# Шаблон секретов для контейнерного агента. СКОПИРУЙ в ~/.agent-secrets.env
# и заполни. НЕ коммитить (добавлено в .gitignore). chmod 600.
#
# Токен Forgejo (git.aidaplus.ru) — с 08.09.2026 репо здесь, не на GitHub.
# Нужны scopes write:repository (git push) и write:issue (PR — это issue).
# Создать: git.aidaplus.ru → Settings → Applications → Generate New Token.
# По духу оригинального дизайна (радиус утечки = только этот репо) заведи
# отдельный токен под контейнер, а не личный из интерактивного tea login.
FORGEJO_TOKEN=xxx

# Отдельный ключ для claude (НЕ личный OAuth). Лучше с бюджет-лимитом.
#   Создать: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=sk-ant-xxx
