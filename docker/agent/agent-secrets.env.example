# Шаблон секретов для контейнерного агента. СКОПИРУЙ в ~/.agent-secrets.env
# и заполни. НЕ коммитить (добавлено в .gitignore). chmod 600.
#
# GitHub fine-grained PAT — ТОЛЬКО репо aidacamp-v2, права:
#   Contents: Read and write, Pull requests: Read and write. Больше ничего.
#   Создать: github.com → Settings → Developer settings → Fine-grained tokens.
GH_TOKEN=github_pat_xxx

# Отдельный ключ для claude (НЕ личный OAuth). Лучше с бюджет-лимитом.
#   Создать: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=sk-ant-xxx
