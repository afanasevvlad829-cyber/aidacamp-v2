[
  {
    "scene": "s1",
    "start": 0.15,
    "end": 2.627,
    "text": "Каждое лето нас спрашивают:"
  },
  {
    "scene": "s1",
    "start": 2.627,
    "end": 4.573,
    "text": "«А вдруг он плачет?»,"
  },
  {
    "scene": "s1",
    "start": 4.573,
    "end": 7.493,
    "text": "«А можно позвонить в тихий час?»"
  },
  {
    "scene": "s1",
    "start": 7.493,
    "end": 9.704,
    "text": "В этом году мы сдались и"
  },
  {
    "scene": "s1",
    "start": 9.704,
    "end": 12.889,
    "text": "сделали тариф «Тревожный родитель»."
  },
  {
    "scene": "s2",
    "start": 13.292,
    "end": 15.174,
    "text": "Подъём в шесть утра —"
  },
  {
    "scene": "s2",
    "start": 15.174,
    "end": 18.167,
    "text": "не спится. Сидишь на подоконнике с"
  },
  {
    "scene": "s2",
    "start": 18.167,
    "end": 21.16,
    "text": "телефоном, как пушкинская Татьяна."
  },
  {
    "scene": "s2b",
    "start": 21.558,
    "end": 25.664,
    "text": "В тариф входит неограниченная фильтрованная вода"
  },
  {
    "scene": "s2b",
    "start": 25.664,
    "end": 28.931,
    "text": "и сертификат «Я отпустил(а)» по итогам"
  },
  {
    "scene": "s2b",
    "start": 28.931,
    "end": 29.517,
    "text": "смены."
  },
  {
    "scene": "s3",
    "start": 29.917,
    "end": 31.714,
    "text": "В допуслуги входит:"
  },
  {
    "scene": "s3",
    "start": 31.714,
    "end": 33.512,
    "text": "отругать вожатого —"
  },
  {
    "scene": "s3",
    "start": 33.512,
    "end": 37.376,
    "text": "девять тысяч, отчитать основателя лагеря —"
  },
  {
    "scene": "s3",
    "start": 37.376,
    "end": 38.993,
    "text": "сто тысяч рублей."
  },
  {
    "scene": "s4",
    "start": 39.391,
    "end": 41.103,
    "text": "Итого: десять дней,"
  },
  {
    "scene": "s4",
    "start": 41.103,
    "end": 43.5,
    "text": "сто пятьдесят тысяч рублей."
  },
  {
    "scene": "s4",
    "start": 43.5,
    "end": 45.982,
    "text": "Шутка. Путёвка для ребёнка —"
  },
  {
    "scene": "s4",
    "start": 45.982,
    "end": 46.838,
    "text": "отдельно."
  }
]