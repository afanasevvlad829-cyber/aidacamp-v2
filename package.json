{
  "name": "aidacamp",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "check:stack": "node scripts/check-stack-standard.mjs",
    "check:astro": "node --max-old-space-size=6144 ./node_modules/.bin/astro check --minimumSeverity error --minimumFailingSeverity error",
    "check:public": "node scripts/check-public-astro.mjs",
    "guard": "npm run check:stack && npm run check:public && bash scripts/guard-no-partytown.sh && bash scripts/check-banned-words.sh && bash scripts/check-price-drift.sh && bash scripts/check-transfer-price-drift.sh && bash scripts/check-date-drift.sh && bash scripts/check-evergreen-drift.sh && bash scripts/guard-static-rules.sh && bash scripts/guard-icons-fresh.sh && bash scripts/check-undefined-vars.sh && npm run check:hooks && node scripts/check-articles.mjs",
    "articles": "node scripts/gen-articles.mjs",
    "check:articles": "node scripts/check-articles.mjs",
    "check:dates": "bash scripts/check-date-drift.sh",
    "check:prices": "bash scripts/check-price-drift.sh",
    "check:transfer": "bash scripts/check-transfer-price-drift.sh",
    "check:banned": "bash scripts/check-banned-words.sh",
    "check:static": "bash scripts/guard-static-rules.sh",
    "check:hooks": "python3 scripts/hooks/guard-preflight.py --selftest && python3 scripts/hooks/guard-agent-output.py --selftest && python3 scripts/hooks/agent-task-registry.py --selftest",
    "check:icons": "bash scripts/guard-icons-fresh.sh",
    "eval:ask": "node scripts/eval-ask-bot.mjs",
    "check:undefined": "bash scripts/check-undefined-vars.sh",
    "check:faq": "node scripts/check-faq-schema.mjs",
    "icons": "node scripts/build-icons-css.mjs",
    "build": "bash scripts/build.sh",
    "pagefind": "pagefind --site dist/client --output-subdir _pagefind --exclude-selectors '[data-pagefind-ignore], header, footer, nav, .ad, [data-analytics-goal]'",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test public.spec.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary",
    "test:coverage:core": "vitest run --config vitest.core.config.ts --coverage --coverage.reporter=text-summary",
    "export:articles": "npx tsx scripts/export-articles-json.ts",
    "check:evergreen": "bash scripts/check-evergreen-drift.sh"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "^1.60.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "3.2.7",
    "bootstrap-icons": "^1.13.1",
    "pagefind": "^1.5.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@astrojs/node": "10.1.4",
    "@astrojs/sitemap": "^3.7.2",
    "@playform/compress": "^0.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/golden-retriever": "^5.2.1",
    "@uppy/xhr-upload": "^5.2.0",
    "astro": "6.4.8",
    "dayjs": "^1.11.21",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "notyf": "^3.10.0",
    "pg": "^8.20.0",
    "photoswipe": "^5.4.4",
    "playwright": "^1.59.1",
    "plyr": "^3.8.4",
    "sharp": "^0.34.5",
    "sortablejs": "^1.15.7",
    "tailwindcss": "4.2.2",
    "zod": "^4.3.6"
  }
}
