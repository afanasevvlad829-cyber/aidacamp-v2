{
  "name": "aidacamp",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "guard": "bash scripts/guard-no-partytown.sh && bash scripts/check-banned-words.sh && bash scripts/check-price-drift.sh && bash scripts/check-date-drift.sh && bash scripts/guard-static-rules.sh && bash scripts/guard-icons-fresh.sh && bash scripts/check-undefined-vars.sh && node scripts/check-articles.mjs",
    "articles": "node scripts/gen-articles.mjs",
    "check:articles": "node scripts/check-articles.mjs",
    "check:dates": "bash scripts/check-date-drift.sh",
    "check:prices": "bash scripts/check-price-drift.sh",
    "check:banned": "bash scripts/check-banned-words.sh",
    "check:static": "bash scripts/guard-static-rules.sh",
    "check:icons": "bash scripts/guard-icons-fresh.sh",
    "eval:ask": "node scripts/eval-ask-bot.mjs",
    "check:undefined": "bash scripts/check-undefined-vars.sh",
    "icons": "node scripts/build-icons-css.mjs",
    "build": "npm run guard && npm run icons && astro build && node -e \"const fs=require('fs'),p='dist/client/';if(fs.existsSync(p+'sitemap-0.xml')){fs.copyFileSync(p+'sitemap-0.xml',p+'sitemap.xml');fs.unlinkSync(p+'sitemap-0.xml');fs.unlinkSync(p+'sitemap-index.xml');console.log('sitemap.xml ready')}\" && node scripts/inject-modulepreload.mjs && npm run pagefind",
    "pagefind": "pagefind --site dist/client --output-subdir _pagefind --exclude-selectors '[data-pagefind-ignore], header, footer, nav, .ad, [data-analytics-goal]'",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "export:articles": "npx tsx scripts/export-articles-json.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/pg": "^8.20.0",
    "bootstrap-icons": "^1.13.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@astrojs/node": "^10.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@playform/compress": "^0.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/golden-retriever": "^5.2.1",
    "@uppy/xhr-upload": "^5.2.0",
    "astro": "^6.1.4",
    "dayjs": "^1.11.21",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "notyf": "^3.10.0",
    "pg": "^8.20.0",
    "photoswipe": "^5.4.4",
    "playwright": "^1.59.1",
    "plyr": "^3.8.4",
    "sharp": "^0.34.5",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  }
}
