{
  "manifest_version": 3,
  "name": "АйДаКемп CRM Panel",
  "version": "1.2.0",
  "description": "Панель реактивации контактов с AI-сообщениями и скорингом",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://codim.s20.online/*",
    "https://aidacamp.ru/*",
    "http://localhost:6300/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codim.s20.online/*"
      ],
      "js": [
        "content.js",
        "ui-modern.js",
        "style-collector.js",
        "style-crawler.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "АйДаКемп CRM Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}