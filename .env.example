# Шаблон локального .env. Скопировать: cp .env.example .env
#
# ⚠️ Как это работает. Код читает переменные в основном через process.env
# (164 обращения против 51 через import.meta.env), а Vite сам кладёт .env
# ТОЛЬКО в import.meta.env. Поэтому npm-скрипты dev/preview запускаются с
# `node --env-file-if-exists=.env` — без этого флага две трети кода файла не
# увидит, и это молча: маршрут не упадёт, а вернёт пустой результат.
#
# ⚠️ Прод-секреты сюда не копировать. Боевые значения живут на сервере в
# /var/www/aidacamp/.env.prod, в CI — в секретах GitHub Actions.
#
# Для правки SEO-страниц (лендинги, статьи) не нужна ни одна переменная —
# они статические и рендерятся dev-сервером как есть.

# ─── База данных ────────────────────────────────────────────────────────────
# Читается в порядке AIDAPLUS_PG_DSN → PG_DSN → DATABASE_URL (src/lib/db.ts).
# Пусто = getPool() вернёт null, зависимые маршруты отдадут пустой результат.
# Прод-БД не прописывать: персональные данные детей и родителей.
PG_DSN=

# ─── Секреты подписи ────────────────────────────────────────────────────────
# Локально сгенерировать своими: openssl rand -hex 32
PORTAL_SESSION_SECRET=
STAFF_AUTH_SECRET=
LEAD_LINK_SECRET=

# ─── Портал и админка ───────────────────────────────────────────────────────
PORTAL_PWD_ADMIN=
PORTAL_PWD_TEACHER=
PORTAL_PWD_STUDENT=
PORTAL_COOKIE_DOMAIN=
PORTAL_BOT_TOKEN=
PORTAL_BOT_USERNAME=
ADMIN_KEY=

# ─── AlfaCRM ────────────────────────────────────────────────────────────────
ALFACRM_HOSTNAME=
ALFACRM_EMAIL=
ALFACRM_API_KEY=
ALFACRM_FIELD_YMUID=
ALFACRM_FIELD_UBTCUID=
ALFACRM_FIELD_DOMAINID=

# ─── Внешние сервисы ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YADISK_TOKEN=
IMMICH_BASE_URL=
IMMICH_API_KEY=
VK_TOKEN=
VK_USER_ID=

# ─── Google Business Profile ────────────────────────────────────────────────
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_REDIRECT_URI=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# ─── Платежи ────────────────────────────────────────────────────────────────
# Боевые значения — только на сервере.
TINKOFF_PASSWORD=
