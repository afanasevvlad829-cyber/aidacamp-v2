---
import '../styles/global.css';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ShiftModal from '../components/ShiftModal.astro';
import GlobalShiftLinkHandler from '../components/GlobalShiftLinkHandler.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  canonical?: string;
  heroImage?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  readTime?: string;
}

const {
  title,
  description,
  h1,
  canonical,
  heroImage,
  datePublished = '2026-04-23',
  dateModified = '2026-04-23',
  authorName = 'Дарья Афанасьева',
  readTime = '7 минут',
} = Astro.props;

const SITE_URL = 'https://aidacamp.ru';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  image: heroImage ? `${SITE_URL}${heroImage}` : `${SITE_URL}/images/hero-custom-2026-04-07-1100.avif`,
  datePublished,
  dateModified,
  author: {
    '@type': 'Person',
    name: authorName,
    '@id': `${SITE_URL}/#person-daria-afanaseva`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'АйДаКемп',
    '@id': `${SITE_URL}/#organization`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo-aidacamp.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical ?? SITE_URL },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: h1, item: canonical ?? SITE_URL },
  ],
};
---

<Base title={title} description={description} ogImage={heroImage}>
  <Fragment slot="head">
    {canonical && <link rel="canonical" href={canonical} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <slot name="head" />
  </Fragment>

  <Header />

  <main class="pb-20 md:pb-0">
    <!-- Breadcrumbs -->
    <div class="mx-auto max-w-[860px] px-4 pt-4 md:pt-6">
      <nav class="text-[13px] text-slate-400 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-orange-500 transition-colors">Главная</a>
        <span>/</span>
        <a href="/blog" class="hover:text-orange-500 transition-colors">Статьи</a>
        <span>/</span>
        <span class="text-slate-600 truncate max-w-[240px]">{h1}</span>
      </nav>
    </div>

    <!-- Hero -->
    {heroImage && (
      <div class="mx-auto max-w-[860px] px-4 mt-6">
        <div class="rounded-2xl overflow-hidden aspect-[16/7]">
          <img
            src={heroImage}
            alt={h1}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )}

    <!-- Article header -->
    <div class="mx-auto max-w-[860px] px-4 mt-8">
      <h1 class="text-[26px] md:text-[34px] font-extrabold leading-[1.15] tracking-[-0.03em] text-slate-900">
        {h1}
      </h1>
      <div class="mt-4 flex items-center gap-4 text-[13px] text-slate-400 flex-wrap">
        <span class="flex items-center gap-1.5">
          <i class="bi bi-person-fill" aria-hidden="true"></i>
          {authorName}
        </span>
        <span class="flex items-center gap-1.5">
          <i class="bi bi-calendar3" aria-hidden="true"></i>
          {new Date(datePublished).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
        <span class="flex items-center gap-1.5">
          <i class="bi bi-clock" aria-hidden="true"></i>
          {readTime}
        </span>
      </div>
    </div>

    <!-- Article content -->
    <div class="mx-auto max-w-[860px] px-4 mt-8 article-body">
      <slot />
    </div>

    <!-- CTA after article -->
    <div class="mx-auto max-w-[860px] px-4 mt-12 mb-12">
      <div class="rounded-2xl bg-gradient-to-br from-orange-50 to-amber-50 border border-orange-100 p-6 md:p-8">
        <p class="text-[13px] font-semibold uppercase tracking-widest text-orange-500 mb-2">АйДаКемп 2026</p>
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 leading-[1.2] mb-3">
          Хотите выбрать смену для вашего ребёнка?
        </h2>
        <p class="text-[15px] text-slate-600 mb-5">
          Расскажем о программах, подберём смену по возрасту и ответим на все вопросы — без скриптов и навязывания.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://wa.me/79999999999"
            class="inline-flex items-center gap-2 rounded-full bg-[#25d366] px-5 py-2.5 text-[14px] font-semibold text-white hover:bg-[#1eb855] transition-colors"
          >
            <i class="bi bi-whatsapp" aria-hidden="true"></i>
            Написать в WhatsApp
          </a>
          <a
            href="/#shifts"
            class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-[14px] font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors"
          >
            Смотреть смены
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>

    <slot name="after" />
  </main>

  <Footer />
  <ShiftModal />
  <StickyCta />
  <GlobalShiftLinkHandler />
</Base>

<style is:global>
  .article-body {
    font-size: 16px;
    line-height: 1.75;
    color: #334155; /* slate-700 */
  }
  .article-body h2 {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .article-body h3 {
    font-size: 17px;
    font-weight: 700;
    color: #1e293b;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .article-body p {
    margin-bottom: 1rem;
  }
  .article-body ul, .article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .article-body li {
    margin-bottom: 0.35rem;
  }
  .article-body strong {
    color: #1e293b;
    font-weight: 700;
  }
  .article-body a {
    color: #ea580c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body a:hover {
    color: #c2410c;
  }
  .article-body blockquote {
    border-left: 3px solid #fb923c;
    padding-left: 1rem;
    color: #475569;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .myth-block {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    margin: 1.75rem 0;
  }
  .myth-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a3412;
    background: #fed7aa;
    padding: 2px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
  }
  .fact-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #14532d;
    background: #bbf7d0;
    padding: 2px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
    margin-top: 6px;
  }
</style>
