---
import '../styles/global.css';
import { ensureTrailingSlash } from '../utils/canonical';
import '../styles/icons.css';
import '../styles/mobile-ux-p0.css';
import '../styles/microinteractions.css';
import '../styles/print.css';
import AgeBar from '../components/AgeBar.astro';
import DynamicPrices from '../components/DynamicPrices.astro';
import ReferralModal from '../components/hero/ReferralModal.astro';
import ShiftModal from '../components/ShiftModal.astro';
import BackToTop from '../components/BackToTop.astro';
import DotPatternBackground from '../components/DotPatternBackground.astro';
import SiteSearch from '../components/SiteSearch.astro';
import NudgeBanner from '../components/NudgeBanner.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Hero image path for early LCP preload — must be set for above-fold hero pages */
  heroPreload?: string;
  /** Responsive hero preload: мобильные ≤768px (рендерится ДО аналитики) */
  heroPreloadMobile?: string;
  /** srcset для мобильного preload — если задан, используется imagesrcset вместо href */
  heroPreloadMobileSrcset?: string;
  /** Responsive hero preload: десктоп ≥769px (рендерится ДО аналитики) */
  heroPreloadDesktop?: string;
  /** Загружать tag.js Метрики немедленно (без задержки 8 сек / интеракции).
   *  Используй для страниц с коротким визитом — /r/, /akciya/ и т.п. */
  eagerMetrika?: boolean;
  /** Запрет индексации страницы поисковиками (robots: noindex, follow) */
  noindex?: boolean;
  /** Переопределяет self-canonical. Если не задан — строится из Astro.url.pathname. */
  canonical?: string;
  /** Скрыть нижнюю AgeBar-плашку с летними сменами (сезонные лендинги: осень/зима/весна) */
  hideAgeBar?: boolean;
  /** Скрыть конверсионные виджеты (DynamicPrices, AgeBar, ShiftModal, ReferralModal,
   *  NudgeBanner) — для страниц без воронки записи (404, юридические документы). */
  hideMarketingWidgets?: boolean;
}

const {
  title,
  description = 'АйДаКемп — IT-лагерь для детей 7–15 лет. Программирование, AI, бассейн. 66 км от Москвы.',
  ogType,
  ogImage = 'https://aidacamp.ru/images/og-default.jpg',
  ogImageAlt = 'АйДаКемп — IT-лагерь для детей в Подмосковье',
  heroPreload,
  heroPreloadMobile,
  heroPreloadMobileSrcset,
  heroPreloadDesktop,
  eagerMetrika = false,
  noindex = false,
  canonical: canonicalProp,
  hideAgeBar = false,
  hideMarketingWidgets = false,
} = Astro.props;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `https://aidacamp.ru${ogImage}`;
// canonical/og:url — на финальный слеш-URL (см. src/utils/canonical.ts, инцидент 03.07.2026).
const canonicalUrl = ensureTrailingSlash(canonicalProp ?? new URL(Astro.url.pathname, 'https://aidacamp.ru').href);
// Автодетект: /stati/ → article, остальные → website
const resolvedOgType = ogType ?? (Astro.url.pathname.startsWith('/stati/') && !Astro.url.pathname.endsWith('/stati/') ? 'article' : 'website');
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    {/* viewport ПЕРЕД preload — preload scanner'у нужен viewport для eval media queries.
        Без этого Chrome грузит и мобильный, и десктопный вариант одновременно. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* LCP preload — после viewport, чтобы media="" в preload scanner работал корректно */}
    {heroPreload && <link rel="preload" as="image" href={heroPreload} type="image/avif" fetchpriority="high" />}
    {heroPreloadMobile && heroPreloadMobileSrcset
      ? <link rel="preload" as="image" type="image/avif" media="(max-width: 768px)" imagesrcset={heroPreloadMobileSrcset} imagesizes="(max-width: 768px) 100vw, 828px" fetchpriority="high" />
      : heroPreloadMobile && <link rel="preload" as="image" media="(max-width: 768px)" href={heroPreloadMobile} fetchpriority="high" />
    }
    {heroPreloadDesktop && <link rel="preload" as="image" media="(min-width: 768px)" href={heroPreloadDesktop} type="image/avif" fetchpriority="high" />}
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="zen-verification" content="bGXeSELNzYWCrN3Ewdwmlygt2cmc8kFg2S9YKuZ5WxhhN92yXsX575rcs6E47eyL" />
    <!-- Mobile address bar / Android task switcher color (бренд orange) -->
    <meta name="theme-color" content="#ec9b44" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0d1a2b" media="(prefers-color-scheme: dark)">
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" href="/fonts/inter-cyrillic.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/inter-latin.woff2" type="font/woff2" crossorigin />
    <!-- Bootstrap Icons: subset of 30 icons inlined locally (no CDN, no font download) -->
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <link rel="dns-prefetch" href="https://mc.yandex.ru" />
    <script is:inline>
      // === Засечь начало сессии ДО любых других скриптов — для корректного session_ms лида ===
      try {
        if (!sessionStorage.getItem('ac_session_start')) {
          sessionStorage.setItem('ac_session_start', String(Date.now()));
        }
      } catch (_) {}
    </script>
    <script is:inline>
      // === Аналитика: отключение для тестовых страниц + ботов ===
      // A. Внутренние страницы (demo/admin/ask-test) — Метрика и Clarity не запускаются
      var __isInternalPath = /^\/(demo|admin|ask-test)\b/.test(location.pathname);
      // C. Dev-домены: dev.aidacamp.ru, dev.codims.ru, localhost — не пишем в Clarity/Метрику
      var __isDevHost = /^(dev\.|localhost|127\.0\.0\.1)/.test(location.hostname);
      // B. Боты: webdriver (Puppeteer/Playwright/Selenium), известные UA, headless без plugins
      var __ua = navigator.userAgent || '';
      var __isBot = navigator.webdriver === true
        || /bot|crawl|spider|headless|puppeteer|playwright|phantom|chrome-lighthouse|gptbot|claudebot|perplexity|ahrefs|semrush|googlebot|yandexbot|bingbot|duckduckbot|applebot|facebookexternalhit/i.test(__ua)
        || (navigator.plugins && navigator.plugins.length === 0 && /Chrome/.test(__ua) && !/Mobile/.test(__ua));

      if (window.location.search.includes('ym_disable=1') || __isInternalPath || __isBot || __isDevHost) {
        document.cookie = 'ym_disable96499295=true; expires=Thu, 31 Dec 2099 23:59:59 UTC; path=/';
        document.cookie = 'clarity_disable=true; expires=Thu, 31 Dec 2099 23:59:59 UTC; path=/';
      }
      if (document.cookie.indexOf('ym_disable96499295=true') !== -1 || __isInternalPath || __isBot || __isDevHost) {
        window.ym_disable96499295 = true;
      }
      if (document.cookie.indexOf('clarity_disable=true') !== -1 || __isInternalPath || __isBot || __isDevHost) {
        window._clarityDisabled = true;
      }
    </script>
    {/* eagerMetrika: устанавливает глобальный флаг ДО инлайн-скрипта Метрики */}
    {eagerMetrika && <script is:inline>window.__ymEager=true;</script>}
    <!-- Yandex.Metrika — lazy load: ym() stub queues calls until tag.js is fetched -->
    <script type="text/javascript" is:inline>
      (function(m,i){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
      })(window,'ym');
      if (!window.ym_disable96499295 && !window._ymInited) {
        window._ymInited = true;
        ym(96499295, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
      }
      (function(){
        if(window.ym_disable96499295) return;
        var loaded=false;
        function loadYM(){
          if(loaded) return; loaded=true;
          var s=document.createElement('script'); s.async=1;
          s.src='https://mc.yandex.ru/metrika/tag.js?id=96499295';
          document.head.appendChild(s);
        }
        if(window.__ymEager){
          /* eagerMetrika: load immediately */
          loadYM();
        } else {
          var t=setTimeout(loadYM,8000);
          ['scroll','click','touchstart','keydown'].forEach(function(e){
            document.addEventListener(e,function(){clearTimeout(t);loadYM();},{once:true,passive:true});
          });
        }
      })();
    </script>
    {/* noscript-фолбэк Метрики вынесен в <body> (Footer.astro) — в <head> он невалиден (div внутри noscript) и ломал W3C-валидацию на всех страницах */}
    <!-- /Yandex.Metrika counter -->
    <!-- WebView detection: tags visit in Metrika + adds data-webview attr for CSS fallbacks -->
    <script is:inline>
      (function(){
        var ua  = navigator.userAgent;
        var ref = document.referrer;
        var isWebView = (
          /\bwv\b/.test(ua) ||
          /FBAV|FBAN|Instagram|MicroMessenger/.test(ua) ||
          ref.indexOf('smartmedia.mail.ru') !== -1 ||
          ref.indexOf('pogoda.mail.ru')     !== -1 ||
          ref.indexOf('vk.com')             !== -1 ||
          (ua.indexOf('Android') !== -1 && ua.indexOf('Version/') !== -1 && ua.indexOf('Chrome') === -1)
        );
        if (isWebView) {
          document.documentElement.setAttribute('data-webview', '1');
          window._isWebView = true;
          // Метрика: параметр визита webview=true — сегментировать в отчётах
          if (typeof ym === 'function') {
            ym(96499295, 'params', { webview: true });
          } else {
            window.addEventListener('load', function(){
              if (typeof ym === 'function') ym(96499295, 'params', { webview: true });
            });
          }
        }
      })();
    </script>

    <!-- Stage 2 scripts (Clarity + Google Analytics) — отложены до первой интеракции или +20 сек -->
    <!-- Перф P2 2026-04-20: 8s→20s, чтобы скрипты не грузились внутри 10-сек окна Lighthouse mobile теста -->
    <!-- Leadfeeder/Andata TM/OneSignal убраны из кода 26.07.2026 (решение владельца — из сторонней
         аналитики оставлены только Метрика и Clarity). Сниппеты не удалены, лежат в
         src/_archive/marketing-widgets/andata-leadfeeder-onesignal.md — вернуть при необходимости. -->
    <script is:inline type="text/javascript">
      (function(){
        var loaded = false;
        function loadStage2(){
          if (loaded) return; loaded = true;
          /* Clarity */
          if(!window._clarityDisabled){
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window,document,"clarity","script","w8yoykmszl");
          }
          /* Google Analytics (GA4) — та же фильтрация бот/dev-хост/внутренние страницы, что у Clarity */
          if(!window._clarityDisabled){
            var gaScript = document.createElement('script');
            gaScript.async = true;
            gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-PGMT3ET16X';
            document.head.appendChild(gaScript);
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-PGMT3ET16X');
          }
        }
        var t = setTimeout(loadStage2, 20000);
        ['scroll','click','touchstart','keydown'].forEach(function(e){
          document.addEventListener(e, function(){ clearTimeout(t); loadStage2(); }, { once:true, passive:true });
        });
      })();
    </script>
    <!-- OG Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="АйДаКемп" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    <slot name="head" />
    <!-- page-globals + dynamic-prices-client: глобальные обработчики + динамические цены -->
    <script>
      import '../scripts/page-globals';
      import '../scripts/dynamic-prices-client';
    </script>
    <!-- Novofon — отложенная загрузка (idle/после load/первое взаимодействие), чтобы не конкурировать с LCP -->
    <script>
      (function () {
        var loaded = false;
        function loadNovofon() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.type = 'text/javascript'; s.async = true;
          s.src = 'https://widget.novofon.ru/novofon.js?k=krSWuOAGuEr40pPzs0o66QKdaef8K0BY';
          document.body.appendChild(s);
        }
        var idleWindow = window as Window & { requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number };
        if (typeof idleWindow.requestIdleCallback === 'function') {
          idleWindow.requestIdleCallback(loadNovofon, { timeout: 5000 });
        } else {
          window.addEventListener('load', function () { setTimeout(loadNovofon, 2500); });
        }
        ['scroll', 'pointerdown', 'keydown'].forEach(function (e) {
          window.addEventListener(e, loadNovofon, { once: true, passive: true });
        });
      })();
    </script>
    <!-- /Novofon -->
  </head>
  <body class="font-sans text-[var(--color-text)] bg-white antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-primary focus:text-white focus:font-semibold focus:shadow-lg">Перейти к содержимому</a>
    <slot />

    <!-- Cookie Banner -->
    <div id="cookieBanner" class="fixed bottom-4 left-4 right-4 z-50 md:left-auto md:right-4 md:bottom-[90px] md:w-[340px]" style="display:none">
      <div class="flex items-center gap-3 rounded-[14px] bg-slate-900/90 px-4 py-3 text-base text-white/80 backdrop-blur-sm shadow-[0_8px_24px_rgba(15,23,42,0.18)]">
        <i class="bi bi-info-circle shrink-0 text-[16px] text-white/60" aria-hidden="true"></i>
        <p class="flex-1 leading-[1.4]">Сайт использует cookies и Яндекс.Метрику для аналитики. <a href="/privacy-policy/" class="underline opacity-70 hover:opacity-100">Подробнее</a></p>
        <button id="cookieAccept" class="shrink-0 rounded-[8px] bg-white/15 px-3 py-1.5 text-[12px] font-medium text-white transition hover:bg-white/25">
          Понятно
        </button>
      </div>
    </div>

    <!-- Cookie banner обработан в page-globals.ts -->
    {!hideMarketingWidgets && (
      <Fragment>
        <!-- DynamicPrices: единый скрипт динамических цен для всех страниц -->
        <DynamicPrices />
        <!-- AgeBar: мобильная плашка выбора возраста (летние смены) — на сезонных лендингах скрыта -->
        {!hideAgeBar && <AgeBar />}
        <!-- ShiftModal: открывается из AgeBar «Посмотреть» и data-shift-link на всех страницах
             (собственный document click-делегат в shift-modal.ts, initShiftModal()) -->
        <ShiftModal />
      </Fragment>
    )}
    {!hideMarketingWidgets && <ReferralModal />}
    <!-- <ExitIntentPopup /> отключён -->
    <!-- Debug: ?modal=referral → обработано в page-globals.ts -->

    <DotPatternBackground />
    <BackToTop />

    <!-- Reveal-on-scroll анимация для карточек (концепт aidacamp-full_9) -->
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
    <SiteSearch />
    <!-- ReturnBanner отключён → заменён на NudgeBanner (догрев повторщиков, A/B отзывы vs ТВ) -->
    {!hideMarketingWidgets && <NudgeBanner />}

    <!-- Неизвестные якоря и ретаргет-трафик → #shifts (обработано в page-globals.ts) -->

    <!-- Andata Tag Manager — загружается лениво в Stage 2 вместе с Clarity/Mail.ru -->
  </body>
</html>
