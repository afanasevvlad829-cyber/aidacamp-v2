---
import '../styles/global.css';
import '../styles/icons.css';
import '../styles/mobile-ux-p0.css';
import '../styles/microinteractions.css';
import '../styles/print.css';
import AgeBar from '../components/AgeBar.astro';
import ReferralModal from '../components/hero/ReferralModal.astro';
import ShiftModal from '../components/ShiftModal.astro';
import GlobalShiftLinkHandler from '../components/GlobalShiftLinkHandler.astro';
import BackToTop from '../components/BackToTop.astro';
import DotPatternBackground from '../components/DotPatternBackground.astro';
import SiteSearch from '../components/SiteSearch.astro';
import ReturnBanner from '../components/ReturnBanner.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Hero image path for early LCP preload — must be set for above-fold hero pages */
  heroPreload?: string;
  /** Responsive hero preload: мобильные ≤768px (рендерится ДО аналитики) */
  heroPreloadMobile?: string;
  /** srcset для мобильного preload — если задан, используется imagesrcset вместо href */
  heroPreloadMobileSrcset?: string;
  /** Responsive hero preload: десктоп ≥769px (рендерится ДО аналитики) */
  heroPreloadDesktop?: string;
  /** Загружать tag.js Метрики немедленно (без задержки 8 сек / интеракции).
   *  Используй для страниц с коротким визитом — /r/, /akciya/ и т.п. */
  eagerMetrika?: boolean;
  /** Запрет индексации страницы поисковиками (robots: noindex, nofollow) */
  noindex?: boolean;
}

const {
  title,
  description = 'АйДаКемп — IT-лагерь для детей 7–15 лет. Программирование, AI, бассейн. 66 км от Москвы.',
  ogType,
  ogImage = 'https://aidacamp.ru/images/og-default.jpg',
  ogImageAlt = 'АйДаКемп — IT-лагерь для детей в Подмосковье',
  heroPreload,
  heroPreloadMobile,
  heroPreloadMobileSrcset,
  heroPreloadDesktop,
  eagerMetrika = false,
  noindex = false,
} = Astro.props;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `https://aidacamp.ru${ogImage}`;
const canonicalUrl = new URL(Astro.url.pathname, 'https://aidacamp.ru').href;
// Автодетект: /stati/ → article, остальные → website
const resolvedOgType = ogType ?? (Astro.url.pathname.startsWith('/stati/') && !Astro.url.pathname.endsWith('/stati/') ? 'article' : 'website');
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    {/* viewport ПЕРЕД preload — preload scanner'у нужен viewport для eval media queries.
        Без этого Chrome грузит и мобильный, и десктопный вариант одновременно. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* LCP preload — после viewport, чтобы media="" в preload scanner работал корректно */}
    {heroPreload && <link rel="preload" as="image" href={heroPreload} type="image/avif" fetchpriority="high" />}
    {heroPreloadMobile && heroPreloadMobileSrcset
      ? <link rel="preload" as="image" media="(max-width: 768px)" imagesrcset={heroPreloadMobileSrcset} imagesizes="100vw" fetchpriority="high" />
      : heroPreloadMobile && <link rel="preload" as="image" media="(max-width: 768px)" href={heroPreloadMobile} fetchpriority="high" />
    }
    {heroPreloadDesktop && <link rel="preload" as="image" media="(min-width: 768px)" href={heroPreloadDesktop} type="image/avif" fetchpriority="high" />}
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <!-- Mobile address bar / Android task switcher color (бренд orange) -->
    <meta name="theme-color" content="#ec9b44" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0d1a2b" media="(prefers-color-scheme: dark)">
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" as="font" href="/fonts/inter-cyrillic.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/inter-latin.woff2" type="font/woff2" crossorigin />
    <!-- Bootstrap Icons: subset of 30 icons inlined locally (no CDN, no font download) -->
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <link rel="dns-prefetch" href="https://mc.yandex.ru" />
    <link rel="dns-prefetch" href="https://top-fwz1.mail.ru" />
    <script is:inline>
      // === Засечь начало сессии ДО любых других скриптов — для корректного session_ms лида ===
      try {
        if (!sessionStorage.getItem('ac_session_start')) {
          sessionStorage.setItem('ac_session_start', String(Date.now()));
        }
      } catch (_) {}
    </script>
    <script is:inline>
      // === Аналитика: отключение для тестовых страниц + ботов ===
      // A. Внутренние страницы (demo/admin/ask-test) — Метрика и Clarity не запускаются
      var __isInternalPath = /^\/(demo|admin|ask-test)\b/.test(location.pathname);
      // C. Dev-домены: dev.aidacamp.ru, dev.codims.ru, localhost — не пишем в Clarity/Метрику
      var __isDevHost = /^(dev\.|localhost|127\.0\.0\.1)/.test(location.hostname);
      // B. Боты: webdriver (Puppeteer/Playwright/Selenium), известные UA, headless без plugins
      var __ua = navigator.userAgent || '';
      var __isBot = navigator.webdriver === true
        || /bot|crawl|spider|headless|puppeteer|playwright|phantom|chrome-lighthouse|gptbot|claudebot|perplexity|ahrefs|semrush|googlebot|yandexbot|bingbot|duckduckbot|applebot|facebookexternalhit/i.test(__ua)
        || (navigator.plugins && navigator.plugins.length === 0 && /Chrome/.test(__ua) && !/Mobile/.test(__ua));

      if (window.location.search.includes('ym_disable=1') || __isInternalPath || __isBot || __isDevHost) {
        document.cookie = 'ym_disable96499295=true; expires=Thu, 31 Dec 2099 23:59:59 UTC; path=/';
        document.cookie = 'clarity_disable=true; expires=Thu, 31 Dec 2099 23:59:59 UTC; path=/';
      }
      if (document.cookie.indexOf('ym_disable96499295=true') !== -1 || __isInternalPath || __isBot || __isDevHost) {
        window.ym_disable96499295 = true;
      }
      if (document.cookie.indexOf('clarity_disable=true') !== -1 || __isInternalPath || __isBot || __isDevHost) {
        window._clarityDisabled = true;
      }
    </script>
    {/* eagerMetrika: устанавливает глобальный флаг ДО инлайн-скрипта Метрики */}
    {eagerMetrika && <script is:inline>window.__ymEager=true;</script>}
    <!-- Yandex.Metrika — lazy load: ym() stub queues calls until tag.js is fetched -->
    <script type="text/javascript" is:inline>
      (function(m,i){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
      })(window,'ym');
      if (!window.ym_disable96499295 && !window._ymInited) {
        window._ymInited = true;
        ym(96499295,'init',{clickmap:true,referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:false});
      }
      (function(){
        if(window.ym_disable96499295) return;
        var loaded=false;
        function loadYM(){
          if(loaded) return; loaded=true;
          var s=document.createElement('script'); s.async=1;
          s.src='https://mc.yandex.ru/metrika/tag.js';
          document.head.appendChild(s);
        }
        if(window.__ymEager){
          // Страница с коротким визитом — tag.js грузится немедленно (см. eagerMetrika prop)
          loadYM();
        } else {
          var t=setTimeout(loadYM,8000);
          ['scroll','click','touchstart','keydown'].forEach(function(e){
            document.addEventListener(e,function(){clearTimeout(t);loadYM();},{once:true,passive:true});
          });
        }
      })();
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/96499295" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
    <!-- Mail.ru Top.Mail.Ru — _tmr queue init (нет сетевых запросов; pageView ставится в очередь;
         сам скрипт загружается лениво в Stage 2 вместе с Clarity) -->
    <script is:inline type="text/javascript">
      (function(){
        var t = window._tmr = window._tmr || [];
        t.push({id:'3755202', type:'pageView', start:+new Date()});
      })();
    </script>
    <!-- /Mail.ru _tmr init -->
    <!-- WebView detection: tags visit in Metrika + adds data-webview attr for CSS fallbacks -->
    <script is:inline>
      (function(){
        var ua  = navigator.userAgent;
        var ref = document.referrer;
        var isWebView = (
          /\bwv\b/.test(ua) ||
          /FBAV|FBAN|Instagram|MicroMessenger/.test(ua) ||
          ref.indexOf('smartmedia.mail.ru') !== -1 ||
          ref.indexOf('pogoda.mail.ru')     !== -1 ||
          ref.indexOf('vk.com')             !== -1 ||
          (ua.indexOf('Android') !== -1 && ua.indexOf('Version/') !== -1 && ua.indexOf('Chrome') === -1)
        );
        if (isWebView) {
          document.documentElement.setAttribute('data-webview', '1');
          window._isWebView = true;
          // Метрика: параметр визита webview=true — сегментировать в отчётах
          if (typeof ym === 'function') {
            ym(96499295, 'params', { webview: true });
          } else {
            window.addEventListener('load', function(){
              if (typeof ym === 'function') ym(96499295, 'params', { webview: true });
            });
          }
        }
      })();
    </script>

    <!-- Stage 2 scripts (Clarity + Leadfeeder + Mail.ru + Andata) — отложены до первой интеракции или +20 сек -->
    <!-- Перф P2 2026-04-20: 8s→20s, чтобы скрипты не грузились внутри 10-сек окна Lighthouse mobile теста -->
    <script is:inline type="text/javascript">
      (function(){
        var loaded = false;
        function loadStage2(){
          if (loaded) return; loaded = true;
          // Clarity
          if(!window._clarityDisabled){
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window,document,"clarity","script","w8yoykmszl");
          }
          // Leadfeeder
          (function(ss,ex){
            window.ldfdr=window.ldfdr||function(){(ldfdr._q=ldfdr._q||[]).push([].slice.call(arguments));};
            (function(d,s){var fs=d.getElementsByTagName(s)[0];function ce(src){var cs=d.createElement(s);cs.src=src;cs.async=1;fs.parentNode.insertBefore(cs,fs);}
            ce('https://sc.lfeeder.com/lftracker_v1_'+ss+(ex?'_'+ex:'')+'.js');})(document,'script');
          })('YEgkB8lbGVx4ep3Z');
          // Mail.ru Top.Mail.Ru — скрипт загружается лениво; _tmr очередь уже заполнена pageView + reachGoal
          (function(d,id){
            if(d.getElementById(id)) return;
            var s=d.createElement('script'); s.id=id; s.async=1;
            s.src='https://top-fwz1.mail.ru/js/code.js';
            var f=d.getElementsByTagName('script')[0]; f.parentNode.insertBefore(s,f);
          })(document,'topmailru-code');
          // Andata Tag Manager — лениво, не блокирует LCP/TBT
          (function(d,id){
            if(d.getElementById(id)) return;
            var s=d.createElement('script'); s.id=id; s.async=1;
            s.src='https://tagmanager.andata.ru/api/v1/container/9c0aaeb2-3b5c-4f86-aebd-786c79f7314b/published/code.js';
            var f=d.getElementsByTagName('script')[0]; f.parentNode.insertBefore(s,f);
          })(document,'andata-tm');
        }
        var t = setTimeout(loadStage2, 20000);
        ['scroll','click','touchstart','keydown'].forEach(function(e){
          document.addEventListener(e, function(){ clearTimeout(t); loadStage2(); }, { once:true, passive:true });
        });
      })();
    </script>
    <!-- OG Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="АйДаКемп" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    <slot name="head" />
    <!-- Analytics globals: trackGoal, initScrollTracking, initContactTracking — inline, no network request -->
    <script is:inline>
      (function () {
        var YM_ID = 96499295;
        var _fired = new Set(JSON.parse(sessionStorage.getItem('ym_fired') || '[]'));
        function _persist() { try { sessionStorage.setItem('ym_fired', JSON.stringify([..._fired])); } catch(e){} }
        window.trackGoal = function (id, params) {
          if (_fired.has(id)) return;
          _fired.add(id);
          _persist();
          try { if (typeof window.ym !== 'undefined') window.ym(YM_ID, 'reachGoal', id, params || {}); } catch(e){}
          // Своя аналитика — параметрированные события в PostgreSQL
          if (params && Object.keys(params).length > 0) {
            try {
              var payload = JSON.stringify({ goal: id, params: params, url: location.href,
                referrer: document.referrer || undefined,
                client_id: (document.cookie.match(/_ym_uid=(\d+)/) || [])[1] || undefined });
              if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
              } else {
                fetch('/api/track', { method: 'POST', body: payload,
                  headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(function(){});
              }
            } catch(e) {}
          }
        };
        window.initScrollTracking = function () {
          var goals = [{p:25,id:'scroll_25'},{p:50,id:'scroll_50'},{p:75,id:'scroll_75'},{p:90,id:'scroll_90'}];
          window.addEventListener('scroll', function () {
            var h = document.documentElement.scrollHeight - (window.visualViewport ? window.visualViewport.height : window.innerHeight);
            if (!h) return;
            var pct = Math.round(window.scrollY / h * 100);
            goals.forEach(function (g) { if (pct >= g.p) window.trackGoal(g.id); });
          }, { passive: true });
        };
        window.initContactTracking = function (scope) {
          document.querySelectorAll(scope + ' a[href^="tel:"]').forEach(function (a) {
            a.addEventListener('click', function () { window.trackGoal('phone_click'); });
          });
          document.querySelectorAll(scope + ' a[href*="wa.me"]').forEach(function (a) {
            a.addEventListener('click', function () { window.trackGoal('whatsapp_click'); });
          });
          document.querySelectorAll(scope + ' a[href*="t.me"]').forEach(function (a) {
            a.addEventListener('click', function () { window.trackGoal('telegram_click'); });
          });
        };
      })();
    </script>
  </head>
  <body class="font-sans text-[var(--color-text)] bg-white antialiased">
    <slot />
    <!-- Nudge toast (отключён) -->
    <div
      id="nudge-toast"
      class="hidden fixed bottom-20 left-4 right-4 z-50 mx-auto max-w-[420px] translate-y-full opacity-0 transition-all duration-300 pointer-events-none md:bottom-6 md:left-auto md:right-6"
    >
      <div class="flex items-start gap-3 rounded-[14px] bg-slate-900/95 px-4 py-3 shadow-[0_8px_32px_rgba(0,0,0,0.25)] backdrop-blur-sm">
        <div class="flex-1">
          <span id="nudge-text" class="text-[14px] leading-[1.45] text-white/90"></span>
          <span id="nudge-sub" class="block mt-0.5 text-[12px] leading-[1.4] text-white/60"></span>
        </div>
        <button id="nudge-close" class="shrink-0 inline-flex h-6 w-6 items-center justify-center rounded-full text-white/65 hover:text-white/90 transition-colors" aria-label="Закрыть">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <script is:inline>
      // initNudges отключены
      document.addEventListener('DOMContentLoaded', function () {
        if (window.initScrollTracking) window.initScrollTracking();
      });
    </script>

    <!-- Cookie Banner -->
    <div id="cookieBanner" class="fixed bottom-4 left-4 right-4 z-50 md:left-auto md:right-4 md:bottom-[90px] md:w-[340px]" style="display:none">
      <div class="flex items-center gap-3 rounded-[14px] bg-slate-900/90 px-4 py-3 text-[13px] text-white/80 backdrop-blur-sm shadow-[0_8px_24px_rgba(15,23,42,0.18)]">
        <i class="bi bi-info-circle shrink-0 text-[16px] text-white/60" aria-hidden="true"></i>
        <p class="flex-1 leading-[1.4]">Сайт использует cookies и Яндекс.Метрику для аналитики. <a href="/privacy-policy/" class="underline opacity-70 hover:opacity-100">Подробнее</a></p>
        <button id="cookieAccept" class="shrink-0 rounded-[8px] bg-white/15 px-3 py-1.5 text-[12px] font-medium text-white transition hover:bg-white/25">
          Понятно
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        if (!localStorage.getItem('cookieAccepted')) {
          var banner = document.getElementById('cookieBanner');
          if (banner) {
            banner.style.display = 'block';
            document.getElementById('cookieAccept').addEventListener('click', function() {
              localStorage.setItem('cookieAccepted', '1');
              banner.style.display = 'none';
            });
          }
        }
      })();
    </script>
    <!-- AgeBar: мобильная плашка выбора возраста -->
    <AgeBar />
    <!-- ShiftModal: открывается из AgeBar «Посмотреть» и data-shift-link на всех страницах -->
    <ShiftModal />
    <GlobalShiftLinkHandler />
    <ReferralModal />
    <!-- Debug: ?modal=referral открывает модалку напрямую -->
    <script is:inline>
      (function () {
        var param = new URLSearchParams(location.search).get('modal');
        if (!param) return;
        function tryOpen() {
          var el = document.getElementById(param + 'Modal');
          if (!el || el.open) return;
          try { el.showModal(); } catch(e) {}
        }
        setTimeout(tryOpen, 100);
        document.addEventListener('astro:page-load', function() { setTimeout(tryOpen, 100); });
      })();
    </script>

    <DotPatternBackground />
    <BackToTop />

    <!-- Reveal-on-scroll анимация для карточек (концепт aidacamp-full_9) -->
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
    <SiteSearch />
    <ReturnBanner />

    <!-- Неизвестные якоря и ретаргет-трафик → #shifts -->
    <script is:inline>
      (function () {
        var KNOWN = ['shifts','about','gallery','gallery-preview','faq','booking','price','smeny','program','tracks','philosophy','economy','journey','team','stay','reviews','contacts','videos','hackathon','mentors','hero','waitlist'];
        var hash = (location.hash || '').replace('#','');
        var isRetarget = location.search.indexOf('ybaip=1') !== -1;
        var isUnknownHash = hash && KNOWN.indexOf(hash) === -1;
        if (isRetarget || isUnknownHash) {
          function scrollToShifts() {
            var el = document.getElementById('shifts');
            if (el) el.scrollIntoView({ behavior: 'instant', block: 'start' });
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scrollToShifts);
          } else {
            scrollToShifts();
          }
        }
      })();
    </script>

    <!-- Andata Tag Manager — загружается лениво в Stage 2 вместе с Clarity/Mail.ru -->
  </body>
</html>
