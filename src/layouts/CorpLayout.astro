---
import '../styles/global.css';
import iconsCSS from '../styles/icons.css?raw';
import type { CorpClient } from '../data/corp/types';

interface Props {
  client: CorpClient;
  title?: string;
  description?: string;
}

const {
  client,
  title = `АйДаКемп 2026 — для сотрудников ${client.clientName}`,
  description = `IT-лагерь АйДаКемп для детей сотрудников ${client.clientName}. Программирование, AI, бассейн. 66 км от Москвы. Скидка ${client.discount}%.`,
} = Astro.props;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>

    <!-- Unbounded — только для corp заголовков -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons (inline) -->
    <style set:html={iconsCSS} />

    <style>
      /* ── Corp dark theme tokens ─────────────────────────────── */
      :root {
        --corp-bg:      #0C0E11;
        --corp-bg2:     #111418;
        --corp-bg3:     #181C22;
        --corp-bg4:     #1F2530;
        --corp-or:      #FF5A1F;
        --corp-or2:     #FF7A3D;
        --corp-txt:     #E2E8F5;
        --corp-txt2:    #8892A4;
        --corp-bdr:     rgba(255,255,255,0.06);
        --corp-bdr2:    rgba(255,255,255,0.12);
        --corp-surface: rgba(255,255,255,0.04);
        --corp-green:   #22C76A;
      }

      /* ── Base reset ─────────────────────────────────────────── */
      body {
        background: var(--corp-bg);
        color: var(--corp-txt);
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* ── Corp headings ──────────────────────────────────────── */
      .corp-h1 {
        font-family: 'Unbounded', sans-serif;
        font-size: clamp(2.25rem, 5vw, 4rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.025em;
        color: var(--corp-txt);
      }
      .corp-h2 {
        font-family: 'Unbounded', sans-serif;
        font-size: clamp(1.75rem, 4vw, 3rem);
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--corp-txt);
      }
      @media (max-width: 640px) {
        .corp-h2 { line-height: 1.2; letter-spacing: -0.01em; }
      }

      .corp-or  { color: var(--corp-or); }
      .corp-or2 { color: var(--corp-or2); }

      /* ── Kicker (UPPERCASE label) ───────────────────────────── */
      .corp-kicker {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--corp-or);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
      }
      .corp-kicker::after {
        content: '';
        width: 32px;
        height: 2px;
        background: var(--corp-or);
        opacity: 0.5;
        border-radius: 1px;
      }

      /* ── Section wrapper ────────────────────────────────────── */
      .corp-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
      }
      .corp-section {
        padding: 80px 0;
      }
      .corp-section-alt {
        background: var(--corp-bg2);
      }
      @media (max-width: 768px) {
        .corp-section { padding: 52px 0; }
        .corp-wrap { padding: 0 16px; }
      }

      /* ── Reveal animation ───────────────────────────────────── */
      .r { opacity: 0; transform: translateY(18px); transition: opacity 0.5s, transform 0.5s; }
      .r.visible { opacity: 1; transform: none; }
    </style>
  </head>

  <body>
    <slot />

    <script>
      // Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('visible'); io.unobserve(e.target); } }),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.r').forEach(el => io.observe(el));
    </script>
  </body>
</html>
