---
import '../styles/global.css';
import iconsCSS from '../styles/icons.css?raw';
import type { CorpClient } from '../data/corp/types';

interface Props {
  client: CorpClient;
  title?: string;
  description?: string;
}

const {
  client,
  title = `АйДаКемп 2026 — для сотрудников ${client.clientName}`,
  description = `IT-лагерь АйДаКемп для детей сотрудников ${client.clientName}. Программирование, AI, бассейн. 66 км от Москвы. Скидка ${client.discount}%.`,
} = Astro.props;
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons (inline) -->
    <style set:html={iconsCSS} />

    <style>
/* ── DESIGN TOKENS — DARK (default) ─────────────────────────────────── */
:root {
  --bg:      #0C0E11;
  --bg2:     #111418;
  --bg3:     #181C22;
  --bg4:     #1F2530;
  --bdr:     rgba(255,255,255,0.07);
  --bdr2:    rgba(255,255,255,0.13);
  --txt:     #E4E6EF;
  --txt2:    #9098AB;
  --or:      #FF5A1F;
  --or2:     #FF7A3D;
  --green:   #22C76A;
  --blue:    #4A9EFF;
  --surface: rgba(255,255,255,0.04);
  --shadow:  0 24px 64px rgba(0,0,0,0.55);
  --code-bg: #0F1419;
  --ck: #FF7B72; --cf: #D2A8FF; --cs: #A5D6FF; --cn: #FFA657; --cc: #6E7681;
  --code-text:    #E6EDF3;
  --code-comment: #8B949E;
  --code-dark:    #0d1a2b;
  --c-white:   #ffffff;
  --c-error:   #EF4444;
  --c-warn:    #FACC15;
  --c-amber:   #FB923C;
  --c-bg-dark: #0d1a2b;
  --nav-bg:  rgba(12,14,17,0.88);
  /* typography */
  --fs-xs:   12px;
  --fs-sm:   16px;
  --fs-base: 17px;
  --fs-md:   18px;
  --fs-lg:   20px;
  --fs-xl:   22px;
  --fs-2xl:  24px;
  --fs-3xl:  28px;
  --lh-tight:   1.1;
  --lh-snug:    1.25;
  --lh-normal:  1.6;
  --lh-relaxed: 1.75;
  /* spacing */
  --gap-xs:  6px;
  --gap-sm:  10px;
  --gap-md:  16px;
  --gap-lg:  24px;
  --gap-xl:  36px;
  --gap-2xl: 48px;
  /* radius */
  --r-xs:  4px;
  --r-sm:  8px;
  --r-md:  12px;
  --r-lg:  16px;
  --r-xl:  20px;
  --r-2xl: 28px;
  --r-full: 9999px;
  /* padding */
  --py-xs:  8px;
  --py-sm:  16px;
  --py-md:  24px;
  --py-lg:  48px;
  --py-xl:  80px;
  --px-sm:  16px;
  --px-md:  24px;
  --px-lg:  28px;
}

/* ── DESIGN TOKENS — LIGHT ───────────────────────────────────────────── */
[data-theme="light"] {
  --bg:      #F4F5F8;
  --bg2:     #FFFFFF;
  --bg3:     #ECEEF3;
  --bg4:     #E2E5ED;
  --bdr:     rgba(0,0,0,0.08);
  --bdr2:    rgba(0,0,0,0.14);
  --txt:     #1A1D24;
  --txt2:    #5A6070;
  --surface: rgba(0,0,0,0.03);
  --shadow:  0 12px 32px rgba(0,0,0,0.10);
  --code-bg: #1A1E26;
  --nav-bg:  rgba(244,245,248,0.92);
}

/* ── BASE RESET ──────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg); color: var(--txt);
  font-family: 'Inter', system-ui, sans-serif;
  font-size: var(--fs-md); line-height: 1.7;
  overflow-x: hidden; -webkit-font-smoothing: antialiased;
  transition: background 0.3s, color 0.3s;
}
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
button { font-family: inherit; }

/* ── LAYOUT ──────────────────────────────────────────────────────────── */
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; }

/* ── NAV ─────────────────────────────────────────────────────────────── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  background: var(--nav-bg);
  backdrop-filter: blur(18px) saturate(180%);
  border-bottom: 1px solid var(--bdr);
  transition: background 0.3s;
}
.nav-inner {
  max-width: 1100px; margin: 0 auto; padding: 0 28px;
  height: 64px; display: flex; align-items: center; justify-content: space-between; gap: var(--gap-md);
}
.nav-logo { font-family: 'Unbounded', sans-serif; font-size: var(--fs-lg); font-weight: 900; color: var(--txt); }
.nav-logo em { font-style: normal; color: var(--or2); }
.nav-badge {
  font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--or2); border: 1px solid rgba(255,122,61,0.35);
  padding: 5px 14px; border-radius: 3px;
}
.nav-right { display: flex; align-items: center; gap: var(--gap-md); }
.nav-tel { font-size: var(--fs-base); font-weight: 700; color: var(--txt); transition: color 0.2s; }
.nav-tel:hover { color: var(--or2); }
.theme-toggle {
  width: 38px; height: 38px; border-radius: var(--r-sm);
  background: var(--bg3); border: 1px solid var(--bdr2);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: background 0.2s; color: var(--txt);
}
.theme-toggle:hover { background: var(--bg4); }

/* ── HERO ────────────────────────────────────────────────────────────── */
.hero {
  position: relative; min-height: 100vh;
  display: flex; align-items: center;
  padding: 100px 28px 80px;
  overflow: hidden;
  border-top: none !important;
}
#hero-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
  opacity: 0.22; transition: opacity 0.3s;
}
[data-theme="light"] #hero-canvas { opacity: 0.07; }
.hero-content {
  position: relative; z-index: 1;
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 500px; gap: 72px; align-items: center;
  width: 100%;
}
.hero-kicker {
  display: inline-flex; align-items: center; gap: var(--gap-sm);
  font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--or2); margin-bottom: var(--gap-xl);
}
.hero-kicker-line { width: 28px; height: 2px; background: var(--or2); flex-shrink: 0; }
h1 {
  font-family: 'Unbounded', sans-serif;
  font-size: clamp(38px, 5vw, 68px);
  font-weight: 900; line-height: 1.0;
  letter-spacing: -0.03em; color: var(--txt);
  margin-bottom: var(--gap-lg);
}
h1 em { font-style: normal; color: var(--or2); }
.hero-desc { font-size: var(--fs-lg); color: var(--txt2); line-height: 1.75; margin-bottom: var(--gap-xl); max-width: 500px; }
.hero-pills { display: flex; gap: var(--gap-xs); flex-wrap: wrap; margin-bottom: var(--gap-xl); }
.pill { font-size: var(--fs-sm); font-weight: 500; background: var(--surface); border: 1px solid var(--bdr2); color: var(--txt2); padding: 8px 16px; border-radius: var(--r-xs); text-decoration: none; }
.pill-link { cursor: pointer; transition: border-color 0.15s, color 0.15s; }
.pill-link:hover { border-color: var(--or2); color: var(--or2); }
.hero-btns { display: flex; gap: var(--gap-sm); flex-wrap: wrap; }
.btn-primary {
  display: inline-flex; align-items: center; gap: var(--gap-xs);
  background: var(--or); color: var(--c-white); font-size: var(--fs-md); font-weight: 700;
  padding: 16px 28px; border-radius: var(--r-xs); transition: background 0.2s, transform 0.15s;
  text-decoration: none;
}
.btn-primary:hover { background: var(--or2); transform: translateY(-2px); }
.btn-ghost {
  display: inline-flex; align-items: center; gap: var(--gap-xs);
  background: var(--surface); border: 1px solid var(--bdr2);
  color: var(--txt); font-size: var(--fs-md); font-weight: 600;
  padding: 16px 28px; border-radius: var(--r-xs); transition: border-color 0.2s, transform 0.15s;
  text-decoration: none;
}
.btn-ghost:hover { border-color: rgba(255,122,61,0.4); transform: translateY(-2px); }

/* ── TERMINAL ────────────────────────────────────────────────────────── */
.terminal {
  background: var(--code-bg); border: 1px solid var(--bdr2);
  border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow); position: relative;
  height: 420px; display: flex; flex-direction: column;
}
.term-bar {
  background: rgba(255,255,255,0.05); padding: 13px 18px;
  display: flex; align-items: center; gap: var(--gap-xs);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  flex-shrink: 0;
}
.tdot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
.td-r { background: #FF5F57; }
.td-y { background: #FFBD2E; }
.td-g { background: #28C840; }
.term-tabs { display: flex; gap: 2px; margin-left: 12px; }
.term-tab {
  background: transparent; border: none; color: #6E7681;
  font-size: var(--fs-xs); font-weight: 600;
  padding: 5px 12px; border-radius: var(--r-xs); cursor: pointer; transition: all 0.15s;
  font-family: 'SF Mono','Fira Code',monospace;
}
.term-tab:hover { background: rgba(255,255,255,0.06); color: #C9D1DA; }
.term-tab.active { background: rgba(255,122,61,0.12); color: var(--or2); }
.term-body {
  padding: 24px 24px 16px; font-family: 'SF Mono','Fira Code','Consolas',monospace;
  font-size: var(--fs-sm); line-height: 1.9; flex: 1; overflow: hidden;
}
.ck { color: var(--ck); }
.cf { color: var(--cf); }
.cs { color: var(--cs); }
.cn { color: var(--cn); }
.cc { color: var(--cc); }
.cw { color: var(--code-text); }
.cursor {
  display: inline-block; width: 2px; height: 1em; background: var(--or2);
  vertical-align: text-bottom; animation: blink 1s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }
.term-footer {
  background: rgba(255,90,31,0.1); border-top: 1px solid rgba(255,90,31,0.2);
  padding: 11px 18px; display: flex; justify-content: space-between; align-items: center;
  flex-shrink: 0;
}
.term-tag { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--or2); font-family: 'SF Mono',monospace; }
.term-ok { font-size: var(--fs-xs); color: var(--green); display: flex; align-items: center; gap: var(--gap-xs); font-family: 'SF Mono',monospace; }
.term-ok::before { content: ''; width: 7px; height: 7px; border-radius: var(--r-full); background: var(--green); }

/* Terminal easter eggs */
#term-cscrash {
  position: absolute; inset: 0; background: #1a0000; display: flex; flex-direction: column;
  padding: 24px; font-family: 'SF Mono','Fira Code',monospace; font-size: 13px; line-height: 1.7;
  overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity 0.15s; z-index: 5;
}
#term-cscrash.show { opacity: 1; pointer-events: all; }
.cs-line { color: #cc8888; }
.cs-white { color: #ffffff; }
.cs-gray { color: #888; }
.cs-btn-row { display: flex; gap: var(--gap-sm); margin-top: 12px; flex-wrap: wrap; }
.cs-btn {
  padding: 5px 14px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3);
  color: #fff; font-family: 'SF Mono',monospace; font-size: 12px; cursor: pointer;
  transition: background 0.15s; border-radius: 2px;
}
.cs-btn:hover { background: rgba(255,255,255,0.25); }

#term-kpanic {
  position: absolute; inset: 0; background: #000; display: flex; flex-direction: column;
  padding: 24px; font-family: 'SF Mono','Fira Code',monospace; font-size: 13px; line-height: 1.7;
  overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity 0.15s; z-index: 5; color: #fff;
}
#term-kpanic.show { opacity: 1; pointer-events: all; }
.kp-yellow { color: #FFBD2E; }
.kp-red { color: #FF5F57; }
.kp-btn {
  display: inline-block; margin-top: 12px; padding: 6px 16px; background: #111; border: 1px solid #555;
  color: #aaa; font-family: 'SF Mono',monospace; font-size: 12px; cursor: pointer;
  transition: background 0.15s;
}
.kp-btn:hover { background: #222; }

#term-bsod {
  position: absolute; inset: 0; background: #0000AA; display: flex; flex-direction: column;
  justify-content: center; align-items: center; padding: 20px 24px; z-index: 10;
  opacity: 0; transition: opacity 0.15s; pointer-events: none;
  font-family: 'SF Mono','Fira Code','Consolas',monospace; color: var(--c-white); text-align: center;
}
#term-bsod.show { opacity: 1; pointer-events: all; }
.bsod-face { font-size: 56px; line-height: 1; margin-bottom: var(--gap-sm); }
.bsod-title { font-size: var(--fs-lg); font-weight: 700; margin-bottom: var(--gap-xs); }
.bsod-subtitle { font-size: var(--fs-xs); opacity: 0.85; margin-bottom: var(--gap-sm); line-height: 1.7; }
.bsod-code { font-size: 10px; opacity: 0.6; margin-bottom: var(--gap-md); letter-spacing: 0.04em; }
.bsod-pct { font-size: var(--fs-sm); margin-bottom: var(--gap-xs); }
.bsod-bar-wrap { width: 200px; height: 5px; background: rgba(255,255,255,0.2); overflow: hidden; margin-bottom: var(--gap-md); }
.bsod-bar { height: 100%; background: #fff; width: 0; transition: width 3.5s linear; }
.bsod-btns { display: flex; gap: var(--gap-sm); }
.bsod-btn {
  padding: 7px 18px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.5);
  color: var(--c-white); font-family: inherit; font-size: var(--fs-xs); cursor: pointer;
  transition: background 0.15s;
}
.bsod-btn:hover { background: rgba(255,255,255,0.3); }
.bsod-hint { font-size: 10px; opacity: 0.5; margin-top: 10px; min-height: 14px; }

/* Snake game */
#snake-wrap {
  position: absolute; inset: 50px 0 44px 0; display: none; flex-direction: column;
  background: var(--code-bg);
}
#snake-wrap.active { display: flex; }
#sw-bar {
  display: flex; justify-content: space-between; padding: 8px 16px;
  font-family: 'SF Mono',monospace; font-size: 11px; color: var(--or2);
  background: rgba(255,90,31,0.06); border-bottom: 1px solid rgba(255,90,31,0.15);
  flex-shrink: 0;
}
#sov-canvas { flex: 1; display: block; width: 100%; }
#sov-msg {
  text-align: center; font-size: var(--fs-sm); color: var(--txt2);
  font-family: 'SF Mono',monospace; padding: 12px;
  position: absolute; bottom: 8px; left: 0; right: 0;
}

/* ── SECTIONS ────────────────────────────────────────────────────────── */
section { padding: 88px 0; border-top: 1px solid var(--bdr); background: var(--bg); }
section.alt { background: var(--bg2); }
.s-kicker {
  font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--or); display: flex; align-items: center; gap: var(--gap-sm); margin-bottom: 18px;
}
.s-kicker::after { content: ''; width: 40px; height: 2px; background: var(--or); opacity: 0.5; }
h2 {
  font-family: 'Unbounded', sans-serif; font-size: clamp(28px, 4vw, 48px);
  font-weight: 900; line-height: 1.05; letter-spacing: -0.025em; color: var(--txt); margin-bottom: var(--gap-md);
}
h2 em { font-style: normal; color: var(--or2); }
.s-lead { font-size: var(--fs-lg); color: var(--txt2); max-width: 600px; margin-bottom: 52px; line-height: 1.75; }
.ico { width: 20px; height: 20px; display: inline-block; flex-shrink: 0; vertical-align: middle; }
.ico-sm { width: 16px; height: 16px; }
.ico-lg { width: 24px; height: 24px; }

/* ── WHY ─────────────────────────────────────────────────────────────── */
.grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-md); }
.why-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-sm); padding: 32px 28px; transition: border-color 0.25s, transform 0.25s; cursor: pointer; }
.why-card:hover { border-color: rgba(255,90,31,0.3); transform: translateY(-3px); }
.why-marker { width: 36px; height: 4px; background: var(--or); border-radius: 2px; margin-bottom: var(--gap-lg); }
.why-title { font-size: var(--fs-lg); font-weight: 700; color: var(--txt); margin-bottom: var(--gap-sm); line-height: 1.3; }
.why-text { font-size: var(--fs-md); color: var(--txt2); line-height: 1.7; }

/* ── TRACKS ──────────────────────────────────────────────────────────── */
.grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--gap-md); }
.track-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-sm); padding: 24px 20px; transition: border-color 0.2s, transform 0.2s; }
.track-card:hover { border-color: rgba(255,90,31,0.25); transform: translateY(-2px); }
.track-age { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--or); margin-bottom: var(--gap-sm); font-family: 'SF Mono',monospace; }
.track-name { font-size: var(--fs-lg); font-weight: 700; color: var(--txt); margin-bottom: var(--gap-sm); line-height: 1.3; }
.track-sep { height: 1px; background: var(--bdr); margin-bottom: var(--gap-sm); }
.track-res { font-size: var(--fs-md); color: var(--txt2); line-height: 1.6; }

/* ── HACKATHON ───────────────────────────────────────────────────────── */
.hackathon-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-2xl); align-items: center; }
.hack-steps { display: flex; flex-direction: column; }
.hack-step { display: flex; gap: var(--gap-lg); align-items: flex-start; padding: 24px 0; border-bottom: 1px solid var(--bdr); }
.hack-step:first-child { padding-top: 0; }
.hack-step:last-child { border-bottom: none; }
.hack-num { font-family: 'Unbounded', sans-serif; font-size: 32px; font-weight: 900; color: rgba(255,90,31,0.55); line-height: 1; flex-shrink: 0; width: 48px; }
.hack-title { font-size: var(--fs-md); font-weight: 700; color: var(--txt); margin-bottom: var(--gap-xs); }
.hack-text { font-size: var(--fs-md); color: var(--txt2); line-height: 1.7; }
.hack-visual { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 40px 36px; text-align: center; }
.hack-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap-xs); }
.hack-tag { font-size: var(--fs-sm); font-weight: 600; background: var(--surface); border: 1px solid var(--bdr2); color: var(--txt2); padding: 8px 16px; border-radius: var(--r-xs); }
.role-badge { font-size: var(--fs-sm); font-weight: 600; background: var(--surface); border: 1px solid var(--bdr2); color: var(--txt2); padding: 8px 16px; border-radius: var(--r-xs); cursor: pointer; transition: all 0.2s; }
.role-badge:hover, .role-badge.active-role { background: rgba(255,90,31,0.12); border-color: rgba(255,90,31,0.4); color: var(--or2); }

/* ── POOL ────────────────────────────────────────────────────────────── */
.pool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-2xl); align-items: center; }
.pool-img-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-sm); }
.pool-img-btn { background: none; border: none; padding: 0; cursor: pointer; border-radius: var(--r-sm); overflow: hidden; display: block; }
.pool-img-btn:first-child { grid-column: span 2; }
.pool-img-btn img { border-radius: var(--r-sm); width: 100%; height: 150px; object-fit: cover; transition: transform 0.3s; display: block; }
.pool-img-btn:hover img { transform: scale(1.04); }
.pool-img-btn:first-child img { height: 190px; }
.pool-features { display: flex; flex-direction: column; gap: var(--gap-md); margin-top: var(--gap-lg); }
.pool-feature { display: flex; gap: var(--gap-md); align-items: flex-start; }
.pool-feature-icon { width: 44px; height: 44px; border-radius: var(--r-sm); background: rgba(255,90,31,0.1); border: 1px solid rgba(255,90,31,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--or2); }
.pool-feature-title { font-size: var(--fs-md); font-weight: 700; color: var(--txt); margin-bottom: 2px; }
.pool-feature-text { font-size: var(--fs-md); color: var(--txt2); line-height: 1.6; }

/* ── PRICING ─────────────────────────────────────────────────────────── */
.smeny-tabs { display: flex; gap: var(--gap-xs); margin-bottom: var(--gap-xl); flex-wrap: wrap; }
.stab { padding: 11px 22px; border-radius: var(--r-xs); font-size: var(--fs-base); font-weight: 600; background: var(--bg3); border: 1px solid var(--bdr); cursor: pointer; color: var(--txt2); transition: all 0.2s; }
.stab.active { background: var(--or); border-color: var(--or); color: var(--c-white); }
.stab:hover:not(.active) { border-color: var(--bdr2); color: var(--txt); }
.calc-box { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 40px; margin-bottom: var(--gap-xl); }
.slider-row { display: flex; align-items: center; gap: var(--gap-lg); margin-bottom: var(--gap-sm); }
.slider-label { font-size: var(--fs-md); font-weight: 600; color: var(--txt); white-space: nowrap; }
.slider-val { font-family: 'Unbounded', sans-serif; font-size: var(--fs-3xl); font-weight: 900; color: var(--or2); min-width: 48px; }
input[type=range] { flex: 1; -webkit-appearance: none; appearance: none; height: 6px; background: var(--bg4); border-radius: 3px; outline: none; touch-action: pan-x; }
input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; background: var(--or); cursor: pointer; box-shadow: 0 0 0 4px rgba(255,90,31,0.2); transition: box-shadow 0.2s; }
input[type=range]::-webkit-slider-thumb:hover { box-shadow: 0 0 0 7px rgba(255,90,31,0.3); }
input[type=range]::-moz-range-thumb { width: 28px; height: 28px; border-radius: 50%; background: var(--or); border: none; cursor: pointer; box-shadow: 0 0 0 4px rgba(255,90,31,0.2); }
.calc-results { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-md); margin-top: 32px; }
.calc-res { background: var(--bg2); border: 1px solid var(--bdr); border-radius: var(--r-sm); padding: 20px; }
.calc-res-label { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--txt2); margin-bottom: var(--gap-xs); font-family: 'SF Mono',monospace; }
.calc-res-val { font-family: 'Unbounded', sans-serif; font-size: 22px; font-weight: 900; color: var(--txt); line-height: 1.1; }
.calc-res-val.green { color: var(--green); }
.calc-res-val.orange { color: var(--or2); }
.calc-res-sub { font-size: var(--fs-sm); color: var(--txt2); margin-top: var(--gap-xs); }
.transfer-note { background: rgba(255,90,31,0.07); border: 1px solid rgba(255,90,31,0.25); border-radius: var(--r-sm); padding: 18px 24px; font-size: var(--fs-base); color: var(--txt2); line-height: 1.7; display: none; }
.transfer-note strong { color: var(--or2); }
.transfer-note.show { display: block; }

/* ── TAX ─────────────────────────────────────────────────────────────── */
.tax-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--gap-2xl); align-items: center; }
.tax-calc-box { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 36px; }
.tax-row { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--bdr); }
.tax-row:last-child { border-bottom: none; }
.tax-row-label { font-size: var(--fs-base); color: var(--txt2); }
.tax-row-val { font-size: var(--fs-md); font-weight: 700; color: var(--txt); font-family: 'Unbounded', sans-serif; }
.tax-row.highlight .tax-row-val { color: var(--green); font-size: 22px; }
.tax-steps { list-style: none; display: flex; flex-direction: column; gap: var(--gap-lg); }
.tax-step { display: flex; gap: 20px; align-items: flex-start; }
.tax-step-num { font-family: 'Unbounded', sans-serif; font-size: var(--fs-3xl); font-weight: 900; color: var(--or2); line-height: 1; flex-shrink: 0; width: 40px; }
.tax-step-title { font-size: var(--fs-md); font-weight: 700; color: var(--txt); margin-bottom: var(--gap-xs); }
.tax-step-text { font-size: var(--fs-base); color: var(--txt2); line-height: 1.65; }

/* ── GALLERY ─────────────────────────────────────────────────────────── */
.gallery-tabs { display: flex; gap: var(--gap-xs); margin-bottom: var(--gap-lg); flex-wrap: wrap; }
.gtab { padding: 8px 18px; border-radius: var(--r-xs); font-size: var(--fs-sm); font-weight: 600; background: var(--bg3); border: 1px solid var(--bdr); cursor: pointer; color: var(--txt2); transition: all 0.2s; }
.gtab.active { background: var(--or); border-color: var(--or); color: var(--c-white); }
.gtab:hover:not(.active) { border-color: var(--bdr2); color: var(--txt); }
.gallery-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-sm); }
.gallery-grid .big { grid-column: span 2; }
.gallery-item { border-radius: var(--r-sm); overflow: hidden; aspect-ratio: 4/3; background: var(--bg3); position: relative; cursor: pointer; }
.gallery-item.big { aspect-ratio: 16/9; }
.gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.gallery-item:hover img { transform: scale(1.04); }
.gallery-item-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0); transition: background 0.3s; display: flex; align-items: center; justify-content: center; }
.gallery-item:hover .gallery-item-overlay { background: rgba(0,0,0,0.3); }
.gallery-item-overlay svg { opacity: 0; transition: opacity 0.3s; color: white; }
.gallery-item:hover .gallery-item-overlay svg { opacity: 1; }
.gal-pill { border-radius: var(--r-full); padding: 6px 16px; font-size: var(--fs-sm); font-weight: 500; border: 1px solid var(--bdr); cursor: pointer; background: var(--bg3); color: var(--txt2); transition: all 0.15s; font-family: inherit; }
.gal-pill.active { background: var(--or) !important; color: #fff !important; border-color: var(--or) !important; }
.gal-pill:not(.active):hover { color: var(--txt); border-color: var(--bdr2); }

/* ── VIDEO ───────────────────────────────────────────────────────────── */
.vid-tab-btn { padding: 8px 20px; border-radius: var(--r-xs); font-size: var(--fs-sm); font-weight: 600; background: var(--bg3); border: 1px solid var(--bdr); cursor: pointer; color: var(--txt2); transition: all 0.2s; }
.vid-tab-btn.active { background: var(--or); border-color: var(--or); color: var(--c-white); }
.vid-tab-btn:hover:not(.active) { border-color: var(--bdr2); color: var(--txt); }
.vid-card-btn { background: none; border: none; padding: 0; cursor: pointer; text-align: left; width: 100%; }
.vid-card-thumb { position: relative; overflow: hidden; border-radius: var(--r-xl); aspect-ratio: 9/16; }
.vid-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.vid-card-btn:hover .vid-card-thumb img { transform: scale(1.05); }
.vid-play-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.2); }
.vid-play-icon { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; color: var(--or); }
.vid-card-title { margin-top: var(--gap-xs); font-size: var(--fs-sm); font-weight: 600; color: var(--txt); line-height: 1.4; }

/* ── REVIEWS ─────────────────────────────────────────────────────────── */
.reviews-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-md); }
.review-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-sm); padding: 28px; transition: border-color 0.2s, transform 0.2s; display: flex; flex-direction: column; }
.review-card:hover { border-color: var(--bdr2); transform: translateY(-2px); }
.review-top { display: flex; align-items: center; gap: var(--gap-sm); margin-bottom: var(--gap-md); }
.review-avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: var(--bg4); display: flex; align-items: center; justify-content: center; color: var(--or); font-weight: 700; font-size: var(--fs-lg); }
.review-avatar img { width: 100%; height: 100%; object-fit: cover; }
.review-name { font-size: var(--fs-base); font-weight: 700; color: var(--txt); }
.review-meta-text { font-size: var(--fs-sm); color: var(--txt2); margin-top: 2px; }
.review-stars { margin-left: auto; color: var(--or2); font-size: var(--fs-sm); letter-spacing: 1px; }
.review-text { font-size: var(--fs-base); color: var(--txt2); line-height: 1.75; flex: 1; font-style: italic; }
.review-sep { height: 1px; background: var(--bdr); margin: 16px 0; }
.review-more-btn { font-size: var(--fs-sm); color: var(--or2); background: none; border: none; cursor: pointer; padding: 0; margin-top: var(--gap-xs); font-family: inherit; text-decoration: underline; text-underline-offset: 3px; }
.rv-card { border: 1px solid var(--bdr); background: var(--bg3); border-radius: var(--r-xl); padding: 16px; display: flex; flex-direction: column; }

/* ── TEAM ────────────────────────────────────────────────────────────── */
.team-layout { display: grid; grid-template-columns: 320px 1fr; gap: 40px; align-items: start; }
.book-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-md); padding: 28px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.team-members-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-md); }
.team-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-sm); overflow: hidden; transition: border-color 0.2s, transform 0.2s; display: flex; }
.team-card:hover { border-color: rgba(255,90,31,0.25); transform: translateY(-2px); }
.team-info { padding: 16px 18px; }
.team-name { font-size: var(--fs-base); font-weight: 700; color: var(--txt); margin-bottom: 3px; }
.team-role { font-size: var(--fs-xs); color: var(--or2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--gap-xs); }
.team-bio { font-size: var(--fs-md); color: var(--txt2); line-height: 1.6; }
.btn-sm { display: inline-flex; align-items: center; gap: var(--gap-xs); padding: 10px 20px; border-radius: var(--r-xs); font-size: var(--fs-sm); font-weight: 600; transition: all 0.2s; width: 100%; justify-content: center; text-decoration: none; }
.btn-sm-primary { background: var(--or); color: var(--c-white); }
.btn-sm-primary:hover { background: var(--or2); }

/* ── REFUND ──────────────────────────────────────────────────────────── */
.refund-table { display: flex; flex-direction: column; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--bdr); margin-top: var(--gap-md); }
.refund-row { display: flex; align-items: center; justify-content: space-between; gap: var(--gap-sm); padding: 12px 16px; border-bottom: 1px solid var(--bdr); }
.refund-row:last-child { border-bottom: none; }

/* ── FAQ ─────────────────────────────────────────────────────────────── */
.faq-item { border: 1px solid var(--bdr); border-radius: var(--r-md); background: var(--bg3); margin-bottom: var(--gap-xs); overflow: hidden; }
.faq-item summary { padding: 16px 20px; font-size: var(--fs-base); font-weight: 600; color: var(--txt); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; font-size: var(--fs-xl); color: var(--or2); flex-shrink: 0; transition: transform 0.2s; }
.faq-item[open] summary::after { transform: rotate(45deg); }
.faq-ans { padding: 0 20px 16px; font-size: var(--fs-md); color: var(--txt2); line-height: 1.65; }
.faq-panel { display: none; }
.faq-panel.active { display: block; }

/* ── CONTACTS ────────────────────────────────────────────────────────── */
.contacts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-2xl); align-items: start; }
.contact-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-sm); }
.contact-card { background: var(--bg3); border: 1px solid var(--bdr); border-radius: var(--r-sm); padding: 20px 22px; display: flex; flex-direction: column; gap: 5px; transition: border-color 0.2s, transform 0.15s; text-decoration: none; }
.contact-card:hover { border-color: rgba(255,90,31,0.3); transform: translateY(-2px); }
.contact-card-inner { display: flex; align-items: center; gap: var(--gap-sm); }
.contact-type { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--txt2); font-family: 'SF Mono',monospace; }
.contact-val { font-size: var(--fs-md); font-weight: 700; color: var(--txt); }
.corp-note { background: rgba(255,90,31,0.07); border: 1px solid rgba(255,90,31,0.25); border-radius: var(--r-sm); padding: 20px 24px; margin-top: var(--gap-md); font-size: var(--fs-md); color: var(--txt2); line-height: 1.7; }
.corp-note strong { color: var(--or2); font-weight: 700; }

/* ── FOOTER ──────────────────────────────────────────────────────────── */
footer { border-top: 1px solid var(--bdr); background: var(--bg); padding: 28px 0; }
.footer-inner { max-width: 1100px; margin: 0 auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--gap-sm); }
.footer-brand { font-family: 'Unbounded', sans-serif; font-size: var(--fs-md); font-weight: 900; color: var(--txt); }
.footer-brand em { font-style: normal; color: var(--or2); }
.footer-note { font-size: var(--fs-sm); color: var(--txt2); }

/* ── REVEAL ──────────────────────────────────────────────────────────── */
.r { opacity: 0; transform: translateY(20px); transition: opacity 0.55s ease, transform 0.55s ease; }
.r.in { opacity: 1; transform: none; }

/* ── RESPONSIVE ──────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .hero-content { grid-template-columns: 1fr; gap: 48px; }
  .terminal { max-width: 500px; }
}
@media (max-width: 768px) {
  section { padding: 60px 0; }
  .wrap { padding: 0 16px; }
  .nav-inner { padding: 0 16px; }
  .footer-inner { padding: 0 16px; }
  .grid-3, .grid-4, .reviews-grid { grid-template-columns: 1fr 1fr; }
  .hackathon-grid, .tax-grid, .contacts-grid, .pool-grid { grid-template-columns: 1fr; }
  .hero-content { gap: 36px; }
  .hero { padding: 90px 16px 60px; }
  .nav-badge { display: none; }
  .team-members-grid { grid-template-columns: 1fr 1fr; }
  .calc-results { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  section { padding: 48px 0; }
  h2 { line-height: var(--lh-snug); letter-spacing: -0.015em; }
  .grid-3, .grid-4, .reviews-grid { grid-template-columns: 1fr; }
  .contact-cards { grid-template-columns: 1fr; }
  .team-members-grid { grid-template-columns: 1fr; }
  .calc-results { grid-template-columns: 1fr; }
  .terminal { height: 380px; }
  .hero-content { grid-template-columns: 1fr; }
  .hero { min-height: auto; padding: 80px 16px 48px; }
}
    </style>
  </head>

  <body>
    <!-- Matrix rain background -->
    <canvas id="hero-canvas" aria-hidden="true"></canvas>

    <slot />

    <!-- Back to top -->
    <button
      id="back-top-btn"
      aria-label="Наверх"
      style="display:none;position:fixed;right:14px;bottom:24px;z-index:9999;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,90,31,0.35);cursor:pointer;background:rgba(255,90,31,0.18);backdrop-filter:blur(10px);color:rgba(255,255,255,0.85);font-size:var(--fs-lg);box-shadow:0 2px 12px rgba(0,0,0,0.25);align-items:center;justify-content:center;opacity:0;transform:scale(0.7) translateY(8px);transition:opacity 0.3s, transform 0.3s;"
    >↑</button>

    <script>
      // ── Theme: restore from localStorage ──────────────────────────
      const saved = localStorage.getItem('corp-theme');
      const html = document.documentElement;
      if (saved === 'dark') html.setAttribute('data-theme', 'dark');
      else html.setAttribute('data-theme', 'light');

      // ── Theme toggle ───────────────────────────────────────────────
      const themeBtn = document.getElementById('themeBtn') as HTMLElement | null;
      const icoMoon = document.getElementById('ico-moon') as HTMLElement | null;
      const icoSun = document.getElementById('ico-sun') as HTMLElement | null;

      function syncIcons(theme: string) {
        if (icoMoon) icoMoon.style.display = theme === 'dark' ? 'none' : 'block';
        if (icoSun)  icoSun.style.display  = theme === 'dark' ? 'block' : 'none';
      }
      syncIcons(html.getAttribute('data-theme') || 'light');

      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('corp-theme', next);
          syncIcons(next);
        });
      }

      // ── Matrix rain ────────────────────────────────────────────────
      (function() {
        const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let cols: number[] = [];
        const CHARS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ01アイウエオabcdefABCDEF{}<>/|\\'.split('');
        const FS = 14;

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          const numCols = Math.floor(canvas.width / FS);
          cols = Array.from({ length: numCols }, () => Math.random() * canvas.height / FS | 0);
        }
        resize();
        window.addEventListener('resize', resize);

        function draw() {
          const theme = document.documentElement.getAttribute('data-theme');
          ctx.fillStyle = theme === 'light' ? 'rgba(244,245,248,0.15)' : 'rgba(12,14,17,0.15)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#FF5A1F';
          ctx.font = `${FS}px 'SF Mono', monospace`;
          cols.forEach((y, i) => {
            const ch = CHARS[Math.random() * CHARS.length | 0];
            const x = i * FS;
            ctx.fillText(ch, x, y * FS);
            if (y * FS > canvas.height && Math.random() > 0.975) cols[i] = 0;
            else cols[i] = y + 1;
          });
        }
        setInterval(draw, 50);
      })();

      // ── Reveal on scroll ───────────────────────────────────────────
      const io = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('in');
            io.unobserve(e.target);
          }
        }),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      // ── Back to top ────────────────────────────────────────────────
      const backBtn = document.getElementById('back-top-btn') as HTMLElement | null;
      if (backBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backBtn.style.display = 'flex';
            backBtn.style.opacity = '1';
            backBtn.style.transform = 'scale(1) translateY(0)';
            backBtn.style.pointerEvents = 'auto';
          } else {
            backBtn.style.opacity = '0';
            backBtn.style.transform = 'scale(0.7) translateY(8px)';
            backBtn.style.pointerEvents = 'none';
          }
        });
        backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
