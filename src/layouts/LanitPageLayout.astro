---
import type { AstroComponentFactory } from 'astro';
import '../styles/icons.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title = 'ЛАНИТ — IT лагерь онлайн', description = 'Обучение программированию в онлайн-формате с менторами ЛАНИТ', ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{title}</title>

    <!-- Design System CSS -->
    <style define:vars={{
      '--bg': '#0C0E11',
      '--bg2': '#111418',
      '--bg3': '#181C22',
      '--bg4': '#1F2530',
      '--bdr': 'rgba(255,255,255,0.07)',
      '--txt': '#E4E6EF',
      '--txt2': '#9098AB',
      '--or': '#FF5A1F',
      '--or2': '#FF7A3D',
      '--green': '#22C76A',
      '--blue': '#4A9EFF',
      '--surface': 'rgba(255,255,255,0.04)',
      '--shadow': '0 24px 64px rgba(0,0,0,0.55)',
      '--code-bg': '#0F1419',
      '--ck': '#FF7B72',
      '--cf': '#D2A8FF',
      '--cs': '#A5D6FF',
      '--cn': '#FFA657',
      '--cc': '#6E7681',
    }}>
      :root {
        --bg: var(--bg);
        --bg2: var(--bg2);
        --bg3: var(--bg3);
        --bg4: var(--bg4);
        --bdr: var(--bdr);
        --txt: var(--txt);
        --txt2: var(--txt2);
        --or: var(--or);
        --or2: var(--or2);
        --green: var(--green);
        --blue: var(--blue);
        --surface: var(--surface);
        --shadow: var(--shadow);
        --code-bg: var(--code-bg);
        --ck: var(--ck);
        --cf: var(--cf);
        --cs: var(--cs);
        --cn: var(--cn);
        --cc: var(--cc);
      }

      [data-theme="light"] {
        --bg: #F4F5F8;
        --bg2: #FFFFFF;
        --bg3: #EEEFF3;
        --bg4: #E4E6EF;
        --bdr: rgba(0, 0, 0, 0.08);
        --txt: #0C0E11;
        --txt2: #5A6471;
        --or: #FF5A1F;
        --or2: #FF7A3D;
        --green: #17A557;
        --blue: #0A7BC2;
        --surface: rgba(0, 0, 0, 0.03);
        --shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        --code-bg: #FAFBFC;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }

      body {
        background-color: var(--bg);
        color: var(--txt);
        transition: background-color 0.2s, color 0.2s;
      }

      .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
      }

      @media (max-width: 1024px) {
        .wrap {
          padding: 0 20px;
        }
      }

      @media (max-width: 768px) {
        .wrap {
          padding: 0 16px;
        }
      }

      @media (max-width: 520px) {
        .wrap {
          padding: 0 12px;
        }
      }

      /* Grid layouts */
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }

      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }

      @media (max-width: 1024px) {
        .grid-3 { grid-template-columns: repeat(2, 1fr); }
        .grid-4 { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 640px) {
        .grid-3 { grid-template-columns: 1fr; }
        .grid-4 { grid-template-columns: 1fr; }
      }

      /* Reveal animation */
      .r {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .r.in {
        opacity: 1;
        transform: translateY(0);
      }

      /* Bootstrap Icons */
      .bi {
        display: inline-block;
        width: 1em;
        height: 1em;
        vertical-align: -0.125em;
        background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Cpath fill=%22currentColor%22/%3E%3C/svg%3E');
        background-repeat: no-repeat;
        background-size: 1em 1em;
      }
    </style>
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript" is:inline>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js', 'ym');

      if (!window.ym_disable96499295 && !window._ymInited) {
        window._ymInited = true;
        ym(96499295, 'init', {clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:false});
      }
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>

  <body>
    <!-- noscript-фолбэк Метрики: в body (в head div внутри noscript невалиден) -->
    <noscript><img src="https://mc.yandex.ru/watch/96499295" style="position:absolute;left:-9999px" alt="" /></noscript>
    <nav class="nav">
      <div class="wrap nav-inner">
        <div class="logo">ЛАНИТ</div>
        <div class="nav-right">
          <a href="tel:+79990001234" class="tel">+7 999 000-12-34</a>
          <button id="theme-btn" class="theme-btn" aria-label="Toggle theme">
            <span class="theme-icon">🌙</span>
          </button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p>&copy; 2024 ЛАНИТ. Все права защищены.</p>
      </div>
    </footer>

    <script>
      // Theme toggle
      const html = document.documentElement;
      const saved = localStorage.getItem('theme') || 'dark';
      html.dataset.theme = saved;

      const themeBtn = document.getElementById('theme-btn');
      themeBtn?.addEventListener('click', () => {
        const t = html.dataset.theme === 'dark' ? 'light' : 'dark';
        html.dataset.theme = t;
        localStorage.setItem('theme', t);
      });

      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('in');
            }, idx * 70);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.06 });

      document.querySelectorAll('.r').forEach((el) => observer.observe(el));
    </script>

    <style is:global>
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 64px;
        background-color: var(--bg);
        border-bottom: 1px solid var(--bdr);
        backdrop-filter: blur(10px);
        z-index: 1000;
      }

      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 100%;
      }

      .logo {
        font-size: 18px;
        font-weight: 600;
        color: var(--or);
        letter-spacing: 2px;
      }

      .nav-right {
        display: flex;
        gap: 24px;
        align-items: center;
      }

      .tel {
        color: var(--txt);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
      }

      .theme-btn {
        background: none;
        border: none;
        color: var(--txt);
        cursor: pointer;
        font-size: 20px;
        padding: 4px;
      }

      main {
        margin-top: 64px;
      }

      .footer {
        background-color: var(--bg2);
        border-top: 1px solid var(--bdr);
        padding: 40px 0;
        margin-top: 120px;
        text-align: center;
        color: var(--txt2);
        font-size: 14px;
      }
    </style>
  </body>
</html>
