---
import '../styles/global.css';
import '../styles/icons.css';
import '../styles/portal.css';
import '../styles/portal-modal.css';
import UploadQueueIndicator from '../components/UploadQueueIndicator.astro';
import ToastInit from '../components/portal/ToastInit.astro';
import MediaLightbox from '../components/portal/MediaLightbox.astro';
import VoiceInput from '../components/portal/VoiceInput.astro';
import { ROLE_LABELS } from '../lib/portalPerms';

interface Props {
  title: string;
  showHeader?: boolean;
}

const { title, showHeader = true } = Astro.props;

// Показываем «← Назад» когда мы НЕ на главной портала.
const pathNow = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showBack = pathNow !== '/portal' && pathNow !== '';

const realRole = Astro.locals.portalRole ?? null;
const portalName = Astro.locals.portalName ?? null;
const roleLabel = realRole ? (ROLE_LABELS[realRole] ?? realRole) : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-page text-body antialiased">
    {showHeader && (
      <header
        class="border-b border-border bg-white"
        style="padding-top: var(--tg-safe-top, 0px); padding-right: var(--tg-safe-right, 0px);"
      >
        <div class="mx-auto max-w-6xl px-3 py-2 md:px-4 md:py-3">
          {/* Логотип AidaCamp — отдельный верхний ряд, чтобы попасть в свободную зону
              между «Закрыть» и «⌄⋯» от Telegram WebApp */}
          <div class="flex justify-center md:hidden">
            <a href="/portal/"
               class="text-[18px] font-extrabold tracking-[-0.02em] text-navy-950"
               aria-label="AidaCamp">
              <span class="text-primary">Aida</span><span>Camp</span>
            </a>
          </div>
          {/* Иконки + Назад — отдельный нижний ряд */}
          <div class="mt-2 flex items-center justify-between gap-2 md:mt-0">
            <div class="flex items-center gap-2">
              {showBack && (
                <a href="/portal/"
                   data-portal-back
                   onclick="if (document.referrer && new URL(document.referrer).origin === location.origin && document.referrer !== location.href) { event.preventDefault(); history.back(); }"
                   class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border border-border bg-white text-body-muted transition hover:border-primary hover:text-primary md:h-auto md:w-auto md:gap-1 md:px-3 md:py-1.5"
                   title="Назад"
                   aria-label="Назад">
                  <i class="bi bi-arrow-left text-base" aria-hidden="true"></i>
                  <span class="hidden md:inline">Назад</span>
                </a>
              )}
              <a href="/portal/"
                 class="hidden shrink-0 text-[20px] font-extrabold tracking-[-0.02em] text-navy-950 md:inline"
                 aria-label="AidaCamp">
                <span class="text-primary">Aida</span><span>Camp</span>
              </a>
              {realRole && (
                <span
                  class="inline-flex min-w-0 items-center gap-1.5 rounded-full border border-border bg-page px-2.5 py-1 text-base"
                  title={`Вы вошли как ${portalName ? portalName + ' — ' : ''}${roleLabel}`}
                >
                  <i class="bi bi-person-circle text-base text-primary" aria-hidden="true"></i>
                  {portalName && (
                    <span class="max-w-[110px] truncate font-medium text-navy-950 md:max-w-[220px]">{portalName}</span>
                  )}
                  <span class="shrink-0 text-body-muted">{roleLabel}</span>
                </span>
              )}
            </div>
            <div class="flex items-center gap-1.5">
            <UploadQueueIndicator />
            <ToastInit />
            <MediaLightbox />
            <VoiceInput />
            {/* Кнопка обновления страницы (reload) */}
            <button
              type="button"
              onclick="location.reload()"
              title="Обновить страницу"
              aria-label="Обновить страницу"
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border border-border bg-white text-body-muted transition hover:border-primary hover:text-primary"
            >
              <i class="bi bi-arrow-clockwise text-[16px]" aria-hidden="true"></i>
            </button>
            {/* Сброс сессии — менее заметная кнопка */}
            <form method="POST" action="/api/portal/logout" class="shrink-0">
              <button
                type="submit"
                title="Сбросить сессию и войти заново"
                aria-label="Выйти"
                class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border border-border bg-white text-body-muted/50 transition hover:border-red-300 hover:text-red-500"
              >
                <i class="bi bi-door-open text-base" aria-hidden="true"></i>
              </button>
            </form>
          </div>
          </div>
        </div>
      </header>
    )}
    <main class="mx-auto max-w-6xl px-4 py-10 md:py-16">
      <slot />
    </main>

    <!-- Лента загруженных фото/видео по событию. -->
    <script is:inline>
      (() => {
        const escapeHtml = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        function fmtTime(iso) {
          if (!iso) return '';
          try {
            const d = new Date(iso);
            const dd = String(d.getDate()).padStart(2, '0');
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const hh = String(d.getHours()).padStart(2, '0');
            const mi = String(d.getMinutes()).padStart(2, '0');
            return dd + '.' + mm + ' ' + hh + ':' + mi;
          } catch { return ''; }
        }
        async function load(root) {
          const eventId = root.dataset.eventId;
          const canDelete = root.dataset.canDelete === 'true';
          if (!eventId) return;
          const list = root.querySelector('.portal-media__list');
          const header = root.querySelector('.portal-media__header');
          if (!list || !header) return;
          try {
            const r = await fetch('/api/portal/photo?event_id=' + encodeURIComponent(eventId), { credentials: 'include' });
            if (!r.ok) return;
            const data = await r.json().catch(() => ({}));
            const photos = (data && data.photos) || [];
            if (photos.length === 0) {
              header.classList.add('hidden');
              list.innerHTML = '';
              return;
            }
            header.classList.remove('hidden');
            const iconAttach = '<i class="bi bi-paperclip text-base" aria-hidden="true"></i>';
            header.innerHTML = iconAttach + ' Загружено: ' + photos.length;
            list.innerHTML = photos.map(function(p) {
              const url = p.file_url || '';
              const author = escapeHtml(p.author_name || '');
              const when = fmtTime(p.uploaded_at);
              const isVideo = p.file_type === 'video';
              // Thumbnail: для фото — клик открывает PhotoSwipe-лайтбокс,
              // для видео — нативное «Открыть» в новом табе (PhotoSwipe видео не показывает inline).
              const thumb = url && !isVideo
                ? '<a href="' + escapeHtml(url) + '" class="pswp-thumb shrink-0" data-pswp-width="1600" data-pswp-height="1200" target="_blank" rel="noopener">' +
                    '<img src="' + escapeHtml(url) + '" alt="" loading="lazy" class="h-10 w-10 rounded-[6px] border border-border object-cover" />' +
                  '</a>'
                : (url && isVideo
                    ? '<a href="' + escapeHtml(url) + '" target="_blank" rel="noopener" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] border border-border bg-page text-body-muted"><i class="bi bi-camera-video" aria-hidden="true"></i></a>'
                    : '<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] border border-border bg-page text-body-muted"><i class="bi bi-image" aria-hidden="true"></i></span>');
              const del = canDelete
                ? '<button type="button" class="portal-media__del shrink-0 text-base text-red-600 hover:underline" data-photo-id="' + p.id + '" title="Удалить"><i class="bi bi-x-lg text-[12px]" aria-hidden="true"></i></button>'
                : '';
              return '<li class="flex items-center gap-2 text-body">' +
                thumb +
                '<span class="min-w-0 truncate text-base text-body-muted">' + author + ', ' + when + '</span>' +
                '<span class="ml-auto">' + del + '</span>' +
                '</li>';
            }).join('');
            // Сообщаем lightbox-инициализатору, что в этом root есть новые ссылки
            document.dispatchEvent(new CustomEvent('portal-media:lightbox-rebind', { detail: { eventId: eventId } }));
            list.querySelectorAll('.portal-media__del').forEach(function(b) {
              b.addEventListener('click', async function() {
                if (!confirm('Удалить файл? Это необратимо.')) return;
                const pid = b.dataset.photoId;
                const dr = await fetch('/api/portal/photo/' + encodeURIComponent(pid), { method: 'DELETE', credentials: 'include' });
                if (dr.ok) load(root);
                else alert('Не получилось удалить (' + dr.status + ')');
              });
            });
          } catch (e) { /* silent */ }
        }
        const all = Array.from(document.querySelectorAll('.portal-media'));
        all.forEach(load);
        document.addEventListener('portal-media:refresh', (ev) => {
          const wanted = String(ev.detail && ev.detail.eventId || '');
          all.forEach((root) => {
            if (!wanted || String(root.dataset.eventId) === wanted) load(root);
          });
        });
      })();
    </script>

    <!-- Inline-edit события (teacher/vozhaty правят свои события). -->
    <script is:inline>
      (() => {
        document.querySelectorAll('.portal-edit').forEach((root) => {
          const toggle = root.querySelector('.portal-edit__toggle');
          const form = root.querySelector('.portal-edit__form');
          const cancel = root.querySelector('.portal-edit__cancel');
          const status = root.querySelector('.portal-edit__status');
          const eventId = root.dataset.eventId;
          if (!toggle || !form || !cancel) return;

          toggle.addEventListener('click', () => {
            form.classList.toggle('hidden');
          });
          // Карандашик у заголовка события — открывает ту же форму.
          const titleBtn = document.querySelector('[data-edit-title-for="' + eventId + '"]');
          if (titleBtn) titleBtn.addEventListener('click', () => {
            form.classList.toggle('hidden');
            if (!form.classList.contains('hidden')) form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
          cancel.addEventListener('click', () => {
            form.classList.add('hidden');
          });
          // Удаление события (доступно всем, кто видит форму правки — ограничения сняты).
          const delBtn = root.querySelector('.portal-edit__delete');
          if (delBtn) delBtn.addEventListener('click', async () => {
            if (!confirm('Удалить это событие? Действие необратимо.')) return;
            if (status) { status.textContent = 'Удаляю…'; status.classList.remove('hidden'); }
            try {
              const r = await fetch('/api/portal/shift/event-edit', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ event_id: eventId, delete: true }),
                credentials: 'include',
              });
              const d = await r.json().catch(() => ({}));
              if (r.ok && d.ok) {
                if (status) status.textContent = '✓ Удалено, обновляю…';
                setTimeout(() => window.location.reload(), 300);
              } else if (status) {
                status.textContent = 'Ошибка: ' + (d.error || r.status); status.classList.add('text-red-600');
              }
            } catch (e) {
              if (status) { status.textContent = 'Сетевая ошибка'; status.classList.add('text-red-600'); }
            }
          });
          form.addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const fd = new FormData(form);
            const body = { event_id: eventId };
            for (const [k, v] of fd.entries()) body[k] = v;
            if (status) { status.textContent = 'Сохраняю…'; status.classList.remove('hidden'); }
            try {
              const r = await fetch('/api/portal/shift/event-edit', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(body),
                credentials: 'include',
              });
              const d = await r.json().catch(() => ({}));
              if (r.ok && d.ok) {
                if (status) status.textContent = '✓ Сохранено, обновляю…';
                setTimeout(() => window.location.reload(), 300);
              } else {
                if (status) { status.textContent = 'Ошибка: ' + (d.error || r.status); status.classList.add('text-red-600'); }
              }
            } catch (e) {
              if (status) { status.textContent = 'Сетевая ошибка'; status.classList.add('text-red-600'); }
            }
          });
        });
      })();
    </script>
    <script src="/portal/voice-input.js" defer></script>

    {/* Telegram WebApp — фикс сжатия при свайпе вниз внутри Telegram Mini App.
        Грузим официальный SDK + сразу expand() + блок свайп-вниз (>=Bot API 7.7).
        Вне Telegram скрипт не делает ничего вредного — window.Telegram?.WebApp = undefined. */}
    <script src="https://telegram.org/js/telegram-web-app.js?56" defer></script>
    <script is:inline>
      (function () {
        function init() {
          var tg = (window.Telegram && window.Telegram.WebApp) || null;
          if (!tg) return;
          try { tg.ready(); } catch (e) {}
          try { tg.expand(); } catch (e) {}
          // Bot API 7.7+ — выключает вертикальные свайпы для сворачивания
          try { if (typeof tg.disableVerticalSwipes === 'function') tg.disableVerticalSwipes(); } catch (e) {}
          // Bot API 8.0+ — режим fullscreen на мобильном
          try { if (typeof tg.requestFullscreen === 'function') tg.requestFullscreen(); } catch (e) {}
          // Safe area — иначе пилюли Telegram (Назад/Закрыть/⋯/▾) перекрывают шапку
          function applySafeArea() {
            try {
              var sa = tg.safeAreaInset || {};
              var csa = tg.contentSafeAreaInset || {};
              var top = Math.max(sa.top || 0, csa.top || 0);
              var right = Math.max(sa.right || 0, csa.right || 0);
              // Fullscreen: пилюли «Назад»/«Закрыть»/«▼⋯» занимают ~100px сверху и ~56px справа
              if (tg.isFullscreen) {
                top = Math.max(top, 100);
                right = Math.max(right, 60);
              } else if (window.innerWidth < 640) {
                // Обычный mini-app на мобилке: «Назад» и «⋯» в шапке TG ≈ 52–60px
                top = Math.max(top, 60);
                right = Math.max(right, 48);
              }
              var root = document.documentElement;
              root.style.setProperty('--tg-safe-top', top + 'px');
              root.style.setProperty('--tg-safe-right', right + 'px');
            } catch (e) {}
          }
          applySafeArea();
          // Пересчитываем при изменении safe area (смена ориентации, разворот)
          try {
            tg.onEvent && tg.onEvent('safeAreaChanged', applySafeArea);
            tg.onEvent && tg.onEvent('contentSafeAreaChanged', applySafeArea);
          } catch(e) {}
          // Прячем нашу кнопку «Назад» внутри TG WebApp — используем нативную BackButton,
          // иначе она перекрывается пилюлей «Закрыть» от Telegram.
          try {
            var ourBack = document.querySelector('[data-portal-back]');
            if (ourBack) ourBack.style.display = 'none';
            if (tg.BackButton) {
              var pathNow = (location.pathname.replace(/\/+$/, '') || '/');
              var isPortalRoot = (pathNow === '/portal' || pathNow === '');
              if (isPortalRoot) {
                tg.BackButton.hide();
              } else {
                tg.BackButton.show();
                tg.BackButton.onClick(function () {
                  if (document.referrer && new URL(document.referrer).origin === location.origin && document.referrer !== location.href) {
                    history.back();
                  } else {
                    location.href = '/portal/';
                  }
                });
              }
            }
          } catch (e) {}
          // Закрепить viewport — на iOS Telegram WebApp иногда нужен повторный expand при resize
          try {
            tg.onEvent && tg.onEvent('viewportChanged', function (ev) {
              if (ev && ev.isStateStable === false) return;
              try { tg.expand(); } catch (e) {}
              applySafeArea();
            });
            tg.onEvent && tg.onEvent('safeAreaChanged', applySafeArea);
            tg.onEvent && tg.onEvent('contentSafeAreaChanged', applySafeArea);
            tg.onEvent && tg.onEvent('fullscreenChanged', applySafeArea);
          } catch (e) {}
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
          window.addEventListener('load', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
