---
import '../styles/global.css';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ShiftModal from '../components/ShiftModal.astro';
import MomStory from '../components/MomStory.astro';
import ShiftOccupancy from '../components/ShiftOccupancy.astro';
import GlobalShiftLinkHandler from '../components/GlobalShiftLinkHandler.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { PHONE_MAIN, EMAIL, STAT_RATING, CAMP_PRICE_FROM } from '../data/contacts';
import { reviews } from '../data/reviews';

interface Props {
  title: string;
  description: string;
  h1: string;
  canonical?: string;
  heroImage?: string;
}

const { title, description, h1, canonical, heroImage } = Astro.props;

const reviewCount = reviews.length.toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["SummerCamp", "LocalBusiness"],
  "@id": "https://aidacamp.ru/#camp",
  "name": "АйДаКемп",
  "description": "Детский IT-лагерь для детей 7–15 лет в Подмосковье. Python, AI, Minecraft, бассейн. Каждый ребёнок уезжает с собственным проектом.",
  "url": "https://aidacamp.ru",
  "telephone": PHONE_MAIN,
  "email": EMAIL,
  "priceRange": `от ${CAMP_PRICE_FROM} ₽`,
  "image": "https://aidacamp.ru/images/hero-custom-2026-04-07-1100.avif",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "территория «Санаторий Изумруд»",
    "addressLocality": "Наро-Фоминский городской округ",
    "addressRegion": "Московская область",
    "addressCountry": "RU"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 55.265643,
    "longitude": 36.724185
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": STAT_RATING,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": reviewCount,
    "reviewCount": reviewCount
  },
  "parentOrganization": {
    "@type": "Organization",
    "@id": "https://aidacamp.ru/#organization",
    "name": "АйДаКемп"
  }
};
---

<Base title={title} description={description} ogImage={heroImage} heroPreload={heroImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://aidacamp.ru"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": h1,
      "item": canonical ?? `https://aidacamp.ru${Astro.url.pathname}`
    }
  ]
})} />
    <slot name="head" />
  </Fragment>
  <Header />
  <main class="pb-20 md:pb-0">
    <slot name="hero" />
    <!-- Наличие мест + Дарья — как на главной -->
    <div class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4 lg:pt-12">
      <div class="flex flex-col gap-8 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <ShiftOccupancy />
        <MomStory compact />
      </div>
    </div>
    <slot />
  </main>
  <Footer />
  <ShiftModal />
  <StickyCta />
  <GlobalShiftLinkHandler />
  <FAQSchema />
</Base>
