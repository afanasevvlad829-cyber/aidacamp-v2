---
import '../styles/global.css';
import { ensureTrailingSlash } from '../utils/canonical';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ReturnBanner from '../components/ReturnBanner.astro';
import { PHONE_MAIN, EMAIL, STAT_RATING, CAMP_PRICE_FROM } from '../data/contacts';
import { PRICE_MIN, PRICE_MAX } from '../data/shifts';
const _priceNum = (p: string) => parseInt(p.replace(/[^\d]/g, ''), 10);
import { reviews } from '../data/reviews';

interface Props {
  title: string;
  description: string;
  h1: string;
  canonical?: string;
  heroImage?: string;
  noindex?: boolean;
  /** Сезонный лендинг (осень/зима/весна): скрыть AgeBar-плашку с летними сменами */
  hideAgeBar?: boolean;
}

const { title, description, h1, canonical, heroImage, noindex, hideAgeBar } = Astro.props;

const reviewCount = reviews.length.toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["SummerCamp", "LocalBusiness"],
  "@id": "https://aidacamp.ru/#camp",
  "name": "АйДаКемп",
  "description": "Детский IT-лагерь для детей 7–15 лет в Подмосковье. Python, AI, Minecraft, бассейн. Каждый ребёнок уезжает с собственным проектом.",
  "url": "https://aidacamp.ru",
  "telephone": PHONE_MAIN,
  "email": EMAIL,
  "priceRange": `${PRICE_MIN} – ${PRICE_MAX}`,
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": _priceNum(PRICE_MIN),
    "highPrice": _priceNum(PRICE_MAX),
    "priceCurrency": "RUB",
    "offerCount": 6,
    "availability": "https://schema.org/InStock",
    "url": "https://aidacamp.ru/#shifts"
  },
  "image": "https://aidacamp.ru/images/hero-custom-2026-04-07-1100.avif",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "территория «Санаторий Изумруд»",
    "addressLocality": "Наро-Фоминский городской округ",
    "addressRegion": "Московская область",
    "addressCountry": "RU"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 55.265643,
    "longitude": 36.724185
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": STAT_RATING,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": reviewCount,
    "reviewCount": reviewCount
  },
  "parentOrganization": {
    "@type": "Organization",
    "@id": "https://aidacamp.ru/#organization",
    "name": "АйДаКемп"
  }
};
---

<Base title={title} description={description} ogImage={heroImage} canonical={canonical} noindex={noindex} hideAgeBar={hideAgeBar}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://aidacamp.ru"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": h1,
      "item": ensureTrailingSlash(canonical ?? `https://aidacamp.ru${Astro.url.pathname}`)
    }
  ]
})} />
    <slot name="head" />
  </Fragment>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-primary focus:text-white focus:font-semibold focus:shadow-lg">Перейти к содержимому</a>
  <Header />
  <main id="main-content" class="pb-20 md:pb-0">
    <slot name="hero" />
    <slot />
  </main>
  <Footer />
  <!-- StickyCta убран: контактные облачка (телефон/WA/TG) скрыты — бессмысленны -->
  <!-- ShiftModal и GlobalShiftLinkHandler НЕ дублируем — их уже рендерит Base.astro
       (LandingLayout их не скрывает через hideMarketingWidgets), дубли давали
       duplicate id="shift-modal" на всех LandingLayout-страницах (Labrika, 10.07.2026) -->
  <!-- FAQSchema здесь БОЛЬШЕ НЕ рендерим: <FAQSchema /> без пропов отдавал общесайтовые
       15 вопросов из faq.ts на каждом лендинге — вторым FAQPage поверх локального и
       вдобавок невидимым (видимый accordion берёт вопросы из FAQ.astro). Разметку FAQ
       теперь даёт та же сущность, что рисует вопросы: <FAQ /> либо <FAQSchema items> у
       страниц со своим accordion (31.07.2026) -->
  <!-- ReturnBanner убран: дефицит-плашку заменяет NudgeBanner (приходит из Base) -->
</Base>
