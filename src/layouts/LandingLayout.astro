---
import '../styles/global.css';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ShiftModal from '../components/ShiftModal.astro';
import MomStory from '../components/MomStory.astro';
import ShiftOccupancy from '../components/ShiftOccupancy.astro';
import GlobalShiftLinkHandler from '../components/GlobalShiftLinkHandler.astro';
import FAQSchema from '../components/FAQSchema.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  canonical?: string;
  heroImage?: string;
}

const { title, description, h1, canonical, heroImage } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "name": "АйДаКемп",
  "description": "IT-лагерь для детей 7–14 лет в Подмосковье",
  "url": "https://aidacamp.ru",
  "telephone": "+74951284429",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Наро-Фоминский район",
    "addressRegion": "Московская область",
    "addressCountry": "RU"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 55.265643,
    "longitude": 36.724185
  }
};
---

<Base title={title} description={description}>
  <Fragment slot="head">
    {canonical && <link rel="canonical" href={canonical} />}
    {heroImage && <link rel="preload" as="image" href={heroImage} type="image/avif" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <main class="pb-20 md:pb-0">
    <slot name="hero" />
    <!-- Наличие мест + Дарья — как на главной -->
    <div class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4 lg:pt-12">
      <div class="flex flex-col gap-8 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <ShiftOccupancy />
        <MomStory compact />
      </div>
    </div>
    <slot />
  </main>
  <Footer />
  <ShiftModal />
  <StickyCta />
  <GlobalShiftLinkHandler />
  <FAQSchema />
</Base>
