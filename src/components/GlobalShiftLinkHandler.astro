---
/**
 * Глобальный делегированный click-handler для всех [data-shift-link] —
 * ловит клики по ShiftLink-ам в любой части страницы и открывает ShiftInfoModal
 * через event shift-modal-open (контракт src/scripts/shift-modal.ts:222).
 *
 * Встраивается один раз в LandingLayout.astro — работает для всех лендингов.
 * На главной — через Base.astro или index.astro включать не надо, там уже есть
 * свои обработчики (но handler идемпотентен — можно и вставить).
 */
---

<script>
  function initShiftLinkHandler() {
    if ((window as any).__aidacampShiftLinkHandlerBound) return;
    (window as any).__aidacampShiftLinkHandlerBound = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const link = target?.closest('[data-shift-link]') as HTMLElement | null;
      if (!link) return;
      // data-shift-id — основной атрибут (ShiftLink.astro)
      // data-shift-link="shift-X" — fallback (hero CTA, старые кнопки)
      const shiftId = link.getAttribute('data-shift-id') || link.getAttribute('data-shift-link') || '';
      if (!shiftId) return;
      e.preventDefault();
      (window as any).acTrack?.('shift_link_click', { shiftId });
      window.location.href = `/shifts/${shiftId}/`;
    });
  }
  document.addEventListener('astro:page-load', initShiftLinkHandler);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initShiftLinkHandler(); }, { timeout: 3000 });
  } else {
    setTimeout(initShiftLinkHandler, 200);
  }
</script>
