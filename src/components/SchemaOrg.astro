---
/**
 * Централизованный JSON-LD для главной страницы aidacamp.ru.
 *
 * Включает:
 *  - Organization (бренд АйДаКемп)
 *  - SummerCamp (LocalBusiness subtype) с адресом, контактами, AggregateRating
 *  - ItemList из Event (смены из data/shifts.ts)
 *  - (FAQPage сюда НЕ добавлять — его отдаёт FAQ.astro по видимым вопросам)
 *  - BreadcrumbList
 *  - Person × N (команда преподавателей из data/team.ts) — E-E-A-T
 *
 * Валидатор: https://search.google.com/test/rich-results + Яндекс.Вебмастер → Инструменты → Валидатор.
 */

import { mainShifts, shortShifts, type Shift, PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import { getCurrentPrice } from '../data/dynamicPrices';
import { members as teamMembers } from '../data/team';
import { reviews } from '../data/reviews';
import {
  PHONE_MAIN,
  PHONE_MOBILE,
  EMAIL,
  WHATSAPP_URL,
  TELEGRAM_URL,
  STAT_RATING,
} from '../data/contacts';

const SITE_URL = 'https://aidacamp.ru';
const LOGO_URL = `${SITE_URL}/images/logo-aidacamp.svg`; // если нет — Astro/браузер просто не покажет лого
const HERO_IMAGE = `${SITE_URL}/images/hero-custom-2026-04-07-1100.avif`;

// Цена в рублях из строки "74 900 ₽" → "74900"
const parsePrice = (p: string) => p.replace(/[^\d]/g, '');

// РЕАЛЬНАЯ текущая цена смены — из dynamicPrices.ts (единый источник).
// Фолбэк на статичную строку shifts.ts, если getCurrentPrice вернул null.
const shiftPriceNum = (s: Shift) => getCurrentPrice(s.id) ?? (parseInt(parsePrice(s.price), 10) || 0);

const allShiftsForPrice = [...mainShifts, ...shortShifts];
const prices = allShiftsForPrice.map(shiftPriceNum).filter(Boolean);
const minPrice = Math.min(...prices).toLocaleString('ru-RU');
const maxPrice = Math.max(...prices).toLocaleString('ru-RU');
const priceRange = `${minPrice} ₽ – ${maxPrice} ₽`;

const reviewCount = reviews.length.toString();

// "2 февраля 2026" → "2026-02-02"
const MONTHS: Record<string, string> = {
  января: '01', февраля: '02', марта: '03', апреля: '04', мая: '05', июня: '06',
  июля: '07', августа: '08', сентября: '09', октября: '10', ноября: '11', декабря: '12',
};
const parseDate = (d: string) => {
  const parts = d.split(' ');
  if (parts.length === 3) {
    const day = parts[0].padStart(2, '0');
    const month = MONTHS[parts[1]] ?? '01';
    return `${parts[2]}-${month}-${day}`;
  }
  return d;
};

const allShifts: Shift[] = [...mainShifts, ...shortShifts];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'АйДаКемп',
  legalName: 'ООО «ВОИП КОННЕКТ»',
  taxID: '7729713637',
  alternateName: ['AidaCamp', 'IT-лагерь АйДаКемп'],
  url: SITE_URL,
  logo: LOGO_URL,
  email: EMAIL,
  telephone: PHONE_MAIN,
  foundingDate: '2021',
  description: 'АйДаКемп — загородный IT-лагерь для детей 7–15 лет в Подмосковье, 66 км от МКАД. Работаем с 2021 года, приняли более 1200 детей. Лицензия Минобрнауки Л035-01298-77/01082973, туроператор РТО 025773.',
  knowsAbout: ['Детское программирование', 'Python для детей', 'AI для школьников', 'Minecraft Education', 'Scratch', 'Детские IT-лагеря'],
  identifier: [
    { '@type': 'PropertyValue', name: 'Лицензия Минобрнауки', value: 'Л035-01298-77/01082973' },
    { '@type': 'PropertyValue', name: 'РТО туроператора', value: '025773' },
    { '@type': 'PropertyValue', name: 'ИНН', value: '7729713637' },
  ],
  sameAs: [
    WHATSAPP_URL,
    TELEGRAM_URL,
    'https://vk.com/aidacamp',
    'https://www.youtube.com/@aida_codit',
    'https://t.me/aidacamp_ru',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: PHONE_MAIN,
      contactType: 'customer service',
      areaServed: 'RU',
      availableLanguage: ['Russian'],
    },
    {
      '@type': 'ContactPoint',
      telephone: PHONE_MOBILE,
      contactType: 'customer support',
      areaServed: 'RU',
      availableLanguage: ['Russian'],
    },
  ],
};

const summerCamp = {
  '@context': 'https://schema.org',
  '@type': ['SummerCamp', 'LocalBusiness'],
  '@id': `${SITE_URL}/#camp`,
  name: 'АйДаКемп — детский IT-лагерь',
  description:
    `АйДаКемп — летний IT-лагерь для детей 7–15 лет в Подмосковье, 66 км от Москвы. Python, AI, Minecraft, Scratch, бассейн, 5-разовое питание. Каждый ребёнок уезжает с собственным IT-проектом. Работаем с 2021 года. Лицензия Минобрнауки Л035-01298-77/01082973. От ${PRICE_MIN}.`,
  url: SITE_URL,
  image: HERO_IMAGE,
  telephone: PHONE_MAIN,
  email: EMAIL,
  priceRange,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Наро-Фоминский городской округ',
    addressRegion: 'Московская область',
    addressCountry: 'RU',
    streetAddress: 'территория «Санаторий Изумруд»',
    postalCode: '143381',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '55.265643',
    longitude: '36.724185',
  },
  hasMap: 'https://maps.yandex.ru/?ll=36.724185,55.265643&z=14',
  areaServed: [
    { '@type': 'City', name: 'Москва' },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: STAT_RATING,
    bestRating: '5',
    worstRating: '1',
    ratingCount: reviewCount,
    reviewCount: reviewCount,
  },
  parentOrganization: { '@id': `${SITE_URL}/#organization` },
  sameAs: [
    WHATSAPP_URL,
    TELEGRAM_URL,
  ],
  review: reviews.map(r => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: r.name },
    datePublished: parseDate(r.date),
    reviewBody: r.fullText || r.text,
  })),
};

const eventsList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Смены АйДаКемп ${SEASON_YEAR}`,
  itemListElement: allShifts.map((shift, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': ['EducationEvent', 'ChildrensEvent'],
      '@id': `${SITE_URL}/#event-${shift.id}`,
      name: `${shift.name} — АйДаКемп ${SEASON_YEAR} (${shift.duration})`,
      description: shift.description,
      startDate: shift.startDate,
      endDate: shift.endDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      location: {
        '@type': 'Place',
        name: 'Санаторий Изумруд',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Наро-Фоминский городской округ',
          addressRegion: 'Московская область',
          addressCountry: 'RU',
        },
      },
      organizer: { '@id': `${SITE_URL}/#organization` },
      image: HERO_IMAGE,
      offers: {
        '@type': 'Offer',
        price: String(shiftPriceNum(shift)),
        priceCurrency: 'RUB',
        availability:
          shift.free > 0
            ? 'https://schema.org/InStock'
            : 'https://schema.org/SoldOut',
        url: `${SITE_URL}/#shifts`,
        validFrom: '2026-01-01',
      },
      audience: {
        '@type': 'PeopleAudience',
        suggestedMinAge: 7,
        suggestedMaxAge: 15,
      },
    },
  })),
};

// FAQPage здесь БОЛЬШЕ НЕТ: 13 захардкоженных вопросов не совпадали ни с одним
// видимым текстом главной — видимый accordion рисует FAQ.astro по src/data/faq.ts.
// Разметку FAQ отдаёт сам <FAQ />, по факту отрисованного (31.07.2026).

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: SITE_URL,
    },
  ],
};

// Слаг для @id — убираем пробелы и приводим к латинице через фото-имя файла
const teamSlug = (photo: string) => photo.replace(/^.*\/team-/, '').replace(/-main-\d+\.avif$/, '').replace(/\.avif$/, '');

// E-E-A-T: Person для каждого преподавателя. Google QRG весом учитывает именно
// публично-идентифицируемых экспертов, работающих с YMYL-аудиторией (дети).
const teamPersons = teamMembers.map((m) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person-${teamSlug(m.photo)}`,
  name: m.name,
  jobTitle: m.role,
  image: `${SITE_URL}${m.photo}`,
  description: m.bio,
  worksFor: { '@id': `${SITE_URL}/#organization` },
}));

// E-E-A-T: основатель Дарья — явно, с sameAs на официальные каналы бренда
const founderPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person-daria-afanaseva`,
  name: 'Дарья Афанасьева',
  jobTitle: 'основатель АйДаКемп',
  image: `${SITE_URL}/images/team/sm/team-daria-main-01.avif`,
  description: 'Предприниматель в сфере детского IT-образования, мама подростка, основатель лагеря АйДаКемп с 2021 года.',
  worksFor: { '@id': `${SITE_URL}/#organization` },
  founder: true,
  sameAs: [
    'https://vk.com/aidacamp',
    'https://t.me/aidacamp_ru',
  ],
};

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: 'АйДаКемп',
  inLanguage: 'ru-RU',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const speakable = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/#webpage`,
  url: SITE_URL,
  name: 'АйДаКемп — летний IT-лагерь для детей в Подмосковье',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.hero-subtitle', '.faq-answer'],
  },
  isPartOf: { '@id': `${SITE_URL}/#website` },
};

// Одним @graph — проще для парсеров и убирает дубли @context
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    summerCamp,
    webSite,
    eventsList,
    breadcrumbs,
    founderPerson,
    ...teamPersons,
    speakable,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
