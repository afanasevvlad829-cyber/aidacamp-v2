---
/**
 * Централизованный JSON-LD для главной страницы aidacamp.ru.
 *
 * Включает:
 *  - Organization (бренд АйДаКемп)
 *  - SummerCamp (LocalBusiness subtype) с адресом, контактами, AggregateRating
 *  - ItemList из Event (смены из data/shifts.ts)
 *  - FAQPage (ключевые вопросы родителей)
 *  - BreadcrumbList
 *  - Person × N (команда преподавателей из data/team.ts) — E-E-A-T
 *
 * Валидатор: https://search.google.com/test/rich-results + Яндекс.Вебмастер → Инструменты → Валидатор.
 */

import { mainShifts, shortShifts, type Shift } from '../data/shifts';
import { members as teamMembers } from '../data/team';
import { reviews } from '../data/reviews';
import {
  PHONE_MAIN,
  PHONE_MOBILE,
  EMAIL,
  WHATSAPP_URL,
  TELEGRAM_URL,
  STAT_RATING,
} from '../data/contacts';

const SITE_URL = 'https://aidacamp.ru';
const LOGO_URL = `${SITE_URL}/images/logo-aidacamp.svg`; // если нет — Astro/браузер просто не покажет лого
const HERO_IMAGE = `${SITE_URL}/images/hero-custom-2026-04-07-1100.avif`;

// Цена в рублях из строки "74 900 ₽" → "74900"
const parsePrice = (p: string) => p.replace(/[^\d]/g, '');

const allShiftsForPrice = [...mainShifts, ...shortShifts];
const prices = allShiftsForPrice.map(s => parseInt(parsePrice(s.price), 10)).filter(Boolean);
const minPrice = Math.min(...prices).toLocaleString('ru-RU');
const maxPrice = Math.max(...prices).toLocaleString('ru-RU');
const priceRange = `${minPrice} ₽ – ${maxPrice} ₽`;

const reviewCount = reviews.length.toString();

// "2 февраля 2026" → "2026-02-02"
const MONTHS: Record<string, string> = {
  января: '01', февраля: '02', марта: '03', апреля: '04', мая: '05', июня: '06',
  июля: '07', августа: '08', сентября: '09', октября: '10', ноября: '11', декабря: '12',
};
const parseDate = (d: string) => {
  const parts = d.split(' ');
  if (parts.length === 3) {
    const day = parts[0].padStart(2, '0');
    const month = MONTHS[parts[1]] ?? '01';
    return `${parts[2]}-${month}-${day}`;
  }
  return d;
};

const allShifts: Shift[] = [...mainShifts, ...shortShifts];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'АйДаКемп',
  alternateName: ['AidaCamp', 'IT-лагерь АйДаКемп'],
  url: SITE_URL,
  logo: LOGO_URL,
  email: EMAIL,
  telephone: PHONE_MAIN,
  foundingDate: '2021',
  description: 'АйДаКемп — загородный IT-лагерь для детей 7–15 лет в Подмосковье, 66 км от МКАД. Работаем с 2021 года, приняли более 1200 детей. Лицензия Минобрнауки Л035-01298-77/01082973, туроператор РТО 025773.',
  knowsAbout: ['Детское программирование', 'Python для детей', 'AI для школьников', 'Minecraft Education', 'Scratch', 'Детские IT-лагеря'],
  identifier: [
    { '@type': 'PropertyValue', name: 'Лицензия Минобрнауки', value: 'Л035-01298-77/01082973' },
    { '@type': 'PropertyValue', name: 'РТО туроператора', value: '025773' },
  ],
  sameAs: [
    WHATSAPP_URL,
    TELEGRAM_URL,
    'https://vk.com/aidacamp',
    'https://www.youtube.com/@aidacamp',
    'https://t.me/aidacamp_ru',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: PHONE_MAIN,
      contactType: 'customer service',
      areaServed: 'RU',
      availableLanguage: ['Russian'],
    },
    {
      '@type': 'ContactPoint',
      telephone: PHONE_MOBILE,
      contactType: 'customer support',
      areaServed: 'RU',
      availableLanguage: ['Russian'],
    },
  ],
};

const summerCamp = {
  '@context': 'https://schema.org',
  '@type': ['SummerCamp', 'LocalBusiness'],
  '@id': `${SITE_URL}/#camp`,
  name: 'АйДаКемп — детский IT-лагерь',
  description:
    'АйДаКемп — летний IT-лагерь для детей 7–15 лет в Подмосковье, 66 км от Москвы. Python, AI, Minecraft, Scratch, бассейн, 5-разовое питание. Каждый ребёнок уезжает с собственным IT-проектом. Работаем с 2021 года. Лицензия Минобрнауки Л035-01298-77/01082973. От 48 000 ₽.',
  url: SITE_URL,
  image: HERO_IMAGE,
  telephone: PHONE_MAIN,
  email: EMAIL,
  priceRange,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Наро-Фоминский городской округ',
    addressRegion: 'Московская область',
    addressCountry: 'RU',
    streetAddress: 'территория «Санаторий Изумруд»',
    postalCode: '143381',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '55.265643',
    longitude: '36.724185',
  },
  hasMap: 'https://maps.yandex.ru/?ll=36.724185,55.265643&z=14',
  areaServed: [
    { '@type': 'City', name: 'Москва' },
    { '@type': 'AdministrativeArea', name: 'Московская область' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: STAT_RATING,
    bestRating: '5',
    worstRating: '1',
    ratingCount: reviewCount,
    reviewCount: reviewCount,
  },
  parentOrganization: { '@id': `${SITE_URL}/#organization` },
  sameAs: [
    WHATSAPP_URL,
    TELEGRAM_URL,
  ],
  review: reviews.map(r => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: r.name },
    datePublished: parseDate(r.date),
    reviewBody: r.fullText || r.text,
  })),
};

const eventsList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Смены АйДаКемп 2026',
  itemListElement: allShifts.map((shift, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': ['EducationEvent', 'ChildrensEvent'],
      '@id': `${SITE_URL}/#event-${shift.id}`,
      name: `${shift.name} — АйДаКемп 2026 (${shift.duration})`,
      description: shift.description,
      startDate: shift.startDate,
      endDate: shift.endDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      location: {
        '@type': 'Place',
        name: 'Санаторий Изумруд',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Наро-Фоминский городской округ',
          addressRegion: 'Московская область',
          addressCountry: 'RU',
        },
      },
      organizer: { '@id': `${SITE_URL}/#organization` },
      image: HERO_IMAGE,
      offers: {
        '@type': 'Offer',
        price: parsePrice(shift.price),
        priceCurrency: 'RUB',
        availability:
          shift.free > 0
            ? 'https://schema.org/InStock'
            : 'https://schema.org/SoldOut',
        url: `${SITE_URL}/#shifts`,
        validFrom: '2026-01-01',
      },
      audience: {
        '@type': 'PeopleAudience',
        suggestedMinAge: 7,
        suggestedMaxAge: 15,
      },
    },
  })),
};

