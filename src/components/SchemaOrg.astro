      },
    },
  ],
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: SITE_URL,
    },
  ],
};

// Слаг для @id — убираем пробелы и приводим к латинице через фото-имя файла
const teamSlug = (photo: string) => photo.replace(/^.*\/team-/, '').replace(/-main-\d+\.avif$/, '').replace(/\.avif$/, '');

// E-E-A-T: Person для каждого преподавателя. Google QRG весом учитывает именно
// публично-идентифицируемых экспертов, работающих с YMYL-аудиторией (дети).
const teamPersons = teamMembers.map((m) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person-${teamSlug(m.photo)}`,
  name: m.name,
  jobTitle: m.role,
  image: `${SITE_URL}${m.photo}`,
  description: m.bio,
  worksFor: { '@id': `${SITE_URL}/#organization` },
}));

// E-E-A-T: основатель Дарья — явно, с sameAs на официальные каналы бренда
const founderPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person-daria-afanaseva`,
  name: 'Дарья Афанасьева',
  jobTitle: 'основатель АйДаКемп',
  image: `${SITE_URL}/images/team/sm/team-daria-main-01.avif`,
  description: 'Предприниматель в сфере детского IT-образования, мама подростка, основатель лагеря АйДаКемп с 2021 года.',
  worksFor: { '@id': `${SITE_URL}/#organization` },
  founder: true,
  sameAs: [
    'https://vk.com/aidacamp',
    'https://t.me/aidacamp_ru',
  ],
};

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: 'АйДаКемп',
  inLanguage: 'ru-RU',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const speakable = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/#webpage`,
  url: SITE_URL,
  name: 'АйДаКемп — летний IT-лагерь для детей в Подмосковье',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.hero-subtitle', '.faq-answer'],
  },
  isPartOf: { '@id': `${SITE_URL}/#website` },
};

// Одним @graph — проще для парсеров и убирает дубли @context
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    summerCamp,
    webSite,
    eventsList,
    faqPage,
    breadcrumbs,
    founderPerson,
    ...teamPersons,
    speakable,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
