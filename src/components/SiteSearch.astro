---
import { Icon } from 'astro-icon/components';
// Site search overlay (Pagefind, statically indexed at build time).
// Render this ONCE per page (in Base layout). Trigger is any button with
// `data-search-trigger` attribute anywhere on the page.
// Build hooks: `npm run pagefind` outputs to dist/client/_pagefind/
---

<div
  id="site-search-overlay"
  class="fixed inset-0 z-[100] hidden bg-black/70 backdrop-blur-sm"
  data-pagefind-ignore
  role="dialog"
  aria-modal="true"
  aria-labelledby="site-search-title"
>
  <div class="mx-auto mt-[10vh] max-w-[680px] px-4">
    <div class="overflow-hidden rounded-2xl bg-white shadow-[0_20px_60px_rgba(0,0,0,0.5)]">
      <div class="flex items-center gap-3 border-b border-slate-200 px-5 py-4">
        <Icon name="bi:search" class="bi bi-search text-[18px] text-slate-400" aria-hidden="true" />
        <input
          id="site-search-input"
          type="search"
          placeholder="Поиск: смены, FAQ, статьи…"
          autocomplete="off"
          class="flex-1 border-0 bg-transparent text-[16px] text-slate-900 outline-none placeholder:text-slate-400"
        />
        <button
          type="button"
          data-search-close
          aria-label="Закрыть"
          class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100"
        >
          <Icon name="bi:x-lg" class="bi bi-x-lg text-[16px]" aria-hidden="true" />
        </button>
      </div>
      <div id="site-search-results" class="max-h-[60vh] overflow-y-auto px-2 py-2">
        <div class="px-4 py-8 text-center text-base text-slate-500">
          Начните вводить запрос. <span class="text-slate-400">Ctrl/Cmd + K — открыть поиск.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Eager-бутстрап (~1 КБ): слушает первое обращение к поиску (клик по
// [data-search-trigger] / Ctrl+K) и лениво догружает логику оверлея из
// src/scripts/site-search.ts — чтобы поиск не входил в начальный граф
// страницы (цепочка критических запросов PageSpeed). Разметка оверлея
// серверная, открытие/закрытие/выдача работают как раньше, с первого клика.
let mod: typeof import('../scripts/site-search') | null = null;
let loading: Promise<unknown> | null = null;

function boot(): Promise<unknown> {
  if (mod) return Promise.resolve(mod);
  if (!loading) {
    loading = import('../scripts/site-search').then((m) => {
      m.initSiteSearch();
      mod = m;
      return m;
    });
  }
  return loading;
}

document.addEventListener('click', (e) => {
  if (!(e.target as Element)?.closest?.('[data-search-trigger]')) return;
  if (mod) return; // модуль уже загружен — обработает сам
  e.preventDefault();
  e.stopPropagation();
  void boot().then((m: any) => m.openOverlay());
}, { capture: true });

document.addEventListener('keydown', (e) => {
  if (!(e.ctrlKey || e.metaKey) || (e.key !== 'k' && e.key !== 'K')) return;
  if (mod) return; // модуль уже загружен — обработает сам
  e.preventDefault();
  void boot().then((m: any) => m.openOverlay());
});

// ─── Mobile keyboard / visual-viewport tracking (phase Q) ──────────────
// Глобальная фича (--kbd-offset для fixed-элементов при открытой клавиатуре),
// обслуживает ВСЕ поля ввода сайта, а не только поиск — поэтому eager.
(function () {
  if (typeof window === 'undefined') return;
  const vv = window.visualViewport;
  if (!vv) return;
  const root = document.documentElement;

  function syncOffset() {
    if (!vv) return;
    const offset = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
    root.style.setProperty('--kbd-offset', offset + 'px');
    root.dataset.kbdOpen = offset > 80 ? 'true' : 'false';
  }
  vv.addEventListener('resize', syncOffset);
  vv.addEventListener('scroll', syncOffset);
  // Initial call skipped: --kbd-offset defaults to 0px in CSS; no keyboard open at page load.

  document.addEventListener('focusin', (e) => {
    const t = e.target as HTMLElement | null;
    if (!t) return;
    const tag = t.tagName;
    if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') return;
    if (t.closest('[data-pagefind-ignore]')) return;
    setTimeout(() => {
      const rect = t.getBoundingClientRect();
      const visibleBottom = vv ? vv.height : window.innerHeight;
      if (rect.bottom > visibleBottom - 20) {
        window.scrollBy({ top: rect.bottom - visibleBottom + 24, behavior: 'smooth' });
      }
    }, 280);
  });
})();
</script>
