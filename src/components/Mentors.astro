---
const mentors = [
  {
    id: 'voronov',
    name: 'Алексей Воронов',
    role: 'IT-директор',
    company: 'ex-Shell → крупный кондитерский холдинг',
    bio: 'Опыт трансформации IT в международных и российских компаниях. Понимает, что рынок ждёт от специалистов следующего поколения.',
    image: '/images/mentors/voronov.webp',
    fallback: '/images/mentors/voronov.png',
  },
  {
    id: 'samokhvalov',
    name: 'Дмитрий Самохвалов',
    role: 'Руководитель IT-автоматизации',
    company: 'ВТБ',
    bio: 'Выстраивает клиентский сервис будущего в одном из крупнейших банков страны. Знает, какие навыки реально ценятся на входе.',
    image: '/images/mentors/samokvalov.webp',
    fallback: '/images/mentors/samokvalov.png',
  },
  {
    id: 'nosov',
    name: 'Павел Носов',
    role: 'Эксперт по продуктовым инновациям',
    company: 'МТС Ventures',
    bio: 'Запускал продукты на ранней стадии в венчурном подразделении МТС. Специалист по инновационным методикам создания продуктов.',
    image: '/images/mentors/nosov.webp',
    fallback: '/images/mentors/nosov.png',
  },
];
---

<section id="mentors" class="mx-auto max-w-[1312px] px-[2px] pt-2 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Менторы проекта</h2>
    </div>

    <p class="mt-2 max-w-[740px] text-[16px] leading-[1.6] text-body-muted">
      Практики из реального IT — они дают нам обратную связь по программе и помогают держать руку на пульсе рынка. <button type="button" id="mentors-why-btn" class="text-[16px] font-medium text-orange-700 underline decoration-orange-300/60 decoration-dashed underline-offset-2 hover:text-orange-800 transition-colors">Зачем нам это?</button>
    </p>

    <!-- Cards: desktop — row of 3, mobile — swipe -->
    <div class="mt-5 hidden md:grid md:grid-cols-3 md:gap-5">
      {mentors.map((m) => (
        <article class="reveal flex flex-col items-center rounded-[22px] bg-surface border border-border-light p-6 shadow-[0_4px_12px_rgba(15,23,42,0.08),0_24px_56px_rgba(15,23,42,0.18)]">
          <!-- Avatar image -->
          <picture>
            <source srcset={m.image} type="image/webp" />
            <img src={m.fallback} alt={m.name} class="h-20 w-20 rounded-full ring-2 ring-white object-cover" loading="lazy" decoding="async" />
          </picture>
          <h3 class="mt-4 text-center text-[17px] font-semibold text-body">{m.name}</h3>
          <p class="mt-0.5 text-center text-[14px] font-semibold text-orange-700">{m.role}</p>
          <p class="mt-0.5 text-center text-[14px] md:text-[13px] text-body-faint">{m.company}</p>
          <p class="mt-3 text-center text-[15px] leading-[1.55] text-body-muted">{m.bio}</p>
        </article>
      ))}
    </div>

    <!-- Mobile: horizontal scroll -->
    <div class="mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:hidden" id="mentors-mobile-track">
      {mentors.map((m, i) => (
        <article class="min-w-[80%] snap-start rounded-[22px] border border-border bg-surface p-5 shadow-[0_4px_12px_rgba(15,23,42,0.08),0_24px_56px_rgba(15,23,42,0.18)]">
          <div class="flex items-center gap-3">
            <picture>
              <source srcset={m.image} type="image/webp" />
              <img src={m.fallback} alt={m.name} class="h-14 w-14 shrink-0 rounded-full object-cover" loading="lazy" decoding="async" />
            </picture>
            <div class="min-w-0">
              <h3 class="text-[16px] font-semibold text-body">{m.name}</h3>
              <p class="text-[13px] font-semibold text-orange-700">{m.role}</p>
              <p class="text-[12px] text-body-faint">{m.company}</p>
            </div>
          </div>
          <p class="mt-3 text-[15px] leading-[1.55] text-body-muted">{m.bio}</p>
        </article>
      ))}
    </div>

    <!-- Dots — mobile only -->
    <div class="mt-3 flex justify-center items-center gap-2 md:hidden" id="mentors-dots">
      {mentors.map((_, i) => (
        <span
          class={`h-2 rounded-full transition-all duration-200 ${i === 0 ? 'w-6 bg-[var(--color-primary, #ec7c00)]' : 'w-2 bg-slate-300'}`}
          data-mentor-dot={i}
        ></span>
      ))}
    </div>
    <!-- Дисклеймер о согласии менторов (требование 152-ФЗ / РКН) -->
    <p class="mt-5 text-[14px] md:text-[13px] leading-[1.5] text-body-faint">
      Фотографии и имена менторов размещены с их письменного согласия на обработку персональных данных в соответствии с&nbsp;Федеральным законом №&nbsp;152-ФЗ «О персональных данных».
    </p>
  </div>
</section>

<!-- Why-modal -->
<dialog
  id="mentorsWhyModal"
  class="fixed inset-0 m-auto w-[min(92vw,480px)] rounded-[20px] border-0 outline-none bg-card p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <div class="flex items-start justify-between gap-3 mb-4">
      <h3 class="text-[20px] font-bold text-body leading-[1.2]">Зачем нам менторы?</h3>
      <button type="button" id="mentors-why-close" aria-label="Закрыть"
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-body-faint hover:bg-surface hover:text-body-muted transition focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-1">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <p class="text-[16px] leading-[1.6] text-body-muted">
      Мы хотим, чтобы через 10–15 лет ребята из наших смен чувствовали себя уверенно в реальном IT — не только умели программировать, но и умели думать как продуктовые люди.
    </p>

    <p class="mt-3 text-[16px] leading-[1.6] text-body-muted">
      Наши менторы — практики, которые прямо сейчас строят это IT изнутри. Они дают нам обратную связь по программе: что реально востребовано, какие навыки открывают двери, а что уже устарело ещё до выхода ребёнка в вузе.
    </p>

    <div class="mt-4 rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3.5">
      <p class="text-[15px] font-medium text-orange-900 leading-[1.5]">
        Им не всё равно, каким будет детское IT через 10 лет. Нам — тем более.
      </p>
    </div>
  </div>
</dialog>

<script>
  function initMentors() {
    // Why modal
    const modal = document.getElementById('mentorsWhyModal') as HTMLDialogElement | null;
    document.getElementById('mentors-why-btn')?.addEventListener('click', () => modal?.showModal());
    document.getElementById('mentors-why-close')?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal?.close(); });

    // Mobile carousel dots
    const track = document.getElementById('mentors-mobile-track');
    const dots = document.querySelectorAll<HTMLElement>('[data-mentor-dot]');
    if (track && dots.length) {
      const cards = Array.from(track.children) as HTMLElement[];
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            dots.forEach((d, di) => {
              const active = di === idx;
              d.classList.toggle('bg-[var(--color-primary, #ec7c00)]', active);
              d.classList.toggle('w-6', active);
              d.classList.toggle('bg-slate-300', !active);
              d.classList.toggle('w-2', !active);
            });
          }
        });
      }, { root: track, threshold: 0.6 });
      cards.forEach((c) => obs.observe(c));
    }
  }

  document.addEventListener('astro:page-load', initMentors);
  initMentors();
</script>
