---
// ShiftModal.astro — единая модалка смены с 3 табами:
// Описание / Календарь / Подробнее
// Открывается по клику на карточку смены или по data-shift-calendar / data-shift-info
import { TELEGRAM_URL } from '../data/contacts';
---

<div id="shift-modal"
  class="fixed inset-0 z-[80] hidden items-end md:items-center justify-center"
  inert
  role="dialog"
  aria-modal="true">

  <!-- Backdrop -->
  <div data-shift-modal-backdrop
    class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Panel -->
  <div data-shift-modal-panel
    class="relative w-full md:w-[600px] md:max-w-[calc(100vw-32px)]
           bg-white md:rounded-2xl rounded-t-2xl
           shadow-[0_-10px_40px_rgba(0,0,0,0.25)] md:shadow-[0_20px_60px_rgba(0,0,0,0.25)]
           h-[82vh] md:h-[620px] flex flex-col
           translate-y-full md:translate-y-4 opacity-0
           transition-all duration-300 ease-out">

    <!-- Mobile swipe handle -->
    <div class="md:hidden flex justify-center pt-2 pb-1 shrink-0" data-shift-modal-handle>
      <div class="h-1 w-10 rounded-full bg-slate-300"></div>
    </div>

    <!-- Header -->
    <div class="flex items-start justify-between gap-3 px-5 pt-3 pb-3 border-b border-slate-100 shrink-0">
      <div class="min-w-0">
        <h3 data-shift-modal-title class="text-[18px] md:text-[20px] font-bold text-slate-900 truncate"></h3>
        <p data-shift-modal-dates class="text-[14px] text-slate-500 mt-0.5"></p>
      </div>
      <button type="button" data-shift-modal-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex gap-1 px-5 pt-3 shrink-0" role="tablist">
      <button type="button" data-shift-modal-tab="description" role="tab"
        class="flex-1 px-3 py-2 rounded-lg text-[14px] font-semibold transition-colors">
        Программа
      </button>
      <button type="button" data-shift-modal-tab="calendar" role="tab"
        class="flex-1 px-3 py-2 rounded-lg text-[14px] font-semibold transition-colors">
        Календарь
      </button>
    </div>

    <!-- Content (scrollable) -->
    <div class="flex-1 overflow-y-auto px-5 py-4">

      <!-- Tab: Description -->
      <div data-shift-modal-content="description" class="hidden">
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-slate-500 mb-3">
          <span class="inline-flex items-center gap-1"><i class="bi bi-clock"></i> <span data-shift-modal-duration></span></span>
          <span class="inline-flex items-center gap-1"><i class="bi bi-calendar3"></i> <span data-shift-modal-daterange></span></span>
        </div>

        <!-- Occupancy bar -->
        <div class="mb-4">
          <div class="h-[10px] w-full overflow-hidden rounded-[6px] bg-slate-100">
            <div class="flex h-full">
              <div data-shift-modal-bar-taken class="bg-slate-400 rounded-l-[6px]"></div>
              <div data-shift-modal-bar-free class="bg-emerald-400 rounded-r-[6px]"></div>
            </div>
          </div>
          <div class="flex justify-between mt-1">
            <span class="text-[14px] text-slate-400">занято <span data-shift-modal-occupied></span></span>
            <span class="text-[14px] text-emerald-700 font-medium">свободно <span data-shift-modal-free></span></span>
          </div>
        </div>

        <p data-shift-modal-description class="text-[16px] leading-[1.6] text-slate-700"></p>

        <!-- Блок ровесников -->
        <div data-shift-age-block class="mt-4 rounded-xl bg-slate-50 px-4 py-3">
          <!-- Фаза 1: вопрос -->
          <div data-shift-age-q>
            <p class="text-[14px] text-slate-500 mb-2">Укажите возраст — покажем сколько ровесников едет</p>
            <div class="flex gap-1.5">
              <button data-shift-age-btn="7–9"
                class="flex-1 py-1.5 rounded-lg text-[14px] font-semibold
                       bg-white border border-slate-200 text-slate-700
                       active:scale-95 transition-all">7–9</button>
              <button data-shift-age-btn="10–12"
                class="flex-1 py-1.5 rounded-lg text-[14px] font-semibold
                       bg-white border border-slate-200 text-slate-700
                       active:scale-95 transition-all">10–12</button>
              <button data-shift-age-btn="13–15"
                class="flex-1 py-1.5 rounded-lg text-[14px] font-semibold
                       bg-white border border-slate-200 text-slate-700
                       active:scale-95 transition-all">13–15</button>
            </div>
          </div>
          <!-- Фаза 2: результат -->
          <div data-shift-age-r class="hidden items-center gap-3">
            <i class="bi bi-people-fill text-[22px] text-slate-500"></i>
            <p data-shift-age-result class="text-[16px] font-semibold text-slate-800 leading-[1.35]"></p>
          </div>
        </div>

        <!-- Объединили бывший таб «Подробнее» сюда: детальная программа смены -->
        <div data-shift-modal-info-body class="mt-5 space-y-2 border-t border-slate-100 pt-5"></div>
      </div>

      <!-- Tab: Calendar -->
      <div data-shift-modal-content="calendar" class="hidden">
        <div data-shift-modal-calendar-grid></div>
      </div>
    </div>

    <!-- Footer with price + CTA -->
    <div class="shrink-0 border-t border-slate-100 px-5 py-4 bg-white md:rounded-b-2xl">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div>
          <div data-shift-modal-price class="text-[22px] font-bold tracking-[-0.03em] text-slate-900 leading-tight"></div>
          <p class="text-[13px] text-slate-400 mt-0.5">Питание, проживание, программа включены</p>
        </div>
      </div>
      <button type="button" data-shift-modal-book
        class="w-full rounded-xl bg-primary hover:bg-primary/90 text-[#0d1a2b] px-4 py-3 text-[15px] font-semibold transition active:scale-[0.98]">
        Выбрать смену
      </button>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener"
         class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-[14px] font-semibold text-slate-600 transition hover:border-[#27A7E5]/60 hover:text-[#229ED9] active:scale-[0.98] no-underline"
         data-analytics-goal="telegram_click">
        <i class="bi bi-telegram text-[16px]" aria-hidden="true"></i>
        Написать в Telegram
      </a>
    </div>

  </div>
</div>

<script>
  import { initShiftModal } from '../scripts/shift-modal';
  import { initDiscountTimer } from '../scripts/discount-timer';
  document.addEventListener('astro:page-load', () => {
    initShiftModal();
    initDiscountTimer();
  });
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initShiftModal(); initDiscountTimer(); }, { timeout: 2000 });
  } else {
    setTimeout(() => { initShiftModal(); initDiscountTimer(); }, 200);
  }
</script>
