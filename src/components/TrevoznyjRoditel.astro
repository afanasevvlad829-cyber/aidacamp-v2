---
import { TELEGRAM_URL } from '../data/contacts';
const TG_TEXT = encodeURIComponent('Хочу тариф «Тревожный родитель» 😅');
const tgLink = `${TELEGRAM_URL}?text=${TG_TEXT}`;

const perks = [
  { icon: 'person-fill',       text: 'Трансфер лично Дарьей — основателем лагеря — с пристёгнутыми ремнями' },
  { icon: 'camera-fill',       text: 'Фото ребёнка каждые 30 минут' },
  { icon: 'house-heart-fill',  text: 'Маленький диванчик у ворот лагеря с WiFi' },
  { icon: 'bag-fill',          text: '5-разовое питание + двойные порции по запросу' },
  { icon: 'cpu-fill',          text: 'Вы тоже уедете с AI-проектом' },
  { icon: 'heart-pulse-fill',  text: 'Гарантия похудения — 10 000 шагов в день' },
  { icon: 'shield-fill-check', text: 'Посещение бассейна без очереди' },
  { icon: 'phone-vibrate',     text: 'Телефон не отбираем — ребёнок всегда на связи' },
  { icon: 'award-fill',        text: 'Сертификат «Я отпустила» 🏅' },
];
---

<section class="mx-auto max-w-4xl px-4 pb-10">
  <div class="relative overflow-hidden rounded-[28px] border-2 border-dashed border-pink-300 bg-gradient-to-br from-pink-50 via-fuchsia-50 to-orange-50 p-6 md:p-8 shadow-[0_8px_32px_rgba(236,72,153,0.10)]">

    <!-- Лента-бейдж -->
    <div class="absolute right-0 top-6 rotate-[30deg] translate-x-8 bg-pink-500 text-white text-[10px] font-black uppercase tracking-widest px-10 py-1 shadow-md select-none">
      ЛИМИТИРОВАНО
    </div>

    <div class="flex flex-col md:flex-row md:items-start gap-6">

      <!-- Левая колонка: заголовок + цена -->
      <div class="md:w-56 shrink-0">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-pink-100 border border-pink-200 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-pink-600 mb-3">
          <i class="bi bi-heart-fill text-[10px]" aria-hidden="true"></i>
          Эксклюзивный тариф
        </div>
        <h2 class="text-[22px] md:text-[24px] font-extrabold text-slate-900 leading-tight">
          Тариф<br>«Тревожный<br>родитель»
        </h2>
        <div class="mt-4">
          <p class="text-[11px] text-slate-400 uppercase tracking-wide">Стоимость</p>
          <p class="text-[34px] font-black text-pink-600 leading-none">150 000 ₽</p>
          <p class="text-[12px] text-slate-500 mt-0.5">за любую смену</p>
        </div>
        <a
          href={tgLink}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-pink-500 px-5 py-2.5 text-[13px] font-bold text-white hover:bg-pink-600 transition-colors shadow-[0_4px_12px_rgba(236,72,153,0.30)]"
        >
          <i class="bi bi-telegram text-[14px]" aria-hidden="true"></i>
          Записаться
        </a>
        <p class="mt-3 text-[11px] leading-[1.5] text-slate-400 italic">
          Налоговый вычет — только на ребёнка. Прости.
        </p>
      </div>

      <!-- Правая колонка: перки -->
      <div class="flex-1">
        <p class="text-[13px] font-semibold text-slate-500 mb-3">Что входит в тариф:</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {perks.map(p => (
            <li class="flex items-start gap-2.5 rounded-[12px] bg-white/70 border border-pink-100 px-3.5 py-2.5">
              <i class={`bi bi-${p.icon} text-[15px] text-pink-400 mt-0.5 shrink-0`} aria-hidden="true"></i>
              <span class="text-[13px] leading-[1.5] text-slate-700">{p.text}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-[12px] leading-[1.6] text-slate-400 italic">
          * Мы правда понимаем вашу тревогу — именно поэтому каждый день отправляем фото и видео в родительский чат, а Дарья всегда на связи в WhatsApp.
        </p>
      </div>

    </div>
  </div>
</section>
