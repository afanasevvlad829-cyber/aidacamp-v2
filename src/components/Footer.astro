---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';

const sections = [
  { label: 'О лагере', href: '#about' },
  { label: 'Смены', href: '#shifts' },
  { label: 'Фото', href: '#gallery' },
  { label: 'Видео', href: '#videos' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Контакты', href: '#contacts' },
];

const documents = [
  { label: 'Политика персональных данных', href: '/privacy-policy/' },
  { label: 'Образовательная лицензия', href: '/legal#license' },
  { label: 'Реестр туроператоров', href: '/legal#requisites' },
  { label: 'Реквизиты', href: '/legal#requisites' },
  { label: 'Об организации отдыха детей', href: '/ob-organizacii-otdyha-detej-i-ozdorovleniya/' },
  { label: 'Устав организации', href: '/docs/ustav-voip-konnekt.pdf' },
  { label: 'Свидетельство ИНН', href: '/docs/svidetelstvo-inn.pdf' },
  { label: 'Оставить отзыв', href: '/ostavit-otzyv' },
  { label: 'Питание в лагере', href: '/pitanie' },
];

const articles = [
  { label: 'Статьи для родителей', href: '/stati' },
  { label: 'Как выбрать лагерь', href: '/stati/kak-vybrat-lager' },
  { label: 'Что взять в лагерь', href: '/stati/chto-vzyat-v-lager' },
  { label: 'Python для детей', href: '/stati/python-dlya-detej' },
  { label: 'Нейросети для детей', href: '/stati/nejroseti-dlya-detej' },
  { label: 'Программа IT-лагеря', href: '/stati/programma-it-lagerya' },
  { label: 'IT-лагерь vs обычный', href: '/stati/it-lager-vs-obychnyj' },
  { label: 'Справки для лагеря', href: '/stati/spravki-dlya-lagera' },
];

const cities = [
  { label: 'Лагерь из Подольска', href: '/lager-podolsk' },
  { label: 'Лагерь из Одинцово', href: '/lager-odintsovo' },
  { label: 'Лагерь из Химок', href: '/lager-himki' },
  { label: 'Лагерь из Домодедово', href: '/lager-domodedovo' },
  { label: 'Лагерь из Серпухова', href: '/lager-serpuhov' },
  { label: 'Лагерь из Зеленограда', href: '/lager-zelenograd' },
  { label: 'Наро-Фоминский район', href: '/lager-naro-fominsk' },
  { label: 'Новая Москва', href: '/lager-novaya-moskva' },
];

const socials = [
  { label: 'VK', href: 'https://vk.com/aidacamp' },
  { label: 'Telegram', href: 'https://t.me/Progaschool' },
  { label: 'YouTube', href: 'https://www.youtube.com/@aidacamp' },
];
---

<footer class="mx-auto max-w-[1312px] px-[2px] pb-4 pt-4 md:pb-6 md:pt-6 md:px-4">
  <div class="border-t border-slate-200 bg-white p-[18px] pt-5 text-sm text-slate-500 md:pt-8">
    <!-- Mobile: compact layout -->
    <div class="grid grid-cols-2 gap-4 md:hidden">
      <details>
        <summary class="cursor-pointer font-semibold text-slate-900 py-2 block">Документы ▾</summary>
        <div class="mt-2 space-y-0.5">
          {documents.map((d) => (
            <a href={d.href} class="block py-2.5 text-slate-500 hover:text-slate-700">{d.label}</a>
          ))}
        </div>
      </details>
      <details>
        <summary class="cursor-pointer font-semibold text-slate-900 py-2 block">Разделы ▾</summary>
        <div class="mt-2 space-y-0.5">
          {sections.map((s) => (
            <a href={s.href} class="block py-2.5 text-slate-500 hover:text-slate-700">{s.label}</a>
          ))}
        </div>
      </details>
      <details>
        <summary class="cursor-pointer font-semibold text-slate-900 py-2 block">По городам ▾</summary>
        <div class="mt-2 space-y-0.5">
          {cities.map((c) => (
            <a href={c.href} class="block py-2.5 text-slate-500 hover:text-slate-700">{c.label}</a>
          ))}
        </div>
      </details>
    </div>

    <!-- Desktop: full 5-col layout -->
    <div class="hidden md:grid md:grid-cols-5 md:gap-6">
      <div>
        <p class="font-semibold text-slate-900">Документы</p>
        <div class="mt-2 space-y-1.5">
          {documents.map((d) => (
            <a href={d.href} class="block text-slate-500 hover:text-slate-700">{d.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Разделы</p>
        <div class="mt-2 space-y-1.5">
          {sections.map((s) => (
            <a href={s.href} class="block text-slate-500 hover:text-slate-700">{s.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Статьи</p>
        <div class="mt-2 space-y-1.5">
          {articles.map((a) => (
            <a href={a.href} class="block text-slate-500 hover:text-slate-700">{a.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-slate-900">По городам</p>
        <div class="mt-2 space-y-1.5">
          {cities.map((c) => (
            <a href={c.href} class="block text-slate-500 hover:text-slate-700">{c.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Соцсети</p>
        <div class="mt-2 flex gap-2">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center rounded-lg border border-slate-200 px-3 py-1.5 text-[14px] text-slate-600 hover:text-slate-700">
              {s.label}
            </a>
          ))}
        </div>
        <div class="mt-4 space-y-1">
          <a href={PHONE_MAIN_HREF} class="block text-slate-500 hover:text-slate-700">{PHONE_MAIN}</a>
          <a href={PHONE_MOBILE_HREF} class="block text-slate-500 hover:text-slate-700">{PHONE_MOBILE}</a>
          <div class="flex gap-2 pt-1">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="text-slate-500 hover:text-slate-700">WhatsApp</a>
            <span>·</span>
            <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="text-slate-500 hover:text-slate-700">Telegram</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal -->
    <div class="mt-6 border-t border-slate-100 pt-4 text-[16px] leading-[1.6] text-slate-500">
      <p>&copy; 2019–2026 ООО «ВОИП КОННЕКТ»</p>
      <p>ИНН 7729713637 · Реестровый номер туроператора РТО 025773</p>
      <p>Образовательная лицензия Л035-01298-77/01082973</p>
    </div>
  </div>

  <!-- Analytics pixels: только noscript-фолбэк (JS-счётчики уже в Base.astro) -->
  <noscript>
    <img src="https://mc.yandex.ru/watch/96499295" style="position:absolute;left:-9999px" alt="" />
    <img src="https://top-fwz1.mail.ru/counter?id=3755202;js=na" style="position:absolute;left:-9999px" alt="" />
  </noscript>
</footer>
