  { label: 'Летняя IT-школа', href: '/letnyaya-it-shkola/' },
  { label: 'Статьи для родителей', href: '/stati' },
  { label: 'Как выбрать лагерь', href: '/stati/kak-vybrat-lager' },
  { label: 'Что взять в лагерь', href: '/stati/chto-vzyat-v-lager' },
  { label: 'Python для детей', href: '/stati/python-dlya-detej' },
  { label: 'Нейросети для детей', href: '/stati/nejroseti-dlya-detej' },
  { label: 'Программа IT-лагеря', href: '/stati/programma-it-lagerya' },
  { label: 'IT-лагерь vs обычный', href: '/stati/it-lager-vs-obychnyj' },
  { label: 'Справки для лагеря', href: '/stati/spravki-dlya-lagera' },
];

const cities = [
  { label: 'Лагерь из Подольска', href: '/lager-podolsk' },
  { label: 'Лагерь из Одинцово', href: '/lager-odintsovo' },
  { label: 'Лагерь из Химок', href: '/lager-himki' },
  { label: 'Лагерь из Домодедово', href: '/lager-domodedovo' },
  { label: 'Лагерь из Серпухова', href: '/lager-serpuhov' },
  { label: 'Лагерь из Зеленограда', href: '/lager-zelenograd' },
  { label: 'Наро-Фоминский район', href: '/lager-naro-fominsk' },
  { label: 'Новая Москва', href: '/lager-novaya-moskva' },
];

const socials = [
  { abbr: 'VK', label: 'ВКонтакте', href: 'https://vk.com/aidacamp' },
  { abbr: 'OK', label: 'Одноклассники', href: 'https://ok.ru/group/64689601773621' },
  { abbr: 'YT', label: 'YouTube', href: 'https://www.youtube.com/@aidacamp' },
  { abbr: 'RT', label: 'Rutube', href: 'https://rutube.ru/channel/53394996/' },
  { abbr: 'IG', label: 'Instagram', href: 'https://www.instagram.com/aida_codit' },
  { abbr: 'LI', label: 'LinkedIn', href: 'https://www.linkedin.com/company/it-лагерь-для-детей-айдакемп' },
  { abbr: 'TT', label: 'TikTok', href: 'https://www.tiktok.com/@aidacodit0' },
  { abbr: 'PI', label: 'Pinterest', href: 'https://ru.pinterest.com/pbalgoritmika/' },
  { abbr: 'YA', label: 'Yappy', href: 'https://yappy.media/n/acceptable.lizardxw' },
];
---

<footer class="mx-auto max-w-[1312px] px-[2px] pb-4 pt-4 md:pb-6 md:pt-6 md:px-4">
  <div class="border-t border-border bg-card p-[18px] pt-5 text-[14px] md:text-[15px] text-body-faint md:pt-8">
    <!-- Mobile: compact layout -->
    <div class="grid grid-cols-2 gap-4 md:hidden">
      <div data-toggle-root>
        <button type="button" data-toggle aria-expanded="false" class="cursor-pointer font-semibold text-body py-2 block w-full text-left">Документы ▾</button>
        <div data-toggle-panel class="hidden mt-2 space-y-0.5">
          {documents.map((d) => (
            <a href={d.href} class="block py-2.5 text-body-faint hover:text-body-muted">{d.label}</a>
          ))}
        </div>
      </div>
      <div data-toggle-root>
        <button type="button" data-toggle aria-expanded="false" class="cursor-pointer font-semibold text-body py-2 block w-full text-left">Разделы ▾</button>
        <div data-toggle-panel class="hidden mt-2 space-y-0.5">
          {sections.map((s) => (
            <a href={s.href} class="block py-2.5 text-body-faint hover:text-body-muted">{s.label}</a>
          ))}
        </div>
      </div>
      <div data-toggle-root>
        <button type="button" data-toggle aria-expanded="false" class="cursor-pointer font-semibold text-body py-2 block w-full text-left">По городам ▾</button>
        <div data-toggle-panel class="hidden mt-2 space-y-0.5">
          {cities.map((c) => (
            <a href={c.href} class="block py-2.5 text-body-faint hover:text-body-muted">{c.label}</a>
          ))}
        </div>
      </div>
      <div data-toggle-root>
        <button type="button" data-toggle aria-expanded="false" class="cursor-pointer font-semibold text-body py-2 block w-full text-left">Статьи ▾</button>
        <div data-toggle-panel class="hidden mt-2 space-y-0.5">
          {articles.map((a) => (
            <a href={a.href} class="block py-2.5 text-body-faint hover:text-body-muted">{a.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile: контакты + соцсети (full-width row под аккордеонами) -->
    <div class="md:hidden mt-5 pt-5 border-t border-border-light space-y-3">
      <div class="flex items-center gap-2 flex-wrap">
        <a href={PHONE_MAIN_HREF} class="inline-flex items-center gap-1.5 text-[15px] font-semibold text-body" data-analytics-goal="phone_click" data-analytics-label="footer_mobile">
          <i class="bi bi-telephone-fill text-[14px] text-primary" aria-hidden="true"></i>
          {PHONE_MAIN}
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center min-h-[40px] rounded-lg border border-border bg-surface px-3 py-2 text-[14px] text-body-muted hover:text-body hover:border-primary/40 transition-colors">
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Desktop: full 5-col layout -->
    <div class="hidden md:grid md:grid-cols-5 md:gap-6">
      <div>
        <p class="font-semibold text-body">Документы</p>
        <div class="mt-2 space-y-1.5">
          {documents.map((d) => (
            <a href={d.href} class="block text-body-faint hover:text-body-muted">{d.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-body">Разделы</p>
        <div class="mt-2 space-y-1.5">
          {sections.map((s) => (
            <a href={s.href} class="block text-body-faint hover:text-body-muted">{s.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-body">Статьи</p>
        <div class="mt-2 space-y-1.5">
          {articles.map((a) => (
            <a href={a.href} class="block text-body-faint hover:text-body-muted">{a.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-body">По городам</p>
        <div class="mt-2 space-y-1.5">
          {cities.map((c) => (
            <a href={c.href} class="block text-body-faint hover:text-body-muted">{c.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="font-semibold text-body">Соцсети</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center min-h-[44px] rounded-lg border border-border px-3 py-1.5 text-[14px] text-body-muted hover:text-body">
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Legal -->
    <div class="mt-6 border-t border-border-light pt-4 text-[14px] leading-[1.6] text-body-faint">
      <p>&copy; 2019–2026 ООО «ВОИП КОННЕКТ»</p>
      <p>ИНН 7729713637 · Реестровый номер туроператора РТО 025773</p>
      <p>Образовательная лицензия Л035-01298-77/01082973</p>
    </div>
  </div>

  <script>
    function initToggles() {
      document.querySelectorAll<HTMLElement>('[data-toggle-root]').forEach((root) => {
        const btn = root.querySelector<HTMLButtonElement>('[data-toggle]');
        const panel = root.querySelector<HTMLElement>('[data-toggle-panel]');
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          panel.classList.toggle('hidden', expanded);
        });
      });
    }
    document.addEventListener('astro:page-load', initToggles);
    // Defer — футер ниже fold, не блокируем LCP
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initToggles, { timeout: 2000 });
    } else {
      setTimeout(initToggles, 200);
    }
  </script>

  <!-- Analytics pixels: только noscript-фолбэк (JS-счётчики уже в Base.astro) -->
  <noscript>
    <img src="https://mc.yandex.ru/watch/96499295" style="position:absolute;left:-9999px" alt="" />
  </noscript>
</footer>
