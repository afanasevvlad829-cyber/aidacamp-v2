---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';
---
<!-- Sticky CTA — mobile: bottom bar / desktop: right-side bubble -->

<!-- ===== MOBILE: Sticky bottom-bar (📞 + 💬 WA) — P1 UX-fix 2026-04-20 ===== -->
<!-- Появляется после скролла >480px, закрывается крестом, hidden на desktop -->
<div
  id="sticky-bar"
  class="fixed bottom-0 inset-x-0 z-[70] md:hidden translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-out"
  style="background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,1) 20%); border-top: 1px solid rgba(17,24,39,0.08); box-shadow: 0 -8px 24px rgba(15,23,42,0.10); padding-bottom: calc(16px + env(safe-area-inset-bottom));"
  inert
  data-sticky-bar-v2
>
  <div class="flex items-center justify-center gap-3 px-4 py-2.5">
    <a
      href={PHONE_MAIN_HREF}
      aria-label="Позвонить"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#ad5b00] text-white shadow-[0_4px_12px_rgba(196,95,0,0.28)] active:scale-[0.94] transition-transform"
      data-sticky-call
      data-haptic
    >
      <svg class="h-6 w-6" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
    </a>
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      aria-label="Написать в WhatsApp"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_4px_12px_rgba(37,211,102,0.32)] active:scale-[0.94] transition-transform"
      data-sticky-wa
      data-haptic
    >
      <svg width="24" height="24" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.638l4.685-1.228A11.934 11.934 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.239 0-4.308-.724-5.993-1.953l-.42-.304-2.785.73.744-2.717-.334-.443A9.955 9.955 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
    </a>
    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener"
      aria-label="Написать в Telegram"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#229ED9] text-white shadow-[0_4px_12px_rgba(34,158,217,0.32)] active:scale-[0.94] transition-transform"
      data-sticky-tg
      data-haptic
    >
      <svg width="24" height="24" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0h-.056zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
    </a>
    <button
      id="sticky-close"
      data-sticky-close
      type="button"
      class="flex h-12 w-12 items-center justify-center rounded-full text-slate-400 active:text-slate-700 transition-colors"
      aria-label="Скрыть панель контактов"
    >
      <svg class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
</div>

<!-- ===== LEGACY mobile bar (старый, на случай отката) — скрыт ===== -->
<div
  id="sticky-bar-legacy"
  class="fixed bottom-0 inset-x-0 z-50 hidden"
  aria-hidden="true"
  inert
>
  <a
    href={PHONE_MAIN_HREF}
    class="flex flex-col items-center gap-1 text-white text-base font-medium"
  >
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
    Позвонить
  </a>
  <a
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center gap-1 text-white text-base font-medium"
  >
    <svg width="20" height="20" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.638l4.685-1.228A11.934 11.934 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.239 0-4.308-.724-5.993-1.953l-.42-.304-2.785.73.744-2.717-.334-.443A9.955 9.955 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
    WhatsApp
  </a>
  <a
    href={TELEGRAM_URL}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center gap-1 text-white text-base font-medium"
  >
    <svg width="20" height="20" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0h-.056zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
    Telegram
  </a>
  <button
    id="sticky-close"
    type="button"
    class="flex flex-col items-center gap-1 text-white/50 text-base hover:text-white transition-colors"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    свернуть
  </button>
</div>

<!-- ===== MOBILE: Collapsed bubble — DISABLED ===== -->
<div
  id="sticky-bubble"
  class="hidden"
  aria-hidden="true"
>
  <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
</div>

<!-- ===== DESKTOP: Right-side bubble with expand ===== -->
<div
  id="desktop-sticky"
  class="fixed right-5 bottom-[72px] z-50 hidden lg:block"
  data-desktop-sticky
>
  <!-- Collapsed: single round button -->
  <button
    type="button"
    id="desktop-bubble-toggle"
    aria-label="Связаться с нами"
    class="relative flex h-14 w-14 items-center justify-center rounded-full bg-slate-800/90 text-white/70 shadow-[0_4px_16px_rgba(0,0,0,0.25)] transition-all duration-300 hover:scale-105 hover:bg-slate-700/90 hover:text-white"
  >
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
  </button>

  <!-- Expanded panel -->
  <div
    id="desktop-bubble-panel"
    class="absolute bottom-[68px] right-0 hidden w-[220px] origin-bottom-right scale-95 rounded-[16px] bg-white p-4 opacity-0 shadow-[0_12px_40px_rgba(15,23,42,0.18)] transition-all duration-200"
  >
    <p class="text-base font-semibold text-slate-900">Свяжитесь с нами</p>
    <div class="mt-3 space-y-2">
      <a
        href={PHONE_MAIN_HREF}
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-base font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-telephone shrink-0 text-base text-slate-400"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a
        href={PHONE_MOBILE_HREF}
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-base font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-phone shrink-0 text-base text-slate-400"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-base font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-whatsapp shrink-0 text-base text-slate-400"></i>
        WhatsApp
      </a>
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-base font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-telegram shrink-0 text-base text-slate-400"></i>
        Telegram
      </a>
    </div>
  </div>
</div>

<script>
  import { hapticTap } from '../scripts/haptic';
  document.querySelectorAll<HTMLElement>('button[data-haptic], a[data-haptic]')
    .forEach(el => el.addEventListener('click', hapticTap));

  let _stickyInited = false;
  function initStickyCta() {
    if (_stickyInited) return;
    _stickyInited = true;

    const hero = document.getElementById('hero');
    const bar = document.getElementById('sticky-bar');
    const bubble = document.getElementById('sticky-bubble');
    const desktopSticky = document.getElementById('desktop-sticky');
    const desktopToggle = document.getElementById('desktop-bubble-toggle');
    const desktopPanel = document.getElementById('desktop-bubble-panel');

    // --- Mobile sticky v2 (P1 2026-04-20) ---
    // Показывается после скролла 480px, скрывается кликом на крест (sessionStorage)
    if (bar && bar.hasAttribute('data-sticky-bar-v2') && window.matchMedia('(max-width: 767px)').matches) {
      const stickyBar = bar;
      const DISMISS_KEY = 'ac_sticky_v2_dismissed';
      let shown = false;

      function hideBar() {
        shown = false;
        sessionStorage.setItem(DISMISS_KEY, '1');
        stickyBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        stickyBar.setAttribute('inert', '');
      }

      function showBar() {
        if (shown || sessionStorage.getItem(DISMISS_KEY) === '1') return;
        shown = true;
        // Скрываем AgeBar чтобы она не перехватывала тапы (z-[60] < z-[70])
        const ageBar = document.getElementById('age-bar');
        if (ageBar) {
          ageBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        }
        stickyBar.removeAttribute('inert');
        // Анимация видимости — но пока pointer-events-none чтобы не было ghost click
        stickyBar.classList.remove('translate-y-full', 'opacity-0');
        // Разрешаем клики только через 400мс после появления (защита от ghost click при скролле)
        setTimeout(() => {
          stickyBar.classList.remove('pointer-events-none');
          // Вешаем listener ПОСЛЕ снятия pointer-events-none
          const closeBtn = stickyBar.querySelector<HTMLElement>('[data-sticky-close]');
          closeBtn?.addEventListener('click', hideBar, { once: true });
          closeBtn?.addEventListener('touchend', (e) => { e.preventDefault(); hideBar(); }, { once: true, passive: false });
        }, 400);
      }

      if (sessionStorage.getItem(DISMISS_KEY) !== '1') {
        if (hero) {
          // Показываем после того как hero покидает вьюпорт
          const mobileHeroObs = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) { showBar(); mobileHeroObs.disconnect(); }
          }, { threshold: 0 });
          mobileHeroObs.observe(hero);
        } else {
          // Нет hero (лендинги) — показываем после скролла 480px
          const onScroll = () => {
            if (window.scrollY > 480) { showBar(); window.removeEventListener('scroll', onScroll); }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      }

      stickyBar.querySelector<HTMLAnchorElement>('[data-sticky-call]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_call_mobile'); } catch {}
      });
      stickyBar.querySelector<HTMLAnchorElement>('[data-sticky-wa]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_wa_mobile'); } catch {}
      });
      stickyBar.querySelector<HTMLAnchorElement>('[data-sticky-tg]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_tg_mobile'); } catch {}
      });
    }

    // --- Desktop sticky — только на десктопе ---
    if (window.matchMedia('(max-width: 1023px)').matches) return;
    if (desktopSticky && desktopToggle && desktopPanel) {
      let panelOpen = false;

      // Если hero есть — скрываем кнопку пока hero виден; иначе всегда показываем
      if (hero) {
        const desktopObs = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) {
            desktopSticky.classList.add('hidden');
            desktopSticky.classList.remove('lg:flex');
          } else {
            desktopSticky.classList.remove('hidden');
            desktopSticky.classList.add('lg:flex');
          }
        }, { threshold: 0.1 });
        desktopObs.observe(hero);
      } else {
        // На лендингах hero нет — показываем сразу
        desktopSticky.classList.remove('hidden');
        desktopSticky.classList.add('lg:flex');
      }

      desktopToggle.addEventListener('click', () => {
        panelOpen = !panelOpen;
        if (panelOpen) {
          desktopPanel.classList.remove('hidden');
          requestAnimationFrame(() => {
            desktopPanel.classList.remove('scale-95', 'opacity-0');
            desktopPanel.classList.add('scale-100', 'opacity-100');
          });
        } else {
          desktopPanel.classList.add('scale-95', 'opacity-0');
          desktopPanel.classList.remove('scale-100', 'opacity-100');
          setTimeout(() => desktopPanel.classList.add('hidden'), 200);
        }
      });

      // Close panel on outside click
      document.addEventListener('click', (e) => {
        if (panelOpen && !desktopSticky.contains(e.target as Node)) {
          panelOpen = false;
          desktopPanel.classList.add('scale-95', 'opacity-0');
          desktopPanel.classList.remove('scale-100', 'opacity-100');
          setTimeout(() => desktopPanel.classList.add('hidden'), 200);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initStickyCta);
  initStickyCta();
</script>
