---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';
---
<!-- Sticky CTA — mobile: bottom bar / desktop: right-side bubble -->

<!-- ===== MOBILE: Sticky bottom-bar (📞 + 💬 WA) — P1 UX-fix 2026-04-20 ===== -->
<!-- Появляется после скролла >480px, закрывается крестом, hidden на desktop -->
<div
  id="sticky-bar"
  class="fixed bottom-0 inset-x-0 z-[70] md:hidden translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-out"
  style="background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,1) 20%); border-top: 1px solid rgba(17,24,39,0.08); box-shadow: 0 -8px 24px rgba(15,23,42,0.10); padding-bottom: env(safe-area-inset-bottom, 0);"
  inert
  data-sticky-bar-v2
>
  <div class="flex items-center justify-center gap-3 px-4 py-2.5">
    <a
      href={PHONE_MAIN_HREF}
      aria-label="Позвонить"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#c45f00] text-white shadow-[0_4px_12px_rgba(196,95,0,0.28)] active:scale-[0.94] transition-transform"
      data-sticky-call
    >
      <i class="bi bi-telephone-fill text-[24px]" aria-hidden="true"></i>
    </a>
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      aria-label="Написать в WhatsApp"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_4px_12px_rgba(37,211,102,0.32)] active:scale-[0.94] transition-transform"
      data-sticky-wa
    >
      <i class="bi bi-whatsapp text-[24px]" aria-hidden="true"></i>
    </a>
    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener"
      aria-label="Написать в Telegram"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[#229ED9] text-white shadow-[0_4px_12px_rgba(34,158,217,0.32)] active:scale-[0.94] transition-transform"
      data-sticky-tg
    >
      <i class="bi bi-telegram text-[24px]" aria-hidden="true"></i>
    </a>
    <button
      id="sticky-close"
      data-sticky-close
      type="button"
      class="flex h-12 w-12 items-center justify-center rounded-full text-slate-400 active:text-slate-700 transition-colors"
      aria-label="Скрыть панель контактов"
    >
      <i class="bi bi-x-lg pointer-events-none text-[20px]" aria-hidden="true"></i>
    </button>
  </div>
</div>

<!-- ===== LEGACY mobile bar (старый, на случай отката) — скрыт ===== -->
<div
  id="sticky-bar-legacy"
  class="fixed bottom-0 inset-x-0 z-50 hidden"
  aria-hidden="true"
  inert
>
  <a
    href={PHONE_MAIN_HREF}
    class="flex flex-col items-center gap-1 text-white text-[14px] font-medium"
  >
    <i class="bi bi-telephone-fill text-[20px]" aria-hidden="true"></i>
    Позвонить
  </a>
  <a
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center gap-1 text-white text-[14px] font-medium"
  >
    <i class="bi bi-whatsapp text-[20px]" aria-hidden="true"></i>
    WhatsApp
  </a>
  <a
    href={TELEGRAM_URL}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center gap-1 text-white text-[14px] font-medium"
  >
    <i class="bi bi-telegram text-[20px]" aria-hidden="true"></i>
    Telegram
  </a>
  <button
    id="sticky-close"
    type="button"
    class="flex flex-col items-center gap-1 text-white/50 text-[14px] hover:text-white transition-colors"
  >
    <i class="bi bi-x-lg text-[16px]" aria-hidden="true"></i>
    свернуть
  </button>
</div>

<!-- ===== MOBILE: Collapsed bubble — DISABLED ===== -->
<div
  id="sticky-bubble"
  class="hidden"
  aria-hidden="true"
>
  <i class="bi bi-telephone-fill text-white text-[20px]" aria-hidden="true"></i>
</div>

<!-- ===== DESKTOP: Right-side bubble with expand ===== -->
<div
  id="desktop-sticky"
  class="fixed right-5 bottom-6 z-50 hidden lg:block"
  data-desktop-sticky
>
  <!-- Collapsed: single round button -->
  <button
    type="button"
    id="desktop-bubble-toggle"
    aria-label="Связаться с нами"
    class="relative flex h-14 w-14 items-center justify-center rounded-full bg-slate-800/90 text-white/70 shadow-[0_4px_16px_rgba(0,0,0,0.25)] transition-all duration-300 hover:scale-105 hover:bg-slate-700/90 hover:text-white"
  >
    <i class="bi bi-telephone-fill text-[24px]" aria-hidden="true"></i>
  </button>

  <!-- Expanded panel -->
  <div
    id="desktop-bubble-panel"
    class="absolute bottom-[68px] right-0 hidden w-[220px] origin-bottom-right scale-95 rounded-[16px] bg-white p-4 opacity-0 shadow-[0_12px_40px_rgba(15,23,42,0.18)] transition-all duration-200"
  >
    <p class="text-[14px] font-semibold text-slate-900">Свяжитесь с нами</p>
    <div class="mt-3 space-y-2">
      <a
        href={PHONE_MAIN_HREF}
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-[14px] font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-telephone shrink-0 text-[15px] text-slate-400"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a
        href={PHONE_MOBILE_HREF}
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-[14px] font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-phone shrink-0 text-[15px] text-slate-400"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-[14px] font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-whatsapp shrink-0 text-[15px] text-slate-400"></i>
        WhatsApp
      </a>
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-[14px] font-medium text-slate-700 transition hover:bg-slate-50"
      >
        <i class="bi bi-telegram shrink-0 text-[15px] text-slate-400"></i>
        Telegram
      </a>
    </div>
  </div>
</div>

<script>
  let _stickyInited = false;
  function initStickyCta() {
    if (_stickyInited) return;
    _stickyInited = true;

    const hero = document.getElementById('hero');
    const bar = document.getElementById('sticky-bar');
    const bubble = document.getElementById('sticky-bubble');
    const desktopSticky = document.getElementById('desktop-sticky');
    const desktopToggle = document.getElementById('desktop-bubble-toggle');
    const desktopPanel = document.getElementById('desktop-bubble-panel');

    // --- Mobile sticky v2 (P1 2026-04-20) ---
    // Показывается после скролла 480px, скрывается кликом на крест (sessionStorage)
    if (bar && bar.hasAttribute('data-sticky-bar-v2') && window.matchMedia('(max-width: 767px)').matches) {
      const DISMISS_KEY = 'ac_sticky_v2_dismissed';
      let shown = false;

      function hideBar() {
        shown = false;
        sessionStorage.setItem(DISMISS_KEY, '1');
        bar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        bar.setAttribute('inert', '');
      }

      function showBar() {
        if (shown || sessionStorage.getItem(DISMISS_KEY) === '1') return;
        shown = true;
        // Скрываем AgeBar чтобы она не перехватывала тапы (z-[60] < z-[70])
        const ageBar = document.getElementById('age-bar');
        if (ageBar) {
          ageBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        }
        bar.removeAttribute('inert');
        // Анимация видимости — но пока pointer-events-none чтобы не было ghost click
        bar.classList.remove('translate-y-full', 'opacity-0');
        // Разрешаем клики только через 400мс после появления (защита от ghost click при скролле)
        setTimeout(() => {
          bar.classList.remove('pointer-events-none');
          // Вешаем listener ПОСЛЕ снятия pointer-events-none
          const closeBtn = bar.querySelector<HTMLElement>('[data-sticky-close]');
          closeBtn?.addEventListener('click', hideBar, { once: true });
          closeBtn?.addEventListener('touchend', (e) => { e.preventDefault(); hideBar(); }, { once: true, passive: false });
        }, 400);
      }

      if (sessionStorage.getItem(DISMISS_KEY) !== '1') {
        if (hero) {
          // Показываем после того как hero покидает вьюпорт
          const mobileHeroObs = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) { showBar(); mobileHeroObs.disconnect(); }
          }, { threshold: 0 });
          mobileHeroObs.observe(hero);
        } else {
          // Нет hero (лендинги) — показываем после скролла 480px
          const onScroll = () => {
            if (window.scrollY > 480) { showBar(); window.removeEventListener('scroll', onScroll); }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      }

      bar.querySelector<HTMLAnchorElement>('[data-sticky-call]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_call_mobile'); } catch {}
      });
      bar.querySelector<HTMLAnchorElement>('[data-sticky-wa]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_wa_mobile'); } catch {}
      });
      bar.querySelector<HTMLAnchorElement>('[data-sticky-tg]')?.addEventListener('click', () => {
        try { (window as any).trackGoal?.('sticky_tg_mobile'); } catch {}
      });
    }

    // --- Desktop sticky — только на десктопе ---
    if (window.matchMedia('(max-width: 1023px)').matches) return;
    if (desktopSticky && desktopToggle && desktopPanel) {
      let panelOpen = false;

      // Если hero есть — скрываем кнопку пока hero виден; иначе всегда показываем
      if (hero) {
        const desktopObs = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) {
            desktopSticky.classList.add('hidden');
            desktopSticky.classList.remove('lg:flex');
          } else {
            desktopSticky.classList.remove('hidden');
            desktopSticky.classList.add('lg:flex');
          }
        }, { threshold: 0.1 });
        desktopObs.observe(hero);
      } else {
        // На лендингах hero нет — показываем сразу
        desktopSticky.classList.remove('hidden');
        desktopSticky.classList.add('lg:flex');
      }

      desktopToggle.addEventListener('click', () => {
        panelOpen = !panelOpen;
        if (panelOpen) {
          desktopPanel.classList.remove('hidden');
          requestAnimationFrame(() => {
            desktopPanel.classList.remove('scale-95', 'opacity-0');
            desktopPanel.classList.add('scale-100', 'opacity-100');
          });
        } else {
          desktopPanel.classList.add('scale-95', 'opacity-0');
          desktopPanel.classList.remove('scale-100', 'opacity-100');
          setTimeout(() => desktopPanel.classList.add('hidden'), 200);
        }
      });

      // Close panel on outside click
      document.addEventListener('click', (e) => {
        if (panelOpen && !desktopSticky.contains(e.target as Node)) {
          panelOpen = false;
          desktopPanel.classList.add('scale-95', 'opacity-0');
          desktopPanel.classList.remove('scale-100', 'opacity-100');
          setTimeout(() => desktopPanel.classList.add('hidden'), 200);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initStickyCta);
  initStickyCta();
</script>
