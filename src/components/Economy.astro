---
const phoneTime = [
  '5 минут — 50 ₽',
  '30 минут — 300 ₽',
  '60 минут — 600 ₽ (весь дневной бюджет)',
];

const events = [
  'Фильм на вечер — 3 000 ₽',
  'Костёр с зефирками — 5 000 ₽',
  'Отбой на час позже — 4 000 ₽',
  'Ночь с телефонами — 20 000 ₽',
];
---

<section id="economy" class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Телефон здесь зарабатывают</h2>
    </div>

    <!-- Блок 1: Вводный текст -->
    <div class="mt-5">
      <h3 class="text-[18px] font-semibold leading-[1.3] text-body">Лагерь без телефонов — это не запрет. Это система.</h3>
      <p class="mt-3 text-[18px] leading-[1.65] text-body-muted">При заезде телефоны сдаются вожатому. Каждый день каждый участник получает 600 игровых рублей. 10 рублей — одна минута телефонного времени. Хочешь позвонить домой — пожалуйста. Хочешь накопить — копи. Хочешь потратить на что-то другое — есть варианты.</p>

    </div>

    <!-- Блок 2: На что тратят -->
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <!-- Телефонное время -->
      <div class="rounded-[16px] border border-border bg-card p-4 md:p-5 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_20px_48px_rgba(15,23,42,0.14)]">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
          <h4 class="text-[16px] font-semibold text-body">Телефонное время</h4>
        </div>
        <ul class="mt-3 space-y-2">
          {phoneTime.map((item) => (
            <li class="flex items-start gap-2 text-[16px] leading-[1.5] text-body-muted">
              <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[13px] leading-[1.5] text-body-muted">Ограничение телефонов — это игра. При серьёзных обстоятельствах правила снимаются: ребёнок всегда может связаться с родителями.</p>
      </div>

      <!-- Коллективные события -->
      <div class="rounded-[16px] border border-border bg-card p-4 md:p-5 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_20px_48px_rgba(15,23,42,0.14)]">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
          <h4 class="text-[16px] font-semibold text-body">Коллективные события</h4>
        </div>
        <ul class="mt-3 space-y-2">
          {events.map((item) => (
            <li class="flex items-start gap-2 text-[16px] leading-[1.5] text-body-muted">
              <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[15px] md:text-[14px] text-body-muted">Чтобы купить — нужно договориться и скинуться. Первый урок про бюджет и коллективные решения.</p>
      </div>
    </div>

    <!-- Блок 3: Цитата -->
    <div class="mt-6 rounded-r-xl border-l-4 border-orange-500 bg-orange-50 p-4">
      <p class="text-[18px] italic leading-[1.65] text-body-muted">К концу смены у большинства остаётся 5–10 минут телефона в день — и это их собственный выбор. Настолки, мафия, волейбол и работа над проектом оказываются интереснее ютуба.</p>
    </div>

    <!-- Блок 4: Родительский контроль -->
    <div class="mt-5 flex items-start gap-2.5 rounded-xl border border-emerald-100 bg-emerald-50/70 p-4">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 mt-0.5">
        <i class="bi bi-camera-fill text-[14px] text-emerald-700" aria-hidden="true"></i>
      </div>
      <div class="text-[15px] leading-[1.5] text-body-muted">
        <span class="font-semibold text-body">Родительский контроль:</span>
        фото-отчёт 2 раза в день в Telegram · круглосуточная связь с вожатым
      </div>
    </div>
  </div>
</section>
