---
// Featured-блок «Наш лагерь — АйДаКемп» для рейтинг-страницы /luchshie.
// АйДаКемп показан отдельно и НЕ входит в рейтинг конкурентов (наш сайт — себя не оцениваем).
import { OUR_CAMP } from '../../data/luchshieCamps';
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
---

<section class="mx-auto max-w-[1080px] px-4 py-10">
  <div class="rounded-[24px] border-2 border-orange-200 bg-orange-50/60 p-6 md:p-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-flex items-center rounded-full bg-orange-500 text-white text-[13px] font-semibold px-3 py-1">Без сравнения</span>
      <span class="text-[13px] text-slate-500">это наш сайт, себя не оцениваем</span>
    </div>
    <h2 class="text-[24px] md:text-[30px] font-bold text-body leading-tight mb-2">{OUR_CAMP.name} — {OUR_CAMP.niche}</h2>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[15px] text-body-muted mb-4">
      <span class="inline-flex items-center gap-1 font-semibold text-orange-600"><i class="bi bi-star-fill text-[13px]" aria-hidden="true"></i> {OUR_CAMP.rating.toFixed(1)}</span>
      <span>· {OUR_CAMP.reviews} отзывов на Яндекс.Картах</span>
      <span>· работает с {OUR_CAMP.year}</span>
      <span>· {OUR_CAMP.location}</span>
    </div>
    <p class="text-[16px] text-body-muted leading-relaxed mb-5">Python, AI, Minecraft, Roblox, 3D — каждый из детей 7–15 лет уезжает с собственным IT-проектом. Лицензия Минобрнауки, группы до 8 человек, бассейн, 5-разовое питание, медработник 24/7. Открыты августовские смены {SEASON_YEAR}, от {PRICE_MIN}.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/ceny/" class="inline-flex items-center rounded-full bg-orange-500 text-white font-semibold px-5 py-2.5 hover:bg-orange-600 transition-colors">Смены и цены {SEASON_YEAR}</a>
      <a href="/otzyvy/" class="inline-flex items-center rounded-full border border-slate-300 text-body font-semibold px-5 py-2.5 hover:border-orange-400 transition-colors">Читать отзывы</a>
    </div>
  </div>
</section>
