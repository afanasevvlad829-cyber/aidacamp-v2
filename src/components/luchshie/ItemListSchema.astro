---
/**
 * ItemListSchema — JSON-LD schema.org/ItemList для рейтинг-страницы /luchshie-detskie-lagerya.
 * Тир-1 (campNiches) — полные карточки: имя + адрес + AggregateRating.
 * Тир-2/тир-3 (compactCamps/catalogCamps) — тоже реальные оценки, но без адреса/локации
 * в части записей, поэтому идут упрощёнными ListItem (только имя + AggregateRating, где есть рейтинг).
 * Без ссылок на конкурентов (item — LocalBusiness без url), только факты.
 */
import type { CampNiche, CompactCamp, CatalogCamp } from '../../data/luchshieCamps';

interface Props {
  niches: CampNiche[];
  compactCamps?: CompactCamp[];
  catalogCamps?: CatalogCamp[];
}

const { niches, compactCamps = [], catalogCamps = [] } = Astro.props;

function toListItem(name: string, rating: number | undefined, reviews: number | undefined, address?: string) {
  return {
    '@type': 'LocalBusiness',
    name,
    ...(address ? { address } : {}),
    ...(rating ? {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: rating,
        reviewCount: reviews,
        bestRating: 5,
      },
    } : {}),
  };
}

const tier1 = niches.flatMap((niche) => niche.camps).filter((camp) => camp.rating)
  .map((camp) => toListItem(camp.name, camp.rating, camp.reviews, camp.location));

const tier2 = compactCamps.filter((camp) => camp.rating)
  .map((camp) => toListItem(camp.name, camp.rating, camp.reviews, camp.location));

const tier3 = catalogCamps.filter((camp) => camp.rating)
  .map((camp) => toListItem(camp.name, camp.rating, camp.reviews, camp.location));

const itemListElement = [...tier1, ...tier2, ...tier3].map((item, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  item,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Лучшие детские лагеря Подмосковья — рейтинг по оценкам Яндекс.Карт',
  itemListElement,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
