---
import { PHONE_MAIN } from '../data/contacts';
import MobileMenu from './MobileMenu.astro';
import PhoneDropdown from './PhoneDropdown.astro';
import BrandName from './BrandName.astro';

// Menu per Design System v3 (Section 16):
// Top: главные конверсионные + философия. More: вспомогательные.
const navItems = [
  { label: 'Смены', href: '#shifts' },
  { label: 'Цены', href: '#economy' },
  { label: 'Философия', href: '#philosophy' },
  { label: 'Спросить анонимно', href: '/ask', highlight: true },
];

const moreItems = [
  { label: 'О лагере', href: '#about' },
  { label: 'Как проходит смена', href: '#journey' },
  { label: 'Команда', href: '#team' },
  { label: 'Размещение', href: '#stay' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Документы', href: '/stati/dokumenty-licenziya-strahovka/' },
  { label: 'Фото', href: '/foto/' },
  { label: 'Видео', href: '/video/' },
  { label: 'Контакты', href: '#contacts' },
];

const allNavItems = [...navItems, ...moreItems];
---

<header class="absolute inset-x-0 top-0 z-40">
  <!-- Desktop Header -->
  <div class="mx-auto hidden h-16 max-w-[1440px] items-center justify-between px-6 md:flex">
    <!-- Logo + Brand -->
    <a href="/" class="flex items-center gap-3">
      <img
        src="/assets/icons/aida-logo.webp"
        alt=""
        aria-hidden="true"
        class="h-10 w-10"
        width="40"
        height="40"
        decoding="async"
      />
      <span class="text-sm font-semibold leading-tight [text-shadow:0px_1px_2px_rgba(0,0,0,0.45)]">
        <span class="text-white/50">АйТи-лагерь для 7–15 лет</span><br />
        <span class="text-white/60">#</span><BrandName variant="header" class="text-base" />
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="flex items-center gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-[13px] px-3 py-1.5 text-[14px] font-semibold leading-[15px] backdrop-blur-sm transition hover:-translate-y-0.5",
            item.highlight
              ? "border border-primary/60 bg-primary/15 text-[#ffd1a3] [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)]"
              : "border border-white/18 bg-[rgba(43,51,61,0.58)] text-white/86 [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)]"
          ]}
          data-analytics-goal={item.highlight ? "anon_qa_click" : "nav_click"}
          data-analytics-label={item.label}
        >
          {item.label}
        </a>
      ))}

      <!-- More dropdown -->
      <div class="group relative" data-nav-more-root>
        <button type="button" data-nav-more-toggle aria-expanded="false" class="flex cursor-pointer items-center gap-1 rounded-[13px] border border-white/18 bg-[rgba(43,51,61,0.58)] px-3 py-1.5 text-[14px] font-semibold leading-[15px] text-white/86 backdrop-blur-sm transition [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)]">
          <span>···</span>
          <svg class="h-3 w-3 transition-transform" id="nav-more-chevron" width="12" height="12" fill="none" viewBox="0 0 12 12">
            <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="nav-more-menu"
          class="hidden absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px]"
        >
          {moreItems.map((item) => (
            <a
              href={item.href}
              class="rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:-translate-y-0.5 hover:bg-white/10"
              data-analytics-goal="nav_click"
              data-analytics-label={item.label}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Search trigger + Phone Dropdown (Desktop) -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-trigger
        aria-label="Поиск по сайту (Ctrl+K)"
        title="Поиск (Ctrl+K)"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 transition hover:bg-white/10 hover:text-white"
      >
        <i class="bi bi-search text-[16px]" aria-hidden="true"></i>
      </button>
      <PhoneDropdown variant="desktop" />
    </div>
  </div>

  <!-- Mobile Header -->
  <div class="flex h-[76px] items-center justify-between px-4 md:hidden">
    <!-- Burger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="flex h-14 w-14 items-center justify-center rounded-xl text-white"
      aria-label="Открыть меню"
    >
      <svg id="burger-icon" class="h-9 w-9" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="hidden h-9 w-9" style="display:none" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <img
        src="/assets/icons/aida-logo.webp"
        alt=""
        aria-hidden="true"
        class="h-[54px] w-[54px]"
        width="54"
        height="54"
        decoding="async"
      />
      <span class="text-[19px] font-semibold leading-tight [text-shadow:0px_1px_2px_rgba(0,0,0,0.45)]">
        <span class="text-white/50">АйТи-лагерь</span><br />
        <span class="text-white/60">#</span><BrandName variant="header" class="text-[22px]" />
      </span>
    </a>

    <!-- Phone (Mobile) -->
    <PhoneDropdown variant="mobile" />
  </div>

  <!-- Mobile Menu -->
  <MobileMenu items={allNavItems} />
</header>

<script>
  // Nav-more dropdown toggle
  function initNavMore() {
    const root = document.querySelector<HTMLElement>('[data-nav-more-root]');
    const toggle = root?.querySelector<HTMLButtonElement>('[data-nav-more-toggle]');
    const menu = document.getElementById('nav-more-menu');
    const chevron = document.getElementById('nav-more-chevron');
    if (!root || !toggle || !menu) return;

    function open() {
      menu.classList.remove('hidden');
      toggle!.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
    function close() {
      menu.classList.add('hidden');
      toggle!.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.style.transform = '';
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.contains('hidden') ? open() : close();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  document.addEventListener('astro:page-load', initNavMore);
  initNavMore();

  // Если якоря нет на текущей странице — ведём на главную с якорем
  document.querySelectorAll<HTMLAnchorElement>('header a[href^="#"]').forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    if (id && id !== 'hero' && !document.getElementById(id)) {
      link.setAttribute('href', '/' + link.getAttribute('href'));
    }
  });
</script>
