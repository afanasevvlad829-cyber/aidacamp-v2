---
import { PHONE_MAIN } from '../data/contacts';
import MobileMenu from './MobileMenu.astro';
import PhoneDropdown from './PhoneDropdown.astro';
import BrandName from './BrandName.astro';

// Menu per Design System v3 (Section 16):
// Top: главные конверсионные + философия. More: вспомогательные.
const navItems = [
  { label: 'Смены', href: '/#shifts' },
  { label: 'Цены', href: '/#shifts' },
  { label: 'Философия', href: '/#philosophy', returningHide: true },
];

const moreItems = [
  { label: 'О лагере', href: '/#about', returningHide: true },
  { label: 'Как проходит смена', href: '/#journey', returningHide: true },
  { label: 'Команда', href: '/#team' },
  { label: 'Размещение', href: '/#stay' },
  { label: 'Отзывы', href: '/#reviews' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Документы', href: '/stati/dokumenty-licenziya-strahovka/' },
  { label: 'Фото', href: '/foto/' },
  { label: 'Видео', href: '/video/' },
  { label: 'Контакты', href: '/#contacts' },
];

const allNavItems = [...navItems, ...moreItems];
---

<header class="absolute inset-x-0 top-0 z-40">
  <!-- Desktop Header -->
  <div class="mx-auto hidden h-16 max-w-[1440px] items-center justify-between px-6 md:flex">
    <!-- Logo + Brand -->
    <a href="/" class="flex items-center gap-3">
      <img
        src="/assets/icons/aida-logo.svg"
        alt=""
        aria-hidden="true"
        class="h-10 w-10 rounded-full"
        width="40"
        height="40"
        decoding="async"
      />
      <span class="text-[18px] font-bold leading-none [text-shadow:0px_1px_2px_rgba(0,0,0,0.45)]">
        <BrandName variant="header" class="text-white" />
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="flex items-center gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-1.5 text-[14px] font-semibold leading-[15px] transition hover:-translate-y-0.5",
            item.highlight ? "text-[#ffd1a3]" : "text-white"
          ]}
          style="text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 12px rgba(0,0,0,0.85), 0 0 22px rgba(0,0,0,0.55);"
          data-analytics-goal={item.highlight ? "anon_qa_click" : "nav_click"}
          data-analytics-label={item.label}
          data-returning-hide={item.returningHide ? "true" : undefined}
        >
          {item.label}
        </a>
      ))}

      <!-- More dropdown -->
      <div class="group relative" data-nav-more-root>
        <button type="button" data-nav-more-toggle aria-expanded="false" class="flex cursor-pointer items-center gap-1 px-3 py-1.5 text-[14px] font-semibold leading-[15px] text-white transition" style="text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 12px rgba(0,0,0,0.85), 0 0 22px rgba(0,0,0,0.55); filter: drop-shadow(0 0 14px rgba(0,0,0,0.6));">
          <i class="bi bi-three-dots text-[14px]" aria-hidden="true"></i>
          <i class="bi bi-chevron-down text-[10px] transition-transform" id="nav-more-chevron" aria-hidden="true"></i>
        </button>
        <div
          id="nav-more-menu"
          class="hidden absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px]"
        >
          {moreItems.map((item) => (
            <a
              href={item.href}
              class="rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:-translate-y-0.5 hover:bg-white/10"
              data-analytics-goal="nav_click"
              data-analytics-label={item.label}
              data-returning-hide={item.returningHide ? "true" : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Search trigger + Phone Dropdown (Desktop) -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-trigger
        aria-label="Поиск по сайту (Ctrl+K)"
        title="Поиск (Ctrl+K)"
        class="search-trigger inline-flex h-11 w-11 items-center justify-center text-white transition" style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.95)) drop-shadow(0 0 14px rgba(0,0,0,0.7)) drop-shadow(0 0 24px rgba(0,0,0,0.45));"
      >
        <i class="bi bi-search text-[16px]" aria-hidden="true"></i>
      </button>
      <PhoneDropdown variant="desktop" />
    </div>
  </div>

  <!-- Mobile Header -->
  <div class="flex h-[76px] items-center justify-between px-4 md:hidden">
    <!-- Burger -->
    <button
      type="button"
      id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-white"
      aria-label="Открыть меню"
    >
      <svg id="burger-icon" class="h-7 w-7" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="hidden h-7 w-7" style="display:none" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Logo — упрощено в одну строку (premium clean), круглый -->
    <a href="/" class="flex items-center gap-2.5">
      <img
        src="/assets/icons/aida-logo.svg"
        alt=""
        aria-hidden="true"
        class="h-[44px] w-[44px] rounded-full"
        width="44"
        height="44"
        decoding="async"
      />
      <span class="text-[20px] font-bold leading-none [text-shadow:0px_1px_2px_rgba(0,0,0,0.55)]">
        <BrandName variant="header" class="text-white" />
      </span>
    </a>

    <!-- Phone (Mobile) -->
    <PhoneDropdown variant="mobile" />
  </div>

  <!-- Mobile Menu -->
  <MobileMenu items={allNavItems} />
</header>

<script>
  // Nav-more dropdown toggle
  function initNavMore() {
    const root = document.querySelector<HTMLElement>('[data-nav-more-root]');
    const toggle = root?.querySelector<HTMLButtonElement>('[data-nav-more-toggle]');
    const menu = document.getElementById('nav-more-menu');
    const chevron = document.getElementById('nav-more-chevron');
    if (!root || !toggle || !menu) return;

    function open() {
      menu.classList.remove('hidden');
      toggle!.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
    function close() {
      menu.classList.add('hidden');
      toggle!.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.style.transform = '';
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.contains('hidden') ? open() : close();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  document.addEventListener('astro:page-load', initNavMore);
  initNavMore();

  // Скрываем пункты меню на скрытые для возвратников секции
  (function () {
    try {
      const hasViewed = !!localStorage.getItem('ac:viewed_shifts');
      const hasYmUid  = /(?:^|[; ])_ym_uid=/.test(document.cookie);
      if (hasViewed || hasYmUid) {
        document.querySelectorAll<HTMLElement>('[data-returning-hide="true"]').forEach((el) => {
          el.style.display = 'none';
        });
      }
    } catch {}
  })();

  // Якорные ссылки: если на главной — smooth scroll, иначе полный переход /#X
  // Для не-главных страниц (в т.ч. /r/) ставим r_redirected='1' чтобы
  // redirect-скрипт на / не редиректил повторно на /r/
  document.querySelectorAll<HTMLAnchorElement>('header a[href^="/#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const hash = link.getAttribute('href')!.slice(1); // '#shifts'
      const target = document.getElementById(hash.slice(1)); // 'shifts'
      if (target && window.location.pathname === '/') {
        // На главной — smooth scroll без перезагрузки
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', hash);
      } else {
        // На другой странице (/r/, /stati/ и т.д.) — помечаем что уже были перенаправлены,
        // чтобы при приходе на / не сработал повторный редирект на /r/
        try { sessionStorage.setItem('r_redirected', '1'); } catch {}
      }
    });
  });
</script>
