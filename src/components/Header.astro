---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';

const navItems = [
  { label: 'О лагере', href: '#about' },
  { label: 'Смены', href: '#shifts' },
  { label: 'Фото', href: '#gallery' },
];

const moreItems = [
  { label: 'Как проходит смена', href: '#journey' },
  { label: 'Видео', href: '#videos' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Команда', href: '#team' },
  { label: 'Размещение', href: '#stay' },
  { label: 'Контакты', href: '#contacts' },
];

const allNavItems = [...navItems, ...moreItems];
---

<header class="absolute inset-x-0 top-0 z-40">
  <!-- Desktop Header -->
  <div class="mx-auto hidden h-16 max-w-[1440px] items-center justify-between px-6 md:flex">
    <!-- Logo + Brand -->
    <a href="#hero" class="flex items-center gap-3">
      <img
        src="/assets/icons/aida-logo-original.svg"
        alt=""
        aria-hidden="true"
        class="h-10 w-10"
        width="40"
        height="40"
      />
      <span class="text-sm font-semibold leading-tight text-white [text-shadow:0px_1px_2px_rgba(0,0,0,0.45)]">
        АйТи-лагерь для 7–14 лет<br />#АйДаКемп
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="flex items-center gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-[13px] border border-white/18 bg-[rgba(43,51,61,0.58)] px-3 py-1.5 text-[14px] font-semibold leading-[15px] text-white/86 backdrop-blur-sm transition hover:-translate-y-0.5 [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)]"
          data-analytics-goal="nav_click"
          data-analytics-label={item.label}
        >
          {item.label}
        </a>
      ))}

      <!-- More dropdown -->
      <details class="group relative" data-nav-more-root>
        <summary class="flex cursor-pointer items-center gap-1 rounded-[13px] border border-white/18 bg-[rgba(43,51,61,0.58)] px-3 py-1.5 text-[14px] font-semibold leading-[15px] text-white/86 backdrop-blur-sm transition [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)] list-none [&::-webkit-details-marker]:hidden">
          <span>···</span>
          <svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 12 12">
            <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div
          id="nav-more-menu"
          class="invisible absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 opacity-0 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px] transition-all group-open:visible group-open:translate-y-0 group-open:opacity-100"
        >
          {moreItems.map((item) => (
            <a
              href={item.href}
              class="rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:-translate-y-0.5 hover:bg-white/10"
              data-analytics-goal="nav_click"
              data-analytics-label={item.label}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </nav>

    <!-- Phone Dropdown (Desktop) -->
    <details class="group relative" data-hero-phone-dropdown="desktop">
      <summary class="inline-flex h-12 cursor-pointer items-center gap-3 whitespace-nowrap rounded-3xl border border-white/42 bg-white/11 px-5 text-[15px] font-semibold text-white backdrop-blur-sm [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)] list-none [&::-webkit-details-marker]:hidden">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {PHONE_MAIN}
        <svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 12 12">
          <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="invisible absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 opacity-0 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px] transition-all group-open:visible group-open:translate-y-0 group-open:opacity-100">
        <a href={PHONE_MAIN_HREF} class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_495">
          <i class="bi bi-telephone shrink-0 text-[15px]"></i>
          <span class="whitespace-nowrap">{PHONE_MAIN}</span>
        </a>
        <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_968">
          <i class="bi bi-phone shrink-0 text-[15px]"></i>
          <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="whatsapp">
          <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
          WhatsApp
        </a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="telegram">
          <i class="bi bi-telegram shrink-0 text-[15px]"></i>
          Telegram
        </a>
      </div>
    </details>
  </div>

  <!-- Mobile Header -->
  <div class="flex h-[76px] items-center justify-between px-4 md:hidden">
    <!-- Burger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="flex h-14 w-14 items-center justify-center rounded-xl text-white"
      aria-label="Открыть меню"
    >
      <svg id="burger-icon" class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="hidden h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Logo -->
    <a href="#hero" class="flex items-center gap-2">
      <img
        src="/assets/icons/aida-logo-original.svg"
        alt=""
        aria-hidden="true"
        class="h-[54px] w-[54px]"
        width="54"
        height="54"
      />
      <span class="text-[19px] font-semibold leading-tight text-white [text-shadow:0px_1px_2px_rgba(0,0,0,0.45)]">
        АйТи-лагерь<br />#АйДаКемп
      </span>
    </a>

    <!-- Phone (Mobile) -->
    <details class="group relative" data-hero-phone-dropdown="mobile">
      <summary class="flex h-14 w-14 cursor-pointer items-center justify-center rounded-xl border border-white/30 bg-white/10 text-white backdrop-blur-sm list-none [&::-webkit-details-marker]:hidden">
        <svg class="h-[30px] w-[30px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </summary>
      <div class="invisible absolute right-0 top-[calc(100%+8px)] z-50 grid min-w-[200px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 opacity-0 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px] transition-all group-open:visible group-open:translate-y-0 group-open:opacity-100">
        <a href={PHONE_MAIN_HREF} class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
          <i class="bi bi-telephone shrink-0 text-[15px]"></i>
          <span class="whitespace-nowrap">{PHONE_MAIN}</span>
        </a>
        <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
          <i class="bi bi-phone shrink-0 text-[15px]"></i>
          <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
          <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
          WhatsApp
        </a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
          <i class="bi bi-telegram shrink-0 text-[15px]"></i>
          Telegram
        </a>
      </div>
    </details>
  </div>

  <!-- Mobile Menu Overlay -->
  <nav
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden flex-col bg-[rgba(7,14,26,0.96)] backdrop-blur-lg"
  >
    <div class="flex h-14 items-center justify-between px-4">
      <button
        type="button"
        id="mobile-menu-close"
        class="flex h-10 w-10 items-center justify-center rounded-xl text-white"
        aria-label="Закрыть меню"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <span class="text-sm font-semibold text-white">Меню</span>
      <div class="w-10"></div>
    </div>
    <div class="flex flex-1 flex-col gap-1 overflow-y-auto p-4">
      {allNavItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10"
          data-analytics-goal="nav_click"
          data-analytics-label={item.label}
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="border-t border-white/10 p-4">
      <a href={PHONE_MAIN_HREF} class="mb-2 block rounded-xl bg-primary px-4 py-3 text-center text-sm font-semibold text-white">
        {PHONE_MAIN}
      </a>
      <div class="flex gap-2">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex-1 rounded-xl border border-white/20 py-2.5 text-center text-sm font-medium text-white/90">WhatsApp</a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex-1 rounded-xl border border-white/20 py-2.5 text-center text-sm font-medium text-white/90">Telegram</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const burgerIcon = document.getElementById('burger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    burgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    burgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  // Close on nav link click
  menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close details on click outside
  document.addEventListener('click', (e) => {
    document.querySelectorAll('header details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) {
        d.removeAttribute('open');
      }
    });
  });

  // Если якоря нет на текущей странице — ведём на главную с якорем
  document.querySelectorAll<HTMLAnchorElement>('header a[href^="#"]').forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    if (id && id !== 'hero' && !document.getElementById(id)) {
      link.setAttribute('href', '/' + link.getAttribute('href'));
    }
  });
</script>
