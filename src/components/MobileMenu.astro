---
import { PHONE_MAIN, PHONE_MAIN_HREF } from '../data/contacts';

interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<!-- Mobile Menu Overlay -->
<nav
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden flex-col bg-[rgba(7,14,26,0.96)] backdrop-blur-lg"
>
  <div class="flex h-14 items-center justify-between px-4">
    <button
      type="button"
      id="mobile-menu-close"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-white"
      aria-label="Закрыть меню"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <span class="text-sm font-semibold text-white">Меню</span>
    <div class="w-10"></div>
  </div>
  <div class="flex flex-1 flex-col overflow-y-auto p-4 gap-5">
    <!-- Группа 1: Главное (конверсионное) -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">Главное</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['Смены', 'Цены', 'Философия'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label} data-returning-hide={item.returningHide ? "true" : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Группа 2: О лагере -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">О лагере</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['О лагере', 'Как проходит смена', 'Команда', 'Размещение', 'Отзывы', 'FAQ'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label} data-returning-hide={item.returningHide ? "true" : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Группа 3: Документы и медиа -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">Документы и медиа</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['Документы', 'Фото', 'Видео', 'Контакты'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label} data-returning-hide={item.returningHide ? "true" : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 p-4">
    <a href={PHONE_MAIN_HREF} class="block rounded-xl border border-orange-400/50 bg-primary/12 px-4 py-3 text-center text-sm font-semibold text-orange-200 transition-colors hover:bg-primary/20">
      {PHONE_MAIN}
    </a>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuClose = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');
    const closeIcon = document.getElementById('close-icon');

    // iOS Safari fix: overflow:hidden alone doesn't prevent background scroll.
    // Use position:fixed + scroll restoration instead.
    let savedScrollY = 0;
    function lockScroll() {
      savedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }
    function unlockScroll() {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, savedScrollY);
    }

    function openMenu() {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      burgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      if (closeIcon) (closeIcon as HTMLElement).style.display = '';
      lockScroll();
      menuBtn?.setAttribute('aria-expanded', 'true');
      menuBtn?.setAttribute('aria-label', 'Закрыть меню');
    }

    function closeMenu() {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      burgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      unlockScroll();
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.setAttribute('aria-label', 'Открыть меню');
    }

    menuBtn?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);

    // Close on nav link click + smooth scroll для якорных ссылок на главной
    menu?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        closeMenu();
        const href = link.getAttribute('href') || '';
        if (href.startsWith('/#')) {
          if (window.location.pathname === '/') {
            const target = document.getElementById(href.slice(2));
            if (target) {
              e.preventDefault();
              setTimeout(() => {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.pushState(null, '', href.slice(1));
              }, 200);
            }
          } else {
            // Не на главной (/r/ и др.) — предотвратить повторный редирект
            try { sessionStorage.setItem('r_redirected', '1'); } catch {}
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initMobileMenu);
  initMobileMenu();

  // Скрываем пункты мобильного меню для скрытых для возвратников секций
  (function () {
    try {
      const hasViewed = !!localStorage.getItem('ac:viewed_shifts');
      const hasYmUid  = /(?:^|[; ])_ym_uid=/.test(document.cookie);
      if (hasViewed || hasYmUid) {
        document.querySelectorAll<HTMLElement>('#mobile-menu [data-returning-hide="true"]').forEach((el) => {
          el.style.display = 'none';
        });
      }
    } catch {}
  })();
</script>
