---
import { PHONE_MAIN, PHONE_MAIN_HREF } from '../data/contacts';

interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<!-- Mobile Menu Overlay -->
<nav
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden flex-col bg-[rgba(7,14,26,0.96)] backdrop-blur-lg"
>
  <div class="flex h-14 items-center justify-between px-4">
    <button
      type="button"
      id="mobile-menu-close"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-white"
      aria-label="Закрыть меню"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <span class="text-sm font-semibold text-white">Меню</span>
    <div class="w-10"></div>
  </div>
  <div class="flex flex-1 flex-col overflow-y-auto p-4 gap-5">
    <!-- Группа 1: Главное (конверсионное) -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">Главное</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['Смены', 'Цены', 'Философия'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Группа 2: О лагере -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">О лагере</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['О лагере', 'Как проходит смена', 'Команда', 'Размещение', 'Отзывы', 'FAQ'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Группа 3: Документы и медиа -->
    <div>
      <p class="px-4 mb-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40">Документы и медиа</p>
      <div class="flex flex-col gap-0.5">
        {items.filter(i => ['Документы', 'Фото', 'Видео', 'Контакты'].includes(i.label)).map((item) => (
          <a href={item.href} class="mobile-nav-link rounded-xl px-4 py-3 text-base font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="nav_click" data-analytics-label={item.label}>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 p-4">
    <a href={PHONE_MAIN_HREF} class="block rounded-xl border border-orange-400/50 bg-orange-500/12 px-4 py-3 text-center text-sm font-semibold text-orange-200 transition-colors hover:bg-orange-500/20">
      {PHONE_MAIN}
    </a>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuClose = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');
    const closeIcon = document.getElementById('close-icon');

    function openMenu() {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      burgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      if (closeIcon) (closeIcon as HTMLElement).style.display = '';
      document.body.style.overflow = 'hidden';
      menuBtn?.setAttribute('aria-expanded', 'true');
      menuBtn?.setAttribute('aria-label', 'Закрыть меню');
    }

    function closeMenu() {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      burgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.setAttribute('aria-label', 'Открыть меню');
    }

    menuBtn?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);

    // Close on nav link click
    menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  document.addEventListener('astro:page-load', initMobileMenu);
  initMobileMenu();
</script>
