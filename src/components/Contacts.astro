---
import { Icon } from 'astro-icon/components';
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, EMAIL, EMAIL_HREF, WHATSAPP_URL, TELEGRAM_URL, YANDEX_MAPS_URL } from '../data/contacts';
import StaticYandexMap from './StaticYandexMap.astro';
---

<section id="contacts" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2">
        <div class="list-accent-dot"></div>
        <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Контакты</h2>
      </div>
      <a href="/kontakty/" class="inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover shrink-0">
        Схема проезда в Подмосковье →
      </a>
    </div>

    <div class="mt-4 flex flex-col gap-5 md:flex-row md:gap-8">

      <div class="flex flex-col gap-4 sm:flex-row sm:gap-8 md:shrink-0">
        <div>
          <p class="text-base font-semibold text-body mb-2">Телефоны</p>
          <div class="space-y-1.5">
            <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="phone_click">
              <Icon name="bi:phone" class="bi bi-phone shrink-0 text-base md:text-base text-body-faint" />
              <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
            </a>
            <a href={PHONE_MAIN_HREF} class="flex items-center gap-2 text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="phone_click">
              <Icon name="bi:telephone" class="bi bi-telephone shrink-0 text-base md:text-base text-body-faint" />
              <span class="whitespace-nowrap">{PHONE_MAIN}</span>
            </a>
            <a href={EMAIL_HREF} class="flex items-center gap-2 text-base md:text-base text-body-faint hover:text-orange-500 transition-colors">
              <Icon name="bi:envelope" class="bi bi-envelope text-base md:text-base text-body-faint" aria-hidden="true" />
              {EMAIL}
            </a>
          </div>
        </div>

        <div>
          <p class="text-base font-semibold text-body mb-2">Мессенджеры</p>
          <div class="flex flex-col">
            <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex items-center gap-2 min-h-[44px] text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="telegram_click">
              <Icon name="bi:telegram" class="bi bi-telegram shrink-0 text-base md:text-base text-body-faint" />
              Telegram
            </a>

            <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex items-center gap-2 min-h-[44px] text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="whatsapp_click">
              <Icon name="bi:whatsapp" class="bi bi-whatsapp shrink-0 text-base md:text-base text-body-faint" />
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Карта — картинка, не текст, слов не ест -->
      <StaticYandexMap image="aidacamp-contacts" href={YANDEX_MAPS_URL} alt="АйДаКемп на карте" width={650} height={200} class="flex-1 rounded-[18px] border border-border min-h-[140px]" fill />

    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('#contacts a[href^="tel:"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('phone_click'); });
  });
  document.querySelectorAll('#contacts a[href*="wa.me"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('whatsapp_click'); });
  });
  document.querySelectorAll('#contacts a[href*="t.me"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('telegram_click'); });
  });
</script>
