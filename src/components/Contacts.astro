---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, EMAIL, EMAIL_HREF, WHATSAPP_URL, TELEGRAM_URL, YANDEX_MAPS_URL, YANDEX_MAPS_ROUTE_URL } from '../data/contacts';

const socials = [
  { abbr: 'VK', label: 'ВКонтакте', href: 'https://vk.com/aidacamp' },
  { abbr: 'OK', label: 'Одноклассники', href: 'https://ok.ru/group/64689601773621' },
  { abbr: 'YT', label: 'YouTube', href: 'https://www.youtube.com/@aida_codit' },
  { abbr: 'RT', label: 'Rutube', href: 'https://rutube.ru/channel/53394996/' },
  { abbr: 'IG', label: 'Instagram', href: 'https://www.instagram.com/aida_codit' },
  { abbr: 'LI', label: 'LinkedIn', href: 'https://www.linkedin.com/company/it-лагерь-для-детей-айдакемп' },
  { abbr: 'TT', label: 'TikTok', href: 'https://www.tiktok.com/@aidacodit0' },
  { abbr: 'PI', label: 'Pinterest', href: 'https://ru.pinterest.com/pbalgoritmika/' },
  { abbr: 'YA', label: 'Yappy', href: 'https://yappy.media/n/acceptable.lizardxw' },
];
---

<section id="contacts" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-4">
      <div class="list-accent-dot"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Контакты и соцсети</h2>
    </div>

    <div class="overflow-hidden rounded-[18px] border border-border">
      <iframe
        id="contacts-map-frame"
        src="https://yandex.ru/map-widget/v1/?ll=37.160000%2C55.500000&z=8&pt=36.724185,55.265643,pm2rdm"
        width="100%"
        height="260"
        class="block w-full"
        frameborder="0"
        loading="lazy"
        title="Расположение АйДаКемп на карте"
      ></iframe>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={YANDEX_MAPS_ROUTE_URL} target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-orange-400 px-5 py-2.5 text-base font-semibold text-white transition-colors">
        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
        Построить маршрут
      </a>
      <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="text-base text-primary hover:underline">
        Открыть в Яндекс.Картах
      </a>
    </div>
    <p class="mt-2 text-base md:text-base text-body-muted">
      66 км от МКАД · Наро-Фоминский городской округ · территория «Санаторий Изумруд»
    </p>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">

      <div>
        <p class="text-base font-semibold text-body mb-2">Телефоны</p>
        <div class="space-y-1.5">
          <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="phone_click">
            <i class="bi bi-phone shrink-0 text-base md:text-base text-body-faint"></i>
            <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
          </a>
          <a href={PHONE_MAIN_HREF} class="flex items-center gap-2 text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="phone_click">
            <i class="bi bi-telephone shrink-0 text-base md:text-base text-body-faint"></i>
            <span class="whitespace-nowrap">{PHONE_MAIN}</span>
          </a>
          <a href={EMAIL_HREF} class="flex items-center gap-2 text-base md:text-base text-body-faint hover:text-orange-500 transition-colors">
            <i class="bi bi-envelope text-base md:text-base text-body-faint" aria-hidden="true"></i>
            {EMAIL}
          </a>
        </div>
      </div>

      <div>
        <p class="text-base font-semibold text-body mb-2">Мессенджеры</p>
        <div class="flex flex-col">
          <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex items-center gap-2 min-h-[44px] text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="telegram_click">
            <i class="bi bi-telegram shrink-0 text-base md:text-base text-body-faint"></i>
            Telegram
          </a>

          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex items-center gap-2 min-h-[44px] text-base font-medium text-body-muted hover:text-orange-500 transition-colors" data-analytics-goal="whatsapp_click">
            <i class="bi bi-whatsapp shrink-0 text-base md:text-base text-body-faint"></i>
            WhatsApp
          </a>
        </div>
      </div>

      <div>
        <p class="text-base font-semibold text-body mb-2">Соцсети</p>
        <div class="flex flex-wrap gap-1.5">
          {socials.slice(0, 3).map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1.5 text-base font-medium text-body-muted transition hover:bg-primary/10 hover:text-primary">
              {s.label}
            </a>
          ))}
          <div class="w-full mt-0.5" data-toggle-root>
            <button type="button" data-toggle aria-expanded="false" class="cursor-pointer text-base font-medium text-body-muted hover:text-body">Ещё соцсети ▾</button>
            <div data-toggle-panel class="hidden mt-1.5 flex flex-wrap gap-1.5">
              {socials.slice(3).map((s) => (
                <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1.5 text-base font-medium text-body-muted transition hover:bg-primary/10 hover:text-primary">
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-toggle-root]').forEach(function (root) {
      var btn = root.querySelector('[data-toggle]');
      var panel = root.querySelector('[data-toggle-panel]');
      if (!btn || !panel) return;
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.classList.toggle('hidden', expanded);
      });
    });
  })();

  document.querySelectorAll('#contacts a[href^="tel:"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('phone_click'); });
  });
  document.querySelectorAll('#contacts a[href*="wa.me"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('whatsapp_click'); });
  });
  document.querySelectorAll('#contacts a[href*="t.me"]').forEach(function (a) {
    a.addEventListener('click', function () { if (window.trackGoal) window.trackGoal('telegram_click'); });
  });
</script>

<script is:inline>
  // Взаимодействие с картой-iframe (клик/зум внутри cross-origin не виден):
  // прокси-сигнал — окно теряет фокус, а активный элемент = iframe карты.
  (function () {
    var frame = document.getElementById('contacts-map-frame');
    if (!frame) return;
    window.addEventListener('blur', function onMapBlur() {
      if (document.activeElement === frame && typeof window.trackGoal === 'function') {
        window.trackGoal('map_interact', { page: location.pathname });
        window.removeEventListener('blur', onMapBlur);
      }
    });
  })();
</script>
