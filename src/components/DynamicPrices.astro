---
/**
 * DynamicPrices — глобальный скрипт динамических цен.
 * Подключается один раз в Base.astro и обновляет ВСЕ [data-dynamic-price] на странице.
 *
 * Атрибуты которые поддерживаются:
 *   data-dynamic-price="shift-1"   → span с ценой (обновляется текст)
 *   data-price-stage="shift-1"     → строка "с 4 июля: X ₽" (плановый скачок ДО старта рампы)
 *   data-price-urgency="shift-1"   → строка "Завтра будет X ₽" (когда цена растёт день-в-день)
 *   data-vychet-link="shift-1"     → ссылка налогового вычета (ищет data-shift-days на родителе)
 *   data-option-price="shift-1"    → <option data-price> в калькуляторе
 */
import { PRICING } from '../data/dynamicPrices';
---

<script id="aida-prices-config" type="application/json" set:html={JSON.stringify(PRICING)} />

<script is:inline>
(function () {
  var cfg = {};
  try {
    var el = document.getElementById('aida-prices-config');
    if (el) cfg = JSON.parse(el.textContent || '{}');
  } catch (e) {}

  function fmt(n) { return n.toLocaleString('ru-RU') + ' ₽'; }

  function todayStr() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }

  function daysDiff(a, b) {
    var da = new Date(a + 'T00:00:00');
    var db = new Date(b + 'T00:00:00');
    return Math.floor((db - da) / 86400000);
  }

  /** Текущая цена: активная ступень + инкремент (если есть) */
  function calcPrice(c, today) {
    var stages = c.stages;
    if (!stages || !stages.length) return null;
    var activeIdx = -1;
    for (var i = 0; i < stages.length; i++) {
      if (stages[i].from <= today) activeIdx = i;
    }
    if (activeIdx === -1) return null;
    var s = stages[activeIdx];
    if (s.increment) {
      var nextFrom = stages[activeIdx + 1] ? stages[activeIdx + 1].from : today;
      var capStr   = nextFrom <= today ? nextFrom : today;
      return s.price + daysDiff(s.from, capStr) * s.increment;
    }
    return s.price;
  }

  /** Цена завтра (для «Завтра будет X ₽») */
  function calcNextDay(c, today) {
    var d = new Date(today + 'T00:00:00');
    d.setDate(d.getDate() + 1);
    var tom = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    var next = calcPrice(c, tom);
    var cur  = calcPrice(c, today);
    return (next && cur && next > cur) ? next : null;
  }

  var MONTHS_RU = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  function fmtDateRu(iso) {
    var p = iso.split('-');
    return parseInt(p[2], 10) + ' ' + MONTHS_RU[parseInt(p[1], 10) - 1];
  }

  /** Ближайшая плановая ступень-скачок ДО начала ежедневного роста (для «с 4 июля: X ₽»). */
  function nextStage(c, today) {
    var stages = c.stages;
    if (!stages) return null;
    for (var i = 0; i < stages.length; i++) {
      if (stages[i].from > today) return stages[i];
    }
    return null;
  }

  function applyPrices() {
    var today = todayStr();
    Object.keys(cfg).forEach(function (id) {
      var c = cfg[id];
      var cur = calcPrice(c, today);
      if (cur === null) return;
      var nextDay = calcNextDay(c, today);

      // Цена (все элементы с атрибутом)
      document.querySelectorAll('[data-dynamic-price="' + id + '"]').forEach(function (el) {
        el.textContent = fmt(cur);
      });

      // "Завтра будет X ₽" — показывается пока цена растёт каждый день
      if (nextDay !== null) {
        var msg = 'Завтра будет ' + nextDay.toLocaleString('ru-RU') + ' ₽';
        document.querySelectorAll('[data-price-urgency="' + id + '"]').forEach(function (el) {
          el.textContent = msg; el.classList.remove('hidden');
        });
      }

      // "с 4 июля: X ₽" — плановый скачок ДО старта ежедневного роста (ступень с инкрементом).
      // Пока идёт ежедневный рост — не показываем (его несёт «Завтра будет X»).
      var ns = nextStage(c, today);
      var stageEls = document.querySelectorAll('[data-price-stage="' + id + '"]');
      if (ns && ns.increment && ns.price > cur) {
        var smsg = 'с ' + fmtDateRu(ns.from) + ': ' + ns.price.toLocaleString('ru-RU') + ' ₽';
        stageEls.forEach(function (el) { el.textContent = smsg; el.classList.remove('hidden'); });
      } else {
        stageEls.forEach(function (el) { el.classList.add('hidden'); });
      }

      // Вычет — пересчёт на основе актуальной цены
      document.querySelectorAll('[data-vychet-link="' + id + '"]').forEach(function (el) {
        var card = el.closest('[data-shift-days]');
        var days = card ? parseInt(card.getAttribute('data-shift-days') || '0', 10) : 0;
        if (!days) return;
        var vychet = Math.round((cur - 3800 * days) * 0.13);
        if (vychet > 0) el.textContent = vychet.toLocaleString('ru-RU') + ' ₽ налогового вычета';
      });

      // <option data-option-price="shift-X"> в калькуляторе
      document.querySelectorAll('[data-option-price="' + id + '"]').forEach(function (el) {
        el.setAttribute('data-price', String(cur));
        var label = el.getAttribute('data-option-label') || '';
        var popular = el.getAttribute('data-option-popular') === 'true';
        el.textContent = label + ' — ' + cur.toLocaleString('ru-RU') + ' ₽' + (popular ? ' · популярная' : '');
      });
    });
  }

  // Запускаем после загрузки DOM и при Astro-навигации
  document.addEventListener('astro:page-load', applyPrices);
  if (document.readyState !== 'loading') applyPrices();
  else document.addEventListener('DOMContentLoaded', applyPrices);
})();
</script>
