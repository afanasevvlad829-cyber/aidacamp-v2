---
const cards = [
  {
    photo: '/images/gallery/gallery-04.avif',
    photo400: '/images/gallery/gallery-04-400.avif',
    title: 'Не по методичке',
    text: 'Программу проверяют менторы из ВТБ, МТС Ventures и крупных IT-компаний',
  },
  {
    photo: '/images/gallery/gallery-05.avif',
    photo400: '/images/gallery/gallery-05-400.avif',
    title: 'Можно попробовать разное',
    text: 'Python, AI, дроны, 3D — направление можно менять прямо по ходу смены',
  },
  {
    photo: '/images/gallery/hackathon-present.avif',
    photo400: '/images/gallery/hackathon-present-400.avif',
    title: 'Ошибаться — нормально',
    text: 'Здесь не наказывают за неправильный код, а разбираются вместе, что пошло не так',
  },
];
---

<section id="about" class="mx-auto max-w-[1312px] px-[2px] pt-4 md:px-4 md:pt-8">
  <div class="p-[18px] md:p-6">
    <div class="flex items-center gap-2 mb-1"><div class="list-accent-dot"></div><h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Это не &laquo;ещё один лагерь&raquo;</h2></div>
    <p class="mt-3 max-w-[980px] text-[18px] leading-[1.6] text-body-muted md:text-[16px]">
      Чем мы отличаемся от типового лагеря — коротко
    </p>
    <div class="-mx-[2px] px-[2px] mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:mt-6 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:pb-0" data-about-carousel>
      {cards.map((card) => (
        <article class="w-[85vw] min-w-[85vw] shrink-0 snap-start overflow-hidden rounded-[22px] card-shadow transition md:w-auto md:min-w-0 md:shrink">
          <div class="relative aspect-[16/10] w-full cursor-pointer overflow-hidden group" data-about-photo={card.photo}>
            <img src={card.photo} srcset={`${card.photo400} 400w, ${card.photo} 600w`} sizes="(min-width: 768px) 440px, 85vw" alt={card.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="600" height="375" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
              <h3 class="text-[17px] font-semibold leading-[1.25] text-white md:text-[18px]">{card.title}</h3>
              <p class="mt-1.5 text-[16px] leading-[1.5] text-white/80 md:text-base">{card.text}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
    <!-- Dots — mobile only -->
    <div class="mt-3 flex justify-center items-center gap-2 md:hidden" data-about-dots role="group" aria-label="Навигация по карточкам">
      {cards.map((_, i) => (
        <span
          class={`h-2 rounded-full transition-all duration-200 ${i === 0 ? 'w-6 bg-[var(--color-primary,#ec7c00)]' : 'w-2 bg-slate-300'}`}
          data-about-dot={i}
          aria-current={i === 0 ? 'true' : 'false'}
        ></span>
      ))}
    </div>
    <div class="mt-4 flex flex-col items-center gap-2 md:flex-row md:justify-center md:gap-4">
      <button
        type="button"
        data-about-modal-open
        class="group inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover min-h-[44px]"
      >
        Чем мы отличаемся?
        <i class="bi bi-arrow-right icon-arrow-right-hover" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>

<!-- About Modal -->
<dialog
  id="aboutModal"
  class="fixed inset-0 m-auto w-[min(92vw,560px)] max-h-[85vh] rounded-[20px] border-0 outline-none bg-card p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="relative overflow-y-auto max-h-[85vh] p-6 md:p-8">
    <!-- Close button -->
    <button
      type="button"
      data-about-modal-close
      aria-label="Закрыть"
      class="absolute right-4 top-4 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full border border-border bg-card text-body-muted transition hover:bg-surface focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-1"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>

    <h3 class="text-[20px] font-bold leading-[1.2] text-body pr-10 md:text-[22px]">
      Не &laquo;ещё один лагерь&raquo;&nbsp;&mdash; всё по-другому
    </h3>

    <div class="mt-5 space-y-4 text-[18px] leading-[1.65] text-body-muted">
      <p>
        Раз в смену <a href="/komanda/" class="text-orange-600 underline">ментор</a> из индустрии смотрит проекты — что реально востребовано, а что уже устарело.
      </p>

      <hr class="border-border-light" />

      <p>
        Начал с Python, зацепили нейросети — можно пересесть в другую группу. К одному треку жёстко не привязывают.
      </p>

      <hr class="border-border-light" />

      <p>
        Не заработало — сели с преподавателем, разобрались, где сломалось, и пошли дальше. Отладка — часть работы, а не повод краснеть.
      </p>
    </div>

    <button
      type="button"
      data-about-modal-close
      class="mt-6 w-full rounded-[12px] border border-border px-4 py-3 text-sm font-semibold text-body-muted transition hover:bg-surface"
    >
      Закрыть
    </button>
  </div>
</dialog>

<script>
  function initAbout() {
    // Dots for mobile carousel
    const aboutCarousel = document.querySelector<HTMLElement>('[data-about-carousel]');
    const aboutDots = document.querySelectorAll<HTMLElement>('[data-about-dot]');
    if (aboutCarousel && aboutDots.length) {
      const aboutCards = Array.from(aboutCarousel.children) as HTMLElement[];
      new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = aboutCards.indexOf(entry.target as HTMLElement);
            aboutDots.forEach((d, di) => {
              const isActive = di === idx;
              d.classList.toggle('bg-[var(--color-primary,#ec7c00)]', isActive);
              d.classList.toggle('w-6', isActive);
              d.classList.toggle('bg-slate-300', !isActive);
              d.classList.toggle('w-2', !isActive);
              d.setAttribute('aria-current', isActive ? 'true' : 'false');
            });
          }
        });
      }, { root: aboutCarousel, threshold: 0.6 }).observe !== undefined &&
      aboutCards.forEach((card) => {
        new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = aboutCards.indexOf(entry.target as HTMLElement);
              aboutDots.forEach((d, di) => {
                const isActive = di === idx;
                d.classList.toggle('bg-[var(--color-primary,#ec7c00)]', isActive);
                d.classList.toggle('w-6', isActive);
                d.classList.toggle('bg-slate-300', !isActive);
                d.classList.toggle('w-2', !isActive);
                d.setAttribute('aria-current', isActive ? 'true' : 'false');
              });
            }
          });
        }, { root: aboutCarousel, threshold: 0.6 }).observe(card);
      });
    }

    const modal = document.getElementById('aboutModal') as HTMLDialogElement | null;
    if (!modal) return;

    document.querySelector('[data-about-modal-open]')?.addEventListener('click', () => {
      modal.showModal();
    });

    modal.querySelectorAll('[data-about-modal-close]').forEach((btn) => {
      btn.addEventListener('click', () => modal.close());
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // About photos → open gallery lightbox
    document.querySelectorAll<HTMLElement>('[data-about-photo]').forEach((el) => {
      el.addEventListener('click', () => {
        const lightbox = document.getElementById('galleryLightbox') as HTMLDialogElement | null;
        const lbImg = lightbox?.querySelector<HTMLImageElement>('[data-gallery-lightbox-img]');
        if (lightbox && lbImg) {
          lbImg.src = el.dataset.aboutPhoto || '';
          lbImg.alt = el.querySelector('img')?.alt || '';
          lightbox.showModal();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initAbout);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initAbout(); }, { timeout: 3000 });
  } else {
    setTimeout(initAbout, 200);
  }
</script>
