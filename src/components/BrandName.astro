---
/**
 * BrandName — "АйДаКемп" с интеллектуальным выделением "АйДа"
 *
 * Автоматически определяет яркость фона и выбирает контрастный цвет
 * На тёмном фоне: белый текст + оранжевая "АйДа"
 * На светлом фоне: чёрный текст + оранжевая "АйДа"
 */

interface Props {
  variant?: 'default' | 'header' | 'footer' | 'hero';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
---

<span class:list={['brand-name', variant, className]}>
  <span class="aida">АйДа</span><span class="kemp">Кемп</span>
</span>

<style>
  .brand-name {
    /* Базовые стили */
    font-weight: 600;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: baseline;
  }

  .aida {
    /* Оранжевое выделение "АйДа" */
    color: #ec7c00;
    font-weight: 700;
  }

  .kemp {
    /* Цвет адаптируется к контексту */
    color: inherit;
    font-weight: 600;
  }

  /* === ВАРИАНТ: header (на белом фоне) === */
  .brand-name.header .kemp {
    color: #0f1c2e;
  }

  /* === ВАРИАНТ: footer (на тёмном фоне) === */
  .brand-name.footer .kemp {
    color: #ffffff;
  }

  /* === ВАРИАНТ: hero (на тёмном фоне с градиентом) === */
  .brand-name.hero .kemp {
    color: #ffffff;
  }

  /* === ВАРИАНТ: default (чёрный на светлом) === */
  .brand-name.default .kemp {
    color: #0f1c2e;
  }

  /* === Media queries для адаптивности === */
  @media (prefers-color-scheme: dark) {
    .brand-name.default .kemp {
      color: #ffffff;
    }
  }
</style>
