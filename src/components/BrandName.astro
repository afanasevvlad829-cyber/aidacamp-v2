---
/**
 * BrandName — "АйДаКемп" с интеллектуальным выделением "АйДа"
 *
 * Автоматически определяет яркость фона и выбирает контрастный цвет
 * На тёмном фоне: белый текст + оранжевая "АйДа"
 * На светлом фоне: чёрный текст + оранжевая "АйДа"
 */

interface Props {
  variant?: 'default' | 'header' | 'footer' | 'hero';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
---

<span class:list={['brand-name', variant, className]}>
  {variant === 'header'
    ? <><span class="da">Да</span><span class="kemp">Кемп</span></>
    : <><span class="aida">АйДа</span><span class="kemp">Кемп</span></>
  }
</span>

<style>
  .brand-name {
    /* Базовые стили */
    font-weight: 600;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: baseline;
  }

  .aida {
    /* Оранжевое выделение "АйДа" */
    color: var(--color-primary);
    font-weight: 700;
  }

  .kemp {
    /* Всегда приглушённый цвет (серый) */
    font-weight: 600;
  }

  /* === ВАРИАНТ: header — Montserrat SemiBold (вариант 2) === */
  .brand-name.header {
    font-family: "Montserrat", "Inter", sans-serif;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-name.header .aida,
  .brand-name.header .da {
    color: var(--color-primary);
    font-weight: 600;
  }
  .brand-name.header .kemp {
    color: #D0D6DE;
  }

  /* === ВАРИАНТ: footer (на тёмном фоне) === */
  .brand-name.footer .kemp {
    color: var(--color-gray-400);
  }

  /* === ВАРИАНТ: hero (на тёмном фоне с градиентом) === */
  .brand-name.hero .kemp {
    color: var(--color-gray-400);
  }

  /* === ВАРИАНТ: default (серый на светлом) === */
  .brand-name.default .kemp {
    color: #a0a8b8;
  }

  /* === Media queries для адаптивности === */
  @media (prefers-color-scheme: dark) {
    .brand-name.default .kemp {
      color: var(--color-gray-400);
    }
  }
</style>
