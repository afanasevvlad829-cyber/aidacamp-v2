---
import { Icon } from 'astro-icon/components';
import { mainShifts, displayShifts, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import { getShiftPhase } from '../data/dynamicPrices';
import ShiftCardSlot from './shifts/ShiftCardSlot.astro';
import ShiftBookModal from './shifts/ShiftBookModal.astro';
import ShiftsGuideLink from './ShiftsGuideLink.astro';

interface Props {
  hideFriendBanner?: boolean;
  /** Новая раскладка карточек: актуальные смены слева (крупнее), «как прошли» —
   *  один компактный слот справа, ширина колонок не хардкод под 4. По умолчанию
   *  выключено — старые страницы получают прежнее поведение без изменений. */
  compactPastShifts?: boolean;
  /** Переопределение текста бейджа ShiftsGuideLink для конкретной страницы. */
  shiftsGuideLinkText?: string;
}
const { hideFriendBanner = false, compactPastShifts = false, shiftsGuideLinkText } = Astro.props;

// Фаза смены считается по датам (getShiftPhase): upcoming → live → done.
const nowDate = new Date();

const doneShifts = displayShifts.filter((s) => getShiftPhase(s.id, nowDate) === 'done' && s.recapUrl);
const activeShifts = displayShifts.filter((s) => getShiftPhase(s.id, nowDate) !== 'done');

// Eyebrow секции — по сезонам смен, которые реально показаны, а не жёстко «Лето SEASON_YEAR».
// В сентябре в блоке остались только осенние и зимние заезды, а подпись продолжала
// обещать лето (баг 06.09.2026). Зимний сезон подписывается двумя годами: заезд
// стартует 30 декабря и заканчивается в январе следующего года.
const seasonLabel = (startDate: string): string => {
  const year = Number(startDate.slice(0, 4));
  const m = Number(startDate.slice(5, 7));
  if (m === 12) return `Зима ${year}—${year + 1}`;
  if (m <= 2) return `Зима ${year - 1}—${year}`;
  if (m <= 5) return `Весна ${year}`;
  if (m <= 8) return `Лето ${year}`;
  return `Осень ${year}`;
};
const seasonsLabel = [...new Set(activeShifts.map((s) => seasonLabel(s.startDate)))].join(' · ')
  || `Лето ${SEASON_YEAR}`;

// Только для compactPastShifts: ширина колонок под реальное число карточек,
// «как прошли» уже (0.6fr), карточки смен (реальный товар) — шире (1fr).
// minmax(0, …) обязателен: голый 1fr не сжимается ниже min-content колонки, а внутри
// карточек есть whitespace-nowrap (даты «30 декабря — 8 января»). Из-за этого сетка
// вылезала за контейнер на ~76px и правая колонка обрезалась (баг 06.09.2026).
const gridColumns = doneShifts.length > 0
  ? `${'minmax(0, 1fr) '.repeat(activeShifts.length)}minmax(0, 0.6fr)`.trim()
  : `${'minmax(0, 1fr) '.repeat(activeShifts.length)}`.trim();

// Обложки прошедших смен — фото из фотобанка (Immich, альбомы «Смена N — YYYY»),
// сами файлы лежат в /var/www/aidacamp-gallery/ (общий архив dev+prod, не в репо).
// Точечная карта id → путь, не постоянное поле данных.
const DONE_SHIFT_COVERS: Record<string, string> = {
  'shift-1': '/images/gallery/proto-smena1.webp',
  'shift-2': '/images/gallery/proto-smena2.webp',
};
---

<section id="shifts" class="mx-auto max-w-[1312px] px-[2px] pt-10 md:px-4">
  <div class="p-[18px]">
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 mb-2">{seasonsLabel}</p>
    <div class="flex items-center gap-2 mb-1"><div class="list-accent-dot"></div><h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Свободные места</h2></div>
    <p class="mt-1 text-base md:text-base text-body-muted">Данные обновляются в реальном времени. Во всех ценах: питание, проживание, программа. <a href="/nalogovyj-vychet/" class="text-emerald-700 underline underline-offset-2 hover:text-emerald-800">Верните до {VYCHET_MAX} налогового вычета</a>.</p>

    <!-- «Едете с другом»: бейджи скидок 5-я/10-я + мерч в одном раскрывающемся блоке -->
    <div class={`mt-3 rounded-xl border border-slate-200 bg-surface overflow-hidden${hideFriendBanner ? ' hidden' : ''}`} data-friend-toggle-root>
      <button type="button" data-friend-toggle aria-expanded="false" class="flex w-full cursor-pointer items-center gap-2.5 px-4 py-2.5 select-none">
        <Icon name="bi:people-fill" class="bi bi-people-fill text-base text-primary shrink-0" aria-hidden="true" />
        <span class="flex-1 text-base font-semibold text-body">Едете с другом? Здесь скидки и мерч</span>
        <Icon name="bi:chevron-down" class="bi bi-chevron-down text-[12px] text-body-faint transition-transform duration-200" aria-hidden="true" id="shifts-friend-chevron" />
      </button>
      <div data-friend-toggle-panel class="hidden border-t border-slate-200">
        <!-- Бейджи скидок (внутри раскрытого блока — про друзей и есть про скидки) -->
        <div class="flex flex-wrap gap-1.5 px-4 pt-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-base font-semibold text-primary-700">
            <Icon name="bi:people-fill" class="bi bi-people-fill text-[12px]" aria-hidden="true" />
            Каждая 5-я путёвка — скидка 50%
          </span>

          <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-base font-semibold text-orange-700">
            <Icon name="bi:people-fill" class="bi bi-people-fill text-[12px]" aria-hidden="true" />
            Каждая 10-я — за 100 ₽
          </span>
        </div>

        <!-- Мерч -->
        <div class="mt-3 flex items-stretch gap-0">
          <button
            type="button"
            data-gallery-open
            data-gallery-src="/images/merch-hoodie.avif"
            data-gallery-alt="Фирменная толстовка АйДаКемп"
            class="shrink-0 cursor-zoom-in self-stretch"
            aria-label="Посмотреть мерч"
          >
            <img
              src="/images/merch-hoodie.avif"
              alt="Мерч АйДаКемп"
              title="Фирменная толстовка АйДаКемп — подарок за приглашённого друга"
              class="h-full w-[96px] object-cover object-top transition hover:scale-105"
              loading="lazy"
            />
          </button>
          <div class="flex-1 px-4 py-3">
            <p class="text-base font-semibold text-body">Те, кто едет в компании, адаптируются вдвое быстрее</p>
            <p class="text-base md:text-base text-body-faint mt-0.5">Позовите друга — подарим фирменный мерч каждому.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Манифест: среда как главная ценность — между мерчем и карточками смен -->
    <div class="mt-6 mb-1 pl-4 border-l-[3px] border-primary">
      <p class="text-[18px] md:text-[20px] font-bold text-body leading-[1.2] tracking-[-0.02em]">Среда решает больше, чем программа.</p>
      <p class="mt-2 text-base md:text-base text-body-muted leading-[1.65]">Собираем тех, кому Майнкрафт уже тесноват — и это чувствуется с первого дня.</p>
    </div>

    <!-- ═══ КАРТОЧКИ СМЕН: 4 в ряд (desktop) / карусель (mobile) ═══ -->
    <div class="shifts-marquee-vp mt-4 -mx-[18px] md:mx-0 relative" data-shifts-marquee-vp role="region" aria-label="Карусель смен">
      <!-- Fade edges — mobile only -->
      <div class="shifts-mq-fade-l" aria-hidden="true"></div>
      <div class="shifts-mq-fade-r" aria-hidden="true"></div>

      <div
        class="shifts-marquee-track flex gap-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        data-shifts-marquee-track
        data-carousel-initial={compactPastShifts ? '0' : '2'}
        style={compactPastShifts ? `--shift-grid-cols: ${gridColumns}` : undefined}
      >

        {compactPastShifts ? (
          <Fragment>
            {/* ─── Новая раскладка: актуальные смены слева (шире), «как прошли» справа (компактно) ─── */}
            {activeShifts.map((shift) => <ShiftCardSlot shift={shift} now={nowDate} />)}

            {/* Прошедшие смены справа — один компактный слот с прямыми ссылками на рекапы,
                фото со смены (Immich) вместо голого текста — жизнь лагеря видна сразу.
                График роста цены — на странице каждой смены (kak-proshla-smena-N), не здесь. */}
            {doneShifts.length > 0 && (
              <div class="shifts-mq-item shrink-0 w-[calc(100vw-56px)] md:w-auto md:flex-1 self-stretch">
                <div class="flex h-full flex-col justify-center gap-4 rounded-[22px] border border-border-light bg-card p-5 md:p-6">
                  <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-body-faint">Прошедшие смены</p>
                  {doneShifts.map((s, i) => (
                    <Fragment>
                      {i > 0 && <div class="border-t border-border-light"></div>}
                      <a href={s.recapUrl} class="group flex items-center gap-3 no-underline pt-1 first:pt-0 md:flex-col md:items-stretch md:gap-2">
                        <img
                          src={DONE_SHIFT_COVERS[s.id] ?? '/images/gallery/camp-smile.avif'}
                          alt={`Фото со смены «${s.name}»`}
                          class="h-24 w-24 shrink-0 rounded-2xl object-cover md:h-[88px] md:w-full"
                          loading="lazy"
                          width="96"
                          height="96"
                        />
                        <span class="min-w-0 flex-1">
                          <span class="block text-[17px] font-bold leading-tight text-body">{s.name}</span>
                          <span class="mt-1 block text-[13px] leading-snug text-body-faint">{s.dates}</span>
                          <span class="mt-1.5 inline-flex items-center gap-1 text-[13px] font-semibold text-emerald-600 group-hover:text-emerald-700">
                            Фото и итоги
                            <Icon name="bi:arrow-right" class="bi bi-arrow-right icon-arrow-right-hover text-[10px]" aria-hidden="true" />
                          </span>
                        </span>
                      </a>
                    </Fragment>
                  ))}
                </div>
              </div>
            )}
          </Fragment>
        ) : (
          <Fragment>
            {/* ─── Классическая раскладка: все смены по датам (предстоит → идёт → прошла), полная ShiftRetroCard на каждую прошедшую ─── */}
            {/* Колесо фортуны рендерится скрытым у ближайшей смены; показывается
                клиентским скриптом ниже по правилу (последние 3 дня + ≤3 места) или по ?fortune=wheel. */}
            {displayShifts.map((shift) => <ShiftCardSlot shift={shift} now={nowDate} />)}
          </Fragment>
        )}

      </div>
    </div>

    <!-- Dot-индикаторы карусели (генерируются JS) -->
    <div data-shifts-dots class="flex justify-center gap-2 mt-3 md:hidden" aria-hidden="true"></div>

    <ShiftsGuideLink mismatchLinkText={shiftsGuideLinkText} />
    </div>
  </div>
</section>

<script is:inline>
/* Активация колеса фортуны: показываем ВСЕМ новым посетителям (решение
   владельца 27.07.2026) — дни-до-старта/реальный остаток мест на активацию
   больше не влияют, это конверсионный виджет, не завязанный на инвентарь.
   Вернувшийся посетитель (был на сайте хоть месяц назад) колесо не видит —
   сигнал ac:viewed_shifts (см. ниже, почему без _ym_uid). Header/ReturnBanner/
   MobileMenu используют похожий, но более широкий сигнал (+ _ym_uid) для
   своей returning-visitor логики — здесь сознательно уже. Считается клиентски.
   Превью в любой момент: ?fortune=wheel (force показывает и вернувшимся —
   для теста/демо). */
(function () {
  var CFG_URL = '/api/fortune/config';
  var cfgCache = null;

  function fetchCfg() {
    if (cfgCache) return Promise.resolve(cfgCache);
    return fetch(CFG_URL, { credentials: 'omit' })
      .then(function (r) { return r.json(); })
      .then(function (d) { cfgCache = (d && d.shifts) || {}; return cfgCache; })
      .catch(function () { cfgCache = {}; return cfgCache; });
  }

  function apply() {
    var qs = new URLSearchParams(location.search);
    var force = qs.get('fortune') === 'wheel' || qs.has('wheel');
    // Только ac:viewed_shifts — не _ym_uid: Метрика ставит свою uid-куку сама,
    // сразу на первом визите (до того, как этот скрипт успевает её проверить),
    // так что _ym_uid ложно помечал бы «уже был» настоящего нового посетителя
    // в его же первый визит. ac:viewed_shifts ставится только по факту открытия
    // карточки смены — осознанное действие, надёжный сигнал «уже был раньше».
    var isReturning = !!localStorage.getItem('ac:viewed_shifts');

    fetchCfg().then(function (cfg) {
      document.querySelectorAll('[data-fortune-wheel]').forEach(function (wheel) {
        var slot = wheel.closest('[data-shift-id]');
        var normal = slot ? slot.querySelector('[data-fortune-normal]') : null;
        var shiftId = slot ? slot.getAttribute('data-shift-id') : null;
        var rule = shiftId ? cfg[shiftId] : null;

        var active;
        if (force) {
          active = true;                       // ?wheel — превью, показываем всегда
        } else if (!rule) {
          active = false;                      // в конфиге смены нет — колеса нет
        } else if (rule.audience === 'all') {
          active = true;
        } else if (rule.audience === 'returning') {
          active = isReturning;
        } else {
          active = !isReturning;               // 'new' — поведение по умолчанию
        }

        // minFree: включать, только когда свободных мест осталось <= N
        if (active && rule && rule.minFree != null) {
          var free = parseInt(wheel.getAttribute('data-fortune-free') || '', 10);
          if (!isNaN(free) && free > rule.minFree) active = false;
        }

        if (active) { wheel.hidden = false; if (normal) normal.hidden = true; }
        else { wheel.hidden = true; if (normal) normal.hidden = false; }
      });
    });
  }
  document.addEventListener('astro:page-load', apply);
  if (document.readyState !== 'loading') apply();
  else document.addEventListener('DOMContentLoaded', apply);
})();
</script>

<style>
  /* ── MARQUEE VIEWPORT ── */
  .shifts-marquee-vp {
    overflow: hidden;
    /* Padding = shadow clearance for card-shadow:
       mobile  → 0 2px 6px / 0 4px 14px: needs 10px top, 18px bottom
       desktop → 0 2px 8px / 0 8px 28px: needs 20px top, 36px bottom */
    padding-top: 20px;
    padding-bottom: 36px;
  }

  /* ── TRACK ── */
  .shifts-marquee-track {
    display: flex;
    overflow-x: auto;
    /* overflow-x:auto forces overflow-y:auto (CSS spec) → clips child shadows.
       Vertical padding here must cover the full shadow extent so nothing is cut. */
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: auto;
    padding-top: 20px;
    padding-bottom: 36px;
    padding-left: 18px;
    padding-right: 18px;
  }
  @media (min-width: 768px) {
    .shifts-marquee-vp {
      overflow: visible;
      padding-top: 20px;
      padding-bottom: 36px;
    }
    .shifts-marquee-track {
      display: grid;
      grid-template-columns: var(--shift-grid-cols, repeat(4, 1fr));
      overflow-x: visible;
      overflow-y: visible;
      cursor: default;
      padding-left: 0;
      padding-right: 0;
      padding-top: 20px;
      padding-bottom: 36px;
      gap: 16px;
      align-items: stretch;
    }
    .shifts-mq-item {
      width: auto !important;
    }
  }

  .shifts-marquee-track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  /* ── FADE EDGES — не заходят в padding-bottom ── */
  .shifts-mq-fade-l,
  .shifts-mq-fade-r {
    position: absolute;
    top: 0;
    bottom: 36px; /* совпадает с padding-bottom viewport */
    width: 48px;
    pointer-events: none;
    z-index: 2;
  }
  .shifts-mq-fade-l {
    left: 0;
    background: linear-gradient(to right, var(--color-page, #fff), transparent);
  }
  .shifts-mq-fade-r {
    right: 0;
    background: linear-gradient(to left, var(--color-page, #fff), transparent);
  }
  @media (min-width: 768px) {
    .shifts-mq-fade-l,
    .shifts-mq-fade-r { display: none; }
  }
</style>

<ShiftBookModal />

<script>
  import { initFriendToggle } from '../scripts/shifts/friendToggle';
  import { initBookingModal } from '../scripts/shifts/bookingModal';
  import { initShiftAgePersonalization } from '../scripts/shifts/agePersonalization';
  import { initShiftsMarquee } from '../scripts/shifts/marquee';
  import { initViewedShiftScroll } from '../scripts/shifts/viewedShiftScroll';
  import { initReturningVisitorSpots } from '../scripts/shifts/returningVisitorSpots';
  import { onIdle } from '../lib/onIdle';

  function initShifts() {
    initFriendToggle();
    initBookingModal();
  }

  document.addEventListener('astro:page-load', initShifts);
  // Defer — Shifts ниже fold, не блокируем LCP
  onIdle(initShifts, 2000);

  document.addEventListener('astro:page-load', initShiftAgePersonalization);
  onIdle(initShiftAgePersonalization, 2000);

  document.addEventListener('astro:page-load', initShiftsMarquee);
  onIdle(initShiftsMarquee, 1500);

  document.addEventListener('astro:page-load', initViewedShiftScroll);
  initViewedShiftScroll();

  // Динамические цены — глобальный DynamicPrices.astro из Base.astro
  initReturningVisitorSpots();
</script>
