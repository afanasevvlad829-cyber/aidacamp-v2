---
import { mainShifts } from '../data/shifts';
import ShiftCard from './shifts/ShiftCard.astro';
import ShiftCardCombined from './shifts/ShiftCardCombined.astro';
import ShortShiftsBlock from './shifts/ShortShiftsBlock.astro';
import FortuneShiftCard from './shifts/FortuneShiftCard.astro';
import ShiftBookModal from './shifts/ShiftBookModal.astro';
import ShiftCalendarModal from './shifts/ShiftCalendarModal.astro';
import ShiftInfoModal from './shifts/ShiftInfoModal.astro';

// Shift 2 progress (June 10–23, 14 days) — computed SSR
const s2Start = new Date('2026-06-10T00:00:00');
const s2End   = new Date('2026-06-23T23:59:59');
const nowDate = new Date();
const S2_TOTAL = 14;
const s2ElapsedDays = Math.max(0, Math.min(S2_TOTAL, Math.floor((nowDate.getTime() - s2Start.getTime()) / 86_400_000)));
const s2Pct = Math.round(s2ElapsedDays / S2_TOTAL * 100);
const s2IsLive = nowDate >= s2Start && nowDate <= s2End;
const s2IsDone = nowDate > s2End;
---

<section id="shifts" class="mx-auto max-w-[1312px] px-[2px] pt-10 md:px-4">
  <div class="p-[18px]">
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 mb-2">Лето 2026</p>
    <div class="flex items-center gap-2 mb-1"><div class="w-1 h-5 rounded-full bg-primary shrink-0"></div><h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Свободные места</h2></div>
    <p class="mt-1 text-[15px] md:text-[14px] text-body-muted">Данные обновляются в реальном времени. Во всех ценах: питание, проживание, программа. <a href="/nalogovyj-vychet/" class="text-emerald-700 underline underline-offset-2 hover:text-emerald-800">Верните до 5&nbsp;434&nbsp;₽ налогового вычета</a>.</p>

    <!-- «Едете с другом»: бейджи скидок 5-я/10-я + мерч в одном раскрывающемся блоке -->
    <div class="mt-3 rounded-xl border border-emerald-100 bg-emerald-50 overflow-hidden" data-toggle-root>
      <button type="button" data-toggle aria-expanded="false" class="flex w-full cursor-pointer items-center gap-2.5 px-4 py-2.5 select-none">
        <i class="bi bi-people-fill text-[14px] text-emerald-600 shrink-0" aria-hidden="true"></i>
        <span class="flex-1 text-[14px] font-semibold text-body">Едете с другом? Здесь скидки и мерч</span>
        <i class="bi bi-chevron-down text-[12px] text-body-faint transition-transform duration-200" aria-hidden="true" id="shifts-friend-chevron"></i>
      </button>
      <div data-toggle-panel class="hidden border-t border-emerald-100">
        <!-- Бейджи скидок (внутри раскрытого блока — про друзей и есть про скидки) -->
        <div class="flex flex-wrap gap-1.5 px-4 pt-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-[13px] font-semibold text-emerald-700">
            <i class="bi bi-people-fill text-[12px]" aria-hidden="true"></i>
            Каждая 5-я путёвка — скидка 50%
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-[13px] font-semibold text-orange-700">
            <i class="bi bi-people-fill text-[12px]" aria-hidden="true"></i>
            Каждая 10-я — за 100 ₽
          </span>
        </div>

        <!-- Мерч -->
        <div class="mt-3 flex items-stretch gap-0">
          <button
            type="button"
            data-gallery-open
            data-gallery-src="/images/merch-hoodie.avif"
            data-gallery-alt="Фирменная толстовка АйДаКемп"
            class="shrink-0 cursor-zoom-in self-stretch"
            aria-label="Посмотреть мерч"
          >
            <img
              src="/images/merch-hoodie.avif"
              alt="Мерч АйДаКемп"
              class="h-full w-[96px] object-cover object-top transition hover:scale-105"
              loading="lazy"
            />
          </button>
          <div class="flex-1 px-4 py-3">
            <p class="text-[14px] font-semibold text-body">Те, кто едет в компании, адаптируются вдвое быстрее</p>
            <p class="text-[14px] md:text-[13px] text-body-faint mt-0.5">Позовите друга — подарим фирменный мерч каждому.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Манифест: среда как главная ценность — между мерчем и карточками смен -->
    <div class="mt-6 mb-1 pl-4 border-l-[3px] border-primary">
      <p class="text-[18px] md:text-[20px] font-bold text-body leading-[1.2] tracking-[-0.02em]">Среда решает больше, чем программа.</p>
      <p class="mt-2 text-[14px] md:text-[15px] text-body-muted leading-[1.65]">Когда рядом те, кому интересно — не потому что заставили, а потому что сами хотят — это заражает. Даже тот, кто приехал просто «посмотреть», через три дня уже не отлипает от проекта.</p>
      <p class="mt-1.5 text-[14px] md:text-[15px] text-body-muted leading-[1.65]">Мы собираем тех, кому Майнкрафт уже тесноват. Кто хочет понять, как это устроено — и сделать что-то своё.</p>
      <p class="mt-1.5 text-[14px] md:text-[15px] font-semibold text-body leading-[1.65]">И это чувствуется с первого дня.</p>
    </div>

    <!-- ═══ КАРТОЧКИ СМЕН: 4 в ряд (desktop) / карусель (mobile) ═══ -->
    <div class="shifts-marquee-vp mt-4 -mx-[18px] md:mx-0 relative" data-shifts-marquee-vp aria-label="Карусель смен">
      <!-- Fade edges — mobile only -->
      <div class="shifts-mq-fade-l" aria-hidden="true"></div>
      <div class="shifts-mq-fade-r" aria-hidden="true"></div>

      <div
        class="shifts-marquee-track flex gap-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        data-shifts-marquee-track
        data-carousel-initial="2"
      >

        {/* ─── Смена 1 — завершена ─── */}
        <div class="shifts-mq-item shrink-0 w-[calc(100vw-56px)] md:w-auto md:flex-1 self-stretch" data-shift-id="shift-1">
          <div class="flex flex-col h-full rounded-[22px] border border-border-light bg-card p-5 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_4px_14px_rgba(15,23,42,0.08)]">
            <!-- header: circle + month | status -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-1.5">
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-[13px] font-extrabold text-slate-400 leading-none shrink-0">1</span>
                <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-400">Май — Июнь</p>
              </div>
              <span class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                <i class="bi bi-check-circle-fill text-[10px]" aria-hidden="true"></i>
                завершена
              </span>
            </div>
            <!-- dates -->
            <h3 class="text-[18px] font-extrabold tracking-[-0.02em] leading-[1.1] text-slate-400 whitespace-nowrap">30 мая — 8 июня</h3>
            <p class="mt-0.5 text-[13px] text-slate-400">10 дней</p>
            <!-- occupancy -->
            <div class="mt-4">
              <div class="flex justify-between text-[12px] mb-1.5">
                <span class="text-slate-400">Занято</span>
                <span class="font-semibold text-emerald-600">45 из 45</span>
              </div>
              <div class="h-1.5 w-full rounded-full overflow-hidden bg-slate-100">
                <div class="h-full rounded-full bg-emerald-400 w-full"></div>
              </div>
            </div>
            <!-- price history compact -->
            <div class="mt-4 flex-1">
              <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400 mb-1.5">Как росла цена</p>
              <div class="flex items-center gap-1.5 text-[13px]">
                <span class="text-slate-400">74&nbsp;900 ₽</span>
                <i class="bi bi-arrow-right text-[11px] text-slate-300" aria-hidden="true"></i>
                <span class="font-bold text-slate-600">93&nbsp;900 ₽</span>
                <span class="ml-auto text-[11px] bg-slate-100 text-slate-500 rounded-full px-2 py-0.5 font-semibold">+25%</span>
              </div>
              <p class="mt-0.5 text-[11px] text-slate-400">Январь → Старт смены</p>
            </div>
            <!-- CTA full width -->
            <a href="/kak-proshla-smena-1/" class="mt-4 flex w-full items-center justify-center gap-1.5 rounded-xl py-3 text-[14px] font-semibold text-emerald-700 border border-emerald-200 hover:bg-emerald-50 transition-colors no-underline group">
              Смотреть как прошла
              <i class="bi bi-arrow-right text-[13px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        {/* ─── Смена 2 — идёт / завершилась ─── */}
        <div class="shifts-mq-item shrink-0 w-[calc(100vw-56px)] md:w-auto md:flex-1 self-stretch" data-shift-id="shift-2">
          <div class={`flex flex-col h-full rounded-[22px] border p-5 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_4px_14px_rgba(15,23,42,0.08)] ${s2IsLive ? 'border-amber-200 bg-amber-50/60' : 'border-border-light bg-card'}`}>
            <!-- header: circle + month | status -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-1.5">
                <span class={`inline-flex h-6 w-6 items-center justify-center rounded-full text-[13px] font-extrabold leading-none shrink-0 ${s2IsLive ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-400'}`}>2</span>
                <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-400">Июнь</p>
              </div>
              {s2IsLive ? (
                <span class="shrink-0 inline-flex items-center gap-1 rounded-full bg-amber-100 border border-amber-300 px-2.5 py-0.5 text-[11px] font-bold text-amber-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse shrink-0"></span>
                  идёт
                </span>
              ) : s2IsDone ? (
                <span class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                  <i class="bi bi-check-circle-fill text-[10px]" aria-hidden="true"></i>
                  завершена
                </span>
              ) : (
                <span class="shrink-0 inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-500">скоро</span>
              )}
            </div>
            <!-- dates -->
            <h3 class={`text-[18px] font-extrabold tracking-[-0.02em] leading-[1.1] whitespace-nowrap ${s2IsLive ? 'text-amber-800' : 'text-slate-400'}`}>10 июня — 23 июня</h3>
            <p class={`mt-0.5 text-[13px] ${s2IsLive ? 'text-amber-700' : 'text-slate-400'}`}>14 дней</p>
            <!-- progress bar -->
            <div class="mt-4">
              <div class="flex justify-between text-[12px] mb-1.5">
                <span class={s2IsLive ? 'text-amber-700' : 'text-slate-400'}>Прогресс</span>
                <span class={`font-semibold ${s2IsLive ? 'text-amber-700' : 'text-slate-500'}`}>{s2ElapsedDays} / {S2_TOTAL} дн</span>
              </div>
              <div class="h-1.5 w-full rounded-full overflow-hidden bg-slate-100">
                <div class={`h-full rounded-full ${s2IsDone ? 'bg-emerald-400' : 'bg-amber-400'}`} style={`width:${s2Pct}%`}></div>
              </div>
              <p class="mt-1 text-[11px] text-slate-400">
                {s2IsDone ? 'Смена завершена' : s2IsLive ? `Осталось ${S2_TOTAL - s2ElapsedDays} дн` : 'Набор закрыт'}
              </p>
            </div>
            <!-- price history compact -->
            <div class="mt-4 flex-1">
              <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400 mb-1.5">Как росла цена</p>
              <div class="flex items-center gap-1.5 text-[13px]">
                <span class="text-slate-400">95&nbsp;000 ₽</span>
                <i class="bi bi-arrow-right text-[11px] text-slate-300" aria-hidden="true"></i>
                <span class="font-bold text-slate-600">108&nbsp;000 ₽</span>
                <span class="ml-auto text-[11px] bg-slate-100 text-slate-500 rounded-full px-2 py-0.5 font-semibold">+14%</span>
              </div>
              <p class="mt-0.5 text-[11px] text-slate-400">Январь → Старт смены</p>
            </div>
            <!-- CTA -->
            <div class="mt-4 flex w-full items-center justify-center gap-1.5 rounded-xl py-3 text-[14px] font-semibold text-slate-400 border border-slate-200 select-none cursor-default">
              <i class="bi bi-lock text-[12px]" aria-hidden="true"></i>
              Продажи закрыты
            </div>
          </div>
        </div>

        {/* ─── Смены 3 и 4 — активные ─── */}
        {mainShifts.map((shift) => (
          <div class="shifts-mq-item shrink-0 w-[calc(100vw-56px)] md:w-auto md:flex-1 self-stretch" data-shift-id={shift.id}>
            <ShiftCard shift={shift} variant="desktop" />
          </div>
        ))}

      </div>
    </div>

    <!-- Dot-индикаторы карусели (генерируются JS) -->
    <div data-shifts-dots class="flex justify-center gap-2 mt-3 md:hidden" aria-hidden="true"></div>

    <!-- stub div for old JS that refs data-closed-panel (no-op) -->
    <div class="hidden">
      <div id="closed-shift-panel" data-closed-panel></div>
    </div>
    </div>
  </div>
</section>

<style>
  /* ── MARQUEE VIEWPORT ── */
  .shifts-marquee-vp {
    overflow: hidden;
    /* Padding = shadow clearance for card-shadow:
       mobile  → 0 2px 6px / 0 4px 14px: needs 10px top, 18px bottom
       desktop → 0 2px 8px / 0 8px 28px: needs 20px top, 36px bottom */
    padding-top: 20px;
    padding-bottom: 36px;
  }

  /* ── TRACK ── */
  .shifts-marquee-track {
    display: flex;
    overflow-x: auto;
    /* overflow-x:auto forces overflow-y:auto (CSS spec) → clips child shadows.
       Vertical padding here must cover the full shadow extent so nothing is cut. */
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: auto;
    padding-top: 20px;
    padding-bottom: 36px;
    padding-left: 18px;
    padding-right: 18px;
  }
  @media (min-width: 768px) {
    .shifts-marquee-vp {
      overflow: visible;
      padding-top: 20px;
      padding-bottom: 36px;
    }
    .shifts-marquee-track {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      overflow-x: visible;
      overflow-y: visible;
      cursor: default;
      padding-left: 0;
      padding-right: 0;
      padding-top: 20px;
      padding-bottom: 36px;
      gap: 16px;
      align-items: stretch;
    }
    .shifts-mq-item {
      width: auto !important;
    }
  }

  .shifts-marquee-track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  /* ── FADE EDGES — не заходят в padding-bottom ── */
  .shifts-mq-fade-l,
  .shifts-mq-fade-r {
    position: absolute;
    top: 0;
    bottom: 36px; /* совпадает с padding-bottom viewport */
    width: 48px;
    pointer-events: none;
    z-index: 2;
  }
  .shifts-mq-fade-l {
    left: 0;
    background: linear-gradient(to right, var(--color-page, #fff), transparent);
  }
  .shifts-mq-fade-r {
    right: 0;
    background: linear-gradient(to left, var(--color-page, #fff), transparent);
  }
  @media (min-width: 768px) {
    .shifts-mq-fade-l,
    .shifts-mq-fade-r { display: none; }
  }
</style>

<ShiftBookModal />
<ShiftCalendarModal />
<ShiftInfoModal />

<!-- Toast: популярность смены (slide-in справа, auto-dismiss 3s) -->
<div
  id="shift-stat-toast"
  aria-hidden="true"
  class="fixed right-4 bottom-24 z-[61] w-[208px]
         translate-x-[calc(100%+20px)] opacity-0 pointer-events-none
         transition-all duration-300 ease-out"
>
  <div class="bg-white/96 backdrop-blur-md rounded-2xl shadow-[0_8px_32px_rgba(15,23,42,0.14)] px-4 pt-3.5 pb-3 border border-slate-100/80">
    <!-- Мини-гистограмма (4 смены) -->
    <div class="flex items-end gap-1.5 mb-2.5" style="height:44px">
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="sst-bar-1" class="w-full rounded-t-sm" style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1)"></div>
        <span class="text-[8px] text-slate-400 font-medium leading-none">С1</span>
      </div>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="sst-bar-2" class="w-full rounded-t-sm" style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1) 0.08s"></div>
        <span class="text-[8px] text-slate-400 font-medium leading-none">С2</span>
      </div>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="sst-bar-3" class="w-full rounded-t-sm" style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1) 0.16s"></div>
        <span class="text-[8px] text-slate-400 font-medium leading-none">С3</span>
      </div>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="sst-bar-4" class="w-full rounded-t-sm" style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1) 0.24s"></div>
        <span class="text-[8px] text-slate-400 font-medium leading-none">С4</span>
      </div>
    </div>
    <p id="sst-pct"  class="text-[18px] font-bold text-slate-900 leading-none mb-0.5"></p>
    <p id="sst-name" class="text-[11px] font-semibold text-primary leading-none mb-0.5"></p>
    <p id="sst-text" class="text-[11px] text-slate-500 leading-[1.3]"></p>
  </div>
</div>

<script>
  import { STORAGE_KEYS } from '../lib/storage';
  import { shiftInfo } from '../data/shifts';
  import { renderCalendar } from '../scripts/shift-calendar';
  // submitLead больше не используется здесь — логика в ShiftBookModal.astro

  // --- Shift stat toast ---
  interface ShiftStat { pct: number; h: [number,number,number,number]; name: string; text: string }
  const SHIFT_STAT: Record<string, ShiftStat> = {
    'Смена 1':   { pct: 41, h: [100, 68, 41, 34], name: 'Смена 1',   text: 'Уезжают первыми — до семейных отпусков' },
    'Смена 2':   { pct: 28, h: [100, 68, 41, 34], name: 'Смена 2',   text: 'Середина лета — дети в лучшей форме' },
    'Смена 2.1': { pct: 28, h: [100, 68, 41, 34], name: 'Смена 2.1', text: 'Середина лета — дети в лучшей форме' },
    'Смена 2.2': { pct: 28, h: [100, 68, 41, 34], name: 'Смена 2.2', text: 'Середина лета — дети в лучшей форме' },
    'Смена 3':   { pct: 17, h: [100, 68, 41, 34], name: 'Смена 3',   text: 'Август — собираются постарше' },
    'Смена 4':   { pct: 14, h: [100, 68, 41, 34], name: 'Смена 4',   text: 'Финал лета — перед учёбой' },
  };
  // Высоты баров для каждой смены (отдельно, т.к. подсвечиваем активную)
  // Индексы: 0=Смена1, 1=Смена2, 2=Смена3, 3=Смена4
  const SHIFT_HEIGHTS: [number,number,number,number] = [100, 68, 41, 34]; // relative to max (Смена1=41%)
  const SHIFT_ACCENT = 'var(--color-primary)';
  const SHIFT_MUTED  = '#e2e8f0';

  const shiftToast = document.getElementById('shift-stat-toast');
  const sstPct     = document.getElementById('sst-pct');
  const sstName    = document.getElementById('sst-name');
  const sstText    = document.getElementById('sst-text');
  const sstBars    = [
    document.getElementById('sst-bar-1'),
    document.getElementById('sst-bar-2'),
    document.getElementById('sst-bar-3'),
    document.getElementById('sst-bar-4'),
  ];
  let shiftToastTimer: ReturnType<typeof setTimeout> | null = null;

  function showShiftToast(shiftName: string) {
    const d = SHIFT_STAT[shiftName];
    if (!d || !shiftToast) return;
    const nameToIdx: Record<string, number> = { 'Смена 1': 0, 'Смена 2': 1, 'Смена 2.1': 1, 'Смена 2.2': 1, 'Смена 3': 2, 'Смена 4': 3 };
    const idx = nameToIdx[shiftName] ?? 0;
    if (sstPct)  sstPct.textContent  = `${d.pct}%`;
    if (sstName) sstName.textContent = d.name;
    if (sstText) sstText.textContent = d.text;
    // Сбросить бары
    sstBars.forEach((b, i) => {
      if (!b) return;
      b.style.height     = '0%';
      b.style.background = i === idx ? SHIFT_ACCENT : SHIFT_MUTED;
    });
    // Показать
    shiftToast.classList.remove('translate-x-[calc(100%+20px)]', 'opacity-0');
    shiftToast.classList.add('translate-x-0', 'opacity-100');
    shiftToast.removeAttribute('aria-hidden');
    // Анимировать бары
    requestAnimationFrame(() => requestAnimationFrame(() => {
      sstBars.forEach((b, i) => { if (b) b.style.height = `${SHIFT_HEIGHTS[i]}%`; });
    }));
    // Auto-dismiss 3s
    if (shiftToastTimer) clearTimeout(shiftToastTimer);
    shiftToastTimer = setTimeout(() => {
      shiftToast.classList.add('translate-x-[calc(100%+20px)]', 'opacity-0');
      shiftToast.classList.remove('translate-x-0', 'opacity-100');
      shiftToast.setAttribute('aria-hidden', 'true');
    }, 3000);
  }


  function initShifts() {
    // === FRIEND DISCOUNT TOGGLE ===
    document.querySelectorAll<HTMLElement>('[data-toggle-root]').forEach((root) => {
      const btn = root.querySelector<HTMLButtonElement>('[data-toggle]');
      const panel = root.querySelector<HTMLElement>('[data-toggle-panel]');
      if (!btn || !panel) return;
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.classList.toggle('hidden', expanded);
        const chevron = btn.querySelector<HTMLElement>('i[id="shifts-friend-chevron"]') || document.getElementById('shifts-friend-chevron');
        if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      });
    });

    // === MOBILE CAROUSEL TABS ===
    const carousel = document.querySelector<HTMLElement>('[data-shifts-carousel]');
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-shifts-tab]');
    const dots = document.querySelectorAll<HTMLElement>('[data-shifts-dot]');

    if (carousel && tabs.length) {
      const cards = Array.from(carousel.children) as HTMLElement[];

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.dataset.shiftsTab || '0', 10);
          cards[idx]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        });
      });

      // Swipe hint: скрыть если уже свайпали раньше
      const swipeHint = document.querySelector<HTMLElement>('[data-shifts-swipe-hint]');
      if (swipeHint && localStorage.getItem(STORAGE_KEYS.shiftsSwiped)) {
        swipeHint.style.display = 'none';
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            tabs.forEach((t, ti) => {
              t.classList.toggle('bg-primary-light', ti === idx);
              t.classList.toggle('text-white', ti === idx);
              t.classList.toggle('bg-surface', ti !== idx);
              t.classList.toggle('text-body-muted', ti !== idx);
            });
            dots.forEach((d, di) => {
              const isActive = di === idx;
              d.classList.toggle('bg-primary-dark', isActive);
              d.classList.toggle('w-6', isActive);
              d.classList.toggle('bg-border', !isActive);
              d.classList.toggle('w-2', !isActive);
              d.setAttribute('aria-current', isActive ? 'true' : 'false');
            });
            if (idx > 0 && swipeHint) {
              swipeHint.classList.add('opacity-0');
              localStorage.setItem(STORAGE_KEYS.shiftsSwiped, '1');
            }
          }
        });
      }, { root: carousel, threshold: 0.6 });

      cards.forEach((card) => observer.observe(card));
    }

    // === BOOKING MODAL — лишь биндинг кнопок открытия + заполнение данных смены.
    // Вся логика валидации/сабмита формы — внутри ShiftBookModal.astro (self-contained).
    const bookModal = document.getElementById('shiftBookModal') as HTMLDialogElement | null;
    if (!bookModal) return;
    const bookShiftBlock = bookModal.querySelector<HTMLElement>('[data-book-shift-block]');
    const bookName = bookModal.querySelector('[data-book-shift-name]');
    const bookDates = bookModal.querySelector('[data-book-shift-dates]');
    const bookDuration = bookModal.querySelector('[data-book-shift-duration]');
    const bookPrice = bookModal.querySelector('[data-book-shift-price]');

    document.querySelectorAll('[data-shift-book]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const name = el.dataset.shiftBookName || '';
        if (bookName) bookName.textContent = name;
        if (bookDates) bookDates.textContent = el.dataset.shiftBookDates || '';
        if (bookDuration) bookDuration.textContent = el.dataset.shiftBookDuration || '';
        if (bookPrice) bookPrice.textContent = el.dataset.shiftBookPrice || '';
        if (bookShiftBlock) bookShiftBlock.classList.toggle('hidden', !name);
        showShiftToast(name);
        bookModal.showModal();
        (window as any).trackGoal?.('shift_book_click', { shift: name }, 500);
      });
    });

    // === CALENDAR MODAL ===
    const calendarModal = document.getElementById('shiftCalendarModal') as HTMLDialogElement | null;
    if (calendarModal) {
      const calendarGrid = calendarModal.querySelector('[data-calendar-grid]');
      const calendarTitle = calendarModal.querySelector('[data-calendar-title]');

      document.querySelectorAll<HTMLElement>('[data-shift-calendar]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const startStr = btn.dataset.start || '';
          const endStr = btn.dataset.end || '';
          const shiftName = btn.dataset.shiftName || '';
          if (calendarGrid && calendarTitle) {
            renderCalendar(startStr, endStr, shiftName, calendarGrid, calendarTitle);
          }
          calendarModal.showModal();
        });
      });

      calendarModal.querySelector('[data-calendar-close]')?.addEventListener('click', () => calendarModal.close());
      calendarModal.addEventListener('click', (e) => { if (e.target === calendarModal) calendarModal.close(); });
    }

    // === INFO MODAL ===
    const infoModal = document.getElementById('shiftInfoModal') as HTMLDialogElement | null;
    if (infoModal) {
      const infoTitle = infoModal.querySelector('[data-info-title]');
      const infoDates = infoModal.querySelector('[data-info-dates]');
      const infoPrice = infoModal.querySelector('[data-info-price]');
      const infoBody = infoModal.querySelector('[data-info-body]');

      document.querySelectorAll<HTMLElement>('[data-shift-info]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const shiftId = btn.dataset.shiftInfo || '';
          const info = shiftInfo[shiftId];
          if (info) {
            if (infoTitle) infoTitle.textContent = btn.dataset.shiftTitle || '';
            if (infoDates) infoDates.textContent = info.dates + ' · ' + info.duration;
            if (infoPrice) infoPrice.textContent = info.price;
            if (infoBody) infoBody.innerHTML = info.html;
          }
          infoModal.showModal();
        });
      });

      infoModal.querySelector('[data-info-close]')?.addEventListener('click', () => infoModal.close());
      infoModal.addEventListener('click', (e) => { if (e.target === infoModal) infoModal.close(); });
    }
  }

  document.addEventListener('astro:page-load', initShifts);
  // Defer — Shifts ниже fold, не блокируем LCP
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initShifts, { timeout: 2000 });
  } else {
    setTimeout(initShifts, 200);
  }

  // === AGE PERSONALIZATION: показываем счётчик ровесников ===
  function showPeerCounts(age: string) {
    document.querySelectorAll<HTMLElement>('.peer-count-badge').forEach((badge) => {
      const counts = JSON.parse(badge.dataset.peerCounts || '{}');
      const n = counts[age];
      if (!n) return;
      const textEl = badge.querySelector<HTMLElement>('.peer-count-text');
      if (textEl) textEl.textContent = `${n} ровесников уже едут в эту смену`;
      badge.classList.remove('hidden');
      badge.classList.add('flex');
    });
  }

  function initShiftAgePersonalization() {
    // Fix 2026-04-20: показываем peer-count ТОЛЬКО после явного выбора в сессии
    // (не читаем из localStorage — иначе на первом заходе показывается "ровесники"
    // без реального выбора возраста, логика бьётся).
    const sessionAge = sessionStorage.getItem(STORAGE_KEYS.selectedAge);
    if (sessionAge) showPeerCounts(sessionAge);
    document.addEventListener('age-personalize', (e: Event) => {
      showPeerCounts((e as CustomEvent<{ age: string }>).detail.age);
    });
  }

  document.addEventListener('astro:page-load', initShiftAgePersonalization);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initShiftAgePersonalization, { timeout: 2000 });
  } else {
    setTimeout(initShiftAgePersonalization, 200);
  }

  // ═══════════════════════════════════════════════════════════
  // INFINITE MARQUEE
  // ═══════════════════════════════════════════════════════════
  function initShiftsMarquee() {
    const vp    = document.querySelector<HTMLElement>('[data-shifts-marquee-vp]');
    const track = document.querySelector<HTMLElement>('[data-shifts-marquee-track]');
    if (!vp || !track) return;
    if (track.dataset.mqReady) return;
    track.dataset.mqReady = '1';

    const origItems = Array.from(track.querySelectorAll<HTMLElement>('.shifts-mq-item'));
    if (!origItems.length) return;

    // Mobile initial scroll to active shift (index from data-carousel-initial)
    if (window.innerWidth < 768) {
      const initialIdx = parseInt(track.dataset.carouselInitial || '0', 10);
      if (initialIdx > 0 && origItems[initialIdx]) {
        requestAnimationFrame(() => {
          const item = origItems[initialIdx];
          const vw = window.innerWidth;
          track.scrollLeft = item.offsetLeft - (vw - item.offsetWidth) / 2;
        });
      }
    }

    // ── Dot-индикаторы ───────────────────────────────────────
    const dotsContainer = document.querySelector<HTMLElement>('[data-shifts-dots]');
    const dotEls: HTMLElement[] = [];
    if (dotsContainer) {
      dotsContainer.innerHTML = '';
      origItems.forEach((_, i) => {
        const d = document.createElement('span');
        d.className = 'block h-2 rounded-full transition-all duration-300 ' + (i === 0 ? 'w-6 bg-primary' : 'w-2 bg-border');
        d.setAttribute('aria-hidden', 'true');
        dotsContainer.appendChild(d);
        dotEls.push(d);
      });

      const dotObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && (entry.intersectionRatio ?? 0) > 0.5) {
            const idx = origItems.indexOf(entry.target as HTMLElement);
            if (idx < 0) return;
            dotEls.forEach((d, di) => {
              const active = di === idx;
              d.className = 'block h-2 rounded-full transition-all duration-300 ' + (active ? 'w-6 bg-primary' : 'w-2 bg-border');
            });
          }
        });
      }, { root: vp, threshold: 0.5 });

      origItems.forEach((item) => dotObserver.observe(item));
    }

    // ── Mouse drag ───────────────────────────────────────────
    let isDragging = false;
    let dragStartX = 0;
    let dragScrollL = 0;

    track.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      isDragging  = true;
      dragStartX  = e.pageX - track.offsetLeft;
      dragScrollL = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      e.preventDefault();
      track.scrollLeft = dragScrollL - (e.pageX - track.offsetLeft - dragStartX);
    });
    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');
    });
  }

  document.addEventListener('astro:page-load', initShiftsMarquee);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initShiftsMarquee, { timeout: 1500 });
  } else {
    setTimeout(initShiftsMarquee, 150);
  }
</script>

<script>
  // Auto-scroll returning mobile visitors to their previously viewed shift
  function initViewedShiftScroll() {
    if (window.innerWidth >= 768) return;
    if (sessionStorage.getItem('ac:scroll_done')) return;

    let viewed: Array<{ id: string; ts: number }>;
    try {
      viewed = JSON.parse(localStorage.getItem('ac:viewed_shifts') || '[]');
    } catch {
      return;
    }
    if (!viewed.length) return;

    // Most recently viewed shift
    const targetId = viewed.sort((a, b) => b.ts - a.ts)[0].id;
    const track = document.querySelector<HTMLElement>('[data-shifts-marquee-track]');
    if (!track) return;

    // Find the item — querySelector gets the first (pre-duplication) occurrence
    const item = track.querySelector<HTMLElement>(`[data-shift-id="${targetId}"]`);
    if (!item) return;

    sessionStorage.setItem('ac:scroll_done', '1');

    // Wait for marquee JS to finish (it might reorder items), then scroll
    setTimeout(() => {
      const shiftsSection = document.getElementById('shifts');
      if (shiftsSection) {
        shiftsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      // Scroll the carousel track so the viewed shift card is centred
      setTimeout(() => {
        const vw = window.innerWidth;
        const itemLeft = item.offsetLeft;
        const itemWidth = item.offsetWidth;
        track.scrollTo({ left: itemLeft - (vw - itemWidth) / 2, behavior: 'smooth' });
      }, 400);
    }, 600);
  }

  document.addEventListener('astro:page-load', initViewedShiftScroll);
  initViewedShiftScroll();
</script>

