---
// Блок отзывов о конкретной смене: один featured (крупно) + сетка остальных.
// Используется на страницах «как прошла смена N». Данные — *.ts со списком ShiftReview.
import type { ShiftReview } from '../data/reviewsSmena2';

interface Props {
  items: ShiftReview[];
  title?: string;
  subtitle?: string;
}
const { items, title = 'Отзывы родителей', subtitle = 'Что написали на Яндекс.Картах после смены' } = Astro.props;

const featured = items[0];
const rest = items.slice(1);

// Аватарка-инициал (у свежих отзывов нет фото)
const avatarColors = ['bg-orange-500', 'bg-rose-500', 'bg-violet-500', 'bg-sky-500', 'bg-emerald-500', 'bg-amber-500', 'bg-indigo-500'];
const initial = (n: string) => n.trim().charAt(0).toUpperCase();
const STAR = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
---

<section class="mx-auto max-w-4xl px-4 pt-8 pb-2">
  <h2 class="text-[20px] font-bold text-slate-900 mb-1">{title}</h2>
  <p class="text-base text-slate-500 mb-5">{subtitle}</p>

  {featured && (
    <article class="rounded-[22px] border border-border bg-surface p-5 md:p-6 mb-4 card-shadow">
      <div class="flex items-center gap-3">
        <div class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-[18px] font-bold text-white ${avatarColors[0]}`}>{initial(featured.name)}</div>
        <div class="min-w-0">
          <p class="text-base font-semibold text-body truncate">{featured.name}</p>
          <p class="text-base text-body-muted">{featured.date}</p>
        </div>
        <div class="ml-auto flex shrink-0 text-amber-400">
          {[...Array(5)].map(() => (<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d={STAR} /></svg>))}
        </div>
      </div>
      <p class="mt-3 text-[18px] leading-[1.6] text-body-muted whitespace-pre-line">{featured.fullText || featured.text}</p>
    </article>
  )}

  {rest.length > 0 && (
    <div class="grid gap-3 sm:grid-cols-2">
      {rest.map((r, i) => (
        <article class="rounded-[22px] border border-border bg-surface p-4 md:p-5 flex flex-col card-shadow">
          <div class="flex items-center gap-3">
            <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-base font-bold text-white ${avatarColors[(i + 1) % avatarColors.length]}`}>{initial(r.name)}</div>
            <div class="min-w-0">
              <p class="text-base font-semibold text-body truncate">{r.name}</p>
              <p class="text-base text-body-muted">{r.date}</p>
            </div>
            <div class="ml-auto flex shrink-0 text-amber-400">
              {[...Array(5)].map(() => (<svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d={STAR} /></svg>))}
            </div>
          </div>
          <p class="mt-3 text-[18px] leading-[1.6] text-body-muted flex-1">{r.text}</p>
        </article>
      ))}
    </div>
  )}

  <div class="mt-5">
    <a href="/otzyvy/"
      class="inline-flex items-center gap-1.5 text-base font-semibold text-primary-dark hover:text-primary transition-colors no-underline">
      Все отзывы родителей
      <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
    </a>
  </div>
</section>
