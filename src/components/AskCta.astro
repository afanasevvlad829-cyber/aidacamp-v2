---
// AskCta — заменяет LeadForm. Ведёт на /ask (AI-ассистент, анонимно, без регистрации).
---

<section class="mx-auto max-w-[1312px] px-[2px] py-4 md:px-4">
  <a
    href="/ask"
    data-analytics-goal="ask_cta_click"
    class="group flex w-full items-center justify-between gap-4 rounded-[22px] bg-[#0d1a2b] px-6 py-5 shadow-[0_4px_16px_rgba(13,26,43,0.18),0_20px_48px_rgba(13,26,43,0.28)] transition-all hover:bg-[#132236] active:bg-[#0d1a2b] md:px-8 md:py-6"
  >
    <!-- Left: icon + text -->
    <div class="flex items-center gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[14px] bg-orange-500/15">
        <i class="bi bi-telegram text-[26px] text-orange-400" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[17px] font-bold leading-tight text-white md:text-[19px]">
          Спросите про лагерь
        </p>
        <p class="mt-0.5 text-[13px] leading-tight text-white/50">
          AI-ассистент · анонимно · без регистрации · отвечает сразу
        </p>
      </div>
    </div>

    <!-- Right: arrow -->
    <svg
      class="h-5 w-5 shrink-0 text-white/30 transition-transform group-hover:translate-x-1 group-hover:text-orange-400"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</section>
