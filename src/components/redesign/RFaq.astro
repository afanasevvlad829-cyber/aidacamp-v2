---
/**
 * FAQ — четыре темы, которые чаще всего решают «да» или «нет»: безопасность,
 * еда, размещение, оплата. Вопросы берутся из faq.ts, тексты не дублируются.
 * Аккордеон на <details> — открывается без JS, доступен с клавиатуры.
 */
import { faqCategories } from '../../data/faq';

const shown = ['safety', 'food', 'accommodation', 'payment']
  .map(id => faqCategories.find(c => c.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<section class="r-section" id="faq">
  <div class="r-wrap">
    <div class="r-head">
      <p class="r-kicker">Вопросы</p>
      <div class="r-head__body">
        <h2 class="r-h2">То, что спрашивают <span class="r-em">до записи</span></h2>
        <p class="r-lead r-text">
          Остальное — в <a href="/faq/">полном списке вопросов</a> и в
          <a href="/garantii/">гарантиях</a>: возврат при болезни, застрахованная
          ответственность туроператора.
        </p>
      </div>
    </div>

    <div class="r-faq__cols">
      {shown.map(cat => (
        <div class="r-faq__group">
          <p class="r-faq__label">{cat.label}</p>
          {cat.items.map(item => (
            <details class="r-faq__item">
              <summary>
                <span>{item.q}</span>
                <i class="bi bi-plus" aria-hidden="true"></i>
              </summary>
              <div class="r-faq__answer" set:html={item.a} />
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .r-faq__cols { display: grid; gap: clamp(32px, 4vw, 48px); }

  .r-faq__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--r-accent-ink);
    margin: 0 0 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--r-line);
  }

  .r-faq__item { border-bottom: 1px solid var(--r-line-soft); }
  .r-faq__item summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    cursor: pointer;
    font-size: 16.5px;
    font-weight: 500;
    color: var(--r-ink);
    list-style: none;
  }
  .r-faq__item summary::-webkit-details-marker { display: none; }
  .r-faq__item summary:focus-visible { outline: 2px solid var(--r-accent-ink); outline-offset: 2px; }
  .r-faq__item summary i {
    color: var(--r-muted);
    font-size: 18px;
    flex: none;
    transition: transform .2s ease;
  }
  .r-faq__item[open] summary i { transform: rotate(45deg); }
  .r-faq__item[open] summary { color: var(--r-accent-ink); }

  .r-faq__answer {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--r-body);
    padding: 0 0 18px;
    max-width: 62ch;
  }
  .r-faq__answer :global(a) { color: var(--r-accent-ink); }

  @media (min-width: 860px) {
    .r-faq__cols { grid-template-columns: repeat(2, 1fr); gap: 48px 64px; }
  }
</style>
