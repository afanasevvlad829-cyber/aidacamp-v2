---
/**
 * «Как проходит день» — редакционный разворот: три части дня, каждая с фото.
 * Часы сознательно не указаны, кроме тихого часа: точное расписание живёт
 * на /stati/raspisanie-v-lagere/ и меняется по сменам — дублировать его здесь
 * значит завести второй источник правды.
 */
const parts = [
  {
    label: 'До обеда',
    title: 'Занятия',
    photo: '/images/gallery/study-coding.avif',
    alt: 'Занятие по программированию в АйДаКемп',
    text: 'Группы до 8 человек, преподаватель знает каждого по имени. Приезжают без опыта — уезжают с готовой игрой, ботом или AI-приложением. Ноутбук привозить не нужно: вся техника в лагере.',
  },
  {
    label: 'После тихого часа',
    title: 'Бассейн и спорт',
    photo: '/images/gallery/pool-noodles.avif',
    alt: 'Бассейн санатория, ребята в воде',
    text: 'Тихий час с 14:00 до 15:00 — он есть даже у подростков, и это единственное железное правило распорядка. Дальше бассейн, футбол, волейбол и территория санатория, по которой можно ходить час и не повториться.',
  },
  {
    label: 'Вечер',
    title: 'Своё дело',
    photo: '/images/gallery/hackathon-present.avif',
    alt: 'Защита проекта на хакатоне',
    text: 'Вечернее мероприятие, настолки в холлах, подготовка к защите проекта. В финале смены — хакатон: день, за который команда собирает и показывает продукт. Именно про этот день потом рассказывают дома.',
  },
];
---

<section class="r-section r-section--paper2" id="day">
  <div class="r-wrap">
    <div class="r-head">
      <p class="r-kicker">День в лагере</p>
      <div class="r-head__body">
        <h2 class="r-h2">Утро за кодом, день в воде,<br /><span class="r-em">вечер за своим проектом</span></h2>
        <p class="r-lead r-text r-dropcap">
          Смена устроена так, чтобы к вечеру не оставалось сил на скуку и на телефон. Занятия —
          не кружок и не школа: с первого дня ребята делают собственный проект и защищают его
          перед всеми. Между этим — обычная лагерная жизнь, ради которой в лагерь и едут.
        </p>
      </div>
    </div>

    <div class="r-day__grid">
      {parts.map((p, i) => (
        <article class="r-day">
          <figure class="r-figure r-day__figure">
            <img src={p.photo} alt={p.alt} loading="lazy" decoding="async" width="640" height="480" class="r-photo" />
          </figure>
          <p class="r-day__label">{p.label}</p>
          <h3 class="r-h3">{p.title}</h3>
          <p class="r-day__text">{p.text}</p>
        </article>
      ))}
    </div>

    <div class="r-day__more">
      <a href="/stati/raspisanie-v-lagere/" class="r-btn r-btn--ghost">Полное расписание дня</a>
      <a href="/programma/" class="r-btn r-btn--ghost">Что именно изучают</a>
    </div>
  </div>
</section>

<style>
  .r-day__grid { display: grid; gap: clamp(32px, 4vw, 44px); }
  .r-day { display: flex; flex-direction: column; }
  .r-day__figure { aspect-ratio: 4 / 3; margin-bottom: 20px; }
  .r-day__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--r-accent-ink);
    margin: 0 0 8px;
  }
  .r-day .r-h3 { margin-bottom: 10px; }
  .r-day__text { font-size: 16px; line-height: 1.6; margin: 0; }

  .r-day__more {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 26px;
    border-top: 1px solid var(--r-line);
  }

  @media (min-width: 860px) {
    .r-day__grid { grid-template-columns: repeat(3, 1fr); }
    /* Средняя колонка опущена — журнальный сбив ритма вместо ровной плитки */
    .r-day:nth-child(2) { margin-top: 48px; }
  }
</style>
