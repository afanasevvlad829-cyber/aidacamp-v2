---
/**
 * Финальный экран: предзапись + все способы связаться + подвал.
 * Форма минимальная (имя и телефон) — каждое лишнее поле стоит заявок;
 * остальное менеджер спрашивает голосом.
 */
import {
  PHONE_MAIN, PHONE_MAIN_HREF, EMAIL, EMAIL_HREF,
  WHATSAPP_URL, TELEGRAM_URL, VK_URL,
  STAT_DISTANCE, STAT_INSURED,
} from '../../data/contacts';
import { PRICE_OSEN, VYCHET_OSEN, SEASON_YEAR } from '../../data/shifts';
import { AUTUMN_SEASON } from '../../data/seasons';
---

<section class="r-section r-cta" id="zapis">
  <div class="r-wrap r-cta__grid">
    <div class="r-cta__pitch">
      <p class="r-kicker">Предварительная запись</p>
      <h2 class="r-h2">Оставьте телефон — <span class="r-em">перезвоним и всё расскажем</span></h2>
      <p class="r-lead r-text">
        Предзапись ни к чему не обязывает: она фиксирует за вами цену {PRICE_OSEN} и место
        в очереди, когда откроются продажи. Из них ≈ {VYCHET_OSEN} вернётся налоговым вычетом.
      </p>

      <ul class="r-cta__points">
        <li><i class="bi bi-clock" aria-hidden="true"></i>Отвечаем в течение часа в рабочее время</li>
        <li><i class="bi bi-geo-alt" aria-hidden="true"></i>{STAT_DISTANCE} от Москвы, Наро-Фоминский округ</li>
        <li><i class="bi bi-shield-check" aria-hidden="true"></i>{STAT_INSURED}</li>
      </ul>
    </div>

    <form class="r-cta__form" data-r-form>
      <label class="r-field">
        <span>Как вас зовут</span>
        <input type="text" name="name" autocomplete="name" placeholder="Имя" required />
      </label>
      <label class="r-field">
        <span>Телефон</span>
        <input type="tel" name="phone" autocomplete="tel" placeholder="+7 (___) ___-__-__" required />
      </label>
      <label class="r-field">
        <span>Какой заезд интересует</span>
        <select name="shift">
          <option>25–31 октября — основной</option>
          <option>15–21 ноября — триместровые школы</option>
          <option>Лето {SEASON_YEAR + 1}</option>
          <option>Пока не выбрали</option>
        </select>
      </label>

      <button type="submit" class="r-btn r-btn--primary r-cta__submit">Записаться заранее</button>

      <p class="r-cta__legal">
        Нажимая кнопку, вы соглашаетесь с <a href="/politika-konfidentsialnosti/">политикой обработки данных</a>.
      </p>

      <div class="r-cta__alt">
        <span>Или сразу напишите:</span>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener">Telegram</a>
        <a href={PHONE_MAIN_HREF}>{PHONE_MAIN}</a>
      </div>
    </form>
  </div>
</section>

<footer class="r-footer">
  <div class="r-wrap">
    <div class="r-footer__top">
      <div class="r-footer__brand">
        <p class="r-footer__logo">АйДаКемп</p>
        <p class="r-footer__tag">Детский IT-лагерь в Подмосковье, {STAT_DISTANCE} от Москвы.</p>
      </div>

      <nav class="r-footer__nav" aria-label="Разделы сайта">
        <div>
          <p class="r-footer__col-title">Лагерь</p>
          <a href="#shifts">Смены и цены</a>
          <a href="/programma/">Программа</a>
          <a href="/foto/">Фото смен</a>
          <a href="/otzyvy/">Отзывы</a>
        </div>
        <div>
          <p class="r-footer__col-title">Родителям</p>
          <a href="/faq/">Вопросы и ответы</a>
          <a href="/garantii/">Гарантии и возврат</a>
          <a href={`${AUTUMN_SEASON.path}/`}>Осенние каникулы</a>
          <a href="/kontakty/">Как добраться</a>
        </div>
        <div>
          <p class="r-footer__col-title">Связь</p>
          <a href={PHONE_MAIN_HREF}>{PHONE_MAIN}</a>
          <a href={EMAIL_HREF}>{EMAIL}</a>
          <a href={VK_URL} target="_blank" rel="noopener">ВКонтакте</a>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener">Telegram</a>
        </div>
      </nav>
    </div>

    <div class="r-footer__bottom">
      <span>© {SEASON_YEAR} АйДаКемп</span>
      <span>{STAT_INSURED}</span>
    </div>
  </div>
</footer>

<style>
  .r-cta { background: var(--r-paper-2); }
  .r-cta__grid { display: grid; gap: clamp(36px, 5vw, 72px); align-items: start; }

  .r-cta__pitch .r-h2 { margin-bottom: 18px; }
  .r-cta__points {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .r-cta__points li {
    display: flex;
    align-items: baseline;
    gap: 11px;
    font-size: 15.5px;
    color: var(--r-body);
  }
  .r-cta__points i { color: var(--r-accent-ink); font-size: 15px; flex: none; }

  .r-cta__form {
    background: var(--r-card);
    border: 1px solid var(--r-line);
    border-radius: var(--r-radius);
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .r-field { display: flex; flex-direction: column; gap: 7px; }
  .r-field span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--r-muted);
  }
  .r-field input,
  .r-field select {
    font: inherit;
    font-size: 16px; /* ≥16px — иначе Safari зумит форму на мобиле */
    padding: 14px 15px;
    border: 1px solid var(--r-line);
    border-radius: var(--r-radius);
    background: var(--r-paper);
    color: var(--r-ink);
    width: 100%;
  }
  .r-field input:focus-visible,
  .r-field select:focus-visible {
    outline: 2px solid var(--r-accent);
    outline-offset: 1px;
    border-color: var(--r-accent);
  }
  .r-cta__submit { margin-top: 6px; }
  .r-cta__legal { font-size: 13px; color: var(--r-muted); margin: 0; line-height: 1.45; }
  .r-cta__legal a { color: var(--r-accent-ink); }

  .r-cta__alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--r-line-soft);
    font-size: 15px;
  }
  .r-cta__alt span { color: var(--r-muted); }
  .r-cta__alt a { color: var(--r-ink); font-weight: 500; text-underline-offset: 3px; }

  /* ── Подвал ── */
  .r-footer {
    background: var(--r-forest-2);
    color: rgba(251, 248, 243, .72);
    padding-block: clamp(40px, 5vw, 64px) 28px;
  }
  .r-footer__top { display: grid; gap: 36px; padding-bottom: 32px; }
  .r-footer__logo {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 30px;
    font-weight: 600;
    color: #FBF8F3;
    margin: 0 0 8px;
  }
  .r-footer__tag { font-size: 15px; margin: 0; max-width: 32ch; }

  .r-footer__nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .r-footer__nav div { display: flex; flex-direction: column; gap: 9px; }
  .r-footer__col-title {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(251, 248, 243, .5);
    margin: 0 0 3px;
  }
  .r-footer__nav a {
    color: rgba(251, 248, 243, .82);
    text-decoration: none;
    font-size: 15px;
  }
  .r-footer__nav a:hover { color: var(--r-accent); }

  .r-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    padding-top: 22px;
    border-top: 1px solid rgba(251, 248, 243, .16);
    font-size: 13.5px;
    color: rgba(251, 248, 243, .55);
  }

  @media (min-width: 860px) {
    .r-cta__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 80px; }
    .r-footer__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 64px; }
    .r-footer__nav { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script is:inline>
  // Прототип: показываем, что форма реагирует, но никуда не отправляем —
  // подключение к /api/lead делается при переносе на боевую страницу.
  (function () {
    var form = document.querySelector('[data-r-form]');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (btn) {
        btn.textContent = 'Прототип: заявка не отправляется';
        btn.disabled = true;
      }
    });
  })();
</script>
