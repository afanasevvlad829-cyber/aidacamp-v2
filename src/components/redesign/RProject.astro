---
/**
 * «Что уезжает домой» — главный отличающий аргумент лагеря. Разбивка по возрастам
 * повторяет ответ из faq.ts («Что ребёнок создаёт за смену»), группы — реальные
 * отряды 7–9 / 10–12 / 13–15.
 *
 * Формат — нумерованные ступени: здесь номер несёт смысл (возраст растёт,
 * сложность проекта тоже), а не украшает блок.
 */
const levels = [
  {
    age: '7–9 лет',
    what: 'Своя игра в Scratch или мир в Minecraft',
    text: 'Начинаем с блоков: персонаж, движение, правила. К концу смены игра работает и в неё можно играть с друзьями.',
  },
  {
    age: '10–12 лет',
    what: 'Python-бот или игра на pygame',
    text: 'Первый настоящий код. Разбираем, почему программа падает, и учимся читать ошибку, а не бояться её.',
  },
  {
    age: '13–15 лет',
    what: 'AI-приложение или бот с нейросетью',
    text: 'Работа с моделями и API, 3D в Blender, защита проекта перед залом. Ближе всего к тому, как это устроено во взрослой разработке.',
  },
];
---

<section class="r-section r-project" id="project">
  <div class="r-wrap">
    <div class="r-head">
      <p class="r-kicker">Результат смены</p>
      <div class="r-head__body">
        <h2 class="r-h2">Домой уезжают <span class="r-em">не с фотографиями</span>, а с проектом</h2>
        <p class="r-lead r-text">
          Опыт программирования не нужен — принимаем с нуля. Группы делятся по возрасту и уровню,
          не больше восьми человек на преподавателя.
        </p>
      </div>
    </div>

    <ol class="r-project__list">
      {levels.map((l, i) => (
        <li class="r-project__item">
          <span class="r-project__num">{String(i + 1).padStart(2, '0')}</span>
          <div class="r-project__body">
            <p class="r-project__age">{l.age}</p>
            <h3 class="r-h3">{l.what}</h3>
            <p class="r-project__text">{l.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="r-project__final">
      <figure class="r-figure r-project__photo">
        <img
          src="/images/gallery/study-pitch.avif"
          alt="Защита проекта перед залом на финале смены"
          loading="lazy"
          decoding="async"
          width="960"
          height="640"
          class="r-photo"
        />
      </figure>
      <div class="r-project__final-text">
        <p class="r-kicker">Последний день</p>
        <h3 class="r-h3">Хакатон: один день — целый продукт</h3>
        <p>
          Команда получает задачу утром и показывает готовое решение вечером. Волнуются все,
          включая преподавателей. Именно с этого дня начинается рассказ, который дома
          слушают неделю.
        </p>
        <a href="/programma/" class="r-btn r-btn--ghost">Программа по дням</a>
      </div>
    </div>
  </div>
</section>

<style>
  .r-project__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--r-line);
  }
  .r-project__item {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 8px;
    padding-block: 26px;
    border-bottom: 1px solid var(--r-line);
  }
  .r-project__num {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 22px;
    color: var(--r-accent-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .r-project__age {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--r-muted);
    margin: 0 0 6px;
  }
  .r-project__body .r-h3 { margin-bottom: 8px; }
  .r-project__text { font-size: 16px; line-height: 1.55; margin: 0; max-width: 56ch; }

  .r-project__final {
    display: grid;
    gap: 28px;
    margin-top: clamp(40px, 5vw, 64px);
    align-items: center;
  }
  .r-project__photo { aspect-ratio: 3 / 2; }
  .r-project__final-text p:not(.r-kicker) {
    font-size: 16.5px;
    line-height: 1.6;
    margin: 12px 0 20px;
    max-width: 52ch;
  }

  @media (min-width: 860px) {
    .r-project__item { grid-template-columns: 80px minmax(0, 1fr); gap: 24px; padding-block: 32px; }
    .r-project__num { font-size: 26px; }
    .r-project__final { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 56px; }
  }
</style>
