---
/**
 * Hero — редакционный разворот, а не фото с текстом поверх.
 *
 * Почему так: текст на групповом кадре всегда конфликтует с лицами и требует
 * затемнения, а затемнение съедает саму фотографию. Здесь типографика живёт
 * на бумаге и читается чисто, снимок работает отдельным кадром — и слабый
 * кадр портит впечатление меньше, чем растянутый во весь экран.
 *
 * На первом экране сознательно нет цены, счётчиков и цветных кнопок:
 * цена — сноска в расписании, а не аргумент.
 */
import { STAT_DISTANCE } from '../../data/contacts';
import { AUTUMN_2026 } from '../../data/shifts';

// Дата ближайшего заезда — форматируем из ISO, чтобы подпись не разъезжалась с shifts.ts
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' }).replace('.', '');
const autumnRange = `${fmt(AUTUMN_2026.startDate)} — ${fmt(AUTUMN_2026.endDate)}`;
---

<section class="r-hero r-grid-bg">
  <div class="r-wrap r-hero__grid">
    <div class="r-hero__copy">
      <p class="r-hero__kicker">Подмосковье · {STAT_DISTANCE} от Москвы · 7–15 лет</p>

      <h1 class="r-display r-hero__title">
        Детский IT-лагерь, из которого
        <span class="r-em">не хотят уезжать</span>
      </h1>

      <p class="r-hero__lead">
        Сосновый лес в часе от города. Занятия с преподавателями-практиками до обеда,
        бассейн и своя лагерная жизнь после.
      </p>

      <div class="r-hero__actions">
        <a href="#shifts" class="r-btn r-btn--outline">Смены</a>
        <a href="#day" class="r-btn r-btn--ghost">Как проходит день</a>
      </div>
    </div>

    <div class="r-hero__visual">
      <figure class="r-figure r-hero__figure">
        <img
          src="/images/gallery/territory-alley.avif"
          alt="Сосновая аллея на территории лагеря"
          width="960"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class="r-photo"
        />
      </figure>

      {/* Панель ближайшего заезда: светлое стекло поверх кадра. Все значения —
          из shifts.ts, декоративных цифр в панели нет. */}
      <div class="r-panel r-panel--ticks r-hero__panel">
        <p class="r-mono r-mono--data">Ближайший заезд</p>
        <div class="r-hero__panel-grid">
          <div class="r-metric">
            <span class="r-metric__label">Даты</span>
            <span class="r-metric__value">{autumnRange}</span>
          </div>
          <div class="r-metric">
            <span class="r-metric__label">Длительность</span>
            <span class="r-metric__value">{AUTUMN_2026.days} дней</span>
          </div>
          <div class="r-metric">
            <span class="r-metric__label">В группе</span>
            <span class="r-metric__value">до 8</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="r-wrap r-hero__foot">
    <p>
      Санаторий «Изумруд», закрытая территория с бассейном. Отряды до восьми человек,
      медработник на смене круглосуточно.
    </p>
  </div>
</section>

<style>
  .r-hero {
    padding-top: clamp(28px, 5vw, 64px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .r-hero__grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .r-hero__kicker {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--r-muted);
    margin: 0 0 22px;
  }
    .r-hero__title {
    max-width: 20ch;
    margin: 0 0 26px;
    /* Кегль чуть ниже общего display: «IT-лагерь» — длинное неразрывное слово,
       на крупном размере оно ломало строку посередине. */
    font-size: clamp(34px, 4.6vw, 58px);
  }
  .r-hero__lead {
    font-size: clamp(17px, 1.6vw, 19.5px);
    line-height: 1.6;
    color: var(--r-body);
    max-width: 40ch;
    margin: 0 0 38px;
  }
  .r-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 26px;
  }

  .r-hero__visual { position: relative; }
  .r-hero__figure { aspect-ratio: 4 / 5; }

  .r-hero__panel {
    margin-top: -56px;
    margin-inline: 16px 0;
    position: relative;
    z-index: 1;
  }
  .r-hero__panel .r-mono { margin: 0 0 14px; }
  .r-hero__panel-grid {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 18px 26px;
  }

  /* Одна строка вместо полосы счётчиков: «5.0 / 1200+ / 24/7» — язык
     агрегаторов, а не бренда. */
  .r-hero__foot {
    margin-top: clamp(36px, 5vw, 64px);
    padding-top: 22px;
  }
  .r-hero__foot p {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--r-line);
    font-size: 15px;
    line-height: 1.55;
    color: var(--r-muted);
    max-width: 68ch;
  }

  @media (min-width: 900px) {
    .r-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
      gap: 72px;
    }
    /* Фотография опущена относительно текста — разворот, а не две ровные колонки */
    .r-hero__visual { margin-top: 40px; }
    /* Панель выходит за левый край кадра — слой интерфейса поверх фотографии,
       а не подпись под ней */
    .r-hero__panel { margin-left: -48px; margin-right: 32px; }
  }
</style>
