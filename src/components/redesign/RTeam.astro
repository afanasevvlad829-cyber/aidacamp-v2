---
/**
 * Команда — четыре человека, которых родитель реально встретит: основатель,
 * руководитель смены и преподаватели. Данные из team.ts, портреты крупные:
 * лица работают лучше должностей.
 */
import { members } from '../../data/team';

const shown = members.slice(0, 4);
---

<section class="r-section r-section--paper2" id="team">
  <div class="r-wrap">
    <div class="r-head">
      <p class="r-kicker">Кто рядом со сменой</p>
      <div class="r-head__body">
        <h2 class="r-h2">Команда, которую <span class="r-em">видно по именам</span></h2>
        <p class="r-lead r-text">
          Вожатые работают в парах, преподаватель ведёт группу до восьми человек.
          В родительском чате отвечает руководитель смены, а не общий номер поддержки.
        </p>
      </div>
    </div>

    <div class="r-team__grid">
      {shown.map(m => (
        <article class="r-team__card">
          <figure class="r-figure r-team__photo">
            <img src={m.photo} alt={m.alt} loading="lazy" decoding="async" width="480" height="600" class="r-photo" />
          </figure>
          <p class="r-team__name">{m.name}</p>
          <p class="r-team__role">{m.role}</p>
          <p class="r-team__bio">{m.bio}</p>
        </article>
      ))}
    </div>

    <div class="r-team__more">
      <a href="/o-lagere/" class="r-btn r-btn--ghost">Вся команда смены</a>
    </div>
  </div>
</section>

<style>
  .r-team__grid { display: grid; gap: clamp(28px, 3vw, 36px); }
  .r-team__card { display: flex; flex-direction: column; }
  .r-team__photo { aspect-ratio: 4 / 5; margin-bottom: 16px; }
  .r-team__photo img { object-position: center 20%; }
  .r-team__name {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    color: var(--r-ink);
    margin: 0 0 2px;
  }
  .r-team__role {
    font-size: 13px;
    color: var(--r-accent-ink);
    margin: 0 0 10px;
    line-height: 1.35;
  }
  .r-team__bio { font-size: 15px; line-height: 1.55; margin: 0; color: var(--r-body); }

  .r-team__more { margin-top: clamp(28px, 3vw, 40px); }

  @media (min-width: 640px) { .r-team__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .r-team__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
