---
---

<!-- ShiftBookModal: bottom-sheet on mobile, centered on desktop -->
<dialog id="shiftBookModal" class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/50 p-0 backdrop:bg-black/50">
  <div class="flex h-full w-full flex-col items-center justify-end sm:justify-center sm:px-4 sm:py-8">
    <div class="relative w-full max-w-[420px] overflow-y-auto rounded-t-[24px] bg-white px-5 pb-6 pt-4 shadow-[0_-8px_40px_rgba(15,23,42,0.20)] sm:rounded-[20px] sm:shadow-[0_20px_50px_rgba(15,23,42,0.25)]"
         style="max-height:92dvh;">
      <!-- Drag handle -->
      <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>

      <button type="button" data-shift-book-close aria-label="Закрыть"
              class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-500 outline-none focus:outline-none focus:ring-0 focus-visible:outline-none">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <!-- Shift info — скрыт когда нет данных о смене -->
      <div class="hidden rounded-[14px] bg-slate-50 p-3" data-book-shift-block>
        <p class="pr-8 text-[16px] font-semibold text-slate-900" data-book-shift-name></p>
        <p class="mt-0.5 text-[14px] text-slate-500" data-book-shift-dates-row><span data-book-shift-dates></span><span class="mx-1 text-slate-400">·</span><span data-book-shift-duration></span></p>
        <p class="mt-1 text-[20px] font-bold text-slate-900" data-book-shift-price></p>
      </div>

      <!-- Age -->
      <p class="mt-4 text-[13px] font-semibold uppercase tracking-[0.08em] text-slate-500">Возраст ребёнка</p>
      <div class="mt-2 flex gap-2" data-book-age-group>
        <button type="button" data-book-age="7-10"
                class="flex-1 min-h-[48px] rounded-xl border border-slate-200 py-3 text-[15px] font-medium text-slate-700 transition">7–10 лет</button>
        <button type="button" data-book-age="10-12"
                class="flex-1 min-h-[48px] rounded-xl bg-primary py-3 text-[15px] font-semibold text-[#1e2430] transition">10–12 лет</button>
        <button type="button" data-book-age="13-15"
                class="flex-1 min-h-[48px] rounded-xl border border-slate-200 py-3 text-[15px] font-medium text-slate-700 transition">13–15 лет</button>
      </div>

      <!-- Phone -->
      <p class="mt-4 text-[13px] font-semibold uppercase tracking-[0.08em] text-slate-500">Ваш телефон</p>
      <input
        type="tel"
        data-book-phone
        placeholder="+7 (___) ___-__-__"
        inputmode="tel"
        autocomplete="tel"
        class="mt-2 h-[52px] w-full rounded-xl border border-slate-200 bg-white px-4 text-[16px] text-slate-700 placeholder:text-slate-400 outline-none focus:border-primary focus:ring-1 focus:ring-primary"
      />

      <!-- Consent: два чекбокса по требованиям 152-ФЗ / РКН -->
      <label class="mt-3 flex cursor-pointer items-start gap-3">
        <input type="checkbox" data-book-consent-policy class="mt-[3px] h-5 w-5 shrink-0 rounded border-slate-300 accent-primary" />
        <span class="text-[15px] leading-[1.45] text-slate-600">Ознакомлен(а) с <a href="/privacy-policy/" class="text-primary underline">Политикой обработки персональных данных</a></span>
      </label>
      <label class="mt-2 flex cursor-pointer items-start gap-3">
        <input type="checkbox" data-book-consent class="mt-[3px] h-5 w-5 shrink-0 rounded border-slate-300 accent-primary" />
        <span class="text-[15px] leading-[1.45] text-slate-600">Согласен(а) на <a href="/soglasie-na-obrabotku-personalnyh-dannyh/" class="text-primary underline">обработку персональных данных</a></span>
      </label>

      <!-- Submit -->
      <button
        type="button"
        data-book-submit
        disabled
        class="mt-4 h-[52px] w-full rounded-xl bg-primary text-[16px] font-semibold text-[#1e2430] transition-all duration-200 hover:shadow-[0_4px_16px_rgba(249,115,22,0.35)] hover:-translate-y-[1px] active:translate-y-0 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none disabled:translate-y-0"
      >
        Отправить заявку
      </button>

      <p class="mt-2 text-center text-[13px] text-slate-400">Без предоплаты · Перезвоним за 10 минут</p>
      <p data-book-error class="mt-2 hidden text-center text-[14px] text-red-500"></p>
    </div>
  </div>
</dialog>
