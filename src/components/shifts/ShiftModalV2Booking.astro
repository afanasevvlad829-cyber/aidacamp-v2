---
/**
 * V2 Booking Style Modal — горизонтальный билет с табами + правая колонка price/CTA. A/B-тест.
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
}
const { shift } = Astro.props;
const occupied = shift.occupied || 23;
const free = shift.free || 12;
const total = occupied + free;
const occupiedPct = Math.round((occupied / total) * 100);

function makeMonthCalendar(year: number, month: number, startDate: string, endDate: string) {
  const start = new Date(startDate); const end = new Date(endDate);
  const lastDay = new Date(year, month, 0).getDate();
  const startWeekday = (new Date(year, month - 1, 1).getDay() + 6) % 7;
  const days: Array<{ day: number | null; inShift: boolean }> = [];
  for (let i = 0; i < startWeekday; i++) days.push({ day: null, inShift: false });
  for (let d = 1; d <= lastDay; d++) {
    const date = new Date(year, month - 1, d);
    days.push({ day: d, inShift: date >= start && date <= end });
  }
  return days;
}
const may = makeMonthCalendar(2026, 5, shift.startDate, shift.endDate);
const jun = makeMonthCalendar(2026, 6, shift.startDate, shift.endDate);
---

<dialog id={`shiftModalV2-${shift.id}`} class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/50 p-2 backdrop:bg-black/50 md:p-4">
  <div class="relative mx-auto mt-[2vh] max-h-[96vh] w-full max-w-[760px] overflow-y-auto rounded-[16px] bg-white shadow-[0_20px_50px_rgba(15,23,42,0.25)] md:mt-[6vh]">
    <!-- Header горизонтальный -->
    <div class="flex items-center justify-between p-4 pb-2">
      <div class="flex items-baseline gap-3">
        <h3 class="text-[18px] font-bold text-slate-900">{shift.name}</h3>
        <p class="text-[13px] text-slate-500">{shift.dates}</p>
      </div>
      <button type="button" data-close aria-label="Закрыть" class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 transition-colors">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Tabs -->
    <div class="px-4">
      <div class="flex gap-2 rounded-[10px] bg-slate-100 p-1" role="tablist">
        <button type="button" data-tab="desc" class="flex-1 rounded-[7px] bg-[#ec7c00] px-3 py-1.5 text-[13px] font-semibold text-white">Описание</button>
        <button type="button" data-tab="cal" class="flex-1 rounded-[7px] px-3 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-white">Календарь</button>
        <button type="button" data-tab="more" class="flex-1 rounded-[7px] px-3 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-white">Подробнее</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_220px] gap-0">
      <!-- Левая часть — контент таба -->
      <div class="px-4 py-4">
        <!-- Описание -->
        <div data-pane="desc" class="space-y-3">
          <div class="space-y-2 text-[13px] text-slate-700">
            <p class="flex items-center gap-2"><i class="bi bi-clock text-slate-400"></i>{shift.duration}</p>
            <p class="flex items-center gap-2"><i class="bi bi-calendar-event text-slate-400"></i>{shift.dates}</p>
          </div>
          <p class="text-[13px] leading-[1.55] text-slate-600 pt-1">{shift.description}</p>
          <p class="flex items-center gap-2 text-[13px] text-slate-700 border-t border-slate-100 pt-3">
            <i class="bi bi-people-fill text-slate-500"></i>
            Уже едет {occupied} ребят 10–12 лет
          </p>
        </div>

        <!-- Календарь — компактнее -->
        <div data-pane="cal" class="hidden">
          <p class="text-center text-[13px] font-semibold text-slate-700 mb-1.5">Май 2026</p>
          <div class="grid grid-cols-7 gap-0.5 text-center text-[10px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-0.5">
            {may.map(d => (
              <div class={`h-7 flex items-center justify-center text-[12px] rounded-[5px] ${d.inShift ? 'bg-[#ec7c00] text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
          <p class="text-center text-[13px] font-semibold text-slate-700 mt-3 mb-1.5">Июнь 2026</p>
          <div class="grid grid-cols-7 gap-0.5 text-center text-[10px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-0.5">
            {jun.map(d => (
              <div class={`h-7 flex items-center justify-center text-[12px] rounded-[5px] ${d.inShift ? 'bg-[#ec7c00] text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
          <p class="text-center mt-3 text-[11px] text-slate-500 inline-flex items-center justify-center gap-1.5 w-full">
            <span class="h-2.5 w-2.5 rounded-[2px] bg-[#ec7c00]"></span>Дни смены
          </p>
        </div>

        <!-- Подробнее -->
        <div data-pane="more" class="hidden space-y-2 text-[13px] leading-[1.55] text-slate-700">
          <p class="font-semibold text-slate-900">Первые дни — включение в процесс</p>
          <p>Знакомство, деление на группы по возрасту и уровню. Сразу практика: сцена, персонаж, движение и простые действия. Даже без опыта — первый результат.</p>
          <p class="font-semibold text-slate-900 pt-1">Далее — работа над своим проектом</p>
          <p>Выбор идеи и пошаговая реализация. Например:</p>
          <ul class="space-y-0.5 pl-1">
            <li class="flex gap-1.5"><span class="text-[#ec7c00]">•</span>игра, где персонаж убегает от препятствий и набирает очки</li>
            <li class="flex gap-1.5"><span class="text-[#ec7c00]">•</span>игра с уровнями и усложнением</li>
          </ul>
        </div>
      </div>

      <!-- Правая колонка — занятость + price + CTA -->
      <div class="border-t md:border-t-0 md:border-l border-slate-100 bg-slate-50 p-4 flex flex-col">
        <div>
          <div class="flex justify-between text-[11px] text-slate-500 mb-1">
            <span>Занято {occupied}</span>
            <span class="text-emerald-700 font-medium">Свободно {free}</span>
          </div>
          <div class="h-1.5 rounded-full bg-emerald-100 overflow-hidden">
            <div class="h-full bg-emerald-500" style={`width: ${occupiedPct}%`}></div>
          </div>
        </div>
        <div class="mt-4">
          <div class="text-[20px] font-bold text-slate-900">{shift.price}</div>
          <p class="mt-1 text-[11px] text-slate-500 leading-[1.4]">Питание, проживание, программа включены</p>
        </div>
        <button type="button" data-shift-link={shift.id} class="mt-auto pt-4 rounded-[8px] bg-[#ec7c00] px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-[#d67000] transition-colors">
          Выбрать смену
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function(){
      const dlg = document.currentScript.parentElement;
      dlg.addEventListener('click', e => {
        const t = e.target;
        if (t.matches('[data-close]') || t === dlg) dlg.close();
        const tab = t.closest('[data-tab]');
        if (tab) {
          dlg.querySelectorAll('[data-tab]').forEach(b => { b.classList.remove('bg-[#ec7c00]','text-white','font-semibold'); b.classList.add('text-slate-600','font-medium'); });
          tab.classList.remove('text-slate-600','font-medium');
          tab.classList.add('bg-[#ec7c00]','text-white','font-semibold');
          dlg.querySelectorAll('[data-pane]').forEach(p => p.classList.add('hidden'));
          dlg.querySelector('[data-pane="' + tab.dataset.tab + '"]').classList.remove('hidden');
        }
      });
    })();
  </script>
</dialog>
