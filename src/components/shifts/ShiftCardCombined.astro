---
/**
 * ShiftCardCombined — карточка которая объединяет 2 смены под одним заголовком.
 * Используется для Августа (Смена 3 + Смена 4) — концепт shift-story_2.html
 *
 * Layout: верхняя часть как обычная ShiftCard, в середине — две progress-полоски
 * с подписями. Цена «От {min}». CTA primary (orange) если хоть одна low-avail.
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shifts: [Shift, Shift];
  variant: 'mobile' | 'desktop';
  monthLabel: string; // например «Август»
  combinedDates: string; // например «3 авг — 26 авг»
  combinedDuration: string; // например «Смены 3 и 4»
}

const { shifts, variant, monthLabel, combinedDates, combinedDuration } = Astro.props;
const isMobile = variant === 'mobile';

// Min price среди двух смен для лейбла «От X»
const prices = shifts.map((s) => parseInt(s.price.replace(/\D/g, ''))).filter((n) => n > 0);
const minPrice = Math.min(...prices);
const minPriceFmt = minPrice.toLocaleString('ru-RU') + ' ₽';

// Total places
const totalFree = shifts.reduce((sum, s) => sum + s.free, 0);
// Low avail если хоть одна ≥85%
const isAnyLow = shifts.some((s) => {
  const t = s.occupied + s.free || 1;
  return Math.round((s.occupied / t) * 100) >= 85;
});

// Status pill
const statusPill = !isAnyLow && totalFree >= 10
  ? { text: `${totalFree} мест`, cls: 'bg-emerald-100 text-emerald-700' }
  : isAnyLow
    ? { text: 'мест мало', cls: 'bg-[var(--color-primary-100)] text-[var(--color-primary-700)]' }
    : null;

const sizeCls = isMobile
  ? 'min-w-[calc(100vw-48px)] max-w-[calc(100vw-48px)] shrink-0 snap-start'
  : '';
---

<article
  data-shift-card
  class:list={[
    'reveal group relative flex flex-col rounded-[22px] border border-border-light bg-card cursor-pointer select-none transition-none',
    'card-shadow',
    'card-shadow-hover',
    'p-5 md:p-6',
    sizeCls,
  ]}
>
  <!-- TOP: eyebrow + big dates + sub / right pill -->
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">{monthLabel}</p>
      <h3 class="mt-1.5 text-[26px] md:text-[28px] font-extrabold tracking-[-0.02em] leading-[1.05] text-body">{combinedDates}</h3>
      <p class="mt-1.5 text-[14px] md:text-[13px] text-body-muted">{combinedDuration}</p>
    </div>
    {statusPill && (
      <span class:list={[
        'shrink-0 inline-flex items-center rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.06em]',
        statusPill.cls,
      ]}>{statusPill.text}</span>
    )}
  </div>

  <!-- TWO shift rows: каждая со своим hover-эффектом, разделены полоской и помечены индексом -->
  <div class="mt-5 divide-y divide-border-light">
    {shifts.map((s, idx) => {
      const total = s.occupied + s.free || 1;
      const pct = Math.round((s.occupied / total) * 100);
      const isLow = pct >= 85;
      const freeColor = isLow ? 'text-primary' : 'text-emerald-700';
      const barColor = isLow ? 'bg-primary' : 'bg-emerald-400';
      // Индексный бейдж: разный акцентный цвет, чтобы строки визуально отличались
      const idxBadge = idx === 0
        ? 'bg-blue-100 text-blue-700'
        : 'bg-purple-100 text-purple-700';
      return (
        <a
          href={`/shifts/${s.id}/`}
          data-analytics-goal="combined_shift_click"
          data-analytics-label={s.name}
          class="block no-underline group/row relative -mx-2 px-2 py-3 first:pt-0 first:-mt-1 last:pb-1 rounded-lg transition-colors duration-200 hover:bg-primary/5"
        >
          <div class="flex items-center justify-between gap-2 text-[13px] mb-1.5">
            <span class="flex items-center gap-2 min-w-0">
              <span class={`shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em] ${idxBadge}`}>
                №{idx === 0 ? 3 : 4}
              </span>
              <span class="text-body group-hover/row:text-primary transition-colors font-medium truncate">
                {s.dates} <span class="text-body-faint font-normal">· {s.duration}</span>
              </span>
            </span>
            <span class={`font-semibold whitespace-nowrap ${freeColor}`}>
              <span data-count-to={s.free}>{s.free}</span> мест
            </span>
          </div>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-border-light">
            <div data-shift-bar class={`h-full rounded-full ${barColor}`} style={`--bar-pct:${pct}%`}></div>
          </div>
        </a>
      );
    })}
  </div>

  <!-- PRICE + CTA -->
  <div class="mt-5 flex items-end justify-between gap-3">
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">От</p>
      <p class="mt-1 text-[26px] md:text-[28px] font-extrabold tracking-[-0.02em] leading-none text-primary">{minPriceFmt}</p>
      <p class="mt-1 text-[12px] text-body-faint">всё включено</p>
    </div>

    <!-- Default CTA: ghost → ведёт на первую из объединённых смен -->
    <a
      href={`/shifts/${shifts[0].id}/`}
      data-analytics-goal="shift_info_click"
      data-analytics-label={`${shifts[0].name}+${shifts[1].name}`}
      class="group/cta shrink-0 inline-flex items-center gap-1.5 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 px-4 py-3 text-[13px] font-semibold text-body-muted hover:text-primary transition-colors min-h-[44px] no-underline"
    >
      Что внутри?
      <i class="bi bi-arrow-right text-[12px] transition-transform group-hover/cta:translate-x-1" aria-hidden="true"></i>
    </a>
  </div>
</article>
