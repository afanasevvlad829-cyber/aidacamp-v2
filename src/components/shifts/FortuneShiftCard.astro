---
import { getCurrentPrice } from '../../data/dynamicPrices';
import { mainShifts } from '../../data/shifts';

interface Props {
  shiftId?: string;
}
const { shiftId = 'shift-1' } = Astro.props;

const shift = mainShifts.find((s) => s.id === shiftId) ?? mainShifts[0];
const SHIFT_ID = shift.id;

const today = new Date();
const currentPrice = getCurrentPrice(SHIFT_ID, today) ?? parseInt(shift.price.replace(/\D/g, ''), 10);
const fortuneMode = process.env.FORTUNE_MODE ?? 'payment'; // 'payment' | 'lead'

// Days until shift starts
const startDate = new Date(shift.startDate + 'T00:00:00');
const daysLeft = Math.max(0, Math.ceil((startDate.getTime() - today.getTime()) / 86_400_000));
const daysLeftLabel = daysLeft === 0 ? 'сегодня' : daysLeft === 1 ? 'через 1 день' : `через ${daysLeft} дн`;

// Заезд = startDate + 2 дня (запас на справки)
const arriveDate = new Date(startDate.getTime() + 2 * 86_400_000);
const monthsGenitive = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const startDayLabel  = `${startDate.getDate()} ${monthsGenitive[startDate.getMonth()]}`;
const arriveDayLabel = `${arriveDate.getDate()} ${monthsGenitive[arriveDate.getMonth()]}`;

// SVG wheel segments (shared server+client via define:vars)
// Все секторы с реальными скидками 10–70%, 0% убраны
interface Seg { label: string; d: number; w: number; color: string }
const SEGMENTS: Seg[] = [
  { label: '10%', d: 10, w: 30, color: '#fdba74' },
  { label: '20%', d: 20, w: 25, color: '#fb923c' },
  { label: '30%', d: 30, w: 20, color: '#f97316' },
  { label: '40%', d: 40, w: 14, color: '#ea580c' },
  { label: '50%', d: 50, w: 8,  color: '#c2410c' },
  { label: '70%', d: 70, w: 3,  color: '#7c2d12' },
];

// Pre-compute SVG paths server-side
const R = 108, CX = 120, CY = 120;
function toRad(deg: number) { return deg * Math.PI / 180; }
const SEG_DEG = 60; // 6 segments × 60° each
const segData = SEGMENTS.map((seg, i) => {
  const a1 = toRad(i * SEG_DEG - 90);
  const a2 = toRad((i + 1) * SEG_DEG - 90);
  const x1 = (CX + R * Math.cos(a1)).toFixed(1);
  const y1 = (CY + R * Math.sin(a1)).toFixed(1);
  const x2 = (CX + R * Math.cos(a2)).toFixed(1);
  const y2 = (CY + R * Math.sin(a2)).toFixed(1);
  const path = `M ${CX} ${CY} L ${x1} ${y1} A ${R} ${R} 0 0 1 ${x2} ${y2} Z`;
  const ta = toRad((i + 0.5) * SEG_DEG - 90);
  const tr = R * 0.62;
  const tx = (CX + tr * Math.cos(ta)).toFixed(1);
  const ty = (CY + tr * Math.sin(ta)).toFixed(1);
  // Rotate text along sector radius, readable from outside
  const ta_deg = (i + 0.5) * SEG_DEG - 90;
  const textAngle = (ta_deg > 90 ? ta_deg - 180 : ta_deg).toFixed(1);
  return { ...seg, path, tx, ty, textAngle };
});
---

<!-- ── Card ── -->
<article
  data-fortune-card
  data-shift-id={SHIFT_ID}
  class="relative flex flex-col rounded-[22px] border border-transparent bg-card card-shadow ring-2 ring-primary shadow-[0_0_0_4px_rgba(236,124,0,0.12)] p-5"
>

  <!-- Orange header banner -->
  <div class="-mx-5 -mt-5 mb-4 flex items-center gap-2 rounded-t-[20px] bg-primary px-5 py-3">
    <span class="text-[16px] font-extrabold text-white leading-none">{shift.name} · {shift.dates}</span>
    <span class="ml-auto flex items-center gap-1.5 whitespace-nowrap text-[12px] font-semibold text-white/80">
      <i class="bi bi-clock text-[11px]" aria-hidden="true"></i>
      {daysLeftLabel}
    </span>
  </div>

  <!-- Tags row: duration + spots + price -->
  <div class="flex items-center gap-1.5 mb-4 flex-wrap">
    <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-1 text-[12px] font-semibold text-orange-700">
      <i class="bi bi-calendar-event text-[10px]" aria-hidden="true"></i>
      {shift.duration}
    </span>
    <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-1 text-[12px] font-bold text-red-700">
      <i class="bi bi-fire text-[10px]" aria-hidden="true"></i>
      Последние 3 места
    </span>
    <span class="ml-auto text-right">
      <span class="block text-[10px] font-semibold uppercase tracking-[0.12em] text-body-faint">Стоимость</span>
      <span class="block text-[20px] font-extrabold text-primary leading-none" data-dynamic-price={SHIFT_ID}>{currentPrice.toLocaleString('ru-RU')} ₽</span>
    </span>
  </div>

  <!-- Wheel area: tagline + SVG + dots + spin btn (скрывается после 3 спинов) -->
  <div id="fsc-wheel-area">
  <!-- Wheel tagline -->
  <p class="text-center text-[13px] font-semibold text-body-muted mb-2">
    <i class="bi bi-trophy-fill text-orange-400 text-[12px] mr-1" aria-hidden="true"></i>
    Крутите колесо — разыгрываем скидку до 70%
  </p>

  <!-- SVG Fortune Wheel -->
  <div class="flex justify-center mb-3 relative">
    <!-- Pointer triangle at top -->
    <div
      class="absolute z-10 pointer-events-none"
      style="top:-4px; left:50%; transform:translateX(-50%)"
      aria-hidden="true"
    >
      <svg width="20" height="14" viewBox="0 0 20 14">
        <polygon points="10,14 0,0 20,0" fill="#1e293b"/>
      </svg>
    </div>

    <div class="w-[220px] max-w-full relative" style="aspect-ratio:1">
      <svg
        id="fsc-wheel"
        viewBox="0 0 240 240"
        style="width:100%;height:100%;transform-origin:50% 50%"
      >
        {segData.map((seg, i) => (
          <g>
            <path d={seg.path} fill={seg.color} stroke="white" stroke-width="1.5"/>
            <text
              x={seg.tx}
              y={seg.ty}
              transform={`rotate(${seg.textAngle}, ${seg.tx}, ${seg.ty})`}
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="17"
              font-weight="900"
              fill="white"
              font-family="system-ui,sans-serif"
              paint-order="stroke"
              stroke="rgba(0,0,0,0.55)"
              stroke-width="5"
              stroke-linejoin="round"
            >{seg.label}</text>
          </g>
        ))}
        <!-- Center hub -->
        <circle cx={CX} cy={CY} r="24" fill="white" stroke="#fed7aa" stroke-width="2.5"/>
        <circle cx={CX} cy={CY} r="18" fill="#fff7ed"/>
        <text
          x={CX} y={CY - 3}
          text-anchor="middle" dominant-baseline="middle"
          font-size="7" font-weight="800" fill="#ea580c"
          style="font-family:system-ui,sans-serif;letter-spacing:0.05em"
        >УДАЧА</text>
        <text
          x={CX} y={CY + 7}
          text-anchor="middle" dominant-baseline="middle"
          font-size="13" fill="#ea580c"
          style="font-family:system-ui,sans-serif"
        >★</text>
      </svg>
    </div>
  </div>

  <!-- Attempts dots + spin button -->
  <div class="flex flex-col items-center gap-2.5 mb-4">
    <div id="fsc-attempts" class="flex items-center gap-1.5" aria-label="Оставшиеся попытки">
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="0" style="background:var(--color-primary,#f97316)"></span>
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="1" style="background:var(--color-primary,#f97316)"></span>
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="2" style="background:var(--color-primary,#f97316)"></span>
    </div>
    <button
      id="fsc-spin-btn"
      type="button"
      class="flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-[14px] px-10 py-3 min-h-[44px] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <i id="fsc-spin-icon" class="bi bi-arrow-repeat text-[16px]" aria-hidden="true"></i>
      <span id="fsc-spin-label">Крутить!</span>
    </button>
  </div>

  </div><!-- /fsc-wheel-area -->

  <!-- Fallback: стандартная карточка после 3 спинов без бронирования -->
  <div id="fsc-fallback" class="hidden flex-col gap-3 mb-4">
    <!-- Occupancy bar -->
    <div>
      <div class="flex justify-between text-[13px] mb-1.5">
        <span class="text-body-muted">Занято</span>
        <span class="font-bold text-primary">Осталось 3 места</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-border-light">
        <div class="h-full rounded-full bg-primary" style="width:91%"></div>
      </div>
    </div>
    <!-- Price + CTA -->
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">Стоимость</p>
        <p class="mt-1 text-[26px] font-extrabold tracking-[-0.02em] leading-none text-primary" data-dynamic-price={SHIFT_ID}>{currentPrice.toLocaleString('ru-RU')} ₽</p>
        <p class="mt-1 text-[12px] text-body-faint">всё включено</p>
      </div>
      <a
        href={`/shifts//`}
        class="shrink-0 inline-flex items-center gap-1.5 rounded-xl px-5 py-3 text-[14px] font-semibold transition-colors min-h-[44px] no-underline bg-primary hover:bg-primary-hover text-white"
      >
        Выбрать
        <i class="bi bi-arrow-right text-[13px]" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <!-- Win result block (hidden until first spin resolves) -->
  <div id="fsc-win-block" class="hidden flex-col items-center gap-2.5 mb-4">
    <div class="w-full rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-green-600 mb-0.5">Ваша скидка</p>
      <p class="text-[34px] font-extrabold text-green-700 leading-none" id="fsc-disc-pct">—</p>
      <p class="text-[13px] text-green-600 mt-1.5 space-x-2">
        <span>Итого: <strong id="fsc-final-price">—</strong></span>
        <span class="text-green-400">·</span>
        <span>Предоплата: <strong id="fsc-dep-price">—</strong></span>
      </p>
    </div>
    <button
      id="fsc-book-btn"
      type="button"
      class="w-full flex items-center justify-center gap-2 rounded-xl bg-green-600 hover:bg-green-700 text-white font-bold text-[15px] py-3.5 min-h-[48px] transition-colors"
    >
      <i class="bi bi-calendar-check text-[16px]" aria-hidden="true"></i>
      Забронировать место
    </button>
  </div>

  <!-- Bottom conditions -->
  <div class="mt-auto border-t border-border-light pt-3 space-y-0.5 text-[11px] text-body-faint">
    <p>
      <i class="bi bi-shield-check text-[10px] mr-1" aria-hidden="true"></i>
      Предоплата 50% · оставшиеся 50% до конца дня оплаты
    </p>
    <p>
      <i class="bi bi-calendar-event text-[10px] mr-1" aria-hidden="true"></i>
      Заехать можно до {arriveDayLabel} · успейте собрать справки
    </p>
    <p class="pt-1">
      <i class="bi bi-telegram text-[10px] mr-1" aria-hidden="true"></i>
      Что-то пошло не так? Сделайте скриншот и
      <a href="https://t.me/Progaschool" target="_blank" rel="noopener"
         class="underline underline-offset-2 hover:text-primary transition-colors">напишите нам в Telegram</a>
    </p>
  </div>
</article>

<!-- ── Booking Modal (fixed overlay, position:fixed → not clipped by carousel) ── -->
<div
  id="fsc-modal"
  class="fixed inset-0 z-[100] hidden overflow-y-auto"
  style="background:rgba(0,0,0,0.55);backdrop-filter:blur(4px)"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fsc-modal-title"
>
  <div class="flex min-h-full items-center justify-center p-4 sm:py-8">
  <div class="relative w-full max-w-sm max-h-[92dvh] overflow-y-auto flex flex-col bg-white rounded-2xl shadow-2xl">

    <!-- Modal header: green -->
    <div class="bg-green-600 px-6 py-4 rounded-t-2xl">
      <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-green-100 mb-0.5">Место забронировано</p>
      <h2 id="fsc-modal-title" class="text-[22px] font-extrabold text-white leading-none">
        Скидка <span id="fsc-modal-disc">—</span> зафиксирована
      </h2>
    </div>

    <!-- Countdown -->
    <div class="flex items-center gap-3 bg-orange-50 border-b border-orange-100 px-6 py-3">
      <i class="bi bi-clock text-orange-500 text-[20px] shrink-0" aria-hidden="true"></i>
      <div>
        <p class="text-[12px] font-semibold text-orange-600">Место удерживается</p>
        <p id="fsc-timer" class="text-[24px] font-extrabold text-orange-700 leading-none tabular-nums">30:00</p>
      </div>
    </div>

    <!-- Payment summary -->
    <div class="px-6 py-3 border-b border-gray-100 space-y-1.5">
      <div class="flex justify-between text-[14px]">
        <span class="text-gray-500">Цена со скидкой</span>
        <span id="fsc-modal-final" class="font-bold text-gray-800">—</span>
      </div>
      <div class="flex justify-between">
        <span class="text-[14px] text-gray-500">Предоплата сейчас (50%)</span>
        <span id="fsc-modal-dep" class="text-[18px] font-extrabold text-primary leading-none">—</span>
      </div>
    </div>

    <!-- Form -->
    <div id="fsc-form-wrap" class="px-6 py-4 space-y-3">
      <div>
        <label for="fsc-name" class="block text-[13px] font-semibold text-gray-700 mb-1.5">Ваши ФИО *</label>
        <input
          id="fsc-name"
          type="text"
          placeholder="Иванов Иван Иванович"
          required
          autocomplete="name"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-[15px] outline-none focus:border-primary focus:ring-2 focus:ring-orange-100 transition"
        />
      </div>
      <div>
        <label for="fsc-phone" class="block text-[13px] font-semibold text-gray-700 mb-1.5">Ваш телефон *</label>
        <input
          id="fsc-phone"
          type="tel"
          placeholder="+7 (999) 000-00-00"
          required
          autocomplete="tel"
          inputmode="tel"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-[15px] outline-none focus:border-primary focus:ring-2 focus:ring-orange-100 transition"
        />
      </div>
      <!-- Согласие на обработку персональных данных -->
      <div class="flex items-start gap-2.5 pt-1">
        <input
          id="fsc-consent"
          type="checkbox"
          class="mt-0.5 h-4 w-4 shrink-0 accent-primary cursor-pointer"
        />
        <label for="fsc-consent" class="text-[12px] text-gray-500 leading-[1.4] cursor-pointer select-none">
          Я согласен(а) на <a href="/privacy/" target="_blank" rel="noopener" class="underline hover:text-primary transition-colors">обработку персональных данных</a>
        </label>
      </div>
      <p id="fsc-form-error" class="hidden text-[12px] text-red-600 font-medium"></p>
    </div>

    <!-- Pay button -->
    <div class="px-6 pb-4">
      <button
        id="fsc-pay-btn"
        type="button"
        class="w-full flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-[15px] py-3.5 min-h-[52px] transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <i id="fsc-pay-icon" class="bi bi-send text-[16px]" aria-hidden="true"></i>
        <span id="fsc-pay-label">Отправить заявку</span>
        <span id="fsc-pay-disc" class="ml-1 rounded-full bg-white/20 px-2 py-0.5 text-[13px] font-extrabold hidden">−<span id="fsc-pay-disc-val">0</span>%</span>
      </button>
    </div>

    <!-- What happens next (ниже кнопки) -->
    <div class="px-6 pb-4 border-t border-gray-100 pt-4 space-y-1.5 text-[12px] text-gray-500">
      <p class="font-semibold text-gray-700 text-[13px] mb-2">Что будет после оплаты:</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">1.</span> В течение 30 минут с вами свяжется представитель</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">2.</span> Договор подготовим до конца рабочего дня</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">3.</span> Окончательная оплата — до конца дня заезда ({startDayLabel})</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">4.</span> Заехать можно до {arriveDayLabel} — время собрать справки</p>
      <p class="text-gray-400 pt-1">Трансфер оплачивается отдельно.</p>
    </div>

    <!-- Fine print + Telegram fallback + close -->
    <div class="px-6 pb-6 text-center space-y-2 border-t border-gray-100 pt-3">
      <p class="text-[11px] text-gray-400">
        Что-то пошло не так?&nbsp;
        <a
          href="https://t.me/Progaschool"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 text-primary hover:underline font-medium"
          data-analytics-goal="fortune_tg_fallback"
        >
          <i class="bi bi-telegram text-[12px]" aria-hidden="true"></i>
          Напишите нам в Telegram
        </a>
        — решим вручную.
      </p>
      <button
        id="fsc-modal-close"
        type="button"
        class="text-[13px] text-gray-400 hover:text-gray-600 underline underline-offset-2 transition"
      >
        Закрыть
      </button>
    </div>

  </div>
  </div><!-- /flex wrapper -->
</div>

<script define:vars={{ SEGMENTS, currentPrice, fortuneMode, SHIFT_ID }}>
  (function () {
    var PRICE = currentPrice;
    var segs  = SEGMENTS;
    var isSpinning  = false;
    var currentRot  = 0;
    var timerInterval = null;

    // ── Cookie helpers ─────────────────────────────────────────────────────
    var COOKIE_KEY = 'fortune_' + SHIFT_ID + '_played';
    function getCookie(name) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    }
    function setCookie(name, value, days) {
      var exp = new Date(Date.now() + days * 864e5).toUTCString();
      document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + exp + '; path=/; SameSite=Lax';
    }

    // Restore state from sessionStorage so page refresh doesn't reset spins
    var SS_KEY = 'fortune_' + SHIFT_ID + '_2026';
    var saved = (function() {
      try { return JSON.parse(sessionStorage.getItem(SS_KEY) || 'null'); } catch(_) { return null; }
    })();
    var attempts    = saved ? saved.attempts    : 3;
    var wonDiscount = saved ? saved.wonDiscount : 0;
    var wonToken    = saved ? saved.wonToken    : '';

    function saveState() {
      try { sessionStorage.setItem(SS_KEY, JSON.stringify({ attempts: attempts, wonDiscount: wonDiscount, wonToken: wonToken })); } catch(_) {}
    }

    var wheel      = document.getElementById('fsc-wheel');
    var spinBtn    = document.getElementById('fsc-spin-btn');
    var spinLabel  = document.getElementById('fsc-spin-label');
    var attemptsEl = document.getElementById('fsc-attempts');
    var winBlock   = document.getElementById('fsc-win-block');
    var fallback   = document.getElementById('fsc-fallback');
    var wheelArea  = document.getElementById('fsc-wheel-area');
    var discPctEl  = document.getElementById('fsc-disc-pct');
    var finalPriceEl = document.getElementById('fsc-final-price');
    var depPriceEl   = document.getElementById('fsc-dep-price');
    var bookBtn    = document.getElementById('fsc-book-btn');
    var modal      = document.getElementById('fsc-modal');
    var modalDisc  = document.getElementById('fsc-modal-disc');
    var modalFinal = document.getElementById('fsc-modal-final');
    var modalDep   = document.getElementById('fsc-modal-dep');
    var timerEl    = document.getElementById('fsc-timer');
    var nameInput   = document.getElementById('fsc-name');
    var phoneInput  = document.getElementById('fsc-phone');
    var consentBox  = document.getElementById('fsc-consent');
    var formError   = document.getElementById('fsc-form-error');
    var payBtn      = document.getElementById('fsc-pay-btn');
    var payLabel   = document.getElementById('fsc-pay-label');
    var modalClose = document.getElementById('fsc-modal-close');

    if (!wheel || !spinBtn || !modal) return; // guard

    // Портал: выносим модалку в <body>, чтобы position:fixed считался от вьюпорта,
    // а не от трансформируемого/скроллящегося предка (карусель) — иначе панель
    // прижимается влево и обрезается сверху на десктопе.
    if (modal.parentElement !== document.body) document.body.appendChild(modal);

    // ── Lead-режим: обновляем блок «что будет» ─────────────────────────────
    if (fortuneMode === 'lead') {
      var nextSteps = payBtn && payBtn.closest('[class*="pb-4"]') && payBtn.parentElement && payBtn.parentElement.nextElementSibling;
      // Обновляем блок «что будет после»
      var stepsBlock = document.querySelector('.px-6.pb-4.border-t.border-gray-100.pt-4');
      if (stepsBlock) stepsBlock.innerHTML = [
        '<p class="font-semibold text-gray-700 text-[13px] mb-2">Что будет дальше:</p>',
        '<p><span class="inline-block w-4 text-orange-500 font-bold">1.</span> Менеджер позвонит вам до конца дня</p>',
        '<p><span class="inline-block w-4 text-orange-500 font-bold">2.</span> Возьмёт данные для договора</p>',
        '<p><span class="inline-block w-4 text-orange-500 font-bold">3.</span> Выставит счёт — оплатить нужно до конца дня</p>',
        '<p class="text-gray-400 pt-1">Скидка фиксируется прямо сейчас.</p>',
      ].join('');
    }

    // ── Вернувшийся посетитель (кука есть, активной сессии нет) ────────────
    // Условие: кука = "уже крутил", sessionStorage = нет (вкладка была закрыта)
    // → скидка утеряна, показываем стандартную карточку без колеса
    if (!saved && getCookie(COOKIE_KEY) === '1') {
      if (wheelArea) wheelArea.classList.add('hidden');
      winBlock.classList.add('hidden'); winBlock.classList.remove('flex');
      if (fallback) { fallback.classList.remove('hidden'); fallback.classList.add('flex'); }
      return; // дальше ничего не инициализируем
    }

    // ── Аналитика: колесо появилось на экране ──────────────────────────────
    var _wheelViewed = false;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries, obs) {
        if (entries[0].isIntersecting && !_wheelViewed) {
          _wheelViewed = true;
          try { window.ym && window.ym(96499295, 'reachGoal', 'fortune_wheel_view'); } catch(_e) {}
          obs.disconnect();
        }
      }, { threshold: 0.4 }).observe(wheelArea || wheel);
    }

    // Restore UI from saved session state
    if (saved) {
      updateDots();
      if (saved.wonDiscount > 0) {
        // Show win block with saved discount
        var _fp = Math.round(PRICE * (1 - saved.wonDiscount / 100));
        var _dep = Math.round(_fp * 0.5);
        if (discPctEl)   discPctEl.textContent    = saved.wonDiscount + '%';
        if (finalPriceEl) finalPriceEl.textContent = _fp.toLocaleString('ru-RU') + ' ₽';
        if (depPriceEl)   depPriceEl.textContent   = _dep.toLocaleString('ru-RU') + ' ₽';
        winBlock.classList.remove('hidden');
        winBlock.classList.add('flex');
        if (saved.attempts <= 0) {
          spinBtn.disabled = true;
          spinLabel.textContent = 'Попытки исчерпаны';
        }
      } else if (saved.attempts <= 0) {
        // Used all spins, no discount — show fallback
        showFallback();
      }
    }

    function rub(n) {
      return n.toLocaleString('ru-RU') + ' ₽';
    }

    // Weighted random from a subset of segment indices
    function pickFrom(indices) {
      var total = 0;
      for (var i = 0; i < indices.length; i++) total += segs[indices[i]].w;
      var r = Math.random() * total;
      var cum = 0;
      for (var j = 0; j < indices.length; j++) {
        cum += segs[indices[j]].w;
        if (r < cum) return indices[j];
      }
      return indices[indices.length - 1];
    }

    // Spin 1: ≤30%  (indices 0–2: 10/20/30%)
    // Spin 2: full random (6 segments)
    // Spin 3: ≥20%  (indices 1–5: 20/30/40/50/70%)
    function pickWinner(spinNumber) {
      if (spinNumber === 1) return pickFrom([0, 1, 2]);
      if (spinNumber === 3) return pickFrom([1, 2, 3, 4, 5]);
      return pickFrom([0, 1, 2, 3, 4, 5]);
    }

    // Target rotation so segment i lands at top pointer (0° position)
    function targetRotation(segIdx) {
      var segCenterDeg = (segIdx + 0.5) * 60; // 0° = top, 6 segments × 60°
      var naturalStop  = (360 - segCenterDeg + 360) % 360;
      var jitter = (Math.random() - 0.5) * 30; // ±15°
      // 5+ full spins from current position
      var base = Math.ceil(currentRot / 360) * 360;
      return base + 5 * 360 + naturalStop + jitter;
    }

    function updateDots() {
      var dots = attemptsEl.querySelectorAll('[data-dot]');
      dots.forEach(function (dot, i) {
        dot.style.background = i < attempts
          ? 'var(--color-primary, #f97316)'
          : '#e2e8f0';
      });
    }

    function showWin(segIdx) {
      var d  = segs[segIdx].d;
      wonDiscount = d;

      // Логируем кручение в БД (fire-and-forget)
      fetch('/api/fortune/spin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ discount: d, shiftId: SHIFT_ID }),
      }).catch(function() {});
      var fp  = Math.round(PRICE * (1 - d / 100));
      var dep = Math.round(fp * 0.5);

      discPctEl.textContent   = d + '%';
      finalPriceEl.textContent = rub(fp);
      depPriceEl.textContent   = rub(dep);

      winBlock.classList.remove('hidden');
      winBlock.classList.add('flex');

      // Получаем подписанный токен для этой скидки с сервера
      fetch('/api/fortune/token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ discount: d }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) { wonToken = data.token || ''; saveState(); })
        .catch(function() { wonToken = ''; });

      // Metrika: выиграл скидку
      try {
        window.ym && window.ym(96499295, 'reachGoal', 'fortune_win', {
          discount:    d,
          price_full:  PRICE,
          price_final: Math.round(PRICE * (1 - d / 100)),
          attempts_left: attempts,
        });
      } catch(_e) {}

      // Re-enable spin button if attempts remain
      if (attempts > 0) {
        spinBtn.disabled = false;
        spinLabel.textContent = 'Попробовать ещё раз';
      } else {
        spinBtn.disabled = true;
        spinLabel.textContent = 'Попытки исчерпаны';
      }
    }

    function showFallback() {
      if (wheelArea) wheelArea.classList.add('hidden');
      winBlock.classList.add('hidden');
      winBlock.classList.remove('flex');
      if (fallback) {
        fallback.classList.remove('hidden');
        fallback.classList.add('flex');
      }
      try { window.ym && window.ym(96499295, 'reachGoal', 'fortune_fallback_shown'); } catch (_) {}
    }

    // ── Spin ──
    spinBtn.addEventListener('click', function () {
      if (isSpinning || attempts <= 0) return;
      isSpinning = true;
      setCookie(COOKIE_KEY, '1', 90); // помечаем: этот браузер уже крутил (90 дней)
      attempts--;
      updateDots();
      spinBtn.disabled = true;
      spinLabel.textContent = 'Крутим...';

      var spinNumber = 3 - attempts; // 1, 2 или 3

      // Metrika: спин (номер попытки 1–3)
      try { window.ym && window.ym(96499295, 'reachGoal', 'fortune_spin', { attempt: spinNumber }); } catch (_) {}

      // Hide previous win block while spinning
      winBlock.classList.add('hidden');
      winBlock.classList.remove('flex');

      var winner = pickWinner(spinNumber);
      var target = targetRotation(winner);

      wheel.style.transition = 'transform 3s cubic-bezier(0.17, 0.67, 0.12, 1.0)';
      wheel.style.transform  = 'rotate(' + target + 'deg)';
      currentRot = target;

      setTimeout(function () {
        isSpinning = false;
        saveState();
        showWin(winner);
      }, 3150);
    });

    // ── Open booking modal ──
    bookBtn.addEventListener('click', function () {
      var d   = wonDiscount;
      var fp  = Math.round(PRICE * (1 - d / 100));
      var dep = Math.round(fp * 0.5);

      modalDisc.textContent  = d + '%';
      modalFinal.textContent = rub(fp);
      modalDep.textContent   = rub(dep);

      // Кнопка: текст и бейдж скидки
      var discBadge    = document.getElementById('fsc-pay-disc');
      var discBadgeVal = document.getElementById('fsc-pay-disc-val');
      if (fortuneMode === 'lead') {
        if (payLabel) payLabel.textContent = 'Отправить заявку';
        if (discBadgeVal) discBadgeVal.textContent = String(d);
        if (discBadge)    discBadge.classList.remove('hidden');
      } else {
        if (payLabel) payLabel.textContent = 'Оплатить ' + rub(dep) + ' через Т-банк';
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      startTimer();
      setTimeout(function () { nameInput.focus(); }, 50);

      // Metrika: открыл форму бронирования
      try { window.ym && window.ym(96499295, 'reachGoal', 'fortune_modal_open', { discount: d }); } catch (_) {}
    });

    // ── Timer ──
    function startTimer() {
      clearInterval(timerInterval);
      var secs = 30 * 60;
      function tick() {
        var m = Math.floor(secs / 60);
        var s = secs % 60;
        timerEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
        if (secs <= 0) {
          clearInterval(timerInterval);
          timerEl.style.color = '#dc2626';
        }
        secs--;
      }
      tick();
      timerInterval = setInterval(tick, 1000);
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      clearInterval(timerInterval);
      try { window.ym && window.ym(96499295, 'reachGoal', 'fortune_modal_close', { discount: wonDiscount }); } catch(_e) {}
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
      // закрыть если клик по подложке, но не по карточке
      if (e.target === modal || (e.target instanceof Element && e.target.closest(`[id="fsc-modal"]`) && !e.target.closest('[role="dialog"] .bg-white'))) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    // ── Pay button ──
    payBtn.addEventListener('click', function () {
      if (formError) {
        formError.classList.add('hidden');
        formError.textContent = '';
      }

      var name  = nameInput.value.trim();
      var phone = phoneInput.value.replace(/\D/g, '');

      if (!name || name.split(' ').length < 2) {
        formError.textContent = 'Введите фамилию и имя';
        formError.classList.remove('hidden');
        nameInput.focus();
        return;
      }
      if (phone.length < 10) {
        formError.textContent = 'Введите корректный номер телефона';
        formError.classList.remove('hidden');
        phoneInput.focus();
        return;
      }
      if (consentBox && !consentBox.checked) {
        formError.textContent = 'Подтвердите согласие на обработку персональных данных';
        formError.classList.remove('hidden');
        consentBox.focus();
        return;
      }

      // Metrika: перехватываем лид до отправки в банк
      try {
        window.ym && window.ym(96499295, 'reachGoal', 'fortune_lead_capture', {
          discount: wonDiscount,
          name:     name,
          phone:    phoneInput.value.trim(),
        });
      } catch (_) {}

      payBtn.disabled = true;
      payLabel.textContent = 'Переходим в банк…';

      var isTest = new URLSearchParams(window.location.search).get('ft') === '1';

      fetch('/api/fortune/init', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          shiftId:  SHIFT_ID,
          discount: wonDiscount,
          token:    wonToken,
          name:     name,
          phone:    phoneInput.value.trim(),
          test:     isTest,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.leadMode) {
            // Режим «лид»: показываем подтверждение, менеджер перезвонит
            clearInterval(timerInterval);
            try {
              window.ym && window.ym(96499295, 'reachGoal', 'fortune_lead', {
                discount: wonDiscount,
                order_id: data.orderId,
              });
            } catch(_e) {}
            // Прячем форму, показываем экран благодарности
            var formWrap = document.getElementById('fsc-form-wrap');
            if (formWrap) formWrap.innerHTML = [
              '<div class="flex flex-col items-center gap-4 py-6 text-center">',
              '  <div class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100">',
              '    <i class="bi bi-check-lg text-[28px] text-emerald-600" aria-hidden="true"></i>',
              '  </div>',
              '  <p class="text-[18px] font-bold text-body">Заявка принята!</p>',
              '  <p class="text-[14px] text-body-muted leading-[1.5]">Менеджер свяжется с вами до конца дня,<br>возьмёт данные для договора и выставит счёт.</p>',
              '  <div class="rounded-xl bg-primary/8 px-4 py-3 text-center">',
              '    <p class="text-[12px] text-body-faint uppercase tracking-wider mb-0.5">Ваша скидка</p>',
              '    <p class="text-[22px] font-extrabold text-primary">' + wonDiscount + '%</p>',
              '    <p class="text-[13px] text-body-muted">Итоговая цена: <b>' + (data.finalPrice || '').toLocaleString("ru-RU") + ' ₽</b></p>',
              '  </div>',
              '</div>',
            ].join('');
          } else if (data.paymentUrl) {
            clearInterval(timerInterval);
            try {
              window.ym && window.ym(96499295, 'reachGoal', 'fortune_payment_start', {
                discount:   wonDiscount,
                deposit:    data.deposit,
                order_id:   data.orderId,
                payment_id: data.paymentId,
              });
            } catch(_e) {}
            window.location.href = data.paymentUrl;
          } else {
            formError.textContent = data.error || 'Ошибка оплаты. Попробуйте ещё раз.';
            formError.classList.remove('hidden');
            payBtn.disabled = false;
            payLabel.textContent = 'Оплатить через Т-банк';
          }
        })
        .catch(function () {
          formError.textContent = 'Ошибка соединения. Проверьте интернет и попробуйте снова.';
          formError.classList.remove('hidden');
          payBtn.disabled = false;
          payLabel.textContent = 'Оплатить через Т-банк';
        });
    });

    // ── Phone mask ──
    phoneInput.addEventListener('input', function () {
      var raw = phoneInput.value.replace(/\D/g, '');
      if (!raw.length) return;
      if (raw[0] === '8') raw = '7' + raw.slice(1);
      if (raw[0] === '9') raw = '7' + raw; // пользователь ввёл без 7 в начале
      var out = '+' + raw[0];
      if (raw.length > 1) out += ' (' + raw.slice(1, 4);
      if (raw.length >= 4) out += ') ' + raw.slice(4, 7);
      if (raw.length >= 7) out += '-' + raw.slice(7, 9);
      if (raw.length >= 9) out += '-' + raw.slice(9, 11);
      phoneInput.value = out;
    });

  })();
</script>
