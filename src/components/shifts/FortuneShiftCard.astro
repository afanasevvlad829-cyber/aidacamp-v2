---
import { Icon } from 'astro-icon/components';
import { iconName } from '../../utils/icons';
import { getCurrentPrice, fmtPrice } from '../../data/dynamicPrices';
import { mainShifts, getAvailabilityLevel, getShiftBadge } from '../../data/shifts';
import { MS_PER_DAY, daysUntil, formatDaysLabel } from '../../scripts/shifts/fortune';
import { seededShuffle } from '../../lib/deterministic';

interface Props {
  shiftId?: string;
}
const { shiftId = 'shift-1' } = Astro.props;

const shift = mainShifts.find((s) => s.id === shiftId) ?? mainShifts[0];
const SHIFT_ID = shift.id;

// Значок в кружке — общий с ShiftCard.astro (номер летом, иконка сезона в межсезонье)
const badge = getShiftBadge(shift);

// Занятость fallback-карточки — было захардкожено "Осталось 3 места"/"width:91%"
// (05.07.2026: чинил заодно с блюром — число разошлось с реальными данными shifts.ts).
const fscTotal = shift.free + shift.occupied || 1;
const fscPct = Math.round((shift.occupied / fscTotal) * 100);
const fscFreeLabel = shift.free === 1 ? '1 место' : shift.free < 5 ? `${shift.free} места` : `${shift.free} мест`;
const fscIsLow = getAvailabilityLevel(shift) === 'low';

// Полоса занятости — сегментами, как в ShiftCard.astro (единый стиль)
const FSC_SEGMENTS = 24;
const fscFilledSegments = Math.round((fscPct / 100) * FSC_SEGMENTS);

const today = new Date();
const currentPrice = getCurrentPrice(SHIFT_ID, today) ?? parseInt(shift.price.replace(/\D/g, ''), 10);
const fortuneMode = process.env.FORTUNE_MODE ?? 'lead'; // 'payment' | 'lead' — по умолчанию заявка, без Т-банка

// Days until shift starts
const startDate = new Date(shift.startDate + 'T00:00:00');
const daysLeft = daysUntil(startDate.getTime(), today.getTime());
const daysLeftLabel = formatDaysLabel(daysLeft);

// Заезд = startDate + 2 дня (запас на справки)
const arriveDate = new Date(startDate.getTime() + 2 * MS_PER_DAY);
const monthsGenitive = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const startDayLabel  = `${startDate.getDate()} ${monthsGenitive[startDate.getMonth()]}`;
const arriveDayLabel = `${arriveDate.getDate()} ${monthsGenitive[arriveDate.getMonth()]}`;

// SVG wheel segments (shared server+client via define:vars)
// 8 секторов: 1-й прокрут гарантирует 30% (см. GUARANTEED_PCT в клиентском скрипте),
// 2-й и 3-й могут выпасть на любое значение из списка — включая ниже 30%.
interface Seg { label: string; d: number; w: number; color: string }

// Порядок секторов на колесе — вперемешку, не по возрастанию (чисто визуально,
// вес/шанс каждого значения не зависит от позиции на круге).
//
// Тасовка засеяна id смены, а не Math.random(). Прежний вариант перемешивал
// НА СБОРКЕ, и это не давало ничего из задуманного: порядок всё равно застывал
// до следующего деплоя, одинаковый для всех посетителей. Зато делал сборку
// невоспроизводимой — Shifts.astro подключён на 115 страницах, и каждая
// получала новый HTML на каждом билде (rsync гнал их заново, кэш минификации
// промахивался). Замер 14.08.2026: 151 изменённая страница из 336 на пустой
// правке. Сейчас порядок стабилен между сборками и по-прежнему разный у разных
// смен. Настоящая случайность на каждый показ, если понадобится, делается
// в браузере — не здесь. См. src/lib/deterministic.ts.
const SEGMENTS: Seg[] = seededShuffle([
  { label: '10%', d: 10, w: 22, color: '#fdba74' },
  { label: '15%', d: 15, w: 18, color: '#fcae67' },
  { label: '20%', d: 20, w: 16, color: '#fb923c' },
  { label: '25%', d: 25, w: 14, color: '#fa8228' },
  { label: '30%', d: 30, w: 12, color: '#f97316' },
  { label: '40%', d: 40, w: 9,  color: '#ea580c' },
  { label: '50%', d: 50, w: 6,  color: '#c2410c' },
  { label: '70%', d: 70, w: 3,  color: '#7c2d12' },
], SHIFT_ID);

// Pre-compute SVG paths server-side
const R = 108, CX = 120, CY = 120;
function toRad(deg: number) { return deg * Math.PI / 180; }
const SEG_DEG = 360 / SEGMENTS.length; // делит круг поровну на все сегменты SEGMENTS
const segData = SEGMENTS.map((seg, i) => {
  const a1 = toRad(i * SEG_DEG - 90);
  const a2 = toRad((i + 1) * SEG_DEG - 90);
  const x1 = (CX + R * Math.cos(a1)).toFixed(1);
  const y1 = (CY + R * Math.sin(a1)).toFixed(1);
  const x2 = (CX + R * Math.cos(a2)).toFixed(1);
  const y2 = (CY + R * Math.sin(a2)).toFixed(1);
  const path = `M ${CX} ${CY} L ${x1} ${y1} A ${R} ${R} 0 0 1 ${x2} ${y2} Z`;
  const ta = toRad((i + 0.5) * SEG_DEG - 90);
  const tr = R * 0.62;
  const tx = (CX + tr * Math.cos(ta)).toFixed(1);
  const ty = (CY + tr * Math.sin(ta)).toFixed(1);
  // Rotate text along sector radius, readable from outside
  const ta_deg = (i + 0.5) * SEG_DEG - 90;
  const textAngle = (ta_deg > 90 ? ta_deg - 180 : ta_deg).toFixed(1);
  return { ...seg, path, tx, ty, textAngle };
});
---

<!-- ── Card ── -->
<article
  data-fortune-card
  data-shift-id={SHIFT_ID}
  class="relative flex flex-col rounded-[22px] border border-transparent bg-card card-shadow ring-2 ring-primary shadow-[0_0_0_4px_rgba(236,124,0,0.12)] p-5"
>

  <!-- Header banner — тот же короб, что у «Ближайшей» в ShiftCard.astro (персиковый фон, контрастный кружок) -->
  <div class="-mx-5 -mt-5 mb-4 flex items-center gap-2 rounded-t-[20px] border-b border-[var(--color-primary-100)] bg-[var(--color-primary-soft)] px-5 py-3">
    <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary text-base font-extrabold text-white shrink-0 shadow-[0_0_0_3px_rgba(236,124,0,0.18)]">{badge.kind === 'num' ? badge.text : <Icon name={iconName(badge.icon)} class:list={['bi', badge.icon, 'text-[13px]']} title={badge.label} aria-label={badge.label} role="img" />}</span>
    <span class="text-base font-bold text-body">{shift.name} · {shift.dates}</span>
    <span class="ml-auto flex items-center gap-1.5 whitespace-nowrap text-[12px] font-semibold text-primary">
      <Icon name="bi:clock" class="bi bi-clock text-[11px]" aria-hidden="true" />
      {daysLeftLabel}
    </span>
  </div>

  <!-- Tags row: duration + spots + price -->
  <div class="flex items-center gap-1.5 mb-4 flex-wrap">
    <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-1 text-[12px] font-semibold text-orange-700">
      <Icon name="bi:calendar-event" class="bi bi-calendar-event text-[10px]" aria-hidden="true" />
      {shift.duration}
    </span>
    <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-1 text-[12px] font-bold text-red-700">
      <Icon name="bi:fire" class="bi bi-fire text-[10px]" aria-hidden="true" />
      Последние 3 места
    </span>
    <span class="ml-auto text-right">
      <span class="block text-[10px] font-semibold uppercase tracking-[0.12em] text-body-faint">Стоимость</span>
      <span class="block text-[20px] font-extrabold text-body leading-none" data-dynamic-price={SHIFT_ID}>{fmtPrice(currentPrice)}</span>
    </span>
  </div>

  <!-- Wheel area: tagline + SVG + dots + spin btn (скрывается после 3 спинов) -->
  <div id={`fsc-wheel-area-${SHIFT_ID}`}>
  <!-- Wheel tagline -->
  <p class="text-center text-base font-semibold text-body-muted mb-2">
    <Icon name="bi:trophy-fill" class="bi bi-trophy-fill text-orange-400 text-[12px] mr-1" aria-hidden="true" />
    Крутите колесо — разыгрываем скидку до 70%
  </p>

  <!-- SVG Fortune Wheel -->
  <div class="flex justify-center mb-3 relative">
    <!-- Pointer triangle at top -->
    <div
      class="absolute z-10 pointer-events-none"
      style="top:-4px; left:50%; transform:translateX(-50%)"
      aria-hidden="true"
    >
      <svg width="20" height="14" viewBox="0 0 20 14">
        <polygon points="10,14 0,0 20,0" fill="#1e293b"/>
      </svg>
    </div>

    <div class="w-[220px] max-w-full relative" style="aspect-ratio:1">
      <svg
        id={`fsc-wheel-${SHIFT_ID}`}
        viewBox="0 0 240 240"
        style="width:100%;height:100%;transform-origin:50% 50%"
      >
        {segData.map((seg, i) => (
          <g>
            <path d={seg.path} fill={seg.color} stroke="white" stroke-width="1.5"/>
            <text
              x={seg.tx}
              y={seg.ty}
              transform={`rotate(${seg.textAngle}, ${seg.tx}, ${seg.ty})`}
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="17"
              font-weight="900"
              fill="white"
              font-family="system-ui,sans-serif"
              paint-order="stroke"
              stroke="rgba(0,0,0,0.55)"
              stroke-width="5"
              stroke-linejoin="round"
            >{seg.label}</text>
          </g>
        ))}
        <!-- Center hub -->
        <circle cx={CX} cy={CY} r="24" fill="white" stroke="#fed7aa" stroke-width="2.5"/>
        <circle cx={CX} cy={CY} r="18" fill="#fff7ed"/>
        <text
          x={CX} y={CY - 3}
          text-anchor="middle" dominant-baseline="middle"
          font-size="7" font-weight="800" fill="#ea580c"
          style="font-family:system-ui,sans-serif;letter-spacing:0.05em"
        >УДАЧА</text>
        <text
          x={CX} y={CY + 7}
          text-anchor="middle" dominant-baseline="middle"
          font-size="13" fill="#ea580c"
          style="font-family:system-ui,sans-serif"
        >★</text>
      </svg>
    </div>
  </div>

  <!-- Attempts dots + spin button -->
  <div class="flex flex-col items-center gap-2.5 mb-4">
    <div id={`fsc-attempts-${SHIFT_ID}`} class="flex items-center gap-1.5" role="group" aria-label="Оставшиеся попытки">
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="0" style="background:var(--color-primary,#f97316)"></span>
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="1" style="background:var(--color-primary,#f97316)"></span>
      <span class="w-2.5 h-2.5 rounded-full transition-colors" data-dot="2" style="background:var(--color-primary,#f97316)"></span>
    </div>
    <button
      id={`fsc-spin-btn-${SHIFT_ID}`}
      type="button"
      class="flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-base px-10 py-3 min-h-[44px] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <Icon name="bi:arrow-repeat" id={`fsc-spin-icon-${SHIFT_ID}`} class="bi bi-arrow-repeat text-[16px]" aria-hidden="true" />
      <span id={`fsc-spin-label-${SHIFT_ID}`}>Крутить!</span>
    </button>
  </div>

  </div><!-- /fsc-wheel-area -->

  <!-- Fallback: стандартная карточка после 3 спинов без бронирования -->
  <div id={`fsc-fallback-${SHIFT_ID}`} class="hidden flex-col gap-3 mb-4">
    <!-- Occupancy bar — сегментами, как в ShiftCard.astro -->
    <div>
      <div class="flex justify-end text-[13px] mb-2">
        <span data-spots-num data-spots-shift={shift.id} class="cursor-pointer select-none font-bold text-primary blur-[6px] transition-[filter] duration-300">Осталось {fscFreeLabel}</span>
      </div>
      <div class="flex h-3 gap-[3px]">
        {Array.from({ length: FSC_SEGMENTS }).map((_, i) => (
          <span class:list={['flex-1 rounded-[3px]', i < fscFilledSegments ? 'bg-emerald-500' : 'bg-border-light']}></span>
        ))}
      </div>
      <button type="button" data-spots-reveal-btn data-spots-shift={shift.id} data-spots-low={fscIsLow ? '1' : undefined} class="mt-1.5 text-[12px] font-semibold text-primary hover:text-primary-hover underline underline-offset-2 transition-colors">
        Узнать точное число мест
      </button>
    </div>
    <!-- Price + CTA -->
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">Стоимость</p>
        <p class="mt-1 text-[26px] font-extrabold tracking-[-0.02em] leading-none text-body" data-dynamic-price={SHIFT_ID}>{fmtPrice(currentPrice)}</p>
        <span class="hidden text-[11px] font-semibold text-orange-500 mt-0.5 block" data-price-stage={SHIFT_ID}></span>
        <p class="mt-1 text-[12px] text-body-faint">всё включено</p>
      </div>
      <a
        href={`/shifts/${SHIFT_ID}/`}
        class="shrink-0 inline-flex items-center gap-1.5 rounded-xl px-5 py-3 text-base font-semibold transition-colors min-h-[44px] no-underline bg-primary hover:bg-primary-hover text-white"
      >
        Выбрать
        <Icon name="bi:arrow-right" class="bi bi-arrow-right text-base" aria-hidden="true" />
      </a>
    </div>
  </div>

  <!-- Win result block (hidden until first spin resolves) -->
  <div id={`fsc-win-block-${SHIFT_ID}`} class="hidden flex-col items-center gap-2.5 mb-4">
    <div class="w-full rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-green-600 mb-0.5">Ваша скидка</p>
      <p class="text-[34px] font-extrabold text-green-700 leading-none" id={`fsc-disc-pct-${SHIFT_ID}`}>—</p>
      <p class="text-base text-green-600 mt-1.5 space-x-2">
        <span>Итого: <strong id={`fsc-final-price-${SHIFT_ID}`}>—</strong></span>
        <span class="text-green-400">·</span>
        <span>Предоплата: <strong id={`fsc-dep-price-${SHIFT_ID}`}>—</strong></span>
      </p>
    </div>
    <button
      id={`fsc-book-btn-${SHIFT_ID}`}
      type="button"
      class="w-full flex items-center justify-center gap-2 rounded-xl bg-green-600 hover:bg-green-700 text-white font-bold text-base py-3.5 min-h-[48px] transition-colors"
    >
      <Icon name="bi:calendar-check" class="bi bi-calendar-check text-[16px]" aria-hidden="true" />
      Забронировать место
    </button>
  </div>

  <!-- Bottom conditions -->
  <div class="mt-auto border-t border-border-light pt-3 space-y-0.5 text-[11px] text-body-faint">
    <p>
      <Icon name="bi:shield-check" class="bi bi-shield-check text-[10px] mr-1" aria-hidden="true" />
      Предоплата 50% · оставшиеся 50% до конца дня оплаты
    </p>
    <p>
      <Icon name="bi:calendar-event" class="bi bi-calendar-event text-[10px] mr-1" aria-hidden="true" />
      Заехать можно до {arriveDayLabel} · успейте собрать справки
    </p>
    <p class="pt-1">
      <Icon name="bi:telegram" class="bi bi-telegram text-[10px] mr-1" aria-hidden="true" />
      Что-то пошло не так? Сделайте скриншот и
      <a href="https://t.me/Progaschool" target="_blank" rel="noopener"
         class="underline underline-offset-2 hover:text-primary transition-colors">напишите нам в Telegram</a>
    </p>
  </div>
</article>

<!-- ── Booking Modal (fixed overlay, position:fixed → not clipped by carousel) ── -->
<div
  id={`fsc-modal-${SHIFT_ID}`}
  class="fixed inset-0 z-[100] hidden items-center justify-center overflow-y-auto"
  style="background:rgba(0,0,0,0.55);backdrop-filter:blur(4px)"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`fsc-modal-title-${SHIFT_ID}`}
>
  <div class="flex min-h-full items-center justify-center p-4 sm:py-8">
  <div class="relative w-full max-w-sm md:max-w-3xl max-h-[92dvh] overflow-y-auto md:overflow-hidden flex flex-col md:flex-row bg-white rounded-2xl shadow-2xl">

    <!-- ЛЕВАЯ КОЛОНКА (на десктопе): инфо о брони -->
    <div class="flex flex-col md:w-[42%] md:shrink-0 md:border-r md:border-gray-100">

    <!-- Modal header: green -->
    <div class="bg-green-600 px-6 py-4 rounded-t-2xl md:rounded-none">
      <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-green-100 mb-0.5">Место забронировано</p>
      <!-- Заголовок ДИАЛОГА, а не документа. Был <h2>, из-за чего на странице
           появлялось столько же одинаковых заголовков, сколько карточек смен —
           Лабрика 31.08.2026 показала это как единственную ошибку главной
           («Найдено несколько заголовков h1-h6 с одинаковым содержанием
           "Скидка — зафиксирована"»). aria-labelledby работает с любым тегом,
           поэтому доступность не страдает, а вид не меняется — классы те же. -->
      <p id={`fsc-modal-title-${SHIFT_ID}`} class="text-[22px] font-extrabold text-white leading-none">
        Скидка <span id={`fsc-modal-disc-${SHIFT_ID}`}>—</span> зафиксирована
      </p>
    </div>


    <!-- Payment summary -->
    <div class="px-6 py-3 border-b border-gray-100 md:border-b-0 space-y-1.5 md:flex-1">
      <div class="flex justify-between items-baseline gap-2 text-base">
        <span class="text-gray-500">Цена со скидкой</span>
        <span id={`fsc-modal-final-${SHIFT_ID}`} class="font-bold text-gray-800 whitespace-nowrap">—</span>
      </div>
      <div class="flex justify-between items-baseline gap-2">
        <span class="text-base text-gray-500">Предоплата сейчас (50%)</span>
        <span id={`fsc-modal-dep-${SHIFT_ID}`} class="text-[18px] font-extrabold text-primary leading-none whitespace-nowrap">—</span>
      </div>
    </div>

    </div><!-- /левая колонка -->

    <!-- ПРАВАЯ КОЛОНКА: форма + кнопка + шаги -->
    <div class="flex flex-col md:flex-1 md:min-w-0 md:overflow-y-auto md:max-h-[92dvh]">

    <!-- Form -->
    <div id={`fsc-form-wrap-${SHIFT_ID}`} class="px-6 py-4 space-y-3">
      <div>
        <label for={`fsc-name-${SHIFT_ID}`} class="block text-base font-semibold text-gray-700 mb-1.5">Ваши ФИО *</label>
        <input
          id={`fsc-name-${SHIFT_ID}`}
          type="text"
          placeholder="Иванов Иван Иванович"
          required
          autocomplete="name"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-base outline-none focus:border-primary focus:ring-2 focus:ring-orange-100 transition"
        />
      </div>
      <div>
        <label for={`fsc-phone-${SHIFT_ID}`} class="block text-base font-semibold text-gray-700 mb-1.5">Ваш телефон *</label>
        <input
          id={`fsc-phone-${SHIFT_ID}`}
          type="tel"
          placeholder="+7 (999) 000-00-00"
          required
          autocomplete="tel"
          inputmode="tel"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-base outline-none focus:border-primary focus:ring-2 focus:ring-orange-100 transition"
        />
      </div>
      <!-- Согласие на обработку персональных данных -->
      <div class="flex items-start gap-2.5 pt-1">
        <input
          id={`fsc-consent-${SHIFT_ID}`}
          type="checkbox"
          class="mt-0.5 h-4 w-4 shrink-0 accent-primary cursor-pointer"
        />
        <label for={`fsc-consent-${SHIFT_ID}`} class="text-[12px] text-gray-500 leading-[1.4] cursor-pointer select-none">
          Я согласен(а) на <a href="/privacy-policy/" target="_blank" rel="noopener" class="underline hover:text-primary transition-colors">обработку персональных данных</a>
        </label>
      </div>
      <p id={`fsc-form-error-${SHIFT_ID}`} class="hidden text-[12px] text-red-600 font-medium"></p>
    </div>

    <!-- Pay button -->
    <div id={`fsc-pay-btn-wrap-${SHIFT_ID}`} class="px-6 pb-4">
      <button
        id={`fsc-pay-btn-${SHIFT_ID}`}
        type="button"
        class="w-full flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-base py-3.5 min-h-[52px] transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <Icon name="bi:send" id={`fsc-pay-icon-${SHIFT_ID}`} class="bi bi-send text-[16px]" aria-hidden="true" />
        <span id={`fsc-pay-label-${SHIFT_ID}`}>Отправить заявку</span>
        <span id={`fsc-pay-disc-${SHIFT_ID}`} class="ml-1 rounded-full bg-white/20 px-2 py-0.5 text-base font-extrabold hidden">−<span id={`fsc-pay-disc-val-${SHIFT_ID}`}>0</span>%</span>
      </button>
    </div>

    <!-- What happens next (ниже кнопки) -->
    <div id={`fsc-next-steps-${SHIFT_ID}`} class="px-6 pb-4 border-t border-gray-100 pt-4 space-y-1.5 text-[12px] text-gray-500">
      <p class="font-semibold text-gray-700 text-base mb-2">Что будет после оплаты:</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">1.</span> В течение 30 минут с вами свяжется представитель</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">2.</span> Договор подготовим до конца рабочего дня</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">3.</span> Окончательная оплата — до конца дня заезда ({startDayLabel})</p>
      <p><span class="inline-block w-4 text-orange-500 font-bold">4.</span> Заехать можно до {arriveDayLabel} — время собрать справки</p>
