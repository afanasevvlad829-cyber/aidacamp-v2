---
/**
 * V2 Booking Style — горизонтальная компоновка как у билетов/бронирования. A/B-тест.
 * Логика идентична оригиналу.
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
}
const { shift } = Astro.props;

const isShort = shift.statusType === 'short';
const popular = shift.popular;
---

<div class={`grid grid-cols-[1fr_auto] gap-0 overflow-hidden rounded-[16px] border bg-white ${popular ? 'border-2 border-[#ec9b44]' : 'border-slate-200'}`}>
  <!-- Левая часть — иконка + контент -->
  <div class="p-4 md:p-5">
    {popular && (
      <div class="mb-2 inline-flex items-center gap-1 rounded-full bg-[#ec9b44] px-2 py-0.5 text-[10px] font-bold text-white">
        <i class="bi bi-fire text-[11px]" aria-hidden="true"></i>
        Популярная
      </div>
    )}
    <div class="flex items-start gap-3">
      <div class={`mt-0.5 shrink-0 flex h-10 w-10 items-center justify-center rounded-full ${isShort ? 'bg-amber-100 text-amber-600' : 'bg-emerald-100 text-emerald-600'}`}>
        <i class={`bi ${isShort ? 'bi-hourglass-split' : 'bi-calendar-event'} text-[18px]`} aria-hidden="true"></i>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-[18px] font-bold text-slate-900">{shift.name}</h3>
          <span class={`rounded-full px-2 py-0.5 text-[11px] font-medium ${isShort ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
            {isShort ? 'короткая' : shift.status}
          </span>
        </div>
        <p class="mt-0.5 text-[13px] text-slate-500">{shift.dates} · {shift.duration}</p>
        <p class="mt-2 text-[13px] leading-[1.55] text-slate-600">{shift.description}</p>
        <p class="mt-3 flex items-center gap-1.5 text-[12px] text-emerald-700 border-t border-slate-100 pt-2.5">
          <i class="bi bi-check-circle-fill text-emerald-500" aria-hidden="true"></i>
          Всё включено
        </p>
      </div>
    </div>
  </div>

  <!-- Правая часть — цена + CTA -->
  <div class="flex flex-col items-end justify-between border-l border-slate-100 bg-slate-50 p-4 md:p-5 min-w-[140px]">
    <div class="text-right">
      <div class="text-[20px] font-bold text-slate-900">{shift.price}</div>
      <p class="mt-1 text-[11px] text-slate-500">Осталось {shift.free} мест</p>
    </div>
    <button type="button" data-shift-link={shift.id} class={`mt-3 rounded-[8px] px-4 py-2 text-[13px] font-semibold transition-colors ${shift.free > 0 ? 'bg-[#ec9b44] text-white hover:bg-[#d67000]' : 'bg-slate-200 text-slate-500 cursor-not-allowed'}`}>
      Выбрать
    </button>
  </div>
</div>
