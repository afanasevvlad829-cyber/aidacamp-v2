---
/**
 * V1 Premium Minimal Modal — премиальный модальник с 3 табами для A/B-теста.
 * Соответствует ShiftCardV1Premium. Логика идентична оригиналам.
 *
 * Открывается через: document.getElementById('shiftModalV1').showModal()
 * Параметризация: data-shift-id передавать через showModalV1(shiftId).
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
}
const { shift } = Astro.props;

const isShort = shift.statusType === 'short';
const popular = shift.popular;
const occupied = shift.occupied || 23;
const free = shift.free || 12;
const total = occupied + free;
const occupiedPct = Math.round((occupied / total) * 100);

// Простой календарь — пример визуализации диапазона дат
function makeMonthCalendar(year: number, month: number, startDate: string, endDate: string) {
  const start = new Date(startDate);
  const end = new Date(endDate);
  const firstDay = new Date(year, month - 1, 1);
  const lastDay = new Date(year, month, 0);
  const startWeekday = (firstDay.getDay() + 6) % 7; // Пн=0
  const days: Array<{ day: number | null; inShift: boolean }> = [];
  for (let i = 0; i < startWeekday; i++) days.push({ day: null, inShift: false });
  for (let d = 1; d <= lastDay.getDate(); d++) {
    const date = new Date(year, month - 1, d);
    days.push({ day: d, inShift: date >= start && date <= end });
  }
  return days;
}
const may = makeMonthCalendar(2026, 5, shift.startDate, shift.endDate);
const jun = makeMonthCalendar(2026, 6, shift.startDate, shift.endDate);
---

<dialog id={`shiftModalV1-${shift.id}`} class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/50 p-2 backdrop:bg-black/50 md:p-4">
  <div class="relative mx-auto mt-[2vh] max-h-[96vh] w-full max-w-[520px] overflow-y-auto rounded-[20px] bg-white shadow-[0_20px_50px_rgba(15,23,42,0.25)] md:mt-[6vh]">
    <!-- Header -->
    <div class="flex items-start justify-between p-5 pb-3">
      <div>
        <h3 class="text-[20px] font-bold text-slate-900">{shift.name}</h3>
        <p class="mt-0.5 text-[13px] text-slate-500">{shift.dates}</p>
      </div>
      <button type="button" data-close aria-label="Закрыть" class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 transition-colors">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Tabs -->
    <div class="px-5">
      <div class="flex gap-2 rounded-[12px] bg-slate-100 p-1" role="tablist">
        <button type="button" data-tab="desc" class="flex-1 rounded-[8px] bg-primary px-3 py-2 text-[13px] font-semibold text-white transition-colors">Описание</button>
        <button type="button" data-tab="cal" class="flex-1 rounded-[8px] px-3 py-2 text-[13px] font-medium text-slate-600 hover:bg-white transition-colors">Календарь</button>
        <button type="button" data-tab="more" class="flex-1 rounded-[8px] px-3 py-2 text-[13px] font-medium text-slate-600 hover:bg-white transition-colors">Подробнее</button>
      </div>
    </div>

    <!-- Tab content -->
    <div class="px-5 pt-5">
      <!-- Описание -->
      <div data-pane="desc" class="space-y-4">
        <div class="flex items-center gap-3 text-[13px] text-slate-600">
          <span class="inline-flex items-center gap-1.5"><i class="bi bi-clock text-slate-400"></i>{shift.duration}</span>
          <span class="text-slate-300">·</span>
          <span class="inline-flex items-center gap-1.5"><i class="bi bi-calendar-event text-slate-400"></i>{shift.dates}</span>
        </div>
        <div>
          <div class="flex justify-between text-[12px] text-slate-500 mb-1.5">
            <span>занято {occupied}</span>
            <span>свободно {free}</span>
          </div>
          <div class="h-2 rounded-full bg-emerald-100 overflow-hidden">
            <div class="h-full bg-emerald-500" style={`width: ${occupiedPct}%`}></div>
          </div>
        </div>
        <p class="text-[14px] leading-[1.55] text-slate-700">{shift.description}</p>
        <div class="flex items-center gap-2 rounded-[10px] bg-slate-50 p-3 text-[13px] text-slate-700">
          <i class="bi bi-people-fill text-slate-500"></i>
          Уже едет {occupied} ребят 10–12 лет вашего возраста
        </div>
      </div>

      <!-- Календарь -->
      <div data-pane="cal" class="hidden space-y-4">
        <div>
          <p class="text-center text-[14px] font-semibold text-slate-700 mb-2">Май 2026</p>
          <div class="grid grid-cols-7 gap-1 text-center text-[11px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            {may.map(d => (
              <div class={`h-9 flex items-center justify-center text-[13px] rounded-[6px] ${d.inShift ? 'bg-primary text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="text-center text-[14px] font-semibold text-slate-700 mb-2">Июнь 2026</p>
          <div class="grid grid-cols-7 gap-1 text-center text-[11px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            {jun.map(d => (
              <div class={`h-9 flex items-center justify-center text-[13px] rounded-[6px] ${d.inShift ? 'bg-primary text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
        </div>
        <p class="text-[12px] text-slate-500 text-center inline-flex items-center justify-center gap-1.5">
          <span class="h-3 w-3 rounded-[3px] bg-primary"></span>
          Дни смены
        </p>
      </div>

      <!-- Подробнее -->
      <div data-pane="more" class="hidden space-y-3 text-[14px] leading-[1.6] text-slate-700">
        <p>Смена выстроена как спокойный и понятный вход в программирование с гарантированным результатом на выходе.</p>
        <p class="font-semibold text-slate-900 pt-2">Первые дни — включение в процесс</p>
        <p>Знакомство, деление на группы по возрасту и уровню. Сразу практика: собирается сцена, добавляется персонаж, настраивается движение и простые действия. Даже без опыта появляется первый результат уже в начале смены.</p>
        <p class="font-semibold text-slate-900 pt-2">Далее — работа над своим проектом</p>
        <p>Выбор идеи и пошаговая реализация. Например:</p>
        <ul class="space-y-1 pl-1">
          <li class="flex gap-2"><span class="text-primary">•</span>игра, где персонаж убегает от препятствий и набирает очки</li>
          <li class="flex gap-2"><span class="text-primary">•</span>игра с уровнями и усложнением</li>
        </ul>
      </div>
    </div>

    <!-- Footer with price + CTA -->
    <div class="mt-5 border-t border-slate-100 px-5 py-4 bg-slate-50/60 rounded-b-[20px]">
      <div class="text-[20px] font-bold text-primary">{shift.price}</div>
      <p class="text-[12px] text-slate-500 mt-0.5">Питание, проживание, программа включены</p>
      <button type="button" data-shift-link={shift.id} class="mt-3 w-full rounded-[10px] bg-primary px-5 py-3 text-[14px] font-semibold text-white hover:bg-[#d67000] transition-colors">
        Выбрать смену
      </button>
    </div>
  </div>

  <script is:inline>
    (function(){
      const dlg = document.currentScript.parentElement;
      dlg.addEventListener('click', e => {
        const t = e.target;
        if (t.matches('[data-close]') || t === dlg) dlg.close();
        const tab = t.closest('[data-tab]');
        if (tab) {
          dlg.querySelectorAll('[data-tab]').forEach(b => b.classList.remove('bg-primary','text-white','font-semibold'));
          dlg.querySelectorAll('[data-tab]').forEach(b => b.classList.add('text-slate-600','font-medium'));
          tab.classList.remove('text-slate-600','font-medium');
          tab.classList.add('bg-primary','text-white','font-semibold');
          dlg.querySelectorAll('[data-pane]').forEach(p => p.classList.add('hidden'));
          dlg.querySelector('[data-pane="' + tab.dataset.tab + '"]').classList.remove('hidden');
        }
      });
    })();
  </script>
</dialog>
