---
/**
 * V3 Parent Decision Modal — фокус «что получит ребёнок» / «как проходит смена». A/B-тест.
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
}
const { shift } = Astro.props;

function makeMonthCalendar(year: number, month: number, startDate: string, endDate: string) {
  const start = new Date(startDate); const end = new Date(endDate);
  const lastDay = new Date(year, month, 0).getDate();
  const startWeekday = (new Date(year, month - 1, 1).getDay() + 6) % 7;
  const days: Array<{ day: number | null; inShift: boolean }> = [];
  for (let i = 0; i < startWeekday; i++) days.push({ day: null, inShift: false });
  for (let d = 1; d <= lastDay; d++) {
    const date = new Date(year, month - 1, d);
    days.push({ day: d, inShift: date >= start && date <= end });
  }
  return days;
}
const may = makeMonthCalendar(2026, 5, shift.startDate, shift.endDate);
const jun = makeMonthCalendar(2026, 6, shift.startDate, shift.endDate);

const benefits = [
  { icon: 'rocket-takeoff-fill', color: 'text-[#ec7c00]', bg: 'bg-orange-50', title: 'Научится создавать игры', text: 'и проекты с AI' },
  { icon: 'star-fill',           color: 'text-amber-500', bg: 'bg-amber-50',  title: 'Увидит результат',     text: 'уже в первые дни' },
  { icon: 'people-fill',         color: 'text-emerald-500', bg: 'bg-emerald-50', title: 'Работает в команде', text: 'и развивает уверенность' },
];
const features = [
  { icon: 'shield-check',  color: 'text-emerald-500', title: 'Безопасная среда',     text: 'Проверенные вожатые и наставники' },
  { icon: 'heart-pulse',   color: 'text-rose-500',    title: 'Баланс обучения и отдыха', text: 'Программирование, игры, спорт, творчество' },
  { icon: 'patch-check-fill', color: 'text-[#ec7c00]', title: 'Поддержка и результат', text: 'Каждый делает свой проект и уезжает с готовым результатом' },
];
---

<dialog id={`shiftModalV3-${shift.id}`} class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/50 p-2 backdrop:bg-black/50 md:p-4">
  <div class="relative mx-auto mt-[2vh] max-h-[96vh] w-full max-w-[560px] overflow-y-auto rounded-[20px] bg-white shadow-[0_20px_50px_rgba(15,23,42,0.25)] md:mt-[6vh]">
    <!-- Header -->
    <div class="flex items-start justify-between p-5 pb-2">
      <div>
        <h3 class="text-[20px] font-bold text-slate-900">{shift.name}</h3>
        <p class="mt-0.5 text-[13px] text-slate-500">{shift.dates}</p>
      </div>
      <button type="button" data-close aria-label="Закрыть" class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 transition-colors">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Tabs -->
    <div class="px-5">
      <div class="flex gap-2 rounded-[12px] bg-slate-100 p-1" role="tablist">
        <button type="button" data-tab="desc" class="flex-1 rounded-[8px] bg-[#ec7c00] px-3 py-2 text-[13px] font-semibold text-white">Описание</button>
        <button type="button" data-tab="cal"  class="flex-1 rounded-[8px] px-3 py-2 text-[13px] font-medium text-slate-600 hover:bg-white">Календарь</button>
        <button type="button" data-tab="more" class="flex-1 rounded-[8px] px-3 py-2 text-[13px] font-medium text-slate-600 hover:bg-white">Подробнее</button>
      </div>
    </div>

    <div class="px-5 pt-5">
      <!-- Описание — что получит ребёнок -->
      <div data-pane="desc">
        <p class="text-[15px] font-semibold text-slate-900 mb-3">Что получит ребёнок за {shift.duration}</p>
        <div class="space-y-2.5">
          {benefits.map(b => (
            <div class="flex items-start gap-3 rounded-[12px] bg-slate-50 p-3">
              <div class={`shrink-0 flex h-9 w-9 items-center justify-center rounded-full ${b.bg}`}>
                <i class={`bi bi-${b.icon} text-[16px] ${b.color}`}></i>
              </div>
              <div>
                <p class="text-[14px] font-semibold text-slate-900">{b.title}</p>
                <p class="text-[13px] text-slate-600 leading-[1.4]">{b.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Календарь -->
      <div data-pane="cal" class="hidden space-y-4">
        <div>
          <p class="text-center text-[14px] font-semibold text-slate-700 mb-2">Май 2026</p>
          <div class="grid grid-cols-7 gap-1 text-center text-[11px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            {may.map(d => (
              <div class={`h-9 flex items-center justify-center text-[13px] rounded-[6px] ${d.inShift ? 'bg-[#ec7c00] text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="text-center text-[14px] font-semibold text-slate-700 mb-2">Июнь 2026</p>
          <div class="grid grid-cols-7 gap-1 text-center text-[11px] text-slate-400 mb-1">
            <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            {jun.map(d => (
              <div class={`h-9 flex items-center justify-center text-[13px] rounded-[6px] ${d.inShift ? 'bg-[#ec7c00] text-white font-semibold' : d.day ? 'text-slate-700' : 'text-slate-300'}`}>
                {d.day ?? ''}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Подробнее — как проходит смена -->
      <div data-pane="more" class="hidden">
        <p class="text-[15px] font-semibold text-slate-900 mb-3">Как проходит смена</p>
        <div class="space-y-2.5">
          {features.map(f => (
            <div class="flex items-start gap-3 rounded-[12px] bg-slate-50 p-3">
              <div class={`shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-white border border-slate-200`}>
                <i class={`bi bi-${f.icon} text-[16px] ${f.color}`}></i>
              </div>
              <div>
                <p class="text-[14px] font-semibold text-slate-900">{f.title}</p>
                <p class="text-[13px] text-slate-600 leading-[1.45]">{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-5 border-t border-slate-100 px-5 py-4 bg-slate-50/60 rounded-b-[20px]">
      <div class="flex items-center justify-between mb-3">
        <div class="text-[20px] font-bold text-[#ec7c00]">{shift.price}</div>
        <p class="text-[12px] text-slate-500 text-right">Питание, проживание,<br/>программа включены</p>
      </div>
      <button type="button" data-shift-link={shift.id} class="w-full rounded-[10px] bg-[#ec7c00] px-5 py-3 text-[14px] font-semibold text-white hover:bg-[#d46e00] transition-colors">
        Выбрать смену
      </button>
    </div>
  </div>

  <script is:inline>
    (function(){
      const dlg = document.currentScript.parentElement;
      dlg.addEventListener('click', e => {
        const t = e.target;
        if (t.matches('[data-close]') || t === dlg) dlg.close();
        const tab = t.closest('[data-tab]');
        if (tab) {
          dlg.querySelectorAll('[data-tab]').forEach(b => { b.classList.remove('bg-[#ec7c00]','text-white','font-semibold'); b.classList.add('text-slate-600','font-medium'); });
          tab.classList.remove('text-slate-600','font-medium');
          tab.classList.add('bg-[#ec7c00]','text-white','font-semibold');
          dlg.querySelectorAll('[data-pane]').forEach(p => p.classList.add('hidden'));
          dlg.querySelector('[data-pane="' + tab.dataset.tab + '"]').classList.remove('hidden');
        }
      });
    })();
  </script>
</dialog>
