---
/**
 * V3 Parent Decision Card — фокус на пользу для ребёнка через bullet-список «подходит, если...».
 * Логика идентична оригиналу. A/B-тест.
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
  /** Кастомный список выгод. Если не указан — используются дефолтные по statusType */
  benefits?: string[];
}
const { shift, benefits } = Astro.props;

const isShort = shift.statusType === 'short';
const popular = shift.popular;

// Дефолтные benefits по типу смены
const defaultBenefits = isShort
  ? ['быстрый вход в тему', 'свой проект за 7 дней', 'без перегруза и стресса']
  : popular
    ? ['больше самостоятельности', 'полноценный проект от идеи до результата', 'спокойный темп без спешки']
    : ['мягкий старт в проектной работе', 'понятный результат за короткий срок', 'поддержку на каждом этапе'];

const items = benefits && benefits.length ? benefits : defaultBenefits;
---

<div class={`rounded-[18px] border bg-white p-5 md:p-6 transition-all ${popular ? 'border-2 border-[#ec9b44]' : 'border-slate-200'}`}>
  {popular && (
    <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#ec9b44] px-2.5 py-1 text-[11px] font-bold text-white">
      <i class="bi bi-fire text-[12px]" aria-hidden="true"></i>
      Популярная
    </div>
  )}

  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-[20px] font-bold text-slate-900">{shift.name}</h3>
      <p class="mt-1 text-[13px] text-slate-500">{shift.dates} · {shift.duration}</p>
    </div>
    <span class={`shrink-0 rounded-full px-2.5 py-1 text-[12px] font-medium ${isShort ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
      {isShort ? 'короткая' : shift.status}
    </span>
  </div>

  <p class="mt-4 text-[14px] font-medium text-slate-800">Подходит, если вы хотите:</p>
  <ul class="mt-2 space-y-1.5">
    {items.map((b) => (
      <li class="flex items-start gap-2 text-[14px] text-slate-700 leading-[1.5]">
        <i class="bi bi-check2-circle text-emerald-500 text-[15px] shrink-0 mt-[3px]" aria-hidden="true"></i>
        <span>{b}</span>
      </li>
    ))}
  </ul>

  <div class="mt-5 flex items-center justify-between">
    <div>
      <div class="text-[22px] font-bold text-[#ec9b44]">{shift.price}</div>
    </div>
    <p class="text-[12px] text-slate-500">Осталось {shift.free} мест</p>
  </div>

  <button type="button" data-shift-link={shift.id} class={`mt-4 w-full rounded-[10px] px-5 py-3 text-[14px] font-semibold transition-colors ${shift.free > 0 ? 'bg-[#ec9b44] text-white hover:bg-[#d67000]' : 'bg-slate-200 text-slate-500 cursor-not-allowed'}`}>
    Выбрать смену
  </button>
</div>
