---
/**
 * V1 Premium Minimal — премиальный минималистичный вариант ShiftCard для A/B-теста.
 * Логика идентична оригиналу: те же data-shift-link и кнопка «Выбрать смену».
 */
import type { Shift } from '../../data/shifts';

interface Props {
  shift: Shift;
}
const { shift } = Astro.props;

const isShort = shift.statusType === 'short';
const popular = shift.popular;
---

<div class={`rounded-[18px] border bg-white p-6 transition-all ${popular ? 'border-2 border-[#ec9b44] shadow-[0_8px_24px_rgba(236,155,68,0.18)]' : 'border-slate-200 hover:border-slate-300'}`}>
  {popular && (
    <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#ec9b44] px-2.5 py-1 text-[11px] font-bold text-white">
      <i class="bi bi-fire text-[12px]" aria-hidden="true"></i>
      Популярная
    </div>
  )}
  {isShort && !popular && (
    <div class="mb-3 text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-700">Короткие смены</div>
  )}

  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-[22px] font-bold leading-[1.1] tracking-[-0.01em] text-slate-900">{shift.name}</h3>
      <p class="mt-1.5 text-[14px] text-slate-500">{shift.dates} · {shift.duration}</p>
    </div>
    <span class={`shrink-0 rounded-full px-2.5 py-1 text-[12px] font-medium ${isShort ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>{shift.status}</span>
  </div>

  <p class="mt-4 text-[14px] leading-[1.55] text-slate-600">{shift.description}</p>

  <div class="mt-5 text-[26px] font-bold text-[#ec9b44]">{shift.price}</div>
  <p class="mt-1 flex items-center gap-1.5 text-[13px] text-emerald-700">
    <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
    Осталось {shift.free} {shift.free === 1 ? 'место' : shift.free < 5 ? 'места' : 'мест'}
  </p>

  <div class="mt-5 flex items-center gap-3">
    <button type="button" data-shift-link={shift.id} class={`flex-1 rounded-[10px] px-5 py-3 text-[14px] font-semibold transition-colors ${shift.free > 0 ? 'bg-[#ec9b44] text-white hover:bg-[#d67000]' : 'bg-slate-200 text-slate-500 cursor-not-allowed'}`}>
      Выбрать смену
    </button>
    <a href={`#shift-${shift.id}`} class="text-[14px] text-slate-500 hover:text-slate-800 transition-colors whitespace-nowrap">
      Подробнее →
    </a>
  </div>
</div>
