---
/**
 * ShortShiftsBlock — раскрывающийся блок коротких смен (2.1, 2.2).
 * По концепту shift-story_2.html: внизу под основными карточками,
 * collapsed по умолчанию.
 */
import type { Shift } from '../../data/shifts';
import { getCurrentPrice, getTaxDeduction, fmtPrice } from '../../data/dynamicPrices';

interface Props {
  shifts: Shift[];
}

const { shifts } = Astro.props;
const prices = shifts.map(s => getCurrentPrice(s.id) ?? parseInt(s.price.replace(/\D/g, ''), 10)).filter(n => n > 0);
const minPrice = Math.min(...prices);
const minPriceFmt = fmtPrice(minPrice);

function getVychet(id: string) { return getTaxDeduction(id); }
function getSsrPrice(s: Shift) { return getCurrentPrice(s.id) ?? parseInt(s.price.replace(/\D/g, ''), 10); }
const durations = [...new Set(shifts.map((s) => s.duration.replace(/[^\d]/g, '')))].join('–');
---

<div
  class="reveal mt-6 rounded-2xl border border-border-light bg-card shadow-[0_2px_8px_rgba(15,23,42,0.06),0_12px_32px_rgba(15,23,42,0.10)] hover:shadow-[0_4px_12px_rgba(15,23,42,0.08),0_18px_44px_rgba(15,23,42,0.14)] transition-shadow duration-200"
  data-short-shifts
>
  <button
    type="button"
    data-short-toggle
    aria-expanded="false"
    aria-controls="short-shifts-panel"
    class="flex w-full items-center gap-3 px-5 py-4 md:px-6 cursor-pointer text-left group"
  >
    <div class="shrink-0 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-primary-100)] text-[var(--color-primary-700)]">
      <i class="bi bi-lightning-charge-fill text-base" aria-hidden="true"></i>
    </div>
    <div class="text-left flex-1 min-w-0">
      <p class="text-base md:text-[16px] font-bold text-body">Короткие смены · {durations} дней</p>
      <p class="mt-0.5 text-base md:text-base text-body-muted">{shifts.map((s) => s.name).join(' и ')} · от {minPriceFmt}</p>
    </div>
    <i class="bi bi-chevron-down text-[16px] text-body-faint transition-transform duration-200 shrink-0" data-short-chevron aria-hidden="true"></i>
  </button>

  <div id="short-shifts-panel" data-short-panel class="hidden border-t border-border-light">
    {shifts.map((s) => (
      <a
        href={`/shifts/${s.id}/`}
        class="block border-t border-border-light first:border-t-0 hover:bg-primary/5 transition-colors no-underline group/row"
      >
        <div class="flex items-center justify-between gap-3 px-5 py-3.5 md:px-6">
          <div class="min-w-0 flex-1">
            <p class="text-base md:text-base font-semibold text-body group-hover/row:text-primary transition-colors leading-snug">{s.dates}</p>
            <p class="mt-0.5 text-[12px] text-body-muted leading-snug">{s.name} · {s.duration} · {s.free} мест</p>
          </div>
          <div class="flex items-center gap-2.5 shrink-0">
            <div class="text-right">
              <p class="text-base md:text-[16px] font-bold text-primary tabular-nums leading-none" data-dynamic-price={s.id}>{fmtPrice(getSsrPrice(s))}</p>
              <span class="hidden text-[10px] font-semibold text-orange-500 leading-snug" data-price-stage={s.id}></span>
              {getVychet(s.id) > 0 && (
                <p class="mt-0.5 text-[10px] text-slate-400 leading-snug">
                  <i class="bi bi-arrow-counterclockwise text-[9px]" aria-hidden="true"></i>
                  {' '}вернёте ~<a href="/nalogovyj-vychet/" class="underline" onclick="event.stopPropagation()">{getVychet(s.id).toLocaleString('ru-RU')} ₽</a>
                </p>
              )}
            </div>
            <i class="bi bi-arrow-right text-base text-body-faint group-hover/row:text-primary group-hover/row:translate-x-0.5 transition-all shrink-0" aria-hidden="true"></i>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  function initShortShifts() {
    const root = document.querySelector<HTMLElement>('[data-short-shifts]');
    const toggle = root?.querySelector<HTMLButtonElement>('[data-short-toggle]');
    const panel = root?.querySelector<HTMLElement>('[data-short-panel]');
    const chevron = root?.querySelector<HTMLElement>('[data-short-chevron]');
    if (!toggle || !panel) return;
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!open));
      if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
    });
  }
  document.addEventListener('astro:page-load', initShortShifts);
  initShortShifts();
</script>
