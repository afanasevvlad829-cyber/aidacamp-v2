---
/**
 * ShiftTimeline — sticky-photo + timeline этапов смены.
 * Концепт: shift-story_2.html .timeline-wrapper
 *
 * Адаптивен под длительность смены (durationDays):
 *   - 7 дней: День 1 / Дни 2-3 / Дни 4-5 / День 6 / День 7
 *   - 10 дней: День 1 / Дни 2-3 / Дни 4-7 / День 8-9 / День 10
 *   - 14 дней: День 1 / Дни 2-4 / Дни 5-9 / Дни 10-12 / День 13-14
 *
 * Desktop: 2 колонки, sticky photo слева
 * Mobile: 1 колонка
 */
interface Props {
  durationDays?: number;
}

const { durationDays = 14 } = Astro.props;

// Короткие смены (≤8 дней) = 4 этапа без хакатона
// Длинные (10+) = 5 этапов с хакатоном
const isShort = durationDays <= 8;

function computeMilestoneDays(d: number, short: boolean) {
  if (short) {
    // 4 этапа: приезд / середина / финал-сборка / защита
    const m1End = Math.max(2, Math.floor(d * 0.4));
    const m2End = Math.floor(d * 0.75);
    return [
      { label: 'День 1' },
      { label: `Дни 2–${m1End}` },
      { label: `Дни ${m1End + 1}–${m2End}` },
      { label: `День ${d}` },
    ];
  }
  if (d <= 10) {
    const m1End = Math.floor(d * 0.3);
    const m2End = Math.floor(d * 0.7);
    return [
      { label: 'День 1' },
      { label: `Дни 2–${m1End}` },
      { label: `Дни ${m1End + 1}–${m2End}` },
      { label: `День ${m2End + 1}–${d - 1}` },
      { label: `День ${d}` },
    ];
  }
  const m1End = Math.floor(d * 0.28);
  const m2End = Math.floor(d * 0.65);
  const m3End = Math.floor(d * 0.85);
  return [
    { label: 'День 1' },
    { label: `Дни 2–${m1End}` },
    { label: `Дни ${m1End + 1}–${m2End}` },
    { label: `Дни ${m2End + 1}–${m3End}` },
    { label: `Дни ${m3End + 1}–${d}` },
  ];
}

const days = computeMilestoneDays(durationDays, isShort);

const milestones = isShort
  ? [
      {
        day: days[0].label,
        title: 'Приезд и знакомство',
        text: 'Заезд утром, группы по возрасту. К вечеру первого дня каждый видит результат на экране.',
        photo: '/images/gallery/shift-timeline-5.avif',
        photoAlt: 'Корпуса и территория лагеря',
      },
      {
        day: days[1].label,
        title: 'Проект обретает форму',
        text: 'Выбор идеи: игра, AI-приложение или чат-бот. Базовые механики добавляются за 2-3 занятия.',
        photo: '/images/gallery/shift-timeline-4.avif',
        photoAlt: 'Дети на занятии программированием',
      },
      {
        day: days[2].label,
        title: 'Сборка и финиш',
        text: 'Проект собирается в готовую версию. Параллельно — бассейн, спорт, настолки.',
        photo: '/images/gallery/shift-timeline-3.avif',
        photoAlt: 'Бассейн',
      },
      {
        day: days[3].label,
        title: 'Защита и домой',
        text: 'Защита перед родителями, проект уезжает домой. А вечером перед отъездом — браслеты-дружбы: на память друг о друге, чтобы не забывать новых друзей.',
        photo: '/images/gallery/shift-timeline-1.avif',
        photoAlt: 'Дети плетут браслеты-дружбы перед отъездом',
      },
    ]
  : [
      {
        day: days[0].label,
        title: 'Приезд и знакомство',
        text: 'Заезд утром, группы по возрасту. К вечеру первого дня каждый видит результат на экране.',
        photo: '/images/gallery/shift-timeline-5.avif',
        photoAlt: 'Корпуса и территория лагеря',
      },
      {
        day: days[1].label,
        title: 'Проект обретает форму',
        text: 'Выбор идеи: игра, AI-приложение или чат-бот. Базовые механики добавляются за 2-3 занятия.',
        photo: '/images/gallery/shift-timeline-4.avif',
        photoAlt: 'Дети на занятии программированием',
      },
      {
        day: days[2].label,
        title: 'Уже есть что запустить',
        text: 'Проект работает в базовой версии. Параллельно — бассейн, спорт, настолки.',
        photo: '/images/gallery/shift-timeline-3.avif',
        photoAlt: 'Бассейн',
      },
      {
        day: days[3].label,
        title: 'Хакатон',
        text: 'Команды доводят проект до финальной версии. Менторы помогают, дети сами решают что важно.',
        photo: '/images/gallery/shift-timeline-2.avif',
        photoAlt: 'Защита проекта в формате хакатона',
      },
      {
        day: days[4].label,
        title: 'Защита и домой',
        text: 'Защита перед родителями, проект уезжает домой. А вечером перед отъездом — браслеты-дружбы: на память друг о друге, чтобы не забывать новых друзей.',
        photo: '/images/gallery/shift-timeline-1.avif',
        photoAlt: 'Дети плетут браслеты-дружбы перед отъездом',
      },
    ];
---

<section>
  <div class="mx-auto max-w-[1200px] px-5 pt-6 md:px-8 md:pt-10">
    <div class="text-center mb-10 md:mb-14">
      <p class="reveal text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 mb-3">{durationDays} дней — день за днём</p>
      <h2 class="reveal text-[28px] md:text-[42px] font-bold leading-[1.15] tracking-[-0.02em] text-body">
        Как смена выглядит<br><span class="text-primary">изнутри</span>
      </h2>
    </div>
  </div>

  <!-- MOBILE: stacked cards -->
  <div class="md:hidden mx-auto max-w-[1200px] px-5 pb-12 space-y-6">
    {milestones.map((m, i) => (
      <article class="reveal" data-reveal-delay={i * 60}>
        <div class="mb-4 overflow-hidden rounded-[18px] aspect-[16/10] card-shadow">
          <img src={m.photo} alt={m.photoAlt} title={m.title} class="h-full w-full object-cover" loading="lazy" />
        </div>
        <p class="text-[22px] font-bold uppercase tracking-[0.18em] text-primary mb-2">{m.day}</p>
        <h3 class="text-[20px] font-bold tracking-[-0.01em] text-body leading-[1.2] mb-2">{m.title}</h3>
        <p class="text-base leading-[1.55] text-body-muted">{m.text}</p>
      </article>
    ))}
  </div>

  <!-- DESKTOP: pinned scroll-driven storyteller -->
  <div class="hidden md:block relative" data-timeline-pinned style={`height: ${milestones.length * 100}vh`}>
    <div class="sticky top-0 h-screen flex items-center overflow-hidden">
      <div class="mx-auto max-w-[1200px] w-full px-8 grid grid-cols-[1fr_1.2fr] gap-12 items-center">
        <!-- LEFT: photo stack -->
        <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[24px] card-shadow">
          {milestones.map((m, i) => (
            <img
              src={m.photo}
              alt={m.photoAlt}
              title={m.title}
              data-pin-photo={i}
              class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5 pointer-events-none">
            <p data-pin-caption class="text-base text-white/90 font-medium">{milestones[0].photoAlt}</p>
          </div>
        </div>

        <!-- RIGHT: текст-слайды + список с подсветкой -->
        <div class="relative">
          <!-- Активный слайд (overlay одного на месте другого) -->
          <div class="grid">
            {milestones.map((m, i) => (
              <div
                data-pin-slide={i}
                class={`col-start-1 row-start-1 transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
              >
                <p class="text-[24px] font-bold uppercase tracking-[0.18em] text-primary mb-3">{m.day}</p>
                <h3 class="text-[28px] lg:text-[34px] font-bold tracking-[-0.02em] text-body leading-[1.15] mb-4">{m.title}</h3>
                <p class="text-[17px] leading-[1.55] text-body-muted max-w-[520px]">{m.text}</p>
              </div>
            ))}
          </div>

          <!-- Прогресс-список этапов -->
          <ol class="mt-10 space-y-2">
            {milestones.map((m, i) => (
              <li>
                <button
                  type="button"
                  data-pin-jump={i}
                  class={`w-full text-left flex items-center gap-3 py-2 transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-50 hover:opacity-80'}`}
                  aria-label={`Перейти к этапу: ${m.title}`}
                >
                  <span data-pin-bar={i} class={`block h-[2px] rounded-full transition-all duration-500 ${i === 0 ? 'w-12 bg-primary' : 'w-6 bg-border-light'}`}></span>
                  <span class="text-[16px] font-medium text-body-muted whitespace-nowrap">{m.day} · {m.title}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initShiftTimeline() {
    const pinned = document.querySelector<HTMLElement>('[data-timeline-pinned]');
    if (!pinned) return;
    const timeline = pinned;
    const photos = pinned.querySelectorAll<HTMLImageElement>('[data-pin-photo]');
    const slides = pinned.querySelectorAll<HTMLElement>('[data-pin-slide]');
    const bars = pinned.querySelectorAll<HTMLElement>('[data-pin-bar]');
    const buttons = pinned.querySelectorAll<HTMLButtonElement>('[data-pin-jump]');
    const caption = pinned.querySelector<HTMLElement>('[data-pin-caption]');
    const N = photos.length;
    if (!N) return;

    let current = -1;

    function setActive(idx: number) {
      if (idx === current) return;
      current = idx;
      photos.forEach((p, i) => { p.style.opacity = i === idx ? '1' : '0'; });
      slides.forEach((s, i) => {
        s.style.opacity = i === idx ? '1' : '0';
        s.classList.toggle('pointer-events-none', i !== idx);
      });
      bars.forEach((b, i) => {
        b.className = `block h-[2px] rounded-full transition-all duration-500 ${i === idx ? 'w-12 bg-primary' : 'w-6 bg-border-light'}`;
      });
      buttons.forEach((btn, i) => {
        btn.style.opacity = i === idx ? '1' : '0.5';
      });
      if (caption && photos[idx]) caption.textContent = photos[idx].alt;
    }

    function update() {
      const rect = timeline.getBoundingClientRect();
      const total = timeline.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const scrolled = Math.max(0, Math.min(total, -rect.top));
      const progress = scrolled / total;
      // равные сегменты: i ∈ [0..N-1]
      const idx = Math.min(N - 1, Math.max(0, Math.floor(progress * N)));
      setActive(idx);
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const total = timeline.offsetHeight - window.innerHeight;
        const segment = total / N;
        const target = timeline.offsetTop + segment * i + segment / 2;
        window.scrollTo({ top: target, behavior: 'smooth' });
      });
    });

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    // Defer initial layout read — #shifts has content-visibility:auto, so calling
    // update() synchronously breaks the skip and causes forced reflow. At scroll=0
    // the first slide is always active, so setActive(0) is sufficient here.
    setActive(0);
  }
  document.addEventListener('astro:page-load', initShiftTimeline);
  // Defer — timeline ниже fold, не блокируем LCP
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initShiftTimeline, { timeout: 2000 });
  } else {
    setTimeout(initShiftTimeline, 200);
  }
</script>
