---
/**
 * ShiftTimeline — sticky-photo + timeline этапов смены.
 * Концепт: shift-story_2.html .timeline-wrapper
 *
 * Адаптивен под длительность смены (durationDays):
 *   - 7 дней: День 1 / Дни 2-3 / Дни 4-5 / День 6 / День 7
 *   - 10 дней: День 1 / Дни 2-3 / Дни 4-7 / День 8-9 / День 10
 *   - 14 дней: День 1 / Дни 2-4 / Дни 5-9 / Дни 10-12 / День 13-14
 *
 * Desktop: 2 колонки, sticky photo слева
 * Mobile: 1 колонка
 */
interface Props {
  durationDays?: number;
}

const { durationDays = 14 } = Astro.props;

// Короткие смены (≤8 дней) = 4 этапа без хакатона
// Длинные (10+) = 5 этапов с хакатоном
const isShort = durationDays <= 8;

function computeMilestoneDays(d: number, short: boolean) {
  if (short) {
    // 4 этапа: приезд / середина / финал-сборка / защита
    const m1End = Math.max(2, Math.floor(d * 0.4));
    const m2End = Math.floor(d * 0.75);
    return [
      { label: 'День 1' },
      { label: `Дни 2–${m1End}` },
      { label: `Дни ${m1End + 1}–${m2End}` },
      { label: `День ${d}` },
    ];
  }
  if (d <= 10) {
    const m1End = Math.floor(d * 0.3);
    const m2End = Math.floor(d * 0.7);
    return [
      { label: 'День 1' },
      { label: `Дни 2–${m1End}` },
      { label: `Дни ${m1End + 1}–${m2End}` },
      { label: `День ${m2End + 1}–${d - 1}` },
      { label: `День ${d}` },
    ];
  }
  const m1End = Math.floor(d * 0.28);
  const m2End = Math.floor(d * 0.65);
  const m3End = Math.floor(d * 0.85);
  return [
    { label: 'День 1' },
    { label: `Дни 2–${m1End}` },
    { label: `Дни ${m1End + 1}–${m2End}` },
    { label: `Дни ${m2End + 1}–${m3End}` },
    { label: `Дни ${m3End + 1}–${d}` },
  ];
}

const days = computeMilestoneDays(durationDays, isShort);

const milestones = isShort
  ? [
      {
        day: days[0].label,
        title: 'Приезд и знакомство',
        text: 'Заезд утром, группы по возрасту. К вечеру первого дня каждый видит результат на экране.',
        photo: '/images/gallery/shift-timeline-5.avif',
        photoAlt: 'Корпуса и территория лагеря',
      },
      {
        day: days[1].label,
        title: 'Проект обретает форму',
        text: 'Выбор идеи: игра, AI-приложение или чат-бот. Базовые механики добавляются за 2-3 занятия.',
        photo: '/images/gallery/shift-timeline-4.avif',
        photoAlt: 'Дети на занятии программированием',
      },
      {
        day: days[2].label,
        title: 'Сборка и финиш',
        text: 'Проект собирается в готовую версию. Параллельно — бассейн, спорт, настолки.',
        photo: '/images/gallery/shift-timeline-3.avif',
        photoAlt: 'Бассейн',
      },
      {
        day: days[3].label,
        title: 'Защита и домой',
        text: 'Защита перед родителями, проект уезжает домой. А вечером перед отъездом — браслеты-дружбы: на память друг о друге, чтобы не забывать новых друзей.',
        photo: '/images/gallery/shift-timeline-1.avif',
        photoAlt: 'Дети плетут браслеты-дружбы перед отъездом',
      },
    ]
  : [
      {
        day: days[0].label,
        title: 'Приезд и знакомство',
        text: 'Заезд утром, группы по возрасту. К вечеру первого дня каждый видит результат на экране.',
        photo: '/images/gallery/shift-timeline-5.avif',
        photoAlt: 'Корпуса и территория лагеря',
      },
      {
        day: days[1].label,
        title: 'Проект обретает форму',
        text: 'Выбор идеи: игра, AI-приложение или чат-бот. Базовые механики добавляются за 2-3 занятия.',
        photo: '/images/gallery/shift-timeline-4.avif',
        photoAlt: 'Дети на занятии программированием',
      },
      {
        day: days[2].label,
        title: 'Уже есть что запустить',
        text: 'Проект работает в базовой версии. Параллельно — бассейн, спорт, настолки.',
        photo: '/images/gallery/shift-timeline-3.avif',
        photoAlt: 'Бассейн',
      },
      {
        day: days[3].label,
        title: 'Хакатон',
        text: 'Команды доводят проект до финальной версии. Менторы помогают, дети сами решают что важно.',
        photo: '/images/gallery/shift-timeline-2.avif',
        photoAlt: 'Защита проекта в формате хакатона',
      },
      {
        day: days[4].label,
        title: 'Защита и домой',
        text: 'Защита перед родителями, проект уезжает домой. А вечером перед отъездом — браслеты-дружбы: на память друг о друге, чтобы не забывать новых друзей.',
        photo: '/images/gallery/shift-timeline-1.avif',
        photoAlt: 'Дети плетут браслеты-дружбы перед отъездом',
      },
    ];
---

<section class="mx-auto max-w-[1200px] px-5 py-12 md:px-8 md:py-20">
  <div class="text-center mb-10 md:mb-14">
    <p class="reveal text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 mb-3">{durationDays} дней — день за днём</p>
    <h2 class="reveal text-[28px] md:text-[42px] font-bold leading-[1.15] tracking-[-0.02em] text-body">
      Как смена выглядит<br><span class="text-primary">изнутри</span>
    </h2>
  </div>

  <div class="shift-timeline grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-12">
    <!-- LEFT: Sticky photo (desktop only) -->
    <div class="hidden md:block">
      <div class="sticky top-24">
        <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[24px] shadow-[0_4px_12px_rgba(15,23,42,0.08),0_24px_56px_rgba(15,23,42,0.18)]">
          {milestones.map((m, i) => (
            <img
              src={m.photo}
              alt={m.photoAlt}
              data-timeline-photo={i}
              class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              loading="lazy"
            />
          ))}
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5">
            <p data-timeline-caption class="text-[13px] text-white/85 font-medium" />
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Milestones -->
    <div class="space-y-6 md:space-y-10">
      {milestones.map((m, i) => (
        <article class="reveal milestone-card" data-timeline-target={i} data-reveal-delay={i * 60}>
          <div class="md:hidden mb-4 overflow-hidden rounded-[18px] aspect-[16/10] shadow-[0_4px_12px_rgba(15,23,42,0.08),0_24px_56px_rgba(15,23,42,0.18)]">
            <img src={m.photo} alt={m.photoAlt} class="h-full w-full object-cover" loading="lazy" />
          </div>

          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary mb-2">{m.day}</p>
          <h3 class="text-[20px] md:text-[24px] font-bold tracking-[-0.01em] text-body leading-[1.2] mb-2">{m.title}</h3>
          <p class="text-[15px] md:text-[16px] leading-[1.55] text-body-muted">{m.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function initShiftTimeline() {
    const photos = document.querySelectorAll<HTMLImageElement>('[data-timeline-photo]');
    const targets = document.querySelectorAll<HTMLElement>('[data-timeline-target]');
    const captionEl = document.querySelector<HTMLElement>('[data-timeline-caption]');
    if (!photos.length || !targets.length) return;
    if (captionEl && photos[0]) captionEl.textContent = (photos[0] as HTMLImageElement).alt;

    function showPhoto(idx: number) {
      photos.forEach((p, i) => { p.style.opacity = i === idx ? '1' : '0'; });
      if (captionEl && photos[idx]) captionEl.textContent = (photos[idx] as HTMLImageElement).alt;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Number((entry.target as HTMLElement).dataset.timelineTarget);
            showPhoto(idx);
          }
        });
      },
      { threshold: 0.5, rootMargin: '0px 0px -40% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }
  document.addEventListener('astro:page-load', initShiftTimeline);
  initShiftTimeline();
</script>
