---
import type { Shift } from '../../data/shifts';
import { renderCard, PEER_COUNTS } from '../../data/shifts';
import { pluralDays } from '../../utils/plural';
import { getTaxDeduction, getCurrentPrice, getNextDayPrice, getDays, fmtPrice } from '../../data/dynamicPrices';

interface Props {
  shift: Shift;
  variant: 'mobile' | 'desktop';
}

const { shift, variant } = Astro.props;
const { pct, btnClass } = renderCard(shift);

// Актуальная цена и налоговый вычет — из единого источника
const vychetAmount = getTaxDeduction(shift.id);
const ssrPrice     = getCurrentPrice(shift.id);
const ssrPriceFmt  = ssrPrice ? fmtPrice(ssrPrice) : shift.price;

const isMobile = variant === 'mobile';
const isLowAvailability = pct >= 85;

// Номер смены: 'shift-3' → '3', 'shift-2-1' → '2.1'
const shiftNum = shift.id.replace('shift-', '').replace('-', '.');

// Предупреждение о росте цены: показываем только до старта инкремента
const PRICE_INCREMENT_WARN: Record<string, { date: string; label: string; increment: string }> = {
  'shift-3': { date: '2026-07-01', label: '1 июля', increment: '+500 ₽/день' },
  'shift-4': { date: '2026-07-10', label: '10 июля', increment: '+300 ₽/день' },
};
const todayISO = new Date().toISOString().slice(0, 10);
const priceWarn = PRICE_INCREMENT_WARN[shift.id];
const showPriceWarn = priceWarn && todayISO < priceWarn.date;

// Eyebrow с месяцами по диапазону дат
const monthsRu: Record<string, string> = {
  '01': 'Январь', '02': 'Февраль', '03': 'Март', '04': 'Апрель',
  '05': 'Май', '06': 'Июнь', '07': 'Июль', '08': 'Август',
  '09': 'Сентябрь', '10': 'Октябрь', '11': 'Ноябрь', '12': 'Декабрь',
};
const startMonthKey = shift.startDate?.split('-')[1] ?? '';
const endMonthKey = shift.endDate?.split('-')[1] ?? '';
const eyebrowMonths = startMonthKey === endMonthKey
  ? monthsRu[startMonthKey] ?? ''
  : `${monthsRu[startMonthKey] ?? ''} — ${monthsRu[endMonthKey] ?? ''}`;

// Urgency: цена растёт завтра
const nextDayPrice = getNextDayPrice(shift.id);
const priceGrowsToday = nextDayPrice !== null;
const priceGrowsDiff = nextDayPrice && ssrPrice ? nextDayPrice - ssrPrice : 0;

// Ring/border вариант
const ringCls = shift.nearest
  ? 'ring-2 ring-primary border-transparent shadow-[0_0_0_4px_rgba(236,124,0,0.12)]'
  : shift.popular
    ? 'ring-2 ring-primary/70 border-transparent'
    : isLowAvailability
      ? 'ring-1 ring-primary/40 border-primary/30'
      : 'border-border-light';

// Mobile vs desktop wrapper sizing
const sizeCls = isMobile
  ? 'min-w-[calc(100vw-48px)] max-w-[calc(100vw-48px)] shrink-0 snap-start'
  : '';

// Total
const total = shift.occupied + shift.free || 1;
const occupiedLabel = `${shift.occupied} из ${total}`;
const freeLabel = isLowAvailability
  ? `Осталось ${shift.free}`
  : `Свободно ${shift.free}`;

// Status pill (правый верхний угол) — не показываем для nearest (info уже в баннере)
const statusPill = shift.nearest ? null
  : shift.statusType === 'short'
    ? { text: 'короткая', cls: 'bg-[var(--color-primary-100)] text-[var(--color-primary-700)]' }
    : isLowAvailability
      ? { text: `Осталось ${shift.free}`, cls: 'bg-orange-100 text-orange-700 font-bold' }
      : shift.free >= 10
        ? { text: `${shift.free} мест`, cls: 'bg-emerald-100 text-emerald-700' }
        : null;

// CTA — primary (orange) для nearest/popular/low_avail, иначе ghost (Что внутри смены)
const isPrimaryCta = shift.nearest || shift.popular || isLowAvailability;

// Countdown для nearest-смены
const today = new Date();
const startDate = shift.startDate ? new Date(shift.startDate + 'T00:00:00') : null;
const daysLeft = startDate
  ? Math.max(0, Math.ceil((startDate.getTime() - today.getTime()) / 86_400_000))
  : null;
---

<article
  data-shift-card
  data-shift-id={shift.id}
  data-shift-spots={shift.free}
  data-shift-days={getDays(shift.id)}
  class:list={[
    'reveal group relative flex flex-col rounded-[22px] border bg-card cursor-pointer select-none transition-none',
    'card-shadow',
    !isMobile && 'card-shadow-hover',
    'p-5 md:p-6',
    sizeCls,
    ringCls,
  ]}
>
  <!-- NEAREST BANNER -->
  {shift.nearest && (
    <div class="-mx-5 -mt-5 mb-4 md:-mx-6 md:-mt-6 flex items-center gap-2 rounded-t-[20px] bg-primary px-5 py-2.5 md:px-6">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/25 text-base font-extrabold text-white shrink-0">{shiftNum}</span>
      <span class="text-base font-bold text-white">Ближайшая</span>
      {daysLeft !== null && daysLeft > 0 && (
        <span class="ml-auto text-[12px] text-white/75 whitespace-nowrap">через {daysLeft}&nbsp;{pluralDays(daysLeft)}</span>
      )}
    </div>
  )}

  <!-- HEADER: circle + month | status pill -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-base font-extrabold text-primary leading-none shrink-0">{shiftNum}</span>
      <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-body-faint truncate">{eyebrowMonths}</p>
    </div>
    {statusPill && (
      <span class:list={[
        'shrink-0 inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-bold',
        statusPill.cls,
      ]} data-spots-pill={statusPill.text.startsWith('Осталось') ? shift.free : undefined}>{statusPill.text}</span>
    )}
  </div>

  <!-- DATES + DURATION: одна строка, не переносится -->
  <h3 class="text-[18px] font-extrabold tracking-[-0.02em] leading-[1.1] text-body whitespace-nowrap overflow-hidden text-ellipsis">
    {shift.dates}
  </h3>
  <p class="mt-0.5 text-base text-body-muted">{shift.duration}</p>

  <!-- OCCUPANCY BAR — скрыто блюром до клика «узнать места» (раскрытие на сессию, синхронно по data-occ-shift) -->
  <div class="mt-4 relative min-h-[40px]" data-occupancy data-occ-shift={shift.id}>
    <div data-occ-content class="occ-cover transition-[filter,opacity] duration-300">
      <div class="flex justify-between text-[12px] mb-1.5">
        <span class="text-body-faint whitespace-nowrap" data-occ-status-slot data-occ-default="Занято">Занято</span>
        <span data-occ-num class:list={['font-semibold', isLowAvailability ? 'text-primary' : 'text-emerald-600']}>
          {isLowAvailability
            ? <Fragment>Осталось <span data-count-to={shift.free}>{shift.free}</span></Fragment>
            : <Fragment><span data-count-to={shift.occupied}>{shift.occupied}</span> из {total}</Fragment>
          }
        </span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-border-light">
        <div data-shift-bar class:list={['h-full rounded-full', isLowAvailability ? 'bg-primary' : 'bg-emerald-400']} style={`--bar-pct:${pct}%`}></div>
      </div>
    </div>
    <button type="button" data-occ-reveal
      class="absolute inset-0 z-10 flex items-center justify-center gap-1.5 rounded-lg text-[12px] font-semibold text-primary hover:text-primary-hover transition-colors"
      aria-label="Узнать число свободных мест в этой смене">
      <span data-occ-icon class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-primary/40 bg-primary/5">
        <i class="bi bi-search text-[10px]" aria-hidden="true"></i>
      </span>
      <span data-occ-label>узнать места</span>
    </button>
  </div>

  <!-- PRICE -->
  <div class="mt-4 flex-1 flex flex-col justify-end">
    <p class="text-[24px] font-extrabold tracking-[-0.02em] leading-none text-primary" data-dynamic-price={shift.id}>{ssrPriceFmt}</p>
    {priceGrowsToday && (
      <p class="text-[11px] font-semibold text-orange-500 mt-0.5 flex items-center gap-1">
        <i class="bi bi-graph-up-arrow text-[10px]" aria-hidden="true"></i>
        Завтра +{priceGrowsDiff.toLocaleString('ru-RU')} ₽
      </p>
    )}
    <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5">
      <span class="text-[12px] text-body-faint">всё включено</span>
      {vychetAmount > 0 && (
        <span class="text-[12px] text-slate-400">
          · ↺&nbsp;<a href="/nalogovyj-vychet/" class="underline hover:text-slate-600" data-vychet-link={shift.id}>−{vychetAmount.toLocaleString('ru-RU')} ₽ вычет</a>
        </span>
      )}
    </div>
    {showPriceWarn && (
      <p class="mt-2 inline-flex items-center gap-1 self-start rounded-full bg-orange-50 border border-orange-200 px-2 py-0.5 text-[11px] font-semibold text-orange-600">
        <i class="bi bi-graph-up-arrow text-[10px]" aria-hidden="true"></i>
        С {priceWarn.label} {priceWarn.increment}
      </p>
    )}
  </div>

  {PEER_COUNTS[shift.id] && (
    <div class="peer-count-badge mt-3 hidden items-center gap-1.5 rounded-lg bg-[var(--color-primary-soft)] px-3 py-1.5"
         data-peer-counts={JSON.stringify(PEER_COUNTS[shift.id])}>
      <i class="bi bi-people-fill text-base text-primary shrink-0" aria-hidden="true"></i>
      <span class="peer-count-text text-base font-medium text-[var(--color-primary-text)]"></span>
    </div>
  )}

  <!-- Смотрят сейчас -->
  <p class="mt-3 flex items-center gap-1.5 text-[11px] text-body-faint" data-watchers={shift.id}>
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
    <span data-watchers-count></span>
  </p>

  <!-- CTA: полная ширина снизу -->
  <a
    href={`/shifts/${shift.id}/`}
    data-analytics-goal="shift_card_click"
    data-analytics-label={shift.name}
    class:list={[
      'group/cta mt-4 flex w-full items-center justify-center gap-1.5 rounded-xl py-3 text-base font-semibold transition-colors min-h-[44px] no-underline',
      isPrimaryCta
        ? 'bg-primary hover:bg-primary-hover text-white'
        : 'border border-border bg-transparent hover:border-primary/40 hover:bg-primary/5 text-body-muted hover:text-primary',
    ]}
  >
    {isPrimaryCta ? 'Выбрать' : 'Что внутри?'}
    <i class="bi bi-arrow-right text-base transition-transform group-hover/cta:translate-x-1" aria-hidden="true"></i>
  </a>

</article>

<style>
  /* Счётчик мест скрыт блюром, пока не нажали «узнать места» */
  .occ-cover { filter: blur(5px); opacity: 0.45; }

  /* Загрузка — яркий пульсирующий кружок + статус primary-цветом */
  [data-occ-reveal].occ-loading [data-occ-icon] {
    background: rgb(236, 124, 0);
    border-color: rgb(236, 124, 0);
    color: #fff;
    animation: occ-pulse 0.9s ease-in-out infinite;
  }
  [data-occ-reveal].occ-loading [data-occ-label] { color: rgb(236, 124, 0); }
  @keyframes occ-pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(236, 124, 0, 0.18); }
    50%      { box-shadow: 0 0 0 7px rgba(236, 124, 0, 0.30); }
  }

  /* Раскрытие — pop счётчика + вспышка числа */
  @keyframes occ-pop {
    0%   { transform: scale(0.9); }
    55%  { transform: scale(1.07); }
    100% { transform: scale(1); }
  }
  .occ-pop { animation: occ-pop 0.5s cubic-bezier(0.2, 0.8, 0.3, 1.3); }
  .occ-pop [data-count-to] {
    border-radius: 6px;
    padding: 0 3px;
    animation: occ-glow 1s ease-out;
  }
  @keyframes occ-glow {
    0%   { background: rgba(236, 124, 0, 0.40); box-shadow: 0 0 14px rgba(236, 124, 0, 0.55); }
    100% { background: transparent; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .occ-pop, [data-occ-reveal].occ-loading [data-occ-icon] { animation: none; }
  }
</style>

<script>
  function initShiftCards() {
    // ── Click navigation ──────────────────────────────────────────────────────
    document.querySelectorAll<HTMLElement>('article[data-shift-card]').forEach((card) => {
      if ((card as any).__clickReady) return;
      (card as any).__clickReady = true;

      let startX = 0;
      let startY = 0;

      card.addEventListener('pointerdown', (e) => {
        startX = e.clientX;
        startY = e.clientY;
      });

      card.addEventListener('click', (e) => {
        if ((e.target as Element).closest('button, a')) return;
        const dx = Math.abs(e.clientX - startX);
        const dy = Math.abs(e.clientY - startY);
        if (dx > 8 || dy > 8) return;
        const bookBtn = card.querySelector<HTMLButtonElement>('[data-shift-book]');
        const infoLink = card.querySelector<HTMLAnchorElement>('a[href^="/shifts"]');
        const shiftId = bookBtn?.dataset.shiftBook;
        if (shiftId) {
          window.location.href = `/shifts/${shiftId}/`;
        } else if (infoLink) {
          window.location.href = infoLink.href;
        }
      });
    });

    // ── Progress-bar + counter animate on scroll ──────────────────────────────
    if ((window as any).__shiftBarObserverReady) return;
    (window as any).__shiftBarObserverReady = true;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('[data-shift-bar]').forEach(b => b.classList.add('bar-filled'));
      return;
    }

    function animateCounter(el: HTMLElement) {
      const target = parseInt(el.dataset.countTo || '0', 10);
      if (!target) return;
      const duration = 900;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const barObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target as HTMLElement;
          card.querySelectorAll<HTMLElement>('[data-shift-bar]').forEach(b => b.classList.add('bar-filled'));
          card.querySelectorAll<HTMLElement>('[data-count-to]').forEach(animateCounter);
          barObserver.unobserve(card);
        });
      },
      { threshold: 0.25 }
    );

    document.querySelectorAll<HTMLElement>('article[data-shift-card]').forEach(card => barObserver.observe(card));
  }

  document.addEventListener('astro:page-load', initShiftCards);
  if (document.readyState !== 'loading') initShiftCards();

  // ── Счётчик «смотрят сейчас» ──────────────────────────────────────────────
  function initWatchers() {
    // Базовые числа по смене (чтобы у каждой были разные — привязываем к id)
    const BASE: Record<string, number> = {
      'shift-3': 3, 'shift-4': 3, 'shift-1': 2, 'shift-2': 2,
      'shift-2-1': 2, 'shift-2-2': 2,
    };
    document.querySelectorAll<HTMLElement>('[data-watchers]').forEach(el => {
      const id = el.dataset.watchers!;
      const base = BASE[id] ?? 5;
      const countEl = el.querySelector<HTMLElement>('[data-watchers-count]');
      if (!countEl) return;

      function randomN() {
        return base + Math.floor(Math.random() * 3) - 1;
      }

      function update() {
        const n = Math.max(2, randomN());
        countEl.textContent = `${n} смотрят прямо сейчас`;
      }

      update();
      setInterval(update, 8000 + Math.random() * 4000);
    });
  }

  document.addEventListener('astro:page-load', initWatchers);
  if (document.readyState !== 'loading') initWatchers();

  // Обновляем счётчик дней до Смены 1 динамически
  function updateShift1Days() {
    var el = document.getElementById('shift1-days');
    if (el) {
      var d = Math.ceil((new Date('2026-05-30').getTime() - new Date().getTime()) / 86400000);
      el.textContent = String(Math.max(0, d));
    }
  }
  document.addEventListener('astro:page-load', updateShift1Days);
  updateShift1Days();

  // ── Блюр счётчика мест → клик «узнать места» раскрывает смену ──────────────
  // Гранулярно по смене, синхронно на всех карточках (data-occ-shift).
  // Храним в sessionStorage → повторный заход снова под блюром → снова событие.
  function initOccupancy() {
    const KEY = 'ac:occ_revealed';
    const getRevealed = () => {
      try { return JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch { return []; }
    };
    const saveRevealed = (id: string) => {
      const r = getRevealed();
      if (!r.includes(id)) { r.push(id); try { sessionStorage.setItem(KEY, JSON.stringify(r)); } catch {} }
    };

    const lerp = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
    // Цвет бара по занятости: зелёный → жёлтый → красный
    function colorForPct(p: number) {
      if (p <= 55) {
        const t = p / 55;
        return `rgb(${lerp(22, 234, t)}, ${lerp(163, 179, t)}, ${lerp(74, 8, t)})`;
      }
      const t = Math.min((p - 55) / 35, 1);
      return `rgb(${lerp(234, 220, t)}, ${lerp(179, 38, t)}, ${lerp(8, 38, t)})`;
    }
    const barPct = (bar: HTMLElement | null) => (bar ? parseFloat(bar.style.getPropertyValue('--bar-pct')) || 0 : 0);

    function animateCount(el: HTMLElement) {
      const target = parseInt(el.dataset.countTo || '0', 10);
      const dur = 600, t0 = performance.now();
      function tick(now: number) {
        const t = Math.min((now - t0) / dur, 1);
        el.textContent = String(Math.round((1 - Math.pow(1 - t, 3)) * target));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const STEPS = ['Сверяемся…', 'Запрос в CRM…', 'Сверяем брони…', 'Смотрим отказы…', 'Просроченные брони…'];
    const DUR = 7000;

    // Мгновенное финальное состояние — для уже открытых в этой сессии
    function setFinal(block: HTMLElement) {
      const bar = block.querySelector<HTMLElement>('[data-shift-bar]');
      const pct = barPct(bar);
      if (bar) { bar.style.transition = 'none'; bar.style.width = pct + '%'; bar.style.backgroundColor = colorForPct(pct); }
      block.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => { el.textContent = el.dataset.countTo || '0'; });
      const num = block.querySelector<HTMLElement>('[data-occ-num]');
      if (num) num.style.display = '';
      const slot = block.querySelector<HTMLElement>('[data-occ-status-slot]');
      if (slot) slot.textContent = slot.dataset.occDefault || 'Занято';
    }

    // Драматичный reveal ~2.5 с: статус-цепочка + бар зелёный→жёлтый→красный
    function playReveal(block: HTMLElement) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { setFinal(block); return; }
      const bar = block.querySelector<HTMLElement>('[data-shift-bar]');
      const slot = block.querySelector<HTMLElement>('[data-occ-status-slot]');
      const num = block.querySelector<HTMLElement>('[data-occ-num]');
      const content = block.querySelector<HTMLElement>('[data-occ-content]');
      const finalPct = barPct(bar);

      if (num) num.style.display = 'none';          // число прячем, пока «считаем остаток»
      if (bar) { bar.style.transition = 'none'; bar.style.width = '0%'; bar.style.backgroundColor = colorForPct(0); }

      let si = -1;
      const step = () => { si++; if (slot && si < STEPS.length) slot.innerHTML = `<i class="bi bi-arrow-repeat animate-spin"></i> ${STEPS[si]}`; };
      step();
      const iv = setInterval(step, DUR / STEPS.length);

      const t0 = performance.now();
      function frame(now: number) {
        const t = Math.min((now - t0) / DUR, 1);
        // линейно — бар растёт ровно вместе со статус-шагами, без рывка в начале
        const pct = finalPct * t;
        if (bar) { bar.style.width = pct + '%'; bar.style.backgroundColor = colorForPct(pct); }
        if (t < 1) { requestAnimationFrame(frame); return; }
        clearInterval(iv);
        if (slot) slot.textContent = slot.dataset.occDefault || 'Занято';
        if (num) num.style.display = '';
        block.querySelectorAll<HTMLElement>('[data-count-to]').forEach(animateCount);
        content?.classList.add('occ-pop');
        setTimeout(() => content?.classList.remove('occ-pop'), 700);
      }
      requestAnimationFrame(frame);
    }

    function revealShift(id: string, animate: boolean) {
      document.querySelectorAll<HTMLElement>(`[data-occupancy][data-occ-shift="${id}"]`).forEach((block) => {
        block.querySelector('[data-occ-content]')?.classList.remove('occ-cover');
        block.querySelector('[data-occ-reveal]')?.classList.add('hidden');
        if (animate) playReveal(block); else setFinal(block);
      });
    }

    // На загрузке — раскрываем уже открытые в этой сессии (без анимации)
    getRevealed().forEach((id: string) => revealShift(id, false));

    document.querySelectorAll<HTMLElement>('[data-occ-reveal]').forEach((btn) => {
      if (btn.dataset.occBound) return;
      btn.dataset.occBound = '1';
      // не даём клику всплыть до навигации по карточке
      ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'touchstart', 'touchend'].forEach((ev) =>
        btn.addEventListener(ev, (e) => e.stopPropagation()));
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const block = btn.closest<HTMLElement>('[data-occupancy]');
        const id = block?.dataset.occShift;
        if (!id) return;
        saveRevealed(id);
        revealShift(id, true);
        try { (window as any).ym?.(96499295, 'reachGoal', 'occupancy_check', { shift: id }); } catch {}
      });
    });
  }

  document.addEventListener('astro:page-load', initOccupancy);
  if (document.readyState !== 'loading') initOccupancy();
</script>
