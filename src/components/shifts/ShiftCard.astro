---
import type { Shift } from '../../data/shifts';
import { renderCard, PEER_COUNTS } from '../../data/shifts';

interface Props {
  shift: Shift;
  variant: 'mobile' | 'desktop';
}

const { shift, variant } = Astro.props;
const { pct, btnClass } = renderCard(shift);

const isMobile = variant === 'mobile';
const isLowAvailability = pct >= 85;

// Eyebrow с месяцами по диапазону дат
const monthsRu: Record<string, string> = {
  '01': 'Январь', '02': 'Февраль', '03': 'Март', '04': 'Апрель',
  '05': 'Май', '06': 'Июнь', '07': 'Июль', '08': 'Август',
  '09': 'Сентябрь', '10': 'Октябрь', '11': 'Ноябрь', '12': 'Декабрь',
};
const startMonthKey = shift.startDate?.split('-')[1] ?? '';
const endMonthKey = shift.endDate?.split('-')[1] ?? '';
const eyebrowMonths = startMonthKey === endMonthKey
  ? monthsRu[startMonthKey] ?? ''
  : `${monthsRu[startMonthKey] ?? ''} — ${monthsRu[endMonthKey] ?? ''}`;

// Ring/border вариант
const ringCls = shift.popular
  ? 'ring-2 ring-orange-400 border-transparent'
  : isLowAvailability
    ? 'ring-1 ring-orange-300/60 border-orange-300'
    : 'border-border-light';

// Mobile vs desktop wrapper sizing
const sizeCls = isMobile
  ? 'min-w-[calc(100vw-48px)] max-w-[calc(100vw-48px)] shrink-0 snap-start'
  : '';

// Total
const total = shift.occupied + shift.free || 1;
const occupiedLabel = `${shift.occupied} из ${total}`;
const freeLabel = isLowAvailability
  ? `Осталось ${shift.free}`
  : `Свободно ${shift.free}`;

// Status pill (правый верхний угол): only when много мест ИЛИ короткая
const statusPill = shift.statusType === 'short'
  ? { text: 'короткая', cls: 'bg-orange-100 text-orange-700' }
  : !isLowAvailability && shift.free >= 10
    ? { text: `${shift.free} мест`, cls: 'bg-emerald-100 text-emerald-700' }
    : null;

// CTA — primary (orange) для popular/low_avail, иначе ghost (Что внутри смены)
const isPrimaryCta = shift.popular || isLowAvailability;
---

<article
  data-shift-card
  class:list={[
    'reveal group relative flex flex-col rounded-[22px] border bg-card cursor-pointer select-none transition-all duration-200',
    'shadow-[0_2px_6px_rgba(15,23,42,0.06),0_20px_48px_rgba(15,23,42,0.14)]',
    'hover:shadow-[0_4px_10px_rgba(15,23,42,0.08),0_28px_64px_rgba(15,23,42,0.20)]',
    !isMobile && 'hover:-translate-y-0.5',
    'p-5 md:p-6',
    sizeCls,
    ringCls,
  ]}
>
  <!-- TOP: eyebrow + big dates + duration / right pill -->
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">{eyebrowMonths}</p>
      <h3 class="mt-1.5 text-[26px] md:text-[28px] font-extrabold tracking-[-0.02em] leading-[1.05] text-body">
        {shift.dates.replace('— ', '— ')}
      </h3>
      <p class="mt-1.5 text-[14px] md:text-[13px] text-body-muted">{shift.duration}</p>
    </div>
    {statusPill && (
      <span class:list={[
        'shrink-0 inline-flex items-center rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.06em]',
        statusPill.cls,
      ]}>{statusPill.text}</span>
    )}
  </div>

  <!-- OCCUPANCY: Занято + value + bar -->
  <div class="mt-5">
    <div class="flex justify-between text-[13px] mb-1.5">
      <span class="text-body-muted">Занято</span>
      <span class:list={[
        'font-medium',
        isLowAvailability ? 'text-orange-600' : 'text-emerald-700',
      ]}>{isLowAvailability ? freeLabel : occupiedLabel}</span>
    </div>
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-border-light">
      <div
        class:list={[
          'h-full rounded-full transition-all duration-500',
          isLowAvailability ? 'bg-orange-500' : 'bg-emerald-400',
        ]}
        style={`width:${pct}%`}
      ></div>
    </div>
  </div>

  <!-- PRICE + CTA — flex justify-between -->
  <div class="mt-5 flex items-end justify-between gap-3">
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-body-faint">Стоимость</p>
      <p class="mt-1 text-[26px] md:text-[28px] font-extrabold tracking-[-0.02em] leading-none text-primary">{shift.price}</p>
      <p class="mt-1 text-[12px] text-body-faint">всё включено</p>
    </div>

    {isPrimaryCta ? (
      <button
        type="button"
        data-shift-book={shift.id}
        data-shift-book-name={shift.name}
        data-shift-book-dates={shift.dates}
        data-shift-book-duration={shift.duration}
        data-shift-book-price={shift.price}
        data-analytics-goal="shift_select"
        data-analytics-label={shift.name}
        class="shrink-0 inline-flex items-center gap-1.5 rounded-xl bg-primary hover:bg-primary-hover px-5 py-3 text-[14px] font-semibold text-white transition-colors min-h-[44px]"
      >
        Выбрать
        <i class="bi bi-arrow-right text-[13px]" aria-hidden="true"></i>
      </button>
    ) : (
      <a
        href={`/shifts/${shift.id}/`}
        data-analytics-goal="shift_info_click"
        data-analytics-label={shift.name}
        class="group/cta shrink-0 inline-flex items-center gap-1.5 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 px-4 py-3 text-[13px] font-semibold text-body-muted hover:text-primary transition-colors min-h-[44px] no-underline"
      >
        Что внутри смены?
        <i class="bi bi-arrow-right text-[12px] transition-transform group-hover/cta:translate-x-1" aria-hidden="true"></i>
      </a>
    )}
  </div>

  {PEER_COUNTS[shift.id] && (
    <div class="peer-count-badge mt-3 hidden items-center gap-1.5 rounded-lg bg-orange-50 px-3 py-1.5"
         data-peer-counts={JSON.stringify(PEER_COUNTS[shift.id])}>
      <i class="bi bi-people-fill text-[14px] text-orange-500 shrink-0" aria-hidden="true"></i>
      <span class="peer-count-text text-[13px] font-medium text-orange-700"></span>
    </div>
  )}
</article>

<script>
  document.querySelectorAll<HTMLElement>('article[data-shift-card]').forEach((card) => {
    let startX = 0;
    let startY = 0;

    card.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });

    card.addEventListener('click', (e) => {
      // Игнорируем клики внутри кнопок и ссылок
      if ((e.target as Element).closest('button, a')) return;
      // Игнорируем свайп
      const dx = Math.abs(e.clientX - startX);
      const dy = Math.abs(e.clientY - startY);
      if (dx > 8 || dy > 8) return;
      // Click на карточку = открыть BookModal (если кнопка Выбрать есть) ИЛИ ведёт на shift page
      const bookBtn = card.querySelector<HTMLButtonElement>('[data-shift-book]');
      const infoLink = card.querySelector<HTMLAnchorElement>('a[href^="/shifts/"]');
      if (bookBtn) {
        bookBtn.click();
      } else if (infoLink) {
        window.location.href = infoLink.href;
      }
    });
  });
</script>
