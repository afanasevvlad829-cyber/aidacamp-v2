---
import type { Shift } from '../../data/shifts';
import { renderCard, PEER_COUNTS } from '../../data/shifts';

interface Props {
  shift: Shift;
  variant: 'mobile' | 'desktop';
}

const { shift, variant } = Astro.props;
const { pct, badgeBg, badgeText, btnClass } = renderCard(shift);

const isMobile = variant === 'mobile';

const articleClass = isMobile
  ? `min-w-[calc(100vw-48px)] max-w-[calc(100vw-48px)] shrink-0 snap-start rounded-[20px] border bg-slate-50 p-4 shadow-[0_6px_18px_rgba(15,23,42,0.04)] ${shift.popular ? 'border-orange-400 ring-2 ring-orange-400' : 'border-slate-200'}`
  : `rounded-[20px] border border-slate-200 bg-slate-50 p-5 shadow-[0_6px_18px_rgba(15,23,42,0.04)] transition hover:-translate-y-0.5 hover:shadow-[0_14px_32px_rgba(15,23,42,0.08)] ${shift.popular ? 'ring-2 ring-orange-400' : ''}`;

const descClass = isMobile ? 'text-[14px]' : 'text-[15px]';
const priceClass = isMobile ? 'text-[20px]' : 'text-[22px]';
const btnHover = isMobile ? '' : 'hover:-translate-y-0.5';
---

<article class={articleClass}>
  <!-- Popular tag — отдельная строка сверху карточки, чтобы не конкурировать с заголовком на узких экранах -->
  {shift.popular && (
    <div class="mb-2 flex">
      <span class="inline-flex items-center gap-1 rounded-full bg-orange-500 px-2.5 py-0.5 text-[13px] font-medium text-white">
        <i class="bi bi-fire text-[13px]" aria-hidden="true"></i>
        Популярная
      </span>
    </div>
  )}

  <!-- Title row: заголовок + статус. min-w-0 на левой колонке + shrink-0 на бейдже = безопасный wrap на любом узком экране. -->
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0 flex-1">
      <h3 class="text-[20px] font-semibold leading-[1.15] text-slate-900">{shift.name}</h3>
      <p class="mt-1 text-sm font-medium text-slate-600">{shift.dates}</p>
    </div>
    <span class={`shrink-0 rounded-full ${badgeBg} ${badgeText} px-2 py-0.5 text-[14px] font-medium`}>{shift.status}</span>
  </div>

  <p class="mt-1 text-[13px] text-slate-600">{shift.duration}</p>

  {/* Price transparency — вытащена наверх P1C 2026-04-20, чтобы цена была видна без клика */}
  {isMobile && (
    <div class="mt-2 flex items-baseline gap-2">
      <span class="text-[22px] font-bold tracking-[-0.03em] text-slate-900">{shift.price}</span>
      <span class="text-[12px] text-slate-500">всё включено</span>
    </div>
  )}

  <!-- Action buttons: flex-wrap чтобы ровно переносились на отдельные строки на узких экранах -->
  <div class="mt-2 flex flex-wrap gap-2">
    <button type="button" data-shift-calendar={shift.id} data-start={shift.startDate} data-end={shift.endDate} data-shift-name={shift.name} class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-2.5 py-2 text-[14px] text-slate-600 hover:bg-slate-100" title="Календарь">
      <i class="bi bi-calendar-event text-[14px]" aria-hidden="true"></i>
      календарь
    </button>
    <button type="button" data-shift-info={shift.id} data-shift-title={shift.name} class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-2.5 py-2 text-[14px] text-slate-600 hover:bg-slate-100" title="Подробнее">
      <i class="bi bi-lightbulb text-[14px]" aria-hidden="true"></i>
      Подробнее
    </button>
  </div>

  <p class={`mt-3 ${descClass} leading-[1.55] text-slate-600`}>{shift.description}</p>

  {PEER_COUNTS[shift.id] && (
    <div class="peer-count-badge mt-2 hidden items-center gap-1.5 rounded-lg bg-orange-50 px-3 py-1.5"
         data-peer-counts={JSON.stringify(PEER_COUNTS[shift.id])}>
      <svg class="h-4 w-4 shrink-0 text-orange-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
      <span class="peer-count-text text-[13px] font-medium text-orange-700"></span>
    </div>
  )}

  <div class={`mt-4 ${priceClass} font-bold tracking-[-0.03em] text-slate-900`}>{shift.price}</div>
  <p class="text-[14px] text-slate-600 mt-1">Питание, проживание, программа включены</p>

  <div class="mt-3">
    <div class="h-[10px] w-full overflow-hidden rounded-[6px] bg-slate-100">
      <div class="flex h-full">
        <div class="bg-slate-400 rounded-l-[6px]" style={`width:${pct}%`}></div>
        <div class="bg-emerald-400 rounded-r-[6px]" style={`width:${100 - pct}%`}></div>
      </div>
    </div>
    <div class="flex justify-between mt-1">
      <span class="text-[14px] text-slate-600">занято {shift.occupied}</span>
      <span class="text-[14px] text-emerald-700 font-medium">свободно {shift.free}</span>
    </div>
  </div>

  <button
    type="button"
    data-shift-book={shift.id}
    data-shift-book-name={shift.name}
    data-shift-book-dates={shift.dates}
    data-shift-book-duration={shift.duration}
    data-shift-book-price={shift.price}
    data-analytics-goal="shift_select"
    data-analytics-label={shift.name}
    class={`mt-4 w-full rounded-xl px-4 py-3 text-[15px] font-semibold min-h-[48px] ${btnHover} ${btnClass}`}
  >
    Выбрать
  </button>
  <p class="text-[14px] text-slate-600 text-center mt-1.5">Не понравится в первые 3 дня — вернём 50%</p>
</article>
