---
import type { Shift } from '../../data/shifts';
import { renderCard, PEER_COUNTS } from '../../data/shifts';

interface Props {
  shift: Shift;
  variant: 'mobile' | 'desktop';
}

const { shift, variant } = Astro.props;
const { pct, badgeBg, badgeText, btnClass } = renderCard(shift);

const isMobile = variant === 'mobile';

// Scarcity signal: ≥85% occupied → urgency border + badge
const isLowAvailability = pct >= 85;

const articleClass = isMobile
  ? `min-w-[calc(100vw-48px)] max-w-[calc(100vw-48px)] shrink-0 snap-start rounded-[20px] border bg-surface p-4 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_20px_48px_rgba(15,23,42,0.14)] hover:shadow-[0_4px_10px_rgba(15,23,42,0.08),0_28px_64px_rgba(15,23,42,0.20)] cursor-pointer select-none ${shift.popular ? 'border-orange-400 ring-2 ring-orange-400' : isLowAvailability ? 'border-orange-300 ring-1 ring-orange-300/60' : 'border-border'}`
  : `rounded-[20px] border bg-surface p-5 shadow-[0_2px_6px_rgba(15,23,42,0.06),0_20px_48px_rgba(15,23,42,0.14)] transition hover:-translate-y-0.5 hover:shadow-[0_4px_10px_rgba(15,23,42,0.08),0_28px_64px_rgba(15,23,42,0.20)] cursor-pointer select-none ${shift.popular ? 'border-border ring-2 ring-orange-400' : isLowAvailability ? 'border-orange-300 ring-1 ring-orange-300/60' : 'border-border'}`;

const descClass = isMobile ? 'text-[16px]' : 'text-[15px]';
const priceClass = isMobile ? 'text-[20px]' : 'text-[22px]';
const btnHover = isMobile ? '' : 'hover:-translate-y-0.5';
---

<article class={articleClass} data-shift-card>
  <!-- Title row. "Популярная" сигналим оранжевой обводкой карточки (без бейджа). Статус «места есть» — через progress bar ниже (без дубль-бейджа). -->
  <div class="min-w-0">
    <h3 class="text-[20px] font-semibold leading-[1.15] text-body">{shift.name}</h3>
    <p class="mt-1 text-sm font-medium text-body-muted">{shift.dates}</p>
  </div>

  <p class="mt-1 text-[13px] text-body-muted">{shift.duration}</p>

  {/* Price transparency — вытащена наверх P1C 2026-04-20, чтобы цена была видна без клика */}
  {isMobile && (
    <div class="mt-2 flex items-baseline gap-2">
      <span class="text-[26px] font-extrabold tracking-[-0.02em] text-body leading-none">{shift.price}</span>
      <span class="text-[12px] text-body-faint">всё включено</span>
    </div>
  )}

  <!-- Single secondary CTA: «Подробнее» открывает модалку с программой и календарём -->
  <div class="mt-2">
    <button type="button" data-shift-info={shift.id} data-shift-title={shift.name} class="group inline-flex items-center gap-1.5 text-[15px] font-semibold text-primary hover:text-primary-hover min-h-[44px]" title="Подробнее">
      Что внутри смены?
      <i class="bi bi-arrow-right text-[14px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
    </button>
  </div>

  <p class={`mt-3 ${descClass} leading-[1.55] text-body-muted`}>{shift.description}</p>

  {PEER_COUNTS[shift.id] && (
    <div class="peer-count-badge mt-2 hidden items-center gap-1.5 rounded-lg bg-orange-50 px-3 py-1.5"
         data-peer-counts={JSON.stringify(PEER_COUNTS[shift.id])}>
      <svg class="h-4 w-4 shrink-0 text-orange-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
      <span class="peer-count-text text-[13px] font-medium text-orange-700"></span>
    </div>
  )}

  <div class={`mt-4 text-[28px] font-extrabold tracking-[-0.02em] text-body leading-none ${isMobile ? 'hidden' : ''}`}>{shift.price}</div>
  {/* "Питание, проживание, программа включены" вынесено в Shifts.astro один раз под H2.
       "Осталось X мест" убрано — progress bar становится оранжевым при заполненности ≥85%. */}

  <div class="mt-3">
    <div class="h-[10px] w-full overflow-hidden rounded-[6px] bg-surface">
      <div class="flex h-full">
        <div class={`${isLowAvailability ? 'bg-orange-400' : 'bg-slate-400'} rounded-l-[6px]`} style={`width:${pct}%`}></div>
        <div class="bg-emerald-400 rounded-r-[6px]" style={`width:${100 - pct}%`}></div>
      </div>
    </div>
    <div class="flex justify-between mt-1">
      <span class="text-[14px] text-body-muted">занято {shift.occupied}</span>
      <span class={`text-[14px] font-medium ${isLowAvailability ? 'text-body' : 'text-emerald-700'}`}>свободно {shift.free}</span>
    </div>
  </div>

  <button
    type="button"
    data-shift-book={shift.id}
    data-shift-book-name={shift.name}
    data-shift-book-dates={shift.dates}
    data-shift-book-duration={shift.duration}
    data-shift-book-price={shift.price}
    data-analytics-goal="shift_select"
    data-analytics-label={shift.name}
    class={`mt-4 w-full rounded-xl px-4 py-3 text-[15px] font-semibold min-h-[48px] ${btnHover} ${btnClass}`}
  >
    Выбрать
  </button>
</article>

<script>
  document.querySelectorAll<HTMLElement>('article[data-shift-card]').forEach(card => {
    let startX = 0;
    let startY = 0;

    card.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });

    card.addEventListener('click', (e) => {
      // Игнорируем клики внутри кнопок и ссылок
      if ((e.target as Element).closest('button, a')) return;
      // Игнорируем если это был свайп (смещение > 8px)
      const dx = Math.abs(e.clientX - startX);
      const dy = Math.abs(e.clientY - startY);
      if (dx > 8 || dy > 8) return;
      (card.querySelector<HTMLButtonElement>('[data-shift-book]'))?.click();
    });
  });
</script>
