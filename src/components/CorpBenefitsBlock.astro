---
/**
 * Блок «Корпоративные льготы» — отсылка к /korporativnye-lgoty/.
 * Логотипы партнёров лежат в public/partners/ (белые версии — под тёмную плашку).
 * Программы корпоративных льгот — в ряду PARTNERS. ВТБ Фэмили — отдельной строкой
 * под рядом: это клиентская программа ВТБ, мы с ней сотрудничаем, но это не корпоративная льгота.
 */
import { Icon } from 'astro-icon/components';

const PARTNERS = [
  { name: 'BestBenefits', src: '/partners/bestbenefits-logo.svg', className: 'h-3.5 w-auto' },
  { name: 'Аладдин', src: '/partners/aladdin-logo-white.svg', className: 'h-5 w-auto' },
  { name: 'PremiumCode', src: '/partners/premiumcode-logo.svg', className: 'h-6 w-6', label: 'PremiumCode' },
];
---

<section aria-labelledby="corp-benefits-title" class="mt-6 rounded-2xl bg-[#0C1939] p-4 text-white md:p-5">
  <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-center md:gap-8">
    <div class="min-w-0">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-white/60">Корпоративные льготы</p>
      <h2 id="corp-benefits-title" class="mt-1 text-[16px] font-bold leading-[1.25] md:text-[18px]">
        Работодатель может оплатить детский лагерь
      </h2>
      <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
        {PARTNERS.map((p) => (
          <li class="flex items-center gap-2">
            <img src={p.src} alt={p.name} class={p.className} loading="lazy" decoding="async" />
            {p.label && <span class="text-sm font-bold text-white">{p.label}</span>}
          </li>
        ))}
      </ul>
      <p class="mt-3 border-t border-white/15 pt-3 text-sm leading-[1.5] text-white/75">
        Спецусловия — в программе
        <img src="/partners/vtb-privilege-family-white.svg" alt="ВТБ Фэмили" class="ml-1 inline-block h-4 w-auto align-[-3px]" loading="lazy" decoding="async" />
        
      </p>
    </div>
    <a
      href="/korporativnye-lgoty/"
      class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-white px-4 py-2.5 text-sm font-bold text-[#0C1939] no-underline transition hover:bg-white/90 md:whitespace-nowrap"
    >
      Проверить компанию
      <Icon name="bi:arrow-right" class="bi bi-arrow-right text-xs" aria-hidden="true" />
    </a>
  </div>
</section>
