---
/**
 * Блок «Корпоративные льготы» — отсылка к /korporativnye-lgoty/.
 * Логотипы партнёров лежат в public/partners/ (белые версии — под тёмную плашку).
 * Список партнёров и их названия менять здесь; условия и справочник — на самой странице.
 */
import { Icon } from 'astro-icon/components';

const PARTNERS = [
  { name: 'ВТБ Фэмили', src: '/partners/vtb-privilege-family-white.svg', className: 'h-7 w-auto' },
  { name: 'BestBenefits', src: '/partners/bestbenefits-logo.svg', className: 'h-5 w-auto' },
  { name: 'Аладдин', src: '/partners/aladdin-logo-white.svg', className: 'h-7 w-auto' },
  { name: 'PremiumCode', src: '/partners/premiumcode-logo.svg', className: 'h-9 w-9', label: 'PremiumCode' },
];
---

<section aria-labelledby="corp-benefits-title" class="mt-8 rounded-[22px] bg-[#0C1939] p-5 text-white md:p-8">
  <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/60">Корпоративные льготы</p>
      <h2 id="corp-benefits-title" class="mt-2 text-[22px] font-bold leading-[1.15] tracking-[-0.02em] md:text-[28px]">
        Работодатель может оплатить детский лагерь
      </h2>
      <p class="mt-2 text-base leading-[1.6] text-white/75">
        Проверьте, есть ли программа у вашей компании. Условия уточняйте у HR.
      </p>
      <ul class="mt-5 flex flex-col gap-4 md:flex-row md:flex-wrap md:items-center md:gap-x-8">
        {PARTNERS.map((p) => (
          <li class="flex items-center gap-2.5">
            <img src={p.src} alt={p.name} class={p.className} loading="lazy" decoding="async" />
            {p.label && <span class="text-base font-bold text-white">{p.label}</span>}
          </li>
        ))}
      </ul>
    </div>
    <a
      href="/korporativnye-lgoty/"
      class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3.5 text-base font-bold text-[#0C1939] no-underline transition hover:bg-white/90 md:whitespace-nowrap"
    >
      Проверить компанию
      <Icon name="bi:arrow-right" class="bi bi-arrow-right text-sm" aria-hidden="true" />
    </a>
  </div>
</section>
