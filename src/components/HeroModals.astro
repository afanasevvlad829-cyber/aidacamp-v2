---
import BookingInfoModal from './BookingInfoModal.astro';
import FeatureModal from './FeatureModal.astro';
import heroFeaturesData from '../data/hero-features.json';

type Feature = {
  icon: string;
  iconBg: string;
  iconColor: string;
  title: string;
  contentBg: string;
  whatIs: string;
  whyMatters: Array<{ title: string; description: string }>;
  whatWeDo: string;
};

const features = heroFeaturesData as Record<string, Feature>;
const featureIds = Object.keys(features) as (keyof typeof features)[];
---

<BookingInfoModal />

<!-- Validation Modal -->
<dialog
  id="bookingReminderModal"
  class="fixed inset-0 m-auto w-[min(92vw,420px)] rounded-[18px] border-0 outline-none bg-white p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="p-5">
    <h3 class="text-[18px] font-semibold text-slate-900">Проверьте данные</h3>
    <p class="mt-2 text-[14px] text-slate-600">Чтобы продолжить, заполните телефон и подтвердите согласие на обработку персональных данных.</p>
    <ul class="mt-3 list-disc pl-5 text-[14px] text-slate-500">
      <li>Телефон в формате +7 (XXX) XXX-XX-XX</li>
      <li>Галочка согласия обязательна</li>
    </ul>
    <button
      type="button"
      data-booking-reminder-close
      class="mt-4 inline-flex rounded-[10px] border border-primary/55 bg-primary/8 px-4 py-2 text-sm font-semibold text-primary transition-colors duration-150 hover:bg-primary/14"
    >
      Понятно
    </button>
  </div>
</dialog>

<!-- Equipment Modal -->
<dialog
  id="equipmentModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <i class="bi bi-laptop text-[32px] leading-none" aria-hidden="true"></i>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Почему ноутбук<br/>не нужен</h3>
      </div>
      <button type="button" data-equip-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-1"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Problem -->
    <div class="rounded-[14px] bg-slate-50 px-4 py-3.5 mb-4">
      <p class="text-[14px] font-semibold text-slate-800 mb-1">Проблема с «домашними» ноутбуками</p>
      <p class="text-[14px] text-slate-600 leading-[1.6]">
        У каждой семьи свой ноутбук — от дешёвого Windows до MacBook за 500 000 ₽. Разные ОС, драйверы, версии ПО, настройки антивирусов. Для преподавателей это нескончаемый ад: «почему у тебя не запускается», «переустанови библиотеку», «а у тебя какая версия».
      </p>
    </div>

    <!-- Solution -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Наше решение — одинаковый парк машин</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-clock" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Сброс ОС за 15 секунд</p>
          <p class="text-[13px] text-slate-500">Любая машина возвращается в эталонное состояние — одна кнопка, 15 секунд.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Полное восстановление за 15 минут</p>
          <p class="text-[13px] text-slate-500">Если ребёнок что-то сломал — копируем проект, сбрасываем, восстанавливаем. Работа не теряется.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-check-lg text-orange-600" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Выверенные настройки</p>
          <p class="text-[13px] text-slate-500">Все машины идентичны. Преподаватели знают их досконально — занятие идёт без технических пауз.</p>
        </div>
      </li>
    </ul>

    <!-- Closing statement -->
    <div class="rounded-[14px] bg-[#0d1a2b] px-4 py-3.5">
      <p class="text-[14px] font-semibold text-white/90 leading-[1.5]">
        Мы реально понимаем, как работает IT-образование — и строим инфраструктуру, которая не мешает учиться, а помогает.
      </p>
    </div>
  </div>
</dialog>

<!-- Feature Modals (Python, Minecraft, AI, Pool) -->
{featureIds.map((featureId) => (
  <FeatureModal id={featureId} {...features[featureId]} />
))}

<script is:inline>
  // Equipment modal open handler — desktop + mobile stamps
  // Используем event delegation, т.к. equipment-stamp-mobile в index.astro
  // рендерится ПОСЛЕ HeroModals (script бы не нашёл элемент в момент выполнения).
  document.addEventListener('click', (e) => {
    const target = e.target.closest('#equipment-stamp, #equipment-stamp-mobile');
    if (!target) return;
    const equipmentModal = document.getElementById('equipmentModal');
    if (equipmentModal) equipmentModal.showModal();
  });

  // Equipment modal close handler
  const equipCloseBtn = document.querySelector('[data-equip-close]');

  if (equipCloseBtn && equipmentModal) {
    equipCloseBtn.addEventListener('click', () => {
      equipmentModal.close();
    });
  }

  if (equipmentModal) {
    equipmentModal.addEventListener('click', (e) => {
      if (e.target === equipmentModal) {
        equipmentModal.close();
      }
    });
  }

  // Booking reminder close handler
  const bookingReminderModal = document.getElementById('bookingReminderModal');
  const bookingReminderCloseBtn = document.querySelector('[data-booking-reminder-close]');

  if (bookingReminderCloseBtn && bookingReminderModal) {
    bookingReminderCloseBtn.addEventListener('click', () => {
      bookingReminderModal.close();
    });
  }
</script>
