---
import BookingInfoModal from './BookingInfoModal.astro';
---
<BookingInfoModal />

<!-- Validation Modal -->
<dialog
  id="bookingReminderModal"
  class="fixed inset-0 m-auto w-[min(92vw,420px)] rounded-[18px] border-0 outline-none bg-white p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="p-5">
    <h3 class="text-[18px] font-semibold text-slate-900">Проверьте данные</h3>
    <p class="mt-2 text-[14px] text-slate-600">Чтобы продолжить, заполните телефон и подтвердите согласие на обработку персональных данных.</p>
    <ul class="mt-3 list-disc pl-5 text-[14px] text-slate-500">
      <li>Телефон в формате +7 (XXX) XXX-XX-XX</li>
      <li>Галочка согласия обязательна</li>
    </ul>
    <button
      type="button"
      data-booking-reminder-close
      class="mt-4 inline-flex rounded-[10px] bg-[#ec7c00] px-4 py-2 text-sm font-semibold text-[#1e2430] transition-all duration-200 hover:shadow-[0_4px_16px_rgba(249,115,22,0.35)] hover:-translate-y-[1px] active:translate-y-0"
    >
      Понятно
    </button>
  </div>
</dialog>

<!-- Equipment Modal -->
<dialog
  id="equipmentModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <i class="bi bi-laptop text-[32px] leading-none" aria-hidden="true"></i>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Почему ноутбук<br/>не нужен</h3>
      </div>
      <button type="button" data-equip-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition outline-none focus:outline-none"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Problem -->
    <div class="rounded-[14px] bg-slate-50 px-4 py-3.5 mb-4">
      <p class="text-[14px] font-semibold text-slate-800 mb-1">Проблема с «домашними» ноутбуками</p>
      <p class="text-[14px] text-slate-600 leading-[1.6]">
        У каждой семьи свой ноутбук — от дешёвого Windows до MacBook за 500 000 ₽. Разные ОС, драйверы, версии ПО, настройки антивирусов. Для преподавателей это нескончаемый ад: «почему у тебя не запускается», «переустанови библиотеку», «а у тебя какая версия».
      </p>
    </div>

    <!-- Solution -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Наше решение — одинаковый парк машин</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-clock" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Сброс ОС за 15 секунд</p>
          <p class="text-[13px] text-slate-500">Любая машина возвращается в эталонное состояние — одна кнопка, 15 секунд.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Полное восстановление за 15 минут</p>
          <p class="text-[13px] text-slate-500">Если ребёнок что-то сломал — копируем проект, сбрасываем, восстанавливаем. Работа не теряется.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-check-lg text-orange-600" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Выверенные настройки</p>
          <p class="text-[13px] text-slate-500">Все машины идентичны. Преподаватели знают их досконально — занятие идёт без технических пауз.</p>
        </div>
      </li>
    </ul>

    <!-- Closing statement -->
    <div class="rounded-[14px] bg-[#0d1a2b] px-4 py-3.5">
      <p class="text-[14px] font-semibold text-white/90 leading-[1.5]">
        Мы реально понимаем, как работает IT-образование — и строим инфраструктуру, которая не мешает учиться, а помогает.
      </p>
    </div>
  </div>
</dialog>

<!-- Python Modal -->
<dialog
  id="pythonModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100">
          <i class="bi bi-code-slash text-[20px] text-blue-600" aria-hidden="true"></i>
        </div>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Python</h3>
      </div>
      <button type="button" data-python-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition outline-none focus:outline-none"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- What is it -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Что такое Python?</p>
    <p class="text-[14px] text-slate-600 leading-[1.6] mb-5">
      Самый популярный язык программирования в мире. На нём пишут веб-сайты, игры, приложения для анализа данных и искусственного интеллекта. Очень простой для начинающих, но мощный для профессионалов.
    </p>

    <!-- Why matters -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Зачем это нужно детям?</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Реальные навыки:</span> Python используют в NASA, Google, Netflix. Знание Python откроет двери в любую IT-компанию.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Логика и алгоритмы:</span> Через Python дети учат основы программирования — как думать алгоритмически.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">От нуля к проекту:</span> За неделю ребёнок не просто кодит — он создаёт свою игру или приложение.</p>
      </li>
    </ul>

    <!-- What we do -->
    <div class="rounded-[14px] bg-blue-50 px-4 py-3.5">
      <p class="text-[14px] font-semibold text-slate-800 mb-2">Что мы с этим делаем</p>
      <p class="text-[14px] text-slate-700 leading-[1.5]">
        На смене дети учат основы: переменные, циклы, функции. Потом создают свой проект — игру или приложение. На финальном хакатоне защищают результаты перед другими ребятами. К концу смены каждый идёт домой с портфелем и опытом реальной разработки.
      </p>
    </div>
  </div>
</dialog>

<!-- Minecraft Modal -->
<dialog
  id="minecraftModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-100">
          <i class="bi bi-box text-[20px] text-green-600" aria-hidden="true"></i>
        </div>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Minecraft</h3>
      </div>
      <button type="button" data-minecraft-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition outline-none focus:outline-none"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- What is it -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Что такое Minecraft?</p>
    <p class="text-[14px] text-slate-600 leading-[1.6] mb-5">
      Более чем видеоигра. Minecraft в образовании — это среда для изучения программирования. Дети пишут код, который управляет блоками, создаёт механизмы и строит целые миры.
    </p>

    <!-- Why matters -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Зачем это нужно детям?</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Вовлечённость:</span> Дети учат программирование через то, что их уже увлекает. Видимый результат прямо в игре.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Креативность + логика:</span> Они не просто кодят — они создают свой мир. Это комбинирует творчество и алгоритмическое мышление.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Командная работа:</span> Дети работают вместе над проектами, а потом защищают их перед остальными.</p>
      </li>
    </ul>

    <!-- What we do -->
    <div class="rounded-[14px] bg-green-50 px-4 py-3.5">
      <p class="text-[14px] font-semibold text-slate-800 mb-2">Что мы с этим делаем</p>
      <p class="text-[14px] text-slate-700 leading-[1.5]">
        Дети учат Python и используют его, чтобы управлять Minecraft. Они создают модификации, строят механизмы, всё это через реальный код. На финальном хакатоне показывают, что они построили.
      </p>
    </div>
  </div>
</dialog>

<!-- AI Modal -->
<dialog
  id="aiModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-100">
          <i class="bi bi-brain text-[20px] text-purple-600" aria-hidden="true"></i>
        </div>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Искусственный интеллект</h3>
      </div>
      <button type="button" data-ai-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition outline-none focus:outline-none"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- What is it -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Что такое AI?</p>
    <p class="text-[14px] text-slate-600 leading-[1.6] mb-5">
      Это системы, которые учатся из данных и принимают решения. Нейросети, распознавание лиц, голоса, рекомендации в YouTube — всё это AI. Не магия, а математика и статистика.
    </p>

    <!-- Why matters -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Зачем это нужно детям?</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Будущее IT:</span> AI — это направление, в котором развивается весь IT-мир. Знания тут будут очень ценны.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Критическое мышление:</span> Ребёнок понимает, как работает AI, что это может и не может, где его опасности.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Опыт, а не страх:</span> Дети работают с реальными моделями, видят результаты, а не боятся неизвестного.</p>
      </li>
    </ul>

    <!-- What we do -->
    <div class="rounded-[14px] bg-purple-50 px-4 py-3.5">
      <p class="text-[14px] font-semibold text-slate-800 mb-2">Что мы с этим делаем</p>
      <p class="text-[14px] text-slate-700 leading-[1.5]">
        Дети изучают основы нейросетей и машинного обучения. Тренируют модели на реальных данных, видят, как работает предсказание. Создают свой AI-проект на Python — например, классификатор фотографий или чат-бот.
      </p>
    </div>
  </div>
</dialog>

<!-- Pool (Бассейн) Modal -->
<dialog
  id="poolModal"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100">
          <i class="bi bi-water text-[20px] text-cyan-600" aria-hidden="true"></i>
        </div>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Бассейн</h3>
      </div>
      <button type="button" data-pool-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition outline-none focus:outline-none"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- What is it -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Что такое бассейн в лагере?</p>
    <p class="text-[14px] text-slate-600 leading-[1.6] mb-5">
      Это не просто место для плавания. Это часть дневного расписания, где дети отвлекаются от кода, прыгают, плавают и отдыхают. 50-метровый открытый бассейн на территории лагеря — одна из самых популярных активностей.
    </p>

    <!-- Why matters -->
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Зачем это нужно?</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Разгрузка от экрана:</span> 14 дней интенсивного кодирования — это нормально, но нужны перерывы. Бассейн даёт физическую активность и переключение.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Социализация:</span> Здесь дети расслабляются, смеются, дружат. Не по проектам, а просто общаются.</p>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-orange-500"><i class="bi bi-check-lg text-[14px]" aria-hidden="true"></i></span>
        <p class="text-[14px] text-slate-600"><span class="font-semibold text-slate-800">Здоровье:</span> Плавание — это суперполезная физическая активность. Спина скажет спасибо за перерыв от компьютера.</p>
      </li>
    </ul>

    <!-- What we do -->
    <div class="rounded-[14px] bg-cyan-50 px-4 py-3.5">
      <p class="text-[14px] font-semibold text-slate-800 mb-2">Что мы с этим делаем</p>
      <p class="text-[14px] text-slate-700 leading-[1.5]">
        Бассейн входит в ежедневное расписание смены. Дети ходят туда каждый день после занятий, когда закончились уроки программирования. Инструктор по плаванию присутствует, пловцы разного уровня разделены по группам. Это не спорт, это отдых.
      </p>
    </div>
  </div>
</dialog>

<script>
  function initHero() {
    const modal = document.getElementById('bookingReminderModal') as HTMLDialogElement | null;
    modal?.querySelector('[data-booking-reminder-close]')?.addEventListener('click', () => modal.close());
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

    // Equipment modal
    const equipModal = document.getElementById('equipmentModal') as HTMLDialogElement | null;
    const openEquip = () => equipModal?.showModal();
    document.getElementById('equipment-stamp')?.addEventListener('click', openEquip);
    document.getElementById('equipment-stamp-mobile')?.addEventListener('click', openEquip);
    equipModal?.querySelector('[data-equip-close]')?.addEventListener('click', () => equipModal.close());
    equipModal?.addEventListener('click', (e) => { if (e.target === equipModal) equipModal.close(); });

    // Feature modals - Python
    const pythonModal = document.getElementById('pythonModal') as HTMLDialogElement | null;
    pythonModal?.querySelector('[data-python-close]')?.addEventListener('click', () => pythonModal.close());
    pythonModal?.addEventListener('click', (e) => { if (e.target === pythonModal) pythonModal.close(); });

    // Feature modals - Minecraft
    const minecraftModal = document.getElementById('minecraftModal') as HTMLDialogElement | null;
    minecraftModal?.querySelector('[data-minecraft-close]')?.addEventListener('click', () => minecraftModal.close());
    minecraftModal?.addEventListener('click', (e) => { if (e.target === minecraftModal) minecraftModal.close(); });

    // Feature modals - AI
    const aiModal = document.getElementById('aiModal') as HTMLDialogElement | null;
    aiModal?.querySelector('[data-ai-close]')?.addEventListener('click', () => aiModal.close());
    aiModal?.addEventListener('click', (e) => { if (e.target === aiModal) aiModal.close(); });

    // Feature modals - Pool
    const poolModal = document.getElementById('poolModal') as HTMLDialogElement | null;
    poolModal?.querySelector('[data-pool-close]')?.addEventListener('click', () => poolModal.close());
    poolModal?.addEventListener('click', (e) => { if (e.target === poolModal) poolModal.close(); });

    // Mobile form: auto-reveal after 30 sec
    const bookingBlock = document.getElementById('hero-booking-block') as HTMLElement | null;
    let revealed = false;

    function revealForm() {
      if (revealed || !bookingBlock) return;
      revealed = true;
      bookingBlock.style.maxHeight = '700px';
      bookingBlock.style.paddingTop = '1rem';
      bookingBlock.style.paddingBottom = '1.5rem';
      bookingBlock.style.opacity = '1';
      bookingBlock.style.pointerEvents = 'auto';
    }

    setTimeout(() => {
      const heroEl = document.getElementById('hero');
      if (!heroEl) return;
      const rect = heroEl.getBoundingClientRect();
      if (window.innerWidth < 1024 && rect.bottom > 0) revealForm();
    }, 30000);
  }

  document.addEventListener('astro:page-load', initHero);
  initHero();
</script>
