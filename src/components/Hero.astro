---
import LeadForm from './LeadForm.astro';
---

<section id="hero" class="relative mx-auto w-full overflow-hidden bg-surface-warm md:max-w-[1440px]">
  <!-- ===== MOBILE HERO ===== -->
  <div class="relative w-full bg-dark-navy md:hidden">
    <!-- Photo with gradient fade to dark -->
    <div class="relative">
      <img
        src="/images/hero-custom-2026-04-07.avif"
        alt=""
        aria-hidden="true"
        class="w-full aspect-[4/3] object-cover object-[center_20%]"
        loading="eager"
        fetchpriority="high"
        width="1536"
        height="1024"
      />
      <!-- Side gradient -->
      <div class="absolute inset-0 bg-[linear-gradient(92deg,rgba(6,10,18,0.72)_0%,rgba(6,10,18,0.46)_42%,rgba(6,10,18,0.2)_70%,rgba(6,10,18,0.06)_100%)]"></div>
      <!-- Bottom fade to dark -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-dark-navy"></div>

      <!-- Text over photo -->
      <div class="absolute bottom-6 left-5 right-5">
        <p class="text-[13px] tracking-[0.2px] text-white/80">
          <span class="text-orange-400">★ 5.0</span> на Яндекс Картах · 6 лет работы · 1200+ детей
        </p>
        <h1 id="hero-title-mobile" class="mt-1 text-[36px] font-bold leading-[1.1] tracking-[-0.03em] text-white">
          Летний лагерь в&nbsp;Подмосковье, 7–14
        </h1>
        <p id="hero-subtitle-mobile" class="mt-2 flex items-center gap-2 text-[13px] text-white/60">
          Вам — 14 дней для себя. Согласны?
          <button
            type="button"
            id="hero-agree-btn-mobile"
            class="inline-flex h-[22px] items-center gap-1 rounded-[11px]
                   border border-[rgba(245,166,36,0.45)]
                   bg-[rgba(245,166,36,0.20)] px-2
                   text-[10px] font-semibold text-white/88
                   hover:bg-[rgba(245,166,36,0.35)] transition"
          >
            <i class="bi bi-hand-thumbs-up-fill text-[10px]"></i>
            <span id="hero-agree-count-mobile">301</span>
          </button>
        </p>
      </div>
    </div>

    <!-- Form area — hidden initially, slides open -->
    <div
      id="hero-booking-block"
      class="bg-dark-navy px-4 pb-6 pt-4"
      style="overflow:hidden; max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none;"
    >
      <!-- Info bar -->
      <div class="mb-4 flex items-center justify-between rounded-[12px] bg-white/10 px-4 py-2.5 text-[12px] text-white/80">
        <span>от 48 000 ₽ за 7 дней</span>
        <span>✓ <span data-response-time>Ответим за 10 мин</span></span>
      </div>
      <!-- White card with form -->
      <LeadForm variant="mobile" />
    </div>
  </div>

  <!-- ===== DESKTOP HERO ===== -->
  <div class="relative hidden h-[520px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
    <img
      src="/images/hero-custom-2026-04-07.avif"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
      loading="eager"
      fetchpriority="high"
      width="1536"
      height="1024"
    />

    <!-- Desktop Overlays -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.78)_0%,rgba(5,9,18,0.62)_26%,rgba(5,9,18,0.34)_48%,rgba(5,9,18,0.12)_66%,rgba(5,9,18,0.02)_82%,rgba(5,9,18,0)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(140%_120%_at_50%_50%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.12)_84%,rgba(0,0,0,0.24)_100%)] mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(236,124,0,0.09)_0%,rgba(236,124,0,0.04)_30%,rgba(236,124,0,0)_62%)] mix-blend-soft-light"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
    </div>

    <!-- Desktop Text Content -->
    <div class="absolute left-16 top-[78px] z-10">
      <!-- Location -->
      <p class="text-[13px] text-white/50 whitespace-nowrap">
        66 км от Москвы · смены июнь–август
      </p>
      <!-- H1 -->
      <h1
        id="hero-title"
        class="mt-2 w-[700px] text-[44px] font-bold leading-[52px] tracking-[-0.03em] text-white [text-shadow:0px_4px_12px_rgba(0,0,0,0.35)]"
      >
        Летний лагерь в Подмосковье, 7–14
      </h1>
      <p id="hero-subtitle" class="mt-2 text-[15px] text-white/65">
        Каждый уедет с проектом и новыми друзьями.
      </p>
      <p class="mt-1 flex items-center gap-3 text-[15px] text-white/65">
        Вам — 14 дней для себя. Согласны?
        <button
          type="button"
          id="hero-agree-btn"
          class="inline-flex h-[26px] items-center gap-1.5 rounded-[13px]
                 border border-[rgba(245,166,36,0.45)]
                 bg-[rgba(245,166,36,0.20)] px-3
                 text-[11px] font-semibold text-white/88
                 hover:bg-[rgba(245,166,36,0.35)] transition"
        >
          <i class="bi bi-hand-thumbs-up-fill text-[12px]"></i>
          <span id="hero-agree-count">301</span>
        </button>
      </p>
      <!-- Badges -->
      <div id="hero-badges" class="mt-3 flex gap-2">
        <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-[12px] text-white/85">Python</span>
        <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-[12px] text-white/85">Minecraft</span>
        <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-[12px] text-white/85">AI</span>
        <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-[12px] text-white/85">Бассейн</span>
      </div>
      <!-- Rating -->
      <p class="mt-3 text-[13px] text-white/50">
        <span class="mr-1 inline-flex items-center rounded-[5px] bg-[rgba(245,166,36,0.18)] px-1.5 py-0.5 text-[13px] font-bold text-[#f5a624]">★ 5.0</span>
        на Яндекс Картах · 6 лет работы · 1200+ детей
      </p>
      <!-- CTA -->
      <a
        href="#shifts"
        class="mt-5 inline-flex items-center gap-2 rounded-[14px] bg-[#ec7c00] hover:bg-[#d46e00] px-6 py-3 text-[15px] font-semibold text-white shadow-[0_4px_16px_rgba(236,124,0,0.35)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_6px_20px_rgba(236,124,0,0.45)]"
      >
        Смены 2026
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Desktop Bottom Info Bar -->
    <div class="absolute bottom-0 inset-x-0 z-20 border-t border-white/8 bg-black/25 backdrop-blur-sm">
      <div class="mx-auto max-w-[1312px] px-6 py-2.5">
        <a href="#shifts" class="block text-[11px] text-white/55 text-center leading-relaxed hover:text-white/75 transition-colors">
          от 48 000 ₽ за 7 дней · 60% возвращаются снова · проживание, питание, программа включены · Трансфер — опция
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Validation Modal -->
<dialog
  id="bookingReminderModal"
  class="fixed inset-0 m-auto w-[min(92vw,420px)] rounded-[18px] border-0 outline-none bg-white p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="p-5">
    <h3 class="text-[18px] font-semibold text-slate-900">Проверьте данные</h3>
    <p class="mt-2 text-[14px] text-slate-600">Чтобы продолжить, заполните телефон и подтвердите согласие на обработку персональных данных.</p>
    <ul class="mt-3 list-disc pl-5 text-[13px] text-slate-500">
      <li>Телефон в формате +7 (XXX) XXX-XX-XX</li>
      <li>Галочка согласия обязательна</li>
    </ul>
    <button
      type="button"
      data-booking-reminder-close
      class="mt-4 inline-flex rounded-[10px] bg-[#ec7c00] px-4 py-2 text-sm font-semibold text-white transition-all duration-200 hover:shadow-[0_4px_16px_rgba(249,115,22,0.35)] hover:-translate-y-[1px] active:translate-y-0"
    >
      Понятно
    </button>
  </div>
</dialog>

<script is:inline>
  // UTM-based title variations
  (function() {
    var params = new URLSearchParams(window.location.search);
    var h1Key = params.get('utm_h1');
    var content = params.get('utm_content');
    var source = params.get('utm_source');

    var variants = {
      // Search utm_h1 values
      camp:        { title: 'Летний лагерь в Подмосковье для детей 7–14 лет', subtitle: 'IT, бассейн, проживание — всё включено. 66 км от Москвы' },
      result:      { title: 'За смену ребёнок создаёт реальный IT-проект', subtitle: 'Хакатон в финале каждой смены — защита перед жюри' },
      it:          { title: 'IT-лагерь для детей 7–14 лет — Python, Minecraft, AI', subtitle: 'Каждый уедет с проектом и новыми друзьями' },
      reviews:     { title: 'АйДаКемп — 40+ отзывов, рейтинг 5.0 на Яндекс Картах', subtitle: '6 лет работы · 1200+ детей · лицензия Минобра' },
      brand:       { title: 'АйДаКемп — IT-лагерь в Подмосковье', subtitle: '66 км от Москвы, программирование, бассейн, природа' },
      nophone:     { title: 'Телефон здесь зарабатывают', subtitle: 'Экранное время — за участие и инициативу, не выдаётся автоматически' },
      price:       { title: 'IT-лагерь 7–14 лет от 48 000₽', subtitle: '7 дней: программирование, хакатон, бассейн — всё включено' },
      age:         { title: 'Лагерь для детей 7–14 лет', subtitle: 'Учатся программировать и защищают свой проект' },
      // РСЯ utm_content group values
      keys:        { title: 'IT-лагерь в Подмосковье — вы знаете, куда отправляете ребёнка', subtitle: 'Лицензия Минобра · 6 лет работы · 1200+ детей' },
      parents:     { title: 'Ребёнок в лагере — вы отдыхаете 14 дней', subtitle: 'Не просто лагерь — дети создают игры и приложения' },
      edu:         { title: 'IT-лагерь 7–14 лет — ребёнок уедет с проектом на Python', subtitle: 'Хакатон в финале, лицензия Минобра, 66 км от Москвы' },
      books:       { title: 'Не просто лагерь — среда развития', subtitle: 'Наши преподаватели написали книгу по Python. Учим серьёзно.' },
      competitors: { title: 'Лучший IT-лагерь Подмосковья', subtitle: '66 км от Москвы, хакатон в финале каждой смены' },
      // Прочие
      // VK problem_photo — ключи совпадают с содержанием
      telefon:     { title: 'На 3-й день дети сами забывают про телефон', subtitle: 'Потому что стало интереснее без него. IT-лагерь 66 км от Москвы' },
      nichego:     { title: '«Ничего не хочет» — это не правда', subtitle: 'Просто вокруг скучно. В лагере это исчезает на 3-й день' },
      leto:        { title: 'Пока другие дети скучают дома — твой делает игру', subtitle: 'IT-лагерь 66 км от Москвы · Python, Minecraft, AI · проект за смену' },
      // VK intent_kw — те же объявления, ключи перепутаны → мэпим на правильный контент
      lager:       { title: 'На 3-й день дети сами забывают про телефон', subtitle: 'Потому что стало интереснее без него. IT-лагерь 66 км от Москвы' },
      it_lager:    { title: '«Ничего не хочет» — это не правда', subtitle: 'Просто вокруг скучно. В лагере это исчезает на 3-й день' },
      chem_zanyat: { title: 'Лето может пройти иначе', subtitle: 'IT-лагерь под Москвой — проект, друзья, бассейн. 66 км от МКАД' },
      // VK crm_school — ключи точно совпадают с объявлениями
      next_step:   { title: 'Этим летом — не просто отдых', subtitle: 'Ребёнок знаком с IT? Свой проект за 7 дней, бассейн, друзья. 66 км от Москвы' },
      polza:       { title: 'Лето с пользой', subtitle: 'IT-лагерь 7–14 лет: свой проект за 7 дней, бассейн, команда. 66 км от Москвы' },
      proekt:      { title: 'За 7 дней — свой проект', subtitle: 'IT-лагерь под Москвой: бассейн, команда и настоящее лето' }
    };

    var sourceVariants = {
      codims: {
        title: 'Попробовать IT за одно лето — и подтянуть информатику к сентябрю',
        subtitle: 'Берём с нуля. Опыт не нужен — за смену ребёнок создаст реальный проект и придёт в сентябрь с преимуществом',
        badge: 'Берём с нуля · опыт не нужен'
      }
    };

    var v = (h1Key && variants[h1Key])
         || (content && variants[content])
         || (source && sourceVariants[source])
         || null;

    if (v) {
      var titleEl = document.getElementById('hero-title');
      var titleMob = document.getElementById('hero-title-mobile');
      var subtitleEl = document.getElementById('hero-subtitle');
      var subtitleMob = document.getElementById('hero-subtitle-mobile');
      if (v.title) {
        if (titleEl) titleEl.textContent = v.title;
        if (titleMob) titleMob.textContent = v.title;
      }
      if (v.subtitle) {
        if (subtitleEl) subtitleEl.textContent = v.subtitle;
        // Mobile: replace only text node, keep agree button intact
        if (subtitleMob) {
          var firstNode = subtitleMob.firstChild;
          if (firstNode && firstNode.nodeType === 3) {
            firstNode.textContent = v.subtitle + ' ';
          }
        }
      }
      if (v.badge) {
        var badgesEl = document.getElementById('hero-badges');
        if (badgesEl) {
          badgesEl.innerHTML = '<span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-[12px] text-white/85">' + v.badge + '</span>';
        }
      }
    }
  })();
</script>

<script>
  function initHero() {
    const modal = document.getElementById('bookingReminderModal') as HTMLDialogElement | null;
    modal?.querySelector('[data-booking-reminder-close]')?.addEventListener('click', () => modal.close());
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

    // Mobile form toggle — agree button reveals form
    const bookingBlock = document.getElementById('hero-booking-block') as HTMLElement | null;
    const agreeBtn = document.getElementById('hero-agree-btn-mobile');
    const agreeCount = document.getElementById('hero-agree-count-mobile');
    let revealed = false;

    function revealForm() {
      if (revealed || !bookingBlock) return;
      revealed = true;
      bookingBlock.style.transition = 'max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease';
      bookingBlock.style.maxHeight = '600px';
      bookingBlock.style.paddingTop = '1rem';
      bookingBlock.style.paddingBottom = '1.5rem';
      bookingBlock.style.opacity = '1';
      bookingBlock.style.pointerEvents = 'auto';
      if (agreeCount) {
        const cur = parseInt(agreeCount.textContent || '301', 10);
        agreeCount.textContent = String(cur + 1);
      }
    }

    agreeBtn?.addEventListener('click', revealForm);

    // Also reveal when clicking "Смены 2026" desktop button on mobile (just in case)
  }

  document.addEventListener('astro:page-load', initHero);
  initHero();
</script>
