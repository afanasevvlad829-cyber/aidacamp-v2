---
import HeroMobile from './hero/Mobile.astro';
import HeroDesktop from './hero/Desktop.astro';
import HeroModals from './HeroModals.astro';
import HeroFeatures from './HeroFeatures.astro';
import NewsJazz from './NewsJazz.astro';
import { displayShifts, shiftDatesShort, DATES_SHORT_S21, DATES_SHORT_S22 } from '../data/shifts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc, hasVariants = false } = Astro.props;

const heroShiftsData = {
  ...Object.fromEntries(displayShifts.map(s => [
    s.id,
    { name: s.name.replace('Смена', 'Смену'), dates: shiftDatesShort(s), free: s.free }
  ])),
  'shift-2-1': { name: 'Смену 2.1', dates: DATES_SHORT_S21, free: 0 },
  'shift-2-2': { name: 'Смену 2.2', dates: DATES_SHORT_S22, free: 0 },
};
---

<section id="hero" class="relative mx-auto w-full overflow-x-hidden bg-surface-warm md:max-w-[1440px]">
  <!--
    Два H1 в разметке — один рендерится на мобильном viewport, другой на десктопном
    (через md:hidden / hidden md:block wrappers). Каждый crawler видит только свой
    H1 как visible. Multiple <h1> — допустимо (John Mueller, 2020): не ранжирующий
    штраф. Раньше был один absolute H1 с responsive классами, но он улетал из
    потока при раскрытии мобильной формы (bottom-[80px] относительно секции). Теперь
    оба H1 в потоке своих блоков → стабильно при любом состоянии формы.
  -->
  <HeroMobile {imageSrc} {hasVariants} />
  <HeroDesktop {imageSrc} {hasVariants} />
  <!-- HeroFeatures strip — mobile + desktop, dark navy bg как продолжение hero -->
  <HeroFeatures />
  <!-- News Jazz: модалка + JS + CSS (карточки встроены в Desktop/Mobile) -->
  <NewsJazz />
</section>

<HeroModals />

<!-- ── Персонализированный баннер для возвратников ── -->
<div id="returning-hero-hint" class="hidden mx-auto max-w-[1312px] px-4 py-3">
  <a id="returning-hero-link" href="/shifts/shift-1/"
     class="flex items-center gap-3 rounded-xl border border-primary/30 bg-primary/5 px-4 py-3 text-base hover:bg-primary/10 transition-colors no-underline">
    <i class="bi bi-arrow-left-circle-fill text-[20px] text-primary shrink-0" aria-hidden="true"></i>
    <span id="returning-hero-text" class="text-slate-700 font-medium"></span>
    <i class="bi bi-arrow-right text-base text-primary ml-auto shrink-0" aria-hidden="true"></i>
  </a>
</div>
<script is:inline define:vars={{ heroShiftsData }}>
(function() {
  var SHIFTS = heroShiftsData;
  try {
    var viewed = JSON.parse(localStorage.getItem('ac:viewed_shifts') || '[]');
    if (!viewed.length) return;
    var last = viewed[viewed.length - 1];
    // Support both {id, ts} objects and plain string IDs
    if (last && typeof last === 'object') last = last.id;
    var s = SHIFTS[last];
    if (!s) return;
    var hint = document.getElementById('returning-hero-hint');
    var text = document.getElementById('returning-hero-text');
    var link = document.getElementById('returning-hero-link');
    if (!hint || !text || !link) return;
    var freePlural = s.free === 1 ? 'место' : s.free < 5 ? 'места' : 'мест';
    text.textContent = 'Вы смотрели ' + s.name + ' · ' + s.free + ' ' + freePlural + ' · ' + s.dates;
    link.href = '/shifts/' + last + '/';
    hint.classList.remove('hidden');
  } catch(e) {}
})();
</script>

<script is:inline>
  // UTM-based title variations
  // Приоритет: utm_h1 → utm_content (точный) → utm_content (префикс) → utm_term (ключ поиска) → utm_source
  (function() {
    var params = new URLSearchParams(window.location.search);
    var h1Key  = params.get('utm_h1');
    var content = params.get('utm_content');
    var source  = params.get('utm_source');
    var term    = params.get('utm_term');   // поисковая фраза из Директа ({keyword})

    // Skip fetch when no UTM params — avoids unnecessary network request and LCP delay on organic/direct traffic
    if (!h1Key && !content && !source && !term) return;

    // Load variants from API instead of hardcoded
    fetch('/api/hero-variants.json')
      .then(r => r.json())
      .then(function(variants) {
        var sourceVariants = {
          codims: variants.codims
        };

        // Префикс-маппинг
        var prefixMap = {
          'age_core':         variants.age,
          'brand_core':       variants.brand,
          'it_core_generic':  variants.it,
          'price_core':       variants.price,
          'nophone_v':        variants.nophone,
          'camp_v':           variants.camp,
          'crm_leads':        variants.crm_leads,
          'parents':          variants.nophone,
          'addiction':        variants.nophone,
          'edu':              variants.it,
          'books':            variants.it,
          'result':           variants.camp,
          'keys':             variants.brand,
          'competitors':      variants.price,
          'telefon_':         variants.telefon,
          'nichego_':         variants.nichego,
          'leto_':            variants.leto,
          'lager_':           variants.lager,
          'it_lager_':        variants.it_lager,
          'chem_zanyat_':     variants.chem_zanyat,
          'podmoskove_':      variants.letny_podmoskove,
        };

        function matchPrefix(key) {
          if (!key) return null;
          for (var p in prefixMap) {
            if (key.indexOf(p) === 0) return prefixMap[p];
          }
          return null;
        }

        function matchTerm(t) {
          if (!t) return null;
          t = t.toLowerCase();
          if (/без телефон|без гаджет|телефон.{0,15}лагер|гаджет/.test(t)) return variants.nophone;
          if (/цен|стоимост|сколько стоит|путёвк|путевк|недорого/.test(t)) return variants.price;
          if (/программирован|python|питон|minecraft|майнкрафт|scratch|скретч|it-лагер|айти лагер/.test(t)) return variants.it;
          if (/для подростк|подростк|10 лет|11 лет|12 лет|13 лет/.test(t)) return variants.age;
          if (/2026/.test(t)) return variants.camp2026;
          if (/лагерь.{0,10}подмосков|подмосков.{0,10}лагерь/.test(t)) return variants.camp;
          if (/зависим/.test(t)) return variants.addiction;
          if (/летний лагерь|летн.{0,5}лагер/.test(t)) return variants.leto;
          if (/москва|московск/.test(t)) return variants.camp;
          if (/детский лагерь|детск.{0,5}лагер|лагерь для детей|лагер.{0,10}детей/.test(t)) return variants.camp;
          return null;
        }

        var v = (h1Key  && variants[h1Key])
             || (content && variants[content])
             || (content && matchPrefix(content))
             || matchTerm(term)
             || (source  && sourceVariants[source])
             || null;

        if (v) {
          var titleEl = document.getElementById('hero-title');
          var titleMob = document.getElementById('hero-title-mobile');
          var subtitleEl = document.getElementById('hero-subtitle');
          var subtitleMob = document.getElementById('hero-subtitle-mobile');
          if (v.title) {
            if (titleEl) titleEl.textContent = v.title;
            if (titleMob) titleMob.textContent = v.title;
          }
          if (v.subtitle) {
            if (subtitleEl) subtitleEl.textContent = v.subtitle;
            if (subtitleMob) {
              var firstNode = subtitleMob.firstChild;
              if (firstNode && firstNode.nodeType === 3) {
                firstNode.textContent = v.subtitle + ' ';
              }
            }
          }
          if (v.badge) {
            var badgesEl = document.getElementById('hero-badges');
            if (badgesEl) {
              badgesEl.innerHTML = '<span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-base text-white/85">' + v.badge + '</span>';
            }
          }
        }
      })
      .catch(function(err) {
        console.warn('Failed to load hero-variants:', err);
      })
  })();

  // "Ответим за 10 мин" → открывает ShiftBookModal
  document.getElementById('hero-callback-btn')?.addEventListener('click', () => {
    var m = document.getElementById('shiftBookModal'); if (m) m.showModal();
  });

  // Feature badges click handlers
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-feature]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var feature = this.getAttribute('data-feature');
        var modalId = feature + 'Modal';
        var modal = document.getElementById(modalId);
        if (modal) modal.showModal();
      });
    });
  });
</script>
