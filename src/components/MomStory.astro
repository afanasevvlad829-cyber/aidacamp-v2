---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

// Единый layout — параметры зависят от compact (DRY-refactor per audit)
const wrapperCls = compact
  ? 'bg-surface-warm p-4 md:p-5 rounded-[18px]'
  : 'bg-card p-[18px] md:p-8 rounded-[24px] shadow-[0_4px_16px_rgba(15,23,42,0.04)]';
const sectionCls = compact ? '' : 'mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4';
const containerGap = compact ? 'gap-3 md:gap-5' : 'gap-4 md:gap-10';
const photoWrapperCls = compact ? 'shrink-0' : 'shrink-0 md:w-[40%] md:flex md:justify-center';
const photoCls = compact
  ? 'h-16 w-16 rounded-full object-cover object-top mx-auto md:h-24 md:w-24'
  : 'h-24 w-24 rounded-full object-cover object-top mx-auto mb-4 md:mb-0 md:h-48 md:w-48';
const quoteWrapperCls = compact ? '' : 'md:w-[60%]';
const quoteMarkCls = compact
  ? 'text-[40px] font-serif leading-none text-orange-400 block mb-[-10px]'
  : 'text-[56px] font-serif leading-none text-orange-400 block mb-[-14px] md:text-[72px] md:mb-[-18px]';
const photoSrc = compact ? '/images/team/sm/team-daria-main-01.avif' : '/images/team/team-daria-main-01.avif';
const photoSrcset = compact
  ? '/images/team/sm/team-daria-main-01.avif 1x, /images/team/team-daria-main-01.avif 2x'
  : '/images/team/sm/team-daria-main-01.avif 96w, /images/team/team-daria-main-01.avif 192w';
const photoW = compact ? 96 : 192;
const photoH = compact ? 96 : 192;
---

<section class={sectionCls}>
  <div class={wrapperCls}>
    <div class:list={['flex flex-col items-center text-center', containerGap, 'md:flex-row md:items-start md:text-left']}>
      <!-- Photo -->
      <div class={photoWrapperCls}>
        <img
          src={photoSrc}
          srcset={photoSrcset}
          sizes={compact ? undefined : '(max-width: 768px) 96px, 192px'}
          alt="Дарья Афанасьева"
          class={photoCls}
          width={photoW}
          height={photoH}
          loading="lazy"
        />
      </div>
      <!-- Quote -->
      <div class={quoteWrapperCls}>
        <span class={quoteMarkCls}>&laquo;</span>
        <p class="text-[18px] leading-[1.65] text-body">
          Я сама мама подростка. Объездила разные лагеря, смотрела программы, читала отзывы. Везде было одно и то же&nbsp;&mdash; всё решено заранее, программа просто &laquo;идёт по сценарию&raquo;. Тогда я решила сделать лагерь таким, каким сама хотела бы видеть обучение своей дочери.
        </p>
        <div class={compact ? 'mt-2' : 'mt-3'}>
          <p class="text-[16px] font-bold text-body">&mdash; Дарья Афанасьева</p>
          <p class="text-[14px] text-body-muted">основатель АйДаКемп и мама подростка</p>
        </div>
      </div>
    </div>
  </div>
</section>
