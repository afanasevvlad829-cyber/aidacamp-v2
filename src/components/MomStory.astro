---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{compact ? (
  <section class>
    <div class="bg-surface-warm p-4 md:p-5 rounded-[18px]">
      <div class="flex flex-col items-center text-center gap-3 md:flex-row md:items-start md:text-left md:gap-5">
        <!-- Photo -->
        <div class="shrink-0">
          <img
            src="/images/team/sm/team-daria-main-01.avif"
            srcset="/images/team/sm/team-daria-main-01.avif 1x, /images/team/team-daria-main-01.avif 2x"
            alt="Дарья Афанасьева"
            class="h-16 w-16 rounded-full object-cover object-top mx-auto md:h-24 md:w-24"
            width="96"
            height="96"
            loading="lazy"
          />
        </div>
        <!-- Quote -->
        <div>
          <span class="text-[40px] font-serif leading-none text-orange-400 block mb-[-10px]">&laquo;</span>
          <p class="text-[16px] leading-[1.6] text-slate-700 md:text-[15px]">
            Я сама мама подростка. Объездила разные лагеря, смотрела программы, читала отзывы. Везде было одно и то же&nbsp;&mdash; всё решено заранее, программа просто &laquo;идёт по сценарию&raquo;. Тогда я решила сделать лагерь таким, каким сама хотела бы видеть обучение своей дочери.
          </p>
          <div class="mt-2">
            <p class="text-[14px] font-semibold text-slate-900">&mdash; Дарья Афанасьева</p>
            <p class="text-[14px] text-slate-600">основатель АйДаКемп и мама подростка</p>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
    <div class="bg-white p-[18px] md:p-8 rounded-[24px] shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
      <div class="flex flex-col items-center text-center gap-4 md:flex-row md:items-start md:text-left md:gap-10">
        <!-- Photo -->
        <div class="shrink-0 md:w-[40%] md:flex md:justify-center">
          <img
            src="/images/team/team-daria-main-01.avif"
            srcset="/images/team/sm/team-daria-main-01.avif 96w, /images/team/team-daria-main-01.avif 192w"
            sizes="(max-width: 768px) 96px, 192px"
            alt="Дарья Афанасьева"
            class="h-24 w-24 rounded-full object-cover object-top mx-auto mb-4 md:mb-0 md:h-48 md:w-48"
            width="192"
            height="192"
            loading="lazy"
          />
        </div>
        <!-- Quote -->
        <div class="md:w-[60%]">
          <span class="text-[56px] font-serif leading-none text-orange-400 block mb-[-14px] md:text-[72px] md:mb-[-18px]">&laquo;</span>
          <p class="text-[16px] leading-[1.6] text-slate-700 italic md:text-[18px] md:leading-[1.65]">
            Я сама мама подростка. Объездила разные лагеря, смотрела программы, читала отзывы. Везде было одно и то же&nbsp;&mdash; всё решено заранее, программа просто &laquo;идёт по сценарию&raquo;. Тогда я решила сделать лагерь таким, каким сама хотела бы видеть обучение своей дочери.
          </p>
          <div class="mt-3">
            <p class="text-[15px] font-bold text-slate-900 not-italic">&mdash; Дарья Афанасьева</p>
            <p class="text-[14px] text-slate-600">основатель АйДаКемп и мама подростка</p>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
