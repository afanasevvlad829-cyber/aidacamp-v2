---
import CallTimeSelector from './CallTimeSelector.astro';
import VideoPlayer from './VideoPlayer.astro';

const DARIA_CUES = [
  { s: 0.000, e: 3.800, t: 'Мы живём в самом прекрасном IT-лагере на свете.' },
  { s: 4.000, e: 6.800, t: 'А все остальные лагеря нам завидуют.' },
  { s: 7.000, e: 11.500, t: 'Ведь только у нас дети пишут родителям, что здесь плохая еда,' },
  { s: 11.600, e: 16.100, t: 'и тут же заказывают во вкусвилл 20 жвачек и чипсы.' },
  { s: 16.400, e: 18.600, t: 'Только у нас можно не звонить маме,' },
  { s: 18.800, e: 21.500, t: 'потому что копишь на Крипера из Майнкрафта.' },
  { s: 21.600, e: 24.000, t: 'Она даже не знает, что это такое.' },
  { s: 24.200, e: 29.100, t: 'Только у нас некоторые узнают, что гречка — это не наказание, а еда.' },
  { s: 29.300, e: 31.400, t: 'У нас дети плачут дважды.' },
  { s: 31.600, e: 34.900, t: 'Первый раз в трубку: «Мама, забери меня отсюда!»' },
  { s: 35.100, e: 39.400, t: 'Второй раз, когда мама приезжает, а уезжать перехотелось.' },
  { s: 39.600, e: 43.400, t: 'Родители называют это катастрофой и временем для себя.' },
  { s: 43.600, e: 47.400, t: 'Мы называем это свободой и самостоятельностью.' },
];

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

// По прототипу aidacamp-full_9: card на ПРОЗРАЧНОМ фоне (transparent),
// фото 80x80 / 120x120 + rounded-2xl + контент справа. Не нарушает dot-pattern фон.
const wrapperCls = compact
  ? 'p-4 md:p-6 bg-transparent'
  : 'p-[18px] md:p-8';
const sectionCls = compact ? '' : 'mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4';
const containerGap = compact ? 'gap-4 md:gap-6' : 'gap-4 md:gap-10';
const photoWrapperCls = compact ? 'shrink-0' : 'shrink-0 md:w-[40%] md:flex md:justify-center';
const photoCls = compact
  ? 'h-20 w-20 rounded-2xl object-cover object-top md:h-[120px] md:w-[120px]'
  : 'h-24 w-24 rounded-full object-cover object-top mx-auto mb-4 md:mb-0 md:h-48 md:w-48';
const quoteWrapperCls = compact ? 'flex-1 min-w-0' : 'md:w-[60%]';
const quoteMarkCls = compact
  ? 'text-[40px] font-serif leading-none text-orange-400 block mb-[-10px]'
  : 'text-[56px] font-serif leading-none text-orange-400 block mb-[-14px] md:text-[72px] md:mb-[-18px]';
const photoSrc = compact ? '/images/team/sm/daria-wave-01.avif' : '/images/team/daria-wave-01.avif';
const photoSrcset = compact
  ? '/images/team/sm/daria-wave-01.avif 1x, /images/team/daria-wave-01.avif 2x'
  : '/images/team/sm/daria-wave-01.avif 96w, /images/team/daria-wave-01.avif 192w';
const photoW = compact ? 96 : 192;
const photoH = compact ? 96 : 192;
---

<section class={sectionCls}>
  <div class={wrapperCls}>
    {/* Внешний грид: [цитата] | [видео] на десктопе, стопка на мобилке */}
    <div class="flex flex-col md:flex-row md:items-center md:gap-8 lg:gap-12">

      {/* Левая часть — фото + цитата (существующий блок) */}
      <div class="flex-1 min-w-0">
        <div class:list={[compact ? 'flex items-start text-left' : 'flex flex-col items-center text-center md:flex-row md:items-start md:text-left', containerGap]}>
          <!-- Photo -->
          <div class={photoWrapperCls}>
            <div class="daria-hover-wrap" style={`width:${photoW}px;height:${photoH}px`}>
              <img
                src={photoSrc}
                srcset={photoSrcset}
                sizes={compact ? undefined : '(max-width: 768px) 96px, 192px'}
                alt="Дарья Афанасьева"
                class={`daria-photo ${photoCls}`}
                width={photoW}
                height={photoH}
                loading="lazy"
              />
              <video
                class="daria-video"
                muted
                playsinline
                loop
                preload="metadata"
                aria-hidden="true"
              >
                <source src="/images/team/daria-wave.webm" type="video/webm" />
                <source src="/images/team/daria-wave.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
          <!-- Quote -->
          <div class={quoteWrapperCls}>
            <span class={quoteMarkCls}>&laquo;</span>
            {compact ? (
              <p class="text-[16px] md:text-[17px] leading-[1.55] text-body">
                Я сама мама подростка. Сделала лагерь таким, каким хотела бы видеть обучение своей дочери&nbsp;&mdash; не &laquo;по сценарию&raquo;.
              </p>
            ) : (
              <p class="text-[18px] leading-[1.65] text-body">
                Я сама мама подростка. Объездила разные лагеря, смотрела программы, читала отзывы. Везде было одно и то же&nbsp;&mdash; всё решено заранее, программа просто &laquo;идёт по сценарию&raquo;. Тогда я решила сделать лагерь таким, каким сама хотела бы видеть обучение своей дочери.
              </p>
            )}
            <div class={compact ? 'mt-2' : 'mt-3'}>
              <p class="text-[15px] font-bold text-body">&mdash; Дарья Афанасьева</p>
              <p class="text-[14px] md:text-[13px] text-body-muted">основатель АйДаКемп</p>
            </div>

            {/* Callback CTA от Дарьи */}
            <button
              id="daria-callback-btn"
              type="button"
              class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-semibold text-primary hover:text-primary-hover transition-colors"
            >
              Перезвоню и расскажу всё
              <i class="bi bi-arrow-right text-[13px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
            </button>

            {/* Proof-line */}
            <div class={`${compact ? 'mt-3' : 'mt-4'} flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[14px] md:text-[13px] text-body-muted`}>
              <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary transition-colors no-underline">
                <i class="bi bi-star-fill text-primary text-[12px]" aria-hidden="true"></i>
                <strong class="font-bold text-body">5.0</strong> на Яндекс.Картах
              </a>
              <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
              <span><strong class="font-bold text-body">5 лет</strong> работы</span>
              <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
              <span><strong class="font-bold text-body">1 200+</strong> детей</span>
              <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
              <a href="https://incamp.ru/camps/339484/" target="_blank" rel="noopener" class="hover:text-primary transition-colors no-underline">
                <strong class="font-bold text-body">ТОП-4</strong> по МО
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Правая часть — видео-блок */}
      {!compact && (
        <div class="mt-6 md:mt-0 md:w-[280px] lg:w-[320px] shrink-0">
          <VideoPlayer
            src="/video/daria-story.mp4"
            caption="«Мы живём в самом прекрасном IT-лагере на свете.<br>А все остальные лагеря нам завидуют...»"
            cues={DARIA_CUES}
            uid="daria"
            goalName="daria_video_play"
          />
        </div>
      )}

    </div>
  </div>
</section>

<!-- Модалка: Дарья перезвонит -->
<dialog id="dariaCallbackModal" class="m-0 h-full w-full max-w-none border-0 bg-black/50 p-0 backdrop:bg-black/50 outline-none">
  <div class="flex min-h-full items-end justify-center sm:items-center sm:p-4">
    <div class="relative w-full max-w-[420px] rounded-t-[20px] sm:rounded-[20px] bg-white px-6 pb-8 pt-6 shadow-xl">
      <!-- Close -->
      <button type="button" id="dariaCallbackClose" class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors" aria-label="Закрыть">
        <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
      </button>

      <!-- Header -->
      <div class="flex items-center gap-3 mb-4">
        <img src="/images/team/sm/team-daria-main-01.avif" alt="Дарья Афанасьева" width="48" height="48" class="h-12 w-12 rounded-full object-cover shrink-0" loading="lazy" />
        <div>
          <p class="text-[15px] font-bold text-body">Дарья Афанасьева</p>
          <p class="text-[13px] text-body-muted">перезвонит и расскажет всё</p>
        </div>
      </div>

      <!-- Phone -->
      <p class="text-[14px] font-semibold text-[#6e788a] mb-2">Ваш номер</p>
      <input
        id="daria-callback-phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        maxlength="18"
        placeholder="+7 (___) ___-__-__"
        class="h-[48px] w-full rounded-[10px] border-[1.5px] border-[#e6e6e6] bg-white px-[14px] text-[16px] text-body outline-none transition placeholder:text-[#919cab] focus:border-primary"
      />
      <p id="daria-callback-hint-phone" class="mt-1.5 hidden text-[13px] text-red-500">Введите номер полностью — 11 цифр (+7 …)</p>

      <CallTimeSelector />

      <!-- Consent: два чекбокса по требованиям 152-ФЗ / РКН -->
      <label class="mt-4 flex items-start gap-2 text-[13px] leading-[1.4] text-body-muted">
        <input type="checkbox" id="daria-callback-consent-policy" class="mt-[2px] h-4 w-4 shrink-0 rounded border border-slate-300 accent-primary" />
        <span>Ознакомлен(а) с <a href="/privacy-policy/" class="text-primary underline">Политикой обработки персональных данных</a></span>
      </label>
      <label class="mt-2 flex items-start gap-2 text-[13px] leading-[1.4] text-body-muted">
        <input type="checkbox" id="daria-callback-consent" class="mt-[2px] h-4 w-4 shrink-0 rounded border border-slate-300 accent-primary" />
        <span>Согласен(а) на <a href="/soglasie-na-obrabotku-personalnyh-dannyh/" class="text-primary underline">обработку персональных данных</a></span>
      </label>
      <p id="daria-callback-hint-consent" class="mt-1 hidden text-[13px] text-red-500">Поставьте обе галочки — без них не можем принять заявку</p>

      <button
        id="daria-callback-submit"
        type="button"
        class="mt-4 h-[48px] w-full rounded-[10px] bg-primary text-[16px] font-semibold text-[#0d1a2b] transition hover:bg-primary-hover"
      >
        Жду звонка
      </button>

      <!-- Success state (hidden) -->
      <div id="daria-callback-success" class="hidden text-center py-4">
        <i class="bi bi-check-circle-fill text-emerald-500 text-[32px]" aria-hidden="true"></i>
        <p class="mt-2 text-[16px] font-semibold text-body">Дарья перезвонит вам!</p>
        <p class="mt-1 text-[14px] text-body-muted">Обычно в течение нескольких часов</p>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* karaoke styles are applied via inline JS (Astro scoping bypass) */

  .daria-hover-wrap {
    position: relative;
    border-radius: inherit;
    overflow: hidden;
    cursor: pointer;
  }
  .daria-photo,
  .daria-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    transition: opacity 0.3s ease;
  }
  .daria-video {
    opacity: 0;
  }
  .daria-hover-wrap:hover .daria-photo,
  .daria-hover-wrap.playing .daria-photo {
    opacity: 0;
  }
  .daria-hover-wrap:hover .daria-video,
  .daria-hover-wrap.playing .daria-video {
    opacity: 1;
  }
</style>

<script>
  const wraps = document.querySelectorAll<HTMLElement>('.daria-hover-wrap');
  wraps.forEach(wrap => {
    const video = wrap.querySelector('video')!;
    wrap.addEventListener('mouseenter', () => {
      video.play().catch(() => {});
      wrap.classList.add('playing');
    });
    wrap.addEventListener('mouseleave', () => {
      video.pause();
      video.currentTime = 0;
      wrap.classList.remove('playing');
    });
    // Touch support
    wrap.addEventListener('click', () => {
      if (wrap.classList.contains('playing')) {
        video.pause();
        video.currentTime = 0;
        wrap.classList.remove('playing');
      } else {
        video.play().catch(() => {});
        wrap.classList.add('playing');
      }
    });
  });
</script>

<script>
  const modal = document.getElementById('dariaCallbackModal') as HTMLDialogElement;
  const openBtn = document.getElementById('daria-callback-btn');
  const closeBtn = document.getElementById('dariaCallbackClose');
  const phoneInput = document.getElementById('daria-callback-phone') as HTMLInputElement;
  const hintPhone = document.getElementById('daria-callback-hint-phone');
  const consentPolicy = document.getElementById('daria-callback-consent-policy') as HTMLInputElement;
  const consent = document.getElementById('daria-callback-consent') as HTMLInputElement;
  const hintConsent = document.getElementById('daria-callback-hint-consent');
  const submitBtn = document.getElementById('daria-callback-submit');
  const successEl = document.getElementById('daria-callback-success');

  openBtn?.addEventListener('click', () => {
    modal?.showModal();
    (window as any).trackGoal?.('daria_callback_open');
  });

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  // Phone formatting
  phoneInput?.addEventListener('input', () => {
    let d = phoneInput.value.replace(/\D/g, '');
    if (d.startsWith('8') && d.length > 1) d = '7' + d.slice(1);
    if (d.length > 0 && !d.startsWith('7')) d = '7' + d;
    d = d.slice(0, 11);
    let f = '+7';
    if (d.length > 1) f += ' (' + d.slice(1, 4);
    if (d.length > 4) f += ') ' + d.slice(4, 7);
    if (d.length > 7) f += '-' + d.slice(7, 9);
    if (d.length > 9) f += '-' + d.slice(9, 11);
    phoneInput.value = f;
    hintPhone?.classList.toggle('hidden', d.length === 11 || d.length === 0);
  });

  submitBtn?.addEventListener('click', async () => {
    const digits = phoneInput?.value.replace(/\D/g, '') || '';
    const phoneOk = digits.length === 11;
    const consentOk = consentPolicy?.checked && consent?.checked;

    hintPhone?.classList.toggle('hidden', phoneOk || digits.length === 0);
    hintConsent?.classList.toggle('hidden', !!consentOk);

    if (!phoneOk || !consentOk) {
      if (!phoneOk) phoneInput?.focus();
      else consentPolicy?.focus();
      return;
    }

    const callTimeInput = modal?.querySelector<HTMLInputElement>('[data-call-time-value]');
    submitBtn.textContent = 'Отправляем…';
    (submitBtn as HTMLButtonElement).disabled = true;

    try {
      const { submitLead } = await import('../scripts/form-submit');
      await submitLead({
        phone: phoneInput.value,
        age: '',
        form: 'daria_callback',
        call_time: callTimeInput?.value || '',
      });
      modal?.querySelector<HTMLElement>('.relative > *:not(#daria-callback-success):not(button[id="dariaCallbackClose"])')
      // Show success
      const formEls = modal?.querySelectorAll<HTMLElement>('p, input, label, button[id="daria-callback-submit"]');
      formEls?.forEach(el => el.classList.add('hidden'));
      successEl?.classList.remove('hidden');
      (window as any).trackGoal?.('daria_callback_submit');
      setTimeout(() => modal?.close(), 3000);
    } catch {
      submitBtn.textContent = 'Жду звонка';
      (submitBtn as HTMLButtonElement).disabled = false;
    }
  });
</script>

