---
const roles = [
  { name: 'Разработчик',         desc: 'Пишет код и собирает прототип. Отвечает за техническую часть — без него нечего показывать инвесторам.' },
  { name: 'Дизайнер',            desc: 'Делает интерфейс и логотип с помощью AI. Отвечает за то, как продукт выглядит.' },
  { name: 'Маркетолог',          desc: 'Придумывает название, слоган, готовит питч. Знает кому и зачем это нужно.' },
  { name: 'Финансовый директор', desc: 'Управляет бюджетом команды — покупает ресурсы, следит чтобы деньги не кончились раньше защиты.' },
  { name: 'Стратег',             desc: 'Определяет что делаем, для кого и чем отличаемся от других команд.' },
  { name: 'Тестировщик',         desc: 'Ищет баги и слабые места до питча. Задаёт неудобные вопросы своей же команде.' },
];

const steps = [
  {
    icon: 'bulb',
    title: 'Идея и паспорт',
    text: 'Брейншторм, паспорт проекта: для кого, какую проблему решает, чем отличается',
  },
  {
    icon: 'dollar',
    title: 'Покупка ресурсов',
    text: 'Рабочее место, интернет, консультации экспертов — всё за игровую валюту. Ресурсы ограничены',
  },
  {
    icon: 'cpu',
    title: 'Разработка и AI',
    text: 'Прототип, техзадание, AI для логотипа и текстов. Тестировщики ищут слабые места',
  },
  {
    icon: 'chart',
    title: 'Питч перед инвесторами',
    text: 'Два тура инвестиций. Финальная защита — 5 минут на питч и вопросы жюри',
  },
];

const outcomes = [
  'Опыт командной работы с распределёнными ролями',
  'Понимание что такое продукт, бюджет и питч',
  'Ощущение что сделал что-то настоящее — не учебное задание',
];
---

<section id="hackathon" class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Хакатон: один день — настоящий стартап</h2>
    </div>

    <p class="mt-3 text-[18px] leading-[1.6] text-body-muted">Хакатон — это отдельное событие внутри смены. Не продолжение проекта, а другой формат: команда, стартап, инвесторы.</p>

    <!-- Блок 1: Роли -->
    <div class="mt-6">
      <h3 class="text-[17px] font-semibold text-body">Команда собирается с нуля — <span class="font-normal text-body-muted">роли распределяются сразу:</span></h3>
      <div class="mt-3 flex flex-wrap gap-2" id="hackathon-roles">
        {roles.map((role, i) => (
          <button
            type="button"
            data-role-idx={i}
            class="role-badge inline-flex items-center gap-1 min-h-[40px] rounded-full border border-orange-200 bg-orange-50/40 px-4 py-2 text-[14px] font-medium text-orange-700 transition-all hover:border-orange-400 hover:bg-orange-100 hover:-translate-y-0.5 cursor-pointer"
          >{role.name}</button>
        ))}
      </div>

      <!-- Попап описания роли -->
      <div id="role-popup" class="hidden mt-3 rounded-xl border border-orange-200 bg-orange-50 px-4 py-3 text-[15px] leading-[1.55] text-body-muted transition-all">
        <span id="role-popup-name" class="font-semibold text-orange-700"></span>
        <span id="role-popup-sep"> — </span>
        <span id="role-popup-desc"></span>
      </div>
    </div>

    <!-- Блок 2: Степпер -->
    <div class="mt-8">
      <!-- Mobile: vertical -->
      <div class="space-y-0 md:hidden">
        {steps.map((step, i) => (
          <div class="flex gap-3">
            <div class="flex flex-col items-center">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-[14px] font-bold text-[#0d1a2b]">{i + 1}</div>
              {i < steps.length - 1 && <div class="w-px flex-1 bg-border my-1"></div>}
            </div>
            <div class={`${i < steps.length - 1 ? 'pb-5' : 'pb-0'}`}>
              <div class="flex items-center gap-2">
                {step.icon === 'bulb' && <i class="bi bi-lightbulb-fill text-[20px] text-primary" aria-hidden="true"></i>}
                {step.icon === 'dollar' && <i class="bi bi-currency-dollar text-[20px] text-primary" aria-hidden="true"></i>}
                {step.icon === 'cpu' && <i class="bi bi-cpu-fill text-[20px] text-primary" aria-hidden="true"></i>}
                {step.icon === 'chart' && <i class="bi bi-graph-up-arrow text-[20px] text-primary" aria-hidden="true"></i>}
                <h4 class="text-[17px] font-semibold text-body">{step.title}</h4>
              </div>
              <p class="mt-1.5 text-[16px] leading-[1.6] text-body-muted">{step.text}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop: horizontal -->
      <div class="hidden md:grid md:grid-cols-4 md:gap-0">
        {steps.map((step, i) => (
          <div class="relative flex flex-col items-center text-center">
            <div class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-[14px] font-bold text-[#0d1a2b]">{i + 1}</div>
            {i < steps.length - 1 && <div class="absolute top-5 left-[calc(50%+20px)] h-px w-[calc(100%-40px)] bg-border"></div>}
            <div class="mt-3 flex items-center justify-center gap-1.5">
              {step.icon === 'bulb' && <i class="bi bi-lightbulb-fill text-[20px] text-primary" aria-hidden="true"></i>}
              {step.icon === 'dollar' && <i class="bi bi-currency-dollar text-[20px] text-primary" aria-hidden="true"></i>}
              {step.icon === 'cpu' && <i class="bi bi-cpu-fill text-[20px] text-primary" aria-hidden="true"></i>}
              {step.icon === 'chart' && <i class="bi bi-graph-up-arrow text-[20px] text-primary" aria-hidden="true"></i>}
              <h4 class="text-[17px] font-semibold text-body">{step.title}</h4>
            </div>
            <p class="mt-1.5 px-2 text-[16px] leading-[1.6] text-body-muted">{step.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Блок 3: Итог -->
    <div class="mt-8 rounded-xl bg-slate-900 p-5 md:p-6">
      <h3 class="text-[18px] font-semibold text-white">Что остаётся после</h3>
      <div class="mt-4 space-y-3">
        {outcomes.map((item) => (
          <div class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-[20px] text-white mt-0.5 shrink-0" aria-hidden="true"></i>
            <p class="text-[18px] leading-[1.6] text-slate-300">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initHackathon() {
    const roles = [
      { name: 'Разработчик',         desc: 'Пишет код и собирает прототип. Отвечает за техническую часть — без него нечего показывать инвесторам.' },
      { name: 'Дизайнер',            desc: 'Делает интерфейс и логотип с помощью AI. Отвечает за то, как продукт выглядит.' },
      { name: 'Маркетолог',          desc: 'Придумывает название, слоган, готовит питч. Знает кому и зачем это нужно.' },
      { name: 'Финансовый директор', desc: 'Управляет бюджетом команды — покупает ресурсы, следит чтобы деньги не кончились раньше защиты.' },
      { name: 'Стратег',             desc: 'Определяет что делаем, для кого и чем отличаемся от других команд.' },
      { name: 'Тестировщик',         desc: 'Ищет баги и слабые места до питча. Задаёт неудобные вопросы своей же команде.' },
    ];

    const popup   = document.getElementById('role-popup')!;
    const popName = document.getElementById('role-popup-name')!;
    const popDesc = document.getElementById('role-popup-desc')!;
    let activeIdx: number | null = null;

    document.querySelectorAll<HTMLElement>('.role-badge').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.roleIdx);

        // Тот же — закрыть
        if (activeIdx === idx) {
          activeIdx = null;
          popup.classList.add('hidden');
          btn.classList.remove('border-orange-400', 'bg-orange-50', 'text-orange-700');
          return;
        }

        // Снять выделение с предыдущего
        document.querySelectorAll<HTMLElement>('.role-badge').forEach(b =>
          b.classList.remove('!border-orange-400', '!bg-orange-50', '!text-orange-700')
        );

        activeIdx = idx;
        popName.textContent = roles[idx].name;
        popDesc.textContent = roles[idx].desc;
        popup.classList.remove('hidden');

        // Выделить активный
        btn.classList.add('!border-orange-400', '!bg-orange-50', '!text-orange-700');
      });
    });

    // Клик вне — закрыть
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#hackathon-roles') && activeIdx !== null) {
        activeIdx = null;
        popup.classList.add('hidden');
        document.querySelectorAll<HTMLElement>('.role-badge').forEach(b =>
          b.classList.remove('!border-orange-400', '!bg-orange-50', '!text-orange-700')
        );
      }
    });
  }

  document.addEventListener('astro:page-load', initHackathon);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initHackathon(); }, { timeout: 3000 });
  } else {
    setTimeout(initHackathon, 200);
  }
</script>
