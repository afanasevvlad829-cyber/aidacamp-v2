---
/**
 * FAQSchema — JSON-LD FAQPage без UI.
 *
 * Только для страниц, которые рисуют СВОЙ видимый accordion (detox-ot-telefona,
 * pitanie, razmeshchenie, vakansii, статьи блога). Передаваемые сюда вопросы обязаны
 * присутствовать на странице как видимый текст — это требование Google к FAQPage.
 *
 * Страницы, которые рендерят <FAQ />, схему НЕ подключают: FAQ.astro отдаёт её сам,
 * по факту отрисованного. Вопросы страницы передаются в <FAQ extraItems={...} />.
 *
 * ⚠️ items — обязательный проп. Раньше был фолбэк на faqFlat (15 общесайтовых
 * вопросов), и LandingLayout рендерил <FAQSchema /> без пропов — это давало второй
 * FAQPage на 123 страницах, целиком из вопросов, которых на странице не было
 * (инцидент 31.07.2026). Фолбэк не возвращать.
 *
 * Страж на дубли: scripts/check-faq-schema.mjs (в npm run build).
 */

import type { FAQItem } from '../data/faq';

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

// Schema.org Text — только чистый текст; HTML-теги (напр. <a> в ответах со
// ссылками) ломают парсинг JSON-LD у html-minifier-terser и невалидны по спеке.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.a),
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
