---
/**
 * FAQSchema — JSON-LD FAQPage без UI.
 *
 * ⚠️ items — ОБЯЗАТЕЛЬНЫЙ проп. Раньше был фолбэк на faqFlat (15 общесайтовых
 * вопросов), и LandingLayout рендерил <FAQSchema /> без пропов — это давало второй
 * FAQPage на 123 страницах (инцидент 31.07.2026). Фолбэк не возвращать: пропущенный
 * проп обязан ломать билд, а не тихо подставлять чужой контент.
 *
 * Один FAQPage на URL — проверяется scripts/check-faq-schema.mjs в npm run build.
 *
 * Передаваемые вопросы обязаны быть на странице как видимый текст: этого требует
 * Google. Страж пока только предупреждает об этом — см. TODO в нём.
 */

import type { FAQItem } from '../data/faq';

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

// Schema.org Text — только чистый текст; HTML-теги (напр. <a> в ответах со
// ссылками) ломают парсинг JSON-LD у html-minifier-terser и невалидны по спеке.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.a),
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
