---
/**
 * TrustBlock — блок доверия: страховка, медпункт, охрана, лицензии, реестры.
 * Все бейджи кликабельны → /legal (документы, лицензии, реестры).
 * Props: hideInsurance — скрыть бейдж «Страхование ответственности» (на /r/)
 */
interface Props { hideInsurance?: boolean; }
const { hideInsurance = false } = Astro.props;
const LEGAL = '/legal';
const allBadges = [
  {
    icon: 'bi-umbrella-fill', color: 'bg-blue-100', iconColor: 'text-blue-600',
    title: 'Страхование ответственности', sub: 'каждый ребёнок застрахован',
  },
  {
    icon: 'bi-heart-pulse-fill', color: 'bg-red-100', iconColor: 'text-red-500',
    title: 'Медпункт 24/7', sub: 'медсестра на территории',
  },
  {
    icon: 'bi-shield-fill', color: 'bg-slate-200', iconColor: 'text-slate-600',
    title: 'Охрана', sub: 'закрытая территория санатория',
  },
  {
    icon: 'bi-patch-check-fill', color: 'bg-emerald-100', iconColor: 'text-emerald-600',
    title: 'Лицензия на образование', sub: 'налоговый вычет 13%',
  },
  {
    icon: 'bi-award-fill', color: 'bg-amber-100', iconColor: 'text-amber-600',
    title: 'РТО 025773', sub: 'реестр туроператоров',
  },
  {
    icon: 'bi-journal-bookmark', color: 'bg-violet-100', iconColor: 'text-violet-600',
    title: 'Лагерь в реестре', sub: 'Роспотребнадзор',
  },
];
const badges = hideInsurance ? allBadges.filter(b => b.title !== 'Страхование ответственности') : allBadges;
---

<section class="mx-auto max-w-[1312px] px-4 py-6 md:py-8">
  <p class="text-center text-[13px] uppercase tracking-[0.08em] font-semibold text-slate-400 mb-4">
    Безопасность и документы
  </p>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    {badges.map(b => (
      <a
        href={LEGAL}
        class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center hover:bg-slate-100 hover:shadow-sm transition-all duration-150 cursor-pointer"
        aria-label={b.title}
      >
        <div class={`h-10 w-10 rounded-full ${b.color} flex items-center justify-center shrink-0`}>
          <i class={`bi ${b.icon} text-[18px] ${b.iconColor}`} aria-hidden="true"></i>
        </div>
        <div>
          <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">{b.title}</p>
          <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">{b.sub}</p>
        </div>
      </a>
    ))}
  </div>
</section>
