---
/**
 * TrustBlock — блок доверия: страховка, медпункт, охрана, лицензии, реестры.
 * Вставляется перед блоком бронирования (Shifts) для повышения конверсии.
 */
---

<section class="mx-auto max-w-[1312px] px-4 py-6 md:py-8">
  <p class="text-center text-[13px] uppercase tracking-[0.08em] font-semibold text-slate-400 mb-4">
    Безопасность и документы
  </p>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">

    <!-- Страховка НС -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
        <i class="bi bi-umbrella-fill text-[18px] text-blue-600" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">Страховка НС</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">каждый ребёнок застрахован</p>
      </div>
    </div>

    <!-- Медпункт -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
        <i class="bi bi-heart-pulse-fill text-[18px] text-red-500" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">Медпункт 24/7</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">медсестра на территории</p>
      </div>
    </div>

    <!-- Охрана -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-slate-200 flex items-center justify-center shrink-0">
        <i class="bi bi-shield-fill text-[18px] text-slate-600" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">Охрана</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">закрытая территория санатория</p>
      </div>
    </div>

    <!-- Образовательная лицензия -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
        <i class="bi bi-patch-check-fill text-[18px] text-emerald-600" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">Лицензия на образование</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">налоговый вычет 13%</p>
      </div>
    </div>

    <!-- РТО -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
        <i class="bi bi-award-fill text-[18px] text-amber-600" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">РТО 025773</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">реестр туроператоров</p>
      </div>
    </div>

    <!-- Реестр детских лагерей -->
    <div class="flex flex-col items-center gap-2 rounded-xl bg-slate-50 px-3 py-4 text-center">
      <div class="h-10 w-10 rounded-full bg-violet-100 flex items-center justify-center shrink-0">
        <i class="bi bi-journal-bookmark text-[18px] text-violet-600" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-slate-800 leading-[1.3]">Лагерь в реестре</p>
        <p class="text-[11px] text-slate-400 mt-0.5 leading-[1.3]">Роспотребнадзор</p>
      </div>
    </div>

  </div>
</section>
