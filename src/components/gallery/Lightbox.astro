<dialog id="galleryLightbox" class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/90 p-4 backdrop:bg-black/90">
  <div class="flex h-full items-center justify-center">
    <button type="button" data-gallery-lightbox-close aria-label="Закрыть" style="outline:none;box-shadow:none" class="absolute right-4 top-4 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white outline-none focus:outline-none focus:ring-0 focus-visible:outline-none">
      <i class="bi bi-x-lg text-[20px]" aria-hidden="true"></i>
    </button>
    <button type="button" data-gallery-prev aria-label="Назад" class="absolute left-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white md:flex">
      <i class="bi bi-chevron-left text-[20px]" aria-hidden="true"></i>
    </button>
    <button type="button" data-gallery-next aria-label="Вперёд" class="absolute right-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white md:flex">
      <i class="bi bi-chevron-right text-[20px]" aria-hidden="true"></i>
    </button>
    <div class="flex flex-col items-center">
      <img data-gallery-lightbox-img class="max-h-[80vh] max-w-full rounded-lg object-contain" src="" alt="" width="1200" height="900" />
      <p data-gallery-counter class="mt-3 text-center text-[14px] text-white/60"></p>
    </div>
  </div>
</dialog>
