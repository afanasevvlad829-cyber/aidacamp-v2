---
// News Jazz — живые AI-новости в Hero
// Данные: /data/news-jazz.json (обновляется каждый час кроном на сервере)
---

<!-- ── Модалка ── -->
<div id="nj-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="nj-modal-title"
  style="display:none;position:fixed;inset:0;z-index:500;background:rgba(5,9,18,0.82);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);align-items:center;justify-content:center;padding:20px;">
  <div style="background:#111d2e;border-radius:20px;padding:28px;max-width:480px;width:100%;position:relative;animation:nj-modal-in 0.22s ease-out;">
    <button id="nj-modal-close" aria-label="Закрыть"
      style="position:absolute;top:16px;right:16px;background:rgba(255,255,255,0.08);border:none;border-radius:50%;width:32px;height:32px;color:rgba(255,255,255,0.6);font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>

    <div style="font-size:10px;font-weight:700;letter-spacing:1.2px;color:#ec9b44;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
      <span style="width:6px;height:6px;border-radius:50%;background:#ec9b44;display:inline-block;flex-shrink:0"></span>
      AI News · TechCrunch
    </div>
    <div id="nj-modal-title" style="font-size:20px;font-weight:700;color:#fff;line-height:1.3;margin-bottom:6px;"></div>
    <div id="nj-modal-orig" style="font-size:12px;color:rgba(255,255,255,0.32);margin-bottom:16px;line-height:1.4;"></div>
    <div id="nj-modal-summary" style="font-size:15px;line-height:1.65;color:rgba(255,255,255,0.8);margin-bottom:20px;"></div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <span id="nj-modal-meta" style="font-size:12px;color:rgba(255,255,255,0.3);"></span>
      <a id="nj-modal-link" href="#" target="_blank" rel="noopener"
        style="display:inline-flex;align-items:center;gap:6px;background:#ec9b44;color:#0d1a2b;font-size:13px;font-weight:700;padding:9px 18px;border-radius:20px;text-decoration:none;">
        Читать на TechCrunch →
      </a>
    </div>
  </div>
</div>

<style is:global>
  @keyframes nj-modal-in {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
  }
  /* Карточка — десктоп */
  .nj-card {
    display: inline-flex;
    align-items: stretch;
    background: transparent;
    margin-top: 24px;
    min-width: 280px;
    max-width: 420px;
    text-decoration: none;
    cursor: pointer;
  }

  /* Карточка — мобайл */
  .nj-card-mobile {
    display: flex;
    align-items: stretch;
    background: transparent;
    width: 100%;
    text-decoration: none;
    cursor: pointer;
  }

  .nj-stripe { width: 3px; background: #ec9b44; flex-shrink: 0; border-radius: 2px; }

  .nj-body { padding: 6px 14px 8px; flex: 1; min-width: 0; }

  .nj-label { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }

  .nj-dot { width: 7px; height: 7px; border-radius: 50%; background: #ec9b44; flex-shrink: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .nj-dot { animation: nj-pulse 1.6s ease-in-out infinite; }
  }

  .nj-label-text { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; color: #ec9b44; text-transform: uppercase; }

  .nj-text { font-size: 16px; font-weight: 700; color: #fff; line-height: 1.35; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity 0.35s; text-shadow: 0 1px 6px rgba(0,0,0,0.7); }

  .nj-orig { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.3; margin-bottom: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity 0.35s; }

  .nj-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

  .nj-time   { font-size: 13px; color: rgba(255,255,255,0.6); transition: opacity 0.35s; flex-shrink: 0; }
  .nj-source { font-size: 13px; color: rgba(255,255,255,0.55); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity 0.35s; }

  .nj-arrow { flex-shrink: 0; display: flex; align-items: center; padding: 6px 4px 8px 8px; color: rgba(255,255,255,0.4); transition: color 0.2s; }
  .nj-card:hover .nj-arrow,
  .nj-card-mobile:hover .nj-arrow { color: #ec9b44; }

  @keyframes nj-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
</style>

<script is:inline>
(function () {
  var news = [];
  var idx  = 0;

  function fadeSwap(els, fn) {
    els.forEach(function(el) { if (el) el.style.opacity = '0'; });
    setTimeout(function() {
      fn();
      els.forEach(function(el) { if (el) el.style.opacity = '1'; });
    }, 340);
  }

  function setCard(suffix, item) {
    var textEl   = document.getElementById('nj-text-'   + suffix);
    var origEl   = document.getElementById('nj-orig-'   + suffix);
    var sourceEl = document.getElementById('nj-source-' + suffix);
    var timeEl   = document.getElementById('nj-time-'   + suffix);
    if (!textEl) return;
    fadeSwap([textEl, origEl, sourceEl, timeEl], function() {
      if (textEl)   textEl.textContent   = item.text;
      if (origEl)   origEl.textContent   = item.orig;
      if (sourceEl) sourceEl.textContent = item.source;
      if (timeEl)   timeEl.textContent   = item.time;
      // Обновляем aria-label чтобы accessible name совпадал с видимым текстом (WCAG 2.5.3)
      var linkEl = document.getElementById('nj-link-' + suffix);
      if (linkEl) linkEl.setAttribute('aria-label', 'Читать AI-новость: ' + item.text);
    });
  }

  function currentItem() {
    return news[(idx - 1 + news.length) % news.length];
  }

  function tick() {
    if (!news.length) return;
    var item = news[idx % news.length];
    setCard('d', item);
    setCard('m', item);
    idx = (idx + 1) % news.length;
  }

  /* ── Модалка ── */
  function openModal(item) {
    document.getElementById('nj-modal-title').textContent   = item.text;
    document.getElementById('nj-modal-orig').textContent    = item.orig;
    document.getElementById('nj-modal-summary').textContent = item.summary || '';
    document.getElementById('nj-modal-meta').textContent    = item.source + ' · ' + item.time;
    document.getElementById('nj-modal-link').href           = item.url;
    var bd = document.getElementById('nj-modal-backdrop');
    bd.style.display = 'flex';
    _lockScroll();

    // Метрика-цель
    if (typeof ym !== 'undefined') { ym(96499295, 'reachGoal', 'news_jazz_click'); }
  }

    // iOS Safari: overflow:hidden alone doesn't prevent scroll — use position:fixed
  let _savedScrollY = 0;
  function _lockScroll() {
    _savedScrollY = window.scrollY;
    Object.assign(document.body.style, { position: 'fixed', top: `-${_savedScrollY}px`, width: '100%', overflow: 'hidden' });
  }
  function _unlockScroll() {
    Object.assign(document.body.style, { position: '', top: '', width: '', overflow: '' });
    window.scrollTo(0, _savedScrollY);
  }
function closeModal() {
    document.getElementById('nj-modal-backdrop').style.display = 'none';
    _unlockScroll();
  }

  document.getElementById('nj-modal-close').addEventListener('click', closeModal);
  document.getElementById('nj-modal-backdrop').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  ['nj-link-d', 'nj-link-m'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('click', function(e) {
      e.preventDefault();
      if (!news.length) return;
      openModal(currentItem());
    });
  });

  /* ── Загрузка данных ── */
  function start() { tick(); setInterval(tick, 8000); }

  /* ── Загрузка данных — отложена на 2с чтобы не конкурировать с LCP ── */
  function loadData() {
    fetch('/data/news-jazz.json')
      .then(function(r) { return r.json(); })
      .then(function(d) { news = d.items || []; start(); })
      .catch(function()  { start(); });
  }
  if (document.readyState === 'complete') {
    setTimeout(loadData, 2000);
  } else {
    window.addEventListener('load', function() { setTimeout(loadData, 2000); }, { once: true });
  }
})();
</script>
