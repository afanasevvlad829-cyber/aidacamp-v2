---
/**
 * TaxCalculator — интерактивный калькулятор налогового вычета за путёвку в лагерь.
 *
 * Формула:
 *   residential_part = 3 800 ₽ × кол-во дней смены
 *     (наша внутренняя себестоимость проживания + питания)
 *   educational_part = стоимость путёвки − residential_part
 *   deduction_base = min(educational_part, 110 000 ₽)
 *     (лимит НК РФ на обучение одного ребёнка в год)
 *   возврат = deduction_base × 13%
 *
 * Props:
 *   - variant: 'full' | 'compact' (по умолчанию 'full')
 *   - title: заголовок над калькулятором (по умолчанию "Калькулятор налогового вычета")
 */

import { mainShifts, PRICE_S2 } from '../data/shifts';
import { fmtPrice } from '../data/dynamicPrices';

interface Props {
  variant?: 'full' | 'compact';
  title?: string;
}

const { variant = 'full', title = 'Калькулятор налогового вычета' } = Astro.props;

// Единый источник правды — data/shifts.ts.
// Парсим цену из строки "74 900 ₽" и дни из "10 дней" чтобы не дублировать числа.
const parsePrice = (s: string) => parseInt(s.replace(/[^\d]/g, ''), 10) || 0;
const parseDays = (s: string) => parseInt(s, 10) || 0;

const orderedShifts = [...mainShifts];

const shifts = orderedShifts.map((s) => ({
  id: s.id,
  label: `${s.name} — ${s.dates}, ${s.duration}`,
  price: parsePrice(s.price),
  days: parseDays(s.duration),
  popular: s.popular ?? false,
}));
---

<section class="tax-calc mx-auto my-8 max-w-[720px] rounded-[16px] border border-orange-100 bg-white p-6 md:p-8 shadow-[0_4px_20px_rgba(236,124,0,0.08)]">
  <div class="mb-5 flex items-center gap-2">
    <div class="list-accent-dot"></div>
    <h3 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
      {title}
    </h3>
  </div>

  <p class="mb-5 text-base leading-[1.6] text-slate-600">
    Путёвка в АйДаКемп частично квалифицируется как оплата обучения ребёнка —
    а это право на налоговый вычет 13%. Калькулятор покажет ориентировочную сумму возврата.
  </p>

  <!-- Выбор смены -->
  <div class="mb-5">
    <label for="tc-shift" class="mb-2 block text-base font-semibold text-slate-700 uppercase tracking-wide">
      Выберите смену 2026
    </label>
    <!-- appearance-none + кастомный chevron справа = одинаковое оформление во всех браузерах -->
    <div class="relative">
    <select
      id="tc-shift"
      class="w-full appearance-none rounded-[10px] border border-slate-300 bg-white px-4 py-3 pr-10 text-base text-slate-900 focus:border-orange-500 focus:outline-none"
    >
      <option value="" disabled>— Выберите смену —</option>
      {shifts.map((s) => (
        <option
          value={s.id}
          data-price={s.price}
          data-days={s.days}
          selected={s.popular}
          data-option-price={s.id}
          data-option-label={s.label}
          data-option-popular={s.popular ? 'true' : undefined}
        >
          {s.label} — {fmtPrice(s.price)}{s.popular ? ' · популярная' : ''}
        </option>
      ))}
      <option value="custom" data-price="0" data-days="0">
        Другая / ввести вручную
      </option>
    </select>
      <i
        class="bi bi-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-base text-slate-500"
        aria-hidden="true"
      ></i>
    </div>
  </div>

  <!-- Ручной ввод (скрыт по умолчанию) -->
  <div id="tc-manual" class="mb-5 hidden grid grid-cols-2 gap-3">
    <div>
      <label for="tc-price" class="mb-2 block text-base font-semibold text-slate-700 uppercase tracking-wide">
        Стоимость, ₽
      </label>
      <input
        type="number"
        id="tc-price"
        min="0"
        step="1000"
        placeholder="75000"
        class="w-full rounded-[10px] border border-slate-300 px-4 py-3 text-base text-slate-900 focus:border-orange-500 focus:outline-none"
      />
    </div>
    <div>
      <label for="tc-days" class="mb-2 block text-base font-semibold text-slate-700 uppercase tracking-wide">
        Дней в смене
      </label>
      <input
        type="number"
        id="tc-days"
        min="1"
        max="30"
        placeholder="10"
        class="w-full rounded-[10px] border border-slate-300 px-4 py-3 text-base text-slate-900 focus:border-orange-500 focus:outline-none"
      />
    </div>
  </div>

  <!-- Результат -->
  <div class="rounded-[14px] bg-gradient-to-br from-orange-50 to-amber-50 p-5 border border-orange-100">
    <div class="mb-3 flex items-baseline justify-between gap-2">
      <span class="text-base text-slate-600">Ориентировочный возврат:</span>
      <span id="tc-deduction" class="text-[32px] md:text-[36px] font-bold leading-none text-orange-600">
        —
      </span>
    </div>
    <div class="text-base text-slate-600">
      Итого за смену:
      <b id="tc-net" class="text-slate-900">—</b>
      <span class="text-slate-400">(путёвка минус возврат)</span>
    </div>
  </div>

  {variant === 'full' && (
    <div class="mt-4 text-base text-slate-600">
      <button type="button" id="tc-breakdown-toggle" aria-expanded="false" class="cursor-pointer font-semibold text-orange-600 hover:text-orange-700">
        Как считается (разбор по частям) ↓
      </button>
      <ul id="tc-breakdown-panel" class="hidden mt-3 flex flex-col gap-2 pl-1">
        <li>
          <span class="text-slate-500">Стоимость путёвки:</span>
          <b id="tc-price-out" class="text-slate-900">{PRICE_S2}</b>
        </li>
        <li>
          <span class="text-slate-500">Бытовая часть (проживание + 5-разовое питание, 3 800 ₽/день):</span>
          <b id="tc-resid-out" class="text-slate-900">53 200 ₽</b>
        </li>
        <li>
          <span class="text-slate-500">Образовательная часть (IT-программа, преподаватели, материалы):</span>
          <b id="tc-edu-out" class="text-slate-900">41 800 ₽</b>
        </li>
        <li>
          <span class="text-slate-500">База для вычета (лимит НК РФ — 110 000 ₽/год на одного ребёнка):</span>
          <b id="tc-base-out" class="text-slate-900">41 800 ₽</b>
        </li>
        <li class="mt-2 text-slate-700">
          <span class="text-orange-600 font-semibold">13% × база = возврат:</span>
          <b id="tc-deduction-out" class="text-orange-700">—</b>
        </li>
      </ul>
    </div>
  )}

  <!-- Дисклеймеры -->
  <div class="mt-5 flex flex-col gap-2 text-base text-slate-500 leading-[1.5]">
    <p>
      ⓘ Расчёт носит исключительно ориентировочный характер и не является офертой, гарантией выплаты конкретной суммы или документом, на который можно ссылаться при предъявлении требований к ООО «ВОИП КОННЕКТ». Итоговый размер налогового вычета определяется налоговым органом самостоятельно на основании представленных документов и зависит от суммы фактически уплаченного вами НДФЛ, наличия иных вычетов в налоговом периоде и действующего законодательства.
    </p>
    <p>
      <i class="bi bi-file-earmark-text mr-1" aria-hidden="true"></i>Договор, акт, платёжное поручение и копию лицензии оформляем <b>по запросу</b> после оплаты путёвки.
    </p>
    <p>
      <i class="bi bi-calendar-event mr-1" aria-hidden="true"></i>Декларация 3-НДФЛ подаётся в следующем году за годом оплаты (смена лета 2026 → декларация в 2027).
      Альтернатива — оформить вычет через работодателя в том же году.
    </p>
  </div>

  <!--
    CTA «Купить смену» — навигирует на страницу выбранной смены /shifts/[id]/
    Если смена = «custom» (ручной ввод) — fallback на /kupit-putevku-v-lager/.
  -->
  <button
    type="button"
    id="tc-buy-btn"
    data-analytics-goal="tc_buy_shift"
    class="mt-5 inline-flex items-center gap-2 rounded-[12px] border border-primary/55 bg-primary/8 px-6 py-3 text-base font-semibold text-primary transition-colors hover:bg-primary/14 hover:border-primary/75 disabled:cursor-not-allowed disabled:border-border disabled:bg-surface disabled:text-body-faint"
  >
    Купить смену →
  </button>
</section>

<script is:inline>
  (function () {
    const sel = document.getElementById('tc-shift');
    const manual = document.getElementById('tc-manual');
    const priceEl = document.getElementById('tc-price');
    const daysEl = document.getElementById('tc-days');

    const RESIDENTIAL_PER_DAY = 3800;
    const DEDUCTION_LIMIT_CHILD = 110000;
    const DEDUCTION_RATE = 0.13;

    const fmt = (n) => n.toLocaleString('ru-RU');
    const roundTo100 = (n) => Math.round(n / 100) * 100;

    function recalc() {
      let price, days;
      const selected = sel.selectedOptions[0];
      const isCustom = sel.value === 'custom';

      manual.classList.toggle('hidden', !isCustom);
      manual.classList.toggle('grid', isCustom);

      if (isCustom) {
        price = parseInt(priceEl.value) || 0;
        days = parseInt(daysEl.value) || 0;
      } else {
        price = parseInt(selected?.dataset.price) || 0;
        days = parseInt(selected?.dataset.days) || 0;
      }

      if (!price || !days) {
        ['tc-deduction', 'tc-net', 'tc-price-out', 'tc-resid-out', 'tc-edu-out', 'tc-base-out', 'tc-deduction-out']
          .forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.textContent = '—';
          });
        return;
      }

      const residential = RESIDENTIAL_PER_DAY * days;
      const edu = Math.max(0, price - residential);
      const base = Math.min(edu, DEDUCTION_LIMIT_CHILD);
      const deduction = roundTo100(base * DEDUCTION_RATE);
      const net = price - deduction;

      const set = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      set('tc-deduction', '~' + fmt(deduction) + ' ₽');
      set('tc-net', fmt(net) + ' ₽');
      set('tc-price-out', fmt(price) + ' ₽');
      set('tc-resid-out', fmt(residential) + ' ₽');
      set('tc-edu-out', fmt(edu) + ' ₽');
      set('tc-base-out', fmt(base) + ' ₽' + (edu > DEDUCTION_LIMIT_CHILD ? ' (лимит НК)' : ''));
      set('tc-deduction-out', fmt(Math.round(base * DEDUCTION_RATE)) + ' ₽');
    }

    sel?.addEventListener('change', recalc);
    priceEl?.addEventListener('input', recalc);
    daysEl?.addEventListener('input', recalc);

    // CTA «Купить смену» → навигирует на страницу смены
    // (или /kupit-putevku-v-lager/ если выбран «Другая / ввести вручную»).
    const buyBtn = document.getElementById('tc-buy-btn');
    buyBtn?.addEventListener('click', () => {
      const shiftId = sel?.value;
      // BUGFIX: если TaxCalculator открыт внутри TaxWidget модалки —
      // её надо закрыть ДО навигации, иначе она останется открытой
      const taxModal = document.getElementById('tax-widget-modal');
      const taxClose = document.getElementById('tax-widget-close');
      if (taxModal && !taxModal.classList.contains('hidden')) {
        taxClose?.click();
      }
      if (!shiftId || shiftId === 'custom') {
        window.location.href = '/kupit-putevku-v-lager/';
        return;
      }
      // Навигируем на страницу смены с небольшой задержкой, чтобы tax-widget успела закрыться
      setTimeout(() => {
        window.location.href = `/shifts/${shiftId}/`;
      }, 50);
      window.acTrack && window.acTrack('tc_buy_shift', { shiftId: shiftId });
    });

    // Initial render
    recalc();

    // Breakdown toggle
    const breakdownToggle = document.getElementById('tc-breakdown-toggle');
    const breakdownPanel = document.getElementById('tc-breakdown-panel');
    if (breakdownToggle && breakdownPanel) {
      breakdownToggle.addEventListener('click', function () {
        const expanded = breakdownToggle.getAttribute('aria-expanded') === 'true';
        breakdownToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        breakdownPanel.classList.toggle('hidden', expanded);
        breakdownToggle.textContent = expanded
          ? 'Как считается (разбор по частям) ↓'
          : 'Как считается (разбор по частям) ↑';
      });
    }
  })();
</script>
