---
<!-- Video modal -->
<dialog id="videoModal" class="m-0 h-full w-full max-w-none border-0 outline-none bg-black/90 p-0 backdrop:bg-black/90">
  <div class="flex h-full items-center justify-center p-4">
    <button type="button" id="videoModalClose"
            aria-label="Закрыть" class="absolute right-4 top-4 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <iframe id="videoFrame" class="rounded-[18px]" style="height:calc(100dvh - 48px);aspect-ratio:9/16;max-width:calc(100vw - 32px);border:none"
            allow="autoplay; fullscreen; encrypted-media; picture-in-picture" allowfullscreen></iframe>
  </div>
</dialog>

<script>
  function closeVideoModal() {
    const frame = document.getElementById('videoFrame') as HTMLIFrameElement | null;
    const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
    if (frame) frame.src = '';
    modal?.close();
  }

  function initVideoModal() {
    const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('videoModalClose');
    if (!modal) return;
    closeBtn?.addEventListener('click', closeVideoModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeVideoModal(); });
  }

  document.addEventListener('astro:page-load', initVideoModal);
  initVideoModal();
</script>
