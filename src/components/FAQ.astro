---
/**
 * FAQ — видимый accordion + FAQPage JSON-LD.
 *
 * Схема отдаётся ровно по тем вопросам, которые компонент отрисовал: Google требует,
 * чтобы размеченные вопрос и ответ были видны пользователю. Поэтому НЕ добавляй сюда
 * отдельный «список для схемы» и не подключай на ту же страницу FAQSchema.astro —
 * будет второй FAQPage на одном URL. Страж: scripts/check-faq-schema.mjs.
 *
 * Общесайтовые вопросы — из src/data/faq.ts. Вопросы конкретной страницы передаются
 * через extraItems: они рендерятся первой (открытой по умолчанию) вкладкой и попадают
 * в ту же разметку.
 */
import { faqCategories, type FAQItem } from '../data/faq';
const allCategories = faqCategories;

interface Props {
  only?: string[];
  /** Точечный набор вопросов из разных категорий, формат "categoryId:index" (0-based), напр. "documents:0". Рендерится одной плоской панелью без вкладок. */
  items?: string[];
  /** Вопросы конкретной страницы. Рендерятся первой, открытой по умолчанию вкладкой и попадают в FAQPage — раньше такие вопросы уходили только в разметку (FAQSchema в slot="head") и не были видны пользователю. */
  extraItems?: FAQItem[];
  /** Заголовок вкладки для extraItems. */
  extraLabel?: string;
  moreLink?: { href: string; text: string };
  intro?: { text: string; href: string; linkText: string };
  heading?: string;
}
const { only, items, extraItems, extraLabel = 'Частые вопросы', moreLink, intro, heading = 'FAQ' }: Props = Astro.props;

let visibleCategories: typeof allCategories;
if (items) {
  const picked = items
    .map((spec) => {
      const [catId, idxStr] = spec.split(':');
      const cat = allCategories.find((c) => c.id === catId);
      return cat?.items[Number(idxStr)];
    })
    .filter((item): item is FAQItem => Boolean(item));
  visibleCategories = [{ id: 'custom', label: 'Вопросы и ответы', items: picked }];
} else {
  visibleCategories = only ? allCategories.filter((cat) => only.includes(cat.id)) : allCategories;
}

// Вопросы страницы — всегда первыми: первая вкладка открыта по умолчанию.
if (extraItems && extraItems.length) {
  visibleCategories = [{ id: 'page', label: extraLabel, items: extraItems }, ...visibleCategories];
}

const showTabs = visibleCategories.length > 1;

// FAQPage строится по visibleCategories — то есть ровно по отрисованному.
// Schema.org Text — только чистый текст: HTML-теги (<a> в ответах) невалидны по спеке
// и ломают парсинг JSON-LD у html-minifier-terser.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: visibleCategories.flatMap((cat) =>
    cat.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(item.a) },
    })),
  ),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
  <div class="p-[18px]">
    <h2 class="text-[18px] font-bold leading-[1.1] text-body md:text-[22px]">{heading}</h2>

    {intro && (
      <p class="mt-2 text-[16px] leading-[1.6] text-body-muted max-w-[720px]">
        {intro.text} <a href={intro.href} class="text-primary font-semibold hover:text-primary-hover">{intro.linkText}</a>
      </p>
    )}

    <!-- Filter tabs -->
    <div class:list={["mt-4 grid grid-cols-3 gap-1.5 md:flex md:flex-wrap md:gap-2", { hidden: !showTabs }]} data-faq-filters>
      {visibleCategories.map((cat, i) => (
        <button
          type="button"
          data-faq-filter-btn
          data-faq-group={cat.id}
          class={`whitespace-nowrap rounded-full border px-3 py-1.5 text-base font-medium transition-colors md:px-4 md:py-2 md:text-sm ${i === 0 ? 'border-primary-light bg-primary-soft text-primary-text' : 'border-border bg-card text-body-muted'}`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- FAQ panels -->
    {visibleCategories.map((cat, i) => (
      <article data-faq-group-panel={cat.id} class={`mt-5 space-y-2 ${i === 0 ? '' : 'hidden'}`}>
        {cat.items.map((item) => (
          <div class="rounded-[14px] border border-border bg-surface" data-faq-item>
            <h3 class="m-0">
            <button
              type="button"
              data-faq-toggle
              class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[17px] font-semibold text-body hover:bg-surface transition-colors"
              aria-expanded="false"
            >
              <span>{item.q}</span>
              <i class="bi bi-plus-lg ml-3 shrink-0 text-[16px] text-body-faint transition-transform duration-200" data-faq-icon aria-hidden="true"></i>
            </button>
            </h3>
            <div class="px-4 pb-4 text-[16px] leading-[1.65] text-body-muted [&_a]:text-orange-600 [&_a]:underline [&_a:hover]:text-orange-700" data-faq-answer set:html={item.a}>
            </div>
          </div>
        ))}
      </article>
    ))}

    {moreLink && (
      <a href={moreLink.href} class="mt-4 inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover">
        {moreLink.text}
        <i class="bi bi-arrow-right icon-arrow-right-hover" aria-hidden="true"></i>
      </a>
    )}
  </div>
</section>

<script>
  import { trackGoal } from '../scripts/analytics';

  function initFaq() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-faq-filter-btn]');
    const panels = document.querySelectorAll<HTMLElement>('[data-faq-group-panel]');

    // Category filter tabs
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('border-primary-light', 'bg-primary-soft', 'text-primary-text');
          b.classList.add('border-border', 'bg-card', 'text-body-muted');
        });
        btn.classList.remove('border-border', 'bg-card', 'text-body-muted');
        btn.classList.add('border-primary-light', 'bg-primary-soft', 'text-primary-text');

        const group = btn.dataset.faqGroup;
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.faqGroupPanel !== group));
      });
    });

    // Accordion toggles
    document.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('[data-faq-item]') as HTMLElement;
        const answer = item.querySelector<HTMLElement>('[data-faq-answer]')!;
        const icon = btn.querySelector<HTMLElement>('[data-faq-icon]')!;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          answer.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          answer.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          trackGoal('faq_open', { question: btn.querySelector('span')?.textContent || '' });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFaq);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initFaq(); }, { timeout: 3000 });
  } else {
    setTimeout(initFaq, 200);
  }
</script>
