---

<section id="faq" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
  <div class="rounded-[24px] bg-card p-[18px] shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
    <h2 class="text-[18px] font-bold leading-[1.1] text-body md:text-[22px]">FAQ</h2>

    <!-- Filter tabs -->
    <div class="mt-4 grid grid-cols-3 gap-1.5 md:flex md:flex-wrap md:gap-2" data-faq-filters>
      {categories.map((cat, i) => (
        <button
          type="button"
          data-faq-filter-btn
          data-faq-group={cat.id}
          class={`whitespace-nowrap rounded-full border px-3 py-1.5 text-[14px] font-medium transition-colors md:px-4 md:py-2 md:text-sm ${i === 0 ? 'border-primary-light bg-primary-soft text-primary-text' : 'border-border bg-card text-body-muted'}`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- FAQ panels -->
    {categories.map((cat, i) => (
      <article data-faq-group-panel={cat.id} class={`mt-5 space-y-2 ${i === 0 ? '' : 'hidden'}`}>
        {cat.items.map((item) => (
          <div class="rounded-[14px] border border-border bg-surface" data-faq-item>
            <button
              type="button"
              data-faq-toggle
              class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-body"
              aria-expanded="false"
            >
              <span>{item.q}</span>
              <span class="ml-3 shrink-0 text-lg text-body-faint transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
            </button>
            <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-body-muted [&_a]:text-orange-600 [&_a]:underline [&_a:hover]:text-orange-700" data-faq-answer set:html={item.a}>
            </div>
          </div>
        ))}
      </article>
    ))}
  </div>
</section>

<script>
  function initFaq() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-faq-filter-btn]');
    const panels = document.querySelectorAll<HTMLElement>('[data-faq-group-panel]');

    // Category filter tabs
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('border-primary-light', 'bg-primary-soft', 'text-primary-text');
          b.classList.add('border-border', 'bg-card', 'text-body-muted');
        });
        btn.classList.remove('border-border', 'bg-card', 'text-body-muted');
        btn.classList.add('border-primary-light', 'bg-primary-soft', 'text-primary-text');

        const group = btn.dataset.faqGroup;
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.faqGroupPanel !== group));
      });
    });

    // Accordion toggles
    document.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('[data-faq-item]') as HTMLElement;
        const answer = item.querySelector<HTMLElement>('[data-faq-answer]')!;
        const icon = btn.querySelector<HTMLElement>('[data-faq-icon]')!;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          answer.classList.add('hidden');
          icon.style.transform = '';
          btn.setAttribute('aria-expanded', 'false');
        } else {
          answer.classList.remove('hidden');
          icon.style.transform = 'rotate(45deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFaq);
  initFaq();
</script>
