---
import type { SmenaTimeline } from '../../data/timeline/types';

interface Props {
  timeline: SmenaTimeline;
}

const { timeline } = Astro.props;

const stats = [
  { value: timeline.daysCount, label: 'дней смены' },
  { value: timeline.kidsCount, label: 'ребят' },
  { value: timeline.photosCount, label: 'фотографий' },
  { value: timeline.videosCount, label: 'видео' },
  { value: timeline.projectsCount, label: 'проектов' },
];
---

<header class="tl-hero">
  <!-- Сетка и орб -->
  <div class="tl-hero-grid" aria-hidden="true"></div>
  <div class="tl-hero-orb" aria-hidden="true"></div>

  <!-- Топбар: лого + бейдж -->
  <div class="tl-topbar">
    <div class="tl-logo">
      <div class="tl-logo-icon">А</div>
      <span class="tl-logo-name">АйДаКемп</span>
    </div>
    <div class="tl-private-badge">
      <span class="tl-private-dot" aria-hidden="true"></span>
      приватная ссылка · только для родителей
    </div>
  </div>

  <!-- Контент -->
  <div class="tl-hero-content">
    <div class="tl-shift-label">{timeline.shiftName} · {timeline.dateRange} · {timeline.daysCount} дней</div>
    <h1 class="tl-hero-title">Как прошла смена</h1>
    <p class="tl-hero-sub">
      {timeline.daysCount} дней кода, бассейна и хакатона — день за днём, глазами лагеря.
      Все фото и видео смены в одном месте. Листайте таймлайн ниже.
    </p>

    <!-- Обложка -->
    <div class="tl-cover">
      {timeline.coverImage ? (
        <img src={timeline.coverImage} alt={`Обложка ${timeline.shiftName} АйДаКемп`} class="tl-cover-img" />
      ) : (
        <>
          <span class="tl-cover-label">обложка смены · общее фото отряда у главного корпуса</span>
          <span class="tl-cover-badge">COVER · 2520×1080</span>
        </>
      )}
    </div>

    <!-- Статистика -->
    <div class="tl-stats">
      {stats.map(s => (
        <div class="tl-stat">
          <div class="tl-stat-value">{s.value}</div>
          <div class="tl-stat-label">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- CTA-кнопки -->
    <div class="tl-hero-ctas">
      <a href="#footer-cta" class="tl-btn-primary">Записаться на следующую смену →</a>
      <a href="/#shifts" class="tl-btn-ghost">↓ Все смены лагеря</a>
    </div>
  </div>
</header>

<style>
  .tl-hero {
    background: #0d1a2b;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .tl-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 64px);
    pointer-events: none;
  }

  .tl-hero-orb {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-primary, #ec7c00) 0%, transparent 70%);
    opacity: 0.22;
    filter: blur(12px);
    pointer-events: none;
  }

  /* Топбар */
  .tl-topbar {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tl-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tl-logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--color-primary, #ec7c00);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Unbounded', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: #0d1a2b;
  }
  .tl-logo-name {
    font-family: 'Unbounded', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .tl-private-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 12.5px;
    color: #cfd8e4;
  }
  .tl-private-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #46c97e;
    flex-shrink: 0;
  }

  /* Контент */
  .tl-hero-content {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 22px 56px;
  }

  .tl-shift-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--color-primary, #ec7c00);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .tl-hero-title {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 7vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    max-width: 14ch;
  }

  .tl-hero-sub {
    font-size: clamp(16px, 2.4vw, 20px);
    line-height: 1.55;
    color: #b9c4d2;
    max-width: 54ch;
    margin: 0 0 30px;
  }

  /* Обложка */
  .tl-cover {
    position: relative;
    aspect-ratio: 21/9;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.12);
    background: #0a1422;
    background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.035) 0 14px, rgba(255,255,255,0.07) 14px 28px);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
  }
  .tl-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tl-cover-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #6c7a8c;
    text-align: center;
    padding: 0 20px;
  }
  .tl-cover-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: #5a6878;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 6px;
    padding: 4px 7px;
  }

  /* Статистика */
  .tl-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }
  .tl-stat {
    flex: 1 1 110px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 16px;
  }
  .tl-stat-value {
    font-family: 'Unbounded', sans-serif;
    font-weight: 700;
    font-size: 26px;
    color: var(--color-primary, #ec7c00);
    line-height: 1.1;
  }
  .tl-stat-label {
    font-size: 13px;
    color: #9fabbb;
    margin-top: 3px;
  }

  /* CTA */
  .tl-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tl-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary, #ec7c00);
    color: #0d1a2b;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 12px;
    transition: background 0.15s;
  }
  .tl-btn-primary:hover { background: var(--color-primary-hover, #d67000); }
  .tl-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #fff;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.22);
    transition: background 0.15s;
  }
  .tl-btn-ghost:hover { background: rgba(255,255,255,0.06); }
</style>
