---
import type { TimelineDay } from '../../data/timeline/types';

interface Props {
  days: TimelineDay[];
}

const { days } = Astro.props;
---

<nav class="tl-nav no-sb" aria-label="Навигация по дням смены">
  <div class="tl-nav-inner">
    {days.map(day => (
      <a href={`#day-${day.id}`} class={`tl-nav-pill ${day.isSpecial ? 'tl-nav-pill--special' : ''}`}>
        <span class="tl-nav-title">{day.isSpecial ? day.title : `День ${day.id}`}</span>
        <span class="tl-nav-date">{day.date}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  // Подсвечиваем активный день в навигации при скролле
  const pills = document.querySelectorAll('.tl-nav-pill');
  const sections = document.querySelectorAll('[id^="day-"]');

  if (sections.length > 0 && pills.length > 0) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            pills.forEach(p => {
              const href = p.getAttribute('href');
              p.classList.toggle('tl-nav-pill--active', href === `#${id}`);
            });
          }
        });
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
    );

    sections.forEach(s => obs.observe(s));
  }
</script>

<style>
  .tl-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(243, 238, 230, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #e4dccb;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .tl-nav::-webkit-scrollbar { display: none; }

  .tl-nav-inner {
    display: flex;
    gap: 8px;
    padding: 10px 22px;
    max-width: 1080px;
    margin: 0 auto;
    width: max-content;
    min-width: 100%;
  }

  .tl-nav-pill {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border: 1px solid #e7ddca;
    border-radius: 11px;
    padding: 8px 13px;
    transition: border-color 0.15s, background 0.15s;
  }
  .tl-nav-pill:hover {
    border-color: var(--color-primary, #ec7c00);
  }
  .tl-nav-pill--active {
    background: #fff7ee;
    border-color: var(--color-primary, #ec7c00);
  }
  .tl-nav-pill--special {
    background: var(--color-primary, #ec7c00);
    border-color: var(--color-primary, #ec7c00);
  }
  .tl-nav-pill--special:hover {
    background: var(--color-primary-hover, #d67000);
    border-color: var(--color-primary-hover, #d67000);
  }

  .tl-nav-title {
    font-size: 13px;
    font-weight: 600;
    color: #1a2433;
    line-height: 1.2;
  }
  .tl-nav-pill--special .tl-nav-title,
  .tl-nav-pill--special .tl-nav-date {
    color: #0d1a2b;
  }
  .tl-nav-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #8a8a8a;
    margin-top: 2px;
  }
</style>
