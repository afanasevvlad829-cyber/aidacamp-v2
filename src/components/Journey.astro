---
import { SHIFT_META, allShifts } from '../data/shifts';

const _M = ['','января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const startLabel = (id: string) => {
  const [, m, d] = SHIFT_META[id].startDate.split('-').map(Number);
  return `${d} ${_M[m]}`;
};

const schedule = [
  { time: 'Утро',   icon: 'sunrise',      text: 'Завтрак, первый блок программирования' },
  { time: 'День',   icon: 'water',        text: 'Бассейн, спорт, второй блок проекта' },
  { time: 'Вечер',  icon: 'people-fill',  text: 'Свободное время, ужин, активность' },
  { time: 'Ночь',   icon: 'moon-stars',   text: 'Отбой' },
];

const ageCards = [
  {
    icon: 'users',
    title: '7–9 лет',
    text: 'Первые игры: персонаж, движение, счёт, простые механики',
  },
  {
    icon: 'code',
    title: '10–12 лет',
    text: 'Игры с уровнями, логикой и системой взаимодействия',
  },
  {
    icon: 'cpu',
    title: '13–15 лет',
    text: 'Проекты с элементами AI: вариативное поведение, генерация событий',
  },
];
---

<section id="journey" class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="list-accent-dot"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Как проходит смена</h2>
    </div>

    <!-- Tabs -->
    <div class="mt-5 flex gap-2">
      <button type="button" data-journey-tab="program" class="cursor-pointer flex-1 rounded-lg px-4 py-2.5 text-base font-semibold transition md:flex-none md:px-6 bg-primary-soft text-primary-text">Программа</button>
      <button type="button" data-journey-tab="day" class="cursor-pointer flex-1 rounded-lg px-4 py-2.5 text-base font-semibold transition md:flex-none md:px-6 bg-surface text-body-muted">День в лагере</button>
    </div>

    <!-- Tab 1: Программа -->
    <div data-journey-panel="program" class="mt-6">
      <div>
        <h3 class="text-[20px] font-bold leading-[1.2] text-body md:text-[24px]">Мы не играем в игры — мы их создаём</h3>
        <p class="mt-2 text-[16px] leading-[1.5] text-body-muted md:text-[16px]">Приезжают без опыта. Уезжают с игрой. Всё оборудование выдадим — свой ноутбук не привозите.</p>
        <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">С первого дня — реальная работа: персонаж, движение, механика. К финалу — готовый проект.</p>
      </div>

      <div class="mt-6 grid gap-3 md:grid-cols-3 md:gap-4" id="journey-age-cards">
        {ageCards.map((card) => (
          <div class="rounded-[22px] border border-border bg-surface p-4 md:p-5 transition-all duration-300 card-shadow" data-age-card={card.title}>
            <div class="flex items-center gap-2.5">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                {card.icon === 'users' && (
                  <i class="bi bi-people text-[20px] text-primary shrink-0" aria-hidden="true"></i>
                )}
                {card.icon === 'code' && (
                  <i class="bi bi-arrow-up-right text-[20px] text-primary" aria-hidden="true"></i>
                )}
                {card.icon === 'cpu' && (
                  <i class="bi bi-cpu-fill text-[20px] text-primary" aria-hidden="true"></i>
                )}
              </div>
              <h4 class="text-[16px] font-semibold text-body journey-age-title">{card.title}</h4>
            </div>
            <p class="mt-2 text-[18px] leading-[1.6] text-body-muted journey-age-text">{card.text}</p>
          </div>
        ))}
      </div>

      <p class="mt-4 text-base md:text-base text-body-muted">Опыт программирования не нужен. Нужно только желание что-то сделать.</p>
    </div>

    <!-- Tab 2: День в лагере -->
    <div data-journey-panel="day" class="mt-6 hidden">
      <div class="flex flex-col-reverse gap-6 md:flex-row md:gap-8">
        <!-- Левая колонка: расписание -->
        <div class="md:w-[55%]">
          <div class="space-y-0">
            {schedule.map((item, i) => (
              <div class="flex gap-3 md:gap-4">
                <div class="flex flex-col items-center">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                    <i class={`bi bi-${item.icon} text-[16px] text-primary`} aria-hidden="true"></i>
                  </div>
                  {i < schedule.length - 1 && <div class="w-px flex-1 bg-border my-1"></div>}
                </div>
                <div class={`pb-4 ${i === schedule.length - 1 ? 'pb-0' : ''}`}>
                  <span class="text-base font-semibold text-body">{item.time}</span>
                  <p class="mt-0.5 text-[16px] leading-[1.5] text-body-muted">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Правая колонка: что происходит на занятиях -->
        <div class="md:w-[45%]">
          <h3 class="text-[17px] font-semibold text-body">Что происходит на занятиях</h3>
          <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">Первый день — оценка уровня, дальше свой проект и шаг вперёд каждый день.
            <a href="/o-lagere/" class="text-orange-600 underline decoration-orange-600/60 underline-offset-2">Подробно о смене →</a></p>
          <div class="mt-4 space-y-2" id="journey-age-items">
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="7–9">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-base md:text-base text-body-muted">7–9 лет</span>
            </div>
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="10–12">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-base md:text-base text-body-muted">10–12 лет</span>
            </div>
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="13–15">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-base md:text-base text-body-muted">13–15 лет</span>
            </div>
          </div>
          <p class="mt-4 text-base md:text-base text-body-faint">По сменам:</p>
          {/* Ссылки только на реально существующие страницы смен (allShifts = getStaticPaths в /shifts/[id]).
              Завершённые смены исключены автоматически — источник правды один, мёртвых ссылок не будет. */}
          <div class="mt-2 flex flex-wrap gap-2">
            {allShifts.map((shift) => (
              <a href={`/shifts/${shift.id}/`}
                class="inline-flex rounded-lg border border-border bg-card px-3 py-1.5 text-base md:text-base text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
                {shift.name} · {startLabel(shift.id)}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { STORAGE_KEYS } from '../lib/storage';

  function initJourneyTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-journey-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-journey-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.journeyTab;
        tabs.forEach((t) => {
          const isActive = t.dataset.journeyTab === target;
          t.classList.toggle('bg-primary-soft', isActive);
          t.classList.toggle('text-primary-text', isActive);
          t.classList.toggle('bg-surface', !isActive);
          t.classList.toggle('text-body-muted', !isActive);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.journeyPanel !== target);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initJourneyTabs);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initJourneyTabs, { timeout: 2000 });
  } else {
    setTimeout(initJourneyTabs, 200);
  }

  // === AGE PERSONALIZATION (mobile only) ===
  function applyJourneyAge(age: string) {
    const isMobile = window.innerWidth < 768;

    document.querySelectorAll<HTMLElement>('[data-age-card]').forEach((card) => {
      const matches = (card.dataset.ageCard || '').startsWith(age);
      if (isMobile) {
        // На мобилке прячем не-совпадающие
        card.classList.toggle('hidden', !matches);
      } else {
        // На десктопе: приглушаем не-совпадающие, выделяем совпадающую
        card.classList.toggle('opacity-30', !matches);
        card.classList.toggle('border-primary', matches);
        card.classList.toggle('bg-primary-warm', matches);
      }
    });

    // Пункты программы по возрасту: прячем не-совпадающие (везде)
    document.querySelectorAll<HTMLElement>('[data-age-item]').forEach((item) => {
      const matches = item.dataset.ageItem === age;
      item.classList.toggle('hidden', !matches);
    });
  }

  function resetJourneyAge() {
    document.querySelectorAll<HTMLElement>('[data-age-card]').forEach((c) => {
      c.classList.remove('hidden', 'opacity-30', 'border-primary', 'bg-primary-warm');
    });
    document.querySelectorAll<HTMLElement>('[data-age-item]').forEach((i) => i.classList.remove('hidden'));
  }

  function initJourneyAge() {
    const saved = localStorage.getItem(STORAGE_KEYS.userAgeGroup);
    if (saved) applyJourneyAge(saved);

    document.addEventListener('age-personalize', (e: Event) => {
      const { age } = (e as CustomEvent<{ age: string }>).detail;
      applyJourneyAge(age);
    });
  }

  document.addEventListener('astro:page-load', initJourneyAge);
  // Defer — Journey ниже fold, не блокируем LCP
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initJourneyAge, { timeout: 2000 });
  } else {
    setTimeout(initJourneyAge, 200);
  }
</script>
