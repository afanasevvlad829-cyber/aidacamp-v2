---

const schedule = [
  { time: '8:00',  icon: 'sunrise',       text: 'Подъём, завтрак' },
  { time: '9:30',  icon: 'laptop',        text: 'Первый блок: программирование и работа над проектом' },
  { time: '12:00', icon: 'water',         text: 'Спорт, бассейн или чемпионат по футболу/волейболу' },
  { time: '13:30', icon: 'cup-hot-fill',  text: 'Обед' },
  { time: '15:00', icon: 'cpu-fill',      text: 'Второй блок: продолжение проекта' },
  { time: '18:00', icon: 'controller',    text: 'Свободное время' },
  { time: '19:00', icon: 'cup-hot-fill',  text: 'Ужин' },
  { time: '20:30', icon: 'people-fill',   text: 'Вечерняя активность' },
  { time: '22:00', icon: 'moon-stars',    text: 'Отбой' },
];

const ageCards = [
  {
    icon: 'users',
    title: '7–9 лет',
    text: 'Первые игры: персонаж, движение, счёт, простые механики',
  },
  {
    icon: 'code',
    title: '10–12 лет',
    text: 'Игры с уровнями, логикой и системой взаимодействия',
  },
  {
    icon: 'cpu',
    title: '13–15 лет',
    text: 'Проекты с элементами AI: вариативное поведение, генерация событий',
  },
];
---

<section id="journey" class="mx-auto max-w-[1312px] px-[2px] pt-8 md:px-4">
  <div class="bg-card p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Как проходит смена</h2>
    </div>

    <!-- Tabs -->
    <div class="mt-5 flex gap-2">
      <button type="button" data-journey-tab="program" class="cursor-pointer flex-1 rounded-lg px-4 py-2.5 text-[14px] font-semibold transition md:flex-none md:px-6 bg-primary-soft text-primary-text">Программа</button>
      <button type="button" data-journey-tab="day" class="cursor-pointer flex-1 rounded-lg px-4 py-2.5 text-[14px] font-semibold transition md:flex-none md:px-6 bg-surface text-body-muted">День в лагере</button>
    </div>

    <!-- Tab 1: Программа -->
    <div data-journey-panel="program" class="mt-6">
      <div>
        <h3 class="text-[20px] font-bold leading-[1.2] text-body md:text-[24px]">Мы не играем в игры — мы их создаём</h3>
        <p class="mt-2 text-[16px] leading-[1.5] text-body-muted md:text-[16px]">Приезжают без опыта. Уезжают с игрой. Всё оборудование выдадим — свой ноутбук не привозите.</p>
        <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">С первого дня — реальная работа: персонаж, движение, механика. К финалу — готовый проект.</p>
      </div>

      <div class="mt-6 grid gap-3 md:grid-cols-3 md:gap-4" id="journey-age-cards">
        {ageCards.map((card) => (
          <div class="rounded-[16px] border border-border bg-surface p-4 md:p-5 transition-all duration-300" data-age-card={card.title}>
            <div class="flex items-center gap-2.5">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                {card.icon === 'users' && (
                  <i class="bi bi-people text-[20px] text-primary shrink-0" aria-hidden="true"></i>
                )}
                {card.icon === 'code' && (
                  <i class="bi bi-arrow-up-right text-[20px] text-primary" aria-hidden="true"></i>
                )}
                {card.icon === 'cpu' && (
                  <i class="bi bi-cpu-fill text-[20px] text-primary" aria-hidden="true"></i>
                )}
              </div>
              <h4 class="text-[16px] font-semibold text-body journey-age-title">{card.title}</h4>
            </div>
            <p class="mt-2 text-[18px] leading-[1.6] text-body-muted journey-age-text">{card.text}</p>
          </div>
        ))}
      </div>

      <p class="mt-4 text-[14px] text-body-muted">Опыт программирования не нужен. Нужно только желание что-то сделать.</p>
    </div>

    <!-- Tab 2: День в лагере -->
    <div data-journey-panel="day" class="mt-6 hidden">
      <div class="flex flex-col-reverse gap-6 md:flex-row md:gap-8">
        <!-- Левая колонка: расписание -->
        <div class="md:w-[55%]">
          <div class="space-y-0">
            {schedule.map((item, i) => (
              <div class="flex gap-3 md:gap-4">
                <div class="flex flex-col items-center">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                    <i class={`bi bi-${item.icon} text-[16px] text-primary`} aria-hidden="true"></i>
                  </div>
                  {i < schedule.length - 1 && <div class="w-px flex-1 bg-border my-1"></div>}
                </div>
                <div class={`pb-4 ${i === schedule.length - 1 ? 'pb-0' : ''}`}>
                  <span class="text-[14px] font-semibold text-body">{item.time}</span>
                  <p class="mt-0.5 text-[16px] leading-[1.5] text-body-muted">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Правая колонка: что происходит на занятиях -->
        <div class="md:w-[45%]">
          <h3 class="text-[17px] font-semibold text-body">Что происходит на занятиях</h3>
          <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">Первый день — не урок. Детей делят на группы по возрасту и уровню, проводят короткое тестирование — не экзамен, а просто чтобы понять с чего начинать. Кто-то уже писал код, кто-то ни разу не открывал редактор. Обе ситуации нормальные.</p>
          <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">Дальше — выбор проекта. Не «все делаем Марио», не «сегодня по учебнику страница 12». Каждый выбирает то, что хочет сделать сам: погоня, стрелялка, платформер, история с выбором. Технически все эти игры устроены одинаково — персонаж, движение, механика, условия победы. Но один делает рыцаря, другой — космический корабль, третий — кота который собирает рыбу.</p>
          <p class="mt-3 text-[18px] leading-[1.65] text-body-muted md:text-[16px]">Каждый день — конкретный шаг вперёд. Добавили механику, проверили, сломалось — починили, добавили следующую. К середине смены уже есть что запустить. К финалу — готовый проект, который можно показать дома.</p>
          <div class="mt-4 space-y-2" id="journey-age-items">
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="7–9">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-[14px] text-body-muted">7–9 лет — первые игры, движение и счёт</span>
            </div>
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="10–12">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-[14px] text-body-muted">10–12 лет — уровни, логика, механики</span>
            </div>
            <div class="flex items-center gap-2 transition-all duration-300" data-age-item="13–15">
              <i class="bi bi-people text-[16px] text-primary shrink-0" aria-hidden="true"></i>
              <span class="age-item-text text-[14px] text-body-muted">13–15 лет — AI-элементы, сложная структура</span>
            </div>
          </div>
          <p class="mt-4 text-[14px] text-body-faint">Подробная программа по каждой смене:</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <button type="button" data-journey-shift-info="shift-1"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 1 · 30 мая
            </button>
            <button type="button" data-journey-shift-info="shift-2"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 2 · 10 июня
            </button>
            <button type="button" data-journey-shift-info="shift-2-1"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 2.1 · 10 июня
            </button>
            <button type="button" data-journey-shift-info="shift-2-2"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 2.2 · 16 июня
            </button>
            <button type="button" data-journey-shift-info="shift-3"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 3 · 3 августа
            </button>
            <button type="button" data-journey-shift-info="shift-4"
              class="cursor-pointer rounded-lg border border-border bg-card px-3 py-1.5 text-[14px] text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors">
              Смена 4 · 17 августа
            </button>
          </div>

          <script>
            document.querySelectorAll('[data-journey-shift-info]').forEach((btn) => {
              btn.addEventListener('click', () => {
                const shiftId = (btn as HTMLElement).dataset.journeyShiftInfo!;
                document.dispatchEvent(
                  new CustomEvent('shift-modal-open', { detail: { shiftId, tab: 'info' } })
                );
              });
            });
          </script>
        </div>
      </div>

      <div class="mt-5 flex items-start gap-2.5 rounded-xl border border-border bg-surface p-3.5">
        <i class="bi bi-phone text-[20px] text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <p class="text-[16px] leading-[1.5] text-body-muted">Телефоны сдаются при заезде. Доступ — за заработанное время.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { STORAGE_KEYS } from '../lib/storage';

  function initJourneyTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-journey-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-journey-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.journeyTab;
        tabs.forEach((t) => {
          const isActive = t.dataset.journeyTab === target;
          t.classList.toggle('bg-primary-soft', isActive);
          t.classList.toggle('text-primary-text', isActive);
          t.classList.toggle('bg-surface', !isActive);
          t.classList.toggle('text-body-muted', !isActive);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.journeyPanel !== target);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initJourneyTabs);
  initJourneyTabs();

  // === AGE PERSONALIZATION (mobile only) ===
  function applyJourneyAge(age: string) {
    const isMobile = window.innerWidth < 768;

    document.querySelectorAll<HTMLElement>('[data-age-card]').forEach((card) => {
      const matches = (card.dataset.ageCard || '').startsWith(age);
      if (isMobile) {
        // На мобилке прячем не-совпадающие
        card.classList.toggle('hidden', !matches);
      } else {
        // На десктопе: приглушаем не-совпадающие, выделяем совпадающую
        card.classList.toggle('opacity-30', !matches);
        card.classList.toggle('border-primary', matches);
        card.classList.toggle('bg-primary-warm', matches);
      }
    });

    // Пункты программы по возрасту: прячем не-совпадающие (везде)
    document.querySelectorAll<HTMLElement>('[data-age-item]').forEach((item) => {
      const matches = item.dataset.ageItem === age;
      item.classList.toggle('hidden', !matches);
    });
  }

  function resetJourneyAge() {
    document.querySelectorAll<HTMLElement>('[data-age-card]').forEach((c) => {
      c.classList.remove('hidden', 'opacity-30', 'border-primary', 'bg-primary-warm');
    });
    document.querySelectorAll<HTMLElement>('[data-age-item]').forEach((i) => i.classList.remove('hidden'));
  }

  function initJourneyAge() {
    const saved = localStorage.getItem(STORAGE_KEYS.userAgeGroup);
    if (saved) applyJourneyAge(saved);

    document.addEventListener('age-personalize', (e: Event) => {
      const { age } = (e as CustomEvent<{ age: string }>).detail;
      applyJourneyAge(age);
    });
  }

  document.addEventListener('astro:page-load', initJourneyAge);
  initJourneyAge();
</script>
