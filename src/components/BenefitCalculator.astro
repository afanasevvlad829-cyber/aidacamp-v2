---
/**
 * BenefitCalculator — калькулятор выгоды: групповые скидки + налоговый вычет.
 *
 * Скидки применяются к образовательной части путёвки
 * (total_price − residential_per_day × days), т.к. бытовые расходы — пол цены.
 *
 * Групповые опции:
 *   solo     — без скидки
 *   friend1  — −10% образовательной части (привёл 1 друга)
 *   group5   — −50% образовательной части (группа 5 человек)
 *   group10  — образовательная часть = 100 ₽ (группа 10+ человек)
 *
 * Налоговый вычет:
 *   13% × min(discountedEdu, 110 000 ₽) — независимая опция, применяется поверх.
 */

import { EDU_RESID_PER_DAY, NDFL_RATE, EDU_BASE_CAP, SEASON_YEAR } from '../data/shifts';
import { fmtPrice } from '../data/dynamicPrices';
import { getShiftSelectOptions } from '../utils/shiftSelectOptions';

// Опции смен (цена/дни из data/shifts.ts) — единый источник, без дублирования парсинга.
const shifts = getShiftSelectOptions();
---

<section class="mx-auto max-w-[720px] px-4 pb-10 md:pb-14">
  <div class="rounded-[20px] border border-slate-200 bg-white p-6 md:p-8 shadow-[0_4px_24px_rgba(15,23,42,0.06)]">

    <!-- Заголовок -->
    <div class="mb-1 flex items-center gap-2">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold text-body leading-[1.2] tracking-[-0.02em]">
        Калькулятор выгоды
      </h2>
    </div>
    <p class="mt-3 mb-6 text-base text-body-muted leading-[1.65]">
      Сложите все скидки сразу: групповая запись и налоговый вычет от государства.
      Посмотрите, сколько реально стоит смена.
    </p>

    <!-- 1. Выбор смены -->
    <div class="mb-5">
      <label for="bc-shift" class="mb-2 block text-base font-semibold text-body-muted uppercase tracking-wide">
        Выберите смену {SEASON_YEAR}
      </label>
      <div class="relative">
        <select
          id="bc-shift"
          class="w-full appearance-none rounded-[10px] border border-slate-300 bg-white px-4 py-3 pr-10 text-base text-body focus:border-orange-500 focus:outline-none"
          data-edu-resid={EDU_RESID_PER_DAY}
          data-ndfl-rate={NDFL_RATE}
          data-edu-cap={EDU_BASE_CAP}
        >
          {shifts.map((s) => (
            <option
              value={s.id}
              data-price={s.price}
              data-days={s.days}
              selected={s.popular}
            >
              {s.label} — {fmtPrice(s.price)}{s.popular ? ' · популярная' : ''}
            </option>
          ))}
        </select>
        <i class="bi bi-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-base text-body-faint" aria-hidden="true"></i>
      </div>
    </div>

    <!-- 2. Групповая скидка (radio) -->
    <div class="mb-5">
      <div class="mb-3 text-base font-semibold text-body-muted uppercase tracking-wide">
        Сколько человек едет от вас
      </div>
      <div class="flex flex-col gap-2" id="bc-group-options">

        <label class="bc-radio-label flex cursor-pointer items-center gap-3 rounded-[12px] border border-slate-200 bg-slate-50 px-4 py-3 transition-colors hover:border-orange-300 hover:bg-orange-50/40 has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50">
          <input type="radio" name="bc-group" value="solo" class="accent-orange-500" checked />
          <span class="flex-1 text-base text-body">
            Только мой ребёнок
          </span>
          <span class="text-base font-semibold text-body-faint">без скидки</span>
        </label>

        <label class="bc-radio-label flex cursor-pointer items-center gap-3 rounded-[12px] border border-slate-200 bg-slate-50 px-4 py-3 transition-colors hover:border-orange-300 hover:bg-orange-50/40 has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50">
          <input type="radio" name="bc-group" value="friend1" class="accent-orange-500" />
          <span class="flex-1 text-base text-body">
            Позову 1 друга <span class="text-body-faint">(2 ребёнка)</span>
          </span>
          <span class="text-base font-semibold text-orange-600">−10%</span>
        </label>

        <label class="bc-radio-label flex cursor-pointer items-center gap-3 rounded-[12px] border border-slate-200 bg-slate-50 px-4 py-3 transition-colors hover:border-orange-300 hover:bg-orange-50/40 has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50">
          <input type="radio" name="bc-group" value="group5" class="accent-orange-500" />
          <span class="flex-1 text-base text-body">
            Позову 4 человека <span class="text-body-faint">(5 детей)</span>
          </span>
          <span class="text-base font-semibold text-orange-600">−50%</span>
        </label>

        <label class="bc-radio-label flex cursor-pointer items-center gap-3 rounded-[12px] border border-slate-200 bg-slate-50 px-4 py-3 transition-colors hover:border-orange-300 hover:bg-orange-50/40 has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50">
          <input type="radio" name="bc-group" value="group10" class="accent-orange-500" />
          <span class="flex-1 text-base text-body">
            Позову 10 человек <span class="text-body-faint">(10+ детей)</span>
          </span>
          <span class="text-base font-semibold text-green-600">почти бесплатно</span>
        </label>

      </div>
    </div>

    <!-- 3. Налоговый вычет (checkbox) -->
    <label class="mb-6 flex cursor-pointer items-start gap-3 rounded-[12px] border border-slate-200 bg-slate-50 px-4 py-3 transition-colors hover:border-orange-300 hover:bg-orange-50/40 has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50">
      <input type="checkbox" id="bc-tax" class="mt-0.5 accent-orange-500" checked />
      <span class="flex-1">
        <span class="block text-base font-semibold text-body">Налоговый вычет 13%</span>
        <span class="block text-base text-body-faint mt-0.5">Вернут из ФНС в следующем году — документы даём автоматически</span>
      </span>
      <span id="bc-tax-badge" class="shrink-0 text-base font-semibold text-green-600">−<span id="bc-tax-amount">0</span> ₽</span>
    </label>

    <!-- Результат -->
    <div class="rounded-[14px] bg-gradient-to-br from-orange-50 to-amber-50 border border-orange-100 p-5">

      <!-- Разбивка -->
      <div class="mb-4 flex flex-col gap-2 text-base">
        <div class="flex justify-between">
          <span class="text-body-faint">Полная стоимость</span>
          <span id="bc-base-price" class="font-medium text-body-muted">—</span>
        </div>
        <div id="bc-group-row" class="flex justify-between">
          <span class="text-body-faint" id="bc-group-label">Групповая скидка</span>
          <span id="bc-group-saving" class="font-semibold text-orange-600">—</span>
        </div>
        <div id="bc-parts-row" class="flex justify-between text-base text-body-faint">
          <span>жильё + питание: <b id="bc-resid-val" class="text-body-faint">—</b></span>
          <span>образование: <b id="bc-edu-val" class="text-body-faint">—</b></span>
        </div>
        <div id="bc-tax-row" class="flex justify-between">
          <span class="text-body-faint">Налоговый вычет (13% от образов. части)</span>
          <span id="bc-tax-saving" class="font-semibold text-green-600">—</span>
        </div>
        <div class="my-1 border-t border-orange-200"></div>
        <div class="flex items-baseline justify-between">
          <span class="text-base font-bold text-body">Итого</span>
          <span id="bc-total" class="text-[28px] md:text-[32px] font-bold leading-none text-orange-600">—</span>
        </div>
      </div>

      <!-- Итоговая выгода -->
      <div id="bc-saving-block" class="hidden rounded-[10px] bg-white border border-orange-200 px-4 py-3 flex items-center justify-between gap-4">
        <div>
          <div class="text-base text-body-faint mb-0.5">Ваша выгода</div>
          <div id="bc-saving-total" class="text-[20px] font-bold text-green-600">—</div>
        </div>
        <div class="text-base text-body-faint text-right leading-[1.5]" id="bc-saving-pct">
        </div>
      </div>
    </div>

    <!-- Дисклеймер -->
    <p class="mt-4 text-base text-body-faint leading-[1.55]">
      Групповая скидка считается от всей суммы, но применяется в первую очередь к бытовой части
      (проживание + питание, 3 800 ₽/день). Образовательная часть остаётся для налогового вычета 13%.
      Для группы 10+ человек условия уточняйте у менеджера — итого символические 100 ₽ (договор обязателен).
    </p>

    <a
      href="/putevka-v-lager/"
      class="mt-5 inline-flex items-center gap-2 rounded-[12px] border border-primary/55 bg-primary/8 px-6 py-3 text-base font-semibold text-primary transition-colors hover:bg-primary/14 hover:border-primary/75"
    >
      Забронировать смену →
    </a>
  </div>
</section>

<script is:inline>
(function () {
  const EDU_FIXED_GROUP10 = 100;

  const fmt = (n) => Math.round(n).toLocaleString('ru-RU');
  const roundTo100 = (n) => Math.round(n / 100) * 100;

  const shiftSel  = document.getElementById('bc-shift');
  // Константы вычета — из data/shifts.ts через data-атрибуты <select> (единый источник).
  const RESIDENTIAL_PER_DAY = Number(shiftSel?.dataset.eduResid) || 3800;
  const TAX_RATE = Number(shiftSel?.dataset.ndflRate) || 0.13;
  const TAX_LIMIT = Number(shiftSel?.dataset.eduCap) || 110000;
  const taxCheck  = document.getElementById('bc-tax');
  const groupRads = document.querySelectorAll('input[name="bc-group"]');

  function getGroupValue() {
    for (const r of groupRads) if (r.checked) return r.value;
    return 'solo';
  }

  function recalc() {
    const opt = shiftSel.selectedOptions[0];
    const price = parseInt(opt?.dataset.price) || 0;
    const days  = parseInt(opt?.dataset.days)  || 0;
    if (!price || !days) return;

    const residential = RESIDENTIAL_PER_DAY * days;
    const edu         = Math.max(0, price - residential);

    const group = getGroupValue();

    // Скидка считается от ВСЕЙ суммы, но применяется сначала к жилью/питанию —
    // чтобы образовательная часть оставалась для налогового вычета.
    let discountedPrice, discountedResidential, discountedEdu, groupSaving;

    if (group === 'group10') {
      // 10+ человек: итого символические 100 ₽ (нужен договор)
      discountedPrice       = EDU_FIXED_GROUP10;
      discountedResidential = 0;
      discountedEdu         = EDU_FIXED_GROUP10;
      groupSaving           = price - EDU_FIXED_GROUP10;
    } else {
      const discountRate   = group === 'friend1' ? 0.1 : group === 'group5' ? 0.5 : 0;
      const discountAmount = Math.round(price * discountRate);

      // Скидка «съедает» жильё/питание первым
      discountedResidential = Math.max(0, residential - discountAmount);
      const leftoverDiscount = Math.max(0, discountAmount - residential);
      // Остаток скидки (если превысила жильё) — уменьшает образовательную часть
      discountedEdu   = Math.max(0, edu - leftoverDiscount);
      discountedPrice = discountedResidential + discountedEdu;
      groupSaving     = price - discountedPrice;
    }

    const taxBase   = Math.min(discountedEdu, TAX_LIMIT);
    const taxReturn = taxCheck.checked ? roundTo100(taxBase * TAX_RATE) : 0;

    const total   = discountedPrice - taxReturn;
    const savings = price - total;

    // Обновляем UI
    set('bc-base-price', fmt(price) + ' ₽');
    set('bc-resid-val', fmt(discountedResidential) + ' ₽');
    set('bc-edu-val',   fmt(discountedEdu) + ' ₽');

    const groupRow = document.getElementById('bc-group-row');
    if (groupSaving > 0) {
      groupRow.style.display = '';
      let label;
      if (group === 'friend1')  label = 'Скидка за друга (−10%)';
      else if (group === 'group5')  label = 'Групповая скидка (−50%)';
      else label = 'Группа 10+ человек';
      set('bc-group-label',  label);
      set('bc-group-saving', '−' + fmt(groupSaving) + ' ₽');
    } else {
      groupRow.style.display = 'none';
    }

    const taxRow = document.getElementById('bc-tax-row');
    if (taxReturn > 0) {
      taxRow.style.display = '';
      set('bc-tax-saving', '−' + fmt(taxReturn) + ' ₽');
      set('bc-tax-amount', fmt(taxReturn));
      document.getElementById('bc-tax-badge').style.display = '';
    } else {
      taxRow.style.display = 'none';
      document.getElementById('bc-tax-badge').style.display = 'none';
    }

    set('bc-total', fmt(total) + ' ₽');

    const savingBlock = document.getElementById('bc-saving-block');
    if (savings > 0) {
      savingBlock.classList.remove('hidden');
      savingBlock.style.display = 'flex';
      set('bc-saving-total', '~' + fmt(savings) + ' ₽');
      const pct = Math.round((savings / price) * 100);
      set('bc-saving-pct', 'Это ' + pct + '% от полной стоимости путёвки');
    } else {
      savingBlock.classList.add('hidden');
    }
  }

  function set(id, val) {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  }

  shiftSel.addEventListener('change', recalc);
  taxCheck.addEventListener('change', recalc);
  groupRads.forEach((r) => r.addEventListener('change', recalc));

  recalc();
})();
</script>
