---
import { projectVideos, campVideos } from '../data/videos';
import VideoModal from './VideoModal.astro';

const projects = projectVideos;

const SITE = 'https://aidacamp.ru';
const publisher = {
  '@type': 'Organization',
  name: 'АйДаКемп',
  url: SITE,
  logo: { '@type': 'ImageObject', url: `${SITE}/images/logo-aidacamp.svg` },
};

function makeVideoObject(v: { url: string; title: string; thumb: string; description?: string; uploadDate?: string }) {
  return {
    '@type': 'VideoObject',
    name: v.title,
    description: v.description ?? v.title,
    thumbnailUrl: `${SITE}${v.thumb}`,
    uploadDate: v.uploadDate ?? '2025-01-01',
    embedUrl: v.url,
    publisher,
  };
}

const campVideoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Видео об IT-лагере АйДаКемп',
  itemListElement: campVideos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: makeVideoObject(v),
  })),
};

const projectVideoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Проекты детей из IT-лагеря АйДаКемп',
  itemListElement: projectVideos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: makeVideoObject(v),
  })),
};

const videos = campVideos;

const tabs = [
  { value: 'projects', label: 'Проекты' },
  { value: 'videos', label: 'Видео' },
];
---

<script type="application/ld+json" set:html={JSON.stringify(campVideoSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(projectVideoSchema)} />

<section id="videos" class="mx-auto max-w-[1312px] px-[2px] pt-10 md:px-4" data-videos-root>
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1"><div class="list-accent-dot"></div><h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Видео</h2></div>

    <!-- Filter tabs -->
    <div class="mt-4 flex flex-wrap gap-1.5 md:gap-2" data-video-filters>
      {tabs.map((t, i) => (
        <button
          type="button"
          data-video-filter={t.value}
          class={`cursor-pointer whitespace-nowrap rounded-full px-3 py-1.5 text-base font-medium transition-colors md:px-4 md:py-2 md:text-sm ${i === 0 ? 'bg-[#fff2e3] text-[#9c3d00]' : 'bg-surface text-body-muted'}`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <!-- Tab: Проекты -->
    <div data-video-category="projects" class="mt-5">
      <!-- Mobile: main + thumbs -->
      <div class="md:hidden">
        <button
          type="button"
          data-video-open
          data-video-url={projects[0].url}
          data-video-slug={projects[0].slug}
          data-video-title={projects[0].title}
          class="cursor-pointer group w-full"
          data-proj-main
        >
          <span class="relative overflow-hidden rounded-[18px] block">
            <img src={projects[0].thumb} alt={projects[0].alt} class="aspect-[9/16] w-full object-cover" loading="lazy" width="360" height="640" data-proj-main-img />
            <span class="absolute inset-0 flex items-center justify-center bg-black/20">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-primary-light">
                <svg class="ml-1 h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </span>
          </span>
          <span class="mt-2 block text-left text-[16px] font-medium leading-[1.4] text-body-muted" data-proj-main-title>{projects[0].title}</span>
        </button>
        {projects.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-2">
            {projects.slice(1).map((v) => (
              <button
                type="button"
                data-proj-thumb
                data-video-url={v.url}
                data-video-slug={v.slug}
                data-video-title={v.title}
                data-video-thumb-src={v.thumb}
                class="cursor-pointer group"
              >
                <span class="relative overflow-hidden rounded-[12px] block">
                  <img src={v.thumb} alt={v.alt} class="aspect-[9/16] w-full object-cover" loading="lazy" width="180" height="320" />
                  <span class="absolute inset-0 flex items-center justify-center bg-black/20">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/80 text-primary-light">
                      <svg class="ml-0.5 h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </span>
                </span>
              </button>
            ))}
          </div>
        )}
      </div>
      <!-- Desktop: grid -->
      <div class="hidden md:grid md:grid-cols-5 md:gap-4">
        {projects.map((v) => (
          <div>
            <button
              type="button"
              data-video-open
              data-video-url={v.url}
              data-video-slug={v.slug}
              data-video-title={v.title}
              class="group block w-full cursor-pointer"
            >
              <span class="relative overflow-hidden rounded-[18px] block">
                <img src={v.thumb} alt={v.alt} class="aspect-[9/16] w-full object-cover transition group-hover:scale-105" loading="lazy" width="360" height="640" />
                <span class="absolute inset-0 flex items-center justify-center bg-black/20">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-primary-light">
                    <svg class="ml-1 h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </span>
              </span>
            </button>
            {/* Заголовок — ссылка на страницу видео: внутренняя перелинковка + адрес, которым можно поделиться */}
            <a href={`/video/${v.slug}/`} class="mt-2 line-clamp-2 block text-left text-[16px] leading-[1.4] text-body-muted no-underline hover:text-primary transition-colors">{v.title}</a>
          </div>
        ))}
      </div>
    </div>

    <!-- Tab: Видео -->
    <div data-video-category="videos" class="mt-5 hidden">
      <!-- Mobile: main video + thumbnails -->
      <div class="md:hidden">
        <button
          type="button"
          data-video-open
          data-video-url={videos[0].url}
          data-video-slug={videos[0].slug}
          data-video-title={videos[0].title}
          class="group w-full"
          data-vid-main
        >
          <span class="relative overflow-hidden rounded-[18px] block">
            <img src={videos[0].thumb} alt={videos[0].alt} class="aspect-[9/16] w-full object-cover" loading="lazy" width="360" height="640" data-vid-main-img />
            <span class="absolute inset-0 flex items-center justify-center bg-black/20">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-primary-light">
                <svg class="ml-1 h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </span>
          </span>
          <span class="mt-2 block text-left text-[16px] font-medium leading-[1.4] text-body-muted" data-vid-main-title>{videos[0].title}</span>
        </button>
        <div class="mt-3 grid grid-cols-4 gap-2">
          {videos.slice(1).map((v) => (
            <button
              type="button"
              data-video-thumb
              data-video-url={v.url}
                data-video-slug={v.slug}
              data-video-title={v.title}
              data-video-thumb-src={v.thumb}
              class="group"
            >
              <span class="relative overflow-hidden rounded-[12px] block">
                <img src={v.thumb} alt={v.alt} class="aspect-[9/16] w-full object-cover" loading="lazy" width="180" height="320" />
                <span class="absolute inset-0 flex items-center justify-center bg-black/20">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/80 text-primary-light">
                    <svg class="ml-0.5 h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Desktop: 5-col grid with arrows -->
      <div class="relative hidden md:block">
        <button type="button" data-vid-prev aria-label="Назад" class="cursor-pointer absolute -left-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-card/90 text-body-faint shadow-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button type="button" data-vid-next aria-label="Вперёд" class="cursor-pointer absolute -right-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-card/90 text-body-faint shadow-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
        <div data-vid-track class="grid grid-cols-5 gap-4">
          {videos.map((v) => (
            <div data-vid-card>
              <button
                type="button"
                data-video-open
                data-video-url={v.url}
                data-video-slug={v.slug}
                data-video-title={v.title}
                class="group block w-full cursor-pointer"
              >
                <span class="relative overflow-hidden rounded-[18px] block">
                  <img src={v.thumb} alt={v.alt} class="aspect-[9/16] w-full object-cover transition group-hover:scale-105" loading="lazy" width="360" height="640" />
                  <span class="absolute inset-0 flex items-center justify-center bg-black/20">
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-primary-light">
                      <svg class="ml-1 h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </span>
                </span>
              </button>
              {/* Заголовок — ссылка на страницу видео: внутренняя перелинковка + адрес, которым можно поделиться */}
              <a href={`/video/${v.slug}/`} class="mt-2 line-clamp-2 block text-left text-[16px] leading-[1.4] text-body-muted no-underline hover:text-primary transition-colors">{v.title}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<VideoModal />

<script is:inline>
  // Лайтбокс общий на всю страницу — при открытии переставляем на него адрес видео,
  // иначе «Поделиться» отдаст ссылку на предыдущий ролик.
  function openVideoLightbox(btn) {
    var url = btn.dataset.videoUrl;
    if (!url) return;
    var id = url.split('/').pop();
    document.getElementById('videoFrame').src = 'https://kinescope.io/embed/' + id + '?autoplay=1';
    var share = document.querySelector('#videoModal .share-btn');
    if (share) {
      share.dataset.shareUrl = btn.dataset.videoSlug
        ? 'https://aidacamp.ru/video/' + btn.dataset.videoSlug + '/'
        : '';
      share.dataset.shareTitle = btn.dataset.videoTitle || '';
      share.classList.toggle('hidden', !btn.dataset.videoSlug);
    }
    document.getElementById('videoModal').showModal();
  }

  // Tab switching
  document.querySelectorAll('[data-video-filter]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-video-filter]').forEach(function(b) {
        b.classList.remove('bg-[#fff2e3]', 'text-[#9c3d00]');
        b.classList.add('bg-surface', 'text-body-muted');
      });
      btn.classList.remove('bg-surface', 'text-body-muted');
      btn.classList.add('bg-[#fff2e3]', 'text-[#9c3d00]');
      var filter = btn.dataset.videoFilter;
      document.querySelectorAll('[data-video-category]').forEach(function(cat) {
        cat.classList.toggle('hidden', cat.dataset.videoCategory !== filter);
      });
    });
  });

  // Open video modal
  document.querySelectorAll('[data-video-open]').forEach(function(btn) {
    btn.addEventListener('click', function() { openVideoLightbox(btn); });
  });

  // Мобильная миниатюра → открыть в лайтбоксе и подставить в главную карточку
  function bindThumb(thumbSel, mainSel, imgSel, titleSel) {
    document.querySelectorAll(thumbSel).forEach(function(btn) {
      btn.addEventListener('click', function() {
        openVideoLightbox(btn);
        var main = document.querySelector(mainSel);
        var img = document.querySelector(imgSel);
        var title = document.querySelector(titleSel);
        if (main) {
          main.dataset.videoUrl = btn.dataset.videoUrl;
          main.dataset.videoSlug = btn.dataset.videoSlug || '';
          main.dataset.videoTitle = btn.dataset.videoTitle || '';
        }
        if (img) img.src = btn.dataset.videoThumbSrc || '';
        if (title) title.textContent = btn.dataset.videoTitle || '';
      });
    });
  }
  bindThumb('[data-video-thumb]', '[data-vid-main]', '[data-vid-main-img]', '[data-vid-main-title]');
  bindThumb('[data-proj-thumb]', '[data-proj-main]', '[data-proj-main-img]', '[data-proj-main-title]');

  // Desktop carousel arrows (Videos tab)
  (function() {
    var track = document.querySelector('[data-vid-track]');
    var prev = document.querySelector('[data-vid-prev]');
    var next = document.querySelector('[data-vid-next]');
    if (!track || !prev || !next) return;
    var cards = track.querySelectorAll('[data-vid-card]');
    var offset = 0, total = cards.length;
    function update() { cards.forEach(function(c, i) { c.style.order = (i - offset + total) % total; }); }
    prev.addEventListener('click', function() { offset = (offset - 1 + total) % total; update(); });
    next.addEventListener('click', function() { offset = (offset + 1) % total; update(); });
  })();
</script>
