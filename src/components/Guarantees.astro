---
/**
 * Guarantees — блок «Гарантии» на главном лендинге.
 * Четыре ключевые гарантии АйДаКемп: возврат, безопасность, результат, ответственность туроператора.
 * Размещать после Reviews, перед FAQ.
 */
const guarantees = [
  {
    icon: 'bi-cash-coin',
    color: 'bg-emerald-100',
    iconColor: 'text-emerald-600',
    title: 'Возврат при болезни',
    text: 'Если ребёнок заболел в лагере — вернём за неиспользованные дни за вычетом фактически понесённых расходов исполнителя (ст. 32 закона «О защите прав потребителей»).',
  },
  {
    icon: 'bi-shield-fill-check',
    color: 'bg-blue-100',
    iconColor: 'text-blue-600',
    title: 'Безопасность 24/7',
    text: 'Закрытая территория санатория, охрана, медработник на весь сезон. Фото каждый вечер в Telegram-канале для родителей.',
  },
  {
    icon: 'bi-laptop',
    color: 'bg-primary/10',
    iconColor: 'text-primary',
    title: 'Готовый проект',
    text: 'К концу смены каждый ребёнок защищает проект на хакатоне. Не «познакомились с темой» — а рабочий продукт.',
  },
  {
    icon: 'bi-bag-check-fill',
    color: 'bg-amber-100',
    iconColor: 'text-amber-600',
    title: 'Ответственность застрахована',
    text: 'Застрахована ответственность туроператора (Росгосстрах). Личную страховку от несчастных случаев родитель оформляет сам.',
  },
];
---

<section class="mx-auto max-w-[1312px] px-4 py-10 md:py-14">
  <h2 class="text-center text-[26px] md:text-[32px] font-bold text-slate-900 mb-2">
    Наши гарантии
  </h2>
  <p class="text-center text-slate-500 text-[16px] mb-8 max-w-xl mx-auto">
    Мы несём ответственность — юридически и по-человечески
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {guarantees.map(g => (
      <div class="flex flex-col gap-3 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <div class={`h-11 w-11 rounded-xl ${g.color} flex items-center justify-center shrink-0`}>
          <i class={`bi ${g.icon} text-[20px] ${g.iconColor}`} aria-hidden="true"></i>
        </div>
        <div>
          <p class="font-semibold text-slate-900 text-[16px] mb-1">{g.title}</p>
          <p class="text-slate-500 text-base leading-relaxed">{g.text}</p>
        </div>
      </div>
    ))}
  </div>

  <p class="text-center mt-6 text-base text-slate-400">
    Полные условия возврата — в{' '}
    <a href="/politika-vozvrata" class="underline underline-offset-2 hover:text-slate-600">Политике возврата</a>.
    Ответственность туроператора застрахована (договор с Росгосстрахом).
  </p>
</section>
