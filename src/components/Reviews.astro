---
import { reviews } from '../data/reviews';
---

<section id="reviews" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4" data-reviews-root>
  <div class="p-[18px]">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-[22px] font-bold leading-[1.1] text-body md:text-[28px]">Отзывы</h2>
      <div class="flex items-center gap-2">
        <span class="text-[32px] font-extrabold text-body leading-none tabular-nums">5.0</span>
        <div class="flex text-amber-400">
          {[...Array(5)].map(() => (
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-2 text-[15px] md:text-[14px] text-body-faint">
      Более 40 реальных отзывов на
      <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener" class="text-orange-700 underline">Яндекс.Картах</a>
    </p>

    <div class="-mx-[2px] px-[2px] mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:pb-0 xl:grid-cols-3" data-reviews-carousel>
      {reviews.map((r, i) => (
        <article class="min-w-[88%] snap-start rounded-[18px] border border-border bg-surface p-4 md:min-w-0 md:rounded-[20px] md:p-5 flex flex-col">
          <div class="flex items-center gap-3">
            <img src={r.photo} alt={r.name} class="h-10 w-10 rounded-full border border-border object-cover" width="40" height="40" loading="lazy" />
            <div>
              <p class="text-[14px] font-semibold text-body">{r.name}</p>
              <p class="text-[15px] md:text-[14px] text-body-muted">{r.date}</p>
            </div>
            <div class="ml-auto flex text-amber-400">
              {[...Array(5)].map(() => (
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
          </div>
          <p class="mt-3 text-[18px] leading-[1.6] text-body-muted flex-1">{r.text}</p>
          <button
            type="button"
            data-review-open={i}
            class="cursor-pointer mt-3 inline-flex items-center gap-1 text-[14px] font-medium text-orange-700 hover:text-orange-800 transition-colors self-start"
          >
            Подробнее
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </article>
      ))}
    </div>
    <!-- Dots indicator — mobile only -->
    <div class="mt-3 flex justify-center items-center gap-2 md:hidden" data-reviews-dots role="group" aria-label="Навигация по отзывам">
      {reviews.map((_, i) => (
        <span
          class={`h-2 rounded-full transition-all duration-200 ${i === 0 ? 'w-6 bg-primary-dark' : 'w-2 bg-border'}`}
          data-reviews-dot={i}
          aria-current={i === 0 ? 'true' : 'false'}
        ></span>
      ))}
    </div>

    <!-- CTA «Оставить отзыв» — для текущих и прошлых клиентов -->
    <div class="mt-5 flex flex-wrap items-center gap-3 rounded-[16px] bg-surface border border-border-light px-4 py-3 card-shadow">
      <div class="flex-1 min-w-0">
        <p class="text-[14px] font-semibold text-body">Вернулись из лагеря?</p>
        <p class="text-[14px] md:text-[13px] text-body-faint mt-0.5">Поделитесь впечатлениями — вашим отзывом воспользуются другие родители</p>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/?add-review=true" target="_blank" rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-full border border-primary/40 bg-transparent px-3 py-1.5 text-[13px] font-semibold text-primary-dark transition-colors hover:bg-primary/8 hover:border-primary/60"
          onclick="window.trackGoal?.('review_cta_click')">
          <i class="bi bi-star-fill text-[12px]" aria-hidden="true"></i>
          Яндекс.Карты
        </a>
        <a href="https://2gis.ru/moscow/firm/70000001072416487/tab/reviews" target="_blank" rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-full border border-border-light bg-card hover:bg-surface px-3 py-1.5 text-[13px] font-medium text-body-muted transition-colors">
          2GIS
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Review Modal -->
<div id="review-modal"
  class="fixed inset-0 z-[90] hidden items-end md:items-center justify-center"
  inert role="dialog" aria-modal="true">
  <div id="review-modal-backdrop"
    class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
  <div id="review-modal-panel"
    class="relative w-full md:w-[520px] md:max-w-[calc(100vw-32px)]
           bg-card md:rounded-2xl rounded-t-2xl
           shadow-[0_-10px_40px_rgba(0,0,0,0.2)] md:shadow-[0_20px_60px_rgba(0,0,0,0.2)]
           md:max-h-[80vh] flex flex-col
           translate-y-full md:translate-y-4 opacity-0
           transition-all duration-300 ease-out">
    <!-- Handle -->
    <div class="md:hidden flex justify-center pt-2 pb-1 shrink-0">
      <div class="h-1 w-10 rounded-full bg-border"></div>
    </div>
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 px-5 pt-3 pb-4 border-b border-border-light shrink-0">
      <div class="flex items-center gap-3">
        <img id="review-modal-photo" src="" alt="" class="h-11 w-11 rounded-full border border-border object-cover" width="44" height="44" />
        <div>
          <p id="review-modal-name" class="text-[15px] font-semibold text-body"></p>
          <p id="review-modal-date" class="text-[14px] md:text-[13px] text-body-faint"></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex text-amber-400">
          {[...Array(5)].map(() => (
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <button type="button" id="review-modal-close"
          class="cursor-pointer h-8 w-8 rounded-full flex items-center justify-center text-body-faint hover:bg-surface hover:text-body-muted transition"
          aria-label="Закрыть">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    <!-- Body -->
    <div class="flex-1 overflow-y-auto px-5 py-4">
      <p id="review-modal-text" class="text-[18px] leading-[1.65] text-body-muted"></p>
    </div>
  </div>
</div>

<script type="application/json" id="reviews-json" set:html={JSON.stringify(reviews)}></script>

<script>
  function initReviews() {
    // Dots indicator for mobile carousel
    const carousel = document.querySelector<HTMLElement>('[data-reviews-carousel]');
    const dots = document.querySelectorAll<HTMLElement>('[data-reviews-dot]');
    if (carousel && dots.length) {
      const cards = Array.from(carousel.children) as HTMLElement[];
      const dotObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            dots.forEach((d, di) => {
              const isActive = di === idx;
              d.classList.toggle('bg-primary-dark', isActive);
              d.classList.toggle('w-6', isActive);
              d.classList.toggle('bg-border', !isActive);
              d.classList.toggle('w-2', !isActive);
              d.setAttribute('aria-current', isActive ? 'true' : 'false');
            });
          }
        });
      }, { root: carousel, threshold: 0.6 });
      cards.forEach((card) => dotObserver.observe(card));
    }

    const reviews = JSON.parse(document.getElementById('reviews-json')?.textContent || '[]');
    const modal    = document.getElementById('review-modal')!;
    const backdrop = document.getElementById('review-modal-backdrop')!;
    const panel    = document.getElementById('review-modal-panel')!;
    const closeBtn = document.getElementById('review-modal-close')!;
    const photo    = document.getElementById('review-modal-photo') as HTMLImageElement;
    const name     = document.getElementById('review-modal-name')!;
    const date     = document.getElementById('review-modal-date')!;
    const text     = document.getElementById('review-modal-text')!;

    function openModal(idx: number) {
      const r = reviews[idx];
      if (!r) return;
      photo.src = r.photo;
      photo.alt = r.name;
      name.textContent  = r.name;
      date.textContent  = r.date;
      text.textContent  = r.fullText || r.text;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.removeAttribute('inert');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        backdrop.style.opacity = '1';
        panel.classList.remove('translate-y-full', 'md:translate-y-4', 'opacity-0');
        panel.classList.add('translate-y-0', 'opacity-100');
      });
    }

    function closeModal() {
      backdrop.style.opacity = '0';
      panel.classList.add('translate-y-full', 'md:translate-y-4', 'opacity-0');
      panel.classList.remove('translate-y-0', 'opacity-100');
      document.body.style.overflow = '';
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('inert', '');
      }, 300);
    }

    document.querySelectorAll('[data-review-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        openModal(Number((btn as HTMLElement).dataset.reviewOpen));
      });
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    // Swipe down to close on mobile
    let startY = 0;
    panel.addEventListener('touchstart', (e) => { startY = e.touches[0].clientY; }, { passive: true });
    panel.addEventListener('touchend', (e) => {
      if (e.changedTouches[0].clientY - startY > 60) closeModal();
    }, { passive: true });
  }

  document.addEventListener('astro:page-load', initReviews);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initReviews(); }, { timeout: 3000 });
  } else {
    setTimeout(initReviews, 200);
  }
</script>
