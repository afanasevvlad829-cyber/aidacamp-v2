---
/**
 * ArticleHero — hero-блок для статей /stati/*.
 *
 * v4: contenet-first. Статья — не лендинг. На hero 1 якорь (H1) +
 *     1 эпиграф (Дарья). Цена/смены — внутри и в финале статьи.
 *
 * Layout:
 *   - Фон #0d1a2b + фото + /40 градиент (фото видимое)
 *   - 2-col: слева H1 + subtitle + meta, справа — только плашка Дарьи
 *   - AI-CTA — в правом нижнем углу
 *
 * Props:
 *   - title, subtitle, imageBase, imageAlt, breadcrumbsLast  — базовый контент
 *   - date?, readTime?                                        — мета
 *   - daryaQuote?: string                                     — цитата-эпиграф в тему
 *   - showAiCta?: boolean (default true)
 */

interface Props {
  title: string;
  subtitle?: string;
  imageBase: string;
  imageAlt: string;
  date?: string;
  readTime?: string;
  breadcrumbsLast: string;
  daryaQuote?: string;
  showAiCta?: boolean;
}

const {
  title,
  subtitle,
  imageBase,
  imageAlt,
  date,
  readTime,
  breadcrumbsLast,
  daryaQuote,
  showAiCta = true,
} = Astro.props;

const imgSrc = `/images/articles/${imageBase}-1600.jpg`;
const avifSrcset = `/images/articles/${imageBase}-800.avif 800w, /images/articles/${imageBase}-1200.avif 1200w, /images/articles/${imageBase}-1600.avif 1600w`;
const jpgSrcset  = `/images/articles/${imageBase}-800.jpg 800w, /images/articles/${imageBase}-1200.jpg 1200w, /images/articles/${imageBase}-1600.jpg 1600w`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
    { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr" },
    { "@type": "ListItem", "position": 3, "name": breadcrumbsLast }
  ]
};
---

<section class="relative overflow-hidden bg-[#0d1a2b] px-5 pt-14 pb-20 md:px-14 md:pt-16 md:pb-16">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- Background photo -->
  <div class="absolute inset-0 z-0">
    <picture>
      <source type="image/avif" srcset={avifSrcset} sizes="100vw" />
      <source type="image/jpeg" srcset={jpgSrcset} sizes="100vw" />
      <img
        src={imgSrc}
        alt={imageAlt}
        class="w-full h-full object-cover object-[center_30%]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1600"
        height="685"
      />
    </picture>
    <!-- Lighter gradient: photo stays visible as content illustration -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0d1a2b]/80 via-[#0d1a2b]/40 to-[#0d1a2b]/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0d1a2b]/50 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1312px]">

    <!-- Breadcrumb -->
    <nav class="text-[14px] text-white/55">
      <a href="/" class="hover:text-white/85 transition-colors">Главная</a>
      <span class="mx-2">&rarr;</span>
      <a href="/stati/zavisimost-ot-kompyuternyh-igr" class="hover:text-white/85 transition-colors">Статьи</a>
      <span class="mx-2">&rarr;</span>
      <span class="text-white/75">{breadcrumbsLast}</span>
    </nav>

    <!-- 2-col: title left, Daria quote right -->
    <div class="mt-10 grid gap-10 md:grid-cols-[1.2fr_360px] md:gap-14 md:items-start">

      <!-- LEFT: H1 + subtitle + meta -->
      <div>
        <h1 class="text-[30px] md:text-[40px] font-bold leading-[1.1] tracking-[-0.03em] text-white [text-shadow:0_2px_14px_rgba(0,0,0,0.5)]">
          {title}
        </h1>

        {subtitle && (
          <p class="mt-5 text-[16px] md:text-[18px] text-white/80 leading-[1.55] max-w-[560px] [text-shadow:0_1px_8px_rgba(0,0,0,0.4)]">
            {subtitle}
          </p>
        )}

        <!-- Meta: date + read time -->
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-white/60">
          {date && <span>{date}</span>}
          {date && readTime && <span class="text-white/25">·</span>}
          {readTime && <span>{readTime}</span>}
        </div>
      </div>

      <!-- RIGHT: Daria epigraph -->
      {daryaQuote && (
        <aside class="rounded-[16px] bg-white/10 backdrop-blur-md border border-white/15 p-4 md:p-5">
          <div class="flex items-start gap-3">
            <img
              src="/images/team/sm/team-daria-main-01.avif"
              alt="Дарья Афанасьева"
              class="h-14 w-14 shrink-0 rounded-full object-cover object-top"
              width="56"
              height="56"
              loading="lazy"
            />
            <div class="min-w-0">
              <p class="text-[14px] leading-[1.55] text-white/90 italic">«{daryaQuote}»</p>
              <p class="mt-3 text-[12.5px] font-semibold text-white/85">Дарья Афанасьева</p>
              <p class="text-[11.5px] text-white/55">основатель АйДаКемп, мама подростка</p>
            </div>
          </div>
        </aside>
      )}

    </div>

    <!-- AI CTA — bottom-right -->
    {showAiCta && (
      <a
        href="/stati/ii-zamenit-programmista"
        class="absolute right-5 bottom-5 md:right-14 md:bottom-6 inline-flex items-center gap-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 px-3.5 py-2 text-[12.5px] md:text-[13px] text-white/85 hover:text-white transition-colors group backdrop-blur-sm max-w-[60%] md:max-w-none"
      >
        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-orange-500 text-[9px] font-bold text-white">?</span>
        <span>«ИИ заменит программистов» — правда или реклама?</span>
        <svg class="h-3 w-3 shrink-0 opacity-60 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    )}
  </div>
</section>
