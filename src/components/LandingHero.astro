---
import { STAT_DISTANCE, CAMP_PRICE_FROM, CAMP_PRICE_FROM_ID, CAMP_SEASON, YANDEX_MAPS_URL, STAT_RATING } from '../data/contacts';
import { getSeoEffect, getTopicEffect } from '../lib/heroVariant';

// Детерминированный эффект по slug страницы
const _TOPIC_SLUGS = new Set(['python-lager','ai-lager','minecraft-lager','scratch-lager','roblox-lager','3d-modelirovanie-lager']);
const _slug = Astro.url.pathname.replace(/\/+$/, '').split('/').pop() ?? '';
const _heroEffect = _TOPIC_SLUGS.has(_slug) ? getTopicEffect(_slug) : getSeoEffect(_slug);

// Анимированный hero-bg по slug — production версия эффектов с mobile fallback (см. global.css)
const _HERO_BG_BY_SLUG: Record<string, string> = {
  'ai-lager':              'quantum',
  '3d-modelirovanie-lager':'fiber',
  'roblox-lager':          'hexagons',
  'minecraft-lager':       'interactive-stars',
  'scratch-lager':         'particle-flow',
  'python-lager':          'circuit',
  'lager-dlya-podrostkov': 'neon-network',
  'it-lager':              'ascendant',
  'lager-programmirovaniya':'ascendant',
  'letnyaya-it-shkola':    'ascendant',
  'lager-na-leto-2026':    'star-genesis',
  'o-lagere':              'glass-orbs',
  'lager-bez-telefonov':   'fireflies',
};
const _heroBg = _HERO_BG_BY_SLUG[_slug];

interface Props {
  h1: string;
  subtitle: string;
  breadcrumb: string;
  keywords: string[];
  image?: string;
  imageAlt?: string;
  /** Сезонная мета вместо летней («смены июнь–август · от PRICE_MIN»):
   *  чипы дат и цены сезона, ведут на #prezapis. Для осень/зима/весна. */
  seasonMeta?: { dates: string; price: string };
}

const { h1, subtitle, breadcrumb, keywords, image, imageAlt = '', seasonMeta } = Astro.props;

// BreadcrumbList отдаёт LandingLayout (проп breadcrumbLabel) — здесь только видимые крошки.
// Схема была и тут, и там: на 86 лендингах в HTML попадало два блока.
---

<section data-hero-effect={_heroEffect} data-hero-bg={_heroBg} class="relative overflow-hidden bg-[#0d1a2b] px-5 pt-10 pb-8 md:px-14 md:pt-14 md:pb-12">
  {/* CSS backgrounds — photo removed per TZ v3.0 */}
  {_heroEffect === 'mesh' && (
    <div class="absolute inset-0 z-0 bg-[#0d1a2b]">
      <div class="lp-blob lp-blob-1 absolute"></div>
      <div class="lp-blob lp-blob-2 absolute"></div>
      <div class="lp-blob lp-blob-3 absolute"></div>
    </div>
  )}
  {_heroEffect === 'noise' && (
    <div class="absolute inset-0 z-0 lp-noise-bg"></div>
  )}
  {_heroEffect === 'grid' && (
    <div class="absolute inset-0 z-0 bg-[#070d1a] overflow-hidden">
      <div class="lp-grid-lines"></div>
    </div>
  )}

  {/* Сезонное фото — подложка на ВЕСЬ hero. Затемнение градиентное, не сплошное:
      плотнее слева (под текстом) и у низа, справа фото дышит. */}
  {seasonMeta && image && (
    <div class="absolute inset-0 z-[1]" aria-hidden="true">
      <img
        src={image}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-[#0d1a2b]/70 md:hidden"></div>
      <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-[#0d1a2b]/95 via-[#0d1a2b]/70 to-[#0d1a2b]/25"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0d1a2b]/60 via-transparent to-transparent"></div>
    </div>
  )}

  <div class="relative z-10 mx-auto max-w-[1312px]">
    <div class="flex flex-col gap-8 lg:max-w-[680px]">

      <!-- Текст -->
      <div class="min-w-0">
        <!-- Breadcrumb -->
        <nav class="text-base text-white/65">
          <a href="/" class="hover:text-white/85 transition-colors">Главная</a>
          <span class="mx-2">&rarr;</span>
          <span class="text-white/70">{breadcrumb}</span>
        </nav>

        <!-- H1 -->
        <h1 class="mt-4 text-[32px] md:text-[48px] font-bold leading-[1.1] tracking-[-0.03em] text-white">
          {(() => {
            const words = h1.split(' ');
            if (words.length < 3) return h1;
            const last = words.slice(-2).join(' ');
            const rest = words.slice(0, -2).join(' ');
            return <>{rest}{' '}<span class="hero-outline">{last}</span></>;
          })()}
        </h1>

        <!-- Subtitle -->
        <p class={`mt-4 text-[16px] md:text-[17px] leading-[1.6] ${seasonMeta ? 'text-white/90' : 'text-white/70'}`}>
          {subtitle}
        </p>

        <!-- Keywords -->
        <ul class="mt-6 flex flex-col gap-2.5">
          {keywords.map((kw) => (
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-base text-orange-400">&#10003;</span>
              <span class="text-base text-white/80">{kw}</span>
            </li>
          ))}
        </ul>

        {/* Сезонное фото — фоновая подложка hero (см. блок выше); alt-текст для доступности */}
        {seasonMeta && image && <span class="sr-only">{imageAlt}</span>}


        <!-- Meta line — кликабельные чипы -->
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-base text-white/65">
          <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/85 transition-colors">
            <i class="bi bi-star-fill text-[11px] text-[#f5a624]" aria-hidden="true"></i>
            {STAT_RATING} Яндекс.Карты
          </a>
          <span class="text-white/30" aria-hidden="true">·</span>
          <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/85 transition-colors">
            <i class="bi bi-geo-alt text-[12px]" aria-hidden="true"></i>
            {STAT_DISTANCE} от Москвы
          </a>
          <span class="text-white/30" aria-hidden="true">·</span>
          {seasonMeta ? (
            <>
              <a href="#prezapis" class="hover:text-white/85 transition-colors">
                {seasonMeta.dates}
              </a>
              <span class="text-white/30" aria-hidden="true">·</span>
              <a href="#prezapis" class="hover:text-white/85 transition-colors">
                {seasonMeta.price}
              </a>
            </>
          ) : (
            <>
              <a href="/#shifts" class="hover:text-white/85 transition-colors">
                смены {CAMP_SEASON}
              </a>
              <span class="text-white/30" aria-hidden="true">·</span>
              <button type="button" data-shift-link={CAMP_PRICE_FROM_ID} class="hover:text-white/85 transition-colors cursor-pointer">
                от {CAMP_PRICE_FROM}
              </button>
            </>
          )}
          <span class="text-white/30" aria-hidden="true">·</span>
          <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/80 transition-colors">
            <i class="bi bi-trophy text-[11px]" aria-hidden="true"></i>
            ТОП-4 IT-лагерей МО
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
<!-- ShiftModal НЕ рендерим здесь — уже есть в Base.astro, дубль давал id="shift-modal" дважды (Labrika, 10.07.2026) -->
