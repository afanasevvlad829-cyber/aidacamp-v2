---
import ShiftModal from './ShiftModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM, CAMP_SEASON, YANDEX_MAPS_URL } from '../data/contacts';
import { getSeoEffect, getTopicEffect } from '../lib/heroVariant';

// Детерминированный эффект по slug страницы
const _TOPIC_SLUGS = new Set(['python-lager','ai-lager','minecraft-lager','scratch-lager','roblox-lager','3d-modelirovanie-lager']);
const _slug = Astro.url.pathname.replace(/\/+$/, '').split('/').pop() ?? '';
const _heroEffect = _TOPIC_SLUGS.has(_slug) ? getTopicEffect(_slug) : getSeoEffect(_slug);

// Анимированный hero-bg по slug — production версия эффектов с mobile fallback (см. global.css)
const _HERO_BG_BY_SLUG: Record<string, string> = {
  'ai-lager':              'quantum',
  '3d-modelirovanie-lager':'fiber',
  'roblox-lager':          'hexagons',
  'minecraft-lager':       'interactive-stars',
  'scratch-lager':         'particle-flow',
  'python-lager':          'circuit',
  'lager-dlya-podrostkov': 'neon-network',
  'it-lager':              'ascendant',
  'lager-programmirovaniya':'ascendant',
  'letnyaya-it-shkola':    'ascendant',
  'lager-na-leto-2026':    'star-genesis',
  'o-lagere':              'glass-orbs',
  'lager-bez-telefonov':   'fireflies',
};
const _heroBg = _HERO_BG_BY_SLUG[_slug];

interface Props {
  h1: string;
  subtitle: string;
  breadcrumb: string;
  keywords: string[];
  image?: string;
  imageAlt?: string;
}

const { h1, subtitle, breadcrumb, keywords, image, imageAlt = '' } = Astro.props;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
    { "@type": "ListItem", "position": 2, "name": breadcrumb }
  ]
};
---

<section data-hero-effect={_heroEffect} data-hero-bg={_heroBg} class="relative overflow-hidden bg-[#0d1a2b] px-5 pt-10 pb-8 md:px-14 md:pt-14 md:pb-12">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  {/* CSS backgrounds — photo removed per TZ v3.0 */}
  {_heroEffect === 'mesh' && (
    <div class="absolute inset-0 z-0 bg-[#0d1a2b]">
      <div class="lp-blob lp-blob-1 absolute"></div>
      <div class="lp-blob lp-blob-2 absolute"></div>
      <div class="lp-blob lp-blob-3 absolute"></div>
    </div>
  )}
  {_heroEffect === 'noise' && (
    <div class="absolute inset-0 z-0 lp-noise-bg"></div>
  )}
  {_heroEffect === 'grid' && (
    <div class="absolute inset-0 z-0 bg-[#070d1a] overflow-hidden">
      <div class="lp-grid-lines"></div>
    </div>
  )}

  <div class="relative z-10 mx-auto max-w-[1312px]">
    <div class="flex flex-col gap-8 lg:max-w-[680px]">

      <!-- Текст -->
      <div class="min-w-0">
        <!-- Breadcrumb -->
        <nav class="text-[14px] text-white/65">
          <a href="/" class="hover:text-white/85 transition-colors">Главная</a>
          <span class="mx-2">&rarr;</span>
          <span class="text-white/70">{breadcrumb}</span>
        </nav>

        <!-- H1 -->
        <h1 class="mt-4 text-[32px] md:text-[48px] font-bold leading-[1.1] tracking-[-0.03em] text-white">
          {(() => {
            const words = h1.split(' ');
            if (words.length < 3) return h1;
            const last = words.slice(-2).join(' ');
            const rest = words.slice(0, -2).join(' ');
            return <>{rest}{' '}<span class="hero-outline">{last}</span></>;
          })()}
        </h1>

        <!-- Subtitle -->
        <p class="mt-4 text-[16px] md:text-[17px] text-white/70 leading-[1.6]">
          {subtitle}
        </p>

        <!-- Keywords -->
        <ul class="mt-6 flex flex-col gap-2.5">
          {keywords.map((kw) => (
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-[14px] text-orange-400">&#10003;</span>
              <span class="text-[14px] text-white/80">{kw}</span>
            </li>
          ))}
        </ul>


        <!-- Meta line — кликабельные чипы -->
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] text-white/65">
          <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/85 transition-colors">
            <i class="bi bi-geo-alt text-[12px]" aria-hidden="true"></i>
            {STAT_DISTANCE} от Москвы
          </a>
          <span class="text-white/30" aria-hidden="true">·</span>
          <a href="/#shifts" class="hover:text-white/85 transition-colors">
            смены {CAMP_SEASON}
          </a>
          <span class="text-white/30" aria-hidden="true">·</span>
          <button type="button" data-shift-link="shift-2-1" class="hover:text-white/85 transition-colors cursor-pointer">
            от {CAMP_PRICE_FROM}
          </button>
          <span class="text-white/30" aria-hidden="true">·</span>
          <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/80 transition-colors">
            <i class="bi bi-trophy text-[11px]" aria-hidden="true"></i>
            ТОП-4 IT-лагерей МО
          </a>
        </div>
      </div>

    </div>
  </div>
</section>


<ShiftModal />

<!-- Equipment Modal (landing) -->
<dialog
  id="equipmentModalLanding"
  class="fixed inset-0 m-auto w-[min(92vw,460px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_24px_64px_rgba(15,23,42,0.22)] backdrop:bg-black/45 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <i class="bi bi-laptop text-[32px] leading-none" aria-hidden="true"></i>
        <h3 class="text-[18px] font-bold text-slate-900 leading-[1.25]">Почему ноутбук<br/>не нужен</h3>
      </div>
      <button type="button" data-equip-landing-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition"
        aria-label="Закрыть">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="rounded-[14px] bg-slate-50 px-4 py-3.5 mb-4">
      <p class="text-[14px] font-semibold text-slate-800 mb-1">Проблема с «домашними» ноутбуками</p>
      <p class="text-[14px] text-slate-600 leading-[1.6]">У каждой семьи свой ноутбук — от дешёвого Windows до MacBook за 500 000 ₽. Разные ОС, драйверы, версии ПО. Для преподавателей это нескончаемый ад: «почему у тебя не запускается», «переустанови библиотеку».</p>
    </div>
    <p class="text-[14px] font-semibold text-slate-800 mb-3">Наше решение — одинаковый парк машин</p>
    <ul class="space-y-2.5 mb-5">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-clock" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Сброс ОС за 15 секунд</p>
          <p class="text-[13px] text-slate-500">Любая машина возвращается в эталонное состояние — одна кнопка, 15 секунд.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Полное восстановление за 15 минут</p>
          <p class="text-[13px] text-slate-500">Если ребёнок что-то сломал — копируем проект, сбрасываем, восстанавливаем. Работа не теряется.</p>
        </div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[14px]"><i class="bi bi-check-lg text-orange-600" aria-hidden="true"></i></span>
        <div>
          <p class="text-[14px] font-semibold text-slate-800">Выверенные настройки</p>
          <p class="text-[13px] text-slate-500">Все машины идентичны. Преподаватели знают их досконально — занятие идёт без технических пауз.</p>
        </div>
      </li>
    </ul>
    <div class="rounded-[14px] bg-[#0d1a2b] px-4 py-3.5">
      <p class="text-[14px] font-semibold text-white/90 leading-[1.5]">Мы реально понимаем, как работает IT-образование — и строим инфраструктуру, которая не мешает учиться, а помогает.</p>
    </div>
  </div>
</dialog>

<script>
  function initLandingStamp() {
    const modal = document.getElementById('equipmentModalLanding') as HTMLDialogElement | null;
    if (!modal) return;
    const open = () => modal.showModal();
    document.getElementById('equipment-stamp-landing')?.addEventListener('click', open);
    document.getElementById('equipment-stamp-landing-mobile')?.addEventListener('click', open);
    modal.querySelector('[data-equip-landing-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  }
  document.addEventListener('astro:page-load', initLandingStamp);
  initLandingStamp();
</script>
