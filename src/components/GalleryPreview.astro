---
/**
 * GalleryPreview — лёгкий preview Gallery на главной
 * Показывает 3 фото с CTA «Все фото →» на /foto/
 * Снижает initial load главной (вместо полной Gallery с 30+ фото)
 */
const previews = [
  { src: '/images/gallery/camp-smile.avif', alt: 'Атмосфера летнего IT-лагеря АйДаКемп' },
  { src: '/images/gallery/pool-kids-edge.avif', alt: 'Бассейн в лагере АйДаКемп' },
  { src: '/images/gallery/study-dome-group.avif', alt: 'IT-занятия в АйДаКемп' },
];
---

<section id="gallery-preview" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4"><span id="gallery" class="sr-only" aria-hidden="true"></span>
  <div class="p-[18px]">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2">
        <div class="list-accent-dot"></div>
        <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">
          Фото
        </h2>
      </div>
      <a
        href="/foto/"
        class="group inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover"
      >
        Как выглядит АйДаКемп?
        <i class="bi bi-arrow-right icon-arrow-right-hover" aria-hidden="true"></i>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-2 md:gap-3">
      {previews.map((p, i) => (
        <a href="/foto/" class="group relative block overflow-hidden rounded-[12px] bg-slate-100 aspect-square active:scale-[0.97] transition-transform duration-150">
          <img
            src={p.src}
            alt={p.alt}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            width="400"
            height="400"
          />
          {i === 2 && (
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
              <span class="text-white text-base font-semibold flex items-center gap-1">
                <i class="bi bi-images text-[18px]" aria-hidden="true"></i>
                Ещё 30+
              </span>
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
</section>
