---
/**
 * ReturnBanner — два режима в зависимости от gap (дней с последнего просмотра смены):
 *   gap 1–3 дня  → TOP BAR: немедленно, под хедером, оранжевый, заметный
 *   gap 0 или 4+ → BOTTOM BAR: через 10 сек, маленький снизу
 *
 * Gap считается по ts в localStorage ac:viewed_shifts.
 * CTA раскрывает инлайн-форму с телефоном → /api/lead (source=return_banner).
 */
import { mainShifts, shortShifts } from '../data/shifts';

const allShifts = [...mainShifts, ...shortShifts];
const shiftsJson = JSON.stringify(
  allShifts.map(s => ({ id: s.id, name: s.name, free: s.free }))
);
---

<!-- TOP BAR: горячее окно 1–3 дня -->
<div
  id="return-top-bar"
  class="hidden fixed top-0 left-0 right-0 z-[55] -translate-y-full transition-transform duration-300 ease-out"
  aria-live="polite"
>
  <div class="bg-primary px-4 py-2.5 shadow-[0_4px_16px_rgba(0,0,0,0.18)]">
    <div class="mx-auto flex max-w-2xl items-center justify-between gap-3">
      <!-- нормальный вид -->
      <div id="return-top-default" class="flex min-w-0 flex-1 items-center gap-2.5">
        <i class="bi bi-fire text-white text-[16px] shrink-0" aria-hidden="true"></i>
        <span id="return-top-text" class="text-[14px] font-semibold text-white leading-[1.35] truncate"></span>
        <button id="return-top-cta" type="button"
          class="shrink-0 inline-flex items-center gap-1 text-[13px] font-bold text-white/90 whitespace-nowrap hover:text-white transition-colors">
          Узнать подробности <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
        </button>
      </div>
      <!-- CTA → /ask -->
      <a id="return-top-ask" href="/ask"
        class="hidden shrink-0 items-center gap-1.5 rounded-lg bg-white px-4 py-1.5 text-[13px] font-bold text-primary hover:bg-white/90 transition-colors">
        Всё объясним <i class="bi bi-arrow-right text-[11px]" aria-hidden="true"></i>
      </a>
      <button id="return-top-close" type="button"
        class="shrink-0 inline-flex h-7 w-7 items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/15 transition-colors"
        aria-label="Закрыть">
        <i class="bi bi-x-lg text-[13px]" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<!-- BOTTOM BAR: для всех остальных (same-day / gap 4+) -->
<div
  id="return-banner"
  class="hidden fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-400 ease-out"
  aria-live="polite"
  role="status"
>
  <div class="bg-slate-900 border-t border-slate-700 px-4 py-3 md:py-3.5 shadow-[0_-4px_24px_rgba(0,0,0,0.18)]">
    <div class="mx-auto max-w-2xl flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <i class="bi bi-fire text-orange-400 text-[18px] shrink-0" aria-hidden="true"></i>
        <p id="return-banner-text" class="text-[14px] md:text-[15px] text-white/90 leading-[1.4] min-w-0"></p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a id="return-banner-cta" href="/ask"
          class="inline-flex items-center gap-1.5 rounded-lg bg-primary hover:bg-orange-400 px-3 py-1.5 text-[13px] font-semibold text-white transition-colors whitespace-nowrap">
          Всё объясним
          <i class="bi bi-arrow-right text-[11px]" aria-hidden="true"></i>
        </a>
        <button id="return-banner-close" type="button"
          class="inline-flex h-7 w-7 items-center justify-center rounded-full text-white/50 hover:text-white/90 hover:bg-white/10 transition-colors"
          aria-label="Закрыть">
          <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ shiftsJson }}>
  const SHIFTS = JSON.parse(shiftsJson);
  const SESSION_KEY = 'ac:return_banner_shown';

  function getTargetShift() {
    try {
      const viewed = JSON.parse(localStorage.getItem('ac:viewed_shifts') || '[]');
      if (viewed.length > 0) {
        const viewedIds = viewed.map(v => v.id);
        const candidates = SHIFTS.filter(s => viewedIds.includes(s.id) && s.free > 0);
        if (candidates.length > 0) return candidates.sort((a, b) => a.free - b.free)[0];
      }
    } catch {}
    return SHIFTS.filter(s => s.free > 0).sort((a, b) => a.free - b.free)[0];
  }

  function getGapDays() {
    try {
      const viewed = JSON.parse(localStorage.getItem('ac:viewed_shifts') || '[]');
      if (viewed.length > 0) {
        const oldest = Math.min(...viewed.map(v => v.ts || Date.now()));
        return (Date.now() - oldest) / 86400000;
      }
    } catch {}
    const ymMatch = document.cookie.match(/(?:^|[; ])_ym_uid=(\d{10})/);
    if (ymMatch) return (Date.now() / 1000 - parseInt(ymMatch[1])) / 86400;
    return null;
  }

  function freeLabel(n) {
    if (n === 1) return 'последнее место';
    if (n < 5) return `${n} места`;
    return `${n} мест`;
  }

  function initReturnBanner() {
    if (sessionStorage.getItem(SESSION_KEY)) return;
    const shift = getTargetShift();
    if (!shift) return;

    const gap = getGapDays();
    const isHot = gap !== null && gap >= 1 && gap <= 3;
    sessionStorage.setItem(SESSION_KEY, '1');

    if (isHot) {
      // ── TOP BAR: сразу ─────────────────────────────────────────────
      const bar      = document.getElementById('return-top-bar');
      const textEl   = document.getElementById('return-top-text');
      const ctaBtn   = document.getElementById('return-top-cta');
      const askLink  = document.getElementById('return-top-ask');
      const closeBtn = document.getElementById('return-top-close');
      const defaultEl = document.getElementById('return-top-default');
      if (!bar || !textEl) return;

      textEl.textContent = `${shift.name} — осталось ${freeLabel(shift.free)}`;
      bar.classList.remove('hidden');
      requestAnimationFrame(() => {
        bar.classList.remove('-translate-y-full');
        bar.classList.add('translate-y-0');
      });

      ctaBtn?.addEventListener('click', () => {
        defaultEl?.classList.add('hidden');
        askLink?.classList.remove('hidden');
        askLink?.classList.add('flex');
        try { window.ym && window.ym(96499295, 'reachGoal', 'return_banner_cta_click'); } catch {}
      });

      closeBtn?.addEventListener('click', () => {
        bar.classList.remove('translate-y-0');
        bar.classList.add('-translate-y-full');
        setTimeout(() => bar.classList.add('hidden'), 300);
      });

    } else {
      // ── BOTTOM BAR: через 10 сек ───────────────────────────────────
      const hasYmUid  = /(?:^|[; ])_ym_uid=/.test(document.cookie);
      const hasViewed = !!localStorage.getItem('ac:viewed_shifts');
      if (!hasYmUid && !hasViewed) return;

      const banner   = document.getElementById('return-banner');
      const textEl   = document.getElementById('return-banner-text');
      const closeBtn = document.getElementById('return-banner-close');
      if (!banner || !textEl) return;

      textEl.textContent = `«${shift.name}» — осталось ${freeLabel(shift.free)}`;

      setTimeout(() => {
        banner.classList.remove('hidden');
        requestAnimationFrame(() => {
          banner.classList.remove('translate-y-full');
          banner.classList.add('translate-y-0');
        });
        try { window.ym && window.ym(96499295, 'reachGoal', 'return_banner_shown'); } catch {}
      }, 10000);

      document.getElementById('return-banner-cta')?.addEventListener('click', () => {
        try { window.ym && window.ym(96499295, 'reachGoal', 'return_banner_cta_click'); } catch {}
      });

      closeBtn?.addEventListener('click', () => {
        banner.classList.remove('translate-y-0');
        banner.classList.add('translate-y-full');
        setTimeout(() => banner.classList.add('hidden'), 400);
      });
    }
  }

  document.addEventListener('astro:page-load', initReturnBanner);
  initReturnBanner();
</script>
