---
/**
 * RelatedPages — ПРОТОТИП: облако ссылок вместо карточек title+description+CTA.
 * Якорные тексты (page.title) — точные целевые ключи, сохранены полностью, все 147.
 * Убраны только description и CTA-стрелка — на объём/вхождения они не работали,
 * а якорный текст в самой ссылке для SEO важнее.
 */
interface Props {
  title?: string;
  pages: Array<{
    title: string;
    description: string;
    url: string;
    icon?: string;
    emoji?: string;
  }>;
}

const { title = "Подберите лагерь по интересам", pages } = Astro.props;
---

<section class="mx-auto max-w-[1312px] px-4 mt-8 mb-4">
  <div class="p-[18px] md:p-8">

    <!-- Title with stripe -->
    <div class="flex items-center gap-2 mb-6">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[22px] font-bold text-body">
        {title}
      </h2>
    </div>

    <!-- Tag cloud -->
    <div class="flex flex-wrap gap-2">
      {pages.map((page) => (
        <a
          href={page.url}
          class="rounded-full border border-border px-3 py-1 text-base text-body-muted hover:border-orange-400 hover:text-orange-600 transition-colors"
        >
          {page.title}
        </a>
      ))}
    </div>

  </div>
</section>
