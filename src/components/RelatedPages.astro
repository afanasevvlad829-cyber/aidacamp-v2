---
/**
 * RelatedPages — блок внутренней перелинковки со ссылками на другие лендинги.
 *
 * Иконки — только Bootstrap Icons из subset'а в src/styles/icons.css.
 * Новая иконка = добавляй её определение в icons.css + в src/data/landing-pages.ts.
 *
 * Обратная совместимость: если у page есть поле `emoji`, оно не отображается
 * (эмодзи запрещены в UI по CLAUDE.md). Используй `icon` в формате "bi-house-heart".
 */
interface Props {
  title?: string;
  pages: Array<{
    title: string;
    description: string;
    url: string;
    /** Класс иконки: "bi-house-heart" (с префиксом) или "house-heart" (без — legacy). */
    icon?: string;
    /** @deprecated эмодзи в UI запрещены — см. CLAUDE.md. Поле игнорируется. */
    emoji?: string;
  }>;
}

const { title = "Подберите лагерь по интересам", pages } = Astro.props;

// Поддержка обеих форм: "bi-house-heart" и "house-heart"
const normalizeIcon = (icon: string | undefined) =>
  icon ? (icon.startsWith('bi-') ? icon : `bi-${icon}`) : '';
---

<section class="mx-auto max-w-[1312px] px-4 mt-8 mb-4">
  <div class="bg-surface rounded-[24px] p-[18px] md:p-8">

    <!-- Title with stripe -->
    <div class="flex items-center gap-2 mb-6">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[20px] md:text-[22px] font-bold text-body">
        {title}
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
      {pages.map((page) => (
        <a
          href={page.url}
          class="group flex flex-col rounded-[16px] border border-border-light bg-card p-4 transition hover:border-orange-200 hover:shadow-[0_2px_12px_rgba(249,115,22,0.08)]"
        >
          {normalizeIcon(page.icon) && (
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-orange-50">
              <i class={`bi ${normalizeIcon(page.icon)} text-[18px] text-orange-500`} aria-hidden="true"></i>
            </span>
          )}
          <span class="mt-2 text-[16px] font-semibold text-body leading-[1.3]">
            {page.title}
          </span>
          <span class="mt-1 text-[16px] text-body-muted leading-[1.4] flex-1">
            {page.description}
          </span>
          <span class="mt-3 text-[14px] font-medium text-orange-700 group-hover:translate-x-0.5 transition-transform">
            Подробнее &rarr;
          </span>
        </a>
      ))}
    </div>

  </div>
</section>
