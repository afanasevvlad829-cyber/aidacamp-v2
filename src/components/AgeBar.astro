---
import { PEER_COUNTS } from '../data/shifts';
// AgeBar.astro — плашка выбора возраста (снизу экрана)
// v3: scroll-triggered (25%), без таймера, мобилка + десктоп, вторичные страницы

const ageCountsJson = JSON.stringify({
  '7–9':   { 'shift-1': PEER_COUNTS['shift-1']['7–9'],  'shift-2': PEER_COUNTS['shift-2']['7–9']  },
  '10–12': { 'shift-1': PEER_COUNTS['shift-1']['10–12'], 'shift-2': PEER_COUNTS['shift-2']['10–12'] },
  '13–15': { 'shift-1': PEER_COUNTS['shift-1']['13–15'], 'shift-2': PEER_COUNTS['shift-2']['13–15'] },
});
---

<!-- Toast: статистика возраста (slide-in справа, auto-dismiss 2.5s) -->
<div
  id="age-stat-toast"
  aria-hidden="true"
  class="fixed right-4 bottom-24 z-[61] w-[192px]
         translate-x-[calc(100%+20px)] opacity-0 pointer-events-none
         transition-all duration-300 ease-out"
>
  <div class="bg-white/96 backdrop-blur-md rounded-2xl shadow-[0_8px_32px_rgba(15,23,42,0.14)] px-4 pt-3.5 pb-3 border border-slate-100/80">
    <!-- Мини-гистограмма -->
    <div class="flex items-end gap-2 mb-2.5" style="height:48px">
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="ast-bar-79"   class="w-full rounded-t-sm"  style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1)"></div>
        <span class="text-[9px] text-body-faint font-medium leading-none">7–9</span>
      </div>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="ast-bar-1012" class="w-full rounded-t-sm"  style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1) 0.08s"></div>
        <span class="text-[9px] text-body-faint font-medium leading-none">10–12</span>
      </div>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div id="ast-bar-1315" class="w-full rounded-t-sm"  style="background:#e2e8f0;height:0%;transition:height 0.45s cubic-bezier(.22,.61,.36,1) 0.16s"></div>
        <span class="text-[9px] text-body-faint font-medium leading-none">13–15</span>
      </div>
    </div>
    <p id="ast-pct"  class="text-[18px] font-bold text-body leading-none mb-0.5"></p>
    <p id="ast-text" class="text-[11px] text-body-faint leading-[1.3]"></p>
  </div>
</div>

<!-- Плашка выбора возраста — мобилка + десктоп, появляется при 25% скролла -->
<div
  id="age-bar"
  data-age-counts={ageCountsJson}
  class="fixed bottom-0 inset-x-0 z-[60]
         translate-y-full opacity-0 pointer-events-none
         transition-all duration-500 ease-out"
>
  <!-- Фаза 1: выбор возраста — светлая тема, согласована с сайтом -->
  <!-- data-bg-dismiss: клик по фону (мимо кнопок) = "Позже", устраняет dead clicks -->
  <div
    id="age-bar-phase1"
    data-bg-dismiss="true"
    class="bg-white/97 backdrop-blur-md border-t border-slate-200
           shadow-[0_-6px_24px_rgba(15,23,42,0.08)]"
  >
    <div class="mx-auto max-w-[640px] px-4 py-4">
      <p class="text-[14px] text-body-muted mb-2.5 font-medium">
        <span class="text-body font-semibold">Сколько лет ребёнку?</span> — покажем смену с ровесниками
      </p>
      <div class="flex items-center gap-2">
        <div class="flex gap-2 flex-1">
          <button
            data-age="7–9"
            class="age-btn flex-1 py-2.5 rounded-[10px]
                   text-[15px] font-semibold
                   text-body bg-white border border-slate-200
                   hover:border-primary hover:bg-[#fff8f2] hover:text-primary
                   transition-all active:scale-95"
          >7–9</button>
          <button
            data-age="10–12"
            class="age-btn flex-1 py-2.5 rounded-[10px]
                   text-[15px] font-semibold
                   text-body bg-white border border-slate-200
                   hover:border-primary hover:bg-[#fff8f2] hover:text-primary
                   transition-all active:scale-95"
          >10–12</button>
          <button
            data-age="13–15"
            class="age-btn flex-1 py-2.5 rounded-[10px]
                   text-[15px] font-semibold
                   text-body bg-white border border-slate-200
                   hover:border-primary hover:bg-[#fff8f2] hover:text-primary
                   transition-all active:scale-95"
          >13–15</button>
        </div>
        <button
          id="age-bar-close"
          class="shrink-0 text-body-faint hover:text-body-muted
                 transition-colors text-[13px] font-medium px-3 py-2
                 rounded-[8px] hover:bg-surface-alt"
        >Позже</button>
      </div>
    </div>
  </div>

  <!-- Фаза 2: рекомендации смен после выбора возраста -->
  <div
    id="age-bar-phase2"
    class="hidden bg-white/97 backdrop-blur-md border-t border-slate-200
           shadow-[0_-6px_24px_rgba(15,23,42,0.08)]"
  >
    <div class="mx-auto max-w-[640px] px-4 pt-3 pb-4">
      <!-- Заголовок -->
      <div class="flex items-center justify-between mb-2.5">
        <p class="text-[13px] font-semibold text-body-muted">Подходящие смены для вас</p>
        <!-- h-11 w-11 = 44px — минимальный тач-таргет, был h-7 w-7 = 28px (dead clicks) -->
        <button
          id="age-bar-nudge-close"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full text-body-faint hover:bg-surface-alt hover:text-body-muted transition-colors"
          aria-label="Закрыть"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Смена 1 — основная (primary) -->
      <a
        href="/shifts/shift-1/"
        data-age-shift-link="shift-1"
        class="flex items-center justify-between gap-3
               rounded-[12px] bg-[#fff8f2] border border-primary/30
               px-3.5 py-3 mb-2 active:scale-[0.98] transition-transform"
      >
        <div class="min-w-0">
          <p class="text-[14px] font-bold text-body leading-tight">
            Смена 1
            <span class="ml-1.5 text-[11px] font-semibold text-amber-700 bg-amber-100 rounded-full px-2 py-0.5">30 мая — 8 июня</span>
          </p>
          <!-- id для динамического обновления счётчика по возрасту -->
          <p id="ab-shift1-count" class="text-[12px] text-body-muted mt-0.5 leading-snug">
            <i class="bi bi-people-fill text-primary mr-1" aria-hidden="true"></i>уже едут ровесники
          </p>
        </div>
        <span class="shrink-0 text-[13px] font-bold text-primary whitespace-nowrap">74 900 ₽ →</span>
      </a>

      <!-- Смена 2 — альтернатива -->
      <a
        href="/shifts/shift-2/"
        data-age-shift-link="shift-2"
        class="flex items-center justify-between gap-3
               rounded-[12px] bg-surface border border-border
               px-3.5 py-2.5 mb-2.5 active:scale-[0.98] transition-transform"
      >
        <div class="min-w-0">
          <p class="text-[13px] font-semibold text-body leading-tight">
            Смена 2
            <span class="ml-1.5 text-[11px] font-medium text-body-faint">10 — 23 июня</span>
          </p>
          <!-- id для динамического обновления счётчика по возрасту -->
          <p id="ab-shift2-count" class="text-[12px] text-body-muted mt-0.5 leading-snug">
            <i class="bi bi-people-fill text-body-faint mr-1" aria-hidden="true"></i>уже едут ровесники
          </p>
        </div>
        <span class="shrink-0 text-[13px] font-semibold text-body-muted whitespace-nowrap">95 000 ₽ →</span>
      </a>

      <!-- Гарантия -->
      <p class="text-[11.5px] text-body-faint text-center leading-snug">
        <i class="bi bi-shield-check text-emerald-500 mr-1" aria-hidden="true"></i>Не понравится в первые 3 дня — вернём 50% без вопросов
      </p>
    </div>
  </div>
</div>

<style>
  /* Пульс кнопок возраста после 4 сек, если не выбрали */
  @keyframes age-btn-pulse {
    0%, 70%, 100% { box-shadow: 0 0 0 0 rgba(236,124,0,0); }
    85% { box-shadow: 0 0 0 4px rgba(236,124,0,0.15); }
  }
  #age-bar.age-bar-awaken .age-btn {
    animation: age-btn-pulse 2.2s ease-in-out infinite;
  }
  #age-bar.age-bar-awaken .age-btn:nth-child(2) { animation-delay: 0.15s; }
  #age-bar.age-bar-awaken .age-btn:nth-child(3) { animation-delay: 0.3s; }
</style>

<script>
  import { trackGoal } from '../scripts/analytics';
  import { STORAGE_KEYS } from '../lib/storage';

  // --- URL-параметр ?reset_age для тестирования (сбрасывает выбор без кнопки) ---
  if (new URLSearchParams(location.search).has('reset_age')) {
    sessionStorage.removeItem(STORAGE_KEYS.selectedAge);
    sessionStorage.removeItem(STORAGE_KEYS.ageBarDismissed);
    localStorage.removeItem(STORAGE_KEYS.userAgeGroup);
  }

  // AgeBar не нужен при загрузке (показывается при 45% скролла / через 25s)
  // Откладываем init до idle чтобы не блокировать LCP main thread
  const _initAgeBar = () => {

  // --- Age stat toast ---
  const AGE_STAT: Record<string, { pct: number; h: [number,number,number]; text: string }> = {
    '7–9':   { pct: 26, h: [100, 62, 76], text: 'Едут самые активные исследователи' },
    '10–12': { pct: 42, h: [62, 100, 76], text: 'Самый популярный возраст' },
    '13–15': { pct: 32, h: [62, 76, 100], text: 'Подросткам здесь особенно интересно' },
  };
  const ACCENT = 'rgb(236, 155, 68)'; // = var(--color-primary)
  const MUTED  = '#e2e8f0';

  const ageToast   = document.getElementById('age-stat-toast');
  const astPct     = document.getElementById('ast-pct');
  const astText    = document.getElementById('ast-text');
  const astBars    = [
    document.getElementById('ast-bar-79'),
    document.getElementById('ast-bar-1012'),
    document.getElementById('ast-bar-1315'),
  ];
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  function showAgeToast(age: string) {
    const d = AGE_STAT[age];
    if (!d || !ageToast) return;
    const idx = age === '7–9' ? 0 : age === '10–12' ? 1 : 2;
    if (astPct)  astPct.textContent  = `${d.pct}%`;
    if (astText) astText.textContent = d.text;
    // Сбросить высоты и цвета баров до 0
    astBars.forEach((b, i) => {
      if (!b) return;
      b.style.height     = '0%';
      b.style.background = i === idx ? ACCENT : MUTED;
    });
    // Показать тост (slide in)
    ageToast.classList.remove('translate-x-[calc(100%+20px)]', 'opacity-0');
    ageToast.classList.add('translate-x-0', 'opacity-100');
    ageToast.removeAttribute('aria-hidden');
    // Анимировать бары (через два тика чтобы CSS transition сработал)
    requestAnimationFrame(() => requestAnimationFrame(() => {
      astBars.forEach((b, i) => { if (b) b.style.height = `${d.h[i]}%`; });
    }));
    // Auto-dismiss 2.5s
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      ageToast.classList.add('translate-x-[calc(100%+20px)]', 'opacity-0');
      ageToast.classList.remove('translate-x-0', 'opacity-100');
      ageToast.setAttribute('aria-hidden', 'true');
    }, 2500);
  }

  const bar       = document.getElementById('age-bar');
  const AGE_COUNTS = JSON.parse(bar?.dataset.ageCounts || '{}');
  const phase1    = document.getElementById('age-bar-phase1');
  const phase2    = document.getElementById('age-bar-phase2');
  const closeBtn  = document.getElementById('age-bar-close');
  const nudgeClose= document.getElementById('age-bar-nudge-close');
  const ageBtns   = document.querySelectorAll('.age-btn');

  function isDismissed() {
    // Сессия (мгновенный dismiss) ИЛИ localStorage с TTL 7 дней
    if (sessionStorage.getItem(STORAGE_KEYS.ageBarDismissed)) return true;
    const longTerm = localStorage.getItem(STORAGE_KEYS.ageBarDismissed);
    if (!longTerm) return false;
    const ts = parseInt(longTerm, 10);
    if (isNaN(ts)) return false;
    const sevenDays = 7 * 24 * 60 * 60 * 1000;
    if (Date.now() - ts > sevenDays) {
      localStorage.removeItem(STORAGE_KEYS.ageBarDismissed); // expired
      return false;
    }
    return true;
  }

  let awakenTimer = null;

  // Единый source of truth для «выбран ли возраст в текущей сессии» — sessionStorage.
  // localStorage (userAgeGroup) остаётся только для персонализации между визитами, но НЕ
  // используется как триггер «уже выбрал» (Fix 2026-04-20 — синхронизация
  // AgeBar ↔ ShiftModal ↔ Shifts.peer-count).
  function currentAge() {
    return sessionStorage.getItem(STORAGE_KEYS.selectedAge);
  }

  function showBar() {
    if (isDismissed()) return;

    // Не показываем AgeBar если StickyCta (мобильная полоска) уже видна — взаимное исключение
    const stickyBar = document.getElementById('sticky-bar');
    if (stickyBar && !stickyBar.classList.contains('translate-y-full') && !stickyBar.hasAttribute('inert')) return;

    const selectedAge = currentAge();
    if (selectedAge && AGE_COUNTS[selectedAge]) {
      // Возраст уже выбран в сессии → сразу показываем нудж (фаза 2)
      showNudge(selectedAge);
    }
    // В любом случае показываем плашку
    bar?.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
    bar?.classList.add('translate-y-0', 'opacity-100');

    // Через 4 сек — лёгкая пульсация кнопок, если ещё не выбрали
    if (!selectedAge) {
      clearTimeout(awakenTimer);
      awakenTimer = setTimeout(() => {
        if (!currentAge() && !isDismissed()) {
          bar?.classList.add('age-bar-awaken');
        }
      }, 8000);
    }
  }

  // Синхронизация: если возраст выбран в другом месте (ShiftModal) —
  // AgeBar тоже переключается в nudge-фазу без перезагрузки.
  document.addEventListener('age-personalize', (e) => {
    const age = e.detail?.age;
    if (!age || !AGE_COUNTS[age]) return;
    if (isDismissed()) return;
    bar?.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
    bar?.classList.add('translate-y-0', 'opacity-100', 'age-bar-awaken');
    showNudge(age);
  });

  function hideBar() {
    bar?.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    bar?.classList.remove('translate-y-0', 'opacity-100', 'age-bar-awaken');
    sessionStorage.setItem(STORAGE_KEYS.ageBarDismissed, '1');
    // Долгосрочный dismiss на 7 дней (если user явно закрыл)
    localStorage.setItem(STORAGE_KEYS.ageBarDismissed, String(Date.now()));
    clearTimeout(awakenTimer);
  }

  function showNudge(age?: string) {
    phase1?.classList.add('hidden');
    phase2?.classList.remove('hidden');
    // Обновляем счётчики ровесников по выбранному возрасту (были захардкожены — dead clicks)
    if (age && AGE_COUNTS[age]) {
      const c1 = AGE_COUNTS[age]['shift-1'] ?? 0;
      const c2 = AGE_COUNTS[age]['shift-2'] ?? 0;
      const s1 = document.getElementById('ab-shift1-count');
      const s2 = document.getElementById('ab-shift2-count');
      if (s1) s1.innerHTML = `<i class="bi bi-people-fill text-primary mr-1" aria-hidden="true"></i>${c1} ребят вашего возраста уже едут`;
      if (s2) s2.innerHTML = `<i class="bi bi-people-fill text-body-faint mr-1" aria-hidden="true"></i>${c2} ребят вашего возраста уже едут`;
    }
  }

  // Триггер: 25% скролла (без таймера)
  function onScroll() {
    const scrolled = window.scrollY;
    const total = document.documentElement.scrollHeight - (window.visualViewport?.height ?? window.innerHeight);
    if (total > 0 && scrolled / total >= 0.45) {
      showBar();
      window.removeEventListener('scroll', onScroll);
    }
  }

  if (!isDismissed()) {
    window.addEventListener('scroll', onScroll, { passive: true });
    // Триггер по таймеру: 10 сек, если не доскроллили до 25%
    setTimeout(() => {
      if (!isDismissed()) {
        showBar();
        window.removeEventListener('scroll', onScroll);
      }
    }, 25000);
  }

  closeBtn?.addEventListener('click', hideBar);
  nudgeClose?.addEventListener('click', hideBar);

  // Клик по фону Phase 1 (мимо кнопок) → Позже. Устраняет dead clicks на белой подложке.
  phase1?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('button')) hideBar();
  });

  ageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const age = btn.dataset.age || '10–12';

      // Убрать пульс после выбора
      bar?.classList.remove('age-bar-awaken');
      clearTimeout(awakenTimer);

      // Аналитика
      trackGoal('age_select', { age: age });

      // Сохраняем возраст
      sessionStorage.setItem(STORAGE_KEYS.selectedAge, age);
      localStorage.setItem(STORAGE_KEYS.userAgeGroup, age);

      // Персонализация страницы
      document.dispatchEvent(new CustomEvent('age-personalize', { detail: { age } }));

      // Тост со статистикой возраста
      showAgeToast(age);

      // Показываем нудж
      showNudge(age);
    });
  });

  // Клик по карточке смены → трекинг + переход
  document.querySelectorAll<HTMLAnchorElement>('[data-age-shift-link]').forEach((link) => {
    link.addEventListener('click', () => {
      const shiftId = link.dataset.ageShiftLink || '';
      trackGoal('age_bar_shift_click', { shift: shiftId });
      trackGoal('check_places');
    });
  });


  // Скрываем AgeBar когда ShiftModal открыт
  document.addEventListener('shift-modal-open', () => {
    bar?.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    bar?.classList.remove('translate-y-0', 'opacity-100');
  });

  // Восстанавливаем AgeBar когда ShiftModal закрыт (если не был закрыт пользователем)
  const shiftModalEl = document.getElementById('shift-modal');
  if (shiftModalEl) {
    const observer = new MutationObserver(() => {
      const isClosed = shiftModalEl.classList.contains('hidden');
      if (isClosed && !isDismissed()) {
        const wasVisible = bar?.classList.contains('translate-y-0');
        // Восстановить только если был показан до открытия ShiftModal
        if (!wasVisible) {
          bar?.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar?.classList.add('translate-y-0', 'opacity-100');
        }
      }
    });
    observer.observe(shiftModalEl, { attributes: true, attributeFilter: ['class'] });
  }
  }; // end _initAgeBar

  if ('requestIdleCallback' in window) {
    requestIdleCallback(_initAgeBar, { timeout: 2000 });
  } else {
    setTimeout(_initAgeBar, 200);
  }
</script>
