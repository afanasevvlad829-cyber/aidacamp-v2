---
/**
 * BackToTop — ненавязчивая кнопка прокрутки наверх
 * Появляется после scroll > 800px, sticky right-bottom
 * Дизайн-система Section 21
 */
---

<button
  type="button"
  id="back-to-top-btn"
  aria-label="Прокрутить страницу вверх"
  class="fixed bottom-[160px] right-[26px] md:bottom-[144px] z-[65] hidden h-11 w-11 items-center justify-center text-slate-400 hover:text-primary transition-colors duration-200"
  data-analytics-goal="back_to_top_click"
>
  <i class="bi bi-chevron-up text-[22px]" aria-hidden="true" style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.18));"></i>
</button>

<script is:inline>
(function () {
  var btn = document.getElementById('back-to-top-btn');
  if (!btn) return;

  function onScroll() {
    if (window.scrollY > 800) {
      btn.classList.remove('hidden');
      btn.classList.add('flex');
    } else {
      btn.classList.add('hidden');
      btn.classList.remove('flex');
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  btn.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    if (window.trackGoal) window.trackGoal('back_to_top_click');
  });
})();
</script>
