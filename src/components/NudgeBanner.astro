---
import { Icon } from 'astro-icon/components';
import { mainShifts, shortShifts } from '../data/shifts';

/**
 * NudgeBanner — догрев-плашка для повторщиков (2-й+ заход на сайт).
 * Нижняя плашка, A/B(/C) поровну (фиксируется за посетителем в localStorage: ac:nudge_ab):
 *   A (отзывы)  → /kak-proshla-smena-2/  «Что пишут родители после смен»
 *   B (ТВ)      → /tv/                   «Наш директор — на федеральном ТВ»
 *   C (дефицит) → /shifts/<id>/          «Смена N — осталось K мест» — ТОЛЬКО если
 *     есть реально дефицитная смена (занятость ≥85%, добавлено 04.07.2026).
 *     Цифра и ссылка вычисляются из shifts.ts на каждой сборке — не хардкод.
 *     Если дефицитных смен нет — вариант C не показываем (не изображаем то, чего нет).
 * События в Метрику 96499295: nudge_shown / nudge_click с параметром variant.
 * Другие страницы: 1 раз за сессию, через 8 сек, начиная со 2-го захода.
 * Главная: корпоративная плашка через 20 сек при прокрутке или открытии смены.
 */
function freeLabel(free: number) {
  if (free === 1) return '1 место';
  if (free < 5) return `${free} места`;
  return `${free} мест`;
}

// Вариант C временно СКРЫТ по решению владельца (05.07.2026): число мест теперь
// везде под блюром/кликом, отдельная плашка с открытым числом — лишний канал
// утечки той же информации. Код оставлен (не удалён) — вернуть = SHOW_SCARCITY_ARM=true.
const SHOW_SCARCITY_ARM = false;
const scarceShift = SHOW_SCARCITY_ARM
  ? [...mainShifts, ...shortShifts]
      .filter((s) => s.free > 0 && Math.round((s.occupied / (s.free + s.occupied)) * 100) >= 85)
      .sort((a, b) => a.free - b.free)[0]
  : undefined;

const ARMS: Record<string, { icon: string; text: string; cta: string; href: string }> = {
  A: { icon: 'bi-camera-reels', text: 'Что пишут родители после смен', cta: 'Посмотреть', href: '/kak-proshla-smena-1/' },
  B: { icon: 'bi-tv',           text: 'Наш директор — на федеральном ТВ, ОТР', cta: 'Смотреть', href: '/tv/' },
};
if (scarceShift) {
  ARMS.C = {
    icon: 'bi-people-fill',
    text: `${scarceShift.name} — осталось ${freeLabel(scarceShift.free)}`,
    cta: 'Забронировать',
    href: `/shifts/${scarceShift.id}/`,
  };
}
// На главной используем эту же плашку для корпоративного предложения.
const isCorporate = Astro.url.pathname === '/';
ARMS.CORPORATE = {
  icon: 'bi-people-fill',
  text: 'Работаете в крупной компании? Возможно, вам доступна компенсация части стоимости путёвки. Проверьте компанию и уточните условия у HR.',
  cta: 'Проверить компанию',
  href: '/korporativnye-lgoty/',
};
const armsJson = JSON.stringify(isCorporate ? { CORPORATE: ARMS.CORPORATE } : Object.fromEntries(Object.entries(ARMS).filter(([key]) => key !== 'CORPORATE')));
---

<div
  id="nudge-banner"
  class="hidden fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-400 ease-out"
  aria-live="polite"
  role="status"
>
  <div class="bg-slate-900 border-t border-slate-700 px-4 py-3 md:py-3.5 shadow-[0_-4px_24px_rgba(0,0,0,0.18)]">
    <div class="mx-auto max-w-2xl flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center sm:gap-4">
      <div class="flex items-center gap-3 min-w-0">
        {/* legacy <i>: JS ниже меняет className на другую иконку — рисуется через icons-js.css */}
        <i id="nudge-icon" class="bi bi-camera-reels text-orange-400 text-[18px] shrink-0" aria-hidden="true"></i>
        <p id="nudge-text" class="text-base text-white/90 leading-[1.4] min-w-0"></p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a id="nudge-cta" href="#"
          class="inline-flex items-center gap-1.5 rounded-lg bg-primary hover:bg-orange-400 px-3.5 py-1.5 text-base font-semibold text-white transition-colors whitespace-nowrap no-underline">
          <span id="nudge-cta-text">Посмотреть</span>
          <Icon name="bi:arrow-right" class="bi bi-arrow-right text-[11px]" aria-hidden="true" />
        </a>
        <button id="nudge-close" type="button"
          class="inline-flex h-7 w-7 items-center justify-center rounded-full text-white/50 hover:text-white/90 hover:bg-white/10 transition-colors"
          aria-label="Закрыть">
          <Icon name="bi:x-lg" class="bi bi-x-lg text-base" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ armsJson, isCorporate }}>
  const ARMS = JSON.parse(armsJson);
  const SESSION_FLAG = 'ac:session_active';
  const SHOWN_FLAG = 'ac:nudge_shown';    // показано в этой сессии
  const CLOSED_FLAG = 'ac:nudge_closed';  // закрыто в этой сессии

  function pickArm() {
    const keys = Object.keys(ARMS);
    let arm = localStorage.getItem('ac:nudge_ab');
    if (!keys.includes(arm)) {
      arm = keys[Math.floor(Math.random() * keys.length)];
      try { localStorage.setItem('ac:nudge_ab', arm); } catch {}
    }
    return arm;
  }

  // Счётчик визитов: +1 на каждую новую сессию (sessionStorage гейт)
  function countVisit() {
    let visits = parseInt(localStorage.getItem('ac:visits') || '0', 10) || 0;
    if (!sessionStorage.getItem(SESSION_FLAG)) {
      try { sessionStorage.setItem(SESSION_FLAG, '1'); } catch {}
      visits += 1;
      try { localStorage.setItem('ac:visits', String(visits)); } catch {}
    }
    return visits;
  }

  function initNudge() {
    if (sessionStorage.getItem(SHOWN_FLAG) || sessionStorage.getItem(CLOSED_FLAG)) return;
    const visits = countVisit();
    if (!isCorporate && visits < 2) return;  // только повторщик (2-й заход и далее)

    const arm = isCorporate ? 'CORPORATE' : pickArm();
    const a = ARMS[arm];
    const banner = document.getElementById('nudge-banner');
    const iconEl = document.getElementById('nudge-icon');
    const textEl = document.getElementById('nudge-text');
    const cta = document.getElementById('nudge-cta');
    const ctaText = document.getElementById('nudge-cta-text');
    const closeBtn = document.getElementById('nudge-close');
    if (!banner || !textEl || !cta || banner.dataset.initialized) return;
    banner.dataset.initialized = 'true';

    if (iconEl) iconEl.className = `bi ${a.icon} text-orange-400 text-[18px] shrink-0`;
    textEl.textContent = a.text;
    cta.setAttribute('href', a.href);
    if (ctaText) ctaText.textContent = a.cta;

    cta.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('ac:nudge-goal', { detail: { goal: 'nudge_click', params: { variant: arm, placement: isCorporate ? 'corporate_popup' : 'returning_popup' } } }));
    });
    closeBtn?.addEventListener('click', () => {
      try { sessionStorage.setItem(CLOSED_FLAG, '1'); } catch {}
      banner.classList.remove('translate-y-0');
      banner.classList.add('translate-y-full');
      setTimeout(() => banner.classList.add('hidden'), 400);
    });

    let interested = window.scrollY >= 160;
    if (isCorporate) {
      window.addEventListener('scroll', () => { if (window.scrollY >= 160) interested = true; }, { passive: true });
      document.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('[data-shift-link]')) interested = true;
      });
    }
    function showWhenReady() {
      const openDialog = [...document.querySelectorAll('[role="dialog"], #shift-modal')].some(el => {
        const style = getComputedStyle(el);
        return style.opacity !== '0' && style.display !== 'none' && style.visibility !== 'hidden' && el.getAttribute('aria-hidden') !== 'true';
      });
      if (openDialog) interested = true;
      const cookieBanner = document.getElementById('cookieBanner');
      const cookieVisible = cookieBanner && getComputedStyle(cookieBanner).display !== 'none';
      if (isCorporate && (!interested || document.hidden || openDialog || cookieVisible)) {
        setTimeout(showWhenReady, 5000);
        return;
      }
      try { sessionStorage.setItem(SHOWN_FLAG, '1'); } catch {}
      banner.classList.remove('hidden');
      requestAnimationFrame(() => {
        banner.classList.remove('translate-y-full');
        banner.classList.add('translate-y-0');
      });
      document.dispatchEvent(new CustomEvent('ac:nudge-goal', { detail: { goal: 'nudge_shown', params: { variant: arm, placement: isCorporate ? 'corporate_popup' : 'returning_popup' } } }));
    }
    setTimeout(showWhenReady, isCorporate ? 20000 : 8000);
  }

  document.addEventListener('astro:page-load', initNudge);
  document.addEventListener('DOMContentLoaded', initNudge, { once: true });
  if (document.readyState !== 'loading') initNudge();
</script>

<script>
  import { trackGoal } from '../scripts/analytics';
  document.addEventListener('ac:nudge-goal', event => {
    const { goal, params } = (event as CustomEvent<{ goal: string; params: Record<string, string> }>).detail;
    trackGoal(goal, params);
  });
</script>
