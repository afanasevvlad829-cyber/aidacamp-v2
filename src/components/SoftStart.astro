---
import TaxWidget from './TaxWidget.astro';
---

<section class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4 md:pt-8">
  <div class="bg-white px-[18px] py-8 md:py-10">
    <div class="mx-auto grid max-w-[1200px] items-center gap-8 md:grid-cols-[1fr_360px] md:gap-10">

      <!-- Left: текст + 3 иконки-features -->
      <div class="text-center md:text-left">

        <p class="text-[13px] font-semibold uppercase tracking-[0.1em] text-orange-500">Мягкий вход в IT</p>

        <h2 class="mt-3 text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900 md:text-[30px]">
          Опыт программирования не&nbsp;нужен.
        </h2>

        <p class="mt-3 text-[16px] leading-[1.65] text-slate-500 md:text-[17px]">
          Каждый сам выберет глубину — попробует и поймёт.<br class="hidden md:block" />
          Не понравится за первые 3 дня — вернём 50%.
        </p>

        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-6 md:justify-start">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#fff2e3]">
              <i class="bi bi-lightbulb text-orange-500 text-[16px]" aria-hidden="true"></i>
            </span>
            <span class="text-[15px] text-slate-700">Берём с нуля</span>
          </div>
          <div class="hidden h-4 w-px bg-slate-200 sm:block"></div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#fff2e3]">
              <i class="bi bi-person-fill text-orange-500 text-[16px]" aria-hidden="true"></i>
            </span>
            <span class="text-[15px] text-slate-700">Группы по возрасту и уровню</span>
          </div>
          <div class="hidden h-4 w-px bg-slate-200 sm:block"></div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#fff2e3]">
              <i class="bi bi-check-circle-fill text-orange-500 text-[16px]" aria-hidden="true"></i>
            </span>
            <span class="text-[15px] text-slate-700">Возврат 50% за первые 3 дня</span>
          </div>
        </div>

      </div>

      <!-- Right: виджет налогового вычета -->
      <aside class="w-full">
        <TaxWidget variant="card" />
      </aside>

    </div>
  </div>
</section>
