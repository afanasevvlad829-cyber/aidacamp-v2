---
/**
 * AnimatedStat — большая цифра, считается от 0 при появлении в viewport.
 * Один раз, easeOut, 1.4 сек.
 */
interface Props {
  value: string;        // числовая часть: "95", "40", "375", "2.5"
  unit?: string;        // суффикс: "%", "B", "млн", " лет"
  prefix?: string;      // префикс: "$", "+"
  label: string;        // подпись под числом
  source?: string;      // источник (мелкий текст)
  tone?: 'orange' | 'red' | 'blue' | 'green' | 'slate' | 'purple';
  size?: 'lg' | 'xl';   // xl = 80px, lg = 56px
}

const {
  value,
  unit = '',
  prefix = '',
  label,
  source,
  tone = 'orange',
  size = 'xl',
} = Astro.props;

const id = `astat-${Math.random().toString(36).slice(2, 9)}`;

const tones = {
  orange: { bg: '#FFF7F0', border: '#FFD8B8', text: '#C94B00', track: '#FFD8B8' },
  red:    { bg: '#FFF1F1', border: '#FECACA', text: '#B91C1C', track: '#FECACA' },
  blue:   { bg: '#EFF6FF', border: '#BFDBFE', text: '#1D4ED8', track: '#BFDBFE' },
  green:  { bg: '#F0FDF4', border: '#BBF7D0', text: '#15803D', track: '#BBF7D0' },
  slate:  { bg: '#F8FAFC', border: '#E2E8F0', text: '#374151', track: '#E2E8F0' },
  purple: { bg: '#FAF5FF', border: '#DDD6FE', text: '#6D28D9', track: '#DDD6FE' },
};

const c = tones[tone] ?? tones.orange;
const fontSize = size === 'xl' ? '72px' : '52px';
const mdFontSize = size === 'xl' ? '96px' : '68px';
---

<div
  class="__astat my-5 rounded-[20px] px-6 py-7 text-center"
  style={`background: ${c.bg}; border: 1.5px solid ${c.border};`}
>
  <div
    id={id}
    class="font-black leading-none tabular-nums"
    style={`color: ${c.text}; font-size: ${fontSize};`}
    data-prefix={prefix}
    data-unit={unit}
    data-target={value}
  >
    {prefix}0{unit}
  </div>
  <p class="mt-3 text-[15px] leading-[1.5] text-body-muted max-w-[280px] mx-auto">{label}</p>
  {source && <p class="mt-2 text-[11px] text-body-faint font-mono tracking-wide">{source}</p>}
</div>

<style>
  @media (min-width: 768px) {
    .__astat .font-black {
      /* md override applied via JS below */
    }
  }
</style>

<script>
(function () {
  if (typeof window === 'undefined') return;

  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  function animateStat(el: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const raw = el.dataset.target ?? '0';
      const prefix = el.dataset.prefix ?? '';
      const unit = el.dataset.unit ?? '';
      el.textContent = prefix + raw + unit;
      return;
    }
    const raw = el.dataset.target ?? '0';
    const prefix = el.dataset.prefix ?? '';
    const unit = el.dataset.unit ?? '';
    const isFloat = raw.includes('.');
    const target = parseFloat(raw);
    const duration = 1400;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const current = easeOut(progress) * target;
      const display = isFloat ? current.toFixed(1) : Math.round(current).toString();
      el.textContent = prefix + display + unit;
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = prefix + raw + unit;
    }
    requestAnimationFrame(tick);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateStat(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.4 }
  );

  document.querySelectorAll<HTMLElement>('[id^="astat-"]').forEach((el) => {
    observer.observe(el);
  });
})();
</script>
