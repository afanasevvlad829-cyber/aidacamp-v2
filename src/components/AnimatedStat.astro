---
/**
 * AnimatedStat — большая цифра, считается от 0 при появлении в viewport.
 * Один раз, easeOut, 1.4 сек.
 */
import { stableId } from '../lib/deterministic';
interface Props {
  value: string;        // числовая часть: "95", "40", "375", "2.5"
  unit?: string;        // суффикс: "%", "B", "млн", " лет"
  prefix?: string;      // префикс: "$", "+"
  label: string;        // подпись под числом
  source?: string;      // источник (мелкий текст)
  tone?: 'orange' | 'red' | 'blue' | 'green' | 'slate' | 'purple';
  size?: 'lg' | 'xl';   // xl = 80px, lg = 56px
}

const {
  value,
  unit = '',
  prefix = '',
  label,
  source,
  tone = 'orange',
  size = 'xl',
} = Astro.props;

// Детерминированный id вместо Math.random(): тот делал сборку невоспроизводимой —
// страница получала новый HTML на каждом билде, из-за чего rsync гнал её заново,
// а кэш минификации промахивался (см. src/lib/deterministic.ts).
// Уникальность здесь не нужна: скрипт ниже ищет элементы по префиксу
// `[id^="astat-"]`, а не по конкретному id.
const id = stableId('astat', `${value}|${unit}|${prefix}|${label}|${tone}|${size}`);

const tones = {
  orange: { bg: '#FFF7F0', border: '#FFD8B8', text: '#C94B00', track: '#FFD8B8' },
  red:    { bg: '#FFF1F1', border: '#FECACA', text: '#B91C1C', track: '#FECACA' },
  blue:   { bg: '#EFF6FF', border: '#BFDBFE', text: '#1D4ED8', track: '#BFDBFE' },
  green:  { bg: '#F0FDF4', border: '#BBF7D0', text: '#15803D', track: '#BBF7D0' },
  slate:  { bg: '#F8FAFC', border: '#E2E8F0', text: '#374151', track: '#E2E8F0' },
  purple: { bg: '#FAF5FF', border: '#DDD6FE', text: '#6D28D9', track: '#DDD6FE' },
};

const c = tones[tone] ?? tones.orange;
const maxFontSize = size === 'xl' ? 72 : 52;

/*
 * Автоподгон размера цифры под ширину карточки.
 * Карточка — container (cqi), поэтому размер считается от её реальной ширины,
 * а не от вьюпорта: одинаково работает и в колонке grid, и на всю ширину.
 * Ширина строки в em ≈ (символы числа × 0.68) + (символы юнита × 0.68 × UNIT_EM),
 * 0.68 — замеренная ширина цифры font-black tabular-nums плюс небольшой запас.
 * 100cqi — уже content-box контейнера (паддинги px-6 исключены), 0.5rem — запас.
 *
 * Словесный юнит (« млрд $», « млн», «+ мес») рендерится вдвое мельче: иначе он
 * съедает всё место и цифра ужимается до нечитаемой. Знаковые юниты («%», «+»,
 * «:15») остаются в размер цифры — они часть самого числа.
 */
const isWordUnit = /\s/.test(unit) || /^\p{L}{2,}$/u.test(unit);
const UNIT_EM = isWordUnit ? 0.5 : 1;
const numChars = `${prefix}${value}`.length;
const lineEm = (numChars * 0.68 + unit.length * 0.68 * UNIT_EM).toFixed(2);
const fontSize = `min(${maxFontSize}px, calc((100cqi - 0.5rem) / ${lineEm}))`;
---

<div
  class="__astat my-5 rounded-[20px] px-6 py-7 text-center"
  style={`background: ${c.bg}; border: 1.5px solid ${c.border};`}
  data-rss-strip
>
  <div
    id={id}
    class="__astat-num font-black leading-none tabular-nums"
    style={`color: ${c.text}; font-size: ${fontSize};`}
    data-prefix={prefix}
    data-unit={unit}
    data-target={value}
  >
    <span data-num>{prefix}0</span>{unit && <span style={`font-size: ${UNIT_EM}em`}>{unit}</span>}
  </div>
  <p class="mt-3 text-base leading-[1.5] text-body-muted max-w-[280px] mx-auto">{label}</p>
  {source && <p class="mt-2 text-[11px] text-body-faint font-mono tracking-wide">{source}</p>}
</div>

<style>
  .__astat {
    /* база для cqi: размер цифры считается от ширины карточки */
    container-type: inline-size;
  }
  .__astat-num {
    /* юнит не переносится на новую строку — иначе карточка «разъезжается» */
    white-space: nowrap;
  }
</style>

<script>
  import { initAnimateOnScroll } from '../scripts/animateOnScroll';
  initAnimateOnScroll('[id^="astat-"]');
</script>
