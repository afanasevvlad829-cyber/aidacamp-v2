---
import UppyUploader from '../UppyUploader.astro';

interface Props {
  summaryEventId: number | string;
  photos: { file_url: string | null; file_type: string; caption: string | null }[];
}
const { summaryEventId, photos } = Astro.props;
---
<section class="den-summary" data-summary-event={summaryEventId}>
  <h3>📦 Материалы дня</h3>
  <p class="den-summary-hint">Общие фото и видео за день — не привязанные к конкретной активности. Загружайте сюда итог дня.</p>

  {photos.length > 0 && (
    <div class="den-gallery">
      {photos.map((ph) => (
        <a href={ph.file_url ?? '#'} target="_blank" class="den-thumb">
          {ph.file_type === 'video'
            ? <span class="den-thumb-vid"><i class="bi bi-play-circle"></i></span>
            : <img src={ph.file_url ?? ''} alt={ph.caption ?? ''} loading="lazy">}
        </a>
      ))}
    </div>
  )}
  {photos.length === 0 && <p class="den-summary-empty">Пока ничего не загружено.</p>}

  {summaryEventId
    ? <UppyUploader eventId={summaryEventId} accept="image/*,video/*" note="Фото и видео за день — перетащи или выбери" />
    : <p class="den-summary-empty">Сначала выберите день, чтобы загружать материалы.</p>}
</section>
