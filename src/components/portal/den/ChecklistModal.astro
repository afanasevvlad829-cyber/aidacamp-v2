---
// Модалка создания/редактирования чек-листа. Управляется из den.ts.
---
<div class="cl-modal" id="cl-modal" hidden>
  <div class="cl-modal-box">
    <div class="cl-modal-head">
      <h3>Новый чек-лист</h3>
      <button type="button" class="cl-modal-x" id="cl-close">✕</button>
    </div>
    <label class="den-field">
      <span>Название</span>
      <input type="text" id="cl-title" placeholder="Напр. Сборы на бассейн">
    </label>
    <div class="cl-items-label">Пункты</div>
    <div id="cl-items"></div>
    <button type="button" class="den-mini ghost" id="cl-add-item">+ Добавить пункт</button>
    <div class="cl-modal-foot">
      <button type="button" class="den-save" id="cl-create">Создать и привязать</button>
      <span class="den-status" id="cl-status"></span>
    </div>
  </div>
</div>
