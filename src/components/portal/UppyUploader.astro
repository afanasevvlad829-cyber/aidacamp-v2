---
/**
 * Полноценный Uppy-загрузчик с собственным picker'ом (Dashboard, compact-mode).
 *
 * Заменяет любые наши предыдущие реализации. UI:
 *  - одна большая кнопка «выбрать файл»
 *  - JS-инициированный диалог Uppy: «Камера / Из библиотеки / Файл»
 *  - прогресс-бар, отмена, retry, offline-восстановление
 *
 * Совместимость: после успешной загрузки диспатчит portal-media:uploaded и
 * portal-media:refresh с тем же payload что раньше — listener'ы в smena/rooms
 * продолжают работать.
 */
interface Props {
  eventId: number | string;
  contentTaskId?: string | number | null;
  id?: string | null;
  /** MIME-фильтры. По умолчанию любые. */
  accept?: string;
  /** Подсказка в drag-зоне. */
  note?: string;
}
const {
  eventId,
  contentTaskId = '',
  id = null,
  accept = 'image/*,video/*',
  note = 'Камера, библиотека или файл — выбор в окне Uppy',
} = Astro.props;

// Уникальный id корня — нужен и для адресации portal-media:uploaded,
// и для крепления Dashboard к контейнеру.
const rootId = id ?? `uppy-${Math.random().toString(36).slice(2)}`;
---
<div class="uppy-uploader portal-uploader mt-3"
     id={rootId}
     data-event-id={String(eventId)}
     data-content-task-id={contentTaskId == null ? '' : String(contentTaskId)}
     data-accept={accept}
     data-note={note}>
  <div class="uppy-uploader__mount"></div>
  <p class="uppy-uploader__status mt-2 text-base text-body-muted hidden" aria-live="polite"></p>
</div>

<script>
  import Uppy from '@uppy/core';
  import Dashboard from '@uppy/dashboard';
  import XHRUpload from '@uppy/xhr-upload';
  import GoldenRetriever from '@uppy/golden-retriever';
  import '@uppy/core/css/style.min.css';
  import '@uppy/dashboard/css/style.min.css';
  import { UPPY_LOCALE_STRINGS, buildUppyRestrictions, UPPY_DASHBOARD_BASE, UPPY_XHR_BASE, attachGoldenRetriever, formatUploadError } from '../../scripts/portal/uppyShared';

  const initialised = new WeakSet<HTMLElement>();

  function showStatus(el: HTMLElement | null, text: string, isError = false) {
    if (!el) return;
    el.textContent = text;
    el.classList.remove('hidden');
    el.classList.toggle('text-red-600', isError);
    el.classList.toggle('text-body-muted', !isError);
  }

  function attachOne(root: HTMLElement) {
    if (initialised.has(root)) return;
    initialised.add(root);

    const mount = root.querySelector<HTMLElement>('.uppy-uploader__mount');
    const status = root.querySelector<HTMLParagraphElement>('.uppy-uploader__status');
    if (!mount) return;

    const eventId = root.dataset.eventId || '';
    const ctId = root.dataset.contentTaskId || '';
    const uploaderId = root.id || '';
    const accept = root.dataset.accept || 'image/*,video/*';
    const note = root.dataset.note || '';
    const toast = (window as any).toast;

    const uppy = new Uppy({
      id: 'uppy-' + uploaderId,
      autoProceed: true,
      restrictions: buildUppyRestrictions(accept, 5),
    });

    uppy.use(Dashboard, {
      target: mount,
      ...UPPY_DASHBOARD_BASE,
      height: 240,
      note,
      locale: { strings: UPPY_LOCALE_STRINGS },
    });

    uppy.use(XHRUpload, {
      endpoint: '/api/portal/photo',
      ...UPPY_XHR_BASE,
    });
    uppy.setMeta({ event_id: eventId, content_task_id: ctId });

    attachGoldenRetriever(uppy, GoldenRetriever);

    uppy.on('upload-success', (_file, response) => {
      const body = (response as any)?.body ?? {};
      const photoId = body?.id ?? null;
      const fileUrl = body?.file_url ?? null;
      showStatus(status, '✓ Загружено');
      if (toast) toast.success(`Загружено${photoId ? ' · id=' + photoId : ''}`);
      document.dispatchEvent(new CustomEvent('portal-media:refresh', { detail: { eventId } }));
      document.dispatchEvent(new CustomEvent('portal-media:uploaded', {
        detail: { eventId, photoId, fileUrl, uploaderId },
      }));
    });

    uppy.on('upload-error', (_file, error, response) => {
      const { code, msg } = formatUploadError(error, response);
      showStatus(status, `Ошибка${code ? ' (HTTP ' + code + ')' : ''}: ${msg}`, true);
      if (toast) toast.error('Не загрузилось: ' + msg);
    });

    uppy.on('restriction-failed', (_file, error) => {
      const msg = (error as any)?.message || 'restriction';
      showStatus(status, 'Отказ: ' + msg, true);
      if (toast) toast.error(msg);
    });
  }

  function bindAll() {
    document.querySelectorAll<HTMLElement>('.uppy-uploader').forEach(attachOne);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindAll);
  } else {
    bindAll();
  }
</script>
