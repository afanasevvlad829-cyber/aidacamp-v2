---
import type { ShiftEvent } from '../../../lib/portalShift';
import { eventColorClass } from '../../../lib/portalShift';

interface Props {
  dates: string[];
  events: ShiftEvent[];
  staffNameByKey: Map<string, string>;
}

const { dates, events, staffNameByKey } = Astro.props;

const MATRIX_ROLES = ['teacher', 'vozhaty', 'rukovoditel'];
const ROLE_LABEL: Record<string, string> = {
  teacher: 'Учитель',
  vozhaty: 'Вожатый',
  rukovoditel: 'Руководитель',
  student: 'Ученик',
  admin: 'Админ',
};
function roleLabel(r: string): string {
  return ROLE_LABEL[r] ?? r;
}

const MONTHS_RU = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
function fmtDate(iso: string): string {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  return m ? Number(m[3]) + ' ' + MONTHS_RU[Number(m[2]) - 1] : iso;
}
function fmtTime(t: string | null): string {
  return t ? t.slice(0, 5) : '';
}
function eventActor(e: ShiftEvent): string {
  if (!e.staff_keys || e.staff_keys.length === 0) return '';
  const names = e.staff_keys.map((k) => staffNameByKey.get(k)).filter(Boolean) as string[];
  return names.length > 0 ? names.join(', ') : '';
}

function byTime(a: ShiftEvent, b: ShiftEvent): number {
  return (a.start_time ?? '99').localeCompare(b.start_time ?? '99') || a.sort - b.sort;
}
function cellEvents(date: string, r: string): ShiftEvent[] {
  return events.filter((e) => e.date === date && e.roles.includes(r)).sort(byTime);
}
---

<section class="overflow-auto rounded-[16px] border border-border bg-white card-shadow">
  {dates.length === 0 ? (
    <p class="p-6 text-[16px] text-body-muted">Событий пока нет.</p>
  ) : (
    <table class="w-full min-w-[640px] border-collapse text-[16px]">
      <thead>
        <tr>
          <th class="border-b border-border bg-page px-4 py-3 text-left font-semibold text-navy-950">
            День
          </th>
          {MATRIX_ROLES.map((r) => (
            <th class="border-b border-l border-border bg-page px-4 py-3 text-left font-semibold text-navy-950">
              {roleLabel(r)}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {dates.map((d) => (
          <tr>
            <td class="border-b border-border px-4 py-3 align-top font-medium text-navy-950 whitespace-nowrap">
              {fmtDate(d)}
            </td>
            {MATRIX_ROLES.map((r) => {
              const cells = cellEvents(d, r);
              return (
                <td class="border-b border-l border-border px-3 py-2 align-top text-body">
                  {cells.length === 0 ? (
                    <span class="text-body-muted">—</span>
                  ) : (
                    <ul class="space-y-1">
                      {cells.map((e) => {
                        const actor = eventActor(e);
                        return (
                          <li>
                            <a
                              href={`/portal/smena?view=role&date=${e.date}`}
                              class={`inline-flex max-w-full items-center gap-1.5 rounded-[6px] border px-2 py-0.5 text-[13px] leading-snug ${eventColorClass(e.event_type ?? e.activity_type)}`}
                              title={actor ? `${e.title} · ${actor}` : e.title}
                            >
                              <span class="font-mono text-[11px] opacity-70">{fmtTime(e.start_time)}</span>
                              <span class="truncate">{e.title}</span>
                              {actor && <span class="text-[11px] font-semibold opacity-70">· {actor}</span>}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  )}
</section>
