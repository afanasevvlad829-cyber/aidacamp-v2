---
interface KidAssignment {
  kid_id: string;
  kid_name: string;
  kid_age: number | null;
  kid_gender: string | null;
  room_number: number | null;
  bed_index: number | null;
}

interface Props {
  unassignedKids: KidAssignment[];
}
const { unassignedKids } = Astro.props;
---
{unassignedKids.length > 0 && (
  <div class="rasselenie-pool w-[220px] shrink-0 rounded-[14px] border border-amber-200 bg-amber-50/60 p-3 card-shadow sticky top-4">
    <div class="mb-2 flex items-center justify-between gap-1">
      <div class="flex items-center gap-1.5 text-[13px] font-semibold text-navy-950">
        <i class="bi bi-people-fill text-amber-600" aria-hidden="true"></i>
        Не расселены ({unassignedKids.length})
      </div>
      <button id="toggle-pool-btn" type="button"
        class="rounded-[6px] border border-border bg-white px-1.5 py-0.5 text-[11px] text-body-muted hover:border-primary hover:text-primary">
        Свернуть
      </button>
    </div>
    <div id="pool-list" class="flex flex-col gap-1.5 overflow-y-auto max-h-[560px] pr-0.5">
      {unassignedKids.map((kid) => (
        <div class="kid-card flex cursor-grab items-center gap-1.5 rounded-[10px] border border-border bg-white px-2.5 py-1.5 text-[13px] active:cursor-grabbing"
             draggable="true"
             data-kid-id={kid.kid_id}
             data-kid-name={kid.kid_name}
             title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
          <span class={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${
            kid.kid_gender === 'F' ? 'bg-pink-500' : kid.kid_gender === 'M' ? 'bg-sky-500' : 'bg-slate-400'
          }`}>{kid.kid_gender === 'F' ? 'Ж' : kid.kid_gender === 'M' ? 'М' : '?'}</span>
          <span class="min-w-0 flex-1 truncate text-navy-950">{kid.kid_name}{kid.kid_age ? ` · ${kid.kid_age}` : ''}</span>
          <button type="button" class="kid-remove shrink-0 text-[11px] text-red-600 hover:underline" data-kid-id={kid.kid_id} title="Удалить из списка">×</button>
        </div>
      ))}
    </div>
  </div>
)}
