---
interface KidAssignment {
  kid_id: string;
  kid_name: string;
  kid_age: number | null;
  kid_gender: string | null;
  room_number: number | null;
  bed_index: number | null;
}

import KidCardBody from './KidCardBody.astro';

interface Props {
  unassignedKids: KidAssignment[];
}
const { unassignedKids } = Astro.props;

// Разделяем детей и сотрудников
const kids = unassignedKids.filter((k) => !k.kid_id.startsWith('staff-'));
const staff = unassignedKids.filter((k) => k.kid_id.startsWith('staff-'));
---
<div class="rasselenie-pool w-[220px] shrink-0 rounded-[14px] border border-amber-200 bg-amber-50/60 p-3 card-shadow sticky top-4 flex flex-col gap-3">

  {/* ── Дети ── */}
  <div>
    <div class="mb-2 flex items-center justify-between gap-1">
      <div class="flex items-center gap-1.5 text-[13px] font-semibold text-navy-950">
        <i class="bi bi-people-fill text-amber-600" aria-hidden="true"></i>
        Дети ({kids.length})
      </div>
      <button id="toggle-pool-btn" type="button"
        class="rounded-[6px] border border-border bg-white px-1.5 py-0.5 text-[11px] text-body-muted hover:border-primary hover:text-primary">
        Свернуть
      </button>
    </div>
    <div id="pool-list" class="flex flex-col gap-1.5 overflow-y-auto max-h-[320px] pr-0.5">
      {kids.map((kid) => (
        <div class="kid-card flex cursor-grab items-start gap-1.5 rounded-[10px] border border-border bg-white px-2.5 py-1.5 text-[13px] active:cursor-grabbing"
             draggable="true"
             data-kid-id={kid.kid_id}
             data-kid-name={kid.kid_name}
             title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
          <KidCardBody kid={kid} removeTitle="Удалить из списка" removeAction="delete" />
        </div>
      ))}
    </div>
  </div>

  {/* ── Сотрудники ── */}
  <div class="border-t border-amber-200 pt-3">
    <div class="mb-2 flex items-center justify-between gap-1">
      <div class="flex items-center gap-1.5 text-[13px] font-semibold text-navy-950">
        <i class="bi bi-person-badge text-blue-600" aria-hidden="true"></i>
        Сотрудники ({staff.length})
      </div>
      <button id="load-staff-btn" type="button"
        class="rounded-[6px] border border-blue-300 bg-white px-1.5 py-0.5 text-[11px] text-blue-700 hover:bg-blue-50">
        + Загрузить
      </button>
    </div>
    <div id="staff-pool-list" class="flex flex-col gap-1.5 overflow-y-auto max-h-[220px] pr-0.5">
      {staff.map((s) => (
        <div class="kid-card flex cursor-grab items-start gap-1.5 rounded-[10px] border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-[13px] active:cursor-grabbing"
             draggable="true"
             data-kid-id={s.kid_id}
             data-kid-name={s.kid_name}
             title={s.kid_name}>
          <KidCardBody kid={s} removeTitle="Удалить из списка" removeAction="delete" />
        </div>
      ))}
      {staff.length === 0 && (
        <p class="text-[12px] text-body-muted">Нажмите «+ Загрузить»</p>
      )}
    </div>
  </div>

</div>
