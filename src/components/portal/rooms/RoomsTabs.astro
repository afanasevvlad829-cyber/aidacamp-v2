---
interface Props {
  tab: 'inventory' | 'rasselenie';
}
const { tab } = Astro.props;
---
<nav class="mb-6 flex flex-wrap gap-2" aria-label="Разделы комнат">
  <a href="/portal/rooms"
     class={`inline-flex items-center gap-2 rounded-[12px] border px-4 py-2 text-[15px] font-medium transition ${
       tab === 'rasselenie'
         ? 'border-primary bg-primary text-white'
         : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary'
     }`}>
    <i class="bi bi-house-door-fill text-[16px]" aria-hidden="true"></i>
    Расселение
  </a>
  <a href="/portal/rooms?tab=inventory"
     class={`inline-flex items-center gap-2 rounded-[12px] border px-4 py-2 text-[15px] font-medium transition ${
       tab === 'inventory'
         ? 'border-primary bg-primary text-white'
         : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary'
     }`}>
    <i class="bi bi-clipboard-check text-[16px]" aria-hidden="true"></i>
    Инвентаризация
  </a>
</nav>
