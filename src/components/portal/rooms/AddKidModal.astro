---
interface Props {
  shiftId: number;
}
const { shiftId } = Astro.props;
---
<div id="add-kid-modal" class="fixed inset-0 z-50 hidden bg-black/50">
  <div class="absolute inset-0 flex items-start justify-center overflow-y-auto p-4">
    <div class="mt-20 w-full max-w-md rounded-[16px] bg-white p-6 shadow-xl">
      <h2 class="mb-4 text-[20px] font-bold text-navy-950">Добавить ребёнка</h2>
      <form id="add-kid-form" class="space-y-3">
        <input type="hidden" name="shift_id" value={shiftId} />
        <div>
          <label class="form-label">Имя и фамилия</label>
          <input name="kid_name" required class="form-input" placeholder="Иван Иванов" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="form-label">Пол</label>
            <select name="kid_gender" class="form-input">
              <option value="">—</option>
              <option value="M">Мальчик</option>
              <option value="F">Девочка</option>
            </select>
          </div>
          <div>
            <label class="form-label">Возраст</label>
            <input name="kid_age" type="number" min="6" max="18" class="form-input" />
          </div>
        </div>
        <div>
          <label class="form-label">Заметки</label>
          <textarea name="notes" rows="2" data-voice data-voice-append class="form-input" placeholder="Пожелания по соседям, особенности"></textarea>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="rounded-[10px] bg-primary px-4 py-2 text-base font-semibold text-white hover:opacity-90">Добавить</button>
          <button type="button" id="add-kid-cancel" class="rounded-[10px] border border-border bg-white px-4 py-2 text-base font-medium text-body-muted hover:border-primary">Отмена</button>
          <span id="add-kid-status" class="ml-auto self-center text-base text-body-muted"></span>
        </div>
      </form>
    </div>
  </div>
</div>
