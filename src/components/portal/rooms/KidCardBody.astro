---
// Внутреннее наполнение карточки ребёнка/сотрудника: две строки
//   строка 1: [иконка пол] Фамилия
//   строка 2: [иконка возраст] Имя
// Используется и в пуле (справа), и на койках в плане.
interface KidAssignment {
  kid_id: string;
  kid_name: string;
  kid_age: number | null;
  kid_gender: string | null;
}
interface Props {
  kid: KidAssignment;
  removeTitle: string;
  removeAction: 'unassign' | 'delete';
}
const { kid, removeTitle, removeAction } = Astro.props;

const isStaff = kid.kid_id.startsWith('staff-');
const raw = (kid.kid_name || '').trim();
const parts = raw.split(/\s+/);
const surname = parts[0] || raw;
const firstName = parts.slice(1).join(' ');

const genderClass = kid.kid_gender === 'F' ? 'bg-pink-500'
  : kid.kid_gender === 'M' ? 'bg-sky-500'
  : isStaff ? 'bg-blue-500' : 'bg-slate-400';
const genderChar = kid.kid_gender === 'F' ? 'Ж'
  : kid.kid_gender === 'M' ? 'М'
  : isStaff ? 'С' : '?';
const ageChar = isStaff ? '·' : (kid.kid_age != null ? String(kid.kid_age) : '?');
const ageClass = isStaff ? 'bg-slate-300 text-slate-600' : (kid.kid_age != null ? 'bg-emerald-500 text-white' : 'bg-slate-300 text-slate-600');
---
<div class="flex min-w-0 flex-1 flex-col gap-0.5">
  <div class="flex items-center gap-1.5">
    <span class={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${genderClass}`}>{genderChar}</span>
    <span class="min-w-0 flex-1 truncate text-navy-950 font-medium leading-tight">{surname}</span>
  </div>
  <div class="flex items-center gap-1.5">
    <span class={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold ${ageClass}`}>{ageChar}</span>
    <span class="min-w-0 flex-1 truncate text-body-muted leading-tight">{firstName || ' '}</span>
  </div>
</div>
<button type="button" class="kid-remove shrink-0 self-start text-[13px] leading-none text-red-600 hover:underline" data-kid-id={kid.kid_id} data-action={removeAction} title={removeTitle}>×</button>
