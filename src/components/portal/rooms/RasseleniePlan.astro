---
import { ROOMS, FLOOR_LAYOUT } from '../../../lib/portalRooms';
import KidCardBody from './KidCardBody.astro';

interface KidAssignment {
  kid_id: string;
  kid_name: string;
  kid_age: number | null;
  kid_gender: string | null;
  room_number: number | null;
  bed_index: number | null;
}

interface Props {
  assignedByBed: Map<string, KidAssignment>;
}
const { assignedByBed } = Astro.props;

const floors: (1 | 2)[] = [1, 2];
---

<div class="space-y-8">
  {floors.map((floor) => (
    <section>
      <h2 class="mb-3 text-[20px] font-bold text-navy-950">{FLOOR_LAYOUT[floor].title}</h2>
      <div class="overflow-x-auto rounded-[16px] border-2 border-slate-300 bg-slate-100 p-5">
        <div class="flex flex-col gap-3" style="min-width: 700px;">
          {FLOOR_LAYOUT[floor].rows.map((row) => (
            <div class="flex items-stretch gap-3">
              {[row.left, row.right].map((wing, wi) => (
                <Fragment>
                  {wi === 1 && <div class="w-8 shrink-0 border-x border-dashed border-slate-400 opacity-50"></div>}
                  <div class="flex flex-1 gap-2">
                    {wing.map((num) => {
                      const r = ROOMS.find((x) => x.number === num)!;
                      const isStaff = r.type === 'staff';
                      const occ = Array.from({ length: r.capacity }).map((_, i) => assignedByBed.get(`${r.number}:${i}`)).filter(Boolean).length;
                      return (
                        <div class={`rasselenie-room flex flex-1 flex-col rounded-[12px] border-2 p-3 shadow-sm min-w-[110px] ${isStaff ? 'border-slate-200 bg-slate-100 opacity-60' : 'border-border bg-white'}`}
                             data-room-number={r.number}>
                          <div class="mb-2 flex items-center justify-between">
                            <div class="font-bold text-[15px] text-navy-950">№{r.number}</div>
                            {!isStaff && <div class="text-[12px] text-body-muted">{occ}/{r.capacity}</div>}
                          </div>
                          <div class="mb-1.5 text-[10px] text-body-muted leading-tight">{r.label}</div>
                          {!isStaff && (
                            <div class="flex-1 space-y-1.5">
                              {Array.from({ length: r.capacity }).map((_, i) => {
                                const kid = assignedByBed.get(`${r.number}:${i}`);
                                return (
                                  <div
                                    class={`bed flex min-h-[42px] items-start gap-2 rounded-[8px] border-2 border-dashed border-border px-2 py-1 text-[13px] ${kid ? 'border-solid bg-white' : 'bg-page'}`}
                                    data-room-number={r.number}
                                    data-bed-index={i}
                                    data-kid-id={kid?.kid_id ?? ''}
                                  >
                                    {kid ? (
                                      <div class="kid-card relative flex min-w-0 flex-1 cursor-grab items-start gap-1.5 active:cursor-grabbing"
                                           draggable="true"
                                           data-kid-id={kid.kid_id}
                                           data-kid-name={kid.kid_name}
                                           title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}`}>
                                        <KidCardBody kid={kid} removeTitle="Вернуть в список" removeAction="unassign" />
                                      </div>
                                    ) : (
                                      <span class="text-body-muted self-center">койка {i + 1}</span>
                                    )}
                                  </div>
                                );
                              })}
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </Fragment>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
</div>
