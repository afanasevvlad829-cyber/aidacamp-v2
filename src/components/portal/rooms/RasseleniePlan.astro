---
import { ROOMS } from '../../../lib/portalRooms';
import KidCardBody from './KidCardBody.astro';

interface KidAssignment {
  kid_id: string;
  kid_name: string;
  kid_age: number | null;
  kid_gender: string | null;
  room_number: number | null;
  bed_index: number | null;
}

interface Props {
  assignedByBed: Map<string, KidAssignment>;
}
const { assignedByBed } = Astro.props;

const floor1 = ROOMS.filter((r) => r.floor === 1 && r.type !== 'staff');
const floor2 = ROOMS.filter((r) => r.floor === 2);
---

<div class="space-y-4">
  {/* Этаж 1 */}
  <div class="rounded-[14px] border border-border bg-white p-4 card-shadow">
    <h3 class="mb-3 text-[16px] font-bold text-navy-950">Этаж 1 · 22 места</h3>
    <div class="overflow-x-auto">
      <div class="grid gap-2"
           style="grid-template-columns: repeat(4, minmax(118px, 1fr)) 18px repeat(4, minmax(118px, 1fr)); grid-auto-rows: minmax(132px, auto); min-width: 1080px;">
        {floor1.map((r) => {
          const occ = Array.from({ length: r.capacity }).map((_, i) => assignedByBed.get(`${r.number}:${i}`)).filter(Boolean).length;
          return (
            <div class="rasselenie-room flex flex-col rounded-[12px] border border-border bg-page p-3"
                 data-room-number={r.number}
                 style={`grid-column: ${r.col}; grid-row: ${r.row};`}>
              <div class="mb-2 flex items-center justify-between">
                <div class="font-bold text-[15px] text-navy-950">№{r.number}</div>
                <div class="text-[12px] text-body-muted">{occ}/{r.capacity}</div>
              </div>
              <div class="flex-1 space-y-1.5">
                {Array.from({ length: r.capacity }).map((_, i) => {
                  const kid = assignedByBed.get(`${r.number}:${i}`);
                  return (
                    <div
                      class={`bed flex min-h-[38px] items-center gap-2 rounded-[8px] border-2 border-dashed border-border px-2 py-1 text-[13px] ${kid ? 'border-solid bg-white' : 'bg-page'}`}
                      data-room-number={r.number}
                      data-bed-index={i}
                      data-kid-id={kid?.kid_id ?? ''}
                    >
                      {kid ? (
                        <div class="kid-card group/kid relative flex min-w-0 flex-1 cursor-grab items-start gap-1.5 active:cursor-grabbing"
                             draggable="true"
                             data-kid-id={kid.kid_id}
                             data-kid-name={kid.kid_name}
                             title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
                          <KidCardBody kid={kid} removeTitle="Вернуть в список" removeAction="unassign" />
                        </div>
                      ) : (
                        <span class="text-body-muted">койка {i + 1}</span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
        <div class="pointer-events-none border-x border-dashed border-slate-300"
             style="grid-column: 5; grid-row: 1 / span 2;"></div>
      </div>
    </div>
  </div>

  {/* Этаж 2 */}
  <div class="rounded-[14px] border border-border bg-white p-4 card-shadow">
    <h3 class="mb-3 text-[16px] font-bold text-navy-950">Этаж 2 · 24 места</h3>
    <div class="overflow-x-auto">
      <div class="grid gap-2"
           style="grid-template-columns: repeat(3, minmax(118px, 1fr)) 18px repeat(4, minmax(118px, 1fr)); grid-auto-rows: minmax(170px, auto); min-width: 960px;">
        {floor2.map((r) => {
          const occ = Array.from({ length: r.capacity }).map((_, i) => assignedByBed.get(`${r.number}:${i}`)).filter(Boolean).length;
          return (
            <div class="rasselenie-room flex flex-col rounded-[12px] border border-border bg-page p-3"
                 data-room-number={r.number}
                 style={`grid-column: ${r.col}; grid-row: ${r.row};`}>
              <div class="mb-2 flex items-center justify-between">
                <div class="font-bold text-[15px] text-navy-950">№{r.number}</div>
                <div class="text-[12px] text-body-muted">{occ}/{r.capacity}</div>
              </div>
              <div class="flex-1 space-y-1.5">
                {Array.from({ length: r.capacity }).map((_, i) => {
                  const kid = assignedByBed.get(`${r.number}:${i}`);
                  return (
                    <div
                      class={`bed flex min-h-[38px] items-center gap-2 rounded-[8px] border-2 border-dashed border-border px-2 py-1 text-[13px] ${kid ? 'border-solid bg-white' : 'bg-page'}`}
                      data-room-number={r.number}
                      data-bed-index={i}
                      data-kid-id={kid?.kid_id ?? ''}
                    >
                      {kid ? (
                        <div class="kid-card group/kid relative flex min-w-0 flex-1 cursor-grab items-start gap-1.5 active:cursor-grabbing"
                             draggable="true"
                             data-kid-id={kid.kid_id}
                             data-kid-name={kid.kid_name}
                             title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
                          <KidCardBody kid={kid} removeTitle="Вернуть в список" removeAction="unassign" />
                        </div>
                      ) : (
                        <span class="text-body-muted">койка {i + 1}</span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
        <div class="pointer-events-none border-x border-dashed border-slate-300"
             style="grid-column: 4; grid-row: 1 / span 2;"></div>
      </div>
    </div>
  </div>
</div>
