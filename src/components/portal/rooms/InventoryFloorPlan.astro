              <button type="button"
                class={`room-tile flex-1 rounded-[12px] border-2 p-3 text-left shadow-sm transition touch-manipulation active:scale-[0.97] h-[140px] min-w-[70px] ${colorCls(s, r.type)} ${isStaff ? 'cursor-not-allowed opacity-60' : 'hover:shadow-md'}`}
                data-room={num}
                disabled={isStaff}
