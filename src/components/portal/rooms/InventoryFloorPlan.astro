---
import { ROOMS, FLOOR_GRID } from '../../../lib/portalRooms';

interface Props {
  statusByRoom: Map<number, string>;
}
const { statusByRoom } = Astro.props;

function statusOf(n: number): 'pending' | 'ok' | 'defects' {
  return (statusByRoom.get(n) ?? 'pending') as any;
}
function colorCls(s: string, type: string): string {
  if (type === 'staff') return 'bg-slate-100 text-slate-400 border-slate-200';
  if (s === 'ok')      return 'bg-emerald-50 border-emerald-300 text-emerald-900';
  if (s === 'defects') return 'bg-amber-50 border-amber-300 text-amber-900';
  return 'bg-white border-border text-navy-950';
}

const floors: (1 | 2)[] = [1, 2];
---

{floors.map((floor) => {
  const plan = FLOOR_GRID[floor];
  return (
    <section class="mb-8">
      <h2 class="mb-3 text-[20px] font-bold text-navy-950">{plan.title}</h2>
      <div class="overflow-x-auto rounded-[16px] border-2 border-slate-300 bg-slate-100 p-5">
        <div
          class="grid gap-2"
          style={`grid-template-columns: repeat(${plan.cols}, minmax(64px, 1fr)); grid-template-rows: ${plan.rowsTemplate}; min-width: 660px;`}
        >
          {/* Коридор по центру — пунктирная вертикаль */}
          <div class="pointer-events-none border-x border-dashed border-slate-400 opacity-40"
               style="grid-column: 5; grid-row: 1 / -1;"></div>

          {plan.cells.map((cell) => {
            const r = ROOMS.find((x) => x.number === cell.n)!;
            const s = statusOf(cell.n);
            const isStaff = r.type === 'staff';
            return (
              <button type="button"
                class={`room-tile flex flex-col rounded-[12px] border-2 p-3 text-left shadow-sm transition touch-manipulation active:scale-[0.97] ${colorCls(s, r.type)} ${isStaff ? 'cursor-not-allowed opacity-60' : 'hover:shadow-md'}`}
                style={`grid-column: ${cell.col}; grid-row: ${cell.row};`}
                data-room={cell.n}
                disabled={isStaff}
              >
                <div class="text-[15px] font-bold">№{cell.n}</div>
                <div class="mt-0.5 text-[10px] text-body-muted leading-tight">{r.label}</div>
                {!isStaff && (
                  <div class="mt-auto pt-1 text-[11px] font-semibold">
                    {s === 'ok' && <><i class="bi bi-check-lg" aria-hidden="true"></i> принято</>}
                    {s === 'defects' && <><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> замечания</>}
                    {s === 'pending' && <><i class="bi bi-circle" aria-hidden="true"></i> не принято</>}
                  </div>
                )}
              </button>
            );
          })}
        </div>
      </div>
    </section>
  );
})}
