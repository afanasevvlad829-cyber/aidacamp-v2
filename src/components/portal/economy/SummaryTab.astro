---
interface Props {
  fmtRub: (n: number) => string;
  totalAll: number;
}
const { fmtRub, totalAll } = Astro.props;
---
<div class="grid gap-4 lg:grid-cols-2">
  <div class="rounded-[14px] border border-border bg-white p-5 card-shadow">
    <div class="mb-3 text-base font-semibold uppercase tracking-wide text-primary">
      <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы — общая экономика
    </div>
    <div class="space-y-2 text-base">
      <div class="flex justify-between"><span class="text-body-muted">Закуплено (Ozon, видимые)</span><b class="font-mono tabular-nums" id="sum-ozon-visible">{fmtRub(totalAll)}</b></div>
      <div class="flex justify-between text-base text-body-muted"><span>В т.ч. всего по счетам</span><span>{fmtRub(totalAll)}</span></div>
      <div class="flex justify-between"><span class="text-body-muted">В игровых ₽ (рекоменд.)</span><b class="font-mono tabular-nums" id="sum-recommended">—</b></div>
      <div class="flex justify-between"><span class="text-body-muted">В игровых ₽ (заданные)</span><b class="font-mono tabular-nums" id="sum-bongere-2">—</b></div>
      <div class="flex justify-between text-base text-body-muted"><span>Средняя наценка</span><span id="sum-markup-avg">—</span></div>
    </div>
  </div>
  <div class="rounded-[14px] border border-border bg-white p-5 card-shadow">
    <div class="mb-3 text-base font-semibold uppercase tracking-wide text-primary">
      <i class="bi bi-coin" aria-hidden="true"></i> Денежный поток
    </div>
    <div class="space-y-2 text-base">
      <div class="flex justify-between"><span class="text-body-muted">Всего в обороте</span><b class="font-mono tabular-nums" id="sum-total-money">—</b></div>
      <div class="flex justify-between"><span class="text-body-muted">Если потратить на призы</span><b class="font-mono tabular-nums" id="sum-balance-prizes">—</b></div>
      <div class="flex justify-between"><span class="text-body-muted">Остаток на активности</span><b class="font-mono tabular-nums" id="sum-balance-acts">—</b></div>
    </div>
  </div>
</div>
