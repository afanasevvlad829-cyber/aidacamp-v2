---
// No props needed
---
{/* Модалка добавления / редактирования */}
<dialog id="activity-dialog" class="aida-modal-center rounded-[16px] border border-border p-0 backdrop:bg-black/50">
  <form method="dialog" class="aida-modal-form">
    <h3 class="text-[18px] font-semibold text-navy-950">Активность</h3>
    <input type="hidden" id="act-id" />
    <div class="mt-4 grid gap-3">
      <label class="block">
        <span class="form-label">Название</span>
        <input id="act-name" type="text" required
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="form-label">Описание</span>
        <textarea id="act-desc" rows="2" data-voice data-voice-append
                  class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none"></textarea>
      </label>
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="block">
          <span class="form-label">Категория</span>
          <select id="act-cat" class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none">
            <option value="phone">Телефон</option>
            <option value="fun">Развлечения</option>
            <option value="food">Еда</option>
            <option value="prize">Физ. приз</option>
            <option value="privilege">Привилегии</option>
            <option value="comfort">Комфорт</option>
            <option value="service">Услуги</option>
            <option value="other">Прочее</option>
          </select>
        </label>
        <label class="block">
          <span class="form-label">Цена, ₽ <span class="text-body-muted text-[11px]">(если без формулы)</span></span>
          <input id="act-price" type="number" min="0" step="100"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
        </label>
        <label class="block">
          <span class="form-label">Группа N <span class="text-body-muted text-[11px]">(пусто = вся смена)</span></span>
          <input id="act-participants" type="number" min="1"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
        </label>
      </div>
      <div>
        <div class="text-base font-semibold uppercase tracking-wide text-body-muted">
          Формула цены (опционально)
        </div>
        <p class="text-[12px] text-body-muted">Если заданы оба — цена = группа × выдача × дней × доля%. Иначе берётся «Цена» сверху.</p>
        <div class="mt-2 grid gap-3 sm:grid-cols-3">
          <label class="block">
            <span class="form-label">Дней копления</span>
            <input id="act-target-days" type="number" min="1" max="14" step="1"
                   class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
          </label>
          <label class="block">
            <span class="form-label">% дохода / день</span>
            <input id="act-target-share" type="number" min="10" max="100" step="5"
                   class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
          </label>
          <label class="block">
            <span class="form-label">Множитель повтора ×</span>
            <input id="act-repeat" type="number" min="1" max="5" step="0.1"
                   class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
          </label>
        </div>
      </div>
    </div>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" id="act-cancel"
              class="rounded-[10px] border border-border bg-white px-4 py-2 text-base text-navy-950 hover:border-primary">Отмена</button>
      <button type="button" id="act-save"
              class="rounded-[10px] border border-primary bg-primary px-4 py-2 text-base text-white hover:opacity-90">Сохранить</button>
    </div>
  </form>
</dialog>
