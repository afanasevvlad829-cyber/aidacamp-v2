---
interface Props {
  kids: { id: number; name: string; room_number?: string | null; age?: number | null }[];
}
const { kids } = Astro.props;
---
{/* ── Modal: Выдать приз ребёнку ─────────────────────────────────── */}
<dialog id="give-dialog"
        class="aida-modal-center rounded-[16px] border border-border p-0 backdrop:bg-black/50">
  <form method="dialog" enctype="multipart/form-data" class="aida-modal-form">
    <h3 class="text-[18px] font-semibold text-navy-950">
      Выдать приз: <span id="give-prize-name" class="text-primary"></span>
    </h3>
    <input type="hidden" id="give-prize-id" />
    <input type="hidden" id="give-prize-name-hidden" />

    {/* Памятка с вопросами для видео — для вожатого/руководителя */}
    <div class="mt-3 rounded-[10px] border border-amber-300 bg-amber-50 p-3 text-[13px]">
      <div class="mb-1 flex items-center gap-1.5 font-semibold text-amber-900">
        <i class="bi bi-camera-video-fill" aria-hidden="true"></i> Спроси на видео:
      </div>
      <ol class="ml-5 list-decimal space-y-0.5 text-amber-900">
        <li>Почему ты копил именно на этот приз?</li>
        <li>Что для тебя значит этот приз?</li>
        <li>Как будешь использовать / с кем поделишься?</li>
        <li>Сколько дней копил, от чего отказался?</li>
        <li>Что посоветуешь другим ребятам?</li>
      </ol>
    </div>

    <div class="mt-4 space-y-3">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Кому выдаём</span>
        <select id="give-kid" required
                class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none">
          <option value="">— выбери ребёнка —</option>
          {kids.map((k) => (
            <option value={k.id} data-name={k.name}>{k.name}{k.room_number ? ` · к.${k.room_number}` : ''}{k.age ? ` · ${k.age} лет` : ''}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Цена в игровых ₽ (сколько отдал ребёнок)</span>
        <input id="give-price" type="number" min="0" step="50"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
      </label>
      <div>
        <span class="block text-[13px] font-medium text-body-muted">Фото или видео вручения (обязательно)</span>
        <label class="mt-1 inline-flex cursor-pointer items-center gap-2 rounded-[10px] bg-primary px-4 py-2 text-[15px] font-medium text-white transition hover:opacity-90">
          <i class="bi bi-camera-fill" aria-hidden="true"></i>
          <span id="give-file-label">Снять или выбрать файл</span>
          <input id="give-file" type="file" accept="image/*,video/*" class="sr-only" />
        </label>
        <span class="mt-1 block text-[12px] text-body-muted">Можешь снять сразу или выбрать готовый файл из библиотеки. Если снимаешь — горизонтально, задай 1-2 вопроса из списка выше.</span>
      </div>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Заметка (необязательно)</span>
        <textarea id="give-note" rows="2" data-voice data-voice-append
                  class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-[14px] focus:border-primary focus:outline-none"
                  placeholder="За что выдан, контекст, ответы ребёнка…"></textarea>
      </label>
    </div>
    <div class="mt-5 flex flex-wrap items-center justify-end gap-2">
      <span id="give-status" class="mr-auto text-[13px] text-body-muted"></span>
      <button type="button" id="give-cancel"
              class="rounded-[10px] border border-border bg-white px-4 py-2 text-[14px] text-navy-950 hover:border-primary">Отмена</button>
      <button type="button" id="give-save"
              class="rounded-[10px] border border-primary bg-primary px-4 py-2 text-[14px] text-white hover:opacity-90">
        <i class="bi bi-gift-fill" aria-hidden="true"></i> Выдать и сохранить
      </button>
    </div>
  </form>
</dialog>
