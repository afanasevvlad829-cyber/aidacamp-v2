---
// No props needed
---
{/* ── Modal: Добавить кастомный приз ──────────────────────────────── */}
<dialog id="custom-dialog" class="aida-modal-center rounded-[16px] border border-border p-0 backdrop:bg-black/50">
  <form method="dialog" enctype="multipart/form-data" class="aida-modal-form">
    <h3 class="text-[18px] font-semibold text-navy-950">Новый приз в каталог</h3>
    <div class="mt-4 space-y-3">
      <label class="block">
        <span class="form-label">Название</span>
        <input id="cust-name" type="text" required
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="form-label">Описание</span>
        <textarea id="cust-desc" rows="2" data-voice data-voice-append
                  class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-base focus:border-primary focus:outline-none"></textarea>
      </label>
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="block">
          <span class="form-label">Категория</span>
          <input id="cust-cat" type="text" placeholder="напр. Опыты / Сувенир"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none" />
        </label>
        <label class="block">
          <span class="form-label">Цена Ozon, ₽</span>
          <input id="cust-price" type="number" min="0" step="10"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
        </label>
        <label class="block">
          <span class="form-label">Количество</span>
          <input id="cust-qty" type="number" min="1" step="1" value="1"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
        </label>
      </div>
<div>
        <span class="form-label">Фотография приза</span>
        <label class="mt-1 inline-flex cursor-pointer items-center gap-2 rounded-[10px] bg-primary px-4 py-2 text-base font-medium text-white transition hover:opacity-90">
          <i class="bi bi-camera-fill" aria-hidden="true"></i>
          <span id="cust-file-label">Снять или выбрать фото</span>
          <input id="cust-file" type="file" accept="image/*" class="sr-only" />
        </label>
      </div>
    </div>
    <div class="mt-5 flex items-center justify-end gap-2">
      <span id="cust-status" class="mr-auto text-base text-body-muted"></span>
      <button type="button" id="cust-cancel"
              class="rounded-[10px] border border-border bg-white px-4 py-2 text-base text-navy-950 hover:border-primary">Отмена</button>
      <button type="button" id="cust-save"
              class="rounded-[10px] border border-primary bg-primary px-4 py-2 text-base text-white hover:opacity-90">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Сохранить приз
      </button>
    </div>
  </form>
</dialog>
