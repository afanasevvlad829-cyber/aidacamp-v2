---
// No props needed — all inputs have hardcoded value= and id= that JS reads/writes
---
{/* Шапка-настройки — общий калькулятор */}
<div class="mb-6 rounded-[16px] border border-border bg-white p-5 card-shadow">
  <div class="mb-3 flex items-center gap-2 text-base font-semibold uppercase tracking-wide text-primary">
    <i class="bi bi-sliders" aria-hidden="true"></i>
    Параметры смены
  </div>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <label class="block">
      <span class="form-label">Детей на смене</span>
      <input id="set-kids" type="number" min="1" max="200" value="35"
             class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
    </label>
    <label class="block">
      <span class="form-label">Дней в смене</span>
      <input id="set-days" type="number" min="1" max="30" value="10"
             class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
    </label>
    <label class="block">
      <span class="form-label">1 минута телефона, ₽ <span class="text-amber-700">(якорь)</span></span>
      <input id="set-phone-min" type="number" min="1" step="1" value="10"
             class="mt-1 w-full rounded-[10px] border border-amber-300 bg-amber-50/40 px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
    </label>
    <label class="block">
      <span class="form-label">Цель изъятия, %</span>
      <input id="set-target-extract" type="number" min="50" max="100" step="5" value="75"
             class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      <span class="mt-1 block text-[12px] text-body-muted">сколько денег вытащить через призы и активности</span>
    </label>
  </div>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <label class="block">
      <span class="form-label">Наценка для физических призов, ×</span>
      <input id="set-markup" type="number" min="1" step="0.1" value="3"
             class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      <span class="mt-1 block text-[12px] text-body-muted">Рекомендованная цена = Ozon × наценка, за 1 шт.</span>
    </label>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <label class="block">
      <span class="form-label">Выдача в день, ₽ <span class="text-amber-700">(= час телефона)</span></span>
      <input id="set-daily" type="number" min="0" step="50" value="600"
             class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      <span class="mt-1 block text-[12px] text-body-muted">600 ₽ — это ровно 60 минут телефона. Получают все, без условий.</span>
    </label>
    <label class="block">
      <span class="form-label">Округление до</span>
      <select id="set-round"
              class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 font-mono tabular-nums focus:border-primary focus:outline-none">
        <option value="10">10 ₽</option>
        <option value="50" selected>50 ₽</option>
        <option value="100">100 ₽</option>
      </select>
    </label>
  </div>

  <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
    <div class="rounded-[10px] border border-border bg-page p-3">
      <div class="text-base text-body-muted">Выдача / ребёнок / день</div>
      <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
        <span id="kpi-potential">—</span>
      </div>
      <div class="text-[12px] text-body-muted">= <span id="kpi-phone-equiv">—</span> мин</div>
    </div>
    <div class="rounded-[10px] border border-border bg-page p-3">
      <div class="text-base text-body-muted">Дневной фонд лагеря</div>
      <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
        <span id="kpi-daily-fund">—</span>
      </div>
    </div>
    <div class="rounded-[10px] border border-border bg-page p-3">
      <div class="text-base text-body-muted">Полный фонд смены</div>
      <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
        <span id="kpi-total">—</span>
      </div>
    </div>
    <div class="rounded-[10px] border border-primary bg-primary-soft p-3">
      <div class="text-base font-medium text-primary">Цель изъятия</div>
      <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-primary">
        <span id="kpi-target-extract">—</span>
      </div>
      <div class="text-[12px] text-primary/80">через призы + активности</div>
    </div>
    <div class="rounded-[10px] border border-border bg-page p-3">
      <div class="text-base text-body-muted">За всю смену с ребёнка</div>
      <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
        <span id="kpi-per-kid">—</span>
      </div>
    </div>
  </div>
</div>
