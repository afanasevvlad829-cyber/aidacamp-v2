---
/**
 * MediaManager — единый блок загрузки и управления медиа для любой сущности.
 *
 * Props:
 *   entityType: 'event' | 'student' | 'prize' | 'lesson' | 'room' | 'profile' (или любой string)
 *   entityId:   number|string
 *   canDelete:  default — true для admin/руководителя на клиенте (он проверит)
 *   accept:     MIME-фильтры (по умолчанию любые)
 *   title:      опц. заголовок секции
 *   maxFiles:   максимум файлов (по умолчанию 5)
 *
 * Использование:
 *   <MediaManager entityType="event" entityId={42} title="Фото с занятия" />
 *   <MediaManager entityType="student" entityId={kid.id} accept="image/*" maxFiles={1} title="Профиль" />
 */
interface Props {
  entityType: string;
  entityId:   number | string;
  accept?:    string;
  title?:     string;
  maxFiles?:  number;
  /** Заметка под uploader. */
  note?:      string;
}

const {
  entityType,
  entityId,
  accept = 'image/*,video/*',
  title,
  maxFiles = 5,
  note = 'Камера / Из библиотеки / Файл',
} = Astro.props;

const rootId = `mm-${entityType}-${entityId}-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="media-manager mt-3"
         id={rootId}
         data-entity-type={entityType}
         data-entity-id={String(entityId)}
         data-accept={accept}
         data-max={String(maxFiles)}
         data-note={note}>
  {title && (
    <h3 class="mb-2 text-base font-semibold text-navy-950">{title}</h3>
  )}
  <div class="media-manager__upload"></div>
  <div class="media-manager__list mt-2"></div>
</section>

<script>
  import Uppy from '@uppy/core';
  import Dashboard from '@uppy/dashboard';
  import XHRUpload from '@uppy/xhr-upload';
  import GoldenRetriever from '@uppy/golden-retriever';
  import '@uppy/core/css/style.min.css';
  import '@uppy/dashboard/css/style.min.css';
  import { UPPY_LOCALE_STRINGS, buildUppyRestrictions, UPPY_DASHBOARD_BASE, UPPY_XHR_BASE, attachGoldenRetriever, formatUploadError } from '../../scripts/portal/uppyShared';

  const initialised = new WeakSet<HTMLElement>();

  function fmtSize(bytes: number): string {
    if (!bytes) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / 1024 / 1024).toFixed(1) + ' MB';
  }
  function fmtTime(iso: string): string {
    try {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleString('ru-RU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
    } catch { return ''; }
  }
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function attachOne(root: HTMLElement) {
    if (initialised.has(root)) return;
    initialised.add(root);

    const uploadEl = root.querySelector<HTMLElement>('.media-manager__upload')!;
    const listEl   = root.querySelector<HTMLElement>('.media-manager__list')!;
    const entityType = root.dataset.entityType!;
    const entityId   = root.dataset.entityId!;
    const accept     = root.dataset.accept || 'image/*,video/*';
    const maxFiles   = Number(root.dataset.max || '5');
    const note       = root.dataset.note || '';
    const toast = (window as any).toast;

    const uppy = new Uppy({
      id: `uppy-${root.id}`,
      autoProceed: true,
      restrictions: buildUppyRestrictions(accept, maxFiles),
    });

    uppy.use(Dashboard, {
      target: uploadEl,
      ...UPPY_DASHBOARD_BASE,
      height: 200,
      note,
      locale: { strings: UPPY_LOCALE_STRINGS },
    });

    uppy.use(XHRUpload, {
      endpoint: '/api/portal/media',
      ...UPPY_XHR_BASE,
    });
    uppy.setMeta({ entity_type: entityType, entity_id: entityId });

    attachGoldenRetriever(uppy, GoldenRetriever);

    uppy.on('upload-success', () => {
      if (toast) toast.success('Загружено');
      refresh();
    });
    uppy.on('upload-error', (_f, error, response) => {
      const { code, msg } = formatUploadError(error, response);
      if (toast) toast.error(`Ошибка${code ? ' (HTTP ' + code + ')' : ''}: ${msg}`);
    });
    uppy.on('restriction-failed', (_f, error) => {
      const msg = (error as any)?.message || 'restriction';
      if (toast) toast.error(msg);
    });

    async function refresh() {
      const r = await fetch(`/api/portal/media?entity_type=${encodeURIComponent(entityType)}&entity_id=${encodeURIComponent(entityId)}`,
        { credentials: 'include' });
      const j = await r.json().catch(() => ({}));
      const items = (j.items || []) as any[];
      if (items.length === 0) {
        listEl.innerHTML = '';
        return;
      }
      listEl.innerHTML = `
        <div class="mb-1 text-[12px] uppercase tracking-wider text-body-muted">Загружено: ${items.length}</div>
        <ul class="space-y-1">
          ${items.map((p) => {
            const url = p.file_url || '';
            const isVideo = p.file_type === 'video';
            const thumb = url && !isVideo
              ? `<a href="${escapeHtml(url)}" class="pswp-thumb shrink-0" data-pswp-width="1600" data-pswp-height="1200" target="_blank" rel="noopener">
                   <img src="${escapeHtml(url)}" alt="" loading="lazy" class="h-10 w-10 rounded-[6px] border border-border object-cover" />
                 </a>`
              : (url && isVideo
                  ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] border border-border bg-page text-body-muted"><i class="bi bi-camera-video"></i></a>`
                  : `<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] border border-border bg-page text-body-muted"><i class="bi bi-image"></i></span>`);
            const meta = `${escapeHtml(p.author_name || '')} · ${fmtTime(p.uploaded_at)}${p.size_bytes ? ' · ' + fmtSize(p.size_bytes) : ''}`;
            return `<li class="flex items-center gap-2 rounded-[8px] border border-border bg-white px-2 py-1.5"
                        data-id="${p.id}">
                      ${thumb}
                      <span class="min-w-0 flex-1 truncate text-base text-body-muted">${meta}</span>
                      <button type="button" data-delete="${p.id}" title="Удалить"
                              class="rounded-[6px] border border-border bg-white px-2 py-1 text-[12px] text-red-600 hover:border-red-300 hover:bg-red-50">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    </li>`;
          }).join('')}
        </ul>`;
      // PhotoSwipe rebind
      document.dispatchEvent(new CustomEvent('portal-media:lightbox-rebind'));
      // Delete handlers
      listEl.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = Number(btn.dataset.delete);
          if (!confirm('Удалить файл?')) return;
          btn.disabled = true;
          try {
            const r = await fetch(`/api/portal/media?id=${id}`, { method: 'DELETE', credentials: 'include' });
            const j = await r.json();
            if (!j.ok) throw new Error(j.error || 'error');
            if (toast) toast.success('Удалено');
            refresh();
          } catch (e: any) {
            if (toast) toast.error('Ошибка: ' + (e?.message || e));
            btn.disabled = false;
          }
        });
      });
    }

    // Первичная отрисовка списка
    refresh();
  }

  function bindAll() {
    document.querySelectorAll<HTMLElement>('.media-manager').forEach(attachOne);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindAll);
  } else {
    bindAll();
  }
</script>
