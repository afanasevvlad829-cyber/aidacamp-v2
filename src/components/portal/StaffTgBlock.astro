---
/**
 * Telegram сотрудника: телефон / @username (редактирование) + статус последней доставки ссылки входа
 * и кнопка «Отправить заново» (та же постоянная ссылка) и «Новая ссылка» (новый токен, старый отключается); автоповторов нет.
 */
import type { LastDelivery } from '../../lib/portalLinkDelivery';
interface Props {
  id: number;
  phone?: string | null;
  tgUsername?: string | null;
  delivery?: LastDelivery | null;
}
const { id, phone, tgUsername, delivery } = Astro.props;
const STATUS: Record<string, { label: string; cls: string }> = {
  sent: { label: 'отправлено', cls: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  queued: { label: 'в очереди', cls: 'bg-amber-50 text-amber-700 border-amber-200' },
  failed: { label: 'ошибка', cls: 'bg-red-50 text-red-700 border-red-200' },
};
const st = delivery ? STATUS[delivery.status] : null;
const when = delivery ? new Date(delivery.sent_at ?? delivery.created_at).toLocaleString('ru-RU', { timeZone: 'Europe/Moscow' }) : '';
---
<div class="mt-2 text-base">
  <form method="POST" action="/api/portal/staff/contact" class="flex flex-wrap items-center gap-2">
    <input type="hidden" name="id" value={id} />
    <span class="text-body-muted"><i class="bi bi-telegram" aria-hidden="true"></i> Telegram:</span>
    <input type="text" name="phone" value={phone ?? ''} placeholder="Телефон, 11 цифр" inputmode="tel"
           class="w-48 rounded-[8px] border border-border bg-white px-2 py-1 text-[14px] text-navy-950 outline-none focus:border-primary" />
    <input type="text" name="tg_username" value={tgUsername ?? ''} placeholder="@username"
           class="w-40 rounded-[8px] border border-border bg-white px-2 py-1 text-[14px] text-navy-950 outline-none focus:border-primary" />
    <button type="submit" class="rounded-[8px] border border-border px-2 py-1 text-[12px] font-medium text-body-muted transition hover:border-primary hover:text-primary">Сохранить</button>
  </form>
  <div class="mt-1 flex flex-wrap items-center gap-2">
    <span class="text-body-muted">Ссылка входа:</span>
    {st ? (
      <span class={`rounded-full border px-2 py-0.5 text-[12px] font-medium ${st.cls}`} title={delivery?.error ?? ''}>{st.label}</span>
    ) : (
      <span class="text-[13px] text-body-muted">не отправлялась</span>
    )}
    {delivery && <span class="text-[12px] text-body-muted">{when}</span>}
    {delivery?.status === 'failed' && delivery.error && <span class="text-[12px] text-red-700">{delivery.error}</span>}
    <form method="POST" action="/api/portal/staff/send-link" onsubmit="return confirm('Отправить ссылку входа в Telegram?')">
      <input type="hidden" name="id" value={id} />
      <button type="submit" class="rounded-[8px] border border-primary px-2 py-1 text-[12px] text-primary transition hover:bg-primary-soft">{delivery ? 'Отправить заново' : 'Отправить ссылку'}</button>
    </form>
    <form method="POST" action="/api/portal/staff/send-link" onsubmit="return confirm('Выпустить НОВУЮ ссылку и отправить? Прежняя ссылка перестанет работать.')">
      <input type="hidden" name="id" value={id} />
      <input type="hidden" name="rotate" value="1" />
      <button type="submit" class="rounded-[8px] border border-border px-2 py-1 text-[12px] text-body-muted transition hover:text-red-700">Новая ссылка</button>
    </form>
  </div>
</div>
