---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';

interface Props {
  variant: 'desktop' | 'mobile';
}

const { variant } = Astro.props;
---

{variant === 'desktop' && (
  <div class="relative" data-hero-phone-dropdown="desktop">
    <button
      type="button"
      data-phone-toggle
      aria-expanded="false"
      class="phone-pill inline-flex h-11 cursor-pointer items-center gap-2.5 whitespace-nowrap px-4 text-[15px] font-semibold text-white transition" style="text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 12px rgba(0,0,0,0.85), 0 0 22px rgba(0,0,0,0.55); filter: drop-shadow(0 0 14px rgba(0,0,0,0.6));"
    >
      <svg class="h-4 w-4" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      {PHONE_MAIN}
      <svg class="h-3 w-3 transition-transform duration-200" data-phone-chevron width="12" height="12" fill="none" viewBox="0 0 12 12">
        <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div data-phone-panel class="hidden absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px]">
      <a href={PHONE_MAIN_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_495">
        <i class="bi bi-telephone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a href={PHONE_MOBILE_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_968">
        <i class="bi bi-phone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="telegram">
        <i class="bi bi-telegram shrink-0 text-[15px]"></i>
        Telegram
      </a>

      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="whatsapp">
        <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
        WhatsApp
      </a>
    </div>
  </div>
)}

{variant === 'mobile' && (
  <div class="relative" data-hero-phone-dropdown="mobile">
    <button
      type="button"
      data-phone-toggle
      aria-expanded="false"
      aria-label="Позвонить"
      class="flex h-14 w-14 cursor-pointer items-center justify-center rounded-xl border border-white/30 bg-white/10 text-white backdrop-blur-sm"
    >
      <svg class="h-[30px] w-[30px]" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
    </button>
    <div data-phone-panel class="hidden absolute right-0 top-[calc(100%+8px)] z-50 grid min-w-[200px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px]">
      <a href={PHONE_MAIN_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
        <i class="bi bi-telephone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a href={PHONE_MOBILE_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
        <i class="bi bi-phone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
        <i class="bi bi-telegram shrink-0 text-[15px]"></i>
        Telegram
      </a>

      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
        <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
        WhatsApp
      </a>
    </div>
  </div>
)}

<script>
  function initPhoneDropdowns() {
    document.querySelectorAll<HTMLElement>('[data-hero-phone-dropdown]').forEach((wrap) => {
      const btn = wrap.querySelector<HTMLButtonElement>('[data-phone-toggle]')!;
      const panel = wrap.querySelector<HTMLElement>('[data-phone-panel]')!;
      const chevron = wrap.querySelector<HTMLElement>('[data-phone-chevron]');

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          panel.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          chevron && (chevron.style.transform = '');
        } else {
          panel.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          chevron && (chevron.style.transform = 'rotate(180deg)');
        }
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) {
          panel.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          chevron && (chevron.style.transform = '');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initPhoneDropdowns);
  initPhoneDropdowns();
</script>
