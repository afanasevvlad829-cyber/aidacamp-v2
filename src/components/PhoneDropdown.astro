---
import { PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';

interface Props {
  variant: 'desktop' | 'mobile';
}

const { variant } = Astro.props;
---

{variant === 'desktop' && (
  <details class="group relative" data-hero-phone-dropdown="desktop">
    <summary class="inline-flex h-12 cursor-pointer items-center gap-3 whitespace-nowrap rounded-3xl border border-white/42 bg-white/11 px-5 text-[15px] font-semibold text-white backdrop-blur-sm [text-shadow:0px_1px_2px_rgba(0,0,0,0.35)] list-none [&::-webkit-details-marker]:hidden">
      <i class="bi bi-telephone-fill text-[16px]" aria-hidden="true"></i>
      {PHONE_MAIN}
      <i class="bi bi-chevron-down transition-transform group-open:rotate-180 text-[12px]" aria-hidden="true"></i>
    </summary>
    <div class="invisible absolute right-0 top-[calc(100%+10px)] z-50 grid min-w-[220px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 opacity-0 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px] transition-all group-open:visible group-open:translate-y-0 group-open:opacity-100">
      <a href={PHONE_MAIN_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_495">
        <i class="bi bi-telephone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a href={PHONE_MOBILE_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click" data-analytics-label="call_968">
        <i class="bi bi-phone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="whatsapp">
        <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
        WhatsApp
      </a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click" data-analytics-label="telegram">
        <i class="bi bi-telegram shrink-0 text-[15px]"></i>
        Telegram
      </a>
    </div>
  </details>
)}

{variant === 'mobile' && (
  <details class="group relative" data-hero-phone-dropdown="mobile">
    <summary class="flex h-14 w-14 cursor-pointer items-center justify-center rounded-xl border border-white/30 bg-white/10 text-white backdrop-blur-sm list-none [&::-webkit-details-marker]:hidden">
      <i class="bi bi-telephone-fill text-[16px]" aria-hidden="true"></i>
    </summary>
    <div class="invisible absolute right-0 top-[calc(100%+8px)] z-50 grid min-w-[200px] gap-1 rounded-2xl border border-white/16 bg-[rgba(7,14,26,0.92)] p-2 opacity-0 shadow-[0_20px_44px_rgba(2,8,20,0.46)] backdrop-blur-[10px] transition-all group-open:visible group-open:translate-y-0 group-open:opacity-100">
      <a href={PHONE_MAIN_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
        <i class="bi bi-telephone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MAIN}</span>
      </a>
      <a href={PHONE_MOBILE_HREF} class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="phone_click">
        <i class="bi bi-phone shrink-0 text-[15px]"></i>
        <span class="whitespace-nowrap">{PHONE_MOBILE}</span>
      </a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
        <i class="bi bi-whatsapp shrink-0 text-[15px]"></i>
        WhatsApp
      </a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="flex min-h-[44px] items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-white/90 transition hover:bg-white/10" data-analytics-goal="messenger_click">
        <i class="bi bi-telegram shrink-0 text-[15px]"></i>
        Telegram
      </a>
    </div>
  </details>
)}
