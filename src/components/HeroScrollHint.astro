---
/**
 * HeroScrollHint — анимированный bouncing-хинт под hero «листай вниз».
 * Концепт: вертикальная линия + подпись внизу. Пульсирует.
 * На mobile + desktop. respect prefers-reduced-motion.
 */
---

<a href="#shifts" aria-label="Прокрутить к сменам" class="hero-scroll-hint group flex flex-col items-center gap-1.5 mx-auto py-3 text-body-faint hover:text-primary transition-colors no-underline">
  <span class="hero-scroll-line block w-px bg-current opacity-50 group-hover:opacity-90"></span>
  <span class="text-[10px] font-bold uppercase tracking-[0.2em]">смены</span>
  <i class="bi bi-chevron-down text-[10px] opacity-60" aria-hidden="true"></i>
</a>

<style>
  .hero-scroll-line {
    height: 28px;
    animation: hero-scroll-bounce 2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes hero-scroll-bounce {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50%      { transform: scaleY(1.4); opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line { animation: none; }
  }
</style>
