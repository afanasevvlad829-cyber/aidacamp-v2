---
import { PHONE_MAIN, PHONE_MAIN_HREF, WHATSAPP_URL, TELEGRAM_URL } from '../data/contacts';

interface Props {
  sections: Array<{
    h2: string
    text: string
    list?: string[]
  }>
  priceFrom?: string
  priceNote?: string
  highlights?: string[]
}

const { sections, priceFrom = "от 48 000 ₽", priceNote = "за 7-дневную смену", highlights = [] } = Astro.props;
---

<div class="mx-auto max-w-[1312px] px-4 py-10 md:py-14">
  <div class="flex flex-col gap-10 lg:flex-row lg:gap-14 lg:items-start">

    <!-- Левая колонка: текстовый контент -->
    <div class="flex-1 min-w-0">
      {sections.map((section, i) => (
        <div class={i > 0 ? "mt-10 border-t border-slate-100 pt-10" : ""}>
          <div class="flex items-center gap-2 mb-4">
            <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
            <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
              {section.h2}
            </h2>
          </div>
          {section.text && (
            <p class="text-[16px] leading-[1.7] text-slate-600 [&_a]:text-orange-600 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-orange-700" set:html={section.text} />
          )}
          {section.list && (
            <ul class="mt-4 flex flex-col gap-2">
              {section.list.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
                  {/*
                    Элементы списка могут содержать HTML (например, ShiftLink
                    через shiftLinkHtml()) — рендерим через set:html.
                    Контент — контролируемый нами в src/pages/*, не user-generated.
                  */}
                  <span class="text-[16px] text-slate-700" set:html={item}></span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <!-- Правая колонка: карточка (sticky) -->
    <div class="lg:w-[340px] shrink-0 lg:sticky lg:top-6">
      <div class="rounded-[22px] bg-[#0d1a2b] p-6 shadow-[0_16px_48px_rgba(2,8,20,0.18)]">

        <!-- Цена -->
        <p class="text-[13px] font-semibold uppercase tracking-[0.8px] text-white/50">Стоимость</p>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="text-[36px] font-bold leading-[1] text-white">{priceFrom}</span>
        </div>
        <p class="mt-1 text-[14px] text-white/50">{priceNote}</p>

        <!-- Разделитель -->
        <div class="my-5 border-t border-white/10"></div>

        <!-- Хайлайты -->
        {highlights.length > 0 && (
          <ul class="flex flex-col gap-2.5 mb-5">
            {highlights.map((h) => (
              <li class="flex items-center gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-orange-500/20 text-[13px] text-orange-400">✓</span>
                <span class="text-[14px] text-white/80">{h}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- CTA -->
        <a
          href="#shifts"
          class="block w-full rounded-[14px] bg-[#ec7c00] px-5 py-3.5 text-center text-[15px] font-semibold text-white hover:shadow-[0_4px_16px_rgba(249,115,22,0.35)] hover:-translate-y-[1px] transition-all duration-200"
        >
          Выбрать смену
        </a>
        <a
          href="#lead-form"
          class="mt-2 block w-full rounded-[14px] border border-white/20 px-5 py-3 text-center text-[14px] text-white/70 hover:border-white/40 hover:text-white transition"
        >
          Оставить заявку
        </a>

        <!-- Гарантия -->
        <p class="mt-4 text-center text-[12px] leading-[1.5] text-white/35">
          Возврат 50% если не понравится в первые 3 дня
        </p>
      </div>

      <!-- Дополнительный блок: контакты -->
      <div class="mt-4 rounded-[18px] bg-slate-50 border border-slate-100 p-5">
        <p class="text-[13px] font-semibold text-slate-500 uppercase tracking-[0.6px]">Остались вопросы?</p>
        <a href={PHONE_MAIN_HREF} class="mt-2 flex items-center gap-2 text-[16px] font-semibold text-slate-900 hover:text-orange-600 transition">
          <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {PHONE_MAIN}
        </a>
        <p class="mt-1 text-[12px] text-slate-400">пн–вс 11:00–20:00 МСК</p>
        <div class="mt-3 flex gap-2">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener"
            class="flex-1 rounded-[10px] bg-[#25D366]/10 border border-[#25D366]/20 py-3 text-center text-[13px] font-medium text-[#1a9e4a] hover:bg-[#25D366]/20 transition">
            WhatsApp
          </a>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener"
            class="flex-1 rounded-[10px] bg-[#229ED9]/10 border border-[#229ED9]/20 py-3 text-center text-[13px] font-medium text-[#1a7fb5] hover:bg-[#229ED9]/20 transition">
            Telegram
          </a>
        </div>
      </div>
    </div>

  </div>
</div>
