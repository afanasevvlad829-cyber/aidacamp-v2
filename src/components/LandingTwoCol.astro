---
interface Props {
  sections: Array<{
    h2: string
    text: string
    list?: string[]
  }>
  /*
    priceFrom / priceNote / highlights больше не рендерятся (правый сайдбар с
    ценой и контактами убран по решению владельца 2026-07-03), но остаются в
    интерфейсе — их передают ~86 страниц, ломать вызовы не нужно.
  */
  priceFrom?: string
  priceNote?: string
  highlights?: string[]
}

const { sections } = Astro.props;
---

<div class="mx-auto max-w-[1312px] px-4 py-10 md:py-14">
  <!-- Одна колонка: текстовый контент (правый сайдбар убран) -->
  <div class="mx-auto max-w-[880px]">
    {sections.map((section, i) => (
      <div class={i > 0 ? "mt-10 border-t border-slate-100 pt-10" : ""}>
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            {section.h2}
          </h2>
        </div>
        {section.text && (
          <p class="text-[16px] leading-[1.7] text-slate-600 [&_a]:text-orange-600 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-orange-700" set:html={section.text} />
        )}
        {section.list && (
          <ul class="mt-4 flex flex-col gap-2">
            {section.list.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
                {/*
                  Элементы списка могут содержать HTML (например, ShiftLink
                  через shiftLinkHtml()) — рендерим через set:html.
                  Контент — контролируемый нами в src/pages/*, не user-generated.
                */}
                <span class="text-[16px] text-slate-700" set:html={item}></span>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</div>
