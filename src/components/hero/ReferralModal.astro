<dialog
  id="referralModal"
  class="fixed inset-0 m-auto w-[min(92vw,420px)] rounded-[20px] border-0 outline-none bg-white p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="p-6" data-glass>
    <!-- Успех -->
    <div class="text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
        <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
      </div>
      <h3 class="mt-3 text-[20px] font-bold text-slate-900">Заявка отправлена!</h3>
      <p class="mt-1 text-base text-slate-500">Свяжемся в течение 10 минут</p>
    </div>

    <!-- Мерч + аргумент -->
    <div class="mt-5 flex items-stretch gap-0 rounded-[16px] bg-emerald-50 border border-emerald-100 overflow-hidden">
      <!-- Фото на всю высоту блока -->
      <button
        type="button"
        data-gallery-open
        data-gallery-src="/images/merch-hoodie.avif"
        data-gallery-alt="Фирменная толстовка АйДаКемп"
        class="shrink-0 cursor-zoom-in hover:brightness-95 transition"
        aria-label="Посмотреть мерч"
      >
        <img
          src="/images/merch-hoodie.avif"
          alt="Фирменная толстовка АйДаКемп"
          title="Фирменная толстовка АйДаКемп — подарок за приглашённого друга"
          class="h-full w-20 object-cover object-top"
          loading="lazy" decoding="async" width="400" height="400"
        />
      </button>
      <!-- Текст -->
      <div class="px-4 py-4">
        <p class="text-base font-semibold text-slate-800 leading-[1.4]">Те, кто едет в компании, адаптируются вдвое быстрее</p>
        <p class="mt-1 text-base text-slate-500">Позовите друга — подарим фирменный мерч каждому</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <span class="inline-block rounded-full bg-emerald-100 px-2.5 py-0.5 text-[12px] font-semibold text-emerald-700">Каждая 5-я — скидка 50%</span>
          <span class="inline-block rounded-full bg-orange-100 px-2.5 py-0.5 text-[12px] font-semibold text-orange-700">Каждая 10-я — за 100 ₽</span>
        </div>
      </div>
    </div>

    <!-- Кнопка поделиться -->
    <button
      type="button"
      data-referral-copy
      class="mt-4 flex w-full items-center justify-center gap-2 rounded-[12px] bg-slate-900 px-4 py-3 text-base font-semibold text-white transition hover:bg-slate-700"
    >
      <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
      Скопировать текст для друга
    </button>

    <button
      type="button"
      data-referral-close
      class="mt-3 w-full text-center text-base text-slate-600 transition hover:text-slate-800"
    >
      Пропустить
    </button>
  </div>
</dialog>

<script is:inline>
  function initReferralModal() {
    var modal = document.getElementById('referralModal');
    if (!modal) return;

    var copyText = 'Едем в АйДаКемп этим летом! IT-лагерь в Подмосковье для детей 7–15 лет. Смотри: aidacamp.ru';

    var copyBtn = modal.querySelector('[data-referral-copy]');
    copyBtn?.addEventListener('click', function () {
      navigator.clipboard.writeText(copyText).then(function () {
        if (copyBtn) {
          copyBtn.textContent = '✓ Скопировано!';
          setTimeout(function () {
            copyBtn.innerHTML = '<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> Скопировать текст для друга';
          }, 2500);
        }
      });
    });

    modal.querySelector('[data-referral-close]')?.addEventListener('click', function () {
      modal.close();
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });

  }

  document.addEventListener('astro:page-load', initReferralModal);
  // Defer — модалка не нужна до взаимодействия, не должна блокировать LCP
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initReferralModal, { timeout: 2000 });
  } else {
    setTimeout(initReferralModal, 200);
  }
</script>
