---
import { STAT_YEARS, STAT_KIDS, STAT_RATING, STAT_DISTANCE, STAT_RETURN, CAMP_PRICE_FROM, YANDEX_MAPS_URL, CAMP_SEASON } from '../../data/contacts';
import DualRatingPill from '../DualRatingPill.astro';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-desktop', hasVariants = false } = Astro.props;
---

<!-- ===== DESKTOP HERO — TRUST VARIANT ===== -->
<!-- Стратегия (на основе портрета клиента): -->
<!-- ВСЁ кликабельное остаётся — это контроль темпа Дарьи и закрытие топ-болей. -->
<!-- Меняем только визуальную иерархию: CTA «Смены 2026» доминирует, -->
<!-- бейджи / печать / чип статьи остаются интерактивными, но контраст ниже. -->
<!-- + Каждый клик — микро-цель в Метрике (data-goal). -->
<div class="relative hidden h-[520px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
  <picture>
    <source type="image/avif" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-768.avif 768w, ${imageSrc}-1080.avif 1080w, ${imageSrc}-1440.avif 1440w, ${imageSrc}.avif 1440w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w, ${imageSrc}.webp 1536w` : `${imageSrc}.webp`} />
    <img
      src={`${imageSrc}.webp`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="560"
    />
  </picture>

  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.78)_0%,rgba(5,9,18,0.62)_26%,rgba(5,9,18,0.34)_48%,rgba(5,9,18,0.12)_66%,rgba(5,9,18,0.02)_82%,rgba(5,9,18,0)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(140%_120%_at_50%_50%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.12)_84%,rgba(0,0,0,0.24)_100%)] mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(236,155,68,0.09)_0%,rgba(236,155,68,0.04)_30%,rgba(236,155,68,0)_62%)] mix-blend-soft-light"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
  </div>

  <div class="absolute left-16 top-[78px] z-30">
    <div class="flex items-center gap-x-3 text-[14px] text-white/50 whitespace-nowrap">
      <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" data-goal="hero_geo_link" class="flex items-center gap-1 hover:text-white/80 transition-colors">
        <i class="bi bi-geo-alt text-[12px]" aria-hidden="true"></i>
        {STAT_DISTANCE} от Москвы
      </a>
      <span class="text-white/20">·</span>
      <a href="#shifts" data-goal="hero_season_link" class="hover:text-white/80 transition-colors">смены {CAMP_SEASON}</a>
      <span class="text-white/20">·</span>
      <button type="button" data-shift-link="shift-2-1" data-goal="hero_price_link" class="hover:text-white/80 transition-colors cursor-pointer">
        от {CAMP_PRICE_FROM}
      </button>
    </div>

    <h1
      id="hero-title"
      class="mt-2 w-[700px] text-[44px] font-bold leading-[52px] tracking-[-0.03em] text-white [text-shadow:0px_4px_12px_rgba(0,0,0,0.35)]"
    >
      Детский IT-лагерь в&nbsp;Подмосковье 2026 — для детей 7–15 лет
    </h1>
    <p id="hero-subtitle" class="mt-2 text-[15px] text-white/90">Каждый уедет с проектом и новыми друзьями.</p>
    <p class="mt-1 text-[15px] text-white/90">Вам — 14 дней для себя.</p>

    <!-- Бейджи: КЛИКАБЕЛЬНЫЕ (закрывают топ-боль «что будет делать ребёнок» — 239 упом.) -->
    <!-- Чуть тише фон (white/15 vs white/22), но при hover вспыхивают -->
    <div id="hero-badges" class="mt-3 flex gap-2">
      <button type="button" data-feature="python" data-goal="hero_badge_python" class="flex h-[26px] items-center rounded-full bg-white/15 hover:bg-white/30 px-3 text-[14px] text-white/80 hover:text-white cursor-pointer transition-colors">Python</button>
      <button type="button" data-feature="minecraft" data-goal="hero_badge_minecraft" class="flex h-[26px] items-center rounded-full bg-white/15 hover:bg-white/30 px-3 text-[14px] text-white/80 hover:text-white cursor-pointer transition-colors">Minecraft</button>
      <button type="button" data-feature="ai" data-goal="hero_badge_ai" class="flex h-[26px] items-center rounded-full bg-white/15 hover:bg-white/30 px-3 text-[14px] text-white/80 hover:text-white cursor-pointer transition-colors">AI</button>
      <button type="button" data-feature="pool" data-goal="hero_badge_pool" class="flex h-[26px] items-center rounded-full bg-white/15 hover:bg-white/30 px-3 text-[14px] text-white/80 hover:text-white cursor-pointer transition-colors">Бассейн</button>
    </div>

    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] text-white/50">
      <DualRatingPill
        yandexRating={STAT_RATING}
        yandexUrl={YANDEX_MAPS_URL}
        incampRating={4.8}
        variant="hero"
        size="sm"
        yandexGoal="hero_yandex_rating"
        incampGoal="hero_incamp_rating"
      />
      <span>·</span>
      <span>{STAT_YEARS} лет работы</span>
      <span>·</span>
      <span>{STAT_KIDS} детей</span>
    </p>

    <div class="mt-5 flex items-center gap-4">
      <!-- ГЛАВНАЯ CTA — крупнее, ярче shadow, чуть больше padding -->
      <a
        href="#shifts"
        data-goal="hero_main_cta"
        class="inline-flex items-center gap-2 rounded-[14px] border border-orange-400/50 bg-primary/12 px-7 py-3.5 text-[16px] font-semibold text-orange-200 transition-colors duration-150 hover:bg-primary/20 hover:border-orange-400/70"
      >
        Смены 2026
        <i class="bi bi-chevron-down text-[18px]" aria-hidden="true"></i>
      </a>

      <!-- Печать «Ноутбук не нужен» — кликабельная (закрывает страх «что брать»), -->
      <!-- но контраст тише и без вращения, чтобы не воровать клик у CTA -->
      <button
        type="button"
        id="equipment-stamp"
        data-goal="hero_nophone_stamp"
        aria-label="Ноутбук не нужен — почему?"
        class="select-none cursor-pointer group hover:scale-[1.04] transition-transform duration-200 shrink-0 relative z-30"
      >
        <div class="relative flex h-[100px] w-[100px] items-center justify-center rounded-full border-[2px] border-dashed border-white/40 group-hover:border-white/70 transition-colors">
          <div class="absolute inset-[7px] rounded-full border border-white/20 group-hover:border-white/40 transition-colors"></div>
          <div class="flex flex-col items-center gap-0.5 px-3 text-center">
            <i class="bi bi-laptop text-[22px] leading-none text-white/90" aria-hidden="true"></i>
            <span class="mt-1 text-[8.5px] font-black uppercase tracking-[0.16em] text-white/90 leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-white/40"></div>
            <span class="mt-1 text-[7.5px] font-semibold uppercase tracking-[0.1em] text-white/65 leading-[1.4]">всё есть</span>
          </div>
        </div>
      </button>
    </div>
  </div>

  <!-- Чип «ИИ заменит программистов» — оставлен (закрывает долгосрочное сомнение), -->
  <!-- но позиция и контраст слегка сдержаны: тоньше border, темнее фон -->
  <a
    href="/stati/ii-zamenit-programmista"
    data-goal="hero_ai_article"
    class="absolute right-6 bottom-[60px] z-20 inline-flex items-center gap-2 rounded-full bg-black/45 backdrop-blur-sm border border-white/15 px-3 py-1.5 text-[13px] text-white/75 hover:bg-black/65 hover:text-white transition-all duration-200 group"
  >
    <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/85 text-[9px] font-bold text-white">?</span>
    <span>«ИИ заменит программистов» — правда или реклама?</span>
    <i class="bi bi-chevron-right shrink-0 opacity-60 group-hover:translate-x-0.5 transition-transform text-[12px]" aria-hidden="true"></i>
  </a>

  <!-- Scroll hint оставлен (повторяющийся trust-сигнал «там ещё есть») -->
  <a href="#shifts" data-goal="hero_scroll_hint" aria-label="Смотреть смены" class="absolute bottom-[52px] left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-1 opacity-40 hover:opacity-90 transition-opacity duration-300 group">
    <i class="bi bi-chevron-down text-white text-[24px]" aria-hidden="true"></i>
  </a>

  <!-- Bottom info bar — социальное подтверждение + цена upfront -->
  <div class="absolute bottom-0 inset-x-0 z-20 border-t border-white/8 bg-black/25 backdrop-blur-sm">
    <div class="mx-auto max-w-[1312px] px-6 py-2.5">
      <a href="#shifts" data-goal="hero_bottom_bar" class="block text-[14px] text-white/55 text-center leading-relaxed hover:text-white/75 transition-colors">
        от {CAMP_PRICE_FROM} за 7 дней · {STAT_RETURN} возвращаются снова · проживание, питание, программа включены · Трансфер — опция
      </a>
    </div>
  </div>
</div>

<!-- Универсальный трекер микроцелей: data-goal="..." → ym('reachGoal', 'hero_…') -->
<script is:inline>
(function() {
  document.addEventListener('click', function(e) {
    var el = e.target.closest('[data-goal]');
    if (!el) return;
    var goal = el.getAttribute('data-goal');
    if (goal && typeof window.ym === 'function') {
      try { window.ym(96499295, 'reachGoal', goal); } catch (_) {}
    }
  });
})();
</script>
