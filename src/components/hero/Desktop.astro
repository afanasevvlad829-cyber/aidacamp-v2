---
import { Icon } from 'astro-icon/components';
import { iconName } from '../../utils/icons';
// imports cleaned: stats/distance/price/url убраны после Variant A declutter
import { CDN } from '../../data/cdn';
import { SEASON_YEAR, upcomingShifts, shiftDatesShort, getShiftBadge } from '../../data/shifts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = `${CDN}/images/hero-desktop`, hasVariants = false } = Astro.props;

// Ближайшие смены для hero — заменили ленту AI-новостей (06.09.2026, решение владельца):
// новости уводили с сайта, а первый экран должен вести на открытые заезды.
// Берём предстоящие смены со свободными местами, максимум 3 — состав считается
// из shifts.ts, руками список не править.
const heroShiftLinks = upcomingShifts(new Date().toISOString().slice(0, 10))
  .filter((s) => s.free > 0)
  .slice(0, 3)
  .map((s) => ({
    href: `/shifts/${s.id}/`,
    dates: shiftDatesShort(s),
    name: s.name,
    badge: getShiftBadge(s),
  }));
---

<!-- ===== DESKTOP HERO ===== -->
<div class="relative hidden h-[640px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
  <picture>
    <source type="image/avif" media="(min-width: 768px)" srcset={hasVariants ? `${imageSrc}-768.avif 768w, ${imageSrc}-1080.avif 1080w, ${imageSrc}-1440.avif 1440w, ${imageSrc}.avif 1440w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(min-width: 768px)" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w, ${imageSrc}.webp 1536w` : `${imageSrc}.webp`} />
    <img
      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="560"
    />
  </picture>

  <!-- Desktop Overlays -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.88)_0%,rgba(5,9,18,0.72)_28%,rgba(5,9,18,0.32)_52%,rgba(5,9,18,0)_72%)]"></div>
    <div class="absolute top-0 left-0 right-0 h-[100px] bg-[linear-gradient(180deg,rgba(0,0,0,0.38)_0%,rgba(0,0,0,0)_100%)] pointer-events-none z-[1]"></div>
  </div>

  <!-- Desktop Text Content (Variant A declutter — без top chips и bottom bar) -->
  <div class="absolute left-16 top-[100px] z-30 max-w-[640px]">
    {/* H1 SEO — видимый, мелкий muted. До 03.05.2026 был таким же (sr-only — побочный эффект дековтера хиро). */}
    <h1
      id="hero-title"
      class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/55 leading-tight [text-shadow:0px_1px_2px_rgba(0,0,0,0.65)]"
    >
      Летний детский лагерь Подмосковье
    </h1>

    <!-- BIG CALL: главный призыв -->
    <p
      id="hero-call"
      class="mt-5 font-extrabold leading-[1.02] tracking-[-0.03em] text-white [text-shadow:0px_4px_14px_rgba(0,0,0,0.6)]"
      style="font-size: clamp(40px, 5vw, 60px);"
    >
      Пока другие на&nbsp;даче —<br>ваш сделает <span class="text-primary" style="text-shadow:none">AI-проект</span> <span class="hero-outline">или игру</span>
    </p>
    <p id="hero-subtitle" class="mt-3 text-[17px] leading-[1.5] text-white/90 [text-shadow:0px_1px_3px_rgba(0,0,0,0.6)]">
      Вам — <span class="font-bold text-white">14 дней для себя</span>.
    </p>

    <!-- Ближайшие смены — на месте бывшей ленты AI-новостей -->
    {heroShiftLinks.length > 0 && (
      <div class="hero-shifts">
        <div class="hero-shifts-label">
          <span class="hero-shifts-dot" aria-hidden="true"></span>
          <span>Идёт запись</span>
        </div>
        <div class="hero-shifts-links">
          {heroShiftLinks.map((s) => (
            <a href={s.href} class="hero-shift-link" aria-label={`${s.name}: ${s.dates}`}>
              {s.badge.kind === 'icon' && <Icon name={iconName(s.badge.icon)} class:list={['bi', s.badge.icon, 'hero-shift-ico']} aria-hidden="true" />}
              <span class="hero-shift-dates">{s.dates}</span>
              <Icon name="bi:arrow-right" class="bi bi-arrow-right hero-shift-arrow" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Chat-CTA убран из hero — мама первый раз листает, не спрашивает.
        Shifts сразу под Hero — естественный скролл. TODO: вернуть как floating-bubble после 30s сессии. */}

    {/* Proof-line перенесена под Дарью (MomStory) — концепт «proof = после слов основателя, не в hero». */}
  </div>
</div>

<script is:inline>
  // Cycling word для desktop hero anon-CTA (синхронно с mobile-версией)
  (function () {
    var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'программу', 'безопасность'];
    var i = 0;
    var el = document.getElementById('hero-bot-topic-desktop');
    if (!el) return;
    setInterval(function () {
      i = (i + 1) % topics.length;
      el.style.opacity = '0';
      setTimeout(function () {
        el.textContent = topics[i];
        el.style.opacity = '1';
      }, 180);
    }, 2200);
  })();
</script>

<style is:global>
  /* Ближайшие смены в hero — на месте бывшей карточки AI-новостей (.nj-card).
     Тёмный фон hero: полупрозрачное стекло + акцентная полоса слева, как было у ленты. */
  .hero-shifts {
    margin-top: 24px;
    max-width: 460px;
    padding-left: 12px;
    border-left: 3px solid var(--color-primary);
  }

  .hero-shifts-label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .hero-shifts-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-shifts-dot { animation: hero-shifts-pulse 1.6s ease-in-out infinite; }
  }
  @keyframes hero-shifts-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero-shifts-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-shift-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero-shift-link:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .hero-shift-ico { font-size: 13px; color: var(--color-primary); }
  .hero-shift-link:hover .hero-shift-ico { color: #fff; }

  .hero-shift-arrow { font-size: 12px; opacity: 0.55; }
  .hero-shift-link:hover .hero-shift-arrow { opacity: 1; }
</style>
