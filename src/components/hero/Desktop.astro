---
// imports cleaned: stats/distance/price/url убраны после Variant A declutter

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-desktop', hasVariants = false } = Astro.props;
---

<!-- ===== DESKTOP HERO ===== -->
<div class="relative hidden h-[520px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
  <picture>
    <source type="image/avif" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-768.avif 768w, ${imageSrc}-1080.avif 1080w, ${imageSrc}-1440.avif 1440w, ${imageSrc}.avif 1440w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w, ${imageSrc}.webp 1536w` : `${imageSrc}.webp`} />
    <img
      src={`${imageSrc}.webp`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="560"
    />
  </picture>

  <!-- Desktop Overlays -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.78)_0%,rgba(5,9,18,0.62)_26%,rgba(5,9,18,0.34)_48%,rgba(5,9,18,0.12)_66%,rgba(5,9,18,0.02)_82%,rgba(5,9,18,0)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(140%_120%_at_50%_50%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.12)_84%,rgba(0,0,0,0.24)_100%)] mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(236,155,68,0.09)_0%,rgba(236,155,68,0.04)_30%,rgba(236,155,68,0)_62%)] mix-blend-soft-light"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
  </div>

  <!-- Desktop Text Content (Variant A declutter — без top chips и bottom bar) -->
  <div class="absolute left-16 top-[110px] z-30">
    <!-- H1 + subtitle (разгружено per design system) -->
    <h1
      id="hero-title"
      class="mt-3 w-[600px] text-[48px] font-extrabold leading-[1.05] tracking-[-0.03em] text-white [text-shadow:0px_4px_12px_rgba(0,0,0,0.35)]"
    >
      Летний IT-лагерь в&nbsp;Подмосковье 2026
    </h1>
    <p id="hero-subtitle" class="mt-3 max-w-[600px] text-[17px] leading-[1.5] text-white/85 [text-shadow:0px_1px_3px_rgba(0,0,0,0.45)]">
      Для детей 7–15 лет. Пока другие на даче — ваш сделает <span class="font-semibold text-primary">AI-проект</span>. Вам — 14 дней для себя.
    </p>

    <!-- CTA: primary «Выбрать смену» + большая anon-карточка как на мобиле -->
    <div class="mt-7 flex flex-col gap-3 max-w-[560px]">
      <a
        href="#shifts"
        class="inline-flex w-fit items-center gap-2 rounded-[14px] border-[1.5px] border-primary/70 bg-primary/10 px-6 py-3 text-[15px] font-semibold text-primary backdrop-blur-sm transition-all duration-200 hover:bg-primary/20 hover:border-primary no-underline"
        data-analytics-goal="hero_cta_to_shifts"
        data-analytics-label="desktop_primary"
      >
        Выбрать смену
        <i class="bi bi-arrow-right text-[14px]" aria-hidden="true"></i>
      </a>

      <!-- Anon CTA — inline-ссылка, без оформления (per design-critique 1b) -->
      <a
        href="/ask"
        data-analytics-goal="anon_qa_click"
        data-analytics-label="hero_desktop"
        class="inline-flex items-center gap-2 text-[15px] text-white/80 hover:text-white transition-colors w-fit no-underline"
      >
        <i class="bi bi-chat-dots-fill text-[16px] text-primary" aria-hidden="true"></i>
        <span>Спросите про <span id="hero-bot-topic-desktop" class="font-semibold text-white" style="transition: opacity 0.2s;">еду</span></span>
        <i class="bi bi-arrow-right text-[13px]" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Cycling word для desktop hero anon-CTA (синхронно с mobile-версией)
  (function () {
    var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'программу', 'безопасность'];
    var i = 0;
    var el = document.getElementById('hero-bot-topic-desktop');
    if (!el) return;
    setInterval(function () {
      i = (i + 1) % topics.length;
      el.style.opacity = '0';
      setTimeout(function () {
        el.textContent = topics[i];
        el.style.opacity = '1';
      }, 180);
    }, 2200);
  })();
</script>
