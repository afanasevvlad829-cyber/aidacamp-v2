---
// imports cleaned: stats/distance/price/url убраны после Variant A declutter

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-desktop', hasVariants = false } = Astro.props;
---

<!-- ===== DESKTOP HERO ===== -->
<div class="relative hidden h-[640px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
  <picture>
    <source type="image/avif" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-768.avif 768w, ${imageSrc}-1080.avif 1080w, ${imageSrc}-1440.avif 1440w, ${imageSrc}.avif 1440w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w, ${imageSrc}.webp 1536w` : `${imageSrc}.webp`} />
    <img
      src={`${imageSrc}.webp`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="560"
    />
  </picture>

  <!-- Desktop Overlays -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.88)_0%,rgba(5,9,18,0.78)_22%,rgba(5,9,18,0.5)_42%,rgba(5,9,18,0.18)_62%,rgba(5,9,18,0.04)_82%,rgba(5,9,18,0)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(140%_120%_at_50%_50%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.12)_84%,rgba(0,0,0,0.24)_100%)] mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(236,155,68,0.09)_0%,rgba(236,155,68,0.04)_30%,rgba(236,155,68,0)_62%)] mix-blend-soft-light"></div>
    <!-- Header readability guard: top gradient 0-100px → гарантирует контраст halo-nav на любом фото -->
    <div class="absolute top-0 left-0 right-0 h-[100px] bg-[linear-gradient(180deg,rgba(0,0,0,0.45)_0%,rgba(0,0,0,0.18)_60%,rgba(0,0,0,0)_100%)] pointer-events-none z-[1]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
  </div>

  <!-- Desktop Text Content (Variant A declutter — без top chips и bottom bar) -->
  <div class="absolute left-16 top-[100px] z-30 max-w-[640px]">
    <!-- H1: SEO-only, мелкий UPPERCASE muted (большой текст ниже = главный призыв) -->
    <div class="flex items-center gap-3 flex-wrap">
      <h1
        id="hero-title"
        class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/55 leading-tight [text-shadow:0px_1px_2px_rgba(0,0,0,0.65)]"
      >
        Детский IT-лагерь в&nbsp;Подмосковье 2026
      </h1>
      <span class="text-white/30 text-[12px]" aria-hidden="true">·</span>
      <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-primary-300 [text-shadow:0px_1px_3px_rgba(0,0,0,0.6)]">
        Для детей 7–15 лет
      </p>
    </div>

    <!-- BIG CALL: главный призыв -->
    <p
      id="hero-call"
      class="mt-5 font-extrabold leading-[1.02] tracking-[-0.03em] text-white [text-shadow:0px_4px_14px_rgba(0,0,0,0.6)]"
      style="font-size: clamp(40px, 5vw, 60px);"
    >
      Пока другие на&nbsp;даче —<br>ваш сделает <span class="text-primary">AI-проект</span> или <span class="text-primary">игру</span>
    </p>
    <p id="hero-subtitle" class="mt-3 text-[17px] leading-[1.5] text-white/90 [text-shadow:0px_1px_3px_rgba(0,0,0,0.6)]">
      Вам — <span class="font-bold text-white">14 дней для себя</span>.
    </p>

    {/* Chat-CTA убран из hero — мама первый раз листает, не спрашивает.
        Shifts сразу под Hero — естественный скролл. TODO: вернуть как floating-bubble после 30s сессии. */}

    {/* Proof-line перенесена под Дарью (MomStory) — концепт «proof = после слов основателя, не в hero». */}
  </div>
</div>

<script is:inline>
  // Cycling word для desktop hero anon-CTA (синхронно с mobile-версией)
  (function () {
    var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'программу', 'безопасность'];
    var i = 0;
    var el = document.getElementById('hero-bot-topic-desktop');
    if (!el) return;
    setInterval(function () {
      i = (i + 1) % topics.length;
      el.style.opacity = '0';
      setTimeout(function () {
        el.textContent = topics[i];
        el.style.opacity = '1';
      }, 180);
    }, 2200);
  })();
</script>
