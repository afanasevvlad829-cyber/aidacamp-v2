---
import { STAT_YEARS, STAT_KIDS, STAT_RATING, STAT_DISTANCE, STAT_RETURN, CAMP_PRICE_FROM, YANDEX_MAPS_URL, CAMP_SEASON } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-desktop', hasVariants = false } = Astro.props;
---

<!-- ===== DESKTOP HERO ===== -->
<div class="relative hidden h-[520px] overflow-hidden bg-[#0f1c2e] w-full md:block md:max-w-[1440px]">
  <picture>
    <source type="image/avif" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-768.avif 768w, ${imageSrc}-1080.avif 1080w, ${imageSrc}-1440.avif 1440w, ${imageSrc}.avif 1440w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(min-width: 769px)" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w, ${imageSrc}.webp 1536w` : `${imageSrc}.webp`} />
    <img
      src={`${imageSrc}.webp`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="560"
    />
  </picture>

  <!-- Desktop Overlays -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.78)_0%,rgba(5,9,18,0.62)_26%,rgba(5,9,18,0.34)_48%,rgba(5,9,18,0.12)_66%,rgba(5,9,18,0.02)_82%,rgba(5,9,18,0)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(140%_120%_at_50%_50%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.12)_84%,rgba(0,0,0,0.24)_100%)] mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(236,155,68,0.09)_0%,rgba(236,155,68,0.04)_30%,rgba(236,155,68,0)_62%)] mix-blend-soft-light"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
  </div>

  <!-- Desktop Text Content -->
  <div class="absolute left-16 top-[78px] z-30">
    <!-- Location — кликабельные чипы -->
    <div class="flex items-center gap-x-3 text-[14px] text-white/50 whitespace-nowrap">
      <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/80 transition-colors">
        <i class="bi bi-geo-alt text-[12px]" aria-hidden="true"></i>
        {STAT_DISTANCE} от Москвы
      </a>
      <span class="text-white/20">·</span>
      <a href="#shifts" class="hover:text-white/80 transition-colors">смены {CAMP_SEASON}</a>
      <span class="text-white/20">·</span>
      <button type="button" data-shift-link="shift-2-1" class="hover:text-white/80 transition-colors cursor-pointer">
        от {CAMP_PRICE_FROM}
      </button>
    </div>
    <!-- H1 + subtitle (разгружено per design system) -->
    <h1
      id="hero-title"
      class="mt-3 w-[700px] text-[48px] font-extrabold leading-[1.05] tracking-[-0.03em] text-white [text-shadow:0px_4px_12px_rgba(0,0,0,0.35)]"
    >
      Летний IT-лагерь в&nbsp;Подмосковье 2026 — для детей 7–15 лет
    </h1>
    <p id="hero-subtitle" class="mt-3 max-w-[600px] text-[17px] leading-[1.5] text-white/85 [text-shadow:0px_1px_3px_rgba(0,0,0,0.45)]">
      Пока другие на даче — ваш сделает <span class="font-semibold text-primary">AI-проект</span>. Вам — 14 дней для себя.
    </p>

    <!-- CTA: главный (primary) + anon (ghost) -->
    <div class="mt-7 flex items-center gap-3">
      <button
        type="button"
        data-shift-link="shift-2-1"
        class="inline-flex items-center gap-2 rounded-[14px] bg-primary px-6 py-3.5 text-[15px] font-semibold text-[#1e2430] transition-all duration-200 hover:shadow-[0_4px_16px_rgba(236,155,68,0.45)] hover:-translate-y-[1px]"
        data-analytics-goal="hero_cta_shifts"
      >
        Выбрать смену
        <i class="bi bi-arrow-right text-[14px]" aria-hidden="true"></i>
      </button>

      <a
        href="/ask"
        data-analytics-goal="anon_qa_click"
        data-analytics-label="hero_desktop"
        class="inline-flex items-center gap-2 rounded-[14px] border border-white/30 bg-white/5 px-5 py-3.5 text-[15px] font-medium text-white/90 backdrop-blur-sm transition hover:bg-white/10 hover:border-white/50"
      >
        <i class="bi bi-shield-lock-fill text-[14px] text-primary" aria-hidden="true"></i>
        Спросите анонимно
      </a>
    </div>
  </div>

  <!-- Desktop Bottom Info Bar -->
  <div class="absolute bottom-0 inset-x-0 z-20 border-t border-white/8 bg-black/25 backdrop-blur-sm">
    <div class="mx-auto max-w-[1312px] px-6 py-2.5">
      <a href="#shifts" class="block text-[14px] text-white/55 text-center leading-relaxed hover:text-white/75 transition-colors">
        от {CAMP_PRICE_FROM} за 7 дней · {STAT_RETURN} возвращаются снова · проживание, питание, программа включены · Трансфер — опция
      </a>
    </div>
  </div>
</div>
