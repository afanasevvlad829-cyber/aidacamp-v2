---
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — SINGLE-PHOTO continuous (no hard edge) ===== -->
<div class="relative w-full md:hidden overflow-hidden bg-dark-navy" style="padding-top: env(safe-area-inset-top); min-height: 95svh;">

  <!-- ─── ОДНА фото-подложка на ВЕСЬ hero ─── -->
  <picture>
    <source type="image/avif" srcset={hasVariants ? `${imageSrc}.avif 390w, ${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" srcset={hasVariants ? `${imageSrc}.webp 390w, ${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} sizes="100vw" />
    <img
      src={`${imageSrc}.webp`}
      alt="Дети на занятии в IT-лагере АйДаКемп"
      class="absolute inset-0 h-full w-full object-cover"
      style="filter: saturate(0.92) brightness(0.95); object-position: center 25%;"
      loading="eager"
      fetchpriority="high"
      width="390"
      height="800"
    />
  </picture>

  <!-- ─── ЕДИНЫЙ continuous overlay — overlay усилен в зоне tagline для читаемости ─── -->
  <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg,
    rgba(6,10,18,0.35) 0%,
    rgba(6,10,18,0.10) 8%,
    transparent 18%,
    transparent 35%,
    rgba(13,26,43,0.25) 45%,
    rgba(13,26,43,0.55) 52%,
    rgba(13,26,43,0.65) 60%,
    rgba(13,26,43,0.80) 72%,
    rgba(13,26,43,0.90) 85%,
    rgba(13,26,43,0.93) 100%
  );"></div>

  <!-- ─── ВЕСЬ КОНТЕНТ ─── -->
  <div class="relative z-10 flex flex-col min-h-[95svh]">

    <!-- H1 — premium size, теперь работает (mobile-ux-p0 в @layer base) -->
    <div class="px-5 pt-20">
      <h1
        id="hero-title-mobile"
        class="font-extrabold leading-[1.02] tracking-[-0.045em] text-white"
        style="font-size: 44px; text-shadow: 0 2px 6px rgba(0,0,0,0.75), 0 1px 2px rgba(0,0,0,0.95);"
      >
        Детский <span class="text-primary">IT-лагерь</span><br>в&nbsp;Подмосковье 2026
      </h1>
      <p class="mt-3 text-[16px] font-semibold text-white/90 tracking-[0.02em] uppercase" style="text-shadow: 0 1px 3px rgba(0,0,0,0.7); letter-spacing: 0.06em;">
        Для детей 7–15 лет
      </p>
    </div>

    <!-- Spacer — оставляет место для photo subject (boy + bean bag) -->
    <div class="flex-1 min-h-[40vh]"></div>

    <!-- Контент — на затемнённой нижней части photo, читается через text-shadow + dark overlay -->
    <div class="px-5 pb-8">

      <!-- Tagline — компактно, 2 строки -->
      <p class="leading-[1.35] text-white text-center mb-4" style="font-size: 17px; font-weight: 500; text-shadow: 0 2px 6px rgba(0,0,0,0.85), 0 1px 2px rgba(0,0,0,0.95);">
        Пока другие на даче — <span style="font-weight: 700;">ваш сделает <span class="text-primary" style="font-weight: 700; text-shadow: 0 2px 6px rgba(0,0,0,0.95), 0 1px 2px rgba(0,0,0,0.95);">AI-проект</span></span>.<br />
        Вам — <span style="font-weight: 700;">14 дней для себя</span>.
      </p>

      <!-- Price + Programa — borders only -->
      <div class="flex items-stretch border-t border-b border-white/15 -mx-5">
        <a href="#shifts" data-analytics-goal="hero_cta_to_shifts" data-analytics-label="mobile_price"
          class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/[0.05] transition-colors no-underline">
          <span class="text-[26px] font-extrabold text-white leading-none tabular-nums" style="text-shadow: 0 1px 3px rgba(0,0,0,0.5);">от {CAMP_PRICE_FROM}</span>
          <span class="text-[12px] text-white/75 leading-none uppercase tracking-wider mt-1.5">за 7 дней</span>
        </a>
        <div class="w-px bg-white/15 my-3"></div>
        <a href="#journey"
          class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/[0.05] transition-colors">
          <span class="text-[16px] font-semibold text-white leading-none">Программирование</span>
          <span class="text-[12px] text-white/75 leading-none mt-1.5">AI · Бассейн</span>
        </a>
      </div>

      <!-- БОТ CTA — 2-строчная структура, cycling word на отдельной строке -->
      <a
        href="https://aidacamp.ru/ask"
        data-analytics-goal="bot_click"
        class="hero-bot-cta mt-6 flex items-center gap-3.5 rounded-2xl bg-primary py-4 px-5 active:opacity-90 transition-opacity"
      >
        <i class="bi bi-chat-dots-fill hero-bot-icon text-[32px] text-white shrink-0" aria-hidden="true"></i>
        <div class="flex flex-col text-left flex-1 min-w-0">
          <span class="text-[12px] font-semibold text-white/85 uppercase tracking-wider leading-tight">Спросите про</span>
          <span
            id="hero-bot-topic"
            class="text-[18px] font-bold text-white leading-tight mt-0.5 truncate"
            style="font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s;"
          >лагерь</span>
          <span class="mt-1 flex items-center gap-1.5 text-[11px] text-white/85 leading-tight">
            <i class="bi bi-shield-lock-fill text-[10px]" aria-hidden="true"></i>
            Анонимно, без регистрации
          </span>
        </div>
        <i class="bi bi-arrow-right text-[22px] text-white shrink-0" aria-hidden="true"></i>
      </a>

      <!-- Stats inline — text only, centered -->
      <div class="mt-6 text-center">
        <p class="text-[14px] text-white/90 leading-relaxed" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
          <span class="font-semibold tabular-nums">{STAT_YEARS} лет</span>
          <span class="text-white/35 mx-2">·</span>
          <span class="font-semibold tabular-nums">{STAT_KIDS} детей</span>
        </p>
        <p class="text-[14px] text-white/90 leading-relaxed mt-1" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
          <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" data-goal="mobile_hero_yandex_rating" class="font-semibold text-amber-300">★ {STAT_RATING}</a>
          <span class="text-white/65 ml-1">Яндекс</span>
          <span class="text-white/35 mx-2">·</span>
          <a href="https://incamp.ru/camps/339484/" target="_blank" rel="noopener" data-goal="mobile_hero_incamp_rating" class="font-semibold text-amber-300">★ 4.8</a>
          <span class="text-white/65 ml-1">inCamp</span>
        </p>
        <p class="text-[14px] text-white/90 leading-relaxed mt-1" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
          <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="font-bold text-primary">ТОП-4</a>
          <span class="text-white/65 ml-1">IT-лагерей МО · vc.ru</span>
        </p>
      </div>

      <!-- Trust inline -->
      <div class="mt-5 flex items-center justify-center gap-4 text-[12px] text-white/80" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
        <a href="/stati/dokumenty-licenziya-strahovka/#licenziya"
          class="flex items-center gap-1 hover:text-white transition-colors">
          <i class="bi bi-patch-check-fill text-[12px]" aria-hidden="true"></i>
          <span>Лицензия</span>
        </a>
        <span class="text-white/30">·</span>
        <a href="/stati/dokumenty-licenziya-strahovka/#medsestra"
          class="flex items-center gap-1 hover:text-white transition-colors">
          <i class="bi bi-heart-pulse-fill text-[12px]" aria-hidden="true"></i>
          <span>Медсестра 24/7</span>
        </a>
        <span class="text-white/30">·</span>
        <a href="/stati/dokumenty-licenziya-strahovka/#strahovka"
          class="flex items-center gap-1 hover:text-white transition-colors">
          <i class="bi bi-shield-check text-[12px]" aria-hidden="true"></i>
          <span>Страховка</span>
        </a>
      </div>
    </div>

  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<style>
  /* Pulse contained — НЕ blow на photo: только icon scale, без box-shadow */
  @keyframes hero-bot-icon-pulse {
    0%, 92%, 100% { transform: scale(1); }
    96% { transform: scale(1.12); }
  }
  .hero-bot-icon { animation: hero-bot-icon-pulse 4.5s ease-in-out infinite; transform-origin: center; display: inline-block; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #hero-title-mobile { animation: hero-fade-up 0.6s ease-out 0.1s both; }
  @media (prefers-reduced-motion: reduce) {
    .hero-bot-cta, .hero-bot-icon, #hero-title-mobile { animation: none !important; }
  }
</style>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'минусы', 'косяки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0.3';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
    }, 200);
  }, 2200);
})();
</script>
