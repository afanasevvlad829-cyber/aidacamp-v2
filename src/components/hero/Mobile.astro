---
import LeadForm from '../LeadForm.astro';
import DualRatingPill from '../DualRatingPill.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, STAT_DISTANCE, STAT_RETURN, CAMP_PRICE_FROM, YANDEX_MAPS_URL, CAMP_SEASON, TELEGRAM_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO ===== -->
<div class="relative w-full bg-dark-navy md:hidden min-h-[95svh] flex flex-col">
  <!-- Photo with gradient fade to dark -->
  <div class="relative flex-1 min-h-[52vw]">
    <picture>
      <source type="image/avif" srcset={hasVariants ? `${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} />
      <source type="image/webp" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} />
      <img
        src={`${imageSrc}.webp`}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover object-[center_35%]"
        loading="eager"
        fetchpriority="high"
        width="390"
        height="441"
      />
    </picture>
    <!-- Side gradient -->
    <div class="absolute inset-0 bg-[linear-gradient(92deg,rgba(6,10,18,0.72)_0%,rgba(6,10,18,0.46)_42%,rgba(6,10,18,0.2)_70%,rgba(6,10,18,0.06)_100%)]"></div>
    <!-- Bottom fade to dark — плавный переход -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_0%,transparent_50%,rgba(13,26,43,0.35)_72%,#0d1a2b_100%)]"></div>

    <!-- Text over photo -->
    <div class="absolute bottom-8 left-5 right-5">
      <!-- Tagline pill -->
      <div class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-orange-400/40 bg-orange-500/15 px-3 py-1 backdrop-blur-sm">
        <span class="text-[13px] font-semibold leading-tight text-orange-300">Пока другие на даче — ваш сделает AI-проект</span>
      </div>
      <h1
        id="hero-title-mobile"
        class="text-[36px] font-bold leading-[1.1] tracking-[-0.03em] text-white [text-shadow:0px_2px_10px_rgba(0,0,0,0.45)]"
      >
        Летний IT-лагерь в&nbsp;Подмосковье 2026 — для детей 7–15 лет
      </h1>
      <p id="hero-subtitle-mobile" class="mt-2.5 text-[15px] text-white/90">
        Вам — 14 дней для себя.
      </p>
    </div>
  </div>

  <!-- Два отдельных блока: цена + обратный звонок -->
  <div class="mx-4 mt-4 flex gap-2">
    <button type="button" data-shift-link="shift-2-1" class="flex-1 min-h-[44px] rounded-[12px] bg-orange-500/20 border border-orange-400/40 px-4 py-2 text-center active:bg-orange-500/30 transition-colors flex flex-col items-center justify-center">
      <span class="text-[16px] font-semibold text-orange-300">от {CAMP_PRICE_FROM}</span>
      <span class="text-[12px] text-orange-300/65">за 7 дней</span>
    </button>
    <a href="#journey" class="flex-1 rounded-[12px] bg-white/10 border border-white/15 px-4 py-2 text-[13px] text-white/85 text-center leading-[1.25] flex flex-col justify-center active:bg-white/15 transition-colors">
      <span>Программирование</span>
      <span class="text-white/65">AI · Бассейн</span>
    </a>
  </div>

  <!-- 2×2 грид: бот + статистика / рейтинги + топ-4 -->
  <div class="mx-4 mt-3 grid grid-cols-2 gap-2">

    <!-- Бот CTA с крутящимся текстом -->
    <a
      href="https://aidacamp.ru/ask"
      data-analytics-goal="bot_click"
      class="rounded-[12px] bg-orange-500/12 border border-orange-400/40 flex flex-col items-center justify-center px-3 py-3 text-center gap-1 active:bg-orange-500/22 transition-colors"
    >
      <div class="flex items-center gap-1.5">
        <i class="bi bi-telegram text-[15px] text-orange-300" aria-hidden="true"></i>
        <span class="text-[13px] font-semibold text-orange-200">Спросите про</span>
      </div>
      <span
        id="hero-bot-topic"
        class="text-[13px] font-bold text-orange-400"
        style="font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s, transform 0.2s;"
      >лагерь</span>
    </a>

    <!-- Статистика (зеркало рейтингов) -->
    <div class="rounded-[12px] bg-white/8 overflow-hidden flex flex-col justify-center">
      <a href="#team" class="flex items-center gap-2 px-3 py-2 active:bg-white/5 transition-colors">
        <span class="text-[22px] font-bold leading-none text-white">{STAT_YEARS}</span>
        <span class="text-[12px] text-white/55 leading-tight">лет работы</span>
      </a>
      <div class="h-px bg-white/15 mx-3"></div>
      <a href="#gallery" class="flex items-center gap-2 px-3 py-2 active:bg-white/5 transition-colors">
        <span class="text-[20px] font-bold leading-none text-white">{STAT_KIDS}</span>
        <span class="text-[12px] text-white/55 leading-tight">детей отдохнули</span>
      </a>
    </div>

    <!-- Рейтинги стопкой -->
    <div class="flex items-stretch rounded-[12px] bg-white/8 overflow-hidden">
      <DualRatingPill
        yandexRating={STAT_RATING}
        yandexUrl={YANDEX_MAPS_URL}
        incampRating={4.8}
        variant="hero"
        size="md"
        stacked={true}
        yandexGoal="mobile_hero_yandex_rating"
        incampGoal="mobile_hero_incamp_rating"
      />
    </div>

    <!-- ТОП-4 -->
    <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="rounded-[12px] bg-white/8 px-2 py-4 text-center active:bg-white/15 transition-colors">
      <div class="text-[22px] font-bold leading-none text-amber-300">ТОП-4</div>
      <div class="mt-1.5 text-[12px] leading-tight text-white">IT-лагерей МО · vc.ru</div>
    </a>

  </div>

  <!-- Trust-строка — лицензия / медсестра / страховка в одну линию -->
  <div class="mx-4 mt-3 mb-6 flex items-center justify-center gap-4">
    <a href="/stati/dokumenty-licenziya-strahovka/#licenziya" class="flex items-center gap-1 text-[12px] text-white/45 hover:text-white/65 transition-colors active:text-white/65">
      <i class="bi bi-patch-check-fill text-[11px]" aria-hidden="true"></i>
      <span>Лицензия</span>
    </a>
    <span class="text-white/20">·</span>
    <a href="/stati/dokumenty-licenziya-strahovka/#medsestra" class="flex items-center gap-1 text-[12px] text-white/45 hover:text-white/65 transition-colors active:text-white/65">
      <i class="bi bi-heart-pulse-fill text-[11px]" aria-hidden="true"></i>
      <span>Медсестра 24/7</span>
    </a>
    <span class="text-white/20">·</span>
    <a href="/stati/dokumenty-licenziya-strahovka/#strahovka" class="flex items-center gap-1 text-[12px] text-white/45 hover:text-white/65 transition-colors active:text-white/65">
      <i class="bi bi-shield-check text-[11px]" aria-hidden="true"></i>
      <span>Страховка</span>
    </a>
  </div>

  <!-- Form area — hidden initially, auto-reveals after 30s or on CTA tap -->

  <div
    id="hero-booking-block"
    class="bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  >
    <!-- White card with form -->
    <LeadForm variant="mobile" />
  </div>
</div>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'недостатки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0';
    el.style.transform = 'translateY(5px)';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 180);
  }, 2200);
})();
</script>
