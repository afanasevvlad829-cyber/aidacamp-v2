---
import DualRatingPill from '../DualRatingPill.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — clean magazine layout: photo + content separate ===== -->
<div class="relative w-full md:hidden bg-dark-navy flex flex-col overflow-hidden" style="padding-top: env(safe-area-inset-top);">

  <!-- ── ФОТО-ЗОНА: 58vh, photo + только H1 над небом ── -->
  <div class="relative w-full" style="height: 58vh; min-height: 460px; max-height: 580px;">
    <picture>
      <source type="image/avif" srcset={hasVariants ? `${imageSrc}.avif 390w, ${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} sizes="100vw" />
      <source type="image/webp" srcset={hasVariants ? `${imageSrc}.webp 390w, ${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} sizes="100vw" />
      <img
        src={`${imageSrc}.webp`}
        alt="Дети на занятии в IT-лагере АйДаКемп"
        class="absolute inset-0 h-full w-full object-cover"
        style="filter: saturate(0.92) brightness(0.95); object-position: center 25%;"
        loading="eager"
        fetchpriority="high"
        width="390"
        height="800"
      />
    </picture>

    <!-- Glass-strip за навбаром -->
    <div class="absolute top-0 inset-x-0 h-[88px] bg-[linear-gradient(180deg,rgba(6,10,18,0.55)_0%,rgba(6,10,18,0.20)_60%,transparent_100%)] backdrop-blur-[2px] z-[5] pointer-events-none"></div>

    <!-- Soft fade-out снизу к контентной зоне -->
    <div class="absolute bottom-0 inset-x-0 h-32 bg-[linear-gradient(180deg,transparent_0%,rgba(13,26,43,0.50)_50%,#0d1a2b_100%)] pointer-events-none"></div>

    <!-- H1 — вверху над небом (safe zone, лицо чисто) — крупнее -->
    <div class="absolute top-0 inset-x-0 px-5 pt-20 z-10">
      <h1
        id="hero-title-mobile"
        class="text-[42px] font-extrabold leading-[1.04] tracking-[-0.04em] text-white"
        style="text-shadow: 0 1px 2px rgba(0,0,0,0.9), 0 2px 14px rgba(0,0,0,0.7);"
      >
        Летний IT-лагерь в&nbsp;Подмосковье <span class="text-white/95">2026</span>
      </h1>
      <p class="mt-2 text-[17px] font-medium text-white/85 tracking-wide" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7);">
        Для детей 7–15 лет
      </p>
    </div>
  </div>

  <!-- ── КОНТЕНТНАЯ ЗОНА: чистый dark-navy, всё дышит ── -->
  <div class="relative bg-dark-navy px-4 pt-6 pb-24">

    <!-- Tagline — bumped sizes -->
    <div class="text-center mb-7">
      <p class="text-[18px] leading-[1.45] text-white/70">Пока другие на даче —</p>
      <p class="mt-1 text-[22px] leading-[1.25] font-bold text-white">
        ваш сделает <span class="text-primary">AI-проект</span>
      </p>
      <p class="mt-4 text-[17px] leading-[1.4] text-white/65">Вам — 14 дней для себя</p>
    </div>

    <!-- Цена + программа: bumped -->
    <div class="flex items-stretch border-y border-white/10">
      <button type="button" data-shift-link="shift-2-1"
        class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/5 transition-colors">
        <span class="text-[26px] font-extrabold text-white leading-tight tabular-nums">от {CAMP_PRICE_FROM}</span>
        <span class="text-[12px] text-white/60 leading-tight uppercase tracking-wider">за 7 дней</span>
      </button>
      <div class="w-px bg-white/12 my-3"></div>
      <a href="#journey"
        class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/5 transition-colors">
        <span class="text-[17px] font-semibold text-white leading-tight">Программирование</span>
        <span class="text-[13px] text-white/65 leading-tight">AI · Бассейн</span>
      </a>
    </div>

    <!-- БОТ — primary CTA, full-width, БОЛЬШЕ -->
    <a
      href="https://aidacamp.ru/ask"
      data-analytics-goal="bot_click"
      class="hero-bot-cta mt-6 flex items-center justify-center gap-4 rounded-2xl bg-primary/15 border border-primary/40 py-5 px-5 active:bg-primary/25 transition-colors"
    >
      <i class="bi bi-telegram hero-bot-icon text-[34px] text-primary" aria-hidden="true" style="filter: drop-shadow(0 0 10px rgba(245,166,36,0.55));"></i>
      <div class="flex flex-col text-left">
        <span class="text-[13px] font-medium text-white/75 uppercase tracking-wider leading-tight">Спросите бота про</span>
        <span
          id="hero-bot-topic"
          class="text-[20px] font-bold text-primary leading-tight"
          style="font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s, transform 0.2s;"
        >лагерь</span>
      </div>
      <i class="bi bi-arrow-right ml-auto text-[24px] text-primary" aria-hidden="true"></i>
    </a>

    <!-- Stats / Rating / Top-4 — bumped -->
    <div class="mt-3 grid grid-cols-3 gap-2">
      <a href="#about" class="flex flex-col items-center justify-center text-center py-4 rounded-xl bg-white/[0.04] border border-white/10 active:bg-white/8 transition-colors">
        <span class="text-[22px] font-extrabold text-white leading-none tabular-nums">{STAT_YEARS}</span>
        <span class="text-[11px] text-white/65 uppercase tracking-wider mt-1">лет</span>
        <span class="text-[11px] text-white/50 mt-0.5">{STAT_KIDS} детей</span>
      </a>

      <div class="flex items-stretch rounded-xl bg-white/[0.04] border border-white/10 overflow-hidden">
        <DualRatingPill
          yandexRating={STAT_RATING}
          yandexUrl={YANDEX_MAPS_URL}
          incampRating={4.8}
          variant="hero"
          size="md"
          stacked={true}
          reverseOrder={true}
          yandexGoal="mobile_hero_yandex_rating"
          incampGoal="mobile_hero_incamp_rating"
        />
      </div>

      <a
        href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove"
        target="_blank" rel="noopener"
        class="flex flex-col items-center justify-center text-center py-4 rounded-xl bg-white/[0.04] border border-white/10 active:bg-white/8 transition-colors"
      >
        <span class="text-[22px] font-extrabold text-white leading-none">ТОП-4</span>
        <span class="text-[11px] text-white/65 uppercase tracking-wider mt-1">МО</span>
        <span class="text-[11px] text-white/50 mt-0.5">vc.ru</span>
      </a>
    </div>

    <!-- Trust — bumped -->
    <div class="mt-6 flex items-center justify-center gap-3">
      <a href="/stati/dokumenty-licenziya-strahovka/#licenziya"
        class="flex items-center gap-1.5 text-[13px] text-white/65 hover:text-white/85 transition-colors">
        <i class="bi bi-patch-check-fill text-[13px]" aria-hidden="true"></i>
        <span>Лицензия</span>
      </a>
      <span class="text-white/25">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#medsestra"
        class="flex items-center gap-1.5 text-[13px] text-white/65 hover:text-white/85 transition-colors">
        <i class="bi bi-heart-pulse-fill text-[13px]" aria-hidden="true"></i>
        <span>Медсестра 24/7</span>
      </a>
      <span class="text-white/25">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#strahovka"
        class="flex items-center gap-1.5 text-[13px] text-white/65 hover:text-white/85 transition-colors">
        <i class="bi bi-shield-check text-[13px]" aria-hidden="true"></i>
        <span>Страховка</span>
      </a>
    </div>
  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<style>
  /* PREMIUM: Bot pulse */
  @keyframes hero-bot-pulse {
    0%, 92%, 100% {
      box-shadow: 0 0 0 0 rgba(245,166,36,0);
    }
    96% {
      box-shadow: 0 0 0 4px rgba(245,166,36,0.2);
    }
  }
  .hero-bot-cta { animation: hero-bot-pulse 4.5s ease-in-out infinite; }
  @keyframes hero-bot-icon-pulse {
    0%, 92%, 100% { transform: scale(1); }
    96% { transform: scale(1.1); }
  }
  .hero-bot-icon { animation: hero-bot-icon-pulse 4.5s ease-in-out infinite; transform-origin: center; display: inline-block; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #hero-title-mobile { animation: hero-fade-up 0.6s ease-out 0.1s both; }
  @media (prefers-reduced-motion: reduce) {
    .hero-bot-cta, .hero-bot-icon, #hero-title-mobile { animation: none !important; }
  }
</style>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'недостатки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0';
    el.style.transform = 'translateY(5px)';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 180);
  }, 2200);
})();
</script>
