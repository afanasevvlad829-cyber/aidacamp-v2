---
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — CSS placeholder → async photo crossfade ===== -->
<!-- LCP = heading text (instant), hero-фото грузится в фоне через preload + JS-инжект -->
<div id="hero-mobile-root" class="relative w-full md:hidden overflow-hidden bg-dark-navy" style="padding-top: env(safe-area-inset-top); min-height: 95svh;">

  <!-- ─── PHOTO: инжектируется JS-ом после DOMContentLoaded с opacity crossfade ─── -->
  <!-- bg-dark-navy (#060a12) — CSS-плейсхолдер, виден пока грузится фото -->

  <!-- ─── ЕДИНЫЙ continuous overlay — overlay усилен в зоне tagline для читаемости ─── -->
  <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg,
    rgba(6,10,18,0.35) 0%,
    rgba(6,10,18,0.10) 8%,
    transparent 18%,
    transparent 35%,
    rgba(13,26,43,0.25) 45%,
    rgba(13,26,43,0.55) 52%,
    rgba(13,26,43,0.65) 60%,
    rgba(13,26,43,0.80) 72%,
    rgba(13,26,43,0.90) 85%,
    rgba(13,26,43,0.93) 100%
  );"></div>

  <!-- ─── ВЕСЬ КОНТЕНТ ─── -->
  <div class="relative z-10 flex flex-col min-h-[95svh]">

    <!-- H1: SEO-only, мелко UPPERCASE muted (per design intent: маленький H1 для SEO, большой call ниже) -->
    <div class="px-5 pt-20">
      <h1
        id="hero-title-mobile"
        class="text-[12px] font-semibold uppercase tracking-[0.14em] text-white/95 leading-tight"
        style="text-shadow: 0 2px 6px rgba(0,0,0,0.95), 0 1px 2px rgba(0,0,0,0.95);"
      >
        Детский IT-лагерь в&nbsp;Подмосковье 2026
      </h1>
      {/* «Для детей 7-15 лет» eyebrow убран — есть в HeroFeatures «Возраст 7-15 лет» */}
    </div>

    <!-- Spacer — оставляет место для photo subject (boy + bean bag) -->
    <div class="flex-1 min-h-[40vh]"></div>

    <!-- Контент — на затемнённой нижней части photo, читается через text-shadow + dark overlay -->
    <div class="px-5 pb-8">

      <!-- BIG CALL: главный призыв (44px, что раньше было у H1; теперь это «большой текст» по концепту) -->
      <p class="leading-[1.05] text-white text-left mb-3 font-extrabold tracking-[-0.025em]" style="font-size: clamp(32px, 9vw, 44px); text-shadow: 0 2px 8px rgba(0,0,0,0.85), 0 1px 2px rgba(0,0,0,0.95);">
        Пока другие<br>на&nbsp;даче — ваш<br>сделает <span class="text-primary" style="text-shadow:none">AI-проект</span> <span class="hero-outline">или игру</span>
      </p>
      <p class="text-left text-[15px] text-white/90 mb-5" style="text-shadow: 0 1px 3px rgba(0,0,0,0.85);">
        Вам — <span class="font-bold text-white">14 дней для себя</span>.
      </p>

      {/* Price + Programa блок убран — заменён HeroFeatures (горизонтальный свайп фактов под hero). */}

      {/* БОТ CTA убран из hero — мама первый раз листает, не спрашивает.
          TODO: вернуть как floating-bubble после 30s сессии или на 2-й визит. */}
      {/* Stats inline убраны — есть в HeroFeatures под hero */}
      {/* Trust inline убраны — Лицензия/Медсестра в HeroFeatures */}
    </div>

  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<style>
  /* Pulse contained — НЕ blow на photo: только icon scale, без box-shadow */
  @keyframes hero-bot-icon-pulse {
    0%, 92%, 100% { transform: scale(1); }
    96% { transform: scale(1.12); }
  }
  .hero-bot-icon { animation: hero-bot-icon-pulse 4.5s ease-in-out infinite; transform-origin: center; display: inline-block; }
  @keyframes hero-fade-up {
    from { opacity: 0.01; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #hero-title-mobile { animation: hero-fade-up 0.6s ease-out 0.1s both; }
  @media (prefers-reduced-motion: reduce) {
    .hero-bot-cta, .hero-bot-icon, #hero-title-mobile { animation: none !important; }
  }

  /* Hero async photo — JS-инжект с crossfade */
  #hero-mobile-photo {
    opacity: 0;
  }
  #hero-mobile-photo.hero-loaded {
    opacity: 1;
    transition: opacity 1.4s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #hero-mobile-photo.hero-loaded { transition: none; }
  }
</style>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'минусы', 'косяки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0.3';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
    }, 200);
  }, 2200);
})();
</script>

<script define:vars={{ imageSrc, hasVariants }} is:inline>
/* Hero photo async inject — LCP = heading text, фото грузится через preload + crossfade */
(function () {
  function mountHeroPhoto() {
    var root = document.getElementById('hero-mobile-root');
    if (!root || document.getElementById('hero-mobile-photo')) return;

    /* Используем WebP (не AVIF): WebP декодируется в ~20× быстрее AVIF при 4× CPU throttling.
       AVIF (270KB) → ~2400ms decode; WebP (293KB) → ~100ms decode → LCP ≈ 2s вместо 4.4s.
       Preload в <head> также изменён на WebP srcset → browser hit-ует кэш. */
    var img = document.createElement('img');
    img.id = 'hero-mobile-photo';
    img.alt = 'Дети на занятии в IT-лагере АйДаКемп';
    img.className = 'absolute inset-0 h-full w-full object-cover';
    /* opacity:0 inline — Astro-scoped CSS [data-astro-cid-*] не применится к JS-элементу */
    img.style.cssText = 'object-position:center 30%;opacity:0;';
    img.width = 390;
    img.height = 800;
    img.sizes = '100vw';
    img.srcset = hasVariants
      ? (imageSrc + '.webp 390w, ' + imageSrc + '-600.webp 600w, ' + imageSrc + '-900.webp 900w')
      : (imageSrc + '.webp');
    img.src = imageSrc + '.webp'; /* fallback + preload cache match */

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

    function fadeIn() {
      if (prefersReducedMotion) {
        img.style.opacity = '1';
      } else {
        /* double-rAF: первый фрейм — transition, второй — opacity:1 → плавная анимация */
        requestAnimationFrame(function () {
          img.style.transition = 'opacity 1.4s ease';
          requestAnimationFrame(function () { img.style.opacity = '1'; });
        });
      }
    }
    img.addEventListener('load', fadeIn, { once: true });

    /* Вставляем перед первым дочерним элементом — под overlay и текст */
    root.insertBefore(img, root.firstChild);

    /* Если картинка уже в кеше preload — сработает сразу */
    if (img.complete && img.naturalHeight > 0) fadeIn();
  }

  if (document.readyState !== 'loading') {
    mountHeroPhoto();
  } else {
    document.addEventListener('DOMContentLoaded', mountHeroPhoto, { once: true });
  }
})();
</script>
