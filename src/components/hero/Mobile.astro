---
import DualRatingPill from '../DualRatingPill.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — FULL-BLEED: фото фон на весь блок, контент поверх ===== -->
<div class="relative w-full md:hidden min-h-[95svh] flex flex-col overflow-hidden">

  <!-- ── Фото-подложка на ВЕСЬ hero — aspect-ratio совпадает с файлом, sizes указан явно ── -->
  <picture>
    <source type="image/avif" srcset={hasVariants ? `${imageSrc}.avif 390w, ${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" srcset={hasVariants ? `${imageSrc}.webp 390w, ${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} sizes="100vw" />
    <img
      src={`${imageSrc}.webp`}
      alt="Дети на занятии в IT-лагере АйДаКемп"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="390"
      height="800"
      style="aspect-ratio: 390/800;"
      data-img-debug
    />
  </picture>

  <!-- ── Единый overlay на весь hero — мягкий fade, темнее снизу для контента ── -->
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0.20)_0%,rgba(6,10,18,0.05)_18%,transparent_35%,rgba(13,26,43,0.30)_55%,rgba(13,26,43,0.62)_72%,rgba(13,26,43,0.82)_88%,rgba(13,26,43,0.92)_100%)]"></div>

  <!-- ── Весь контент поверх (relative, чтобы был над overlay) ── -->
  <div class="relative flex flex-col flex-1 z-10">

    <!-- ★ H1 — premium typography: 38px, tighter tracking, subtle weight gradient ── -->
    <div class="px-5 pt-20">
      <h1
        id="hero-title-mobile"
        class="text-[38px] font-extrabold leading-[1.05] tracking-[-0.035em] text-white"
        style="text-shadow: 0 1px 2px rgba(0,0,0,0.9), 0 2px 10px rgba(0,0,0,0.75), 0 6px 28px rgba(0,0,0,0.55);"
      >
        Летний IT-лагерь в&nbsp;Подмосковье <span class="text-white/95">2026</span>
      </h1>
      <p class="mt-2 text-[15px] font-medium text-white/85 tracking-wide" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7);">
        Для детей <span class="text-amber-300 font-semibold">7–15 лет</span>
      </p>
    </div>

    <!-- ★ P3: Spacer уменьшен (28vh → 20vh) чтобы поднять контент над cookie-баннером ── -->
    <div class="flex-1 min-h-[20vh]"></div>

    <!-- ── Таглайн + субтитр — premium hierarchy с амбер-акцентом ── -->
    <div class="mx-5 text-center">
      <p class="text-[16px] leading-[1.45] text-white/85" style="text-shadow: 0 1px 4px rgba(0,0,0,0.75), 0 0 14px rgba(0,0,0,0.5);">
        Пока другие на даче —
        <span class="text-amber-200 font-semibold">ваш сделает AI-проект</span>
      </p>
      <p class="mt-1.5 text-[17px] leading-[1.4] text-white font-semibold" style="text-shadow: 0 1px 4px rgba(0,0,0,0.75), 0 0 14px rgba(0,0,0,0.5);">Вам — 14 дней для себя</p>
    </div>

    <!-- ── PREMIUM: Цена + программа в glass-cards (главный CTA) ── -->
    <div class="mx-4 mt-3 flex gap-2.5">
      <button type="button" data-shift-link="shift-2-1"
        class="flex-1 flex flex-col items-center justify-center gap-0.5 py-3 min-h-[56px] rounded-2xl bg-white/[0.18] backdrop-blur-xl border border-white/30 shadow-[0_4px_24px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] active:bg-white/25 transition-all">
        <span class="text-[19px] font-bold text-white leading-tight tabular-nums" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7);">от {CAMP_PRICE_FROM}</span>
        <span class="text-[12px] text-white/80 leading-tight uppercase tracking-wider">за 7 дней</span>
      </button>
      <a href="#journey"
        class="flex-1 flex flex-col items-center justify-center gap-0.5 py-3 min-h-[56px] rounded-2xl bg-white/[0.18] backdrop-blur-xl border border-white/30 shadow-[0_4px_24px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] active:bg-white/25 transition-all">
        <span class="text-[15px] font-semibold text-white leading-tight" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7);">Программирование</span>
        <span class="text-[12px] text-white/80 leading-tight">AI · Бассейн</span>
      </a>
    </div>

    <!-- ── PREMIUM 2×2 grid: ВСЕ cells = glass для визуальной унификации ── -->
    <div class="mx-4 mt-2.5 grid grid-cols-2 gap-2.5">

      <!-- Бот CTA — теперь в glass-card с большой иконкой и glow ── -->
      <a
        href="https://aidacamp.ru/ask"
        data-analytics-goal="bot_click"
        class="relative flex flex-col items-center justify-center text-center gap-1 py-3 min-h-[76px] rounded-2xl bg-white/[0.14] backdrop-blur-xl border border-white/25 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] active:bg-white/22 transition-all overflow-hidden"
      >
        <i class="bi bi-telegram text-[32px] text-primary" aria-hidden="true" style="filter: drop-shadow(0 0 8px rgba(245,166,36,0.4)) drop-shadow(0 1px 3px rgba(0,0,0,0.6));"></i>
        <div class="flex flex-col items-center gap-0">
          <span class="text-[12px] font-medium text-white/90 leading-tight uppercase tracking-wider">Спросите про</span>
          <span
            id="hero-bot-topic"
            class="text-[15px] font-bold text-primary leading-tight"
            style="font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s, transform 0.2s; text-shadow: 0 0 10px rgba(245,166,36,0.5);"
          >лагерь</span>
        </div>
      </a>

      <!-- Статистика — glass-card с tabular-nums ── -->
      <a href="#about"
        class="flex flex-col items-center justify-center text-center py-3 min-h-[76px] rounded-2xl bg-white/[0.14] backdrop-blur-xl border border-white/25 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] active:bg-white/22 transition-all">
        <span class="text-[20px] font-extrabold text-white leading-none tabular-nums" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">{STAT_YEARS}</span>
        <span class="text-[10px] text-white/75 uppercase tracking-wider mt-0.5">лет в работе</span>
        <span class="text-[11px] text-white/85 leading-tight mt-1 tabular-nums">{STAT_KIDS} детей</span>
      </a>

      <!-- Рейтинги — glass с inset border ── -->
      <div class="flex items-stretch rounded-2xl bg-white/[0.14] backdrop-blur-xl border border-white/25 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] overflow-hidden">
        <DualRatingPill
          yandexRating={STAT_RATING}
          yandexUrl={YANDEX_MAPS_URL}
          incampRating={4.8}
          variant="hero"
          size="md"
          stacked={true}
          reverseOrder={true}
          yandexGoal="mobile_hero_yandex_rating"
          incampGoal="mobile_hero_incamp_rating"
        />
      </div>

      <!-- ТОП-4 — premium с gold accent ── -->
      <a
        href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove"
        target="_blank" rel="noopener"
        class="flex flex-col items-center justify-center text-center py-3 min-h-[76px] rounded-2xl bg-white/[0.14] backdrop-blur-xl border border-white/25 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] active:bg-white/22 transition-all"
      >
        <div class="text-[24px] font-extrabold leading-none bg-gradient-to-br from-amber-300 to-orange-400 bg-clip-text text-transparent" style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4));">ТОП-4</div>
        <div class="mt-1 text-[10px] leading-tight text-white/75 uppercase tracking-wider">IT-лагерей МО</div>
        <div class="text-[10px] leading-tight text-white/55">vc.ru</div>
      </a>

    </div>

    <!-- Trust-строка — premium: gold check-icons, проверенный баланс -->
    <div class="mx-4 mt-3 mb-24 flex items-center justify-center gap-3">
      <a href="/stati/dokumenty-licenziya-strahovka/#licenziya"
        class="flex items-center gap-1.5 text-[12px] font-medium text-white/85 hover:text-white transition-colors active:text-white" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-patch-check-fill text-[12px] text-emerald-300" aria-hidden="true"></i>
        <span>Лицензия</span>
      </a>
      <span class="text-white/25">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#medsestra"
        class="flex items-center gap-1.5 text-[12px] font-medium text-white/85 hover:text-white transition-colors active:text-white" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-heart-pulse-fill text-[12px] text-rose-300" aria-hidden="true"></i>
        <span>24/7</span>
      </a>
      <span class="text-white/25">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#strahovka"
        class="flex items-center gap-1.5 text-[12px] font-medium text-white/85 hover:text-white transition-colors active:text-white" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-shield-check text-[12px] text-sky-300" aria-hidden="true"></i>
        <span>Страховка</span>
      </a>
    </div>

  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'недостатки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0';
    el.style.transform = 'translateY(5px)';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 180);
  }, 2200);
})();
</script>
