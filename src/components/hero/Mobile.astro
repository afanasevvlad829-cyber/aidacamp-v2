---
import LeadForm from '../LeadForm.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, STAT_DISTANCE, STAT_RETURN, CAMP_PRICE_FROM, YANDEX_MAPS_URL, CAMP_SEASON } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO ===== -->
<div class="relative w-full bg-dark-navy md:hidden min-h-[95svh] flex flex-col">
  <!-- Photo with gradient fade to dark -->
  <div class="relative flex-1 min-h-[52vw]">
    <picture>
      <source type="image/avif" srcset={hasVariants ? `${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} />
      <source type="image/webp" srcset={hasVariants ? `${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} />
      <img
        src={`${imageSrc}.webp`}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover object-[center_35%]"
        loading="eager"
        fetchpriority="high"
        width="390"
        height="441"
      />
    </picture>
    <!-- Side gradient -->
    <div class="absolute inset-0 bg-[linear-gradient(92deg,rgba(6,10,18,0.72)_0%,rgba(6,10,18,0.46)_42%,rgba(6,10,18,0.2)_70%,rgba(6,10,18,0.06)_100%)]"></div>
    <!-- Bottom fade to dark — плавный переход (раньше via-transparent давал резкую полоску) -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_0%,transparent_55%,rgba(13,26,43,0.45)_78%,#0d1a2b_100%)]"></div>

    <!-- Text over photo -->
    <div class="absolute bottom-8 left-5 right-5">
      <h1
        id="hero-title-mobile"
        class="text-[36px] font-bold leading-[1.1] tracking-[-0.03em] text-white [text-shadow:0px_2px_10px_rgba(0,0,0,0.45)]"
      >
        Летний лагерь в&nbsp;Подмосковье,&nbsp;<span class="whitespace-nowrap">7–15</span>
      </h1>
      <p id="hero-subtitle-mobile" class="mt-2.5 text-[15px] text-white/90">
        Вам — 14 дней для себя.
      </p>
    </div>
  </div>

  <!-- ===== Вопросы для бота — 2×2 чипы ===== -->
  <!-- Разделитель -->
  <div class="mx-4 mt-4 flex items-center gap-2">
    <div class="h-px flex-1 bg-white/10"></div>
    <span class="text-[10px] font-bold tracking-[0.1em] uppercase text-white/35">Что вас беспокоит?</span>
    <div class="h-px flex-1 bg-white/10"></div>
  </div>

  <!-- 2×2 основные чипы -->
  <div class="mx-4 mt-2.5 grid grid-cols-2 gap-1.5" id="hero-chips">
    <a href={`/ask?q=${encodeURIComponent('Сколько стоит и что входит в цену?')}&utm_source=hero_chip`}
      class="hero-chip group flex items-center gap-2.5 rounded-[12px] bg-white/8 border border-white/10 px-3 py-3.5 min-h-[52px] active:bg-white/15 transition-colors">
      <i class="bi bi-coin text-[16px] text-orange-400 shrink-0" aria-hidden="true"></i>
      <span class="text-[14px] font-semibold leading-tight text-white flex-1">Сколько стоит?</span>
      <i class="bi bi-chevron-right text-[10px] text-white/30 shrink-0" aria-hidden="true"></i>
    </a>
    <a href={`/ask?q=${encodeURIComponent('Телефон у ребёнка заберут?')}&utm_source=hero_chip`}
      class="hero-chip group flex items-center gap-2.5 rounded-[12px] bg-white/8 border border-white/10 px-3 py-3.5 min-h-[52px] active:bg-white/15 transition-colors">
      <i class="bi bi-phone-x text-[16px] text-orange-400 shrink-0" aria-hidden="true"></i>
      <span class="text-[14px] font-semibold leading-tight text-white flex-1">Телефон заберут?</span>
      <i class="bi bi-chevron-right text-[10px] text-white/30 shrink-0" aria-hidden="true"></i>
    </a>
    <a href={`/ask?q=${encodeURIComponent('Как кормят в лагере?')}&utm_source=hero_chip`}
      class="hero-chip group flex items-center gap-2.5 rounded-[12px] bg-white/8 border border-white/10 px-3 py-3.5 min-h-[52px] active:bg-white/15 transition-colors">
      <i class="bi bi-cup-hot text-[16px] text-orange-400 shrink-0" aria-hidden="true"></i>
      <span class="text-[14px] font-semibold leading-tight text-white flex-1">Как кормят?</span>
      <i class="bi bi-chevron-right text-[10px] text-white/30 shrink-0" aria-hidden="true"></i>
    </a>
    <a href={`/ask?q=${encodeURIComponent('Можно без опыта программирования?')}&utm_source=hero_chip`}
      class="hero-chip group flex items-center gap-2.5 rounded-[12px] bg-white/8 border border-white/10 px-3 py-3.5 min-h-[52px] active:bg-white/15 transition-colors">
      <i class="bi bi-controller text-[16px] text-orange-400 shrink-0" aria-hidden="true"></i>
      <span class="text-[14px] font-semibold leading-tight text-white flex-1">Без опыта можно?</span>
      <i class="bi bi-chevron-right text-[10px] text-white/30 shrink-0" aria-hidden="true"></i>
    </a>
  </div>

  <!-- Вторичные пилюли (горизонтальный скролл) -->
  <div class="mx-4 mt-1.5 flex gap-1.5 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <a href={`/ask?q=${encodeURIComponent('А что у вас плохо?')}&utm_source=hero_chip`}
      class="hero-chip shrink-0 rounded-full bg-white/6 border border-white/10 px-3.5 py-2 text-[13px] text-white/55 whitespace-nowrap active:bg-white/12 transition-colors">
      А что у вас плохо?
    </a>
    <a href={`/ask?q=${encodeURIComponent('Можно вернуть деньги если не понравится?')}&utm_source=hero_chip`}
      class="hero-chip shrink-0 rounded-full bg-white/6 border border-white/10 px-3.5 py-2 text-[13px] text-white/55 whitespace-nowrap active:bg-white/12 transition-colors">
      Возврат денег?
    </a>
    <a href={`/ask?q=${encodeURIComponent('Как добраться до лагеря?')}&utm_source=hero_chip`}
      class="hero-chip shrink-0 rounded-full bg-white/6 border border-white/10 px-3.5 py-2 text-[13px] text-white/55 whitespace-nowrap active:bg-white/12 transition-colors">
      Как добраться?
    </a>
  </div>

  <!-- Синие trust-бейджи -->
  <div class="mx-4 mt-2.5 flex gap-1.5">
    <a href="/stati/dokumenty-licenziya-strahovka/#licenziya" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-[13px] font-medium text-[#bfdbfe] transition-colors active:bg-[#1e40af]/60">
      <i class="bi bi-patch-check-fill text-[14px]" aria-hidden="true"></i>
      <span class="leading-tight">Лицензия</span>
    </a>
    <a href="/stati/dokumenty-licenziya-strahovka/#medsestra" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-[13px] font-medium text-[#bfdbfe] transition-colors active:bg-[#1e40af]/60">
      <i class="bi bi-heart-pulse-fill text-[14px]" aria-hidden="true"></i>
      <span class="leading-tight">Медсестра 24/7</span>
    </a>
    <a href="/stati/dokumenty-licenziya-strahovka/#strahovka" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-[13px] font-medium text-[#bfdbfe] transition-colors active:bg-[#1e40af]/60">
      <i class="bi bi-shield-check text-[14px]" aria-hidden="true"></i>
      <span class="leading-tight">Страховка</span>
    </a>
  </div>

  <!-- Главная CTA — Спросить бота -->
  <div class="mx-4 mt-3 mb-6">
    <a href="/ask" id="hero-ask-btn"
      class="flex w-full items-center justify-center gap-2.5 rounded-full bg-[#ec7c00] px-6 py-4 text-[17px] font-bold text-[#1e2430] shadow-[0_4px_20px_rgba(236,124,0,.40)] active:bg-[#d46e00] transition-all duration-150">
      <i class="bi bi-telegram text-[19px]" aria-hidden="true"></i>
      Спросить бота
    </a>
    <p class="mt-2 text-center text-[12px] text-white/35">без регистрации · без звонка · ответ сразу</p>
  </div>

  <!-- Form area — hidden initially, auto-reveals after 30s or on CTA tap -->
  <div
    id="hero-booking-block"
    class="bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  >
    <!-- White card with form -->
    <LeadForm variant="mobile" />
  </div>
</div>

<script is:inline>
// Красивый клик по чипам героя → переход в /ask?q=
(function(){
  document.querySelectorAll('.hero-chip[href*="/ask?q"]').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var href = this.getAttribute('href');
      var self = this;
      // Orange glow on clicked chip
      self.style.cssText = 'background:rgba(236,124,0,.25)!important;border-color:rgba(236,124,0,.7)!important;box-shadow:0 0 0 3px rgba(236,124,0,.16),0 4px 20px rgba(236,124,0,.30)!important;transform:scale(1.05)!important;transition:all .08s ease!important;';
      // Dim siblings
      document.querySelectorAll('.hero-chip').forEach(function(s) {
        if(s !== self) s.style.cssText = 'opacity:.28!important;transition:opacity .16s ease!important;';
      });
      setTimeout(function() { location.href = href; }, 190);
    });
  });
})();
</script>
