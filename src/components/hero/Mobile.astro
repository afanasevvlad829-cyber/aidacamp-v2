---
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — SINGLE-PHOTO continuous (no hard edge) ===== -->
<div class="relative w-full md:hidden overflow-hidden bg-dark-navy" style="padding-top: env(safe-area-inset-top); min-height: 95svh;">

  <!-- ─── ОДНА фото-подложка на ВЕСЬ hero ─── -->
  <picture>
    <source type="image/avif" media="(max-width: 768px)" srcset={hasVariants ? `${imageSrc}.avif 390w, ${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" media="(max-width: 768px)" srcset={hasVariants ? `${imageSrc}.webp 390w, ${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} sizes="100vw" />
    {/* Fallback img: 1×1 transparent png — на desktop parent с md:hidden, а <source> теперь имеют media,
        поэтому браузер падает на этот placeholder и НЕ грузит mobile hero на desktop. */}
    <img
      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
      alt="Дети на занятии в IT-лагере АйДаКемп"
      class="absolute inset-0 h-full w-full object-cover"
      style="filter: saturate(0.92) brightness(0.95); object-position: center 30%;"
      loading="eager"
      fetchpriority="high"
      width="390"
      height="800"
    />
  </picture>

  <!-- ─── ЕДИНЫЙ continuous overlay — overlay усилен в зоне tagline для читаемости ─── -->
  <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg,
    rgba(6,10,18,0.35) 0%,
    rgba(6,10,18,0.10) 8%,
    transparent 18%,
    transparent 35%,
    rgba(13,26,43,0.25) 45%,
    rgba(13,26,43,0.55) 52%,
    rgba(13,26,43,0.65) 60%,
    rgba(13,26,43,0.80) 72%,
    rgba(13,26,43,0.90) 85%,
    rgba(13,26,43,0.93) 100%
  );"></div>

  <!-- ─── ВЕСЬ КОНТЕНТ ─── -->
  <div class="relative z-10 flex flex-col min-h-[95svh]">

    <!-- H1: SEO-only, мелко UPPERCASE muted (per design intent: маленький H1 для SEO, большой call ниже) -->
    <div class="px-5 pt-20">
      <h1
        id="hero-title-mobile"
        class="text-[12px] font-semibold uppercase tracking-[0.14em] text-white/95 leading-tight"
        style="text-shadow: 0 2px 6px rgba(0,0,0,0.95), 0 1px 2px rgba(0,0,0,0.95);"
      >
        Детский IT-лагерь в&nbsp;Подмосковье 2026
      </h1>
      {/* «Для детей 7-15 лет» eyebrow убран — есть в HeroFeatures «Возраст 7-15 лет» */}
    </div>

    <!-- Spacer — оставляет место для photo subject (boy + bean bag) -->
    <div class="flex-1 min-h-[40vh]"></div>

    <!-- Контент — на затемнённой нижней части photo, читается через text-shadow + dark overlay -->
    <div class="px-5 pb-8">

      <!-- BIG CALL: главный призыв (44px, что раньше было у H1; теперь это «большой текст» по концепту) -->
      <p class="leading-[1.05] text-white text-left mb-3 font-extrabold tracking-[-0.025em]" style="font-size: clamp(32px, 9vw, 44px); text-shadow: 0 2px 8px rgba(0,0,0,0.85), 0 1px 2px rgba(0,0,0,0.95);">
        Пока другие<br>на&nbsp;даче — ваш<br>сделает <span class="text-primary">AI-проект</span> или <span class="text-primary">игру</span>
      </p>
      <p class="text-left text-[15px] text-white/90 mb-5" style="text-shadow: 0 1px 3px rgba(0,0,0,0.85);">
        Вам — <span class="font-bold text-white">14 дней для себя</span>.
      </p>

      <!-- News Jazz — живые AI-новости -->
      <a id="nj-link-m" href="#" class="nj-card-mobile" aria-label="Читать AI-новость">
        <div class="nj-stripe"></div>
        <div class="nj-body">
          <div class="nj-label">
            <div class="nj-dot" aria-hidden="true"></div>
            <span class="nj-label-text">AI News</span>
          </div>
          <div id="nj-text-m" class="nj-text"></div>
          <div id="nj-orig-m" class="nj-orig"></div>
          <div class="nj-footer">
            <span id="nj-source-m" class="nj-source"></span>
            <span id="nj-time-m" class="nj-time"></span>
          </div>
        </div>
        <div class="nj-arrow" aria-hidden="true">
          <i class="bi bi-arrow-up-right" style="font-size:14px"></i>
        </div>
      </a>

      {/* Price + Programa блок убран — заменён HeroFeatures (горизонтальный свайп фактов под hero). */}

      {/* БОТ CTA убран из hero — мама первый раз листает, не спрашивает.
          TODO: вернуть как floating-bubble после 30s сессии или на 2-й визит. */}
      {/* Stats inline убраны — есть в HeroFeatures под hero */}
      {/* Trust inline убраны — Лицензия/Медсестра в HeroFeatures */}
    </div>

  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<style>
  /* Pulse contained — НЕ blow на photo: только icon scale, без box-shadow */
  @keyframes hero-bot-icon-pulse {
    0%, 92%, 100% { transform: scale(1); }
    96% { transform: scale(1.12); }
  }
  .hero-bot-icon { animation: hero-bot-icon-pulse 4.5s ease-in-out infinite; transform-origin: center; display: inline-block; }
  @keyframes hero-fade-up {
    from { opacity: 0.01; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #hero-title-mobile { animation: hero-fade-up 0.6s ease-out 0.1s both; }
  @media (prefers-reduced-motion: reduce) {
    .hero-bot-cta, .hero-bot-icon, #hero-title-mobile { animation: none !important; }
  }
</style>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'минусы', 'косяки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0.3';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
    }, 200);
  }, 2200);
})();
</script>
