---
import DualRatingPill from '../DualRatingPill.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';

interface Props {
  imageSrc?: string;
  hasVariants?: boolean;
}

const { imageSrc = '/images/hero-mobile-bean-v3', hasVariants = false } = Astro.props;
---

<!-- ===== MOBILE HERO — FULL-BLEED PHOTO + GLASS CARDS ===== -->
<div class="relative w-full md:hidden overflow-hidden bg-dark-navy" style="padding-top: env(safe-area-inset-top); min-height: 95svh;">

  <!-- ── ФОТО на ВЕСЬ HERO как фон ── -->
  <picture>
    <source type="image/avif" srcset={hasVariants ? `${imageSrc}.avif 390w, ${imageSrc}-600.avif 600w, ${imageSrc}-900.avif 900w` : `${imageSrc}.avif`} sizes="100vw" />
    <source type="image/webp" srcset={hasVariants ? `${imageSrc}.webp 390w, ${imageSrc}-600.webp 600w, ${imageSrc}-900.webp 900w` : `${imageSrc}.webp`} sizes="100vw" />
    <img
      src={`${imageSrc}.webp`}
      alt="Дети на занятии в IT-лагере АйДаКемп"
      class="absolute inset-0 h-full w-full object-cover"
      style="filter: saturate(0.92) brightness(0.95); object-position: center 25%;"
      loading="eager"
      fetchpriority="high"
      width="390"
      height="800"
    />
  </picture>

  <!-- ── Glass-strip за навбаром (легкий) ── -->
  <div class="absolute top-0 inset-x-0 h-[88px] bg-[linear-gradient(180deg,rgba(6,10,18,0.50)_0%,rgba(6,10,18,0.18)_60%,transparent_100%)] backdrop-blur-[2px] z-[5] pointer-events-none"></div>

  <!-- ── Mid-fade: photo→слегка-затемнённое для контента (не чёрный квадрат, glass) ── -->
  <div class="absolute inset-x-0 top-[45%] bottom-0 bg-[linear-gradient(180deg,transparent_0%,rgba(13,26,43,0.40)_25%,rgba(13,26,43,0.65)_55%,rgba(13,26,43,0.78)_100%)] pointer-events-none"></div>

  <!-- ── ВЕСЬ КОНТЕНТ ── -->
  <div class="relative z-10 flex flex-col min-h-[95svh]">

    <!-- H1 над небом -->
    <div class="px-5 pt-20">
      <h1
        id="hero-title-mobile"
        class="text-[42px] font-extrabold leading-[1.04] tracking-[-0.04em] text-white"
        style="text-shadow: 0 1px 2px rgba(0,0,0,0.9), 0 2px 14px rgba(0,0,0,0.7);"
      >
        Летний IT-лагерь в&nbsp;Подмосковье <span class="text-white/95">2026</span>
      </h1>
      <p class="mt-2 text-[17px] font-medium text-white/85 tracking-wide" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7);">
        Для детей 7–15 лет
      </p>
    </div>

    <!-- Spacer — толкает остальной контент вниз -->
    <div class="flex-1 min-h-[26vh]"></div>

    <!-- Tagline — крупно, единая фраза (P5: +2 levels — 22→24px) -->
    <div class="px-5 mb-7 text-center">
      <p class="text-[22px] leading-[1.35] text-white" style="text-shadow: 0 1px 4px rgba(0,0,0,0.7), 0 0 14px rgba(0,0,0,0.45);">
        Пока другие на даче — <span class="font-bold">ваш сделает <span class="text-primary">AI-проект</span></span>.<br />
        <span class="text-white">Вам — <span class="font-bold">14 дней для себя</span>.</span>
      </p>
    </div>

    <!-- ── ВСЕ КАРТОЧКИ — GLASS (фото просвечивает) ── -->
    <div class="px-4 space-y-2.5">

      <!-- Цена + программа: glass split -->
      <div class="flex items-stretch rounded-2xl bg-white/[0.10] backdrop-blur-xl border border-white/20 shadow-[0_4px_24px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] overflow-hidden">
        <button type="button" data-shift-link="shift-2-1"
          class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/10 transition-colors">
          <span class="text-[26px] font-extrabold text-white leading-tight tabular-nums" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">от {CAMP_PRICE_FROM}</span>
          <span class="text-[12px] text-white/85 leading-tight uppercase tracking-wider">за 7 дней</span>
        </button>
        <div class="w-px bg-white/20 my-3"></div>
        <a href="#journey"
          class="flex-1 flex flex-col items-center justify-center gap-1 py-5 active:bg-white/10 transition-colors">
          <span class="text-[17px] font-semibold text-white leading-tight" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">Программирование</span>
          <span class="text-[13px] text-white/85 leading-tight">AI · Бассейн</span>
        </a>
      </div>

      <!-- БОТ — primary CTA: SOLID orange (не размытый), bi-robot icon -->
      <a
        href="https://aidacamp.ru/ask"
        data-analytics-goal="bot_click"
        class="hero-bot-cta flex items-center gap-4 rounded-2xl bg-primary/95 backdrop-blur-xl border border-primary shadow-[0_6px_28px_rgba(245,166,36,0.45),inset_0_1px_0_rgba(255,255,255,0.30)] py-4 px-5 active:bg-primary transition-colors"
      >
        <i class="bi bi-robot hero-bot-icon text-[34px] text-white shrink-0" aria-hidden="true" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));"></i>
        <div class="flex flex-col text-left flex-1">
          <span class="text-[12px] font-semibold text-white/90 uppercase tracking-wider leading-tight">Спросите бота про</span>
          <span
            id="hero-bot-topic"
            class="text-[20px] font-bold text-white leading-tight"
            style="font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s, transform 0.2s;"
          >лагерь</span>
          <span class="mt-1 flex items-center gap-1 text-[12px] font-medium text-white/95 leading-tight">
            <i class="bi bi-shield-lock text-[11px]" aria-hidden="true"></i>
            Анонимно · без регистрации
          </span>
        </div>
        <i class="bi bi-arrow-right text-[24px] text-white shrink-0" aria-hidden="true"></i>
      </a>

      <!-- Stats + ТОП-4 — glass 2-col -->
      <div class="grid grid-cols-2 gap-2.5">
        <a href="#about" class="flex flex-col items-center justify-center text-center py-5 rounded-2xl bg-white/[0.10] backdrop-blur-xl border border-white/20 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] active:bg-white/15 transition-colors">
          <span class="text-[28px] font-extrabold text-white leading-none tabular-nums" style="text-shadow: 0 1px 4px rgba(0,0,0,0.5);">{STAT_YEARS}</span>
          <span class="text-[12px] text-white/85 uppercase tracking-wider mt-1.5">лет работы</span>
          <span class="text-[12px] text-white/70 mt-0.5 tabular-nums">{STAT_KIDS} детей</span>
        </a>

        <a
          href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove"
          target="_blank" rel="noopener"
          class="flex flex-col items-center justify-center text-center py-5 rounded-2xl bg-white/[0.10] backdrop-blur-xl border border-white/20 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] active:bg-white/15 transition-colors"
        >
          <span class="text-[28px] font-extrabold text-primary leading-none" style="text-shadow: 0 1px 4px rgba(0,0,0,0.4);">ТОП-4</span>
          <span class="text-[12px] text-white/85 uppercase tracking-wider mt-1.5">IT-лагерей МО</span>
          <span class="text-[12px] text-white/70 mt-0.5">vc.ru</span>
        </a>
      </div>

      <!-- Рейтинги — glass single row, восстановленный stacked для inCamp/Яндекс -->
      <div class="flex items-stretch rounded-2xl bg-white/[0.10] backdrop-blur-xl border border-white/20 shadow-[0_4px_20px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.12)] overflow-hidden">
        <DualRatingPill
          yandexRating={STAT_RATING}
          yandexUrl={YANDEX_MAPS_URL}
          incampRating={4.8}
          variant="hero"
          size="md"
          reverseOrder={true}
          yandexGoal="mobile_hero_yandex_rating"
          incampGoal="mobile_hero_incamp_rating"
        />
      </div>

    </div>

    <!-- Trust — компактнее с photo через glass -->
    <div class="mt-5 mb-8 flex items-center justify-center gap-3 px-4">
      <a href="/stati/dokumenty-licenziya-strahovka/#licenziya"
        class="flex items-center gap-1.5 text-[13px] text-white/85 hover:text-white transition-colors" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-patch-check-fill text-[13px]" aria-hidden="true"></i>
        <span>Лицензия</span>
      </a>
      <span class="text-white/40">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#medsestra"
        class="flex items-center gap-1.5 text-[13px] text-white/85 hover:text-white transition-colors" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-heart-pulse-fill text-[13px]" aria-hidden="true"></i>
        <span>Медсестра 24/7</span>
      </a>
      <span class="text-white/40">·</span>
      <a href="/stati/dokumenty-licenziya-strahovka/#strahovka"
        class="flex items-center gap-1.5 text-[13px] text-white/85 hover:text-white transition-colors" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
        <i class="bi bi-shield-check text-[13px]" aria-hidden="true"></i>
        <span>Страховка</span>
      </a>
    </div>

  </div>

  <!-- Form area -->
  <div
    id="hero-booking-block"
    class="relative z-10 bg-dark-navy px-4 overflow-hidden"
    style="max-height:0; padding-top:0; padding-bottom:0; opacity:0; pointer-events:none; transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;"
  ></div>

</div>

<style>
  @keyframes hero-bot-pulse {
    0%, 92%, 100% { box-shadow: 0 6px 28px rgba(245,166,36,0.45), inset 0 1px 0 rgba(255,255,255,0.30); }
    96% { box-shadow: 0 6px 36px rgba(245,166,36,0.75), 0 0 0 4px rgba(245,166,36,0.25), inset 0 1px 0 rgba(255,255,255,0.40); }
  }
  .hero-bot-cta { animation: hero-bot-pulse 4.5s ease-in-out infinite; }
  @keyframes hero-bot-icon-pulse {
    0%, 92%, 100% { transform: scale(1); }
    96% { transform: scale(1.08); }
  }
  .hero-bot-icon { animation: hero-bot-icon-pulse 4.5s ease-in-out infinite; transform-origin: center; display: inline-block; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #hero-title-mobile { animation: hero-fade-up 0.6s ease-out 0.1s both; }
  @media (prefers-reduced-motion: reduce) {
    .hero-bot-cta, .hero-bot-icon, #hero-title-mobile { animation: none !important; }
  }
</style>

<script is:inline>
(function () {
  var topics = ['лагерь', 'еду', 'бассейн', 'размещение', 'стоимость', 'недостатки'];
  var i = 0;
  var el = document.getElementById('hero-bot-topic');
  if (!el) return;
  setInterval(function () {
    i = (i + 1) % topics.length;
    el.style.opacity = '0';
    el.style.transform = 'translateY(5px)';
    setTimeout(function () {
      el.textContent = topics[i];
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 180);
  }, 2200);
})();
</script>
