---
/**
 * HeroFeatures — горизонтальная полоска фактов под hero.
 * Прозрачный фон (живёт над dot-pattern). Тёмный текст для читаемости на светлом.
 *
 * Mobile: horizontal scroll-snap (свайп пальцем)
 * Desktop: ряд по центру
 */
const features = [
  { label: 'Возраст', value: '7–15 лет', adaptable: true },
  { label: 'Группы', value: 'до 8 чел.' },
  { label: 'От Москвы', value: '66 км' },
  { label: 'Опыт', value: 'не нужен' },
  { label: 'Ноутбук', value: 'не нужен' },
  { label: 'Гарантия', value: '50% за 3 дня', accent: true },
  { label: 'Лицензия', value: '✓ Минобрнауки', accent: true },
  { label: 'Медсестра', value: '24/7', accent: true },
  { label: 'Питание', value: '5-разовое' },
];
---

<div class="hero-features relative" aria-label="Ключевые факты о лагере">
  <ul class="hero-features-track flex gap-0 overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
    {features.map((f, i) => (
      <li class="hero-features-chip flex flex-col justify-center shrink-0 snap-start min-w-[150px] md:min-w-[170px] px-5 py-4 md:px-6 md:py-5 border-r border-border-light last:border-r-0">
        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.16em] text-body-muted">{f.label}</span>
        {f.adaptable ? (
          <span
            class={`mt-1.5 text-[16px] md:text-[18px] font-extrabold leading-[1.15] tracking-[-0.01em] ${f.accent ? 'text-emerald-700' : 'text-body'}`}
            data-age-adapt
            data-age-default={f.value}
            data-age7-9="7–9 лет"
            data-age10-12="10–12 лет"
            data-age13-15="13–15 лет"
          >{f.value}</span>
        ) : (
          <span class={`mt-1.5 text-[16px] md:text-[18px] font-extrabold leading-[1.15] tracking-[-0.01em] ${f.accent ? 'text-emerald-700' : 'text-body'}`}>{f.value}</span>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .hero-features {
    background: transparent;
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }
  /* На очень широких экранах содержимое центрируется */
  @media (min-width: 1280px) {
    .hero-features-track { justify-content: center; }
  }
</style>
