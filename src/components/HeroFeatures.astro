---
/**
 * HeroFeatures — горизонтальная полоска чипов с фактами о смене.
 * Концепт: ВОЗРАСТ / ГРУППЫ / ОТ МОСКВЫ / ОПЫТ / НОУТБУК / ГАРАНТИЯ / ЛИЦЕНЗИЯ / МЕДСЕСТРА / ПИТАНИЕ.
 *
 * Mobile: horizontal scroll-snap (свайп пальцем)
 * Desktop: full row (или wrap если не поместятся)
 *
 * Используется в hero (Mobile.astro + Desktop.astro) под big call.
 */
const features = [
  { label: 'Возраст', value: '7–15 лет' },
  { label: 'Группы', value: 'до 8 чел.' },
  { label: 'От Москвы', value: '1 час' },
  { label: 'Опыт', value: 'не нужен' },
  { label: 'Ноутбук', value: 'не нужен' },
  { label: 'Возврат', value: '50% за 3 дня', accent: true },
  { label: 'Лицензия', value: '✓ Минобрнауки', accent: true },
  { label: 'Медсестра', value: '24/7', accent: true },
  { label: 'Питание', value: '5-разовое' },
];
---

<div class="hero-features relative" aria-label="Ключевые факты о лагере">
  <!-- Левая тень-затухание (намёк что есть скролл) -->
  <div class="hero-features-fade-l" aria-hidden="true"></div>
  <!-- Правая тень-затухание -->
  <div class="hero-features-fade-r" aria-hidden="true"></div>

  <ul class="hero-features-track flex gap-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
    {features.map((f) => (
      <li class="hero-features-chip flex flex-col justify-center shrink-0 min-w-[152px] md:min-w-[176px] px-5 py-4 md:px-6 md:py-5 border-r border-white/10 last:border-r-0">
        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.16em] text-white/72">{f.label}</span>
        <span class={`mt-1.5 text-[17px] md:text-[19px] font-extrabold leading-[1.15] tracking-[-0.01em] ${f.accent ? 'text-emerald-300' : 'text-white'}`}>
          {f.value}
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .hero-features {
    background: rgba(13, 26, 43, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .hero-features-fade-l,
  .hero-features-fade-r {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    pointer-events: none;
    z-index: 2;
  }
  .hero-features-fade-l {
    left: 0;
    background: linear-gradient(to right, rgba(13,26,43,0.95), transparent);
  }
  .hero-features-fade-r {
    right: 0;
    background: linear-gradient(to left, rgba(13,26,43,0.95), transparent);
  }
  .hero-features-track.dragging {
    scroll-behavior: auto; /* отключаем smooth-scroll при драгинге */
    cursor: grabbing;
  }
  /* На очень широких экранах содержимое центрируется и fade не нужен */
  @media (min-width: 1280px) {
    .hero-features-track { justify-content: center; }
  }
</style>

<script>
  function initHeroFeaturesDrag() {
    const track = document.querySelector<HTMLElement>('.hero-features-track');
    if (!track) return;

    // ─── Mouse drag ───────────────────────────────────────────────
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let velocity = 0;
    let lastX = 0;
    let lastTime = 0;
    let rafId = 0;

    const onMouseDown = (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      lastX = e.pageX;
      lastTime = Date.now();
      velocity = 0;
      cancelAnimationFrame(rafId);
      track.style.cursor = 'grabbing';
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.6; // чуть легче — 1.6 вместо 1.2
      const now = Date.now();
      const dt = now - lastTime;
      if (dt > 0) velocity = (e.pageX - lastX) / dt;
      lastX = e.pageX;
      lastTime = now;
      track.scrollLeft = scrollLeft - walk;
    };

    const onMouseUp = () => {
      if (!isDown) return;
      isDown = false;
      track.style.cursor = 'grab';
      // momentum
      let v = velocity;
      const animate = () => {
        if (Math.abs(v) > 0.08) {
          track.scrollLeft -= v * 18;
          v *= 0.92;
          rafId = requestAnimationFrame(animate);
        }
      };
      rafId = requestAnimationFrame(animate);
    };

    track.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
    track.style.userSelect = 'none';
    track.style.cursor = 'grab';

    // ─── Touch momentum (дополнение к нативному скроллу) ─────────
    // На iOS нативный скролл уже с инерцией. На Android — нет.
    // Добавляем momentum для Android и десктопных тач-экранов.
    let touchStartX = 0;
    let touchScrollLeft = 0;
    let touchLastX = 0;
    let touchLastTime = 0;
    let touchVelocity = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      cancelAnimationFrame(rafId);
      const t = e.touches[0];
      touchStartX = t.clientX;
      touchScrollLeft = track.scrollLeft;
      touchLastX = t.clientX;
      touchLastTime = Date.now();
      touchVelocity = 0;
    }, { passive: true });

    track.addEventListener('touchmove', (e: TouchEvent) => {
      const t = e.touches[0];
      const now = Date.now();
      const dt = now - touchLastTime;
      if (dt > 0) touchVelocity = (t.clientX - touchLastX) / dt;
      touchLastX = t.clientX;
      touchLastTime = now;
      track.scrollLeft = touchScrollLeft - (t.clientX - touchStartX);
    }, { passive: true });

    track.addEventListener('touchend', () => {
      let v = touchVelocity;
      const animate = () => {
        if (Math.abs(v) > 0.05) {
          track.scrollLeft -= v * 20;
          v *= 0.90;
          rafId = requestAnimationFrame(animate);
        }
      };
      rafId = requestAnimationFrame(animate);
    }, { passive: true });
  }

  // Инициализируем при загрузке — defer drag init, не блокируем LCP
  document.addEventListener('astro:page-load', initHeroFeaturesDrag);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initHeroFeaturesDrag, { timeout: 1000 });
  } else {
    setTimeout(initHeroFeaturesDrag, 100);
  }
</script>
