---
/**
 * SeasonCalendar — предварительные даты заездов мини-календарями.
 * Окна группируются по месяцу: один месяц = одна сетка, в ней могут быть
 * и основной заезд (оранжевый), и триместровые окна (светлая подсветка).
 * Легенда собирается из label/sub всех окон.
 */
import { buildMonthCells, monthLabel, WEEKDAYS, type CalRange } from '../../utils/seasonCalendar';
import type { SeasonCalWindow } from '../../data/seasons';

interface Props { windows: SeasonCalWindow[]; }
const { windows } = Astro.props;

// Все диапазоны — каждый месяц подсвечивает и «перетёкшие» в него чужие заезды
const allRanges: CalRange[] = windows.map((w) => ({ from: w.from, to: w.to, primary: w.primary }));

// Уникальные месяцы в порядке следования окон
const monthKeys: { year: number; month: number }[] = [];
for (const w of windows) {
  if (!monthKeys.some((m) => m.year === w.year && m.month === w.month)) {
    monthKeys.push({ year: w.year, month: w.month });
  }
}

const CELL_CLS: Record<string, string> = {
  primary: 'py-1 rounded-md bg-primary text-white font-semibold',
  secondary: 'py-1 rounded-md bg-orange-100 text-orange-900 font-semibold',
  month: 'py-1 text-body-muted',
  off: 'py-1 text-slate-300',
};

const months = monthKeys.map((m) => ({
  label: monthLabel(m.year, m.month),
  cells: buildMonthCells(m.year, m.month, allRanges).map((c) => ({ day: c.day, cls: CELL_CLS[c.state] })),
}));
---

<p class="text-[14px] font-bold uppercase tracking-[0.12em] text-primary mb-4">Предварительные даты заездов</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[720px]">
  {months.map((m) => (
    <div class="rounded-[16px] border border-slate-200 bg-white p-4">
      <p class="text-[14px] font-semibold text-body mb-2">{m.label}</p>
      <div class="grid grid-cols-7 gap-y-0.5 text-center text-[12px]">
        {WEEKDAYS.map((d) => <span class="text-slate-400 font-medium pb-1">{d}</span>)}
        {m.cells.map((c) => <span class={c.cls}>{c.day}</span>)}
      </div>
    </div>
  ))}
</div>

<!-- Легенда -->
<ul class="mt-5 space-y-2">
  {windows.map((w) => (
    <li class="flex items-center gap-2.5 text-[14.5px] text-body">
      <span class={`inline-block h-3.5 w-3.5 rounded ${w.primary ? 'bg-primary' : 'bg-orange-100 border border-orange-300'}`} aria-hidden="true"></span>
      <span><strong class="font-semibold">{w.label}</strong> <span class="text-slate-500">— {w.sub}</span></span>
    </li>
  ))}
</ul>
