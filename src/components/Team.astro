---
import { members } from '../data/team';
import Mentors from './Mentors.astro';
---

<section id="team" class="mx-auto max-w-[1312px] px-[2px] pt-6 md:px-4">
  <div class="p-[18px]">
    <div class="flex items-center gap-2 mb-1">
      <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
      <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">Команда</h2>
    </div>

    <p class="mt-3 max-w-[800px] text-[16px] leading-[1.6] text-body-muted">
      Наши преподаватели — авторы собственной книги по Python для детей.
    </p>

    <div class="mt-5 flex flex-col gap-5 md:flex-row md:gap-6">
      <!-- Left: Book card -->
      <div class="w-full shrink-0 md:w-[35%]">
        <div class="flex h-full flex-col p-5 bg-white rounded-[22px]">
          <button type="button" data-gallery-open data-gallery-src="/images/team/team-book-main-01.webp" data-gallery-alt="Книга по Python для детей" class="group mx-auto block">
            <img src="/images/team/team-book-main-01.webp" alt="Книга по Python" class="h-auto w-full max-w-[200px] rounded-lg object-cover shadow-[0_2px_8px_rgba(15,23,42,0.08)] transition group-hover:scale-105" loading="lazy" width="200" height="280" />
          </button>
          <p class="mt-4 text-base font-semibold text-body">Собственная книга по Python</p>
          <p class="mt-2 text-[16px] leading-[1.5] text-body-muted">Команда не только ведёт занятия, но и написала книгу по Python для детей — тираж 2000 экз.</p>
          <button type="button" data-book-open class="group mt-4 inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover min-h-[44px]">
            <i class="bi bi-book text-base" aria-hidden="true"></i>
            Смотреть книгу
            <i class="bi bi-arrow-right text-base transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <!-- Right: Teachers — desktop: top 2 fixed + bottom carousel / mobile: swipe -->
      <div class="relative w-full md:flex md:w-[65%] md:flex-col">
        <!-- Desktop layout -->
        <div class="hidden md:flex md:h-full md:flex-col md:gap-4">
          <!-- Top row: fixed (members 0 + 1) -->
          <div class="grid flex-1 grid-cols-2 gap-4" data-team-top-row>
            {members.slice(0, 2).map((m) => (
              <article class="flex flex-col items-center rounded-[22px] border border-border-light bg-card p-5">
                <img
                  src={m.photo.replace('/images/team/', '/images/team/sm/')}
                  srcset={`${m.photo.replace('/images/team/', '/images/team/sm/')} 1x, ${m.photo} 2x`}
                  alt={m.alt}
                  class="mx-auto h-16 w-16 rounded-full object-cover object-top ring-2 ring-white"
                  width="64" height="64" loading="lazy"
                />
                <h3 class="mt-3 text-center text-[16px] font-semibold text-body">{m.name}</h3>
                <p class="mt-1 text-center text-base font-medium text-body-faint">{m.role}</p>
                <p class="mt-2 text-center text-[16px] leading-[1.55] text-body-faint">{m.bio}</p>
              </article>
            ))}
          </div>
          <!-- Bottom row: carousel of members 2–4 (shows 2 at a time) -->
          <div class="relative flex flex-1 items-stretch gap-4">
            <button type="button" data-team-prev aria-label="Назад" class="absolute -left-5 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-card text-body-faint shadow-sm transition hover:bg-surface">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div data-team-bottom-row class="grid flex-1 grid-cols-2 gap-4">
              <!-- JS populates 2 visible from bottom pool -->
            </div>
            <button type="button" data-team-next aria-label="Вперёд" class="absolute -right-5 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-card text-body-faint shadow-sm transition hover:bg-surface">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>

        <!-- Mobile: horizontal scroll carousel -->
        <div class="-mx-[2px] px-[2px] flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:hidden" data-team-mobile-track>
          {members.map((m) => (
            <article class="min-w-[72%] snap-start rounded-[22px] border border-border-light bg-card p-5">
              <img
                src={m.photo.replace('/images/team/', '/images/team/sm/')}
                srcset={`${m.photo.replace('/images/team/', '/images/team/sm/')} 1x, ${m.photo} 2x`}
                alt={m.name}
                class="mx-auto h-20 w-20 rounded-full border border-border object-cover object-top"
                width="80" height="80" loading="lazy" />
              <h3 class="mt-3 text-center text-[16px] font-semibold text-body">{m.name}</h3>
              <p class="mt-1 text-center text-base font-medium text-body-faint">{m.role}</p>
              <p class="mt-2 text-center text-[16px] leading-[1.5] text-body-muted">{m.bio}</p>
            </article>
          ))}
        </div>
        <!-- Dots — mobile only -->
        <div class="mt-3 flex justify-center items-center gap-2 md:hidden" data-team-dots role="group" aria-label="Навигация по команде">
          {members.map((_, i) => (
            <span
              class={`h-2 rounded-full transition-all duration-200 ${i === 0 ? 'w-6 bg-primary-dark' : 'w-2 bg-slate-300'}`}
              data-team-dot={i}
              aria-current={i === 0 ? 'true' : 'false'}
            ></span>
          ))}
        </div>
      </div>
    </div>
    <!-- Дисклеймер о согласии сотрудников (требование 152-ФЗ / РКН) -->
    <p class="mt-5 text-base md:text-base leading-[1.5] text-body-faint">
      Фотографии и имена сотрудников и наставников размещены с их письменного согласия на обработку персональных данных в соответствии с&nbsp;Федеральным законом №&nbsp;152-ФЗ «О персональных данных».
    </p>
  </div>

  <!-- ── Mentors merged into Team (per design system) ── -->
  <Mentors />
</section>

<!-- Book modal -->
<dialog id="teamBookModal" class="m-0 h-full w-full max-w-none border-0 bg-black/50 p-4 backdrop:bg-black/50">
  <div class="flex h-full items-center justify-center">
    <div class="relative w-full max-w-[420px] rounded-[20px] bg-card p-5 shadow-[0_20px_50px_rgba(15,23,42,0.25)]">
      <button type="button" data-book-close aria-label="Закрыть" class="absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-border text-body-muted">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <div class="flex gap-4">
        <img src="/images/team/team-book-main-01.webp" alt="Книга по Python" class="h-[160px] w-[110px] shrink-0 rounded-lg object-cover shadow-md" loading="lazy" decoding="async" width="110" height="160" />
        <div>
          <h3 class="text-[16px] font-semibold leading-[1.3] text-body">Python для детей. Играем, чтобы программировать</h3>
          <p class="mt-1.5 text-base md:text-base text-body-faint">Владимир Афанасьев, Никита Брагин</p>
          <p class="mt-2 text-[16px] leading-[1.5] text-body-muted">Книга команды #АйДаКодить — тираж 2000 экз., для детей которые хотят начать Python и сделать первую игру.</p>
        </div>
      </div>

      <div class="mt-4 grid gap-2">
        <a href="https://www.ozon.ru/product/python-dlya-detey-igraem-chtoby-programmirovat-afanasev-vladimir-vladimirovich-3487599843/" target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover">
          Купить на Ozon
          <i class="bi bi-box-arrow-up-right text-base transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
        </a>
        <a href="https://bombora.ru/book/180272/" target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-base font-semibold text-body-muted hover:text-body">
          Читать фрагмент
          <i class="bi bi-box-arrow-up-right text-base transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
        </a>
      </div>

      <p class="mt-3 text-center text-base md:text-base text-body-faint">Также доступно: Book24, Читай-город, Яндекс Маркет, ЛитРес</p>
    </div>
  </div>
</dialog>

<script>
  function initTeam() {
    // Mobile carousel dots
    const mobileTrack = document.querySelector<HTMLElement>('[data-team-mobile-track]');
    const teamDots = document.querySelectorAll<HTMLElement>('[data-team-dot]');
    if (mobileTrack && teamDots.length) {
      const mCards = Array.from(mobileTrack.children) as HTMLElement[];
      const teamDotObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = mCards.indexOf(entry.target as HTMLElement);
            teamDots.forEach((d, di) => {
              const isActive = di === idx;
              d.classList.toggle('bg-primary-dark', isActive);
              d.classList.toggle('w-6', isActive);
              d.classList.toggle('bg-slate-300', !isActive);
              d.classList.toggle('w-2', !isActive);
              d.setAttribute('aria-current', isActive ? 'true' : 'false');
            });
          }
        });
      }, { root: mobileTrack, threshold: 0.6 });
      mCards.forEach((card) => teamDotObserver.observe(card));
    }

    // Book modal
    const modal = document.getElementById('teamBookModal') as HTMLDialogElement | null;
    document.querySelector('[data-book-open]')?.addEventListener('click', () => modal?.showModal());
    modal?.querySelector('[data-book-close]')?.addEventListener('click', () => modal.close());
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

    // Desktop: bottom-row carousel (members 2,3,4 — shows 2 at a time)
    const bottomRow = document.querySelector<HTMLElement>('[data-team-bottom-row]');
    if (!bottomRow) return;

    const members = JSON.parse(
      document.getElementById('team-json')?.textContent || '[]'
    );

    const pool = members.slice(2); // members 2,3,4
    let offset = 0;

    function renderBottom() {
      bottomRow!.innerHTML = '';
      for (let i = 0; i < 2; i++) {
        const m = pool[(offset + i) % pool.length];
        const card = document.createElement('article');
        card.className = 'flex flex-col items-center rounded-[22px] border border-border-light bg-card p-5';
        card.innerHTML = `
          <img src="${m.photo.replace('/images/team/', '/images/team/sm/')}" srcset="${m.photo.replace('/images/team/', '/images/team/sm/')} 1x, ${m.photo} 2x" alt="${m.alt || m.name}" class="mx-auto h-16 w-16 rounded-full object-cover object-top ring-2 ring-white" width="64" height="64" loading="lazy" />
          <h3 class="mt-3 text-center text-[16px] font-semibold text-body">${m.name}</h3>
          <p class="mt-1 text-center text-base font-medium text-body-faint">${m.role}</p>
          <p class="mt-2 text-center text-[16px] leading-[1.55] text-body-faint">${m.bio}</p>
        `;
        bottomRow!.appendChild(card);
      }
    }

    renderBottom();

    document.querySelector('[data-team-prev]')?.addEventListener('click', () => {
      offset = (offset - 1 + pool.length) % pool.length;
      renderBottom();
    });

    document.querySelector('[data-team-next]')?.addEventListener('click', () => {
      offset = (offset + 1) % pool.length;
      renderBottom();
    });
  }

  document.addEventListener('astro:page-load', initTeam);
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initTeam(); }, { timeout: 3000 });
  } else {
    setTimeout(initTeam, 200);
  }
</script>
<script type="application/json" id="team-json" set:html={JSON.stringify(members)}></script>
