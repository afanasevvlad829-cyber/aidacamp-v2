---
/**
 * AmbientParticles — floating decorative elements за контентом.
 * 2 слоя:
 *   1. Soft geometric shapes (blur'd circles) — медленно плавают
 *   2. IT-themed symbols (< />, { }, ★) — slow drift
 *
 * Pointer-events: none — не мешают кликам.
 * Respect prefers-reduced-motion.
 * z-index: 0 (между body bg и main контентом).
 */
---

<div class="ambient-particles" aria-hidden="true">
  <!-- Layer 1: soft blurred shapes -->
  <span class="ap-blob ap-blob-1"></span>
  <span class="ap-blob ap-blob-2"></span>
  <span class="ap-blob ap-blob-3"></span>
  <span class="ap-blob ap-blob-4"></span>
  <span class="ap-blob ap-blob-5"></span>

  <!-- Layer 2: вариант C — code (50%) + geometric (30%) + magic (20%) -->
  <span class="ap-symbol ap-symbol-1">{`</>`}</span>
  <span class="ap-symbol ap-symbol-2">{`{ }`}</span>
  <span class="ap-symbol ap-symbol-3">{`( )`}</span>
  <span class="ap-symbol ap-symbol-4">●</span>
  <span class="ap-symbol ap-symbol-5">{`<>`}</span>
  <span class="ap-symbol ap-symbol-6">▲</span>
  <span class="ap-symbol ap-symbol-7">★</span>
  <span class="ap-symbol ap-symbol-8">✦</span>
</div>

<style is:global>
  .ambient-particles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* ─── Floating blurred blobs (soft shapes) ─── */
  .ap-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(28px);
    opacity: 0.35;
    will-change: transform;
  }
  .ap-blob-1 {
    width: 110px; height: 110px;
    background: radial-gradient(circle, rgba(236,155,68,0.55) 0%, rgba(236,155,68,0) 70%);
    top: 18%; left: 8%;
    animation: ap-float-1 22s ease-in-out infinite;
  }
  .ap-blob-2 {
    width: 80px; height: 80px;
    background: radial-gradient(circle, rgba(59,118,195,0.5) 0%, rgba(59,118,195,0) 70%);
    top: 42%; left: 75%;
    animation: ap-float-2 28s ease-in-out infinite;
  }
  .ap-blob-3 {
    width: 95px; height: 95px;
    background: radial-gradient(circle, rgba(236,155,68,0.4) 0%, rgba(236,155,68,0) 70%);
    top: 68%; left: 14%;
    animation: ap-float-3 25s ease-in-out infinite reverse;
  }
  .ap-blob-4 {
    width: 70px; height: 70px;
    background: radial-gradient(circle, rgba(59,118,195,0.45) 0%, rgba(59,118,195,0) 70%);
    top: 88%; left: 62%;
    animation: ap-float-1 30s ease-in-out infinite;
  }
  .ap-blob-5 {
    width: 130px; height: 130px;
    background: radial-gradient(circle, rgba(236,155,68,0.3) 0%, rgba(236,155,68,0) 70%);
    top: 8%; left: 55%;
    animation: ap-float-2 32s ease-in-out infinite reverse;
  }

  @keyframes ap-float-1 {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(40px, -30px); }
    50% { transform: translate(20px, 40px); }
    75% { transform: translate(-30px, 20px); }
  }
  @keyframes ap-float-2 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(-50px, 40px); }
    66% { transform: translate(30px, -40px); }
  }
  @keyframes ap-float-3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(35px, -50px); }
  }

  /* ─── IT-themed symbols ─── */
  .ap-symbol {
    position: absolute;
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    font-weight: 600;
    color: rgba(120, 130, 150, 0.18);
    user-select: none;
    will-change: transform;
  }
  .ap-symbol-1 { top: 12%; left: 30%; font-size: 22px; animation: ap-drift-a 24s ease-in-out infinite; }
  .ap-symbol-2 { top: 28%; left: 68%; font-size: 28px; animation: ap-drift-b 30s ease-in-out infinite; }
  .ap-symbol-3 { top: 52%; left: 22%; font-size: 24px; animation: ap-drift-a 26s ease-in-out infinite reverse; }
  .ap-symbol-4 { top: 38%; left: 48%; font-size: 18px; color: rgba(236,155,68,0.25); animation: ap-drift-c 20s ease-in-out infinite; }
  .ap-symbol-5 { top: 75%; left: 78%; font-size: 26px; animation: ap-drift-b 28s ease-in-out infinite reverse; }
  .ap-symbol-6 { top: 82%; left: 38%; font-size: 32px; color: rgba(59,118,195,0.22); animation: ap-drift-a 32s ease-in-out infinite; }
  .ap-symbol-7 { top: 22%; left: 88%; font-size: 16px; color: rgba(236,155,68,0.28); animation: ap-drift-c 22s ease-in-out infinite reverse; }
  .ap-symbol-8 { top: 60%; left: 6%; font-size: 22px; color: rgba(59,118,195,0.20); animation: ap-drift-b 26s ease-in-out infinite; }

  @keyframes ap-drift-a {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.6; }
    50% { transform: translate(15px, -25px) rotate(8deg); opacity: 1; }
  }
  @keyframes ap-drift-b {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.5; }
    50% { transform: translate(-20px, 20px) rotate(-6deg); opacity: 0.95; }
  }
  @keyframes ap-drift-c {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
    50% { transform: translate(10px, -15px) scale(1.15); opacity: 1; }
  }

  /* Уважаем системные настройки уменьшения движения */
  @media (prefers-reduced-motion: reduce) {
    .ap-blob, .ap-symbol { animation: none !important; }
  }

  /* Не показываем на узких экранах — мобилка не должна страдать в производительности */
  @media (max-width: 640px) {
    .ap-blob-2, .ap-blob-4, .ap-blob-5,
    .ap-symbol-2, .ap-symbol-5, .ap-symbol-7, .ap-symbol-8 { display: none; }
  }
</style>
