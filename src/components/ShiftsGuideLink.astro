---
/**
 * ShiftsGuideLink — лёгкая ссылка на статью «Какую смену выбрать»
 * + бейдж-ссылка на «Кому не подходит АйДаКемп» (скрывается на самой
 * статье — иначе получается ссылка страницы саму на себя).
 * Используется под любым блоком со списком/выбором смен.
 *
 * mismatchLinkText — переопределение текста бейджа для конкретной страницы
 * (например, когда странице нужно снизить точные вхождения «лагерь» —
 * см. lager-elektrostal.astro). Дефолт не менять — общий для всех страниц.
 */
interface Props {
  mismatchLinkText?: string;
}
const { mismatchLinkText = 'Кому лагерь не подходит — честный список причин' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const onMismatchArticle = currentPath === '/stati/komu-ne-podhodit-lager';
---
<div class="mt-1 flex flex-col items-center gap-2">
  <p class="text-center text-base">
    <a href="/stati/kakuyu-smenu-vybrat/" class="text-primary hover:underline underline-offset-2">
      Не знаете, какую смену выбрать? Инструкция для мамы, которая запуталась
    </a>
  </p>

  {!onMismatchArticle && (
    <a
      href="/stati/komu-ne-podhodit-lager/"
      class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white pl-2 pr-3.5 py-1.5 text-base text-body-muted transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
    >
      <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-[11px] font-bold text-primary" aria-hidden="true">6</span>
      {mismatchLinkText}
    </a>
  )}
</div>
