---
/**
 * SchoolContinue — информационный блок «Продолжить после смены»: кросс-ссылки
 * на школу программирования #АйДаКодить (codims.ru, наш же бренд, круглогодичное
 * обучение). Info-блок по DESIGN_SYSTEM.md §11 — navy/white, без orange.
 */
import { Icon } from 'astro-icon/components';
import { iconName } from '../utils/icons';

interface Props {
  links: Array<{ href: string; label: string }>;
}

const { links } = Astro.props;
---

<section class="mx-auto max-w-[1312px] px-4 py-6 md:py-8">
  <div class="rounded-[22px] border border-border bg-slate-50 px-6 py-6 md:px-8 md:py-7">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[14px] bg-navy-900/10">
        <Icon name={iconName('mortarboard-fill')} class="bi bi-mortarboard-fill text-[24px] text-navy-700" aria-hidden="true" />
      </div>
      <div class="flex-1">
        <h2 class="text-[18px] md:text-[20px] font-bold text-slate-900 leading-tight">
          Продолжить после смены
        </h2>
        <p class="mt-1.5 text-base leading-[1.5] text-slate-600">
          Ребятам, которым понравилось в лагере, есть куда пойти дальше: школа программирования #АйДаКодить учит весь год — очно в Москве или индивидуально онлайн.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {links.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-2 text-base font-medium text-navy-700 transition-all hover:border-navy-500 hover:text-navy-900 hover:shadow-sm"
            >
              {link.label}
              <Icon name={iconName('box-arrow-up-right')} class="bi bi-box-arrow-up-right text-[13px]" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
