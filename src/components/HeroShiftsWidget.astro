---
import { mainShifts, shortShifts } from '../data/shifts';

function getColor(pct: number) {
  if (pct >= 90) return '#ef4444';
  if (pct >= 70) return '#f59e0b';
  return '#22c55e';
}

function freeLabel(free: number) {
  if (free === 1) return '1 место';
  if (free < 5) return `${free} места`;
  return `${free} мест`;
}
---

<div
  class="w-full rounded-[22px] bg-white shadow-[0_12px_40px_rgba(0,0,0,0.18)] overflow-hidden"
  data-hero-shifts-widget
>
  <!-- Фиксированный контейнер — высота не меняется при переключении состояний -->
  <div class="relative" style="min-height: 420px;">

    <!-- ===== IDLE STATE ===== -->
    <div
      data-widget-idle
      class="absolute inset-0 flex flex-col items-center justify-center gap-5 px-6 py-8 transition-opacity duration-300"
    >
      <!-- Иконка -->
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-orange-50">
        <svg class="h-7 w-7 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>

      <!-- Текст -->
      <div class="text-center">
        <p class="text-[17px] font-bold text-slate-900">Свободные места</p>
        <p class="mt-1 text-[14px] text-slate-500">Данные обновляются в реальном времени</p>
      </div>

      <!-- Пульсирующий индикатор -->
      <div class="flex items-center gap-2">
        <span class="flex h-2 w-2 rounded-full bg-green-500 shadow-[0_0_5px_#22c55e] animate-pulse"></span>
        <span class="text-[13px] text-slate-500">обновлено сегодня</span>
      </div>

      <!-- CTA кнопка -->
      <button
        type="button"
        data-widget-check-btn
        class="flex items-center gap-2 rounded-[14px] bg-[#ec7c00] hover:bg-[#d46e00] px-6 py-3 text-[15px] font-semibold text-white shadow-[0_4px_16px_rgba(236,124,0,0.35)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_6px_20px_rgba(236,124,0,0.45)] active:scale-[0.98]"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Проверить
      </button>
    </div>

    <!-- ===== LOADED STATE ===== -->
    <div
      data-widget-loaded
      class="absolute inset-0 flex flex-col px-5 py-5 opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <!-- Header -->
      <div class="flex items-center justify-between mb-3 shrink-0">
        <div class="flex items-center gap-2">
          <span class="flex h-2 w-2 rounded-full bg-green-500 shadow-[0_0_5px_#22c55e] animate-pulse"></span>
          <p class="text-[13px] font-semibold uppercase tracking-[0.7px] text-slate-600">Свободные места</p>
        </div>
        <span class="text-[12px] text-slate-500">обновлено сегодня</span>
      </div>

      <div class="flex flex-col gap-0.5 flex-1 overflow-y-auto">
        {mainShifts.slice(0, 2).map((s) => {
          const total = s.occupied + s.free;
          const pct = Math.round((s.occupied / total) * 100);
          const color = getColor(pct);
          return (
            <button
              type="button"
              class="hero-shift-row w-full text-left rounded-[10px] px-2 py-2.5 transition hover:bg-slate-50 active:bg-slate-100 shrink-0"
              data-occupancy-shift={s.id}
            >
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-[14px] font-bold text-slate-900 shrink-0">{s.name}</span>
                  <span class="truncate text-[13px] text-slate-600">{s.dates}</span>
                </div>
                <span class="shrink-0 ml-2 text-[13px] font-semibold" style={`color: ${color}`}>
                  {freeLabel(s.free)}
                </span>
              </div>
              <div class="h-[5px] w-full overflow-hidden rounded-full bg-slate-100">
                <div
                  class="hero-shift-bar h-full rounded-full transition-[width] duration-[900ms] ease-[cubic-bezier(0.4,0,0.2,1)]"
                  style={`width: 0%; background-color: ${color}`}
                  data-target-width={`${pct}%`}
                ></div>
              </div>
            </button>
          );
        })}

        <!-- Июль: распродан -->
        <div class="my-2 flex items-center gap-2 shrink-0">
          <div class="h-px flex-1 bg-red-100"></div>
          <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-red-500">Июль — мест нет</span>
          <div class="h-px flex-1 bg-red-100"></div>
        </div>

        {mainShifts.slice(2).map((s) => {
          const total = s.occupied + s.free;
          const pct = Math.round((s.occupied / total) * 100);
          const color = getColor(pct);
          return (
            <button
              type="button"
              class="hero-shift-row w-full text-left rounded-[10px] px-2 py-2.5 transition hover:bg-slate-50 active:bg-slate-100 shrink-0"
              data-occupancy-shift={s.id}
            >
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-[14px] font-bold text-slate-900 shrink-0">{s.name}</span>
                  <span class="truncate text-[13px] text-slate-600">{s.dates}</span>
                </div>
                <span class="shrink-0 ml-2 text-[13px] font-semibold" style={`color: ${color}`}>
                  {freeLabel(s.free)}
                </span>
              </div>
              <div class="h-[5px] w-full overflow-hidden rounded-full bg-slate-100">
                <div
                  class="hero-shift-bar h-full rounded-full transition-[width] duration-[900ms] ease-[cubic-bezier(0.4,0,0.2,1)]"
                  style={`width: 0%; background-color: ${color}`}
                  data-target-width={`${pct}%`}
                ></div>
              </div>
            </button>
          );
        })}

        <!-- Короткие смены -->
        <div class="my-2 flex items-center gap-2 shrink-0">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-[12px] font-medium uppercase tracking-[0.08em] text-slate-500">Короткие · 7–8 дней</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        {shortShifts.map((s) => {
          const total = s.occupied + s.free;
          const pct = Math.round((s.occupied / total) * 100);
          const color = getColor(pct);
          return (
            <button
              type="button"
              class="hero-shift-row w-full text-left rounded-[10px] px-2 py-2.5 transition hover:bg-slate-50 active:bg-slate-100 shrink-0"
              data-occupancy-shift={s.id}
            >
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-[14px] font-bold text-slate-900 shrink-0">{s.name}</span>
                  <span class="truncate text-[13px] text-slate-600">{s.dates}</span>
                </div>
                <span class="shrink-0 ml-2 text-[13px] font-semibold" style={`color: ${color}`}>
                  {freeLabel(s.free)}
                </span>
              </div>
              <div class="h-[5px] w-full overflow-hidden rounded-full bg-slate-100">
                <div
                  class="hero-shift-bar h-full rounded-full transition-[width] duration-[900ms] ease-[cubic-bezier(0.4,0,0.2,1)]"
                  style={`width: 0%; background-color: ${color}`}
                  data-target-width={`${pct}%`}
                ></div>
              </div>
            </button>
          );
        })}
      </div>

      <p class="mt-3 shrink-0 text-center text-[13px] text-slate-400">Нажмите на смену — откроется подробная информация</p>
    </div>

  </div>
</div>

<script>
  function initHeroWidget() {
    const widget = document.querySelector('[data-hero-shifts-widget]');
    if (!widget) return;

    const idle = widget.querySelector<HTMLElement>('[data-widget-idle]');
    const loaded = widget.querySelector<HTMLElement>('[data-widget-loaded]');
    const btn = widget.querySelector<HTMLElement>('[data-widget-check-btn]');

    if (!idle || !loaded || !btn) return;

    btn.addEventListener('click', () => {
      if (typeof window.ym !== 'undefined') window.ym(96499295, 'reachGoal', 'check_places');
      window._tmr = window._tmr || [];
      window._tmr.push({ type: 'reachGoal', id: 3755202, value: 100, goal: 'check_places' });

      // Fade out idle
      idle.style.opacity = '0';
      idle.style.pointerEvents = 'none';

      // Fade in loaded
      loaded.style.opacity = '1';
      loaded.style.pointerEvents = 'auto';

      // Animate bars
      setTimeout(() => {
        loaded.querySelectorAll<HTMLElement>('.hero-shift-bar').forEach((bar, i) => {
          setTimeout(() => {
            bar.style.width = bar.dataset.targetWidth || '0%';
          }, i * 80);
        });
      }, 150);
    });
  }

  document.addEventListener('astro:page-load', initHeroWidget);
  initHeroWidget();
</script>
