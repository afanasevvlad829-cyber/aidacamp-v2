---
interface Props {
  variant?: 'default' | 'addiction' | 'summer';
}
const { variant = 'default' } = Astro.props;

const variants = {
  default: {
    title: 'Хочешь, чтобы лето прошло с пользой?',
    text: 'АйДаКемп — IT-лагерь в Подмосковье. Дети создают игры и ботов, а не смотрят чужие. Смены с 30 мая, от 48 000 ₽.',
    cta: 'Посмотреть смены',
    href: '/lager-na-leto-2026',
  },
  addiction: {
    title: 'Лагерь без телефонов — один из способов перезагрузки',
    text: 'В АйДаКемп телефоны сдают при заезде. За 10 дней дети сами начинают общаться и делать что-то настоящее. 60% просятся обратно.',
    cta: 'Узнать про лагерь без телефонов',
    href: '/lager-bez-telefonov',
  },
  summer: {
    title: 'Куда поехать этим летом?',
    text: 'IT-лагерь АйДаКемп: Python, AI, Minecraft — реальный проект за смену. Подмосковье, 66 км от МКАД. Смены с 30 мая.',
    cta: 'Смены лета 2026',
    href: '/lager-na-leto-2026',
  },
};

const v = variants[variant];
---

<div class="my-10 rounded-[22px] bg-card border border-border-light p-6 md:p-7 card-shadow">
  <p class="font-bold text-body text-[20px] md:text-[22px] leading-[1.25] tracking-[-0.01em]">{v.title}</p>
  <p class="mt-3 text-[16px] text-body-muted leading-[1.6]">{v.text}</p>
  <a href={v.href} class="group mt-5 inline-flex items-center gap-1.5 text-[15px] font-semibold text-primary hover:text-primary-hover">
    {v.cta}
    <i class="bi bi-arrow-right text-[14px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
  </a>
</div>
