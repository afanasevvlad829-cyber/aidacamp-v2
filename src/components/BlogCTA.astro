---
interface Props {
  variant?: 'default' | 'addiction' | 'summer' | 'detox';
}
const { variant = 'default' } = Astro.props;

const variants = {
  default: {
    title: 'Хочешь, чтобы лето прошло с пользой?',
    text: 'АйДаКемп — IT-лагерь в Подмосковье. Дети создают игры и ботов, а не смотрят чужие. Смены июнь–август 2026, от 48 000 ₽ за 7 дней.',
    cta: 'Посмотреть смены',
    href: '/lager-na-leto-2026',
  },
  addiction: {
    title: 'Лагерь без телефонов — один из способов перезагрузки',
    text: 'В АйДаКемп телефоны сдают при заезде. За 10 дней дети сами начинают общаться и делать что-то настоящее. Смены июнь–август 2026.',
    cta: 'Узнать про лагерь без телефонов',
    href: '/lager-bez-telefonov',
  },
  summer: {
    title: 'Куда поехать этим летом?',
    text: 'IT-лагерь АйДаКемп: Python, AI, Minecraft — реальный проект за смену. Подмосковье, 66 км от МКАД. Июнь и август 2026.',
    cta: 'Смены лета 2026',
    href: '/lager-na-leto-2026',
  },
  detox: {
    title: 'Когда экранное время становится наградой, а не правом',
    text: 'В АйДаКемп телефоны сдают при заезде — честно. Но не навсегда: в лагере есть внутренняя валюта, и экранное время на ней нужно заработать. За прогресс в проекте, помощь команде, зарядку. Когда телефон стоит дорого, подросток сам начинает думать, тратить ли заработанное на скролл.',
    cta: 'Посмотреть, как устроена смена →',
    href: '/detox-ot-telefona',
  },
};

const v = variants[variant];
---

<a
  href={v.href}
  class="group my-10 block no-underline rounded-[22px] bg-card border border-border-light p-6 md:p-7 card-shadow hover:border-primary/30 transition-colors"
  data-analytics-goal="blog_cta_click"
  data-analytics-label={variant}
>
  <p class="font-bold text-body text-[20px] md:text-[22px] leading-[1.25] tracking-[-0.01em]">{v.title}</p>
  <p class="mt-3 text-[16px] text-body-muted leading-[1.6]">{v.text}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-base font-semibold text-primary group-hover:text-primary-hover">
    {v.cta}
    <i class="bi bi-arrow-right text-base transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
  </span>
</a>
