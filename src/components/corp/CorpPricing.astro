---
import { DATES_S3, DATES_S4, SHIFT_META } from '../../data/shifts';
import { fmtPrice } from '../../data/dynamicPrices';
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;

const shiftsData = [
  { label: `Смена 3 · ${DATES_S3}`, tag: 'Популярная', days: SHIFT_META['shift-3'].days, basePrice: SHIFT_META['shift-3'].basePrice, desc: `Август — пик лета. ${SHIFT_META['shift-3'].days} дней, два полных цикла хакатона. Подходит всем уровням, максимальная насыщенность программы.` },
  { label: `Смена 4 · ${DATES_S4}`, tag: '',            days: SHIFT_META['shift-4'].days, basePrice: SHIFT_META['shift-4'].basePrice, desc: `Последняя смена сезона. ${SHIFT_META['shift-4'].days} дней, идеально если остальные уже заняты или ребёнок идёт в школу позже.` },
];
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Цены для сотрудников {client.clientName}</div>
    <h2 class="corp-h2 r mb-4">Выберите смену — <em class="not-italic text-[var(--corp-or2)]">посчитаем вместе</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">Скажите «я из {client.clientName}» при записи. Скидка применяется сразу — без промокодов и форм.</p>

    <div class="smeny-tabs r">
      {shiftsData.map((s, i) => (
        <div class:list={['stab', i === 0 && 'active']} onclick={`selectSmena(${i}, this)`}>{s.label.split(' · ')[0]} · {s.label.split(' · ')[1]}</div>
      ))}
    </div>

    <div class="calc-box r">
      <div id="smena-card" style="margin-bottom:var(--gap-lg);padding:var(--gap-md);border-radius:var(--r-lg);background:var(--bg3);border:1px solid var(--bdr);">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--gap-xs);margin-bottom:var(--gap-xs);">
          <span id="smena-label" style="font-size:var(--fs-md);font-weight:700;color:var(--txt);">{shiftsData[0].label}</span>
          <span id="smena-tag" style="font-size:var(--fs-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.08em;padding:3px 8px;border-radius:var(--r-full);background:rgba(255,90,31,0.12);color:var(--or2);">{shiftsData[0].tag}</span>
        </div>
        <div id="smena-meta" style="font-size:var(--fs-sm);color:var(--txt2);margin-bottom:var(--gap-xs);">{shiftsData[0].days} дней · базовая цена {fmtPrice(shiftsData[0].basePrice)} / ребёнок</div>
        <div id="smena-desc" style="font-size:var(--fs-base);color:var(--txt2);line-height:1.65;">{shiftsData[0].desc}</div>
      </div>
      <div class="slider-row">
        <div class="slider-label">Количество детей:</div>
        <div class="slider-val" id="kids-count">7</div>
      </div>
      <input type="range" min="1" max="30" value="7" id="kids-slider" oninput="updateCalc()" style="display:block;width:100%;"/>
      <div id="calc-group-result">
        <div class="calc-results">
          <div class="calc-res">
            <div class="calc-res-label">Цена за путёвку</div>
            <div class="calc-res-val orange" id="res-pp">—</div>
            <div class="calc-res-sub" id="res-pp-sub"></div>
          </div>
          <div class="calc-res">
            <div class="calc-res-label">Скидка {client.clientName}</div>
            <div class="calc-res-val orange" id="res-disc">−{client.discount}%</div>
            <div class="calc-res-sub">от базовой цены</div>
          </div>
          <div class="calc-res">
            <div class="calc-res-label">Налоговый вычет</div>
            <div class="calc-res-val green" id="res-tax">—</div>
            <div class="calc-res-sub">13% · вернут через ФНС</div>
          </div>
        </div>
      </div>
      <div id="calc-10plus" style="display:none;margin-top:var(--gap-xs);padding:var(--gap-lg) 24px;border-radius:var(--r-lg);border:1px solid rgba(255,90,31,0.25);background:rgba(255,90,31,0.06);text-align:center;">
        <div style="font-size:var(--fs-3xl);font-weight:900;color:var(--or2);letter-spacing:-0.02em;margin-bottom:var(--gap-xs);">от 12%</div>
        <div style="font-size:var(--fs-base);color:var(--txt);line-height:1.5;">Скидка для группы от 10 детей — по согласованию.<br/><span style="color:var(--txt2);font-size:var(--fs-sm);">Обычно получается 15–20%, зависит от смены и дат.</span></div>
      </div>
    </div>

    <div class="transfer-note r" id="transfer-note">
      При группе от <strong>10 детей</strong> — бесплатный трансфер автобусом {client.transferFrom} до лагеря и обратно. Входит в договор.
    </div>
  </div>
</section>

<style is:global>
.smeny-tabs { display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap; }
.stab { padding:11px 22px; border-radius:4px; font-size:var(--fs-base); font-weight:600; background:var(--bg3); border:1px solid var(--bdr); cursor:pointer; color:var(--txt2); transition:all 0.2s; }
.stab.active { background:var(--or); border-color:var(--or); color:#fff; }
.stab:hover:not(.active) { border-color:var(--bdr2); color:var(--txt); }
.calc-box { background:var(--bg3); border:1px solid var(--bdr); border-radius:12px; padding:40px; margin-bottom:24px; }
.slider-row { display:flex; align-items:center; gap:24px; margin-bottom:12px; }
.slider-label { font-size:var(--fs-md); font-weight:600; color:var(--txt); white-space:nowrap; }
.slider-val { font-family:'Unbounded',sans-serif; font-size:var(--fs-3xl); font-weight:900; color:var(--or2); min-width:48px; }
input[type=range] { flex:1; -webkit-appearance:none; appearance:none; height:6px; background:var(--bg4); border-radius:3px; outline:none; touch-action:pan-x; }
input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:28px; height:28px; border-radius:50%; background:var(--or); cursor:pointer; box-shadow:0 0 0 4px rgba(255,90,31,0.2); transition:box-shadow 0.2s; }
input[type=range]::-webkit-slider-thumb:hover { box-shadow:0 0 0 7px rgba(255,90,31,0.3); }
input[type=range]::-moz-range-thumb { width:28px; height:28px; border-radius:50%; background:var(--or); border:none; cursor:pointer; box-shadow:0 0 0 4px rgba(255,90,31,0.2); }
.calc-results { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:32px; }
.calc-res { background:var(--bg2); border:1px solid var(--bdr); border-radius:6px; padding:20px; }
.calc-res-label { font-size:var(--fs-xs); font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--txt2); margin-bottom:8px; font-family:'SF Mono',monospace; }
.calc-res-val { font-family:'Unbounded',sans-serif; font-size:22px; font-weight:900; color:var(--txt); line-height:1.1; }
.calc-res-val.green { color:var(--green); }
.calc-res-val.orange { color:var(--or2); }
.calc-res-sub { font-size:var(--fs-sm); color:var(--txt2); margin-top:8px; }
.transfer-note { background:rgba(255,90,31,0.07); border:1px solid rgba(255,90,31,0.25); border-radius:6px; padding:18px 24px; font-size:var(--fs-base); color:var(--txt2); line-height:1.7; display:none; }
.transfer-note strong { color:var(--or2); }
.transfer-note.show { display:block; }
@media (max-width:768px) { .calc-results { grid-template-columns:1fr 1fr; } }
@media (max-width:640px) { .calc-results { grid-template-columns:1fr; } }
</style>

<script define:vars={{ shiftsData, discount: client.discount, freeTransferMinKids: client.freeTransferMinKids }}>
  let currentSmenaIdx = 0;
  function fmt(n) { return n.toLocaleString('ru') + ' ₽'; }
  function selectSmena(idx, el) {
    currentSmenaIdx = idx;
    document.querySelectorAll('.stab').forEach(t => t.classList.remove('active'));
    if (el) el.classList.add('active');
    const s = shiftsData[idx];
    const lbl = document.getElementById('smena-label');
    const tag = document.getElementById('smena-tag');
    const meta = document.getElementById('smena-meta');
    const desc = document.getElementById('smena-desc');
    if (lbl) lbl.textContent = s.label;
    if (tag) { tag.textContent = s.tag; tag.style.display = s.tag ? 'inline-block' : 'none'; }
    if (meta) meta.textContent = s.days + ' дней · базовая цена ' + s.basePrice.toLocaleString('ru') + ' ₽ / ребёнок';
    if (desc) desc.textContent = s.desc;
    updateCalc();
  }
  function updateCalc() {
    const s = shiftsData[currentSmenaIdx];
    const kids = parseInt(document.getElementById('kids-slider')?.value || '7', 10);
    const kidsEl = document.getElementById('kids-count');
    if (kidsEl) kidsEl.textContent = kids;
    const discountedPrice = Math.round(s.basePrice * (1 - discount / 100));
    const tax = Math.round((discountedPrice - 3800 * s.days) * 0.13);
    const pp = document.getElementById('res-pp');
    const ppSub = document.getElementById('res-pp-sub');
    const taxEl = document.getElementById('res-tax');
    const plus10 = document.getElementById('calc-10plus');
    const transfer = document.getElementById('transfer-note');
    const group = document.getElementById('calc-group-result');
    if (kids >= freeTransferMinKids) {
      if (group) group.style.display = 'none';
      if (plus10) plus10.style.display = 'block';
      if (transfer) transfer.classList.add('show');
    } else {
      if (group) group.style.display = 'block';
      if (plus10) plus10.style.display = 'none';
      if (transfer) transfer.classList.remove('show');
      if (pp) pp.textContent = fmt(discountedPrice);
      if (ppSub) ppSub.innerHTML = '<s style="opacity:.5">' + s.basePrice.toLocaleString('ru') + ' ₽</s>';
      if (taxEl) taxEl.textContent = '~' + Math.max(tax,0).toLocaleString('ru') + ' ₽';
    }
  }
  window.selectSmena = selectSmena;
  window.updateCalc = updateCalc;
  document.addEventListener('DOMContentLoaded', () => updateCalc());
  updateCalc();
</script>
