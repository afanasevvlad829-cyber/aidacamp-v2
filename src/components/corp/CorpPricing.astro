---
import type { CorpClient } from '../../data/corp/types';
import { mainShifts } from '../../data/shifts';
interface Props { client: CorpClient }
const { client } = Astro.props;

const shiftsData = mainShifts.map(s => ({
  id: s.id,
  name: s.name,
  dates: s.dates,
  duration: s.duration,
  price: parseInt(s.price.replace(/\D/g, '')),
  days: parseInt(s.duration),
  tag: s.popular ? 'Популярная' : (s.free > 10 ? 'Больше всего мест' : ''),
  desc: s.description,
  shortDate: s.dates.split('—')[0].trim(),
}));

const discount = client.discount;
const clientName = client.clientName;
const freeTransferMinKids = client.freeTransferMinKids;
const transferFrom = client.transferFrom;
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Цены для сотрудников {clientName}</div>
    <h2 class="corp-h2 r mb-4">Выберите смену — <em class="not-italic text-[var(--corp-or2)]">посчитаем вместе</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">
      Скажите «я из {clientName}» при записи. Скидка применяется сразу — без промокодов и форм.
    </p>

    <!-- Shift tabs -->
    <div class="r flex flex-wrap gap-2 mb-6" id="corp-smeny-tabs">
      {shiftsData.map((s, i) => (
        <button
          type="button"
          class:list={[
            'corp-stab cursor-pointer rounded-full border px-4 py-2 text-sm font-bold transition-all duration-200',
            i === 0
              ? 'border-[var(--corp-or)] bg-[var(--corp-or)] text-white'
              : 'border-[var(--corp-bdr)] text-[var(--corp-txt2)] hover:border-[var(--corp-or)] hover:text-[var(--corp-txt)]',
          ]}
          data-idx={i}
        >
          {s.name} · {s.shortDate}
        </button>
      ))}
    </div>

    <div class="r rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-6 md:p-8">
      <!-- Shift info card -->
      <div class="mb-6 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg2)] p-4 md:p-5">
        <div class="mb-1 flex flex-wrap items-center gap-2">
          <span id="corp-smena-label" class="text-base font-bold text-[var(--corp-txt)]"></span>
          <span id="corp-smena-tag" class="rounded-full bg-[rgba(255,90,31,0.12)] px-2 py-0.5 text-xs font-bold uppercase tracking-widest text-[var(--corp-or2)]"></span>
        </div>
        <div id="corp-smena-meta" class="mb-2 text-sm text-[var(--corp-txt2)]"></div>
        <div id="corp-smena-desc" class="text-sm leading-relaxed text-[var(--corp-txt2)]"></div>
      </div>

      <!-- Slider -->
      <div class="mb-3 flex items-center justify-between">
        <div class="text-sm font-medium text-[var(--corp-txt2)]">Количество детей:</div>
        <div id="corp-kids-count" class="text-2xl font-black text-[var(--corp-or)]">7</div>
      </div>
      <input
        type="range"
        min="1"
        max="30"
        value="7"
        id="corp-kids-slider"
        class="w-full accent-[var(--corp-or)]"
      />
      <div class="relative mb-6 mt-1 h-5 px-2 font-mono text-xs font-bold text-[var(--corp-or2)]">
        <span class="absolute" style="left: calc(8px + 31% * (100% - 16px))">10</span>
      </div>

      <!-- Results -->
      <div class="mb-4 grid grid-cols-3 gap-4">
        <div class="text-center">
          <div class="mb-1 text-xs text-[var(--corp-txt2)]">Цена за путёвку</div>
          <div id="corp-res-pp" class="text-xl font-black text-[var(--corp-or2)]"></div>
          <div id="corp-res-pp-sub" class="mt-0.5 text-xs text-[var(--corp-txt2)]"></div>
        </div>
        <div class="text-center">
          <div class="mb-1 text-xs text-[var(--corp-txt2)]">Скидка</div>
          <div id="corp-res-disc" class="text-xl font-black text-[var(--corp-or2)]"></div>
          <div class="mt-0.5 text-xs text-[var(--corp-txt2)]">от базовой цены</div>
        </div>
        <div class="text-center">
          <div class="mb-1 text-xs text-[var(--corp-txt2)]">Налоговый вычет</div>
          <div id="corp-res-tax" class="text-xl font-black text-[var(--corp-green)]"></div>
          <div class="mt-0.5 text-xs text-[var(--corp-txt2)]">13% · вернут через ФНС</div>
        </div>
      </div>

      <!-- 10+ block -->
      <div
        id="corp-calc-10plus"
        class="hidden mt-4 rounded-xl border border-[rgba(255,90,31,0.25)] bg-[rgba(255,90,31,0.06)] p-6 text-center"
      >
        <div class="mb-2 text-4xl font-black tracking-tight text-[var(--corp-or2)]">от 12%</div>
        <div class="text-sm leading-relaxed text-[var(--corp-txt)]">
          Скидка для группы от 10 детей — по согласованию.<br />
          <span class="text-[var(--corp-txt2)]">Обычно получается 15–20%, зависит от смены и дат.</span>
        </div>
      </div>
    </div>

    <!-- Transfer note -->
    {transferFrom && (
      <div
        id="corp-transfer-note"
        class="r mt-4 hidden rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] px-5 py-4 text-sm text-[var(--corp-txt2)]"
      >
        При группе от <strong class="text-[var(--corp-txt)]">{freeTransferMinKids} детей</strong> — бесплатный
        трансфер автобусом {transferFrom} до лагеря и обратно. Входит в договор.
      </div>
    )}
  </div>
</section>

<script define:vars={{ shiftsData, discount, freeTransferMinKids }}>
  let currentShiftIdx = 0;

  function fmt(n) {
    return n.toLocaleString('ru-RU') + ' ₽';
  }

  function updateCalc() {
    const kids = parseInt(document.getElementById('corp-kids-slider').value);
    document.getElementById('corp-kids-count').textContent = kids;

    const shift = shiftsData[currentShiftIdx];
    const effectiveDiscount = kids >= 10 ? Math.max(discount, 12) : discount;
    const discountedPrice = Math.round(shift.price * (1 - effectiveDiscount / 100));
    const eduPart = discountedPrice - 3800 * shift.days;
    const taxRefund = Math.max(0, Math.round(eduPart * 0.13));

    document.getElementById('corp-res-pp').textContent = fmt(discountedPrice);
    document.getElementById('corp-res-pp-sub').innerHTML =
      '<s style="opacity:.5">' + fmt(shift.price) + '</s>';
    document.getElementById('corp-res-disc').textContent = '−' + effectiveDiscount + '%';
    document.getElementById('corp-res-tax').textContent = fmt(taxRefund);

    const block10 = document.getElementById('corp-calc-10plus');
    const noteEl = document.getElementById('corp-transfer-note');

    if (block10) block10.classList.toggle('hidden', kids < freeTransferMinKids);
    if (noteEl) noteEl.classList.toggle('hidden', kids < freeTransferMinKids);
  }

  function selectShift(idx) {
    currentShiftIdx = idx;
    const shift = shiftsData[idx];

    // Update tabs
    document.querySelectorAll('.corp-stab').forEach((btn, i) => {
      if (i === idx) {
        btn.classList.add('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.remove('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      } else {
        btn.classList.remove('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.add('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      }
    });

    // Update info card
    document.getElementById('corp-smena-label').textContent = shift.name + ' · ' + shift.dates;
    const tagEl = document.getElementById('corp-smena-tag');
    tagEl.textContent = shift.tag;
    tagEl.style.display = shift.tag ? '' : 'none';
    document.getElementById('corp-smena-meta').textContent =
      shift.duration + ' · базовая цена ' + fmt(shift.price) + ' / ребёнок';
    document.getElementById('corp-smena-desc').textContent = shift.desc;

    updateCalc();
  }

  // Wire up tabs
  document.querySelectorAll('.corp-stab').forEach((btn) => {
    btn.addEventListener('click', () => selectShift(parseInt(btn.dataset.idx)));
  });

  // Wire up slider
  document.getElementById('corp-kids-slider').addEventListener('input', updateCalc);

  // Init
  selectShift(0);
</script>
