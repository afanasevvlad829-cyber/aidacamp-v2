---
const projects = [
  { title: 'Моя ферма',               thumb: 'https://aidacamp.ru/images/videos/project-farm.avif',    url: 'https://kinescope.io/g2S7xxtEUP4S2E3WXYFNqZ' },
  { title: 'Программирование дронов', thumb: 'https://aidacamp.ru/images/videos/project-drones.avif',  url: 'https://kinescope.io/2ULnxEqqC4ssLNYCh5YPvo' },
  { title: 'Игра на Unity',           thumb: 'https://aidacamp.ru/images/videos/project-unity.avif',   url: 'https://kinescope.io/iFCF2uprpHLxx9VgJ1M7SP' },
  { title: 'Игра-исследователь',      thumb: 'https://aidacamp.ru/images/videos/project-explorer.avif',url: 'https://kinescope.io/0Vs3qPMJr7Kvz13MWsxcbc' },
  { title: 'Луиджи',                  thumb: 'https://aidacamp.ru/images/videos/project-luigi.avif',   url: 'https://kinescope.io/w1eZLPX8mqdC7dMniPaBWT' },
];
const campVideos = [
  { title: 'IT-лагерь — это не «сидеть за компьютером»', thumb: 'https://aidacamp.ru/images/videos/video-01.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Видео из лагеря',         thumb: 'https://aidacamp.ru/images/videos/video-02.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Хакатон',                 thumb: 'https://aidacamp.ru/images/videos/video-03.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Финальный день',          thumb: 'https://aidacamp.ru/images/videos/video-04.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Атмосфера',               thumb: 'https://aidacamp.ru/images/videos/video-05.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
];
---

<!-- Video modal -->
<dialog id="videoModal" style="margin:0;width:100%;max-width:none;height:100%;border:0;background:rgba(0,0,0,0.92);padding:0;backdrop-filter:blur(6px);">
  <div style="display:flex;align-items:center;justify-content:center;height:100%;position:relative;">
    <button id="videoModalClose" type="button" style="position:absolute;top:16px;right:16px;width:44px;height:44px;border-radius:var(--r-full);background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff;">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <iframe id="videoFrame" src="" allow="autoplay;fullscreen;picture-in-picture;" allowfullscreen style="width:min(560px,90vw);aspect-ratio:9/16;max-height:85vh;border:0;border-radius:var(--r-md);background:#000;"></iframe>
  </div>
</dialog>

<section>
  <div class="wrap">
    <div class="s-kicker r">Видео</div>
    <h2 class="r">Смотрите, как это <em>происходит</em></h2>
    <div style="display:flex;flex-wrap:wrap;gap:var(--gap-xs);margin-bottom:var(--gap-lg);" class="r">
      <button type="button" class="vid-tab-btn active" onclick="switchVidTab('projects',this)">Проекты</button>
      <button type="button" class="vid-tab-btn" onclick="switchVidTab('camp',this)">Видео</button>
    </div>

    <!-- Projects -->
    <div id="vtab-projects" style="display:grid;grid-template-columns:repeat(5,1fr);gap:var(--gap-sm);" class="r">
      {projects.map(v => (
        <button type="button" class="vid-card-btn" onclick={`openVideo('${v.url}')`}>
          <div class="vid-card-thumb">
            <img src={v.thumb} alt={v.title} loading="lazy"/>
            <div class="vid-play-btn">
              <div class="vid-play-icon">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <div class="vid-card-title">{v.title}</div>
        </button>
      ))}
    </div>

    <!-- Camp videos -->
    <div id="vtab-camp" style="display:none;grid-template-columns:repeat(3,1fr);gap:var(--gap-md);" class="r">
      {campVideos.map(v => (
        <button type="button" class="vid-card-btn" onclick={`openVideo('${v.url}')`}>
          <div style="position:relative;overflow:hidden;border-radius:var(--r-xl);aspect-ratio:16/9;">
            <img src={v.thumb} alt={v.title} loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s;"/>
            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);">
              <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,90,31,0.8);display:flex;align-items:center;justify-content:center;margin-bottom:var(--gap-sm);">
                <svg width="24" height="24" fill="#fff" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div style="font-size:var(--fs-sm);font-weight:600;color:#fff;text-align:center;padding:0 16px;">{v.title}</div>
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  function openVideo(url: string) {
    const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
    const frame = document.getElementById('videoFrame') as HTMLIFrameElement | null;
    if (!modal || !frame) return;
    frame.src = 'https://kinescope.io/embed/' + url.split('/').pop();
    modal.showModal();
  }

  const closeBtn = document.getElementById('videoModalClose');
  const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => {
      modal.close();
      const frame = document.getElementById('videoFrame') as HTMLIFrameElement | null;
      if (frame) frame.src = '';
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
        const frame = document.getElementById('videoFrame') as HTMLIFrameElement | null;
        if (frame) frame.src = '';
      }
    });
  }

  function switchVidTab(tab: string, el: HTMLElement) {
    document.querySelectorAll('.vid-tab-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    const projects = document.getElementById('vtab-projects') as HTMLElement | null;
    const camp = document.getElementById('vtab-camp') as HTMLElement | null;
    if (tab === 'projects') {
      if (projects) projects.style.display = 'grid';
      if (camp) camp.style.display = 'none';
    } else {
      if (projects) projects.style.display = 'none';
      if (camp) camp.style.display = 'grid';
    }
  }

  (window as any).openVideo = openVideo;
  (window as any).switchVidTab = switchVidTab;
</script>
