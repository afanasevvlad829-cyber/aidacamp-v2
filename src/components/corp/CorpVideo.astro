---
const projects = [
  { title: 'Моя ферма',              thumb: 'https://aidacamp.ru/images/videos/project-farm.avif',    url: 'https://kinescope.io/g2S7xxtEUP4S2E3WXYFNqZ' },
  { title: 'Программирование дронов', thumb: 'https://aidacamp.ru/images/videos/project-drones.avif',  url: 'https://kinescope.io/2ULnxEqqC4ssLNYCh5YPvo' },
  { title: 'Игра на Unity',          thumb: 'https://aidacamp.ru/images/videos/project-unity.avif',   url: 'https://kinescope.io/iFCF2uprpHLxx9VgJ1M7SP' },
  { title: 'Игра-исследователь',     thumb: 'https://aidacamp.ru/images/videos/project-explorer.avif',url: 'https://kinescope.io/0Vs3qPMJr7Kvz13MWsxcbc' },
  { title: 'Луиджи',                 thumb: 'https://aidacamp.ru/images/videos/project-luigi.avif',   url: 'https://kinescope.io/w1eZLPX8mqdC7dMniPaBWT' },
];
const campVideos = [
  { title: 'IT-лагерь — это не «сидеть за компьютером»', thumb: 'https://aidacamp.ru/images/videos/video-01.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Видео из лагеря',        thumb: 'https://aidacamp.ru/images/videos/video-02.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Хакатон',               thumb: 'https://aidacamp.ru/images/videos/video-03.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Финальный день',         thumb: 'https://aidacamp.ru/images/videos/video-04.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Атмосфера',             thumb: 'https://aidacamp.ru/images/videos/video-05.avif', url: 'https://kinescope.io/qmLxu2S7uaS44CKkhoV1Jj' },
];
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Видео</div>
    <h2 class="corp-h2 r mb-6">Смотрите, как это <em class="not-italic text-[var(--corp-or2)]">происходит</em></h2>

    <!-- Tabs -->
    <div class="r mb-8 flex flex-wrap gap-2">
      <button type="button" id="vtab-btn-projects" class="cursor-pointer rounded-lg border border-[var(--corp-or)] bg-[var(--corp-or)] px-5 py-2 text-sm font-semibold text-white transition-all">Проекты</button>
      <button type="button" id="vtab-btn-camp" class="cursor-pointer rounded-lg border border-[var(--corp-bdr)] px-5 py-2 text-sm font-semibold text-[var(--corp-txt2)] transition-all hover:border-[var(--corp-bdr2)] hover:text-[var(--corp-txt)]">Видео</button>
    </div>

    <!-- Projects tab — вертикальные карточки 9:16 -->
    <div id="vtab-projects" class="r grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {projects.map(v => (
        <a
          href={v.url}
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)]"
          style="aspect-ratio:9/16"
        >
          <img
            src={v.thumb}
            alt={v.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/70 via-black/20 to-transparent p-3">
            <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm ring-1 ring-white/30 transition-all group-hover:bg-[var(--corp-or)]">
              <i class="bi bi-play-fill text-sm text-white" aria-hidden="true"></i>
            </div>
            <div class="text-xs font-semibold leading-tight text-white">{v.title}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Camp tab — горизонтальные 16:9 -->
    <div id="vtab-camp" class="r hidden grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
      {campVideos.map(v => (
        <a
          href={v.url}
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)]"
          style="aspect-ratio:16/9"
        >
          <img
            src={v.thumb}
            alt={v.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/30 transition-all group-hover:bg-black/15">
            <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-[var(--corp-or)]/80 ring-2 ring-white/30 backdrop-blur-sm">
              <i class="bi bi-play-fill text-xl text-white" aria-hidden="true"></i>
            </div>
            <div class="px-4 text-center text-sm font-semibold leading-snug text-white drop-shadow">{v.title}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const btns = {
    projects: document.getElementById('vtab-btn-projects'),
    camp: document.getElementById('vtab-btn-camp'),
  };
  const panels = {
    projects: document.getElementById('vtab-projects'),
    camp: document.getElementById('vtab-camp'),
  };

  function switchTab(tab: string) {
    Object.entries(btns).forEach(([key, btn]) => {
      if (!btn) return;
      if (key === tab) {
        btn.classList.add('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.remove('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      } else {
        btn.classList.remove('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.add('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      }
    });
    Object.entries(panels).forEach(([key, panel]) => {
      if (!panel) return;
      if (key === tab) {
        panel.classList.remove('hidden');
        panel.classList.add('grid');
      } else {
        panel.classList.remove('grid');
        panel.classList.add('hidden');
      }
    });
  }

  btns.projects?.addEventListener('click', () => switchTab('projects'));
  btns.camp?.addEventListener('click', () => switchTab('camp'));
</script>
