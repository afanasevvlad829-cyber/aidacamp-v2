---
const projects = [
  { title: 'Моя ферма',               thumb: 'https://aidacamp.ru/images/videos/project-farm.avif',    id: 'g2S7xxtEUP4S2E3WXYFNqZ' },
  { title: 'Программирование дронов', thumb: 'https://aidacamp.ru/images/videos/project-drones.avif',  id: '2ULnxEqqC4ssLNYCh5YPvo' },
  { title: 'Игра на Unity',           thumb: 'https://aidacamp.ru/images/videos/project-unity.avif',   id: 'iFCF2uprpHLxx9VgJ1M7SP' },
  { title: 'Игра-исследователь',      thumb: 'https://aidacamp.ru/images/videos/project-explorer.avif',id: '0Vs3qPMJr7Kvz13MWsxcbc' },
  { title: 'Луиджи',                  thumb: 'https://aidacamp.ru/images/videos/project-luigi.avif',   id: 'w1eZLPX8mqdC7dMniPaBWT' },
];
const campVideos = [
  { title: 'IT-лагерь — это не «сидеть за компьютером»', thumb: 'https://aidacamp.ru/images/videos/video-01.avif', id: 'qmLxu2S7uaS44CKkhoV1Jj' },
  { title: 'Видео из лагеря',         thumb: 'https://aidacamp.ru/images/videos/video-02.avif', id: 'tJAaAnvCYYJ5vRz7uyUepj' },
  { title: 'Хакатон',                 thumb: 'https://aidacamp.ru/images/videos/video-03.avif', id: 'naDfzrei9duApz3AnaencH' },
  { title: 'Финальный день',          thumb: 'https://aidacamp.ru/images/videos/video-04.avif', id: 'eTmCgZHcwhcWQQs3HLCz1S' },
  { title: 'Атмосфера',               thumb: 'https://aidacamp.ru/images/videos/video-05.avif', id: 's1SCYKqLx6C94fMRumitHF' },
];

const playIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>`;
---

<section class="alt" id="video">
  <div class="wrap">
    <div class="s-kicker r">Видео</div>
    <h2 class="r">Смотрите, как это <em>происходит</em></h2>

    <!-- Tabs -->
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;" id="vid-tabs">
      <button type="button" class="vid-tab-btn active" id="vtab-btn-projects" onclick="switchVidTab('projects',this)">Проекты</button>
      <button type="button" class="vid-tab-btn" id="vtab-btn-camp" onclick="switchVidTab('camp',this)">Видео</button>
    </div>

    <!-- Projects tab — вертикальные 9:16 -->
    <div id="vtab-projects">
      <!-- Mobile: main + 4 thumbs -->
      <div class="vid-mobile-only">
        <button type="button" id="proj-main-btn" data-vopen={projects[0].id} style="background:none;border:none;padding:0;width:100%;cursor:pointer;text-align:left;">
          <div style="position:relative;overflow:hidden;border-radius:18px;aspect-ratio:9/16;max-width:260px;margin:0 auto;">
            <img id="proj-main-img" src={projects[0].thumb} alt={projects[0].title} style="width:100%;height:100%;object-fit:cover;">
            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.2);">
              <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.9);display:flex;align-items:center;justify-content:center;color:#FF5A1F;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <p id="proj-main-title" style="margin-top:8px;font-size:15px;font-weight:600;color:var(--txt);line-height:1.4;">{projects[0].title}</p>
        </button>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px;" id="proj-thumbs">
          {projects.slice(1).map(v => (
            <button type="button" class="proj-thumb-btn" data-url={v.id} data-thumb={v.thumb} data-title={v.title} style="background:none;border:none;padding:0;cursor:pointer;">
              <div style="position:relative;overflow:hidden;border-radius:10px;aspect-ratio:9/16;">
                <img src={v.thumb} alt={v.title} style="width:100%;height:100%;object-fit:cover;" loading="lazy">
                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);">
                  <div style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;color:#FF5A1F;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Desktop: 5 карточек -->
      <div class="vid-desktop-only" style="grid-template-columns:repeat(5,1fr);gap:16px;">
        {projects.map(v => (
          <button type="button" data-vopen={v.id} class="vid-card-btn">
            <div class="vid-card-thumb">
              <img src={v.thumb} alt={v.title} loading="lazy">
              <div class="vid-play-btn">
                <div class="vid-play-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <p class="vid-card-title">{v.title}</p>
          </button>
        ))}
      </div>
    </div>

    <!-- Camp videos tab — горизонтальные 16:9 на десктопе, вертикальные 9:16 на мобиле -->
    <div id="vtab-camp" style="display:none;">
      <!-- Mobile: горизонтальный scroll -->
      <div class="vid-mobile-only">
        <div style="display:flex;gap:12px;overflow-x:auto;padding-bottom:8px;-webkit-overflow-scrolling:touch;">
          {campVideos.map(v => (
            <button type="button" data-vopen={v.id} style="background:none;border:none;padding:0;cursor:pointer;flex-shrink:0;">
              <div style="position:relative;overflow:hidden;border-radius:10px;aspect-ratio:9/16;width:140px;">
                <img src={v.thumb} alt={v.title} style="width:100%;height:100%;object-fit:cover;" loading="lazy">
                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);">
                  <div style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;color:#FF5A1F;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Desktop: 5 карточек горизонтальные 16:9 -->
      <div class="vid-desktop-only" style="grid-template-columns:repeat(5,1fr);gap:16px;">
        {campVideos.map(v => (
          <button type="button" data-vopen={v.id} class="vid-card-btn">
            <div class="vid-card-thumb" style="aspect-ratio:9/16;">
              <img src={v.thumb} alt={v.title} loading="lazy">
              <div class="vid-play-btn">
                <div class="vid-play-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <p class="vid-card-title">{v.title}</p>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Video Modal (dialog) -->
<dialog id="videoModal" style="margin:0;width:100%;max-width:none;height:100%;border:0;background:rgba(0,0,0,0.92);padding:0;backdrop-filter:blur(6px);">
  <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;position:relative;">
    <button id="videoModalClose" style="position:absolute;top:16px;right:16px;width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff;" aria-label="Закрыть">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <iframe id="videoFrame" src="" allow="autoplay;fullscreen;picture-in-picture;" allowfullscreen style="width:min(560px,90vw);aspect-ratio:9/16;max-height:85vh;border:0;border-radius:12px;background:#000;"></iframe>
  </div>
</dialog>

<style>
.vid-tab-btn { padding: 8px 20px; border-radius: 4px; font-size: 14px; font-weight: 600; background: var(--bg3); border: 1px solid var(--bdr); cursor: pointer; color: var(--txt2); transition: all 0.2s; }
.vid-tab-btn.active { background: var(--or); border-color: var(--or); color: #fff; }
.vid-tab-btn:hover:not(.active) { border-color: var(--bdr2); color: var(--txt); }
.vid-mobile-only { display: none; }
.vid-desktop-only { display: grid; }
.vid-card-btn { background: none; border: none; padding: 0; cursor: pointer; text-align: left; }
.vid-card-thumb { position: relative; overflow: hidden; border-radius: 18px; aspect-ratio: 9/16; }
.vid-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.vid-card-btn:hover .vid-card-thumb img { transform: scale(1.05); }
.vid-play-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.2); }
.vid-play-icon { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; color: #FF5A1F; }
.vid-card-title { margin-top: 8px; font-size: 13px; font-weight: 600; color: var(--txt); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
@media (max-width: 767px) {
  .vid-mobile-only { display: block !important; }
  .vid-desktop-only { display: none !important; }
}
</style>

<script>
// Video modal
(function() {
  const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
  const frame = document.getElementById('videoFrame') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('videoModalClose');

  function openVideo(id: string) {
    if (!modal || !frame) return;
    frame.src = 'https://kinescope.io/embed/' + id + '?autoplay=1';
    modal.showModal();
  }

  function closeVideo() {
    if (!modal || !frame) return;
    frame.src = '';
    modal.close();
  }

  closeBtn?.addEventListener('click', closeVideo);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeVideo(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal?.open) closeVideo(); });

  // All data-vopen buttons
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element)?.closest('[data-vopen]') as HTMLElement | null;
    if (btn) openVideo(btn.dataset.vopen || '');
  });

  // Mobile: proj-main-btn opens video
  const projMainBtn = document.getElementById('proj-main-btn');
  projMainBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const id = (projMainBtn as HTMLElement).dataset.vopen || '';
    if (id) openVideo(id);
  });

  // Mobile: thumb click → update main + open video
  document.querySelectorAll('.proj-thumb-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLElement;
      const url = b.dataset.url || '';
      const thumb = b.dataset.thumb || '';
      const title = b.dataset.title || '';
      const mainImg = document.getElementById('proj-main-img') as HTMLImageElement | null;
      const mainTitle = document.getElementById('proj-main-title');
      const mainBtn = document.getElementById('proj-main-btn') as HTMLElement | null;
      if (mainImg) mainImg.src = thumb;
      if (mainTitle) mainTitle.textContent = title;
      if (mainBtn) mainBtn.dataset.vopen = url;
      openVideo(url);
    });
  });
})();

// Tab switching
function switchVidTab(tab: string, btn: HTMLElement) {
  document.querySelectorAll('.vid-tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const projects = document.getElementById('vtab-projects');
  const camp = document.getElementById('vtab-camp');
  if (tab === 'projects') {
    if (projects) projects.style.display = '';
    if (camp) camp.style.display = 'none';
  } else {
    if (projects) projects.style.display = 'none';
    if (camp) camp.style.display = '';
  }
}
</script>
