---
// Video section — project demos + camp footage
const projects = [
  { title: 'Ферма-менеджер',    thumb: 'https://aidacamp.ru/images/videos/project-farm.avif',    url: 'https://kinescope.io/g2S7xxtEUP4S2E3WXYFNqZ' },
  { title: 'Игра-квест',         thumb: 'https://aidacamp.ru/images/videos/project-quest.avif',   url: 'https://kinescope.io/9QbMaweMb3oMBqD7h2T9Ro' },
  { title: 'Телеграм-бот',       thumb: 'https://aidacamp.ru/images/videos/project-bot.avif',     url: 'https://kinescope.io/fDnzVMbJ4tBPHZEMHq4yvq' },
  { title: 'Сайт-портфолио',    thumb: 'https://aidacamp.ru/images/videos/project-site.avif',    url: 'https://kinescope.io/aFTxHPvKcEXsMNZBbL7gBn' },
  { title: 'Игра на Python',     thumb: 'https://aidacamp.ru/images/videos/project-game.avif',    url: 'https://kinescope.io/hFgkXvLbQpCmNdJeYwR3Tz' },
];
const campVideos = [
  { title: 'Атмосфера лагеря',   thumb: 'https://aidacamp.ru/images/videos/camp-vibe.avif',       url: 'https://kinescope.io/mKpNvZqB4xRtSdYgWcHjEu' },
  { title: 'Хакатон 2025',       thumb: 'https://aidacamp.ru/images/videos/camp-hackathon.avif',  url: 'https://kinescope.io/rLwXtFsJyDqPvCmGnBhKzA' },
  { title: 'Финальный день',      thumb: 'https://aidacamp.ru/images/videos/camp-final.avif',      url: 'https://kinescope.io/uPqXcVbZkMnYsDtGhRjWfL' },
];
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Видео</div>
    <h2 class="corp-h2 r mb-6">Смотрите, как это <em class="not-italic text-[var(--corp-or2)]">происходит</em></h2>

    <!-- Tabs -->
    <div class="r mb-8 flex flex-wrap gap-2" id="vid-tabs">
      <button type="button" id="vtab-btn-projects" class="vid-tab-active cursor-pointer rounded-full border border-[var(--corp-or)] bg-[var(--corp-or)] px-4 py-2 text-sm font-bold text-white transition-all">Проекты</button>
      <button type="button" id="vtab-btn-camp" class="cursor-pointer rounded-full border border-[var(--corp-bdr)] px-4 py-2 text-sm font-bold text-[var(--corp-txt2)] transition-all hover:border-[var(--corp-or)] hover:text-[var(--corp-txt)]">Видео</button>
    </div>

    <!-- Projects tab -->
    <div id="vtab-projects" class="r">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {projects.map(v => (
          <a
            href={v.url}
            target="_blank"
            rel="noopener"
            class="group relative block aspect-[9/16] max-w-[200px] cursor-pointer overflow-hidden rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)]"
          >
            <img
              src={v.thumb}
              alt={v.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/70 to-transparent p-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                <i class="bi bi-play-fill text-white" aria-hidden="true"></i>
              </div>
              <div class="mt-2 text-xs font-semibold text-white">{v.title}</div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Camp tab -->
    <div id="vtab-camp" class="r hidden">
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {campVideos.map(v => (
          <a
            href={v.url}
            target="_blank"
            rel="noopener"
            class="group relative block aspect-video cursor-pointer overflow-hidden rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)]"
          >
            <img
              src={v.thumb}
              alt={v.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/30 backdrop-blur-[1px] transition-all group-hover:bg-black/10">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--corp-or)]/80 backdrop-blur-sm">
                <i class="bi bi-play-fill text-xl text-white" aria-hidden="true"></i>
              </div>
              <div class="mt-3 text-sm font-semibold text-white drop-shadow">{v.title}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const btns = {
    projects: document.getElementById('vtab-btn-projects'),
    camp: document.getElementById('vtab-btn-camp'),
  };
  const panels = {
    projects: document.getElementById('vtab-projects'),
    camp: document.getElementById('vtab-camp'),
  };

  function switchTab(tab: string) {
    Object.entries(btns).forEach(([key, btn]) => {
      if (!btn) return;
      if (key === tab) {
        btn.classList.add('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.remove('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      } else {
        btn.classList.remove('bg-[var(--corp-or)]', 'text-white', 'border-[var(--corp-or)]');
        btn.classList.add('border-[var(--corp-bdr)]', 'text-[var(--corp-txt2)]');
      }
    });
    Object.entries(panels).forEach(([key, panel]) => {
      if (panel) panel.classList.toggle('hidden', key !== tab);
    });
  }

  btns.projects?.addEventListener('click', () => switchTab('projects'));
  btns.camp?.addEventListener('click', () => switchTab('camp'));
</script>
