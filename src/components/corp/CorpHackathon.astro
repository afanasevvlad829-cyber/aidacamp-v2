---
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">

      <!-- Left: text -->
      <div>
        <div class="corp-kicker r">Финал смены</div>
        <h2 class="corp-h2 r mb-4">Хакатон: один день —<br/><em class="not-italic text-[var(--corp-or2)]">настоящий стартап</em></h2>
        <p class="r text-lg leading-relaxed text-[var(--corp-txt2)]">
          Последние 2 дня — командный хакатон. Участники разбиваются на команды,
          создают продукт и презентуют его жюри. Не игрушечный — настоящий.
        </p>
        <div class="r mt-6 space-y-3">
          {[
            'Команды формируются по интересам и уровню',
            'Работа в роли: продакт, дизайнер, разработчик',
            'Защита перед взрослым жюри',
            'Дипломы и сертификаты победителям',
          ].map(item => (
            <div class="flex items-start gap-3">
              <i class="bi bi-check-circle-fill mt-0.5 shrink-0 text-[var(--corp-green)]" aria-hidden="true"></i>
              <span class="text-base text-[var(--corp-txt2)]">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: big numbers -->
      <div class="r grid grid-cols-2 gap-4">
        {[
          { num: '8',   unit: 'треков',     label: 'от Scratch до AI и кибербезопасности' },
          { num: '2',   unit: 'дня',        label: 'хакатон в конце каждой смены' },
          { num: '4–5', unit: 'чел.',       label: 'на одного педагога-наставника' },
          { num: '40+', unit: 'часов',      label: 'практики за смену' },
        ].map(stat => (
          <div class="rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5">
            <div class="font-['Unbounded'] text-3xl font-black text-[var(--corp-or)] md:text-4xl">{stat.num}</div>
            <div class="mb-1 text-sm font-bold text-[var(--corp-txt)]">{stat.unit}</div>
            <div class="text-xs leading-relaxed text-[var(--corp-txt2)]">{stat.label}</div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
