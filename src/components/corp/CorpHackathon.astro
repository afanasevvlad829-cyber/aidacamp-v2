---
const roles = [
  { label: 'Разработчик',       desc: 'Пишет код и собирает прототип. Отвечает за техническую часть — без него нечего показывать инвесторам.' },
  { label: 'Дизайнер',          desc: 'Делает интерфейс и логотип с помощью AI. Отвечает за то, как продукт выглядит.' },
  { label: 'Маркетолог',        desc: 'Придумывает название, слоган, готовит питч. Знает кому и зачем это нужно.' },
  { label: 'Финансовый директор', desc: 'Управляет бюджетом команды — покупает ресурсы, следит чтобы деньги не кончились раньше защиты.' },
  { label: 'Стратег',           desc: 'Определяет что делаем, для кого и чем отличаемся от других команд.' },
  { label: 'Тестировщик',       desc: 'Ищет баги и слабые места до питча. Задаёт неудобные вопросы своей же команде.' },
];
const steps = [
  { num: '01', title: 'Идея и паспорт проекта',   text: 'Брейншторм, паспорт проекта: для кого, какую проблему решает, чем отличается от других команд.' },
  { num: '02', title: 'Покупка ресурсов',          text: 'Рабочее место, интернет, консультации экспертов — всё за игровую валюту. Ресурсы ограничены.' },
  { num: '03', title: 'Разработка и AI',           text: 'Прототип, техзадание, AI для логотипа и текстов. Тестировщики ищут слабые места в своей же команде.' },
  { num: '04', title: 'Питч перед инвесторами',    text: 'Два тура инвестиций. Финальная защита — 5 минут на питч и вопросы жюри. Проект уходит домой.' },
];
const results = [
  'Опыт командной работы с распределёнными ролями',
  'Понимание что такое продукт, бюджет и питч',
  'Ощущение что сделал что-то настоящее — не учебное задание',
];
const tags = ['Python', 'JavaScript', 'Java', 'ИИ-агенты', 'Стартап-формат', 'Публичная защита'];
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Внутри смены</div>
    <h2 class="corp-h2 r mb-4">Хакатон: один день —<br/><em class="not-italic text-[var(--corp-or2)]">настоящий стартап</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">Хакатон — это отдельное событие внутри смены, во второй её половине. Не продолжение проекта, а другой формат: команда, стартап, инвесторы.</p>

    <!-- Роли -->
    <div class="r mb-8">
      <div class="mb-3 font-semibold text-[var(--corp-txt)]">Команда собирается с нуля — роли распределяются сразу:</div>
      <div class="flex flex-wrap gap-2">
        {roles.map(r => (
          <button type="button" class="role-badge" data-desc={r.desc}>{r.label}</button>
        ))}
      </div>
      <div id="role-popup" class="role-popup-hidden mt-3 rounded-lg border border-[rgba(255,90,31,0.25)] bg-[rgba(255,90,31,0.08)] px-5 py-3.5 text-sm leading-relaxed text-[var(--corp-txt)]">
        <span id="role-popup-name" class="font-bold text-[var(--corp-or2)]"></span>
        <span> — </span>
        <span id="role-popup-desc"></span>
      </div>
    </div>

    <!-- 2-кол сетка -->
    <div class="r grid gap-12 lg:grid-cols-2">
      <!-- Шаги -->
      <div class="divide-y divide-[var(--corp-bdr)]">
        {steps.map(step => (
          <div class="flex gap-6 py-6 first:pt-0 last:pb-0">
            <div class="w-12 flex-shrink-0 font-['Unbounded'] text-3xl font-black leading-none text-[rgba(255,90,31,0.55)]">{step.num}</div>
            <div>
              <div class="mb-1 font-bold text-[var(--corp-txt)]">{step.title}</div>
              <div class="text-sm leading-relaxed text-[var(--corp-txt2)]">{step.text}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Итоги -->
      <div class="rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-10 text-center">
        <div class="mb-6 text-xs font-bold uppercase tracking-widest text-[var(--corp-or)]">Что остаётся после</div>
        <div class="mb-8 flex flex-col gap-4 text-left">
          {results.map(item => (
            <div class="flex items-start gap-3">
              <i class="bi bi-check-lg mt-0.5 flex-shrink-0 text-[var(--corp-or2)]" aria-hidden="true"></i>
              <span class="text-sm leading-relaxed text-[var(--corp-txt2)]">{item}</span>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {tags.map(tag => (
            <span class="rounded border border-[var(--corp-bdr2)] bg-[var(--corp-bg3)] px-4 py-2 text-sm font-semibold text-[var(--corp-txt2)]">{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
.role-badge {
  font-size: 13px; font-weight: 600; padding: 8px 16px; border-radius: 4px;
  background: var(--corp-bg3); border: 1px solid var(--corp-bdr2);
  color: var(--corp-txt2); cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.role-badge:hover,
.role-badge.active-role {
  background: rgba(255,90,31,0.12); border-color: rgba(255,90,31,0.4); color: var(--corp-or2);
}
.role-popup-hidden { display: none; }
.role-popup-visible { display: block; }
</style>

<script>
document.querySelectorAll('.role-badge').forEach(btn => {
  btn.addEventListener('click', () => {
    const popup = document.getElementById('role-popup');
    const nameEl = document.getElementById('role-popup-name');
    const descEl = document.getElementById('role-popup-desc');
    if (!popup || !nameEl || !descEl) return;
    const el = btn as HTMLElement;
    document.querySelectorAll('.role-badge').forEach(b => b.classList.remove('active-role'));
    el.classList.add('active-role');
    nameEl.textContent = el.textContent || '';
    descEl.textContent = el.dataset.desc || '';
    popup.classList.remove('role-popup-hidden');
    popup.classList.add('role-popup-visible');
  });
});
</script>
