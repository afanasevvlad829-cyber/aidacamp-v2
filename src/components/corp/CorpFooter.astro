---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<footer class="border-t border-[var(--corp-bdr)] bg-[var(--corp-bg2)] py-10">
  <div class="corp-wrap">
    <div class="flex flex-col items-center gap-4 text-center md:flex-row md:justify-between md:text-left">
      <div>
        <div class="font-['Unbounded'] text-lg font-black text-[var(--corp-txt)]">
          АйДа<span class="text-[var(--corp-or2)]">Кемп</span>
        </div>
        <div class="mt-1 text-xs text-[var(--corp-txt2)]">Партнёрская программа · {client.clientName}</div>
      </div>

      <div class="flex flex-col gap-1 text-center">
        <a href="tel:74951284429" class="text-sm font-semibold text-[var(--corp-txt)] hover:text-[var(--corp-or2)] transition-colors">{client.phone}</a>
        <a href="mailto:hello@codims.ru" class="text-xs text-[var(--corp-txt2)] hover:text-[var(--corp-or2)] transition-colors">hello@codims.ru</a>
      </div>

      <div class="text-xs text-[var(--corp-txt2)]">
        <div>Лицензия Минобра № Л035-01298-77/01082973</div>
        <div class="mt-1">© {new Date().getFullYear()} АйДаКемп</div>
      </div>
    </div>
  </div>
</footer>
