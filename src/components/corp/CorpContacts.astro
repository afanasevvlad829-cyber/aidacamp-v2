---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;

const contacts = [
  { type: 'Телефон', val: client.phone,       href: `tel:${client.phone.replace(/\D/g, '')}`,         icon: 'bi-telephone' },
  { type: 'Телефон', val: '+7 (968) 808-64-55', href: 'tel:+79688086455',                             icon: 'bi-telephone' },
  { type: 'Telegram', val: '@Progaschool',     href: 'https://t.me/Progaschool',                      icon: 'bi-telegram' },
  { type: 'E-mail',  val: 'hello@codims.ru',   href: 'mailto:hello@codims.ru',                        icon: 'bi-envelope-fill' },
];
---

<section class="corp-section corp-section-alt" id="contacts">
  <div class="corp-wrap">
    <div class="grid gap-12 md:grid-cols-2 md:items-start">

      <!-- Left -->
      <div>
        <div class="corp-kicker r">Записаться</div>
        <h2 class="corp-h2 r mb-4">Есть вопросы —<br /><em class="not-italic text-[var(--corp-or2)]">звоните или пишите</em></h2>
        <p class="r mb-6 text-lg leading-relaxed text-[var(--corp-txt2)]">
          Отвечаем с 11:00 до 20:00 МСК в течение 10 минут. Скажите «я из {client.clientName}» — скидка применяется сразу.
        </p>
        <div class="r rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] px-5 py-4 text-sm leading-relaxed text-[var(--corp-txt2)]">
          В цену входит: проживание, <strong class="text-[var(--corp-txt)]">5-разовое питание</strong>, все занятия,
          материалы, бассейн, спорт, медсестра. Ноутбук не нужен.
        </div>
      </div>

      <!-- Right -->
      <div class="r grid gap-3 sm:grid-cols-2">
        {contacts.map(c => (
          <a
            href={c.href}
            target={c.type === 'Telegram' ? '_blank' : undefined}
            rel={c.type === 'Telegram' ? 'noopener' : undefined}
            class="group flex flex-col gap-3 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5 transition-all duration-200 hover:border-[var(--corp-or)] hover:bg-[rgba(255,90,31,0.04)]"
          >
            <div class="text-xs font-bold uppercase tracking-widest text-[var(--corp-txt2)]">{c.type}</div>
            <div class="flex items-center gap-3">
              <i class={`bi ${c.icon} shrink-0 text-xl text-[var(--corp-or)]`} aria-hidden="true"></i>
              <span class="font-bold text-[var(--corp-txt)] group-hover:text-[var(--corp-or2)]">{c.val}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>
