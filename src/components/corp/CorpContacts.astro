---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<section id="contacts" class="alt">
  <div class="wrap">
    <div class="contacts-grid">
      <div>
        <div class="s-kicker r">Записаться</div>
        <h2 class="r">Есть вопросы —<br/><em>звоните или пишите</em></h2>
        <p class="r" style="font-size:var(--fs-md);color:var(--txt2);line-height:1.75;margin-bottom:var(--gap-lg);">Отвечаем с 11:00 до 20:00 МСК в течение 10 минут. Скажите «я из {client.clientName}» — скидка применяется сразу.</p>
        <div class="corp-note r">
          В цену входит: проживание, <strong>5-разовое питание</strong>, все занятия, материалы, бассейн, спорт, медсестра. Ноутбук не нужен.
        </div>
      </div>
      <div class="r">
        <div class="contact-cards">
          <a href={`tel:${client.phone.replace(/\D/g, '')}`} class="contact-card">
            <div class="contact-type">Телефон</div>
            <div class="contact-card-inner">
              <svg class="ico" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <div class="contact-val">{client.phone}</div>
            </div>
          </a>
          <a href="https://t.me/Progaschool" target="_blank" rel="noopener" class="contact-card">
            <div class="contact-type">Telegram</div>
            <div class="contact-card-inner">
              <svg class="ico" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              <div class="contact-val">@Progaschool</div>
            </div>
          </a>
          <a href="mailto:hello@codims.ru" class="contact-card">
            <div class="contact-type">Email</div>
            <div class="contact-card-inner">
              <svg class="ico" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
              <div class="contact-val">hello@codims.ru</div>
            </div>
          </a>
          <a href="https://yandex.ru/maps/org/aydakemp/35558479035/" target="_blank" rel="noopener" class="contact-card">
            <div class="contact-type">Яндекс.Карты</div>
            <div class="contact-card-inner">
              <svg class="ico" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
              <div class="contact-val">★ 5.0 · 40+ отзывов</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
