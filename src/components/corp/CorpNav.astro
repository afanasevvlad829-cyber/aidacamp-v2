---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<nav>
  <div class="nav-inner">
    <div class="nav-logo">АйДа<em>Кемп</em></div>
    <div class="nav-badge">{client.partnerBadge}</div>
    <div class="nav-right">
      <a href={`tel:${client.phone.replace(/\D/g, '')}`} class="nav-tel">{client.phone}</a>
      <button class="theme-toggle" id="themeBtn" title="Сменить тему" aria-label="Сменить тему">
        <svg id="ico-moon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:block">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg id="ico-sun" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:none">
          <circle cx="12" cy="12" r="5"/>
          <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </button>
    </div>
  </div>
</nav>
