---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-[rgba(255,255,255,0.06)] bg-[#0C0E11]/90 backdrop-blur-md">
  <div class="corp-wrap flex items-center justify-between h-16 md:h-[68px]">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 font-['Unbounded'] text-lg font-black tracking-tight text-[var(--corp-txt)] no-underline">
      АйДа<span class="text-[var(--corp-or2)]">Кемп</span>
    </a>

    <!-- Partner badge (desktop) -->
    <div class="hidden md:flex items-center gap-2 rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-xs font-semibold tracking-widest text-[var(--corp-txt2)] uppercase">
      {client.partnerBadge}
    </div>

    <!-- Phone -->
    <a
      href={`tel:${client.phone.replace(/\D/g, '')}`}
      class="text-sm font-bold text-[var(--corp-txt)] no-underline hover:text-[var(--corp-or2)] transition-colors"
    >
      {client.phone}
    </a>
  </div>

  <!-- Partner badge (mobile) -->
  <div class="md:hidden border-t border-[var(--corp-bdr)] px-4 py-2 text-center text-[10px] font-semibold tracking-widest text-[var(--corp-txt2)] uppercase">
    {client.partnerBadge}
  </div>
</header>
