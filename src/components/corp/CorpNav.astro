---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<header
  id="corp-nav"
  class="sticky top-0 z-50 border-b border-[var(--corp-bdr)] backdrop-blur-md transition-colors duration-300"
  style="background: var(--corp-nav-bg);"
>
  <div class="corp-wrap flex h-16 items-center justify-between md:h-[68px]">

    <!-- Logo -->
    <a href="/" class="shrink-0 font-['Unbounded'] text-lg font-black tracking-tight text-[var(--corp-txt)] no-underline">
      АйДа<span class="text-[var(--corp-or2)]">Кемп</span>
    </a>

    <!-- Partner badge (desktop) -->
    <div class="hidden items-center gap-2 rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[var(--corp-txt2)] md:flex">
      {client.partnerBadge}
    </div>

    <!-- Right: phone + theme toggle -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${client.phone.replace(/\D/g, '')}`}
        class="text-sm font-bold text-[var(--corp-txt)] no-underline transition-colors hover:text-[var(--corp-or2)]"
      >
        {client.phone}
      </a>

      <!-- Theme toggle -->
      <button
        id="corp-theme-toggle"
        type="button"
        aria-label="Сменить тему"
        title="Сменить тему"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-[var(--corp-bdr2)] bg-[var(--corp-bg3)] text-[var(--corp-txt2)] transition-all hover:border-[var(--corp-or)] hover:text-[var(--corp-or)]"
      >
        <!-- Moon — shown in light mode (click → go dark) -->
        <svg id="corp-ico-moon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:block">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <!-- Sun — shown in dark mode (click → go light) -->
        <svg id="corp-ico-sun" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:none">
          <circle cx="12" cy="12" r="5" />
          <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Partner badge (mobile) -->
  <div class="border-t border-[var(--corp-bdr)] px-4 py-2 text-center text-[10px] font-semibold uppercase tracking-widest text-[var(--corp-txt2)] md:hidden">
    {client.partnerBadge}
  </div>
</header>

<script>
  // Sync icon with current theme on load
  const theme = document.documentElement.getAttribute('data-theme');
  const moon = document.getElementById('corp-ico-moon');
  const sun  = document.getElementById('corp-ico-sun');
  if (moon) moon.style.display = theme === 'dark' ? 'none' : 'block';
  if (sun)  sun.style.display  = theme === 'dark' ? 'block' : 'none';
</script>
