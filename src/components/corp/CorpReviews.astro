---
import { reviews } from '../../data/corp/shared';
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Отзывы родителей</div>
    <h2 class="corp-h2 r mb-10">Говорят <em class="not-italic text-[var(--corp-or2)]">родители</em></h2>

    <div class="grid gap-4 md:grid-cols-2">
      {reviews.map((rv) => (
        <div class="r rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-6">
          <div class="mb-4 flex items-center gap-3">
            <img
              src={rv.photo}
              alt={rv.name}
              width="44"
              height="44"
              class="h-11 w-11 rounded-full object-cover"
              loading="lazy"
            />
            <div>
              <div class="font-semibold text-[var(--corp-txt)]">{rv.name}</div>
              <div class="text-xs text-[var(--corp-txt2)]">{rv.date}</div>
            </div>
            <div class="ml-auto flex gap-0.5">
              {Array.from({ length: rv.rating }).map(() => (
                <svg class="h-4 w-4 text-[var(--corp-or)]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>
          <p class="text-base leading-relaxed text-[var(--corp-txt2)]">«{rv.short}»</p>
        </div>
      ))}
    </div>
  </div>
</section>
