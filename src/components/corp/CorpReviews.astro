---
const reviews = [
  { name:'Анна К.', date:'март 2025', stars:'★★★★★', short:'Сын вернулся с проектом — мы все были в шоке, насколько крутой.', full:'Сын вернулся с проектом — мы все были в шоке, насколько крутой. Он написал игру на Python и ещё до конца смены начал её дорабатывать дома. Педагоги объясняют сложное просто, без педагогических заморочек. Однозначно едем ещё.', initials:'А' },
  { name:'Михаил Д.', date:'июль 2024', stars:'★★★★★', short:'Дочь 10 лет начала с нуля, уехала с JavaScript-проектом.', full:'Дочь 10 лет начала с нуля, уехала с JavaScript-проектом. Я сам разработчик — боялся что будет слишком просто, но педагог разобрался с её уровнем и дал реальные задачи. Бассейн, питание, безопасность — всё на уровне.', initials:'М' },
  { name:'Елена С.', date:'август 2024', stars:'★★★★★', short:'Первый раз отпустила ребёнка в лагерь — не пожалела ни разу.', full:'Первый раз отпустила ребёнка в лагерь — не пожалела ни разу. Каждый день присылал скриншоты своего проекта. Педагоги отвечали на вопросы родителей в чате. Организация на высоте.', initials:'Е' },
  { name:'Дмитрий П.', date:'июнь 2024', stars:'★★★★★', short:'Рекомендую всем коллегам из IT — дети получают настоящий опыт.', full:'Рекомендую всем коллегам из IT — дети получают настоящий опыт. Не Scratch для галочки, а реальные инструменты. Сын изучал Python и AI-агентов, вернулся с горящими глазами и уже пишет второй проект.', initials:'Д' },
  { name:'Ольга Т.', date:'август 2023', stars:'★★★★★', short:'Двое детей, разный возраст — оба остались довольны.', full:'Двое детей, разный возраст — оба остались довольны. Старший (13) работал на продвинутом Python, младший (8) делал анимацию на Scratch. Педагоги индивидуально работают с каждым. Отличный лагерь.', initials:'О' },
  { name:'Сергей Р.', date:'июль 2024', stars:'★★★★★', short:'Сын уже третий раз едет — лучшая рекомендация.', full:'Сын уже третий раз едет — лучшая рекомендация. Каждый раз берёт новый трек, растёт заметно. В этом году планируем Python (старшие). Организация, питание, безопасность — всегда без нареканий.', initials:'С' },
];
---

<section id="reviews">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--gap-sm);margin-bottom:var(--gap-xs);">
      <h2 style="margin-bottom:0;">Отзывы</h2>
      <div style="display:flex;align-items:center;gap:var(--gap-xs);">
        <span style="font-size:var(--fs-2xl);font-weight:900;color:var(--txt);">5.0</span>
        <span style="color:var(--or2);font-size:var(--fs-lg);">★★★★★</span>
      </div>
    </div>
    <p style="font-size:var(--fs-md);color:var(--txt2);margin-bottom:var(--gap-xl);">Более 40 реальных отзывов на <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener" style="color:var(--or2);">Яндекс.Картах</a></p>

    <div class="reviews-grid r">
      {reviews.map(r => (
        <div class="review-card">
          <div class="review-top">
            <div class="review-avatar">{r.initials}</div>
            <div>
              <div class="review-name">{r.name}</div>
              <div class="review-meta-text">{r.date}</div>
            </div>
            <div class="review-stars">{r.stars}</div>
          </div>
          <div class="review-text">«{r.short}»</div>
        </div>
      ))}
    </div>

    <div style="margin-top:var(--gap-xl);text-align:center;" class="r">
      <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener" class="btn-ghost" style="display:inline-flex;">
        Все отзывы на Яндекс.Картах
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="margin-left:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>
</section>
