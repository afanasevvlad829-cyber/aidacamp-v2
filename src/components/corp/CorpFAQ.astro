---
import { faqItems } from '../../data/corp/shared';
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Частые вопросы</div>
    <h2 class="corp-h2 r mb-10">Ответы на <em class="not-italic text-[var(--corp-or2)]">частые вопросы</em></h2>

    <div class="mx-auto max-w-3xl divide-y divide-[var(--corp-bdr)]">
      {faqItems.map((item) => (
        <details class="r group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-[var(--corp-txt)] md:text-lg">
            {item.q}
            <i class="bi bi-plus-lg shrink-0 text-[var(--corp-or)] transition-transform group-open:rotate-45" aria-hidden="true"></i>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-[var(--corp-txt2)]">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
