---
// Team section — mentors + book card
const mentors = [
  {
    name: 'Дарья Афанасьева',
    role: 'Основатель АйДаКемп',
    photo: 'https://aidacamp.ru/images/team/darya.avif',
    bio: 'Педагог, руководитель образовательных программ. Создала АйДаКемп как лагерь, где дети делают настоящие проекты, а не просто смотрят на экран.',
  },
  {
    name: 'Алексей Воронин',
    role: 'Senior Python Dev · Ментор',
    photo: 'https://aidacamp.ru/images/team/alexey.avif',
    bio: '8 лет в разработке. Ведёт треки Python и AI. Автор задач для олимпиады ЛАНИТ. Дети называют его «тот, кто объясняет так, что доходит».',
  },
  {
    name: 'Мария Соколова',
    role: 'Frontend Dev · Ментор',
    photo: 'https://aidacamp.ru/images/team/maria.avif',
    bio: 'Специализируется на web-разработке и UI. Ведёт треки HTML/CSS и JavaScript. Делает занятия по дизайну интерфейсов.',
  },
  {
    name: 'Иван Крылов',
    role: 'Game Dev · Ментор',
    photo: 'https://aidacamp.ru/images/team/ivan.avif',
    bio: 'Разрабатывает игры на Unity и Python. Ведёт Scratch и GameDev-треки. Финалист GameJam 2024.',
  },
  {
    name: 'Анастасия Белова',
    role: 'Data Science · Ментор',
    photo: 'https://aidacamp.ru/images/team/anastasia.avif',
    bio: 'ML-инженер в дневное время, ментор вечером. Ведёт Data Science трек — от pandas до нейросетей.',
  },
  {
    name: 'Кирилл Новиков',
    role: 'Backend Dev · Ментор',
    photo: 'https://aidacamp.ru/images/team/kirill.avif',
    bio: 'Python и Django-разработчик. Ведёт Python Advanced и Backend треки. Учит писать код так, чтобы не стыдно показать.',
  },
];
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Команда</div>
    <h2 class="corp-h2 r mb-2">Менторы и <em class="not-italic text-[var(--corp-or2)]">педагоги</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">Действующие разработчики — не просто учителя. Авторы собственной книги по Python для детей.</p>

    <!-- Book card -->
    <div class="r mb-8 flex flex-wrap items-center gap-6 rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-6 md:p-8">
      <img
        src="https://aidacamp.ru/images/team/team-book-main-01.webp"
        alt="Книга Python для детей"
        class="h-28 w-auto shrink-0 rounded-lg object-contain shadow-lg transition-transform duration-200 hover:scale-105"
        loading="lazy"
      />
      <div>
        <div class="mb-1 text-xs font-bold uppercase tracking-widest text-[var(--corp-or)]">Авторская разработка</div>
        <div class="mb-2 text-xl font-bold text-[var(--corp-txt)]">«Python для детей и подростков»</div>
        <p class="text-sm leading-relaxed text-[var(--corp-txt2)]">
          Методическое пособие, по которому учатся дети в АйДаКемп. Написано менторами лагеря —
          практиками, а не академическими авторами. Понятно с 8 лет.
        </p>
      </div>
    </div>

    <!-- Mentors grid -->
    <div class="r grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {mentors.map(m => (
        <div class="flex items-start gap-4 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5">
          <img
            src={m.photo}
            alt={m.name}
            loading="lazy"
            class="h-14 w-14 shrink-0 rounded-full object-cover"
          />
          <div>
            <div class="font-bold text-[var(--corp-txt)]">{m.name}</div>
            <div class="mb-2 text-xs font-semibold text-[var(--corp-or)]">{m.role}</div>
            <p class="text-xs leading-relaxed text-[var(--corp-txt2)]">{m.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
