---
const BASE = 'https://aidacamp.ru/images/team/sm/';
const members = [
  { name:'Дарья Афанасьева', role:'Основатель', photo: BASE+'team-daria-main-01.avif', bio:'Предприниматель в сфере детского IT-образования и мама подростка. Строит лагерь таким, каким сама хотела бы видеть обучение своего ребёнка.' },
  { name:'Никита Брагин', role:'Scratch · Minecraft · Python', photo: BASE+'team-nikita-main-01.avif', bio:'Автор учебника по разработке игр. Специализируется на геймдеве, помогает детям создавать собственные игровые миры.' },
  { name:'Александр Ташкин', role:'Scratch · Minecraft · Python', photo: BASE+'team-alex-main-01.avif', bio:'Соавтор учебника по разработке игр. Умеет зажигать интерес через практику и командные проекты.' },
  { name:'Омар Алхамви', role:'Python · AI · Нейросети', photo: BASE+'team-omar-main-01.avif', bio:'Работает со старшими и продвинутыми группами. Применение AI в реальных проектах, часть занятий — на английском.' },
  { name:'Дарья Воронцова', role:'Scratch · JavaScript · Веб', photo: BASE+'team-daria-vorontsova-main-01.avif', bio:'Специализируется на веб-разработке и творческих проектах. Умеет объяснить сложные концепции через практику и игровые механики.' },
];
---

<section class="alt">
  <div class="wrap">
    <div class="s-kicker r">Команда</div>
    <h2 class="r">Менторы и <em>педагоги</em></h2>
    <p class="s-lead r">Действующие разработчики — не просто учителя. Авторы собственной книги по Python для детей.</p>

    <div style="display:flex;flex-direction:column;gap:var(--gap-lg);margin-top:var(--gap-xs);" class="r">
      <!-- Book card -->
      <div style="display:flex;gap:var(--gap-lg);align-items:center;background:var(--bg3);border:1px solid var(--bdr);border-radius:var(--r-lg);padding:var(--gap-lg) 28px;flex-wrap:wrap;">
        <a href="https://www.ozon.ru/product/python-dlya-detey-igraem-chtoby-programmirovat-afanasev-vladimir-vladimirovich-3487599843/" target="_blank" rel="noopener" style="flex-shrink:0;transition:transform 0.2s;display:block;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
          <img src="https://aidacamp.ru/images/team/team-book-main-01.webp" alt="Книга Python для детей" style="width:120px;border-radius:var(--r-sm);box-shadow:0 8px 24px rgba(0,0,0,0.4);" loading="lazy"/>
        </a>
        <div style="flex:1;min-width:200px;">
          <div style="font-size:var(--fs-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--or2);margin-bottom:var(--gap-xs);">Авторская книга</div>
          <div style="font-size:var(--fs-lg);font-weight:700;color:var(--txt);margin-bottom:var(--gap-xs);">Python для детей. Играем, чтобы программировать</div>
          <div style="font-size:var(--fs-base);color:var(--txt2);line-height:1.6;margin-bottom:var(--gap-sm);">Владимир Афанасьев, Никита Брагин · Тираж 2 000 экз. · Для детей, которые хотят начать Python и сделать первую игру.</div>
          <a href="https://www.ozon.ru/product/python-dlya-detey-igraem-chtoby-programmirovat-afanasev-vladimir-vladimirovich-3487599843/" target="_blank" rel="noopener" class="btn-sm btn-sm-primary" style="width:auto;flex-shrink:0;">Купить на Ozon</a>
        </div>
      </div>

      <!-- Team grid -->
      <div class="team-members-grid">
        {members.map(m => (
          <div class="team-card">
            <div style="width:80px;height:80px;flex-shrink:0;overflow:hidden;background:var(--bg4);">
              <img src={m.photo} alt={m.name} loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top;"/>
            </div>
            <div class="team-info">
              <div class="team-name">{m.name}</div>
              <div class="team-role">{m.role}</div>
              <div class="team-bio">{m.bio}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
