---
const BASE_TEAM = 'https://aidacamp.ru/images/team/sm/';

const mentors = [
  {
    name: 'Дарья Афанасьева',
    role: 'Основатель',
    photo: BASE_TEAM + 'team-daria-main-01.avif',
    bio: 'Предприниматель в сфере детского IT-образования и мама подростка. Строит лагерь таким, каким сама хотела бы видеть обучение своего ребёнка.',
  },
  {
    name: 'Никита Брагин',
    role: 'Scratch · Minecraft · Python',
    photo: BASE_TEAM + 'team-nikita-main-01.avif',
    bio: 'Автор учебника по разработке игр. Специализируется на геймдеве, помогает детям создавать собственные игровые миры.',
  },
  {
    name: 'Александр Ташкин',
    role: 'Scratch · Minecraft · Python',
    photo: BASE_TEAM + 'team-alex-main-01.avif',
    bio: 'Соавтор учебника по разработке игр. Умеет зажигать интерес через практику и командные проекты.',
  },
  {
    name: 'Омар Алхамви',
    role: 'Python · AI · Нейросети',
    photo: BASE_TEAM + 'team-omar-main-01.avif',
    bio: 'Работает со старшими и продвинутыми группами. Применение AI в реальных проектах, часть занятий — на английском.',
  },
  {
    name: 'Дарья Воронцова',
    role: 'Scratch · JavaScript · Веб',
    photo: BASE_TEAM + 'team-daria-vorontsova-main-01.avif',
    bio: 'Специализируется на веб-разработке и творческих проектах. Умеет объяснить сложные концепции через практику и игровые механики.',
  },
];
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Команда</div>
    <h2 class="corp-h2 r mb-2">Менторы и <em class="not-italic text-[var(--corp-or2)]">педагоги</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">Действующие разработчики — не просто учителя. Авторы собственной книги по Python для детей.</p>

    <!-- Book card -->
    <div class="r mb-8 flex flex-wrap items-center gap-6 rounded-2xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-6 md:p-8">
      <a
        href="https://www.ozon.ru/product/python-dlya-detey-igraem-chtoby-programmirovat-afanasev-vladimir-vladimirovich-3487599843/"
        target="_blank"
        rel="noopener"
        class="shrink-0 transition-transform duration-200 hover:scale-105"
      >
        <img
          src="https://aidacamp.ru/images/team/team-book-main-01.webp"
          alt="Книга Python для детей — играем, чтобы программировать"
          class="h-28 w-auto rounded-lg object-contain shadow-lg"
          loading="lazy"
          width="200"
          height="280"
        />
      </a>
      <div class="flex-1 min-w-[200px]">
        <div class="mb-1 text-xs font-bold uppercase tracking-widest text-[var(--corp-or2)]">Авторская книга</div>
        <div class="mb-2 text-xl font-bold text-[var(--corp-txt)]">Python для детей. Играем, чтобы программировать</div>
        <p class="mb-4 text-sm leading-relaxed text-[var(--corp-txt2)]">
          Владимир Афанасьев, Никита Брагин · Тираж 2 000 экз. · Для детей, которые хотят начать Python и сделать первую игру.
        </p>
        <a
          href="https://www.ozon.ru/product/python-dlya-detey-igraem-chtoby-programmirovat-afanasev-vladimir-vladimirovich-3487599843/"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--corp-or)] px-4 py-2 text-sm font-bold text-white transition-opacity hover:opacity-90"
        >
          Купить на Ozon
          <i class="bi bi-box-arrow-up-right text-xs" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <!-- Mentors grid -->
    <div class="r grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {mentors.map(m => (
        <div class="flex items-start gap-4 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5">
          <img
            src={m.photo}
            alt={m.name}
            loading="lazy"
            width="56"
            height="56"
            class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-[var(--corp-bdr)]"
          />
          <div>
            <div class="font-bold text-[var(--corp-txt)]">{m.name}</div>
            <div class="mb-2 text-xs font-semibold text-[var(--corp-or)]">{m.role}</div>
            <p class="text-xs leading-relaxed text-[var(--corp-txt2)]">{m.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
