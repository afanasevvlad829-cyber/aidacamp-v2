---
import type { CorpClient } from '../../data/corp/types';
import { SHIFT_META, taxDeduction, EDU_RESID_PER_DAY, EDU_BASE_CAP, fmtRub } from '../../data/shifts';
interface Props { client: CorpClient }
const { client } = Astro.props;

const basePrice       = SHIFT_META['shift-3'].basePrice;
const days            = SHIFT_META['shift-3'].days;
const discountedPrice = Math.round(basePrice * (1 - client.discount / 100));
const eduPart         = discountedPrice - EDU_RESID_PER_DAY * days;
const taxReturn       = taxDeduction(discountedPrice, days); // единая формула вместо локальной

const steps = [
  { n: '1', title: 'Оплатить лагерь',          text: 'Оплачиваете смену. Мы выдаём договор, акт и чек — все документы для налоговой.' },
  { n: '2', title: 'Подать декларацию 3-НДФЛ', text: 'Через личный кабинет на сайте ФНС или через Госуслуги. Занимает 15–20 минут.' },
  { n: '3', title: 'Получить возврат',          text: 'ФНС возвращает 13% от суммы расходов на карту. Срок — до 3 месяцев.' },
];
const rows = [
  { label: 'Базовая цена',                                       val: `${basePrice.toLocaleString('ru')} ₽`,           green: false },
  { label: `Скидка ${client.clientName} (−${client.discount}%)`, val: `${discountedPrice.toLocaleString('ru')} ₽`,    green: false },
  { label: `Жильё + питание (${EDU_RESID_PER_DAY.toLocaleString('ru')} ₽ × ${days} дней)`, val: `${(EDU_RESID_PER_DAY*days).toLocaleString('ru')} ₽`, green: false },
  { label: 'Образовательная часть',                              val: `${eduPart.toLocaleString('ru')} ₽`,            green: false },
  { label: 'Возврат 13%',                                        val: `~${taxReturn.toLocaleString('ru')} ₽ назад`,    green: true  },
];
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Налоговый вычет</div>
    <h2 class="corp-h2 r mb-10">Верните до <em class="not-italic text-[var(--corp-or2)]">{fmtRub(Math.floor(taxReturn / 50) * 50)}</em><br/>через налоговый вычет</h2>

    <div class="r grid gap-12 lg:grid-cols-[1.2fr_1fr] items-start">
      <!-- Шаги -->
      <div>
        <p class="mb-8 text-lg leading-relaxed text-[var(--corp-txt2)]">
          Расходы на образование детей подпадают под социальный налоговый вычет 13%. Лагерь с&nbsp;<a href="https://aidacamp.ru/docs/licenziya-rosobrnadzor.pdf" target="_blank" rel="noopener" class="text-[var(--corp-or2)] hover:underline">лицензией Минобразования</a>&nbsp;— это полноценные образовательные услуги.
        </p>
        <ol class="flex flex-col gap-6">
          {steps.map(s => (
            <li class="flex items-start gap-5">
              <div class="w-10 flex-shrink-0 font-bold leading-none text-[var(--corp-or2)]" style="font-family:'Unbounded',sans-serif;font-size:2rem;">{s.n}</div>
              <div>
                <div class="mb-1 font-bold text-[var(--corp-txt)]">{s.title}</div>
                <div class="text-sm leading-relaxed text-[var(--corp-txt2)]">{s.text}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Таблица расчёта -->
      <div class="rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-8">
        <div class="mb-5 font-mono text-xs font-bold uppercase tracking-widest text-[var(--corp-txt2)]">
          Пример расчёта · Смена 3 · {client.clientName}
        </div>
        <div class="divide-y divide-[var(--corp-bdr)]">
          {rows.map(row => (
            <div class="flex items-baseline justify-between gap-4 py-4">
              <span class="text-sm text-[var(--corp-txt2)]">{row.label}</span>
              <span
                class="font-bold"
                style={`font-family:'Unbounded',sans-serif;font-size:15px;color:${row.green ? 'var(--corp-green)' : 'var(--corp-txt)'}`}
              >{row.val}</span>
            </div>
          ))}
        </div>
        <p class="mt-5 text-xs leading-relaxed text-[var(--corp-txt2)]">
          Формула: (цена − {EDU_RESID_PER_DAY.toLocaleString('ru')} ₽ × дней) × 13%. Лимит НК РФ — {fmtRub(EDU_BASE_CAP)}/год на ребёнка. Декларация 3-НДФЛ — в следующем году.
        </p>
      </div>
    </div>
  </div>
</section>
