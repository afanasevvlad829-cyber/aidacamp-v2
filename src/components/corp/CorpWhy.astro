---
import { whyCards } from '../../data/corp/shared';
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Почему АйДаКемп</div>
    <h2 class="corp-h2 r mb-10">Не просто лагерь — <em class="not-italic text-[var(--corp-or2)]">результат</em></h2>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {whyCards.map((c) => (
        <div class="r group rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-7 transition-all duration-200 hover:-translate-y-1 hover:border-[rgba(255,90,31,0.25)]">
          <div class="mb-5 h-1 w-9 rounded-full bg-[var(--corp-or)]"></div>
          <h3 class="mb-3 text-lg font-bold leading-snug text-[var(--corp-txt)]">{c.title}</h3>
          <p class="text-base leading-relaxed text-[var(--corp-txt2)]">{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
