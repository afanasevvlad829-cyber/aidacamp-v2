---
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">Не только код</div>
    <h2 class="corp-h2 r mb-4">Спорт, бассейн и <em class="not-italic text-[var(--corp-or2)]">внутренняя экономика</em></h2>
    <p class="r mb-10 text-lg text-[var(--corp-txt2)]">
      Санаторий «Изумруд», 66 км от Москвы. Программа дня сбалансирована: кодинг + активности.
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        {
          svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25C8.344 7.688 6.75 11.063 6.75 13.5a5.25 5.25 0 0010.5 0c0-2.438-1.594-5.813-5.25-11.25z"/>',
          title: 'Крытый бассейн',
          text: 'Заплывы через день. Тёплая вода, инструктор, купание вне зависимости от погоды.',
        },
        {
          svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M6.75 8.25V21m3.75-18v5.25a3 3 0 01-3 3m10.5-8.25V21m0-10.5a3 3 0 013-3h.375"/>',
          title: '5-разовое питание',
          text: 'Завтрак, обед, полдник, ужин и поздний перекус. Без полуфабрикатов.',
        },
        {
          svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>',
          title: 'Медсестра 24/7',
          text: 'Медицинский работник в лагере круглосуточно.',
        },
        {
          svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>',
          title: 'Спорт и активности',
          text: 'Футбол, волейбол. Программа вечерних активностей — не только экраны.',
        },
      ].map(f => (
        <div class="r flex gap-4 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[rgba(255,90,31,0.12)]">
            <svg class="h-5 w-5 text-[var(--corp-or)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <Fragment set:html={f.svg} />
            </svg>
          </div>
          <div>
            <div class="mb-1 font-bold text-[var(--corp-txt)]">{f.title}</div>
            <p class="text-sm leading-relaxed text-[var(--corp-txt2)]">{f.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Photo grid -->
    <div class="r mt-8 grid grid-cols-3 gap-3 md:grid-cols-5">
      {[
        { src: 'https://aidacamp.ru/images/gallery/pool-1.avif', jpg: 'https://aidacamp.ru/images/gallery/jpg/pool-1.jpg', alt: 'Крытый бассейн АйДаКемп' },
        { src: 'https://aidacamp.ru/images/gallery/pool-2.avif', jpg: 'https://aidacamp.ru/images/gallery/jpg/pool-2.jpg', alt: 'Бассейн — вид внутри' },
        { src: 'https://aidacamp.ru/images/gallery/pool-3.avif', jpg: 'https://aidacamp.ru/images/gallery/jpg/pool-3.jpg', alt: 'Дорожки бассейна' },
        { src: 'https://aidacamp.ru/images/gallery/infra-1.avif', jpg: 'https://aidacamp.ru/images/gallery/jpg/infra-1.jpg', alt: 'Территория санатория' },
        { src: 'https://aidacamp.ru/images/gallery/infra-2.avif', jpg: 'https://aidacamp.ru/images/gallery/jpg/infra-2.jpg', alt: 'Спортивная площадка' },
      ].map(p => (
        <div class="aspect-square overflow-hidden rounded-xl">
          <picture>
            <source srcset={p.src} type="image/avif" />
            <img src={p.jpg} alt={p.alt} class="h-full w-full object-cover transition duration-300 hover:scale-105" loading="lazy" />
          </picture>
        </div>
      ))}
    </div>
  </div>
</section>
