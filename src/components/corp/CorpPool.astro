---
---

<section class="alt">
  <div class="wrap">
    <div class="s-kicker r">Отдых и инфраструктура</div>
    <div class="pool-grid r">
      <div>
        <h2>Не только код —<br/><em>бассейн, спорт и лес</em></h2>
        <p style="font-size:var(--fs-md);color:var(--txt2);line-height:1.75;margin-bottom:var(--gap-xl);">Санаторий «Изумруд» в 66 км от Москвы. Для IT-лагеря важно, чтобы ребёнок отдохнул по-настоящему — а не просто переехал из домашнего компьютера в лагерный.</p>
        <div class="pool-features">
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25C8.344 7.688 6.75 11.063 6.75 13.5a5.25 5.25 0 0010.5 0c0-2.438-1.594-5.813-5.25-11.25z"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">Крытый бассейн</div>
              <div class="pool-feature-text">Заплывы через день. Тёплая вода, инструктор, купание вне зависимости от погоды.</div>
            </div>
          </div>
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M6.75 8.25V21m3.75-18v5.25a3 3 0 01-3 3m10.5-8.25V21m0-10.5a3 3 0 013-3h.375"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">5-разовое питание</div>
              <div class="pool-feature-text">Завтрак, обед, полдник, ужин и поздний перекус. Сбалансированное меню без полуфабрикатов.</div>
            </div>
          </div>
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">Спорт и активности</div>
              <div class="pool-feature-text">Футбол, бадминтон, настольный теннис, лес рядом. Программа вечерних активностей — не только экраны.</div>
            </div>
          </div>
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">Медсестра 24/7 + страховка</div>
              <div class="pool-feature-text">Медицинский персонал в санатории круглосуточно. Справка о прибытии и выбытии.</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pool-img-grid">
        <button type="button" class="pool-img-btn" data-lb-src="https://aidacamp.ru/images/gallery/pool-interior.avif" data-lb-alt="Крытый бассейн АйДаКемп">
          <img src="https://aidacamp.ru/images/gallery/pool-interior.avif" alt="Крытый бассейн" loading="lazy"/>
        </button>
        <button type="button" class="pool-img-btn" data-lb-src="https://aidacamp.ru/images/gallery/pool-kids-edge.avif" data-lb-alt="Дети в бассейне">
          <img src="https://aidacamp.ru/images/gallery/pool-kids-edge.avif" alt="Дети у бортика" loading="lazy"/>
        </button>
        <button type="button" class="pool-img-btn" data-lb-src="https://aidacamp.ru/images/gallery/pool-noodles.avif" data-lb-alt="Дети с нудлами в бассейне">
          <img src="https://aidacamp.ru/images/gallery/pool-noodles.avif" alt="Игры в бассейне" loading="lazy"/>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div class="lightbox-overlay" id="pool-lightbox">
  <button class="lightbox-close" id="pool-lb-close" aria-label="Закрыть">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button class="lightbox-nav lightbox-prev" id="pool-lb-prev" aria-label="Назад">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <img class="lightbox-img" id="pool-lb-img" src="" alt="">
  <button class="lightbox-nav lightbox-next" id="pool-lb-next" aria-label="Вперёд">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="lightbox-caption" id="pool-lb-cap"></div>
</div>

<style>
.lightbox-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  backdrop-filter: blur(6px);
}
.lightbox-overlay.open { opacity: 1; pointer-events: all; }
.lightbox-img { max-width: 90vw; max-height: 85vh; border-radius: 8px; object-fit: contain; }
.lightbox-close { position: absolute; top: 20px; right: 20px; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; transition: background 0.2s; }
.lightbox-close:hover { background: rgba(255,255,255,0.2); }
.lightbox-caption { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: rgba(255,255,255,0.7); font-size: 14px; }
.lightbox-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; transition: background 0.2s; }
.lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.lightbox-prev { left: 20px; }
.lightbox-next { right: 20px; }
</style>

<script>
(function() {
  const overlay = document.getElementById('pool-lightbox');
  const lbImg = document.getElementById('pool-lb-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('pool-lb-cap');
  const lbClose = document.getElementById('pool-lb-close');
  const lbPrev = document.getElementById('pool-lb-prev');
  const lbNext = document.getElementById('pool-lb-next');

  const btns = Array.from(document.querySelectorAll('.pool-img-btn[data-lb-src]')) as HTMLElement[];
  let current = 0;

  function open(idx: number) {
    current = idx;
    const btn = btns[idx];
    if (!btn || !lbImg || !lbCap || !overlay) return;
    lbImg.src = btn.dataset.lbSrc || '';
    lbImg.alt = btn.dataset.lbAlt || '';
    if (lbCap) lbCap.textContent = btn.dataset.lbAlt || '';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  btns.forEach((btn, i) => {
    btn.addEventListener('click', () => open(i));
  });

  lbClose?.addEventListener('click', close);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  lbPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    open((current - 1 + btns.length) % btns.length);
  });
  lbNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    open((current + 1) % btns.length);
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') lbPrev?.click();
    if (e.key === 'ArrowRight') lbNext?.click();
  });
})();
</script>
