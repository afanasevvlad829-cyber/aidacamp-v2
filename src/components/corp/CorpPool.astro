---
const features = [
  {
    icon: 'droplet',
    title: 'Крытый бассейн',
    text: 'Заплывы через день. Тёплая вода, инструктор, купание вне зависимости от погоды.',
  },
  {
    icon: 'cup-hot',
    title: '5-разовое питание',
    text: 'Завтрак, обед, полдник, ужин и поздний перекус. Сбалансированное меню без полуфабрикатов.',
  },
  {
    icon: 'trophy',
    title: 'Спорт и активности',
    text: 'Футбол, бадминтон, лес рядом. Программа вечерних активностей — не только экраны.',
  },
  {
    icon: 'heart-pulse-fill',
    title: 'Медсестра 24/7',
    text: 'Медицинский персонал в санатории круглосуточно. Справка о прибытии и выбытии.',
  },
];
const photos = [
  { src: 'https://aidacamp.ru/images/gallery/pool-interior.avif',  alt: 'Крытый бассейн АйДаКемп', thumb: 'Крытый бассейн' },
  { src: 'https://aidacamp.ru/images/gallery/pool-kids-edge.avif', alt: 'Дети в бассейне',          thumb: 'Дети у бортика' },
  { src: 'https://aidacamp.ru/images/gallery/pool-noodles.avif',   alt: 'Дети с нудлами в бассейне', thumb: 'Игры в бассейне' },
];
---

<section class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Отдых и инфраструктура</div>
    <div class="r grid gap-16 lg:grid-cols-2 items-center">
      <!-- Текст + фичи -->
      <div>
        <h2 class="corp-h2 mb-4">Не только код —<br/><em class="not-italic text-[var(--corp-or2)]">бассейн, спорт и лес</em></h2>
        <p class="mb-8 text-[var(--corp-txt2)] leading-relaxed">Санаторий «Изумруд» в 66 км от Москвы. Для IT-лагеря важно, чтобы ребёнок отдохнул по-настоящему — а не просто переехал из домашнего компьютера в лагерный.</p>
        <div class="flex flex-col gap-5">
          {features.map(f => (
            <div class="flex gap-4 items-start">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg bg-[rgba(255,90,31,0.1)] border border-[rgba(255,90,31,0.2)] text-[var(--corp-or2)]">
                <i class={`bi bi-${f.icon} text-lg`} aria-hidden="true"></i>
              </div>
              <div>
                <div class="mb-0.5 font-bold text-[var(--corp-txt)]">{f.title}</div>
                <div class="text-sm leading-relaxed text-[var(--corp-txt2)]">{f.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <!-- Фото-сетка -->
      <div class="grid grid-cols-2 gap-3">
        {photos.map((p, i) => (
          <button
            type="button"
            class:list={['pool-img-btn block overflow-hidden rounded-xl cursor-pointer', i === 0 && 'col-span-2']}
            data-lb-src={p.src}
            data-lb-alt={p.alt}
          >
            <img
              src={p.src}
              alt={p.thumb}
              loading="lazy"
              width={i === 0 ? 800 : 400}
              height={i === 0 ? 192 : 144}
              class:list={['w-full object-cover transition-transform duration-300 hover:scale-[1.04]', i === 0 ? 'h-48' : 'h-36']}
            />
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox-overlay" id="pool-lightbox">
  <button class="lightbox-close" id="pool-lb-close" aria-label="Закрыть">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button class="lightbox-nav lightbox-prev" id="pool-lb-prev" aria-label="Назад">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <img class="lightbox-img" id="pool-lb-img" src="" alt="">
  <button class="lightbox-nav lightbox-next" id="pool-lb-next" aria-label="Вперёд">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="lightbox-caption" id="pool-lb-cap"></div>
</div>

<style is:global>
.lightbox-overlay { position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.92); display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity 0.2s; backdrop-filter:blur(6px); }
.lightbox-overlay.open { opacity:1; pointer-events:all; }
.lightbox-img { max-width:90vw; max-height:85vh; border-radius:8px; object-fit:contain; }
.lightbox-close { position:absolute; top:20px; right:20px; width:44px; height:44px; border-radius:50%; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); cursor:pointer; display:flex; align-items:center; justify-content:center; color:white; transition:background 0.2s; }
.lightbox-close:hover { background:rgba(255,255,255,0.2); }
.lightbox-caption { position:absolute; bottom:20px; left:0; right:0; text-align:center; color:rgba(255,255,255,0.7); font-size:14px; }
.lightbox-nav { position:absolute; top:50%; transform:translateY(-50%); width:48px; height:48px; border-radius:50%; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); cursor:pointer; display:flex; align-items:center; justify-content:center; color:white; transition:background 0.2s; }
.lightbox-nav:hover { background:rgba(255,255,255,0.2); }
.lightbox-prev { left:20px; }
.lightbox-next { right:20px; }
</style>

<script>
(function() {
  const overlay = document.getElementById('pool-lightbox');
  const lbImg   = document.getElementById('pool-lb-img') as HTMLImageElement | null;
  const lbCap   = document.getElementById('pool-lb-cap');
  const lbClose = document.getElementById('pool-lb-close');
  const lbPrev  = document.getElementById('pool-lb-prev');
  const lbNext  = document.getElementById('pool-lb-next');
  const btns    = Array.from(document.querySelectorAll('.pool-img-btn[data-lb-src]')) as HTMLElement[];
  let current   = 0;

  function open(idx: number) {
    current = idx;
    const btn = btns[idx];
    if (!btn || !lbImg || !lbCap || !overlay) return;
    lbImg.src = btn.dataset.lbSrc || '';
    lbImg.alt = btn.dataset.lbAlt || '';
    lbCap.textContent = btn.dataset.lbAlt || '';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    if (!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  btns.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
  lbClose?.addEventListener('click', close);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); open((current - 1 + btns.length) % btns.length); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); open((current + 1) % btns.length); });
  document.addEventListener('keydown', (e) => {
    if (!overlay?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') lbPrev?.click();
    if (e.key === 'ArrowRight') lbNext?.click();
  });
})();
</script>
