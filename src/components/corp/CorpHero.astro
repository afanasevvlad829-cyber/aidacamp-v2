---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<section class="hero" style="border:none;">
  <div class="hero-content">
    <!-- Left: text -->
    <div>
      <div class="hero-kicker">
        <div class="hero-kicker-line"></div>
        Специальные условия для сотрудников {client.clientName}
      </div>
      <h1>IT-лагерь для детей<br/><em>айтишников</em></h1>
      <p class="hero-desc">Ваш ребёнок видит, что вы делаете? Пора показать ему настоящий стек. Python, AI-агенты, Minecraft, Scratch — и реальный проект на выходе. Летняя инженерная школа в 66 км от Москвы. 7–15 лет.</p>
      <div class="hero-pills">
        <span class="pill">7–15 лет</span>
        <a class="pill pill-link" href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener">★ 5.0 · Яндекс.Карты</a>
        <a class="pill pill-link" href="#gallery" id="pill-pool">Крытый бассейн</a>
        <a class="pill pill-link" href="#directions">66 км от Москвы</a>
        <a class="pill pill-link" href="#tracks">8+ треков</a>
        <a class="pill pill-link" href="#gallery" id="pill-food">5-разовое питание</a>
        <a class="pill pill-link" href="https://aidacamp.ru/docs/licenziya-rosobrnadzor.pdf" target="_blank" rel="noopener">Лицензия Минобра № Л035-01298-77/01082973</a>
      </div>
      <div class="hero-btns">
        <a href={`tel:${client.phone.replace(/\D/g, '')}`} class="btn-primary">
          <svg class="ico" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {client.phone}
        </a>
        <a href="https://t.me/Progaschool" class="btn-ghost" target="_blank" rel="noopener">
          <svg class="ico" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          Telegram
        </a>
      </div>
    </div>

    <!-- Right: terminal -->
    <div class="terminal">
      <div class="term-bar">
        <div class="tdot td-r"></div>
        <div class="tdot td-y"></div>
        <div class="tdot td-g"></div>
        <div class="term-tabs" id="term-tabs">
          <button class="term-tab active" data-mode="python" type="button">Python</button>
          <button class="term-tab" data-mode="csharp" type="button">C#</button>
          <button class="term-tab" data-mode="bash" type="button">Bash</button>
          <button class="term-tab" data-mode="game" type="button">▶ Snake</button>
        </div>
      </div>

      <div class="term-body" id="code-out"></div>

      <!-- Snake game -->
      <div id="snake-wrap">
        <div id="sw-bar">
          <span id="sov-score">0 commits</span>
          <span id="sov-food">npm install ...</span>
          <span id="sov-level">Junior Dev</span>
        </div>
        <canvas id="sov-canvas"></canvas>
        <div id="sov-msg">нажми <b>пробел</b> или коснись экрана</div>
      </div>

      <!-- Python BSOD -->
      <div id="term-bsod">
        <div class="bsod-face">:(</div>
        <div class="bsod-title">Вы всё сломали.</div>
        <div class="bsod-subtitle">Аккуратнее с production-серверами.<br/>Все данные сотрудников {client.clientName} под угрозой.</div>
        <div class="bsod-code">CRITICAL_LANIT_EXCEPTION &nbsp; 0x0000LANIT &nbsp; Stop: 0xDEADC0DE</div>
        <div class="bsod-pct" id="bsod-pct">0% завершено</div>
        <div class="bsod-bar-wrap"><div class="bsod-bar" id="bsod-bar"></div></div>
        <div class="bsod-btns">
          <button class="bsod-btn" id="bsod-reboot" type="button">[ Перезагрузить ]</button>
          <button class="bsod-btn" id="bsod-cad" type="button">[ Ctrl + Alt + Del ]</button>
        </div>
        <div class="bsod-hint" id="bsod-hint"></div>
      </div>

      <!-- C# crash -->
      <div id="term-cscrash">
        <div class="cs-line cs-white">Unhandled exception. System.StackOverflowException:</div>
        <div class="cs-line">&nbsp;&nbsp; at LanitPartner.Enroll(Child child)</div>
        <div class="cs-line">&nbsp;&nbsp; at LanitPartner.Enroll(Child child)</div>
        <div class="cs-line">&nbsp;&nbsp; at LanitPartner.Enroll(Child child)</div>
        <div class="cs-line">&nbsp;&nbsp; at LanitPartner.Enroll(Child child)</div>
        <div class="cs-line">&nbsp;&nbsp; at LanitPartner.Enroll(Child child)</div>
        <div class="cs-line cs-gray">&nbsp;&nbsp; ... 65521 more frames ...</div>
        <div class="cs-line" style="margin-top:10px;color:#ff8888">Process terminated. Stack overflow.</div>
        <div class="cs-line cs-gray" style="margin-top:var(--gap-xs)">[1]&nbsp;&nbsp; 31337 segmentation fault &nbsp; dotnet run</div>
        <div class="cs-btn-row">
          <button class="cs-btn" id="cs-restart" type="button">[ dotnet run ]</button>
          <button class="cs-btn" id="cs-gc" type="button">[ GC.Collect() ]</button>
        </div>
        <div class="cs-line cs-gray" id="cs-hint" style="margin-top:var(--gap-xs)"></div>
      </div>

      <!-- Kernel panic -->
      <div id="term-kpanic">
        <div><span class="kp-yellow">[&nbsp; 42.001234]</span> BUG: kernel NULL pointer dereference at 0x0000LANIT</div>
        <div><span class="kp-yellow">[&nbsp; 42.001456]</span> IP: lanit_enroll+0x0/0x42 [lanit_partner]</div>
        <div><span class="kp-yellow">[&nbsp; 42.001678]</span> PGD 0 P4D 0</div>
        <div><span class="kp-yellow">[&nbsp; 42.001890]</span> Oops: 0002 [#1] SMP NOPTI</div>
        <div style="margin:4px 0"><span class="kp-yellow">[&nbsp; 42.002100]</span> CPU: 0 PID: 31337 Comm: enroll.sh Tainted: G</div>
        <div><span class="kp-yellow">[&nbsp; 42.002312]</span> RIP: 0010:lanit_partner_init+0x0/0x42</div>
        <div><span class="kp-yellow">[&nbsp; 42.003100]</span> Call Trace:</div>
        <div><span class="kp-yellow">[&nbsp; 42.003200]</span> &nbsp; enroll_child+0x42/0x80</div>
        <div><span class="kp-yellow">[&nbsp; 42.003300]</span> &nbsp; do_group_booking+0x1a/0x30</div>
        <div style="margin-top:var(--gap-xs)"><span class="kp-red">Kernel panic</span> - not syncing: Fatal exception</div>
        <div><span class="kp-red">---[ end Kernel panic ]---</span></div>
        <div style="margin-top:var(--gap-sm)">Press any key to reboot...</div>
        <button class="kp-btn" id="kp-reboot" type="button">[ reboot -f ]</button>
      </div>

      <div class="term-footer">
        <span class="term-tag" id="term-tag-label">LANIT PARTNER</span>
        <span class="term-ok" id="term-ok-label">скидка применена</span>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  // ── Terminal ─────────────────────────────────────────────────────────
  const codeOut = document.getElementById('code-out') as HTMLElement | null;
  const snakeWrap = document.getElementById('snake-wrap') as HTMLElement | null;
  const bsod = document.getElementById('term-bsod') as HTMLElement | null;
  const cscrash = document.getElementById('term-cscrash') as HTMLElement | null;
  const kpanic = document.getElementById('term-kpanic') as HTMLElement | null;

  const MODES: Record<string, string[]> = {
    python: [
      '<span style="color:var(--code-comment)">$ </span><span style="color:var(--code-text)">ssh partner@aidacamp.ru</span>',
      '<span style="color:var(--code-comment)">Connecting to aidacamp.ru...</span>',
      '<span style="color:var(--green)">✓ Connection established</span>',
      '<span style="color:var(--code-comment)">Authenticating LANIT credentials...</span>',
      '<span style="color:var(--green)">✓ Partner access granted · discount_tier=LANIT</span>',
      '<span style="color:var(--code-comment)">$ </span><span style="color:var(--code-text)">python aidacamp_lanit_2026.py</span>',
      '&nbsp;',
      '<span class="cf">class</span> <span class="cs">LanitPartner</span><span class="cw">:</span>',
      '&nbsp; <span class="cs">MAX_DISCOUNT</span> <span class="cw">=</span> <span class="cn">0.12</span> <span class="cc"># макс. скидка ЛАНИТ</span>',
      '&nbsp; <span class="cs">transfer</span> <span class="cw">=</span> <span class="cf">True</span> <span class="cc"># 10+ детей</span>',
      '&nbsp; <span class="cs">meals</span> <span class="cw">=</span> <span class="cn">5</span> <span class="cc"># раз в сутки</span>',
      '&nbsp; <span class="cf">def</span> <span class="ck">enroll</span><span class="cw">(</span><span class="cs">self</span><span class="cw">,</span> <span class="cn">child</span><span class="cw">):</span>',
      '&nbsp;&nbsp;&nbsp; <span class="cf">return</span> <span style="color:var(--green)">"Смена забронирована!"</span><span class="cursor"></span>',
    ],
    csharp: [
      '<span style="color:var(--code-comment)">// АйДаКемп.LANIT 2026</span>',
      '<span class="cf">using</span> <span class="cs">AidaCamp.LANIT</span><span class="cw">;</span>',
      '&nbsp;',
      '<span class="cf">var</span> <span class="cs">partner</span> <span class="cw">=</span> <span class="cf">new</span> <span class="cs">LanitPartner</span><span class="cw">()</span>',
      '<span class="cw">{</span>',
      '&nbsp; <span class="cs">Discount</span> <span class="cw">=</span> <span class="cn">0.10m</span><span class="cw">,</span>',
      '&nbsp; <span class="cs">FreeTransfer</span> <span class="cw">=</span> <span class="cf">true</span><span class="cw">,</span>',
      '&nbsp; <span class="cs">MealsPerDay</span> <span class="cw">=</span> <span class="cn">5</span>',
      '<span class="cw">};</span>',
      '&nbsp;',
      '<span class="cf">await</span> <span class="cs">partner</span><span class="cw">.</span><span class="ck">EnrollAsync</span><span class="cw">(</span><span class="cs">child</span><span class="cw">);</span><span class="cursor"></span>',
    ],
    bash: [
      '<span style="color:var(--code-comment)">$ </span><span style="color:var(--code-text)">cat /etc/lanit/discount.conf</span>',
      '<span class="cs">PARTNER_ID</span><span class="cw">=</span><span style="color:var(--green)">"LANIT"</span>',
      '<span class="cs">DISCOUNT_PCT</span><span class="cw">=</span><span class="cn">10</span>',
      '<span class="cs">FREE_TRANSFER</span><span class="cw">=</span><span class="cf">true</span>',
      '<span class="cs">MIN_KIDS_TRANSFER</span><span class="cw">=</span><span class="cn">10</span>',
      '&nbsp;',
      '<span style="color:var(--code-comment)">$ </span><span style="color:var(--code-text)">./enroll.sh --partner=lanit --kids=7</span>',
      '<span style="color:var(--green)">✓ Скидка 10% применена</span>',
      '<span style="color:var(--green)">✓ Смена 1 (30 мая): 67 410 ₽/ребёнок</span>',
      '<span style="color:var(--green)">✓ Договор сформирован</span><span class="cursor"></span>',
    ],
  };

  let currentMode = 'python';
  let bsodTriggered = false;
  let csTriggered = false;
  let kpTriggered = false;

  function hideAll() {
    if (bsod) bsod.classList.remove('show');
    if (cscrash) cscrash.classList.remove('show');
    if (kpanic) kpanic.classList.remove('show');
    if (snakeWrap) snakeWrap.classList.remove('active');
    if (codeOut) codeOut.style.display = 'block';
  }

  function showCode(mode: string) {
    hideAll();
    if (!codeOut) return;
    const lines = MODES[mode] || MODES.python;
    codeOut.innerHTML = lines.map(l => `<div>${l}</div>`).join('');
  }

  // Tab click
  document.querySelectorAll('.term-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn as HTMLElement).dataset.mode || 'python';
      document.querySelectorAll('.term-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = mode;
      bsodTriggered = false; csTriggered = false; kpTriggered = false;

      if (mode === 'game') {
        hideAll();
        if (codeOut) codeOut.style.display = 'none';
        if (snakeWrap) snakeWrap.classList.add('active');
        initSnake();
      } else {
        showCode(mode);
        // trigger easter egg after delay
        if (mode === 'python') {
          setTimeout(() => triggerBSOD(), 4500);
        } else if (mode === 'csharp') {
          setTimeout(() => triggerCS(), 4000);
        } else if (mode === 'bash') {
          setTimeout(() => triggerKP(), 4000);
        }
      }
    });
  });

  // Init
  showCode('python');
  setTimeout(() => triggerBSOD(), 5000);

  // ── BSOD ──────────────────────────────────────────────────────────
  function triggerBSOD() {
    if (currentMode !== 'python' || bsodTriggered) return;
    bsodTriggered = true;
    if (!bsod) return;
    bsod.classList.add('show');
    let pct = 0;
    const bar = document.getElementById('bsod-bar') as HTMLElement | null;
    const pctEl = document.getElementById('bsod-pct') as HTMLElement | null;
    const hint = document.getElementById('bsod-hint') as HTMLElement | null;
    if (bar) setTimeout(() => { bar.style.width = '100%'; }, 50);
    const timer = setInterval(() => {
      pct = Math.min(pct + Math.random() * 3 | 0, 100);
      if (pctEl) pctEl.textContent = pct + '% завершено';
      if (pct >= 100) {
        clearInterval(timer);
        if (hint) hint.textContent = 'Системная ошибка не отменяет скидку ЛАНИТ :)';
      }
    }, 120);
  }

  const bsodReboot = document.getElementById('bsod-reboot');
  const bsodCad = document.getElementById('bsod-cad');
  if (bsodReboot) bsodReboot.addEventListener('click', () => { bsodTriggered = false; showCode('python'); setTimeout(() => triggerBSOD(), 3500); });
  if (bsodCad) bsodCad.addEventListener('click', () => { bsodTriggered = false; showCode('python'); setTimeout(() => triggerBSOD(), 3500); });

  // ── C# crash ──────────────────────────────────────────────────────
  function triggerCS() {
    if (currentMode !== 'csharp' || csTriggered) return;
    csTriggered = true;
    if (cscrash) cscrash.classList.add('show');
  }

  const csRestart = document.getElementById('cs-restart');
  const csGc = document.getElementById('cs-gc');
  const csHint = document.getElementById('cs-hint') as HTMLElement | null;
  if (csRestart) csRestart.addEventListener('click', () => { csTriggered = false; showCode('csharp'); setTimeout(() => triggerCS(), 3000); });
  if (csGc) {
    csGc.addEventListener('click', () => {
      if (csHint) csHint.textContent = 'GC.Collect() выполнен. Стек всё ещё переполнен.';
    });
  }

  // ── Kernel panic ──────────────────────────────────────────────────
  function triggerKP() {
    if (currentMode !== 'bash' || kpTriggered) return;
    kpTriggered = true;
    if (kpanic) kpanic.classList.add('show');
  }

  const kpReboot = document.getElementById('kp-reboot');
  if (kpReboot) kpReboot.addEventListener('click', () => { kpTriggered = false; showCode('bash'); setTimeout(() => triggerKP(), 3500); });

  // ── Snake game ─────────────────────────────────────────────────────
  let snakeGame: any = null;

  function initSnake() {
    const canvas = document.getElementById('sov-canvas') as HTMLCanvasElement | null;
    const msg = document.getElementById('sov-msg') as HTMLElement | null;
    const scoreEl = document.getElementById('sov-score') as HTMLElement | null;
    const foodEl = document.getElementById('sov-food') as HTMLElement | null;
    const levelEl = document.getElementById('sov-level') as HTMLElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const gameCanvas = canvas;
    const gameContext = ctx;

    const SZ = 16;
    let W: number, H: number, cols: number, rows: number;
    let snake: {x:number,y:number}[];
    let dir: {x:number,y:number};
    let food: {x:number,y:number};
    let score = 0;
    let running = false;
    let raf: number;
    let lastTime = 0;
    const SPEED = 150;

    const FOODS = ['npm install', 'git commit', 'kubectl apply', 'terraform plan', 'docker build'];
    const LEVELS = ['Junior Dev','Middle Dev','Senior Dev','Tech Lead','CTO'];

    function resize() {
      const wrap = gameCanvas.parentElement;
      if (!wrap) return;
      W = wrap.clientWidth; H = wrap.clientHeight;
      gameCanvas.width = W; gameCanvas.height = H;
      cols = Math.floor(W / SZ); rows = Math.floor(H / SZ);
    }

    function placeFood() {
      food = { x: Math.random() * cols | 0, y: Math.random() * rows | 0 };
      if (foodEl) foodEl.textContent = FOODS[Math.random() * FOODS.length | 0] + ' ...';
    }

    function startGame() {
      resize();
      snake = [{x: cols >> 1, y: rows >> 1}];
      dir = {x: 1, y: 0};
      score = 0;
      placeFood();
      running = true;
      if (msg) msg.style.display = 'none';
      if (raf) cancelAnimationFrame(raf);
      loop(0);
    }

    function loop(t: number) {
      if (!running) return;
      raf = requestAnimationFrame(loop);
      if (t - lastTime < SPEED) return;
      lastTime = t;
      update();
      render(gameContext, W, H);
    }

    function update() {
      const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};
      if (head.x < 0) head.x = cols - 1;
      if (head.x >= cols) head.x = 0;
      if (head.y < 0) head.y = rows - 1;
      if (head.y >= rows) head.y = 0;
      if (snake.some(s => s.x === head.x && s.y === head.y)) {
        running = false;
        if (msg) { msg.style.display = 'block'; msg.innerHTML = `Игра окончена · ${score} commits · <b>пробел</b> для рестарта`; }
        return;
      }
      snake.unshift(head);
      if (head.x === food.x && head.y === food.y) {
        score++;
        if (scoreEl) scoreEl.textContent = score + ' commits';
        if (levelEl) levelEl.textContent = LEVELS[Math.min(score >> 2, LEVELS.length - 1)];
        placeFood();
      } else {
        snake.pop();
      }
    }

    function render(ctx: CanvasRenderingContext2D, W: number, H: number) {
      ctx.fillStyle = '#0F1419';
      ctx.fillRect(0, 0, W, H);
      // food
      ctx.fillStyle = '#FF7A3D';
      ctx.fillRect(food.x * SZ + 2, food.y * SZ + 2, SZ - 4, SZ - 4);
      // snake
      snake.forEach((s, i) => {
        ctx.fillStyle = i === 0 ? '#FF5A1F' : `rgba(255,90,31,${0.7 - i * 0.03})`;
        ctx.fillRect(s.x * SZ + 1, s.y * SZ + 1, SZ - 2, SZ - 2);
      });
    }

    // Controls
    window.addEventListener('keydown', (e) => {
      if (!snakeWrap?.classList.contains('active')) return;
      if (e.code === 'Space') { e.preventDefault(); if (!running) startGame(); return; }
      if (e.key === 'ArrowUp' && dir.y === 0) dir = {x:0, y:-1};
      if (e.key === 'ArrowDown' && dir.y === 0) dir = {x:0, y:1};
      if (e.key === 'ArrowLeft' && dir.x === 0) dir = {x:-1, y:0};
      if (e.key === 'ArrowRight' && dir.x === 0) dir = {x:1, y:0};
    });

    // Touch
    let touchStart: {x:number, y:number} | null = null;
    canvas.addEventListener('touchstart', (e) => {
      touchStart = {x: e.touches[0].clientX, y: e.touches[0].clientY};
      if (!running) startGame();
    });
    canvas.addEventListener('touchend', (e) => {
      if (!touchStart) return;
      const dx = e.changedTouches[0].clientX - touchStart.x;
      const dy = e.changedTouches[0].clientY - touchStart.y;
      if (Math.abs(dx) > Math.abs(dy)) {
        if (dx > 20 && dir.x === 0) dir = {x:1, y:0};
        if (dx < -20 && dir.x === 0) dir = {x:-1, y:0};
      } else {
        if (dy > 20 && dir.y === 0) dir = {x:0, y:1};
        if (dy < -20 && dir.y === 0) dir = {x:0, y:-1};
      }
      touchStart = null;
    });

    resize();
    window.addEventListener('resize', resize);
    render(ctx, canvas.width, canvas.height);
  }

  // ── Gallery pill links ──────────────────────────────────────────────
  const pillPool = document.getElementById('pill-pool');
  const pillFood = document.getElementById('pill-food');
  if (pillPool) {
    pillPool.addEventListener('click', (e) => {
      e.preventDefault();
      (window as any).switchGalCat?.('pool');
      setTimeout(() => document.getElementById('gallery')?.scrollIntoView({behavior:'smooth'}), 50);
    });
  }
  if (pillFood) {
    pillFood.addEventListener('click', (e) => {
      e.preventDefault();
      (window as any).switchGalCat?.('food');
      setTimeout(() => document.getElementById('gallery')?.scrollIntoView({behavior:'smooth'}), 50);
    });
  }
})();
</script>
