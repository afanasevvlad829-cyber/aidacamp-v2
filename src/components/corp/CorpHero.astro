---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--corp-bg)] py-20 md:py-28">
  <!-- Glow background -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 h-[600px] w-[800px] -translate-x-1/2 rounded-full bg-[var(--corp-or)] opacity-[0.04] blur-[120px]"></div>
  </div>

  <div class="corp-wrap">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">

      <!-- Left: text -->
      <div>
        <div class="corp-kicker">Корпоративная программа</div>

        <h1 class="corp-h1 mb-6">
          IT-лагерь<br/>
          для детей<br/>
          <em class="not-italic text-[var(--corp-or2)]">сотрудников<br/>{client.clientName}</em>
        </h1>

        <p class="mb-8 text-lg leading-relaxed text-[var(--corp-txt2)] md:text-xl">
          Программирование, AI и спорт — 66 км от Москвы.
          Ноутбук не нужен. С 7 до 16 лет.
        </p>

        <!-- Pills -->
        <div class="mb-8 flex flex-wrap gap-2">
          {client.discount > 0 && (
            <span class="rounded-full bg-[var(--corp-or)] px-4 py-1.5 text-sm font-bold text-white">
              Скидка {client.discount}% сотрудникам
            </span>
          )}
          <span class="rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-sm font-medium text-[var(--corp-txt2)]">8 треков</span>
          <span class="rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-sm font-medium text-[var(--corp-txt2)]">7–16 лет</span>
          <span class="rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-sm font-medium text-[var(--corp-txt2)]">Крытый бассейн</span>
          <span class="rounded-full border border-[var(--corp-bdr2)] px-4 py-1.5 text-sm font-medium text-[var(--corp-txt2)]">5-разовое питание</span>
        </div>

        <!-- CTA -->
        <div class="flex flex-wrap gap-3">
          <a
            href={`https://aidacamp.ru/?utm_source=${client.utmSource}&utm_medium=corp`}
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--corp-or)] px-6 py-3.5 text-base font-bold text-white transition-opacity hover:opacity-90"
          >
            <i class="bi bi-arrow-right-circle-fill text-lg" aria-hidden="true"></i>
            Записать
          </a>
          <a
            href={`tel:${client.phone.replace(/\D/g, '')}`}
            class="inline-flex items-center gap-2 rounded-xl border border-[var(--corp-bdr2)] px-6 py-3.5 text-base font-semibold text-[var(--corp-txt)] transition-colors hover:border-[var(--corp-or2)] hover:text-[var(--corp-or2)]"
          >
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>
            {client.phone}
          </a>
        </div>
      </div>

      <!-- Right: terminal widget -->
      <div class="r hidden md:block">
        <div class="overflow-hidden rounded-2xl border border-[var(--corp-bdr2)] bg-[#1A1E26] shadow-2xl">
          <!-- Window chrome -->
          <div class="flex items-center gap-2 border-b border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.03)] px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
            <span class="ml-2 font-mono text-xs text-[rgba(255,255,255,0.4)]">aidacamp ~ python camp.py</span>
          </div>
          <!-- Terminal body -->
          <div class="space-y-1 p-5 font-mono text-sm leading-relaxed">
            <p class="text-[#6EE7B7]">$ python camp.py --track ai --age 12</p>
            <p class="text-[rgba(255,255,255,0.5)]"># Определяем трек...</p>
            <p class="text-[var(--corp-txt)]">Трек: <span class="text-[var(--corp-or2)] font-bold">AI & машинное обучение</span></p>
            <p class="text-[var(--corp-txt)]">Уровень: <span class="text-[#6EE7B7]">Продвинутый ✓</span></p>
            <p class="text-[rgba(255,255,255,0.5)]"># Загружаем план...</p>
            <p class="text-[var(--corp-txt)]">День 1: нейросети, что это такое</p>
            <p class="text-[var(--corp-txt)]">День 5: обучаем модель на реальных данных</p>
            <p class="text-[var(--corp-txt)]">День 8: деплоим бота в Telegram</p>
            <p class="text-[rgba(255,255,255,0.5)]"># Хакатон: защита проекта</p>
            <p class="text-[#6EE7B7]">✓ Готово. <span class="text-[var(--corp-or2)]">Старт — 30 мая.</span></p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
