---
import { tracks } from '../../data/corp/shared';
---

<section class="corp-section">
  <div class="corp-wrap">
    <div class="corp-kicker r">8 треков — от Scratch до AI</div>
    <h2 class="corp-h2 r mb-4">Каждый ребёнок найдёт <em class="not-italic text-[var(--corp-or2)]">свой трек</em></h2>
    <p class="r mb-10 text-lg text-[var(--corp-txt2)] md:text-xl">
      Педагог в первый день оценивает уровень и адаптирует задачи. Новичок не потеряется, продвинутый не заскучает.
    </p>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {tracks.map((t) => (
        <div class="r group rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5 transition-all duration-200 hover:-translate-y-1 hover:border-[rgba(255,90,31,0.3)]">
          <div class="mb-3 flex items-center justify-between">
            <span class="rounded-md bg-[var(--corp-or)] px-2 py-0.5 font-mono text-xs font-bold text-white">{t.lang}</span>
            <span class="text-xs font-semibold text-[var(--corp-txt2)]">{t.age} лет</span>
          </div>
          <div class="mb-2 text-base font-bold leading-snug text-[var(--corp-txt)]">{t.title}</div>
          <p class="text-sm leading-relaxed text-[var(--corp-txt2)]">{t.desc}</p>
          <div class="mt-4 flex items-center justify-between text-xs text-[var(--corp-txt2)]">
            <span class="rounded-full border border-[var(--corp-bdr2)] px-2 py-0.5">{t.level}</span>
            <span>{t.hours}+ часов</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
