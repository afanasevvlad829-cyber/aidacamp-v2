---
---

<section id="tracks" class="corp-section corp-section-alt">
  <div class="corp-wrap">
    <div class="corp-kicker r">Программа обучения</div>
    <h2 class="corp-h2 r mb-4">8 треков для детей <em class="not-italic text-[var(--corp-or2)]">7–15 лет</em></h2>
    <p class="r mb-10 text-lg text-[var(--corp-txt2)]">2 занятия по 90 минут каждый день. Подбор в первый день по уровню и интересам ребёнка.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { age: '7–9 лет',   name: 'Scratch + ИИ / GPT',    result: 'Интерактивные истории, анимации. ИИ генерирует фоны и идеи. Итог — собственная игра' },
        { age: '7–9 лет',   name: 'Minecraft + код',        result: 'Логика, команды, автоматизация. Итог — мини-игра или автоматизированный мир' },
        { age: '7–12 лет',  name: 'Дрон Scratch / Python',  result: 'Полётные маршруты, автосценарии, съёмка. Итог — сценарий полёта с видео' },
        { age: '10–12 лет', name: 'Python + Pygame',         result: 'Переменные, условия, циклы через игру. Итог — полноценная игра с уровнями и очками' },
        { age: '10–12 лет', name: 'JavaScript',              result: 'Современный сайт с интерактивностью. ИИ помогает развивать проект дальше' },
        { age: '10–12 лет', name: 'Python Advanced',          result: 'Реальное веб-приложение + ИИ-агент для разработки и тестирования' },
        { age: '13–15 лет', name: 'Python (старшие)',         result: 'Кодинг, отладка, реальный проект уровня junior с применением ИИ-агентов' },
        { age: '13–15 лет', name: 'Java / ООП',              result: 'Основы ООП и алгоритмов, паттерны проектирования. Проект с реальной архитектурой' },
      ].map(track => (
        <div class="r flex flex-col rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5 hover:border-[rgba(255,90,31,0.25)] transition-colors">
          <div class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--corp-or)]">{track.age}</div>
          <div class="mb-3 font-bold text-[var(--corp-txt)]">{track.name}</div>
          <div class="h-px bg-[var(--corp-bdr)] mb-3"></div>
          <div class="text-sm leading-relaxed text-[var(--corp-txt2)]">{track.result}</div>
        </div>
      ))}
    </div>
  </div>
</section>
