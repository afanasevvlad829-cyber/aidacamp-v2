---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<section id="directions">
  <div class="wrap">
    <div class="s-kicker r">Как добраться</div>
    <h2 class="r">66 км от Москвы — <em>легко доехать</em></h2>
    <p class="s-lead r">Наро-Фоминский городской округ, территория «Санаторий Изумруд».{client.transferFrom && ` При группе от ${client.freeTransferMinKids} детей — бесплатный трансфер ${client.transferFrom} до лагеря и обратно.`}</p>
    <div style="border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--bdr);" class="r">
      <iframe
        src="https://yandex.ru/map-widget/v1/?ll=37.160000%2C55.500000&z=8&pt=36.724185,55.265643,pm2rdm"
        width="100%"
        height="400"
        frameborder="0"
        allowfullscreen
        style="display:block;"
        title="Карта лагеря"
      ></iframe>
    </div>
    <div style="margin-top:var(--gap-lg);display:flex;gap:var(--gap-md);flex-wrap:wrap;" class="r">
      <div style="flex:1;min-width:200px;padding:var(--gap-lg);background:var(--bg3);border:1px solid var(--bdr);border-radius:var(--r-md);">
        <div style="font-size:var(--fs-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--or2);margin-bottom:var(--gap-xs);">На машине</div>
        <div style="font-size:var(--fs-md);font-weight:600;color:var(--txt);">~1 час от МКАД</div>
        <div style="font-size:var(--fs-sm);color:var(--txt2);margin-top:4px;">Киевское шоссе → Наро-Фоминск → Атепцево</div>
      </div>
      <div style="flex:1;min-width:200px;padding:var(--gap-lg);background:var(--bg3);border:1px solid var(--bdr);border-radius:var(--r-md);">
        <div style="font-size:var(--fs-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--or2);margin-bottom:var(--gap-xs);">На электричке</div>
        <div style="font-size:var(--fs-md);font-weight:600;color:var(--txt);">Киевский вокзал → Нара</div>
        <div style="font-size:var(--fs-sm);color:var(--txt2);margin-top:4px;">~55 минут, далее такси ~15 мин</div>
      </div>
      {client.transferFrom && (
        <div style="flex:1;min-width:200px;padding:var(--gap-lg);background:rgba(255,90,31,0.07);border:1px solid rgba(255,90,31,0.25);border-radius:var(--r-md);">
          <div style="font-size:var(--fs-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--or2);margin-bottom:var(--gap-xs);">Трансфер для {client.clientName}</div>
          <div style="font-size:var(--fs-md);font-weight:600;color:var(--txt);">Бесплатно от {client.freeTransferMinKids}+ детей</div>
          <div style="font-size:var(--fs-sm);color:var(--txt2);margin-top:4px;">Автобус {client.transferFrom} и обратно</div>
        </div>
      )}
    </div>
  </div>
</section>
