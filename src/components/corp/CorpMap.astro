---
import type { CorpClient } from '../../data/corp/types';
interface Props { client: CorpClient }
const { client } = Astro.props;
---

<section class="corp-section" id="directions">
  <div class="corp-wrap">
    <div class="corp-kicker r">Как добраться</div>
    <h2 class="corp-h2 r mb-4">66 км от Москвы — <em class="not-italic text-[var(--corp-or2)]">легко доехать</em></h2>
    <p class="r mb-8 text-lg text-[var(--corp-txt2)]">
      Наро-Фоминский городской округ, территория «Санаторий Изумруд».
      {client.transferFrom && (
        <> При группе от {client.freeTransferMinKids} участников — <strong class="text-[var(--corp-txt)]">бесплатный трансфер {client.transferFrom}</strong>.</>
      )}
    </p>

    <div class="r grid gap-6 md:grid-cols-3">
      {[
        { icon: 'bi-car-front-fill',     title: 'На машине',   text: 'Киевское шоссе, 66 км от МКАД. ~50 мин без пробок.' },
        { icon: 'bi-train-front-fill',   title: 'На электричке', text: 'Курское направление → Нара. Далее такси 10 мин.' },
        { icon: 'bi-bus-front-fill',     title: 'Трансфер',    text: `Организованный трансфер${client.transferFrom ? ` ${client.transferFrom}` : ''}. Уточните при записи.` },
      ].map(t => (
        <div class="flex items-start gap-4 rounded-xl border border-[var(--corp-bdr)] bg-[var(--corp-bg3)] p-5">
          <i class={`bi ${t.icon} mt-0.5 shrink-0 text-2xl text-[var(--corp-or)]`} aria-hidden="true"></i>
          <div>
            <div class="mb-1 font-bold text-[var(--corp-txt)]">{t.title}</div>
            <p class="text-sm leading-relaxed text-[var(--corp-txt2)]">{t.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="r mt-6 overflow-hidden rounded-2xl border border-[var(--corp-bdr)]">
      <iframe
        src="https://yandex.ru/map-widget/v1/?ll=37.160000%2C55.500000&z=8&pt=36.724185,55.265643,pm2rdm"
        width="100%"
        height="360"
        frameborder="0"
        loading="lazy"
        title="Расположение АйДаКемп на карте"
        style="display:block;"
      ></iframe>
    </div>
  </div>
</section>
