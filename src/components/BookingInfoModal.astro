---
/**
 * BookingInfoModal — общая модалка для разъяснения чипов под LeadForm
 * (Без оплаты / Договор / Трансфер). Открывается при клике на чип,
 * контент выбирается по data-info-key.
 *
 * Используется:
 *   - LeadForm.astro — 3 чипа под формой на мобильной версии
 *
 * Trigger-атрибут:
 *   <button data-booking-info-key="no-prepay|contract|transfer" ...>
 *
 * Аналитика:
 *   На каждое открытие — ym('reachGoal', 'booking_info_open', { key, variant }),
 *   где variant — booking_desktop / booking_mobile (из ближайшего data-form).
 */
---

<dialog
  id="bookingInfoModal"
  class="fixed inset-0 m-auto w-[min(92vw,440px)] rounded-[18px] border-0 outline-none bg-white p-0 shadow-[0_20px_60px_rgba(15,23,42,0.25)] backdrop:bg-black/40"
>
  <div class="p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h3 id="bookingInfoModalTitle" class="text-[18px] font-semibold text-body leading-[1.3]"></h3>
      <button
        type="button"
        data-booking-info-close
        class="shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-body-faint hover:bg-surface-alt hover:text-body-muted transition focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-1"
        aria-label="Закрыть"
      >
        <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
      </button>
    </div>
    <div id="bookingInfoModalBody" class="text-[14px] text-body-muted leading-[1.6]"></div>
    <div id="bookingInfoModalCtas" class="mt-5 flex flex-col gap-2"></div>
  </div>
</dialog>

<script>
  type CtaAction = 'close-scroll-to-form' | 'link';
  interface CtaDef {
    text: string;
    action: CtaAction;
    url?: string;
    external?: boolean;
    variant?: 'primary' | 'secondary';
  }
  interface InfoContent {
    title: string;
    body: string;
    ctas: CtaDef[];
  }

  // Контент — утверждён владельцем 2026-04-20
  const BOOKING_INFO: Record<string, InfoContent> = {
    'no-prepay': {
      title: 'Бронь без предоплаты',
      body: `
        <p>Звонок менеджера — и мы фиксируем место <strong>на 72 часа</strong>.</p>
        <p>За это время вы получаете договор с ценой и условиями. Решаете без спешки.</p>
        <div class="rounded-[12px] bg-slate-50 px-4 py-3 mt-3">
          <p class="text-[13px] font-semibold uppercase tracking-wide text-slate-500">Оплата в 2 этапа</p>
          <ul class="mt-1.5 text-[14px] text-slate-700 space-y-1">
            <li>— 50% при бронировании</li>
            <li>— 50% за 3 недели до старта смены</li>
          </ul>
        </div>
      `,
      ctas: [
        { text: 'Узнать о свободных местах', variant: 'primary', action: 'close-scroll-to-form' },
      ],
    },
    'contract': {
      title: 'Договор и налоговый вычет',
      body: `
        <p>Договор на <strong>образовательные услуги</strong> по <strong>лицензии Минобрнауки</strong>.</p>
        <p>Это даёт право на налоговый вычет <strong>13% от стоимости путёвки</strong>.</p>
        <p>Все документы для вычета (договор, чек, копия лицензии) высылаем автоматически после оплаты.</p>
      `,
      ctas: [
        { text: 'Калькулятор вычета 13%', variant: 'primary', action: 'link', url: '/nalogovyj-vychet/' },
      ],
    },
    'transfer': {
      title: 'Трансфер из Москвы',
      body: `
        <p>Организованный автобус от <strong>компаний-партнёров</strong>.</p>
        <p><strong>2 000 ₽ в одну сторону</strong> (туда+обратно = 5 000 ₽).</p>
        <div class="rounded-[12px] bg-emerald-50/70 border border-emerald-100 px-4 py-3 mt-3">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-slate-900">
            <i class="bi bi-geo-alt-fill text-emerald-700" aria-hidden="true"></i>
            Сбор: Производственная 4А
          </p>
          <p class="mt-1.5 text-[13px] text-slate-600 leading-[1.5]">
            Удобно приехать на машине или метро — автобус свободно размещается, парковки хватает.
          </p>
        </div>
        <p class="mt-3 text-[13px] text-slate-500 leading-[1.5]">
          <strong>Почему эта точка:</strong> автобус идёт в обход МКАД, без пробок. Дорога до лагеря — 40–60 минут.
        </p>
      `,
      ctas: [
        { text: 'Открыть на Яндекс.Картах', variant: 'secondary', action: 'link', url: 'https://yandex.ru/maps?whatshere%5Bzoom%5D=17&whatshere%5Bpoint%5D=37.388087,55.647305&si=t9er14d10me0wuccmt794ph9jg', external: true },
      ],
    },
  };

  function ctaClasses(variant: 'primary' | 'secondary') {
    if (variant === 'secondary') {
      return 'inline-flex items-center justify-center gap-2 rounded-[10px] border border-slate-200 bg-white px-4 py-2.5 text-[14px] font-semibold text-slate-800 hover:bg-slate-50 transition';
    }
    return 'inline-flex items-center justify-center gap-2 rounded-[10px] bg-primary px-4 py-2.5 text-[14px] font-semibold text-[#0d1a2b] transition-all duration-200 hover:shadow-[0_4px_16px_rgba(249,115,22,0.35)] hover:-translate-y-[1px] active:translate-y-0';
  }

  function initBookingInfoModal() {
    const modal = document.getElementById('bookingInfoModal') as HTMLDialogElement | null;
    if (!modal) return;

    const titleEl = modal.querySelector('#bookingInfoModalTitle');
    const bodyEl = modal.querySelector('#bookingInfoModalBody');
    const ctasEl = modal.querySelector('#bookingInfoModalCtas');
    if (!titleEl || !bodyEl || !ctasEl) return;

    function open(key: string, sourceVariant: string) {
      const content = BOOKING_INFO[key];
      if (!content) return;
      titleEl!.textContent = content.title;
      bodyEl!.innerHTML = content.body;
      ctasEl!.innerHTML = '';
      content.ctas.forEach((cta) => {
        if (cta.action === 'link' && cta.url) {
          const a = document.createElement('a');
          a.href = cta.url;
          a.className = ctaClasses(cta.variant ?? 'primary');
          a.textContent = cta.text;
          if (cta.external) {
            a.target = '_blank';
            a.rel = 'noopener';
          }
          ctasEl!.appendChild(a);
        } else {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = ctaClasses(cta.variant ?? 'primary');
          btn.textContent = cta.text;
          btn.addEventListener('click', () => {
            modal!.close();
            if (cta.action === 'close-scroll-to-form') {
              // Раскрываем форму (если свёрнута) и скроллим
              const block = document.getElementById('hero-booking-block');
              if (block) {
                block.style.maxHeight = block.scrollHeight + 'px';
                block.style.opacity = '1';
                block.style.pointerEvents = 'auto';
                block.style.paddingTop = '16px';
                block.style.paddingBottom = '24px';
              }
              const phone = document.querySelector<HTMLInputElement>('[data-form="booking_mobile"] [data-phone-input], [data-form="booking_desktop"] [data-phone-input]');
              phone?.focus({ preventScroll: true });
              phone?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
          ctasEl!.appendChild(btn);
        }
      });
      modal!.showModal();
      // Аналитика
      (window as any).acTrack?.('booking_info_open', { key, variant: sourceVariant });
    }

    // Триггеры — делегирование, чтобы ловить клики на кнопки из LeadForm
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const trigger = target?.closest('[data-booking-info-key]') as HTMLElement | null;
      if (!trigger) return;
      e.preventDefault();
      const key = trigger.getAttribute('data-booking-info-key') || '';
      const form = trigger.closest('[data-form]') as HTMLElement | null;
      const variant = form?.getAttribute('data-form') || 'unknown';
      open(key, variant);
    });

    // Закрытие
    modal.querySelector('[data-booking-info-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }

  document.addEventListener('astro:page-load', initBookingInfoModal);
  initBookingInfoModal();
</script>
