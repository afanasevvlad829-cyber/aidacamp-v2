---
import { mainShifts, shortShifts } from '../data/shifts';

function getColor(pct: number) {
  if (pct >= 90) return '#f5612e';
  if (pct >= 70) return '#f5a624';
  return 'rgb(148, 163, 184)';
}

function getIcon(pct: number) {
  if (pct >= 90) return 'bi-fire';
  if (pct >= 70) return 'bi-lightning-charge';
  return 'bi-calendar-check';
}

function freeLabel(free: number) {
  if (free === 1) return '1 место';
  if (free < 5) return `${free} места`;
  return `${free} мест`;
}
---

<!--
  px-3 md:px-0 — даёт мобилке «дыхание» от края экрана (12 px слева/справа).
  На desktop отключено, т.к. wrapper в index.astro + lg:grid-cols-2 уже
  задаёт нужные отступы.
-->
<div data-shift-occupancy class="px-3 md:px-0">
  <!-- STATE: idle -->
  <div data-state="idle">
    <div class="py-8 text-center">
      <button data-check-occupancy
              class="group inline-flex items-center gap-3 text-primary hover:text-primary-hover">
        <i class="bi bi-search text-[28px] md:text-[32px]" aria-hidden="true"></i>
        <span class="text-[24px] md:text-[28px] font-extrabold tracking-[-0.01em] border-b-2 border-primary/40 group-hover:border-primary pb-1 transition-colors">Проверить свободные места</span>
      </button>
      <p class="mt-3 text-[14px] text-body-faint">Данные обновляются в реальном времени</p>
    </div>
  </div>

  <!-- STATE: loading -->
  <div data-state="loading" class="hidden flex-col items-center justify-center py-8 gap-3">
    <i class="bi bi-arrow-repeat text-orange-500 text-[28px] animate-spin"></i>
    <p class="text-[14px] text-body-faint font-medium">Проверяем занятость смен...</p>
  </div>

  <!-- STATE: loaded -->
  <div data-state="loaded" class="hidden">
    <div class="space-y-3">
      {mainShifts.slice(0, 2).map((s) => {
        const total = s.occupied + s.free;
        const pct = Math.round((s.occupied / total) * 100);
        const free = s.free;
        const color = getColor(pct);
        const icon = getIcon(pct);
        return (
          <div class="occupancy-row cursor-pointer rounded-lg -mx-1 px-1 py-1 hover:bg-surface transition-colors" style="opacity: 0" data-occupancy-shift={s.id} role="button" tabindex="0">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-2">
                <span class="text-[14px] text-body-muted">{s.name}</span>
                <span class="text-[14px] text-body-faint">{s.dates} · {s.duration}</span>
              </div>
              <span class="shift-label text-[18px] font-bold tabular-nums" style={`color: ${color}; opacity: 0`}>
                <i class={`bi ${icon}`}></i> {freeLabel(free)}
              </span>
            </div>
            <div class="h-[8px] w-full rounded-full bg-surface overflow-hidden">
              <div
                class="shift-bar h-full rounded-full"
                style={`width: 0%; background-color: ${color}`}
                data-width={`${pct}%`}
              ></div>
            </div>
          </div>
        );
      })}

      <!-- July sold-out divider -->
      <div class="flex items-center gap-3 py-1">
        <div class="h-px flex-1 bg-red-100"></div>
        <span class="flex items-center gap-1.5 text-[13px] font-semibold uppercase tracking-[0.08em] text-red-400"><i class="bi bi-lock-fill"></i> Июль — 100% забронирован</span>
        <div class="h-px flex-1 bg-red-100"></div>
      </div>

      {mainShifts.slice(2).map((s) => {
        const total = s.occupied + s.free;
        const pct = Math.round((s.occupied / total) * 100);
        const free = s.free;
        const color = getColor(pct);
        const icon = getIcon(pct);
        return (
          <div class="occupancy-row cursor-pointer rounded-lg -mx-1 px-1 py-1 hover:bg-surface transition-colors" style="opacity: 0" data-occupancy-shift={s.id} role="button" tabindex="0">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-2">
                <span class="text-[14px] text-body-muted">{s.name}</span>
                <span class="text-[14px] text-body-faint">{s.dates} · {s.duration}</span>
              </div>
              <span class="shift-label text-[18px] font-bold tabular-nums" style={`color: ${color}; opacity: 0`}>
                <i class={`bi ${icon}`}></i> {freeLabel(free)}
              </span>
            </div>
            <div class="h-[8px] w-full rounded-full bg-surface overflow-hidden">
              <div
                class="shift-bar h-full rounded-full"
                style={`width: 0%; background-color: ${color}`}
                data-width={`${pct}%`}
              ></div>
            </div>
          </div>
        );
      })}

      <!-- Divider: short shifts -->
      <div class="flex items-center gap-3 pt-2 pb-1">
        <div class="h-px flex-1 bg-border"></div>
        <span class="text-[14px] font-medium uppercase tracking-[0.08em] text-body-muted">Короткие смены · 7–8 дней</span>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      {shortShifts.map((s) => {
        const total = s.occupied + s.free;
        const pct = Math.round((s.occupied / total) * 100);
        const free = s.free;
        const color = getColor(pct);
        const icon = getIcon(pct);
        return (
          <div class="occupancy-row cursor-pointer rounded-lg -mx-1 px-1 py-1 hover:bg-surface transition-colors" style="opacity: 0" data-occupancy-shift={s.id} role="button" tabindex="0">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-2">
                <span class="text-[14px] text-body-muted">{s.name}</span>
                <span class="text-[14px] text-body-faint">{s.dates} · {s.duration}</span>
              </div>
              <span class="shift-label text-[18px] font-bold tabular-nums" style={`color: ${color}; opacity: 0`}>
                <i class={`bi ${icon}`}></i> {freeLabel(free)}
              </span>
            </div>
            <div class="h-[8px] w-full rounded-full bg-surface overflow-hidden">
              <div
                class="shift-bar h-full rounded-full"
                style={`width: 0%; background-color: ${color}`}
                data-width={`${pct}%`}
              ></div>
            </div>
          </div>
        );
      })}

      <div class="pt-2 text-center">
        <a href="#shifts" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-orange-500 hover:text-orange-600 transition">
          <i class="bi bi-arrow-down-circle"></i>
          Смотреть цены &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { trackGoal } from '../scripts/analytics';
  function initOccupancy() {
    const root = document.querySelector('[data-shift-occupancy]');
    if (!root) return;

    const states = {
      idle: root.querySelector('[data-state="idle"]') as HTMLElement,
      loading: root.querySelector('[data-state="loading"]') as HTMLElement,
      loaded: root.querySelector('[data-state="loaded"]') as HTMLElement,
    };

    function showState(name: 'idle' | 'loading' | 'loaded') {
      Object.entries(states).forEach(([key, el]) => {
        if (!el) return;
        if (key === name) {
          el.classList.remove('hidden');
          if (name === 'loading') el.classList.add('flex');
        } else {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }
      });
    }

    function animateBars() {
      root.querySelectorAll<HTMLElement>('.occupancy-row').forEach((row, i) => {
        setTimeout(() => {
          row.style.opacity = '1';
          row.style.transition = 'opacity 0.4s ease';
          const bar = row.querySelector<HTMLElement>('.shift-bar');
          if (bar) {
            bar.style.transition = 'width 0.9s cubic-bezier(0.4,0,0.2,1)';
            bar.style.width = bar.dataset.width || '0%';
          }
          setTimeout(() => {
            const label = row.querySelector<HTMLElement>('.shift-label');
            if (label) {
              label.style.transition = 'opacity 0.3s ease';
              label.style.opacity = '1';
            }
          }, 700);
        }, i * 150);
      });
    }

    root.querySelector('[data-check-occupancy]')?.addEventListener('click', () => {
      trackGoal('check_places');

      showState('loading');
      setTimeout(() => {
        showState('loaded');
        animateBars();
      }, 900);
    });
  }

  document.addEventListener('astro:page-load', initOccupancy);
  initOccupancy();
</script>
