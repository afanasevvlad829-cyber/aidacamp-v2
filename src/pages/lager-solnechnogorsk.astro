---
import { DATES_SHORT_S3, DATES_SHORT_S4, DAYS_S3, DAYS_S4, PRICE_MIN, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX, VYCHET_MAX_DAYS, VYCHET_S3, VYCHET_S4, daysAdj } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';
import { PAYMENT_SPLIT, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Как добраться до АйДаКемп: дорога через ЦКАД",
    text: "Сразу по-честному: Солнечногорск — город на севере Подмосковья по Ленинградскому шоссе, а мы — на юго-западе, в санатории «Изумруд» в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе. Ехать придётся через ЦКАД (А107): примерно 90 км и около 1,5 часа. Не перепутайте: м. Солнцево, откуда идёт трансфер, — станция метро на юго-западе столицы.",
    list: [
      "На машине: через ЦКАД (А107) → Киевское шоссе, ~90 км, около 1,5 часа",
      `Трансфер АйДаКемп от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец, с сопровождающим, в день заезда и обратно в день отъезда`
    ]
  },
  {
    h2: "Налоговый вычет для родителей",
    text: "АйДаКемп — лицензированная образовательная организация. Семьи оформляют налоговый вычет через личный кабинет налоговой на nalog.ru.",
    list: [
      `Смена 4 — ${DAYS_S4} (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 — ${DAYS_S3} (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Чем заняты школьники на IT-смене",
    text: "Ребята 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, ведут практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: `Один преподаватель на 6–8 участников. Медработник дежурит круглосуточно, родители получают фото со смены в Telegram каждый день. Рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами таких же родителей.`,
    list: [
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале в 21:00"
    ]
  },
  {
    h2: "Отзывы семей с севера Подмосковья",
    text: `Отзывы за родителей мы не пишем — они есть в оригинале: ${otzyvyLink()} на сайте и карточка на ${yandexReviewsLink()}.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский IT-лагерь рядом с Солнечногорском : программирование, Python и AI, бассейн, трансфер из Москвы | АйДаКемп"
  description={`Детский IT-лагерь : из Солнечногорска ~1,5 часа через ЦКАД. Python и AI для ребят 7–15 лет, налоговый вычет, трансфер от м. Солнцево. Смены ${SEASON_YEAR}.`}
  h1="Детский лагерь рядом с Солнечногорском"
  canonical="https://aidacamp.ru/lager-solnechnogorsk"
  breadcrumb="Лагерь из Солнечногорска"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь рядом с Солнечногорском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1,5 часа от Солнечногорска через ЦКАД. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-solnechnogorsk"
      ageMin={7}
      ageMax={15}
    />

  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Солнечногорском"
    subtitle={`IT-программа в Наро-Фоминском районе — отсюда ~1,5 часа через ЦКАД. Удобный трансфер от м. Солнцево ${TRANSFER_PRICE_FMT} (не путать с самим городом).`}
    breadcrumb="Лагерь из Солнечногорска"
    keywords={["~1,5 часа отсюда через ЦКАД (А107)", "IT-программа: Python, AI, Minecraft для школьников 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь рядом с Солнечногорском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:9', 'payment:1', 'about2026:5', 'documents:5']} extraItems={[
    ...[
    { q: "Как добраться из Солнечногорска до лагеря АйДаКемп?", a: "У вас — север (Ленинградское шоссе), мы — юго-запад (Киевское шоссе). Ехать через ЦКАД (А107): около 90 км и ~1,5 часа. Или довезти ребёнка до м. Солнцево и отправить трансфером АйДаКемп. Мы — в 66 км от МКАД." },
    { q: "Солнечногорск и Солнцево — это одно и то же?", a: "Нет. Это город на севере Подмосковья по Ленинградскому шоссе. м. Солнцево — станция метро на юго-западе Москвы, рядом с нами, откуда идёт трансфер. Это разные места, не перепутайте при планировании дороги." },
    { q: "Есть ли трансфер из Солнечногорска?", a: `Прямого трансфера от вас нет. Есть трансфер АйДаКемп от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец, с сопровождающим. Так как дорога неблизкая, многим удобнее довезти ребёнка до метро и отправить автобусом.` },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%: документы через nalog.ru. Возврат от ~${VYCHET_S4} (${daysAdj(DAYS_S4, 'nom')} смена) до ${VYCHET_MAX} (${daysAdj(VYCHET_MAX_DAYS, 'nom')}).` },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — подросток выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ],
    ...[
    { q: "Сколько времени ехать из Солнечногорска в АйДаКемп?", a: `Около 1,5 часа на машине через ЦКАД (А107), примерно 90 км: у вас север, у нас — юго-запад, поэтому ехать в обход Москвы. Мы — в 66 км от МКАД. Удобная альтернатива — трансфер от м. Солнцево, ${TRANSFER_PRICE_FMT}.` },
    { q: "Входит ли в стоимость трансфер из Солнечногорска?", a: `Трансфер платный — ${TRANSFER_PRICE_FMT} в один конец, от м. Солнцево (юго-запад Москвы, не путать с вашим городом). От вас удобнее довезти ребёнка до метро и отправить автобусом, чем вести машину через всю область.` },
    { q: "Можно ли заехать в лагерь в середине смены из Солнечногорска?", a: "Да, на родительский день. Дорога неблизкая — около 1,5 часа через ЦКАД, но реальная, чтобы навестить ребят и привезти забытые вещи." },
    { q: "Какой налоговый вычет получит родитель из Солнечногорска?", a: `На ${daysAdj(DAYS_S4, 'acc')} смену (${PRICE_S4}) — возврат ~${VYCHET_S4}; на ${daysAdj(DAYS_S3, 'acc')} (${PRICE_S3}) — до ${VYCHET_MAX}. Оформляется через nalog.ru.` }
  ]
  ]} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-[14px] text-slate-500 mt-2">
      Смотрите также: <a href="/lager-zelenograd/" class="text-primary hover:underline">лагерь рядом с Зеленоградом</a> · <a href="/lager-klin/" class="text-primary hover:underline">лагерь рядом с Клином</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты {SEASON_YEAR}</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Сколько ехать от вас в АйДаКемп?</h2>
  <p><strong>Время:</strong> около 1,5 часа на машине через ЦКАД (А107), примерно 90 км — у вас север, у нас юго-запад.</p>
  <p><strong>Важно:</strong> ваш город (это север) — это не м. Солнцево (станция метро на юго-западе Москвы, откуда идёт трансфер).</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, {TRANSFER_PRICE_FMT} в один конец — удобнее, чем вести машину через всю область.</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
