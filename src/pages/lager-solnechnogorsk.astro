---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { PAYMENT_SPLIT, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Как добраться из Солнечногорска до лагеря АйДаКемп",
    text: "Сразу по-честному: Солнечногорск стоит на севере Подмосковья по Ленинградскому шоссе, а наш лагерь — на юго-западе, в санатории «Изумруд» Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. Направления противоположные, поэтому ехать придётся через ЦКАД (А107): примерно 90 км и около 1,5 часа. Это дальше, чем из ближних к нам городов, но дорога понятная и без заезда в центр Москвы. Важно не перепутать: Солнечногорск — это северный город, а м. Солнцево, откуда идёт трансфер, — станция метро на юго-западе столицы, совсем рядом с лагерем."
  },
  {
    h2: "Маршрут из Солнечногорска — ~1,5 часа через ЦКАД",
    text: "Из Солнечногорска удобнее всего ехать по ЦКАД (А107): она огибает Москву с запада и выводит к Киевскому шоссе. Дорога занимает примерно 1,5 часа, около 90 км. Альтернатива — заехать к точке трансфера на юго-западе столицы и дальше довериться автобусу лагеря.",
    list: [
      "На машине: Солнечногорск → ЦКАД (А107) → Киевское шоссе, ~90 км, около 1,5 часа",
      "Электричка: Ленинградское направление до Москвы, далее метро до м. Солнцево к трансферу",
      "Трансфер лагеря от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим"
    ]
  },
  {
    h2: "Трансфер от м. Солнцево — удобнее, чем своим ходом",
    text: "Поскольку из Солнечногорска дорога не близкая, многим семьям проще не вести машину через всю область, а воспользоваться трансфером лагеря. Он отправляется от м. Солнцево (юго-запад Москвы, не путать с самим Солнечногорском) в день заезда и обратно в день отъезда. Родитель довозит подростка до метро и освобождает себе день.",
    list: [
      "Трансфер 2 000 ₽ в один конец, от м. Солнцево в день заезда и обратно в день отъезда",
      "Сопровождающий едет с ребятами всю дорогу — родителю не нужно вести машину",
      "Альтернатива: привезти ребёнка сами через ЦКАД — около 1,5 часа"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Солнечногорска",
    text: "АйДаКемп — лицензированная образовательная организация. Семьи из Солнечногорска оформляют налоговый вычет так же, как все: через личный кабинет налоговой на nalog.ru.",
    list: [
      `Смена 4 — 10 дней (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 — 13 дней (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Чем заняты школьники в IT-лагере",
    text: "АйДаКемп — лагерь с настоящей технологической программой и проектом на финале. Ребята 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, ведут практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: `Один преподаватель на 6–8 участников — маленькие группы и личное внимание. Медработник дежурит круглосуточно. Родители из Солнечногорска получают фото из лагеря в Telegram-чат отряда каждый день, даже если сами далеко. Это официальный оздоровительный лагерь: бронирование через сайт фиксирует место, рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами таких же родителей.`,
    list: [
      "1 преподаватель на 6–8 ребят — никто не потеряется в потоке",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — спокойствие на расстоянии"
    ]
  },
  {
    h2: "Почему семьи из Солнечногорска выбирают АйДаКемп",
    text: "Да, лагерь не за углом — направление другое. Но многие родители с севера области едут к нам осознанно:",
    list: [
      "Дорога без авиаперелётов и акклиматизации — подросток в той же климатической зоне",
      "Трансфер от м. Солнцево снимает с родителя задачу вести машину через всю область",
      "Серьёзная IT-программа и проект в портфолио — а не просто «отдохнуть»",
      "Можно приехать на родительский день — около 1,5 часа через ЦКАД"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены раскупают первыми. Семьи из Солнечногорска обычно выбирают заранее: дорога не близкая, поэтому даты планируют спокойно. Июнь и август пока открыты. В стоимость входят проживание, питание, IT-программа, бассейн и активности.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      "Трансфер от м. Солнцево — 2 000 ₽ отдельно",
      PAYMENT_SPLIT
    ]
  },
  {
    h2: "Отзывы семей с севера Подмосковья",
    text: "В АйДаКемп приезжают ребята из Солнечногорска, Зеленограда, Лобни и других городов севера области:",
    list: [
      "«Ехать неблизко — другая сторона области, поэтому взяли трансфер от Солнцево. Довезла до метро и поехала по делам, ребёнка довезли с сопровождающим» — Юлия, Солнечногорск",
      "«Сначала путала Солнечногорск и Солнцево, потом разобралась: трансфер идёт от метро на юго-западе. Всё оказалось проще, чем казалось» — Ирина, Лобня",
      "«Сын вернулся со своим проектом на Python и неделю показывал его всем. Ради такого и полтора часа дороги не жалко» — Алексей, Зеленоград"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский IT-лагерь рядом с Солнечногорском 2026 | АйДаКемп"
  description={`Детский IT-лагерь: из Солнечногорска ~1,5 часа через ЦКАД. Python и AI для ребят 7–15 лет, вычет до ${VYCHET_MAX}, трансфер от м. Солнцево. Смены 2026.`}
  h1="Детский лагерь рядом с Солнечногорском"
  canonical="https://aidacamp.ru/lager-solnechnogorsk"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Солнечногорска до лагеря АйДаКемп?", a: "Солнечногорск на севере (Ленинградское шоссе), лагерь — на юго-западе (Киевское шоссе). Ехать через ЦКАД (А107): около 90 км и ~1,5 часа. Или довезти ребёнка до м. Солнцево и отправить трансфером лагеря. Сам лагерь — 66 км от МКАД." },
    { q: "Солнечногорск и Солнцево — это одно и то же?", a: "Нет. Солнечногорск — город на севере Подмосковья по Ленинградскому шоссе. м. Солнцево — станция метро на юго-западе Москвы, рядом с лагерём, откуда идёт трансфер. Это разные места, не перепутайте при планировании дороги." },
    { q: "Есть ли трансфер из Солнечногорска?", a: "Прямого трансфера из Солнечногорска нет. Есть трансфер лагеря от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим. Так как дорога из Солнечногорска неблизкая, многим удобнее довезти ребёнка до метро и отправить автобусом." },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%: документы через nalog.ru. Возврат от ~${VYCHET_S4} (10-дневная смена) до ${VYCHET_MAX} (13-дневная).` },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — подросток выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Солнечногорском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1,5 часа от Солнечногорска через ЦКАД. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-solnechnogorsk"
      ageMin={7}
      ageMax={15}
    />

    <FAQSchema items={[
    { q: "Сколько времени ехать из Солнечногорска в АйДаКемп?", a: "Около 1,5 часа на машине через ЦКАД (А107), примерно 90 км: Солнечногорск на севере, лагерь — на юго-западе, поэтому ехать в обход Москвы. Сам лагерь — 66 км от МКАД. Удобная альтернатива — трансфер от м. Солнцево, 2 000 ₽." },
    { q: "Входит ли в стоимость трансфер из Солнечногорска?", a: "Трансфер платный — 2 000 ₽ в один конец, от м. Солнцево (юго-запад Москвы, не путать с Солнечногорском). Из Солнечногорска удобнее довезти ребёнка до метро и отправить автобусом, чем вести машину через всю область." },
    { q: "Можно ли заехать в лагерь в середине смены из Солнечногорска?", a: "Да, на родительский день. Дорога из Солнечногорска неблизкая — около 1,5 часа через ЦКАД, но реальная, чтобы навестить ребят и привезти забытые вещи." },
    { q: "Какой налоговый вычет получит родитель из Солнечногорска?", a: `На 10-дневную смену (${PRICE_S4}) — возврат ~${VYCHET_S4}; на 13-дневную (${PRICE_S3}) — до ${VYCHET_MAX}. Оформляется через nalog.ru.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Солнечногорском"
    subtitle="IT-лагерь в Наро-Фоминском районе — из Солнечногорска ~1,5 часа через ЦКАД. Удобный трансфер от м. Солнцево 2 000 ₽ (не путать с самим городом)."
    breadcrumb="Лагерь из Солнечногорска"
    keywords={["~1,5 часа от Солнечногорска через ЦКАД (А107)", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь рядом с Солнечногорском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-[14px] text-slate-500 mt-2">
      Смотрите также: <a href="/lager-zelenograd/" class="text-primary hover:underline">лагерь рядом с Зеленоградом</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты 2026</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Сколько ехать из Солнечногорска в АйДаКемп?</h2>
  <p><strong>Время:</strong> около 1,5 часа на машине через ЦКАД (А107), примерно 90 км — Солнечногорск на севере, лагерь на юго-западе.</p>
  <p><strong>Важно:</strong> Солнечногорск (северный город) — это не м. Солнцево (станция метро на юго-западе Москвы, откуда идёт трансфер).</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, 2 000 ₽ в один конец — удобнее, чем вести машину через всю область.</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
