---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что делают школьники в АйДаКемп",
    text: "Никаких «посиделок за компьютером». Каждый день — структурированная программа: утром IT-занятия в мини-группах, днём бассейн и спорт, вечером командные квесты. За смену каждый школьник делает собственный проект — игру, бота или сайт — и защищает его на хакатоне.",
    list: [
      "Scratch и Minecraft — для школьников 7–9 лет",
      "Python с нуля до рабочего бота — для 10–12 лет",
      "Python Advanced, AI и API — для 13–15 лет",
      "Бассейн, спорт, вечерние квесты — каждый день"
    ]
  },
  {
    h2: "Для школьников какого класса подходит",
    text: "АйДаКемп принимает детей от 7 до 17 лет — с 1 по 11 класс. Группы делятся по возрасту, а не по классу, поэтому программа всегда по уровню. Первоклашки и старшеклассники не пересекаются ни в занятиях, ни в быту.",
    list: [
      "1–3 класс (7–9 лет): Scratch, Minecraft Education, первые игры",
      "4–6 класс (10–12 лет): Python, Telegram-боты, мини-проекты",
      "7–9 класс (13–15 лет): Python Advanced, AI, командные хакатоны",
      "10–11 класс (15–17 лет): проекты на реальных API, AI-инструменты"
    ]
  },
  {
    h2: "Чем лагерь с проживанием лучше городских курсов",
    text: "На городских курсах ребёнок учится 2–3 часа и возвращается домой — к телефону и привычному укладу. В лагере с проживанием он полностью погружается: занятия, команда, общий ритм дня. За 10 дней получается больше, чем за целый учебный год кружков.",
    list: [
      "Полное погружение — без ежедневного возврата домой",
      "Команда из ровесников с такими же интересами",
      "Результат смены — реальный проект, а не «прошли тему»",
      "Опыт самостоятельности: решения, режим, быт"
    ]
  },
  {
    h2: "Как устроен день школьника в лагере",
    text: "Никакого хаоса — чёткий ритм дня, который дети принимают уже к третьему дню. Подъём, завтрак, IT-занятия, обед, свободное время или активности, ужин, вечерняя программа. Дети знают что будет дальше — и это снижает тревогу даже у тех, кто едет впервые.",
    list: [
      "8:00 — подъём, завтрак",
      "10:00–13:00 — IT-занятия в мини-группах (до 8 человек)",
      "13:00 — обед, свободное время, бассейн",
      "16:00 — спорт или командная игра",
      "19:00 — ужин, вечерний квест или кино"
    ]
  },
  {
    h2: "Цены и смены летом 2026",
    text: "Смены с 30 мая по конец августа. В стоимость входит всё: проживание в корпусе, 5-разовое питание, IT-программа, бассейн, охрана. Ноутбук брать не нужно — всё оборудование предоставляется. Оплата частями: 50% при бронировании, остаток за 3 недели до заезда.",
    list: [
      `Смена 10 дней — от ${PRICE_MIN}`,
      `Смена 13 дней — от ${PRICE_MAX}`,
      `Налоговый вычет 13% — до ${VYCHET_MAX} возврата`,
      "Оплата в рассрочку без переплаты"
    ]
  },
  {
    h2: "Что нужно взять школьнику в летний лагерь",
    text: "Список минимальный — специального снаряжения не нужно. Ноутбук, планшет и дополнительные гаджеты везти не нужно: всё оборудование в лагере есть. Подробный список отправляем вместе с договором после бронирования.",
    list: [
      "Одежда по погоде на весь срок смены",
      "Дождевик и удобная обувь для прогулок",
      "Сланцы для бассейна, плавки/купальник",
      "Средство от комаров, солнцезащитный крем",
      "Личные гигиенические принадлежности"
    ]
  },
  {
    h2: "Как IT-лагерь помогает школьнику расти",
    text: "Школьный кружок по информатике даёт знания — лагерь даёт опыт и уверенность. Разница ощутима сразу после смены:",
    list: [
      "Математическое мышление через программирование — задачи в Python требуют логики, которая потом работает на олимпиадах и ЕГЭ",
      "Навыки командной работы — хакатон в финале проводится в командах, каждый берёт роль: разработчик, презентующий, тестировщик",
      "Уверенность в себе — «я могу создать что-то сам» — это заявление, которое школьник доказывает на публичной защите проекта",
      "Первые строки портфолио — аккаунт на GitHub с реальным кодом убедительнее любой грамоты за участие"
    ]
  },
  {
    h2: "Что школьник забирает домой после смены",
    text: "Не сертификат «за участие» и не воспоминания — а конкретный результат, который можно показать, открыть и использовать.",
    list: [
      "Реальный IT-проект — Telegram-бот, игра на Roblox или AI-ассистент, который он создал сам",
      "Аккаунт GitHub с кодом проекта — первые строки портфолио для поступления или резюме",
      "Сертификат участника лагеря — с указанием программы и преподавателей",
      "Новые друзья среди технарей — сверстники с похожими интересами из разных школ и городов"
    ]
  },
  {
    h2: "Форматы и цены на лето 2026",
    text: "Шесть смен с мая по август — от короткой пробной до полного погружения на две недели. Июль 2026 закрыт, записи нет. Июнь и август — места ещё есть.",
    list: [
      `Смена 2.1 (завершена) — 7 дней, ${DATES_SHORT_S21} — <b>${PRICE_S21}</b> (для первого раза, мягкая адаптация)`,
      `Смена 2.2 (завершена) — 8 дней, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `Смена 1 (завершена) — 10 дней, ${DATES_S1} — <b>${PRICE_S1}</b>`,
      `Смена 4 — 10 дней, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b>`,
      `Смена 3 — 13 дней, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b>`,
      `Смена 2 (завершена) — 14 дней, ${DATES_SHORT_S2} — <b>${PRICE_S2}</b> (самая популярная, закрыта)`
    ]
  }
];

const faqItems = [
  {
    question: "С какого класса берут в лагерь?",
    answer: "С первого класса (7 лет) и до 11-го (17 лет). Группы делятся по возрасту: 7–9, 10–12, 13–15 и 15–17 лет. Программа в каждой группе своя — первоклашки не будут сидеть на одних занятиях со старшеклассниками."
  },
  {
    question: "Нужно ли уметь программировать?",
    answer: "Нет. Большинство детей приезжают с нуля. Для каждого возраста своя программа: малыши начинают со Scratch, дети постарше — с визуального Python, старшие — сразу к реальному коду. Наш принцип: все уходят с готовым проектом, независимо от стартового уровня."
  },
  {
    question: "Сколько стоит смена в летнем лагере?",
    answer: `От ${PRICE_MIN} за 10-дневную смену. Всё включено: проживание, 5-разовое питание, IT-программа, бассейн, охрана. Ноутбук не нужен — оборудование наше. Можно оплатить частями: 50% при бронировании, остаток за 3 недели до заезда. Доступен налоговый вычет 13%.`
  },
  {
    question: "Что если ребёнок едет впервые и боится?",
    answer: "Это нормально — почти каждый едет с этим чувством. Первые 1–2 дня бывают сложными, потом ребёнок включается. Мы предупреждаем родителей: не звоните каждые 2 часа — это поддерживает тревогу, а не снижает её. В лагере всегда есть воспитатель, к которому можно обратиться."
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Лагерь для школьников на лето 2026 | АйДаКемп"
  description={`Летний лагерь для школьников 7–17 лет в Подмосковье 2026. IT-проект за смену, бассейн, малые группы. 66 км от МКАД. Смены с 30 мая от ${PRICE_MIN}.`}
  h1="Летний лагерь для школьников в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-dlya-shkolnikov-na-leto"
>
  <Fragment slot="head">
    <FAQSchema items={faqItems.map(item => ({ q: item.question, a: item.answer }))} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для школьников в Подмосковье"
    subtitle="IT-проект за смену, бассейн, лес и 10–15 новых друзей. Для школьников 7–17 лет, группы по возрасту."
    breadcrumb="Летний лагерь для школьников"
    keywords={["IT-проект за смену — игра, бот или сайт", "Группы по возрасту: 7–9, 10–12, 13–17 лет", `66 км от МКАД, всё включено от ${PRICE_MIN}`]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Летний лагерь для школьников в Подмосковье 2026"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <section class="mx-auto max-w-[860px] px-4 py-10">
    <div class="flex items-center gap-2 mb-6">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Частые вопросы о летнем лагере для школьников
      </h2>
    </div>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
          <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
            <span>{item.question}</span>
            <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
          </button>
          <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
            <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Куда деть ребёнка летом — 5 вариантов", url: "/stati/kuda-det-rebenka-letom/", description: "Честный разбор: дача, город, лагерь, море — что выбрать.", icon: "lightbulb" },
    { title: "Что взять ребёнку в лагерь", url: "/stati/chto-vzyat-v-lager/", description: "Полный список вещей, без лишнего.", icon: "backpack" },
    { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", description: "Программа для 12–16 лет.", icon: "rocket-takeoff" },
    { title: "Смены лета 2026 — цены", url: "/ceny/", description: "Выбрать смену и забронировать.", icon: "calendar-week" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</LandingLayout>
