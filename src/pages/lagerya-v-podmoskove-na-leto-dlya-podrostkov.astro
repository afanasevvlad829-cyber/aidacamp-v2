---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагеря в подмосковье на лето для подростков 2026 — IT-лагерь АйДаКемп"
  description="Лагеря в подмосковье на лето для подростков — АйДаКемп в Подмосковье 2026. Python, AI, Minecraft, бассейн. Смены июнь–август, от 48 000 ₽. Трансфер от м. Солнцево."
  h1="Лагеря в подмосковье на лето для подростков 2026 — АйДаКемп"
  canonical="https://aidacamp.ru/lagerya-v-podmoskove-na-leto-dlya-podrostkov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли лагеря в подмосковье на лето для подростков с проживанием в 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Подмосковье на. Смены 7–14 дней, летом 2026, для школьников 7–15 лет." }
        },
        {
          "@type": "Question",
          "name": "Как добраться до лагеря из Подмосковье на?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь в 2026 году?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Смены 10, 13 и 14 дней — 74 900–99 000 ₽. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до 5 434 ₽." }
        }
      ]
    })} />
  </Fragment>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Лагеря в подмосковье на лето для подростков 2026 — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Подмосковье на — организованный трансфер от м. Солнцево (2 000 ₽).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от 48 000 ₽, налоговый вычет 13% — до 5 434 ₽.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, 2 000 ₽</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 7–14 дней, июнь и август 2026</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-[15px] text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Смены июнь–август 2026, от 48 000 ₽.
        Налоговый вычет 13% — до 5 434 ₽.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny" class="text-primary hover:underline">цены и смены 2026</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />


  <!-- strengthened-v2 -->
  <section class="mx-auto max-w-[720px] px-4 py-8 prose prose-lg max-w-none text-body-muted leading-relaxed">
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4">Летние лагеря для подростков в Подмосковье 2026</h2>
    <p>Лето 2026 уже не за горами, и многие родители задумываются о том, куда отправить своих подростков. Лагеря в Подмосковье предлагают разнообразные программы, и одним из интересных вариантов является АйДаКемп. Здесь ребята могут погрузиться в мир IT, изучая Python, AI, а также создавать свои игры в Minecraft и Roblox.</p>
    <p>АйДаКемп расположен в санатории «Изумруд», всего в 66 км от МКАД. Это комфортное место с закрытой охраняемой территорией, что позволяет родителям не волноваться за безопасность детей. Питание здесь пятиразовое, а медработник на территории всегда готов прийти на помощь, что также важно для спокойствия родителей.</p>
    <p>Каждая смена длится от 7 до 14 дней, а группы небольшие — до 8 человек. Это создает атмосферу доверия и позволяет преподавателям уделять каждому ребенку достаточно внимания. В конце смены проходит хакатон, где ребята защищают свои проекты, что поможет им не только получить диплом, но и создать портфолио для будущего.</p>
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4 mt-8">Преимущества лагеря АйДаКемп</h2>
    <ul class="space-y-2">
      <li>Разнообразные IT-программы на выбор</li>
      <li>Удобное расположение и комфортные условия</li>
      <li>Небольшие группы для индивидуального подхода</li>
      <li>Ежедневные фотоотчеты для родителей в Telegram-чатах</li>
      <li>Хакатон в конце смены для демонстрации достижений</li>
    </ul>
  </section>
</LandingLayout>
