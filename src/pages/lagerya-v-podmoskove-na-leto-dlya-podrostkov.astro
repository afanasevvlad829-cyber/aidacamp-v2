---
import { PRICE_MAX, PRICE_MIN, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import FAQSchema from '../components/FAQSchema.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагеря в подмосковье на лето для подростков 2026 — IT-лагерь АйДаКемп"
  description={`Лагеря в подмосковье на лето для подростков — АйДаКемп в Подмосковье 2026. Python, AI, Minecraft, бассейн. Смены июнь–август, от ${PRICE_MIN}. Трансфер от м. Солнцево.`}
  h1="Лагеря в подмосковье на лето для подростков 2026 — АйДаКемп"
  canonical="https://aidacamp.ru/lagerya-v-podmoskove-na-leto-dlya-podrostkov"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Есть ли лагеря в подмосковье на лето для подростков с проживанием в 2026?", a: "АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Подмосковье на. Смены 7–14 дней, летом 2026, для школьников 7–15 лет." },
    { q: "Как добраться до лагеря из Подмосковье на?", a: "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе." },
    { q: "Сколько стоит лагерь в 2026 году?", a: `От ${PRICE_MIN} за 7 дней. Смены 10, 13 и 14 дней — ${PRICE_S4}–${PRICE_MAX}. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до 5 434 ₽.` }
  ]} />
  </Fragment>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Лагеря в подмосковье на лето для подростков 2026 — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Подмосковье на — организованный трансфер от м. Солнцево (2 000 ₽).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от {PRICE_MIN}, налоговый вычет 13% — до 5 434 ₽.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, 2 000 ₽</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 7–14 дней, июнь и август 2026</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-[15px] text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Смены июнь–август 2026, от {PRICE_MIN}.
        Налоговый вычет 13% — до 5 434 ₽.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny" class="text-primary hover:underline">цены и смены 2026</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />


  

  <!-- strengthened-v2 -->
  <section class="mx-auto max-w-[720px] px-4 py-8 prose prose-lg max-w-none text-body-muted leading-relaxed">
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4">Среда, в которой подростку интересно</h2>
    <p>Подростку важно быть среди своих. В АйДаКемп едут ребята, которым интересны игры, код и технологии, — здесь легко найти друзей по увлечениям и не чувствовать себя лишним.</p>
    <p>Каждый за смену делает свой проект: игру, бота, 3D-сцену — и показывает его на хакатоне. Группы до 8 человек, поэтому подросток не теряется, а преподаватель успевает помочь лично. После занятий — бассейн, спорт, вечерние программы.</p>
    <p>Лагерь в санатории «Изумруд», Наро-Фоминский район, 66 км от МКАД. Закрытая территория, 5-разовое питание, медработник круглосуточно. Родителям — фото из отряда в Telegram каждый день. Смены июнь–август 2026.</p>
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4 mt-8">Коротко</h2>
    <ul class="space-y-2">
      <li>Ребята с общими интересами — код, игры, технологии</li>
      <li>Свой проект и защита на хакатоне</li>
      <li>Группы до 8, внимание каждому</li>
      <li>Бассейн, 5-разовое питание, медработник 24/7</li>
      <li>Налоговый вычет 13% — до 5 434 ₽ за 14-дневную смену</li>
    </ul>
  </section>
</LandingLayout>
