---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", icon: "cpu", description: "Разбираем реальные данные WEF" },
  { title: "ROI образовательных инвестиций", url: "/blog/future-skills", icon: "cash-coin", description: "Что считать и как" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программирование + мышление" },
];
---

<Base
  title="AI и ВВП: почему статистика не видит революции | АйДаКемп"
  description="Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Объясняю механику — опираясь на данные MIT и Нобелевского лауреата Асемоглу, а не на интуицию."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/blog/ai-economy" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "AI и ВВП: почему статистика не видит революции",
      "description": "Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Объясняю механику — опираясь на данные MIT и Нобелевского лауреата Асемоглу, а не на интуицию.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-09",
      "dateModified": "2026-06-09",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/blog/ai-economy"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="AI и ВВП: почему статистика не видит революции"
    subtitle="Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Объясняю механику — через данные MIT и Нобелевского лауреата."
    imageBase="lager-programmirovaniya"
    imageAlt="AI и экономика — почему статистика не видит революции"
    breadcrumbsLast="AI и экономика"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Это не случайность. Объясняю механику — опираясь на данные MIT и Нобелевского лауреата, а не на интуицию.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что показало исследование MIT
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          В 2025 году MIT NANDA — исследовательский центр при Массачусетском технологическом институте — опубликовал «The GenAI Divide». 150 интервью с руководителями, анализ 300 публичных кейсов. Результат: 95% пилотных проектов не дали измеримого эффекта на P&L — прибыль и убытки. Только 5% компаний реально изменили свою экономику.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          374 компании из S&P 500 упоминают AI в отчётах. Большинство говорит что всё прекрасно. Прибыль стоит на месте. Дарон Асемоглу, лауреат Нобелевской премии по экономике 2024 года, оценивает суммарный вклад AI в рост ВВП США в 0.5–1% за следующие 10 лет.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">ИТОГИ ИССЛЕДОВАНИЙ</p>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="rounded-[12px] bg-[#FFF3EC] p-4">
              <div class="text-[24px] font-bold text-orange-500">$40B</div>
              <div class="text-[13px] text-slate-500 mt-1">Вложено в GenAI</div>
            </div>
            <div class="rounded-[12px] bg-[#FFF0F0] p-4">
              <div class="text-[24px] font-bold text-red-600">95%</div>
              <div class="text-[13px] text-slate-500 mt-1">Пилотов без P&L эффекта</div>
            </div>
            <div class="rounded-[12px] bg-[#EDFAF4] p-4">
              <div class="text-[24px] font-bold text-emerald-600">+0.5%</div>
              <div class="text-[13px] text-slate-500 mt-1">ВВП за 10 лет (MIT)</div>
            </div>
          </div>
          <p class="text-[12px] text-slate-400 mt-4">MIT NANDA «The GenAI Divide» 2025 · Acemoglu 2024</p>
        </div>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему оптимизация не создаёт рост
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Это нулевая сумма. Один McDonald's сократил трёх юристов с помощью AI. Экономия — несколько миллионов в год. Но три уволенных юриста перестали тратить деньги. Покупательная способность снижается — в том числе тех, кто покупает бургеры. Рынок не вырос.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          AI работает там, где создаёт новый спрос, а не просто снижает затраты. Uber сделал такси удобнее — люди стали ездить больше — рынок вырос. Это создание ценности, а не перераспределение. Именно поэтому Uber стоит дорого.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Контейнерная революция как метафора
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Стандартный морской контейнер изобрели в 1956 году. К 1980-м стоимость перевозки тонны груза морем упала в 20 раз. Это изменило мировую торговлю навсегда — но за 30 лет, а не за 3 года. AI сейчас примерно там же, где контейнер в 1960-м. Технология работает. Эффект накапливается медленно.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делать прямо сейчас
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Это не повод расслабляться. Гонка идёт, просто результаты не видны в квартальных отчётах. Компания, которая не понимает AI-инструменты, проигрывает конкурентам, которые понимают. Понимать механику раньше, чем она стала очевидной всем — уже конкурентное преимущество.
        </p>

        <div class="my-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Понимать механику раньше, чем она стала очевидной всем — уже само по себе конкурентное преимущество.»
          </p>
        </div>

        <div class="mt-4 rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-[13px] font-semibold text-slate-500 uppercase tracking-[0.05em] mb-2">ИСТОЧНИКИ</p>
          <ul class="space-y-1 text-[13px] text-slate-500">
            <li>— MIT NANDA «The GenAI Divide: State of AI in Business 2025»</li>
            <li>— Daron Acemoglu «The Simple Macroeconomics of AI», MIT (2024)</li>
            <li>— Financial Times — анализ упоминаний AI в отчётах S&P 500 (2025)</li>
            <li>— Marc Levinson «The Box» — история контейнерной революции</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Помогите ребёнку понять AI раньше, чем это стало очевидным"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
