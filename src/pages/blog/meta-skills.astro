---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", icon: "cpu", description: "Разбираем реальные данные WEF" },
  { title: "Геймдев как образовательный инструмент", url: "/blog/game-dev-skills", icon: "controller", description: "Что говорит нейронаука" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программирование + мышление" },
];
---

<Base
  title="85% профессий ещё не существует. Что с этим делать | АйДаКемп"
  description="IFTF — Institute for the Future — публикует прогнозы рынка труда с 1968 года. Их цифра про 85% вызывает два чувства: кто-то отмахивается, кто-то паникует. Ни то, ни другое не помогает. Объясняю, что с этим делать."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/blog/meta-skills" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "85% профессий ещё не существует. Что с этим делать",
      "description": "IFTF — Institute for the Future — публикует прогнозы рынка труда с 1968 года. Их цифра про 85% вызывает два чувства: кто-то отмахивается, кто-то паникует. Ни то, ни другое не помогает. Объясняю, что с этим делать.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-05-26",
      "dateModified": "2026-05-26",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/blog/meta-skills"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="85% профессий ещё не существует. Что с этим делать"
    subtitle="IFTF прогнозирует рынок труда с 1968 года. Их цифра вызывает панику — объясняю, что с этим реально делать."
    imageBase="ii-programmista"
    imageAlt="Профессии будущего — как готовить детей к рынку труда"
    breadcrumbsLast="Профессии будущего"
    readTime="4 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          IFTF — Institute for the Future, Калифорния — публикует прогнозы рынка труда с 1968 года. Их цифра про 85% вызывает два чувства: кто-то отмахивается, кто-то паникует. Ни то, ни другое не помогает. Объясняю, что с этим делать.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Откуда взялась цифра и что она значит
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          85% — это оценка порядка величины на горизонте 10 лет. Даже авторы говорят, что точность здесь невозможна. Но даже если реальная цифра вдвое меньше — 42% профессий ещё не существует — это уже меняет логику образовательных инвестиций.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          В 2000 году не существовало профессий UX-исследователь, data analyst, специалист по кибербезопасности, SMM-менеджер, prompt-инженер. Это не экзотика — это востребованные позиции с хорошими зарплатами. И так же в 2035 году будут востребованы профессии, которые сегодня нельзя назвать.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">ТОП НАВЫКОВ БУДУЩЕГО — WEF FUTURE OF JOBS 2025</p>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-[14px] font-medium text-slate-700">Адаптивность и гибкость</span>
                <span class="text-[14px] font-bold text-blue-600">73%</span>
              </div>
              <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" style="width:73%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-[14px] font-medium text-slate-700">Критическое мышление</span>
                <span class="text-[14px] font-bold text-orange-500">68%</span>
              </div>
              <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-orange-500 rounded-full" style="width:68%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-[14px] font-medium text-slate-700">Технологическая грамотность</span>
                <span class="text-[14px] font-bold text-emerald-600">62%</span>
              </div>
              <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width:62%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-[14px] font-medium text-slate-700">Творческое мышление</span>
                <span class="text-[14px] font-bold text-red-600">58%</span>
              </div>
              <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-red-500 rounded-full" style="width:58%"></div>
              </div>
            </div>
          </div>
          <p class="text-[12px] text-slate-400 mt-4">World Economic Forum «Future of Jobs Report 2025»</p>
        </div>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему выбор «правильной специальности» больше не работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          BLS — Бюро трудовой статистики США — фиксирует: средний работник сменит 12 работ за карьеру. McKinsey оценивает: к 2030 году 375 миллионов человек сменят категорию занятости из-за автоматизации. Выигрывает не тот, кто угадал профессию в 17 лет. Выигрывает тот, кто умеет быстро переключаться без паники.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое метанавыки и как они развиваются
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Метанавык — навык, не привязанный к конкретному инструменту. Умение разобраться в незнакомом ПО за два-три дня, не паниковать перед задачей без готового ответа, декомпозировать большую непонятную задачу на маленькие понятные. Ни один не устаревает при смене языка, платформы или отрасли.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          World Economic Forum в «Future of Jobs 2025» называет три формата наиболее эффективными: проектное обучение, работа в смешанных командах, решение задач без готового ответа. Общее: ученик несёт ответственность за результат, а не за правильное воспроизведение чужого решения.
        </p>

        <div class="my-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Рынок всё меньше вознаграждает за конкретную специальность. Всё больше — за скорость освоения следующей.»
          </p>
        </div>

        <div class="mt-4 rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-[13px] font-semibold text-slate-500 uppercase tracking-[0.05em] mb-2">ИСТОЧНИКИ</p>
          <ul class="space-y-1 text-[13px] text-slate-500">
            <li>— IFTF (Institute for the Future) «Future Work Skills 2030» (2023)</li>
            <li>— McKinsey «Jobs lost, jobs gained: Workforce transitions» (2023)</li>
            <li>— World Economic Forum «Future of Jobs Report 2025»</li>
            <li>— BLS (Bureau of Labor Statistics, США) — данные о смене работы за карьеру</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Научите ребёнка учиться — любая профессия будет по плечу"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
