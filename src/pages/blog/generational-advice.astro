---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "85% профессий ещё не существует", url: "/blog/meta-skills", icon: "graph-up", description: "Что с этим делать" },
  { title: "ROI образовательных инвестиций", url: "/blog/future-skills", icon: "cash-coin", description: "Что считать и как" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программирование + мышление" },
];
---

<Base
  title="Как передавать опыт, когда он устаревает быстрее, чем передаётся | АйДаКемп"
  description="Это не статья про то, что родители дают неправильные советы. Это про механику — почему хорошие советы тоже имеют срок годности, и что передать детям"
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/blog/generational-advice" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Как передавать опыт, когда он устаревает быстрее, чем передаётся",
      "description": "Это не статья про то, что родители дают неправильные советы. Это про механику — почему хорошие советы тоже имеют срок годности, и что передать детям действительно долговечного.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-09",
      "dateModified": "2026-06-09",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/blog/generational-advice"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как передавать опыт, когда он устаревает быстрее, чем передаётся"
    subtitle="Не про то, что родители дают неправильные советы. Про механику — и что реально долговечно."
    imageBase="lager-programmirovaniya"
    imageAlt="Как передавать опыт детям в эпоху быстрых изменений"
    breadcrumbsLast="Воспитание и опыт"
    readTime="4 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Это не статья про то, что родители дают неправильные советы. Это про механику — почему хорошие советы тоже имеют срок годности, и что делать, если хочется передать детям что-то действительно долговечное.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему родители дают советы из прошлого — и это нормально
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Человек принимает решения на основе того, что видел и что сработало в его жизни. Родитель, выросший в 1990-е, наблюдал вполне конкретную реальность: юрист или экономист — это стабильность, уважение, хорошая зарплата. Это не стереотип из книги, это реальный опыт. Такой опыт передаётся как забота — не как манипуляция.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Проблема не в намерениях. Проблема в том, что скорость изменений рынка труда превысила длину одного поколения. Раньше опыт отца был актуален для сына. Сейчас это не так.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5 overflow-x-auto">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">СРОК АКТУАЛЬНОСТИ КАРЬЕРНОГО СОВЕТА ПО ДЕСЯТИЛЕТИЯМ</p>
          <table class="w-full text-[14px]">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left px-4 py-2 font-semibold text-slate-700 rounded-tl-[8px]">Период</th>
                <th class="text-left px-4 py-2 font-semibold text-slate-700">Совет</th>
                <th class="text-left px-4 py-2 font-semibold text-slate-700 rounded-tr-[8px]">Актуален</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr class="bg-slate-50">
                <td class="px-4 py-2 text-slate-600">1950–70-е</td>
                <td class="px-4 py-2 text-slate-600">Инженер / врач / учитель</td>
                <td class="px-4 py-2 font-semibold text-emerald-600">30+ лет</td>
              </tr>
              <tr>
                <td class="px-4 py-2 text-slate-600">1980–90-е</td>
                <td class="px-4 py-2 text-slate-600">Юрист / экономист</td>
                <td class="px-4 py-2 font-semibold text-blue-600">15–20 лет</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="px-4 py-2 text-slate-600">2000-е</td>
                <td class="px-4 py-2 text-slate-600">IT / маркетолог</td>
                <td class="px-4 py-2 font-semibold text-orange-500">5–10 лет</td>
              </tr>
              <tr>
                <td class="px-4 py-2 text-slate-600">2010–20-е</td>
                <td class="px-4 py-2 text-slate-600">Data / UX / DevOps</td>
                <td class="px-4 py-2 font-semibold text-red-600">3–5 лет</td>
              </tr>
            </tbody>
          </table>
          <div class="mt-3 rounded-[8px] bg-red-50 border-l-3 border-red-400 px-4 py-2 text-[12px] text-slate-600">
            Тренд: срок актуальности совета сокращается с каждым поколением
          </div>
          <p class="text-[12px] text-slate-400 mt-3">McKinsey «Future of Work» 2023 · BLS данные о карьерных траекториях</p>
        </div>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что происходит, когда скорость изменений превышает длину поколения
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          McKinsey: к 2030 году 375 миллионов человек сменят категорию занятости из-за автоматизации. BLS фиксирует, что средний работник сменит 12 работ за карьеру. Это создаёт новый тип родительской тревоги: «Я хочу дать правильный совет, но не знаю, что правильно».
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что можно передать вместо конкретных советов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Есть вещи, которые не устаревают: умение принимать решение в условиях неопределённости, справляться с неудачей и двигаться дальше, задавать вопрос «почему» вместо поиска правильного ответа, спокойствие перед незнакомым. Это передаётся через демонстрацию — через то, как сам родитель ведёт себя в непонятных ситуациях.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Разговор о будущем без тревоги
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Самый продуктивный разговор с подростком о будущем — не «кем ты хочешь стать», а «что тебе по-настоящему интересно» и «что ты готов делать, даже когда сложно». Эти два вопроса дают гораздо больше информации для навигации, чем любой рейтинг профессий.
        </p>

        <div class="my-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Самая ценная часть родительского опыта — не конкретные ответы. А умение находить ответы в условиях, которых раньше не было.»
          </p>
        </div>

        <div class="mt-4 rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-[13px] font-semibold text-slate-500 uppercase tracking-[0.05em] mb-2">ИСТОЧНИКИ</p>
          <ul class="space-y-1 text-[13px] text-slate-500">
            <li>— McKinsey «Future of Work» — прогнозы изменений рынка труда (2023)</li>
            <li>— BLS (Bureau of Labor Statistics) — данные о карьерных траекториях</li>
            <li>— Carol Dweck «Mindset» — установки и их передача детям</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Дайте ребёнку опыт, который не устареет"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
