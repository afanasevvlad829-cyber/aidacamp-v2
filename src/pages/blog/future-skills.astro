---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "85% профессий ещё не существует", url: "/blog/meta-skills", icon: "graph-up", description: "Что с этим делать" },
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", icon: "cpu", description: "Разбор реальных данных" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программирование + мышление" },
];
---

<Base
  title="ROI образовательных инвестиций: что считать и как | АйДаКемп"
  description="Родители в Москве тратят на допобразование детей 100–250 тысяч в год. Объясняю, как считать отдачу от этих вложений и какие инвестиции работают дольше других."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/blog/future-skills" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "ROI образовательных инвестиций: что считать и как",
      "description": "Родители в Москве тратят на допобразование детей 100–250 тысяч в год. Объясняю, как считать отдачу от этих вложений и какие инвестиции работают дольше других.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-02",
      "dateModified": "2026-06-02",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/blog/future-skills"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="ROI образовательных инвестиций: что считать и как"
    subtitle="Родители тратят 100–250 тысяч в год на допобразование. Объясняю, какие вложения окупаются дольше всего."
    imageBase="lager-programmirovaniya"
    imageAlt="ROI образовательных инвестиций для детей — что считать и как"
    breadcrumbsLast="Образование и инвестиции"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Родители в Москве тратят на дополнительное образование детей от 100 до 250 тысяч рублей в год. Это серьёзные деньги. И как любые серьёзные деньги, они заслуживают вопроса: какую отдачу мы ожидаем и через сколько лет? Отдельная статья — <a href="/ceny" class="text-orange-600 underline decoration-orange-600/60 underline-offset-2">сколько стоит смена в нашем лагере</a> и как рассчитывается цена.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Период полураспада знания — что это такое
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          IBM Institute for Business Value ввёл термин «период полураспада профессионального знания» — по аналогии с ядерной физикой. Это время, за которое актуальность знания снижается вдвое. В 2000-е в IT этот период составлял около пяти лет. Сейчас IBM оценивает его в два с половиной года. Для офисных специальностей — около пяти лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Это значит: половина того, что знает сегодняшний IT-специалист, через два с половиной года перестанет быть конкурентным преимуществом. Это не катастрофа — просто новая реальность, о которой не принято говорить вслух.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-base font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">АКТУАЛЬНОСТЬ ЗНАНИЯ ЧЕРЕЗ ПЕРИОД ПОЛУРАСПАДА (IBM 2023)</p>
          <div class="space-y-5">
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-base font-semibold text-slate-700">IT-специалист</span>
                <span class="text-[12px] text-slate-400">полураспад 2.5 года</span>
              </div>
              <div class="h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" style="width:50%"></div>
              </div>
              <p class="text-[12px] text-slate-400 mt-1">50% актуальности через 2.5 года</p>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-base font-semibold text-slate-700">Офисный работник</span>
                <span class="text-[12px] text-slate-400">полураспад 5 лет</span>
              </div>
              <div class="h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-primary rounded-full" style="width:50%"></div>
              </div>
              <p class="text-[12px] text-slate-400 mt-1">50% актуальности через 5 лет</p>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-base font-semibold text-slate-700">Медицина / право</span>
                <span class="text-[12px] text-slate-400">полураспад 10+ лет</span>
              </div>
              <div class="h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width:70%"></div>
              </div>
              <p class="text-[12px] text-slate-400 mt-1">70% актуальности через 10+ лет</p>
            </div>
          </div>
          <p class="text-[12px] text-slate-400 mt-4">IBM Institute for Business Value (2023)</p>
        </div>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чем отличаются инвестиции с разным сроком годности
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Репетитор по математике — инвестиция в конкретный навык. Срок годности: 5–7 лет. Курс программирования на конкретном языке — аналогично. Python сегодня популярен. Через пять лет будет популярен другой язык или AI-агент, который пишет на Python за вас.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Проектное обучение — другой класс. Умение работать с незнакомой задачей без готового алгоритма. Умение найти ошибку в собственной логике. Умение довести проект до результата, когда хочется бросить. Срок годности — вся карьера. Именно на этом построена программа <a href="/lager-dlya-detey" class="text-orange-600 underline decoration-orange-600/60 underline-offset-2">детского лагеря АйДаКемп</a>.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          NTL — National Training Laboratories, США: при лекции усваивается 5% информации через две недели. При практике с обратной связью — 75%. Без практики деньги на образование работают значительно хуже.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-base font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">УСВОЕНИЕ ПРИ РАЗНЫХ ФОРМАТАХ — NTL</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
            <div class="rounded-[12px] bg-[#FFF0F0] p-4">
              <div class="text-[28px] font-bold text-red-600">5%</div>
              <div class="text-base text-slate-500 mt-1">Лекция</div>
            </div>
            <div class="rounded-[12px] bg-[#FFF3EC] p-4">
              <div class="text-[28px] font-bold text-orange-500">20%</div>
              <div class="text-base text-slate-500 mt-1">Обсуждение</div>
            </div>
            <div class="rounded-[12px] bg-[#EDFAF4] p-4">
              <div class="text-[28px] font-bold text-emerald-600">75%</div>
              <div class="text-base text-slate-500 mt-1">Практика</div>
            </div>
            <div class="rounded-[12px] bg-[#EEF4FF] p-4">
              <div class="text-[28px] font-bold text-blue-600">90%</div>
              <div class="text-base text-slate-500 mt-1">Учу другого</div>
            </div>
          </div>
          <p class="text-[12px] text-slate-400 mt-4">NTL (National Training Laboratories) — Learning Pyramid</p>
        </div>

        <div class="my-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Самые долгоживущие инвестиции — не в конкретные знания, а в скорость их замены.»
          </p>
        </div>

        <div class="mt-4 rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-base font-semibold text-slate-500 uppercase tracking-[0.05em] mb-2">ИСТОЧНИКИ</p>
          <ul class="space-y-1 text-base text-slate-500">
            <li>— IBM Institute for Business Value «Facing the talent disruption of generative AI» (2023)</li>
            <li>— NTL (National Training Laboratories) — Learning Pyramid</li>
            <li>— MIT Media Lab — проектное обучение и долгосрочная память</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Инвестиция в мышление — не устаревает"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
