---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const relatedPages = getRelatedPages('/faq');
---

<Base
  title="Вопросы и ответы про детский лагерь АйДаКемп — FAQ"
  description="Все вопросы родителей о детском IT-лагере АйДаКемп: медицина, безопасность, питание, проживание, документы, связь и оплата."
>
  <Header />
  <main>
    <section class="mx-auto max-w-[900px] px-4 pt-10 pb-4 md:pt-14">
      <nav class="text-base text-slate-400 mb-4">
        <a href="/" class="hover:text-orange-600 transition-colors">Главная</a>
        <span class="mx-2">&rarr;</span>
        <span class="text-slate-600">Вопросы и ответы</span>
      </nav>
      <h1 class="text-[28px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">Вопросы и ответы</h1>
      <p class="mt-2 text-[16px] leading-[1.6] text-slate-500 max-w-[560px]">
        Всё, что спрашивают родители перед тем, как отправить ребёнка в АйДаКемп — по темам.
      </p>
    </section>

    <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'documents:5', 'about2026:1', 'about2026:2', 'documents:0']} />
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <!-- FAQPage отдаёт сам <FAQ /> — по отрисованным вопросам -->
  <Footer />
</Base>
