---
import LandingLayout from '../layouts/LandingLayout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { images } from '../data/gallery';
import { readFileSync } from 'fs';
import { join } from 'path';

const title = "Размещение в лагере АйДаКемп — корпуса, комнаты, условия";
const description = "Условия проживания в детском IT-лагере АйДаКемп: уютные корпуса санатория «Изумруд», комнаты на 2–4 человека, раздельное размещение, круглосуточная охрана.";
const h1 = "Размещение в лагере";
const canonical = "https://aidacamp.ru/razmeshchenie";

// Load room photos from gallery
const galleryDir = join(process.cwd(), 'images', 'gallery');
type Addition = { file: string; alt: string };
let additions: Record<string, Addition[]> = {};
try {
  additions = JSON.parse(readFileSync(join(galleryDir, 'gallery-additions.json'), 'utf-8'));
} catch {}

const roomPhotos: { src: string; alt: string }[] = [
  ...(images['rooms'] ?? []),
  ...(additions['rooms'] ?? []).map(e => ({
    src: `/images/gallery/${e.file}`,
    alt: e.alt || 'Размещение в лагере АйДаКемп',
  })),
];

function jpgSrc(src: string) {
  return src.replace('/images/gallery/', '/images/gallery/jpg/').replace('.avif', '.jpg');
}

const features = [
  { icon: 'bi-house-door-fill',     title: 'Корпуса санатория',         text: 'Капитальные корпуса санатория «Изумруд» — с ремонтом, мебелью и чистотой. Не палатки, не армейские казармы.' },
  { icon: 'bi-people-fill',          title: 'Комнаты на 2–4 человека',   text: 'Личная кровать, тумбочка и место для вещей у каждого. Без переполненных залов.' },
  { icon: 'bi-shield-lock-fill',     title: 'Раздельное размещение',     text: 'Мальчики и девочки живут в отдельных комнатах на разных этажах или крыльях корпуса.' },
  { icon: 'bi-thermometer-half',     title: 'Тепло и комфортно',         text: 'Горячая вода, чистое постельное бельё и полотенца — меняются по расписанию.' },
  { icon: 'bi-shield-fill',           title: 'Круглосуточная охрана',     text: 'Закрытая территория, охрана и видеонаблюдение. На объект не может зайти посторонний.' },
  { icon: 'bi-wifi',                  title: 'Wi-Fi в корпусах',          text: 'Интернет доступен в корпусах — нужен для учебных проектов.' },
];

const faqs = [
  {
    q: 'Сколько детей живёт в одной комнате?',
    a: 'От 2 до 4 человек. Ровесники или ребята из одного отряда оказываются вместе — легче сдружиться с первого дня.',
  },
  {
    q: 'Мальчики и девочки живут отдельно?',
    a: 'Да. Всегда раздельное размещение: разные комнаты, как правило — разные этажи или крылья.',
  },
  {
    q: 'Нужно привозить постельное бельё?',
    a: 'Нет. Постельное бельё, подушки, одеяла и полотенца предоставляются и меняются по расписанию.',
  },
  {
    q: 'Есть ли место для хранения ценных вещей?',
    a: 'В корпусах есть места для хранения. Дорогостоящую технику лучше не брать — лагерь не несёт материальной ответственности за личные вещи.',
  },
  {
    q: 'Во сколько отбой?',
    a: 'В 22:30. Подъём в 8:00. Режим обязателен: детям нужно высыпаться для учёбы и активного дня.',
  },
];

const articles = [
  { title: 'Куда отправить ребёнка летом: разбор всех вариантов',         url: '/stati/kuda-det-rebenka-letom/',             description: 'Бабушка, лагерь, кружки — плюсы и минусы каждого варианта.',                   icon: 'sun' },
  { title: 'Детский лагерь без телефонов — что это и зачем',              url: '/stati/detskiy-lager-bez-telefonov/',        description: 'Как работает формат с экранным временем как внутренней валютой.',             icon: 'phone-vibrate' },
  { title: 'Как выбрать детский лагерь: на что смотреть',                 url: '/stati/kak-vybrat-detskiy-lager/',          description: 'Чек-лист для родителей: инфраструктура, питание, безопасность, отзывы.',     icon: 'check2-circle' },
];

const relatedPages = [
  { title: 'Питание',      description: '5-разовое питание по СанПиН',  url: '/pitanie/',      icon: 'bi-cup-hot-fill' },
  { title: 'Территория',   description: 'Бассейн, спорт, природа',      url: '/foto/',         icon: 'bi-tree-fill' },
  { title: 'Программа',    description: 'Python, AI, хакатон, проект',  url: '/o-lagere/',     icon: 'bi-laptop' },
  { title: 'Цены и смены', description: 'Стоимость и даты 2026',        url: '/ceny/',         icon: 'bi-calendar-check' },
];
---

<LandingLayout
  title={title}
  description={description}
  h1={h1}
  canonical={canonical}
>
  <Fragment slot="head">
    <FAQSchema items={faqs} />
  </Fragment>

  <!-- HERO -->
  <Fragment slot="hero">
    <section class="relative bg-[#0d1a2b] text-white overflow-hidden">
      <!-- Фото на полную яркость + лёгкий HDR-эффект -->
      <img
        src="/images/gallery/hero-razmeshchenie.avif"
        alt="Корпуса лагеря АйДаКемп"
        class="absolute inset-0 h-full w-full object-cover"
        style="filter: brightness(1.06) contrast(1.1) saturate(1.18);"
        loading="eager"
      />
      <!-- Десктоп: затемнение только слева под текст, правая сторона прозрачна -->
      <div class="absolute inset-0 hidden md:block bg-[linear-gradient(90deg,rgba(5,9,18,0.92)_0%,rgba(5,9,18,0.80)_28%,rgba(5,9,18,0.44)_52%,rgba(5,9,18,0.06)_72%,transparent_88%)]"></div>
      <!-- Мобайл: умеренное затемнение на всю высоту (текст на весь экран) -->
      <div class="absolute inset-0 md:hidden" style="background: rgba(5,9,18,0.62);"></div>
      <!-- Тонкий градиент под шапку навигации -->
      <div class="absolute top-0 left-0 right-0 h-[120px] bg-[linear-gradient(180deg,rgba(0,0,0,0.35)_0%,transparent_100%)] pointer-events-none"></div>
      <div class="relative mx-auto max-w-[1312px] px-4 pt-20 pb-14 md:pt-28 md:pb-20">
        <nav class="mb-4 flex items-center gap-2 text-base text-white/60" aria-label="Хлебные крошки">
          <a href="/" class="hover:text-white">Главная</a>
          <i class="bi bi-chevron-right text-[10px]" aria-hidden="true"></i>
          <span class="text-white/85">Размещение</span>
        </nav>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Условия проживания</p>
        <h1 class="mt-3 text-[34px] md:text-[52px] font-extrabold leading-[1.05] tracking-[-0.03em] text-white max-w-[680px]">
          Комфортные корпуса<br /><span class="hero-outline">санатория «Изумруд»</span>
        </h1>
        <p class="mt-4 max-w-[560px] text-[17px] md:text-[18px] leading-[1.55] text-white/80">
          Уютные комнаты на 2–4 человека, горячая вода, чистота и круглосуточная охрана. Как в детском санатории — не в палатках.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/#shifts" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-bold text-white hover:bg-[#d68830] transition-colors">
            Записать
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
          </a>
          <a href="#gallery-rooms" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-6 py-3 text-base font-medium text-white hover:bg-white/10 transition-colors">
            <i class="bi bi-images text-base" aria-hidden="true"></i>
            Фото корпусов
          </a>
        </div>
      </div>
    </section>
  </Fragment>

  <!-- FEATURES -->
  <section class="mx-auto max-w-[1312px] px-4 py-12 md:py-16">
    <div class="flex items-center gap-2 mb-2">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[26px] font-extrabold tracking-[-0.02em] text-body">Где живём</h2>
    </div>
    <p class="text-body-muted text-base mb-8 mt-1 max-w-[560px]">Санаторий «Изумруд» выбран именно за инфраструктуру: дети живут в комфорте, а не выживают в полевых условиях.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map(f => (
        <div class="rounded-[16px] bg-white border border-[#e8eef4] p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
            <i class={`bi ${f.icon} text-[18px] text-primary`} aria-hidden="true"></i>
          </div>
          <h3 class="text-base font-bold text-body mb-1">{f.title}</h3>
          <p class="text-base text-body-muted leading-[1.55]">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PHOTO GALLERY — раскладка «1 большое + 2×2» как на /foto/ -->
  <section id="gallery-rooms" class="mx-auto max-w-[1312px] px-[2px] pb-10 md:px-4 md:pb-14">
    <div class="p-[18px]">
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2">
          <div class="list-accent-dot"></div>
          <h2 class="text-[24px] font-bold leading-[1.1] tracking-[-0.02em] text-body md:text-[30px]">
            Фото корпусов и комнат
          </h2>
        </div>
        <a href="/foto/"
          class="group inline-flex items-center gap-1.5 text-base font-semibold text-primary hover:text-primary-hover">
          Все фото лагеря
          <i class="bi bi-arrow-right icon-arrow-right-hover" aria-hidden="true"></i>
        </a>
      </div>

      {(() => {
        // Дефолтные фото корпусов (показываются пока нет загруженных)
        const defaults = [
          { src: '/images/gallery/territory-korpus.avif', alt: 'Корпус лагеря АйДаКемп — санаторий Изумруд' },
          { src: '/images/gallery/stay-room-01.avif',     alt: 'Жилая комната в лагере АйДаКемп' },
          { src: '/images/gallery/stay-bathroom-01.avif', alt: 'Санузел в корпусе лагеря АйДаКемп' },
          { src: '/images/gallery/stay-lounge-01.avif',   alt: 'Общий холл в корпусе лагеря АйДаКемп' },
          { src: '/images/gallery/territory-alley.avif',  alt: 'Территория лагеря АйДаКемп — аллея' },
        ];
        const allPhotos = roomPhotos.length > 0
          ? roomPhotos
          : defaults;
        const photos = allPhotos.slice(0, 5);
        const [big, ...smalls] = photos;
        return (
          <>
            {/* Desktop: большое слева + 2×2 справа */}
            <div class="hidden md:flex gap-3 h-[440px]">
              {/* Большое фото */}
              <button type="button"
                data-lightbox-src={big.src} data-lightbox-alt={big.alt}
                class="group relative w-[45%] shrink-0 overflow-hidden rounded-[18px] bg-slate-100 cursor-zoom-in">
                <picture>
                  <source srcset={big.src} type="image/avif" />
                  <img src={jpgSrc(big.src)} alt={big.alt}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="eager" />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                <span class="absolute left-3 top-3 rounded-md bg-white/90 px-2.5 py-1 text-base font-bold tracking-wide text-body backdrop-blur-sm">#АЙДАКЕМП</span>
                <span class="absolute bottom-3 right-3 rounded-md bg-black/70 px-2.5 py-1 text-base font-semibold uppercase tracking-wide text-white backdrop-blur-sm">РАЗМЕЩЕНИЕ</span>
              </button>
              {/* Сетка 2×2 */}
              <div class="grid flex-1 grid-cols-2 gap-3">
                {smalls.map((p, i) => (
                  <button type="button"
                    data-lightbox-src={p.src} data-lightbox-alt={p.alt}
                    class="group relative overflow-hidden rounded-[18px] bg-slate-100 cursor-zoom-in">
                    <picture>
                      <source srcset={p.src} type="image/avif" />
                      <img src={jpgSrc(p.src)} alt={p.alt}
                        class="aspect-square w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy" />
                    </picture>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                    <span class="absolute left-3 top-3 rounded-md bg-white/90 px-2 py-0.5 text-[10px] font-bold tracking-wide text-body backdrop-blur-sm">#АЙДАКЕМП</span>
                    <span class="absolute bottom-2 right-2 rounded-md bg-black/70 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white backdrop-blur-sm">РАЗМЕЩЕНИЕ</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Mobile: 2-col grid, первое фото на всю ширину */}
            <div class="grid grid-cols-2 gap-2 md:hidden">
              {photos.slice(0, 5).map((p, i) => (
                <button type="button"
                  data-lightbox-src={p.src} data-lightbox-alt={p.alt}
                  class={`group relative overflow-hidden rounded-[12px] bg-slate-100 cursor-zoom-in ${i === 0 ? 'col-span-2' : ''}`}>
                  <picture>
                    <source srcset={p.src} type="image/avif" />
                    <img src={jpgSrc(p.src)} alt={p.alt}
                      class={`w-full object-cover transition-transform duration-300 group-hover:scale-105 ${i === 0 ? 'aspect-[2/1]' : 'aspect-square'}`}
                      loading={i === 0 ? 'eager' : 'lazy'} />
                  </picture>
                  <span class="absolute left-2 top-2 rounded-md bg-white/90 px-2 py-0.5 text-[10px] font-bold tracking-wide text-body backdrop-blur-sm">#АЙДАКЕМП</span>
                </button>
              ))}
            </div>

            {/* Горизонтальная полоса — клиентская подгрузка через /api/gallery-photos */}
            <div class="relative mt-3 hidden" id="room-strip-wrap">
              {/* Стрелки (desktop) */}
              <button id="strip-prev" type="button" aria-label="Назад"
                class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 h-9 w-9 items-center justify-center rounded-full bg-white shadow-md border border-slate-200 text-slate-600 hover:text-primary transition-colors">
                <i class="bi bi-chevron-left text-base" aria-hidden="true"></i>
              </button>
              <button id="strip-next" type="button" aria-label="Вперёд"
                class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 h-9 w-9 items-center justify-center rounded-full bg-white shadow-md border border-slate-200 text-slate-600 hover:text-primary transition-colors">
                <i class="bi bi-chevron-right text-base" aria-hidden="true"></i>
              </button>
              {/* Полоса — заполняется JS */}
              <div id="room-strip"
                class="flex gap-2.5 overflow-x-auto scroll-smooth pb-2"
                style="scrollbar-width:none;-ms-overflow-style:none">
              </div>
            </div>
          </>
        );
      })()}
    </div>
  </section>

  <!-- САНАТОРИЙ ИЗУМРУД -->
  <section class="bg-[#f0f6ff] py-12 md:py-16">
    <div class="mx-auto max-w-[1312px] px-4">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="list-accent-dot"></div>
            <h2 class="text-[20px] md:text-[26px] font-extrabold tracking-[-0.02em] text-body">Санаторий «Изумруд»</h2>
          </div>
          <p class="text-base text-body-muted leading-[1.65] mb-4">
            Лагерь АйДаКемп базируется в Наро-Фоминском районе Подмосковья — 66 км от МКАД. Капитальные корпуса, бассейн, спортивные поля, столовая и медпункт.
          </p>
          <p class="text-base text-body-muted leading-[1.65] mb-6">
            Санаторий работает круглый год — инфраструктура всегда в отличном состоянии. Полный доступ ко всем объектам в течение смены.
          </p>
          <div class="flex flex-wrap gap-4">
            <div class="flex items-center gap-2 text-base font-medium text-body">
              <i class="bi bi-geo-alt-fill text-primary text-[16px]" aria-hidden="true"></i>
              66 км от МКАД, Наро-Фоминский р-н
            </div>
            <div class="flex items-center gap-2 text-base font-medium text-body">
              <i class="bi bi-building text-primary text-[16px]" aria-hidden="true"></i>
              Капитальные корпуса
            </div>
          </div>
        </div>
        <div class="rounded-[16px] overflow-hidden shadow-lg aspect-[4/3]">
          <picture>
            <source srcset="/images/gallery/territory-korpus.avif" type="image/avif" />
            <img
              src="/images/gallery/jpg/territory-korpus.jpg"
              alt="Жилой корпус санатория Изумруд"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-[1312px] px-4 py-12 md:py-16">
    <div class="flex items-center gap-2 mb-7">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[26px] font-extrabold tracking-[-0.02em] text-body">Вопросы о проживании</h2>
    </div>
    <div class="max-w-[720px] space-y-3">
      {faqs.map(item => (
        <details class="group rounded-[14px] border border-[#e2e8f0] bg-white overflow-hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-4 font-semibold text-base text-body list-none select-none hover:bg-[#fafbfc] transition-colors">
            {item.q}
            <i class="bi bi-chevron-down text-[12px] text-body-muted shrink-0 transition-transform group-open:rotate-180" aria-hidden="true"></i>
          </summary>
          <div class="px-5 pb-5 pt-1 text-base text-body-muted leading-[1.65]">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- RELATED ARTICLES -->
  <RelatedArticles title="Читать по теме" articles={articles} />

  <!-- RELATED PAGES -->
  <RelatedPages title="Всё о лагере" pages={relatedPages} />

  <!-- CTA -->
  <section class="bg-[#0d1a2b] py-14">
    <div class="mx-auto max-w-[1312px] px-4 text-center">
      <h2 class="text-[28px] md:text-[36px] font-extrabold text-white mb-3 tracking-[-0.02em]">Записать ребёнка в лагерь</h2>
      <p class="text-white/70 text-[16px] mb-8 max-w-[480px] mx-auto">Смены на лето 2026. Питание, проживание, IT-программа — всё включено.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/#shifts" class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 text-[16px] font-bold text-white hover:bg-[#d68830] transition-colors">
          Выбрать смену
          <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
        </a>
        <a href="/ceny/" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-8 py-3.5 text-[16px] font-medium text-white hover:bg-white/10 transition-colors">
          Посмотреть цены
        </a>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-[200] hidden items-center justify-center p-4" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white/70 hover:text-white z-10" aria-label="Закрыть">
      <i class="bi bi-x-lg text-[24px]" aria-hidden="true"></i>
    </button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10 hidden md:block" aria-label="Назад">
      <i class="bi bi-chevron-left text-[32px]" aria-hidden="true"></i>
    </button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-10 hidden md:block" aria-label="Вперёд">
      <i class="bi bi-chevron-right text-[32px]" aria-hidden="true"></i>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-[12px] object-contain" />
  </div>
</LandingLayout>

<script>
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbClose = document.getElementById('lightbox-close')!;
  const lbPrev = document.getElementById('lightbox-prev')!;
  const lbNext = document.getElementById('lightbox-next')!;
  let current = 0;
  let gallery: HTMLElement[] = [];

  function visibleItems() {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-src]'))
      .filter(el => el.offsetParent !== null);
  }

  function open(idx: number) {
    gallery = visibleItems();
    current = Math.max(0, Math.min(idx, gallery.length - 1));
    lbImg.src = gallery[current].dataset.lightboxSrc!;
    lbImg.alt = gallery[current].dataset.lightboxAlt || '';
    lb.classList.remove('hidden'); lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lb.classList.add('hidden'); lb.classList.remove('flex');
    document.body.style.overflow = ''; lbImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-lightbox-src]');
    if (!el) return;
    const items = visibleItems();
    const idx = items.indexOf(el);
    if (idx !== -1) open(idx);
  });
  lbClose.addEventListener('click', close);
  lb.addEventListener('click', e => { if (e.target === lb) close(); });
  lbPrev.addEventListener('click', e => { e.stopPropagation(); open((current - 1 + gallery.length) % gallery.length); });
  lbNext.addEventListener('click', e => { e.stopPropagation(); open((current + 1) % gallery.length); });
  document.addEventListener('keydown', e => {
    if (lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') open((current - 1 + gallery.length) % gallery.length);
    if (e.key === 'ArrowRight') open((current + 1) % gallery.length);
  });

  // Горизонтальная полоса — клиентская подгрузка
  (async () => {
    const wrap  = document.getElementById('room-strip-wrap') as HTMLElement | null;
    const strip = document.getElementById('room-strip') as HTMLElement | null;
    if (!wrap || !strip) return;
    try {
      const res   = await fetch('/api/gallery-photos?section=rooms');
      const photos: { src: string; alt: string }[] = await res.json();
      if (!Array.isArray(photos) || photos.length <= 5) return;
      for (const p of photos) {
        const jpgSrc = p.src.replace('/images/gallery/', '/images/gallery/jpg/').replace('.avif', '.jpg');
        const a = document.createElement('button');
        a.type = 'button';
        a.dataset.lightboxSrc = p.src;
        a.dataset.lightboxAlt = p.alt;
        a.className = 'group relative shrink-0 w-[140px] h-[140px] md:w-[160px] md:h-[160px] overflow-hidden rounded-[14px] bg-slate-100 cursor-zoom-in';
        a.innerHTML = `
          <picture>
            <source srcset="${p.src}" type="image/avif">
            <img src="${jpgSrc}" alt="${p.alt}" loading="lazy"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
          </picture>`;
        strip.appendChild(a);
      }
      wrap.classList.remove('hidden');
    } catch {}
  })();

  // Стрелки полосы
  const strip = document.getElementById('room-strip') as HTMLElement | null;
  document.getElementById('strip-prev')?.addEventListener('click', () => {
    strip?.scrollBy({ left: -340, behavior: 'smooth' });
  });
  document.getElementById('strip-next')?.addEventListener('click', () => {
    strip?.scrollBy({ left: 340, behavior: 'smooth' });
  });
</script>
