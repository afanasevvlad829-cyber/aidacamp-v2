---
// PROTOTYPE: News Jazz в Hero
// URL: /prototype/news-jazz  —  главная не тронута
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>[ПРОТОТИП] News Jazz — АйДаКемп</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/styles/icons.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #050912; color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    /* ── БАННЕР ── */
    .proto-banner {
      position: sticky; top: 0; z-index: 100;
      background: #f59e0b; color: #000;
      text-align: center; font-size: 13px; font-weight: 700;
      padding: 6px 16px;
    }
    .proto-banner a { color: #000; opacity: 0.6; margin-left: 16px; font-size: 12px; }

    /* ── DESKTOP HERO ── */
    .hero-desktop {
      position: relative; height: 640px;
      overflow: hidden; background: #0f1c2e;
      display: none;
    }
    @media (min-width: 768px) { .hero-desktop { display: block; } }

    .hero-desktop img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; object-position: center 20%;
      animation: kenburns 18s ease-in-out infinite;
    }
    .hero-desktop .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(90deg,
        rgba(5,9,18,0.88) 0%, rgba(5,9,18,0.78) 22%,
        rgba(5,9,18,0.50) 42%, rgba(5,9,18,0.18) 62%,
        rgba(5,9,18,0.04) 82%, rgba(5,9,18,0.00) 100%);
    }
    .hero-desktop .overlay2 {
      position: absolute; inset: 0;
      background: linear-gradient(180deg,rgba(6,10,18,0) 52%,rgba(6,10,18,0.42) 100%);
    }
    .hero-desktop .text-block {
      position: absolute; left: 64px; top: 100px;
      z-index: 10; max-width: 620px;
    }

    /* ── MOBILE HERO ── */
    .hero-mobile {
      position: relative; overflow: hidden;
      background: #0d1a2b; min-height: 95svh;
      display: flex; flex-direction: column;
    }
    @media (min-width: 768px) { .hero-mobile { display: none; } }

    .hero-mobile img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; object-position: center 30%;
      filter: saturate(0.92) brightness(0.95);
    }
    .hero-mobile .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg,
        rgba(6,10,18,0.35)  0%,   rgba(6,10,18,0.10)  8%,
        transparent         18%,  transparent         35%,
        rgba(13,26,43,0.25) 45%,  rgba(13,26,43,0.55) 52%,
        rgba(13,26,43,0.65) 60%,  rgba(13,26,43,0.80) 72%,
        rgba(13,26,43,0.90) 85%,  rgba(13,26,43,0.93) 100%);
    }
    .hero-mobile .content {
      position: relative; z-index: 10;
      display: flex; flex-direction: column; min-height: 95svh;
    }
    .hero-mobile .h1-label {
      padding: 80px 20px 0;
      font-size: 12px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: rgba(255,255,255,0.95);
      text-shadow: 0 2px 6px rgba(0,0,0,0.95);
    }
    .hero-mobile .spacer { flex: 1; min-height: 40vh; }
    .hero-mobile .bottom { padding: 0 20px 32px; }

    /* ── ТИПОГРАФИКА (единая) ── */
    .hero-call {
      font-size: clamp(40px, 5vw, 60px);
      font-weight: 800; line-height: 1.02;
      letter-spacing: -0.03em; color: #fff;
      text-shadow: 0 4px 14px rgba(0,0,0,0.6);
      margin-top: 20px;
    }
    .hero-mobile .hero-call {
      font-size: clamp(32px, 9vw, 44px);
      text-shadow: 0 2px 8px rgba(0,0,0,0.85);
      margin-top: 0; margin-bottom: 12px;
    }
    .hero-sub {
      margin-top: 12px; font-size: 17px; line-height: 1.5;
      color: rgba(255,255,255,0.9);
      text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    }
    .hero-mobile .hero-sub {
      font-size: 15px; margin-top: 0; margin-bottom: 20px;
      text-shadow: 0 1px 3px rgba(0,0,0,0.85);
    }

    /* ── NEWS JAZZ CARD ── */
    .nj-card {
      display: inline-flex; align-items: stretch;
      background: rgba(255,255,255,0.07);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: none;
      border-radius: 14px;
      overflow: hidden;
      margin-top: 24px;
      min-width: 280px; max-width: 400px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .nj-card:hover {
      background: rgba(255,255,255,0.11);
    }
    .nj-card-mobile {
      display: flex; align-items: stretch;
      background: rgba(255,255,255,0.07);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: none;
      border-radius: 14px;
      overflow: hidden;
      width: 100%;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .nj-card-mobile:hover {
      background: rgba(255,255,255,0.11);
    }

    .nj-stripe { width: 3px; background: #ec9b44; flex-shrink: 0; }

    .nj-body { padding: 10px 14px; flex: 1; min-width: 0; }

    .nj-label {
      display: flex; align-items: center; gap: 6px;
      margin-bottom: 5px;
    }
    .nj-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #ec9b44; flex-shrink: 0;
    }
    @media (prefers-reduced-motion: no-preference) {
      .nj-dot { animation: nj-pulse 1.6s ease-in-out infinite; }
    }
    .nj-label-text {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.2px; color: #ec9b44;
      text-transform: uppercase;
    }

    /* перевод (RU headline) */
    .nj-text {
      font-size: 14px; font-weight: 600;
      color: rgba(255,255,255,0.92);
      line-height: 1.4; margin-bottom: 4px;
      transition: opacity 0.35s;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    /* оригинал EN мелко */
    .nj-orig {
      font-size: 11px; color: rgba(255,255,255,0.35);
      line-height: 1.3; margin-bottom: 4px;
      transition: opacity 0.35s;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .nj-footer {
      display: flex; align-items: center;
      justify-content: space-between; gap: 8px;
    }
    .nj-time {
      font-size: 11px; color: rgba(255,255,255,0.30);
      transition: opacity 0.35s; flex-shrink: 0;
    }
    .nj-source {
      font-size: 11px; color: rgba(255,255,255,0.25);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      transition: opacity 0.35s;
    }
    /* стрелка-иконка */
    .nj-arrow {
      flex-shrink: 0; display: flex; align-items: center;
      padding: 10px 12px 10px 2px;
      color: rgba(255,255,255,0.20);
      transition: color 0.2s;
    }
    .nj-card:hover .nj-arrow,
    .nj-card-mobile:hover .nj-arrow { color: #ec9b44; }

    /* ── МОДАЛКА ── */
    .nj-modal-backdrop {
      display: none;
      position: fixed; inset: 0; z-index: 200;
      background: rgba(5,9,18,0.80);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      align-items: center; justify-content: center;
      padding: 20px;
    }
    .nj-modal-backdrop.open { display: flex; }
    .nj-modal {
      background: #111d2e;
      border-radius: 20px;
      padding: 28px;
      max-width: 480px; width: 100%;
      position: relative;
      animation: modal-in 0.25s ease-out;
    }
    @keyframes modal-in {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    .nj-modal-close {
      position: absolute; top: 16px; right: 16px;
      background: rgba(255,255,255,0.08);
      border: none; border-radius: 50%;
      width: 32px; height: 32px;
      color: rgba(255,255,255,0.6);
      font-size: 16px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }
    .nj-modal-close:hover { background: rgba(255,255,255,0.15); }
    .nj-modal-tag {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.2px; color: #ec9b44;
      text-transform: uppercase; margin-bottom: 10px;
      display: flex; align-items: center; gap: 6px;
    }
    .nj-modal-title {
      font-size: 20px; font-weight: 700;
      color: #fff; line-height: 1.3; margin-bottom: 6px;
    }
    .nj-modal-orig {
      font-size: 12px; color: rgba(255,255,255,0.35);
      margin-bottom: 16px; line-height: 1.4;
    }
    .nj-modal-summary {
      font-size: 15px; line-height: 1.65;
      color: rgba(255,255,255,0.8);
      margin-bottom: 20px;
    }
    .nj-modal-footer {
      display: flex; align-items: center;
      justify-content: space-between; gap: 12px;
      flex-wrap: wrap;
    }
    .nj-modal-meta { font-size: 12px; color: rgba(255,255,255,0.3); }
    .nj-modal-link {
      display: inline-flex; align-items: center; gap: 6px;
      background: #ec9b44; color: #0d1a2b;
      font-size: 13px; font-weight: 700;
      padding: 9px 18px; border-radius: 20px;
      text-decoration: none;
      transition: opacity 0.15s;
    }
    .nj-modal-link:hover { opacity: 0.88; }

    /* ── АНИМАЦИИ ── */
    @keyframes kenburns {
      0%   { transform: scale(1.04) translate(0%, 0%); }
      50%  { transform: scale(1.08) translate(-1%, -0.5%); }
      100% { transform: scale(1.04) translate(0%, 0%); }
    }
    @keyframes nj-pulse {
      0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
    }

    .text-primary { color: #ec9b44; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  </style>
</head>
<body>

  <div class="proto-banner">
    ⚠️ ПРОТОТИП — /prototype/news-jazz — главная не тронута
    <a href="/">← Главная</a>
  </div>

  <!-- ══ DESKTOP ══ -->
  <section class="hero-desktop">
    <img src="/images/hero-desktop.webp" alt="" aria-hidden="true" loading="eager" width="1440" height="640" />
    <div class="overlay"></div>
    <div class="overlay2"></div>

    <div class="text-block">
      <h1 class="sr-only">Детский IT-лагерь в Подмосковье 2026</h1>
      <p class="hero-call">
        Пока другие на&nbsp;даче —<br>ваш сделает <span class="text-primary">AI-проект</span> или <span class="text-primary">игру</span>
      </p>
      <p class="hero-sub">Вам — <strong style="color:#fff">14 дней для себя</strong>.</p>

      <!-- News Jazz desktop -->
      <a id="nj-link-d" href="#" target="_blank" rel="noopener" class="nj-card" aria-label="Читать новость">
        <div class="nj-stripe"></div>
        <div class="nj-body">
          <div class="nj-label">
            <div class="nj-dot" aria-hidden="true"></div>
            <span class="nj-label-text">AI News</span>
          </div>
          <div id="nj-text-d" class="nj-text" aria-live="polite"></div>
          <div id="nj-orig-d" class="nj-orig"></div>
          <div class="nj-footer">
            <span id="nj-source-d" class="nj-source"></span>
            <span id="nj-time-d" class="nj-time"></span>
          </div>
        </div>
        <div class="nj-arrow" aria-hidden="true">
          <i class="bi bi-arrow-up-right" style="font-size:14px"></i>
        </div>
      </a>
    </div>
  </section>

  <!-- ══ MOBILE ══ -->
  <section class="hero-mobile">
    <img src="/images/hero-mobile-bean-v3.webp" alt="Дети на занятии в IT-лагере АйДаКемп" loading="eager" width="390" height="800" />
    <div class="overlay"></div>
    <div class="content">
      <p class="h1-label">Детский IT-лагерь в Подмосковье 2026</p>
      <div class="spacer"></div>
      <div class="bottom">
        <p class="hero-call">
          Пока другие<br>на&nbsp;даче — ваш<br>сделает <span class="text-primary">AI-проект</span> или <span class="text-primary">игру</span>
        </p>
        <p class="hero-sub">Вам — <strong style="color:#fff">14 дней для себя</strong>.</p>

        <!-- News Jazz mobile -->
        <a id="nj-link-m" href="#" target="_blank" rel="noopener" class="nj-card-mobile" aria-label="Читать новость">
          <div class="nj-stripe"></div>
          <div class="nj-body">
            <div class="nj-label">
              <div class="nj-dot" aria-hidden="true"></div>
              <span class="nj-label-text">AI News</span>
            </div>
            <div id="nj-text-m" class="nj-text" aria-live="polite"></div>
            <div id="nj-orig-m" class="nj-orig"></div>
            <div class="nj-footer">
              <span id="nj-source-m" class="nj-source"></span>
              <span id="nj-time-m" class="nj-time"></span>
            </div>
          </div>
          <div class="nj-arrow" aria-hidden="true">
            <i class="bi bi-arrow-up-right" style="font-size:14px"></i>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Модалка новости -->
  <div id="nj-modal-backdrop" class="nj-modal-backdrop" role="dialog" aria-modal="true">
    <div class="nj-modal">
      <button class="nj-modal-close" id="nj-modal-close" aria-label="Закрыть">✕</button>
      <div class="nj-modal-tag">
        <span style="width:6px;height:6px;border-radius:50%;background:#ec9b44;display:inline-block"></span>
        AI News · TechCrunch
      </div>
      <div id="nj-modal-title" class="nj-modal-title"></div>
      <div id="nj-modal-orig" class="nj-modal-orig"></div>
      <div id="nj-modal-summary" class="nj-modal-summary"></div>
      <div class="nj-modal-footer">
        <span id="nj-modal-meta" class="nj-modal-meta"></span>
        <a id="nj-modal-link" href="#" target="_blank" rel="noopener" class="nj-modal-link">
          Читать на TechCrunch →
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
  (function () {
    // Структура: text=перевод на RU, orig=оригинал EN, source=домен, time=время, url=ссылка
    var news = [
      {
        text:   'Anthropic привлёк $2 млрд от Amazon',
        orig:   'Anthropic raises $2B from Amazon',
        source: 'techcrunch.com',
        time:   '2 часа назад',
        url:    'https://techcrunch.com'
      },
      {
        text:   'OpenAI запустил o4-mini — в 3 раза дешевле o3',
        orig:   'OpenAI launches o4-mini, 3x cheaper than o3',
        source: 'openai.com',
        time:   '5 часов назад',
        url:    'https://openai.com/blog'
      },
      {
        text:   'Midjourney v7: персонажи теперь не «плывут»',
        orig:   'Midjourney v7 launched with consistent character',
        source: 'midjourney.com',
        time:   '8 часов назад',
        url:    'https://midjourney.com'
      },
      {
        text:   'Google Gemini 2.0 Flash вышел в общий доступ',
        orig:   'Google Gemini 2.0 Flash now publicly available',
        source: 'blog.google',
        time:   '12 часов назад',
        url:    'https://blog.google'
      },
      {
        text:   'Llama 4 Scout обошёл GPT-4o на MMLU',
        orig:   'Meta Llama 4 Scout beats GPT-4o on MMLU benchmark',
        source: 'ai.meta.com',
        time:   'вчера',
        url:    'https://ai.meta.com'
      },
    ];

    var idx = 0;

    function setItem(suffix, item) {
      var textEl   = document.getElementById('nj-text-'   + suffix);
      var origEl   = document.getElementById('nj-orig-'   + suffix);
      var sourceEl = document.getElementById('nj-source-' + suffix);
      var timeEl   = document.getElementById('nj-time-'   + suffix);
      var linkEl   = document.getElementById('nj-link-'   + suffix);
      if (!textEl) return;
      [textEl, origEl, sourceEl, timeEl].forEach(function(el) {
        if (el) el.style.opacity = '0';
      });
      setTimeout(function () {
        if (textEl)   textEl.textContent   = item.text;
        if (origEl)   origEl.textContent   = item.orig;
        if (sourceEl) sourceEl.textContent = item.source;
        if (timeEl)   timeEl.textContent   = item.time;
        if (linkEl)   linkEl.href          = item.url;
        [textEl, origEl, sourceEl, timeEl].forEach(function(el) {
          if (el) el.style.opacity = '1';
        });
      }, 360);
    }

    function tick() {
      if (!news.length) return;
      setItem('d', news[idx % news.length]);
      setItem('m', news[idx % news.length]);
      idx = (idx + 1) % news.length;
    }

    function start() { tick(); setInterval(tick, 8000); }

    // Модалка
    function openModal(item) {
      document.getElementById('nj-modal-title').textContent   = item.text;
      document.getElementById('nj-modal-orig').textContent    = item.orig;
      document.getElementById('nj-modal-summary').textContent = item.summary || '';
      document.getElementById('nj-modal-meta').textContent    = item.source + ' · ' + item.time;
      document.getElementById('nj-modal-link').href           = item.url;
      document.getElementById('nj-modal-backdrop').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      document.getElementById('nj-modal-backdrop').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.getElementById('nj-modal-close').addEventListener('click', closeModal);
    document.getElementById('nj-modal-backdrop').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });

    // Клик по карточке — открывает модалку
    ['nj-link-d', 'nj-link-m'].forEach(function(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('click', function(e) {
        e.preventDefault();
        if (!news.length) return;
        openModal(news[(idx - 1 + news.length) % news.length]);
      });
    });

    // Загружаем реальные новости
    fetch('/data/news-jazz.json')
      .then(function(r) { return r.json(); })
      .then(function(data) { news = data.items || []; start(); })
      .catch(function() { start(); });
  })();
  </script>

</body>
</html>
