  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Shifts slim />

  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))} only={['documents', 'payment', 'communication']} />
