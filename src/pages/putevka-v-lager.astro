---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, mainShifts, getAvailabilityLevel } from '../data/shifts';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';

// Единый источник наличия мест — getAvailabilityLevel() из shifts.ts, не хардкодим free напрямую в текст.
function shiftAvailabilityFragment(shiftId: string): string {
  const s = mainShifts.find(s => s.id === shiftId);
  if (!s) return '';
  return getAvailabilityLevel(s) === 'soldout'
    ? `${s.name} (мест нет, доступен лист ожидания)`
    : `${s.name} (осталось ${s.free} мест)`;
}
const shift3Availability = shiftAvailabilityFragment('shift-3');
const shift4Availability = shiftAvailabilityFragment('shift-4');
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что входит в стоимость",
    text: "Всё включено в стоимость АйДаКемп — без скрытых доплат. Цена фиксируется сразу: что написано, то и платите.",
    list: [
      "Проживание в корпусе (двух- или трёхместные комнаты)",
      "5-разовое питание: завтрак, обед, полдник, ужин, второй ужин",
      "IT-программа: Python, AI, Minecraft, 3D или Roblox Studio — мини-группы до 8 школьников",
      "Бассейн с ионизированной водой, спортивные площадки ежедневно",
      "Хакатон в финале смены — командная защита проекта",
      "Медработник на территории 24/7, охрана"
    ]
  },
  {
    h2: "Как оформить — 3 шага",
    text: "Оформить получится за 10 минут — без очередей и лишних бумаг. Всё онлайн или по телефону.",
    list: [
      "Шаг 1: выбрать даты и длительность смены",
      "Шаг 2: оплатить 50% онлайн или по реквизитам — место за ребёнком",
      "Шаг 3: получить договор и список вещей на почту"
    ]
  },
  {
    h2: `Цены на сезон ${SEASON_YEAR}`,
    text: "Заезды идут с 30 мая по конец августа — это летний IT-проект целиком: 10 или 13 дней полного погружения, без скрытых доплат.",
    list: [
      `10 дней — от ${PRICE_S4}`,
      `13 дней — от ${PRICE_MAX}`,
      "Оплата частями без переплаты",
      `Налоговый вычет 13% — возврат до ${VYCHET_MAX} с покупки`
    ]
  },
  {
    h2: "Документы, лицензия, оплата",
    text: "АйДаКемп работает официально: лицензия Минобрнауки на образовательную деятельность, регистрация в реестре туроператоров РТО. Для заезда нужны медицинские справки на ребёнка — часть можно взять заранее в поликлинике.",
    list: [
      "Официальный договор с датами и полным описанием услуг АйДаКемп",
      "Справка 086/у или 079/у, копия полиса ОМС",
      "Предоплата 50% при бронировании, остаток — за 14 дней до заезда",
      "Оплата картой, по СБП или по реквизитам ООО для корпоративной оплаты"
    ]
  },
  {
    h2: "Налоговый вычет с покупки",
    text: `С образовательной покупки государство возвращает 13% НДФЛ. Смена за ${PRICE_MIN} — вернёте до 6 240 ₽. Нужен только наш договор и чек — выдаём автоматически.`,
    list: [
      "Максимальная база — 120 000 ₽ в год на образование ребёнка",
      "Оформляется через личный кабинет налоговой за 15 минут"
    ]
  },
  {
    h2: "Условия возврата",
    text: "Планы меняются — условия возврата прозрачные и прописаны в договоре.",
    list: [
      "До 30 дней до заезда — возврат 100% (за вычетом комиссии банка)",
      "14–30 дней до заезда — возврат 80%",
      "7–14 дней до заезда — возврат 50%",
      "При болезни ребёнка — справка от врача, возврат 80%"
    ]
  },
  {
    h2: "Свободные места этим летом",
    text: `Июль занят полностью. На август открыты ${shift3Availability} и ${shift4Availability} — время ещё есть, чтобы взять место. Оставьте заявку — менеджер ответит за 10 минут и скажет точное наличие.`
  },
  {
    h2: "Детский отдых, Московская область — на что обращать внимание",
    text: `Перед тем как выбрать летний отдых, проверьте лицензию Минобрнауки, медицинское сопровождение и статус туроператора — без него договор и страховку на ребёнка не оформят. АйДаКемп, Московская область — оздоровительный IT-центр под Клином: Москва в часе езды, а вокруг лес и тишина. Лицензия ${STAT_LICENSE}, туроператор РТО ${STAT_RTO}, регион — Московская область.`,
  },
];

const faqItems = [
  {
    question: "Что входит в стоимость детского отдыха?",
    answer: "Смена подходит ребятам 8–17 лет, группы формируются с учётом возраста. Входит: проживание в корпусе, 5-разовое питание, IT-программа в мини-группах до 8 человек, бассейн, спортивные и вечерние активности, охрана территории и медработник."
  },
  {
    question: "Где записаться в АйДаКемп?",
    answer: "Через заявку на aidacamp.ru или по телефону — за 10 минут, без личного визита в офис."
  },
  {
    question: "Как оформить возврат?",
    answer: "До 30 дней до заезда — возврат 100%. За 14–30 дней — 80%. За 7–14 дней — 50%. При болезни ребёнка со справкой от врача — 80% в любой срок. Все условия прописаны в договоре."
  },
  {
    question: "Как оформить налоговый вычет за смену?",
    answer: `Мы работаем по образовательной лицензии Минобрнауки. Выдаём договор и чек, по которым можно оформить вычет 13% в личном кабинете налоговой. С покупки за ${PRICE_MIN} вернёте до 6 240 ₽.`
  },
  {
    question: "Можно ли оплатить в рассрочку?",
    answer: "Да. При бронировании — 50% стоимости. Остаток — за 3 недели до заезда. Никаких процентов и переплат. Оплата картой, по счёту или наличными."
  },
  {
    question: "Как записаться в АйДаКемп на детский отдых?",
    answer: "Оформить всё просто: выбрать даты на aidacamp.ru, нажать «Записаться», заполнить форму. Менеджер свяжется в течение часа, пришлёт договор и реквизиты. Оплата онлайн или переводом. Налоговый вычет 13%."
  },
  {
    question: "Сколько стоят смены АйДаКемп?",
    answer: `Открыты к брони: ${PRICE_S4} (10 дней) и ${PRICE_MAX} (13 дней). Июньские заезды (7–14 дней) завершены. Всё включено. Налоговый вычет 13%. Регион — Московская область.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/putevka-lager.avif"
  title="Купить путёвки — детский отдых, Московская область: цена на сезон"
  description="Купить путёвки в АйДаКемп на сезон: детские смены, Москва рядом. Цена отдыха — спортивный и оздоровительный формат, IT-программа, бассейн, налоговый вычет 13%"
  h1="Детский отдых — Московская область"
  canonical="https://aidacamp.ru/putevka-v-lager"
>
  <LandingHero slot="hero"
    h1="Детский отдых — Московская область"
    subtitle="Всё включено: IT-проект, бассейн, спортивные активности, питание, проживание. Официальный договор, налоговый вычет 13%."
    breadcrumb="Стоимость и оформление"
    keywords={["Всё включено — проживание, питание, IT-программа, бассейн", "Лицензия Минобрнауки — вычет 13% с покупки", "Оплата частями: 50% сейчас, 50% за 3 недели", "Московская область, 66 км от МКАД — лес и тишина рядом с Москвой", "Регион — Московская область, трансфер от м. Солнцево"]}
    image="/images/hero/putevka-lager.avif"
    imageAlt="Детский отдых, Московская область"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Shifts />

  <FAQ extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))} only={['documents', 'payment', 'communication']} />
  <RelatedArticles articles={[
    { title: `Цены и смены ${SEASON_YEAR}`, url: "/ceny/", description: "Полное расписание смен и стоимость.", icon: "calendar-week" },
    { title: "Налоговый вычет 13%", url: "/nalogovyj-vychet/", description: "Как вернуть деньги за смену.", icon: "receipt" },
    { title: "Официальный детский отдых", url: "/detskiy-lager-oficialnyj/", description: "Лицензия, РТО, проверка документов.", icon: "patch-check-fill" },
    { title: "Загородный отдых", url: "/zagorodnyj-lager/", description: "Лес, бассейн, 66 км от МКАД.", icon: "tree" },
  ]} />
  <RelatedPages title="Похожие страницы" pages={getRelatedPages(Astro.url.pathname, 3)} />
</LandingLayout>
