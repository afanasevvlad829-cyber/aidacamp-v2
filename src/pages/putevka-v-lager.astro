---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что входит в путёвку",
    text: "Путёвка в АйДаКемп — это всё включено, без скрытых доплат. При бронировании цена фиксированная: что написано, то и платите. Никаких «дополнительно оплачивается» в конце смены.",
    list: [
      "Проживание в корпусе (двух- или трёхместные комнаты)",
      "5-разовое питание: завтрак, обед, полдник, ужин, второй ужин",
      "IT-программа: занятия в мини-группах до 8 человек",
      "Бассейн, спорт, вечерние активности",
      "Охрана территории 24/7, медработник",
      "Оборудование для занятий (ноутбуки, периферия)"
    ]
  },
  {
    h2: "Как оформить путёвку — 3 шага",
    text: "Оформление занимает 10 минут. Никаких очередей, живых очередей в офис, лишних бумаг. Всё онлайн или по телефону.",
    list: [
      "Шаг 1: выбрать смену — даты и длительность на странице цен",
      "Шаг 2: оплатить 50% онлайн или по реквизитам — место за ребёнком",
      "Шаг 3: получить договор и список вещей на почту",
      "За 3 недели до заезда — оплата оставшихся 50%",
      "Перед выездом — медицинская справка (форма 079/у)"
    ]
  },
  {
    h2: "Стоимость путёвок лето 2026",
    text: "Смены идут с 30 мая по конец августа. Выбирайте длительность — все смены с одинаковым составом услуг, цена пропорционально времени.",
    list: [
      "7 дней — от 48 000 ₽",
      "10 дней — от 60 000 ₽",
      "14 дней — от 78 000 ₽",
      "Оплата частями без переплаты",
      "Налоговый вычет 13% — возврат до 5 200 ₽ с путёвки"
    ]
  },
  {
    h2: "Официальный договор и документы",
    text: "АйДаКемп работает официально: лицензия Минобрнауки, регистрация в реестре туроператоров РТО, страховка. Это важно не только для спокойствия — без лицензии нельзя оформить налоговый вычет.",
    list: [
      "Лицензия на образовательную деятельность Минобрнауки",
      "Реестр туроператоров РТО — проверяется онлайн",
      "Официальный договор с датами, услугами и стоимостью",
      "Чек об оплате — подходит для вычета в налоговой",
      "Справка для вычета — выдаётся по запросу"
    ]
  },
  {
    h2: "Налоговый вычет с путёвки",
    text: "С образовательных путёвок государство возвращает 13% НДФЛ. Если путёвка стоит 60 000 ₽ — вернёте до 7 800 ₽. Для этого нужен наш договор и чек — мы их выдаём автоматически.",
    list: [
      "Вычет доступен если вы официально работаете и платите НДФЛ",
      "Максимальная база — 120 000 ₽ в год на образование детей",
      "Возврат до 15 600 ₽ в год (13% от 120 000 ₽)",
      "Оформляется через личный кабинет налоговой за 15 минут",
      "Мы выдаём все нужные документы — договор, чек, справку"
    ]
  },
  {
    h2: "Можно ли вернуть путёвку",
    text: "Мы понимаем: планы меняются. Условия возврата прозрачные и прописаны в договоре. Без сюрпризов.",
    list: [
      "До 30 дней до заезда — возврат 100% (за вычетом комиссии банка)",
      "14–30 дней до заезда — возврат 80% стоимости",
      "7–14 дней до заезда — возврат 50% стоимости",
      "Менее 7 дней — возврат по согласованию",
      "При болезни ребёнка — справка от врача, возврат 80%"
    ]
  }
];

const faqItems = [
  {
    question: "Что входит в путёвку в детский лагерь?",
    answer: "Проживание в корпусе, 5-разовое питание, IT-программа в мини-группах до 8 человек, бассейн, спортивные и вечерние активности, охрана территории и медработник. Оборудование для занятий (ноутбуки) наше — везти ничего не нужно."
  },
  {
    question: "Можно ли вернуть путёвку?",
    answer: "Да. До 30 дней до заезда — возврат 100%. За 14–30 дней — 80%. За 7–14 дней — 50%. При болезни ребёнка со справкой от врача — 80% в любой срок. Все условия прописаны в договоре."
  },
  {
    question: "Как оформить налоговый вычет с путёвки?",
    answer: "Мы официальный образовательный лагерь с лицензией Минобрнауки. Выдаём договор и чек, по которым можно оформить вычет 13% в личном кабинете налоговой. С путёвки 60 000 ₽ вернёте до 7 800 ₽."
  },
  {
    question: "Можно ли оплатить путёвку в рассрочку?",
    answer: "Да. При бронировании — 50% стоимости. Остаток — за 3 недели до заезда. Никаких процентов и переплат. Оплата картой, по счёту или наличными."
  }
];
---

<LandingLayout
  heroImage="/images/hero/putevka-lager.avif"
  title="Путёвка в детский лагерь 2026 в Подмосковье — от 48 000 ₽ | АйДаКемп"
  description="Купить путёвку в детский лагерь 2026 в Подмосковье. IT-программа + бассейн + проживание — всё включено. Лицензия Минобрнауки. Смены с 30 мая. Вычет 13%."
  h1="Купить путёвку в детский IT-лагерь 2026"
  canonical="https://aidacamp.ru/putevka-v-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Путёвка в детский IT-лагерь 2026"
    subtitle="Всё включено: IT-проект, бассейн, питание, проживание. Официальный договор, налоговый вычет 13%."
    breadcrumb="Путёвка в лагерь"
    keywords={["Всё включено — проживание, питание, IT-программа, бассейн", "Лицензия Минобрнауки — вычет 13% с путёвки", "Оплата частями: 50% сейчас, 50% за 3 недели"]}
    image="/images/hero/putevka-lager.avif"
    imageAlt="Путёвка в детский лагерь в Подмосковье 2026"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <section class="mx-auto max-w-[860px] px-4 py-10">
    <div class="flex items-center gap-2 mb-6">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Частые вопросы о путёвке в лагерь
      </h2>
    </div>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <details class="border border-slate-200 rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer list-none select-none hover:bg-slate-50 transition-colors">
            <span class="text-[15px] font-semibold text-slate-800 leading-[1.4]">{item.question}</span>
            <i class="bi bi-chevron-down text-slate-400 text-[14px] shrink-0 transition-transform group-open:rotate-180" aria-hidden="true"></i>
          </summary>
          <div class="px-5 pb-5 pt-1">
            <p class="text-[14px] leading-[1.7] text-slate-600">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Цены и смены 2026", url: "/ceny", description: "Полное расписание смен и стоимость.", icon: "calendar-week" },
    { title: "Налоговый вычет 13%", url: "/nalogovyj-vychet", description: "Как вернуть деньги с путёвки.", icon: "receipt" },
    { title: "Официальный детский лагерь", url: "/detskiy-lager-oficialnyj", description: "Лицензия, РТО, проверка документов.", icon: "patch-check-fill" },
    { title: "Загородный лагерь", url: "/zagorodnyj-lager", description: "Лес, бассейн, 66 км от МКАД.", icon: "tree" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
