---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, mainShifts, getAvailabilityLevel } from '../data/shifts';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';

// Единый источник наличия мест — getAvailabilityLevel() из shifts.ts, не хардкодим free напрямую в текст.
function shiftAvailabilityFragment(shiftId: string): string {
  const s = mainShifts.find(s => s.id === shiftId);
  if (!s) return '';
  return getAvailabilityLevel(s) === 'soldout'
    ? `${s.name} (мест нет, доступен лист ожидания)`
    : `${s.name} (осталось ${s.free} мест)`;
}
const shift3Availability = shiftAvailabilityFragment('shift-3');
const shift4Availability = shiftAvailabilityFragment('shift-4');
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что входит в путёвку",
    text: "Путёвка в АйДаКемп — это всё включено, без скрытых доплат. Цена фиксируется сразу: что написано, то и платите. Никаких «дополнительно оплачивается» в конце заезда.",
    list: [
      "Проживание в корпусе (двух- или трёхместные комнаты)",
      "5-разовое питание: завтрак, обед, полдник, ужин, второй ужин",
      "IT-программа: Python, AI, Minecraft, 3D или Roblox Studio — мини-группы до 8 детей",
      "Бассейн с ионизированной водой, спортивные площадки ежедневно",
      "Хакатон в финале смены — командная защита проекта",
      "Медработник на территории 24/7, охрана"
    ]
  },
  {
    h2: "Как взять путёвку — 3 шага",
    text: "Взять её можно за 10 минут. Никаких очередей, живых очередей в офис, лишних бумаг. Всё онлайн или по телефону.",
    list: [
      "Шаг 1: выбрать даты и длительность на странице смен",
      "Шаг 2: оплатить 50% онлайн или по реквизитам — место за ребёнком",
      "Шаг 3: получить договор и список вещей на почту",
      "За 3 недели до заезда — оплата оставшихся 50%",
      "Перед выездом — что взять с собой и медицинская справка (форма 079/у)"
    ]
  },
  {
    h2: `Цены на лето ${SEASON_YEAR}`,
    text: `Заезды идут с 30 мая по конец августа ${SEASON_YEAR}. Путёвка на летние каникулы — это лето целиком в IT-проекте: 10 или 13 дней полного погружения, без скрытых доплат. Выбирайте длительность — во всех программах одинаковый набор услуг, цена растёт пропорционально времени.`,
    list: [
      `10 дней — от ${PRICE_S4}`,
      `13 дней — от ${PRICE_MAX}`,
      "Оплата частями без переплаты",
      `Налоговый вычет 13% — возврат до ${VYCHET_MAX} с покупки`
    ]
  },
  {
    h2: "Официальный договор и документы",
    text: "АйДаКемп работает официально: лицензия Минобрнауки, регистрация в реестре туроператоров РТО. Это важно не только для спокойствия — без лицензии нельзя получить налоговый вычет.",
    list: [
      "Лицензия на образовательную деятельность Минобрнауки",
      "Реестр туроператоров РТО — проверяется онлайн",
      "Официальный договор с датами и полным описанием услуг лагеря",
      "Чек об оплате — подходит для вычета в налоговой",
      "Справка для вычета — выдаётся по запросу"
    ]
  },
  {
    h2: "Налоговый вычет с покупки",
    text: `С образовательной покупки государство возвращает 13% НДФЛ. Путёвка за ${PRICE_MIN} — вернёте до 6 240 ₽. Получить вычет просто: нужен наш договор и чек — мы их выдаём автоматически.`,
    list: [
      "Вычет доступен если вы официально работаете и платите НДФЛ",
      "Максимальная база — 120 000 ₽ в год на образование детей",
      "Возврат до 15 600 ₽ в год (13% от 120 000 ₽)",
      "Оформляется через личный кабинет налоговой за 15 минут",
      "Мы выдаём все нужные документы — договор, чек, справку"
    ]
  },
  {
    h2: "Можно ли вернуть путёвку",
    text: "Мы понимаем: планы меняются. Условия возврата прозрачные и прописаны в договоре, как и должно быть у честного лагеря. Без сюрпризов.",
    list: [
      "До 30 дней до заезда — возврат 100% (за вычетом комиссии банка)",
      "14–30 дней до заезда — возврат 80%",
      "7–14 дней до заезда — возврат 50%",
      "Менее 7 дней — возврат по согласованию",
      "При болезни ребёнка — справка от врача, возврат 80%"
    ]
  },
  {
    h2: "Документы для оформления путёвки",
    text: "Для заезда нужны медицинские документы на детей. Часть можно взять заранее в поликлинике — вот список:",
    list: [
      "От родителей: паспорт — для подписания договора",
      "Справка по форме 086/у (от педиатра или терапевта) — действует 6 месяцев от даты выдачи",
      "Форма 079/у (альтернатива 086/у) — уточните у педиатра, какую именно оформляет ваша поликлиника",
      "Копия полиса ОМС",
      "Страховой полис — оформляйте самостоятельно, чтобы быть прямым выгодоприобретателем"
    ]
  },
  {
    h2: "Рассрочка и оплата",
    text: "Всё официально — через ООО, с договором и кассовым чеком. Никаких переводов на личную карту.",
    list: [
      "Предоплата 50% при бронировании — место зафиксировано",
      "Остаток (50%) — за 14 дней до заезда",
      "Онлайн-эквайринг (Сбербанк / Т-Бизнес) или СБП по QR-коду — оплата картой без ввода реквизитов",
      "По реквизитам ООО — для корпоративной оплаты, доступны счёт-фактура и акт"
    ]
  },
  {
    h2: `Места на это лето ${SEASON_YEAR}`,
    text: `Июль занят полностью. На август открыты ${shift3Availability} и ${shift4Availability} — время ещё есть, чтобы взять место. Оставьте заявку — менеджер ответит за 10 минут и скажет точное наличие. Место бронируется на 72 часа без предоплаты.`
  },
  {
    h2: "Частые вопросы про АйДаКемп",
    text: `Отвечаем на вопросы, которые чаще всего задают перед покупкой путёвки в АйДаКемп ${SEASON_YEAR}.`,
    list: [
      "Оплата онлайн или по реквизитам — договор и чек сразу на email",
      "Налоговый вычет 13% — оформляете самостоятельно через ФНС по справке от нас",
      "Возврат при отмене — по условиям договора, не позднее чем за 14 дней до начала",
    ],
  },
  {
    h2: "Путёвки в детские лагеря в Подмосковье — на что обращать внимание",
    text: `Перед тем как выбрать летний лагерь в Подмосковье, проверьте: лицензию Минобрнауки (даёт право получить вычет), медицинское сопровождение, питание по нормам СанПиН и статус туроператора — без него лагерь не обязан оформлять договор и страховку на ребёнка. АйДаКемп ${SEASON_YEAR} — детский оздоровительный IT-лагерь под Клином: Москва в часе езды, а вокруг лес и тишина. Лицензия ${STAT_LICENSE}, туроператор РТО ${STAT_RTO}, медработник 24/7, бассейн с ионизированной водой и полноценная IT-программа для детей.`,
  },
];

const faqItems = [
  {
    question: "Что входит в путёвку в детский лагерь?",
    answer: `Путёвка ${SEASON_YEAR} для детского отдыха подходит детям 8–17 лет, группы формируются с учётом возраста детей. Входит: проживание в корпусе, 5-разовое питание, IT-программа в мини-группах до 8 человек, бассейн, спортивные и вечерние активности, охрана территории и медработник. Оборудование для занятий (ноутбуки) наше — везти ничего не нужно.`
  },
  {
    question: "Где взять путёвку в детский лагерь?",
    answer: "Взять получится через заявку на aidacamp.ru или по телефону — за 10 минут, без личного визита в офис."
  },
  {
    question: "Можно ли вернуть путёвку?",
    answer: "Да. До 30 дней до заезда — возврат 100%. За 14–30 дней — 80%. За 7–14 дней — 50%. При болезни ребёнка со справкой от врача — 80% в любой срок. Все условия прописаны в договоре."
  },
  {
    question: "Как оформить налоговый вычет с путёвки?",
    answer: `Мы официальный образовательный лагерь с лицензией Минобрнауки. Выдаём договор и чек, по которым можно оформить вычет 13% в личном кабинете налоговой. С покупки за ${PRICE_MIN} вернёте до 6 240 ₽.`
  },
  {
    question: "Можно ли оплатить путёвку в рассрочку?",
    answer: "Да. При бронировании — 50% стоимости. Остаток — за 3 недели до заезда. Никаких процентов и переплат. Оплата картой, по счёту или наличными."
  },
  {
    question: `Как купить путёвку в детский лагерь АйДаКемп ${SEASON_YEAR}?`,
    answer: "Оформить всё просто: выбрать даты на aidacamp.ru, нажать «Записаться», заполнить форму. Менеджер свяжется в течение часа, пришлёт договор и реквизиты. Оплата онлайн или переводом. Налоговый вычет 13%."
  },
  {
    question: "Сколько стоят путёвки в детские лагеря в Подмосковье?",
    answer: `Открыты к брони: ${PRICE_S4} (10 дней) и ${PRICE_MAX} (13 дней). Июньские заезды (7–14 дней) завершены. Всё включено. Налоговый вычет 13%.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/putevka-lager.avif"
  title={`Купить путевки — летний лагерь ${SEASON_YEAR}, Подмосковье: цена на лето`}
  description={`Купить путевки в детский летний лагерь Подмосковье на лето ${SEASON_YEAR}: детские смены для детей, Москва рядом. Цена отдыха: спортивный и оздоровительный формат, IT-программа, бассейн`}
  h1={`Детские путевки: летний спортивный, оздоровительный лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/putevka-v-lager"
>
  <LandingHero slot="hero"
    h1={`Детские путевки: летний спортивный, оздоровительный лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle="Всё включено: IT-проект, бассейн, спортивные активности, питание, проживание. Официальный договор, налоговый вычет 13%."
    breadcrumb="Путёвка в лагерь"
    keywords={["Всё включено — проживание, питание, IT-программа, бассейн", "Лицензия Минобрнауки — вычет 13% с покупки", "Оплата частями: 50% сейчас, 50% за 3 недели", "Москва — в часе езды, а вокруг лес и тишина"]}
    image="/images/hero/putevka-lager.avif"
    imageAlt="Путёвка в детский лагерь в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Shifts />

  <section class="mx-auto max-w-[860px] px-4 py-10">
    <div class="flex items-center gap-2 mb-6">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Частые вопросы о путёвке в лагерь
      </h2>
    </div>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
          <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
            <span>{item.question}</span>
            <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
          </button>
          <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
            <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQ extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))} only={['medicine', 'safety', 'food', 'accommodation', 'documents', 'communication', 'payment']} />
  <RelatedArticles articles={[
    { title: `Цены и смены ${SEASON_YEAR}`, url: "/ceny/", description: "Полное расписание смен и стоимость.", icon: "calendar-week" },
    { title: "Налоговый вычет 13%", url: "/nalogovyj-vychet/", description: "Как вернуть деньги с путёвки.", icon: "receipt" },
    { title: "Официальный детский лагерь", url: "/detskiy-lager-oficialnyj/", description: "Лицензия, РТО, проверка документов.", icon: "patch-check-fill" },
    { title: "Загородный лагерь", url: "/zagorodnyj-lager/", description: "Лес, бассейн, 66 км от МКАД.", icon: "tree" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('[data-faq-item]');
      const answer = item?.querySelector<HTMLElement>('[data-faq-answer]');
      const icon = btn.querySelector<HTMLElement>('[data-faq-icon]');
      if (!answer) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</LandingLayout>
