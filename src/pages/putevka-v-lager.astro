---

<LandingLayout
  heroImage="/images/hero/putevka-lager.avif"
  title={`Путёвки в детский лагерь Подмосковье 2026 — купить от ${PRICE_MIN} | АйДаКемп`}
  description={`Купить путёвку в детский лагерь 2026 в Подмосковье. Лицензия Минобрнауки, IT-программа, бассейн. Смены с 30 мая — ${PRICE_MIN}–${PRICE_MAX}. Вычет 13%.`}
  h1={`Путёвки в детский лагерь 2026 Подмосковье — от ${PRICE_MIN}`}
  canonical="https://aidacamp.ru/putevka-v-lager"
>
  <Fragment slot="head">
    <FAQSchema items={faqItems.map(item => ({ q: item.question, a: item.answer }))} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Путёвки в детский лагерь 2026 — купить онлайн"
    subtitle="Всё включено: IT-проект, бассейн, питание, проживание. Официальный договор, налоговый вычет 13%."
    breadcrumb="Путёвка в лагерь"
    keywords={["Всё включено — проживание, питание, IT-программа, бассейн", "Лицензия Минобрнауки — вычет 13% с путёвки", "Оплата частями: 50% сейчас, 50% за 3 недели"]}
    image="/images/hero/putevka-lager.avif"
    imageAlt="Путёвка в детский лагерь в Подмосковье 2026"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Shifts />

  <section class="mx-auto max-w-[860px] px-4 py-10">
    <div class="flex items-center gap-2 mb-6">
      <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Частые вопросы о путёвке в лагерь
      </h2>
    </div>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
          <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
            <span>{item.question}</span>
            <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
          </button>
          <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
            <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Цены и смены 2026", url: "/ceny", description: "Полное расписание смен и стоимость.", icon: "calendar-week" },
    { title: "Налоговый вычет 13%", url: "/nalogovyj-vychet", description: "Как вернуть деньги с путёвки.", icon: "receipt" },
    { title: "Официальный детский лагерь", url: "/detskiy-lager-oficialnyj", description: "Лицензия, РТО, проверка документов.", icon: "patch-check-fill" },
    { title: "Загородный лагерь", url: "/zagorodnyj-lager", description: "Лес, бассейн, 66 км от МКАД.", icon: "tree" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</LandingLayout>
