---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, SEASON_YEAR, mainShifts, getAvailabilityLevel } from '../data/shifts';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';

// Единый источник наличия мест — getAvailabilityLevel() из shifts.ts, не хардкодим free напрямую в текст.
function shiftAvailabilityFragment(shiftId: string): string {
  const s = mainShifts.find(s => s.id === shiftId);
  if (!s) return '';
  return getAvailabilityLevel(s) === 'soldout'
    ? `${s.name} (мест нет, доступен лист ожидания)`
    : `${s.name} (осталось ${s.free} мест)`;
}
const shift3Availability = shiftAvailabilityFragment('shift-3');
const shift4Availability = shiftAvailabilityFragment('shift-4');
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что входит в путёвку в детский лагерь",
    text: "АйДаКемп — оздоровительный лагерь: всё включено, без скрытых доплат. Сумма за смену в лагере фиксируется сразу — что написано, то и платите. Оформить и получить путёвку можно заранее, а всё нужное для детей на смене уже включено в программу.",
    list: [
      "Проживание в корпусе (двух- или трёхместные комнаты)",
      "5-разовое питание: завтрак, обед, полдник, ужин, второй ужин",
      "IT-программа: Python, AI, Minecraft, 3D или Roblox Studio — мини-группы до 8 школьников",
      "Бассейн с ионизированной водой, спортивные площадки ежедневно",
      "Хакатон в финале смены — командная защита проекта",
      "Медработник на территории лагеря 24/7, охрана"
    ]
  },
  {
    h2: "Как оформить — 3 шага",
    text: `Место в детском лагере в Подмосковье, недалеко от Москвы, можно получить за 10 минут — без очередей и лишних бумаг. Все формальности лагеря проходят онлайн или по телефону: отличный вариант, если ищете лагерь на лето ${SEASON_YEAR}.`,
    list: [
      "Шаг 1: выбрать даты и длительность смены",
      "Шаг 2: оплатить 50% онлайн или по реквизитам — место за ребёнком",
      "Шаг 3: получить договор и список вещей на почту"
    ]
  },
  {
    h2: `Цены на смены в детском лагере в ${SEASON_YEAR} году`,
    text: "Заезды идут с 30 мая по конец августа — это IT-проект в детском лагере на всю летнюю смену: 10 или 13 дней полного погружения в жизнь лагеря, без скрытых доплат. Мы каждый день на связи с родителями и делимся тем, что происходит с ребёнком.",
    list: [
      `10 дней — от ${PRICE_S4}`,
      `13 дней — от ${PRICE_MAX}`,
      "Оплата частями без переплаты",
      `Налоговый вычет 13% — возврат до ${VYCHET_MAX} с покупки`
    ]
  },
  {
    h2: "Документы, лицензия, оплата",
    text: `АйДаКемп — детский лагерь в Московской области, который работает официально: лицензия Минобрнауки на образовательную деятельность, регистрация в реестре туроператоров РТО. Для заезда нужны медицинские справки на детей — часть можно взять заранее в поликлинике по месту жительства. Все документы лагеря доступны по запросу, а если ребёнку понадобится помощь — рядом медработник. Полный комплект бумаг пригодится и на лето ${SEASON_YEAR}, и в любой другой сезон.`,
    list: [
      "Официальный договор лагеря с датами и полным описанием услуг",
      "Справка 086/у или 079/у, копия полиса ОМС",
      "Предоплата 50% при бронировании, остаток — за 14 дней до заезда",
      "Оплата картой, по СБП или по реквизитам ООО для корпоративной оплаты"
    ]
  },
  {
    h2: "Налоговый вычет с покупки",
    text: `С образовательной покупки государство возвращает 13% НДФЛ. Смена за ${PRICE_MIN} — вернёте до 6 240 ₽. Для этого нужен наш договор и чек — мы их выдаём автоматически. Вычет можно оформить после любой смены в лагере — хоть на лето ${SEASON_YEAR}, хоть в межсезонье.`,
    list: [
      "Максимальная база — 120 000 ₽ в год на образование одного из детей",
      "Оформляется через личный кабинет налоговой за 15 минут"
    ]
  },
  {
    h2: "Условия возврата",
    text: "Планы меняются — условия возврата прозрачные и прописаны в договоре лагеря. Мы бережно относимся к деньгам семьи и интересам детей — правила понятные и без скрытых условий.",
    list: [
      "До 30 дней до заезда — возврат 100% (за вычетом комиссии банка)",
      "14–30 дней до заезда — возврат 80%",
      "7–14 дней до заезда — возврат 50%",
      "При болезни ребёнка — справка от врача, возврат 80% от суммы смены в лагере"
    ]
  },
  {
    h2: "Свободные места в лагере этим летом",
    text: `Июль занят полностью. На август открыты ${shift3Availability} и ${shift4Availability} — самое время узнать, где ещё остались места на лето ${SEASON_YEAR}. Забронировать место в лагере несложно — заявка занимает пару минут. Оставьте заявку — менеджер ответит за 10 минут и скажет точное наличие.`
  },
  {
    h2: "Как выбрать детский лагерь в Подмосковье — на что смотреть",
    text: `Где искать детский лагерь на лето ${SEASON_YEAR}? Перед выбором оздоровительного лагеря на летние каникулы проверьте лицензию Минобрнауки, медицинское сопровождение и статус туроператора — без него договор и страховку на ребёнка не оформят. АйДаКемп — IT-лагерь в Наро-Фоминском округе, Московская область: 66 км от Москвы по Киевскому шоссе, около часа езды, а вокруг лес и тишина. Распорядок дня в лагере предсказуемый и безопасный. Лицензия ${STAT_LICENSE}, туроператор РТО ${STAT_RTO}, регион — Московская область, Подмосковье.`,
  },
];

const faqItems = [
  {
    question: "Что входит в путёвку в детский лагерь?",
    answer: "Это оздоровительный лагерь: смена подходит ребятам 8–17 лет, группы формируются с учётом возраста. Входит: проживание в корпусе, 5-разовое питание, IT-программа в мини-группах до 8 человек, бассейн, спортивные и вечерние активности, охрана территории и медработник. Все правила лагеря понятные и одинаковые для всех смен."
  },
  {
    question: "Где записаться в АйДаКемп?",
    answer: `Через заявку на aidacamp.ru или по телефону — за 10 минут, без личного визита в офис. Лагерь в Наро-Фоминском округе, Московская область. Подходит семьям из Москвы и соседних городов — хороший вариант на лето ${SEASON_YEAR}. Добраться до лагеря можно на трансфере от метро.`
  },
  {
    question: "Как оформить возврат?",
    answer: "До 30 дней до заезда — возврат 100%. За 14–30 дней — 80%. За 7–14 дней — 50%. При болезни ребёнка со справкой от врача — 80% в любой срок. Все условия прописаны в договоре. Решить вопрос с ребёнком и деньгами можно всегда — мы идём навстречу."
  },
  {
    question: "Как оформить налоговый вычет за смену?",
    answer: `Мы официальный образовательный лагерь с лицензией Минобрнауки. Выдаём договор и чек, по которым можно оформить вычет 13% в личном кабинете налоговой. С покупки за ${PRICE_MIN} вернёте до 6 240 ₽.`
  },
  {
    question: "Можно ли оплатить в рассрочку?",
    answer: "Да. При бронировании — 50% стоимости. Остаток — за 3 недели до заезда. Никаких процентов и переплат. Оплата картой, по счёту или наличными. Способ оплаты можно менять по каждому ребёнку в семье отдельно."
  },
  {
    question: "Как записаться в детский лагерь АйДаКемп?",
    answer: "Оформить всё просто: выбрать даты на aidacamp.ru, нажать «Записаться», заполнить форму. Менеджер свяжется в течение часа, пришлёт договор и реквизиты. Оплата онлайн или переводом. Налоговый вычет 13%."
  },
  {
    question: "Сколько стоят смены АйДаКемп?",
    answer: `Летние смены на лето ${SEASON_YEAR} открыты к брони: ${PRICE_S4} (10 дней) и ${PRICE_MAX} (13 дней). Июньские заезды (7–14 дней) завершены. Всё включено. Налоговый вычет 13%. Лагерь в Наро-Фоминском округе Московской области.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/putevka-lager.avif"
  title={`Как получить путёвку в детский лагерь в Подмосковье ${SEASON_YEAR} — цены на смены`}
  description={`Детский лагерь в Подмосковье, Московская область: как получить путёвки на смены ${SEASON_YEAR}, что входит, сколько стоит и как оплатить. IT-программа, бассейн, официальный договор, налоговый вычет 13%.`}
  h1={`Как получить путёвку в летний детский лагерь в Подмосковье — Московская область, ${SEASON_YEAR} год`}
  canonical="https://aidacamp.ru/putevka-v-lager"
>
  <LandingHero slot="hero"
    h1={`Как получить путёвку в летний детский лагерь в Подмосковье — Московская область, ${SEASON_YEAR} год`}
    subtitle="Летний детский лагерь в Наро-Фоминском округе, Московская область, 66 км от Москвы: всё включено — IT-проект, бассейн, спорт, питание, проживание. Официальный договор, налоговый вычет 13%."
    breadcrumb="Оформление и оплата"
    keywords={["Всё включено — проживание, питание, IT-программа, бассейн", "Лицензия Минобрнауки — вычет 13% с покупки", "Оплата частями: 50% сейчас, 50% за 3 недели", "Лагерь в Подмосковье, Московская область — 66 км от МКАД, лес и тишина", "Наро-Фоминский округ, юго-запад Московской области — трансфер от м. Солнцево"]}
    image="/images/hero/putevka-lager.avif"
    imageAlt="Детский лагерь, Московская область"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Shifts />

  <FAQ extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))} only={['documents', 'payment', 'communication']} />
  <RelatedArticles articles={[
    { title: "Цены и расписание смен", url: "/ceny/", description: "Полное расписание смен и сколько это стоит.", icon: "calendar-week" },
    { title: "Налоговый вычет 13%", url: "/nalogovyj-vychet/", description: "Возврат денег за смену.", icon: "receipt" },
    { title: "Официальный детский лагерь", url: "/detskiy-lager-oficialnyj/", description: "Лицензия, РТО, проверка документов.", icon: "patch-check-fill" },
    { title: "Загородный лагерь", url: "/zagorodnyj-lager/", description: "Лес и бассейн, Московская область, 66 км от МКАД.", icon: "tree" },
  ]} />
  <RelatedPages title="Похожие страницы" pages={getRelatedPages(Astro.url.pathname, 3)} />
</LandingLayout>
