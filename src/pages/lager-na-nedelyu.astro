---
import { DATES_SHORT_S4, PRICE_S4, PRICE_OSEN, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь на неделю — для кого этот формат",
    text: "Неделя — самый частый запрос родителей, которые отправляют ребёнка первый раз или не готовы отпускать надолго. Это честный компромисс: достаточно, чтобы школьник прожил самостоятельный опыт, завёл друзей и сделал собственный проект — и не настолько долго, чтобы успеть всерьёз заскучать по дому.",
    list: [
      "Первый лагерный опыт — 7 дней комфортнее двухнедельной смены",
      "Плотный график: короткие каникулы, отпуск родителей, спорт и репетиторы",
      "«Проверить, зайдёт ли» — перед тем как брать длинную смену следующим летом",
      "Подростку, который «не хочет в лагерь» — неделю согласиться проще"
    ]
  },
  {
    h2: "Какие короткие смены есть в АйДаКемп",
    text: `Мы регулярно проводим смены на 7–10 дней — это наш рабочий формат, не урезанная версия. Ближайшие: августовская смена 4 на 10 дней (${DATES_SHORT_S4}, ${PRICE_S4}, места есть) и осенняя неделя на каникулах — открыта предварительная запись, ориентир ${PRICE_OSEN}. Короткая программа лагеря доступна и на летние, и на зимние (новогодние) каникулы; лагерь находится в 66 км от МКАД по Киевскому шоссе.`,
    list: [
      `Август: смена 4 — 10 дней, ${DATES_SHORT_S4}, ${PRICE_S4} (запись открыта)`,
      `Осень: смена 7 дней на осенних каникулах — предзапись без оплаты, ориентир ${PRICE_OSEN}`,
      "Зима: смена на новогодних каникулах — предзапись открыта",
      `Лето 2027: короткие 7-дневные смены объявим зимой — в сезоне ${SEASON_YEAR} такая была и разошлась первой`
    ]
  },
  {
    h2: "Что ребёнок успевает за неделю в лагере",
    text: "Семь дней при структурированном дне — это больше, чем кажется. Два IT-занятия в день, бассейн, командный хакатон в середине смены и защита собственного проекта в конце. Плюс лагерная экономика: ребята зарабатывают лагерные рубли и учатся ими распоряжаться. За неделю ребята получают и IT-навыки, и первые финансовые: бассейн и спортивные активности чередуются с занятиями и вечерними мероприятиями.",
    list: [
      "Дни 1–3: адаптация, старт трека и первого языка программирования (Scratch, Minecraft, Python или Roblox — по возрасту)",
      "День 4: хакатон — команды за день собирают мини-игру",
      "Дни 5–6: собственный проект и защита перед всей сменой",
      "День 7: выезд — домой с работающей игрой или ботом"
    ]
  },
  {
    h2: "Неделя или полная смена — что выбрать",
    text: "Если ребёнок едет впервые или сомневается — берите неделю: этого хватает на полный цикл «адаптация → проект → защита». Если уже был в лагере и просит «подольше» — смотрите смены на 10–14 дней: там программа глубже, проект серьёзнее, а цена за день ниже.",
    list: [
      "7 дней: первый опыт, проверка формата, плотное расписание семьи",
      "10 дней: золотая середина — хватает и на проект, и на «пожить лагерем»",
      "13–14 дней: для тех, кто уже влюбился в лагерь — максимум программы",
      "Цена за день снижается с длиной смены — длинные выгоднее в пересчёте"
    ]
  },
  {
    h2: "Условия — как в полной смене, без скидок на короткий срок",
    text: "Неделя в АйДаКемп — это те же условия, что и в длинных сменах: тёплые номера санатория «Изумруд» по 2–4 человека, питание 5 раз в день, крытый бассейн, медработник на территории круглосуточно, группы до 8 школьников на преподавателя. 66 км от МКАД по Киевскому шоссе.",
    list: [
      "Проживание: комнаты по 2–4 человека, удобства в номере",
      "Питание 5 раз в день — своя столовая, учитываем аллергии",
      "Крытый бассейн по графику групп",
      "Медработник 24/7, закрытая территория, охрана",
      `Лицензия Минобрнауки — налоговый вычет 13% (до ${VYCHET_MAX} на длинных сменах)`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title={`Лагерь на неделю (7 дней) для ребёнка ${SEASON_YEAR} — Подмосковье | АйДаКемп`}
  description={`Детский лагерь на неделю в Подмосковье для детей 7–15 лет: летние, осенние и зимние смены 7–10 дней. IT-программа, бассейн, всё включено. Август — ${PRICE_S4}.`}
  h1="Лагерь на неделю — 7 незабываемых дней"
  canonical="https://aidacamp.ru/lager-na-nedelyu"
>
  <Fragment slot="head">
    <FAQSchema items={[
      { q: "Есть ли детские лагеря на неделю?", a: `Да, короткие смены 7–10 дней — рабочий формат АйДаКемп: августовская смена на 10 дней (${DATES_SHORT_S4}), 7-дневная смена на осенних каникулах ${SEASON_YEAR} (предзапись открыта) и неделя на новогодних каникулах. Условия те же, что в длинных сменах.` },
      { q: "Что ребёнок успеет за неделю в лагере?", a: "Полный цикл: адаптация, IT-трек по возрасту, командный хакатон в середине смены и защита собственного проекта — игры или бота — перед всей сменой. Домой уезжает с работающим проектом." },
      { q: `Сколько стоит лагерь на неделю в ${SEASON_YEAR} году?`, a: `Ориентиры: осенняя 7-дневная смена — ${PRICE_OSEN} (предварительная цена, всё включено), августовская 10-дневная — ${PRICE_S4}. В цену входят проживание, питание 5 раз в день, программа и бассейн.` },
      { q: "Неделя — не слишком мало для первого раза?", a: "Наоборот, это лучший формат дебюта: достаточно для самостоятельного опыта и новых друзей, но без риска затосковать. Половина наших «недельных» ребят потом возвращаются на длинные смены." }
    ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на неделю — 7 незабываемых дней"
    subtitle="Короткие смены 7–10 дней круглый год: лето, осенние и новогодние каникулы. Первый лагерь ребёнка — без стресса для всех."
    breadcrumb="Лагерь на неделю"
    keywords={[
      "Полный цикл за 7 дней: трек, хакатон, свой проект",
      "Тёплый санаторий, бассейн, питание 5 раз в день",
      "66 км от МКАД — удобно привезти и забрать"
    ]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь на неделю в Подмосковье — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
