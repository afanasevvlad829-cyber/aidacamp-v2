---
import { DATES_SHORT_S4, DAYS_S4, PRICE_OSEN, PRICE_S4, PRICE_ZIMA, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';

const sections = [
  {
    h2: "Лагерь на неделю — для кого этот формат",
    text: "Это частый запрос родителей, которые впервые отправляют ребёнка в детский лагерь в Подмосковье или не готовы оставлять его в лагере надолго: достаточно, чтобы школьник прожил в лагере самостоятельный опыт, завёл друзей и сделал собственный проект, и не настолько долго, чтобы заскучать по дому.",
    list: [
      "Первый опыт — семь дней в лагере комфортнее двухнедельной смены",
      "Подростку, который сомневается, короткий лагерь предложить проще"
    ]
  },
  {
    h2: "Какие короткие смены есть в АйДаКемп в Подмосковье",
    text: `Мы регулярно проводим смены от семи до ${DAYS_S4} — это наш рабочий формат. Августовская смена 4 (${DATES_SHORT_S4}, ${PRICE_S4}) уже прошла; на осеннюю идёт запись, ${PRICE_OSEN}. Короткая программа в лагере доступна на летние и зимние каникулы; сам лагерь находится в 66 км от МКАД по Киевскому шоссе.`,
    list: [
      `Осень: смена на неделю осенних каникул — идёт запись, ${PRICE_OSEN}`,
      `Зима: лагерь в Подмосковье работает и на новогодних каникулах — идёт запись, ${PRICE_ZIMA}`,
      `Лето 2027: недельный лагерь объявим зимой — в сезоне ${SEASON_YEAR} такой был и разошёлся первым`
    ]
  },
  {
    h2: "Что ребёнок успевает за неделю",
    text: "Два IT-занятия в лагере ежедневно, бассейн, командный хакатон в середине смены и защита собственного проекта в конце лагеря. Плюс лагерная экономика: ребята зарабатывают лагерные рубли и учатся ими распоряжаться.",
    list: [
      "Первые трое суток: адаптация и старт трека (Scratch, Minecraft, Python или Roblox — по возрасту); четвёртые сутки: хакатон; пятые и шестые: проект и защита; последние сутки: выезд домой с работающей игрой или ботом"
    ]
  },
  {
    h2: "Короткая или полная смена — что выбрать",
    text: "Если ребёнок едет впервые или сомневается — берите короткий лагерь: этого хватает на полный цикл «адаптация → проект → защита». Если уже был в лагере и просит «подольше» — смотрите смены на 10–14 суток: программа глубже, проект серьёзнее, цена за сутки ниже."
  },
  {
    h2: "Условия — как в полной смене, без скидок на короткий срок",
    text: "Те же условия, что и в лагере в Подмосковье с длинными сменами: тёплые номера санатория «Изумруд» по 2–4 человека, питание 5 раз в день, крытый бассейн, медработник в лагере круглосуточно, группы до 8 детей на преподавателя.",
    list: [
      "Медработник и охрана — круглосуточно, лагерь — закрытая территория",
      `Лицензия Минобрнауки на программу лагеря — налоговый вычет 13% (до ${VYCHET_MAX} на длинных сменах)`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title={`Летний детский лагерь на неделю (7 дней) ${SEASON_YEAR} — Подмосковье | АйДаКемп`}
  description={`Детский лагерь на неделю в Подмосковье для детей 7–15 лет: летние, осенние и зимние смены 7–${DAYS_S4}. IT-программа, бассейн, всё включено. Август — ${PRICE_S4}.`}
  h1="Лагерь на неделю (7 дней), Подмосковье"
  canonical="https://aidacamp.ru/lager-na-nedelyu"
  breadcrumb="Короткая смена"
>
  <LandingHero slot="hero"
    h1="Лагерь на неделю (7 дней), Подмосковье"
    subtitle="Короткие смены от семи до 10 суток круглый год — лето, осенние и новогодние каникулы. Первый детский лагерь в Подмосковье — без стресса для всех."
    breadcrumb="Короткая смена"
    keywords={[
      "Полный цикл за семь суток: трек, хакатон, свой проект",
      "Тёплый санаторий, бассейн, питание 5 раз в сутки",
      "66 км от МКАД — удобно привезти и забрать"
    ]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Занятия АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:1', 'about2026:3', 'about2026:6', 'food:1']} extraItems={[
      { q: "Есть ли короткие смены?", a: `Да, от семи до ${DAYS_S4} — рабочий формат детского лагеря АйДаКемп в Подмосковье. Августовская смена (${DATES_SHORT_S4}) уже прошла; на осеннюю смену ${SEASON_YEAR} идёт запись, есть и новогодняя.` },
      { q: "Что ребёнок успеет за это время?", a: "Адаптация, IT-трек по возрасту, командный хакатон и защита собственного проекта — игры или бота — перед всей сменой. Домой уезжает с работающим проектом." },
      { q: `Сколько стоит короткая смена в ${SEASON_YEAR} году?`, a: `Осенняя смена — ${PRICE_OSEN}, всё включено; августовская была ${PRICE_S4}. В цену входят проживание, питание 5 раз в день, программа и бассейн.` },
      { q: "Неделя — не слишком мало для первого раза?", a: "Наоборот, это лучший формат дебюта: достаточно для самостоятельного опыта лагеря в Подмосковье и новых друзей, но без риска затосковать. Половина наших «недельных» ребят потом возвращаются в лагерь на длинные смены." }
    ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
