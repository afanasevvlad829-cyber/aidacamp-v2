---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Лагерь 3D-моделирования — Blender с нуля для детей",
    text: "3D-моделирование — одна из самых востребованных digital-профессий. В АйДаКемп дети 10–16 лет осваивают Blender (бесплатный профессиональный 3D-редактор) и создают собственные модели: персонажей, предметы, архитектурные сцены. К концу смены каждый уезжает с цифровой моделью и рендерами — модель готова к 3D-печати дома (через online-сервис или знакомого с принтером)."
  },
  {
    h2: "Программа 3D-моделирования в лагере",
    text: "Blender — сложный инструмент для взрослых, но мы адаптируем курс под детскую логику. Группы до 8 человек, индивидуальный подход, каждый идёт в своём темпе.",
    list: [
      "Интерфейс Blender — первые шаги, горячие клавиши, навигация",
      "Примитивы и моделирование — куб, сфера, расширенные формы",
      "Материалы и текстуры — как сделать модель «живой»",
      "Освещение и камера — основы визуализации",
      "Подготовка к 3D-печати — экспорт STL для печати дома или через online-сервис",
      "Финальная презентация — защита модели перед группой"
    ]
  },
  {
    h2: "Программа 3D-моделирования по дням — что осваивают",
    text: "За 10–14 дней ребята проходят путь от первого куба до готовой модели с текстурами и рендером. Детальная прогрессия:",
    list: [
      "Дни 1–2: интерфейс Blender, навигация в 3D-пространстве, базовые горячие клавиши. Первый объект — «стакан» из цилиндра через Loop Cut и Extrude. Концепция меш-модели, вертексов, рёбер, полигонов",
      "Дни 3–5: Edit Mode — выделение, перемещение, масштаб, поворот. Моделирование персонажа или предмета по референсу. Зеркальный модификатор для симметричных объектов. Сглаживание Subdivision Surface",
      "Дни 6–8: UV-развёртка, создание материалов в Shader Editor. Базовое текстурирование — Paint в Blender или импорт текстуры. Постановка света: Area Light, HDRI-окружение. Первый рендер в Cycles или Eevee",
      "Дни 9–10 (или до 14): финальная сцена — модель в окружении, красивое освещение, несколько ракурсов рендера. Экспорт STL для 3D-печати. Подготовка презентации",
      "Финал: каждый показывает модель и рендеры, рассказывает о процессе. Родители видят результат. Сертификаты."
    ]
  },
  {
    h2: "Для какого возраста подходит 3D-лагерь",
    text: "3D-трек рассчитан на детей 11–16 лет. Специфика по возрасту:",
    list: [
      "11–12 лет: начинают с простых объектов и персонажей. Blender требует понимания 3D-пространства — в этом возрасте оно уже формируется. За смену делают аккуратную модель любимого персонажа или предмета",
      "13–14 лет: могут работать со сложными топологиями, UV-развёрткой, базовыми анимациями. Часто уходят с несколькими объектами в портфолио",
      "15–16 лет: продвинутая группа. Работают над сценой целиком: персонаж + окружение + свет + рендер. Изучают основы скульптинга и риггинга",
      "10 лет (исключение): берём детей с хорошей усидчивостью и интересом к визуальному контенту. Программа немного упрощается, но результат реальный"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену в 3D-лагере",
    text: "На выходе — не «прошли тему», а конкретные файлы которые можно открыть дома, напечатать или показать в портфолио. Типичные финальные проекты:",
    list: [
      "Персонаж из любимого мультфильма или игры — полигональная 3D-модель с текстурами и рендером",
      "Предмет для 3D-печати — кулон, подставка для телефона, брелок. Экспортируется в STL, можно заказать печать за 500–800 ₽ онлайн",
      "Интерьерная сцена — детская комната, сказочный домик или архитектурный фрагмент с мебелью и светом",
      "Короткая анимация (14-дневная смена) — персонаж идёт, машет рукой или падает — 5–10 секунд анимации",
      "Инфографика-сцена — 3D-иллюстрация к теме (космос, природа, техника) для школьного проекта или соцсетей"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для изучения Blender",
    text: "3D-кружки и онлайн-курсы по Blender есть, но лагерный формат даёт другое:",
    list: [
      "Погружение — 5–6 часов Blender в день вместо 1–2 часов в неделю. За 10 дней — то, что в кружке занимает год",
      "Преподаватели с практикой — знают Blender как рабочий инструмент, не только как учебный предмет. Отвечают на вопросы «как делают в профессии»",
      "Референсы и соседство — дети видят как делают другие, вдохновляются и конкурируют. Качество растёт быстрее чем в одиночестве дома",
      "Готовность к 3D-печати — не просто модель «для красоты», а реальный STL-файл который можно заказать напечатать"
    ]
  },
  {
    h2: "Почему именно Blender",
    text: "Blender — бесплатный, но профессиональный. На нём работают студии Pixar, Netflix, ILM (те самые Звёздные войны). Он стандарт индустрии: тот, кто освоит Blender в 12 лет, через 5–6 лет придёт в любую студию уже подготовленным. Альтернативы (Maya, 3ds Max) стоят десятки тысяч в год — для ребёнка экономически бессмысленны. Blender даёт тот же функционал бесплатно и остаётся с ребёнком навсегда: может продолжать учиться дома после лагеря."
  },
  {
    h2: "Профессиональный путь 3D-художника — куда это ведёт",
    text: "3D-моделирование — это не только «смешные фигурки на принтере». Это одна из самых перспективных digital-профессий с зарплатами выше среднего по IT. Вот сценарии как может развиваться карьера:",
    list: [
      "Геймдев — создание персонажей, локаций, предметов для компьютерных игр (Unity, Unreal)",
      "Визуализация архитектуры — 3D-модели зданий и интерьеров для застройщиков и дизайнеров",
      "Анимация и VFX — работа в студиях кино/сериалов/рекламы (Pixar, Netflix, ILM)",
      "3D-печать и продуктовый дизайн — создание прототипов для изобретателей и инженеров",
      "Metaverse и AR/VR — создание виртуальных пространств и объектов",
      "Средняя зарплата 3D-художника в России в 2026: 120-300 тыс./мес в зависимости от уровня"
    ]
  },
  {
    h2: "Что нужно дома чтобы продолжать учиться Blender",
    text: "В отличие от профессиональных 3D-программ (Maya, 3ds Max по 150+ тыс./год), Blender бесплатный. Это одно из главных преимуществ для ребёнка — инструмент остаётся с ним после лагеря. Что нужно дома:",
    list: [
      "Компьютер с 16+ ГБ RAM и дискретной видеокартой (NVIDIA GTX 1660 или лучше) — минимум для комфортной работы",
      "Мышь с колесом-кликом (не тачпад!) — Blender сильно завязан на manipulating через мышь",
      "Планшет Wacom или XP-Pen начального уровня — для скульптинга (опциональный, но сильно помогает)",
      "Подписка на youtube-канал Blender Guru — лучший бесплатный учитель для начинающих",
      "Сообщества: Blender Russia в VK, r/blender на Reddit"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/3d-modelirovanie-lager.avif"
  title="Лагерь 3D-моделирования для детей 2026 — Blender | АйДаКемп"
  description="Летний лагерь 3D-моделирования для детей 11–16 лет в Подмосковье. Blender с нуля до готовой модели, 3D-печать. 66 км от МКАД, от 48 000 ₽."
  h1="Лагерь 3D-моделирования для детей в Подмосковье"
  canonical="https://aidacamp.ru/3d-modelirovanie-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Что такое лагерь 3D-моделирования для детей?", "acceptedAnswer": { "@type": "Answer", "text": "Летний лагерь с проживанием, где дети учатся 3D-моделированию в Blender. За 10–14 дней ребёнок создаёт собственную 3D-модель, рендеры и готовый STL-файл для печати дома." } },
        { "@type": "Question", "name": "С какого возраста подходит лагерь 3D-моделирования?", "acceptedAnswer": { "@type": "Answer", "text": "С 11 лет. АйДаКемп принимает детей 11–16 лет на трек 3D-моделирования. Предварительные знания не нужны — начинаем с нуля." } },
        { "@type": "Question", "name": "Чему учатся дети в лагере 3D-моделирования?", "acceptedAnswer": { "@type": "Answer", "text": "Дети осваивают Blender — профессиональный 3D-редактор (бесплатный, используется в геймдеве и кино). Создают 3D-модели: персонажей, объекты, архитектуру. На выходе — готовый файл для 3D-печати дома или через online-сервис." } },
        { "@type": "Question", "name": "Что ребёнок увезёт домой после лагеря 3D-моделирования?", "acceptedAnswer": { "@type": "Answer", "text": "Цифровую 3D-модель + рендеры + STL-файл для печати, навыки работы в профессиональном инструменте Blender. Распечатать модель можно дома (если есть принтер) или через online-сервис 3D-печати." } },
        { "@type": "Question", "name": "Нужен ли опыт рисования или художественные способности для 3D-лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "Нет. 3D-моделирование в Blender — это скорее техническое мышление, чем художественное. Умение видеть форму и пространство важнее навыков рисования карандашом. Ребята без художественного образования делают отличные модели." } },
        { "@type": "Question", "name": "Можно ли распечатать модель которую сделали в лагере?", "acceptedAnswer": { "@type": "Answer", "text": "Да. В конце смены каждый экспортирует модель в STL-формат для 3D-печати. Дома можно заказать печать через онлайн-сервисы (от 500 ₽) или напечатать на домашнем принтере." } },
        { "@type": "Question", "name": "Blender слишком сложен для детей — справятся?", "acceptedAnswer": { "@type": "Answer", "text": "Blender сложен для взрослых, которые пытаются учиться сами. В лагере программа адаптирована под детское восприятие: поэтапное введение инструментов, практика через конкретные проекты, преподаватель рядом. Дети 11–12 лет справляются и гордятся результатом." } }
      ]
    })} />
    <CourseSchema
      name="Лагерь 3D-моделирования для детей — Blender с нуля"
      description="Летний лагерь 3D-моделирования для детей 11–16 лет: Blender с нуля до готовой модели, экспорт в STL для печати дома. За 7 или 14 дней."
      url="https://aidacamp.ru/3d-modelirovanie-lager"
      level="Beginner"
      ageMin={11}
      ageMax={16}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь 3D-моделирования для детей в Подмосковье"
    subtitle="Blender с нуля. За 10–14 дней ребёнок создаёт свою 3D-модель и рендеры — готовый STL-файл можно распечатать дома или через online-сервис."
    breadcrumb="Лагерь 3D-моделирования"
    keywords={["Blender — профессиональный 3D-редактор, бесплатный", "Цифровая модель + рендеры + STL для печати дома", "11–16 лет, группы до 8 человек"]}
    image="/images/hero/3d-modelirovanie-lager.avif"
    imageAlt="Лагерь 3D-моделирования для детей"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej", description: "Minecraft, Tinkercad, Blender — как дети осваивают 3D.", icon: "box" },
    { title: "Roblox для детей — польза, риски и что с этим делать", url: "/stati/roblox-dlya-detej", description: "От Roblox Studio к Blender — логичный путь для геймдева.", icon: "controller" },
    { title: "Нейросети для детей — с чего начать и зачем", url: "/stati/nejroseti-dlya-detej", description: "AI + 3D = профессия будущего в создании контента.", icon: "cpu" },
  ]} />
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager", icon: "pc-display" },
    { title: "3D-моделирование для детей — статья", url: "/stati/3d-modelirovanie-dlya-detej", icon: "box" },
    { title: "Цены и смены", url: "/ceny", icon: "currency-ruble" },
  ]} />
</LandingLayout>
