---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь 3D-моделирования — Blender с нуля для детей",
    text: "3D-моделирование — одна из самых востребованных digital-профессий. В АйДаКемп дети 10–14 лет осваивают Blender (бесплатный профессиональный 3D-редактор) и создают собственные модели: персонажей, предметы, архитектурные сцены. К концу смены каждый уезжает с цифровой моделью и рендерами — модель готова к 3D-печати дома (через online-сервис или знакомого с принтером). АйДаКемп — <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT-лагерь</a>, где дети создают физические объекты из цифровых моделей. 3D-моделирование — одна из программ нашего <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a>."
  },
  {
    h2: "Инструменты которые изучаем",
    text: "В лагере используем три инструмента — выбор зависит от возраста и задачи:",
    list: [
      "Tinkercad (для начинающих 10–11 лет): браузерный конструктор от Autodesk. Идеален как первый шаг — собираем модели из готовых фигур, экспортируем STL для печати. Нет сложного интерфейса",
      "Blender (основной курс 11–14 лет): полноценный профессиональный 3D-редактор. Моделирование, скульптинг, UV-развёртка, риггинг, рендеринг. Бесплатный навсегда",
      "Экспорт STL/OBJ: из любого инструмента экспортируем в формат для 3D-печати. STL — для принтеров, OBJ — для игровых движков (Unity, Unreal)",
      "Render: финальный рендер в Cycles или EEVEE — красивая картинка которую можно поставить фоном или показать в портфолио"
    ]
  },
  {
    h2: "Программа 3D-моделирования в лагере",
    text: "Blender — сложный инструмент для взрослых, но мы адаптируем курс под детскую логику. Группы до 8 человек, индивидуальный подход, каждый идёт в своём темпе.",
    list: [
      "Интерфейс Blender — первые шаги, горячие клавиши, навигация",
      "Примитивы и моделирование — куб, сфера, расширенные формы",
      "Материалы и текстуры — как сделать модель «живой»",
      "Освещение и камера — основы визуализации",
      "Подготовка к 3D-печати — экспорт STL для печати дома или через online-сервис",
      "Финальная презентация — защита модели перед группой"
    ]
  },
  {
    h2: "Почему именно Blender",
    text: "Blender — бесплатный, но профессиональный. На нём работают студии Pixar, Netflix, ILM (те самые Звёздные войны). Он стандарт индустрии: тот, кто освоит Blender в 12 лет, через 5–6 лет придёт в любую студию уже подготовленным. Альтернативы (Maya, 3ds Max) стоят десятки тысяч в год — для ребёнка экономически бессмысленны. Blender даёт тот же функционал бесплатно и остаётся с ребёнком навсегда: может продолжать учиться дома после лагеря."
  },
  {
    h2: "Что создадут за смену 3D-моделирования",
    text: "Финальный проект у каждого свой — ребята сами выбирают что моделируют. Примеры реальных работ прошлых смен:",
    list: [
      "3D-персонаж для игры: робот, рыцарь, существо с рогами — с UV-разверткой и текстурами, готовый к импорту в Unity",
      "Простая сцена: стол с лампой, рабочий кабинет, уютная комната — работа со светом, материалами, постобработкой в Compositor",
      "Анимация: 3–5-секундный ролик с движущимся персонажем или механизмом — собственное мини-кино",
      "Персонаж для 3D-печати: STL-файл оптимизирован для принтера, поддержки настроены, масштаб выверен",
      "Архитектурный объект: башня, мост, дом — чертёж в 3D, рендер как портфолио-работа"
    ]
  },
  {
    h2: "3D + Python = геймдев и автоматизация",
    text: "Ребята, которые освоили 3D-моделирование, часто приходят на следующую смену в Python-трек — и это не случайно. Связка 3D + программирование открывает новые возможности:",
    list: [
      "Blender Python API: любое действие в Blender можно автоматизировать скриптом. Хочешь сделать 100 деревьев с разными размерами — пишешь 10 строк кода",
      "Экспорт в Unity/Unreal: модель из Blender → OBJ/FBX → импорт в игровой движок. Ребята, знающие оба инструмента, делают игры с собственным контентом",
      "Процедурная генерация: Python создаёт данные, Blender визуализирует их в 3D — популярный подход в data-art и архитектурной визуализации",
      "3D для веба: Three.js (JavaScript) + 3D-модели из Blender — интерактивные 3D-сцены прямо в браузере"
    ]
  },
  {
    h2: "Что уносят школьники из лагеря 3D",
    text: "За 10–14 дней 3D-смены ребята получают не абстрактный «опыт», а конкретные результаты которые показывают прогресс.",
    list: [
      "Собственная 3D-модель готовая к печати — STL-файл для online-сервиса или домашнего принтера",
      "Рендеры работ — красивые картинки, которые можно показать друзьям или поставить фоном",
      "Навык работы в Blender — можно продолжить учиться дома (бесплатно)",
      "Сертификат об участии — для портфолио",
      "Понимание профессии 3D-художника — видение куда дальше развиваться"
    ]
  },
  {
    h2: "Запись на смену — осталось мало мест",
    text: "3D-моделирование — один из немногих треков где мест изначально меньше, потому что нужны мощные ноутбуки для Blender. Группы маленькие (до 8 человек), места заканчиваются быстро. На август ещё можно выбрать дату — июль лучше уточнить сразу."
  },
  {
    h2: "Профессиональный путь 3D-художника — куда это ведёт",
    text: "3D-моделирование — это не только «смешные фигурки на принтере». Это одна из самых перспективных digital-профессий с зарплатами выше среднего по IT. Вот сценарии как может развиваться карьера:",
    list: [
      "Геймдев — создание персонажей, локаций, предметов для компьютерных игр (Unity, Unreal)",
      "Визуализация архитектуры — 3D-модели зданий и интерьеров для застройщиков и дизайнеров",
      "Анимация и VFX — работа в студиях кино/сериалов/рекламы (Pixar, Netflix, ILM)",
      "3D-печать и продуктовый дизайн — создание прототипов для изобретателей и инженеров",
      "Metaverse и AR/VR — создание виртуальных пространств и объектов",
      "Средняя зарплата 3D-художника в России в 2026: 120-300 тыс./мес в зависимости от уровня"
    ]
  },
  {
    h2: "Что нужно дома чтобы продолжать учиться Blender",
    text: "В отличие от профессиональных 3D-программ (Maya, 3ds Max по 150+ тыс./год), Blender бесплатный. Это одно из главных преимуществ для ребёнка — инструмент остаётся с ним после лагеря. Что нужно дома:",
    list: [
      "Компьютер с 16+ ГБ RAM и дискретной видеокартой (NVIDIA GTX 1660 или лучше) — минимум для комфортной работы",
      "Мышь с колесом-кликом (не тачпад!) — Blender сильно завязан на manipulating через мышь",
      "Планшет Wacom или XP-Pen начального уровня — для скульптинга (опциональный, но сильно помогает)",
      "Подписка на youtube-канал Blender Guru — лучший бесплатный учитель для начинающих",
      "Сообщества: Blender Russia в VK, r/blender на Reddit"
    ]
  },
  {
    h2: "Примеры проектов для Blender дома",
    text: "Ребёнок вернулся из лагеря с базовым Blender. Что делать? Мы рекомендуем серию простых проектов, которые дают видимый результат и не дают заскучать:",
    list: [
      "Модель любимой игрушки — распечатать на 3D-принтере у соседа или через online-сервис",
      "Сцена с персонажем — смоделировать и отрендерить 3D-портрет любимого персонажа из мультфильма",
      "Архитектурная модель — смоделировать свою комнату / школьный класс / детскую площадку",
      "Анимированная сцена — короткая 3-5 секундная анимация с движущимся персонажем",
      "Брошь / значок / кулон — простой объект, который можно реально распечатать и носить"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/3d-modelirovanie-lager.avif"
  title="Лагерь 3D-моделирования для детей в Подмосковье 2026 | АйДаКемп"
  description={`Лагерь 3D-моделирования для детей в Подмосковье. Blender, 3D-принтер, своя модель в руках. Смены 2026 с июня, 66 км от МКАД. От ${PRICE_MIN}.`}
  h1="Лагерь 3D-моделирования для детей в Подмосковье"
  canonical="https://aidacamp.ru/3d-modelirovanie-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое лагерь 3D-моделирования для детей?", a: "Летний лагерь с проживанием, где дети учатся 3D-моделированию в Blender. За 10–14 дней ребёнок создаёт собственную 3D-модель, рендеры и готовый STL-файл для печати дома." },
    { q: "С какого возраста подходит лагерь 3D-моделирования?", a: "С 10 лет. АйДаКемп принимает детей 10–14 лет на трек 3D-моделирования. Предварительные знания не нужны — начинаем с нуля." },
    { q: "Чему учатся дети в лагере 3D-моделирования?", a: "Дети осваивают Blender — профессиональный 3D-редактор (бесплатный, используется в геймдеве и кино). Создают 3D-модели: персонажей, объекты, архитектуру. На выходе — готовый файл для 3D-печати дома или через online-сервис." },
    { q: "Что ребёнок увезёт домой после лагеря 3D-моделирования?", a: "Цифровую 3D-модель + рендеры + STL-файл для печати, навыки работы в профессиональном инструменте Blender. Распечатать модель можно дома (если есть принтер) или через online-сервис 3D-печати." }
  ]} />
    <CourseSchema
      name="Лагерь 3D-моделирования для детей — Blender с нуля"
      description="Летний лагерь 3D-моделирования для детей 10–14 лет: Blender с нуля до готовой модели, экспорт в STL для печати дома. За 7 или 14 дней."
      url="https://aidacamp.ru/3d-modelirovanie-lager"
      level="Beginner"
      ageMin={10}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь 3D-моделирования для детей в Подмосковье"
    subtitle="Blender с нуля. За 10–14 дней ребёнок создаёт свою 3D-модель и рендеры — готовый STL-файл можно распечатать дома или через online-сервис."
    breadcrumb="Лагерь 3D-моделирования"
    keywords={["Blender — профессиональный 3D-редактор, бесплатный", "Цифровая модель + рендеры + STL для печати дома", "10–14 лет, группы до 8 человек"]}
    image="/images/hero/3d-modelirovanie-lager.avif"
    imageAlt="Лагерь 3D-моделирования для детей"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — что это и зачем", url: "/stati/3d-modelirovanie-dlya-detej/", description: "Что такое 3D-моделирование, зачем учить и с чего начать ребёнку.", icon: "file-earmark-text" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Нулевой опыт — норма. Дорожная карта по возрастам.", icon: "braces" },
    { title: "Социализация ребёнка в лагере — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere/", description: "Как групповые проекты развивают навыки командной работы.", icon: "people" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
