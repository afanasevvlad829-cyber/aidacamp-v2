---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SchoolContinue from '../components/SchoolContinue.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "3D-моделирование в АйДаКемп — Blender с нуля для детей",
    text: "В АйДаКемп дети 10–14 лет осваивают Blender (бесплатный профессиональный 3D-редактор) и создают собственные модели: персонажей, предметы, архитектурные сцены. К концу смены каждый уезжает с цифровой моделью и рендерами — модель готова к 3D-печати дома (через online-сервис или знакомого с принтером). АйДаКемп — загородный <a href='/it-camp/' class='text-[#ec9b44] hover:underline'>IT-центр</a>, где дети создают физические объекты из цифровых моделей. 3D-моделирование — одна из программ нашей <a href='/kompyuternyy-lager/' class='text-[#ec9b44] hover:underline'>компьютерной смены</a>. Это лагерь, где 3D-дизайн — главное занятие смены, а не факультатив."
  },
  {
    h2: "Творческая программа или кружок рисования: в чём разница",
    text: "На летних каникулах легко перепутать дизайн-программу с обычным творческим кружком рисования. Разница в результате: в 3D-моделировании ребёнок не рисует на бумаге, а работает как 3D-художник — продумывает форму объекта, подбирает материалы и свет, выстраивает композицию сцены в Blender. Итог смены — не альбом с рисунками, а объёмная 3D-модель, которую можно распечатать и держать в руках. Такой дизайн в лагере встречается редко: ребята работают с формой, светом и материалами, как в настоящей студии."
  },
  {
    h2: "Инструменты которые изучаем",
    text: "На занятиях используем три инструмента — выбор зависит от возраста и задачи:",
    list: [
      "Tinkercad (для начинающих 10–11 лет): браузерный конструктор от Autodesk. Идеален как первый шаг — собираем модели из готовых фигур, экспортируем STL для печати. Нет сложного интерфейса",
      "Blender (основной курс 11–14 лет): полноценный профессиональный 3D-редактор. Моделирование, скульптинг, UV-развёртка, риггинг, рендеринг. Бесплатный навсегда",
      "Экспорт STL/OBJ: из любого инструмента экспортируем в формат для 3D-печати. STL — для принтеров, OBJ — для игровых движков (Unity, Unreal)",
      "Render: финальный рендер в Cycles или EEVEE — красивая картинка которую можно поставить фоном или показать в портфолио"
    ]
  },
  {
    h2: "Программа 3D-моделирования",
    text: "Дизайн-курс адаптирован под детскую логику: группы до 8 человек, каждый идёт в своём темпе, опыт не нужен — от первой фигуры до финальной модели за смену. Лагерь для новичков: сложные термины заранее учить не нужно.",
    list: [
      "Интерфейс Blender — первые шаги, горячие клавиши, навигация",
      "Примитивы и моделирование — куб, сфера, расширенные формы",
      "Материалы и текстуры — основы 3D-дизайна: как сделать модель «живой»",
      "Освещение и камера — основы визуализации",
      "Подготовка к 3D-печати — экспорт STL для печати дома или через online-сервис",
      "Финальная презентация — защита модели перед группой"
    ]
  },
  {
    h2: "Что создадут за смену 3D-моделирования",
    text: "Финальный проект в лагере у каждого свой — ребята сами выбирают что моделируют. Примеры реальных работ прошлых смен:",
    list: [
      "3D-персонаж для игры: робот, рыцарь, существо с рогами — с UV-разверткой и текстурами, готовый к импорту в Unity",
      "Простая сцена: стол с лампой, рабочий кабинет, уютная комната — работа со светом, материалами, постобработкой в Compositor",
      "Анимация: 3–5-секундный ролик с движущимся персонажем или механизмом — собственное мини-кино",
      "Персонаж для 3D-печати: STL-файл оптимизирован для принтера — печать проходит без ошибок, поддержки настроены, масштаб выверен",
      "Архитектурный объект: башня, мост, дом — чертёж в 3D, рендер как портфолио-работа"
    ]
  },
  {
    h2: "Что уносят школьники из смены 3D",
    text: "За 10–14 дней в лагере на смене ребята получают не абстрактный «опыт», а конкретные результаты которые показывают прогресс.",
    list: [
      "Собственная 3D-модель готовая к печати — STL-файл для online-сервиса или домашнего принтера",
      "Практический результат — не только файл, но и навык, который пригодится в будущей профессии: геймдев, дизайн, архитектура или кино",
      "Рендеры работ — красивые картинки, которые можно показать друзьям или поставить фоном",
      "Навык работы в Blender — можно продолжить учиться дома (бесплатно)",
      "Сертификат об участии — для портфолио",
      "Понимание профессии 3D-художника — видение куда дальше развиваться"
    ]
  },
  {
    h2: "Запись на смену — осталось мало мест",
    text: "3D-моделирование — один из немногих треков, где мест изначально меньше: нужны мощные ноутбуки для Blender. Лагерь небольшой: группы до 8 человек, места заканчиваются быстро — уточняйте наличие при бронировании."
  },
];

const SCHOOL_CONTINUE_LINKS = [
  { href: 'https://codims.ru/courses/blender/?utm_source=aidacamp&utm_medium=crosslink&utm_campaign=3d-modelirovanie-lager', label: 'Курс 3D-моделирования в Blender' },
];

---

<LandingLayout
  heroImage="/images/hero/3d-modelirovanie-lager.avif"
  title="3D-моделирование и дизайн для детей | АйДаКемп"
  description={`3D-моделирование и дизайн в Blender для детей. Своя модель, рендеры. От ${PRICE_MIN}.`}
  h1="3D-моделирование"
  canonical="https://aidacamp.ru/3d-modelirovanie-lager"
  breadcrumb="3D-моделирование"
>
  <Fragment slot="head">
    <CourseSchema
      name="3D-моделирование и дизайн для детей — Blender с нуля"
      description="АйДаКемп: 3D-моделирование для детей 10–14 лет: Blender с нуля до готовой модели, экспорт в STL для печати дома. За 7 или 14 дней."
      url="https://aidacamp.ru/3d-modelirovanie-lager"
      level="Beginner"
      ageMin={10}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="3D-моделирование"
    subtitle="Blender с нуля. За 10–14 дней ребёнок создаёт свою 3D-модель и рендеры — готовый STL-файл можно распечатать дома или через online-сервис."
    breadcrumb="3D-моделирование"
    keywords={["Blender — профессиональный 3D-редактор для дизайна и моделирования, бесплатный", "Цифровая модель + рендеры + STL для печати дома", "10–14 лет, группы до 8 человек"]}
    image="/images/hero/3d-modelirovanie-lager.avif"
    imageAlt="3D-моделирование для детей — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts slim />
  <SchoolContinue links={SCHOOL_CONTINUE_LINKS} />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
    { q: "Что такое лагерь 3D-моделирования для детей?", a: "Летний лагерь с проживанием, где дети учатся 3D-моделированию в Blender. За 10–14 дней ребёнок создаёт собственную 3D-модель, рендеры и готовый STL-файл для печати дома." },
    { q: "С какого возраста подходит программа 3D-моделирования?", a: "С 10 лет. АйДаКемп принимает детей 10–14 лет на трек 3D-моделирования. Предварительные знания не нужны — начинаем с нуля." },
    { q: "Чему учатся дети на смене 3D-моделирования?", a: "Дети осваивают Blender — профессиональный 3D-редактор (бесплатный, используется в геймдеве и кино). Создают 3D-модели: персонажей, объекты, архитектуру. На выходе — готовый файл для 3D-печати дома или через online-сервис." },
    { q: "Что ребёнок увезёт домой после смены 3D-моделирования?", a: "Цифровую 3D-модель + рендеры + STL-файл для печати, навыки работы в профессиональном инструменте Blender. Распечатать модель можно дома (если есть принтер) или через online-сервис 3D-печати." }
  ]} />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — что это и зачем", url: "/stati/3d-modelirovanie-dlya-detej/", description: "Что такое 3D-моделирование, зачем учить и с чего начать ребёнку.", icon: "file-earmark-text" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Нулевой опыт — норма. Дорожная карта по возрастам.", icon: "braces" },
    { title: "Социализация ребёнка на смене — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere/", description: "Как групповые проекты развивают навыки командной работы.", icon: "people" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
