---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Раменского до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 90 км от Раменского. Маршрут: Новорязанское шоссе → МКАД → Калужское шоссе, время в пути 1.5–2 часа. Организованный трансфер отправляется от м. Солнцево — от Раменского до Солнцево можно доехать через Люберцы или на электричке."
  },
  {
    h2: "Почему родители из Раменского выбирают АйДаКемп",
    text: "Раменское — юго-восток Подмосковья, и до АйДаКемп удобно добраться через МКАД на Калужское шоссе. Никакого перелёта и акклиматизации: ребёнок в Подмосковье, в том же климате. За смену — реальный IT-проект, бассейн и загородный отдых.",
    list: [
      "~90 км по Новорязанскому → МКАД → Калужскому шоссе",
      "1.5–2 часа в пути, трансфер от м. Солнцево",
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Раменского",
    text: "В АйДаКемп едут дети со всего юго-востока Подмосковья. Вот что говорят семьи из Раменского:",
    list: [
      "«Час на машине через МКАД, и сын на месте. Вернулся с кодом и командой друзей. Спрашивает, когда снова» — Николай, Раменское",
      "«Боялась, что далеко. Но дочь доехала на трансфере, написала в WhatsApp что всё хорошо — и я успокоилась» — Ксения, Раменское"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагерь в Подмосковье Раменское 2026 — АйДаКемп"
  description="IT-лагерь рядом с Раменским: 1.5–2 часа через МКАД и Калужское шоссе. Python, AI, Minecraft для детей 7–15 лет. Санаторий Изумруд. От 48 000 ₽."
  h1="Лагерь в Подмосковье рядом с Раменским"
  canonical="https://aidacamp.ru/lager-ramenskoe"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Раменского до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Раменского ~90 км: Новорязанское шоссе → МКАД → Калужское шоссе, 1.5–2 часа. Трансфер от м. Солнцево (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Раменского до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов по Новорязанскому шоссе, МКАД и Калужскому шоссе. Расстояние ~90 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Раменского?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер от м. Солнцево (2 500 ₽). Из Раменского можно добраться до Солнцево через Люберцы или на электричке." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="IT-лагерь в Подмосковье рядом с Раменским — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5–2 часа от Раменского. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-ramenskoe"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь в Подмосковье рядом с Раменским"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч от Раменского через МКАД и Калужское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Раменского"
    keywords={["~1.5 ч от Раменского через МКАД и Калужское шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Лагерь в Подмосковье рядом с Раменским — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
