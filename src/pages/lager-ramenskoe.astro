---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Раменского до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 110 км от Раменского, ~1 ч 25 мин. Маршрут на электричке: электричка Казанского направления → Казанский вокзал → метро до м. Солнцево → организованный трансфер АйДаКемп (2 000 ₽). На машине: Новорязанское шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево."
  },
  {
    h2: "Рядом аэродром Жуковский — IT это логичный следующий шаг",
    text: "Раменское стоит рядом с аэродромом Жуковский и ЦАГИ. Авиация, инженерия, технологии — это атмосфера города. Многие родители здесь понимают: IT сегодня — это такая же профессия будущего, как авиация 50 лет назад. В АйДаКемп ребята не просто учатся — они создают собственный проект и защищают его на хакатоне в последний день смены.",
    list: [
      "Электричка Казанского направления → м. Солнцево → трансфер",
      "~110 км, ~1 ч 25 мин — быстрее, чем добраться до многих курортов",
      "Группы до 8 человек, практикующие IT-специалисты",
      "Итоговый хакатон — каждый участник защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Ежедневные фото из лагеря в Telegram-чат отряда — родители всегда в курсе.",
    list: [
      "1 преподаватель : 6–8 участников смены",
      "Медработник 24/7, охрана, закрытая территория",
      "Фото в Telegram каждый день — не нужно гадать, как дела",
      `Лицензия Минобрнауки, налоговый вычет до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Открыты августовские смены — места ещё есть",
    text: "Летние смены раскупают быстро, самый ходовой сезон уже позади. Сейчас открыты августовские смены. Если нужны конкретные даты — лучше забронировать сейчас.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Отзывы родителей из Раменского",
    text: "В АйДаКемп едут со всего юго-востока Подмосковья. Вот что говорят семьи из Раменского:",
    list: [
      "«Час на машине через МКАД, и сын на месте. Вернулся с кодом и командой друзей. Спрашивает, когда снова» — Николай, Раменское",
      "«Боялась, что далеко. Но дочь доехала на трансфере, написала что всё хорошо — и я успокоилась» — Ксения, Раменское"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагерь в Подмосковье Раменское 2026 — АйДаКемп"
  description={`IT-лагерь рядом с Раменским: 1.5 часа через МКАД и Киевское шоссе. Python, AI, Minecraft для ребят 7–15 лет. Санаторий Изумруд. От ${PRICE_MIN}.`}
  h1="Лагерь в Подмосковье рядом с Раменским"
  canonical="https://aidacamp.ru/lager-ramenskoe"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Раменского до лагеря АйДаКемп?", a: "Из Раменского ~110 км, ~1.5 часа: электричка Казанского направления до Казанского вокзала, затем метро до м. Солнцево и трансфер АйДаКемп (2 000 ₽). На машине: Новорязанское шоссе → МКАД → Киевское шоссе." },
    { q: "Сколько ехать из Раменского до лагеря?", a: "Около 1.5 часов — ~110 км по Новорязанскому шоссе, МКАД и Киевскому шоссе. На электричке + трансфере примерно столько же." },
    { q: "Есть ли трансфер из Раменского?", a: "Организованный трансфер от м. Солнцево (2 000 ₽). Из Раменского удобно добраться на электричке Казанского направления до Москвы, затем метро до Солнцево." },
    { q: "Сколько стоит путёвка?", a: `Открыты к брони августовские смены: от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. В стоимость входит проживание, питание, IT-программа, бассейн.` }
  ]} />
    <CourseSchema
      name="IT-лагерь в Подмосковье рядом с Раменским — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Раменского. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-ramenskoe"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь в Подмосковье рядом с Раменским"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч от Раменского через МКАД и Киевское шоссе. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Раменского"
    keywords={["~1.5 ч от Раменского через МКАД и Киевское шоссе", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Лагерь в Подмосковье рядом с Раменским — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
