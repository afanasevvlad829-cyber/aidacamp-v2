---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Электростали до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе Московской области. Из Электростали ехать около 1.5 часа: по Горьковскому шоссе до МКАД, затем по МКАД на юго-запад и далее по Киевскому шоссе (M-3) до посёлка Атепцево. Расстояние около 95 км. Удобнее всего — добраться до м. Солнцево (около 50 минут на электричке и метро) и сесть на организованный трансфер АйДаКемп."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Электросталью",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Электростали выбирают АйДаКемп",
    text: "1.5 часа от Электростали — и ребёнок в лагере с лицензией Минобрнауки и рейтингом 5.0. Вот что важно для родителей:",
    list: [
      "Подмосковье — привычный климат, никакой акклиматизации",
      "Трансфер от м. Солнцево — добраться из Электростали можно на электричке",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Можно приехать в любой день смены — проведать ребёнка"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 000 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Электростали и востока Подмосковья",
    text: "В АйДаКемп едут дети из Электростали, Ногинска, Балашихи и других городов востока Подмосковья:",
    list: [
      "«Ехали электричкой до Курского, потом метро до Солнцево — и автобус лагеря. Дочь вернулась с проектом на Python, которым сразу похвасталась в школе» — Светлана, Электросталь",
      "«Сын после лагеря сам попросил записать его на курс по AI. Раньше только в игры просился» — Михаил, Ногинск"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь рядом с Электросталью 2026 — IT | АйДаКемп"
  description="Детский IT-лагерь рядом с Электросталью — ~1.5 ч через Горьковское шоссе → МКАД → Киевское. Python, AI, Minecraft. От 48 000 ₽."
  h1="Детский лагерь рядом с Электросталью"
  canonical="https://aidacamp.ru/lager-elektrostal"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Электростали до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Электростали до лагеря около 95 км и ~1.5 часа езды: по Горьковскому шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или добраться до м. Солнцево и сесть на организованный трансфер АйДаКемп (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Электростали?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Электростали нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Электростали удобно добраться на электричке до Курского вокзала, затем на метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для поступления в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Электростали?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Электросталью — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Электростали. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-elektrostal"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Электросталью"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Электростали через МКАД → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Электростали"
    keywords={["~1.5 ч из Электростали через МКАД → Киевское шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Электросталью — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
