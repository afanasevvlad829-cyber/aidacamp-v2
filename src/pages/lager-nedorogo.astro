---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { CAMP_PRICE_FROM } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Сколько стоит смена в лагере АйДаКемп",
    text: "Цена смены зависит от длительности. Короткие 7–8-дневные смены — самые бюджетные, длинные 13–14-дневные — дороже, но стоимость одного дня получается ниже за счёт фикс-компонентов (проживание, логистика). Все цены указаны за ребёнка, включают проживание, 5-разовое питание, полную IT-программу и досуг. Трансфер — отдельная опция. Без скрытых доплат.",
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} — 7 дней, ${DATES_SHORT_S21} — <b>${PRICE_MIN}</b> (самая бюджетная)`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} — 8 дней, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} — 10 дней, ${DATES_S1} — <b>${PRICE_S4}</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} — 14 дней, ${DATES_SHORT_S2} — <b>${PRICE_MAX}</b> (самая популярная, часто полная)`
    ]
  },
  {
    h2: "Анатомия цены — из чего складывается стоимость",
    text: `Когда мама сравнивает «${PRICE_MIN} за 7 дней» с «25 000 ₽ за 7 дней» в другом лагере — обычно разница не в наценке, а в том, что входит. Мы разбиваем нашу цену на честные компоненты, чтобы вы видели реально, за что платите.`,
    list: [
      "<b>Проживание + 5-разовое питание</b> (бытовая часть) — около 3 800 ₽/день. Это комната на 2–4 человека с санузлом, 5 приёмов пищи с учётом аллергий, уборка, стирка",
      "<b>Образовательная программа</b> — 2 раза в день по 90 минут с преподавателями-практиками (Python, AI, Minecraft, 3D). Именно эта часть даёт право на налоговый вычет 13%",
      "<b>Инфраструктура</b> — бассейн (через день), спорт, командные активности, все материалы и оборудование (ноутбуки, 3D-принтер — ребёнок свою технику не везёт)",
      "<b>Безопасность</b> — охрана 24/7, медработник круглосуточно, вожатые 1:8",
      "<b>Коммуникация с родителями</b> — ежедневные фото и сообщения в родительском канале"
    ]
  },
  {
    h2: "Разумная цена vs «дёшево» — в чём разница",
    text: "Мы не говорим «дёшево» — потому что честно ценим то, что предлагаем. Мы говорим «разумная цена за то, что включено». Разберём конкретно:",
    list: [
      "<b>IT-кружок в Москве:</b> ~3 500 ₽/занятие × 10 занятий = 35 000 ₽ за занятия без питания, проживания и оборудования",
      `<b>АйДаКемп 7 дней:</b> ${PRICE_MIN} = 14 занятий + 35 ночей проживания + 35 приёмов пищи + бассейн + техника + охрана`,
      "<b>Итог на занятие:</b> в кружке ~3 500 ₽ за час, у нас ~1 700 ₽ за полтора часа — и это уже со всем «вокруг»",
      "<b>«Дешёвые» лагеря 25–35 тыс. ₽:</b> занятия «по 30 минут от вожатых», своя техника, без образовательной лицензии → нет вычета",
      "<b>Образовательная лицензия Минобрнауки</b> — даёт право на возврат 13%. Без лицензии — вычет невозможен"
    ]
  },
  {
    h2: "Способы оплаты и честная экономия",
    text: "Все платежи официальные, через юр.лицо, с договором и квитанцией. Без переводов на карту и «оплатим потом». Выберите удобный способ:",
    list: [
      "<b>100% единовременно</b> — стандартный способ. По договору, с чеком и полным пакетом документов для вычета",
      "<b>50% предоплата</b> при бронировании, остаток — за 3 недели до начала смены",
      "<b>Банковский перевод / карта онлайн / СБП</b> — все популярные способы",
      "<b>Корпоративная оплата от работодателя</b> — выставляем счёт-фактуру + акт. Многие компании включают детские путёвки сотрудникам в соцпакет"
    ]
  },
  {
    h2: `Налоговый вычет 13% — минус до ${VYCHET_MAX} с одного ребёнка`,
    text: `АйДаКемп работает по лицензии Минобрнауки, поэтому образовательная часть путёвки (не вся путёвка, только обучение) даёт право на налоговый вычет. Как считается: стоимость путёвки минус бытовая часть (проживание + питание) = образовательная часть. Например, ${PRICE_MAX} − 53 200 ₽ = 41 800 ₽ образовательной базы → 13% × 41 800 = <b>${VYCHET_MAX} возврата</b>. Лимит НК РФ — 110 000 ₽/год, наши смены в него легко укладываются. Расчёт под вашу смену — в калькуляторе ниже.`,
    list: [
      "После оплаты высылаем пакет документов: договор, чек, копия лицензии",
      "Декларация 3-НДФЛ через личный кабинет на nalog.ru — 15–20 минут",
      "Сканы документов прикладываются в декларацию",
      "Проверка ФНС — до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Альтернатива — через работодателя: возврат идёт через зарплату сразу, без ожидания года"
    ]
  },
  {
    h2: "Когда реально выгодно бронировать",
    text: "Цены на смены зафиксированы на 2026 год — они не меняются до начала сезона. Но доступность уходит быстро: в апреле свободно 60–80% мест, в мае остаётся 20–30%, в июне популярные смены полностью закрыты. Поэтому «сэкономить» = «успеть» на нужную вам смену до того, как её закроют. После бронирования цена не растёт — договор фиксирует всё.",
    list: [
      `Самая бюджетная — ${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (7 дней, ${PRICE_MIN}). Хороший вход для «первый раз в лагере»`,
      `Самая популярная — ${shiftLinkHtml('shift-2', 'Смена 2')} (14 дней, ${PRICE_MAX}). Закрывается за 2–3 месяца до старта`,
      `Короткая ${shiftLinkHtml('shift-2-2', 'Смена 2.2')} (8 дней, ${PRICE_S22}) — для тех кто сомневается ехать ли ребёнку на две недели`,
      `Августовская ${shiftLinkHtml('shift-4', 'Смена 4')} (10 дней, ${PRICE_S4}) — успеть перед 1 сентября`
    ]
  },
  {
    h2: "Что входит в стоимость — полный список",
    text: "В цену путёвки включено всё необходимое на смене. То, что часто забывают учитывать при сравнении с «бюджетными» лагерями — у нас уже внутри цены.",
    list: [
      "Проживание в комнатах по 2–4 человека с санузлом и душем",
      "5-разовое питание (завтрак, 2-й завтрак, обед, полдник, ужин) с учётом аллергий",
      "Образовательная программа: 2 раза в день по 90 минут (Python, AI, Minecraft, 3D, робототехника) с преподавателями",
      "Бассейн с ионизированной водой — через день, спорт и активности каждый день",
      "Охрана 24/7 на территории, медработник круглосуточно",
      "Вожатые 1:8, авторы учебников по программированию для детей",
      "Всё оборудование и материалы (ноутбуки, 3D-принтер, инструменты) — ребёнок свою технику не везёт",
      "Ежедневные фото и сообщения в родительском канале",
      "Итоговый хакатон и защита проекта перед участниками"
    ]
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что вне цены, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция. Организованный автобус от партнёра, сбор у м. Солнцево. Бронируется вместе с путёвкой",
      "<b>Страховка</b> — рекомендуем оформить отдельно. Причина: по нашему договору выгодоприобретателем является ребёнок через законных представителей; свой полис даёт родителям прямой контроль над суммами и процедурой выплат",
      "<b>Дополнительные экскурсии за территорию</b> — редко, по желанию группы, оплачиваются отдельно",
      "<b>Карманные деньги ребёнка</b> — по вашему усмотрению, часть отдаёт вожатому на хранение"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title="Недорогой детский лагерь на лето 2026 — Подмосковье | АйДаКемп"
  description={`Детский лагерь в Подмосковье от ${PRICE_MIN} на 7 дней — всё включено. Python, AI, бассейн, питание, 66 км от Москвы. Возраст 7–15 лет. Вычет 13%.`}
  h1="Недорогой лагерь на лето 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какой самый недорогой вариант лагеря в 2026 году?", a: `Смена 2.1 — 7 дней, ${DATES_SHORT_S21}, ${PRICE_MIN}. Включает всё: проживание, питание, IT-программу и бассейн.` },
    { q: "Можно ли оплатить лагерь в рассрочку?", a: "Да: 50% при бронировании, остаток за 3 недели до смены. Без банков и переплат." },
    { q: "Есть ли скидки на детский лагерь?", a: "Возврат 13% через налоговый вычет. Ранняя бронь фиксирует текущую цену." },
    { q: "Что входит в минимальную стоимость путёвки?", a: "Проживание, 5-разовое питание, IT-программа, бассейн. Без скрытых доплат." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Недорогой лагерь на лето 2026 в Подмосковье"
    subtitle={`От ${CAMP_PRICE_FROM} за 7-дневную смену — самый доступный IT-лагерь в Подмосковье. Проживание, питание, программа включены. Без скрытых доплат.`}
    breadcrumb="Лагерь недорого"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа включены`, "Лагерь недорого: короткие смены от 7 дней", "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 7-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа — всё включено",
      `Минус до ${VYCHET_MAX} через налоговый вычет 13% (с 14-дневной смены)`,
      "Возврат 50% если не подошло в первые 3 дня",
      "Бронь на 72 часа без предоплаты",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
