---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_MAX, DAYS_MIN, DAYS_S1, DAYS_S2, DAYS_S21, DAYS_S22, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_MAX_DAYS, daysAdj } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { CAMP_PRICE_FROM, STAT_RATING, STAT_RATING_INCAMP } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';

const sections = [
  {
    h2: "Сколько стоит детский лагерь АйДаКемп",
    text: `Цену мы считаем по длительности смены — чем она длиннее, тем ниже стоимость дня. В неё включены проживание, 5-разовое питание и IT-программа. Лето уже позади, но новый сезон впереди. Трансфер в лагерь — отдельная опция, скрытых доплат нет. Лагерь находится в Подмосковье, поэтому заехать на день открытых дверей — не проблема.`,
    list: [
      `${shiftLinkHtml('shift-4', 'Смена 4')} — ${DAYS_S4}, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — ${DAYS_S3}, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b>`
    ]
  },
  {
    h2: "Анатомия цены — из чего складывается стоимость",
    text: `Когда мама сравнивает «${PRICE_MIN} за ${DAYS_MIN}» с «25 000 ₽ за неделю» у других детских центров — разница в том, что входит в цену.`,
    list: [
      "<b>Проживание и питание</b> — около 3 800 ₽/день: комната на 2–4 человека с санузлом, 5-разовое питание с учётом аллергий",
      "<b>Образовательная программа</b> — 2 занятия в день по 90 минут (Python, AI, Minecraft, 3D). Эта часть даёт право на налоговый вычет 13%",
      "<b>Инфраструктура лагеря</b> — бассейн через день, спорт, ноутбуки, 3D-принтер",
      "<b>Безопасность</b> — охрана 24/7, медработник и вожатые 1:8 на территории лагеря"
    ]
  },
  {
    h2: "Способы оплаты и честная экономия",
    text: "Оплата смены в лагере — официально, через юр.лицо, с договором и квитанцией. Единовременно или в рассрочку — как удобнее.",
    list: [
      "<b>100% единовременно</b> — с чеком и полным пакетом документов для вычета",
      "<b>50% предоплата</b> при бронировании, остаток — за 3 недели до заезда",
      "<b>Оплата от работодателя</b> — выставляем счёт и акт",
      "<b>Что не меняется:</b> лагерь не поднимает цену смены после оплаты"
    ]
  },
  {
    h2: `Налоговый вычет 13% — минус до ${VYCHET_MAX} с одного ребёнка`,
    text: `АйДаКемп — лагерь с лицензией Минобрнауки, поэтому образовательная часть путёвки даёт право на налоговый вычет 13%. Для Смены 3 (${DAYS_MAX}): ${PRICE_MAX} − 49 400 ₽ = 40 000 ₽ базы → 13% = <b>${VYCHET_MAX} возврата</b>. Точный расчёт — в калькуляторе выше.`,
    list: [
      "После оплаты высылаем договор, чек и копию лицензии",
      "Декларация 3-НДФЛ через nalog.ru — 15–20 минут",
      "Через работодателя — возврат идёт сразу через зарплату"
    ]
  },
  {
    h2: "Что входит в стоимость лагеря — полный список",
    text: "В цену путёвки включено всё необходимое в лагере.",
    list: [
      "Проживание в лагере по 2–4 человека с санузлом и 5-разовое питание",
      "IT-программа: 2 занятия в день по 90 минут",
      "Бассейн через день, спорт и активности в лагере",
      "Охрана 24/7, медработник круглосуточно, вожатые 1:8",
      "Итоговый хакатон — финал смены в лагере"
    ]
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что лагерь не включает в цену.",
    list: [
      "<b>Трансфер из Москвы</b> — опция, сбор у м. Солнцево",
      "<b>Страховка лагеря</b> — рекомендуем отдельно",
      "<b>Карманные деньги</b> — берите в лагерь сумму на ваше усмотрение"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title={`Недорогой лагерь для детей — Подмосковье, рассрочка | АйДаКемп`}
  description={`Детский лагерь в Подмосковье ${SEASON_YEAR} от ${PRICE_MIN} за ${DAYS_MIN} — всё включено, доплат нет. Python, AI, Minecraft, бассейн, 5-разовое питание, 66 км от Москвы. Рассрочка 50/50, налоговый вычет 13%.`}
  h1={`Недорогой лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-nedorogo"
  breadcrumb="Цены и скидки"
>
  <LandingHero slot="hero"
    h1={`Недорогой лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle={`От ${CAMP_PRICE_FROM} за 10-дневную смену — очень доступный детский IT-лагерь в Подмосковье. Проживание, питание, программа включены.`}
    breadcrumb="Цены и скидки"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа смены включены`, "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 10-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа — всё включено",
      `Минус до ${VYCHET_MAX} через налоговый вычет 13% (с ${daysAdj(VYCHET_MAX_DAYS, 'gen')} Смены 3)`,
      '<a href="/politika-vozvrata/">Гарантия и условия возврата →</a>',
      "Бронь на 72 часа без предоплаты",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: `Какая летняя смена ${SEASON_YEAR} года была самой недорогой?`, a: `Смена 4: ${DAYS_S4}, ${DATES_SHORT_S4}, ${PRICE_S4}, всё включено. Июньские короткие смены стоили от ${PRICE_S21}. Все летние смены завершились.` },
    { q: "Можно ли оплатить путёвку в рассрочку?", a: "Да: 50% при бронировании, остаток за 3 недели до смены. Без банков и переплат." },
    { q: "Есть ли скидки на путёвку?", a: "Возврат 13% через налоговый вычет. Цена смены у нас фиксируется сразу при ранней брони." },
    { q: "Что входит в минимальную стоимость путёвки?", a: "Проживание, 5-разовое питание, IT-программа, бассейн. Все расходы на смену — в одном чеке, без скрытых доплат." }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
