---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingContent from '../components/LandingContent.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import LeadForm from '../components/LeadForm.astro';

const sections = [
  {
    h2: "Сколько стоит лагерь АйДаКемп",
    text: "Стоимость смены зависит от продолжительности. Все цены включают проживание в комнатах по 2–4 человека, 5-разовое питание, полную IT-программу и все активности. Трансфер — платная опция. Скрытых доплат нет.",
    list: [
      "Смена 2.1 — 7 дней (10–16 июня) — 48 000 ₽",
      "Смена 2.2 — 8 дней (16–23 июня) — 65 000 ₽",
      "Смена 1 — 10 дней (30 мая–8 июня) — 74 900 ₽",
      "Смена 4 — 10 дней (17–26 августа) — 69 600 ₽",
      "Смена 3 — 13 дней (3–15 августа) — 89 400 ₽",
      "Смена 2 — 14 дней (10–23 июня) — 95 000 ₽"
    ]
  },
  {
    h2: "Что входит в стоимость путёвки",
    text: "Цена смены АйДаКемп — это полная стоимость без сюрпризов.",
    list: [
      "Проживание в корпусе — комнаты по 2–4 человека с санузлом",
      "Питание 5 раз в день — завтрак, 2й завтрак, обед, полдник, ужин",
      "Полная IT-программа — Python, AI, Minecraft по возрасту",
      "Бассейн, спорт, командные активности каждый день",
      "Охрана 24/7, медработник на смене"
    ]
  },
  {
    h2: "Как купить путёвку в лагерь",
    text: "Оставьте заявку на сайте — перезвоним в течение 10 минут в рабочее время (11:00–20:00 МСК). Обсудим возраст ребёнка, выберем смену, зафиксируем место. Оплата по договору — безопасно и прозрачно. Работаем как лицензированный туроператор (РТО 025773)."
  },
  {
    h2: "Налоговый вычет 13%",
    text: "Стоимость образовательных услуг лагеря можно частично компенсировать через налоговый вычет — до 13% от суммы. Предоставляем все необходимые документы: договор, акт, чеки. Уточните детали при оформлении заявки."
  }
];

const relatedPages = [
  { title: "Смены и даты", url: "/#shifts", icon: "bi-calendar-event", description: "Все смены 2026" },
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove", icon: "bi-tree", description: "Расположение, условия" },
  { title: "Для компаний", url: "/dlya-kompaniy", icon: "bi-building", description: "Корпоративные путёвки" },
];
---

<LandingLayout
  title="Летний лагерь недорого в Подмосковье 2026 — цены и путёвки | АйДаКемп"
  description="Летний детский лагерь от 48 000 ₽ за 7 дней. Подмосковье, IT-программа, проживание и питание включены. Смены июнь–август 2026. Рассрочка доступна."
  h1="Летний лагерь в Подмосковье — цены 2026"
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <LandingHero
    h1="Летний лагерь в Подмосковье — цены 2026"
    subtitle="От 48 000 ₽ за 7-дневную смену. Проживание, питание, IT-программа — всё включено. Без скрытых доплат."
    breadcrumb="Цены и путёвки"
    keywords={["От 48 000 ₽ за смену — проживание, питание, программа включены", "Смены от 7 до 14 дней — выбери подходящую", "Фиксация цены на 72 часа — возврат если не понравится"]}
  />
  <LandingContent sections={sections} />
  <Shifts />
  <FAQ />
  <RelatedPages pages={relatedPages} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
