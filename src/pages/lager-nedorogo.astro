---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Сколько стоит лагерь АйДаКемп",
    text: "Стоимость смены зависит от продолжительности. Все цены включают проживание в комнатах по 2–4 человека, 5-разовое питание, полную IT-программу и все активности. Трансфер — платная опция. Скрытых доплат нет.",
    list: [
      "Смена 2.1 — 7 дней (10–16 июня) — 48 000 ₽",
      "Смена 2.2 — 8 дней (16–23 июня) — 65 000 ₽",
      "Смена 1 — 10 дней (30 мая–8 июня) — 74 900 ₽",
      "Смена 4 — 10 дней (17–26 августа) — 69 600 ₽",
      "Смена 3 — 13 дней (3–15 августа) — 89 400 ₽",
      "Смена 2 — 14 дней (10–23 июня) — 95 000 ₽"
    ]
  },
  {
    h2: "Что входит в стоимость путёвки",
    text: "Цена смены АйДаКемп — это полная стоимость без сюрпризов.",
    list: [
      "Проживание в корпусе — комнаты по 2–4 человека с санузлом",
      "Питание 5 раз в день — завтрак, 2й завтрак, обед, полдник, ужин",
      "Полная IT-программа — Python, AI, Minecraft по возрасту",
      "Бассейн, спорт, командные активности каждый день",
      "Охрана 24/7, медработник на смене"
    ]
  },
  {
    h2: "Как купить путёвку в лагерь",
    text: "Оставьте заявку на сайте — перезвоним в течение 10 минут в рабочее время (11:00–20:00 МСК). Обсудим возраст ребёнка, выберем смену, зафиксируем место. Оплата по договору — безопасно и прозрачно. Работаем как лицензированный туроператор (РТО 025773)."
  },
  {
    h2: "Налоговый вычет 13%",
    text: "Стоимость образовательных услуг лагеря можно частично компенсировать через налоговый вычет — до 13% от суммы. Предоставляем все необходимые документы: договор, акт, чеки. Уточните детали при оформлении заявки."
  },
  {
    h2: "Как оформить налоговый вычет — пошагово",
    text: "Налоговый вычет за обучение доступен, если услуга лицензированная (у нас — да). Возврат работает как за ребёнка так и на взрослого. Коротко что делать:",
    list: [
      "Собрать документы: договор с АйДаКемп + акт выполненных работ + платёжное поручение/чек (мы их выдаём при оформлении)",
      "Заполнить декларацию 3-НДФЛ — можно онлайн через личный кабинет на nalog.ru или мобильное приложение «Налоги ФЛ»",
      "Приложить отсканированные документы в декларацию",
      "Отправить и ждать — проверка ФНС до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Лимит на обучение ребёнка — 110 000 ₽/год на одного ребёнка, то есть максимум вернут 14 300 ₽ (13% от 110 000)"
    ]
  },
  {
    h2: "Как сэкономить ещё больше — 4 реальных способа",
    text: "Даже по сравнению с дешёвыми лагерями наша цена конкурентна, но можно получить дополнительную скидку. Вот что предлагаем семьям:",
    list: [
      "Ранняя бронь до 1 мая — цены текущие. После 1 мая — на 10–15% выше. Каждая неделя ожидания = деньги на ветер",
      "Скидка за второго ребёнка в семье — минус 10% на путёвку младшего / старшего ребёнка из одной семьи",
      "Рассрочка без переплаты — разбить сумму на 3–6 платежей через банк-партнёр",
      "Программа «пригласи друга» — если ваш знакомый оплачивает смену по вашей рекомендации, вы получаете 5 000 ₽ возврата на карту"
    ]
  },
  {
    h2: "Что ещё входит кроме проживания и занятий",
    text: "В цену путёвки включены не только очевидные пункты (еда, кровать, IT-программа), но и все «мелочи» о которых обычно забывают при расчёте общей стоимости отдыха. По нашему опыту — это порядка 10–15 тыс. ₽ дополнительных расходов, которые родители не платят в других лагерях только потому что эти услуги там отсутствуют вообще.",
    list: [
      "Страховка от несчастного случая на весь срок смены",
      "Медицинское сопровождение — медработник и аптечка первой помощи 24/7",
      "Все материалы для занятий — ноутбуки, доски, принтер, 3D-принтер. Ребёнок не везёт свой ноутбук",
      "Одноразовая форма, бейдж, рюкзак АйДаКемп на память",
      "Сертификат и фотоотчёт смены — все фото на Яндекс.Диск доступны родителям после смены",
      "Финальный хакатон с подарочной атрибутикой (медали, грамоты)"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title="Летний лагерь недорого в Подмосковье 2026 — цены и путёвки | АйДаКемп"
  description="Летний детский лагерь от 48 000 ₽ за 7 дней. Подмосковье, IT-программа, проживание и питание включены. Смены июнь–август 2026. Рассрочка доступна."
  h1="Летний лагерь в Подмосковье — цены 2026"
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <LandingHero slot="hero"
    h1="Летний лагерь в Подмосковье — цены 2026"
    subtitle={`От ${CAMP_PRICE_FROM} за 7-дневную смену. Проживание, питание, IT-программа — всё включено. Без скрытых доплат.`}
    breadcrumb="Цены и путёвки"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа включены`, "Смены от 7 до 14 дней — выбери подходящую", "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 7-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа",
      "Смены от 7 до 14 дней",
      "Возврат 50% в первые 3 дня",
      "Лицензированный туроператор РТО 025773",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
