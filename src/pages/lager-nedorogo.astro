---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { CAMP_PRICE_FROM, STAT_RATING } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Сколько стоит детский лагерь АйДаКемп",
    text: "Цена смены зависит от длительности. Стоимость одного дня в длинных сменах ниже за счёт фикс-компонентов (проживание, логистика). Все цены указаны на одного участника смены и включают проживание, 5-разовое питание, полную IT-программу и досуг. Июньские смены уже завершились — открыты к брони августовские. Трансфер — отдельная опция. Без скрытых доплат.",
    list: [
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b>`,
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (завершена) — 7 дней, ${DATES_SHORT_S21} — <b>${PRICE_S21}</b>`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} (завершена) — 8 дней, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} (завершена) — 10 дней, ${DATES_S1} — <b>${PRICE_S1}</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} (завершена) — 14 дней, ${DATES_SHORT_S2} — <b>${PRICE_S2}</b>`
    ]
  },
  {
    h2: "Анатомия цены — из чего складывается стоимость",
    text: `Когда мама сравнивает «${PRICE_MIN} за 10 дней» с «25 000 ₽ за неделю» в другом лагере — обычно разница не в наценке, а в том, что входит. Мы разбиваем нашу цену на честные компоненты, чтобы вы видели реально, за что платите.`,
    list: [
      "<b>Проживание + 5-разовое питание</b> (бытовая часть) — около 3 800 ₽/день. Это комната на 2–4 человека с санузлом, 5 приёмов пищи с учётом аллергий, уборка, стирка",
      "<b>Образовательная программа</b> — 2 раза в день по 90 минут с преподавателями-практиками (Python, AI, Minecraft, 3D). Именно эта часть даёт право на налоговый вычет 13%",
      "<b>Инфраструктура</b> — бассейн (через день), спорт, командные активности, все материалы и оборудование (ноутбуки, 3D-принтер — ребёнок свою технику не везёт)",
      "<b>Безопасность</b> — охрана 24/7, медработник круглосуточно, вожатые 1:8",
      "<b>Коммуникация с родителями</b> — ежедневные фото и сообщения в родительском канале"
    ]
  },
  {
    h2: "Разумная цена vs «дёшево» — в чём разница",
    text: `Мы не говорим «дёшево» — потому что честно ценим то, что предлагаем. Мы говорим «разумная цена за то, что включено». Рейтинг ${STAT_RATING} на Яндекс.Картах по реальным отзывам родителей держится не за счёт низкой цены, а за счёт того, что родители реально получают заявленное. Разберём конкретно:`,
    list: [
      "<b>Городской IT-кружок в Москве:</b> ~3 500 ₽/занятие × 10 занятий = 35 000 ₽ за занятия без питания, проживания и оборудования",
      `<b>АйДаКемп 10 дней (Смена 4):</b> ${PRICE_S4} = 20 занятий + 10 ночей проживания + 50 приёмов пищи + бассейн + техника + охрана`,
      "<b>Итог на занятие:</b> в кружке ~3 500 ₽ за час, у нас ~1 700 ₽ за полтора часа — и это уже со всем «вокруг»",
      "<b>«Дешёвые» варианты 25–35 тыс. ₽:</b> занятия «по 30 минут от вожатых», своя техника, без образовательной лицензии → нет вычета",
      "<b>Образовательная лицензия Минобрнауки</b> — даёт право на возврат 13%. Без лицензии — вычет невозможен"
    ]
  },
  {
    h2: "Способы оплаты и честная экономия",
    text: "Все платежи официальные, через юр.лицо, с договором и квитанцией. Без переводов на карту и «оплатим потом». Можно единовременно или в рассрочку — выберите удобный способ:",
    list: [
      "<b>100% единовременно</b> — стандартный способ. По договору, с чеком и полным пакетом документов для вычета",
      "<b>50% предоплата</b> при бронировании, остаток — за 3 недели до начала смены",
      "<b>Банковский перевод / карта онлайн / СБП</b> — все популярные способы",
      "<b>Корпоративная оплата от работодателя</b> — выставляем счёт-фактуру + акт. Многие компании включают детские путёвки сотрудникам в соцпакет"
    ]
  },
  {
    h2: `Налоговый вычет 13% — минус до ${VYCHET_MAX} с одного ребёнка`,
    text: `АйДаКемп работает по лицензии Минобрнауки, поэтому образовательная часть путёвки (не вся путёвка, только обучение) даёт право на налоговый вычет. Как считается: стоимость путёвки минус бытовая часть (проживание + питание) = образовательная часть. Например, для Смены 3 (13 дней): ${PRICE_MAX} − 49 400 ₽ = 40 000 ₽ образовательной базы → 13% × 40 000 = <b>${VYCHET_MAX} возврата</b>. Лимит НК РФ — 110 000 ₽/год, наши смены в него легко укладываются. Расчёт под вашу смену — в калькуляторе ниже.`,
    list: [
      "После оплаты высылаем пакет документов: договор, чек, копия лицензии",
      "Декларация 3-НДФЛ через личный кабинет на nalog.ru — 15–20 минут",
      "Сканы документов прикладываются в декларацию",
      "Проверка ФНС — до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Альтернатива — через работодателя: возврат идёт через зарплату сразу, без ожидания года"
    ]
  },
  {
    h2: "Когда реально выгодно бронировать",
    text: `Цены на смены зафиксированы на ${SEASON_YEAR} год — они не меняются до начала сезона. Но доступность уходит быстро: в апреле свободно 60–80% мест, в мае остаётся 20–30%, в июне популярные смены полностью закрыты. Поэтому «сэкономить» = «успеть» на нужную вам смену до того, как её закроют. После бронирования цена не растёт — договор фиксирует всё.`,
    list: [
      `Самая бюджетная из открытых — ${shiftLinkHtml('shift-4', 'Смена 4')} (10 дней, ${PRICE_S4}). Успеть перед 1 сентября`,
      `Большой проект до школы — ${shiftLinkHtml('shift-3', 'Смена 3')} (13 дней, ${PRICE_S3}). Августовская, открыта к брони`,
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (завершена, 7 дней, ${PRICE_S21}) — был вход для «первый раз в лагере»`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} (завершена, 14 дней, ${PRICE_S2}) — была самой популярной`
    ]
  },
  {
    h2: "Что входит в стоимость — полный список",
    text: "В цену путёвки включено всё необходимое на смене. То, что часто забывают учитывать при сравнении с «бюджетными» лагерями — у нас уже внутри цены.",
    list: [
      "Проживание в комнатах по 2–4 человека с санузлом и душем",
      "5-разовое питание (завтрак, 2-й завтрак, обед, полдник, ужин) с учётом аллергий",
      "Образовательная программа: 2 раза в день по 90 минут (Python, AI, Minecraft, 3D) с преподавателями",
      "Бассейн с ионизированной водой — через день, спорт и активности каждый день",
      "Охрана 24/7 на территории, медработник круглосуточно",
      "Вожатые 1:8, авторы учебников по программированию для школьников",
      "Всё оборудование и материалы: ноутбуки, 3D-принтер, инструменты — уже на месте",
      "Ежедневные фото и сообщения в родительском канале",
      "Итоговый хакатон и защита проекта перед участниками"
    ]
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что вне цены, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция. Организованный автобус от партнёра, сбор у м. Солнцево. Бронируется вместе с путёвкой",
      "<b>Страховка</b> — рекомендуем оформить отдельно. Причина: по нашему договору выгодоприобретателем является ребёнок через законных представителей; свой полис даёт родителям прямой контроль над суммами и процедурой выплат",
      "<b>Дополнительные экскурсии за территорию</b> — редко, по желанию группы, оплачиваются отдельно",
      "<b>Карманные деньги на смену</b> — сумма на ваше усмотрение, часть сдаётся вожатому на хранение"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title={`Недорогой летний лагерь для детей ${SEASON_YEAR} — Подмосковье, рассрочка | АйДаКемп`}
  description={`Детский лагерь в Подмосковье ${SEASON_YEAR} от ${PRICE_MIN} за 10 дней — всё включено, доплат нет. Python, AI, Minecraft, бассейн, 5-разовое питание, 66 км от Москвы. Рассрочка 50/50, налоговый вычет 13%.`}
  h1={`Недорогой лагерь под Москвой ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: `Какой самый недорогой вариант лагеря в ${SEASON_YEAR} году?`, a: `Из открытых смен — Смена 4: 10 дней, ${DATES_SHORT_S4}, ${PRICE_S4}. Включает всё: проживание, питание, IT-программу и бассейн. Июньские короткие смены (от ${PRICE_S21}) уже завершились.` },
    { q: "Можно ли оплатить лагерь в рассрочку?", a: "Да: 50% при бронировании, остаток за 3 недели до смены. Без банков и переплат." },
    { q: "Есть ли скидки на детский лагерь?", a: "Возврат 13% через налоговый вычет. Ранняя бронь фиксирует текущую цену." },
    { q: "Что входит в минимальную стоимость путёвки?", a: "Проживание, 5-разовое питание, IT-программа, бассейн. Без скрытых доплат." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Недорогой лагерь под Москвой ${SEASON_YEAR}`}
    subtitle={`От ${CAMP_PRICE_FROM} за 10-дневную смену — самый доступный детский IT-лагерь в Подмосковье. Проживание, питание, программа включены.`}
    breadcrumb="Цены и скидки"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа включены`, "Недорого: открытые августовские смены 10–13 дней", "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 10-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа — всё включено",
      `Минус до ${VYCHET_MAX} через налоговый вычет 13% (с 13-дневной Смены 3)`,
      '<a href="/politika-vozvrata/">Гарантия и условия возврата →</a>',
      "Бронь на 72 часа без предоплаты",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
