---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { CAMP_PRICE_FROM, STAT_RATING } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';

const sections = [
  {
    h2: "Сколько стоит детский лагерь АйДаКемп",
    text: "Цена лагеря зависит от длительности смены — чем она длиннее, тем ниже стоимость дня. В стоимость лагеря уже включены проживание, 5-разовое питание и полная IT-программа. Июньские смены завершились, к брони открыты августовские. Трансфер — отдельная опция: сколько стоит лагерь по договору, столько вы и платите, скрытых доплат нет.",
    list: [
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b>`,
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (завершена) — 7 дней, ${DATES_SHORT_S21} — <b>${PRICE_S21}</b>`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} (завершена) — 8 дней, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} (завершена) — 10 дней, ${DATES_S1} — <b>${PRICE_S1}</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} (завершена) — 14 дней, ${DATES_SHORT_S2} — <b>${PRICE_S2}</b>`
    ]
  },
  {
    h2: "Анатомия цены — из чего складывается стоимость",
    text: `Когда мама сравнивает «${PRICE_MIN} за 10 дней» с «25 000 ₽ за неделю» у других лагерей — разница обычно не в наценке, а в том, что входит в цену. Лагерь честно раскладывает компоненты стоимости.`,
    list: [
      "<b>Проживание и питание</b> (бытовая часть) — около 3 800 ₽/день: комната на 2–4 человека с санузлом, 5-разовое питание с учётом аллергий",
      "<b>Образовательная программа лагеря</b> — 2 занятия в день по 90 минут (Python, AI, Minecraft, 3D). Эта часть даёт право на налоговый вычет 13%",
      "<b>Инфраструктура</b> — бассейн через день, спорт, вся техника уже в лагере: ноутбуки, 3D-принтер",
      "<b>Безопасность</b> — охрана 24/7, медработник и вожатые 1:8",
      "<b>Связь с родителями</b> — ежедневные фото и сообщения в чате"
    ]
  },
  {
    h2: "Честная цена vs «дёшево» — в чём разница",
    text: `Мы не обещаем «самый бюджетный лагерь» — обещаем честную стоимость за то, что включено. Рейтинг ${STAT_RATING} на Яндекс.Картах держится не на низкой цене, а на том, что родители реально получают заявленное:`,
    list: [
      "<b>Городской IT-кружок в Москве:</b> ~3 500 ₽ за занятие × 10 занятий = 35 000 ₽ — без питания, проживания и оборудования",
      `<b>Лагерь АйДаКемп, 10 дней (Смена 4):</b> ${PRICE_S4} = 20 занятий + проживание + 50 приёмов пищи + бассейн + техника + охрана`,
      "<b>Итог на занятие:</b> в кружке ~3 500 ₽ за час, в лагере ~1 700 ₽ за полтора часа — уже со всем «вокруг»",
      "<b>Бюджетные варианты за 25–35 тыс. ₽</b> — занятия по 30 минут, своя техника и без лицензии Минобрнауки, а значит без права на вычет"
    ]
  },
  {
    h2: "Способы оплаты и честная экономия",
    text: "Оплата лагеря — официально, через юр.лицо, с договором и квитанцией. Без переводов на карту и «оплатим потом». Единовременно или в рассрочку — как удобнее:",
    list: [
      "<b>100% единовременно</b> — стандартный способ, с чеком и полным пакетом документов для вычета",
      "<b>50% предоплата</b> при бронировании, остаток — за 3 недели до смены",
      "<b>Перевод, карта онлайн или СБП</b> — любой удобный способ",
      "<b>Оплата от работодателя</b> — выставляем счёт и акт. Многие компании включают путёвки в соцпакет"
    ]
  },
  {
    h2: `Налоговый вычет 13% — минус до ${VYCHET_MAX} с одного ребёнка`,
    text: `АйДаКемп — лагерь с лицензией Минобрнауки, поэтому образовательная часть путёвки даёт право на налоговый вычет 13%. Считается так: цена смены минус бытовая часть (проживание + питание) = образовательная база. Для Смены 3 (13 дней): ${PRICE_MAX} − 49 400 ₽ = 40 000 ₽ базы → 13% = <b>${VYCHET_MAX} возврата</b>. Лимит НК РФ — 110 000 ₽/год, наши смены укладываются в него легко. Точный расчёт — в калькуляторе ниже.`,
    list: [
      "После оплаты высылаем пакет документов: договор, чек, копию лицензии",
      "Декларация 3-НДФЛ через nalog.ru — 15–20 минут",
      "Сканы документов прикладываются к декларации",
      "Проверка ФНС — до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Через работодателя — возврат идёт сразу через зарплату, без ожидания года"
    ]
  },
  {
    h2: "Когда реально выгодно бронировать",
    text: `Цены на это лето фиксированы до начала сезона. Но доступность уходит быстро: в апреле свободно 60–80% мест, в мае — 20–30%, в июне популярные смены лагеря закрыты. «Сэкономить» в лагере значит «успеть» — после бронирования цена по договору больше не растёт.`,
    list: [
      `Самая бюджетная на лето — ${shiftLinkHtml('shift-4', 'Смена 4')} (10 дней, ${PRICE_S4}). Успеть до 1 сентября`,
      `Большой проект до школы — ${shiftLinkHtml('shift-3', 'Смена 3')} (13 дней, ${PRICE_S3}), августовская, открыта к брони`,
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (завершена, 7 дней, ${PRICE_S21}) — вход для «первый раз в лагере»`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} (завершена, 14 дней, ${PRICE_S2}) — была самой популярной`
    ]
  },
  {
    h2: "Что входит в стоимость лагеря — полный список",
    text: "В цену путёвки включено всё необходимое в лагере — то, что часто забывают учесть при сравнении с «бюджетными» лагерями.",
    list: [
      "Проживание по 2–4 человека с санузлом и 5-разовое питание с учётом аллергий",
      "IT-программа: 2 занятия в день по 90 минут — Python, AI, Minecraft, 3D",
      "Бассейн через день, спорт и активности каждый день",
      "Охрана 24/7, медработник круглосуточно, вожатые 1:8",
      "Вся техника на месте: ноутбуки, 3D-принтер, инструменты",
      "Ежедневные фото и сообщения в родительском канале",
      "Итоговый хакатон и защита проекта"
    ]
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что лагерь не включает в цену, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция, автобус от партнёра, сбор у м. Солнцево",
      "<b>Страховка</b> — рекомендуем отдельно: свой полис даёт родителям прямой контроль над выплатами",
      "<b>Экскурсии за территорию</b> — редко, по желанию группы, отдельно",
      "<b>Карманные деньги</b> — сумма на ваше усмотрение, часть хранится у вожатого"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title={`Недорогой летний лагерь для детей ${SEASON_YEAR} — Подмосковье, рассрочка | АйДаКемп`}
  description={`Детский лагерь в Подмосковье ${SEASON_YEAR} от ${PRICE_MIN} за 10 дней — всё включено, доплат нет. Python, AI, Minecraft, бассейн, 5-разовое питание, 66 км от Москвы. Рассрочка 50/50, налоговый вычет 13%.`}
  h1={`Недорогой лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <LandingHero slot="hero"
    h1={`Недорогой лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle={`От ${CAMP_PRICE_FROM} за 10-дневную смену — самый доступный детский IT-лагерь в Подмосковье. Проживание, питание, программа включены.`}
    breadcrumb="Цены и скидки"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа лагеря включены`, "Смены лагеря на август, 10–13 дней — без переплаты", "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 10-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа — всё включено",
      `Минус до ${VYCHET_MAX} через налоговый вычет 13% (с 13-дневной Смены 3)`,
      '<a href="/politika-vozvrata/">Гарантия и условия возврата →</a>',
      "Бронь на 72 часа без предоплаты",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: `Какой лагерь на это лето самый недорогой?`, a: `Из открытых смен — Смена 4: 10 дней, ${DATES_SHORT_S4}, ${PRICE_S4}, всё включено. Июньские короткие смены (от ${PRICE_S21}) уже завершились.` },
    { q: "Можно ли оплатить путёвку в рассрочку?", a: "Да: 50% при бронировании, остаток за 3 недели до смены. Без банков и переплат." },
    { q: "Есть ли скидки на путёвку?", a: "Возврат 13% через налоговый вычет. Ранняя бронь фиксирует текущую цену." },
    { q: "Что входит в минимальную стоимость путёвки?", a: "Проживание, 5-разовое питание, IT-программа, бассейн. Без скрытых доплат." }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
