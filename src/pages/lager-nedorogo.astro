---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { CAMP_PRICE_FROM } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';

const sections = [
  {
    h2: "Сколько стоит смена в лагере АйДаКемп",
    text: "Цена смены зависит от длительности. Короткие 7–8-дневные смены — самые бюджетные, длинные 13–14-дневные — дороже, но стоимость одного дня получается ниже за счёт фикс-компонентов (проживание, логистика). Все цены указаны за ребёнка, включают проживание, 5-разовое питание, полную IT-программу и досуг. Трансфер — отдельная опция. Без скрытых доплат.",
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} — 7 дней, 10–16 июня — <b>48 000 ₽</b> (самая бюджетная)`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} — 8 дней, 16–23 июня — <b>65 000 ₽</b>`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, 17–26 августа — <b>69 600 ₽</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} — 10 дней, 30 мая — 8 июня — <b>74 900 ₽</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, 3–15 августа — <b>89 400 ₽</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} — 14 дней, 10–23 июня — <b>95 000 ₽</b> (самая популярная, часто полная)`
    ]
  },
  {
    h2: "Анатомия цены — из чего складывается стоимость",
    text: "Когда мама сравнивает «48 000 ₽ за 7 дней» с «25 000 ₽ за 7 дней» в другом лагере — обычно разница не в наценке, а в том, что входит. Мы разбиваем нашу цену на честные компоненты, чтобы вы видели реально, за что платите.",
    list: [
      "<b>Проживание + 5-разовое питание</b> (бытовая часть) — около 3 800 ₽/день. Это комната на 2–4 человека с санузлом, 5 приёмов пищи с учётом аллергий, уборка, стирка",
      "<b>Образовательная программа</b> — 2 раза в день по 90 минут с преподавателями-практиками (Python, AI, Minecraft, 3D). Именно эта часть даёт право на налоговый вычет 13%",
      "<b>Инфраструктура</b> — бассейн (через день), спорт, командные активности, все материалы и оборудование (ноутбуки, 3D-принтер — ребёнок свою технику не везёт)",
      "<b>Безопасность</b> — охрана 24/7, медработник круглосуточно, вожатые 1:8",
      "<b>Коммуникация с родителями</b> — ежедневные фото и сообщения в родительском канале"
    ]
  },
  {
    h2: "Как сравнивать с другими лагерями честно",
    text: "Дешёвые детские лагеря в Подмосковье часто стоят 25–35 тыс. ₽ за 10–14 дней — и это реальная цена, не обман. Но важно понимать разницу:",
    list: [
      "<b>Школа рядом с лагерем vs IT-программа с преподавателями</b> — в бюджетных вариантах занятия часто «по 30 минут, чтобы было» от вожатых. У нас 2×90 минут с преподавателями, которые пишут учебники (тираж 2 000 экз.)",
      "<b>Ноутбук не нужен vs «привези свой ноутбук»</b> — в 70% «компьютерных» лагерей ребёнок едет со своей техникой. В случае поломки или кражи — родителям возмещать. У нас вся техника наша",
      "<b>Медик 24/7 vs медкабинет в соседнем корпусе</b> — проверяйте при выборе. Наш медработник физически на территории круглосуточно",
      "<b>Образовательная лицензия vs отсутствие</b> — даёт возможность оформить налоговый вычет 13% с образовательной части. Бюджетные лагеря чаще без лицензии → вычет невозможен"
    ]
  },
  {
    h2: "Способы оплаты и честная экономия",
    text: "Все платежи официальные, через юр.лицо, с договором и квитанцией. Без переводов на карту и «оплатим потом». Выберите удобный способ:",
    list: [
      "<b>100% единовременно</b> — стандартный способ. По договору, с чеком и полным пакетом документов для вычета",
      "<b>50/50</b> — половина при бронировании, половина за 3 недели до начала смены. Удобно если бюджет распределён",
      "<b>Банковский перевод / карта онлайн / СБП</b> — все популярные способы",
      "<b>Рассрочка</b> — возможна, условия уточняет менеджер при бронировании (зависит от банка-партнёра и даты заезда)",
      "<b>Корпоративная оплата от работодателя</b> — выставляем счёт-фактуру + акт. Многие компании включают детские путёвки сотрудникам в соцпакет"
    ]
  },
  {
    h2: "Налоговый вычет 13% — минус 14 300 ₽ с одного ребёнка",
    text: "АйДаКемп работает по лицензии Минобрнауки, поэтому образовательная часть путёвки (не вся путёвка, только обучение) даёт право на налоговый вычет. Практический максимум: 13% от лимита 110 000 ₽ — <b>до 14 300 ₽ возврата</b> с одного ребёнка в год. Если ребёнок поехал к нам + у него был ещё какой-то лицензированный курс — лимит общий. Расчёт под вашу смену — в калькуляторе ниже.",
    list: [
      "После оплаты высылаем пакет документов: договор, чек, копия лицензии",
      "Декларация 3-НДФЛ через личный кабинет на nalog.ru — 15–20 минут",
      "Сканы документов прикладываются в декларацию",
      "Проверка ФНС — до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Альтернатива — через работодателя: возврат идёт через зарплату сразу, без ожидания года"
    ]
  },
  {
    h2: "Когда реально выгодно бронировать",
    text: "Цены на смены зафиксированы на 2026 год — они не меняются до начала сезона. Но доступность уходит быстро: в апреле свободно 60–80% мест, в мае остаётся 20–30%, в июне популярные смены полностью закрыты. Поэтому «сэкономить» = «успеть» на нужную вам смену до того, как её закроют. После бронирования цена не растёт — договор фиксирует всё.",
    list: [
      `Самая бюджетная — ${shiftLinkHtml('shift-2-1', 'Смена 2.1')} (7 дней, 48 000 ₽). Хороший вход для «первый раз в лагере»`,
      `Самая популярная — ${shiftLinkHtml('shift-2', 'Смена 2')} (14 дней, 95 000 ₽). Закрывается за 2–3 месяца до старта`,
      `Короткая ${shiftLinkHtml('shift-2-2', 'Смена 2.2')} (8 дней, 65 000 ₽) — для тех кто сомневается ехать ли ребёнку на две недели`,
      `Августовская ${shiftLinkHtml('shift-4', 'Смена 4')} (10 дней, 69 600 ₽) — успеть перед 1 сентября`
    ]
  },
  {
    h2: "Что входит в стоимость — полный список",
    text: "В цену путёвки включено всё необходимое на смене. То, что часто забывают учитывать при сравнении с «бюджетными» лагерями — у нас уже внутри цены.",
    list: [
      "Проживание в комнатах по 2–4 человека с санузлом и душем",
      "5-разовое питание (завтрак, 2-й завтрак, обед, полдник, ужин) с учётом аллергий",
      "Образовательная программа: 2 раза в день по 90 минут (Python, AI, Minecraft, 3D, робототехника) с преподавателями",
      "Бассейн с ионизированной водой — через день, спорт и активности каждый день",
      "Охрана 24/7 на территории, медработник круглосуточно",
      "Вожатые 1:8, авторы учебников по программированию для детей",
      "Всё оборудование и материалы (ноутбуки, 3D-принтер, инструменты) — ребёнок свою технику не везёт",
      "Ежедневные фото и сообщения в родительском канале",
      "Итоговый хакатон и защита проекта перед участниками"
    ]
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что вне цены, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция. Организованный автобус от партнёра, сбор у м. Солнцево. Бронируется вместе с путёвкой",
      "<b>Страховка</b> — рекомендуем оформить отдельно. Причина: по нашему договору выгодоприобретателем является ребёнок через законных представителей; свой полис даёт родителям прямой контроль над суммами и процедурой выплат",
      "<b>Дополнительные экскурсии за территорию</b> — редко, по желанию группы, оплачиваются отдельно",
      "<b>Карманные деньги ребёнка</b> — по вашему усмотрению, часть отдаёт вожатому на хранение"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title="Летний лагерь недорого в Подмосковье 2026 — от 48 000 ₽ за 7 дней | АйДаКемп"
  description="Детский IT-лагерь в Подмосковье без переплат — от 48 000 ₽ за 7 дней, всё включено. 66 км от Москвы. Налоговый вычет 13% (до 14 300 ₽). Смены июнь–август 2026. ★ 5.0 на Яндекс Картах."
  h1="Летний лагерь в Подмосковье — цены 2026"
  canonical="https://aidacamp.ru/lager-nedorogo"
>
  <LandingHero slot="hero"
    h1="Летний лагерь в Подмосковье — цены 2026"
    subtitle={`От ${CAMP_PRICE_FROM} за 7-дневную смену. Проживание, питание, IT-программа — всё включено. Без скрытых доплат.`}
    breadcrumb="Цены и путёвки"
    keywords={[`От ${CAMP_PRICE_FROM} за смену — проживание, питание, программа включены`, "Смены от 7 до 14 дней — выбери подходящую", "Фиксация цены на 72 часа — возврат если не понравится"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Лагерь недорого АйДаКемп"
  />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <LandingTwoCol
    sections={sections}
    priceFrom={`от ${CAMP_PRICE_FROM}`}
    priceNote="за 7-дневную смену, всё включено"
    highlights={[
      "Проживание, питание, IT-программа — всё включено",
      "Минус 14 300 ₽ через налоговый вычет 13%",
      "Возврат 50% если не подошло в первые 3 дня",
      "Бронь на 72 часа без предоплаты",
    ]}
  />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
