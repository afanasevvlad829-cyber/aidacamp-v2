---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Videos from '../../components/Videos.astro';
---

<Base
  title="Видео из лагеря АйДаКемп — программы, отзывы, экскурсия"
  description="Видео с программ IT-лагеря АйДаКемп: экскурсия по корпусам, занятия, отзывы детей и родителей."
>
  <Header />
  <main class="min-h-[60vh]">
    <!-- Hero block (как на остальных страницах) -->
    <section class="relative overflow-hidden bg-dark-navy text-white">
      <!-- Декоративный градиент -->
      <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_70%_30%,rgba(236,155,68,0.18)_0%,transparent_60%),radial-gradient(60%_50%_at_20%_80%,rgba(59,118,195,0.18)_0%,transparent_60%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[1312px] px-4 pt-20 pb-14 md:pt-28 md:pb-20">
        <nav class="mb-4 flex items-center gap-2 text-base text-white/60" aria-label="Хлебные крошки">
          <a href="/" class="hover:text-white">Главная</a>
          <i class="bi bi-chevron-right text-[10px]" aria-hidden="true"></i>
          <span class="text-white/85">Видео</span>
        </nav>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Видео из лагеря</p>
        <h1 class="mt-3 text-[34px] md:text-[54px] font-extrabold leading-[1.05] tracking-[-0.03em] text-white">
          Покажем как<br />проходит смена
        </h1>
        <p class="mt-4 max-w-[640px] text-[17px] md:text-[18px] leading-[1.55] text-white/80">
          Экскурсия по корпусам, как идут занятия, хакатон в финале, отзывы детей и родителей с прошлых смен.
        </p>
      </div>
    </section>

    <Videos />

    <div class="mx-auto max-w-[1312px] px-4 py-12 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-base font-medium text-primary hover:text-[#d68830]">
        <i class="bi bi-arrow-left text-base" aria-hidden="true"></i>
        На главную
      </a>
    </div>
  </main>
  <Footer />
</Base>
