---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Videos from '../../components/Videos.astro';
---

<Base
  title="Видео из лагеря АйДаКемп — программы, отзывы, экскурсия"
  description="Видео с программ IT-лагеря АйДаКемп: экскурсия по корпусам, занятия, отзывы детей и родителей."
>
  <Header />
  <main class="min-h-[60vh]">
    <div class="mx-auto max-w-[1312px] px-4 pt-8 pb-2 md:pt-12">
      <p class="text-[14px] font-semibold uppercase tracking-wider text-primary">Видео</p>
      <h1 class="mt-2 text-[32px] md:text-[44px] font-extrabold leading-[1.1] tracking-[-0.03em] text-slate-900">
        Покажем как<br>проходит смена
      </h1>
      <p class="mt-3 max-w-[640px] text-[16px] leading-[1.6] text-slate-600">
        Экскурсия по корпусам, как идут занятия, отзывы детей и родителей с прошлых смен.
      </p>
    </div>

    <Videos />

    <div class="mx-auto max-w-[1312px] px-4 py-12 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-[15px] font-medium text-primary hover:text-[#d68830]">
        <i class="bi bi-arrow-left text-[14px]" aria-hidden="true"></i>
        На главную
      </a>
    </div>
  </main>
  <Footer />
</Base>
