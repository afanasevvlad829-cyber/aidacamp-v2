---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import BenefitCalculator from '../components/BenefitCalculator.astro';
import { getRelatedPages } from '../data/landing-pages';
import { PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S1, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4, mainShifts, shortShifts, SEASON_YEAR, SHIFT_META, allShiftsIncludingArchived, TRANSFER_PRICE_FMT } from '../data/shifts';
import AskCta from '../components/AskCta.astro';
import { getCurrentPrice, getShiftPhase } from '../data/dynamicPrices';
import { PAYMENT_SPLIT, STAT_RATING } from '../data/contacts';
import { SEASON_END_ISO } from '../data/evergreen';

const ldPrice = (id: string) => String(getCurrentPrice(id) ?? SHIFT_META[id].basePrice);
const schemaPrice = {
  s1: ldPrice('shift-1'), s2: ldPrice('shift-2'), s21: ldPrice('shift-2-1'),
  s22: ldPrice('shift-2-2'), s3: ldPrice('shift-3'), s4: ldPrice('shift-4'),
};

// Event-блоки JSON-LD всех смен сезона — генерируются из shifts.ts
const eventLd = allShiftsIncludingArchived.map(s => ({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `${s.name} — IT-лагерь АйДаКемп ${SEASON_YEAR} (${s.duration})`,
  "startDate": s.startDate,
  "endDate": s.endDate,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": { "@type": "Place", "name": "Санаторий Изумруд, Подмосковье", "address": { "@type": "PostalAddress", "addressCountry": "RU", "addressRegion": "Московская область" } },
  "organizer": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
  "description": `${s.description} IT-лагерь для детей 7–15 лет, ${s.duration}.`,
  "offers": { "@type": "Offer", "price": ldPrice(s.id), "priceCurrency": "RUB", "url": "https://aidacamp.ru/ceny", "availability": getShiftPhase(s.id) === 'done' ? "https://schema.org/SoldOut" : "https://schema.org/InStock" },
  "audience": { "@type": "PeopleAudience", "suggestedMinAge": 7, "suggestedMaxAge": 15 },
}));

function freeLabel(free: number): string {
  if (free === 0) return 'Мест нет';
  const word = free === 1 ? 'место' : free >= 2 && free <= 4 ? 'места' : 'мест';
  return `Осталось ${free} ${word}`;
}
function freeBadgeClass(free: number): string {
  if (free === 0) return 'inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-[12px] font-medium text-red-700';
  if (free <= 5) return 'inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-0.5 text-[12px] font-medium text-orange-700';
  return 'inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-[12px] font-medium text-emerald-700';
}

// Таблица цен — формируем из data/shifts.ts, чтобы источник правды был один.
function shiftPrice(s: { id: string; price: string }): string {
  const cur = getCurrentPrice(s.id);
  return cur ? cur.toLocaleString('ru-RU') + ' ₽' : s.price;
}

const priceRows = [
  ...mainShifts.map((s) => ({
    id: s.id,
    name: s.name,
    dates: s.dates,
    duration: s.duration,
    price: shiftPrice(s),
    free: s.free,
    freeLabel: freeLabel(s.free),
    freeBadgeClass: freeBadgeClass(s.free),
    note: s.popular ? 'популярная' : '',
  })),
  ...shortShifts.map((s) => ({
    id: s.id,
    name: s.name,
    dates: s.dates,
    duration: s.duration,
    price: shiftPrice(s),
    free: s.free,
    freeLabel: freeLabel(s.free),
    freeBadgeClass: freeBadgeClass(s.free),
    note: 'короткая',
  })),
];

const sections = [
  {
    h2: 'Сколько стоит путёвка в лагерь',
    text: `Открыты к брони августовские заезды: 10 дней — ${PRICE_S4}, 13 дней — ${PRICE_S3}. Цена — за ребёнка, включает проживание, питание, программу и бассейн, без доплат. Лагерь в Подмосковье, Наро-Фоминский округ — официальный договор, оплата в рублях, путёвку можно оформить онлайн.`,
  },
  {
    h2: 'Что входит в стоимость',
    text: 'Путёвка закрывает всё необходимое, включая IT-образование: ребёнок создаст проект и уедет не только с воспоминаниями, но и с навыками.',
    list: [
      'Проживание в комнатах по 2–4 человека с санузлом и душем',
      '5-разовое питание (завтрак, 2-й завтрак, обед, полдник, ужин)',
      'Образовательная программа: 2 раза в день по 90 минут — Python, AI, Minecraft, 3D',
      'Бассейн с ионизированной водой — через день',
      'Вожатые 1:8, медработник на территории 24/7',
      'Ноутбуки и всё оборудование — предоставляются в лагере',
      'Родительский чат с ежедневными фото и сообщениями',
    ],
  },
  {
    h2: 'Что оплачивается отдельно',
    text: 'В путёвку не входит — но можно заказать как опцию.',
    list: [
      'Трансфер от Москвы до лагеря — опция',
      'Страховка на время заезда — оформляется отдельно, выгодоприобретатель — родители, полный контроль над выплатами.',
    ],
  },
  {
    h2: 'Способы оплаты',
    text: 'Удобно и без давления.',
    list: [
      '100% оплата одним платежом — стандарт',
      '50% предоплата при бронировании, остаток за 3 недели до заезда',
      'Банковский перевод, карта, СБП',
      'Оплата через работодателя по безналу — предоставляем договор и акты',
    ],
  },
  {
    h2: 'Налоговый вычет 13%',
    text: 'АйДаКемп работает по лицензии Минобрнауки — можно вернуть 13% от образовательной части цены (из суммы путёвки вычитается бытовая составляющая: проживание и питание). Документы высылаем автоматически после оплаты, расчёт — в калькуляторе ниже. Подробнее: <a href=\'/nalogovyj-vychet/\' class=\'text-orange-600 underline underline-offset-2\'>как оформить налоговый вычет за лагерь</a>.',
    list: [
      `Смена 4 (10 дней, ${PRICE_S4}) — возврат ~${VYCHET_S4}`,
      `Смена 3 (13 дней, ${PRICE_S3}) — возврат ~${VYCHET_S3}`,
      `Смена 1 (завершена, 10 дней, ${PRICE_S1}) — возврат ~${VYCHET_S1}`,
      `Смена 2.1 (завершена, 7 дней, ${PRICE_S21}) — возврат ~${VYCHET_S21}`,
      `Смена 2.2 (завершена, 8 дней, ${PRICE_S22}) — возврат ~${VYCHET_S22}`,
      `Смена 2 (завершена, 14 дней, ${PRICE_S2}) — возврат ~${VYCHET_S2} (максимум сезона)`,
      'Оформляется через ФНС — декларация 3-НДФЛ или через Госуслуги',
    ],
  },
  {
    h2: 'Из чего складывается стоимость путёвки',
    text: 'Цена складывается из постоянных расходов: педагоги-IT (2 занятия в день, группы до 8 человек) — основная статья, вожатые 1:8 — выше рыночного стандарта, проживание в санатории «Изумруд», медработник круглосуточно. Питание, бассейн и оборудование входят в путёвку без доплат. Для сравнения: летние лагеря Подмосковья стоят от 30 до 120 тыс. ₽ за смену, АйДаКемп в среднем сегменте — но с IT-программой вместо обычных кружков.',
  },
  {
    h2: 'Когда лучше бронировать',
    text: `Популярные заезды закрываются за 2–3 месяца до старта: в апреле свободно 60–80% мест, в мае — только 20–30%. Путёвки на август ${SEASON_YEAR} открыты, рейтинг ${STAT_RATING} на Яндекс.Картах. 72 часа на размышление после звонка менеджера, без предоплаты — <a href="/lager-nedorogo/" class="text-primary hover:underline">недорогой лагерь для детей</a>.`,
  },
  {
    h2: 'Лагерь vs городской IT-кружок — сравнение по стоимости часа',
    text: `<p class="text-slate-600 mb-4">«Почему лагерь дороже кружка?» — считаем честно:</p>
<div class="overflow-x-auto rounded-xl border border-slate-200 mb-4">
  <table class="w-full text-base border-collapse">
    <thead>
      <tr class="bg-slate-50 text-slate-500 text-[12px] uppercase tracking-wide font-semibold">
        <th class="px-4 py-3 text-left">Формат</th>
        <th class="px-4 py-3 text-right">Стоимость</th>
        <th class="px-4 py-3 text-right">IT-часов</th>
        <th class="px-4 py-3 text-right">Стоимость часа</th>
      </tr>
    </thead>
    <tbody>
      <tr class="border-t border-slate-100 text-slate-700">
        <td class="px-4 py-3">Городской IT-кружок (2 нед.)</td>
        <td class="px-4 py-3 text-right">~21 000 ₽</td>
        <td class="px-4 py-3 text-right">~28 ч</td>
        <td class="px-4 py-3 text-right font-semibold text-slate-800">~750 ₽/ч</td>
      </tr>
      <tr class="border-t border-slate-100 text-slate-700 bg-orange-50">
        <td class="px-4 py-3 font-semibold text-slate-900">АйДаКемп 13 дней</td>
        <td class="px-4 py-3 text-right">${PRICE_MAX}</td>
        <td class="px-4 py-3 text-right">~104 ч</td>
        <td class="px-4 py-3 text-right font-semibold text-primary">~848 ₽/ч</td>
      </tr>
    </tbody>
  </table>
</div>
<p class="text-slate-600 text-base">Дороже, но включает 8 часов IT-занятий <em>плюс</em> питание, проживание, бассейн и хакатон — а не два часа программирования. Час в лагере выгоднее.</p>`,
  },
  {
    h2: 'Рассрочка и корпоративная оплата',
    text: '',
    list: [
      'Рассрочка 50/50: первый платёж при бронировании фиксирует место, второй — за 2 недели до заезда',
      'Оплата от юрлица или ИП: возможна, нужен договор — уточните при оформлении, всё сделаем',
      'Корпоративный соцпакет: уточните у своего HR — часть компаний компенсирует путёвки для детей сотрудников',
      'Банковский перевод, карта, СБП — принимаем всё',
      'Отправляете сразу <a href="/dlya-kompaniy/" class="text-primary hover:underline">лагерь для группы детей</a> сотрудников — оформляем одним договором',
    ],
  },
  {
    h2: `Срочно: последние места сезона ${SEASON_YEAR}`,
    text: `Лето заканчивается — уточняйте наличие мест при бронировании. Оставьте заявку, менеджер перезвонит в течение часа.`,
  },
  {
    h2: 'Сколько стоит детский лагерь — часто задаваемые вопросы',
    text: 'Отвечаем на частые вопросы: сколько стоит лагерь, что входит в цену и как её снизить.',
    list: [
      'В стоимость входит всё: проживание, 5-разовое питание, IT-программа, бассейн, охрана — без скрытых доплат',
      `Самая доступная открытая программа — 10 дней от ${PRICE_MIN} (август)`,
      `Налоговый вычет 13% возвращается из бюджета — от ${VYCHET_S21} до ${VYCHET_MAX} в зависимости от путёвки`,
      'Рассрочка по карте Тинькофф — делим оплату на 3–6 месяцев без переплат',
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону, бронируется отдельно`,
    ],
  },
];
---

<LandingLayout
  title={`Цены на путевки в детский лагерь Подмосковья ${SEASON_YEAR}`}
  description={`Цены на летний детский лагерь АйДаКемп ${SEASON_YEAR}: путевки от ${PRICE_MIN} за смену в Подмосковье. Включены питание, проживание, оборудование, IT-программа и бассейн. Налоговый вычет 13% до ${VYCHET_MAX}, доступна рассрочка.`}
  h1={`Детский лагерь Подмосковья — стоимость`}
  canonical="https://aidacamp.ru/ceny"
  heroImage="/images/hero/kupit-putevku-v-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": `Путёвка в детский IT-лагерь АйДаКемп ${SEASON_YEAR}`,
      "description": "Летний IT-лагерь для детей 7–15 лет в Подмосковье. Программирование (Python, AI, Minecraft), бассейн, проживание — всё включено.",
      "brand": { "@type": "Brand", "name": "АйДаКемп" },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 7,
        "suggestedMaxAge": 15
      },
      "offers": priceRows.map(row => ({
        "@type": "Offer",
        "name": `${row.name} — ${row.dates}`,
        "description": `${row.duration}, ${row.dates}`,
        "price": row.price.replace(/[^\d]/g, ''),
        "priceCurrency": "RUB",
        "availability": "https://schema.org/InStock",
        "url": "https://aidacamp.ru/ceny",
        "priceValidUntil": SEASON_END_ISO,
        "seller": { "@type": "Organization", "name": "АйДаКемп" }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детский лагерь Подмосковья — стоимость`}
    subtitle={`Заезды в Подмосковье на ${SEASON_YEAR} год: от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Проживание, питание, IT-программа и бассейн — всё включено без скрытых доплат.`}
    breadcrumb="Стоимость"
    keywords={[
      `Стоимость путёвки — от ${PRICE_MIN}`,
      `IT-лагерь ${SEASON_YEAR} — без скрытых доплат`,
      `Налоговый вычет 13% — до ${VYCHET_MAX} возврата`,
      'Оплата 100% или частями (50% сейчас + 50% за 3 нед. до заезда), банковский перевод или карта',
    ]}
    image="/images/hero/kupit-putevku-v-lager.avif"
    imageAlt="Стоимость программы АйДаКемп для детей"
  />

  <!--
    Таблица цен — каждая строка кликабельна и навигирует на страницу смены /shifts/[id]/
  -->
  <section class="mx-auto max-w-[1312px] px-4 py-10 md:py-14">
    <div class="flex items-center gap-2 mb-6">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Даты и стоимость смен {SEASON_YEAR}
      </h2>
    </div>

    <div class="overflow-x-auto rounded-[22px] border border-border-light bg-card card-shadow">
      <table class="w-full min-w-[720px] border-collapse bg-white">
        <thead>
          <tr class="bg-slate-50 text-base font-semibold uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3 text-left">Смена</th>
            <th class="px-4 py-3 text-left">Даты</th>
            <th class="px-4 py-3 text-left">Длительность</th>
            <th class="px-4 py-3 text-right">Стоимость</th>
            <th class="px-2 py-3 w-[110px]" aria-label="Метка"></th>
            <th class="px-4 py-3 w-[160px] text-right" aria-label="Действие"></th>
          </tr>
        </thead>
        <tbody>
          {priceRows.map((row) => (
            <tr
              class="border-t border-slate-100 text-base text-slate-700 transition-colors hover:bg-[var(--color-primary-warm)] cursor-pointer"
              onclick={`location.href='/shifts/${row.id}/'`}
              role="link"
              tabindex="0"
              aria-label={`Смена ${row.name} — подробнее и бронирование`}
            >
              <td class="px-4 py-3 font-semibold text-slate-900">
                {row.name}
              </td>
              <td class="px-4 py-3">
                {row.dates}
              </td>
              <td class="px-4 py-3 text-slate-600">
                {row.duration}
              </td>
              <td class="px-4 py-3 text-right font-bold text-primary">
                {row.price}
              </td>
              <td class="px-2 py-3 text-right">
                <div class="flex flex-col items-end gap-1">
                  {row.note && (
                    <span class="inline-flex rounded-full bg-[var(--color-primary-50)] px-2.5 py-0.5 text-[12px] font-medium text-[var(--color-primary-700)]">{row.note}</span>
                  )}
                  <span class={row.freeBadgeClass}>
                    <i class="bi bi-people-fill text-[11px]" aria-hidden="true"></i>
                    {row.freeLabel}
                  </span>
                </div>
              </td>
              <td class="px-4 py-3 text-right">
                <a
                  href={`/shifts/${row.id}/`}
                  class="inline-flex items-center gap-1 rounded-full bg-primary hover:bg-primary-hover text-white px-3 py-1.5 text-base font-semibold transition-colors whitespace-nowrap"
                  data-analytics-goal="ceny_table_book"
                  data-analytics-label={row.id}
                  onclick="event.stopPropagation()"
                >
                  Забронировать
                  <i class="bi bi-arrow-right-short text-base" aria-hidden="true"></i>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-base text-slate-500">
      Стоимость на {SEASON_YEAR} зафиксирована, оплата в рублях. Клик по строке — подробности и бронирование. Все открытые даты: <a href="/#shifts" class="text-primary hover:underline">Выбрать →</a>
    </p>
    <p class="mt-2 text-base text-slate-500">
      Готовы записаться? <a href="/zapisatsya/" class="text-primary hover:underline">Как забронировать место</a> — пошаговая инструкция.
    </p>

    <!-- Mobile CTA — ссылка на первую смену для выбора -->
    <div class="mt-4 md:hidden">
      <a
        href="/#shifts"
        class="block w-full inline-flex items-center justify-center gap-2 rounded-[14px] bg-primary hover:bg-primary-hover active:bg-primary-dark px-5 py-3.5 text-[16px] font-semibold text-white transition-colors shadow-[0_4px_16px_rgba(236,124,0,0.3)]"
        data-analytics-goal="ceny_mobile_cta"
      >
        <i class="bi bi-calendar-check text-[18px]" aria-hidden="true"></i>
        Выбрать и забронировать
      </a>
    </div>

  </section>

  <LandingTwoCol sections={sections} />

  <!-- Калькулятор выгоды: групповые скидки + налоговый вычет -->
  <BenefitCalculator />

  <!-- Калькулятор налогового вычета (детальный расчёт 13%) -->
  <TaxCalculator />

  <!-- Карточки смен с кнопкой «Выбрать» -->
  <Shifts />

  <!-- Галерея для доверия -->
  <Gallery />

  <FAQ extraItems={[
    { q: `Сколько стоит летний лагерь в ${SEASON_YEAR} году?`, a: `Открытые к брони августовские заезды: ${PRICE_S4} за 10 дней (Смена 4) и ${PRICE_S3} за 13 дней (Смена 3) — цены остальных смен смотрите в таблице выше. В цену включены проживание, питание, IT-программа и бассейн, без скрытых доплат.` },
    { q: "Какова цена летнего лагеря для детей в Подмосковье?", a: `От ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Налоговый вычет 13% возвращает до ${VYCHET_MAX} от образовательной части.` },
    { q: "Можно ли оплатить лагерь частями?", a: `Да. ${PAYMENT_SPLIT}. Место фиксируется после первого взноса. Принимаем банковский перевод и карту.` },
