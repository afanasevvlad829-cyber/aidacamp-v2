---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import BenefitCalculator from '../components/BenefitCalculator.astro';
import { getRelatedPages } from '../data/landing-pages';
import { PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S1, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4, mainShifts, shortShifts } from '../data/shifts';
import AskCta from '../components/AskCta.astro';
import { getCurrentPrice } from '../data/dynamicPrices';
import FAQSchema from '../components/FAQSchema.astro';
import { PAYMENT_SPLIT, STAT_RATING } from '../data/contacts';

const schemaPrice = {
  s1:   String(getCurrentPrice('shift-1')   ?? 74900),
  s2:   String(getCurrentPrice('shift-2')   ?? 99000),
  s21:  String(getCurrentPrice('shift-2-1') ?? 48000),
  s22:  String(getCurrentPrice('shift-2-2') ?? 75000),
  s3:   String(getCurrentPrice('shift-3')   ?? 89400),
  s4:   String(getCurrentPrice('shift-4')   ?? 74900),
};

function freeLabel(free: number): string {
  if (free === 0) return 'Мест нет';
  const word = free === 1 ? 'место' : free >= 2 && free <= 4 ? 'места' : 'мест';
  return `Осталось ${free} ${word}`;
}
function freeBadgeClass(free: number): string {
  if (free === 0) return 'inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-[12px] font-medium text-red-700';
  if (free <= 5) return 'inline-flex items-center gap-1 rounded-full bg-orange-100 px-2.5 py-0.5 text-[12px] font-medium text-orange-700';
  return 'inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-[12px] font-medium text-emerald-700';
}

// Таблица цен — формируем из data/shifts.ts, чтобы источник правды был один.
function shiftPrice(s: { id: string; price: string }): string {
  const cur = getCurrentPrice(s.id);
  return cur ? cur.toLocaleString('ru-RU') + ' ₽' : s.price;
}

const priceRows = [
  ...mainShifts.map((s) => ({
    id: s.id,
    name: s.name,
    dates: s.dates,
    duration: s.duration,
    price: shiftPrice(s),
    free: s.free,
    freeLabel: freeLabel(s.free),
    freeBadgeClass: freeBadgeClass(s.free),
    note: s.popular ? 'популярная' : '',
  })),
  ...shortShifts.map((s) => ({
    id: s.id,
    name: s.name,
    dates: s.dates,
    duration: s.duration,
    price: shiftPrice(s),
    free: s.free,
    freeLabel: freeLabel(s.free),
    freeBadgeClass: freeBadgeClass(s.free),
    note: 'короткая',
  })),
];

const sections = [
  {
    h2: 'Сколько стоит смена',
    text: `Открыты к брони августовские смены: 10 дней — ${PRICE_S4} и 13 дней — ${PRICE_S3}. Летние смены сезона (7–14 дней) уже завершены. Цена — за ребёнка, включает проживание, пятиразовое питание, полную программу и бассейн, без скрытых доплат. Сравниваете цены на лагеря под Москвой? У нас официальный договор и фиксированная цена в рублях — путёвку можно оформить онлайн. Лагерь расположен в Подмосковье (Наро-Фоминский округ, лесная территория): бассейн, активный отдых и никаких доплат сверху.`,
  },
  {
    h2: 'Что входит в стоимость',
    text: 'Путёвка закрывает всё необходимое на смене, включая IT-образование: ребёнок научится программировать, создаст проект и уедет с навыками, а не только воспоминаниями.',
    list: [
      'Проживание в комнатах по 2–4 человека с санузлом и душем',
      '5-разовое питание (завтрак, 2-й завтрак, обед, полдник, ужин)',
      'Образовательная программа: 2 раза в день по 90 минут — Python, AI, Minecraft, 3D, робототехника',
      'Бассейн с ионизированной водой — через день',
      'Вожатые 1:8, медработник на территории 24/7',
      'Ноутбуки и всё оборудование — предоставляются в лагере',
      'Родительский чат с ежедневными фото и сообщениями',
    ],
  },
  {
    h2: 'Что оплачивается отдельно',
    text: 'В путёвку не входит — но можно заказать как опцию.',
    list: [
      'Трансфер от Москвы до лагеря в Подмосковье — опция',
      'Страховка на время смены — оформляется отдельно, выгодоприобретатель — родители, полный контроль над выплатами.',
    ],
  },
  {
    h2: 'Способы оплаты',
    text: 'Удобно и без давления.',
    list: [
      '100% оплата одним платежом — стандарт',
      '50% предоплата при бронировании, остаток за 3 недели до начала смены',
      'Банковский перевод, карта, СБП',
      'Оплата через работодателя по безналу — предоставляем договор и акты',
    ],
  },
  {
    h2: 'Налоговый вычет 13%',
    text: 'АйДаКемп работает по лицензии Минобрнауки, поэтому можно вернуть 13% от стоимости образовательных услуг. Вычет считается от образовательной части цены смены — из суммы путёвки вычитается бытовая составляющая (проживание и питание). Документы для вычета — договор, чек, копия лицензии — высылаем автоматически после оплаты. Расчёт возврата — в калькуляторе ниже. Подробная инструкция: <a href=\'/nalogovyj-vychet/\' class=\'text-orange-600 underline underline-offset-2\'>как оформить налоговый вычет за лагерь</a>.',
    list: [
      `Смена 4 (10 дней, ${PRICE_S4}) — возврат ~${VYCHET_S4}`,
      `Смена 3 (13 дней, ${PRICE_S3}) — возврат ~${VYCHET_S3}`,
      `Смена 1 (завершена, 10 дней, ${PRICE_S1}) — возврат ~${VYCHET_S1}`,
      `Смена 2.1 (завершена, 7 дней, ${PRICE_S21}) — возврат ~${VYCHET_S21}`,
      `Смена 2.2 (завершена, 8 дней, ${PRICE_S22}) — возврат ~${VYCHET_S22}`,
      `Смена 2 (завершена, 14 дней, ${PRICE_S2}) — возврат ~${VYCHET_S2} (максимум сезона)`,
      'Оформляется через ФНС — декларация 3-НДФЛ или через Госуслуги',
    ],
  },
  {
    h2: 'Из чего складывается стоимость путёвки',
    text: 'Цена лагеря в Подмосковье — это не просто «поездка за город», а постоянный операционный состав: педагоги-IT (2 занятия в день, группы до 8 человек) — основная статья расходов, вожатые 1:8 — выше рыночного стандарта, проживание в санатории «Изумруд», медработник на территории круглосуточно. Питание, бассейн и оборудование уже перечислены выше — всё входит в стоимость путёвки без доплат.',
  },
  {
    h2: 'Когда лучше бронировать',
    text: `Популярные смены закрываются за 2–3 месяца до старта: в апреле свободно 60–80% мест, в мае — только 20–30%. Раннее бронирование — свобода выбора детского лагеря по дате и возрастной группе. Путёвки на август 2026 в Подмосковье открыты. Рейтинг ${STAT_RATING} на Яндекс.Картах — отзывы родителей. Бронирование без предоплаты: 72 часа на размышление после звонка менеджера. Самый доступный вариант из открытых смен — на странице <a href="/lager-nedorogo/" class="text-primary hover:underline">недорогой лагерь для детей</a>.`,
  },
  {
    h2: 'Лагерь vs городской IT-кружок — сравнение по стоимости часа',
    text: `<p class="text-slate-600 mb-4">Родители часто спрашивают: «А почему лагерь дороже кружка?» Считаем честно:</p>
<div class="overflow-x-auto rounded-xl border border-slate-200 mb-4">
  <table class="w-full text-base border-collapse">
    <thead>
      <tr class="bg-slate-50 text-slate-500 text-[12px] uppercase tracking-wide font-semibold">
        <th class="px-4 py-3 text-left">Формат</th>
        <th class="px-4 py-3 text-right">Стоимость</th>
        <th class="px-4 py-3 text-right">IT-часов</th>
        <th class="px-4 py-3 text-right">Цена за час</th>
      </tr>
    </thead>
    <tbody>
      <tr class="border-t border-slate-100 text-slate-700">
        <td class="px-4 py-3">Городской IT-кружок (2 нед.)</td>
        <td class="px-4 py-3 text-right">~21 000 ₽</td>
        <td class="px-4 py-3 text-right">~28 ч</td>
        <td class="px-4 py-3 text-right font-semibold text-slate-800">~750 ₽/ч</td>
      </tr>
      <tr class="border-t border-slate-100 text-slate-700 bg-orange-50">
        <td class="px-4 py-3 font-semibold text-slate-900">АйДаКемп 13 дней</td>
        <td class="px-4 py-3 text-right">${PRICE_MAX}</td>
        <td class="px-4 py-3 text-right">~104 ч</td>
        <td class="px-4 py-3 text-right font-semibold text-primary">~848 ₽/ч</td>
      </tr>
    </tbody>
  </table>
</div>
<p class="text-slate-600 text-base">День в лагере дороже кружка, но включает 8 часов IT-занятий <em>плюс</em> питание, проживание, бассейн и итоговый хакатон — а не два часа программирования. С учётом всего включённого час обучения в лагере выгоднее, плюс командная защита проекта — этого в кружке нет.</p>`,
  },
  {
    h2: 'Рассрочка и корпоративная оплата',
    list: [
      'Рассрочка 50/50: первый платёж при бронировании фиксирует место, второй — за 2 недели до заезда',
      'Оплата от юрлица или ИП: возможна, нужен договор — уточните при оформлении, всё сделаем',
      'Корпоративный соцпакет: уточните у своего HR — часть компаний компенсирует путёвки для детей сотрудников',
      'Банковский перевод, карта, СБП — принимаем всё',
      'Отправляете сразу <a href="/dlya-kompaniy/" class="text-primary hover:underline">лагерь в Подмосковье для группы детей</a> сотрудников — оформляем одним договором',
    ],
  },
  {
    h2: 'Срочно: последние места сезона 2026',
    text: 'Июль 2026 полностью занят. В июне и августе ещё есть места в лагере в Подмосковье — уточняйте актуальность при бронировании. Оставьте заявку сейчас: менеджер перезвонит в течение часа и ответит на все вопросы.',
  },
  {
    h2: 'Сколько стоит детский лагерь — часто задаваемые вопросы',
    text: 'Разбираем типичные вопросы о цене лагеря в Подмосковье: что входит в стоимость и как её снизить.',
    list: [
      'В цену входит всё: проживание, 5-разовое питание, IT-программа, бассейн, охрана — без скрытых доплат',
      `Самая доступная открытая смена — 10 дней от ${PRICE_MIN} (Смена 4, август)`,
      `Налоговый вычет 13% возвращается из бюджета — от 2 800 до ${VYCHET_MAX} в зависимости от смены`,
      'Рассрочка по карте Тинькофф — делим оплату на 3–6 месяцев без переплат',
      'Трансфер от м. Солнцево — 2 000 ₽ в одну сторону, бронируется отдельно',
    ],
  },
  {
    h2: 'Цены на лагерь 2026 — из чего складывается стоимость',
    text: 'Стоимость летних лагерей Подмосковья — от 30 000 до 120 000 ₽ за смену; АйДаКемп в среднем сегменте, но с IT-программой вместо обычных кружков и спорта. Проживание, питание, бассейн и охрана уже включены — скрытых платежей нет.',
  },
