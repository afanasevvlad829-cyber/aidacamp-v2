---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import Shifts from '../components/Shifts.astro';
import AskCta from '../components/AskCta.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { STAT_LICENSE } from '../data/contacts';

const faqItems = [
  {
    q: "Вы правда не забираете телефон?",
    a: "Правда. Телефон остаётся у владельца. Пользоваться им можно за внутреннюю валюту, которую зарабатывают в лагере делом. Запрета нет — есть цена."
  },
  {
    q: "А если захочется позвонить домой?",
    a: "Звонки родителям — вне всякой валюты и в любой момент. Это святое. Валюта касается развлекательного экранного времени, а не связи с вами."
  },
  {
    q: "Сколько времени дети реально проводят за компьютером?",
    a: "Около трёх часов в день на IT-занятиях — и это работа над проектом, а не соцсети. Остальной день офлайн: спорт, бассейн, активности."
  },
  {
    q: "Эффект сохранится после возвращения домой?",
    a: "Частично — и это честный ответ. Домой едет привычка, что у экранного времени есть цена. Но дальше многое зависит от семьи. Мы даём старт, а не таблетку. В разделе для родителей рассказываем, как поддержать эффект дома."
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-bez-telefonov.avif"
  title="Детокс от телефона для детей — IT-лагерь АйДаКемп 2026"
  description="Лагерь, после которого телефон перестаёт быть центром вселенной. Не запрет, а замена: внутренняя валюта, IT-проекты, живая среда. Подмосковье, смены июнь–август 2026."
  h1="Лагерь, после которого телефон перестаёт быть центром вселенной"
  canonical="https://aidacamp.ru/detox-ot-telefona"
>
  <Fragment slot="head">
    <FAQSchema items={faqItems} />
  </Fragment>

  <LandingHero slot="hero"
    h1="Лагерь, после которого телефон перестаёт быть центром вселенной"
    subtitle="Телефон при заезде сдаётся — это правда. Но не запирается навсегда: в лагере работает внутренняя валюта, и экранное время на ней можно заработать — за прогресс в проекте, помощь команде, утреннюю зарядку. Когда телефон становится самой ценной «покупкой», а не фоном по умолчанию — подросток сам начинает думать: тратить заработанное на скролл или на что-то поинтереснее. Чаще выбирает второе."
    breadcrumb="Детокс от телефона"
    keywords={[
      "Телефон не забирают — экранное время зарабатывается делом",
      "IT-уроки, бассейн, спорт, хакатоны — к вечеру телефон не нужен",
      "7–15 лет · Подмосковье · лицензия Минобрнауки"
    ]}
    image="/images/hero/lager-bez-telefonov.avif"
    imageAlt="Лагерь детокс от телефона АйДаКемп"
  />

  <!-- Кнопка скролла к сменам -->
  <div class="mx-auto max-w-[1312px] px-4 pt-8 pb-0 text-center">
    <a
      href="#shifts"
      class="inline-flex items-center gap-2 rounded-[14px] bg-primary px-8 py-4 text-[16px] font-semibold text-white hover:bg-primary-hover transition-colors"
    >
      Выбрать смену
      <i class="bi bi-arrow-down text-base" aria-hidden="true"></i>
    </a>
    <p class="mt-3 text-base text-body-faint">7–15 лет · Подмосковье · лицензия Минобрнауки</p>
  </div>

  <!-- БЛОК 2 — ВНУТРЕННЯЯ ЭКОНОМИКА -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-0">
    <h2 class="text-[24px] md:text-[30px] font-bold leading-[1.15] tracking-[-0.02em] text-body mb-5">
      Телефон сдают при заезде. И это самое умное, что мы придумали
    </h2>
    <div class="space-y-4 text-[16px] leading-[1.7] text-body-muted max-w-[720px]">
      <p>В лагере работает внутренняя валюта. Экранное время на личном телефоне за неё можно купить — как и всё остальное. А заработать валюту можно делом: продвинулся в проекте, помог команде, навёл порядок, не проспал зарядку.</p>
      <p>И вот тут происходит интересное. Впервые появляется честный расчёт: потратить заработанное на полчаса в телефоне — или приберечь на что-то поинтереснее. Никто не запрещает. Никто не читает нотаций. Просто у времени появляется цена, и распоряжается ей сам подросток.</p>
      <p>Это не запрет, который заканчивается на выходе из лагеря. Это привычка, которая едет домой: у экранного времени есть стоимость, и я ей управляю.</p>
    </div>
  </section>

  <!-- БЛОК 3 — IT ≠ СИДЕТЬ ЗА КОМПЬЮТЕРОМ -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-0">
    <h2 class="text-[24px] md:text-[30px] font-bold leading-[1.15] tracking-[-0.02em] text-body mb-3">
      IT-лагерь, где за компьютером проводят меньше времени, чем дома
    </h2>
    <p class="text-[16px] leading-[1.7] text-body-muted mb-6 max-w-[720px]">Звучит парадоксально для «компьютерного» лагеря. Но посмотрите на обычный день:</p>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-[16px] bg-card border border-border-light p-5">
        <div class="text-[32px] font-bold text-primary mb-2">3 ч</div>
        <p class="text-base font-semibold text-body mb-1">2 IT-урока в день, по 1,5 часа</p>
        <p class="text-base leading-[1.55] text-body-faint">Код, проекты, нейросети. Экран осмысленный — тут создают, а не листают.</p>
      </div>
      <div class="rounded-[16px] bg-card border border-border-light p-5">
        <div class="text-[32px] font-bold text-primary mb-2">2</div>
        <p class="text-base font-semibold text-body mb-1">Проекта за смену</p>
        <p class="text-base leading-[1.55] text-body-faint">То, что соберут сами и покажут родителям на выходе.</p>
      </div>
      <div class="rounded-[16px] bg-card border border-border-light p-5">
        <div class="text-[32px] font-bold text-primary mb-2">∞</div>
        <p class="text-base font-semibold text-body mb-1">Всё остальное время</p>
        <p class="text-base leading-[1.55] text-body-faint">Бассейн, спорт, хакатоны, квесты, мафия до отбоя.</p>
      </div>
    </div>
    <div class="mt-5 rounded-[14px] bg-orange-50 border border-orange-100 p-5">
      <p class="text-base leading-[1.65] text-body-muted">Итого «за компьютером» — три часа в день, и все три уходят на дело: код, проект, результат. Остальное — движение и люди. К отбою дети засыпают без задних ног. На бесцельный телефон не остаётся ни времени, ни сил — и это не запрет, это просто насыщенный день.</p>
    </div>
  </section>

  <!-- БЛОК 4 — ФАКТЫ -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-0">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      <div class="rounded-[14px] bg-card border border-border-light p-4 flex gap-3 items-start">
        <i class="bi bi-patch-check-fill text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-base font-semibold text-body leading-[1.3]">Лицензия Минобрнауки</p>
          <p class="text-[12px] text-body-faint mt-0.5">{STAT_LICENSE}</p>
        </div>
      </div>
      <div class="rounded-[14px] bg-card border border-border-light p-4 flex gap-3 items-start">
        <i class="bi bi-geo-alt text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-base font-semibold text-body leading-[1.3]">66 км от Москвы</p>
          <p class="text-[12px] text-body-faint mt-0.5">Довезёте за час с небольшим</p>
        </div>
      </div>
      <div class="rounded-[14px] bg-card border border-border-light p-4 flex gap-3 items-start">
        <i class="bi bi-water text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-base font-semibold text-body leading-[1.3]">Бассейн</p>
          <p class="text-[12px] text-body-faint mt-0.5">На территории лагеря</p>
        </div>
      </div>
      <div class="rounded-[14px] bg-card border border-border-light p-4 flex gap-3 items-start">
        <i class="bi bi-people text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-base font-semibold text-body leading-[1.3]">Возраст 7–15 лет</p>
          <p class="text-[12px] text-body-faint mt-0.5">Группы по возрасту</p>
        </div>
      </div>
      <div class="rounded-[14px] bg-card border border-border-light p-4 flex gap-3 items-start col-span-2 md:col-span-1">
        <i class="bi bi-camera-video text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-base font-semibold text-body leading-[1.3]">Связь каждый вечер</p>
          <p class="text-[12px] text-body-faint mt-0.5">Видеозвонок + Telegram-канал с фото за день</p>
        </div>
      </div>
    </div>
  </section>

  <!-- БЛОК 5 — СРАВНЕНИЕ -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-0">
    <h2 class="text-[24px] md:text-[30px] font-bold leading-[1.15] tracking-[-0.02em] text-body mb-6">
      Разница между «отняли» и «показали, что бывает иначе»
    </h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5 md:p-6">
        <p class="text-base font-semibold uppercase tracking-[0.08em] text-slate-400 mb-3">Лагерь с запретом</p>
        <p class="text-base leading-[1.65] text-body-muted">Телефон забрали на входе, отдали на выходе. Две недели прошли в ожидании, когда вернут. Вернули — и за три дня дома всё откатилось обратно. Потому что не изменилось ничего, кроме того, что телефона просто не было под рукой.</p>
      </div>
      <div class="rounded-[16px] bg-orange-50 border border-orange-100 p-5 md:p-6">
        <p class="text-base font-semibold uppercase tracking-[0.08em] text-primary mb-3">АйДаКемп</p>
        <p class="text-base leading-[1.65] text-body-muted">Телефон остался при себе. Но рядом появилось то, ради чего его не хотелось доставать. Меняется не доступ к телефону — меняется отношение. А отношение, в отличие от запрета, едет домой.</p>
      </div>
    </div>
    <p class="mt-5 text-base leading-[1.65] text-body-faint border-l-2 border-slate-200 pl-4 max-w-[680px]">За две недели телефонную привычку не вылечить — честных обещаний такого не бывает. Но можно показать, что есть другой мир: где живое интереснее экрана. Кто этот мир увидел — тот возвращается домой уже немного другим. Не чудо. Сдвиг. Для двух недель это честный результат.</p>
  </section>

  <!-- БЛОК 6 — СМЕНЫ -->
  <section id="shifts" class="mx-auto max-w-[1312px] px-4 pt-14 pb-0">
    <div class="text-center mb-6 max-w-[600px] mx-auto">
      <h2 class="text-[24px] md:text-[30px] font-bold leading-[1.15] tracking-[-0.02em] text-body">Выберите смену</h2>
      <p class="mt-2 text-base text-body-faint">Свободные места есть не на всех — лагерь маленький, 40 детей на смену.</p>
    </div>
    <Shifts />
  </section>

  <!-- БЛОК 7 — ФОРМА -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-0">
    <div class="text-center mb-6 max-w-[560px] mx-auto">
      <h2 class="text-[22px] md:text-[28px] font-bold leading-[1.2] tracking-[-0.02em] text-body">Остались вопросы? Спросите — ответим честно</h2>
      <p class="mt-2 text-base text-body-faint">Перезвоним в течение 10 минут с 11:00 до 20:00 по Москве. Вечером и ночью — напишем с утра.</p>
    </div>
    <AskCta />
  </section>

  <!-- БЛОК 8 — FAQ -->
  <section class="mx-auto max-w-[860px] px-4 pt-14 pb-20">
    <h2 class="text-[22px] md:text-[26px] font-bold leading-[1.2] tracking-[-0.02em] text-body mb-6">Частые вопросы</h2>
    <div class="space-y-3">
      {faqItems.map(item => (
        <details class="rounded-[14px] border border-border-light bg-card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 text-[16px] font-semibold text-body list-none select-none">
            {item.q}
            <i class="bi bi-chevron-down text-base text-body-faint shrink-0 transition-transform group-open:rotate-180" aria-hidden="true"></i>
          </summary>
          <p class="px-5 pb-5 text-base leading-[1.65] text-body-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

</LandingLayout>
