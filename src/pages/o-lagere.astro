---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { getRelatedPages } from '../data/landing-pages';

const sections = [
  {
    h2: "Кто мы и как всё началось",
    text: "АйДаКемп основали в 2019 году. Дарья Афанасьева — мама дочери-подростка — не могла найти <a href='/detskiy-lager'>лагерь</a>, который выбрала бы сама. Везде было или скучно, или страшно отпускать. Решила сделать такой лагерь, какой хотела бы для дочери: с настоящим делом, нормальными людьми рядом и атмосферой, в которую хочется возвращаться. За 6 лет через АйДаКемп прошло 1200+ выпускников. Многие едут снова — сами просят маму забронировать. Почитай <a href='/otzyvy'>отзывы родителей</a>.",
  },
  {
    h2: "Цифры и факты о лагере АйДаКемп",
    text: "Не потому что «так принято писать», а чтобы сразу понимать масштаб и опыт.",
    list: [
      "2019 год — год основания, уже 6 лет в деле",
      "1200+ выпускников за всё время",
      "60% возвращаются повторно — сами просят родителей забронировать",
      "5.0 на Яндекс.Картах — 40+ независимых отзывов",
      "Группы до 8 человек — не поток, а штучная работа",
      "66 км от МКАД — 1 час от Москвы по Киевскому шоссе"
    ]
  },
  {
    h2: "Команда: кто делает лагерь",
    text: "АйДаКемп — небольшая команда, которую знаешь по именам.",
    list: [
      "Дарья Афанасьева — основатель и руководитель. Мама дочери-подростка, именно её опыт лёг в основу формата лагеря. Не педагог на бумаге — человек, который первой спрашивает дочь: «Тебе было бы интересно?»",
      "Никита Брагин и Александр Ташкин — ведущие преподаватели, практикующие IT-специалисты. Авторы учебника по Python для детей (тираж 2 000 экз.)",
      "Вожатые — студенты IT-направлений и молодые педагоги. Проходят отбор и обучение до начала сезона",
      "Соотношение персонала к ребятам — 1:4. Никто не остаётся без внимания"
    ]
  },
  {
    h2: "Лицензия и документы — всё прозрачно",
    text: "Юридически лагерь оформлен как образовательная организация, что даёт родителям налоговый вычет 13%.",
    list: [
      "Лицензия Минобрнауки: Л035-01298-77/01082973 — подтверждает право на образовательную деятельность",
      "Туроператор: РТО 025773 — регистрация в едином реестре Ростуризма",
      "Страхование детей (ВСК) — включено в стоимость каждой смены",
      "Разрешение Роспотребнадзора на работу детского оздоровительного лагеря",
      "Договор оферты, чек об оплате, справка для вычета — всё выдаётся при бронировании"
    ]
  },
  {
    h2: "Что говорят родители — цитаты из отзывов",
    text: "Всё, что написано ниже, — реальные фразы из отзывов на Яндекс.Картах и в нашем Telegram. Без редактуры.",
    list: [
      "«Дочка вернулась совсем другой — спокойнее с телефоном, сама каждый день садится программировать»",
      "«Боялась отпускать первый раз. Получала фото каждый день. Видела по глазам — ей там хорошо»",
      "«Сын приехал и сразу показал бота которого написал. Я не ожидала что за 10 дней можно такому научить»",
      "«Единственный лагерь куда ребёнок сам просит вернуться — обычно мы уговариваем»",
      "«Вожатые и преподаватели отвечали в любое время. Никаких тревог за 14 дней»"
    ]
  },
  {
    h2: "Где мы находимся",
    text: "<a href='/lager-v-podmoskove'>Подмосковье</a>, 66 км от МКАД. Лес, бассейн, спортивные площадки — не бетонный забор с видом на парковку, а настоящая природа. До МКАД примерно час езды: удобно подвезти в первый день и забрать в последний. Адрес и точку на карте отправляем при бронировании.",
    list: [
      "66 км от МКАД — 1 час на машине или автобусе",
      "Собственный бассейн, футбольное поле, волейбол",
      "Жилые корпуса на 2–4 человека с санузлом",
      "Столовая с нормальной едой — мамы отдельно пишут про это в отзывах"
    ]
  },
  {
    h2: "Как устроен день в лагере",
    text: "Телефоны сдают при заезде — это не наказание, это условие, при котором дети вообще начинают общаться и делать что-то интересное. Подробнее про формат: <a href='/lager-bez-telefonov'>лагерь без телефонов</a>. Распорядок примерно такой:",
    list: [
      "Утро — занятия по программированию (Python, Scratch, Roblox, Minecraft, AI — зависит от смены)",
      "Обед, тихий час — без обсуждений",
      "После полудня — бассейн, спорт, командные активности",
      "Вечер — работа над проектом в команде, иногда хакатон-марафон",
      "Вечерний отбой — утром всё заново, но уже чуть бодрее"
    ]
  },
  {
    h2: "Кто преподаёт",
    text: "Практикующие разработчики с опытом 6+ лет. Не студенты, не «энтузиасты» — люди, которые работали или работают в IT-компаниях и умеют объяснять сложное просто. Группы до 8 человек — преподаватель знает каждого по имени и объясняет пока не поймёт, не переходит дальше пока непонятно.",
    list: [
      "Группы до 8 человек — никого не теряют",
      "Разбивка по уровню: новичок, средний, продвинутый",
      "Объясняют пока не поймёт — без «ладно, потом разберёшься»",
      "Следят за тем, чтобы никто не сидел в углу один"
    ]
  },
  {
    h2: "Что в конце смены",
    text: "В последний день — хакатон. Каждый презентует свой проект перед всем отрядом. Получает сертификат, фото с командой. Но главный результат не это. Главное — ребята приезжают домой и сами идут к компьютеру. Не потому что делать нечего, а потому что хочется доделать то, что начали. Это замечают почти все мамы в <a href='/otzyvy'>отзывах</a>.",
    list: [
      "Публичный хакатон в финале — каждый показывает проект",
      "Сертификат участника, фото с командой",
      "60% детей возвращаются в следующую смену",
      "Многие после лагеря записываются на онлайн-занятия сами — без уговоров"
    ]
  },
];
---

<LandingLayout
  heroImage="/images/hero/o-lagere.avif"
  title="О лагере АйДаКемп — IT-лагерь в Подмосковье с 2021"
  description="АйДаКемп — IT-лагерь для детей 7–15 лет в Подмосковье. С 2019 года, 1200+ выпускников, 66 км от МКАД. Узнай о нас."
  h1="О лагере АйДаКемп"
  canonical="https://aidacamp.ru/o-lagere"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Когда основан лагерь АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "С 2019 года. За 5 сезонов через лагерь и школу АйДаКодить прошли более 1 200 детей. 35% возвращаются повторно, 60% новых семей — по рекомендации знакомых." } },
        { "@type": "Question", "name": "Кто организует лагерь АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Основатель — Дарья Афанасьева, мама подростка, педагог с опытом в IT-образовании. Преподаватели — Никита Брагин и Александр Ташкин, практикующие IT-специалисты, авторы учебника по Python для детей (тираж 2 000 экз.)." } },
        { "@type": "Question", "name": "Сколько детей в одной группе?", "acceptedAnswer": { "@type": "Answer", "text": "До 8 человек в группе. Это ключевое отличие от больших лагерей, где дети «теряются в потоке». В малой группе преподаватель видит каждого, успевает объяснить лично, адаптирует программу под темп." } },
        { "@type": "Question", "name": "Какие документы есть у лагеря АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Образовательная лицензия Минобрнауки Л035-01298-77/01082973, туроператор РТО 025773, страхование детей (ВСК), разрешение Роспотребнадзора. Рейтинг 5.0 на Яндекс.Картах, 40+ независимых отзывов." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="О лагере АйДаКемп"
    subtitle="IT-лагерь для детей 7–15 лет в Подмосковье. С 2019 года. 1200+ детей. Группы до 8 человек. 66 км от МКАД."
    breadcrumb="О лагере"
    keywords={[
      "С 2019 года — 1200+ детей прошло через лагерь",
      "Группы до 8 человек — преподаватель знает каждого",
      "60% детей возвращаются сами — без уговоров"
    ]}
    image="/images/hero/o-lagere.avif"
    imageAlt="О лагере АйДаКемп — дети на занятии программированием в Подмосковье"
  />
  <LandingTwoCol sections={sections} />

  <!-- F.69/F.70: Документы и упоминания в СМИ -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <h2 class="text-[20px] md:text-[24px] font-bold text-slate-900 mb-6">Документы и упоминания</h2>
    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div class="rounded-[16px] border border-slate-200 bg-white p-5 flex gap-4">
        <i class="bi bi-patch-check-fill text-[28px] text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-[15px] font-semibold text-slate-900 mb-1">Образовательная лицензия</p>
          <p class="text-[13px] text-slate-500">Лицензия Минпросвещения Л035-01298-77/01082973 — право на образовательную деятельность и основание для налогового вычета</p>
        </div>
      </div>
      <div class="rounded-[16px] border border-slate-200 bg-white p-5 flex gap-4">
        <i class="bi bi-award-fill text-[28px] text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-[15px] font-semibold text-slate-900 mb-1">Туроператор РТО 025773</p>
          <p class="text-[13px] text-slate-500">Реестровая запись в федеральном реестре туроператоров. Финансовая ответственность застрахована</p>
        </div>
      </div>
    </div>
    <div class="rounded-[16px] bg-slate-50 border border-slate-100 p-5">
      <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-slate-400 mb-3">Упоминания в СМИ</p>
      <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="flex items-start gap-3 group">
        <i class="bi bi-trophy-fill text-[18px] text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <p class="text-[14px] font-semibold text-slate-800 group-hover:text-primary transition-colors">vc.ru / GdeKurs — ТОП-4 IT-лагерей Подмосковья 2025</p>
          <p class="text-[13px] text-slate-500 mt-0.5">«Топ-20 детских летних IT-лагерей в Москве и Подмосковье» — независимый рейтинг</p>
        </div>
        <i class="bi bi-box-arrow-up-right text-[12px] text-slate-400 shrink-0 mt-1 ml-auto" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
