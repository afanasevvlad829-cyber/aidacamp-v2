---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Маршрут из Домодедово в АйДаКемп",
    text: "Из Домодедово в АйДаКемп удобнее всего на машине через Каширское шоссе или через Подольск — это прямая дорога без лишних развязок.",
    list: [
      "На машине: Домодедово → Каширское шоссе → М3 → около 100 км",
      "Альтернатива через Подольск: Домодедово → Подольск → А-107 → Наро-Фоминск → Апрелевка — ~55 км, около 55 минут",
      "МЦД-2: ст. Домодедово → Москва-Пасс. → пересадка → м. Солнцево (1 ч 20 мин). Бесплатный трансфер от Солнцево",
      "Из Домодедово: метро + МЦД до м. Солнцево — 30–40 минут (через Домодедово-1 или Красная Горка + метро)"
    ]
  },
  {
    h2: "Отправляете ребёнка в лагерь и сами летите в отпуск?",
    text: "Домодедово — это одновременно город и аэропорт. Многие семьи из Домодедово летят на отдых именно в то время, когда ребята в лагере. Практично: вы отправляете сына или дочь на смену (трансфер от Солнцево, или сами довозите до лагеря), и улетаете спокойно.",
    list: [
      "Ежедневные фото в Telegram — ребёнок под присмотром, вы отдыхаете",
      "Возможность позвонить в любое время смены — не нужно переживать",
      "При необходимости можно быть рядом через час — лагерь в Подмосковье, не на другом конце страны",
      "Июль занят полностью. В июне и августе ещё есть места"
    ]
  },
  {
    h2: "Трансфер из Домодедово в лагерь",
    text: "Лагерь организует бесплатный трансфер от м. Солнцево в день заезда и обратно в день отъезда. Из Домодедово до м. Солнцево — около 30–40 минут через метро или МЦД.",
    list: [
      "Трансфер бесплатный от м. Солнцево — точное время уточняется при бронировании",
      "Из Домодедово до точки сбора: метро или МЦД, 30–40 минут",
      "Многие семьи из Домодедово едут на машине через Подольск — это около часа без пробок"
    ]
  },
  {
    h2: "Налоговый вычет для жителей Домодедово",
    text: "АйДаКемп — лицензированная образовательная организация. Родители из Домодедово могут вернуть 13% от стоимости образовательной части путёвки — точно так же, как жители любого другого региона, через личный кабинет nalog.ru.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽",
      "Выдаём договор и чеки при заезде — всё, что нужно для вычета"
    ]
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Домодедово",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в Minecraft, Roblox или Python-разработку"
    ]
  },
  {
    h2: "Почему родители из Домодедово выбирают АйДаКемп",
    text: "Из Домодедово до лагеря через Подольск — чуть больше часа. Это не просто «удобно», это реально меняет условия:",
    list: [
      "Подмосковье: никакой акклиматизации, ребёнок адаптируется с первого часа",
      "При необходимости можно быть рядом через час — без перелётов и поездов",
      "Трансфер бесплатный от м. Солнцево — 30–40 минут от Домодедово",
      "Можно приехать проведать в любой день смены — лагерь открыт для родителей",
      "Ежедневные фото в Telegram — видите, чем занимается ребёнок, даже если сами в отпуске"
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "В смене АйДаКемп работают два типа взрослых: IT-преподаватели (ведут учебные блоки, 1 педагог на 6–8 ребят) и вожатые (отвечают за жизнь в лагере, организацию досуга, безопасность). Вожатые — студенты педагогических и психологических специальностей, проходящие конкурсный отбор. IT-преподаватели — практикующие разработчики и выпускники технических вузов. Медицинский работник находится на территории в течение всей смены.",
    list: [
      "Соотношение: 1 преподаватель на 6–8 учеников в группе",
      "Вожатые — конкурсный отбор, студенты педагогических специальностей",
      "Медработник круглосуточно на территории",
      "Ежедневные фото в Telegram — родители видят, чем занимается ребёнок"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Июль занят полностью. В июне и августе ещё есть места. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер от м. Солнцево в день заезда — бесплатный.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей с юга Подмосковья",
    text: "В АйДаКемп едут дети из Домодедово, Видного, Раменского и других городов южного Подмосковья. Вот что пишут родители:",
    list: [
      "«До Юго-Западной с пересадкой минут 35, а потом автобус. Дочь была в полном восторге от IT-программы» — Марина, мама Насти, 12 лет",
      "«Искала не просто лагерь с бассейном, а чтобы ребёнок ещё и научился чему-то — нашла АйДаКемп и не пожалела ни секунды» — Светлана, Видное",
      "«Сын уехал геймером, вернулся программистом — сделал собственную игру на Roblox и теперь учит одноклассников» — Павел, Раменское"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Домодедово 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Домодедово: ~55 км через Подольск, ~1 час. МЦД-2 до м. Солнцево + трансфер. Ребёнок в лагере — вы летите в отпуск. Июль занят. От 48 000 ₽."
  h1="Детский лагерь рядом с Домодедово"
  canonical="https://aidacamp.ru/lager-domodedovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Домодедово до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Домодедово удобнее всего на машине через Подольск — около 55 км, ~55 минут без пробок. Или: метро до м. Солнцево (30–40 мин) и оттуда трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Домодедово?",
          "acceptedAnswer": { "@type": "Answer", "text": "На машине через Подольск — около 55 минут. На трансфере через м. Солнцево — 30–40 минут до точки сбора плюс поездка автобусом." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт не нужен: есть группы для начинающих (с нуля), среднего и продвинутого уровня. Занятия в группах до 8 человек с практикующими IT-специалистами." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание, 5-разовое питание, IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности, страховка. Трансфер от м. Солнцево — бесплатно." }
        },
        {
          "@type": "Question",
          "name": "Есть ли возможность оплатить путёвку частями?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да: 50% при бронировании, 50% за 3 недели до заезда. Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней)." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Домодедово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~60 км от Домодедово через Подольск. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-domodedovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Домодедово"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~55 км через Подольск, ~1 час. Отправляете ребёнка на смену — и летите в отпуск спокойно."
    breadcrumb="Лагерь из Домодедово"
    keywords={["~60 км от Домодедово через Подольск (~1 час)", "IT-лагерь с проживанием, бассейн, 5-разовое питание", "Python, AI, Minecraft, Roblox для детей 7–15 лет"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Домодедово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
