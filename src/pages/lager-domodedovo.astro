    "bestRating": "5",
    "worstRating": "1"
  }
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь Домодедово 2026 — IT-смена для 7–15 лет"
    subtitle="66 км от МКАД по Киевскому шоссе, ~час в дороге. Лето 2026: отправляете ребёнка на смену — и летите в отпуск спокойно. Ежедневные фото в Telegram."
    breadcrumb="Лагерь из Домодедово"
    keywords={["66 км от МКАД по Киевскому шоссе (~1 час)", "IT-лагерь с проживанием, бассейн, 5-разовое питание", "Python, AI, Minecraft, Roblox для ребят 8–17 лет"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Домодедово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
