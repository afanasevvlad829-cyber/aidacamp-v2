---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Летний лагерь в Домодедово — это про что",
    text: "Летний лагерь в Домодедово сам по себе не ищут — ищут смену, до которой можно довезти ребёнка за час и не переживать. У нас именно так: 55 км через Подольск, час по А-107, и вы сдаёте сына или дочь вожатой на крыльце санатория «Изумруд».\n\nЭто IT-лагерь. Ребята 8–17 лет, программирование, нейросети, Minecraft, Roblox. Школьники из Домодедово, Видного, Раменского — у нас половина смены такая.\n\nДарья, основатель, её дочка ездила первой — начинали именно потому, что нормального лагеря под боком не было. Сейчас отправляем чужих детей и каждый день дёргаемся: всё ли с ними хорошо? Поэтому в чате родителей фото льются с утра до отбоя.",
  },
  {
    h2: "Сколько ехать из Домодедово до лагеря",
    text: "Короткий ответ: час на машине, два — на электричке с пересадкой и трансфером. Лагерь — в Наро-Фоминском округе, посёлок Колонтаево, санаторий «Изумруд».",
    list: [
      "На машине через Подольск и А-107 — ~55 км, 55–70 минут без пробок. Дорога ровная, без МКАД",
      "Альтернатива через Каширку и М-2 — длиннее, ~100 км, но без светофоров",
      "Без машины: ст. Домодедово → Москва-Павелецкая → метро до Солнцево (~1 ч 10 мин)",
      "От м. Солнцево — бесплатный трансфер лагеря в день заезда и в день отъезда. Сбор обычно в 11:00"
    ]
  },
  {
    h2: "Почему удобно именно из Домодедово",
    text: "Домодедово — это и город, и аэропорт. Половина наших семей из вашего района летит в отпуск как раз в смену. Получается естественная схема: вы довозите ребёнка в субботу до Колонтаево, обнимаете, едете в Шереметьево или обратно в Домодедово и улетаете. У ребёнка — лагерь. У вас — Турция. Все взрослые.",
    list: [
      "Час до лагеря в обе стороны — если что, приедете быстрее, чем такси из Сочи до отеля",
      "Без перелёта и акклиматизации — ребёнок не теряет первые три дня смены на «привыкание к климату»",
      "Ежедневные фото в Telegram-чате родителей — видите дочку с тарелкой каши в 9:00, с ноутом в 11:00, в бассейне в 16:00",
      "Можно позвонить ребёнку в любое время — не «по расписанию», как в некоторых лагерях"
    ]
  },
  {
    h2: "Что ребёнок реально делает в лагере",
    text: "Не «знакомится с миром IT». Делает свой проект и защищает его на хакатоне в конце смены. Уезжает домой с готовой штукой, которую можно показать одноклассникам.",
    list: [
      "Python и нейросети — для 12–17 лет. К концу смены — телеграм-бот с ChatGPT внутри или полезный скрипт",
      "Minecraft Education и Roblox — для 8–12 лет. Свой мир, свои моды, своя мини-игра",
      "3D-моделирование в Blender — для тех, кто хочет рисовать, но устал от бумаги",
      "AI и нейросети для творчества — Midjourney, Stable Diffusion, своя серия артов",
      "Группы до 8 ребят, один преподаватель на 6–8 человек, занятия — два раза в день по 90 минут"
    ]
  },
  {
    h2: "Условия проживания и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский округ. Корпуса с ремонтом, комнаты по 2–4 человека с собственным санузлом и душем. Бассейн с ионизированной водой, спортплощадки, лесная территория, КПП, охрана 24/7.",
    list: [
      "Питание: 5 раз в день — завтрак, второй завтрак, обед, полдник, ужин. Учитываем аллергии",
      "Медик на территории круглосуточно всю смену. Лекарства по расписанию — он же, не ребёнок сам",
      "Территория закрытая, огорожена, камеры в ключевых зонах, посторонним не зайти",
      "Вожатые — студенты педагогических и психологических факультетов с конкурсным отбором, работают парами",
      "Telegram-чат родителей: фото каждый день, ответы на вопросы в течение часа"
    ]
  },
  {
    h2: "Сколько стоит и как вернуть 13%",
    text: "В стоимость входит всё: проживание, пятиразовое питание, IT-программа, ноутбуки, бассейн, спорт, медик, страховка, итоговый хакатон. Доплат за «оборудование» или «материалы» нет.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽ → налоговый возврат ~2 800 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ → возврат до 5 434 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽ → возврат ~5 200 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽ → возврат ~4 800 ₽",
      "Возврат 50% стоимости, если не понравится в первые 3 дня смены (для смен от 10 дней)"
    ]
  },
  {
    h2: "Что говорят родители из Домодедово и района",
    text: "В АйДаКемп едут ребята из Домодедово, Видного, Раменского и других городов южного Подмосковья.",
    list: [
      "«Дочка всё лето сидела в телефоне, я была в отчаянии. Вернулась с собственным ботом в телеграме, который помогает делать домашку. Я в шоке, в хорошем смысле.» — Марина, мама Насти, 12 лет, Домодедово",
      "«Искала не просто лагерь с бассейном, а чтобы ребёнок ещё и научился чему-то — нашла АйДаКемп и не пожалела ни секунды. Час до лагеря на машине, всё рядом.» — Светлана, Видное",
      "«Сын уехал геймером, вернулся программистом — сделал собственную игру на Roblox и теперь учит одноклассников. Из Раменского ехали 40 минут.» — Павел, Раменское"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний лагерь Домодедово 2026 — IT-смена 55 км от города | АйДаКемп"
  description="Летний лагерь рядом с Домодедово: 55 км через Подольск, час в дороге. Программирование, бассейн, 5-разовое питание. Июль уже занят, на июнь и август места есть."
  h1="Летний лагерь Домодедово 2026 — IT-смена 55 км от города"
  canonical="https://aidacamp.ru/lager-domodedovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Домодедово до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Домодедово удобнее всего на машине через Подольск — около 55 км, ~55 минут без пробок. Или: метро до м. Солнцево (30–40 мин) и оттуда трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Домодедово?",
          "acceptedAnswer": { "@type": "Answer", "text": "На машине через Подольск — около 55 минут. На трансфере через м. Солнцево — 30–40 минут до точки сбора плюс поездка автобусом." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт не нужен: есть группы для начинающих (с нуля), среднего и продвинутого уровня. Занятия в группах до 8 человек с практикующими IT-специалистами." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание, 5-разовое питание, IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности, страховка. Трансфер от м. Солнцево — бесплатно." }
        },
        {
          "@type": "Question",
          "name": "Есть ли возможность оплатить путёвку частями?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да: 50% при бронировании, 50% за 3 недели до заезда. Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней)." }
        },
        {
          "@type": "Question",
          "name": "Какие детские лагеря работают рядом с Домодедово летом 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — IT-лагерь в 55 км от Домодедово (Наро-Фоминский район, санаторий «Изумруд»), работает летом 2026: июнь и август (июль занят). Смены 7–14 дней, Python, AI, Minecraft, Roblox для школьников 7–15 лет." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Домодедово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~60 км от Домодедово через Подольск. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-domodedovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь Домодедово 2026 — IT-смена 55 км от города"
    subtitle="55 км через Подольск, час в дороге. Лето 2026: отправляете ребёнка на смену — и летите в отпуск спокойно. Ежедневные фото в Telegram."
    breadcrumb="Лагерь из Домодедово"
    keywords={["~55 км от Домодедово через Подольск (~1 час)", "IT-лагерь с проживанием, бассейн, 5-разовое питание", "Python, AI, Minecraft, Roblox для ребят 8–17 лет"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Домодедово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
