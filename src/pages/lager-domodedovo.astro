---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Домодедово",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, примерно в 60 км от Домодедово. Удобный маршрут — через А-107 (Большая бетонка) или по Симферопольскому шоссе через Подольск на Наро-Фоминск, около часа езды. Организованный трансфер отправляется от м. Солнцево — от Домодедово это 30–35 минут, затем автобус доставит прямо в лагерь."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Домодедово",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в Minecraft, Roblox или Python-разработку"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с конца мая по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Отзывы семей с юга Подмосковья",
    text: "В АйДаКемп едут дети из Домодедово, Видного, Раменского и других городов южного Подмосковья. Вот что пишут родители:",
    list: [
      "«Из Домодедово до Солнцево около получаса, автобус всё взял на себя. Дочь была в полном восторге от IT-программы» — Марина, мама Насти, 12 лет",
      "«Искала не просто лагерь с бассейном, а чтобы ребёнок ещё и научился чему-то — нашла АйДаКемп и не пожалела ни секунды» — Светлана, Видное",
      "«Сын уехал геймером, вернулся программистом — сделал собственную игру на Roblox и теперь учит одноклассников» — Павел, Раменское"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь рядом с Домодедово 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Домодедово: ~60 км через Подольск, около часа. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Домодедово"
  canonical="https://aidacamp.ru/lager-domodedovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Домодедово до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Домодедово — ~60 км через Подольск и Наро-Фоминск, около 1 часа. Организованный трансфер отправляется от м. Солнцево (45–60 мин. от Домодедово). Стоимость трансфера — 2 500 ₽." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт не нужен: есть группы для начинающих (с нуля), среднего и продвинутого уровня. Занятия в группах до 8 человек с практикующими IT-специалистами." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание, 5-разовое питание, IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности, страховка. Дополнительно — трансфер из Москвы (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Есть ли возможность оплатить путёвку частями?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да: 50% при бронировании, 50% за 3 недели до заезда. Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней)." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Домодедово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~60 км от Домодедово через Подольск. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-domodedovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Домодедово"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~60 км от Домодедово через Подольск. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Домодедово"
    keywords={["~60 км от Домодедово через Подольск (~1 час)", "IT-лагерь с проживанием, бассейн, 5-разовое питание", "Python, AI, Minecraft, Roblox для детей 7–15 лет"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Домодедово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
