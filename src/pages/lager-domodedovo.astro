---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S21, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Летний лагерь в Домодедово — это про что",
    text: "Детский лагерь в Домодедово сам по себе не ищут — ищут смену, до которой можно довезти ребёнка за час и не переживать. У нас именно так: АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час), и вы сдаёте дочь или сына вожатой на крыльце санатория «Изумруд».\n\nЭто IT-лагерь. Ребята 8–17 лет, программирование, нейросети, Minecraft, Roblox. Школьники из Домодедово, Видного, Раменского — у нас половина смены такая.\n\nДарья, основатель, её дочка ездила первой — начинали именно потому, что нормального лагеря под боком не было. Сейчас отправляем чужих ребят и каждый день дёргаемся: всё ли с ними хорошо? Поэтому в чате родителей фото льются с утра до отбоя.",
  },
  {
    h2: "Сколько ехать из Домодедово до лагеря",
    text: "Короткий ответ: около часа на машине, дольше — на электричке с пересадкой и трансфером. Лагерь — санаторий «Изумруд», Наро-Фоминский городской округ Московской области.",
    list: [
      "АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час без пробок)",
      "Из Домодедово: на машине по Киевскому шоссе, либо до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин)",
      "Без машины: до м. Солнцево (Солнцевская линия), оттуда автобус-трансфер с сопровождающим до лагеря",
      "Трансфер от м. Солнцево — 2 000 ₽ в один конец, сопровождающий до лагеря. Сбор обычно в 11:00"
    ]
  },
  {
    h2: "Почему удобно именно из Домодедово",
    text: "Домодедово — это и город, и аэропорт. Половина наших семей из вашего района летит в отпуск как раз в смену. Получается естественная схема: вы довозите ребёнка в субботу до Колонтаево, обнимаете, едете в Шереметьево или обратно в Домодедово и улетаете. У ребёнка — лагерь. У вас — Турция. Все взрослые.",
    list: [
      "Около часа до лагеря в обе стороны — если что, приедете быстрее, чем такси из Сочи до отеля",
      "Без перелёта и акклиматизации — ребёнок не теряет первые три дня смены на «привыкание к климату»",
      "Ежедневные фото в Telegram-чате родителей — видите дочку с тарелкой каши в 9:00, с ноутом в 11:00, в бассейне в 16:00",
      "Можно позвонить ребёнку в любое время — не «по расписанию», как в некоторых лагерях"
    ]
  },
  {
    h2: "Что ребёнок реально делает в лагере",
    text: "Не «знакомится с миром IT». Делает свой проект и защищает его на хакатоне в конце смены. Уезжает домой с готовой штукой, которую можно показать одноклассникам.",
    list: [
      "Python и нейросети — для 12–17 лет. К концу смены — телеграм-бот с ChatGPT внутри или полезный скрипт",
      "Minecraft Education и Roblox — для 8–12 лет. Свой мир, свои моды, своя мини-игра",
      "3D-моделирование в Blender — для тех, кто хочет рисовать, но устал от бумаги",
      "AI и нейросети для творчества — Midjourney, Stable Diffusion, своя серия артов",
      "Группы до 8 ребят, один преподаватель на 6–8 человек, занятия — два раза в день по 90 минут"
    ]
  },
  {
    h2: "Условия проживания и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский округ. Корпуса с ремонтом, комнаты по 2–4 человека с собственным санузлом и душем. Бассейн с ионизированной водой, спортплощадки, лесная территория, КПП, охрана 24/7.",
    list: [
      "Питание: 5 раз в день — завтрак, второй завтрак, обед, полдник, ужин. Учитываем аллергии",
      "Медик на территории круглосуточно всю смену. Лекарства по расписанию — он же, не ребёнок сам",
      "Территория закрытая, огорожена, камеры в ключевых зонах, посторонним не зайти",
      "Вожатые — студенты педагогических и психологических факультетов с конкурсным отбором, работают парами",
      "Telegram-чат родителей: фото каждый день, ответы на вопросы в течение часа"
    ]
  },
  {
    h2: "Сколько стоит и как вернуть 13%",
    text: "В стоимость входит всё: проживание, пятиразовое питание, IT-программа, ноутбуки, бассейн, спорт, медик, итоговый хакатон. Доплат за «оборудование» или «материалы» нет.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней, ${PRICE_MIN} → налоговый возврат ~${VYCHET_S21}`,
      `Смена 2 — 10–23 июня, 14 дней, ${PRICE_MAX} → возврат до ${VYCHET_MAX} (самая популярная)`,
      `Смена 3 — 3–15 августа, 13 дней, ${PRICE_S3} → возврат ~${VYCHET_S3}`,
      `Смена 4 — 17–26 августа, 10 дней, ${PRICE_S4} → возврат ~${VYCHET_S4}`,
      "Возврат 50% стоимости, если не понравится в первые 3 дня смены (для смен от 10 дней)"
    ]
  },
  {
    h2: "Что говорят родители из Домодедово и района",
    text: "В АйДаКемп едут ребята из Домодедово, Видного, Раменского и других городов южного Подмосковья.",
    list: [
      "«Дочка всё лето сидела в телефоне, я была в отчаянии. Вернулась с собственным ботом в телеграме, который помогает делать домашку. Я в шоке, в хорошем смысле.» — Марина, мама Насти, 12 лет, Домодедово",
      "«Искала не просто лагерь с бассейном, а чтобы ребёнок ещё и научился чему-то — нашла АйДаКемп и не пожалела ни секунды. Час до лагеря на машине, всё рядом.» — Светлана, Видное",
      "«Сын уехал геймером, вернулся программистом — сделал собственную игру на Roblox и теперь учит одноклассников. Доехали по Киевскому шоссе примерно за час.» — Павел, Раменское"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский лагерь Домодедово 2026 — IT-смена за час | АйДаКемп"
  description="Детский IT-лагерь рядом с Домодедово: 66 км от МКАД, ~1 час. Python, нейросети, Minecraft, Roblox. Питание 5 раз, бассейн, медик. Трансфер 2000₽, возврат 13%."
  h1="Летний лагерь Домодедово 2026 — IT-смена для 7–15 лет"
  canonical="https://aidacamp.ru/lager-domodedovo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Домодедово до лагеря?", a: "АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час). Из Домодедово: на машине по Киевскому шоссе, либо до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин)." },
    { q: "Сколько ехать из Домодедово?", a: "АйДаКемп — 66 км от МКАД по Киевскому шоссе, ~1 час без пробок. Без машины — до м. Солнцево и трансфер лагеря (2 000 ₽)." },
    { q: "Для каких детей подходит IT-лагерь?", a: "Для детей 7–15 лет. Опыт не нужен: есть группы для начинающих (с нуля), среднего и продвинутого уровня. Занятия в группах до 8 человек с практикующими IT-специалистами." },
    { q: "Что входит в стоимость путёвки?", a: "Проживание, 5-разовое питание, IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности. Трансфер от м. Солнцево — 2 000 ₽ в один конец." },
    { q: "Есть ли возможность оплатить путёвку частями?", a: `Да: 50% при бронировании, 50% за 3 недели до заезда. Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней).` },
    { q: "Какие детские лагеря работают рядом с Домодедово летом 2026?", a: "АйДаКемп — детский IT-лагерь в 66 км от МКАД по Киевскому шоссе (Наро-Фоминский округ, санаторий «Изумруд»), работает летом 2026: июнь и август. Смены 7–14 дней, Python, AI, Minecraft, Roblox для школьников 7–15 лет." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Домодедово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-domodedovo"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationEvent",
  "name": "Летний IT-лагерь АйДаКемп в Домодедово",
  "description": "Летний лагерь программирования для детей 8-17 лет в Наро-Фоминском округе",
  "image": "/images/hero/lager-na-leto-2026.avif",
  "startDate": "2026-06-10",
  "endDate": "2026-08-26",
  "eventStatus": "EventScheduled",
  "eventAttendanceMode": "OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Санаторий «Изумруд»",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Наро-Фоминский округ",
      "addressRegion": "Московская область",
      "postalCode": "143500",
      "addressCountry": "RU"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "АйДаКемп",
    "url": "https://aidacamp.ru",
    "logo": "/logo.png"
  },
