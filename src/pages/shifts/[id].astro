---
/**
 * Динамическая страница смены — /shifts/[id]/
 *
 * Берёт данные из src/data/shifts.ts (allShifts) + src/data/shift-info.ts
 * Layout вдохновлён shift-story_2.html: hero с большими датами →
 * strip с мета (возраст/группы/опыт) → story timeline → milestones → result → booking.
 *
 * Создаётся на каждую смену из allShifts (не displayShifts!) — завершённые смены
 * (shift-1, shift-2, shift-2-1, shift-2-2) в allShifts больше не входят, страниц
 * для них getStaticPaths не генерирует. Сейчас: shift-3, shift-4.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ShiftBookModal from '../../components/shifts/ShiftBookModal.astro';
import ShiftTimeline from '../../components/shifts/ShiftTimeline.astro';
import WaitlistInfoIcon from '../../components/shifts/WaitlistInfoIcon.astro';
import { allShifts, shiftInfo, type Shift, getAvailabilityLevel, getBookingCta, WAITLIST_EXPLANATION, SEASON_YEAR } from '../../data/shifts';
import { getCurrentPrice, getTaxDeduction, fmtPrice } from '../../data/dynamicPrices';

export async function getStaticPaths() {
  return allShifts.map((shift) => ({
    params: { id: shift.id },
    props: { shift },
  }));
}

interface Props {
  shift: Shift;
}

const { shift } = Astro.props;
const info = shiftInfo[shift.id];

// Total для progress bar
const total = (shift.free || 0) + (shift.occupied || 0) || 1;
const occupiedPct = Math.round((shift.occupied / total) * 100);
const isLowAvail = occupiedPct >= 85;
const isSoldOut = getAvailabilityLevel(shift) === 'soldout';
const bookingCta = getBookingCta(shift);

// Парсинг дат для крупного отображения «10—23 июня»
const months: Record<string, string> = {
  '01': 'января', '02': 'февраля', '03': 'марта', '04': 'апреля',
  '05': 'мая', '06': 'июня', '07': 'июля', '08': 'августа',
  '09': 'сентября', '10': 'октября', '11': 'ноября', '12': 'декабря',
};
const startMonth = shift.startDate.split('-')[1];
const endMonth = shift.endDate.split('-')[1];
const startDay = parseInt(shift.startDate.split('-')[2]);
const endDay = parseInt(shift.endDate.split('-')[2]);
const sameMonth = startMonth === endMonth;
const heroDateBig = sameMonth
  ? `${startDay}—${endDay}`
  : `${startDay} ${months[startMonth].slice(0, 3)} — ${endDay} ${months[endMonth].slice(0, 3)}`;
const heroMonthLabel = sameMonth ? months[startMonth] : '';

// Актуальная цена (SSR) — единый источник
const ssrPrice    = getCurrentPrice(shift.id) ?? parseInt(shift.price.replace(/\D/g, ''), 10);
const ssrPriceFmt = fmtPrice(ssrPrice);
const ssrVychet   = getTaxDeduction(shift.id);

// SEO
const seoTitle = shift.id === 'shift-3'
  ? `${shift.name} IT-лагеря — летняя смена, ${startDay}—${endDay} ${months[startMonth]} ${SEASON_YEAR} | АйДаКемп`
  : `${shift.name} IT-лагеря — летняя смена в Подмосковье, ${shift.dates} ${SEASON_YEAR} | АйДаКемп`;
const seoDescription = shift.id === 'shift-3'
  ? `Летняя смена в лагере в Подмосковье: Python, AI, хакатон, бассейн, 5-разовое питание. ${shift.duration}, возраст 7–15, ${ssrPriceFmt} — всё включено, доплат нет.`
  : `Летняя смена в лагере под Москвой: Python, AI, хакатон. ${shift.duration}, возраст 7–15, ${ssrPriceFmt} всё включено. Купить смену в IT-лагерь — смены лагерей с ${shift.dates} ${SEASON_YEAR}.`;
const durationDays = parseInt(shift.duration.replace(/[^\d]/g, ''), 10) || 14;
---

<Base
  title={seoTitle}
  description={seoDescription}
  heroPreloadDesktop="/images/hero-desktop.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["EducationEvent", "ChildrensEvent"],
          "@id": `https://aidacamp.ru/shifts/${shift.id}/`,
          "name": `${shift.name} — АйДаКемп ${shift.dates} ${SEASON_YEAR}`,
          "description": shift.description,
          "startDate": shift.startDate,
          "endDate": shift.endDate,
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "eventStatus": "https://schema.org/EventScheduled",
          "url": `https://aidacamp.ru/shifts/${shift.id}/`,
          "image": "https://aidacamp.ru/images/hero-desktop.avif",
          "location": {
            "@type": "Place",
            "name": "Санаторий Изумруд",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Наро-Фоминский городской округ",
              "addressRegion": "Московская область",
              "addressCountry": "RU",
              "postalCode": "143381"
            }
          },
          "organizer": {
            "@type": "Organization",
            "name": "АйДаКемп",
            "url": "https://aidacamp.ru"
          },
          "offers": {
            "@type": "Offer",
            "price": String(ssrPrice),
            "priceCurrency": "RUB",
            "availability": shift.free > 0 ? "https://schema.org/InStock" : "https://schema.org/SoldOut",
            "url": `https://aidacamp.ru/shifts/${shift.id}/`,
            "validFrom": "2026-01-01"
          },
          "audience": {
            "@type": "PeopleAudience",
            "suggestedMinAge": 7,
            "suggestedMaxAge": 15
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
            { "@type": "ListItem", "position": 2, "name": "Смены", "item": "https://aidacamp.ru/shifts/" },
            { "@type": "ListItem", "position": 3, "name": shift.name, "item": `https://aidacamp.ru/shifts/${shift.id}/` }
          ]
        }
      ]
    })} />
  </Fragment>
  {shift.id === 'shift-1' && (
    <div
      id="shift-top-bar"
      class="bg-primary text-white px-4 text-base font-semibold sticky top-0 z-[60]"
      style="padding-top: calc(env(safe-area-inset-top, 0px) + 8px); padding-bottom: 8px;"
    >
      <div class="mx-auto flex max-w-4xl items-center justify-between gap-2">
        <div class="flex min-w-0 flex-1 items-center justify-center gap-1.5 flex-wrap">
          <i class="bi bi-lightning-charge text-base shrink-0" aria-hidden="true"></i>
          <span>Осталось <span data-spots-num data-spots-shift={shift.id} class="cursor-pointer blur-[6px] transition-[filter] duration-300 select-none">{shift.free} {shift.free === 1 ? 'место' : shift.free < 5 ? 'места' : 'мест'}</span> · Старт 30 мая ·</span>
          <a href="#booking" class="underline underline-offset-2 hover:text-white/90 transition-colors whitespace-nowrap">Забронировать →</a>
        </div>
        <button
          id="shift-top-bar-close"
          type="button"
          class="shrink-0 inline-flex h-7 w-7 items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/20 transition-colors"
          aria-label="Закрыть"
        >
          <i class="bi bi-x-lg text-base" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  )}
  <Header />
  <main class="pb-20 md:pb-0">

    <!-- ═══════ HERO — крупные даты, цена, occupancy, CTA ═══════ -->
    <section class="relative overflow-hidden bg-dark-navy text-white">
      <!-- Background photo: portrait для mobile, desktop для md+ -->
      <picture>
        <source media="(max-width: 768px)" srcset="/images/hero-mobile-bean-v3-600.avif" />
        <img src="/images/hero-desktop.avif" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-55" style="object-position: center 30%;" loading="eager" />
      </picture>
      <!-- Затемняющий градиент -->
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,9,18,0.85)_0%,rgba(5,9,18,0.55)_50%,rgba(5,9,18,0.75)_100%)]" aria-hidden="true"></div>
      <!-- Top header overlay -->
      <div class="absolute top-0 left-0 right-0 h-[100px] bg-[linear-gradient(180deg,rgba(0,0,0,0.45)_0%,rgba(0,0,0,0)_100%)] pointer-events-none" aria-hidden="true"></div>
      <!-- Brand orange ambient -->
      <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_70%_30%,rgba(236,155,68,0.15)_0%,transparent_60%)] mix-blend-soft-light" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-[1200px] px-5 pt-24 pb-10 md:px-8 md:pt-32 md:pb-16">
        <!-- Breadcrumb -->
        <nav class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-base text-white/60" aria-label="Хлебные крошки">
          <a href="/" class="hover:text-white">Главная</a>
          <i class="bi bi-chevron-right text-[10px]" aria-hidden="true"></i>
          <a href="/#shifts" class="hover:text-white">Смены</a>
          <i class="bi bi-chevron-right text-[10px]" aria-hidden="true"></i>
          <span class="text-white/85">{shift.name}</span>
        </nav>

        <!-- Eyebrow tag -->
        <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-md px-3 py-1 text-[12px] font-bold uppercase tracking-[0.14em] text-white">
          <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
          {shift.name} · Лето {SEASON_YEAR}{shift.popular ? ' · Популярная' : ''}
        </p>

        <!-- Occupancy badge -->
        {shift.free === 0 && (
          <div class="mb-3 block">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-red-500/90 backdrop-blur-md px-3 py-1 text-base font-semibold text-white">
              <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
              Мест нет
            </span>
          </div>
        )}
        {shift.free > 0 && shift.free <= 5 && (
          <div class="mb-3 block">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-600 backdrop-blur-md px-3 py-1 text-base font-semibold text-white">
              <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
              Осталось <span data-spots-num data-spots-shift={shift.id} class="cursor-pointer blur-[6px] transition-[filter] duration-300 select-none">{shift.free} {shift.free === 1 ? 'место' : shift.free < 5 ? 'места' : 'мест'}</span>
            </span>
          </div>
        )}
        {shift.free > 5 && (
          <div class="mb-3 block">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/90 backdrop-blur-md px-3 py-1 text-base font-semibold text-white">
              <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
              Осталось <span data-spots-num data-spots-shift={shift.id} class="cursor-pointer blur-[6px] transition-[filter] duration-300 select-none">{shift.free} мест</span>
            </span>
          </div>
        )}

        <!-- BIG DATES (как в концепте «10—23 июня») -->
        <h1 class="sr-only">{shift.id === 'shift-3' ? `${shift.name}: летняя смена в лагере Подмосковья` : `${shift.name}: летняя смена в IT-лагере Подмосковья — ${shift.dates} ${SEASON_YEAR}`}</h1>
        <p class="font-extrabold leading-[1.0] tracking-[-0.02em]" style="font-size: clamp(40px, 7vw, 80px);">
          <span class="text-white" style="text-shadow: 0 4px 16px rgba(0,0,0,0.5);">{shift.dates.split('—')[0].trim()} —</span>
          <span class="hero-outline"> {shift.dates.split('—')[1]?.trim() ?? ''}</span>
        </p>

        <p class="mt-4 text-[16px] md:text-[18px] text-white/85 max-w-[640px]" style="text-shadow: 0 1px 3px rgba(0,0,0,0.7);">
          <strong class="font-bold text-white">{shift.duration}</strong> · Санаторий «Изумруд» · 66 км от Москвы
        </p>
        <p class="mt-2 text-base text-white/70 max-w-[640px]" style="text-shadow: 0 1px 3px rgba(0,0,0,0.7);">
          Летние смены лагерей {SEASON_YEAR} для школьников 7–15 лет. Смена в лагере — проживание, питание, IT-программа всё включено.
        </p>

        <!-- Meta block: price + occupancy + CTA -->
        <div class="mt-8 grid gap-5 md:grid-cols-[auto_1fr_auto] md:items-end md:gap-8">
          <!-- Price -->
          <div class="flex flex-col">
            <span class="text-[12px] font-semibold uppercase tracking-[0.14em] text-white/65">Стоимость</span>
            <span class="text-[36px] md:text-[44px] font-extrabold tracking-[-0.02em] text-white leading-none mt-1" data-dynamic-price={shift.id}>{ssrPriceFmt}</span>
            <span class="text-base text-white/70 mt-1">всё включено</span>
            <span class="hidden text-[12px] font-semibold text-orange-300 mt-0.5" data-price-stage={shift.id}></span>
            <span class="hidden text-[11px] font-semibold text-orange-300 mt-0.5" data-price-urgency={shift.id}></span>
          </div>

          {isSoldOut ? (
            <div class="flex flex-col">
              <div class="flex justify-between mb-2 text-base">
                <span class="text-white/75">Мест на смену</span>
                <span class="font-semibold text-white/90">нет</span>
              </div>
              <div class="h-2 w-full overflow-hidden rounded-full bg-white/15">
                <div class="h-full w-full rounded-full bg-white/40"></div>
              </div>
            </div>
          ) : (
            <!-- Occupancy — число и заполненность полосы скрыты блюром до клика «узнать места» -->
            <div class="flex flex-col">
              <div class="flex justify-between mb-2 text-base">
                <span class="text-white/75">Свободно мест</span>
                <span data-spots-num data-spots-shift={shift.id} class={`cursor-pointer blur-[6px] transition-[filter] duration-300 select-none ${isLowAvail ? 'text-orange-300 font-semibold' : 'text-emerald-300 font-semibold'}`}>
                  {isLowAvail ? `Осталось ${shift.free}` : `${shift.free}`}
                </span>
              </div>
              <div class="h-2 w-full overflow-hidden rounded-full bg-white/15">
                <div data-spots-bar data-spots-shift={shift.id} data-spots-width={`${occupiedPct}%`} class={`h-full ${isLowAvail ? 'bg-orange-400' : 'bg-emerald-400'} rounded-full transition-[width] duration-500`} style="width:0%"></div>
              </div>
              <button type="button" data-spots-reveal-btn data-spots-shift={shift.id} data-spots-low={isLowAvail ? '1' : undefined} class="mt-1.5 self-start text-[12px] font-semibold text-white/70 hover:text-white underline underline-offset-2 transition-colors">
                Узнать точное число мест
              </button>
            </div>
          )}

          <!-- Primary CTA -->
          <div class="flex items-center gap-2">
            <button type="button"
              data-shift-book={shift.id}
              data-shift-book-name={shift.name}
              data-shift-book-dates={shift.dates}
              data-shift-book-duration={shift.duration}
              data-shift-book-price={ssrPriceFmt}
              data-shift-waitlist={isSoldOut ? 'true' : undefined}
              data-analytics-goal="shift_select"
              data-analytics-label={shift.name}
              class:list={[
                'inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-[16px] font-semibold transition-colors min-h-[52px] whitespace-nowrap',
                isSoldOut ? 'bg-white/15 hover:bg-white/25 text-white border border-white/30' : 'bg-primary hover:bg-primary-hover text-white',
              ]}
            >
              {bookingCta.label}
              <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            </button>
            {isSoldOut && <WaitlistInfoIcon dark />}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ TIMELINE — фоточки + 5 этапов смены ═══════ -->
    <ShiftTimeline durationDays={durationDays} />

    <!-- ═══════ STRIP — мета (возраст/группы/опыт/ноутбук) ═══════ -->
    <section class="border-b border-border-light">
      <div class="mx-auto max-w-[1200px] px-5 py-6 md:px-8 md:py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-4 gap-x-6">
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint">Возраст</p>
            <p class="mt-1 text-[16px] font-bold text-body">7–15 лет</p>
          </div>
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint">Группы</p>
            <p class="mt-1 text-[16px] font-bold text-body">до 8 человек</p>
          </div>
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint">Опыт</p>
            <p class="mt-1 text-[16px] font-bold text-body">не нужен</p>
          </div>
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint">Ноутбук</p>
            <p class="mt-1 text-[16px] font-bold text-body">не нужен</p>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════ MILESTONES — три кита ═══════ -->
    <section class="border-y border-border-light bg-surface">
      <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-8 md:py-20">
        <div class="text-center mb-10 md:mb-14">
          <p class="reveal text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 mb-3">Три кита</p>
          <h2 class="reveal text-[28px] md:text-[42px] font-bold leading-[1.15] tracking-[-0.02em] text-body">
            Что делает смену<br><span class="text-primary">полной</span>
          </h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          <article class="reveal flex flex-col rounded-[16px] border border-border-light bg-card p-6 card-shadow">
            <i class="bi bi-lightning-charge-fill text-[28px] text-primary mb-3" aria-hidden="true"></i>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint mb-1">Каждый день</p>
            <h3 class="text-[20px] font-bold text-body mb-2">Реальный прогресс</h3>
            <p class="text-base leading-[1.55] text-body-muted">Не «прошли тему», а «добавили механику и она работает». Каждый день — конкретный шаг вперёд в своём проекте.</p>
          </article>
          <article class="reveal flex flex-col rounded-[16px] border border-border-light bg-card p-6 card-shadow" data-reveal-delay="100">
            <i class="bi bi-tree-fill text-[28px] text-primary mb-3" aria-hidden="true"></i>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint mb-1">Между занятиями</p>
            <h3 class="text-[20px] font-bold text-body mb-2">Жизнь за экраном</h3>
            <p class="text-base leading-[1.55] text-body-muted">Бассейн, лес, настолки, мафия по вечерам. Телефон — только вечером для связи с домом.</p>
          </article>
          <article class="reveal flex flex-col rounded-[16px] border border-border-light bg-card p-6 card-shadow" data-reveal-delay="200">
            <i class="bi bi-trophy-fill text-[28px] text-primary mb-3" aria-hidden="true"></i>
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-body-faint mb-1">Финал</p>
            <h3 class="text-[20px] font-bold text-body mb-2">Хакатон и защита</h3>
            <p class="text-base leading-[1.55] text-body-muted">Финальный рывок: проект собирается в итоговую версию, защищается перед родителями и едет домой.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══════ RESULT — «Каждый увезет домой свой проект» + цифры ═══════ -->
    <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24 text-center">
      <h2 class="reveal font-extrabold leading-[1.0] tracking-[-0.02em] text-body" style="font-size: clamp(36px, 6vw, 64px);">
        Привезёт<br><span class="text-primary">проект домой</span>
      </h2>
      <p class="reveal mt-4 text-[17px] leading-[1.6] text-body-muted max-w-[520px] mx-auto">
        Не сертификат и впечатления. Рабочую игру или EA-проект, которую можно запустить дома и показать подругам.
      </p>
      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-[860px] mx-auto">
        <div class="reveal">
          <p class="text-[36px] md:text-[44px] font-extrabold text-body leading-none">{shift.duration.split(' ')[0]}</p>
          <p class="mt-1 text-base md:text-base text-body-muted">дней плотной практики</p>
        </div>
        <div class="reveal" data-reveal-delay="80">
          <p class="text-[36px] md:text-[44px] font-extrabold text-body leading-none">1</p>
          <p class="mt-1 text-base md:text-base text-body-muted">готовый проект</p>
        </div>
        <div class="reveal" data-reveal-delay="160">
          <p class="text-[36px] md:text-[44px] font-extrabold text-body leading-none">8</p>
          <p class="mt-1 text-base md:text-base text-body-muted">человек в группе максимум</p>
        </div>
        <div class="reveal" data-reveal-delay="240">
          <p class="text-[36px] md:text-[44px] font-extrabold text-body leading-none">60%</p>
          <p class="mt-1 text-base md:text-base text-body-muted">детей возвращаются снова</p>
        </div>
      </div>
    </section>

    <!-- ═══════ SEO-текст: точечно для Смены 3 (Лабрика), другие смены не задевает ═══════ -->
    {shift.id === 'shift-3' && (
      <section class="mx-auto max-w-[760px] px-5 pb-4 md:px-8">
        <p class="text-base leading-[1.6] text-body-muted">
          На этой смене в лагере — не про пассивный отдых у бассейна. Ребята приезжают в лагерь на {shift.duration}: {shift.dates} {SEASON_YEAR} года, санаторий «Изумруд» в Наро-Фоминском округе, 66 км от Москвы. Территория лагеря большая: бассейн и лес — жизнь лагеря не сводится к монитору. Группы смены — до 8 человек, тренер успевает разобраться с каждым проектом лично, а вечерами вместе с ребятами гуляет по лагерю. Программа смены строится вокруг Python и нейросетей: с первого дня в лагере ребята пишут код своими руками, а не слушают теорию с доски. Вечером — настолки и разговоры: распорядок лагеря устроен так, чтобы кодинг не занимал весь день. К финалу смены каждый защищает свой проект на хакатоне и увозит его домой рабочим — не сертификат, а результат. Стоимость — {ssrPriceFmt}, всё включено: проживание, питание и программа лагеря без доплат. Заявку в лагерь на эту смену стоит оставить заранее — свободных мест немного.
        </p>
      </section>
    )}

    <!-- ═══════ BOOKING — финальная форма ═══════ -->
    <section id="booking" class="border-t border-border-light bg-surface">
      <div class="mx-auto max-w-[640px] px-5 py-12 md:px-8 md:py-20">
        <div class="rounded-[20px] bg-card p-6 md:p-8 card-shadow">
          <h3 class="text-[24px] md:text-[28px] font-bold text-body mb-2">{isSoldOut ? `Лист ожидания: ${shift.name}` : `Забронировать ${shift.name}`}</h3>
          <p class="text-base text-body-muted mb-5">
            {shift.dates} · {shift.duration}
            {isSoldOut && <span class="text-slate-500 font-semibold"> · Мест нет</span>}
            {!isSoldOut && isLowAvail && (<span class="text-orange-700 font-semibold"> · Осталось <span data-spots-num data-spots-shift={shift.id} class="cursor-pointer blur-[6px] transition-[filter] duration-300 select-none">{shift.free} {shift.free === 1 ? 'место' : shift.free < 5 ? 'места' : 'мест'}</span></span>)}
          </p>
          {isSoldOut && (
            <p class="mb-5 rounded-xl bg-slate-50 border border-slate-200 p-4 text-base leading-[1.55] text-slate-600">
              {WAITLIST_EXPLANATION}
            </p>
          )}

          <div class="flex items-baseline gap-3 mb-2">
            <span class="text-[36px] font-extrabold tracking-[-0.02em] text-body" data-dynamic-price={shift.id}>{ssrPriceFmt}</span>
            <span class="text-base md:text-base text-body-muted">всё включено · проживание, питание, программа</span>
          </div>
          <p class="hidden text-[13px] font-semibold text-orange-600 mb-3" data-price-stage={shift.id}></p>
          <div class="mb-5 pb-5 border-b border-border-light"></div>

          <ul class="space-y-2.5 mb-6">
            <li class="flex items-start gap-2.5 text-base text-body">
              <i class="bi bi-check-lg text-primary text-base mt-1 shrink-0" aria-hidden="true"></i>
              <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">Гарантия и условия возврата →</a>
            </li>
            <li class="flex items-start gap-2.5 text-base text-body">
              <i class="bi bi-check-lg text-primary text-base mt-1 shrink-0" aria-hidden="true"></i>
              Договор и чек — налоговый вычет 13%
            </li>
            <li class="flex items-start gap-2.5 text-base text-body">
              <i class="bi bi-check-lg text-primary text-base mt-1 shrink-0" aria-hidden="true"></i>
              Лицензия Минобрнауки · медсестра 24/7
            </li>
          </ul>

          <div class="flex items-center gap-2">
            <button type="button"
              data-shift-book={shift.id}
              data-shift-book-name={shift.name}
              data-shift-book-dates={shift.dates}
              data-shift-book-duration={shift.duration}
              data-shift-book-price={ssrPriceFmt}
              data-shift-waitlist={isSoldOut ? 'true' : undefined}
              data-analytics-goal="shift_select"
              data-analytics-label={shift.name + '_booking_block'}
              class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-hover px-6 py-4 text-[17px] font-semibold text-white transition-colors min-h-[56px] whitespace-nowrap"
            >
              {isSoldOut ? 'Оставить заявку в лист ожидания' : 'Оставить заявку'}
              <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            </button>
            {isSoldOut && <WaitlistInfoIcon />}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ Back to all shifts ═══════ -->
    <div class="mx-auto max-w-[1200px] px-5 py-10 md:px-8 text-center">
      <a href="/#shifts" class="group inline-flex items-center gap-2 text-base font-semibold text-primary hover:text-primary-hover">
        <i class="bi bi-arrow-left text-base transition-transform group-hover:-translate-x-1" aria-hidden="true"></i>
        Все смены
      </a>
    </div>
  </main>
  <Footer />
  <ShiftBookModal />

<script>
  // Записываем просмотр смены — чтобы редирект на /r/ сработал при следующем визите
  (function markViewed() {
    try {
      const id = window.location.pathname.replace(/^\/shifts\//, '').replace(/\/$/, '');
      if (!id) return;
      const KEY = 'ac:viewed_shifts';
      const existing: Array<{id: string; ts: number}> = JSON.parse(localStorage.getItem(KEY) || '[]');
      const found = existing.find((e) => e.id === id);
      if (found) {
        found.ts = Date.now(); // обновляем timestamp при повторном просмотре
      } else {
        existing.push({ id, ts: Date.now() });
      }
      localStorage.setItem(KEY, JSON.stringify(existing));
      // Цель «Открыл инфо о смене» (shift_modal_open) — раньше карточка открывала модалку
      // с этим же trackGoal, с 2026-05-03 карточка ведёт сюда напрямую (навигация вместо
      // модалки), поэтому просмотр этой страницы теперь и есть «открыл инфо о смене».
      (window as any).trackGoal?.('shift_modal_open', { shift: id, source: 'page' });
    } catch {}
  })();

  // Bind все кнопки [data-shift-book] на странице к ShiftBookModal
  function initBookButtons() {
    const modal = document.getElementById('shiftBookModal');
    if (!modal) return;
    const closeBtn = modal.querySelector('[data-shift-book-close]');
    closeBtn?.addEventListener('click', () => (modal as HTMLDialogElement).close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) (modal as HTMLDialogElement).close();
    });

    const nameEl = modal.querySelector('[data-book-shift-name]');
    const datesEl = modal.querySelector('[data-book-shift-dates]');
    const durationEl = modal.querySelector('[data-book-shift-duration]');
    const priceEl = modal.querySelector('[data-book-shift-price]');
    const blockEl = modal.querySelector('[data-book-shift-block]');

    document.querySelectorAll('[data-shift-book]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const el = btn as HTMLElement;
        const name = el.dataset.shiftBookName || '';
        if (nameEl) nameEl.textContent = name;
        if (datesEl) datesEl.textContent = el.dataset.shiftBookDates || '';
        if (durationEl) durationEl.textContent = el.dataset.shiftBookDuration || '';
        if (priceEl) priceEl.textContent = el.dataset.shiftBookPrice || '';
        if (blockEl) blockEl.classList.toggle('hidden', !name);
        (modal as HTMLElement).dataset.waitlist = el.dataset.shiftWaitlist === 'true' ? 'true' : 'false';
        (modal as HTMLDialogElement).showModal();
        (window as any).trackGoal?.(el.dataset.shiftWaitlist === 'true' ? 'waitlist_click' : 'shift_book_click', { shift: name }, 500);
      });
    });
  }
  document.addEventListener('astro:page-load', initBookButtons);
  initBookButtons();

  // Top bar close button
  const closeBtn = document.getElementById('shift-top-bar-close');
  const topBar = document.getElementById('shift-top-bar');
  if (closeBtn && topBar) {
    closeBtn.addEventListener('click', function() {
      topBar.style.display = 'none';
    });
  }
</script>

<!-- Раскрытие блюра мест обрабатывает глобальный делегированный обработчик в Base.astro
     (клик по [data-spots-reveal-btn]) — свой скрипт здесь не нужен. -->

<!-- Цены обновляет глобальный DynamicPrices.astro (подключён через Base.astro) -->
</Base>
