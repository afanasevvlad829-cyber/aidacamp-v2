---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "IT — не только для мальчиков",
    text: "Около 40% детей в АйДаКемп — девочки. Дарья Афанасьева основала этот лагерь в том числе для своей дочери-подростка — и знает, что «айтишный лагерь» у многих мам вызывает вопрос: а моей дочке это вообще надо? Надо. Только по-другому. Девочки часто выбирают AI и нейросети, 3D-моделирование, Python под конкретные задачи. Создать свой проект — это про самовыражение. Не про то, чтобы стать программистом.",
    list: [
      "~40% участников лагеря — девочки",
      "30% выпускников МФТИ и Бауманки, идущих в IT — девушки: IT не мужская территория",
      "AI, нейросети, 3D-моделирование, Python — по интересу дочери",
      "Основатель лагеря — мама дочери-подростка"
    ]
  },
  {
    h2: "Треки, которые выбирают девочки",
    text: "Никто не заставляет выбирать Minecraft. Каждая сама выбирает трек по интересу. Занятия — дважды в день по 90 минут с практикующими IT-специалистами.",
    list: [
      "AI и нейросети — рисование через Kandinsky, музыка, тексты с ChatGPT",
      "3D-моделирование — создать украшение в Blender и распечатать на 3D-принтере",
      "Python — автоматизация, боты, очень практичные проекты",
      "В конце смены — хакатон, каждая защищает свой проект"
    ]
  },
  {
    h2: "Реальные проекты, которые делают девочки",
    text: "За смену участницы создают настоящие проекты — не учебные упражнения, а то, что можно показать подругам и использовать в жизни.",
    list: [
      "AI-рекомендатор книг на Python — вводишь жанр, получаешь список",
      "Telegram-помощник, который отвечает на вопросы по вашим любимым темам",
      "Серия AI-арт иллюстраций через Stable Diffusion для оформления профиля",
      "3D-украшение в Blender, напечатанное на принтере в конце смены"
    ]
  },
  {
    h2: "Среда и атмосфера",
    text: "Группы смешанные, до 8 человек. Уютная обстановка, внимание каждой участнице. Медработник 24/7, закрытая территория санатория «Изумруд».",
    list: [
      "Вечерние активности: мастерские, кино, танцы, настольные игры",
      "Комнаты по 2–4 человека с санузлом, можно взять любимые вещи",
      "Медработник 24/7, охрана, закрытая территория",
      "5-разовое питание, бассейн с ионизированной водой"
    ]
  },
  {
    h2: "Смены 2026 — места заканчиваются",
    text: "АйДаКемп работает с конца мая по август 2026. Смены 7–14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Группы до 8 человек — мест мало, июньская смена традиционно бронируется первой.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Отзывы мам про дочерей",
    text: "Мамы, которые сомневались — и всё равно отправили дочку:",
    list: [
      "«Думала, что моей дочери 3D-принтер ни к чему. Она вернулась с серьгами, которые сама спроектировала, и теперь хочет стать дизайнером» — Ольга, мама Сони, 12 лет",
      "«Дочь сделала проект с AI-артом — нарисовала целую серию картин через нейросеть. Пришла домой и сразу показала одноклассникам. Я была в шоке» — Екатерина, мама Маши, 13 лет",
      "«Везла дочь с теми же сомнениями. Теперь она уже на третьей смене» — из отзывов на Яндекс.Картах"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний лагерь для девочек 2026 — IT, AI, 3D | АйДаКемп"
  description="IT-лагерь для девочек 7–15 лет: AI-арт, 3D-моделирование, Python. ~40% участников — девочки. Подмосковье, от 48 000 ₽. Основатель — мама дочери-подростка."
  h1="Летний IT-лагерь для девочек 2026"
  canonical="https://aidacamp.ru/lager-dlya-devochek"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Правда ли, что IT-лагерь — это для мальчиков?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. ~40% детей в АйДаКемп — девочки. AI, 3D-моделирование, дизайн — треки, которые особенно нравятся девочкам. Основатель лагеря Дарья Афанасьева — сама мама дочери-подростка." }
        },
        {
          "@type": "Question",
          "name": "Какие треки подходят для девочек?",
          "acceptedAnswer": { "@type": "Answer", "text": "AI и нейросети, 3D-моделирование и печать, Python, Scratch (для 7–9 лет). Девочки особенно вовлекаются в AI-арт, генерацию и 3D-дизайн. Выбор за ребёнком." }
        },
        {
          "@type": "Question",
          "name": "Как проходит адаптация девочек в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Вожатые помогают освоиться в первые дни. Смешанные команды на хакатоне, вечерние активности, бассейн. Большинство девочек к концу первой недели уже не хотят домой — это нормально." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста девочки могут ехать в лагерь одни?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Принимаем детей 7–15 лет. Для самых маленьких (7–8 лет) рекомендуем начать с 7-дневной смены — адаптация проходит легче." }
        }
      ]
    })} />
    <CourseSchema
      name="IT-лагерь для девочек — АйДаКемп"
      description="IT-лагерь для девочек в Подмосковье: AI, 3D-моделирование, Python. ~40% детей в лагере — девочки."
      url="https://aidacamp.ru/lager-dlya-devochek"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для девочек"
    subtitle="IT-лагерь в Подмосковье — AI, 3D-печать, Python. ~40% участников — девочки. Для девочек 7–15 лет."
    breadcrumb="Лагерь для девочек"
    keywords={["AI, 3D-моделирование, Python — по интересу дочери", "~40% участников лагеря — девочки", "Основатель — мама дочери-подростка"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний лагерь для девочек — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
