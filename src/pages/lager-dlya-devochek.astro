---
import { PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S1, VYCHET_S2, VYCHET_S21, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';

const sections = [
  {
    h2: "Честно — а моей дочке это вообще надо?",
    text: "Полноценный отдых для девочек: занятия утром, бассейн и активности днём, кино и танцы вечером. Этот вопрос задаёт почти каждая мама, которая ищет лагерь, где дочка не единственная среди мальчиков, а полноценная половина смены. Мы не единственный вариант среди лагерей Подмосковья, но с самым конкретным результатом на выходе. Дарья Афанасьева, основатель АйДаКемп и мама дочери-подростка, сама его задавала. Дочери было 11, когда она первый раз поехала в лагерь. Ждали нытья про код. Дочь вернулась и две недели рассказывала, как обучала нейросеть рисовать её любимого персонажа в разных стилях. Не «программировать научилась» — а сделала своё, показала подругам, получила кучу комплиментов. Вот за этим сюда и едут. Не за профессией. За результатом, который не стыдно показать.",
    list: [
      "«Там одни мальчики» — не одни: около 40% девочек в каждой смене",
      "«IT для технарей, а она гуманитарий» — AI-арт и 3D-дизайн украшений ближе к творчеству, чем к математике",
      "«Будет весь день в ноутбуке» — два занятия по 90 минут, остальное — бассейн, мастерские, танцы, кино",
      "Программу проверяет мама дочери-подростка"
    ]
  },
  {
    h2: "Что мы делаем на смене — без педагогических слов",
    text: "Никто не заставляет учить Python с нуля «чтобы стать программистом». Каждая участница выбирает трек по интересу в первый день и работает над своим проектом до конца смены в лагере.",
    list: [
      "Нейросети и AI-арт — самый популярный трек у девчонок 10+: Stable Diffusion, Kandinsky, ChatGPT с нормальными промптами. Итог — серия из 10–20 иллюстраций в одном стиле. Девочкам запоминается не факт освоения нейросети, а ощущение открытия — своя серия AI-иллюстраций или серьги из Blender, которые можно надеть прямо сейчас",
      "3D-моделирование и печать — садится в Blender, рисует кулон или серьги, через два дня держит в руках. Печатаем прямо на месте",
      "Python по-человечески — бот, который советует книги по жанру; Telegram-помощник для домашки; игра, в которую можно играть с сестрой",
      "Хакатон в конце смены — каждая защищает свой проект. Не экзамен, а момент когда дочь видит: я сделала то, чем можно похвастаться"
    ]
  },
  {
    h2: "Как живётся девочкам в лагере",
    text: "Всё продумано просто. Комнаты по 2–4 человека, с санузлом и душем внутри. Размещение по возрасту и полу — раздельно, не смешанные комнаты. Можно привезти любимые вещи, плед, плюшевого зайца — всё нормально, это не армия.",
    list: [
      "Закрытая территория санатория с КПП и охраной",
      "Медработник 24/7 — живёт прямо в корпусе, а не приходящий",
      "5 приёмов пищи в день, учитываем аллергии и ограничения",
      "Бассейн с ионизированной водой (без хлорки в глаза)",
      "Спортивные активности — бассейн, игры на улице — чередуются с IT-занятиями и вечерними мероприятиями",
      "Вечерние активности: танцы, кино, мастерские, настолки",
      "Группы до 8 человек — вожатые знают каждую по имени и в лицо"
    ]
  },
  {
    h2: `Сколько стоит и какие смены есть в ${SEASON_YEAR}`,
    text: "Все цены — «всё включено»: проживание, 5-разовое питание, IT-программа, оборудование (ноутбуки выдаём свои), бассейн, спорт. Доплачивать в лагере не за что. Открыты летние августовские смены лагеря — места ограничены: до 8 человек в группе. Путёвку можно забронировать онлайн, трансфер от м. Солнцево — отдельной опцией, а в программе смены есть и творческие занятия, не только код.",
    list: [
      `Смена 3 — 3 – 15 августа, 13 дней, ${PRICE_S3} (вычет ~${VYCHET_S3} — максимум)`,
      `Смена 4 — 17 – 26 августа, 10 дней, ${PRICE_S4} (вычет ~${VYCHET_S4})`,
      `Смена 1 (завершена) — 30 мая – 8 июня, 10 дней, ${PRICE_S1} (налоговый вычет ~${VYCHET_S1})`,
      `Смена 2 (завершена) — 10 – 23 июня, 14 дней, ${PRICE_S2} (вычет ~${VYCHET_S2})`,
      `Короткие смены 7–8 дней (завершены) — от ${PRICE_S21} (вычет от ~${VYCHET_S21})`
    ]
  },
  {
    h2: "Возражения, которые слышим чаще всего",
    text: "Собрали честные ответы на вопросы мам, которые сомневались:",
    list: [
      '«А если ей не понравится в первые дни?» — <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">условия гарантии возврата →</a>',
      "«Она стеснительная» — Группы по 8 человек — меньше, чем класс в школе. Вожатые в первый день специально знакомят всех",
      "«А связь?» — Ежедневные фото и сообщения в родительском Telegram-канале. Прямая связь с вожатыми",
      "«Нулевой уровень — справится?» — Принимаем с 7 лет без опыта. Начнёт со Scratch и блочного программирования, к концу смены — своя мини-игра или проект",
      "«Может, лучше языковая смена?» — В отличие от языковых программ, здесь изучают не английский, а Python и AI — и результат видно сразу"
    ]
  },
  {
    h2: "Что говорят мамы (которые тоже сомневались)",
    text: `Своими словами за мам мы ничего не пишем: их отзывы открыты целиком — ${otzyvyLink('здесь, на сайте')}, и в карточке на ${yandexReviewsLink()}, с именами и датами. Вот темы, которые в них повторяются чаще всего:`,
    list: [
      "Про «ей это не надо»: с этого сомнения начинают многие — и почти всегда пишут потом про конкретную вещь, которую дочь сделала руками или в коде",
      "Про творческие треки: 3D-моделирование, AI-арт и дизайн у девочек популярны наравне с программированием — результат можно показать подругам сразу",
      "Про повторные смены: заметная часть отзывов — от тех, кто приезжает не первый раз, и решение о второй смене чаще принимает сама дочь"
    ]
  },
  {
    h2: "Что в итоге получит ваша дочь",
    text: "Не сертификат. Не «навыки будущего». А конкретную вещь, которую можно показать — серию AI-артов, бот в Telegram, напечатанные украшения, мини-игру. Плюс две недели в лагере среди девчонок, которым интересно то же самое. Когда рядом ровесницы, которые тоже что-то делают своими руками — это заражает. Даже та, кто приехала «просто посмотреть», на третий день уже не отлипает от своего проекта. Лето короткое. Места в группах лагеря ограничены — 8 мест на трек.",
    list: []
  }
];

const faqItems = [
  { question: "С какого возраста принимаете девочек?", answer: "С 7 до 15 лет. Группы делятся по возрасту: младшие (7–10), средние (11–13), старшие (13–15). У старших — более серьёзные проекты, у младших — больше игровых форматов." },
  { question: "Можно ли приехать с подругой в один отряд?", answer: "Да, при бронировании напишите в комментарии — посадим в одну комнату и в один трек. Многие так и делают." },
  { question: "Что если у дочки аллергия или особое питание?", answer: "Сообщаете при бронировании — повар учитывает. Без глютена, без лактозы, вегетарианское — нормально." },
  { question: "А если ей не понравится в первые дни?", answer: "На сменах от 10 дней действует гарантия возврата. Условия — на странице aidacamp.ru/politika-vozvrata." },
  { question: "У неё нулевой уровень — справится?", answer: "Принимаем без опыта — с 7 лет. Начнёт со Scratch и блочного программирования. К концу смены — своя игра или мини-проект." },
  { question: "Когда платить и как отменить бронирование?", answer: "Бронь — после предоплаты 30%. Отмена за 14+ дней — полный возврат. На сменах от 10 дней действует гарантия возврата — условия на aidacamp.ru/politika-vozvrata." },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Детский лагерь для девочек ${SEASON_YEAR}: AI и 3D-моделирование | АйДаКемп`}
  description={`Детский лагерь для девочек 7–15 лет ${SEASON_YEAR}: AI, 3D, Python в Подмосковье. Основатель — мама дочери-подростка.`}
  h1="Лагерь для девочек 7–15 лет"
  canonical="https://aidacamp.ru/lager-dlya-devochek"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детская IT-программа для девочек — АйДаКемп"
      description="IT-программа для девочек в Подмосковье: AI, 3D-моделирование, Python. ~40% участниц смены — девочки."
      url="https://aidacamp.ru/lager-dlya-devochek"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для девочек 7–15 лет"
    subtitle={`IT-программа в Подмосковье — нейросети, 3D-печать, Python. Почти половина участниц — девочки. 66 км от МКАД, от ${PRICE_MIN}.`}
    breadcrumb="Для девочек"
    keywords={["Нейросети, AI-арт, 3D-моделирование — по интересу дочери", "~40% участниц смены — девочки", "Основатель — мама дочери-подростка"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Дети на занятии в АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <!-- Свой accordion убран: те же faqItems теперь только во вкладке <FAQ /> — один
       видимый источник вопросов и один FAQPage вместо двух (01.08.2026) -->
  <FAQ
    extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))}
    only={['medicine', 'safety', 'food', 'accommodation', 'documents', 'communication', 'payment']}
  />

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
