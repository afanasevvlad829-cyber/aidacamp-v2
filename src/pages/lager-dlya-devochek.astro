---
import { PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S1, VYCHET_S2, VYCHET_S21, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Честно — а моей дочке это вообще надо?",
    text: "Этот вопрос задаёт почти каждая мама, которая открывает страницу детского лагеря для девочек с IT-уклоном. Дарья Афанасьева, основатель АйДаКемп и мама дочери-подростка, сама его задавала. Дочери было 11, когда она первый раз поехала в лагерь. Ждали нытья про код. Дочь вернулась и две недели рассказывала, как обучала нейросеть рисовать её любимого персонажа в разных стилях. Не «программировать научилась» — а сделала своё, показала подругам, получила кучу комплиментов. Вот за этим девочки сюда и едут. Не за профессией. За результатом, который не стыдно показать.",
    list: [
      "«Там одни мальчики» — не одни: около 40% девочек в каждой смене",
      "«IT для технарей, а она гуманитарий» — AI-арт и 3D-дизайн украшений ближе к творчеству, чем к математике",
      "«Будет весь день в ноутбуке» — два занятия по 90 минут, остальное — бассейн, мастерские, танцы, кино",
      "Основатель лагеря — мама дочери-подростка"
    ]
  },
  {
    h2: "Что мы делаем на смене — без педагогических слов",
    text: "Никто не заставляет учить Python с нуля «чтобы стать программистом». Каждая участница выбирает трек по интересу в первый день и работает над своим проектом до конца смены.",
    list: [
      "Нейросети и AI-арт — самый популярный трек у девчонок 10+: Stable Diffusion, Kandinsky, ChatGPT с нормальными промптами. Итог — серия из 10–20 иллюстраций в одном стиле",
      "3D-моделирование и печать — садится в Blender, рисует кулон или серьги, через два дня держит в руках. Печатаем прямо в лагере",
      "Python по-человечески — бот, который советует книги по жанру; Telegram-помощник для домашки; игра, в которую можно играть с сестрой",
      "Хакатон в конце смены — каждая защищает свой проект. Не экзамен, а момент когда дочь видит: я сделала то, чем можно похвастаться"
    ]
  },
  {
    h2: "Как живут девочки в лагере",
    text: "Комнаты по 2–4 человека, с санузлом и душем внутри. Размещение по возрасту и полу — девочки с девочками, не смешанные комнаты. Можно привезти любимые вещи, плед, плюшевого зайца — всё нормально, это не армия.",
    list: [
      "Закрытая территория санатория с КПП и охраной",
      "Медработник 24/7 — живёт прямо в корпусе, а не приходящий",
      "5 приёмов пищи в день, учитываем аллергии и ограничения",
      "Бассейн с ионизированной водой (без хлорки в глаза)",
      "Вечерние активности: танцы, кино, мастерские, настолки",
      "Группы до 8 человек — вожатые знают каждую по имени и в лицо"
    ]
  },
  {
    h2: "Сколько стоит и какие смены есть в 2026",
    text: "Все цены — «всё включено»: проживание, 5-разовое питание, IT-программа, оборудование (ноутбуки выдаём свои), бассейн, спорт. Доплачивать на месте не за что. Открыты августовские смены — места ограничены: до 8 девочек в группе. Путёвку можно забронировать онлайн, трансфер от м. Солнцево — отдельной опцией, а в программе смены есть и творческие мастер-классы, не только код.",
    list: [
      `Смена 3 — 3 – 15 августа, 13 дней, ${PRICE_S3} (вычет ~${VYCHET_S3} — максимум)`,
      `Смена 4 — 17 – 26 августа, 10 дней, ${PRICE_S4} (вычет ~${VYCHET_S4})`,
      `Смена 1 (завершена) — 30 мая – 8 июня, 10 дней, ${PRICE_S1} (налоговый вычет ~${VYCHET_S1})`,
      `Смена 2 (завершена) — 10 – 23 июня, 14 дней, ${PRICE_S2} (вычет ~${VYCHET_S2})`,
      `Короткие смены 7–8 дней (завершены) — от ${PRICE_S21} (вычет от ~${VYCHET_S21})`
    ]
  },
  {
    h2: "Возражения, которые слышим чаще всего",
    text: "Собрали честные ответы на вопросы мам, которые сомневались:",
    list: [
      '«А если ей не понравится в первые дни?» — <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">условия гарантии возврата →</a>',
      "«Она стеснительная» — Группы по 8 человек — меньше, чем класс в школе. Вожатые в первый день специально знакомят всех",
      "«А связь?» — Ежедневные фото и сообщения в родительском Telegram-канале. Прямая связь с вожатыми",
      "«Нулевой уровень — справится?» — Принимаем с 7 лет без опыта. Начнёт со Scratch и блочного программирования, к концу смены — своя мини-игра или проект"
    ]
  },
  {
    h2: "Что говорят мамы (которые тоже сомневались)",
    text: "Реальные отзывы от мам, которые решились:",
    list: [
      "«Думала, что моей дочери 3D-принтер ни к чему — она же про танцы и подружек. Вернулась с серьгами, которые сама спроектировала. Теперь хочет на курсы дизайна.» — Ольга, мама Сони, 12 лет",
      "«Дочь сделала серию AI-артов через нейросеть. Пришла домой и сразу выложила в свой профиль. Я была в шоке от качества — это реально красиво.» — Екатерина, мама Маши, 13 лет",
      "«Везла с теми же сомнениями, что и все. Теперь она едет на третью смену подряд. Не я её уговариваю — она меня.» — из отзывов на Яндекс.Картах (рейтинг 4.9)"
    ]
  },
  {
    h2: "Что в итоге получит ваша дочь",
    text: "Не сертификат. Не «навыки будущего». А конкретную вещь, которую можно показать — серию AI-артов, бот в Telegram, напечатанные украшения, мини-игру. Плюс две недели среди девчонок, которым интересно то же самое. Когда рядом ровесницы, которые тоже что-то делают своими руками — это заражает. Даже та, кто приехала «просто посмотреть», на третий день уже не отлипает от своего проекта. Лето короткое. Места в группах ограничены — 8 девочек на трек.",
    list: []
  }
];

const faqItems = [
  { question: "С какого возраста принимаете девочек?", answer: "С 7 до 15 лет. Группы делятся по возрасту: младшие (7–10), средние (11–13), старшие (13–15). У старших — более серьёзные проекты, у младших — больше игровых форматов." },
  { question: "Можно ли приехать с подругой в один отряд?", answer: "Да, при бронировании напишите в комментарии — посадим в одну комнату и в один трек. Многие так и делают." },
  { question: "Что если у дочки аллергия или особое питание?", answer: "Сообщаете при бронировании — повар учитывает. Без глютена, без лактозы, вегетарианское — нормально." },
  { question: "А если ей не понравится в первые дни?", answer: "На сменах от 10 дней действует гарантия возврата. Условия — на странице aidacamp.ru/politika-vozvrata." },
  { question: "У неё нулевой уровень — справится?", answer: "Принимаем с 7 лет без опыта. Девочка 8 лет начнёт со Scratch и блочного программирования. К концу смены — своя игра или мини-проект." },
  { question: "Когда платить и как отменить бронирование?", answer: "Бронь — после предоплаты 30%. Отмена за 14+ дней — полный возврат. На сменах от 10 дней действует гарантия возврата — условия на aidacamp.ru/politika-vozvrata." },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь для девочек 2026 — IT, AI, 3D-моделирование | АйДаКемп"
  description={`Лагерь для девочек 2026: AI, 3D, Python в Подмосковье. ~40% участниц — девочки. Основатель — мама дочери-подростка. От ${PRICE_MIN}.`}
  h1="Лагерь для девочек 2026 — нейросети, 3D, Python"
  canonical="https://aidacamp.ru/lager-dlya-devochek"
>
  <Fragment slot="head">
    <FAQSchema items={faqItems.map(item => ({ q: item.question, a: item.answer }))} />
    <CourseSchema
      name="IT-лагерь для девочек — АйДаКемп"
      description="IT-лагерь для девочек в Подмосковье: AI, 3D-моделирование, Python. ~40% детей в лагере — девочки."
      url="https://aidacamp.ru/lager-dlya-devochek"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для девочек 2026 — IT-смены для девочек 7–15 лет"
    subtitle={`IT-лагерь в Подмосковье — нейросети, 3D-печать, Python. Почти половина участниц — девочки. 66 км от МКАД, от ${PRICE_MIN}.`}
    breadcrumb="Лагерь для девочек"
    keywords={["Нейросети, AI-арт, 3D-моделирование — по интересу дочери", "~40% участниц лагеря — девочки", "Основатель — мама дочери-подростка"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний лагерь для девочек — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <section class="mx-auto max-w-[860px] px-4 py-10">
    <div class="flex items-center gap-2 mb-6">
      <div class="list-accent-dot"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Частые вопросы о лагере для девочек
      </h2>
    </div>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
          <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
            <span>{item.question}</span>
            <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
          </button>
          <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
            <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQ />
  <ShiftBookModal />

<section class="mx-auto max-w-[880px] px-4 py-10">
  <div class="flex items-center gap-2 mb-4">
    <div class="list-accent-dot"></div>
    <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Безопасность и комфорт девочек в лагере АйДаКемп</h2>
  </div>

  <div class="flex flex-col gap-3 text-[16px] leading-[1.7] text-slate-600">
    <p>
      <strong>Как лагерь для девочек обеспечивает безопасность?</strong> Закрытая территория санатория с КПП и охраной, медработник живёт прямо в корпусе — не приходящий, а на месте круглосуточно. Девочки размещаются отдельно от мальчиков: по 2–4 человека в комнате, с собственным санузлом и душем.
    </p>
    <p>
      Аллергии и особое питание учитываем при бронировании — сообщаете повару заранее. Каждый день — фото и сообщения в родительском Telegram-канале, видно, чем дочь занята прямо сейчас. Группы до 8 человек: вожатая знает каждую девочку по имени, а не по номеру отряда.
    </p>
    <p>
      Дарья, основательница АйДаКемп, сама отправляла в лагерь дочь-подростка — с теми же вопросами, что и вы. Разделение по полу, охрана территории, медик рядом — это не строчки из буклета, а то, что она проверила сама, прежде чем открыть лагерь для чужих детей.
    </p>
  </div>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>

<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
