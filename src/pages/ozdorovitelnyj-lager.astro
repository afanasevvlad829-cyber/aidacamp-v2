---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { getRelatedPages } from '../data/landing-pages';

const sections = [
  {
    h2: "Детские оздоровительные лагеря Московской области — что это",
    text: "Детский оздоровительный лагерь — официальный термин для загородного лагеря с проживанием, где созданы условия для здоровья: свежий воздух, питание, медицинское сопровождение, физическая активность. АйДаКемп — именно такой лагерь в Наро-Фоминском районе Подмосковья, дополненный IT-образованием.",
    list: [
      "Чистый воздух Наро-Фоминского района — 66 км от МКАД, хвойный лес",
      "5-разовое питание с учётом аллергий и диетических ограничений",
      "Закрытый бассейн с ионизированной водой (без хлора) ежедневно",
      "Медицинский работник 24/7 на территории",
      "Спорт, командные активности, прогулки на свежем воздухе"
    ]
  },
  {
    h2: "Чем оздоровительный лагерь АйДаКемп отличается от обычного",
    text: "В большинстве детских оздоровительных лагерей Московской области основная программа — спорт и творчество. В АйДаКемп к оздоровительной базе добавлена IT-образовательная программа: дети не просто отдыхают, а создают реальные проекты. Главный результат — ребёнок приезжает домой здоровым и с новыми знаниями.",
    list: [
      "IT-занятия дважды в день — Python, Scratch, Minecraft, AI",
      "Хакатон в финале — каждый защищает свой проект",
      "Без телефонов: экранное время заменяется живым общением",
      "Бассейн, спорт, прогулки — активный отдых каждый день",
      "Группы до 8 человек — никто не теряется в потоке"
    ]
  },
  {
    h2: "Территория и условия проживания",
    text: "Лагерь работает на базе санатория «Изумруд» — это не временный палаточный лагерь, а стационарная база с жилыми корпусами, столовой и спортивными объектами. Территория 40 соток, охраняется круглосуточно.",
    list: [
      "Жилые корпуса по 2–4 человека с санузлом и горячей водой",
      "Столовая с 5-разовым питанием — мамы отдельно пишут про еду в отзывах",
      "Закрытый бассейн с ионизированной водой — без хлора, без аллергий",
      "Футбольное поле, волейбол, спортивные площадки",
      "Охрана и закрытый КПП — на территорию не пройдут посторонние"
    ]
  },
  {
    h2: "Здоровье ребёнка в оздоровительном лагере — как устроено",
    text: "АйДаКемп — не медицинское учреждение. Но условия созданы так, чтобы ребёнок действительно отдохнул: нормальный сон, свежий воздух, питание и физическая активность. Медработник принимает каждый день — ссадины, температура, лечение — всё под контролем.",
    list: [
      "Медработник на территории 24/7 — первая помощь в любое время",
      "Ежедневный режим: сон не менее 9 часов, тихий час после обеда",
      "Питьевая вода и соки доступны весь день",
      "Экстренная связь с родителями — звоним сразу при необходимости",
      "Страхование детей (ВСК) включено в стоимость смены"
    ]
  },
  {
    h2: "Документы оздоровительного лагеря АйДаКемп",
    text: "У лагеря полный комплект разрешительной документации. Образовательная лицензия позволяет оформить налоговый вычет 13% — вернуть до 5 200 ₽ с каждой смены.",
    list: [
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973",
      "Туроператор РТО 025773 — реестр Ростуризма",
      "Разрешение Роспотребнадзора на каждую смену",
      "Страхование детей ВСК — оформлено автоматически",
      "Налоговый вычет 13% — до 5 200 ₽ назад через nalog.ru"
    ]
  },
  {
    h2: "Детские оздоровительные лагеря Подмосковья 2026 — смены АйДаКемп",
    text: "Шесть смен с конца мая по август. Для тех, кто едет первый раз — короткие смены 7–8 дней: меньше нагрузка на адаптацию. Для опытных — флагманская смена 14 дней с максимальной программой.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (флагман)",
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2.2 — 16–23 июня, 8 дней, 65 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы о детском оздоровительном лагере АйДаКемп",
    text: "Что говорят мамы после смены:",
    list: [
      "«Приехал загорелым, выспавшимся и с готовым ботом. Не знаю что лучше» — Ольга, мама Максима, 11 лет",
      "«Сначала боялась про питание — у нас лактоза. Предупредила, учли сразу. Ни одного раза не отступили» — Наталья, мама Вики, 9 лет",
      "«Реально оздоровительный: приехал бодрый, ел нормально, спал — я даже не верила сначала» — Ирина, мама Дениса, 13 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский оздоровительный лагерь в Подмосковье 2026 — АйДаКемп"
  description="Оздоровительный IT-лагерь в Московской области: бассейн, лес, медработник 24/7, IT-программа. Смены с 30 мая 2026. Лицензия Минобра."
  h1="Детский оздоровительный лагерь в Московской области"
  canonical="https://aidacamp.ru/ozdorovitelnyj-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Что такое детский оздоровительный лагерь?", "acceptedAnswer": { "@type": "Answer", "text": "Детский оздоровительный лагерь — загородный лагерь с проживанием, где обеспечены условия для здоровья детей: свежий воздух, питание, медицинское сопровождение, физическая активность. АйДаКемп — оздоровительный лагерь в Наро-Фоминском районе МО с IT-образованием: Python, Scratch, Minecraft, AI." } },
        { "@type": "Question", "name": "Есть ли медработник в детском оздоровительном лагере АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Да. Медицинский работник присутствует на территории 24/7. При необходимости сразу связываемся с родителями. Страхование детей (ВСК) включено в стоимость смены." } },
        { "@type": "Question", "name": "Сколько стоит детский оздоровительный лагерь Подмосковья в 2026?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп: от 48 000 ₽ за 7 дней до 95 000 ₽ за 14 дней. Включено: проживание, 5-разовое питание, IT-программа, бассейн, медработник. Налоговый вычет 13% — возврат до 5 200 ₽ при наличии образовательной лицензии." } },
        { "@type": "Question", "name": "Какая лицензия у оздоровительного лагеря АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Образовательная лицензия Минобрнауки Л035-01298-77/01082973, туроператор РТО 025773, разрешение Роспотребнадзора на каждую смену, страхование детей ВСК. Рейтинг 5.0 на Яндекс.Картах, 40+ независимых отзывов." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский оздоровительный лагерь в Подмосковье 2026"
    subtitle="Лес, бассейн, медработник 24/7 и IT-проект за смену. Санаторий «Изумруд», 66 км от МКАД. Для детей 7–15 лет, от 48 000 ₽."
    breadcrumb="Оздоровительный лагерь"
    keywords={[
      "Свежий воздух, бассейн, медработник — оздоровление без компромиссов",
      "Лицензия Минобрнауки + Роспотребнадзор — официально и безопасно",
      "IT-проект за смену — ребёнок возвращается здоровым и с результатом"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский оздоровительный лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
