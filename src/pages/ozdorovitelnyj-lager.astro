---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import { getRelatedPages } from '../data/landing-pages';
import { STAT_INSURED, STAT_LICENSE, STAT_RTO } from '../data/contacts';
import { SEASON_FROM_TO, PAST_SHIFTS_SENTENCE, SEASON_SHIFTS_PHRASE_CAP } from '../data/evergreen';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';

const sections = [
  {
    h2: "Детские оздоровительные лагеря Московской области — что это",
    text: "АйДаКемп — в Наро-Фоминском округе Московской области (Подмосковье): воздух, питание, медицина и IT-занятия в одной смене для детей.",
    list: [
      "Чистый воздух Наро-Фоминского округа, Московская область — 66 км от МКАД, хвойный лес",
      "5-разовое питание с учётом аллергий и диетических ограничений",
      "Закрытый бассейн с ионизированной водой (без хлора) — через день",
      "Медицинский работник 24/7 на территории",
      "Спорт, командные активности, минимум 3 часа на воздухе ежедневно"
    ]
  },
  {
    h2: "Чем оздоровительный лагерь АйДаКемп отличается от обычного",
    text: "У большинства в области программа — только спорт и творчество. Мы добавили IT-программу: ребёнок возвращается с готовым проектом.",
    list: [
      "IT-занятия дважды в день — Python, Scratch, Minecraft, AI",
      "Хакатон в финале — каждый защищает свой проект",
      "Без телефонов: экранное время заменяется живым общением",
      "Бассейн, спорт, прогулки — активный отдых",
      "Группы до 8 человек — никто не теряется в потоке"
    ]
  },
  {
    h2: "Территория и условия проживания",
    text: "База — санаторий «Изумруд» в Наро-Фоминском округе, Подмосковье: корпуса, столовая и спортплощадки на охраняемой территории 40 соток. Подробнее — на странице <a href=\"/zagorodnyj-lager/\" class=\"text-primary hover:underline\">детский отдых за городом</a>.",
    list: [
      "Жилые корпуса по 2–4 человека — санузел и горячая вода",
      "Столовая с 5-разовым питанием — мамы хвалят еду в отзывах",
      "Закрытый бассейн с ионизированной водой — без хлора",
      "Футбольное поле, волейбол, спортивные площадки",
      "Охрана и закрытый КПП — посторонние не пройдут"
    ]
  },
  {
    h2: "Здоровье ребёнка на смене — как устроено",
    text: "Медработник живёт на территории весь сезон — оздоровительные привычки закладываются с первого дня. Ссадины, температура, лекарства по рецепту под контролем, родителям звоним сразу.",
    list: [
      "Медработник на территории 24/7 — первая помощь в любое время",
      "Ежедневный режим: сон не менее 9 часов, тихий час после обеда",
      "Питьевая вода и соки — доступны весь день",
      "Экстренная связь с родителями — звоним сразу при необходимости",
      STAT_INSURED
    ]
  },
  {
    h2: "Документы АйДаКемп: лицензии и разрешения",
    text: `Полный комплект разрешительных документов — включая образовательную лицензию, которая даёт право на налоговый вычет 13%, до ${VYCHET_MAX} с каждой смены.`,
    list: [
      `Образовательная лицензия Минобрнауки ${STAT_LICENSE}`,
      `Туроператор РТО ${STAT_RTO} — реестр Ростуризма`,
      "Разрешение Роспотребнадзора на каждую смену",
      STAT_INSURED,
      `Налоговый вычет 13% — до ${VYCHET_MAX} назад через nalog.ru`,
      "Официальный договор, чек/акт услуг и справка для ФНС — по запросу"
    ]
  },
  {
    h2: `Смены АйДаКемп на лето ${SEASON_YEAR} — Подмосковье`,
    text: `${SEASON_SHIFTS_PHRASE_CAP} ${SEASON_FROM_TO}. ${PAST_SHIFTS_SENTENCE} — сейчас открыта запись на августовские смены 10 и 13 дней с полной программой.`,
    list: [
      `Смена 1 (завершена) — ${DATES_S1}, 10 дней, ${PRICE_S1}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2} (флагман)`,
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней, ${PRICE_S21}`,
      `Смена 2.2 (завершена) — ${DATES_SHORT_S22}, 8 дней, ${PRICE_S22}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Отзывы мам об АйДаКемп",
    text: `Слова мам мы за них не сочиняем — оригиналы открыты: ${otzyvyLink('отзывы родителей')} на сайте и карточка лагеря на ${yandexReviewsLink()}. Про оздоровительную часть в них чаще всего пишут так:`,
    list: [
      "Режим действительно работает: ребята приезжают выспавшимися, загорелыми и с проектом одновременно",
      "Еда — тема, которая всплывает почти в каждом отзыве, причём и у родителей, и у самих ребят",
      "Особенности питания (аллергии, непереносимость) просят учесть заранее — и это обычная рабочая история, а не исключение"
    ]
  },
  {
    h2: "Без телефонов — настоящий отдых",
    text: "Телефоны — главный враг летнего отдыха. В АйДаКемп экранное время ограничено системно, без конфликтов с детьми.",
    list: [
      "Экранное время зарабатывается игровыми рублями — игровой валютой смены (по аналогии с Монополией)",
      "Ребята выбирают, на что тратить заработанные рубли: кино, свободный интернет, настолки",
      "Результат: живое общение, прогулки, спорт вместо бесконечной ленты соцсетей",
      "Мамы отмечают: возвращаются бодрыми и разговорчивыми уже на второй день"
    ]
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский оздоровительный лагерь для детей ${SEASON_YEAR} — путёвка в Подмосковье, лето`}
  description={`Детский оздоровительный лагерь для детей в Подмосковье ${SEASON_YEAR} — летний отдых, IT, бассейн, медработник 24/7. В Московской области. Путёвка на августовские смены 10 и 13 дней от ${PRICE_MIN}.`}
  h1={`Детский оздоровительный лагерь Подмосковья`}
  canonical="https://aidacamp.ru/ozdorovitelnyj-lager"
>
  <LandingHero slot="hero"
    h1={`Детский оздоровительный лагерь Подмосковья`}
    subtitle={`Лес, бассейн, медработник 24/7 и IT-проект за смену. Санаторий «Изумруд», 66 км от МКАД, Московская область. Для детей 7–15 лет, от ${PRICE_MIN}.`}
    breadcrumb="Оздоровительный лагерь"
    keywords={[
      "Свежий воздух, бассейн, медработник — оздоровление без компромиссов",
      "Лицензия Минобрнауки + Роспотребнадзор — официально и безопасно",
      "IT-проект за смену — ребёнок возвращается здоровым и с результатом"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Дети и вожатые АйДаКемп на территории санатория «Изумруд» в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что такое детский оздоровительный лагерь?", a: "Лагерь с проживанием за городом, где обеспечены условия для здоровья детей: свежий воздух, питание, медицинское сопровождение, физическая активность. АйДаКемп — с IT-образованием: Python, Scratch, Minecraft, AI, в Наро-Фоминском округе, Московская область." },
    { q: "Есть ли медработник в АйДаКемп?", a: "Да. Медицинский работник присутствует на территории 24/7 и следит за здоровьем детей. При необходимости сразу связываемся с родителями." },
    { q: `Сколько стоит путёвка в Подмосковье в ${SEASON_YEAR}?`, a: `АйДаКемп: от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Включено: проживание, 5-разовое питание, IT-программа, бассейн, медработник. Самый бюджетный вариант — короткая смена: цена за день ниже, чем в городских кружках. Налоговый вычет 13% — возврат до ${VYCHET_MAX} при наличии образовательной лицензии.` },
    { q: "Какая лицензия у АйДаКемп?", a: `Образовательная лицензия Минобрнауки ${STAT_LICENSE}, туроператор РТО ${STAT_RTO}, разрешение Роспотребнадзора на каждую смену. Рейтинг 5.0 на Яндекс.Картах, 40+ независимых отзывов.` },
    { q: `Как выбрать лагерь на лето ${SEASON_YEAR}?`, a: `При выборе важно: наличие лицензии (право на вычет), медработник на территории, питание по СанПиН. АйДаКемп — в Наро-Фоминском округе, Московская область: лицензия Минобрнауки, медработник 24/7, открыта запись на августовские смены 10 и 13 дней от ${PRICE_MIN}.` },
    { q: "С какого возраста принимают детей?", a: "Принимаем ребят от 7 до 15 лет, группы формируются по возрасту." },
    { q: "Какая медицинская справка нужна для поездки?", a: "Форма 079/у или 026/у, оформляется у педиатра в районной поликлинике." },
    { q: "Забирают ли телефон у ребёнка на смене?", a: "В первые дни смены школьники сдают телефоны на хранение — это помогает быстрее адаптироваться." },
    { q: "Есть ли родительский день?", a: "Да, раз в смену, дата анонсируется за 3–5 дней." },
    { q: "Есть ли трансфер из Москвы?", a: `Да, организованный автобус от метро Солнцево в день заезда, ${TRANSFER_PRICE_FMT}, бронируется вместе с путёвкой.` },
  ]} only={['safety', 'food', 'accommodation']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
