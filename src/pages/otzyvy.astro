---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Shifts from '../components/Shifts.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { reviews } from '../data/reviews';
import { getRelatedPages } from '../data/landing-pages';
import { WHATSAPP_URL, YANDEX_MAPS_URL } from '../data/contacts';

const relatedPages = getRelatedPages('/otzyvy');

const reviewsSchema = reviews.map((r) => ({
  "@type": "Review",
  "author": { "@type": "Person", "name": r.name },
  "datePublished": r.date,
  "reviewBody": r.fullText ?? r.text,
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": "5",
    "bestRating": "5"
  },
  "itemReviewed": {
    "@type": "EducationalOrganization",
    "name": "АйДаКемп"
  }
}));
---

<Base
  title="Отзывы об АйДаКемп — родители о детском IT-лагере в Подмосковье"
  description="Настоящие отзывы родителей об IT-лагере АйДаКемп. Дети 7–15 лет, Подмосковье. Что говорят мамы после смены — без купюр."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/otzyvy" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "АйДаКемп",
      "url": "https://aidacamp.ru",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "40",
        "bestRating": "5"
      },
      "review": reviewsSchema
    })} />
  </Fragment>

  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-slate-50 border-b border-slate-100 pt-12 pb-10 md:pt-16 md:pb-14">
      <div class="mx-auto max-w-[860px] px-4">
        <!-- Breadcrumbs -->
        <nav class="mb-6 flex items-center gap-1.5 text-[13px] text-slate-400">
          <a href="/" class="hover:text-orange-500 transition">Главная</a>
          <i class="bi bi-arrow-right-short text-[16px]" aria-hidden="true"></i>
          <span class="text-slate-600">Отзывы</span>
        </nav>

        <h1 class="text-[28px] md:text-[38px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">
          Отзывы родителей об АйДаКемп
        </h1>
        <p class="mt-4 text-[16px] md:text-[17px] leading-[1.6] text-slate-500 max-w-[640px]">
          Собрали настоящие отзывы — с Яндекс.Карт, 2ГИС и напрямую от наших мам. Никакой редактуры, только живые слова. Хочешь узнать больше о лагере? <a href="/o-lagere" class="text-orange-500 hover:underline">О нас</a> и <a href="/lager-v-podmoskove" class="text-orange-500 hover:underline">о месте</a>.
        </p>

        <!-- Рейтинг-плашка -->
        <div class="mt-8 inline-flex flex-col sm:flex-row items-start sm:items-center gap-4 bg-white rounded-[18px] border border-slate-100 shadow-sm px-6 py-4">
          <div class="flex items-center gap-3">
            <span class="text-[42px] font-bold leading-[1] text-slate-900">5.0</span>
            <div class="flex flex-col gap-1">
              <div class="flex items-center gap-0.5">
                <i class="bi bi-star-fill text-[15px] text-orange-500" aria-hidden="true"></i>
                <i class="bi bi-star-fill text-[15px] text-orange-500" aria-hidden="true"></i>
                <i class="bi bi-star-fill text-[15px] text-orange-500" aria-hidden="true"></i>
                <i class="bi bi-star-fill text-[15px] text-orange-500" aria-hidden="true"></i>
                <i class="bi bi-star-fill text-[15px] text-orange-500" aria-hidden="true"></i>
              </div>
              <span class="text-[13px] text-slate-400">из 5 звёзд</span>
            </div>
          </div>
          <div class="hidden sm:block w-px h-10 bg-slate-100"></div>
          <div class="flex flex-col gap-0.5">
            <span class="text-[17px] font-semibold text-slate-800">40+ отзывов</span>
            <a
              href={YANDEX_MAPS_URL}
              target="_blank"
              rel="noopener"
              class="text-[13px] text-orange-500 hover:underline flex items-center gap-1"
            >
              <i class="bi bi-geo-alt text-[13px]" aria-hidden="true"></i>
              Яндекс.Карты
            </a>
          </div>
          <div class="hidden sm:block w-px h-10 bg-slate-100"></div>
          <div class="flex items-center gap-2">
            <i class="bi bi-patch-check-fill text-[20px] text-orange-500" aria-hidden="true"></i>
            <span class="text-[13px] text-slate-500 max-w-[160px] leading-[1.4]">Верифицированные отзывы от реальных родителей</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="mx-auto max-w-[1080px] px-4">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((review) => (
            <article class="flex flex-col bg-white rounded-[20px] border border-slate-100 shadow-sm p-6 hover:shadow-md transition-shadow duration-200">
              <!-- Шапка карточки -->
              <div class="flex items-center gap-3 mb-4">
                <img
                  src={review.photo}
                  alt={`Фото ${review.name}`}
                  class="w-11 h-11 rounded-full object-cover shrink-0 border-2 border-orange-100"
                  loading="lazy"
                  width="44"
                  height="44"
                />
                <div class="min-w-0">
                  <p class="text-[14px] font-semibold text-slate-900 truncate">{review.name}</p>
                  <p class="text-[12px] text-slate-400">{review.date}</p>
                </div>
                <div class="ml-auto flex items-center gap-0.5 shrink-0">
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                </div>
              </div>
              <!-- Текст отзыва -->
              <p class="text-[14px] leading-[1.7] text-slate-600 flex-1">
                {review.fullText ?? review.text}
              </p>
            </article>
          ))}
        </div>

        <!-- CTA после отзывов -->
        <div class="mt-12 rounded-[22px] bg-[#0d1a2b] px-6 py-8 md:px-10 md:py-10 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-chat-quote text-[20px] text-orange-400" aria-hidden="true"></i>
              <span class="text-[13px] font-semibold uppercase tracking-[0.8px] text-white/50">Есть вопросы?</span>
            </div>
            <p class="text-[20px] md:text-[22px] font-bold text-white leading-[1.3]">
              Напишите нам — ответим за 10 минут
            </p>
            <p class="mt-2 text-[14px] text-white/50 leading-[1.6]">
              Расскажем про ближайшую смену, поможем подобрать под возраст и уровень ребёнка. Или посмотри <a href="/ceny" class="text-orange-400 hover:underline">цены и даты</a>.
            </p>
          </div>
          <div class="flex flex-col gap-2 w-full md:w-auto shrink-0">
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 rounded-[14px] bg-[#25D366] px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-[#1db954] hover:-translate-y-[1px] transition-all duration-200 whitespace-nowrap"
            >
              <i class="bi bi-whatsapp text-[16px]" aria-hidden="true"></i>
              Написать в WhatsApp
            </a>
            <a
              href="#shifts"
              class="flex items-center justify-center gap-2 rounded-[14px] border border-white/20 px-6 py-3 text-[14px] text-white/70 hover:border-white/40 hover:text-white transition whitespace-nowrap"
            >
              Посмотреть смены
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Shifts />
  <ShiftBookModal />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
