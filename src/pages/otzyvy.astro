---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Shifts from '../components/Shifts.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { reviews } from '../data/reviews';
import { getRelatedPages } from '../data/landing-pages';
import { WHATSAPP_URL, YANDEX_MAPS_URL } from '../data/contacts';

const relatedPages = getRelatedPages('/otzyvy');

const reviewsSchema = reviews.map((r) => ({
  "@type": "Review",
  "author": { "@type": "Person", "name": r.name },
  "datePublished": r.date,
  "reviewBody": r.fullText ?? r.text,
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": "5",
    "bestRating": "5"
  },
  "itemReviewed": {
    "@type": "EducationalOrganization",
    "name": "АйДаКемп"
  }
}));
---

<Base
  title="Отзывы родителей о детском лагере АйДаКемп — 40+ на Яндекс.Картах, рейтинг 5.0"
  description="Отзывы о детском IT-лагере АйДаКемп в Подмосковье. 40+ отзывов от реальных мам на Яндекс.Картах, рейтинг 5.0. Дети 7–15 лет, смены июнь–август 2026."
  ogImage="/images/hero/otzyvy.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/otzyvy" />
    <link rel="preload" as="image" href="/images/hero/otzyvy.avif" type="image/avif" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "АйДаКемп",
      "url": "https://aidacamp.ru",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "40",
        "bestRating": "5"
      },
      "review": reviewsSchema
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько отзывов у детского лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Более 40 верифицированных отзывов на Яндекс.Картах со средней оценкой 5.0. Лагерь работает с 2021 года — более 1 200 детей за 5 лет." }
        },
        {
          "@type": "Question",
          "name": "Где читать отзывы о детских лагерях Подмосковья?",
          "acceptedAnswer": { "@type": "Answer", "text": "Отзывы об АйДаКемп — на этой странице, на Яндекс.Картах (рейтинг 5.0) и Google Maps. Публикуем без цензуры — в том числе замечания." }
        },
        {
          "@type": "Question",
          "name": "Что пишут родители в отзывах о детском IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Три самые частые темы: (1) ребёнок вернулся и продолжает программировать дома, (2) хочет поехать снова в следующем году, (3) удивились, что серьёзная IT-программа сочетается с живой загородной атмосферой." }
        },
        {
          "@type": "Question",
          "name": "Можно ли доверять отзывам о детском лагере на сайте?",
          "acceptedAnswer": { "@type": "Answer", "text": "Отзывы на этой странице — реальные, от родителей детей которые были в АйДаКемп. Большинство — с Яндекс.Карт (верифицированная платформа). Публикуем без редактуры." }
        }
      ]
    })} />
  </Fragment>

  <Header />

  <main>
    <!-- Hero с фото -->
    <section class="relative overflow-hidden min-h-[480px] md:min-h-[540px] bg-[#0d1a2b] px-5 pt-16 pb-12 md:px-14 md:pt-20 md:pb-16">
      <!-- Фоновое фото -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero/otzyvy.avif"
          alt="Дети в IT-лагере АйДаКемп"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="540"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#0d1a2b]/95 via-[#0d1a2b]/70 to-[#0d1a2b]/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d1a2b]/60 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-[1312px]">
        <div class="flex flex-col gap-6 lg:max-w-[660px]">
          <!-- Breadcrumb -->
          <nav class="text-[14px] text-white/50">
            <a href="/" class="hover:text-white/80 transition-colors">Главная</a>
            <span class="mx-2">&rarr;</span>
            <span class="text-white/70">Отзывы</span>
          </nav>

          <h1 class="text-[32px] md:text-[46px] font-bold leading-[1.1] tracking-[-0.03em] text-white">
            Отзывы о детском лагере АйДаКемп — 40+ на Яндекс.Картах
          </h1>
          <p class="text-[16px] md:text-[17px] leading-[1.6] text-white/70 max-w-[580px]">
            Собрали настоящие отзывы родителей — с Яндекс.Карт, 2ГИС и напрямую от наших мам. Никакой редактуры, только живые слова. Хочешь узнать больше? <a href="/o-lagere" class="text-orange-400 hover:underline">О нас</a> и <a href="/lager-v-podmoskove" class="text-orange-400 hover:underline">о месте</a>.
          </p>

          <!-- Рейтинг-плашка -->
          <div class="inline-flex flex-col sm:flex-row items-start sm:items-center gap-4 bg-white/10 backdrop-blur-sm rounded-[18px] border border-white/15 px-6 py-4 w-fit">
            <div class="flex items-center gap-3">
              <span class="text-[42px] font-bold leading-[1] text-white">5.0</span>
              <div class="flex flex-col gap-1">
                <div class="flex items-center gap-0.5">
                  <i class="bi bi-star-fill text-[15px] text-orange-400" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[15px] text-orange-400" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[15px] text-orange-400" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[15px] text-orange-400" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[15px] text-orange-400" aria-hidden="true"></i>
                </div>
                <span class="text-[13px] text-white/50">из 5 звёзд</span>
              </div>
            </div>
            <div class="hidden sm:block w-px h-10 bg-white/20"></div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[17px] font-semibold text-white">40+ отзывов</span>
              <a
                href={YANDEX_MAPS_URL}
                target="_blank"
                rel="noopener"
                class="text-[13px] text-orange-400 hover:underline flex items-center gap-1"
              >
                <i class="bi bi-geo-alt text-[13px]" aria-hidden="true"></i>
                Яндекс.Карты
              </a>
            </div>
            <div class="hidden sm:block w-px h-10 bg-white/20"></div>
            <div class="flex items-center gap-2">
              <i class="bi bi-patch-check-fill text-[20px] text-orange-400" aria-hidden="true"></i>
              <span class="text-[13px] text-white/60 max-w-[160px] leading-[1.4]">Верифицированные отзывы от реальных родителей</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="mx-auto max-w-[1080px] px-4">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((review) => (
            <article class="flex flex-col bg-white rounded-[20px] border border-slate-100 shadow-sm p-6 hover:shadow-md transition-shadow duration-200">
              <!-- Шапка карточки -->
              <div class="flex items-center gap-3 mb-4">
                <img
                  src={review.photo}
                  alt={`Фото ${review.name}`}
                  class="w-11 h-11 rounded-full object-cover shrink-0 border-2 border-orange-100"
                  loading="lazy"
                  width="44"
                  height="44"
                />
                <div class="min-w-0">
                  <p class="text-[14px] font-semibold text-slate-900 truncate">{review.name}</p>
                  <p class="text-[12px] text-slate-400">{review.date}</p>
                </div>
                <div class="ml-auto flex items-center gap-0.5 shrink-0">
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                  <i class="bi bi-star-fill text-[11px] text-orange-500" aria-hidden="true"></i>
                </div>
              </div>
              <!-- Текст отзыва -->
              <p class="text-[14px] leading-[1.7] text-slate-600 flex-1">
                {review.fullText ?? review.text}
              </p>
            </article>
          ))}
        </div>

        <!-- CTA после отзывов -->
        <div class="mt-12 rounded-[22px] bg-[#0d1a2b] px-6 py-8 md:px-10 md:py-10 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-chat-quote text-[20px] text-orange-400" aria-hidden="true"></i>
              <span class="text-[13px] font-semibold uppercase tracking-[0.8px] text-white/50">Есть вопросы?</span>
            </div>
            <p class="text-[20px] md:text-[22px] font-bold text-white leading-[1.3]">
              Напишите нам — ответим за 10 минут
            </p>
            <p class="mt-2 text-[14px] text-white/50 leading-[1.6]">
              Расскажем про ближайшую смену, поможем подобрать под возраст и уровень ребёнка. Или посмотри <a href="/ceny" class="text-orange-400 hover:underline">цены и даты</a>.
            </p>
          </div>
          <div class="flex flex-col gap-2 w-full md:w-auto shrink-0">
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 rounded-[14px] bg-[#25D366] px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-[#1db954] hover:-translate-y-[1px] transition-all duration-200 whitespace-nowrap"
            >
              <i class="bi bi-whatsapp text-[16px]" aria-hidden="true"></i>
              Написать в WhatsApp
            </a>
            <a
              href="#shifts"
              class="flex items-center justify-center gap-2 rounded-[14px] border border-white/20 px-6 py-3 text-[14px] text-white/70 hover:border-white/40 hover:text-white transition whitespace-nowrap"
            >
              Посмотреть смены
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Shifts />
  <ShiftBookModal />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
