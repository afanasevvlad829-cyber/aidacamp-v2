---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Что такое IT camp для детей",
    text: "IT camp — это летний лагерь с программой в сфере информационных технологий. Дети живут в загородном лагере, занимаются программированием, AI и созданием цифровых проектов — и при этом купаются, играют, общаются с ровесниками. АйДаКемп работает с 2021 года, через нас прошли более 1 200 детей от 7 до 15 лет. Подробнее о программах — в нашем <a href='/kompyuternyy-lager' class='text-[#ec7c00] hover:underline'>компьютерном лагере</a>.",
  },
  {
    h2: "Чем IT camp отличается от кружка программирования",
    text: "В кружке ребёнок приходит на 1–2 часа в неделю. В IT camp он полностью погружён в среду — 7 или 14 дней, с утра до вечера, с командой ровесников и преподавателями рядом. Это даёт то, чего не добиться за разовые занятия: концентрацию, командный проект, навык доводить задачу до конца.",
    list: [
      "7 или 14 дней полного погружения — без отвлечений на домашние дела",
      "Соотношение преподаватель : дети = 1:6",
      "Каждый уезжает с готовым IT-проектом — игрой, ботом, 3D-моделью или приложением",
      "Не кружок — лагерь: бассейн, спорт, живое общение между занятиями"
    ]
  },
  {
    h2: "Программа IT camp АйДаКемп",
    text: "Программа подбирается по возрасту и уровню — группы 7–9, 10–12 и 13–15 лет. На старте смены преподаватель проводит короткую диагностику, чтобы каждый ребёнок попал в подходящую группу.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые игры и анимации",
      "Python (10–14 лет) — с нуля до рабочего проекта: скрипты, боты, игры",
      "AI и нейросети (11–14 лет) — работа с реальными инструментами: ChatGPT, Gemini, Stable Diffusion",
      "Minecraft Education (8–12 лет) — создание модов, Python-скрипты для игры",
      "3D-моделирование и печать (10–14 лет) — Blender, прототипирование, работа с 3D-принтером"
    ]
  },
  {
    h2: "Где проходит IT camp",
    text: "Лагерь расположен в Московской области, в 66 км от МКАД по Киевскому шоссе. Территория санатория «Изумруд» — Наро-Фоминский городской округ. Живописный сосновый лес, закрытая охраняемая территория, корпуса с номерами по 2–4 человека, 5-разовое питание, бассейн с ионизированной водой.",
    list: [
      "66 км от МКАД по Киевскому шоссе — ~1 час на машине",
      "Трансфер от метро Солнцево — опция при бронировании",
      "Закрытая территория, КПП, охрана 24/7",
      "Медработник на территории в течение всей смены",
      "Корпуса: номера 2–4 человека, раздельное размещение мальчиков и девочек",
      "Бассейн с ионизированной водой, спортплощадки, зоны отдыха"
    ]
  },
  {
    h2: "Возраст и уровень подготовки для IT camp",
    text: "Мы принимаем детей 7–15 лет с любым уровнем — от «никогда не видел код» до «уже пишет на Python». Диагностика на старте смены позволяет распределить всех по группам так, чтобы каждый ребёнок работал на своём уровне: не скучал и не чувствовал себя отстающим.",
  },
  {
    h2: "Стоимость и смены IT camp 2026",
    text: "Смены проходят с июня по август 2026 года. Продолжительность — 7 или 14 дней. В стоимость включены: проживание, питание (5 раз в день), полная IT-программа, активности, оборудование. Налоговый вычет 13% — можно вернуть до 5 434 ₽ за смену."
  },
  {
    h2: "Направления IT camp — выбери программу",
    text: "В АйДаКемп шесть IT-направлений. Каждое — отдельная программа со своим финальным проектом. Если не знаешь, с чего начать — поможем определиться при бронировании.",
    list: [
      "<a href='/python-lager' class='text-[#ec7c00] hover:underline'>Лагерь Python</a> (10–15 лет) — боты, скрипты, работа с API",
      "<a href='/ai-lager' class='text-[#ec7c00] hover:underline'>Лагерь AI и нейросетей</a> (11–15 лет) — ChatGPT API, Gemini, генерация",
      "<a href='/minecraft-lager' class='text-[#ec7c00] hover:underline'>Лагерь Minecraft</a> (8–12 лет) — моды, Python-скрипты, своя карта",
      "<a href='/scratch-lager' class='text-[#ec7c00] hover:underline'>Лагерь Scratch</a> (7–10 лет) — первая игра и анимация без барьера кода",
      "<a href='/roblox-lager' class='text-[#ec7c00] hover:underline'>Лагерь Roblox</a> (9–13 лет) — 3D-игра на Lua с нуля",
      "<a href='/3d-modelirovanie-lager' class='text-[#ec7c00] hover:underline'>Лагерь 3D-моделирования</a> (10–14 лет) — Blender, модель на 3D-печать"
    ]
  },
  {
    h2: "Что ребёнок привезёт из IT camp домой",
    text: "Главный результат — не сертификат и не «они теперь умеют Python». Главное — готовый проект, который ребята сделали сами от идеи до финала. Это игра, бот, 3D-модель или анимация — в зависимости от программы. Плюс опыт работы в команде, публичная защита проекта перед аудиторией и два десятка новых знакомых.",
  }
];
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title="IT Camp для детей в Подмосковье 2026 | АйДаКемп"
  description="ИТ-лагерь (IT Camp) — Python, AI, Minecraft для детей 7–15 лет в Подмосковье. Смены июнь–август 2026 от 48 000 ₽, 66 км от МКАД, ★ 5.0."
  h1="IT Camp для детей в Подмосковье"
  canonical="https://aidacamp.ru/it-camp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Что такое IT Camp для детей?", "acceptedAnswer": { "@type": "Answer", "text": "IT Camp — загородный лагерь с полным IT-погружением. В АйДаКемп дети 7–15 лет живут в санатории «Изумруд» в Подмосковье и занимаются программированием дважды в день. Python, AI, Minecraft, 3D-моделирование. В финале — хакатон с защитой проекта." } },
        { "@type": "Question", "name": "Чем IT-кемп отличается от обычного лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "В обычном лагере дети отдыхают, в IT Camp — создают. Программирование дважды в день по 90 минут в малых группах до 8 человек, реальный проект в финале. Один IT-кемп по глубине погружения = 3–4 месяца онлайн-курса." } },
        { "@type": "Question", "name": "Какие треки есть в IT Camp?", "acceptedAnswer": { "@type": "Answer", "text": "Python (программирование и боты), AI и нейросети (ChatGPT API, Gemini), Minecraft (моды и логика), Roblox (создание игр на Lua), 3D-моделирование (Blender + 3D-печать). Трек выбирается по возрасту и интересам." } },
        { "@type": "Question", "name": "Сколько стоит IT Camp в Подмосковье 2026?", "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней до 95 000 ₽ за 14 дней. Проживание, питание, IT-программа и бассейн включены. Налоговый вычет 13% — до 5 434 ₽ возврата через nalog.ru." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="IT Camp для детей в Подмосковье"
    subtitle="Летний лагерь с программированием, AI и живым общением — не кружок, а полное погружение на 7 или 14 дней."
    breadcrumb="IT Camp"
    keywords={[
      "Python, AI, Minecraft — от первых строк кода до готового проекта",
      "Преподаватели с опытом 7+ лет, соотношение 1:6",
      "Смены с июня по август 2026, трансфер от метро"
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="IT Camp для детей АйДаКемп Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
