---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Что такое IT camp для детей",
    text: "IT camp — это летний лагерь с программой в сфере информационных технологий. Дети живут в загородном лагере, занимаются программированием, AI и созданием цифровых проектов — и при этом купаются, играют, общаются с ровесниками. АйДаКемп работает с 2019 года, через нас прошли более 1200 детей от 7 до 14 лет.",
  },
  {
    h2: "Чем IT camp отличается от кружка программирования",
    text: "В кружке ребёнок приходит на 1–2 часа в неделю. В IT camp он полностью погружён в среду — 7 или 14 дней, с утра до вечера, с командой ровесников и преподавателями рядом. Это даёт то, чего не добиться за разовые занятия: концентрацию, командный проект, навык доводить задачу до конца.",
    list: [
      "7 или 14 дней полного погружения — без отвлечений на домашние дела",
      "Соотношение преподаватель : дети = 1:6",
      "Каждый уезжает с готовым IT-проектом — игрой, ботом, 3D-моделью или приложением",
      "Не кружок — лагерь: бассейн, спорт, живое общение между занятиями"
    ]
  },
  {
    h2: "Программа IT camp АйДаКемп",
    text: "Программа подбирается по возрасту и уровню — группы 7–9, 10–12 и 13–14 лет. На старте смены преподаватель проводит короткую диагностику, чтобы каждый ребёнок попал в подходящую группу.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые игры и анимации",
      "Python (10–14 лет) — с нуля до рабочего проекта: скрипты, боты, игры",
      "AI и нейросети (11–14 лет) — работа с реальными инструментами: ChatGPT, Gemini, Stable Diffusion",
      "Minecraft Education (8–12 лет) — создание модов, Python-скрипты для игры",
      "3D-моделирование и печать (10–14 лет) — Blender, прототипирование, работа с 3D-принтером"
    ]
  },
  {
    h2: "Где проходит IT camp",
    text: "Лагерь расположен в Московской области, в 66 км от Москвы по Калужскому шоссе. Территория санатория «Изумруд» — Наро-Фоминский городской округ. Живописный сосновый лес, закрытая охраняемая территория, корпуса с номерами по 2–4 человека, 5-разовое питание, бассейн с ионизированной водой.",
    list: [
      "66 км от МКАД по Калужскому шоссе — ~1 час на машине",
      "Трансфер от метро Тёплый Стан — опция при бронировании",
      "Закрытая территория, КПП, охрана 24/7",
      "Медработник на территории в течение всей смены",
      "Корпуса: номера 2–4 человека, раздельное размещение мальчиков и девочек",
      "Бассейн с ионизированной водой, спортплощадки, зоны отдыха"
    ]
  },
  {
    h2: "Возраст и уровень подготовки для IT camp",
    text: "Мы принимаем детей 7–14 лет с любым уровнем — от «никогда не видел код» до «уже пишет на Python». Диагностика на старте смены позволяет распределить всех по группам так, чтобы каждый ребёнок работал на своём уровне: не скучал и не чувствовал себя отстающим.",
  },
  {
    h2: "Стоимость и смены IT camp 2026",
    text: "Смены проходят с июня по август 2026 года. Продолжительность — 7 или 14 дней. В стоимость включены: проживание, питание (5 раз в день), полная IT-программа, активности, оборудование. Налоговый вычет 13% — можно вернуть до 15 600 ₽ за смену."
  },
  {
    h2: "Что ребёнок привезёт из IT camp домой",
    text: "Главный результат — не сертификат и не «он теперь умеет Python». Главное — готовый проект, который ребёнок сделал сам от идеи до финала. Это игра, бот, 3D-модель или анимация — в зависимости от программы. Плюс опыт работы в команде, публичная защита проекта перед аудиторией и два десятка новых знакомых.",
  }
];
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title="IT Camp для детей 2026 — летний IT-лагерь в Подмосковье | АйДаКемп"
  description="IT camp для детей 7–14 лет в Подмосковье. Python, AI, Minecraft, 3D — ребёнок уезжает с проектом. Смены июнь–август 2026, от 48 000 ₽. 66 км от Москвы, ★ 5.0 Яндекс Карты."
  h1="IT Camp для детей в Подмосковье"
  canonical="https://aidacamp.ru/it-camp"
>
  <LandingHero slot="hero"
    h1="IT Camp для детей в Подмосковье"
    subtitle="Летний лагерь с программированием, AI и живым общением — не кружок, а полное погружение на 7 или 14 дней."
    breadcrumb="IT Camp"
    keywords={[
      "Python, AI, Minecraft — от первых строк кода до готового проекта",
      "Преподаватели с опытом 7+ лет, соотношение 1:6",
      "Смены с июня по август 2026, трансфер от метро"
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="IT Camp для детей АйДаКемп Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
