---
import { DAYS_MAX, DAYS_MIN, DAYS_S2, DAYS_S21, PRICE_MAX, PRICE_MIN, SEASON_YEAR, VYCHET_MAX, daysNum } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SchoolContinue from '../components/SchoolContinue.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import { SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "Компьютерный лагерь — что это такое",
    text: "АйДаКемп — детский загородный лагерь в Подмосковье, где ребёнок совмещает отдых с реальной работой над проектом. Дети 7–15 лет живут в санатории «Изумруд», занимаются программированием дважды в день — а между этим купаются, играют, общаются с ровесниками в лагере. Для многих детей это первое живое знакомство с IT. Работаем в лагере с 2021 года, через наш Camp прошли более 1 200 ребят. Место на смену 2026 года можно забронировать через заявку на сайте. Почитайте <a href='/otzyvy/' class='text-[#ec9b44] hover:underline'>отзывы родителей</a>. Подробнее — в описании нашей программы, которую ведёт команда лагеря.",
  },
  {
    h2: "Стоимость и смены 2026 для детей 7–15 лет",
    text: `Смены проходят всё лето — ${SEASON_FROM_TO} ${SEASON_YEAR} года, удобно впишутся в летние каникулы. Продолжительность — ${daysNum(DAYS_S21)} или ${DAYS_S2}. В стоимость включены: проживание, питание (5 раз в день), полная образовательная программа, активности, оборудование. Налоговый вычет 13% — можно вернуть от 2 800 до ${VYCHET_MAX} в зависимости от смены.`
  },
  {
    h2: "Без опыта в программировании — можно?",
    text: "Да. В нашем Camp большинство ребят делают первые шаги в программировании. На старте смены преподаватель проводит короткую диагностику (15–20 минут) и определяет группу. Ребёнок, никогда не видевший код, начинает со Scratch или визуальных блоков: за 7 дней доходят до первой работающей игры, за 14 — до питча проекта перед жюри. Тем, кто уже пишет на Python, дают задачи сложнее — например, нейросети и искусственный интеллект. Подробнее — на странице <a href='/lager-programmirovaniya/' class='text-[#ec9b44] hover:underline'>про наш лагерь и подход к программированию</a>.",
  },
  {
    h2: "Чем наш лагерь отличается от кружка",
    text: "В кружке ребёнок приходит на 1–2 часа в неделю. В лагере он полностью погружён в среду — 7 или 14 дней, с утра до вечера, с командой ровесников и преподавателями рядом.",
    list: [
      "Группы до 8 человек — преподаватель помогает каждому, а не ведёт лекцию на 30 школьников",
      "Каждый ребёнок уезжает с готовым проектом — игрой, ботом, 3D-моделью или AI-приложением",
      `<strong>Одна смена по глубине погружения ≈ 3–4 месяца онлайн-курса</strong>`
    ]
  },
  {
    h2: "Чему учат по возрасту — программа смены",
    text: "Программирование — общая основа всех направлений, а дальше программа подбирается по возрасту — для детей 7–9, 10–12 и 13–15 лет.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование для самых младших детей: первые игры и анимации",
      "Python (10–14 лет) — с нуля до рабочего проекта: скрипты, боты, игры",
      "AI и нейросети (11–15 лет) — ChatGPT API, Gemini, Stable Diffusion",
      "Unity и C# (12–15 лет) — создание 2D/3D-игры с нуля",
      "VR/AR-разработка (13–15 лет) — сборка сцены в Unity",
      "Minecraft Education (8–12 лет) — моды и Python-скрипты",
      "3D-моделирование и печать (10–14 лет) — Blender, 3D-принтер"
    ]
  },
  {
    h2: "Вожатые и преподаватели — кто работает с детьми",
    text: "Преподаватели — не студенты с методичкой, а практикующие разработчики с опытом 3–10 лет. Вожатые лагеря живут вместе с детьми, а не только на занятиях.",
    list: [
      "Лицензия на образовательную деятельность — документы в порядке, налоговый вычет оформить можно"
    ]
  },
  {
    h2: "Где проходит смена",
    text: "Лагерь расположен в Московской области, в 66 км от МКАД по Киевскому шоссе, в Наро-Фоминском округе — на территории санатория «Изумруд». Территория в лагере закрытая и охраняемая круглосуточно: сосновый лес, корпуса на 2–4 человека, 5-разовое питание, бассейн с ионизированной водой. Подробнее — на странице <a href='/zagorodnyj-lager/' class='text-[#ec9b44] hover:underline'>загородный лагерь</a>.",
    list: [
    ]
  },
  {
    h2: "День в лагере — как устроен распорядок",
    text: "Многие мамы спрашивают: а дети не сидят за экраном весь день? Нет — это два блока по 90 минут в компьютерном классе, а середина дня — бассейн, спорт и прогулки на воздухе. Вечером — работа над своим проектом в небольшой группе.",
    list: [
      "08:00 — подъём, зарядка, завтрак",
      "09:00–12:30 — два блока занятий малыми группами",
      "14:00–17:00 — бассейн, спортплощадка, командные игры, квесты",
      "18:00–19:30 — работа над финальным проектом",
      "20:00 — ужин и вечерние мероприятия: кино, настолки, костёр",
      "22:00 — отбой"
    ]
  },
  {
    h2: "Финальный хакатон — защита проекта перед жюри",
    text: "Хакатон проходит прямо в лагере: каждый ребёнок выступает перед аудиторией: 5 минут объясняет идею, демонстрирует рабочий прототип, отвечает на вопросы.",
    list: [
      "Жюри: преподаватели + приглашённые специалисты из индустрии",
      "Лучшие проекты получают дипломы и призы от АйДаКемп",
    ]
  },
  {
    h2: "Направления для ребёнка — выбери трек",
    text: "У нас шесть направлений — от Python до 3D-печати.",
    list: [
      "<a href='/python-lager/' class='text-[#ec9b44] hover:underline'>Направление Python для детей</a> (10–15 лет) — боты и скрипты",
      "<a href='/ai-lager/' class='text-[#ec9b44] hover:underline'>Направление AI и нейросетей</a> (11–15 лет) — ChatGPT API, Gemini",
      "<a href='/minecraft-lager/' class='text-[#ec9b44] hover:underline'>Направление Minecraft</a> (8–12 лет) — моды и своя карта",
      "<a href='/scratch-lager/' class='text-[#ec9b44] hover:underline'>Направление Scratch</a> (7–10 лет) — первая игра и анимация",
      "<a href='/roblox-lager/' class='text-[#ec9b44] hover:underline'>Направление Roblox</a> (9–13 лет) — 3D-игра на Lua",
      "<a href='/3d-modelirovanie-lager/' class='text-[#ec9b44] hover:underline'>Направление 3D-моделирования</a> (10–14 лет) — Blender, модель на 3D-печать"
    ]
  },
  {
    h2: "Что ребёнок привезёт из лагеря домой",
    text: "Главный результат — не сертификат, а готовый проект: игра, бот, 3D-модель или AI-приложение. Плюс опыт публичной защиты, компьютерная грамотность и два десятка новых знакомых. Как <a href='/zapisatsya/' class='text-[#ec9b44] hover:underline'>записать ребёнка в лагерь</a> — пошагово на отдельной странице.",
  }
];
const SCHOOL_CONTINUE_LINKS = [
  { href: 'https://codims.ru/?utm_source=aidacamp&utm_medium=crosslink&utm_campaign=it-camp', label: 'Школа программирования для детей #АйДаКодить' },
  { href: 'https://codims.ru/courses/python/?utm_source=aidacamp&utm_medium=crosslink&utm_campaign=it-camp', label: 'Курс Python для школьников' },
];

---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title={`Летний компьютерный IT-лагерь программирования для детей в Подмосковье ${SEASON_YEAR} — АйДаКемп`}
  description={`АйДаКемп — летний компьютерный IT-лагерь программирования для детей в Подмосковье, 66 км от Москвы. Python, Minecraft, 7–15 лет, группы до 8 человек, от ${PRICE_MIN}.`}
  h1={`Летний IT-лагерь программирования в Подмосковье: учим детей`}
  canonical="https://aidacamp.ru/it-camp"
  breadcrumb="IT-лагерь"
>
  <LandingHero slot="hero"
    h1={`Летний IT-лагерь программирования в Подмосковье: учим детей`}
    subtitle="Для детей 7–15 лет. Python, AI, Unity, Minecraft — свои игры и полное погружение на 7 или 14 дней. Группы до 8 человек, без опыта — можно."
    breadcrumb="IT-лагерь"
    keywords={[
      "Программирование на Python, AI, Unity, C#, VR/AR — от первых строк до готового проекта",
      "Группы до 8 человек, преподаватели-практики с опытом 3–10 лет в разработке",
      `IT-смены ${SEASON_FROM_TO} ${SEASON_YEAR} для детей, трансфер от метро`
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="IT-лагерь для детей АйДаКемп Подмосковье"
  />
  <!-- Featured Snippet: что такое IT-лагерь для детей -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-blue-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="chto-takoe-lager-programmirovaniya">Что такое IT-лагерь для ребёнка?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>Лагерь</strong> — это летняя загородная смена, где ребёнок совмещает отдых с реальной работой над проектом.
      Дети 7–15 лет изучают Python, AI, Unity, Scratch, Minecraft — и создают собственные проекты, живя в санатории «Изумруд» в Подмосковье. Смены 2026 года длятся 7–14 дней, группы до 8 человек, без опыта. Между собой дети зовут это место просто Camp.
    </p>
  </section>

  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <SchoolContinue links={SCHOOL_CONTINUE_LINKS} />
  <FAQ extraItems={[
    { q: "Что делают дети в IT-лагере?", a: "Это летний загородный лагерь, где ребёнок совмещает отдых с работой над IT-проектом: Python, AI, Unity, Minecraft, 3D-моделирование — дважды в день. В финале — хакатон с защитой проекта перед жюри из специалистов индустрии." },
    { q: "Можно ли начать без опыта в IT?", a: "Да. Большинство ребят приезжают с нулевым опытом — преподаватель распределяет по группам после диагностики. За 7 дней получается первая работающая игра, за 14 — питч проекта перед жюри." },
    { q: "Какие направления есть в этом лагере?", a: "Python (код и боты), AI и нейросети (ChatGPT API, Gemini), Unity и C# (создание игр), VR/AR-разработка (13–15 лет), Minecraft (моды и логика), Roblox (игры на Lua), 3D-моделирование (Blender + 3D-печать). Трек выбирается по возрасту и интересам." },
    { q: "Сколько стоит смена в IT-лагере в Подмосковье?", a: `Цены ${SEASON_YEAR} года: от ${PRICE_MIN} за ${DAYS_MIN} до ${PRICE_MAX} за ${DAYS_MAX}. Проживание, питание, образовательная программа и бассейн включены. Ноутбук не нужен. Налоговый вычет 13% — до ${VYCHET_MAX} возврата через nalog.ru.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
