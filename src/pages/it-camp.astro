---
import { PRICE_MAX, PRICE_MIN, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "Что такое лагерь программирования для детей",
    text: "IT Camp (лагерь программирования) — это летний загородный детский лагерь и один из лагерей Подмосковья, где ребёнок совмещает отдых и реальную работу над IT-проектом на каникулах. В АйДаКемп школьники 7–15 лет живут в санатории «Изумруд» в Подмосковье, занимаются по программе два раза в день — и между этим купаются, играют, общаются с ровесниками. АйДаКемп работает с 2021 года, через нас прошли более 1 200 ребят. Почитайте <a href='/otzyvy/' class='text-[#ec7c00] hover:underline'>отзывы родителей</a> — это честнее любых обещаний. Подробнее о программах — в нашем <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерном лагере</a>.",
  },
  {
    h2: "Стоимость и смены IT-лагеря",
    text: `Смены проходят всё лето — ${SEASON_FROM_TO} ${SEASON_YEAR} года, удобно впишутся в летние каникулы. Продолжительность — 7 или 14 дней. В стоимость IT Camp включены: проживание, питание (5 раз в день), полная образовательная программа, активности, оборудование. Ноутбук привозить не нужно — все компьютеры в лагере. Налоговый вычет 13% — можно вернуть от 2 800 до ${VYCHET_MAX} в зависимости от смены.`
  },
  {
    h2: "Без опыта программирования — можно?",
    text: "Да. Программирование с нуля — это норма, большинство ребят делают здесь первые шаги. На старте каждой смены преподаватель проводит короткую диагностику: 15–20 минут, и становится понятно, в какую группу попадёт ребёнок. Те, кто никогда не видел код, начинают со Scratch или визуальных блоков. За 7 дней доходят до первой работающей игры. За 14 — до питча своего проекта перед жюри. Тем, кто уже пишет на Python, дают задачи сложнее — например, обучение работе с нейросетями и искусственным интеллектом, — скучать тоже не придётся.",
  },
  {
    h2: "Чем IT Camp отличается от кружка программирования",
    text: "В кружке ребёнок приходит на 1–2 часа в неделю. В IT Camp он полностью погружён в среду — 7 или 14 дней, с утра до вечера, с командой ровесников и преподавателями рядом. Разница примерно как между уроком плавания раз в неделю и неделей на море.",
    list: [
      "7 или 14 дней полного погружения без отвлечений",
      "Группы до 8 человек — преподаватель помогает каждому, а не ведёт лекцию на 30 человек",
      "Каждый уезжает с готовым IT-проектом — игрой, ботом, 3D-моделью или AI-приложением",
      "Не кружок — лагерь: бассейн, спорт, живое общение между занятиями",
      `<strong>Один IT-лагерь по глубине погружения ≈ 3–4 месяца онлайн-курса</strong>`
    ]
  },
  {
    h2: "Программа лагеря программирования",
    text: "Программа подбирается по возрасту и уровню — группы 7–9, 10–12 и 13–15 лет. Каждое направление ведёт отдельный преподаватель с практическим IT-бэкграундом.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые игры и анимации без барьера кода",
      "Python (10–14 лет) — язык программирования с нуля до рабочего проекта: скрипты, боты, игры",
      "AI и нейросети (11–15 лет) — ChatGPT API, Gemini, Stable Diffusion: реальные инструменты, не демонстрация",
      "Unity и C# (12–15 лет) — создание 2D/3D-игры с нуля, основы геймдева",
      "VR/AR-разработка (13–15 лет) — сборка сцены в Unity, взаимодействие с виртуальной средой",
      "Minecraft Education (8–12 лет) — создание модов, Python-скрипты для игры",
      "3D-моделирование и печать (10–14 лет) — Blender, прототипирование, работа с 3D-принтером"
    ]
  },
  {
    h2: "Что ребёнок сделает за смену — конкретные результаты",
    text: "За 7 дней — рабочий прототип: игра на Scratch, Telegram-бот, 3D-модель для печати или AI-помощник. За 14 дней — полноценный проект с питчем перед жюри. Примеры из прошлых смен:",
    list: [
      "Игра на Python — платформер с препятствиями, системой очков и персонажем",
      "Telegram-бот с AI — отвечает на вопросы, переводит, советует фильмы",
      "3D-модель в Blender — напечатанный на принтере сувенир, который увозят домой"
    ]
  },
  {
    h2: "Вожатые и преподаватели — кто работает с ребятами",
    text: "Преподаватели АйДаКемп — не студенты с методичкой, а практикующие разработчики и педагоги с опытом 3–10 лет в IT. У каждого за плечами реальные проекты: свои боты, игры, стартапы. Это важно: ребята чувствуют разницу между «так надо по программе» и «я сам это делал».",
    list: [
      "Соотношение преподаватель : ребята = 1:6–8 — каждый получает живую обратную связь",
      "Вожатые (активности, проживание) — отдельно от преподавателей: у каждого своя роль",
      "Команда проходит подготовку перед каждой сменой — новые задачи, новые программы",
      "Лицензия на образовательную деятельность — документы в порядке, налоговый вычет оформить можно"
    ]
  },
  {
    h2: "Где проходит лагерь программирования",
    text: "Лагерь расположен в Московской области, в 66 км от МКАД по Киевскому шоссе. Территория санатория «Изумруд» — Наро-Фоминский городской округ. Сосновый лес, закрытая охраняемая территория, корпуса с номерами по 2–4 человека, 5-разовое питание, бассейн с ионизированной водой. Подробнее про территорию и инфраструктуру — на странице <a href='/zagorodnyj-lager/' class='text-[#ec7c00] hover:underline'>загородный IT-лагерь</a>.",
    list: [
      "66 км от МКАД по Киевскому шоссе — ~1 час на машине",
      "Трансфер от метро Солнцево — опция при бронировании",
      "Безопасность: закрытая территория, КПП, охрана 24/7",
      "Медработник на территории в течение всей смены",
      "Корпуса: номера 2–4 человека, раздельное размещение мальчиков и девочек",
      "Бассейн с ионизированной водой, спортплощадки, зоны отдыха"
    ]
  },
  {
    h2: "День в IT Camp — как устроен распорядок",
    text: "Многие мамы спрашивают: а они там не сидят за экраном весь день? Не сидят. IT-занятия — два блока по 90 минут с перерывом, а середина дня — бассейн, спортивный блок и прогулки на свежем воздухе. Вечером — работа над своим проектом в небольшой группе. Это и есть главное отличие от онлайн-курса.",
    list: [
      "08:00 — подъём, зарядка, завтрак",
      "09:00–10:30 — IT-занятия: первый блок (90 мин) в малых группах",
      "10:30 — перерыв, перекус",
      "11:00–12:30 — IT-занятия: второй блок (90 мин), продолжение проекта",
      "13:00 — обед",
      "14:00–17:00 — активности: бассейн, спортплощадка, командные игры, квесты, мастер-классы",
      "17:00 — полдник",
      "18:00–19:30 — работа над финальным проектом в группе",
      "20:00 — ужин и вечерние мероприятия: квесты, кино, настолки, костёр",
      "22:00 — отбой"
    ]
  },
  {
    h2: "Финальный хакатон — защита проекта перед жюри",
    text: "В последний день смены каждый ребёнок выступает перед аудиторией — не просто показывает экран, а питчит: 5 минут объясняет идею, демонстрирует рабочий прототип, отвечает на вопросы. Жюри — преподаватели и приглашённые IT-специалисты из отрасли. Это навык, который пригодится намного дальше IT.",
    list: [
      "Каждый выступает сам — личный проект, не групповой",
      "Жюри: преподаватели + приглашённые специалисты из IT-индустрии",
      "Лучшие проекты получают дипломы и призы от АйДаКемп",
      "Родители могут приехать лично или подключиться к онлайн-трансляции",
      "Видеозапись защиты отправляем каждой семье — остаётся на память"
    ]
  },
  {
    h2: "Направления IT-лагеря — выбери программу",
    text: "В АйДаКемп шесть IT-направлений. Каждое — отдельная программа со своим финальным проектом. Если не знаешь, с чего начать — поможем определиться при бронировании.",
    list: [
      "<a href='/python-lager/' class='text-[#ec7c00] hover:underline'>Лагерь Python для детей</a> (10–15 лет) — боты, скрипты, работа с API",
      "<a href='/ai-lager/' class='text-[#ec7c00] hover:underline'>Лагерь AI и нейросетей</a> (11–15 лет) — ChatGPT API, Gemini, генерация",
      "<a href='/minecraft-lager/' class='text-[#ec7c00] hover:underline'>Лагерь Minecraft</a> (8–12 лет) — моды, Python-скрипты, своя карта",
      "<a href='/scratch-lager/' class='text-[#ec7c00] hover:underline'>Лагерь Scratch</a> (7–10 лет) — первая игра и анимация без барьера кода",
      "<a href='/roblox-lager/' class='text-[#ec7c00] hover:underline'>Лагерь Roblox</a> (9–13 лет) — 3D-игра на Lua с нуля",
      "<a href='/3d-modelirovanie-lager/' class='text-[#ec7c00] hover:underline'>Лагерь 3D-моделирования</a> (10–14 лет) — Blender, модель на 3D-печать"
    ]
  },
  {
    h2: "Что ребёнок привезёт из лагеря программирования домой",
    text: "Главный результат — не сертификат. Это готовый проект, сделанный от идеи до финала: игра, бот, 3D-модель или AI-приложение. Плюс опыт публичной защиты перед аудиторией и два десятка новых знакомых, которые думают в ту же сторону. Как <a href='/zapisatsya/' class='text-[#ec7c00] hover:underline'>записать ребёнка в IT-лагерь</a> — пошагово на отдельной странице.",
  }
];
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title={`IT лагерь программирования для детей и подростков, Подмосковье`}
  description={`АйДаКемп — загородный летний IT Camp на каникулах, лагерь программирования для детей в Подмосковье ${SEASON_YEAR}, 66 км от Москвы. Python, AI, Unity, Minecraft, 7–15 лет. Группы до 8 человек. Смены от ${PRICE_MIN}.`}
  h1={`IT Camp — лагерь программирования в Подмосковье`}
  canonical="https://aidacamp.ru/it-camp"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое лагерь программирования для детей?", a: "Лагерь программирования — загородный лагерь, где ребёнок совмещает отдых с реальной работой над IT-проектом. В АйДаКемп школьники 7–15 лет живут в санатории «Изумруд» в Подмосковье и занимаются программированием дважды в день. Python, AI, Unity, Minecraft, 3D-моделирование. В финале — хакатон с защитой проекта перед жюри из IT-специалистов." },
    { q: "Можно ли без опыта программирования?", a: "Да. Большинство ребят приезжают с нулевым опытом. На старте смены преподаватель проводит диагностику и распределяет всех по группам. Те, кто никогда не видел код, начинают со Scratch или визуальных блоков. За 7 дней — первая работающая игра. За 14 — питч своего проекта перед жюри." },
    { q: "Какие направления есть в IT-лагере?", a: "Python (программирование и боты), AI и нейросети (ChatGPT API, Gemini), Unity и C# (создание игр), VR/AR-разработка (13–15 лет), Minecraft (моды и логика), Roblox (игры на Lua), 3D-моделирование (Blender + 3D-печать). Трек выбирается по возрасту и интересам." },
    { q: "Сколько стоит лагерь программирования в Подмосковье?", a: `От ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Проживание, питание, IT-программа и бассейн включены. Ноутбук не нужен. Налоговый вычет 13% — до ${VYCHET_MAX} возврата через nalog.ru.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`IT Camp — лагерь программирования в Подмосковье`}
    subtitle="Для детей 7–15 лет. Python, AI, Unity, Minecraft — полное погружение на 7 или 14 дней. Группы до 8 человек, без опыта программирования — можно."
    breadcrumb="IT-лагерь"
    keywords={[
      "Python, AI, Unity, C#, VR/AR — от первых строк кода до готового проекта",
      "Группы до 8 человек, преподаватели-практики с опытом 3–10 лет в IT",
      `Смены ${SEASON_FROM_TO} ${SEASON_YEAR}, трансфер от метро`
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="IT Camp для детей АйДаКемп Подмосковье"
  />
  <!-- Featured Snippet: что такое лагерь программирования -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-blue-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="chto-takoe-lager-programmirovaniya">Что такое лагерь программирования для детей?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>Лагерь программирования</strong> — это летний загородный лагерь, где ребёнок совмещает отдых с реальной работой над IT-проектом.
      В АйДаКемп школьники 7–15 лет изучают программирование — Python, AI, Unity, Scratch, Minecraft — и создают собственные проекты,
      живя в санатории «Изумруд» в Подмосковье. Смены длятся 7–14 дней, группы до 8 человек, опыт программирования не нужен.
    </p>
  </section>

  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
