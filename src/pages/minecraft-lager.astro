---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Чем лагерь Майнкрафт отличается от домашней игры",
    text: "В АйДаКемп Minecraft — это не просто игра, а инструмент обучения. Дети работают с Minecraft Education Edition: создают архитектурные проекты, программируют поведение персонажей, строят механизмы с редстоуном. Каждый из ребят уезжает с собственным миром, который можно запустить дома."
  },
  {
    h2: "Программа Minecraft в лагере",
    text: "Занятия выстроены от визуального строительства к программированию. Группы до 8 человек, преподаватель ведёт от простого к сложному.",
    list: [
      "Строительство и архитектура — от хижины до города",
      "Редстоун — схемы, механизмы, логика",
      "Создание модов — введение в программирование через игру",
      "Командная работа — совместные проекты и презентации"
    ]
  },
  {
    h2: "Программа Minecraft по дням — что осваивают",
    text: "За 10 дней ребята проходят путь от первого дома до рабочих механизмов и простых скриптов. Вот прогрессия:",
    list: [
      "Дни 1–2: знакомство с Minecraft Education Edition. Первое строительство — дом по заданию. Материалы, инструменты, режим Creative. Принципы архитектуры: фундамент, стены, крыша, детали",
      "Дни 3–5: редстоун — «электричество Minecraft». Факел, проводники, рычаги, кнопки. Первая схема: дверь которая открывается кнопкой. Более сложные механики: таймер, ловушка, автоматическая ферма",
      "Дни 6–8: командные блоки и введение в программирование. Команды /give, /teleport, /execute. Создание мини-игры прямо в мире: квест, гонка, охота за сокровищем",
      "Дни 9–10: финальный проект — каждый (или команда) строит свой уникальный мир по теме. Добавление механик, редстоуна, командных блоков. Подготовка «экскурсии» по своему миру",
      "Финал: каждый проводит экскурсию по своему миру для родителей и других ребят. Сертификаты."
    ]
  },
  {
    h2: "Возраст и группы",
    text: "Minecraft подходит детям 8–12 лет. Нюансы по возрастам:",
    list: [
      "8–9 лет: отличный старт — строительство и базовый редстоун. Пространственное мышление развивается через 3D-среду. Minecraft Education понятнее обычного Minecraft благодаря образовательным блокам",
      "10–11 лет: золотой возраст для Minecraft-треке. Уже могут разобраться со сложными редстоун-схемами, программируют командные блоки, делают реально работающие мини-игры в мире",
      "12 лет: старшая группа. Переходят к введению в Java/Python через Minecraft API — простые моды и скрипты которые меняют поведение мира. Это мост к «настоящему» программированию",
      "7 лет (исключение): берём если ребёнок уже играл в Minecraft дома и уверенно управляет мышью. Попадает в младшую группу к 8-летним"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену Minecraft",
    text: "Финал смены — мир который можно сохранить, запустить дома и показать друзьям. Примеры финальных проектов:",
    list: [
      "Замок с рабочими воротами — ворота открываются рычагом через редстоун-схему, подъёмный мост работает по кнопке",
      "Автоматическая ферма пшеницы — редстоун-механизм автоматически собирает урожай и складирует в сундук",
      "Квест-карта для друзей — мир с заданиями, загадками, скрытыми рычагами и финальной наградой",
      "Мини-город с транспортом — улицы, здания, действующий транспорт через вагонетки и активаторы",
      "Мини-игра «Поймай флаг» — командная игра с командными блоками, таймером и счётом"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для Minecraft-лагеря",
    text: "Minecraft-лагеря бывают разные — одни просто дают детям поиграть. В АйДаКемп это программа с прогрессией:",
    list: [
      "Minecraft Education Edition — специальная образовательная версия с расширенными инструментами, классной доской для совместной работы и программируемыми блоками",
      "От строительства к программированию — в финале смены старшие группы пишут первые скрипты через Minecraft API. Это реальный мост к Python",
      "Командные проекты — часть времени дети строят вместе. Это учит договариваться, делить задачи, принимать чужие идеи — живой навык",
      "Группы до 8 человек — преподаватель знает каждого ребёнка, корректирует темп и задаёт задачи на вырост"
    ]
  },
  {
    h2: "Как Minecraft готовит к программированию",
    text: "Редстоун — это аналог электрических схем: сигнал, проводник, логические элементы И/ИЛИ/НЕ. Дети которые научились редстоуну, намного легче понимают логические операции в Python. А командные блоки вводят понятие алгоритма: последовательность команд, условия выполнения. Путь Minecraft → Python — один из самых плавных переходов в программировании:",
    list: [
      "Редстоун-схемы развивают логическое мышление — базу для любого программирования",
      "Командные блоки учат алгоритмическому мышлению: делай A, потом B, если C — то D",
      "Minecraft Python API (для старших групп) — уже настоящий Python, просто с игровым контекстом",
      "После лагеря дети часто приходят на Python-трек со словами «я хочу делать боты как мы делали в Minecraft»"
    ]
  },
  {
    h2: "После Minecraft-лагеря — куда развиваться",
    text: "Minecraft — отличная первая ступень. Что дальше:",
    list: [
      "Scratch — если ещё не было: визуальное программирование с анимациями и играми",
      "Python-лагерь в следующую смену — логичный переход, особенно для детей 10+",
      "Roblox Studio — создавать собственные 3D-игры (Roblox похож на Minecraft в плане «строить + программировать»)",
      "Minecraft Python API дома — скачать Minecraft Java Edition, установить mcpi библиотеку и продолжать писать скрипты",
      "Командный YouTube-канал по Minecraft-программированию — есть хорошие каналы где показывают как создавать плагины"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Летний лагерь Майнкрафт для детей 2026 в Подмосковье | АйДаКемп"
  description="Летний лагерь Minecraft: создание миров, редстоун, моды и программирование. Для детей 8–12 лет в Подмосковье. Смены июнь–август от 48 000 ₽."
  h1="Детский лагерь Майнкрафт в Подмосковье"
  canonical="https://aidacamp.ru/minecraft-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем отличается лагерь Minecraft от обычного лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "В лагере Minecraft дети не просто играют, а создают: пишут моды, строят по заданиям, программируют редстоун-механику. АйДаКемп использует Minecraft Education Edition — версию для обучения с расширенными возможностями." }
        },
        {
          "@type": "Question",
          "name": "Нужно ли уметь играть в Minecraft до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Есть группы для новичков — начинают с основ управления и строительства. И группы для опытных игроков — переходят сразу к написанию модов и программированию." }
        },
        {
          "@type": "Question",
          "name": "Чему научатся дети в Minecraft-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Пространственное мышление, логика через редстоун, основы программирования через моды, командная работа при строительстве. Дети, прошедшие Minecraft-трек, легче переходят к Python и 3D-моделированию." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста подходит лагерь Minecraft?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 8 лет. Принимаем детей 8–12 лет. Для детей 8–10 лет Minecraft — первый шаг к программированию. Для 10–12 — можно сочетать с Python-треком." }
        },
        {
          "@type": "Question",
          "name": "Что такое редстоун и зачем его учить?",
          "acceptedAnswer": { "@type": "Answer", "text": "Редстоун — «электричество Minecraft». Это система проводников, сигналов и логических схем прямо в игре. Изучая редстоун, дети понимают логические операции И/ИЛИ/НЕ — основы которые потом встречают в программировании." }
        },
        {
          "@type": "Question",
          "name": "Что такое Minecraft Education Edition?",
          "acceptedAnswer": { "@type": "Answer", "text": "Специальная образовательная версия Minecraft с расширенными возможностями: классная доска для совместного обучения, Code Builder для программирования прямо в игре, дополнительные образовательные блоки. Используется в школах по всему миру." }
        },
        {
          "@type": "Question",
          "name": "Помогает ли Minecraft перейти к программированию?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, это один из самых плавных переходов. Редстоун учит логическим схемам, командные блоки — алгоритмическому мышлению. Minecraft Python API (для старших групп) — уже настоящий Python в игровом контексте. Многие наши Python-учащиеся прошли Minecraft-трек сначала." }
        }
      ]
    })} />
    <CourseSchema
      slot="head"
      name="Лагерь Minecraft Education для детей"
      description="Летний лагерь Minecraft Education: дети создают собственные миры, редстоун-механизмы и моды. Первый шаг к программированию для детей 8–12 лет."
      url="https://aidacamp.ru/minecraft-lager"
      level="Beginner"
      ageMin={8}
      ageMax={12}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь Майнкрафт в Подмосковье"
    subtitle="Дети создают собственные миры и моды в Minecraft Education — и параллельно учатся программировать через редстоун и командные блоки."
    breadcrumb="Лагерь Майнкрафт"
    keywords={["Minecraft Education — официальная образовательная версия", "Редстоун, командные блоки, первые моды — реальное программирование", "8–12 лет, загородный лагерь с проживанием"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Детский лагерь Майнкрафт в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej", description: "Minecraft учит 3D-мышлению — как развить это дальше.", icon: "box" },
    { title: "Социализация ребёнка в лагере — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere", description: "Командная работа в Minecraft — мощный инструмент сближения.", icon: "people" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Minecraft → Roblox Studio → Python: логичный путь.", icon: "braces" },
  ]} />
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager", icon: "pc-display" },
    { title: "Программирование с нуля — статья", url: "/stati/programmirovanie-dlya-detej-s-nulya", icon: "braces" },
    { title: "Цены и смены", url: "/ceny", icon: "currency-ruble" },
  ]} />
</LandingLayout>
