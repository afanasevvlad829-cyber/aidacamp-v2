---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Чем лагерь Майнкрафт отличается от домашней игры",
    text: "В АйДаКемп Minecraft — это не просто игра, а инструмент обучения. Дети работают с Minecraft Education Edition: создают архитектурные проекты, программируют поведение персонажей, строят механизмы с редстоуном. Каждый из ребят уезжает с собственным миром, который можно запустить дома."
  },
  {
    h2: "Программа Minecraft в лагере",
    text: "",
    list: [
      "Строительство и архитектура — от хижины до города",
      "Редстоун — схемы, механизмы, логика",
      "Создание модов — введение в программирование через игру",
      "Командная работа — совместные проекты и презентации"
    ]
  },
  {
    h2: "Возраст и группы",
    text: "Minecraft подходит детям 7–12 лет. Младшие (7–9) занимаются в Scratch и Minecraft параллельно — это идеальный старт для тех, кто ещё не готов к тексту кода. Старшие (10–12) переходят к программированию модов на Python."
  }
];

---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Лагерь Minecraft для детей в Подмосковье 2026 — АйДаКемп"
  description="Лагерь Minecraft Education в Подмосковье. Дети создают моды и карты на Python. Смены 2026 с июня, 66 км от МКАД, бассейн. От 48 000 ₽."
  h1="Детский лагерь Майнкрафт в Подмосковье"
  canonical="https://aidacamp.ru/minecraft-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем отличается лагерь Minecraft от обычного лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "В лагере Minecraft дети не просто играют, а создают: пишут моды, строят по заданиям, программируют редстоун-механику. АйДаКемп использует Minecraft Education Edition — версию для обучения с расширенными возможностями." }
        },
        {
          "@type": "Question",
          "name": "Нужно ли уметь играть в Minecraft до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Есть группы для новичков — начинают с основ управления и строительства. И группы для опытных игроков — переходят сразу к написанию модов и программированию." }
        },
        {
          "@type": "Question",
          "name": "Чему научатся дети в Minecraft-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Пространственное мышление, логика, основы программирования через моды, командная работа при строительстве. Дети, прошедшие Minecraft-трек, легче переходят к Python и 3D-моделированию." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста подходит лагерь Minecraft?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Принимаем детей 7–14 лет. Для детей 7–9 лет Minecraft — первый шаг к программированию. Для 10–14 — можно сочетать с Python-треком или Roblox Studio." }
        }
      ]
    })} />
    <CourseSchema
      slot="head"
      name="Лагерь Minecraft Education для детей"
      description="Летний лагерь Minecraft Education: дети создают собственные миры, пишут моды и учатся программировать в игровой среде за 7 или 14 дней."
      url="https://aidacamp.ru/minecraft-lager"
      level="Beginner"
      ageMin={7}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь Майнкрафт в Подмосковье"
    subtitle="Дети создают собственные миры и моды в Minecraft Education — и параллельно учатся программировать."
    breadcrumb="Лагерь Майнкрафт"
    keywords={["Minecraft Education — официальная образовательная версия", "Создание миров, модов и мини-игр с нуля", "7–15 лет, загородный лагерь с проживанием"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Детский лагерь Майнкрафт в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej", description: "Minecraft учит 3D-мышлению — как развить это дальше.", icon: "box" },
    { title: "Социализация ребёнка в лагере — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere", description: "Командная работа в Minecraft — мощный инструмент сближения.", icon: "people" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Minecraft → Roblox Studio → Python: логичный путь.", icon: "braces" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
