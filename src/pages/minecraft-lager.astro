---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Чем лагерь Minecraft (майнкрафт) отличается от домашней игры",
    text: "В АйДаКемп дети работают с Minecraft Education Edition: строят архитектурные проекты, программируют редстоун-механизмы и уезжают с собственным миром. Майнкрафт-программа — часть <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT-лагеря</a> и <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a> в Подмосковье."
  },
  {
    h2: "Лагерь Minecraft (майнкрафт): чему учат ребят",
    text: "Работаем в Minecraft Education Edition — официальной образовательной версии игры.",
    list: [
      "Редстоун — логические схемы, механизмы, автоматизированные фермы",
      "Моддинг на Java и Python (11–14 лет) — новые предметы, блоки, существа",
      "Кастомные биомы и мини-игры по собственным правилам",
      "Финал смены — «Экспо миров»: показывают и объясняют, что построили"
    ]
  },
  {
    h2: "Возраст и группы",
    text: "Майнкрафт-трек делится на два уровня подготовки:",
    list: [
      "7–10 лет — основы редстоуна, строительство, первые логические схемы",
      "11–14 лет — Java-моддинг: код, новые предметы и мобы"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Летний лагерь Minecraft (майнкрафт) для детей 7–14 лет с программированием в Подмосковье"
  description={`Загородный лагерь Minecraft (майнкрафт) для детей от 7 лет: создание модов и миров, программирование, летние смены ${SEASON_YEAR} года.`}
  h1="Каникулы детей: Minecraft (майнкрафт) в Подмосковье"
  canonical="https://aidacamp.ru/minecraft-lager"
>
  <Fragment slot="head">
    <CourseSchema
      slot="head"
      name="Minecraft Education для детей"
      description="Летний лагерь Minecraft Education: дети создают собственные миры, пишут моды и учатся программировать в игровой среде за 7 или 14 дней."
      url="https://aidacamp.ru/minecraft-lager"
      level="Beginner"
      ageMin={7}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Каникулы детей: лагерь Minecraft (майнкрафт) в Подмосковье"
    subtitle="Дети создают собственные миры и моды в Minecraft Education — и параллельно учатся программировать."
    breadcrumb="Лагерь Майнкрафт"
    keywords={["Minecraft Education — официальная образовательная версия", "Создание миров, модов и мини-игр с нуля", "7–15 лет, загородное проживание"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Дети на занятии Minecraft в АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Чем лагерь Майнкрафт отличается от обычного?", a: "Дети не просто играют, а создают: пишут моды, строят по заданиям, программируют редстоун. Используем Minecraft Education Edition — версию для обучения." },
    { q: "Нужно ли уметь играть в Minecraft до лагеря?", a: "Нет. Есть группы для новичков и для опытных игроков — сразу переходят к моддингу в майнкрафт." },
    { q: "Чему научатся дети в Minecraft-лагере?", a: "Пространственному мышлению, логике, основам программирования и командной работе." },
    { q: "С какого возраста подходит лагерь Minecraft?", a: "С 7 лет. Принимаем детей 7–14 лет: младшим — первый шаг в IT, старшим — Java-моддинг." }
  ]} items={['payment:1']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedArticles articles={[
    { title: "Minecraft для детей — польза, вред и как начать", url: "/stati/minecraft-dlya-detej/", description: "Что развивает игра и какие есть риски.", icon: "file-earmark-text" },
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej/", description: "Minecraft учит 3D-мышлению — куда расти дальше.", icon: "box" },
    { title: "Социализация ребёнка в лагере — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere/", description: "Командная работа в Minecraft сближает детей.", icon: "people" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Minecraft → Roblox Studio → Python.", icon: "braces" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
