---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Чем лагерь Майнкрафт отличается от домашней игры",
    text: "В АйДаКемп Minecraft — это не просто игра, а инструмент обучения. Дети работают с Minecraft Education Edition: создают архитектурные проекты, программируют поведение персонажей, строят механизмы с редстоуном. Каждый ребёнок уезжает с собственным миром, который можно запустить дома."
  },
  {
    h2: "Программа Minecraft в лагере",
    text: "",
    list: [
      "Строительство и архитектура — от хижины до города",
      "Редстоун — схемы, механизмы, логика",
      "Создание модов — введение в программирование через игру",
      "Командная работа — совместные проекты и презентации"
    ]
  },
  {
    h2: "Возраст и группы",
    text: "Minecraft подходит детям 7–12 лет. Младшие (7–9) занимаются в Scratch и Minecraft параллельно — это идеальный старт для тех, кто ещё не готов к тексту кода. Старшие (10–12) переходят к программированию модов на Python."
  }
];

---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Детский лагерь Майнкрафт 2026 — с проживанием в Подмосковье | от 48 000 ₽"
  description="Летний лагерь Minecraft Education в Подмосковье для детей 7–15 лет. Свои миры, моды и мини-игры, программирование в игре. Смены июнь–август 2026 от 48 000 ₽. ★ 5.0 на Яндекс Картах."
  h1="Детский лагерь Майнкрафт в Подмосковье"
  canonical="https://aidacamp.ru/minecraft-lager"
>
  <LandingHero slot="hero"
    h1="Детский лагерь Майнкрафт в Подмосковье"
    subtitle="Дети создают собственные миры и моды в Minecraft Education — и параллельно учатся программировать."
    breadcrumb="Лагерь Майнкрафт"
    keywords={["Minecraft Education — официальная образовательная версия", "Создание миров, модов и мини-игр с нуля", "7–15 лет, загородный лагерь с проживанием"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Детский лагерь Майнкрафт в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
