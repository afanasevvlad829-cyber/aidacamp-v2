---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Чем лагерь Майнкрафт отличается от домашней игры",
    text: "В АйДаКемп Minecraft — это не просто игра, а инструмент обучения. Ребята работают с Minecraft Education Edition: создают архитектурные проекты, программируют поведение персонажей, строят механизмы с редстоуном. Каждый уезжает с собственным миром, который можно запустить дома. АйДаКемп — <a href='/it-camp' class='text-[#ec7c00] hover:underline'>IT-лагерь</a> в Подмосковье, где Minecraft — это программирование через любимую игру. Одна из программ нашего <a href='/kompyuternyy-lager' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a>."
  },
  {
    h2: "Minecraft Education Edition — чем он отличается от обычного",
    text: "В лагере используется Minecraft Education Edition — специальная версия для обучения, которая недоступна для обычной покупки. Вот чем она отличается:",
    list: [
      "Classroom Mode — педагог видит всех участников на карте, может телепортировать, давать ресурсы, останавливать игру для объяснений",
      "Встроенная среда программирования — MakeCode прямо внутри игры: пишем блочный код или JavaScript, робот-агент выполняет команды",
      "Готовые обучающие карты по физике, химии, истории — используем как основу для заданий",
      "Java Edition моддинг (для продвинутых 11–14 лет): пишем настоящий Java/Python код, создаём собственные предметы и существа"
    ]
  },
  {
    h2: "Программа Minecraft в лагере",
    text: "Программа строится по уровням. Новички начинают с основ, продвинутые сразу берутся за создание модов.",
    list: [
      "Строительство и архитектура — от хижины до города, работа с материалами и биомами",
      "Редстоун — схемы, логические ворота, механизмы, автоматизированные фермы",
      "Кастомные биомы и мини-игры — создание уникальных миров по собственным правилам",
      "Java-моддинг (старшая группа) — добавление предметов, блоков, мобов через код",
      "Командная работа — совместные проекты, презентации, защита мира на хакатоне"
    ]
  },
  {
    h2: "Что создадут за смену Minecraft",
    text: "Финал каждой смены — «Экспо миров»: каждый показывает свой мир и объясняет что построил и как это работает. Примеры проектов прошлых смен:",
    list: [
      "Редстоун-компьютер — сложная схема из логических элементов, которая решает простые задачи",
      "Мини-игра «Выживание» — кастомная карта с правилами, ловушками и финальным боссом",
      "Средневековый город с автоматикой — дома с освещением, ворота с кнопками, фермы с таймерами",
      "Кастомный биом «Кристальная пещера» — уникальные блоки, генерация, атмосфера",
      "Java-мод «Дракон-компаньон» (старшая группа) — новое существо с поведением, анимацией и командами"
    ]
  },
  {
    h2: "Возраст и группы",
    text: "Minecraft в АйДаКемп разделён на два трека — для разного возраста и уровня подготовки:",
    list: [
      "7–10 лет (основы редстоуна): изучают игровой мир, строительство, логические механизмы из редстоуна. Идеальный первый шаг — после этой смены понятны концепции логики и автоматизации",
      "11–14 лет (Java-моддинг): пишут настоящий код на Java или Python через MakeCode API. Создают предметы, мобов, игровые механики. Отличный переход к программированию"
    ]
  },
  {
    h2: "Июль — последние места",
    text: "Minecraft-трек — один из самых популярных у школьников 7–10 лет. Июльские смены традиционно бронируются весной. Если планируете июль — записывайтесь сейчас."
  }
];

---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Лагерь Minecraft для детей в Подмосковье 2026 — АйДаКемп"
  description="Лагерь Minecraft Education в Подмосковье. Дети создают моды и карты на Python. Смены 2026 с июня, 66 км от МКАД, бассейн. От 48 000 ₽."
  h1="Детский лагерь Майнкрафт в Подмосковье"
  canonical="https://aidacamp.ru/minecraft-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем отличается лагерь Minecraft от обычного лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "В лагере Minecraft дети не просто играют, а создают: пишут моды, строят по заданиям, программируют редстоун-механику. АйДаКемп использует Minecraft Education Edition — версию для обучения с расширенными возможностями." }
        },
        {
          "@type": "Question",
          "name": "Нужно ли уметь играть в Minecraft до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Есть группы для новичков — начинают с основ управления и строительства. И группы для опытных игроков — переходят сразу к написанию модов и программированию." }
        },
        {
          "@type": "Question",
          "name": "Чему научатся дети в Minecraft-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Пространственное мышление, логика, основы программирования через моды, командная работа при строительстве. Дети, прошедшие Minecraft-трек, легче переходят к Python и 3D-моделированию." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста подходит лагерь Minecraft?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Принимаем детей 7–14 лет. Для детей 7–9 лет Minecraft — первый шаг к программированию. Для 10–14 — можно сочетать с Python-треком или Roblox Studio." }
        }
      ]
    })} />
    <CourseSchema
      slot="head"
      name="Лагерь Minecraft Education для детей"
      description="Летний лагерь Minecraft Education: дети создают собственные миры, пишут моды и учатся программировать в игровой среде за 7 или 14 дней."
      url="https://aidacamp.ru/minecraft-lager"
      level="Beginner"
      ageMin={7}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь Майнкрафт в Подмосковье"
    subtitle="Дети создают собственные миры и моды в Minecraft Education — и параллельно учатся программировать."
    breadcrumb="Лагерь Майнкрафт"
    keywords={["Minecraft Education — официальная образовательная версия", "Создание миров, модов и мини-игр с нуля", "7–15 лет, загородный лагерь с проживанием"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Детский лагерь Майнкрафт в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej", description: "Minecraft учит 3D-мышлению — как развить это дальше.", icon: "box" },
    { title: "Социализация ребёнка в лагере — что происходит за 2 недели", url: "/stati/socializaciya-rebenka-v-lagere", description: "Командная работа в Minecraft — мощный инструмент сближения.", icon: "people" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Minecraft → Roblox Studio → Python: логичный путь.", icon: "braces" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
