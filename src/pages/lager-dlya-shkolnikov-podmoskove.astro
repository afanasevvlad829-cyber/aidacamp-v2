---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Чем отличается от обычного летнего лагеря",
    text: "В обычных лагерях дети отдыхают — вечером возвращаются к планшетам и мессенджерам. АйДаКемп устроен иначе: каждый школьник получает IT-проект и защищает его на финальном хакатоне. Родители из Подмосковья везут ребёнка и знают: через 10–14 дней привезут обратно с работающим ботом или игрой, которую можно показать классу."
  },
  {
    h2: "Программа по классам: 1–4, 5–7, 8–9",
    text: "Группы формируются строго по возрасту и уровню — чтобы каждый двигался с комфортной скоростью, а не скучал или не успевал.",
    list: [
      "1–4 класс (7–10 лет) — Scratch, Minecraft Education, логика и алгоритмы. Первый код без стресса",
      "5–7 класс (10–13 лет) — Python с нуля, Telegram-боты, основы веб-разработки",
      "8–9 класс (13–16 лет) — Python Advanced, работа с AI, ChatGPT API, реальные данные"
    ]
  },
  {
    h2: "Условия проживания и что включено",
    text: "Лагерь расположен в 66 км от МКАД в Наро-Фоминском районе. Дети живут в корпусах по 3–4 человека. Бассейн с ионизированной водой — ежедневно. Пятиразовое питание. Медработник 24/7 на территории. Смартфоны сдают при заезде — вожатые связываются с родителями ежедневно через лагерный чат."
  },
  {
    h2: "Документы и безопасность",
    text: `АйДаКемп работает официально: лицензия Минобрнауки на образовательную деятельность, лицензия на оздоровительный лагерь на каждого ребёнка. Для поступления нужны справка 079/У (от педиатра) и копия полиса ОМС. Помогаем с оформлением налогового вычета до ${VYCHET_MAX} — документы выдаём автоматически.`,
    list: [
      "Лицензия Минобрнауки — проверяется в реестре",
      "Застрахована ответственность туроператора (Росгосстрах)",
      `Налоговый вычет — до ${VYCHET_MAX} — документы при выезде`,
      "Справка 079/У + ОМС — полный список на сайте"
    ]
  },
  {
    h2: "Смены 2026 для школьников Подмосковья",
    text: "Смены проходят с июня по август. Из Подмосковья добираются самостоятельно или трансфером от м. Солнцево. Рекомендуемые смены для первого раза — 7–10 дней.",
    list: [
      `Смена 2.1: ${DATES_SHORT_S21}, 7 дней — ${PRICE_MIN}`,
      `Смена 2: ${DATES_SHORT_S2}, 14 дней — ${PRICE_MAX}`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`
    ]
  },
  {
    h2: "Школьники из Подмосковья: как организовать поездку",
    text: "Добраться до лагеря из любого города Подмосковья удобнее всего через трансфер от м. Солнцево — туда ходят электрички МЦД из большинства направлений. Если едете на машине — прямой маршрут по Киевскому шоссе.",
    list: [
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону. На МЦД-4 или Киевском направлении до Солнцево из Одинцово, Апрелевки, Наро-Фоминска",
      "Самостоятельный заезд на машине — Киевское шоссе М-3, координаты 55.265643, 36.724185",
      "Из Подольска — 40–50 мин по трассе А101 → М-3",
      "Из Одинцово — 25–35 мин по М-1 → М-3, короткий маршрут без пробок",
      "Из Балашихи / Домодедово — через МКАД: 60–90 мин, трансфер через Солнцево удобнее"
    ]
  },
  {
    h2: "Вожатые и команда",
    text: "Каждый педагог ведёт группу из 6–8 школьников — не «зала», а класс в правильном смысле. Вожатые отбираются конкурсно, проходят обязательное обучение до начала лагерного сезона.",
    list: [
      "1 педагог на 6–8 школьников — реальное внимание к каждому",
      "Конкурсный отбор — только те, кто умеет работать с подростками и знает IT",
      "Медработник на территории 24/7 — любая ситуация с самочувствием закрыта",
      "Ежедневные фото в Telegram в 21:00 — мама видит как прошёл день"
    ]
  },
  {
    h2: "Актуальность мест — июнь и август 2026",
    text: `Июль 2026 полностью занят, запись закрыта. Июнь и август — места ещё есть, но немного. Школьникам из Подмосковья удобны обе августовские смены: ${DATES_SHORT_S3} (13 дней) и ${DATES_SHORT_S4} (10 дней). Оставьте заявку — ответим за 10 минут и уточним наличие.`
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Лагерь для школьников Подмосковья 2026 | АйДаКемп"
  description={`Летний IT-лагерь для школьников 7–15 лет из Подмосковья. Python, AI, Minecraft — проект за смену. Бассейн, питание, трансфер. От ${PRICE_MIN}.`}
  h1="Летний лагерь для школьников в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-dlya-shkolnikov-podmoskove"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Для каких классов подходит лагерь для школьников Подмосковья?", a: "АйДаКемп принимает школьников 1–9 класса (7–16 лет). Группы формируются по возрасту и уровню: 1–4 класс — Scratch и Minecraft, 5–7 класс — Python и боты, 8–9 класс — Python Advanced и AI." },
    { q: "Как добраться до лагеря из Подмосковья?", a: "Лагерь расположен в Наро-Фоминском районе, 66 км от МКАД. Из Подмосковья можно добраться самостоятельно или воспользоваться организованным трансфером от м. Солнцево — это удобно для семей из Одинцово, Подольска, Балашихи и других городов Подмосковья." },
    { q: "Нужно ли уметь программировать до лагеря?", a: "Нет. Большинство детей приезжают с нулевым опытом. Группы начинающих стартуют с самого начала — уже на 3-й день виден результат. К концу смены каждый школьник защищает собственный проект." },
    { q: "Какие документы нужны для школьника в лагерь?", a: "Справка по форме 079/У от педиатра (не ранее чем за 3 дня до заезда), копия полиса ОМС, копия свидетельства о рождении или паспорта. Полный список документов отправляем после оформления путёвки." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для школьников в Подмосковье — АйДаКемп"
    subtitle="Для школьников 7–15 лет. IT-проект за смену, бассейн, природа — и никаких телефонов."
    breadcrumb="Лагерь для школьников Подмосковья"
    keywords={[`Для школьников 1–9 класса, группы по возрасту`, "IT-проект за смену: Python, AI, Minecraft", `Подмосковье, ${STAT_DISTANCE} от Москвы, смены июнь–август`]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Летний лагерь для школьников Подмосковья"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
