---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Team from '../components/Team.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const relatedPages = getRelatedPages('/komanda');
---

<Base
  title="Команда и менторы АйДаКемп — преподаватели детского IT-лагеря"
  description="Кто учит и сопровождает детей в АйДаКемп: преподаватели Python, Scratch, Minecraft и AI, руководитель смены, менторы из ВТБ, МТС Ventures и Shell."
>
  <Header />
  <main>
    <section class="mx-auto max-w-[900px] px-4 pt-10 pb-4 md:pt-14">
      <nav class="text-base text-slate-400 mb-4">
        <a href="/" class="hover:text-orange-600 transition-colors">Главная</a>
        <span class="mx-2">&rarr;</span>
        <span class="text-slate-600">Команда</span>
      </nav>
      <h1 class="text-[28px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">Команда и менторы</h1>
      <p class="mt-2 text-[16px] leading-[1.6] text-slate-500 max-w-[560px]">
        Преподаватели, которые ведут занятия каждый день, и менторы из реального IT, которые помогают держать программу актуальной.
      </p>
    </section>

    <Team />
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
