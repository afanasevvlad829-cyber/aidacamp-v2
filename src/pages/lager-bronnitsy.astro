---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Бронниц до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе Московской области. Из Бронниц ехать около 1.5 часа: по Новорязанскому шоссе до МКАД, затем по МКАД на запад и далее по Киевскому шоссе (M-3) до посёлка Атепцево. Расстояние около 100 км. Удобный вариант — добраться до м. Солнцево (электричка до Казанского вокзала, затем метро) и сесть на организованный трансфер АйДаКемп."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Бронницами",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Бронниц выбирают АйДаКемп",
    text: "До лагеря из Бронниц — около 1.5 часа. Это не так далеко, как кажется — и вот почему родители возвращаются:",
    list: [
      "Подмосковье — привычный климат, акклиматизации нет, ребёнок в ритме с первого дня",
      "Новорязанское шоссе → МКАД → Киевское — маршрут прямой, без пробок в область",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ отзывов от подмосковных семей"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 000 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Бронниц и Раменского района",
    text: "В АйДаКемп едут дети из Бронниц, Раменского, Жуковского и других городов юго-востока Подмосковья:",
    list: [
      "«Поехали из Бронниц по Новорязанскому — часа полтора без пробок. Дочь вернулась с ботом в Telegram, который сделала сама. Рассказывала всем подругам» — Наталья, Бронницы",
      "«Сын после лагеря сам сел учить Python по вечерам. Раньше я не могла его оторвать от игр» — Ирина, Жуковский"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь рядом с Бронницами 2026 — IT | АйДаКемп"
  description="Детский IT-лагерь рядом с Бронницами — ~1.5 ч через Новорязанское шоссе → МКАД → Киевское. Python, AI, Minecraft. От 48 000 ₽."
  h1="Детский лагерь рядом с Бронницами"
  canonical="https://aidacamp.ru/lager-bronnitsy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Бронниц до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Бронниц до лагеря около 100 км и ~1.5 часа езды: по Новорязанскому шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или добраться до м. Солнцево и сесть на организованный трансфер АйДаКемп (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Бронниц?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Бронниц нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Бронниц удобно добраться электричкой до Казанского вокзала, затем на метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для поступления в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Бронниц?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Бронницами — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Бронниц. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-bronnitsy"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Бронницами"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Бронниц через Новорязанское шоссе → МКАД → Киевское. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Бронниц"
    keywords={["~1.5 ч из Бронниц через МКАД → Киевское шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Бронницами — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
