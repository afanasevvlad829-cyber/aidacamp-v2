---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import Shifts from '../components/Shifts.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const articles = [
  {
    title: "Зависимость от компьютерных игр",
    url: "/stati/zavisimost-ot-kompyuternyh-igr/",
    desc: "Как отличить увлечение от зависимости: 5 признаков + 4 шага которые реально возвращают ребёнка в жизнь.",
    icon: "controller",
    time: "7 мин",
  },
  {
    title: "Зависимость от телефона у подростков",
    url: "/stati/zavisimost-ot-telefona-u-podrostkov/",
    desc: "Почему подросток не выпускает телефон из рук — и что реально работает вместо запретов.",
    icon: "phone",
    time: "6 мин",
  },
  {
    title: "Признаки компьютерной зависимости",
    url: "/stati/priznaki-kompyuternoj-zavisimosti/",
    desc: "6 конкретных признаков — когда это уже не увлечение. Чек-лист для родителей.",
    icon: "search",
    time: "5 мин",
  },
  {
    title: "Игромания у детей",
    url: "/stati/igromaniya-u-detej/",
    desc: "Официальный диагноз ВОЗ (МКБ-11), стадии развития зависимости и группы риска.",
    icon: "bar-chart-fill",
    time: "6 мин",
  },
  {
    title: "Экранное время детей: норма",
    url: "/stati/ekrannoe-vremya-detej-norma/",
    desc: "Сколько часов в день — уже много? Рекомендации ВОЗ и педиатров по возрастам.",
    icon: "clock",
    time: "5 мин",
  },
  {
    title: "Как избавиться от игровой зависимости",
    url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr/",
    desc: "5-шаговый план без запретов и скандалов. Что делать прямо сейчас.",
    icon: "arrow-repeat",
    time: "8 мин",
  },
  {
    title: "Лечение компьютерной зависимости",
    url: "/stati/lechenie-kompyuternoj-zavisimosti/",
    desc: "Без клиники и без таблеток — что реально работает. Методы с доказательной базой.",
    icon: "heart-pulse-fill",
    time: "7 мин",
  },
  {
    title: "Профилактика компьютерной зависимости",
    url: "/stati/profilaktika-kompyuternoj-zavisimosti/",
    desc: "7 правил здоровой семьи. Как предотвратить зависимость, пока её ещё нет.",
    icon: "shield-check",
    time: "6 мин",
  },
];
---

<LandingLayout
  title="Зависимость детей от гаджетов: как отучить от телефона — гид для родителей | АйДаКемп"
  description="Как отучить ребёнка от телефона: 8 статей о гаджет-зависимости — признаки, лечение, профилактика, нормы экранного времени. Практические советы без запретов и скандалов."
  h1="Зависимость от гаджетов у детей: как отучить от телефона — полный гид для родителей"
  canonical="https://aidacamp.ru/zavisimost-ot-gadzetov/"
  heroImage="/images/hero/lager-bez-telefonov.avif"
  breadcrumbLabel="Зависимость от гаджетов"
>
  <Fragment slot="head">
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Зависимость от гаджетов у детей — статьи",
      "description": "Полный гид по детской гаджет-зависимости для родителей",
      "numberOfItems": articles.length,
      "itemListElement": articles.map((a, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": a.title,
        "url": `https://aidacamp.ru${a.url}`
      }))
    })} />
  </Fragment>

  <LandingHero slot="hero"
    h1="Зависимость от гаджетов у детей: как отучить от телефона — полный гид для родителей"
    subtitle="8 статей с признаками, методами лечения и профилактикой. Без запретов и скандалов — с опорой на исследования. Здесь собрана конкретная помощь для мамы, которая не знает, с чего начать — без нотаций, с опорой на то, что реально работает."
    breadcrumb="Зависимость от гаджетов"
    keywords={["Признаки, стадии и группы риска — что это уже зависимость", "Методы дома и без клиники: что реально работает в семье", "Как IT-лагерь помогает переключить интерес с экрана на создание"]}
    image="/images/hero/lager-bez-telefonov.avif"
    imageAlt="Зависимость от гаджетов у детей — АйДаКемп"
  />

  <!-- Ориентация: с чего начать -->
  <section class="mx-auto max-w-[860px] px-4 pt-10">
    <p class="text-[17px] leading-[1.75] text-slate-700 mb-4">
      Если вы попали сюда, набрав в поиске что-то вроде «сын не выпускает телефон из рук» —
      скорее всего, вы уже перепробовали и просьбы, и таймеры, и «выключаю роутер в десять».
      И, скорее всего, ничего из этого надолго не сработало. Это не потому что вы делаете
      что-то не так. Экраны спроектированы так, чтобы удерживать внимание — соревноваться
      с ними силой воли ребёнка, а тем более родителя, изначально невыгодная позиция.
    </p>
    <p class="text-[17px] leading-[1.75] text-slate-700 mb-4">
      Ниже — восемь разборов: от «как вообще понять, зависимость это или обычное подростковое
      увлечение» до конкретных методов и профилактики. Читать подряд не обязательно. Быстрый
      ориентир, с чего начать именно вам:
    </p>
    <div class="flex flex-col gap-3 mb-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold text-slate-900 mb-1">Не знаете, зависимость ли это вообще</p>
        <p class="text-[15px] leading-[1.6] text-slate-600">Начните с признаков и стадий. Чаще всего оказывается, что до «зависимости» по-настоящему далеко — и тогда хватает договорённостей, а не тревоги.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold text-slate-900 mb-1">Уверены, что проблема есть, и хотите действовать</p>
        <p class="text-[15px] leading-[1.6] text-slate-600">Идите к пошаговому плану без запретов и к разбору методов, которые работают дома, без клиники и таблеток.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="font-semibold text-slate-900 mb-1">Пока всё нормально, но хочется не доводить</p>
        <p class="text-[15px] leading-[1.6] text-slate-600">Смотрите нормы экранного времени по возрастам и правила профилактики — предупредить дешевле, чем откатывать.</p>
      </div>
    </div>
  </section>

  <!-- Три вещи, которые не работают -->
  <section class="mx-auto max-w-[860px] px-4 pb-4">
    <h2 class="text-[22px] md:text-[26px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900 mb-4">
      Три подхода, которые почти всегда дают обратный эффект
    </h2>
    <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
      Прежде чем разбирать, что делать, — про то, чего лучше не делать. Именно эти три хода
      родители пробуют первыми, и именно они чаще всего заканчиваются скандалом и закрытой
      дверью в комнату.
    </p>
    <ul class="flex flex-col gap-4">
      <li class="flex items-start gap-3">
        <i class="bi bi-x-circle-fill text-red-400 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
        <span class="text-[16px] leading-[1.7] text-slate-700"><strong>Резкий тотальный запрет.</strong> «С сегодняшнего дня — никакого телефона» убирает не тягу, а доверие. Ребёнок не перестаёт хотеть — он перестаёт рассказывать и учится обходить. Работает постепенное сокращение по общим правилам, а не разовый обрыв.</span>
      </li>
      <li class="flex items-start gap-3">
        <i class="bi bi-x-circle-fill text-red-400 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
        <span class="text-[16px] leading-[1.7] text-slate-700"><strong>Отнять, ничего не предложив взамен.</strong> Экран закрывает скуку, общение и ощущение успеха. Если просто убрать его, освободившееся время нечем занять — и рука сама тянется обратно. Сначала альтернатива, потом ограничение, а не наоборот.</span>
      </li>
      <li class="flex items-start gap-3">
        <i class="bi bi-x-circle-fill text-red-400 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
        <span class="text-[16px] leading-[1.7] text-slate-700"><strong>Обесценивать то, что ему важно.</strong> «Ерунда, тупая игра, только время тратишь» — и разговор окончен. В игре у него получается, там его уважают сверстники. Пока это не признано, договориться не о чем.</span>
      </li>
    </ul>
    <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
      Общий знаменатель у всех трёх — давление вместо замены. Экран проигрывает не запрету,
      а живому интересу, который оказался сильнее. Именно поэтому смена среды на одну-две
      недели часто сдвигает то, что дома буксовало месяцами: когда рядом двадцать сверстников
      заняты общим делом, телефон впервые становится не самым интересным, что происходит вокруг.
    </p>
  </section>

  <!-- Быстрый чек -->
  <section class="mx-auto max-w-[860px] px-4 py-6">
    <h2 class="text-[22px] md:text-[26px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900 mb-4">
      Увлечение или уже зависимость: короткий чек
    </h2>
    <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
      Полный разбор со стадиями — в статьях ниже, но для первого ориентира достаточно
      посмотреть на два признака. Дело не в количестве часов как таковом, а в том, что
      происходит вокруг этих часов.
    </p>
    <div class="grid sm:grid-cols-2 gap-4 mb-5">
      <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-emerald-700 mb-2">Скорее увлечение</p>
        <ul class="flex flex-col gap-2 text-[15px] leading-[1.55] text-slate-700">
          <li>Легко отрывается по просьбе, без скандала</li>
          <li>Есть другие интересы — спорт, друзья офлайн, что-то руками</li>
          <li>Спит, ест и учится примерно как обычно</li>
          <li>Спокойно рассказывает, во что играет и с кем</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-red-600 mb-2">Повод насторожиться</p>
        <ul class="flex flex-col gap-2 text-[15px] leading-[1.55] text-slate-700">
          <li>Любое ограничение — истерика или агрессия</li>
          <li>Другие занятия отпали, осталась только игра</li>
          <li>Врёт о времени, играет ночью тайком</li>
          <li>Пострадали учёба, сон или отношения в семье</li>
        </ul>
      </div>
    </div>
    <p class="text-[16px] leading-[1.7] text-slate-600">
      Если почти всё в левой колонке — выдыхайте, это нормальный подросток с нормальным хобби,
      и жёсткие меры тут только навредят. Если узнаёте правую — это ещё не приговор и не
      обязательно клинический диагноз, но сигнал, что пора действовать системно: договор о
      времени, живая альтернатива и, если конфликты стали ежедневными, разговор со специалистом.
      Как именно выстроить каждый из этих шагов — в разборах ниже.
    </p>
    <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
      И ещё одно, что важно снять с себя сразу: если правая колонка про вашего — это не значит,
      что вы что-то упустили как родитель. Тяга к экрану устроена так же, как тяга к сладкому:
      она есть у всех, просто у кого-то среда сложилась так, что удержаться труднее. Вопрос не
      в вине, а в том, что делать дальше — а на это ответ есть, и он не про запреты.
    </p>
  </section>

  <!-- Статьи кластера -->
  <section class="mx-auto max-w-[1312px] px-4 py-10">
    <div class="mb-8 flex items-center gap-2">
      <div class="w-1 h-6 rounded-full bg-primary shrink-0"></div>
      <h2 class="text-[22px] md:text-[28px] font-bold leading-[1.1] tracking-[-0.02em] text-slate-900">
        Статьи по теме
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {articles.map((a) => (
        <a href={a.url} class="group flex flex-col rounded-[16px] border border-slate-200 bg-white p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)] transition hover:border-orange-300 hover:shadow-[0_4px_16px_rgba(0,0,0,0.1)]">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-[10px] bg-orange-50 text-orange-600">
            <i class={`bi bi-${a.icon} text-[18px]`} aria-hidden="true"></i>
          </div>
          <p class="mb-1 text-[12px] font-semibold uppercase tracking-[0.1em] text-slate-400">{a.time} чтения</p>
          <h3 class="mb-2 text-base font-bold leading-[1.3] text-slate-900 group-hover:text-primary transition">{a.title}</h3>
          <p class="mt-auto text-base leading-[1.6] text-slate-500">{a.desc}</p>
        </a>
      ))}
    </div>

    <!-- CTA к лагерю -->
    <div class="mt-10 rounded-[20px] bg-gradient-to-r from-orange-50 to-amber-50 border border-orange-100 p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center md:gap-8">
        <div class="flex-1 mb-4 md:mb-0">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-orange-600 mb-2">Практическое решение</p>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] text-slate-900 mb-2">
            Лагерь без телефонов — смена среды, которая работает
          </h2>
          <p class="text-base leading-[1.6] text-slate-600">
            В АйДаКемп ребята не «запрещают» экраны — они заменяют бесконтрольный скроллинг на создание собственного IT-проекта. 60% приходят из геймеров и уходят с готовым ботом или игрой.
          </p>
        </div>
        <div class="flex flex-col gap-2 shrink-0">
          <a href="/lager-bez-telefonov/" class="inline-flex items-center justify-center gap-2 rounded-[12px] bg-primary px-6 py-3 text-base font-bold text-white hover:bg-orange-600 transition">
            <i class="bi bi-phone-x" aria-hidden="true"></i>
            Лагерь без телефонов
          </a>
          <a href="/zapisatsya/" class="inline-flex items-center justify-center gap-2 rounded-[12px] border border-slate-200 bg-white px-6 py-3 text-base font-semibold text-slate-700 hover:border-orange-300 transition">
            Подобрать смену
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Частые вопросы -->
  <section class="mx-auto max-w-[860px] px-4 py-8">
    <h2 class="text-[22px] md:text-[26px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900 mb-6">
      Что чаще всего спрашивают родители
    </h2>
    <div class="flex flex-col gap-6">
      <div>
        <p class="text-[17px] font-semibold text-slate-900 mb-2">Сколько часов в день — это уже много?</p>
        <p class="text-[16px] leading-[1.7] text-slate-600">Универсального числа нет: два часа за учёбой и два часа в бесконечной ленте — это разные два часа. Смотреть стоит не на счётчик, а на то, вытесняет ли экран сон, движение и живое общение. Ориентиры по возрастам — в отдельном разборе про нормы экранного времени.</p>
      </div>
      <div>
        <p class="text-[17px] font-semibold text-slate-900 mb-2">Это точно пройдёт с возрастом само?</p>
        <p class="text-[16px] leading-[1.7] text-slate-600">Иногда да — как и любое подростковое увлечение. Но если игра уже вытеснила всё остальное и любое ограничение вызывает срыв, «само» может затянуться на годы, а привычка закрепится. Здесь лучше не ждать, а мягко помогать.</p>
      </div>
      <div>
        <p class="text-[17px] font-semibold text-slate-900 mb-2">Помогает ли «цифровой детокс» в лагере?</p>
        <p class="text-[16px] leading-[1.7] text-slate-600">Помогает не сам факт изъятия телефона, а то, чем заполнена освободившаяся неделя. В АйДаКемп это не «отобрали и терпи», а замена скроллинга на собственный проект, спорт и живой отряд. Первые день-два бывает ломка, дальше про телефон обычно забывают.</p>
      </div>
      <div>
        <p class="text-[17px] font-semibold text-slate-900 mb-2">А после лагеря всё не откатится назад?</p>
        <p class="text-[16px] leading-[1.7] text-slate-600">Откатится, если дома ничего не менять. Смена среды даёт паузу и показывает, что без экрана жизнь есть, — но закрепляют результат домашние правила, о которых договариваются на спокойную голову. Обычно возвращаются не к прежним привычкам, а к прежней обстановке: те же вечера, тот же диван, тот же телефон под рукой. Поэтому первые дни после лагеря — момент, когда стоит вместе с ребёнком договориться о новом распорядке, пока свежо ощущение, что можно иначе. Подробно про это — в разборе про возвращение и новые правила.</p>
      </div>
    </div>
  </section>

  <Shifts />

  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее: <a href="/stati/zavisimost-u-detej/" class="text-primary hover:underline">все статьи о зависимостях</a> — <a href="/lager-bez-telefonov/" class="text-primary hover:underline">лагерь без телефонов</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
