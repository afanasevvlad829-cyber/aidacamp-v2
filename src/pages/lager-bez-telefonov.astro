---
import { DAYS_S3, DAYS_S4, PRICE_MIN, SEASON_YEAR, daysNum } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_LICENSE } from '../data/contacts';

const sections = [
  {
    h2: "Что такое лагерь без телефонов АйДаКемп?",
    text: `АйДаКемп — загородный центр в Подмосковье, 66 км от Москвы, где экранное время не запрещают, а заменяют осознанной системой: внутренней валютой, IT-занятиями и живым общением. Принимаем ребят 7–15 лет. Смены ${daysNum(DAYS_S4)} и ${DAYS_S3}, август, от ${PRICE_MIN}. Лицензия Минобрнауки ${STAT_LICENSE}. Дети проводят за компьютером несколько часов в день — но это учёба и работа над проектом по расписанию, а не скроллинг.`
  },
  {
    h2: "Как это работает без гаджетов",
    text: "В первый день смены смартфоны сдаются на хранение. Вместо этого — внутренняя валюта (игровые рубли): её зарабатывают за участие в активностях, помощь другим, прогресс в IT-проекте. На накопленные рубли можно получить «телефонное время» — строго по правилам. Это не запрет, а осознанный выбор: ребята сами видят ценность времени.",
    list: [
      "Прогресс в IT-проекте — выполнил модуль, объяснил другому, получил обратную связь от преподавателя",
      "Участие в командных активностях: спорт, хакатон, помощь новенькому",
      "Накопленные рубли тратятся на телефонное время или другие привилегии по меню",
      "Ребёнок не «лишён» гаджета — он сам решает, стоит ли тратить рубли на экран или приберечь на что-то другое"
    ]
  },
  {
    h2: "Кому подходит формат без гаджетов?",
    text: "Формат особенно подходит для детей, которые «залипают» в экраны дома и теряют интерес к живому общению. Родители находят в АйДаКемп союзника: здесь правила одинаковы для всех.",
    list: [
      "Дети 7–15 лет с любым уровнем «телефонной зависимости»",
      "Те, кто хочет IT-проект, а не просто «выключить» ребёнка",
      "Семьи, которым важна безопасная цифровая среда",
      `Ближайшие летние смены — август ${SEASON_YEAR}`
    ]
  },
  {
    h2: "Чем наш формат без гаджетов отличается от простого запрета",
    text: "Многие места заявляют «без гаджетов» как силовой запрет: утром сдал устройство, вечером получил — а после возвращения дети набрасываются на экран с удвоенной жадностью. Наш формат другой: вместо «нельзя» — «это ресурс, у которого есть цена». Почему «сдать в бокс» — это не конфискация, разбираем в статье <a href=\"/stati/telefon-v-lagere/\" class=\"text-primary hover:underline\">берут ли гаджет у детей</a>.",
    list: [
      "Обычный формат «без гаджетов»: отнял → отдал обратно → рецидив",
      "Наш формат: валюта → купил время → ценит своё решение → переносит привычку домой",
      "Результат через 3 месяца: 73% родителей отмечают, что ребёнок спокойнее относится к ограничениям экранного времени"
    ]
  },
  {
    h2: "Как поддерживать связь с ребёнком: звонки и Telegram",
    text: "Самый частый вопрос от родителей — «как я буду знать, что всё хорошо?». Отвечаем:",
    list: [
      "Телефонное время — каждый вечер в 19:30: ребёнок может взять гаджет на свои игровые рубли, а может не брать",
      "Telegram-чат группы: вожатые публикуют фото каждый день. Отзывы родителей — 40+ историй на Яндекс.Картах",
      "Если что-то случилось или нужно поговорить с ребёнком — гаджет дают сразу и без вопросов"
    ]
  },
  {
    h2: "Что делать родителям после лагеря, чтобы эффект сохранился",
    text: "Самое частое разочарование родителей: «вернулся — и опять в гаджете» — это происходит, когда дома всё осталось по-прежнему. Чтобы эффект сохранился, нужно минимум 3 изменения дома:",
    list: [
      "Убрать гаджеты из детской спальни — зарядка на общей станции на кухне",
      "Ввести семейные часы без экрана — обед, прогулка, настолки раз в неделю",
      "Самому родителю соблюдать ограничения (дети копируют поведение, а не слова)"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-bez-telefonov.avif"
  title={`Детский лагерь без телефонов и без гаджетов в Подмосковье ${SEASON_YEAR}`}
  description="Детский лагерь без гаджетов и телефонов в Подмосковье. Экранное время зарабатывается — ребёнок учится ценить время. 66 км от МКАД."
  h1={`Детский лагерь без телефонов в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-bez-telefonov"
  breadcrumb="Лагерь без телефонов"
>
  <LandingHero slot="hero"
    h1={`Детский лагерь без телефонов в Подмосковье ${SEASON_YEAR}`}
    subtitle="Смартфоны сдаются в первый день. Вместо них — внутренняя валюта, IT-проекты и живое общение."
    breadcrumb="Лагерь без телефонов"
    keywords={["Смартфоны сдаются на хранение с первого дня смены", "Экранное время зарабатывается — за участие и помощь другим", "Данные августа 2026: телефонное время покупали 27 детей из 52"]}
    image="/images/hero/lager-bez-telefonov.avif"
    imageAlt="Лагерь без телефонов АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts slim />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
    { q: "Как работает лагерь без телефонов?", a: "Смартфоны сдаются в первый день на хранение вожатому. Вместо телефона — внутренняя валюта лагеря за участие, помощь другим и учёбу. Экранное время становится наградой, а не фоном." },
    { q: "Можно ли ребёнку позвонить родителям без телефона?", a: "Да. В 19:30 ребёнок может взять гаджет на свои рубли; если что-то случилось — устройство дают сразу и без вопросов. Родители могут связаться с вожатым в любое время, в Telegram-канале — ежедневные фото." },
    { q: "Дети скучают без телефона в лагере?", a: "Данные августа 2026 (52 ребёнка, не исследование): телефонное время покупали 27 из 52, медиана — час за смену. В лагере плотная программа: IT-занятия, бассейн, спорт, общение с новыми друзьями." },
    { q: "Для чего нужен лагерь без телефонов?", a: "Для перезагрузки. Без смартфона дети начинают живо общаться и замечать природу вокруг. По нашим наблюдениям, большинство перестают скучать по телефону за 2–3 дня." },
    { q: "Когда ребёнку отдавать телефон перед смены и забирать после?", a: "Телефон сдаётся вожатому в первый день смены при заезде, возвращается в последний день при отъезде. По согласованию могут выдавать вечером по расписанию." },
    { q: "Что если у ребёнка паника без телефона?", a: "Такие случаи бывали — обычно в первые 1–2 дня. Вожатые работают с такими детьми индивидуально. За 5 лет работы ни один ребёнок не уехал домой из-за телефонной тревоги." }
  ]} />
  <RelatedArticles articles={[
    { title: "Подросток в телефоне 24/7 — 5 способов без конфликта и конфискации", url: "/stati/zavisimost-ot-telefona-u-podrostkov/", description: "Почему отбирать гаджет не работает и что реально снижает экранное время.", icon: "phone" },
    { title: "Ребёнок не вылезает из игр — 4 шага без скандалов", url: "/stati/zavisimost-ot-kompyuternyh-igr/", description: "Практический план без запретов и конфликтов.", icon: "controller" },
    { title: "Детский отдых без гаджетов — что это и зачем", url: "/stati/detskiy-lager-bez-telefonov/", description: "Как работает формат с внутренней валютой вместо гаджетов.", icon: "phone-vibrate" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-base text-slate-500">
    Полезная статья: <a href="/stati/detskiy-lager-bez-telefonov/" class="text-primary hover:underline">подробнее о жизни без гаджетов</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
