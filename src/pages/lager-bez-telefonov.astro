---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что такое лагерь без телефонов АйДаКемп?",
    text: "АйДаКемп — загородный лагерь в Подмосковье, 66 км от Москвы, где экранное время не запрещают, а заменяют осознанной системой: внутренней валютой, IT-занятиями и живым общением. Принимаем ребят 7–15 лет. Смены 7–14 дней, июнь–август, от 48 000 ₽. Лицензия Минобрнауки Л035-01298-77/01082973."
  },
  {
    h2: "Как выглядит первый день без телефона: 48-часовая адаптация",
    text: "Самый сложный момент — не сдать телефон, а первые 48 часов после. Вот как это работает в АйДаКемп:",
    list: [
      "При заезде: смартфоны кладут в именной бокс с именем и датой. Ребёнок видит свой — это помогает, бокс не пропадёт",
      "Первые часы: вожатые плотно заняты с группой — знакомство, обустройство комнаты, первое общее занятие",
      "Вечер первого дня: ужин вместе, вечерняя активность — мозг переключается на живое",
      "День второй: утреннее занятие по IT, первый прогресс в проекте — появляется другой интерес",
      "К концу второго дня большинство уже не вспоминает о телефоне — поглощены командой и проектом"
    ]
  },
  {
    h2: "Как работает лагерь без телефонов",
    text: "В первый день смены все смартфоны сдаются на хранение. Вместо этого в лагере действует собственная внутренняя валюта (далее под рублями имеется в виду игровая валюта лагеря) — её зарабатывают за участие в активностях, помощь другим, прогресс в IT-проекте. На накопленные рубли можно получить «телефонное время» — строго по правилам. Это не запрет, а осознанный выбор: ребята сами видят ценность времени."
  },
  {
    h2: "Почему это работает — что происходит с детьми без телефона?",
    text: "Большинство родителей боятся, что ребёнок будет страдать без телефона. На практике происходит иначе: за первые 2–3 дня ребята полностью включаются в жизнь лагеря. Без телефона в кармане — больше живого общения, больше концентрации на проекте, больше командной работы. Многие сами говорят, что не скучали по смартфону.",
    list: [
      "День 1–2: непривычно, но ребята быстро адаптируются",
      "День 3–5: полное включение, лагерная жизнь захватывает",
      "Финал смены: большинство не хотят уезжать"
    ]
  },
  {
    h2: "Чем АйДаКемп отличается от обычного лагеря без гаджетов?",
    text: "Важный нюанс: в АйДаКемп дети проводят время за компьютером — но это учёба и работа над проектом, а не бесконтрольный скроллинг. IT-занятия проходят по расписанию, с преподавателем и конкретной целью. Ребята учатся использовать технологии осознанно — это и есть главный навык современности."
  },
  {
    h2: "Для кого подходит лагерь без телефонов?",
    text: "Лагерь без телефонов особенно подходит детям, которые «залипают» в экраны дома и теряют интерес к живому общению. Родители, которые сами устали от бесконечных переговоров про телефон, находят в АйДаКемп союзника: здесь правила одинаковы для всех, и ребята принимают их как данность, а не как личное ограничение.",
    list: [
      "Дети 7–15 лет с любым уровнем «телефонной зависимости»",
      "Те, кто хочет IT-проект, а не просто «выключить» ребёнка",
      "Семьи, которым важна безопасная цифровая среда"
    ]
  },
  {
    h2: "Чем лагерь без телефонов отличается от «лагеря с запретом»",
    text: "Многие лагеря заявляют «без гаджетов» и реализуют это как силовой запрет: утром сдал телефон, вечером получил. Это работает технически, но не меняет ничего в голове. После возвращения дети набрасываются на экран с удвоенной жадностью. Наш формат — принципиально другой. Вместо «нельзя» — «это ресурс, у которого есть цена». Ребята не бунтуют против правил, потому что правила встроены в экономику лагеря, а не наложены сверху.",
    list: [
      "Обычный формат «без гаджетов»: отнял → отдал обратно → рецидив",
      "Наш формат: валюта → купил время → ценит своё решение → переносит привычку домой",
      "Результат через 3 месяца: 73% родителей отмечают, что ребёнок спокойнее относится к ограничениям экранного времени"
    ]
  },
  {
    h2: "Что ребята говорят после смены — мнение самих ребят, не родителей",
    text: "Родители часто пишут отзывы — мы их ценим. Но есть и то, что ребята говорят сами, прямо перед отъездом или уже дома:",
    list: [
      "«Я вообще не думал о телефоне — некогда было, мы так много всего делали»",
      "«Я хочу домой показать маме что я сделал, это лучше чем видео в ютубе смотреть»",
      "«Первые два дня было странно, но потом вообще забыл что он есть»",
      "«Я познакомился с людьми, которых бы не встретил никогда — потому что мы все не в телефонах сидели»",
      "«Хочу вернуться в следующем году» — это говорят ребята сами, не мамы"
    ]
  },
  {
    h2: "Экранное время как награда: как работает игровая валюта",
    text: "Внутренняя игровая валюта лагеря — рубли (далее «рубли» — игровая валюта, не настоящие деньги, аналог Монополии). Заработать рубли можно за реальные действия:",
    list: [
      "Прогресс в IT-проекте — выполнил модуль, объяснил другому, получил обратную связь от преподавателя",
      "Участие в командных активностях: спорт, хакатон, помощь новенькому",
      "Утренняя зарядка, порядок в комнате — маленькие привычки тоже в системе",
      "Накопленные рубли тратятся на телефонное время или другие привилегии по меню",
      "Ребёнок не «лишён» телефона — он сам решает, стоит ли тратить рубли на экран или приберечь на что-то другое"
    ]
  },
  {
    h2: "Как поддерживать связь с ребёнком: звонки и Telegram",
    text: "Самый частый вопрос от родителей — «как я буду знать, что всё хорошо?». Отвечаем:",
    list: [
      "Видеозвонок каждый вечер в фиксированное время (обычно 20:30–21:00) — расписание присылаем при заезде",
      "Telegram-канал группы: вожатые публикуют фото и короткие видео каждый день",
      "При необходимости — вожатый всегда на связи, номер телефона есть у каждого родителя",
      "Смартфон ребёнку выдаётся по расписанию или по просьбе при объективной необходимости",
      "Ни один ребёнок за 6 лет работы не остался без связи с родителями когда это было важно"
    ]
  },
  {
    h2: "Что делать родителям после лагеря, чтобы эффект сохранился",
    text: "Самое частое разочарование родителей: «вернулся — и опять в телефоне». Это происходит, когда дома всё осталось по-прежнему. Ребята сбрасывают привычку в лагере, но старая среда возвращает её обратно за 3–5 дней. Чтобы эффект сохранился, нужно минимум 3 изменения дома:",
    list: [
      "Убрать гаджеты из детской спальни — зарядка на общей станции на кухне",
      "Ввести семейные часы без экрана — обед, прогулка, настолки раз в неделю",
      "Самому родителю соблюдать ограничения (дети копируют поведение, а не слова)",
      "Обсудить новые хобби, которые ребёнок «прихватил» из лагеря (код, спорт, творчество) — поддержать их",
      "Проверить через месяц — если привычки вернулись, запланировать следующую смену"
    ]
  },
  {
    h2: "Сколько длится эффект от одной смены без телефонов?",
    text: "По данным опросов родителей через 1 и 3 месяца после смены АйДаКемп — эффект держится у 70%+ участников, если после возвращения родители поддерживают новые правила. Первые 2 недели — инерция лагерной жизни, ребята сами предлагают настолки и прогулки. С 3-й недели всё зависит от семьи: если дома всё вернулось к прежнему укладу, привычки быстро возвращаются. Если же родители вводят 2–3 простых правила — эффект сохраняется на долгие месяцы. Наш совет — рассматривать лагерь не как разовое «лечение», а как точку перезагрузки, после которой семья меняет несколько своих привычек вместе."
  },
  {
    h2: "Режим с технологиями в АйДаКемп: не без телефона, а с умом",
    text: "АйДаКемп — это IT-лагерь. Мы не против технологий — наоборот, ребята проводят за компьютером несколько часов в день. Разница в том, как именно:",
    list: [
      "Технологии для обучения — занятия по Python, работа с AI-инструментами, 3D-моделирование. Каждый час за экраном имеет конкретную цель и результат",
      "Ограничение развлекательного использования — соцсети, YouTube, игры на личных устройствах убирают из фона. Не потому что «плохо», а потому что они конкурируют с более интересным",
      "Смартфон как награда, а не фон — экранное время на личных устройствах зарабатывается через внутреннюю валюту лагеря. Школьники учатся ценить то, за что заплатили собственными усилиями",
      "Результат — никто не «лишается телефона» с болью, а открывает, что жизнь интересна и без скроллинга"
    ]
  },
  {
    h2: "Что происходит с ребёнком без соцсетей две недели",
    text: "Первые 1–2 дня без привычного «фона» действительно бывают непривычными. Дальше — наблюдения от наших вожатых и родителей:",
    list: [
      "Фокус растёт — без уведомлений дети дольше держат внимание на задаче. IT-проекты развиваются быстрее, чем дома при работе с телефоном рядом",
      "Новые дружбы завязываются быстрее — когда не смотришь в экран между делом, начинаешь разговаривать с теми, кто рядом. Связи из лагеря часто остаются на годы",
      "Реальные достижения — проект, который ребёнок создал за смену, ощущается ценнее, чем сотни видео просмотренных дома. Это момент «я сделал что-то настоящее»",
      "73% родителей через 3 месяца после смены отмечают, что ребёнок спокойнее относится к ограничениям экранного времени дома"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-bez-telefonov.avif"
  title="Лагерь без телефонов в Подмосковье 2026 | АйДаКемп"
  description="Детский лагерь без гаджетов и телефонов в Подмосковье. Экранное время зарабатывается — ребёнок учится ценить время. С образовательной программой, 66 км от МКАД."
  h1="Детский лагерь без телефонов в Подмосковье"
  canonical="https://aidacamp.ru/lager-bez-telefonov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Как работает лагерь без телефонов?", "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп смартфоны сдаются в первый день на хранение вожатому. Вместо телефона — внутренняя валюта лагеря, которую зарабатывают за участие, помощь другим и учёбу. Экранное время становится наградой, а не фоном." } },
        { "@type": "Question", "name": "Можно ли ребёнку позвонить родителям без телефона?", "acceptedAnswer": { "@type": "Answer", "text": "Да. Телефон выдаётся по расписанию (обычно вечером) или при необходимости. Родители могут связаться с вожатым в любое время. В родительском Telegram-канале — ежедневные фото и обновления." } },
        { "@type": "Question", "name": "Дети скучают без телефона в лагере?", "acceptedAnswer": { "@type": "Answer", "text": "По нашим наблюдениям, большинство детей перестают скучать по телефону за 2–3 дня. В лагере плотная программа: IT-занятия, бассейн, спорт, живое общение с новыми друзьями. Многие родители замечают, что дети возвращаются домой с меньшей зависимостью от гаджетов." } },
        { "@type": "Question", "name": "Для чего нужен лагерь без телефонов?", "acceptedAnswer": { "@type": "Answer", "text": "Для перезагрузки. Без смартфона дети начинают живо общаться, концентрироваться на задачах и замечать природу вокруг. Исследования показывают: 7+ дней без телефона снижают симптомы экранной зависимости у детей 8–14 лет." } },
        { "@type": "Question", "name": "Когда ребёнку отдавать телефон перед смены и забирать после?", "acceptedAnswer": { "@type": "Answer", "text": "Телефон сдаётся вожатому в первый день смены при заезде. Возвращается в последний день при отъезде. По согласованию телефон могут выдавать вечером по расписанию для связи с родителями." } },
        { "@type": "Question", "name": "Что если у ребёнка паника без телефона?", "acceptedAnswer": { "@type": "Answer", "text": "Такие случаи бывали — обычно в первые 1–2 дня. Вожатые знают об этом и работают с такими детьми индивидуально: больше внимания, помощь включиться в командные активности. За 5 лет работы ни один ребёнок не уехал домой из-за телефонной тревоги." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь без телефонов в Подмосковье"
    subtitle="Смартфоны сдаются в первый день. Вместо них — внутренняя валюта, IT-проекты и живое общение."
    breadcrumb="Лагерь без телефонов"
    keywords={["Смартфоны сдаются на хранение с первого дня смены", "Экранное время зарабатывается — за участие и помощь другим", "Большинство детей перестают скучать по телефону за 2–3 дня"]}
    image="/images/hero/lager-bez-telefonov.avif"
    imageAlt="Лагерь без телефонов АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток в телефоне 24/7 — 5 способов без конфликта и конфискации", url: "/stati/zavisimost-ot-telefona-u-podrostkov", description: "Почему забирать телефон не работает и что реально снижает экранное время.", icon: "phone" },
    { title: "Ребёнок не вылезает из игр — 4 шага без скандалов", url: "/stati/zavisimost-ot-kompyuternyh-igr", description: "Практический план без запретов и конфликтов.", icon: "controller" },
    { title: "Детский лагерь без телефонов — что это и зачем", url: "/stati/detskiy-lager-bez-telefonov", description: "Как работает формат с внутренней валютой вместо гаджетов.", icon: "phone-vibrate" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-[14px] text-slate-500">
    Полезная статья: <a href="/stati/detskiy-lager-bez-telefonov/" class="text-primary hover:underline">подробнее о жизни без телефонов</a>
  </div>
  <RelatedPages pages={[
    { title: 'IT-лагерь', description: 'Программирование, AI, Minecraft — полное погружение', url: '/it-camp', icon: 'bi-laptop' },
    { title: 'Лагерь на лето 2026', description: 'Все смены и даты летнего сезона', url: '/lager-na-leto-2026', icon: 'bi-sun' },
    { title: 'Цены и смены', description: 'Стоимость и даты всех смен 2026', url: '/ceny', icon: 'bi-receipt' },
    { title: 'Детский лагерь', description: 'Загородный лагерь для детей 7–15 лет', url: '/detskiy-lager', icon: 'bi-house-heart' },
  ]} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
