---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое лагерь без телефонов АйДаКемп?",
    text: `АйДаКемп — загородный лагерь в Подмосковье, 66 км от Москвы, где экранное время не запрещают, а заменяют осознанной системой: внутренней валютой, IT-занятиями и живым общением. Принимаем ребят 7–15 лет. Смены 10 и 13 дней, август, от ${PRICE_MIN}. Лицензия Минобрнауки Л035-01298-77/01082973. Важный нюанс: АйДаКемп — это IT-лагерь. Дети проводят за компьютером несколько часов в день — но это учёба и работа над проектом по расписанию, а не скроллинг. IT-занятия проходят с преподавателем и конкретной целью: ребята учатся использовать технологии осознанно — это и есть главный навык современности.`
  },
  {
    h2: "Как работает лагерь без телефонов",
    text: "В первый день смены все смартфоны сдаются на хранение. Вместо этого в лагере действует собственная внутренняя валюта (далее под рублями имеется в виду игровая валюта лагеря) — её зарабатывают за участие в активностях, помощь другим, прогресс в IT-проекте. На накопленные рубли можно получить «телефонное время» — строго по правилам. Это не запрет, а осознанный выбор: ребята сами видят ценность времени.",
    list: [
      "Прогресс в IT-проекте — выполнил модуль, объяснил другому, получил обратную связь от преподавателя",
      "Участие в командных активностях: спорт, хакатон, помощь новенькому",
      "Утренняя зарядка и порядок в комнате — маленькие привычки тоже в системе",
      "Накопленные рубли тратятся на телефонное время или другие привилегии по меню",
      "Ребёнок не «лишён» телефона — он сам решает, стоит ли тратить рубли на экран или приберечь на что-то другое"
    ]
  },
  {
    h2: "Для кого подходит лагерь без телефонов?",
    text: "Лагерь без телефонов особенно подходит детям, которые «залипают» в экраны дома и теряют интерес к живому общению. Родители, которые сами устали от бесконечных переговоров про телефон, находят в АйДаКемп союзника: здесь правила одинаковы для всех, и ребята принимают их как данность, а не как личное ограничение.",
    list: [
      "Дети 7–15 лет с любым уровнем «телефонной зависимости»",
      "Те, кто хочет IT-проект, а не просто «выключить» ребёнка",
      "Семьи, которым важна безопасная цифровая среда"
    ]
  },
  {
    h2: "Чем лагерь без телефонов отличается от «лагеря с запретом»",
    text: "Многие лагеря заявляют «без гаджетов» и реализуют это как силовой запрет: утром сдал телефон, вечером получил. Это работает технически, но не меняет ничего в голове. После возвращения дети набрасываются на экран с удвоенной жадностью. Наш формат — принципиально другой. Вместо «нельзя» — «это ресурс, у которого есть цена». Ребята не бунтуют против правил, потому что правила встроены в экономику лагеря, а не наложены сверху.",
    list: [
      "Обычный формат «без гаджетов»: отнял → отдал обратно → рецидив",
      "Наш формат: валюта → купил время → ценит своё решение → переносит привычку домой",
      "Результат через 3 месяца: 73% родителей отмечают, что ребёнок спокойнее относится к ограничениям экранного времени"
    ]
  },
  {
    h2: "Как поддерживать связь с ребёнком: звонки и Telegram",
    text: "Самый частый вопрос от родителей — «как я буду знать, что всё хорошо?». Отвечаем:",
    list: [
      "Видеозвонок каждый вечер в фиксированное время (обычно 20:30–21:00) — расписание присылаем при заезде",
      "Telegram-канал группы: вожатые публикуют фото и короткие видео каждый день",
      "При необходимости — вожатый всегда на связи, номер телефона есть у каждого родителя",
      "Смартфон ребёнку выдаётся по расписанию или по просьбе при объективной необходимости",
      "Ни один ребёнок за 5 лет работы не остался без связи с родителями когда это было важно"
    ]
  },
  {
    h2: "Что делать родителям после лагеря, чтобы эффект сохранился",
    text: "Самое частое разочарование родителей: «вернулся — и опять в телефоне». Это происходит, когда дома всё осталось по-прежнему. Ребята сбрасывают привычку в лагере, но старая среда возвращает её обратно за 3–5 дней. Чтобы эффект сохранился, нужно минимум 3 изменения дома:",
    list: [
      "Убрать гаджеты из детской спальни — зарядка на общей станции на кухне",
      "Ввести семейные часы без экрана — обед, прогулка, настолки раз в неделю",
      "Самому родителю соблюдать ограничения (дети копируют поведение, а не слова)",
      "Обсудить новые хобби, которые ребёнок «прихватил» из лагеря (код, спорт, творчество) — поддержать их",
      "Проверить через месяц — если привычки вернулись, запланировать следующую смену"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-bez-telefonov.avif"
  title="Лагерь без телефонов и гаджетов в Подмосковье 2026 | АйДаКемп"
  description="Детский лагерь без гаджетов и телефонов в Подмосковье. Экранное время зарабатывается — ребёнок учится ценить время. С образовательной программой, 66 км от МКАД."
  h1="Детский лагерь без телефонов в Подмосковье"
  canonical="https://aidacamp.ru/lager-bez-telefonov"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как работает лагерь без телефонов?", a: "В АйДаКемп смартфоны сдаются в первый день на хранение вожатому. Вместо телефона — внутренняя валюта лагеря, которую зарабатывают за участие, помощь другим и учёбу. Экранное время становится наградой, а не фоном." },
    { q: "Можно ли ребёнку позвонить родителям без телефона?", a: "Да. Телефон выдаётся по расписанию (обычно вечером) или при необходимости. Родители могут связаться с вожатым в любое время. В родительском Telegram-канале — ежедневные фото и обновления." },
    { q: "Дети скучают без телефона в лагере?", a: "По нашим наблюдениям, большинство детей перестают скучать по телефону за 2–3 дня. В лагере плотная программа: IT-занятия, бассейн, спорт, живое общение с новыми друзьями. Многие родители замечают, что дети возвращаются домой с меньшей зависимостью от гаджетов." },
    { q: "Для чего нужен лагерь без телефонов?", a: "Для перезагрузки. Без смартфона дети начинают живо общаться, концентрироваться на задачах и замечать природу вокруг. По нашим наблюдениям, большинство детей перестают скучать по телефону за 2–3 дня." },
    { q: "Когда ребёнку отдавать телефон перед смены и забирать после?", a: "Телефон сдаётся вожатому в первый день смены при заезде. Возвращается в последний день при отъезде. По согласованию телефон могут выдавать вечером по расписанию для связи с родителями." },
    { q: "Что если у ребёнка паника без телефона?", a: "Такие случаи бывали — обычно в первые 1–2 дня. Вожатые знают об этом и работают с такими детьми индивидуально: больше внимания, помощь включиться в командные активности. За 5 лет работы ни один ребёнок не уехал домой из-за телефонной тревоги." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь без телефонов в Подмосковье"
    subtitle="Смартфоны сдаются в первый день. Вместо них — внутренняя валюта, IT-проекты и живое общение."
    breadcrumb="Лагерь без телефонов"
    keywords={["Смартфоны сдаются на хранение с первого дня смены", "Экранное время зарабатывается — за участие и помощь другим", "Большинство детей перестают скучать по телефону за 2–3 дня"]}
    image="/images/hero/lager-bez-telefonov.avif"
    imageAlt="Лагерь без телефонов АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток в телефоне 24/7 — 5 способов без конфликта и конфискации", url: "/stati/zavisimost-ot-telefona-u-podrostkov/", description: "Почему забирать телефон не работает и что реально снижает экранное время.", icon: "phone" },
    { title: "Ребёнок не вылезает из игр — 4 шага без скандалов", url: "/stati/zavisimost-ot-kompyuternyh-igr/", description: "Практический план без запретов и конфликтов.", icon: "controller" },
    { title: "Детский лагерь без телефонов — что это и зачем", url: "/stati/detskiy-lager-bez-telefonov/", description: "Как работает формат с внутренней валютой вместо гаджетов.", icon: "phone-vibrate" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-base text-slate-500">
    Полезная статья: <a href="/stati/detskiy-lager-bez-telefonov/" class="text-primary hover:underline">подробнее о жизни без телефонов</a>
  </div>
  <RelatedPages pages={[
    { title: 'IT-лагерь', description: 'Программирование, AI, Minecraft — полное погружение', url: '/it-camp/', icon: 'bi-laptop' },
    { title: 'Лагерь на лето 2026', description: 'Все смены и даты летнего сезона', url: '/lager-na-leto-2026/', icon: 'bi-sun' },
    { title: 'Цены и смены', description: 'Стоимость и даты всех смен 2026', url: '/ceny/', icon: 'bi-receipt' },
    { title: 'Детский лагерь', description: 'Загородный лагерь для детей 7–15 лет', url: '/detskiy-lager/', icon: 'bi-house-heart' },
  ]} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
