---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как понять, что лагерь проверенный",
    text: "Слово «проверенный» на сайте лагеря ничего не значит — любой может так написать. Реальные признаки проверенного детского лагеря: официальная лицензия туроператора в государственном реестре, образовательная лицензия Минобрнауки, независимые отзывы на Яндекс.Картах (не только на сайте), конкретный публичный результат работы, прозрачный договор с условиями возврата.",
    list: [
      "Реестровый туроператор РТО 025773 — проверяется на сайте Ростуризма",
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973 — проверяется на сайте Рособрнадзора",
      "Рейтинг 5.0 на Яндекс.Картах — 40+ независимых отзывов за 5 лет",
      "Работаем с 2021 года — через лагерь и школу прошли более 1 200 детей"
    ]
  },
  {
    h2: "Документы и лицензии проверенного лагеря",
    text: "АйДаКемп работает в правовом поле с первого года. Все документы публичны и проверяемы онлайн — не нужно верить нам на слово. Родители могут проверить каждый документ на официальном государственном ресурсе.",
    list: [
      "Туроператор в реестре РТО 025773 (проверить: russiatourism.ru)",
      "Образовательная лицензия Л035-01298-77/01082973 — <a href='/docs/licenziya-rosobrnadzor.pdf' target='_blank' rel='noopener' class='text-primary underline'>посмотрите документ</a>",
      "Страхование детей — ВСК, полис на каждую смену",
      "Публичный договор-оферта — все условия прозрачны до подписания",
      "Ежегодное разрешение Роспотребнадзора на открытие летнего лагеря"
    ]
  },
  {
    h2: "5 лет работы — что это значит для родителей",
    text: "Лагерь с 2021 года — это не разовый проект, а устойчивая практика. За 5 лет мы собрали базу из более чем 1 200 детей и их семей. Многие приезжают повторно — это главный показатель доверия. Второй — рекомендации: 60% новых семей приходят по советам знакомых, а не из рекламы. Такое не купишь, это зарабатывается годами честной работы.",
    list: [
      "С 2019 года — более 1 200 детей из Москвы и Подмосковья",
      "Повторные заезды: 35% детей приезжают снова на следующий сезон",
      "60% новых семей — по рекомендации от тех, кто уже был",
      "5 сезонов без единого серьёзного инцидента с безопасностью детей"
    ]
  },
  {
    h2: "Безопасность в проверенном лагере",
    text: "Безопасность — первое, что проверяют родители. В АйДаКемп это не слова в буклете, а конкретные люди, процедуры и техника. Территория санатория «Изумруд» — закрытый периметр с КПП. Медработник живёт на территории весь сезон. Охрана работает 24/7, видеонаблюдение охватывает все ключевые точки.",
    list: [
      "Медработник на территории 24/7 — не скорая, а постоянное присутствие",
      "Охрана и КПП — въезд только по пропускам, гости — только с уведомлением",
      "Видеонаблюдение на территории санатория",
      "Ближайшая районная больница — 15 минут, скорая из Наро-Фоминска до лагеря — 20 минут",
      "Пищевые аллергии фиксируются при заезде, учитываются на каждом приёме пищи"
    ]
  },
  {
    h2: "Программа проверенного IT-лагеря",
    text: "Программа АйДаКемп — не кружок «для галочки». Авторский курс, разработанный практикующими IT-специалистами и авторами учебника по Python для детей (тираж 2 000 экз.). Каждый трек — от введения до защиты проекта на хакатоне. Группы до 8 человек, чтобы каждый получал внимание преподавателя.",
    list: [
      "Треки: Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование",
      "Занятия дважды в день по 90 минут — системная работа, а не разовые занятия",
      "Хакатон в финале — публичная защита проекта перед всей сменой",
      "Преподаватели — практикующие IT-специалисты, авторы учебника Python для детей"
    ]
  },
  {
    h2: "Отзывы о проверенном лагере",
    text: "Родители, выбравшие АйДаКемп после долгого поиска «проверенного» лагеря:",
    list: [
      "«Выбирала лагерь 2 месяца, читала отзывы везде. АйДаКемп — единственный с реальными отзывами на Яндекс.Картах, а не только на своём сайте. Результат оправдал ожидания» — Марина, мама Никиты, 11 лет",
      "«Муж юрист — проверил все документы. РТО в реестре, лицензия Минобрнауки, договор понятный. Редко такое встретишь» — Ольга, мама Саши, 13 лет",
      "«Сын побывал в двух других лагерях — там было весело, но пусто. Здесь — вернулся с проектом и хочет в следующем году снова» — Андрей, папа Ильи, 12 лет"
    ]
  },
  {
    h2: "Гарантия при выборе проверенного лагеря",
    text: "Мы уверены в нашей программе — настолько, что даём гарантию. Если ребёнку не понравится в первые 3 дня — вернём 50% стоимости смены без лишних вопросов. Такая гарантия возможна только тогда, когда лагерь уверен в своём продукте. Мы уверены.",
    list: [
      "Гарантия возврата 50% за первые 3 дня (смены от 10 дней) — зафиксировано в договоре",
      "Бронь без предоплаты на 72 часа — решайте не торопясь",
      "Документы для налогового вычета 13% выдаём автоматически",
      "Ежедневные фото и обновления в Telegram-канале — вы всегда в курсе"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/luchshie-detskie-lagerya.avif"
  title="Проверенный детский лагерь в Подмосковье 2026 — АйДаКемп"
  description="Проверенный IT-лагерь для детей 7–15 лет в Подмосковье. Лицензия Минобрнауки, РТО 025773, рейтинг 5.0, 5 лет работы. Смены июнь–август от 48 000 ₽."
  h1="Проверенный детский лагерь в Подмосковье"
  canonical="https://aidacamp.ru/proverennyj-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Как проверить детский лагерь перед записью?", "acceptedAnswer": { "@type": "Answer", "text": "Проверьте: 1) Туроператор в реестре Ростуризма (для АйДаКемп — РТО 025773). 2) Образовательная лицензия на сайте Рособрнадзора (Л035-01298-77/01082973). 3) Независимые отзывы на Яндекс.Картах (не только на сайте). 4) Договор с условиями возврата средств." } },
        { "@type": "Question", "name": "Какие документы должны быть у проверенного лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "Обязательно: туроператорская лицензия (реестр Ростуризма), страхование детей, разрешение Роспотребнадзора на сезон. Дополнительно у АйДаКемп: образовательная лицензия Минобрнауки — даёт право на налоговый вычет 13%." } },
        { "@type": "Question", "name": "Как понять что лагерь проверенный по отзывам?", "acceptedAnswer": { "@type": "Answer", "text": "Ищите отзывы на независимых платформах: Яндекс.Карты, Google Maps, Отзовик — а не только на сайте лагеря. АйДаКемп: рейтинг 5.0 на Яндекс.Картах, 40+ отзывов за 5 лет. Отзывы с именами и фото — признак реальности." } },
        { "@type": "Question", "name": "Сколько лет должен работать лагерь, чтобы считаться проверенным?", "acceptedAnswer": { "@type": "Answer", "text": "Нет жёсткого критерия, но 3–5 лет — минимальный признак устойчивости. АйДаКемп работает с 2021 года, через лагерь и школу прошли более 1 200 детей. 35% возвращаются повторно, 60% новых — по рекомендации знакомых." } },
        { "@type": "Question", "name": "Есть ли гарантия возврата денег если лагерь не понравится?", "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп — да. Если ребёнку не понравится в первые 3 дня, вернём 50% стоимости смены. Условие зафиксировано в публичном договоре-оферте. Бронирование на 72 часа без предоплаты — можно спокойно принять решение." } }
      ]
    })} />
    <CourseSchema
      name="АйДаКемп — проверенный детский IT-лагерь в Подмосковье"
      description="Проверенный лагерь для детей 7–15 лет: лицензия Минобрнауки, туроператор РТО 025773, рейтинг 5.0 на Яндекс.Картах, работаем с 2021 года. IT-программа с хакатоном."
      url="https://aidacamp.ru/proverennyj-lager"
      level="Beginner"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Проверенный детский лагерь в Подмосковье"
    subtitle="АйДаКемп — IT-лагерь с 2021 года. Лицензия Минобрнауки, туроператор РТО 025773, рейтинг 5.0 на Яндекс.Картах. 66 км от МКАД, от 48 000 ₽."
    breadcrumb="Проверенный лагерь"
    keywords={["Лицензия Минобрнауки + туроператор РТО 025773 — проверяется онлайн", "Рейтинг 5.0 на Яндекс.Картах — 40+ независимых отзывов за 5 лет", "С 2019 года — более 1 200 детей, 35% приезжают повторно"]}
    image="/images/hero/luchshie-detskie-lagerya.avif"
    imageAlt="Проверенный детский лагерь АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
