---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PHONE_MOBILE, PHONE_MOBILE_HREF } from '../data/contacts';
---

<Base
  title="Пресс-кит АйДаКемп — материалы для СМИ и журналистов"
  description="Пресс-кит IT-лагеря АйДаКемп: факты, фотографии в высоком разрешении, документы, контакт для редакций."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/press" />
    <meta name="robots" content="noindex" />
  </Fragment>
  <Header />
  <main class="mx-auto max-w-[860px] px-4 py-12">
    <h1 class="text-[32px] md:text-[40px] font-bold text-slate-900 tracking-[-0.02em] mb-2">Пресс-кит АйДаКемп</h1>
    <p class="text-[16px] text-slate-500 mb-10">Материалы для журналистов, блогеров и редакций</p>

    <!-- Факты -->
    <section class="mb-10">
      <h2 class="text-[22px] font-bold text-slate-900 mb-4">Факты о лагере</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {[
          ["С 2019 года", "6 сезонов, с каждым годом программа глубже"],
          ["1 200+ детей", "прошли через лагерь и IT-школу АйДаКодить"],
          ["35%", "возвращаются на следующую смену"],
          ["60%", "новых семей — по рекомендации друзей"],
          ["Рейтинг 5.0", "40+ отзывов на Яндекс.Картах"],
          ["Группы до 8 чел.", "один преподаватель знает каждого по имени"],
          ["66 км от МКАД", "санаторий «Изумруд», Наро-Фоминский район МО"],
          ["ТОП-4 IT-лагерей МО", "рейтинг vc.ru / GdeKurs 2025"],
        ].map(([val, desc]) => (
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 px-4 py-3 flex gap-3 items-start">
            <span class="text-[15px] font-bold text-slate-900 shrink-0">{val}</span>
            <span class="text-[14px] text-slate-500">{desc}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Документы -->
    <section class="mb-10">
      <h2 class="text-[22px] font-bold text-slate-900 mb-4">Документы и лицензии</h2>
      <ul class="flex flex-col gap-3">
        <li class="flex items-start gap-3">
          <i class="bi bi-patch-check-fill text-[18px] text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="text-[14px] font-semibold text-slate-800">Образовательная лицензия Минпросвещения</p>
            <p class="text-[13px] text-slate-500">Л035-01298-77/01082973 — даёт право на образовательную деятельность и является основанием для налогового вычета 13%</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <i class="bi bi-award-fill text-[18px] text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="text-[14px] font-semibold text-slate-800">Туроператор РТО 025773</p>
            <p class="text-[13px] text-slate-500">Запись в Федеральном реестре туроператоров. Финансовая ответственность застрахована</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <i class="bi bi-shield-fill text-[18px] text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="text-[14px] font-semibold text-slate-800">Страхование ответственности</p>
            <p class="text-[13px] text-slate-500">Росгосстрах. Застрахована ответственность туроператора; личную страховку от НС родитель оформляет сам</p>
          </div>
        </li>
      </ul>
    </section>

    <!-- Основатель -->
    <section class="mb-10">
      <h2 class="text-[22px] font-bold text-slate-900 mb-4">Об основателе</h2>
      <div class="rounded-[16px] bg-slate-50 border border-slate-100 p-6">
        <p class="text-[16px] font-semibold text-slate-900 mb-1">Дарья Афанасьева</p>
        <p class="text-[14px] text-slate-500 mb-3">Основатель АйДаКемп, мама подростка, предприниматель в сфере IT-образования</p>
        <ul class="flex flex-col gap-1.5">
          {[
            "Создала лагерь в 2019 году после того как не смогла найти достойный IT-лагерь для собственной дочери",
            "Педагогическое образование + опыт в EdTech",
            "Лично участвует в разработке программы каждой смены",
            "Контакт для интервью и комментариев: pr@aidacamp.ru",
          ].map(fact => (
            <li class="flex items-start gap-2">
              <i class="bi bi-check-lg text-[13px] text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span class="text-[14px] text-slate-600">{fact}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Упоминания -->
    <section class="mb-10">
      <h2 class="text-[22px] font-bold text-slate-900 mb-4">Упоминания в СМИ</h2>
      <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="flex items-start gap-3 rounded-[16px] border border-slate-200 p-5 group hover:border-orange-200 transition-colors">
        <i class="bi bi-trophy-fill text-[20px] text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
        <div class="flex-1 min-w-0">
          <p class="text-[14px] font-semibold text-slate-800 group-hover:text-primary transition-colors">vc.ru / GdeKurs — ТОП-4 IT-лагерей Подмосковья</p>
          <p class="text-[13px] text-slate-500 mt-0.5">«Топ-20 детских летних IT-лагерей в Москве и Подмосковье» — независимый рейтинг, 2025</p>
        </div>
        <i class="bi bi-box-arrow-up-right text-[13px] text-slate-400 shrink-0 mt-1" aria-hidden="true"></i>
      </a>
    </section>

    <!-- Контакт -->
    <section class="rounded-[16px] bg-[#0d1a2b] p-6 text-white">
      <h2 class="text-[18px] font-bold mb-2">Контакт для редакций</h2>
      <p class="text-white/70 text-[14px] mb-3">Для интервью, экспертных комментариев, упоминаний в публикациях:</p>
      <div class="flex flex-col gap-2">
        <a href="mailto:pr@aidacamp.ru" class="flex items-center gap-2 text-[14px] text-orange-400 hover:text-orange-300 transition-colors">
          <i class="bi bi-envelope-fill text-[13px]" aria-hidden="true"></i>
          pr@aidacamp.ru
        </a>
        <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 text-[14px] text-white/70 hover:text-white transition-colors">
          <i class="bi bi-telephone-fill text-[13px]" aria-hidden="true"></i>
          {PHONE_MOBILE}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
