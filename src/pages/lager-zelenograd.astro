---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { STAT_RATING, STAT_INSURED } from '../data/contacts';

const sections = [
  {
    h2: "Сколько ехать из Зеленограда — честно",
    text: "Из Крюково до нашего КПП по навигатору — 78–82 км в зависимости от района. На машине без пробок — 55–65 минут, в пятницу вечером добавьте 20 минут на ЦКАД у Звенигорода. На территории свой паркинг, шлагбаум, охрана пропустит по списку. Коротко: это час-полтора в одну сторону, разово, а не каждый день.",
    list: [
      "На машине: Зеленоград → ЦКАД (А-107) на юг → выход на М-3 «Украина» у Апрелевки → 8 км по съезду",
      "На трансфере: автобус до Планерной или Речного → метро до Солнцево → наш сопровождающий",
      "В день заезда трансфер уезжает по расписанию (обычно 11:00, точное время — накануне в Telegram-чате родителей)",
      "В день отъезда привозим обратно к Солнцево — родители встречают"
    ]
  },
  {
    h2: "Что мы делаем 7–14 дней",
    text: "Шесть направлений на выбор, и «IT» здесь не значит «сажают за компьютеры»: это настоящие проекты, как у первокурсников МИЭТ, адаптированные под 4-й и под 9-й класс. В финале команда защищает проект — каждый объясняет свою часть.",
    list: [
      "Python — от переменных и циклов до телеграм-бота, которого можно показать одноклассникам. На прошлой смене школьник из Зеленограда сделал бота, который дёргает погоду по API и напоминает маме взять зонт: код написан, бот работает",
      "AI и нейросети — ChatGPT API, генерация картинок, простая обработка текста. Подростки 12+ за смену делают собственного AI-помощника",
      "Minecraft Education — внутри игры пишется реальный Python: мобы, постройки, механики. Самое популярное у мальчиков 8–11 лет",
      "Roblox Studio — творческий трек: собственный игровой мир на Lua. Девочки 10–13 любят больше всего — там можно дизайнить интерьер, делать одежду персонажам, попутно изучая логику",
      "3D в Blender + печать — моделируют фигурку и печатают на 3D-принтере прямо здесь. Ребёнок увозит домой физический объект, который сам нарисовал",
      "Хакатон в конце смены — каждый защищает свой проект, родители получают видео"
    ]
  },
  {
    h2: "Почему Зеленоград — наша аудитория",
    text: "Это единственный округ Москвы, где IT — не модное слово, а семейный быт. Завод «Микрон» делает чипы. МИЭТ выпускает инженеров. Половина пап в Силино, Крюково и Старом городе работают в технологических компаниях. Когда мама вечером слышит «папа пишет код» — у школьника вопрос не «зачем», а «как».",
    text2: "Родители здесь знают разницу между курсами у дома (два часа в неделю с домашкой) и десятью днями в среде, где код — норма. К третьему дню от «не хочу» не остаётся следа: школьник перестаёт спрашивать «во что поиграть», потому что вокруг шестеро таких же."
  },
  {
    h2: `Смены ${SEASON_YEAR} и налоговый вычет`,
    text: `Июньские смены уже прошли — открыты две августовские, в них ещё есть места. В стоимость включены проживание 2–4 человека в комнате с душем, пятиразовое питание, ноутбуки (свои везти не надо), вся образовательная IT-программа, бассейн, спорт, врач 24/7. Это официальный оздоровительный лагерь: бронирование фиксирует место и цену, безопасность на территории — по договору и лицензии, ${STAT_INSURED.toLowerCase()}, рейтинг ${STAT_RATING} на Яндекс.Картах.`,
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней, ${PRICE_S21} → налоговый вычет ~${VYCHET_S21}`,
      `Смена 2.2 (завершена) — ${DATES_SHORT_S22}, 8 дней, ${PRICE_S22} → налоговый вычет ~${VYCHET_S22}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2} → налоговый вычет ~${VYCHET_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} → налоговый вычет ~${VYCHET_S3} (места есть)`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} → налоговый вычет ~${VYCHET_S4} (места есть)`
    ]
  },
  {
    h2: "Как добраться — по районам Зеленограда",
    text: "Маршрут зависит от вашего района:",
    list: [
      "15-й или 16-й микрорайон (Крюково): через Пятницкое шоссе → ЦКАД → М-3. Не выезжайте на Ленинградку — там светофоры и дольше",
      "Силино или Матушкино: через Старое Крюковское шоссе → А-107 → М-3",
      "На электричке без машины: до Ленинградского вокзала, метро до Солнцево, и там наш трансфер. Не экономьте через автобус Зеленоград–Внуково — пересадка с чемоданом и подростком в час пик нервы дороже",
      "Документы для поездки: свидетельство о рождении или паспорт, полис ОМС, справка 079/у, справка об отсутствии контактов, прививочный сертификат, анализ на энтеробиоз, СНИЛС. Справку 079/у делает участковый педиатр — в Зеленограде это поликлиники №105, 201, 230, обычно за 2–3 дня"
    ]
  },
  {
    h2: "Что родители из Зеленограда писали после смены",
    text: "Несколько отзывов от семей из разных районов:",
    list: [
      "«Везла на трансфер с опаской — никогда не отдавала на больше чем 3 дня. Через неделю забрала ребёнка, который сам поставил себе VS Code дома и пишет каких-то ботов. Я не понимаю что он делает, но вижу что он занят и счастлив». — Алёна, мама Серёжи из 14-го мкр.",
      "«Сам инженер в Микроне, дочь раньше говорила что программирование — это для мальчиков. После Roblox смены сделала папе на день рождения интерактивную открытку в коде. Папа плакал». — Дмитрий, папа Тани, 12 лет",
      "«Оба близнеца сразу. Один в Python, второй в Minecraft. Впервые за лето не дрались — обсуждали что у кого получилось». — Марина, мама близнецов 10 лет"
    ]
  },
  {
    h2: "Часто спрашивают",
    text: "",
    list: [
      "Как далеко от Зеленограда на самом деле? — 80 километров. На машине без пробок — час. С трансфером от Солнцево — общее время в пути около 1 ч 40 мин",
      "Можно ли приехать навестить? — Можно, любой день кроме первого и последнего. Час дороги, посидите с ребёнком в кафе на территории. Многие родители из Зеленограда так и делают на середине смены",
      "Если школьник никогда не программировал? — Большинство наших — именно такие. Деление по уровням в первый день: новички начинают со Scratch и Minecraft, продвинутые — с Python. К третьему дню разница стирается",
      "Сколько школьников в группе? — До 8 человек на преподавателя. Это принципиальная цифра — больше нельзя качественно вести проект",
      '«А если не понравится?» — <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">Условия гарантии возврата →</a> За шесть лет таких случаев было два, оба раза потом просились вернуться на следующую смену'
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский IT-лагерь Зеленоград — программирование для детей | АйДаКемп"
  description={`IT-лагерь АйДаКемп для детей из Зеленограда. Программирование: Python, AI, Minecraft, Roblox, 3D для ребят 7–15 лет. Трансфер от м. Солнцево включён. Смены июнь-август. От ${PRICE_MIN}.`}
  h1={`Детский лагерь — Зеленоград ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-zelenograd"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Зеленограда до лагеря АйДаКемп?", a: "Из Зеленограда — ~80 км по Киевскому шоссе М-3 через МКАД (южный объезд), около 1 часа без пробок. Не нужно ехать через центр Москвы — сразу по МКАД на юг к Киевскому шоссе." },
    { q: "Откуда стартует трансфер до лагеря?", a: "Бесплатный трансфер отправляется от м. Солнцево. Из Зеленограда добраться туда просто: автобус до м. Планерная и метро до м. Солнцево — около 40–45 минут." },
    { q: "Долго ли ехать из Зеленограда?", a: "Около 1 часа на машине через МКАД и Киевское шоссе. На метро+трансфере — около 40 мин до м. Солнцево. Главное — не нужно ехать через центр Москвы." },
    { q: "Есть ли трансфер непосредственно из Зеленограда?", a: "Прямого трансфера из Зеленограда нет, но ехать до точки сбора у м. Солнцево легко — метро через м. Планерная, около 40–45 минут. Дальше бесплатный автобус лагеря везёт ребёнка прямо на место." },
    { q: "Для каких ребят подходит IT-лагерь?", a: "Для школьников 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." },
    { q: "Какие треки доступны?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." },
    { q: "Когда открывается запись на смены 2026?", a: "Запись уже открыта. Июль 2026 занят полностью. В июне и августе ещё есть места. Бронировать лучше заранее — места ограничены." },
    { q: "Какие лагеря рядом с Зеленоградом работают летом 2026?", a: "АйДаКемп — IT-лагерь в 80 км от Зеленограда (Наро-Фоминский район), работает с 30 мая по 26 августа 2026. Смены 7–14 дней, Python, AI, Minecraft для школьников 7–15 лет." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~80 км от Зеленограда. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />
    
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Camp",
  "name": "АйДаКемп — IT-лагерь для школьников",
  "description": "Летний лагерь программирования и IT для детей 7-17 лет из Москвы",
  "url": "https://aidacamp.ru/lager-zelenograd",
  "image": "https://aidacamp.ru/og-image.jpg",
  "areaServed": {
    "@type": "City",
    "name": "Зеленоград"
  },
  "offers": [
    {
