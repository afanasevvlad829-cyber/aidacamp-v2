---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Зеленограда",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, примерно в 70 км от Зеленограда. Ближайший маршрут — через МКАД (южная часть) и Киевское шоссе в сторону Наро-Фоминска. В среднем около 1–1.5 часа езды. Организованный трансфер отправляется из Москвы (точка сбора — м. Солнцево), до которой из Зеленограда 30–40 минут (машиной через МКАД или электричкой Ленинградского направления до Москвы + метро). Дальше ребёнок едет на автобусе лагеря."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в игры в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Зеленограда выбирают АйДаКемп",
    text: "Зеленоград — самый зелёный район Москвы, и АйДаКемп тоже в сосновом лесу. Плюс практические плюсы:",
    list: [
      "Подмосковье рядом — нет перелёта, нет акклиматизации, ребёнок здоров с первого дня",
      "В любой день смены можно приехать — 1.5 часа и ты рядом с ребёнком",
      "Трансфер от м. Солнцево — 30–40 минут от Зеленограда, пересадка простая",
      "Та же часовая зона, тот же климат — ребёнок спит нормально с первой ночи"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Зеленограда",
    text: "В АйДаКемп едут дети из Зеленограда, Солнечногорска, Химок и северного Подмосковья. Вот что говорят родители:",
    list: [
      "«Доехала из Зеленограда до Солнцево за 35 минут, пересадили сына на автобус — и всё. 10 дней не звонил, потому что был занят проектом на Python. Это победа!» — Марина, мама Артёма, 13 лет",
      "«Дочка из Солнечногорска сначала скептически — мол, лагерь скучно. Вернулась с готовым Roblox-миром и просила записать на следующую смену прямо в машине» — Екатерина, Солнечногорск",
      "«Мы из Химок уже знаем маршрут до Солнцево наизусть — второй год подряд отправляем сына. Организация отличная, на связи можно быть когда хочешь» — Ольга, Химки"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь рядом с Зеленоградом 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Зеленоградом: ~70 км по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет. Загородный с проживанием, от 48 000 ₽."
  h1="Детский лагерь рядом с Зеленоградом"
  canonical="https://aidacamp.ru/lager-zelenograd"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Зеленограда до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Зеленограда — ~70 км по Киевскому шоссе через Одинцово и Наро-Фоминск, около 1.5 часа. Или доехать до м. Солнцево и пересесть на организованный трансфер лагеря (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." }
        },
        {
          "@type": "Question",
          "name": "Какие треки доступны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." }
        },
        {
          "@type": "Question",
          "name": "Когда открывается запись на смены 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Запись уже открыта. Смены в 2026: 30 мая–8 июня, 10–23 июня, 3–15 августа, 17–26 августа. Бронировать лучше заранее — места ограничены." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~70 км от Зеленограда. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Зеленоградом", "item": "https://aidacamp.ru/lager-zelenograd/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Зеленоградом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~70 км от Зеленограда по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Зеленограда"
    keywords={["~70 км от Зеленограда (~1–1.5 часа)", "IT-лагерь с проживанием: Python, AI, Minecraft", "Бассейн, 5-разовое питание, медработник 24/7"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-[#ec7c00] hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
