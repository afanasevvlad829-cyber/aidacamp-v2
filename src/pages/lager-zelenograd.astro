      "price": "99000",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/SoldOut"
    },
    {
      "@type": "Offer",
      "name": `Смена 3 (${DATES_SHORT_S3}, 13 дней)`,
      "price": "89400",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": `Смена 4 (${DATES_SHORT_S4}, 10 дней)`,
      "price": "74900",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "24"
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "target": "https://aidacamp.ru/lager-zelenograd"
  }
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детский лагерь — Зеленоград ${SEASON_YEAR}`}
    subtitle="АйДаКемп 2026 — лагерь в Наро-Фоминском районе, 80 км от Зеленограда. Доезжаете до м. Солнцево, передаёте сына или дочку нашему сопровождающему — и дальше всё."
    breadcrumb="Лагерь из Зеленограда"
    keywords={["80 км по Киевскому шоссе, 55–65 минут без пробок", "Трансфер от м. Солнцево бесплатно — 50–70 мин от Зеленограда", "Python, AI, Minecraft, Roblox, 3D — настоящие проекты за 7–14 дней"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ only={['medicine', 'safety', 'food', 'accommodation', 'communication', 'payment']} />
