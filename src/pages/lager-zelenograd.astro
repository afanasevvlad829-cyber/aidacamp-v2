---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Сколько ехать из Зеленограда — честно",
    text: "Из Крюково до КПП лагеря по навигатору — 78–82 км в зависимости от того, из какого района Зеленограда стартуете. На машине без пробок — 55–65 минут. В пятницу вечером — добавьте 20 минут на ЦКАД у Звенигорода. В лагере свой паркинг, шлагбаум, охрана пропустит по списку.",
    list: [
      "На машине: Зеленоград → ЦКАД (А-107) на юг → выход на М-3 «Украина» в районе Апрелевки → 8 км по съезду до лагеря",
      "На трансфере: автобус до Планерной или Речного → метро до Солнцево → наш сопровождающий. Общее время от дома — 50–70 минут",
      "В день заезда трансфер уезжает строго по расписанию (обычно 11:00, точное время — за день до смены в Telegram-чате родителей)",
      "В день отъезда забираем школьников и привозим обратно к Солнцево — родители встречают"
    ]
  },
  {
    h2: "Что мы делаем 7–14 дней",
    text: "АйДаКемп — это IT-лагерь, и под «IT» имеется в виду не «сажают за компьютеры». Имеется в виду — настоящие проекты, как у студентов первого курса МИЭТ, только адаптированные под 4-й класс и под 9-й.",
    list: [
      "Python — от переменных и циклов до телеграм-бота, которого подросток может показать одноклассникам. На прошлой смене сын инженера-микроэлектронщика из Зеленограда сделал бота, который дёргает погоду по API и шлёт маме напоминание взять зонт",
      "AI и нейросети — ChatGPT API, генерация картинок, простая обработка текста. Подростки 12+ за смену делают собственного AI-помощника",
      "Minecraft Education — внутри игры пишется реальный Python: мобы, постройки, механики. Самое популярное у мальчиков 8–11 лет",
      "Roblox Studio — собственный игровой мир на Lua. Девочки 10–13 любят больше всего — там можно дизайнить интерьер, делать одежду персонажам, попутно изучая логику",
      "3D в Blender + печать — моделируют фигурку и печатают на 3D-принтере прямо в лагере. Ребёнок увозит домой физический объект, который сам нарисовал",
      "Хакатон в конце смены — каждый защищает свой проект, родители получают видео"
    ]
  },
  {
    h2: "Почему Зеленоград — наша аудитория",
    text: "Это единственный округ Москвы, где IT — не модное слово, а семейный быт. Завод «Микрон» делает чипы. МИЭТ выпускает инженеров. Половина пап в Силино, Крюково и Старом городе работают в технологических компаниях. Когда мама вечером слышит «папа пишет код» — у школьника вопрос не «зачем», а «как».",
    text2: "К нам из Зеленограда едут потому, что родители знают разницу между «отдать на курсы программирования у дома» и «погрузить на 10 дней в среду, где код — это норма». Курсы — это два часа в неделю с домашкой. Лагерь — это среда. К третьему дню школьник перестаёт спрашивать «а во что поиграть», потому что вокруг шесть таких же, делающих что-то крутое."
  },
  {
    h2: "Смены 2026 и налоговый вычет",
    text: "Июль 2026 забронирован полностью. В июне и августе ещё есть места. В стоимость включены проживание 2–4 человека в комнате с душем, пятиразовое питание, ноутбуки (свои везти не надо), вся IT-программа, бассейн, спорт, врач 24/7, страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽ → налоговый вычет ~2 800 ₽",
      "Смена 2.2 — 16–23 июня, 8 дней, 75 000 ₽ → налоговый вычет ~5 800 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ → налоговый вычет до 5 434 ₽",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽ → налоговый вычет ~5 200 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽ → налоговый вычет ~4 800 ₽"
    ]
  },
  {
    h2: "Как добраться — по районам Зеленограда",
    text: "Маршрут зависит от вашего района:",
    list: [
      "15-й или 16-й микрорайон (Крюково): через Пятницкое шоссе → ЦКАД → М-3. Не выезжайте на Ленинградку — там светофоры и дольше",
      "Силино или Матушкино: через Старое Крюковское шоссе → А-107 → М-3",
      "На электричке без машины: до Ленинградского вокзала, метро до Солнцево, и там наш трансфер. Не экономьте через автобус Зеленоград–Внуково — пересадка с чемоданом и подростком в час пик нервы дороже",
      "Документы для поездки: свидетельство о рождении или паспорт, полис ОМС, справка 079/у, справка об отсутствии контактов, прививочный сертификат, анализ на энтеробиоз, СНИЛС. Справку 079/у делает участковый педиатр — в Зеленограде это поликлиники №105, 201, 230, обычно за 2–3 дня"
    ]
  },
  {
    h2: "Что родители из Зеленограда писали после смены",
    text: "Несколько отзывов от семей из разных районов:",
    list: [
      "«Везла на трансфер с опаской — никогда не отдавала на больше чем 3 дня. Через неделю забрала ребёнка, который сам поставил себе VS Code дома и пишет каких-то ботов. Я не понимаю что он делает, но вижу что он занят и счастлив». — Алёна, мама Серёжи из 14-го мкр.",
      "«Сам инженер в Микроне, дочь раньше говорила что программирование — это для мальчиков. После Roblox смены сделала папе на день рождения интерактивную открытку в коде. Папа плакал». — Дмитрий, папа Тани, 12 лет",
      "«Оба близнеца сразу. Один в Python, второй в Minecraft. Впервые за лето не дрались — обсуждали что у кого получилось». — Марина, мама близнецов 10 лет"
    ]
  },
  {
    h2: "Часто спрашивают",
    text: "",
    list: [
      "Как далеко от Зеленограда на самом деле? — 80 километров. На машине без пробок — час. С трансфером от Солнцево — общее время в пути около 1 ч 40 мин",
      "Можно ли приехать навестить? — Можно, любой день кроме первого и последнего. Час дороги, посидите с ребёнком в кафе на территории. Многие родители из Зеленограда так и делают на середине смены",
      "Если школьник никогда не программировал? — Большинство наших — именно такие. Деление по уровням в первый день: новички начинают со Scratch и Minecraft, продвинутые — с Python. К третьему дню разница стирается",
      "Сколько школьников в группе? — До 8 человек на преподавателя. Это принципиальная цифра — больше нельзя качественно вести проект",
      "А если не понравится? — В первые 3 дня смен от 10 дней возвращаем 50% и привозим обратно к Солнцево. За шесть лет таких случаев было два, оба раза потом просились вернуться на следующую смену"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь Зеленоград 2026 — IT-смена, трансфер от Солнцево"
  description="АйДаКемп в Наро-Фоминском районе, 80 км по Киевскому шоссе (~1 час). Трансфер от м. Солнцево. Python, AI, Minecraft для школьников 7–15 лет. От 48 000 ₽."
  h1="Лагерь из Зеленограда — 80 км, час по навигатору"
  canonical="https://aidacamp.ru/lager-zelenograd"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Зеленограда до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Зеленограда — ~80 км по Киевскому шоссе М-3 через МКАД (южный объезд), около 1 часа без пробок. Не нужно ехать через центр Москвы — сразу по МКАД на юг к Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Откуда стартует трансфер до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер отправляется от м. Солнцево. Из Зеленограда добраться туда просто: автобус до м. Планерная и метро до м. Солнцево — около 40–45 минут." }
        },
        {
          "@type": "Question",
          "name": "Долго ли ехать из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа на машине через МКАД и Киевское шоссе. На метро+трансфере — около 40 мин до м. Солнцево. Главное — не нужно ехать через центр Москвы." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер непосредственно из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Зеленограда нет, но ехать до точки сбора у м. Солнцево легко — метро через м. Планерная, около 40–45 минут. Дальше бесплатный автобус лагеря везёт ребёнка прямо на место." }
        },
        {
          "@type": "Question",
          "name": "Для каких ребят подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для школьников 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." }
        },
        {
          "@type": "Question",
          "name": "Какие треки доступны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." }
        },
        {
          "@type": "Question",
          "name": "Когда открывается запись на смены 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Запись уже открыта. Июль 2026 занят полностью. В июне и августе ещё есть места. Бронировать лучше заранее — места ограничены." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~80 км от Зеленограда. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Зеленоградом", "item": "https://aidacamp.ru/lager-zelenograd/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь из Зеленограда — 80 км, час по навигатору"
    subtitle="Летний лагерь зеленоград — АйДаКемп в Наро-Фоминском районе. Доезжаете до м. Солнцево, передаёте сына или дочку нашему сопровождающему — и дальше всё."
    breadcrumb="Лагерь из Зеленограда"
    keywords={["80 км по Киевскому шоссе, 55–65 минут без пробок", "Трансфер от м. Солнцево бесплатно — 50–70 мин от Зеленограда", "Python, AI, Minecraft, Roblox, 3D — настоящие проекты за 7–14 дней"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
