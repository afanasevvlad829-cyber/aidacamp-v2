---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_S2, DAYS_S21, DAYS_S22, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';
import { STAT_RATING, STAT_INSURED } from '../data/contacts';
import { SEASON_MONTHS_NOM, PAST_SHIFTS_SENTENCE, OPEN_MONTHS_RANGE_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Сколько ехать до нас — честно",
    text: "Из Крюково до КПП — 78–82 км (Зеленоград → Киевское шоссе → КПП), около часа без пробок. Территория закрытая, со своим паркингом и охраной по списку."
  },
  {
    h2: "Что мы делаем 7–14 дней",
    text: "Шесть направлений на выбор — Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D в Blender. В финале — хакатон: команда защищает свой проект."
  },
  {
    h2: `Смены ${SEASON_YEAR} и налоговый вычет`,
    text: `${PAST_SHIFTS_SENTENCE} — открыты смены ${OPEN_MONTHS_RANGE_NOM}, места ещё есть. В стоимость входят проживание 2–4 человека с душем, питание, ноутбуки, IT-программа, бассейн, спорт, врач 24/7 — по договору и лицензии, ${STAT_INSURED.toLowerCase()}, рейтинг ${STAT_RATING} на Яндекс.Картах.`
  },
  {
    h2: "Что оформить перед сменой",
    text: "Комплект документов один для всех: свидетельство о рождении или паспорт, полис ОМС, справка 079/у, справка об отсутствии контактов, прививочный сертификат, анализ на энтеробиоз, СНИЛС. 079/у выдают поликлиники №105, 201, 230 (2–3 дня)."
  },
  {
    h2: "Что зеленоградские родители писали после смены",
    text: `Цитату с чужим именем сюда ставить нечестно, поэтому — ссылки на первоисточник: ${otzyvyLink('отзывы родителей на сайте')} и карточка на ${yandexReviewsLink()}.`
  },
  {
    h2: "Часто спрашивают",
    text: "",
    list: [
      "Если школьник никогда не программировал? — Большинство наших именно такие: начинают со Scratch и Minecraft, к третьему дню разница стирается",
      '«А если не понравится?» — <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">Условия гарантии возврата →</a> За шесть лет таких случаев было два'
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="IT-лагерь для детей из Зеленограда — Python, Minecraft, AI | АйДаКемп"
  description={`IT-лагерь АйДаКемп для детей из Зеленограда. Программирование: Python, AI, Minecraft, Roblox, 3D для ребят 7–15 лет. Трансфер от м. Солнцево. Смены ${SEASON_MONTHS_NOM}, отправление из Зеленограда.`}
  h1={`Детский лагерь для ребят из Зеленограда с программированием и Minecraft`}
  canonical="https://aidacamp.ru/lager-zelenograd"
  breadcrumb="Маршрут и программа"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~80 км от Зеленограда. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />

    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Camp",
  "name": "АйДаКемп — IT-лагерь для школьников",
  "description": "Летний лагерь программирования и IT для детей 7-17 лет из Москвы",
  "url": "https://aidacamp.ru/lager-zelenograd",
  "image": "https://aidacamp.ru/og-image.jpg",
  "areaServed": {
    "@type": "City",
    "name": "Зеленоград"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": `Смена 2.1 (${DATES_SHORT_S21}, ${DAYS_S21}) — завершена`,
      "price": "48000",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/SoldOut"
    },
    {
      "@type": "Offer",
      "name": `Смена 2 (${DATES_SHORT_S2}, ${DAYS_S2}) — завершена`,
      "price": "99000",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/SoldOut"
    },
    {
      "@type": "Offer",
      "name": `Смена 3 (${DATES_SHORT_S3}, ${DAYS_S3})`,
      "price": "89400",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": `Смена 4 (${DATES_SHORT_S4}, ${DAYS_S4})`,
      "price": "74900",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "24"
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "target": "https://aidacamp.ru/lager-zelenograd"
  }
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детский лагерь для ребят из Зеленограда с программированием и Minecraft`}
    subtitle={`АйДаКемп ${SEASON_YEAR} — IT-лагерь в Наро-Фоминском районе, 80 км от города. Доезжаете до м. Солнцево, передаёте сына или дочку нашему сопровождающему — и дальше всё.`}
    breadcrumb="Маршрут и программа"
    keywords={[`80 км по Киевскому шоссе, трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT}`, "Python, AI, Minecraft, Roblox, 3D — настоящие проекты за 7–14 дней"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="IT-программа для детей рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как добраться из Зеленограда до нас?", a: `~80 км по Киевскому шоссе М-3 через МКАД, около часа без пробок. Без машины — автобус до м. Планерная, метро до м. Солнцево, дальше трансфер (${TRANSFER_PRICE_FMT}, с сопровождающим).` },
    { q: "Для каких ребят подходит эта программа?", a: "Формат подходит школьникам 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." },
    { q: "Какие треки доступны?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." },
    { q: `Когда открывается запись на смены ${SEASON_YEAR}?`, a: "Запись уже открыта. Июль занят полностью, в июне и августе ещё есть места — бронировать лучше заранее." }
  ]} only={['medicine', 'safety', 'food', 'accommodation', 'communication', 'payment']} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">IT-программа в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться</a> — <a href="/lager-klin/" class="text-primary hover:underline">лагерь рядом с Клином</a>
    </p>
  </div>

<section class="internal-links-section" style="background: #f9f9f9; padding: 24px; margin: 32px 0; border-radius: 8px; border-left: 4px solid #3b82f6;">
  <h2 style="font-size: 18px; margin-top: 0; color: var(--color-gray-800);">Выбирайте программу под интересы ребёнка</h2>
  <p style="color: var(--color-gray-600); line-height: 1.6; margin-bottom: 16px;">
    Посмотрите подробное описание всех <a href="/stati/programma-it-lagerya/" style="color: var(--color-blue); text-decoration: underline; font-weight: 500;">IT-программ</a> — от Python и AI до Minecraft и 3D-печати.
  </p>
  <p style="color: var(--color-gray-600); line-height: 1.6; margin: 0;">
    Узнайте точную <a href="/ceny/" style="color: var(--color-blue); text-decoration: underline; font-weight: 500;">стоимость смены и налоговый вычет</a> — для родителей из Москвы по открытым августовским сменам вернётся ~{VYCHET_S4}–{VYCHET_S3} в виде вычета.
  </p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
