---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Зеленоград — российская «Кремниевая долина»",
    text: "Зеленоград — место, где производят российские чипы (завод Micron), расположен МИЭТ, и живут тысячи IT-семей. Когда папа разрабатывает микроэлектронику, а мама пишет код — ребёнок хочет попробовать тоже. АйДаКемп — лагерь, где это «попробовать» превращается в настоящий проект. Возможно, именно отсюда выйдет следующий выпускник МИЭТ."
  },
  {
    h2: "Маршрут из Зеленограда в АйДаКемп — ~80 км, ~1 ч",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области. Из Зеленограда добираться удобнее, чем кажется — ехать не через центр Москвы, а сразу на юг по МКАД к Киевскому шоссе М-3.",
    list: [
      "На машине: Зеленоград → МКАД (южный объезд) → Киевское шоссе М-3 → Апрелевка, ~80 км, около 1 часа без пробок",
      "На общественном транспорте: из Зеленограда автобус до м. Планерная, затем метро до м. Солнцево — итого 40–50 минут",
      "Трансфер от м. Солнцево бесплатно в день заезда и обратно в день отъезда"
    ]
  },
  {
    h2: "Трансфер из Зеленограда в лагерь",
    text: "Бесплатный трансфер лагеря отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Зеленограда до м. Солнцево — около 40–45 минут через м. Планерная. Ребёнка достаточно проводить до точки сбора, дальше всё берёт на себя команда лагеря.",
    list: [
      "Трансфер бесплатный, от м. Солнцево в день заезда — точное время уточняется при бронировании",
      "Из Зеленограда до м. Солнцево: автобус → м. Планерная → метро, итого ~40–45 мин",
      "В день отъезда трансфер обратно до м. Солнцево — забрать можно в любое удобное время",
      "Альтернатива: привезти ребёнка на машине прямо в лагерь — около 1 часа"
    ]
  },
  {
    h2: "Что делают зеленоградские ребята в АйДаКемп",
    text: "АйДаКемп — IT-лагерь с настоящим программированием. Школьники из Зеленограда особенно быстро вписываются: технический округ, где многие папы и мамы работают в IT. Ребёнок с первого дня видит: программирование — это не скучно, это про создание.",
    list: [
      "Python — от первой переменной до собственного Telegram-бота за 10 дней",
      "AI и нейросети — учатся работать с ChatGPT API и делают своего AI-помощника",
      "Minecraft Education — пишут код прямо в любимой игре, это настоящий Python",
      "Roblox Studio — создают собственный игровой мир на Lua",
      "3D-моделирование в Blender — и потом печатают свою фигурку на 3D-принтере",
      "Хакатон в конце смены: каждый защищает проект перед всей группой"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Зеленограда",
    text: "АйДаКемп — лицензированная образовательная организация, поэтому родители могут вернуть 13% от стоимости образовательной части смены. Документы оформляются через личный кабинет налоговой на сайте ФНС.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽ (максимум)",
      "Документы (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Почему родители из Зеленограда выбирают АйДаКемп",
    text: "Зеленоград — самый зелёный округ Москвы, и АйДаКемп тоже в сосновом лесу. Плюс практические преимущества:",
    list: [
      "Подмосковье рядом — нет перелёта, нет акклиматизации, ребёнок здоров с первого дня",
      "В любой день смены можно приехать — около часа езды и ты рядом",
      "Трансфер бесплатный от м. Солнцево — 40–50 минут от Зеленограда на метро",
      "Та же часовая зона, тот же климат — ребёнок спит нормально с первой ночи"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Зеленограда",
    text: "В АйДаКемп едут ребята из Зеленограда, Солнечногорска, Химок и северного Подмосковья. Вот что говорят родители:",
    list: [
      "«Доехала из Зеленограда до м. Солнцево за 35 минут, пересадила сына на автобус — и всё. 10 дней не звонил, потому что был занят проектом на Python. Это победа!» — Марина, мама Артёма, 13 лет",
      "«Дочка из Солнечногорска сначала скептически — мол, лагерь скучно. Вернулась с готовым Roblox-миром и просила записать на следующую смену прямо в машине» — Екатерина, Солнечногорск",
      "«Мы из Химок уже знаем маршрут до м. Солнцево наизусть — второй год подряд отправляем сына. Организация отличная» — Ольга, Химки"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский лагерь для Зеленограда 2026 — ~1 час, IT-программа"
  description="IT-лагерь ~80 км от Зеленограда по Киевскому шоссе, ~1 час. Трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Зеленоградом 2026"
  canonical="https://aidacamp.ru/lager-zelenograd"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Зеленограда до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Зеленограда — ~80 км по Киевскому шоссе М-3 через МКАД (южный объезд), около 1 часа без пробок. Не нужно ехать через центр Москвы — сразу по МКАД на юг к Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Откуда стартует трансфер до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер отправляется от м. Солнцево. Из Зеленограда добраться туда просто: автобус до м. Планерная и метро до м. Солнцево — около 40–45 минут." }
        },
        {
          "@type": "Question",
          "name": "Долго ли ехать из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа на машине через МКАД и Киевское шоссе. На метро+трансфере — около 40 мин до м. Солнцево. Главное — не нужно ехать через центр Москвы." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер непосредственно из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Зеленограда нет, но ехать до точки сбора у м. Солнцево легко — метро через м. Планерная, около 40–45 минут. Дальше бесплатный автобус лагеря везёт ребёнка прямо на место." }
        },
        {
          "@type": "Question",
          "name": "Для каких ребят подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для школьников 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." }
        },
        {
          "@type": "Question",
          "name": "Какие треки доступны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." }
        },
        {
          "@type": "Question",
          "name": "Когда открывается запись на смены 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Запись уже открыта. Июль 2026 занят полностью. В июне и августе ещё есть места. Бронировать лучше заранее — места ограничены." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~80 км от Зеленограда. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Зеленоградом", "item": "https://aidacamp.ru/lager-zelenograd/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Зеленоградом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~80 км от Зеленограда по Киевскому шоссе, ~1 час. Трансфер от м. Солнцево бесплатно."
    breadcrumb="Лагерь из Зеленограда"
    keywords={["~80 км от Зеленограда (~1 час), трансфер от м. Солнцево бесплатно", "IT-лагерь с проживанием: Python, AI, Minecraft", "Бассейн, 5-разовое питание, медработник 24/7"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
