---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Маршрут из Зеленограда в АйДаКемп — ~70 км, ~1 ч 20 мин",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области. Из Зеленограда добираться удобнее, чем кажется — ехать не через центр Москвы, а сразу на юг по МКАД к Калужскому шоссе А-101.",
    list: [
      "На машине: Зеленоград → МКАД (выезд на юг) → Калужское шоссе А-101 → Апрелевка → ~70 км, около 1 часа 20 минут без пробок",
      "На общественном транспорте: из Зеленограда до м. Планерная (автобус), далее метро до м. Солнцево — итого 40–50 минут",
      "Из Зеленограда удобно: не нужно тащиться через центр Москвы, просто южный объезд по МКАД и прямо на Калужское шоссе"
    ]
  },
  {
    h2: "Трансфер из Зеленограда в лагерь",
    text: "Лагерь организует бесплатный трансфер от м. Солнцево в день заезда, и обратно — в день отъезда. Из Зеленограда до м. Солнцево проще всего добраться на метро через м. Планерная — займёт около 40–45 минут. Ребёнка достаточно проводить до точки сбора, дальше всё берёт на себя команда лагеря.",
    list: [
      "Трансфер отправляется от м. Солнцево в день заезда — точное время уточняется при бронировании",
      "Из Зеленограда до м. Солнцево: автобус → м. Планерная → метро, итого ~40 мин",
      "В день отъезда трансфер обратно до м. Солнцево — забрать ребёнка удобно в любое время",
      "Альтернатива: привезти ребёнка на машине прямо в лагерь — занимает чуть больше часа"
    ]
  },
  {
    h2: "Что делают зеленоградские дети в АйДаКемп",
    text: "АйДаКемп — IT-лагерь с настоящим программированием, не «игровой». Дети из Зеленограда особенно хорошо вписываются: технический округ, где многие папы и мамы работают в IT. Ребёнок с первого дня видит: программирование — это не скучно, это про создание.",
    list: [
      "Python — от первой переменной до собственного Telegram-бота за 10 дней",
      "AI и нейросети — учатся работать с ChatGPT API и делают своего AI-помощника",
      "Minecraft Education — пишут код прямо в любимой игре, это настоящий Python",
      "Roblox Studio — создают собственный игровой мир на Lua",
      "3D-моделирование в Blender — и потом печатают свою фигурку на 3D-принтере",
      "Хакатон в конце смены: каждый защищает проект перед всей группой"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Зеленограда",
    text: "АйДаКемп — лицензированная образовательная организация, поэтому родители могут вернуть 13% от стоимости образовательной части смены. Документы стандартные, оформляются через личный кабинет налоговой на сайте ФНС. Никаких сложностей: мы выдаём нужный пакет документов.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽ (максимум)",
      "Подробнее о документах и формуле расчёта: раздел «Налоговый вычет» на сайте"
    ]
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в игры в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Зеленограда выбирают АйДаКемп",
    text: "Зеленоград — самый зелёный район Москвы, и АйДаКемп тоже в сосновом лесу. Плюс практические плюсы:",
    list: [
      "Подмосковье рядом — нет перелёта, нет акклиматизации, ребёнок здоров с первого дня",
      "В любой день смены можно приехать — 1.5 часа и ты рядом с ребёнком",
      "Трансфер бесплатный от м. Солнцево — 40–50 минут от Зеленограда на метро",
      "Та же часовая зона, тот же климат — ребёнок спит нормально с первой ночи"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Зеленограда",
    text: "В АйДаКемп едут дети из Зеленограда, Солнечногорска, Химок и северного Подмосковья. Вот что говорят родители:",
    list: [
      "«Доехала из Зеленограда до м. Солнцево за 35 минут, пересадили сына на автобус — и всё. 10 дней не звонил, потому что был занят проектом на Python. Это победа!» — Марина, мама Артёма, 13 лет",
      "«Дочка из Солнечногорска сначала скептически — мол, лагерь скучно. Вернулась с готовым Roblox-миром и просила записать на следующую смену прямо в машине» — Екатерина, Солнечногорск",
      "«Мы из Химок уже знаем маршрут до м. Солнцево наизусть — второй год подряд отправляем сына. Организация отличная, на связи можно быть когда хочешь» — Ольга, Химки"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Зеленоградом 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Зеленоградом: ~70 км по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет. Загородный с проживанием, от 48 000 ₽."
  h1="Детский лагерь рядом с Зеленоградом"
  canonical="https://aidacamp.ru/lager-zelenograd"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Зеленограда до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Зеленограда — ~70 км по Калужскому шоссе А-101 через МКАД (южный объезд), около 1 часа 20 минут без пробок. Не нужно ехать через центр Москвы — сразу по МКАД на юг к Калужскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Откуда стартует трансфер до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Трансфер отправляется от м. Солнцево. Из Зеленограда добраться туда просто: автобус до м. Планерная и метро до м. Солнцево — около 40–45 минут. Трансфер в день заезда бесплатный." }
        },
        {
          "@type": "Question",
          "name": "Долго ли ехать из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа 20 минут на машине через МКАД и Калужское шоссе. На метро+трансфере — около 40 мин до м. Солнцево плюс время поездки автобусом. Главное — не нужно ехать через центр Москвы." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер непосредственно из Зеленограда?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Зеленограда нет, но ехать до точки сбора у м. Солнцево легко — метро через м. Планерная, около 40–45 минут. Дальше автобус лагеря везёт ребёнка прямо на место." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт не нужен. Группы для начинающих, среднего и продвинутого уровня — до 8 человек. Преподаватели-практики из IT." }
        },
        {
          "@type": "Question",
          "name": "Какие треки доступны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при регистрации. В конце смены — хакатон с защитой проекта." }
        },
        {
          "@type": "Question",
          "name": "Когда открывается запись на смены 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Запись уже открыта. Смены в 2026: 30 мая–8 июня, 10–23 июня, 3–15 августа, 17–26 августа. Бронировать лучше заранее — места ограничены." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Зеленоградом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~70 км от Зеленограда. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-zelenograd"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Зеленоградом", "item": "https://aidacamp.ru/lager-zelenograd/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Зеленоградом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~70 км от Зеленограда по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Зеленограда"
    keywords={["~70 км от Зеленограда (~1–1.5 часа)", "IT-лагерь с проживанием: Python, AI, Minecraft", "Бассейн, 5-разовое питание, медработник 24/7"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Зеленоградом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
