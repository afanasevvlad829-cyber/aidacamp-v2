---
import LandingLayout from '../layouts/LandingLayout.astro';
import ShiftModal from '../components/ShiftModal.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { SEASON_YEAR } from '../data/shifts';

const title = "Питание детей в детском IT-лагере АйДаКемп — меню по СанПиН в Подмосковье";
const description = "Питание в детском IT-лагере АйДаКемп: 5 приёмов пищи в день, меню по СанПиН, горячие блюда, фрукты и соки. Дети полноценно питаются и занимаются программированием. Подмосковье, 66 км от МКАД.";
const h1 = "Питание детей в детском IT-лагере АйДаКемп в Подмосковье";
const canonical = "https://aidacamp.ru/pitanie";

// Единый список: из него и видимый accordion, и FAQPage. Раньше в slot="head" лежал
// ОТДЕЛЬНЫЙ список с другими формулировками — размеченными оказывались вопросы,
// которых на странице нет («Сколько раз в день кормят в лагере АйДаКемп?» против
// видимого «Сколько раз в день кормят?»), 31.07.2026.
const faqItems = [
  {
    q: "Сколько раз в день кормят?",
    a: "Пять: завтрак, второй завтрак, обед, полдник и ужин. Три основных приёма — обязательно с горячим блюдом. Всё готовится на кухне санатория «Изумруд», на территории, и уже включено в стоимость путёвки — доплачивать за еду не нужно.",
  },
  {
    q: "А если ребёнок привередлив в еде?",
    a: "На обед и ужин есть выбор из двух горячих и двух салатов, так что вариант «ничего не хочу» встречается редко. Плюс между основными приёмами — второй завтрак и полдник с фруктом, выпечкой или кисломолочным. Голодным ребёнок не останется даже в самый капризный день.",
  },
  {
    q: "Как учитываются аллергии?",
    a: "По справке от врача — укажите особенности при бронировании, до заезда. Повара получают список заранее и учитывают его при раскладке порций. Не полагайтесь на то, что ребёнок сам предупредит в столовой: в первый день он занят знакомством, а не своим рационом.",
  },
  {
    q: "Можно ли привезти еду из дома?",
    a: "Конфеты и печенье — можно. Полноценную домашнюю еду везти не нужно: она портится в тепле, а пяти приёмов в день хватает с запасом. Орехи, сухофрукты и батончики удобно положить в сумку на дорогу.",
  },
  {
    q: "Кто следит, что ребёнок действительно поел?",
    a: "Вожатый сопровождает отряд на каждый приём пищи: следит, чтобы никто не пропустил еду, а в первые дни помогает ребятам с тарелками. Меню и список ограничений по здоровью параллельно контролирует медработник.",
  },
];

const meals = [
  { time: "08:00", name: "Завтрак", icon: "bi-sun" },
  { time: "10:30", name: "Второй завтрак", icon: "bi-cup-hot" },
  { time: "13:00", name: "Обед", icon: "bi-fire" },
  { time: "16:30", name: "Полдник", icon: "bi-tree" },
  { time: "19:00", name: "Ужин", icon: "bi-moon" },
];

// Примерное меню на 3 дня по СанПиН 2.3/2.4.3590-20 для детских лагерей
const menu = [
  {
    day: "День 1",
    breakfast: "Каша овсяная молочная с маслом, бутерброд с сыром, какао с молоком",
    second_breakfast: "Яблоко, печенье",
    lunch: "Борщ со сметаной · Горячее на выбор: котлета куриная с картофельным пюре / овощная запеканка с сыром · Салат на выбор: из свежих огурцов / из капусты с морковью · Компот",
    snack: "Кефир, булочка",
    dinner: "Горячее на выбор: плов с курицей / тефтели с картофельным пюре · Свежие овощи, чай с лимоном",
  },
  {
    day: "День 2",
    breakfast: "Омлет с зеленью, хлеб с маслом, чай с сахаром",
    second_breakfast: "Груша, вафли",
    lunch: "Суп куриный с лапшой · Горячее на выбор: гуляш говяжий с гречкой / тушёные овощи с сыром · Салат на выбор: из свежей капусты / из помидоров с зеленью · Сок",
    snack: "Кефир, пряник",
    dinner: "Горячее на выбор: макароны с тефтелями / с овощным соусом · Свежий огурец, кисель",
  },
  {
    day: "День 3",
    breakfast: "Творожная запеканка со сметаной, хлеб с маслом, какао с молоком",
    second_breakfast: "Апельсин, крекер",
    lunch: "Щи из свежей капусты · Горячее на выбор: курица тушёная с овощами / картофельная запеканка · Салат на выбор: из свежих огурцов и помидоров / из моркови с изюмом · Компот",
    snack: "Йогурт, печенье",
    dinner: "Горячее на выбор: рыба запечённая с картофельным пюре / куриный шницель с гречкой · Хлеб, чай с сахаром",
  },
];
---

<LandingLayout
  breadcrumb="Питание в лагере"
  title={title}
  description={description}
  h1={h1}
  canonical={canonical}
>
  <Fragment slot="head">
    <FAQSchema items={faqItems} />
  </Fragment>
  <Fragment slot="hero">
    <section class="relative bg-[#0d1a2b] text-white overflow-hidden" data-hero-bg="fireflies">
      <div class="absolute inset-0">
        <img
          src="/images/food/food-hall.avif"
          alt="Столовая лагеря АйДаКемп"
          class="w-full h-full object-cover opacity-30"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0d1a2b]/60 via-transparent to-[#0d1a2b]/80"></div>
      </div>
      <div class="relative mx-auto max-w-[1312px] px-4 py-16 md:py-24 text-center">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <i class="bi bi-patch-check-fill text-primary" aria-hidden="true"></i>
          СанПиН 2.3/2.4.3590-20 — соблюдается
        </div>
        <p class="text-white/70 text-sm md:text-base max-w-2xl mx-auto mb-4">
          Рацион питания в детском летнем лагере составлен в соответствии с требованиями СанПиН 2.3/2.4.3590-20 и одобрен Роспотребнадзором.
        </p>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4">
          Питание детей в детском IT-лагере АйДаКемп в Подмосковье
        </h1>
        <p class="text-lg md:text-xl text-white/75 max-w-2xl mx-auto">
          5 раз в день, горячие блюда, фрукты и соки — всё по нормативу Роспотребнадзора
        </p>
      </div>
    </section>
  </Fragment>

  <!-- Расписание приёмов пищи -->
  <section class="mx-auto max-w-[1312px] px-4 pt-12 pb-8">
    <h2 class="text-2xl md:text-3xl font-black text-[#0d1a2b] mb-2 text-center">5 приёмов пищи в день</h2>
    <p class="text-center text-gray-500 mb-8">Никаких перекусов чипсами — только нормальная еда по расписанию</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
      {meals.map(m => (
        <div class="bg-[#f7f5f2] rounded-2xl p-4 text-center">
          <i class={`bi ${m.icon} text-[28px] text-primary`} aria-hidden="true"></i>
          <div class="mt-2 text-xl font-black text-[#0d1a2b]">{m.time}</div>
          <div class="text-sm font-semibold text-gray-600 mt-0.5">{m.name}</div>
        </div>
      ))}
    </div>
    <p class="text-center text-gray-500 mt-6 max-w-2xl mx-auto">Стабильный режим питания — система пяти приёмов в день, где основные (завтрак, обед, ужин) включают горячее блюдо, и два перекуса (второй завтрак и полдник) — по расписанию ежедневно. Дети в лагере много двигаются, поэтому сытный день важен, когда впереди программирование и активные игры.</p>
  </section>

  <!-- Фото -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="col-span-2 rounded-2xl overflow-hidden aspect-[16/9]">
        <img src="/images/food/food-buffet.avif" alt="Шведский стол в лагере АйДаКемп" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="rounded-2xl overflow-hidden aspect-square">
        <img src="/images/food/food-tray.avif" alt="Тарелка с обедом" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="rounded-2xl overflow-hidden aspect-square">
        <img src="/images/food/food-kids-peace.avif" alt="Дети обедают в лагере" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Примерное меню -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <h2 class="text-2xl md:text-3xl font-black text-[#0d1a2b] mb-2">Примерное меню</h2>
    <p class="text-gray-500 mb-8">Составлено по санитарным нормам <a href="https://www.rospotrebnadzor.ru/" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">СанПиН 2.3/2.4.3590-20</a> для детских оздоровительных лагерей. Дети едят с аппетитом, а реальное меню может отличаться по дням.</p>

    <div class="grid md:grid-cols-3 gap-6">
      {menu.map(day => (
        <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm">
          <div class="bg-primary text-white text-center py-2.5 font-black text-lg">{day.day}</div>
          <div class="p-5 space-y-3 text-sm">
            <div>
              <div class="flex items-center gap-1.5 font-bold text-[#0d1a2b] mb-1">
                <i class="bi bi-sun text-primary" aria-hidden="true"></i> Завтрак
              </div>
              <p class="text-gray-600">{day.breakfast}</p>
            </div>
            <div>
              <div class="flex items-center gap-1.5 font-bold text-[#0d1a2b] mb-1">
                <i class="bi bi-cup-hot text-primary" aria-hidden="true"></i> 2-й завтрак
              </div>
              <p class="text-gray-600">{day.second_breakfast}</p>
            </div>
            <div>
              <div class="flex items-center gap-1.5 font-bold text-[#0d1a2b] mb-1">
                <i class="bi bi-fire text-primary" aria-hidden="true"></i> Обед
              </div>
              <div class="text-gray-600 space-y-1">
                {day.lunch.split(' · ').map((part) => {
                  if (!part.includes('на выбор:')) return <p class="text-gray-600">{part}</p>;
                  const label = (part.match(/^(.+?) на выбор:/) ?? ['',''])[1];
                  const options = part.replace(/^[^:]+:\s*/, '');
                  return (
                    <div class="rounded-lg bg-orange-50 border border-orange-100 px-2.5 py-1.5">
                      <span class="text-[11px] font-semibold text-orange-600 uppercase tracking-wide">{label} — на выбор</span>
                      <p class="mt-0.5">{options}</p>
                    </div>
                  );
                })}
              </div>
            </div>
            <div>
              <div class="flex items-center gap-1.5 font-bold text-[#0d1a2b] mb-1">
                <i class="bi bi-tree text-primary" aria-hidden="true"></i> Полдник
              </div>
              <p class="text-gray-600">{day.snack}</p>
            </div>
            <div>
              <div class="flex items-center gap-1.5 font-bold text-[#0d1a2b] mb-1">
                <i class="bi bi-moon text-primary" aria-hidden="true"></i> Ужин
              </div>
              <div class="text-gray-600 space-y-1">
                {day.dinner.split(' · ').map((part) => {
                  if (!part.includes('на выбор:')) return <p class="text-gray-600">{part}</p>;
                  const label = (part.match(/^(.+?) на выбор:/) ?? ['',''])[1];
                  const options = part.replace(/^[^:]+:\s*/, '');
                  return (
                    <div class="rounded-lg bg-orange-50 border border-orange-100 px-2.5 py-1.5">
                      <span class="text-[11px] font-semibold text-orange-600 uppercase tracking-wide">{label} — на выбор</span>
                      <p class="mt-0.5">{options}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Как работает выбор блюда -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <div class="bg-white rounded-3xl border border-slate-200 p-6 md:p-10">
      <h2 class="text-2xl font-black text-[#0d1a2b] mb-4">Почему в меню «на выбор»</h2>
      <p class="text-slate-600 leading-[1.7] max-w-[760px] mb-4">
        Самая частая мамина тревога про лагерь звучит так: «а если он это не ест?». Поэтому на обед
        и на ужин горячее и салат идут в двух вариантах — ребёнок выбирает сам, уже стоя у раздачи,
        а не выбирает между «есть невкусное» и «остаться голодным».
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-2xl bg-orange-50 border border-orange-100 p-5">
          <p class="font-semibold text-[#0d1a2b] mb-1.5">Горячее — два варианта</p>
          <p class="text-[15px] text-slate-600 leading-[1.6]">Один из них всегда без мяса: овощная запеканка с сыром, тушёные овощи, картофельная запеканка. Отдельно предупреждать об этом не нужно — безмясной вариант есть в каждом обеде и ужине.</p>
        </div>
        <div class="rounded-2xl bg-orange-50 border border-orange-100 p-5">
          <p class="font-semibold text-[#0d1a2b] mb-1.5">Салат — два варианта</p>
          <p class="text-[15px] text-slate-600 leading-[1.6]">Огурцы, помидоры, капуста с морковью, морковь с изюмом — чередуются по дням. Ребята, которые дома овощи игнорируют, в столовой берут их заметно охотнее: сосед по столу взял — и он взял.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Что важно знать -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <div class="bg-[#f7f5f2] rounded-3xl p-6 md:p-10">
      <h2 class="text-2xl font-black text-[#0d1a2b] mb-6">Что важно знать родителям о питании</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: "bi-check-circle-fill", text: "Аллергии и индивидуальные непереносимости учитываем по справке от врача" },
          { icon: "bi-check-circle-fill", text: "Питьевая вода — бесплатно в свободном доступе весь день" },
          { icon: "bi-check-circle-fill", text: "Горячие и холодные напитки — на каждом приёме пищи: какао, чай, компот, кисель, сок чередуются по дням" },
          { icon: "bi-check-circle-fill", text: "Столовая на территории лагеря, добираться никуда не нужно. Горячий стол накрывается строго по расписанию — пропуск приёма пищи не предусмотрен" },
          { icon: "bi-check-circle-fill", text: "Витаминный перекус — свежие фрукты ежедневно: яблоки, груши, апельсины по сезону" },
          { icon: "bi-check-circle-fill", text: "Горячее питание — не привозное: готовится на собственной кухне из свежих продуктов, по-домашнему, а не централизованная доставка" },
          { icon: "bi-check-circle-fill", text: "Мясные и рыбные блюда — ежедневно: котлеты, гуляш, плов, тефтели, тушёная курица с овощами и запечённая рыба чередуются по меню" },
          { icon: "bi-check-circle-fill", text: "Выпечка и хлебобулочные изделия — часть ежедневного меню: булочка, пряник, вафли или крекер включены в завтрак и полдник" },
          { icon: "bi-check-circle-fill", text: "Сладкое разрешено — конфеты и печенье из дома без ограничений" },
        ].map(item => (
          <div class="flex gap-3 items-start">
            <i class={`bi ${item.icon} text-primary text-[18px] mt-0.5 flex-shrink-0`} aria-hidden="true"></i>
            <p class="text-gray-700 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Частые вопросы -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <div class="max-w-[860px]">
      <h2 class="text-2xl font-black text-[#0d1a2b] mb-6">Частые вопросы о питании</h2>
      <div class="flex flex-col gap-6">
        {faqItems.map(item => (
          <div>
            <p class="text-[17px] font-semibold text-[#0d1a2b] mb-2">{item.q}</p>
            <p class="text-[16px] leading-[1.7] text-slate-600">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Фото столовой -->
  <section class="mx-auto max-w-[1312px] px-4 py-8">
    <div class="rounded-2xl overflow-hidden aspect-[21/9]">
      <img src="/images/food/food-buffet.avif" alt="Шведский стол в лагере АйДаКемп" class="w-full h-full object-cover" loading="lazy" />
    </div>
  </section>

  <!-- CTA — честный для тех, кто уже записан куда-то -->
  <section class="mx-auto max-w-[1312px] px-4 py-10">
    <div class="bg-[#0d1a2b] text-white rounded-3xl p-6 md:p-10 flex flex-col md:flex-row gap-6 items-center">
      <div class="flex-1">
        <p class="text-sm text-white/50 font-medium mb-1">Скорее всего, это лето уже распланировано</p>
        <h2 class="text-xl md:text-2xl font-black mb-3">
          Если этим летом вы едете к нам — отлично.<br/>
          Если нет — добро пожаловать в следующем году
        </h2>
        <p class="text-white/65 text-sm leading-relaxed max-w-xl">
          Программа год от года становится лучше — новые треки, новая техника, живое программирование.
          Оставьте заявку сейчас: напомним весной 2027, когда откроется бронирование.
          Или позвоните, если ещё выбираете лагерь на это лето — мест пока немного осталось.
        </p>
      </div>
      <div class="flex flex-col gap-3 min-w-[200px]">
        <a
          href="/#shifts"
          class="bg-primary hover:bg-[#d4700a] text-white font-bold rounded-xl px-6 py-3 text-center transition-colors"
        >
          Узнать про смены {SEASON_YEAR}
        </a>
        <a
          href="tel:+74951284429"
          class="border border-white/20 hover:border-white/40 text-white font-semibold rounded-xl px-6 py-3 text-center transition-colors text-sm"
        >
          <i class="bi bi-telephone mr-1.5" aria-hidden="true"></i>
          Позвонить
        </a>
      </div>
    </div>
  </section>

</LandingLayout>
