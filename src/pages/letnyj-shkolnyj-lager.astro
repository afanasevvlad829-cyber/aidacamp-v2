---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import { STAT_LICENSE, STAT_RTO, STAT_RATING } from '../data/contacts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { SEASON_FROM_TO, SEASON_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Чем летний школьный лагерь АйДаКемп отличается от обычного",
    text: "Летний школьный лагерь — формат, где каникулы не уходят впустую. В АйДаКемп дети учатся программированию в загородном формате с проживанием: утром занятия, днём бассейн и спорт, вечером работа над собственным проектом. К концу смены каждый ребёнок защищает реальный IT-проект на хакатоне. Это не «развлекательный лагерь» и не «городской кружок» — это сочетание отдыха и серьёзного образования.",
    list: [
      "IT-занятия дважды в день по 90 минут — не одна пара, а системная работа",
      "Преподаватели-практики, авторы учебника по Python для детей (тираж 2 000 экз.)",
      "Группы до 8 человек — каждому уделяется время, нет «потерявшихся»",
      "Хакатон в финале — дети защищают проект перед всей сменой как на настоящей презентации"
    ]
  },
  {
    h2: "Программа летнего лагеря для школьников",
    text: "В программе — три возрастных группы ребят: 7–10, 10–12 и 13–15 лет. Программа подбирается по выбору ребёнка, его возрасту и стартовому уровню. Школьники 7–10 лет начинают со Scratch и Minecraft — создают простые игры и анимации. Ученики 10–12 лет изучают Python и пишут первые боты. Подростки 13–15 лет работают с Python Advanced, AI-API и нейросетями.",
    list: [
      "7–10 лет: Scratch, Minecraft — логика, алгоритмы, первые программы",
      "10–12 лет: Python, Telegram-боты, работа с данными",
      "13–15 лет: Python Advanced, ChatGPT API, Gemini, AI-проекты",
      "Дополнительно: 3D-моделирование в Blender, создание игр в Roblox Studio"
    ]
  },
  {
    h2: "Летний школьный лагерь или репетитор — что выбрать",
    text: "Репетитор даёт знания, лагерь — опыт и навыки. Разница принципиальная. За 10 дней в летнем школьном лагере ребёнок создаёт IT-проект с нуля до публичной защиты — это невозможно воспроизвести на занятиях с репетитором. Кроме того, в лагере — сверстники с похожими интересами, это тоже мотивирует.",
    list: [
      "За 10 дней — объём знаний как за 3–4 месяца занятий с репетитором",
      "Публичная защита проекта — навык презентации, которого не даёт ни один репетитор",
      "Сверстники как мотиватор: в команде тянутся к уровню группы, а не к минимуму",
      "Живое общение без телефонов и других гаджетов — за 3 дня большинство школьников забывают о них и уходят в проект"
    ]
  },
  {
    h2: "Летний школьный лагерь с проживанием — условия",
    text: "АйДаКемп работает на базе санатория «Изумруд» в Наро-Фоминском районе, 66 км от МКАД. Дети живут в корпусах по 2–4 человека с санузлом. Питание 5 раз в день. Закрытый бассейн с ионизированной водой. Охрана 24/7, медработник на территории. Связь с родителями — ежедневные фото в Telegram-канале и звонки по расписанию.",
    list: [
      "Комнаты по 2–4 человека с раздельным санузлом",
      "5-разовое питание с учётом аллергий и диет",
      "Закрытый бассейн с ионизированной водой — без хлора",
      "Прогулки на свежем воздухе, спорт после занятий — не только экран",
      "Медработник 24/7, охрана, закрытая территория",
      "Ежедневные фото в Telegram-канале для родителей"
    ]
  },
  {
    h2: "Документы и лицензии — летний лагерь для школьников",
    text: `АйДаКемп — официальная образовательная организация с лицензией Минобрнауки. Это значит, что оплата смены частично квалифицируется как «оплата обучения» — родители получают налоговый вычет 13% (до ${VYCHET_MAX}). После оплаты автоматически выдаём договор, акт и копию лицензии — всё необходимое для декларации 3-НДФЛ.`,
    list: [
      `Образовательная лицензия Минобрнауки ${STAT_LICENSE}`,
      `Туроператор РТО ${STAT_RTO} — юридическая защита прав родителей`,
      `Налоговый вычет 13% — возврат до ${VYCHET_MAX} через nalog.ru`,
      "Публичная оферта — все условия прозрачны до подписания",
      `Путёвка включает оздоровительную часть смены, рейтинг ${STAT_RATING} на Яндекс.Картах`
    ]
  },
  {
    h2: `Смены летнего школьного лагеря ${SEASON_YEAR}`,
    text: `АйДаКемп проводит летние школьные смены ${SEASON_FROM_TO} — сезон ${SEASON_YEAR} почти завершён: четыре смены мая–июля уже прошли, к записи открыты две августовские. Смена 4 (10 дней) — мягкий формат перед школой, смена 3 (13 дней) — с расширенной программой и двухдневным хакатоном. Подробно про августовские заезды: <a href="/lager-na-avgust-podmoskove/" class="text-primary font-semibold hover:underline">детский лагерь на август ${SEASON_YEAR}</a>.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (места есть)`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (перед школой, места есть)`,
      `Смены мая–июля (1, 2, 2.1, 2.2) — завершены; расписание лета 2027 объявим зимой`
    ]
  },
  {
    h2: "Отзывы родителей о летнем школьном лагере",
    text: "Мнения тех, чьи дети уже прошли лагерь АйДаКемп:",
    list: [
      "«Сын вернулся с ботом, который сам написал. До этого категорически отказывался от репетитора. В лагере — захотел сам» — Татьяна, мама Артёма, 12 лет",
      "«Боялась, что скучно без телефона. Но за три дня забыл про него сам. Вернулся с друзьями из разных школ» — Ирина, мама Кирилла, 10 лет",
      "«Программа серьёзная — не просто развлечение. Учитель информатики удивился, что сын знает Python» — Светлана, мама Даниила, 13 лет"
    ]
  },
  {
    h2: "Чем IT-лагерь отличается от обычного школьного",
    text: "В типичном школьном лагере — продлёнка, настольные игры и «просмотр мультфильмов по расписанию». В АйДаКемп — реальные IT-проекты, которые можно положить на GitHub.",
    list: [
      "Python-боты — школьники 10–12 лет пишут Telegram-ботов, которые отвечают на вопросы или выдают расписание",
      "AI-ассистенты — подростки 13–15 лет работают с ChatGPT API и Gemini, создают умных помощников",
      "Игры на Roblox Studio — собственный игровой мир с механиками и скриптами на Lua",
      "3D-модели в Blender — от куба до персонажа за 10 дней",
      "Портфолио на GitHub — ребята уезжают не с грамотой за участие, а с рабочим кодом в открытом репозитории"
    ]
  },

  {
    h2: "Вожатые и преподаватели",
    text: "Программу ведут опытные преподаватели-практики и авторы учебника по Python для подростков (тираж 2 000 экземпляров, в открытой продаже). Не «пришли ради летней подработки», а практикующие IT-специалисты.",
    list: [
      "1 педагог на 6–8 школьников — преподаватель видит каждого, успевает помочь",
      "С помощью педагога — не «сам разберись», а «давай вместе найдём ошибку»",
      "Конкурсный отбор — каждый вожатый прошёл отбор и обучение перед сезоном"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/letnyaya-it-shkola.avif"
  title={`Летний школьный лагерь в Подмосковье ${SEASON_YEAR} — Python и AI`}
  description={`Летний школьный лагерь ${SEASON_YEAR} для детей 7–15 лет: IT-занятия, бассейн, готовый проект за смену. Санаторий «Изумруд», Подмосковье, от ${PRICE_MIN}.`}
  h1={`Летний лагерь для школьников ${SEASON_YEAR} — IT и бассейн в Подмосковье`}
  canonical="https://aidacamp.ru/letnyj-shkolnyj-lager"
>
  <Fragment slot="head">
    <CourseSchema
      name="Летний школьный лагерь АйДаКемп — IT-программа с проживанием"
      description="Летний лагерь для школьников 7–15 лет с IT-программой: Python, AI, Minecraft, 3D-моделирование. Проживание в санатории «Изумруд», 66 км от МКАД. Смены"
      url="https://aidacamp.ru/letnyj-shkolnyj-lager"
      level="Beginner"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Летний лагерь для школьников ${SEASON_YEAR} — IT и бассейн в Подмосковье`}
    subtitle={`IT-лагерь с проживанием для школьников 7–15 лет. Python, AI, Minecraft — реальный проект за смену. 66 км от МКАД, от ${PRICE_MIN}.`}
    breadcrumb="Летние каникулы"
    keywords={["Для школьников 7–15 лет, группы по возрасту и уровню", "Образовательная лицензия Минобрнауки — налоговый вычет 13%", "Хакатон в финале — каждый защищает свой IT-проект"]}
    image="/images/hero/letnyaya-it-shkola.avif"
    imageAlt="Летний школьный лагерь АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что такое летний школьный лагерь с IT-программой?", a: `Летний школьный лагерь АйДаКемп — это загородный лагерь с проживанием, где школьники 7–15 лет учатся программированию. IT-занятия дважды в день, бассейн, питание, хакатон в финале. 66 км от МКАД, санаторий «Изумруд», смены ${SEASON_MONTHS_NOM} ${SEASON_YEAR}.` },
    { q: "Что школьник узнает в летнем лагере с IT-программой?", a: "Зависит от возраста: 7–10 лет — Scratch и Minecraft (логика и алгоритмы), 10–12 лет — Python и боты, 13–15 лет — Python Advanced, AI-API, нейросети. В финале каждый защищает реальный проект на хакатоне." },
    { q: `Сколько стоит летний школьный лагерь ${SEASON_YEAR}?`, a: `Открытые августовские смены — от ${PRICE_MIN} за 10 дней (смена 4) до ${PRICE_MAX} за 13 дней (смена 3). Проживание, питание, IT-программа, бассейн включены. Налоговый вычет 13% — возврат до ${VYCHET_MAX}.` },
    { q: "Как выбрать летний школьный лагерь?", a: `Проверьте: образовательная лицензия (у АйДаКемп — Минобрнауки ${STAT_LICENSE}), туроператорский реестр (РТО ${STAT_RTO}), реальные отзывы на Яндекс.Картах (★ 5.0, 40+ отзывов), программа с конкретным результатом (проект, хакатон), малые группы (до 8 человек).` },
    { q: "Можно ли оформить налоговый вычет за летний лагерь?", a: `Да, если у лагеря есть образовательная лицензия. У АйДаКемп — лицензия Минобрнауки. Вычет 13% применяется к образовательной части стоимости. Все документы (договор + акт + копия лицензии) выдаём автоматически после оплаты. Возврат до ${VYCHET_MAX} через nalog.ru.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
