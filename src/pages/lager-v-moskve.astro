---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';

const sections = [
  {
    h2: "Летний лагерь рядом с Москвой",
    text: "АйДаКемп — загородный IT-лагерь в Подмосковье, который выбирают московские семьи. До лагеря 66 км от МКАД по Калужскому шоссе — около часа езды на машине. Это достаточно близко чтобы приехать на выходных, и достаточно далеко чтобы ребёнок был по-настоящему «в лагере» — в лесу, без городской суеты. Трансфер из нескольких точек Москвы организуем по запросу."
  },
  {
    h2: "Почему московские родители выбирают АйДаКемп",
    text: "Летних лагерей вокруг Москвы много. Мы отличаемся тем, что у нас есть конкретный образовательный результат: ребёнок уезжает с IT-проектом, который сам придумал и сделал за смену. Python, AI, Minecraft — программа адаптирована под возраст от 7 до 14 лет.",
    list: [
      "Авторская IT-программа — Python, AI, Minecraft, дизайн",
      "Преподаватели — авторы учебника по Python для детей",
      "Хакатон в финале — каждый защищает свой проект",
      "Без телефонов — экранное время зарабатывается",
      "Бассейн, спорт, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Как добраться из Москвы",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд». Координаты: 55.265643, 36.724185. На машине из Москвы: по Калужскому шоссе (A-101) на юго-запад, 66 км от МКАД. Время в пути — 50–70 минут в зависимости от пробок. Трансфер: организуем из нескольких точек Москвы — уточните при бронировании."
  },
  {
    h2: "Летний лагерь в Москве — сравнение форматов",
    text: "Городские дневные лагеря в Москве — удобно, но ребёнок каждый вечер дома. Загородный лагерь в Подмосковье — это полное погружение: новые друзья, режим, природа и занятия без отвлечений на привычную среду. Большинство детей после первых двух дней адаптации не хотят уезжать."
  },
  {
    h2: "Из каких округов Москвы к нам удобно ехать",
    text: "Наше расположение — западная часть Подмосковья, Калужское шоссе. Это означает удобный доступ для половины округов Москвы без заезда в центр. Оценка времени в пути для разных точек старта (в обычный рабочий день, без пробок):",
    list: [
      "ТиНАО (Троицк, Внуково, Коммунарка, Румянцево) — 25–40 минут, прямой путь по Калужскому шоссе",
      "ЮЗАО (Тёплый Стан, Ясенево, Бутово) — 40–55 минут, выезд через Саларьево",
      "ЗАО (Очаково, Никулино, Солнцево) — 45–60 минут, через МКАД или Боровское шоссе",
      "САО и СЗАО — 60–85 минут через МКАД, плюс северный въезд",
      "ЦАО — 50–70 минут, зависит от выбранного выезда из центра",
      "ВАО и ЮВАО — 70–100 минут, весь путь вокруг МКАД"
    ]
  },
  {
    h2: "Чем загородный лагерь полезнее для московского ребёнка",
    text: "Ребёнок, родившийся и выросший в Москве, редко бывает в настоящем загородном окружении. Природа парка Воробьёвы горы — это не лес. Ходьба до метро — не «прогулка на свежем воздухе». Уровень утомляемости у городских детей выше, а качество сна — ниже. Загородная смена даёт организму то, что не может дать никакой парк в городе:",
    list: [
      "Высокое содержание кислорода в воздухе — хвойно-лиственный лес = естественная ионизация",
      "Низкий уровень шумового загрязнения — засыпает быстрее, сон глубже",
      "Темнота ночью — мелатонин вырабатывается правильно, режим сна восстанавливается",
      "Движение в течение дня — не на тренажёре в школе, а на улице и в воде (бассейн)",
      "Отсутствие 4G/5G на 10 дней — парасимпатическая нервная система «выдыхает»"
    ]
  },
  {
    h2: "Что готовить родителям из Москвы",
    text: "Если везёте ребёнка первый раз — 3 практических совета от мам которые через это прошли. Первое: выезжайте с запасом времени. Пробка по МКАД в день заезда + попасть в нашу регистрацию = заложите 2.5 часа на путь. Второе: возьмите личные вещи ребёнка из списка на сайте (он высылается в договоре), не перегружайте. Третье: договоритесь о «режиме связи» заранее — какой час в какой день звонить, а когда давать ребёнку пожить своей жизнью. Иначе вы будете звонить 5 раз в день, а ребёнок — просить забрать домой уже на 2 день."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-moskve.avif"
  title="Летний лагерь в Москве и Подмосковье 2026 для детей — АйДаКемп"
  description="Летний детский лагерь рядом с Москвой — 66 км по Калужскому шоссе. IT-программа, Python, AI, Minecraft. Смены июнь–август 2026, от 48 000 ₽."
  h1="Летний лагерь в Москве и Подмосковье"
  canonical="https://aidacamp.ru/lager-v-moskve"
>
  <LandingHero slot="hero"
    h1="Летний лагерь в Москве и Подмосковье"
    subtitle={`${STAT_DISTANCE} от МКАД по Калужскому шоссе. Ближайший IT-лагерь к Москве с проживанием, бассейном и авторской программой.`}
    breadcrumb="Лагерь в Москве"
    keywords={[`${STAT_DISTANCE} от Москвы — около часа езды по Калужскому шоссе`, "Трансфер из Москвы — организуем по запросу", "IT-программа, бассейн, питание — всё включено"]}
    image="/images/hero/lager-v-moskve.avif"
    imageAlt="Летний лагерь в Москве и Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
