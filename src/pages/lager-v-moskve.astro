---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';

const sections = [
  {
    h2: "Есть ли летний лагерь с проживанием рядом с Москвой?",
    text: "АйДаКемп — загородный IT-лагерь в Подмосковье, который выбирают московские семьи. До лагеря 66 км от МКАД по Киевскому шоссе — около часа езды на машине. Это достаточно близко чтобы приехать на выходных, и достаточно далеко чтобы ребёнок был по-настоящему «в лагере» — в лесу, без городской суеты. Трансфер из Москвы организуем через компании-партнёров — сбор в удобной точке с большой парковкой."
  },
  {
    h2: "Какие смены лета 2026 доступны для записи?",
    text: "Шесть смен с июня по август — от бюджетной 7-дневной до популярной 14-дневной. Клик по названию — откроется подробное описание смены с возрастной сеткой, программой и расписанием.",
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} — 7 дней, 10–16 июня — <b>48 000 ₽</b> (самая бюджетная, хороший старт)`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} — 10 дней, 30 мая — 8 июня — <b>74 900 ₽</b> (открывает лето)`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} — 8 дней, 16–23 июня — <b>75 000 ₽</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} — 14 дней, 10–23 июня — <b>95 000 ₽</b> (самая популярная)`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, 3–15 августа — <b>89 400 ₽</b>`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, 17–26 августа — <b>74 900 ₽</b> (закрывает лето)`
    ]
  },
  {
    h2: "Почему московские родители выбирают АйДаКемп?",
    text: "Летних лагерей вокруг Москвы много. Мы отличаемся тем, что у нас есть конкретный образовательный результат: дети уезжают с IT-проектом, который сами придумали и сделали за смену. Python, AI, Minecraft — программа адаптирована под возраст от 7 до 15 лет.",
    list: [
      "Авторская IT-программа — Python, AI, Minecraft, 3D-моделирование",
      "Образовательные занятия — 2 раза в день по 90 минут с преподавателями, авторами учебника по Python для детей",
      "Бассейн с ионизированной водой — через день",
      "Хакатон в финале — каждый защищает свой проект",
      "Без телефонов в течение дня — экранное время зарабатывается",
      "Медработник на территории 24/7, охрана, видеонаблюдение",
      "Налоговый вычет 13% от стоимости образовательных услуг (до 5 434 ₽)"
    ]
  },
  {
    h2: "Как добраться до лагеря из Москвы?",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория санатория «Изумруд». Координаты лагеря: 55.265643, 36.724185. На машине из Москвы — по Киевскому шоссе (М-3) на юго-запад, 66 км от МКАД. Время в пути 50–70 минут в зависимости от пробок.",
    list: [
      "Свой автомобиль — самый быстрый способ, парковка для родителей у лагеря в день заезда",
      "Организованный трансфер — автобус от компании-партнёра, бронируется вместе с путёвкой",
      "Сбор трансфера: м. Солнцево, большая парковка (координаты для навигатора: 55.648543, 37.389828)",
      "Автобус идёт в обход МКАД по Киевскому шоссе — без пробок, 40–60 минут до лагеря",
      "Стоимость трансфера — 2 000 ₽ в одну сторону, туда+обратно 4 000 ₽"
    ]
  },
  {
    h2: "Из каких округов Москвы удобнее всего добираться до лагеря?",
    text: "Наше расположение — западная часть Подмосковья, Киевское шоссе. Это означает удобный доступ для половины округов Москвы без заезда в центр. Оценка времени в пути для разных точек старта (в обычный рабочий день, без пробок):",
    list: [
      "ТиНАО (Троицк, Внуково, Коммунарка, Румянцево) — 25–40 минут, прямой путь по Киевскому шоссе",
      "ЮЗАО (Солнцево, Ясенево, Бутово) — 40–55 минут, выезд через Киевское шоссе",
      "ЗАО (Очаково, Никулино, Солнцево) — 45–60 минут, через МКАД или Боровское шоссе",
      "САО и СЗАО — 60–85 минут через МКАД, плюс северный въезд",
      "ЦАО — 50–70 минут, зависит от выбранного выезда из центра",
      "ВАО и ЮВАО — 70–100 минут, весь путь вокруг МКАД"
    ]
  },
  {
    h2: "Городской или загородный лагерь — как выбрать?",
    text: "Часто родители выбирают между городским дневным лагерем в Москве и выездным загородным. Оба формата имеют смысл, но решают разные задачи. Коротко о том, когда что выбрать:",
    list: [
      "<b>Городской дневной лагерь</b> — удобно по логистике: ребята утром едут в лагерь, вечером дома. Подойдёт если ребёнок младше 7 лет, сильно тревожится уезжать, или если семья не может себе позволить загородный формат",
      "<b>Загородный лагерь с проживанием</b> — полное погружение: новые друзья, режим, природа и занятия без отвлечений на привычную среду. Даёт эффект «новой главы» — дети возвращаются с новыми навыками и повзрослевшими",
      "Большинство детей после первых 2 дней адаптации не хотят уезжать — даже те, кто боялся. Это подтверждённый родителями паттерн",
      "Для «первый раз» часто выбирают нашу короткую 7-дневную смену — можно попробовать формат без риска на 2 недели"
    ]
  },
  {
    h2: "Чем загородный лагерь полезнее для ребёнка из Москвы?",
    text: "Ребёнок, родившийся и выросший в Москве, редко бывает в настоящем загородном окружении. Природа парка — это не лес. Ходьба до метро — не «прогулка на свежем воздухе». Уровень утомляемости у городских детей выше, а качество сна — ниже. Загородная смена даёт организму то, что не может дать никакой парк в городе:",
    list: [
      "Чистый воздух — хвойно-лиственный лес, естественная ионизация, больше кислорода",
      "Низкий уровень шумового загрязнения — засыпает быстрее, сон глубже",
      "Темнота ночью — мелатонин вырабатывается правильно, режим сна восстанавливается",
      "Движение в течение дня — не на тренажёре в школе, а на улице и в воде (бассейн)",
      "Цифровой детокс — телефон сдан, нет уведомлений и постоянного скроллинга, нервная система «выдыхает»"
    ]
  },
  {
    h2: "Как купить путёвку в лагерь из Москвы — процесс без давления?",
    text: "Три шага от заявки до поездки ребёнка. Без «скидка только сегодня», без давления и спешки.",
    list: [
      "<b>Заявка на сайте</b> — менеджер перезвонит за 10 минут (в рабочее время 11–20 МСК). Обсудим возраст, смены, программу",
      "<b>Бронь на 72 часа без предоплаты</b> — время для семейного решения без спешки",
      "<b>Договор + первый платёж (50%)</b> — по договору оферты, с чеком. Вторые 50% — за 3 недели до смены",
      "<b>Документы на email</b> — договор, чек, копия лицензии Минобрнауки для налогового вычета 13%",
      "<b>Чек-лист вещей</b> — высылаем за 3 дня до заезда"
    ]
  },
  {
    h2: "Что нужно подготовить родителям из Москвы перед первой поездкой?",
    text: "Если везёте ребёнка первый раз — 3 практических совета от мам которые через это прошли. Первое: выезжайте с запасом времени. Пробка по МКАД в день заезда + попасть в нашу регистрацию = заложите 2.5 часа на путь. Второе: возьмите личные вещи ребёнка из списка на сайте (он высылается в договоре), не перегружайте. Третье: договоритесь о «режиме связи» заранее — какой час в какой день звонить, а когда давать ребёнку пожить своей жизнью. Иначе вы будете звонить 5 раз в день, а ребёнок — просить забрать домой уже на 2 день."
  },
  {
    h2: "Что не входит в стоимость путёвки?",
    text: "Честно — что вне цены, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция, 2 000 ₽ в одну сторону от м. Солнцево",
      "<b>Страховка</b> — рекомендуем оформить отдельно. По нашему договору выгодоприобретателем является ребёнок через законных представителей; свой полис даёт родителям прямой контроль над выплатами",
      "<b>Дополнительные экскурсии за территорию</b> — редко, по желанию группы",
      "<b>Карманные деньги ребёнка</b> — по вашему усмотрению, часть отдаёт вожатому на хранение"
    ]
  },
  {
    h2: "Из каких районов Москвы удобнее всего ехать",
    text: "ЮЗАО и ЗАО — ближайшие к нам округа: 40–55 минут по Киевскому шоссе почти без пробок. Жители Солнцево, Ясенево, Бутово садятся на трансфер прямо у метро — 40 минут и в лагере. ЮАО, САО, ЦАО добираются через МКАД — 60–80 минут на машине или на трансфере. Для всех без исключения работает трансфер: организованный автобус отправляется от м. Солнцево, 2 000 ₽ в одну сторону. Советы по пробкам: если едете сами — выезжайте в 7:30 или после 10:00. В 8:00–9:30 Киевское шоссе стоит от Московской до Голицыно."
  },
  {
    h2: "Почему московские родители выбирают загородный лагерь, а не городской",
    text: "Городской дневной лагерь удобен логистически, но не даёт главного — смены обстановки. Загородный формат решает задачи, которые городской не может:",
    list: [
      "Лес вместо асфальта — за 10 дней нервная система разгружается так, как за месяц в городе не получится",
      "Без гаджетов в режиме — телефоны зарабатываются активностями, не выдаются по требованию. Дети перестают скроллить и начинают общаться",
      "Живое общение вместо мессенджеров — новые друзья, которые появляются именно потому, что некуда спрятаться в телефон",
      "Образовательный результат — погружение без отвлечений даёт глубину. За 10 дней в лагере — как за 3 месяца онлайн-кружка",
      "Самостоятельность — первый опыт жить отдельно от родителей. Возвращаются другими"
    ]
  },
  {
    h2: "Актуальность мест — июль 2026",
    text: "Июль 2026 занят полностью — запись закрыта. Июнь и август — места ещё есть, но количество ограничено. Смена 2.1 (7 дн., июнь) и Смена 4 (10 дн., август) — наиболее доступны прямо сейчас. Оставьте заявку — менеджер свяжется и скажет точное наличие по вашим датам."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-moskve.avif"
  title="Летний лагерь в Москве 2026 — 66 км от МКАД | АйДаКемп"
  description="Летний лагерь рядом с Москвой, 66 км от МКАД. Трансфер от м. Солнцево. Бассейн, программирование, питание. Смены июнь–август от 48 000 ₽."
  h1="Летний лагерь в Москве и Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-v-moskve"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Есть ли летний лагерь в Москве?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — загородный лагерь в Ближнем Подмосковье (66 км), не городской. Трансфер от м. Солнцево — 40 минут." } },
        { "@type": "Question", "name": "Сколько ехать от Москвы до лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "40–60 минут по Киевскому шоссе. Организованный автобус от м. Солнцево." } },
        { "@type": "Question", "name": "Какой лагерь рядом с Москвой для детей 2026?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп в Наро-Фоминском районе — IT-программа, бассейн, смены с конца мая." } },
        { "@type": "Question", "name": "Как записать ребёнка в лагерь из Москвы?", "acceptedAnswer": { "@type": "Answer", "text": "Оставить заявку на сайте. Менеджер перезванивает за 10 минут." } },
        { "@type": "Question", "name": "Есть ли у лагеря лицензия?", "acceptedAnswer": { "@type": "Answer", "text": "Да. АйДаКемп работает по образовательной лицензии Минобрнауки Л035-01298-77/01082973. Лицензия подтверждает образовательный статус программы и даёт право на налоговый вычет 13% (до 5 434 ₽). Туроператор РТО 025773." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь в Москве и Подмосковье 2026"
    subtitle={`${STAT_DISTANCE} от МКАД по Киевскому шоссе. Ближайший IT-лагерь к Москве с проживанием, бассейном и авторской программой.`}
    breadcrumb="Лагерь в Москве"
    keywords={[`${STAT_DISTANCE} от Москвы — около часа езды по Киевскому шоссе`, "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону", "IT-программа, бассейн, питание — всё включено"]}
    image="/images/hero/lager-v-moskve.avif"
    imageAlt="Летний лагерь в Москве и Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
