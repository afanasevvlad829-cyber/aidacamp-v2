---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';

const sections = [
  {
    h2: "Лагерь для детей из Москвы — что важно",
    text: "Когда выбираешь лагерь для ребёнка из Москвы, есть несколько практических вещей, которые сильно влияют на то, как пройдут эти 7–14 дней.",
    list: [
      "<b>Акклиматизация не нужна</b> — Подмосковье, а не Турция. Привычный климат, привычная еда, нет «трёх потерянных дней», пока организм приходит в себя. Ребёнок включается в программу с первого дня.",
      "<b>1 час дороги</b> — не 3 часа в аэропорту и 2 часа в самолёте. Если что-то случится, родители рядом. Это важно не потому что «случается», а потому что спокойнее.",
      "<b>Трансфер от метро</b> — организованный автобус от м. Солнцево (2 500 ₽) — удобно для родителей, которые не хотят ехать на машине. Сопровождающий доставляет ребёнка до ворот лагеря.",
      "<b>Ежедневная связь</b> — родительский чат с фото каждый вечер. Видно, как ребёнок учится программировать, купается в бассейне, общается с командой.",
      "<b>Московский ребёнок в природе</b> — хвойный лес, река Нара рядом, воздух без выхлопов. За 7–14 дней в Подмосковье организм «выдыхает» от городского ритма без экзотики и риска."
    ]
  },
  {
    h2: "Летний лагерь рядом с Москвой",
    text: "АйДаКемп — загородный IT-лагерь в Подмосковье, который выбирают московские семьи. До лагеря 66 км от МКАД по Калужскому шоссе — около часа езды на машине. Это достаточно близко чтобы приехать на выходных, и достаточно далеко чтобы ребёнок был по-настоящему «в лагере» — в лесу, без городской суеты. Трансфер из Москвы организуем через компании-партнёров — сбор в удобной точке с большой парковкой."
  },
  {
    h2: "Смены лета 2026 — выберите свой вариант",
    text: "Шесть смен с июня по август — от бюджетной 7-дневной до популярной 14-дневной. Клик по названию — откроется подробное описание смены с возрастной сеткой, программой и расписанием.",
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1')} — 7 дней, 10–16 июня — <b>48 000 ₽</b> (самая бюджетная, хороший старт)`,
      `${shiftLinkHtml('shift-1', 'Смена 1')} — 10 дней, 30 мая — 8 июня — <b>74 900 ₽</b> (открывает лето)`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2')} — 8 дней, 16–23 июня — <b>65 000 ₽</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2')} — 14 дней, 10–23 июня — <b>95 000 ₽</b> (самая популярная)`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, 3–15 августа — <b>89 400 ₽</b>`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, 17–26 августа — <b>69 600 ₽</b> (закрывает лето)`
    ]
  },
  {
    h2: "Почему московские родители выбирают АйДаКемп",
    text: "Летних лагерей вокруг Москвы много. Мы отличаемся тем, что у нас есть конкретный образовательный результат: дети уезжают с IT-проектом, который сами придумали и сделали за смену. Python, AI, Minecraft — программа адаптирована под возраст от 7 до 15 лет.",
    list: [
      "Авторская IT-программа — Python, AI, Minecraft, 3D-моделирование",
      "Образовательные занятия — 2 раза в день по 90 минут с преподавателями, авторами учебника по Python для детей",
      "Бассейн с ионизированной водой — через день",
      "Хакатон в финале — каждый защищает свой проект",
      "Без телефонов в течение дня — экранное время зарабатывается",
      "Медработник на территории 24/7, охрана, видеонаблюдение",
      "Налоговый вычет 13% от стоимости образовательных услуг (до 14 300 ₽)"
    ]
  },
  {
    h2: "Как добраться из Москвы",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория санатория «Изумруд». Координаты лагеря: 55.265643, 36.724185. На машине из Москвы — по Калужскому шоссе (А-101) на юго-запад, 66 км от МКАД. Время в пути 50–70 минут в зависимости от пробок.",
    list: [
      "Свой автомобиль — самый быстрый способ, парковка для родителей у лагеря в день заезда",
      "Организованный трансфер — автобус от компании-партнёра, бронируется вместе с путёвкой",
      "Сбор трансфера: м. Солнцево, большая парковка (координаты для навигатора: 55.648543, 37.389828)",
      "Автобус идёт в обход МКАД по Калужскому шоссе — без пробок, 40–60 минут до лагеря",
      "Стоимость трансфера — 2 500 ₽ в одну сторону, туда+обратно 5 000 ₽"
    ]
  },
  {
    h2: "Из каких округов Москвы к нам удобно ехать",
    text: "Наше расположение — западная часть Подмосковья, Калужское шоссе. Это означает удобный доступ для половины округов Москвы без заезда в центр. Оценка времени в пути для разных точек старта (в обычный рабочий день, без пробок):",
    list: [
      "ТиНАО (Троицк, Внуково, Коммунарка, Румянцево) — 25–40 минут, прямой путь по Калужскому шоссе",
      "ЮЗАО (Солнцево, Ясенево, Бутово) — 40–55 минут, выезд через Саларьево",
      "ЗАО (Очаково, Никулино, Солнцево) — 45–60 минут, через МКАД или Боровское шоссе",
      "САО и СЗАО — 60–85 минут через МКАД, плюс северный въезд",
      "ЦАО — 50–70 минут, зависит от выбранного выезда из центра",
      "ВАО и ЮВАО — 70–100 минут, весь путь вокруг МКАД"
    ]
  },
  {
    h2: "Летний лагерь в Москве — сравнение форматов",
    text: "Часто родители выбирают между городским дневным лагерем в Москве и выездным загородным. Оба формата имеют смысл, но решают разные задачи. Коротко о том, когда что выбрать:",
    list: [
      "<b>Городской дневной лагерь</b> — удобно по логистике: ребята утром едут в лагерь, вечером дома. Подойдёт если ребёнок младше 7 лет, сильно тревожится уезжать, или если семья не может себе позволить загородный формат",
      "<b>Загородный лагерь с проживанием</b> — полное погружение: новые друзья, режим, природа и занятия без отвлечений на привычную среду. Даёт эффект «новой главы» — дети возвращаются с новыми навыками и повзрослевшими",
      "Большинство детей после первых 2 дней адаптации не хотят уезжать — даже те, кто боялся. Это подтверждённый родителями паттерн",
      "Для «первый раз» часто выбирают нашу короткую 7-дневную смену — можно попробовать формат без риска на 2 недели"
    ]
  },
  {
    h2: "Чем загородный лагерь полезнее для московского ребёнка",
    text: "Ребёнок, родившийся и выросший в Москве, редко бывает в настоящем загородном окружении. Природа парка — это не лес. Ходьба до метро — не «прогулка на свежем воздухе». Уровень утомляемости у городских детей выше, а качество сна — ниже. Загородная смена даёт организму то, что не может дать никакой парк в городе:",
    list: [
      "Чистый воздух — хвойно-лиственный лес, естественная ионизация, больше кислорода",
      "Низкий уровень шумового загрязнения — засыпает быстрее, сон глубже",
      "Темнота ночью — мелатонин вырабатывается правильно, режим сна восстанавливается",
      "Движение в течение дня — не на тренажёре в школе, а на улице и в воде (бассейн)",
      "Цифровой детокс — телефон сдан, нет уведомлений и постоянного скроллинга, нервная система «выдыхает»"
    ]
  },
  {
    h2: "Как купить путёвку — процесс без давления",
    text: "Три шага от заявки до поездки ребёнка. Без «скидка только сегодня», без давления и спешки.",
    list: [
      "<b>Заявка на сайте</b> — менеджер перезвонит за 10 минут (в рабочее время 11–20 МСК). Обсудим возраст, смены, программу",
      "<b>Бронь на 72 часа без предоплаты</b> — время для семейного решения без спешки",
      "<b>Договор + первый платёж (50%)</b> — по договору оферты, с чеком. Вторые 50% — за 3 недели до смены",
      "<b>Документы на email</b> — договор, чек, копия лицензии Минобрнауки для налогового вычета 13%",
      "<b>Чек-лист вещей</b> — высылаем за 3 дня до заезда"
    ]
  },
  {
    h2: "Что готовить родителям из Москвы",
    text: "Если везёте ребёнка первый раз — 3 практических совета от мам которые через это прошли. Первое: выезжайте с запасом времени. Пробка по МКАД в день заезда + попасть в нашу регистрацию = заложите 2.5 часа на путь. Второе: возьмите личные вещи ребёнка из списка на сайте (он высылается в договоре), не перегружайте. Третье: договоритесь о «режиме связи» заранее — какой час в какой день звонить, а когда давать ребёнку пожить своей жизнью. Иначе вы будете звонить 5 раз в день, а ребёнок — просить забрать домой уже на 2 день."
  },
  {
    h2: "Что не входит в путёвку",
    text: "Честно — что вне цены, чтобы без неожиданностей.",
    list: [
      "<b>Трансфер из Москвы</b> — опция, 2 500 ₽ в одну сторону от м. Солнцево",
      "<b>Страховка</b> — рекомендуем оформить отдельно. По нашему договору выгодоприобретателем является ребёнок через законных представителей; свой полис даёт родителям прямой контроль над выплатами",
      "<b>Дополнительные экскурсии за территорию</b> — редко, по желанию группы",
      "<b>Карманные деньги ребёнка</b> — по вашему усмотрению, часть отдаёт вожатому на хранение"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-moskve.avif"
  title="Детский лагерь Москва 2026 — лагерь для детей рядом с Москвой от 48 000 ₽ | АйДаКемп"
  description="Детский лагерь для детей из Москвы — 66 км от МКАД, 1 час езды. Трансфер от м. Солнцево. Python, AI, бассейн. Акклиматизация не нужна. Смены июнь–август 2026."
  h1="Детский лагерь для детей из Москвы — АйДаКемп"
  canonical="https://aidacamp.ru/lager-v-moskve"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Детский лагерь в Москве или за городом — что лучше для ребёнка?", "acceptedAnswer": { "@type": "Answer", "text": "Городские дневные лагеря Москвы не дают эффекта погружения — ребёнок вечером дома, режима нет. В загородном лагере АйДаКемп — малые группы до 8 человек, хвойный лес, режим без телефонов, собственный IT-проект к концу смены. 66 км от МКАД — час езды, акклиматизация не нужна." } },
        { "@type": "Question", "name": "Лагерь для детей в Москве — как выбрать ближайший с проживанием?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — 66 км от МКАД по Калужскому шоссе, организованный трансфер от метро «Солнцево». Для жителей ЮЗАО и Новой Москвы — 30–50 минут от дома. Проживание, питание, IT-программа и бассейн включены в путёвку." } },
        { "@type": "Question", "name": "Московские летние лагеря — нужна ли акклиматизация?", "acceptedAnswer": { "@type": "Answer", "text": "Нет, если лагерь в Подмосковье. АйДаКемп — в Наро-Фоминском районе МО, привычный климат для московского ребёнка. Никакого перелёта, жары и 3 дней адаптации — сразу включается в программу." } },
        { "@type": "Question", "name": "Сколько стоит летний лагерь для детей из Москвы в 2026?", "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп: от 48 000 ₽ за 7 дней — проживание, питание, IT-программа, бассейн. Трансфер из Москвы — 2 500 ₽ в одну сторону. Налоговый вычет 13% возвращает до 14 300 ₽." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей из Москвы — АйДаКемп"
    subtitle={`${STAT_DISTANCE} от МКАД — около часа езды. Акклиматизация не нужна, трансфер от м. Солнцево, IT-программа и бассейн в Подмосковье.`}
    breadcrumb="Детский лагерь Москва"
    keywords={[`${STAT_DISTANCE} от Москвы — 1 час на машине, трансфер от м. Солнцево`, "Акклиматизация не нужна — привычный климат Подмосковья", "IT-программа, бассейн, питание — всё включено от 48 000 ₽"]}
    image="/images/hero/lager-v-moskve.avif"
    imageAlt="Детский лагерь для детей из Москвы АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
