---
import { DATES_SHORT_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_MAX, DAYS_MIN, DAYS_S1, DAYS_S2, DAYS_S21, DAYS_S22, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX, daysNum } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, STAT_FOUNDED_YEAR, STAT_KIDS, STAT_LICENSE, STAT_RTO } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';
import { PAST_SHIFTS_SENTENCE } from '../data/evergreen';

const sections = [
  {
    h2: "Есть ли отдых с проживанием рядом со столицей?",
    text: `АйДаКемп — загородный детский лагерь в Подмосковье, который выбирают семьи из столицы. Работаем с ${STAT_FOUNDED_YEAR} года, приняли более ${STAT_KIDS} школьников и подростков. До лагеря 66 км от МКАД по Киевскому шоссе — около часа езды на машине. Это достаточно близко чтобы приехать на выходных, и достаточно далеко чтобы подросток был по-настоящему «в лагере» — в лесу, без городской суеты.`
  },
  {
    h2: "Нужен городской формат в столице, без выезда?",
    text: "Если подростку нужен формат «живёт дома, днём занимается» — это наш городской проект: школа программирования <a href='https://codims.ru/gorodskoy-lager/?utm_source=aidacamp&utm_medium=referral&utm_campaign=lager-v-moskve' rel='noopener' class='text-primary underline underline-offset-2'>#АйДаКодить (Codims)</a>. А АйДаКемп — выездной формат с проживанием: полное погружение в жизнь лагеря на 7–14 дней.",
  },
  {
    h2: `Какие смены прошли летом ${SEASON_YEAR}?`,
    text: `Июньские и августовские летние смены завершились. Летний сезон закрыт: оставляем смены лагеря в списке для истории.`,
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1 (завершена)')} — ${DAYS_S21}, ${DATES_SHORT_S21} — <b>${PRICE_S21}</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1 (завершена)')} — ${DAYS_S1}, ${DATES_SHORT_S1} — <b>${PRICE_S1}</b>`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2 (завершена)')} — ${DAYS_S22}, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2 (завершена)')} — ${DAYS_S2}, ${DATES_SHORT_S2} — <b>${PRICE_S2}</b>`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — ${DAYS_S3}, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b> (прошла)`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — ${DAYS_S4}, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b> (прошла)`
    ]
  },
  {
    h2: "Как добраться до лагеря из столицы?",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория санатория «Изумруд». Наши координаты: 55.265643, 36.724185. На машине от столицы — по Киевскому шоссе (М-3) на юго-запад, 66 км от МКАД. Время в пути 50–70 минут в зависимости от пробок.",
    list: [
      "Свой автомобиль — самый быстрый способ, парковка для родителей у лагеря в день заезда",
      "Организованный трансфер — автобус от компании-партнёра к лагерю, бронируется вместе с путёвкой",
      "Сбор трансфера: м. Солнцево (московское метро), большая парковка (координаты для навигатора: 55.648543, 37.389828)",
    ]
  },
  {
    h2: "Как купить путёвку для подростка — процесс без давления?",
    text: "Три шага от заявки до поездки.",
    list: [
      "<b>Заявка на сайте</b> — менеджер перезвонит за 10 минут (в рабочее время 11–20 МСК). Обсудим возраст участника, смены, программу",
      "<b>Бронь на 72 часа без предоплаты</b> — время для семейного решения о поездке без спешки",
      "<b>Договор + первый платёж (50%)</b> — по договору оферты, с чеком. Вторые 50% — за 3 недели до смены",
      "<b>Документы на email</b> — договор, чек, копия лицензии Минобрнауки для налогового вычета 13%",
      "<b>Чек-лист вещей для лагеря</b> — высылаем за 3 дня до заезда"
    ]
  },
  {
    h2: "Что не входит в стоимость путёвки?",
    text: "Честно — что вне цены летних смен лагеря, чтобы без неожиданностей.",
    list: [
      `<b>Трансфер от столицы</b> — опция, ${TRANSFER_PRICE_FMT} в одну сторону от м. Солнцево`,
      "<b>Страховка</b> — рекомендуем оформить отдельно. По нашему договору выгодоприобретателем является подросток через законных представителей",
      "<b>Карманные деньги в лагере</b> — по вашему усмотрению, часть отдаёт вожатому на хранение"
    ]
  },
  {
    h2: "Отдых рядом со столицей — часто задаваемые вопросы",
    text: "Семьи из Москвы — наши основные гости. Вот что спрашивают чаще всего перед бронированием.",
    list: [
      `Трансфер: автобус от м. Солнцево в день заезда и обратно в день отъезда — ${TRANSFER_PRICE_FMT}`,
      "Время в дороге: 1–1.5 часа от Садового кольца без пробок по Киевскому шоссе",
      "Подходит ли ребёнку без опыта: да, программа строится с нуля, группы по возрасту",
      "Можно ли приехать в середине смены: да, родительский день в каждой смене"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-moskve.avif"
  title={`Детский летний компьютерный лагерь в Москве ${SEASON_YEAR}: путевки, программирование, Minecraft, Python`}
  description={`Детские летние лагеря в Москве ${SEASON_YEAR}: официальные путевки для детей и подростков. Детский компьютерный лагерь — программирование на Python, Minecraft, бассейн, трансфер от метро Солнцево, от ${PRICE_MIN}.`}
  h1={`Детские летние лагеря в Москве ${SEASON_YEAR}: программирование, Minecraft`}
  canonical="https://aidacamp.ru/lager-v-moskve/"
  breadcrumb="Лагерь в Москве"
>
  <LandingHero slot="hero"
    h1={`Детские летние лагеря в Москве ${SEASON_YEAR}: программирование, Minecraft`}
    subtitle={`${STAT_DISTANCE} от МКАД по Киевскому шоссе. Трансфер от м. Солнцево в день заезда. IT-программа, бассейн — ребёнок уезжает с проектом.`}
    breadcrumb="Лагерь в Москве"
    keywords={[`${STAT_DISTANCE} от столицы — около часа езды по Киевскому шоссе`, `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону`, "IT-программа, бассейн, питание — всё включено"]}
    image="/images/hero/lager-v-moskve.avif"
    imageAlt="Летний лагерь в Москве и Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Gallery />
  <Shifts slim />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
    { q: "Есть ли летний лагерь в Москве?", a: "АйДаКемп — загородный детский лагерь в Ближнем Подмосковье (66 км), не городской. Трансфер от м. Солнцево — 40 минут." },
    { q: "Сколько ехать от Москвы до лагеря?", a: "40–60 минут по Киевскому шоссе. Организованный автобус от м. Солнцево." },
    { q: `Какой лагерь рядом с Москвой для детей ${SEASON_YEAR}?`, a: "АйДаКемп в Наро-Фоминском районе — IT-программа для школьников и подростков, бассейн, смены с конца мая." },
    { q: "Как записать ребёнка в лагерь из Москвы?", a: "Оставить заявку на сайте. Менеджер перезванивает за 10 минут." },
    { q: "Есть ли у лагеря лицензия?", a: `Да. АйДаКемп работает по образовательной лицензии Минобрнауки ${STAT_LICENSE}. Лицензия подтверждает образовательный статус программы и даёт право на налоговый вычет 13% (до ${VYCHET_MAX}). Туроператор РТО ${STAT_RTO}.` },
    { q: `Какие летние лагеря рядом с Москвой работают в ${SEASON_YEAR} году?`, a: `АйДаКемп — программа для школьников в 66 км от столицы (Наро-Фоминский округ). Работаем с 30 мая по 26 августа ${SEASON_YEAR}. Трансфер от м. Солнцево. Смены ${daysNum(DAYS_S4)} и ${DAYS_S3}, от ${PRICE_MIN}. Лицензия Минобрнауки.` }
  ]} only={['medicine', 'safety', 'food', 'accommodation', 'documents', 'communication', 'payment']} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться к нам</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
