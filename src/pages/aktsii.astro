---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shifts from '../components/Shifts.astro';
import { PHONE_MAIN_HREF, TELEGRAM_URL, WHATSAPP_URL } from '../data/contacts';
import { getCurrentPrice } from '../data/dynamicPrices';

const s3Price = getCurrentPrice('shift-3') ?? 89400;
const s3Discount = Math.round(s3Price / 2);
const fmt = (n: number) => n.toLocaleString('ru-RU');
---

<Base
  title="Акции и скидки — АйДаКемп 2026"
  description="Скидки на путёвки в IT-лагерь АйДаКемп: едете с другом −10%, приводишь пятерых −50%, приводишь девятерых — 10-я путёвка бесплатно."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/aktsii" />
  </Fragment>

  <Header />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden" data-hero-bg="star-genesis">
    <div class="relative z-10 mx-auto max-w-4xl px-4 pt-12 pb-12 md:pt-20 md:pb-16">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-white/15 border border-white/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-[.1em] text-primary backdrop-blur-sm mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
        АйДаКемп · Лето 2026
      </div>

      <h1 class="text-[32px] md:text-[52px] font-extrabold leading-[1.06] tracking-[-0.03em] text-white mb-5">
        Акции и скидки<br>
        <span class="text-primary">на путёвки 2026</span>
      </h1>
      <p class="text-base md:text-lg text-white/70 max-w-xl leading-relaxed mb-8">
        Три способа сэкономить без промокодов. Чем больше — тем выгоднее. Акции суммируются между собой.
      </p>

      <!-- Три карточки-пилюли -->
      <div class="flex flex-wrap gap-3">
        {[
          { icon: 'people-fill',     text: 'Едете вдвоём — −10%' },
          { icon: 'person-plus-fill',text: 'Пятеро друзей — −50%' },
          { icon: 'trophy-fill',     text: 'Девять друзей — 10-я за 100 ₽' },
        ].map(p => (
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-4 py-2 text-sm text-white/85 backdrop-blur-sm">
            <i class={`bi bi-${p.icon} text-primary text-[13px]`} aria-hidden="true"></i>
            {p.text}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ЯКОРНАЯ НАВИГАЦИЯ ── -->
  <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-100 shadow-sm">
    <div class="mx-auto max-w-4xl px-4">
      <ul class="flex gap-1 overflow-x-auto py-3 scrollbar-none">
        {[
          { href: '#drug',      label: 'Едете вдвоём' },
          { href: '#pyatero',   label: 'Пятеро друзей' },
          { href: '#desyataya', label: '9 → 10-я за 100 ₽' },
        ].map(({ href, label }) => (
          <li class="shrink-0">
            <a
              href={href}
              class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-4 py-1.5 text-[15px] font-medium text-slate-700 transition hover:border-primary hover:bg-primary/5 hover:text-primary"
            >
              <i class="bi bi-chevron-right text-[11px] text-primary" aria-hidden="true"></i>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ── МЕРЧ ── -->
  <section class="bg-white border-b border-slate-100 py-10 md:py-14">
    <div class="mx-auto max-w-4xl px-4">
      <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-3">Фирменный мерч</div>
      <h2 class="text-[26px] md:text-[34px] font-bold leading-[1.1] tracking-[-0.02em] text-slate-900 mb-8">
        Худи АйДаКемп Junior — обоим участникам акции
      </h2>

      <div class="grid md:grid-cols-2 gap-8 items-center">
        <!-- Фото с лайтбоксом -->
        <button
          type="button"
          id="merch-open"
          class="group relative w-full rounded-[20px] overflow-hidden border border-slate-200 shadow-[0_4px_16px_rgba(15,23,42,.06)] cursor-zoom-in"
          aria-label="Посмотреть худи крупнее"
        >
          <img
            src="/images/merch-hoodie-junior.avif"
            alt="Фирменное худи АйДаКемп Junior — оранжевое, с лого"
            width="640" height="640"
            loading="eager"
            class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
          >
          <div class="absolute inset-0 flex items-end justify-end p-4 pointer-events-none">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-black/50 px-3 py-1.5 text-[13px] text-white backdrop-blur-sm">
              <i class="bi bi-zoom-in" aria-hidden="true"></i>
              Увеличить
            </span>
          </div>
        </button>

        <!-- Описание -->
        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-3">
            {[
              { icon: 'stars',          title: 'Оранжевое худи Junior', text: 'Вышитый логотип АйДаКемп, принт с Python-кодом на спине — «# TODO: become a pro»' },
              { icon: 'people-fill',    title: 'Обоим участникам', text: 'Тот, кто позвал, и тот, кого позвали — оба получают худи' },
              { icon: 'geo-alt-fill',   title: 'Выдаём при заезде', text: 'В первый день смены, без лишних условий' },
              { icon: 'shield-check',   title: '1-й сезон — First Deploy', text: 'Коллекция 2026. Носят весь сезон как знак принадлежности к комьюнити' },
            ].map(item => (
              <div class="flex items-start gap-3 rounded-[14px] bg-slate-50 border border-slate-100 p-4">
                <div class="w-9 h-9 rounded-[10px] bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-[18px] shrink-0">
                  <i class={`bi bi-${item.icon}`} aria-hidden="true"></i>
                </div>
                <div>
                  <div class="text-[16px] font-semibold text-slate-900 mb-0.5">{item.title}</div>
                  <div class="text-[16px] text-slate-500 leading-snug">{item.text}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Лайтбокс мерча -->
  <dialog
    id="merch-lightbox"
    class="m-0 h-full w-full max-w-none border-0 bg-black/90 p-4 backdrop:bg-black/90 outline-none"
    aria-label="Просмотр мерча"
  >
    <button type="button" id="merch-lightbox-close" aria-label="Закрыть"
      class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors">
      <i class="bi bi-x-lg text-[18px]" aria-hidden="true"></i>
    </button>
    <div class="flex h-full items-center justify-center">
      <img
        src="/images/merch-hoodie-junior.avif"
        alt="Фирменное худи АйДаКемп Junior"
        class="max-h-[90vh] max-w-full rounded-[20px] object-contain shadow-2xl"
        width="1280" height="1280"
      >
    </div>
  </dialog>
  <script>
    const btn   = document.getElementById('merch-open');
    const dlg   = document.getElementById('merch-lightbox') as HTMLDialogElement | null;
    const close = document.getElementById('merch-lightbox-close');
    btn?.addEventListener('click', () => dlg?.showModal());
    close?.addEventListener('click', () => dlg?.close());
    dlg?.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  </script>

  <!-- ── АКЦИИ ── -->
  <div class="mx-auto max-w-4xl px-4 py-14 md:py-20 space-y-14">

    <!-- АКЦИЯ 1: Едете вдвоём -->
    <section id="drug" class="scroll-mt-20">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-[12px] bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-[20px] shrink-0">
          <i class="bi bi-people-fill" aria-hidden="true"></i>
        </div>
        <div>
          <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-0.5">Акция 1</div>
          <h2 class="text-[24px] md:text-[32px] font-bold leading-tight tracking-[-0.02em] text-slate-900">Едете с другом</h2>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Левая: суть -->
        <div class="rounded-[20px] bg-primary border border-primary/80 p-7 flex flex-col gap-4">
          <div class="text-[68px] font-black leading-none tracking-[-0.04em] text-[#1e2430]">−10%</div>
          <p class="text-[16px] text-[#1e2430]/70 leading-relaxed">
            Запишитесь вместе в одну смену — каждый получит скидку 10% и фирменный мерч по факту заезда.
          </p>
          <ul class="space-y-2 text-[16px] text-[#1e2430]/80">
            {[
              'Скидка — обоим участникам',
              'Можно в разные отряды внутри смены',
              'Мерч выдаётся в первый день',
              'Промокод не нужен',
            ].map(li => (
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg shrink-0 mt-0.5" aria-hidden="true"></i>
                {li}
              </li>
            ))}
          </ul>
        </div>

        <!-- Правая: шаги -->
        <div class="rounded-[20px] bg-white border border-slate-200 p-7 shadow-[0_4px_16px_rgba(15,23,42,.06)] flex flex-col gap-5">
          <h3 class="text-[17px] font-bold text-slate-900">Как оформить</h3>
          {[
            { num: '1', title: 'Напишите нам вместе', text: 'Оба называете имена — фиксируем связку.' },
            { num: '2', title: 'Запись в одну смену', text: 'Скидка применяется автоматически.' },
            { num: '3', title: 'Мерч при заезде', text: 'Фирменное худи АйДаКемп — в первый день.' },
          ].map(s => (
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold flex items-center justify-center shrink-0 mt-0.5">{s.num}</div>
              <div>
                <div class="text-[16px] font-semibold text-slate-900 mb-0.5">{s.title}</div>
                <div class="text-[16px] text-slate-500">{s.text}</div>
              </div>
            </div>
          ))}
          <a href={TELEGRAM_URL} target="_blank" rel="noopener"
             class="mt-auto inline-flex items-center justify-center gap-2 rounded-[14px] bg-primary text-[#1e2430] font-semibold text-[15px] px-5 py-3 min-h-[44px] transition-all hover:bg-[#d68830] hover:-translate-y-[1px] hover:shadow-[0_4px_16px_rgba(236,155,68,.35)]">
            <i class="bi bi-telegram" aria-hidden="true"></i>
            Написать в Telegram
          </a>
        </div>
      </div>
    </section>

    <hr class="border-slate-200">

    <!-- АКЦИЯ 2: Пятеро друзей -->
    <section id="pyatero" class="scroll-mt-20">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-[12px] bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-[20px] shrink-0">
          <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
        </div>
        <div>
          <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-0.5">Акция 2</div>
          <h2 class="text-[24px] md:text-[32px] font-bold leading-tight tracking-[-0.02em] text-slate-900">Приводишь пятерых</h2>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-[20px] bg-slate-900 border border-slate-800 p-7 flex flex-col gap-4">
          <div class="text-[68px] font-black leading-none tracking-[-0.04em] text-primary">−50%</div>
          <p class="text-[16px] text-white/65 leading-relaxed">
            Приведите пятерых друзей в АйДаКемп — ваша путёвка идёт со скидкой 50%.
          </p>
          <ul class="space-y-2 text-[16px] text-white/75">
            {[
              'Скидка применяется к вашей путёвке',
              'Пятеро должны записаться в любую смену',
              'Связку фиксирует менеджер при записи',
              'Суммируется с акцией «Едете вдвоём»',
            ].map(li => (
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
                {li}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-[20px] bg-white border border-slate-200 p-7 shadow-[0_4px_16px_rgba(15,23,42,.06)] flex flex-col gap-4">
          <h3 class="text-[17px] font-bold text-slate-900 mb-1">Пример расчёта</h3>
          <div class="space-y-3 text-[16px]">
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
              <span class="text-slate-600">Смена 3, 13 дней</span>
              <span class="font-semibold text-slate-900">{fmt(s3Price)} ₽</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
              <span class="text-slate-600">Скидка 50%</span>
              <span class="font-semibold text-green-600">−{fmt(s3Discount)} ₽</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-slate-900 font-bold">Ваша цена</span>
              <span class="text-[20px] font-black text-primary">{fmt(s3Discount)} ₽</span>
            </div>
          </div>
          <div class="rounded-[10px] bg-primary/8 border border-primary/15 px-4 py-3 text-[14px] text-slate-700 leading-snug mt-auto">
            <i class="bi bi-info-circle text-primary mr-1.5" aria-hidden="true"></i>
            Скидка применяется к текущей цене смены на момент записи
          </div>
        </div>
      </div>
    </section>

    <hr class="border-slate-200">

    <!-- АКЦИЯ 3: Девятеро → 10-я бесплатно -->
    <section id="desyataya" class="scroll-mt-20">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-[12px] bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-[20px] shrink-0">
          <i class="bi bi-trophy-fill" aria-hidden="true"></i>
        </div>
        <div>
          <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-0.5">Акция 3</div>
          <h2 class="text-[24px] md:text-[32px] font-bold leading-tight tracking-[-0.02em] text-slate-900">Приводишь девятерых</h2>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-[20px] bg-primary border border-primary/80 p-7 flex flex-col gap-4">
          <div class="text-[52px] font-black leading-tight tracking-[-0.03em] text-[#1e2430]">10-я путёвка<br>за 100 ₽</div>
          <p class="text-[16px] text-[#1e2430]/70 leading-relaxed">
            Запишитесь сами и приведите ещё девятерых — ваша путёвка обойдётся в символические 100 рублей.
          </p>
          <ul class="space-y-2 text-[16px] text-[#1e2430]/80">
            {[
              'Вы + 9 друзей в любые смены лета 2026',
              'Девять путёвок оплачены — ваша за 100 ₽',
              'Оформляется через менеджера',
              'Суммируется с акцией «Едете вдвоём»',
            ].map(li => (
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg shrink-0 mt-0.5" aria-hidden="true"></i>
                {li}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-[20px] bg-white border border-slate-200 p-7 shadow-[0_4px_16px_rgba(15,23,42,.06)] flex flex-col gap-4">
          <h3 class="text-[17px] font-bold text-slate-900 mb-1">Как это работает</h3>
          <div class="space-y-4">
            {[
              { icon: 'person-fill',      text: 'Вы записываетесь первым — фиксируем вас как организатора группы' },
              { icon: 'people-fill',      text: 'Приводите друзей — каждый называет ваше имя при записи' },
              { icon: '9-circle-fill',    text: 'Когда девятый друг записался — сообщаем вам' },
              { icon: 'gift-fill',        text: 'Ваша путёвка переходит в статус «100 ₽» автоматически' },
            ].map(s => (
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-[10px] bg-primary/10 border border-primary/20 text-primary text-[16px] flex items-center justify-center shrink-0">
                  <i class={`bi bi-${s.icon}`} aria-hidden="true"></i>
                </div>
                <p class="text-[16px] text-slate-600 leading-relaxed pt-1">{s.text}</p>
              </div>
            ))}
          </div>
          <a href={PHONE_MAIN_HREF}
             class="mt-auto inline-flex items-center justify-center gap-2 rounded-[14px] bg-primary text-[#1e2430] font-semibold text-[15px] px-5 py-3 min-h-[44px] transition-all hover:bg-[#d68830] hover:-translate-y-[1px] hover:shadow-[0_4px_16px_rgba(236,155,68,.35)]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>
            Позвонить — уточнить условия
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- ── ПРОШЛЫЕ СМЕНЫ ── -->
  <section class="bg-slate-50 border-y border-slate-200 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4">
      <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-3">Как это было</div>
      <h2 class="text-[26px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900 mb-2">
        Прошлые смены
      </h2>
      <p class="text-base text-slate-500 mb-10 max-w-xl leading-relaxed">
        Чтобы понять зачем ехать — посмотрите как прошли смены 1 и 2. Фото, видео, проекты ребят.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Смена 1 -->
        <a href="/kak-proshla-smena-1" class="group block rounded-[20px] bg-white border border-slate-200 shadow-[0_4px_16px_rgba(15,23,42,.06)] overflow-hidden transition-all hover:-translate-y-[2px] hover:shadow-[0_8px_24px_rgba(15,23,42,.10)]">
          <div class="aspect-[16/9] bg-slate-100 overflow-hidden relative">
            <img
              src="/images/gallery/smena1-005.jpg"
              alt="Смена 1 АйДаКемп — 30 мая — 8 июня 2026"
              width="640" height="360"
              loading="lazy" decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            >
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500 px-3 py-1 text-[12px] font-semibold text-white">
                <i class="bi bi-check-circle-fill text-[11px]" aria-hidden="true"></i>
                Завершена
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-1">Смена 1</div>
            <h3 class="text-[20px] font-bold text-slate-900 mb-2 leading-snug">30 мая — 8 июня 2026</h3>
            <p class="text-[16px] text-slate-500 leading-relaxed mb-4">
              10 дней, 45 участников. Python, AI-проекты, хакатон в финале. Каждый уехал с готовым продуктом.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {['10 дней', '45 участников', 'Python · AI'].map(t => (
                <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-[12px] text-slate-600">{t}</span>
              ))}
            </div>
            <div class="inline-flex items-center gap-1.5 text-primary font-semibold text-[16px] group-hover:gap-2.5 transition-all">
              Смотреть репортаж
              <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </div>
          </div>
        </a>

        <!-- Смена 2 -->
        <a href="/kak-proshla-smena-2" class="group block rounded-[20px] bg-white border border-slate-200 shadow-[0_4px_16px_rgba(15,23,42,.06)] overflow-hidden transition-all hover:-translate-y-[2px] hover:shadow-[0_8px_24px_rgba(15,23,42,.10)]">
          <div class="aspect-[16/9] bg-slate-100 overflow-hidden relative">
            <img
              src="/images/gallery/smena2/IMG_3846.avif"
              alt="Смена 2 АйДаКемп — 10–23 июня 2026"
              width="640" height="360"
              loading="lazy" decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            >
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500 px-3 py-1 text-[12px] font-semibold text-white">
                <i class="bi bi-check-circle-fill text-[11px]" aria-hidden="true"></i>
                Завершена
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="text-[11px] font-bold tracking-[.1em] uppercase text-primary mb-1">Смена 2</div>
            <h3 class="text-[20px] font-bold text-slate-900 mb-2 leading-snug">10 — 23 июня 2026</h3>
            <p class="text-[16px] text-slate-500 leading-relaxed mb-4">
