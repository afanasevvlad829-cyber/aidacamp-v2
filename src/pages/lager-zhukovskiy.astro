---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { SEASON_MONTHS_NOM, PAST_SHIFTS_SENTENCE } from '../data/evergreen';
import { CONTENT_OVERRIDES } from '../data/content-overrides';

// Точечные SEO-переопределения текста в общих компонентах — см. content-overrides.ts
const ov = CONTENT_OVERRIDES['/lager-zhukovskiy/'];

const sections = [
  {
    h2: "Как устроена жизнь в лагере и для кого она",
    text: `Это АйДаКемп — IT-программа в загородном лагере на базе санатория «Изумруд» (Наро-Фоминский округ), для ребят 7–15 лет. Реальная программа: Python, AI, Minecraft, 3D — а не «основы компьютера». Цены открытых августовских смен — от ${PRICE_MIN} за 10 дней, есть налоговый вычет 13% и трансфер от м. Солнцево (${TRANSFER_PRICE_FMT}). Как добраться до лагеря — разбираем ниже отдельным блоком.`
  },
  {
    h2: "Почему родители выбирают АйДаКемп",
    text: "Здесь авиационный наукоград: ЦАГИ, ЛИИ имени Громова. В инженерных и авиационных семьях уважают настоящее образование — и в нашем лагере оно именно такое. Не «основы компьютерной грамотности», а Python, AI и собственные проекты. От авиации к IT — следующий шаг для технических семей.",
    list: [
      "Реальная IT-программа — Python, AI, Minecraft, 3D-моделирование",
      "Без акклиматизации — Подмосковье, привычный климат",
      "Лицензия Минобрнауки, налоговый вычет 13%",
      `Трансфер от м. Солнцево (${TRANSFER_PRICE_FMT}) — логистика решена`
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "1 преподаватель на 6–8 участников — такое соотношение даёт возможность поработать с каждым лично. Вожатые — студенты технических вузов и практикующие IT-специалисты, для которых это не подработка, а призвание.",
    list: [
      "Медработник в лагере круглосуточно — безопасность гарантирована",
      "Telegram-фото и видео каждый день — родители видят, чем занимается их ребёнок",
      "Соотношение 1:6–8 — никто не теряется в толпе",
      "Места на смены есть — запишитесь, чтобы выбрать удобные даты"
    ]
  },
  {
    h2: "IT-программа для детей 7–15 лет",
    text: "Дети 7–15 лет выбирают IT-трек по интересу. Летний режим лагеря: занятия дважды в день по 90 минут, группы до 8 человек — каждый в центре внимания. В конце смены — хакатон, где каждый ребёнок защищает свой проект перед командой.",
    list: [
      "Python — от переменных до телеграм-бота за смену",
      "Scratch — визуальные игры для младших детей 7–10 лет",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — ChatGPT API, обучение собственной модели",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Что чаще всего решает для технических семей",
    text: "Из авиационных наукоградов к нам едут те, кто разбирается в инженерном деле сам — и особенно придирчив к программе. Что для них оказывается важным:",
    list: [
      "Настоящая IT-программа вместо «основ компьютера» — из лагеря ребёнок возвращается с работающим проектом",
      "1.5 часа по Егорьевскому шоссе — приемлемое плечо, а трансфер снимает вопрос «как везти»",
      "Дети продолжают общаться после смены и доделывают проекты онлайн"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены`,
    text: `Смены идут ${SEASON_MONTHS_NOM} ${SEASON_YEAR}. ${PAST_SHIFTS_SENTENCE} — к записи открыты две августовские. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, активные вечерние мероприятия.`,
    list: [
      `Смена 2.1 (завершена): ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена): ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2} (была самой популярной)`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3} (места есть)`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4} (места есть)`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону`
    ]
  },
  {
    h2: "Маршрут: на машине и на электричке",
    text: "Город авиационный, с удобным выездом в сторону Москвы. Добраться до лагеря можно двумя способами.",
    list: [
      "На машине: по Егорьевскому шоссе → МКАД → Киевское шоссе (M-3) → санаторий «Изумруд». ~85 км, ~1 ч 20 мин без пробок",
      `На электричке + трансфер: от местной станции до Казанского вокзала (~45 мин) → метро до м. Солнцево → трансфер АйДаКемп ${TRANSFER_PRICE_FMT}`,
      "Совет: выбирайте дорогу через Раменское — там меньше пробок на выезде из города"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "В АйДаКемп едут школьники из юго-востока Подмосковья:",
    list: [
      "<a href='/lager-lubertsy/'>Люберцы</a> — удобнее через м. Солнцево, общий трансфер",
      "<a href='/lager-reutov/'>Реутов</a> — удобнее через м. Солнцево, общий трансфер",
      "<a href='/lager-vidnoe/'>Видное</a> — удобнее через м. Солнцево, общий трансфер",
      "<a href='/lager-stupino/'>Ступино</a> — удобнее через м. Солнцево, общий трансфер"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`IT-смены АйДаКемп рядом с Жуковским ${SEASON_YEAR}`}
  description={`У нас летом: IT-смены для детей 7–15 лет. Трансфер, налоговый вычет.`}
  h1="Детский лагерь рядом с Жуковским"
  canonical="https://aidacamp.ru/lager-zhukovskiy"
>
  <Fragment slot="head">
    <CourseSchema
      name="IT-смена для детей — АйДаКемп"
      description="Смена в Наро-Фоминском округе, ~1.5 ч по Егорьевскому и Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-zhukovskiy"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Жуковским"
    subtitle={`IT-смены АйДаКемп в Наро-Фоминском округе. Python, AI, Minecraft для детей 7–15 лет, от ${PRICE_MIN}.`}
    breadcrumb="IT-смена рядом"
    keywords={["~1.5 ч через Егорьевское шоссе", "IT-смены: Python, AI, Minecraft для детей 7–15 лет", "Загородный формат с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="IT-смена для детей — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts shiftsGuideLinkText={ov?.shiftsGuideLinkText?.value} />
  <FAQ extraItems={[
    { q: "Как добраться до АйДаКемп?", a: `~85 км и ~1.5 часа: по Егорьевскому шоссе на запад → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Либо на автобусе или электричке до м. Солнцево (около 40 минут) и общий трансфер АйДаКемп (${TRANSFER_PRICE_FMT}).` },
    { q: "Есть ли прямой трансфер?", a: `Прямого трансфера нет — организованный трансфер отправляется от м. Солнцево (${TRANSFER_PRICE_FMT} в одну сторону, с сопровождающим до места).` },
    { q: "Сколько стоит путёвка на смену?", a: `Открытые августовские смены — от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} отдельно.` }
  ]} items={['documents:0', 'payment:0', 'payment:1']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">IT-смены для детей в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться к нам</a>
    </p>
  </div>
  <RelatedPages title={ov?.relatedPagesTitle?.value} pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
