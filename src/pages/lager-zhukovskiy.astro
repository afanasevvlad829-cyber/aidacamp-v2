---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Жуковского до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 85 км от Жуковского, примерно 1.5 часа езды. Маршрут: по Егорьевскому шоссе на запад → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Организованный трансфер отправляется от м. Солнцево — до Солнцево из Жуковского удобно добраться на автобусе или электричке до Москвы."
  },
  {
    h2: "Почему родители из Жуковского выбирают АйДаКемп",
    text: "Жуковский — авиационный наукоград, где сосредоточены ЦАГИ и ЛИИ имени Громова. В инженерных и авиационных семьях уважают настоящее образование — и АйДаКемп именно такой. Не «основы компьютерной грамотности», а Python, AI и собственные проекты. От авиации к IT — следующий шаг для технических семей Жуковского.",
    list: [
      "Реальная IT-программа — Python, AI, Minecraft, 3D-моделирование",
      "Без акклиматизации — Подмосковье, привычный климат",
      "Лицензия Минобрнауки, налоговый вычет 13%",
      "Трансфер от м. Солнцево (2 000 ₽) — логистика решена"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "1 преподаватель на 6–8 участников — такое соотношение даёт возможность поработать с каждым лично. Вожатые — студенты технических вузов и практикующие IT-специалисты, для которых лагерь не подработка, а призвание.",
    list: [
      "Медработник в лагере круглосуточно — безопасность гарантирована",
      "Telegram-фото и видео каждый день — родители видят, чем занимается их ребёнок",
      "Соотношение 1:6–8 — никто не теряется в толпе",
      "Июль 2026 занят полностью. В июне и августе места есть — запишитесь сейчас"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Жуковского",
    text: "Дети 7–15 лет выбирают IT-трек по интересу. Занятия дважды в день по 90 минут, группы до 8 человек. В конце смены — хакатон, где каждый ребёнок защищает свой проект перед командой.",
    list: [
      "Python — от переменных до телеграм-бота за смену",
      "Scratch — визуальные игры для младших детей 7–10 лет",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — ChatGPT API, обучение собственной модели",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Технические семьи из Жуковского и Раменского района ценят качество программы:",
    list: [
      "«Жуковский — город авиаторов и инженеров, мы хотели для сына настоящую IT-программу. АйДаКемп не разочаровал: он вернулся с ботом на Python и планами на следующую смену» — Дмитрий, Жуковский",
      "«1.5 часа по Егорьевскому шоссе — нормально для такого лагеря. Дочь сдружилась с ребятами, теперь вместе делают проект онлайн» — Марина, Жуковский"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 99 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Маршрут из Жуковского: на машине и на электричке",
    text: "Жуковский — авиационный город с удобным выездом в сторону Москвы. До лагеря можно добраться двумя способами.",
    list: [
      "На машине: из Жуковского по Егорьевскому шоссе → МКАД → Киевское шоссе (M-3) → санаторий «Изумруд». ~85 км, ~1 ч 20 мин без пробок",
      "На электричке + трансфер: электричка Жуковский — Казанский вокзал (~45 мин) → метро до м. Солнцево → трансфер АйДаКемп 2 000 ₽",
      "Совет: выбирайте дорогу через Раменское — там меньше пробок на выезде из города"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "В АйДаКемп едут дети из Жуковского и юго-востока Подмосковья:",
    list: [
      "<a href='/lager-lubertsy'>Люберцы</a> — ~75 км, ~1 ч 20 мин через МКАД",
      "<a href='/lager-reutov'>Реутов</a> — ~75 км, ~1 ч 20 мин по МКАД",
      "<a href='/lager-vidnoe'>Видное</a> — ~55 км, ~1 ч прямо по Киевскому",
      "<a href='/lager-stupino'>Ступино</a> — ~100 км, ~1 ч 30 мин через М-4"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний лагерь Жуковский 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Жуковского: ~1.5 ч по Егорьевскому шоссе → МКАД → Киевское. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Жуковским"
  canonical="https://aidacamp.ru/lager-zhukovskiy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Жуковского до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Жуковского около 85 км и ~1.5 часа: по Егорьевскому шоссе на запад → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или до м. Солнцево и трансфер лагеря (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Жуковского до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часа на автомобиле (85 км через Егорьевское шоссе → МКАД → Киевское). До м. Солнцево из Жуковского — около 40 минут, затем трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Жуковского?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Жуковского нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Жуковского можно доехать до Солнцево на автобусе или электричке через Москву." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Жуковского?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 99 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Жуковским — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Жуковского. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-zhukovskiy"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Жуковским"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Жуковского по Егорьевскому шоссе → МКАД → Киевское. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Жуковского"
    keywords={["~1.5 ч от Жуковского через Егорьевское шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Жуковским — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
