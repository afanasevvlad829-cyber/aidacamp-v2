---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Коломны до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе Московской области. Из Коломны ехать около 2 часов: по Новорязанскому шоссе (М-5) до МКАД, затем по МКАД на запад и далее по Киевскому шоссе (M-3) до посёлка Атепцево. Расстояние около 130 км. Можно также добраться до м. Солнцево (около 1.5 часа на электричке до Казанского вокзала, затем метро) и сесть на организованный трансфер АйДаКемп."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Коломной",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Коломны выбирают АйДаКемп",
    text: "Из Коломны до лагеря — около 2 часов, но качество программы того стоит. Вот что говорят родители:",
    list: [
      "Подмосковье — привычный климат, никакой акклиматизации, ребёнок сразу в ритме",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ отзывов от семей со всего Подмосковья",
      "Трансфер от м. Солнцево снимает вопрос логистики"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 000 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Коломны и юго-востока Подмосковья",
    text: "В АйДаКемп едут дети из Коломны, Воскресенска, Луховиц и других городов юго-востока Подмосковья:",
    list: [
      "«Два часа до лагеря? Зато дочь вернулась с настоящим приложением на Python. Я не ожидала, что за 14 дней можно так далеко продвинуться» — Ольга, Коломна",
      "«Отвезли сына сами, забрали сами. На М-5 пробок в область нет. Зато видели его проект на хакатоне — стоило ехать» — Андрей, Коломна"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Коломной 2026 | АйДаКемп"
  description="Детский IT-лагерь рядом с Коломной — ~2 ч через Новорязанское шоссе → МКАД → Киевское. Python, AI, Minecraft. От 48 000 ₽."
  h1="Детский лагерь рядом с Коломной"
  canonical="https://aidacamp.ru/lager-kolomna"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Коломны до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Коломны до лагеря около 130 км и ~2 часа езды: по Новорязанскому шоссе (М-5) → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или добраться до м. Солнцево и сесть на организованный трансфер АйДаКемп (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Коломны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Коломны нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Коломны можно добраться на электричке до Казанского вокзала, затем на метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для поступления в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Коломны?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Коломной — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~2 ч от Коломны. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-kolomna"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Коломной"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~2 ч из Коломны через Новорязанское шоссе → МКАД → Киевское. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Коломны"
    keywords={["~2 ч из Коломны через М-5 → МКАД → Киевское шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Коломной — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
