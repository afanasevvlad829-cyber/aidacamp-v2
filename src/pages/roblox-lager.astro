---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "IT-camp роблокс — геймдев для детей 9–14 лет",
    text: "Roblox Studio — профессиональная среда разработки 3D-проектов, в которой работают в том числе взрослые студии. В АйДаКемп ребята 9–14 лет учатся не просто пользоваться готовым, а создавать собственные миры — со своей логикой, персонажами и монетизацией. За смену школьники разрабатывают полноценный мини-проект, который можно опубликовать в каталоге для миллионов пользователей. АйДаКемп — <a href='/it-camp/' class='text-[#ec9b44] hover:underline'>IT-camp</a> для геймеров: учим создавать, а не только потреблять готовое. Эта студия — один из технических треков нашей <a href='/kompyuternyy-lager/' class='text-[#ec9b44] hover:underline'>компьютерной программы</a>."
  },
  {
    h2: "Технический стек: Roblox Studio + Lua",
    text: "Это — профессиональный движок с редактором уровней, физическим движком и IDE для программирования. Официальный язык — Lua. Вот что осваивают на смене:",
    list: [
      "IDE редактора — интерфейс, панели Properties и Explorer, Workspace, Services",
      "Lua — синтаксис, переменные, функции, таблицы (аналог словарей в Python). Настоящий язык программирования",
      "Типы проектов: obby (полоса препятствий), simulator (ресурсы и прокачка), tycoon (строительство и экономика), RPG-мини",
      "Клиент-серверная модель — LocalScript vs Script, RemoteEvents для мультиплеера",
      "Сервисы платформы: TweenService (анимации), DataStoreService (сохранение), MarketplaceService (монетизация)"
    ]
  },
  {
    h2: "Программа по дням — что осваивают на смене",
    text: "Прогрессия от «первого объекта» до публикации проекта за 10 дней. Вот как это выглядит:",
    list: [
      "Дни 1–2: интерфейс редактора — панели, инструменты, навигация. Создание первой сцены: земля, стены, платформы. Базовые Parts и свойства объектов",
      "Дни 3–5: введение в Lua — переменные, условия, функции. Первый скрипт: кнопка открывает дверь. Скрипты-сервисы: TweenService, Humanoid. Ощущение «код управляет процессом»",
      "Дни 6–8: игровые механики. Система очков, таймер, спавн врагов или препятствий, GUI (интерфейс для игрока). Начало финального проекта — каждый выбирает жанр",
      "Дни 9–10 (или до 14 в длинной смене): финальная доработка проекта. Добавление уровней, звуков, анимаций, декора. Тестирование совместно с другими ребятами",
      "Финал: публикация проекта в каталоге, хакатон — каждый показывает результат, ребята из группы тестируют его вживую"
    ]
  },
  {
    h2: "Для какого возраста подходит camp роблокс",
    text: "Этот трек рассчитан на детей 9–14 лет. Разница по возрастам ощутима:",
    list: [
      "9–10 лет: идеальный старт — платформа уже знакома, интерфейс Studio похож на то, что видели раньше. За смену дойдут до простого рабочего проекта с механиками и публикуют его",
      "11–12 лет: могут полноценно работать с Lua-скриптами. Создают более сложные механики: несколько уровней, система команд, NPC с поведением",
      "13–14 лет: продвинутая группа, изучают архитектуру платформы (клиент-сервер модель, RemoteEvents), могут сделать полноценный мультиплеерный проект",
      "8 лет (исключение): берём если ребёнок хорошо знает платформу и умеет читать. Попадёт в младшую группу, поможет знание среды"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену на треке роблокс",
    text: "Финал смены — опубликованный проект, который можно запустить с любого устройства и показать друзьям. Примеры:",
    list: [
      "Обби (Obby) — полоса препятствий с 10+ уровнями, таймером и таблицей рекордов",
      "Шутер / тимдезматч — командный проект с оружием, HP, respawn-системой и счётом",
      "Симулятор — ферма, магазин или парк с ресурсами, прокачкой и монетами",
      "RPG-мини — персонаж, квест, НПС с диалогами, боевая система",
      "Horror-проект — атмосферный уровень с монстром, скримерами и финальным боссом"
    ]
  },
  {
    h2: "Безопасность на платформе — что важно знать для родителей",
    text: "Это не только среда для разработки, но и социальная сеть с миллионами чужих проектов. Это создаёт риски, о которых родители часто не знают. Перед тем как отпустить ребёнка в эту среду, имеет смысл настроить аккаунт правильно:",
    list: [
      "Включить родительский контроль в настройках — ограничение чата и финансовых операций",
      "Привязать родительский email — все уведомления и подтверждения идут вам",
      "Запретить покупки без пароля — Robux стоят настоящие деньги",
      "Проверить Privacy Settings — запретить чат с незнакомцами, запретить friend-requests",
      "На смене мы объясняем ребятам про social engineering: фейковые обещания «бесплатных Robux», фишинг, подозрительные личные вопросы от незнакомцев"
    ]
  },
  {
    h2: "Места на трек роблокс разбирают заранее",
    text: "Трек роблокс бронируют рано: многие школьники записываются сразу после анонса смен. Проверьте доступные даты при записи — часть групп быстро заполняется."
  },
];

---

<LandingLayout
  heroImage="/images/hero/roblox-lager.avif"
  title={`Лагерь Roblox для детей в Подмосковье ${SEASON_YEAR} года`}
  description={`Лагерь Roblox Studio в Подмосковье: геймдев для детей и подростков. Они создают 3D-игры на Lua. Летние смены ${SEASON_YEAR}, 66 км от МКАД. От ${PRICE_MIN}.`}
  h1={`Лагерь Roblox 9–14 лет в Подмосковье`}
  canonical="https://aidacamp.ru/roblox-lager"
  breadcrumb="Лагерь Roblox"
>
  <Fragment slot="head">
    <CourseSchema
      name="Лагерь Roblox Studio для детей — создание 3D-игр на Lua"
      description="Летний лагерь Roblox Studio для детей 9–14 лет: создание 3D-игр на Lua с нуля до публикации в каталоге Roblox. За 7 или 14 дней."
      url="https://aidacamp.ru/roblox-lager"
      level="Beginner"
      ageMin={9}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Лагерь Roblox 9–14 лет в Подмосковье`}
    subtitle="Не играть, а создавать. За 10–14 дней ребёнок разрабатывает собственный 3D-проект в Roblox Studio с программированием на Lua."
    breadcrumb="Лагерь Roblox"
    keywords={["Профессиональный стек геймдева: движок + Lua", "Собственный проект-публикация в финале смены", "9–14 лет, группы до 8 человек"]}
    image="/images/hero/roblox-lager.avif"
    imageAlt="Лагерь Roblox для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:4', 'documents:0', 'about2026:5', 'documents:2']} extraItems={[
    { q: "Что такое camp роблокс для детей?", a: "Летняя программа с проживанием, где ребята не играют, а создают собственные проекты в Roblox Studio на языке Lua. За смену ребёнок разрабатывает 3D-проект и публикует его в каталоге." },
    { q: "Чему учат на смене роблокс?", a: "Это — профессиональный инструмент геймдева. Ребята изучают основы программирования на Lua, 3D-дизайн уровней, игровую логику, физику объектов. К концу смены — опубликованный проект в каталоге." },
    { q: "С какого возраста подходит camp роблокс?", a: "С 9 лет. АйДаКемп принимает ребят 9–14 лет на этот трек. Предварительные знания программирования не нужны." },
    { q: "Что ребёнок сделает за смену на треке роблокс?", a: "Собственный 3D-проект в этой среде, опубликованный в каталоге. Его можно запускать и показывать друзьям после возвращения домой. Проект защищается на хакатоне в финале смены." },
    { q: "Что такое Lua и зачем его учить на платформе?", a: "Lua — официальный язык программирования этой платформы. На нём написана вся игровая логика: движение персонажей, система очков, двери, враги. Это настоящий язык программирования — освоив Lua, ребёнок понимает концепции которые применимы в Python и JavaScript." },
    { q: "Мой ребёнок «живёт» в роблокс — подойдёт ли ему наша программа?", a: "Отлично! Знание платформы — преимущество. Наша задача — переключить его с потребителя на создателя. Ребёнок уже знает, как выглядит хороший проект — теперь научится делать такие сам." },
    { q: "Можно ли зарабатывать на проектах в роблокс?", a: "Да. Платформа выплачивает авторам Robux, которые конвертируются в реальные деньги через программу DevEx. Топовые молодые разработчики зарабатывают сотни тысяч рублей в год. Понимание «мой труд приносит деньги» — отличная мотивация для ребёнка." }
  ]} />
  <RelatedArticles articles={[
    { title: "Платформа для детей — польза, риски и что с этим делать", url: "/stati/roblox-dlya-detej/", description: "Чем полезна платформа, риски и как направить интерес к созданию проектов.", icon: "controller" },
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej/", description: "Minecraft, Tinkercad, Blender — как дети осваивают 3D.", icon: "box" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "От игровых конструкторов до Python — логичный путь развития.", icon: "braces" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-base text-slate-500">
    Полезная статья: <a href="/stati/roblox-dlya-detej/" class="text-primary hover:underline">Платформа для детей: польза и как начать</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
