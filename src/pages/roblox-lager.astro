---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "IT-camp роблокс — геймдев для детей 9–14 лет",
    text: "Roblox Studio — профессиональная среда разработки 3D-проектов. Ребята 9–14 лет создают собственные миры и игры со своей логикой и персонажами и публикуют мини-проект в каталоге. АйДаКемп — <a href='/it-camp/' class='text-[#ec9b44] hover:underline'>IT-camp</a> для геймеров: учим создавать, а не только потреблять готовое. Это один из треков нашей <a href='/kompyuternyy-lager/' class='text-[#ec9b44] hover:underline'>компьютерной программы</a>."
  },
  {
    h2: "Технический стек: Roblox Studio + Lua",
    text: "Профессиональный движок с редактором уровней и физикой. Официальный язык — Lua. На смене осваивают:",
    list: [
      "Редактор — интерфейс, панели Properties и Explorer, Workspace",
      "Lua — синтаксис, переменные, функции, таблицы",
      "Типы проектов: obby, simulator, tycoon, RPG-мини"
    ]
  },
  {
    h2: "Программа по дням — что осваивают на смене",
    text: "От первого объекта до публикации проекта за 10 дней:",
    list: [
      "Дни 1–2: интерфейс редактора, первая сцена — земля, стены, платформы",
      "Дни 3–5: введение в Lua — переменные, условия, функции, первый скрипт",
      "Дни 6–8: механики игры — очки, таймер, препятствия, интерфейс для игрока",
      "Дни 9–10: доработка проекта, тестирование, публикация и хакатон"
    ]
  },
  {
    h2: "Для какого возраста подходит трек роблокс",
    text: "Трек рассчитан на детей 9–14 лет: группы делятся по возрасту, а за смену каждый доходит до рабочего проекта."
  },
  {
    h2: "Что ребёнок создаст за смену",
    text: "Опубликованный проект — целая игра, которую можно запустить с любого устройства и показать друзьям: обби, симулятор, шутер или RPG-мини — каждый показывает свою игру."
  },
  {
    h2: "Безопасность на платформе — что важно знать для родителей",
    text: "Стоит включить родительский контроль, привязать родительский email и запретить покупки без пароля — Robux стоят настоящие деньги. На смене мы объясняем ребятам про фейковые «бесплатные Robux» и фишинг."
  },
  {
    h2: "Места на трек роблокс разбирают заранее",
    text: "Многие школьники записываются сразу после анонса смен — проверьте доступные даты при записи."
  },
];

---

<LandingLayout
  heroImage="/images/hero/roblox-lager.avif"
  title={`Лагерь Roblox для детей 9–14 лет в Подмосковье — смены роблокс ${SEASON_YEAR} | АйДаКемп`}
  description={`Лагерь Roblox Studio в Подмосковье: геймдев для детей и подростков. Они создают 3D-игры на Lua. Летние смены ${SEASON_YEAR}, 66 км от МКАД. От ${PRICE_MIN}.`}
  h1={`Лагерь Roblox для детей 9–14 лет в Подмосковье: создаём 3D-игры на Lua`}
  canonical="https://aidacamp.ru/roblox-lager"
  breadcrumb="Лагерь Roblox"
>
  <Fragment slot="head">
    <CourseSchema
      name="Лагерь Roblox Studio для детей — создание 3D-игр на Lua"
      description="Летний лагерь Roblox Studio для детей 9–14 лет: создание 3D-игр на Lua с нуля до публикации в каталоге Roblox. За 7 или 14 дней."
      url="https://aidacamp.ru/roblox-lager"
      level="Beginner"
      ageMin={9}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Лагерь Roblox для детей 9–14 лет в Подмосковье: создаём 3D-игры на Lua`}
    subtitle="Не играть, а создавать. За 10–14 дней ребёнок разрабатывает собственный 3D-проект в Roblox Studio с программированием на Lua."
    breadcrumb="Лагерь Roblox"
    keywords={["Профессиональный стек геймдева: движок + Lua", "Собственный проект-публикация в финале смены", "9–14 лет, группы до 8 человек"]}
    image="/images/hero/roblox-lager.avif"
    imageAlt="Лагерь Roblox для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts slim />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
    { q: "Что такое camp роблокс для детей?", a: "Программа с проживанием: ребята создают собственные проекты в Roblox Studio на языке Lua и публикуют их в каталоге." },
    { q: "Чему учат на смене роблокс?", a: "Основам программирования на Lua, дизайну уровней, игровой логике и физике объектов. К концу смены — опубликованный проект." },
    { q: "С какого возраста подходит camp роблокс?", a: "С 9 лет. Принимаем ребят 9–14 лет, знание программирования не нужно." },
    { q: "Что ребёнок сделает за смену на треке роблокс?", a: "Собственный проект, опубликованный в каталоге: его можно показывать друзьям. Защита проекта — на хакатоне." },
    { q: "Что такое Lua и зачем его учить на платформе?", a: "Lua — официальный язык платформы: на нём написана вся игровая логика. Освоив его, ребёнок понимает идеи, применимые в Python и JavaScript." },
    { q: "Мой ребёнок «живёт» в роблокс — подойдёт ли ему наша программа?", a: "Отлично! Наша задача — переключить его с потребителя на создателя: он уже знает, как устроены хорошие игры." },
    { q: "Можно ли зарабатывать на проектах в роблокс?", a: "Да. Авторам платформа выплачивает Robux, которые конвертируются в деньги через программу DevEx — для ребёнка это отличная мотивация." }
  ]} />
  <RelatedArticles articles={[
    { title: "Платформа для детей — польза, риски и что с этим делать", url: "/stati/roblox-dlya-detej/", description: "Чем полезна платформа, риски и как направить интерес к созданию проектов.", icon: "controller" },
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej/", description: "Minecraft, Tinkercad, Blender — как дети осваивают 3D.", icon: "box" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "От игровых конструкторов до Python — логичный путь развития.", icon: "braces" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-base text-slate-500">
    Полезная статья: <a href="/stati/roblox-dlya-detej/" class="text-primary hover:underline">Платформа для детей: польза и как начать</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
