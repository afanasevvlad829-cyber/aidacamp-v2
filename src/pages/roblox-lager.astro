---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь Roblox — геймдев для детей 9–14 лет",
    text: "Roblox Studio — профессиональная среда разработки 3D-игр, в которой работают в том числе взрослые студии. В АйДаКемп дети 9–14 лет учатся не просто играть в Roblox, а создавать собственные миры — со своей логикой, персонажами и монетизацией. За смену ребята разрабатывают полноценную мини-игру, которую можно опубликовать в Roblox для миллионов игроков. АйДаКемп — <a href='/it-camp' class='text-[#ec7c00] hover:underline'>IT-лагерь</a> для геймеров: учим создавать игры, а не только играть. Roblox Studio — одна из программ нашего <a href='/kompyuternyy-lager' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a>."
  },
  {
    h2: "Технический стек: Roblox Studio + Lua",
    text: "Roblox Studio — это профессиональный движок с редактором уровней, физическим движком и IDE для программирования. Официальный язык — Lua. Вот что осваивают в лагере:",
    list: [
      "Roblox Studio IDE — интерфейс, панели Properties и Explorer, Workspace, Services",
      "Lua — синтаксис, переменные, функции, таблицы (аналог словарей в Python). Настоящий язык программирования",
      "Типы игр: obby (полоса препятствий), simulator (ресурсы и прокачка), tycoon (строительство и экономика), RPG-мини",
      "Клиент-серверная модель — LocalScript vs Script, RemoteEvents для мультиплеера",
      "Сервисы Roblox: TweenService (анимации), DataStoreService (сохранение), MarketplaceService (монетизация)"
    ]
  },
  {
    h2: "Программа Roblox Studio в лагере",
    text: "Занятия строятся от простого к сложному: сначала конструктор миров, потом программирование на Lua. Группы до 8 человек, преподаватель-практик рядом.",
    list: [
      "Roblox Studio — знакомство с редактором и 3D-окружением",
      "Создание персонажа и базовой сцены",
      "Программирование на Lua — скрипты поведения объектов",
      "Игровые механики — коллизии, прыжки, система очков",
      "Паблик в Roblox — публикация своей игры для сообщества"
    ]
  },
  {
    h2: "Программа Roblox по дням — что осваивают",
    text: "Прогрессия от «первого объекта» до публикации игры за 10 дней. Вот как это выглядит:",
    list: [
      "Дни 1–2: интерфейс Roblox Studio — панели, инструменты, навигация. Создание первой сцены: земля, стены, платформы. Базовые Parts и свойства объектов",
      "Дни 3–5: введение в Lua — переменные, условия, функции. Первый скрипт: кнопка открывает дверь. Скрипты-сервисы: TweenService, Humanoid. Ощущение «код управляет игрой»",
      "Дни 6–8: игровые механики. Система очков, таймер, спавн врагов или препятствий, GUI (интерфейс для игрока). Начало финального проекта — каждый выбирает жанр",
      "Дни 9–10 (или до 14 в длинной смене): финальная доработка игры. Добавление уровней, звуков, анимаций, декора. Тестирование совместно с другими ребятами",
      "Финал: публикация игры в Roblox, хакатон — каждый показывает проект, ребята из группы играют прямо сейчас"
    ]
  },
  {
    h2: "Для какого возраста подходит Roblox-лагерь",
    text: "Roblox-трек рассчитан на детей 9–14 лет. Разница по возрастам ощутима:",
    list: [
      "9–10 лет: идеальный старт — Roblox уже знаком, интерфейс Studio похож на то, что видели в игре. За смену дойдут до простой рабочей игры с механиками и публикуют её",
      "11–12 лет: могут полноценно работать с Lua-скриптами. Создают более сложные механики: несколько уровней, система команд, NPC с поведением",
      "13–14 лет: продвинутая группа, изучают архитектуру Roblox (клиент-сервер модель, RemoteEvents), могут сделать полноценную мультиплеерную игру",
      "8 лет (исключение): берём если ребёнок хорошо знает Roblox и умеет читать. Попадёт в младшую группу, поможет знание платформы"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену Roblox",
    text: "Финал смены — опубликованная в Roblox игра, которую можно запустить с любого устройства и показать друзьям. Примеры проектов:",
    list: [
      "Обби (Obby) — полоса препятствий с 10+ уровнями, таймером и таблицей рекордов",
      "Шутер / тимдезматч — командная игра с оружием, HP, respawn-системой и счётом",
      "Симулятор — ферма, магазин или парк с ресурсами, прокачкой и монетами",
      "RPG-мини — персонаж, квест, НПС с диалогами, боевая система",
      "Horror-игра — атмосферный уровень с монстром, скримерами и финальным боссом"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для Roblox-геймдева",
    text: "Много лагерей говорят «учим Roblox». Мы объясним разницу:",
    list: [
      "Lua — реальный язык программирования. После Roblox Studio ребёнок понимает переменные, функции, события — база для Python или JavaScript",
      "Публикация игры в Roblox — не демо на компьютере, а настоящий паблик. Другие люди могут играть, писать отзывы, делиться. Это мотивирует сильнее любой оценки",
      "Преподаватели — геймдев-практики, знающие Roblox Studio изнутри, включая оптимизацию, монетизацию и работу с Roblox DevHub",
      "Группы до 8 человек — участники помогают друг другу тестировать игры, дают обратную связь как настоящие плейтестеры"
    ]
  },
  {
    h2: "Чем Roblox лучше обычных игр для ребёнка",
    text: "Обычная игра — ребёнок потребитель. Roblox Studio — ребёнок создатель. Это фундаментальная разница: вместо «прошёл уровень» — «сделал уровень, который проходят другие». Это даёт ощущение результата и вклада, которое нельзя получить за пассивным экранным временем. Плюс — реальный технический стек: Lua, 3D-мыслящие координаты, работа с FPS и оптимизацией — всё это пригодится подростку, если он выберет IT как направление."
  },
  {
    h2: "Безопасность в Roblox — что важно знать родителям",
    text: "Roblox — это не только платформа для разработки, но и социальная сеть с миллионами игр. Это создаёт риски, о которых родители часто не знают. Перед тем как отпустить ребёнка в Roblox Studio, имеет смысл настроить аккаунт правильно:",
    list: [
      "Включить родительский контроль в настройках — ограничение чата и финансовых операций",
      "Привязать родительский email — все уведомления и подтверждения идут вам",
      "Запретить покупки внутри игры без пароля — Robux стоят настоящие деньги",
      "Проверить Privacy Settings — запретить чат с незнакомцами, запретить friend-requests",
      "В лагере мы объясняем детям про social engineering: фейковые обещания «бесплатных Robux», фишинг, подозрительные личные вопросы от незнакомцев"
    ]
  },
  {
    h2: "Экономика Robux как образовательный элемент",
    text: "В лагере разбираем устройство Roblox-экономики — это часть курса, а не просто «как потратить деньги». Понимание монетизации помогает школьнику смотреть на платформу глазами создателя:",
    list: [
      "Как работает Robux: виртуальная валюта Roblox, которую игроки покупают за реальные деньги",
      "Монетизация игры: Game Passes (одноразовая покупка возможностей), Developer Products (повторяемые покупки ресурсов), Premium-товары",
      "Developer Exchange (DevEx): программа Roblox, которая конвертирует заработанные Robux в реальные доллары — минимальная ставка $0.0035 за Robux",
      "Кейсы из практики: топ-разработчики Roblox зарабатывают от $10 000 до $500 000 в год — это реальные подростки и молодые люди",
      "Что нужно чтобы начать зарабатывать: аккаунт с включённым DevEx, минимум 100 000 Robux к выводу, качественная игра с аудиторией"
    ]
  },
  {
    h2: "Смены июля — мест почти не осталось",
    text: "Roblox-трек бронируют рано: у большинства школьников, кто «живёт» в Roblox, запись происходит сразу после анонса смен. На июнь и август выбор есть. Июль — проверяйте при записи, часть смен уже закрыта."
  },
  {
    h2: "После лагеря Roblox — куда развиваться",
    text: "Ребёнок с навыком Roblox Studio + Lua — уже на шаге от профессии. Дальнейшие шаги:",
    list: [
      "Сделать 2-3 собственные игры дома и опубликовать — наращивать портфолио",
      "Подписаться на YouTube-каналы по Roblox Studio (например AlvinBlox) — самообразование",
      "В 14+ — переходить на Unity / Unreal Engine, это серьёзная геймдев-индустрия",
      "Найти онлайн-курс по разработке игр (Яндекс.Практикум, GeekBrains) с выходом на профессию",
      "Участвовать в Roblox Developers Forum — общение с взрослыми разработчиками мира"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/roblox-lager.avif"
  title="Лагерь Roblox для детей в Подмосковье 2026 | АйДаКемп"
  description={`Лагерь Roblox Studio в Подмосковье. Дети создают 3D-игры на Lua с нуля. Смены 2026 с июня, 66 км от МКАД, бассейн. От ${PRICE_MIN}.`}
  h1="Лагерь Roblox для детей в Подмосковье"
  canonical="https://aidacamp.ru/roblox-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое лагерь Roblox для детей?", a: "Летний лагерь с проживанием, где дети не играют в Roblox, а создают собственные игры в Roblox Studio на языке Lua. За смену ребёнок разрабатывает 3D-игру и публикует её в каталоге Roblox." },
    { q: "Чему учат в лагере Roblox?", a: "Roblox Studio — профессиональный инструмент геймдева. Дети изучают основы программирования на Lua, 3D-дизайн уровней, игровую логику, физику объектов. К концу смены — опубликованная игра в каталоге Roblox." },
    { q: "С какого возраста подходит лагерь Roblox?", a: "С 9 лет. АйДаКемп принимает детей 9–14 лет на трек Roblox. Предварительные знания программирования не нужны." },
    { q: "Что ребёнок сделает за смену в лагере Roblox?", a: "Собственную 3D-игру в Roblox Studio, опубликованную в каталоге. Игру можно запускать и показывать друзьям после возвращения домой. Проект защищается на хакатоне в финале смены." },
    { q: "Что такое Lua и зачем его учить в Roblox?", a: "Lua — официальный язык программирования Roblox Studio. На нём написана вся игровая логика: движение персонажей, система очков, двери, враги. Это настоящий язык программирования — освоив Lua, ребёнок понимает концепции которые применимы в Python и JavaScript." },
    { q: "Мой ребёнок «живёт» в Roblox — подойдёт ли ему лагерь?", a: "Отлично! Знание платформы — преимущество. Задача лагеря — переключить его с потребителя на создателя. Ребёнок уже знает как выглядит хорошая игра в Roblox — теперь научится делать такие сам." },
    { q: "Можно ли зарабатывать на играх в Roblox?", a: "Да. Roblox выплачивает авторам Robux, которые конвертируются в реальные деньги через программу DevEx. Топовые молодые разработчики зарабатывают сотни тысяч рублей в год. Понимание «мой труд приносит деньги» — отличная мотивация для ребёнка." }
  ]} />
    <CourseSchema
      name="Лагерь Roblox Studio для детей — создание 3D-игр на Lua"
      description="Летний лагерь Roblox Studio для детей 9–14 лет: создание 3D-игр на Lua с нуля до публикации в каталоге Roblox. За 7 или 14 дней."
      url="https://aidacamp.ru/roblox-lager"
      level="Beginner"
      ageMin={9}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь Roblox для детей в Подмосковье"
    subtitle="Не играть, а создавать. За 10–14 дней ребёнок разрабатывает собственную 3D-игру в Roblox Studio с программированием на Lua."
    breadcrumb="Лагерь Roblox"
    keywords={["Roblox Studio + Lua — профессиональный стек геймдева", "Собственная игра-публикация в финале смены", "9–14 лет, группы до 8 человек"]}
    image="/images/hero/roblox-lager.avif"
    imageAlt="Лагерь Roblox для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Roblox для детей — польза, риски и что с этим делать", url: "/stati/roblox-dlya-detej", description: "Чем полезна платформа, риски и как направить интерес к созданию игр.", icon: "controller" },
    { title: "3D-моделирование для детей — первые шаги", url: "/stati/3d-modelirovanie-dlya-detej", description: "Minecraft, Tinkercad, Blender — как дети осваивают 3D.", icon: "box" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "От Roblox Studio до Python — логичный путь развития.", icon: "braces" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-[14px] text-slate-500">
    Полезная статья: <a href="/stati/roblox-dlya-detej/" class="text-primary hover:underline">Roblox для детей: польза и как начать</a>
  </div>
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager", icon: "pc-display" },
    { title: "Roblox для детей — статья", url: "/stati/roblox-dlya-detej", icon: "controller" },
    { title: "Цены и смены", url: "/ceny", icon: "currency-ruble" },
  ]} />
</LandingLayout>
