---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Лагерь Roblox — геймдев для детей 9–14 лет",
    text: "Roblox Studio — профессиональная среда разработки 3D-игр, в которой работают в том числе взрослые студии. В АйДаКемп дети 9–14 лет учатся не просто играть в Roblox, а создавать собственные миры — со своей логикой, персонажами и монетизацией. За смену ребёнок разрабатывает полноценную мини-игру, которую можно опубликовать в Roblox для миллионов игроков."
  },
  {
    h2: "Программа Roblox Studio в лагере",
    text: "Занятия строятся от простого к сложному: сначала конструктор миров, потом программирование на Lua (официальный язык Roblox). Группы до 8 человек, преподаватель-практик рядом.",
    list: [
      "Roblox Studio — знакомство с редактором и 3D-окружением",
      "Создание персонажа и базовой сцены",
      "Программирование на Lua — скрипты поведения объектов",
      "Игровые механики — коллизии, прыжки, система очков",
      "Паблик в Roblox — публикация своей игры для сообщества"
    ]
  },
  {
    h2: "Чем Roblox лучше обычных игр для ребёнка",
    text: "Обычная игра — ребёнок потребитель. Roblox Studio — ребёнок создатель. Это фундаментальная разница: вместо «прошёл уровень» — «сделал уровень, который проходят другие». Это даёт ощущение результата и вклада, которое нельзя получить за пассивным экранным временем. Плюс — реальный технический стек: Lua, 3D-мыслящие координаты, работа с FPS и оптимизацией — всё это пригодится подростку, если он выберет IT как направление."
  },
  {
    h2: "Можно ли заработать на игре в Roblox",
    text: "Да, и это дополнительная мотивация для ребёнка. Roblox выплачивает авторам игр Robux (внутреннюю валюту), которую можно конвертировать в настоящие деньги через Developer Exchange (программа DevEx). Топовые молодые авторы Roblox зарабатывают сотни тысяч рублей в год. Не обещаем, что ваш ребёнок станет миллионером, — но понимание «мой труд приносит деньги» в 11–14 лет само по себе ценное открытие."
  }
];

const relatedPages = [
  { title: "Компьютерный лагерь", description: "Все IT-направления в одном месте", url: "/kompyuternyy-lager", emoji: "💻" },
  { title: "Лагерь Майнкрафт", description: "Соседнее направление — геймдев", url: "/minecraft-lager", emoji: "⛏️" },
  { title: "Лагерь программирования", description: "Lua, Python и другие языки", url: "/lager-programmirovaniya", emoji: "⌨️" },
];
---

<LandingLayout
  heroImage="/images/hero/minecraft-lager.avif"
  title="Лагерь Roblox для детей 2026 в Подмосковье — АйДаКемп"
  description="Летний лагерь Roblox Studio для детей 9–14 лет в Подмосковье. Дети учатся создавать 3D-игры на Lua, а не просто играть. 66 км от Москвы, от 48 000 ₽."
  h1="Лагерь Roblox для детей в Подмосковье"
  canonical="https://aidacamp.ru/roblox-lager"
>
  <LandingHero slot="hero"
    h1="Лагерь Roblox для детей в Подмосковье"
    subtitle="Не играть, а создавать. За 10–14 дней ребёнок разрабатывает собственную 3D-игру в Roblox Studio с программированием на Lua."
    breadcrumb="Лагерь Roblox"
    keywords={["Roblox Studio + Lua — профессиональный стек геймдева", "Собственная игра-публикация в финале смены", "9–14 лет, группы до 8 человек"]}
    image="/images/hero/minecraft-lager.avif"
    imageAlt="Лагерь Roblox для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={relatedPages} />
</LandingLayout>
