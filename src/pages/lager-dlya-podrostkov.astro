---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S3, VYCHET_S4, mainShifts, getAvailabilityLevel } from '../data/shifts';
import { STAT_RATING } from '../data/contacts';

// Единый источник наличия мест — getAvailabilityLevel() из shifts.ts, не хардкодим free напрямую в текст.
function shiftAvailabilityFragment(shiftId: string): string {
  const s = mainShifts.find(s => s.id === shiftId);
  if (!s) return '';
  return getAvailabilityLevel(s) === 'soldout'
    ? `${s.name} распродана (доступен лист ожидания)`
    : `${s.name} — осталось ${s.free}`;
}
const shift3Availability = shiftAvailabilityFragment('shift-3');
const shift4Availability = shiftAvailabilityFragment('shift-4');

const faqItems = [
  { question: "С какого возраста подростки едут в IT-лагерь?", answer: "С 10 лет: группы по возрасту — средний (10–12) и старший (13–15), с более сложной программой (реальные API, продвинутый Python, AI-проекты)." },
  { question: "Подходит ли лагерь подросткам, которым скучно в обычных лагерях?", answer: "Особенно подходит. В АйДаКемп нет скуки: подростки работают над реальными проектами, конкурируют на хакатоне, общаются с ровесниками, которым интересно то же самое." },
  { question: "Есть ли телефоны у подростков в лагере?", answer: "Телефоны ограничены: в часы занятий убраны, в свободное время — по расписанию. Это сделано намеренно: концентрация повышается, подростки больше общаются между собой." },
  { question: "Что делают подростки в IT-лагере помимо кода?", answer: "Бассейн, спорт, вечерние квесты, командные игры. Хакатон — соревновательная атмосфера, презентация проекта перед аудиторией. Общение с ровесниками из разных городов." },
  { question: "Где находится летний лагерь для подростков в Подмосковье?", answer: "Лагерь для подростков в Подмосковье расположен в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Санаторий «Изумруд» — сосновый лес, бассейн, закрытая охраняемая территория. Трансфер из Москвы организуем в день заезда и выезда." },
  { question: "Сколько стоит летний лагерь для подростков?", answer: `Стоит от ${PRICE_MIN} (10-дневная смена) до ${PRICE_MAX} (13-дневная смена). Возможен налоговый вычет 13% — до ${VYCHET_MAX} обратно в зависимости от смены. Ранняя запись фиксирует цену.` },
  { question: `Есть ли лагерь для подростков в Подмосковье на август ${SEASON_YEAR}?`, answer: `Да — работает всё лето, июнь и август. На август доступны Смена 3 (${DATES_SHORT_S3}, 13 дней) и Смена 4 (${DATES_SHORT_S4}, 10 дней). Ребятам этого возраста рекомендуем смены от 10 дней.` },
  { question: "Как записать подростка в летний IT-лагерь?", answer: "Выбрать смену на странице «Смены и цены», нажать «Забронировать» и заполнить заявку. Менеджер перезвонит в течение 30 минут, ответит на вопросы и выставит счёт. Место фиксируется после оплаты." },
];
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему подросткам не скучно в АйДаКемп?",
    text: "Большинство лагерей не рассчитаны на подростков — скучно и мальчикам, и девочкам, потому что программа одинакова для всех. В АйДаКемп старшая группа занимается отдельно: более сложные проекты, больше самостоятельности, peer learning — когда учишь другого, сам усваиваешь лучше. Нет принудительных активностей — есть свобода выбора в рамках дня.",
    list: [
      "Хакатон — соревновательный формат с реальным питчем перед аудиторией",
      "Командные проекты: каждый выбирает роль сам — разработчик, дизайнер, продакт",
      "Peer learning: объясняешь другому — сам усваиваешь глубже",
      "Без принуждения — интерес возникает потому, что рядом такие же и задача реальная",
      "Соревнования между группами — внутренняя мотивация без оценок и нотаций"
    ]
  },
  {
    h2: "Как работает режим без телефонов в лагере?",
    text: "Смартфоны сдаются на хранение в первый день. Вместо них — внутренняя валюта лагеря, которую зарабатывают за участие в активностях, помощь другим и прогресс в проекте. На неё можно «купить» экранное время или привилегии. Большинство подростков через 2–3 дня перестают скучать по телефону."
  },
  {
    h2: "Трек для продвинутых подростков: AI, стартап, питч",
    text: "Для тех, кто уже программировал или хочет максимального вызова, — отдельный продвинутый трек. Без повторения азов, сразу в сложное.",
    list: [
      "ChatGPT API и Gemini — создание собственного AI-ассистента на Python",
      "Стартап-проект: от идеи до рабочего прототипа за 10 дней",
      "Питч перед IT-специалистами — обратная связь как в настоящем инкубаторе",
      "Анализ данных — таблицы, визуализация, выводы на реальных датасетах",
      "Telegram-бот — создание и публикация, реальные пользователи из лагеря"
    ]
  },
  {
    h2: "Какая программа у старшей группы?",
    text: "Старшая группа работает с Python, AI-инструментами и реальными задачами. Ребята выбирают направление в начале смены: код, AI-проекты, 3D или комбинация.",
    list: [
      "Python Advanced — функции, классы, API, базы данных",
      "AI-проекты — обучение моделей, работа с ChatGPT API",
      "Telegram-боты — создание и публикация рабочего бота",
      "3D и дизайн — техническое творчество: моделирование в Blender, прототипирование интерфейсов"
    ]
  },
  {
    h2: "Где находится лагерь для подростков в Подмосковье?",
    text: "Территория оздоровительного санатория «Изумруд» в Наро-Фоминском районе Московской области — сосновый лес, спортивные площадки, бассейн. Добраться 1–1,5 часа на машине от МКАД — организуем трансфер из Москвы в день заезда и выезда."
  },
  {
    h2: "Сколько стоит смена для подростка?",
    text: `Для подростков подходят смены от 10 дней — за это время успевает сложиться команда и получается полноценный проект. Открытые смены: от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Смена 3 (13 дней, август) особенно подходит для тех, кто хочет максимального результата.`
  },
  {
    h2: `Летний лагерь для подростков на лето ${SEASON_YEAR}: даты смен`,
    text: `Летний лагерь для подростков на лето ${SEASON_YEAR} работает с 30 мая по 26 августа в Наро-Фоминском районе Подмосковья. Четыре смены — ребята выбирают удобные каникулы: от 10 до 14 дней. Ребятам этого возраста рекомендуем смены от 10 дней — за меньший срок команда не успевает сложиться и проект не дойдёт до полноценного питча.`,
    list: [
      `Смена 1 (завершена) (${DATES_S1}, 10 дней) — старт сезона, свежие группы`,
      `Смена 2 (завершена) (${DATES_SHORT_S2}, 14 дней) — максимальный результат, хакатон с питчем`,
      `Смена 3 (${DATES_SHORT_S3}, 13 дней) — AI-треки, стартап-формат`,
      `Смена 4 (${DATES_SHORT_S4}, 10 дней) — быстрый вход для первого раза`
    ]
  },
  {
    h2: "Чем отличается программа старшей группы?",
    text: "Разный возраст — разная программа, разные правила, разная смена. Подростка нельзя просто «подселить» в обычный <a href='/lager-dlya-detey/' class='text-primary underline underline-offset-2'>детский лагерь</a> 7–10 лет — ему будет скучно и «слишком по-детски». В АйДаКемп старшая группа живёт отдельно, с собственным ритмом дня, программой и преподавателями.",
    list: [
      "Меньше фиксированного расписания — больше времени на собственный проект",
      "Возможность самим выбирать роль в команде (лидер / разработчик / дизайнер / презентатор)",
      "Финал смены — защита проекта перед всем лагерем, включая младших (роль «взрослых» в глазах других)",
      "Свои вечерние активности: настольные игры, дискуссии, спортивные турниры",
      "Отдельный корпус или крыло — не пересекаются с малышами в быту"
    ]
  },
  {
    h2: "Что подросток получает из лагеря — реальный результат?",
    text: "Программа и фото с хакатона — это верхушка. Настоящий результат подросток привозит в голове и в характере: за 10–14 дней с ним происходят перемены, которые родители замечают уже через 2 недели после возвращения:",
    list: [
      "Навык сосредоточенной работы без телефона — то, что многим не даётся годами",
      "Опыт принятия решений в команде с ровесниками (не под контролем родителей)",
      "Конкретный IT-проект, которым можно похвастаться в школе",
      "Понимание своих сильных сторон (лидер / разработчик / дизайнер / организатор)",
      "Круг новых друзей-ровесников, с которыми интересно общаться (не только в онлайне)"
    ]
  },
  {
    h2: "Чем заняты подростки в свободное время?",
    text: "В АйДаКемп нет «ничегонеделания» — и это намеренно. Не потому что свободное время плохо, а потому что подростки сами заполняют паузы: гитара у костра, настольные игры, спонтанные беседы о проектах, физическая активность на улице. Расписание даёт структуру, пространство внутри — живое.",
    list: [
      "Спорт: волейбол, футбол, бассейн с ионизированной водой — по выбору, без принудиловки",
      "Вечерние активности: квизы, турниры, кино под звёздами, живая музыка вожатых",
      "Командные события: у каждого отряда общий проект — настоящий повод для общения",
      "Тихие часы — реально тихие: можно читать, слушать музыку, работать над проектом",
      "Хакатон в финале смены: 48-часовой марафон, когда свободное время превращается в драйв"
    ]
  },
  {
    h2: "Безопасность подростка в лагере — как это устроено",
    text: `Родители переживают иначе: не «вдруг заплачет», а «что будет происходить без нас». Конкретно по АйДаКемп: закрытая охраняемая территория санатория «Изумруд», медработник 24/7, вожатый-наставник из расчёта 1:8. Не жёсткий надзор, а присутствие — подростки это чувствуют и ценят разницу. Путёвка оформляется официально по договору, рейтинг ${STAT_RATING} на Яндекс.Картах — от родителей, которые уже отправляли к нам своих ребят.`,
    list: [
      "Охрана территории 24/7, контроль входа-выхода — посторонние не попадают",
      "Медпункт с врачом включена в стоимость смены",
      "Telegram-канал отряда: каждый вечер живые фото — без постановки",
      "Смартфоны сдаются в именной бокс — не конфискуются, а хранятся. Все знают, где",
      "Авторитетные вожатые: прошли отбор, многие сами были участниками лагеря"
    ]
  },
  {
    h2: "Осталось мало мест на ближайшие смены",
    text: `Летние смены для старшей группы ограничены: группы до 8 человек. Июнь практически занят — если хотите смену 2, бронируйте сейчас. В августе: ${shift3Availability}, ${shift4Availability}.`
  },
  {
    h2: "Какие смены лучше подходят старшей группе",
    text: "Ребята этого возраста лучше раскрываются в более длинных сменах — за 10+ дней успевает сложиться команда и дойти до настоящего питча. Коротких смен 2.1 и 2.2 (7–8 дней) для этого возраста мы не рекомендуем.",
    list: [
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2}: самый длинный формат, два полных цикла хакатона, максимальная глубина в проект. Июнь — пик сезона, группы формировались быстро`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}: формат почти такой же как у смены 2, но август — спокойнее, меньше конкуренции за места и лучше погода`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}: оптимальна для первого опыта или если 28 августа уже репетитор или переезд. 10 дней — золотой стандарт первого раза`,
      "Для старшеклассников, которые уже серьёзно программируют: смена 3 — там AI-трек и стартап-формат с реальным питчем"
    ]
  },
  {
    h2: "Лагерь для подростков в августе — что важно знать",
    text: `На август доступны смены 3 и 4 — обе специально подходят старшим ребятам. Смена 3 (${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}) — для тех, кто хочет глубоко уйти в проект: Python Advanced, AI-ассистент, реальные API, хакатон с питчем. Смена 4 (${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}) — оптимальна для первого раза или старшеклассников, у которых 28-го уже репетитор. Обе смены — с отдельной программой для старшей группы, без смешивания с детьми 7–9 лет.`,
    list: [
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — максимальный результат, AI-треки`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — идеально перед школой`,
      "Оба формата: группы до 8 человек, вожатый 1:8, ноутбук на каждого",
      `Налоговый вычет 13%: до ${VYCHET_S3} за смену 3 и до ${VYCHET_S4} за смену 4`,
      "Трансфер из Москвы в день заезда и выезда — отдельная опция"
    ]
  },
  {
    h2: "Как подготовить подростка к первому лагерю?",
    text: "Подросток — не ребёнок: с ним не поработает фраза «мы тебя отправляем туда, соберись». Нужен разговор как со взрослым — с аргументами и возможностью отказаться. Без этого даже «лучший лагерь мира» превратится в «меня заперли на 10 дней». Подробнее — в статье <a href='/stati/rebenok-ne-hochet-v-lager/' class='text-orange-600 underline underline-offset-2'>«Ребёнок не хочет в лагерь: разбираемся без скандалов»</a>. Несколько практических советов:",
    list: [
      "Покажите сайт, фото смен, отзывы других подростков. Пусть выберет сам из 2–3 вариантов",
      "Обсудите цель поездки — не «отдохни», а «попробуй что-то новое, посмотри что получится»",
      "Не обещайте «тебе точно понравится» — честно говорите: «будет вызов, но интересно»",
      "Договоритесь о режиме связи: звонок в определённые окна, не круглосуточный мониторинг",
      "Обсудите что он возьмёт с собой из хобби (гитара, настолка, книги) — чтобы было свое"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`Детский лагерь для подростков 11–15 лет в Подмосковье ${SEASON_YEAR} — подростковые смены | АйДаКемп`}
  description={`Детский летний лагерь для подростков 11–15 лет в Подмосковье ${SEASON_YEAR}. Москва рядом. Python, AI, Telegram-боты, хакатон. От ${PRICE_S4}, налоговый вычет 13%. Август — смены 3–15 и ${DATES_SHORT_S4}.`}
  h1={`Подростковый лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-dlya-podrostkov/"
  breadcrumbLabel="Лагерь для подростков"
>
  <Fragment slot="head">
  </Fragment>
  <LandingHero slot="hero"
    h1={`Подростковый лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle="Для тех, кому скучны обычные лагеря. Подростки делают реальные IT-проекты, конкурируют на хакатоне и возвращаются другими."
    breadcrumb="Лагерь для подростков"
    keywords={["Проект за смену — не задание, а личный результат", "Среда без телефонов — экранное время зарабатывается", "Открытые летние смены: 10 и 13 дней, август"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Летний лагерь для подростков в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <!-- Свой accordion убран: те же faqItems теперь первой вкладкой <FAQ /> — один
       видимый источник вопросов и один FAQPage вместо двух (31.07.2026) -->
  <FAQ
    extraItems={faqItems.map((item) => ({ q: item.question, a: item.answer }))}
    extraLabel="О лагере для подростков"
  />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('[data-faq-item]');
      const answer = item?.querySelector<HTMLElement>('[data-faq-answer]');
      const icon = btn.querySelector<HTMLElement>('[data-faq-icon]');
      if (!answer) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</LandingLayout>
