---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему подростки 12–15 лет не скучают в АйДаКемп?",
    text: "Большинство лагерей не рассчитаны на подростков — там скучно, потому что программа одинакова для всех. В АйДаКемп подростки 12–15 лет занимаются отдельно: более сложные проекты, больше самостоятельности, peer learning — когда учишь другого, сам усваиваешь лучше. Нет принудительных активностей — есть свобода выбора в рамках дня.",
    list: [
      "Хакатон — соревновательный формат с реальным питчем перед аудиторией",
      "Командные проекты: каждый выбирает роль сам — разработчик, дизайнер, продакт",
      "Peer learning: объясняешь другому — сам усваиваешь глубже",
      "Без принуждения — интерес возникает потому, что рядом такие же и задача реальная",
      "Соревнования между группами — внутренняя мотивация без оценок и нотаций"
    ]
  },
  {
    h2: "Как работает режим без телефонов в лагере?",
    text: "Смартфоны сдаются на хранение в первый день. Вместо них — внутренняя валюта лагеря, которую зарабатывают за участие в активностях, помощь другим и прогресс в проекте. На неё можно «купить» экранное время или привилегии. Большинство подростков через 2–3 дня перестают скучать по телефону."
  },
  {
    h2: "Трек для продвинутых подростков: AI, стартап, питч",
    text: "Для тех, кто уже программировал или хочет максимального вызова, — отдельный продвинутый трек. Без повторения азов, сразу в сложное.",
    list: [
      "ChatGPT API и Gemini — создание собственного AI-ассистента на Python",
      "Стартап-проект: от идеи до рабочего прототипа за 10 дней",
      "Питч перед IT-специалистами — обратная связь как в настоящем инкубаторе",
      "Анализ данных — таблицы, визуализация, выводы на реальных датасетах",
      "Telegram-бот — создание и публикация, реальные пользователи из лагеря"
    ]
  },
  {
    h2: "Какая программа для подростков 12–15 лет?",
    text: "Старшая группа работает с Python, AI-инструментами и реальными задачами.",
    list: [
      "Python Advanced — функции, классы, API, базы данных",
      "AI-проекты — обучение моделей, работа с ChatGPT API",
      "Telegram-боты — создание и публикация рабочего бота",
      "3D и дизайн — моделирование, прототипирование интерфейсов"
    ]
  },
  {
    h2: "Где находится лагерь для подростков в Подмосковье?",
    text: "АйДаКемп — лагерь в Подмосковье для подростков: Наро-Фоминский район, 66 км от Москвы по Киевскому шоссе. Сосновый лес, спортивные площадки, бассейн. Добраться 1–1,5 часа на машине от МКАД — организуем трансфер из Москвы в день заезда и выезда."
  },
  {
    h2: "Сколько стоит смена для подростка в 2026 году?",
    text: "Для подростков подходят смены от 10 дней — за это время успевает сложиться команда и получается полноценный проект. Смена 2 (14 дней, июнь) особенно подходит для тех, кто хочет максимального результата."
  },
  {
    h2: "Летний лагерь для подростков на лето 2026: даты смен",
    text: "Летний лагерь для подростков на лето 2026 работает с 30 мая по 26 августа в Наро-Фоминском районе Подмосковья. Для подростков 11–15 лет рекомендуем смены от 10 дней — за меньший срок команда не успевает сложиться и проект не дойдёт до полноценного питча.",
    list: [
      "Смена 1 (30 мая — 8 июня, 10 дней) — старт сезона, свежие группы",
      "Смена 2 (13–26 июня, 14 дней) — максимальный результат, хакатон с питчем",
      "Смена 3 (1–13 июля, 13 дней) — AI-треки, стартап-формат",
      "Смена 4 (17–26 июля, 10 дней) — быстрый вход для первого раза",
      "Смены в августе — ещё есть места, лучше уточнить наличие"
    ]
  },
  {
    h2: "Чем отличается группа для подростков 11–14 лет?",
    text: "Разный возраст — разная программа, разные правила, разная смена. Подростка нельзя просто «подселить» в общий лагерь для 7–10 лет — ему будет скучно и «слишком по-детски». В АйДаКемп старшая группа живёт отдельно, с собственным ритмом дня, программой и преподавателями.",
    list: [
      "Меньше фиксированного расписания — больше времени на собственный проект",
      "Возможность самим выбирать роль в команде (лидер / разработчик / дизайнер / презентатор)",
      "Финал смены — защита проекта перед всем лагерем, включая младших (роль «взрослых» в глазах других)",
      "Свои вечерние активности: настольные игры, дискуссии, спортивные турниры",
      "Отдельный корпус или крыло — не пересекаются с малышами в быту"
    ]
  },
  {
    h2: "Что подросток получает из лагеря — реальный результат?",
    text: "Программа и фото с хакатона — это верхушка. Реальный результат смены — то, что подросток привозит в своей голове и в своём характере. За 10–14 дней с ним происходят изменения, которые родители замечают через 2 недели после возвращения:",
    list: [
      "Навык сосредоточенной работы без телефона — то, что многим не даётся годами",
      "Опыт принятия решений в команде с ровесниками (не под контролем родителей)",
      "Конкретный IT-проект, которым можно похвастаться в школе",
      "Понимание своих сильных сторон (лидер / разработчик / дизайнер / организатор)",
      "Круг новых друзей-ровесников, с которыми интересно общаться (не только в онлайне)"
    ]
  },
  {
    h2: "Чем заняты подростки в свободное время?",
    text: "В АйДаКемп нет «ничегонеделания» — и это намеренно. Не потому что свободное время плохо, а потому что подростки сами заполняют паузы: гитара у костра, настольные игры, спонтанные беседы о проектах, физическая активность на улице. Расписание даёт структуру, пространство внутри — живое.",
    list: [
      "Спорт: волейбол, бадминтон, бассейн с ионизированной водой — по выбору, без принудиловки",
      "Вечерние активности: квизы, турниры, кино под звёздами, живая музыка вожатых",
      "Командные события: у каждого отряда общий проект — настоящий повод для общения",
      "Тихие часы — реально тихие: можно читать, слушать музыку, работать над проектом",
      "Хакатон в финале смены: 48-часовой марафон, когда свободное время превращается в драйв"
    ]
  },
  {
    h2: "Безопасность подростка в лагере — как это устроено",
    text: "Родители подростков волнуются иначе: не «вдруг заплачет», а «что будет происходить без нас». Конкретно по АйДаКемп: закрытая охраняемая территория санатория «Изумруд», медработник 24/7, вожатый из расчёта 1:8. Не жёсткий надзор, а присутствие — подростки это чувствуют и ценят разницу.",
    list: [
      "Охрана территории 24/7, контроль входа-выхода — посторонние не попадают",
      "Медпункт с врачом, страховка включена в стоимость смены",
      "Telegram-канал отряда: каждый вечер живые фото — без постановки",
      "Смартфоны сдаются в именной бокс — не конфискуются, а хранятся. Подростки знают где",
      "Авторитетные вожатые: прошли отбор, многие сами были участниками лагеря"
    ]
  },
  {
    h2: "Осталось мало мест на смены для подростков — июль уже занят",
    text: "Смены с отдельной подростковой программой (12–15 лет) ограничены: группы до 8 человек. По данным прошлых сезонов, смена 2 (14 дней, июнь) заполняется полностью к началу мая. В августе ещё есть места — смены 3 и 4. Если хотите июнь — бронируйте сейчас, цены зафиксированы до повышения."
  },
  {
    h2: "Как подготовить подростка к первому лагерю?",
    text: "Подросток — не ребёнок: с ним не поработает фраза «мы тебя отправляем туда, соберись». Нужен разговор как со взрослым — с аргументами и возможностью отказаться. Без этого даже «лучший лагерь мира» превратится в «меня заперли на 10 дней». Подробнее — в статье <a href='/stati/rebenok-ne-hochet-v-lager' class='text-orange-600 underline underline-offset-2'>«Ребёнок не хочет в лагерь: разбираемся без скандалов»</a>. Несколько практических советов:",
    list: [
      "Покажите сайт, фото смен, отзывы других подростков. Пусть выберет сам из 2–3 вариантов",
      "Обсудите цель поездки — не «отдохни», а «попробуй что-то новое, посмотри что получится»",
      "Не обещайте «тебе точно понравится» — честно говорите: «будет вызов, но интересно»",
      "Договоритесь о режиме связи: звонок в определённые окна, не круглосуточный мониторинг",
      "Обсудите что он возьмёт с собой из хобби (гитара, настолка, книги) — чтобы было свое"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Летний лагерь для подростков в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для подростков 11–15 лет в Подмосковье, 66 км от Москвы. Python, AI, Telegram-боты. Смены на лето 2026 от 74 900 ₽. Группы 10–14 дней, налоговый вычет 13%."
  h1="Летний лагерь для подростков в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-dlya-podrostkov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
            { "@type": "ListItem", "position": 2, "name": "Лагерь для подростков", "item": "https://aidacamp.ru/lager-dlya-podrostkov" }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "С какого возраста подростки едут в IT-лагерь?",
              "acceptedAnswer": { "@type": "Answer", "text": "С 10 лет. Для подростков 10–15 лет есть отдельные группы: средний (10–12 лет) и старший (13–15 лет). Программа сложнее: реальные API, продвинутый Python, AI-проекты." }
            },
            {
              "@type": "Question",
              "name": "Подходит ли лагерь подросткам, которым скучно в обычных лагерях?",
              "acceptedAnswer": { "@type": "Answer", "text": "Особенно подходит. В АйДаКемп нет скуки: подростки работают над реальными проектами, конкурируют на хакатоне, общаются с ровесниками, которым интересно то же самое." }
            },
            {
              "@type": "Question",
              "name": "Есть ли телефоны у подростков в лагере?",
              "acceptedAnswer": { "@type": "Answer", "text": "Телефоны ограничены: в часы занятий убраны, в свободное время — по расписанию. Это сделано намеренно: концентрация повышается, подростки больше общаются между собой." }
            },
            {
              "@type": "Question",
              "name": "Что делают подростки в IT-лагере помимо кода?",
              "acceptedAnswer": { "@type": "Answer", "text": "Бассейн, спорт, вечерние квесты, командные игры. Хакатон — соревновательная атмосфера, презентация проекта перед аудиторией. Общение с ровесниками из разных городов." }
            },
            {
              "@type": "Question",
              "name": "Где находится летний лагерь для подростков в Подмосковье?",
              "acceptedAnswer": { "@type": "Answer", "text": "Лагерь для подростков в Подмосковье расположен в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Санаторий «Изумруд» — сосновый лес, бассейн, закрытая охраняемая территория. Трансфер из Москвы организуем в день заезда и выезда." }
            },
            {
              "@type": "Question",
              "name": "Сколько стоит летний лагерь для подростков 2026?",
              "acceptedAnswer": { "@type": "Answer", "text": "Летний лагерь для подростков 2026 стоит от 74 900 ₽ (10-дневная смена). 14-дневная смена — 99 000 ₽. Возможен налоговый вычет 13% — от 2 800 до 5 434 ₽ обратно в зависимости от смены. Ранняя запись фиксирует цену." }
            },
            {
              "@type": "Question",
              "name": "Есть ли лагерь для подростков в Подмосковье на август 2026?",
              "acceptedAnswer": { "@type": "Answer", "text": "Да, летний лагерь для подростков в Подмосковье работает всё лето — июнь, июль и август 2026. На август доступны смены 2.1 и 2.2. Для подростков рекомендуем смены от 10 дней — за 7–8 дней команда не успевает сложиться и получить полноценный результат." }
            },
            {
              "@type": "Question",
              "name": "Как записать подростка в летний IT-лагерь?",
              "acceptedAnswer": { "@type": "Answer", "text": "Выбрать смену на странице «Смены и цены», нажать «Забронировать» и заполнить заявку. Менеджер перезвонит в течение 30 минут, ответит на вопросы и выставит счёт. Место фиксируется после оплаты." }
            }
          ]
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для подростков в Подмосковье 2026"
    subtitle="Для тех, кому скучны обычные лагеря. Подростки делают реальные IT-проекты, конкурируют на хакатоне и возвращаются другими."
    breadcrumb="Лагерь для подростков"
    keywords={["Проект за смену — не задание, а личный результат", "Среда без телефонов — экранное время зарабатывается", "Смены на лето 2026: от 10 до 14 дней, с 30 мая"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Летний лагерь для подростков в Подмосковье 2026"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
