---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S3, VYCHET_S4, mainShifts, getAvailabilityLevel } from '../data/shifts';
import { STAT_RATING } from '../data/contacts';

// Единый источник наличия мест — getAvailabilityLevel() из shifts.ts, не хардкодим free напрямую в текст.
function shiftAvailabilityFragment(shiftId: string): string {
  const s = mainShifts.find(s => s.id === shiftId);
  if (!s) return '';
  return getAvailabilityLevel(s) === 'soldout'
    ? `${s.name} распродана (доступен лист ожидания)`
    : `${s.name} — осталось ${s.free}`;
}
const shift3Availability = shiftAvailabilityFragment('shift-3');
const shift4Availability = shiftAvailabilityFragment('shift-4');

const faqItems = [
  { question: "С какого возраста едут в IT-лагерь?", answer: "С 10 лет: группы по возрасту — средний (10–12) и старший (13–15), с более сложной программой (реальные API, продвинутый Python, AI-проекты)." },
  { question: "Подходит ли формат тем, кому скучно в обычных лагерях?", answer: "Особенно подходит. У нас нет скуки: ребята работают над реальными проектами, конкурируют на хакатоне, общаются с ровесниками, которым интересно то же самое." },
  { question: "Есть ли телефоны у ребят в лагере?", answer: "Ограничены: в часы занятий убраны, в свободное время — по расписанию. Сделано намеренно: концентрация выше, ребята больше общаются между собой." },
  { question: "Чем заняты ребята помимо кода?", answer: "Бассейн, спорт, вечерние квесты, командные игры. Хакатон — соревновательная атмосфера, презентация проекта перед аудиторией. Общение с ровесниками из разных городов." },
  { question: "Где находится лагерь в Подмосковье?", answer: "В Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Санаторий «Изумруд» — сосновый лес, бассейн, закрытая охраняемая территория. Трансфер из Москвы — в день заезда и выезда." },
  { question: "Сколько стоит смена для подростков?", answer: `От ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Возможен налоговый вычет 13% — до ${VYCHET_MAX} обратно в зависимости от смены. Ранняя запись фиксирует цену.` },
  { question: `Есть ли места в Подмосковье на август ${SEASON_YEAR}?`, answer: `Да — работаем всё лето, июнь и август. На август доступны Смена 3 (${DATES_SHORT_S3}, 13 дней) и Смена 4 (${DATES_SHORT_S4}, 10 дней). Рекомендуем от 10 дней.` },
  { question: "Как записать ребёнка к нам?", answer: "Выбрать смену на странице «Смены и цены», нажать «Забронировать» и заполнить заявку. Менеджер перезвонит в течение 30 минут, ответит на вопросы и выставит счёт. Место фиксируется после оплаты." },
];
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему ребятам не скучно в АйДаКемп?",
    text: "Обычные программы одинаковы для всех возрастов — старшим подросткам от этого скучно. У нас старшая группа занимается отдельно: сложные проекты, больше самостоятельности, peer learning — объясняешь другому, сам понимаешь глубже. Никаких принудительных активностей, только свобода выбора внутри дня.",
    list: [
      "Хакатон — с реальным питчем перед аудиторией",
      "Командные проекты: каждый выбирает роль сам — разработчик, дизайнер, продакт",
      "Peer learning: объясняешь другому — сам усваиваешь глубже",
      "Соревнования между отрядами — мотивация без оценок и нотаций"
    ]
  },
  {
    h2: "Как работает режим без телефонов",
    text: "Смартфоны сдаются на хранение в первый день. Вместо них — внутренняя валюта смены: её зарабатывают за активности, помощь другим и прогресс в проекте, а тратят на экранное время или привилегии. Через 2–3 дня большинство перестаёт скучать по телефону."
  },
  {
    h2: "Программа старшей группы: Python, AI, хакатон",
    text: "Старшая группа живёт и занимается отдельно от младших — свой ритм дня, программа, преподаватели, не тот формат, что <a href='/lager-dlya-detey/' class='text-primary underline underline-offset-2'>смены для детей</a> 7–10 лет. В начале выбирают направление: код, AI-проекты, 3D или комбинация. Для тех, кто уже программировал, — отдельный продвинутый трек без повторения азов, сразу в сложное.",
    list: [
      "Python Advanced — функции, классы, API, базы данных",
      "AI-ассистент на ChatGPT API и Gemini — свой проект на Python",
      "Стартап-трек: от идеи до прототипа за 10 дней, питч перед IT-специалистами",
      "Telegram-бот — создание и публикация, реальные пользователи из смены",
      "3D и дизайн — моделирование в Blender, прототипирование интерфейсов",
      "Финал — защита проекта перед всеми, включая младших"
    ]
  },
  {
    h2: "Сколько стоит смена и какие даты",
    text: `Лучше всего подходят смены от 10 дней — за такой срок успевает сложиться команда и получиться полноценный проект. Сезон ${SEASON_YEAR} длится всё лето — с 30 мая по 26 августа, площадка в Наро-Фоминском районе Подмосковья. Цена — от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13.`,
    list: [
      `Смена 1 (завершена): ${DATES_S1}, 10 дней`,
      `Смена 2 (завершена): ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2} — хакатон с питчем`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} — AI-треки, стартап-формат`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} — быстрый вход для первого раза`
    ]
  },
  {
    h2: "Осталось мест на август",
    text: `Группы небольшие — до 8 человек. Июнь закрыт (смена 2 распродана), в августе: ${shift3Availability}, ${shift4Availability}. Налоговый вычет 13%: до ${VYCHET_S3} за смену 3 и до ${VYCHET_S4} за смену 4.`,
    list: [
      "Группы до 8 человек, вожатый 1:8, ноутбук на каждого",
      "Трансфер из Москвы в день заезда и выезда — отдельная опция"
    ]
  },
  {
    h2: "Что получает ребёнок от смены",
    text: "Фото с хакатона — это верхушка. Настоящий результат — в характере: перемены заметны уже через пару недель после возвращения. Свободное время никто не тратит впустую: гитара у костра, настолки, спонтанные разговоры о проектах, спорт на улице.",
    list: [
      "Навык сосредоточенной работы без телефона",
      "Опыт решений в команде ровесников — без контроля родителей",
      "Конкретный IT-проект, которым можно похвастаться в школе",
      "Круг новых друзей не только в онлайне",
      "Хакатон в финале — 48-часовой марафон, драйв вместо скуки"
    ]
  },
  {
    h2: "Безопасность — как это устроено",
    text: `Родители переживают не «вдруг заплачет», а «что будет происходить без нас». Закрытая охраняемая территория санатория «Изумруд», медработник 24/7, наставник из расчёта 1:8 — присутствие, а не жёсткий надзор. Путёвка оформляется официально по договору, рейтинг ${STAT_RATING} на Яндекс.Картах — от родителей, которые уже отправляли к нам своих детей.`,
    list: [
      "Охрана территории 24/7 — посторонние не попадают",
      "Медпункт с врачом включён в стоимость",
      "Telegram-канал отряда: живые фото каждый вечер",
      "Смартфоны хранятся в именном боксе — не конфискуются"
    ]
  },
  {
    h2: "Как подготовить к первой поездке",
    text: "С ребёнком этого возраста не работает «мы тебя отправляем, соберись» — нужен разговор как со взрослым, с аргументами и правом отказаться. Иначе даже лучшая смена превратится в «меня заперли». Подробнее — в статье <a href='/stati/rebenok-ne-hochet-v-lager/' class='text-orange-600 underline underline-offset-2'>«Ребёнок не хочет в лагерь: разбираемся без скандалов»</a>.",
    list: [
      "Покажите сайт, фото, отзывы — пусть выберет сам из 2–3 вариантов",
      "Обсудите цель: не «отдохни», а «попробуй что-то новое»",
      "Не обещайте «точно понравится» — честно: «будет вызов, но интересно»",
      "Договоритесь о режиме связи — определённые окна, не круглосуточный контроль"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`Детский лагерь для подростков 11–15 лет в Подмосковье ${SEASON_YEAR} — подростковые смены | АйДаКемп`}
  description={`Детский летний лагерь для подростков 11–15 лет в Подмосковье ${SEASON_YEAR}. Москва рядом. Python, AI, Telegram-боты, хакатон. От ${PRICE_S4}, налоговый вычет 13%. Август — смены 3–15 и ${DATES_SHORT_S4}.`}
  h1={`Подростковый летний лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/lager-dlya-podrostkov/"
  breadcrumb="Лагерь для подростков"
>
  <LandingHero slot="hero"
    h1={`Подростковый летний лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle="Для тех, кому скучно в обычных программах. Делают реальные IT-проекты, конкурируют на хакатоне и возвращаются другими."
    breadcrumb="Лагерь для подростков"
    keywords={["Проект за смену — не задание, а личный результат", "Среда без телефонов — экранное время зарабатывается", "Смены на лето: 10 и 13 дней, август"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Ребята на занятиях в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <!-- Свой accordion убран: те же faqItems теперь первой вкладкой <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:0', 'about2026:7', 'about2026:9', 'payment:1']} /> — один
       видимый источник вопросов и один FAQPage вместо двух (31.07.2026) -->
  <FAQ
    extraItems={faqItems.map((item) => ({ q: item.question, a: item.answer }))}
    extraLabel="О лагере для подростков"
  />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('[data-faq-item]');
      const answer = item?.querySelector<HTMLElement>('[data-faq-answer]');
      const icon = btn.querySelector<HTMLElement>('[data-faq-icon]');
      if (!answer) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</LandingLayout>
