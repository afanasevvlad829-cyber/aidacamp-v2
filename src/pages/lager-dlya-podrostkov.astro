---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему подросткам нравится АйДаКемп?",
    text: "Большинство лагерей не рассчитаны на подростков — там скучно, потому что программа одинакова для всех. В АйДаКемп подростки 13–15 лет занимаются отдельно: более сложные проекты, больше самостоятельности, часть занятий на английском. Нет принудительных активностей — есть свобода выбора в рамках дня."
  },
  {
    h2: "Как работает режим без телефонов в лагере?",
    text: "Смартфоны сдаются на хранение в первый день. Вместо них — внутренняя валюта лагеря, которую зарабатывают за участие в активностях, помощь другим и прогресс в проекте. На неё можно «купить» экранное время или привилегии. Большинство подростков через 2–3 дня перестают скучать по телефону."
  },
  {
    h2: "Какая программа для подростков 12–16 лет?",
    text: "Старшая группа работает с Python, AI-инструментами и реальными задачами.",
    list: [
      "Python Advanced — функции, классы, API, базы данных",
      "AI-проекты — обучение моделей, работа с ChatGPT API",
      "Telegram-боты — создание и публикация рабочего бота",
      "3D и дизайн — моделирование, прототипирование интерфейсов"
    ]
  },
  {
    h2: "Где находится лагерь для подростков в Подмосковье?",
    text: "АйДаКемп — лагерь в Подмосковье для подростков: Наро-Фоминский район, 66 км от Москвы по Киевскому шоссе. Сосновый лес, спортивные площадки, бассейн. Добраться 1–1,5 часа на машине от МКАД — организуем трансфер из Москвы в день заезда и выезда."
  },
  {
    h2: "Сколько стоит смена для подростка в 2026 году?",
    text: "Для подростков подходят смены от 10 дней — за это время успевает сложиться команда и получается полноценный проект. Смена 2 (14 дней, июнь) особенно подходит для тех, кто хочет максимального результата."
  },
  {
    h2: "Чем отличается группа для подростков 11–14 лет?",
    text: "Разный возраст — разная программа, разные правила, разная смена. Подростка нельзя просто «подселить» в общий лагерь для 7–10 лет — ему будет скучно и «слишком по-детски». В АйДаКемп старшая группа живёт отдельно, с собственным ритмом дня, программой и преподавателями.",
    list: [
      "Меньше фиксированного расписания — больше времени на собственный проект",
      "Возможность самим выбирать роль в команде (лидер / разработчик / дизайнер / презентатор)",
      "Финал смены — защита проекта перед всем лагерем, включая младших (роль «взрослых» в глазах других)",
      "Свои вечерние активности: настольные игры, дискуссии, спортивные турниры",
      "Отдельный корпус или крыло — не пересекаются с малышами в быту"
    ]
  },
  {
    h2: "Что подросток получает из лагеря — реальный результат?",
    text: "Программа и фото с хакатона — это верхушка. Реальный результат смены — то, что подросток привозит в своей голове и в своём характере. За 10–14 дней с ним происходят изменения, которые родители замечают через 2 недели после возвращения:",
    list: [
      "Навык сосредоточенной работы без телефона — то, что многим не даётся годами",
      "Опыт принятия решений в команде с ровесниками (не под контролем родителей)",
      "Конкретный IT-проект, которым можно похвастаться в школе",
      "Понимание своих сильных сторон (лидер / разработчик / дизайнер / организатор)",
      "Круг новых друзей-ровесников, с которыми интересно общаться (не только в онлайне)"
    ]
  },
  {
    h2: "Как подготовить подростка к первому лагерю?",
    text: "Подросток — не ребёнок: с ним не поработает фраза «мы тебя отправляем туда, соберись». Нужен разговор как со взрослым — с аргументами и возможностью отказаться. Без этого даже «лучший лагерь мира» превратится в «меня заперли на 10 дней». Несколько практических советов:",
    list: [
      "Покажите сайт, фото смен, отзывы других подростков. Пусть выберет сам из 2–3 вариантов",
      "Обсудите цель поездки — не «отдохни», а «попробуй что-то новое, посмотри что получится»",
      "Не обещайте «тебе точно понравится» — честно говорите: «будет вызов, но интересно»",
      "Договоритесь о режиме связи: звонок в определённые окна, не круглосуточный мониторинг",
      "Обсудите что он возьмёт с собой из хобби (гитара, настолка, книги) — чтобы было свое"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Лагерь для подростков в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для подростков 11–15 лет в Наро-Фоминском районе, 66 км от Москвы. Python, AI, Telegram-боты. Смены 10–14 дней от 74 900 ₽. Вычет 13%."
  h1="Лагерь для подростков в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-dlya-podrostkov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "С какого возраста подростки едут в IT-лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 10 лет. Для подростков 10–15 лет есть отдельные группы: средний (10–12 лет) и старший (13–15 лет). Программа сложнее: реальные API, продвинутый Python, AI-проекты." }
        },
        {
          "@type": "Question",
          "name": "Подходит ли лагерь подросткам, которым скучно в обычных лагерях?",
          "acceptedAnswer": { "@type": "Answer", "text": "Особенно подходит. В АйДаКемп нет скуки: подростки работают над реальными проектами, конкурируют на хакатоне, общаются с ровесниками, которым интересно то же самое." }
        },
        {
          "@type": "Question",
          "name": "Есть ли телефоны у подростков в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Телефоны ограничены: в часы занятий убраны, в свободное время — по расписанию. Это сделано намеренно: концентрация повышается, подростки больше общаются между собой." }
        },
        {
          "@type": "Question",
          "name": "Что делают подростки в IT-лагере помимо кода?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бассейн, спорт, вечерние квесты, командные игры. Хакатон — соревновательная атмосфера, презентация проекта перед аудиторией. Общение с ровесниками из разных городов." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для подростков в Подмосковье"
    subtitle="Для тех, кому скучны обычные лагеря. Здесь подростки делают реальные IT-проекты и учатся ценить своё время."
    breadcrumb="Лагерь для подростков"
    keywords={["Проект за смену — не задание, а личный результат", "Среда без телефонов — экранное время зарабатывается", "Группы 10–12 и 13–15 лет с отдельной программой"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Летний лагерь для подростков в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
