---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Подольска",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, примерно в 40 км от Подольска. Ближайший маршрут — по Симферопольскому шоссе через Серпухов на A-101, либо через Подольск–Наро-Фоминск — около часа езды. Организованный трансфер отправляется из Москвы (точка сбора — м. Солнцево), до Подольска мы не заезжаем. Многие семьи из Подольска добираются самостоятельно до точки сбора — это занимает 20–30 минут."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Подольском",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Подольска выбирают АйДаКемп",
    text: "Из Подольска до лагеря 40–50 минут — это ближайший IT-лагерь с полным проживанием для вашего города. Что это значит на практике:",
    list: [
      "Самый близкий IT-лагерь с проживанием — 30–35 км по Калужскому шоссе",
      "Нет акклиматизации — Подмосковье, тот же климат, ребёнок сразу в форме",
      "Проведать в середине смены — 40 минут и ты рядом с ребёнком",
      "Трансфер от м. Солнцево всего 20–25 минут от Подольска на машине"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей с юга Подмосковья",
    text: "В АйДаКемп едут дети из Подольска, Климовска, Чехова, Серпухова — южного и юго-западного Подмосковья. Вот что пишут родители:",
    list: [
      "«Сын из Климовска — ехали сами до Солнцево, 25 минут, и пересели на автобус. Никаких проблем» — Мария, мама Кирилла, 11 лет",
      "«Дочь после лагеря сама скачала Python и продолжила проект дома — это лучшее, что могло быть» — Анна, Подольск",
      "«Боялись что далеко, но 40 минут дороги стоят того — ребёнок вернулся другим человеком» — Сергей, Чехов"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь рядом с Подольском 2026 — АйДаКемп"
  description="Детский лагерь недалеко от Подольска: 40 км по Симферопольскому шоссе, IT-программа, бассейн. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Подольском"
  canonical="https://aidacamp.ru/lager-podolsk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Подольска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Подольска — 40 км по Симферопольскому шоссе через Серпухов на A-101, около 1 часа. Организованный трансфер отправляется от м. Солнцево — до него из Подольска 20–30 минут." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Принимаем детей 7–15 лет с любым уровнем подготовки. Группы начинающих (с нуля), средний и продвинутый уровень — до 8 человек в группе." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание, 5-разовое питание, IT-программа (Python, AI, Minecraft, Roblox, 3D), бассейн, страховка. Трансфер из Москвы — 2 500 ₽ отдельно." }
        },
        {
          "@type": "Question",
          "name": "Когда проходят смены в 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Четыре смены: 30 мая–8 июня (10 дней), 10–23 июня (14 дней), 3–15 августа (13 дней), 17–26 августа (10 дней). Короткие смены 7–8 дней в июне и августе." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Подольском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 40 км от Подольска. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-podolsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Подольском"
    subtitle="IT-лагерь в Наро-Фоминском районе — 40 км от Подольска по Симферопольскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Подольска"
    keywords={["40 км от Подольска по Симферопольскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Бассейн, проживание, 5-разовое питание включено"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Подольском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
