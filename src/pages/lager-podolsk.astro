---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Подольск: от заводов к IT-поколению",
    text: "Подольск — город с мощным промышленным прошлым: металлургия, машиностроение, производство. Именно такие города дают следующее IT-поколение: когда дедушка работал на заводе, а папа уже в офисе — ребёнок пойдёт в программирование. АйДаКемп помогает этому переходу случиться быстро и с удовольствием. Школьник вернётся домой с реальным проектом, а не просто с загаром."
  },
  {
    h2: "Маршрут из Подольска в лагерь — ~75 км, ~1 ч 10 мин",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области. Из Подольска удобно добираться несколькими способами — и важно, что лагерь находится буквально по соседнему шоссе.",
    list: [
      "На машине: Подольск → Симферопольское шоссе → через Наро-Фоминск, ~75 км, ~1 ч 10 мин без пробок",
      "На электричке + трансфер: электричка Курского направления Подольск → Москва-Курская → метро до м. Солнцево, около 1 ч 10 мин",
      "Трансфер от м. Солнцево бесплатно в день заезда и обратно в день отъезда"
    ]
  },
  {
    h2: "Что ждёт школьников в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Ребята 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Подольском",
    text: "Лагерь принимает ребят от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Новички в кодинге — стартуем с нуля, результат виден уже на 3-й день",
      "С опытом — получат более сложные задачи и реальный проект",
      "Геймеры — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Почему родители из Подольска выбирают АйДаКемп",
    text: "Из Подольска до лагеря — один из самых коротких маршрутов среди южного Подмосковья. Что это значит на практике:",
    list: [
      "~75 км по Симферопольскому шоссе — прямая дорога без московских пробок",
      "Нет акклиматизации — Подмосковье, тот же климат, ребёнок сразу в форме",
      "Проведать в середине смены — около часа и ты рядом",
      "Трансфер от м. Солнцево бесплатно — электричка Курского направления до точки сбора"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽ (налоговый вычет ~2 800 ₽)",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (налоговый вычет до 5 434 ₽)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽ (налоговый вычет ~5 200 ₽)",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽ (налоговый вычет ~4 800 ₽)",
      "Трансфер от м. Солнцево — бесплатно"
    ]
  },
  {
    h2: "Отзывы семей с юга Подмосковья",
    text: "В АйДаКемп едут ребята из Подольска, Климовска, Чехова, Серпухова — южного и юго-западного Подмосковья. Вот что пишут родители:",
    list: [
      "«Сын из Климовска — ехали сами до Солнцево, 25 минут, и пересели на автобус. Никаких проблем» — Мария, мама Кирилла, 11 лет",
      "«Дочь после лагеря сама скачала Python и продолжила проект дома — это лучшее, что могло быть» — Анна, Подольск",
      "«Боялись что далеко, но час десять дороги стоят того — ребёнок вернулся другим: сам стал искать задачи» — Сергей, Чехов"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь рядом с Подольском 2026 — АйДаКемп"
  description="IT-лагерь рядом с Подольском: ~75 км, ~1 ч 10 мин по Симферопольскому шоссе. Трансфер от м. Солнцево бесплатно. Python, AI, Minecraft для школьников 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Подольском"
  canonical="https://aidacamp.ru/lager-podolsk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Подольска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Подольска — ~75 км по Симферопольскому шоссе, около 1 ч 10 мин. Бесплатный трансфер от м. Солнцево — добраться туда можно на электричке Курского направления Подольск → Москва → метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Принимаем ребят 7–15 лет с любым уровнем подготовки. Группы начинающих (с нуля), средний и продвинутый уровень — до 8 человек в группе." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание, 5-разовое питание, IT-программа (Python, AI, Minecraft, Roblox, 3D), бассейн, страховка. Трансфер от м. Солнцево — бесплатно." }
        },
        {
          "@type": "Question",
          "name": "Когда проходят смены в 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Четыре смены: 10–16 июня (7 дней), 10–23 июня (14 дней), 3–15 августа (13 дней), 17–26 августа (10 дней). Июль 2026 занят полностью." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Подольском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~75 км от Подольска. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-podolsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Подольском"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~75 км от Подольска. Трансфер от м. Солнцево бесплатно. Python, AI, Minecraft для школьников 7–15 лет."
    breadcrumb="Лагерь из Подольска"
    keywords={["~75 км от Подольска (~1 ч 10 мин), трансфер от м. Солнцево бесплатно", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Бассейн, проживание, 5-разовое питание включено"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Подольском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
