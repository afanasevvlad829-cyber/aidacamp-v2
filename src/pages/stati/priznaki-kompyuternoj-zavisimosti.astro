---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';

const relatedPages = [
  { title: "Зависимость от игр", url: "/stati/zavisimost-ot-kompyuternyh-igr", emoji: "🎮", description: "Главная статья о компьютерной зависимости" },
  { title: "Как избавиться от игр", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", emoji: "🔄", description: "Что реально работает" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", emoji: "📵", description: "Как работает наша механика" },
];
---

<Base
  title="Признаки компьютерной зависимости у детей и подростков — как распознать вовремя"
  description="6 главных признаков того что ребёнок уже зависим, а не «просто много играет». Понятный чек-лист от мам, которые прошли это сами."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/priznaki-kompyuternoj-zavisimosti" />
  </Fragment>
  <Header />
  <main class="mx-auto max-w-[860px] px-4 py-12">

    <nav class="text-[13px] text-slate-400 mb-6">
      <a href="/" class="hover:text-[#ff8a00] transition">Главная</a>
      <span class="mx-1">&rarr;</span>
      <a href="/stati/zavisimost-ot-kompyuternyh-igr" class="hover:text-[#ff8a00] transition">Статьи</a>
      <span class="mx-1">&rarr;</span>
      <span class="text-slate-600">Признаки компьютерной зависимости</span>
    </nav>

    <h1 class="text-[32px] md:text-[40px] font-bold leading-[1.15] tracking-[-0.03em] text-slate-900 mb-4">
      Признаки компьютерной зависимости у детей и подростков
    </h1>

    <p class="text-[16px] text-slate-500 mb-10">
      Как отличить «просто увлечение играми» от настоящей зависимости — 6 конкретных признаков.
    </p>

    <article>
      <div class="mb-10">
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Сколько можно играть?», «Опять перед экраном?», «Оторвись уже!» — знакомые фразы почти в каждой семье подростка. Но где грань между нормальным увлечением играми и настоящей зависимостью? Разбираемся по пунктам — без паники и без занижения проблемы.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            1. Потеря контроля — главный признак
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Здоровое увлечение: ребёнок поиграл, сохранил прогресс, занялся другим. Зависимость: ребёнок <strong>не может остановиться сам</strong>, даже если обещал вам (и себе). Сеанс игры затягивается «ещё на минутку» и превращается в часы. Любая попытка прервать — взрыв эмоций.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            2. Агрессия при попытке ограничить
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Недовольство — нормально. Истерика, угрозы, плач, крики «я тебя ненавижу!» при простом «пора заканчивать» — признак зависимости. Мозг ребёнка реагирует на ограничение экранного времени так, как взрослый зависимый реагирует на отобранную бутылку или сигарету. Это химическая реакция, а не «он просто капризничает».
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            3. Потеря интереса к тому что раньше нравилось
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Особенно тревожный сигнал. Если ребёнок раньше:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Любил гулять с друзьями — перестал выходить из дома</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Ходил в секцию — начал «забывать» про тренировки</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Увлекался Лего или рисованием — забросил всё</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Читал книги — теперь даже комиксы не открывает</span></li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Причина — в мозгу произошло «выравнивание дофамина». Игры дают такой интенсивный и предсказуемый выброс, что обычная жизнь перестаёт «радовать» по ощущению.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            4. Нарушение сна
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Засиживается до 2–3 ночи, встаёт вялый, в школе «засыпает над учебником». Синий свет экрана подавляет мелатонин — гормон сна. А ещё дело в том, что игра не отпускает — «ещё один матч», «ещё уровень», «ещё 10 минут». И так до утра. Если ребёнок стал есть хуже, утром невозможно добудиться, а вечером наоборот оживает — это прямой сигнал что экранное время вышло из-под контроля.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5. Ложь о времени за экраном
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Я уже всё, я просто посмотрел» — а вы слышите звук игры. «Я полчаса всего» — а телефон показывает 4 часа. Ребёнок начинает <strong>лгать осознанно</strong>, прячет устройства, играет ночью под одеялом. Это ещё более серьёзный симптом чем сама игра — он говорит о том что ребёнок уже боится собственного поведения, понимает что «перебрал», но не может остановиться.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            6. Снижение успеваемости и социальная изоляция
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Последний и самый заметный признак — когда проблема уже «в поле». Оценки в школе падают не потому что ребёнок глупеет, а потому что у него нет мыслительного ресурса на учёбу: он устал от игр. Друзья в офлайне исчезают — все контакты переходят в игровые чаты. Семейные обеды проходят в тишине, ребёнок ждёт чтобы быстрее уйти к экрану.
        </p>
      </div>

      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сколько признаков должно совпасть
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Один признак — не диагноз. Два — повод присмотреться. Три и больше в течение минимум месяца — серьёзный сигнал что нужно действовать. Причём быстрее чем «ну посмотрим, может само пройдёт». По опыту мам, которые прошли этот путь — само не проходит. Чем дольше тянуть, тем глубже закрепляется паттерн.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы нашли у своего ребёнка 3+ признака — прочитайте наш материал <a href="/stati/kak-izbavitsya-ot-zavisimosti-ot-igr" class="text-[#ff8a00] hover:underline">«Как избавиться от компьютерной зависимости»</a>. А самый рабочий способ в нашем опыте — сменить среду: смена обстановки + новые друзья + реальный проект за 10 дней переписывают паттерн.
        </p>
        <p class="mt-4 text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Смены лета 2026 — с 30 мая по 26 августа, от 48 000 ₽. Ребёнок без телефона не по запрету, а по собственному выбору — мы сделали экранное время внутренней валютой.
        </p>
        <a
          href="/lager-bez-telefonov/"
          class="mt-6 inline-flex items-center gap-2 rounded-[12px] bg-orange-500 px-6 py-3 text-[15px] font-semibold text-white transition hover:bg-orange-600 hover:-translate-y-0.5 shadow-[0_4px_16px_rgba(249,115,22,0.3)]"
        >
          Лагерь без телефонов в Подмосковье →
        </a>
      </div>

    </article>
  </main>
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
