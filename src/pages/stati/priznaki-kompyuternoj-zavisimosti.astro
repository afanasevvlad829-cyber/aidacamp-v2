---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Все статьи о зависимостях", url: "/stati/zavisimost-u-detej", icon: "grid", description: "Полный гид по детским цифровым зависимостям" },
  { title: "Как избавиться от зависимости от игр", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", icon: "arrow-repeat", description: "Пошаговый план" },
  { title: "Лечение компьютерной зависимости", url: "/stati/lechenie-kompyuternoj-zavisimosti", icon: "heart-pulse-fill", description: "Что реально работает" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-x", description: "Среда без телефонов — смена" },
];
---

<Base
  title="6 признаков компьютерной зависимости у ребёнка — это уже не просто игры"
  description="Ваш ребёнок много играет — или уже зависит? Пройдите чек-лист за 2 минуты и разберитесь, пора ли действовать. От мам, которые уже прошли через это."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/priznaki-kompyuternoj-zavisimosti" />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Признаки компьютерной зависимости у ребёнка — чек-лист из 6 маркеров | АйДаКемп",
      "description": "6 главных признаков зависимости от игр — не «просто много играет». Понятный чек-лист от мам, которые прошли это сами.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-02-05",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/priznaki-kompyuternoj-zavisimosti"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как понять, что у ребёнка компьютерная зависимость?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ключевые признаки: агрессия при попытке забрать гаджет, ложь о времени за экраном, отказ от еды и сна ради игр, потеря интереса ко всему кроме экрана, ухудшение учёбы и отношений с ровесниками." }
        },
        {
          "@type": "Question",
          "name": "Сколько часов за компьютером — это зависимость?",
          "acceptedAnswer": { "@type": "Answer", "text": "Дело не только в часах. 4–5 часов с чередованием активностей — не зависимость. 3 часа, но с агрессией при попытке остановить — уже тревожный сигнал. Важнее не время, а поведение ребёнка." }
        },
        {
          "@type": "Question",
          "name": "Что делать если ребёнок проводит за компьютером всё время?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не запрещать резко — это усиливает тягу. Создавать альтернативы: интересное занятие в реальном мире, физическая активность, общение. IT-лагерь переключает с пассивного потребления на активное создание." }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Признаки компьютерной зависимости у ребёнка"
    subtitle="Как отличить нормальное увлечение от зависимости — список маркеров и что делать."
    imageBase="priznaki-zavisimosti"
    imageAlt="Подростки в лагере улыбаются и общаются — контраст с жизнью в экране"
    readTime="6 мин чтения"
    breadcrumbsLast="Признаки компьютерной зависимости"
    daryaQuote="Моя дочь как-то сказала: «мама, мне ничего не хочется делать без экрана». Это был момент, когда я поняла — пора возвращать жизнь вне телефона."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Сколько можно играть?», «Опять перед экраном?», «Оторвись уже!» — знакомые фразы почти в каждой семье подростка. Но где грань между нормальным увлечением играми и настоящей зависимостью? Разбираемся по пунктам — без паники и без занижения проблемы.
        </p>

        <StatCallout
          value="5+ ч/день"
          label="без экрана — ВОЗ относит к «риску игровой зависимости» у подростков."
          source="ВОЗ, МКБ-11"
          icon="phone"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            1. Потеря контроля — главный признак
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Здоровое увлечение: ребёнок поиграл, сохранил прогресс, занялся другим. Зависимость: ребёнок <strong>не может остановиться сам</strong>, даже если обещал вам (и себе). Сеанс игры затягивается «ещё на минутку» и превращается в часы. Любая попытка прервать — взрыв эмоций.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            2. Агрессия при попытке ограничить
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Недовольство — нормально. Истерика, угрозы, плач, крики «я тебя ненавижу!» при простом «пора заканчивать» — признак зависимости. Мозг ребёнка реагирует на ограничение экранного времени так, как взрослый зависимый реагирует на отобранную бутылку или сигарету. Это химическая реакция, а не «он просто капризничает».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            3. Потеря интереса к тому что раньше нравилось
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Особенно тревожный сигнал. Если ребёнок раньше:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Любил гулять с друзьями — перестал выходить из дома</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ходил в секцию — начал «забывать» про тренировки</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Увлекался Лего или рисованием — забросил всё</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Читал книги — теперь даже комиксы не открывает</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Причина — в мозгу произошло «выравнивание дофамина». Игры дают такой интенсивный и предсказуемый выброс, что обычная жизнь перестаёт «радовать» по ощущению.
        </p>
      </div>

        <StatCallout
          value="9 из 10"
          label="российских подростков играют регулярно — норма превращается в проблему на границе."
          source="Mediascope, 2024"
          icon="controller"
          tone="neutral"
        />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            4. Нарушение сна
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Засиживается до 2–3 ночи, встаёт вялый, в школе «засыпает над учебником». Синий свет экрана подавляет мелатонин — гормон сна. А ещё дело в том, что игра не отпускает — «ещё один матч», «ещё уровень», «ещё 10 минут». И так до утра. Если ребёнок стал есть хуже, утром невозможно добудиться, а вечером наоборот оживает — это прямой сигнал что экранное время вышло из-под контроля.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5. Ложь о времени за экраном
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Я уже всё, я просто посмотрел» — а вы слышите звук игры. «Я полчаса всего» — а телефон показывает 4 часа. Ребёнок начинает <strong>лгать осознанно</strong>, прячет устройства, играет ночью под одеялом. Это ещё более серьёзный симптом чем сама игра — он говорит о том что ребёнок уже боится собственного поведения, понимает что «перебрал», но не может остановиться.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            6. Снижение успеваемости и социальная изоляция
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Последний и самый заметный признак — когда проблема уже «в поле». Оценки в школе падают не потому что ребёнок глупеет, а потому что у него нет мыслительного ресурса на учёбу: он устал от игр. Друзья в офлайне исчезают — все контакты переходят в игровые чаты. Семейные обеды проходят в тишине, ребёнок ждёт чтобы быстрее уйти к экрану.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сколько признаков должно совпасть
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Один признак — не диагноз. Два — повод присмотреться. Три и больше в течение минимум месяца — серьёзный сигнал что нужно действовать. Причём быстрее чем «ну посмотрим, может само пройдёт». По опыту мам, которые прошли этот путь — само не проходит. Чем дольше тянуть, тем глубже закрепляется паттерн.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы нашли у своего ребёнка 3+ признака — прочитайте наш материал <a href="/stati/kak-izbavitsya-ot-zavisimosti-ot-igr" class="text-[#ec9b44] hover:underline">«Как избавиться от компьютерной зависимости»</a>. А самый рабочий способ в нашем опыте — сменить среду: смена обстановки + новые друзья + реальный проект за 10 дней переписывают паттерн.
        </p>
        <p class="mt-4 text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <a href="/ceny" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Смены лета 2026</a> — с 30 мая по 26 августа, от 48 000 ₽. Ребёнок без телефона не по запрету, а по собственному выбору — мы сделали экранное время внутренней валютой.
        </p>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-[#ec9b44]/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Помогает ли лагерь при зависимости от гаджетов?</p>
        <p class="mt-2 text-[15px] text-[#0d1a2b]/70">В АйДаКемп телефоны сдают при заезде. За 10 дней без гаджетов дети сами начинают общаться, делать что-то руками и... забывают про телефон. 60% просятся обратно в следующую смену.</p>
        <a href="/lager-bez-telefonov" class="mt-4 inline-block rounded-xl bg-[#ec9b44] px-6 py-3 text-[15px] font-semibold text-white hover:bg-[#d67000] transition-colors">Узнать про лагерь без телефонов</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-[14px] font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/stati/zavisimost-u-detej" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Все статьи о детских зависимостях — полный гид
          </a>
          <a href="/stati/zavisimost-ot-kompyuternyh-igr" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Зависимость от компьютерных игр — как отличить от увлечения
          </a>
          <a href="/stati/kak-izbavitsya-ot-zavisimosti-ot-igr" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Как избавиться от зависимости от игр — 5 шагов
          </a>
          <a href="/lager-bez-telefonov" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Лагерь без телефонов — как работает детокс
          </a>
        </div>
      </div>

    </article>
  </main>
  <ArticleBottomCta
    bookingTitle="Верните ребёнку жизнь вне экрана"
    bookingSubtitle="Оставьте телефон — перезвоним за 10 минут, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
