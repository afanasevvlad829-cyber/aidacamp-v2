---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import { mainShifts, PRICE_S3, PRICE_S4 } from '../../data/shifts.ts';

const relatedPages = [
  { title: "Смены 2026", url: "/ceny/", icon: "calendar-week", description: "Даты и цены всех смен" },
  { title: "Лагерь от 10 лет", url: "/lager-10-let/", icon: "people", description: "Программа для ребят 10–16 лет" },
  { title: "Первый раз без родителей", url: "/stati/pervyj-raz-bez-roditeley/", icon: "heart", description: "Как подготовиться к первому лагерю" },
  { title: "Что взять в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "backpack", description: "Полный список вещей" },
];

const faqItems = [
  {
    question: "Как понять, готов ли ребёнок ехать в лагерь без родителей в 10 лет?",
    answer: "Смотрите не на возраст, а на поведение. Если ребёнок ночует у бабушки или друга без слёз — уже хороший знак. Если справляется с мелкими бытовыми вещами сам (собрал рюкзак, разогрел еду, решил вопрос с одноклассником) — значит, базовая самостоятельность есть. Готовность к лагерю — это не «хочет ехать», а «справится, даже если поначалу непросто»."
  },
  {
    question: "Как поддержать ребёнка перед отъездом, не нагнетая тревогу?",
    answer: "Самое важное — не переносить свои страхи. Говорите о конкретном: «Там будут ребята твоего возраста, будете вместе делать проекты, по вечерам — игры». Договоритесь, когда позвоните в первый день — и придерживайтесь этого. Ребёнок с чётким якорем («мама позвонит вечером») адаптируется быстрее, чем тот, кто ждёт звонка в любой момент."
  },
  {
    question: "Как поддерживать связь с ребёнком во время смены?",
    answer: "В АйДаКемп телефоны хранятся в именных боксах в течение дня — это помогает ребятам включиться в жизнь отряда. Для родителей: Telegram-канал отряда с фотографиями каждый вечер, плюс звонки в определённые часы. Большинство мам говорят, что после трёх дней перестают тревожиться — по фото всё понятно."
  },
  {
    question: "Что взять ребёнку с собой в лагерь?",
    answer: "Основное: одежда на каждый день с запасом (дети теряют вещи), удобная обувь для улицы, средства гигиены, солнцезащитный крем. Из личного: одну небольшую знакомую вещь — фото семьи или любимый браслет, это снижает тревогу в первые дни. Гаджеты кроме телефона не нужны — на программирование всё есть. Подробный список — в нашей статье «Что взять в лагерь»."
  },
];
---

<Base
  title="Лагерь без родителей для ребёнка 10 лет — первый самостоятельный отдых"
  description="Почему 10 лет — хороший возраст для первого лагеря без родителей. Как устроен день, что помогает адаптироваться, цены смен 2026. Честно — от мамы к маме."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь без родителей для ребёнка 10 лет — первый самостоятельный отдых",
        "description": "Почему 10 лет — хороший возраст для первого лагеря без родителей. Как устроен день, что помогает адаптироваться, цены смен 2026.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-17",
        "dateModified": "2026-06-17",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/lager-bez-roditeley-10-let/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
          {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
          {"@type": "ListItem", "position": 3, "name": "Лагерь без родителей для ребёнка 10 лет", "item": "https://aidacamp.ru/stati/lager-bez-roditeley-10-let/"}
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title="Лагерь без родителей для ребёнка 10 лет"
    subtitle="Почему десять — это хороший возраст, и как сделать первый отъезд лёгким"
    breadcrumb="Лагерь без родителей 10 лет"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Ребята 10 лет в лагере АйДаКемп — первый самостоятельный отдых без родителей"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <h2>Почему 10 лет — хороший возраст для первого лагеря</h2>
    <p>
      Вопрос «рано или не рано» мамы задают себе примерно с восьми лет, а потом ещё раз в девять. Честный ответ: у большинства ребят в 10 лет есть всё, что нужно для первого самостоятельного лагеря.
    </p>
    <p>
      В этом возрасте уже можно объяснить правила и договориться — и ребёнок их запомнит. Уже есть интерес к ровесникам, желание быть в компании. Уже не нужна мама рядом, чтобы лечь спать или разобраться с конфликтом в группе. И — важно — ещё не начался подростковый период, когда всё сложнее.
    </p>
    <p>
      Десятилетние ребята адаптируются быстрее, чем думают их родители. По нашему опыту: первые 2–3 дня — новизна и лёгкий мандраж, потом — включение. К концу первой недели большинство не хотят домой, они хотят остаться.
    </p>

    <h2>Что помогает ребёнку адаптироваться</h2>
    <p>
      Адаптация — это не «перестать скучать по маме». Это найти своё место в новой группе, понять правила, получить первые маленькие победы. В АйДаКемп это происходит быстро — и вот почему.
    </p>
    <p>
      <strong>Группы по возрасту.</strong> Ребята 10–12 лет живут и занимаются вместе — нет ощущения, что ты самый младший и не понимаешь, о чём говорят старшие.
    </p>
    <p>
      <strong>Результат с первого дня.</strong> Уже в первые часы смены ребёнок что-то делает своими руками — собирает сцену, добавляет персонажа, запускает первую анимацию. Это не «мы тут занимаемся, подождите три дня», а сразу видимый результат. Когда что-то получается — тревога уходит.
    </p>
    <p>
      <strong>Внутренняя экономика лагеря.</strong> В АйДаКемп действует своя система: ребята зарабатывают игровую валюту лагеря за активность, помощь, инициативу — и сами решают, на что её потратить. Это создаёт вовлечённость и понятные правила игры с первого дня.
    </p>
    <p>
      <strong>Вожатые, которые следят за настроением.</strong> Если ребёнок замкнулся — вожатый подходит сам, не ждёт. Первые два дня у нас намеренно насыщенные: некогда грустить. К третьему дню большинство уже нашли своих.
    </p>

    <h2>Как устроен день в лагере</h2>
    <p>
      День в АйДаКемп — это не «сидим за компьютером с утра до вечера». Это чередование программирования, активностей и времени с отрядом.
    </p>
    <p>
      Утром — занятия по программированию в группах по возрасту. Ребята 10–12 лет работают над проектами с игровой механикой и логикой — игры с уровнями, системы взаимодействия. Каждый занятие — конкретный шаг: добавили механику, протестировали, улучшили.
    </p>
    <p>
      После обеда — активности: спорт, квесты, командные игры, чемпионаты по футболу и пионерболу. Физическая активность встроена в расписание, а не добавлена «для галочки».
    </p>
    <p>
      Вечером — общие мероприятия: отрядные игры, хакатоны, конкурсы. Это время, когда ребята с разных занятий пересекаются и становятся командой.
    </p>
    <p>
      За 2–3 дня до конца смены — хакатон: ребята доводят проекты до финальной версии и показывают результат. Это момент, которого ждут — и который запоминается надолго.
    </p>

    <h2>Смены АйДаКемп 2026 — для ребят от 10 лет</h2>
    <p>
      Летом 2026 года открыты две смены. Обе подходят для первого самостоятельного отдыха — ребята 10 лет принимаются в обеих.
    </p>

    <ul>
      <li>
        <strong>Смена 3</strong> — {mainShifts[0].dates}, {mainShifts[0].duration}. Акцент на командную работу и проект от идеи до результата. Цена: <strong>{PRICE_S3}</strong>. Осталось {mainShifts[0].free} места.
      </li>
      <li>
        <strong>Смена 4</strong> — {mainShifts[1].dates}, {mainShifts[1].duration}. Закрытие лета: аккуратный проект и уверенный результат. Цена: <strong>{PRICE_S4}</strong>. Осталось {mainShifts[1].free} места.
      </li>
    </ul>

    <p>
      Подробности о каждой смене, программе и местах — на странице <a href="/ceny/">смены 2026</a>. Если ребёнку 10 лет и он едет впервые — напишите нам при записи, вожатый будет в курсе.
    </p>
    <p>
      Ещё про программу для ребят от 10 лет — на странице <a href="/lager-10-let/">лагерь от 10 лет</a>.
    </p>

    <h2>Что говорят мамы, чьи ребята ездили в 10 лет впервые</h2>
    <p>
      «Я переживала больше, чем она. В первый вечер позвонила — говорит нормально всё, девочки в комнате хорошие. На третий день уже не позвонила сама, написала вожатому — оказалось, были на вечернем мероприятии. Приехала с проектом и новыми подругами.»
    </p>
    <p>
      «Сын в 10 лет ехал впервые — боялись, что будет скучать. Первые два дня звонил, потом перестал. Говорит: некогда было. Вернулся другим — самостоятельным и с кучей историй.»
    </p>
    <p>
      Это не исключения — это типичная картина. Большинство страхов родителей остаются страхами родителей. Ребята справляются — особенно когда рядом есть программа, которая их захватывает.
    </p>

    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}

  </main>
  <ArticleBottomCta
    title="Первый лагерь в 10 лет — расскажем всё и поможем выбрать смену"
    subtitle="Напишите нам — ответим на вопросы и подберём подходящий вариант для вашего ребёнка."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
