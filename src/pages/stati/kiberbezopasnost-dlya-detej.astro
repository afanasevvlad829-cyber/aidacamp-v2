---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "AI-лагерь", url: "/ai-lager/", icon: "robot", description: "Нейросети без страха" },
  { title: "IT-лагерь", url: "/it-lager/", icon: "laptop", description: "Цифровая грамотность" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Перезагрузка от экрана" },
  { title: "Зависимость от телефона", url: "/stati/zavisimost-ot-telefona-u-podrostkov/", icon: "phone", description: "Что делать маме" },
];

const faqItems = [
  {
    question: "С какого возраста учить ребёнка кибербезопасности?",
    answer: "Как только школьник получает первый гаджет с выходом в сеть — обычно это 7–9 лет. В этом возрасте достаточно простых правил: не давать никому пароль, не писать незнакомцам, звать взрослого, если что-то напугало. Чем старше — тем подробнее разговор: фишинг, мошенники в играх, личные данные."
  },
  {
    question: "Какие угрозы для школьников в интернете самые частые?",
    answer: "Фишинговые ссылки (под видом подарка или приза), мошенники в чатах онлайн-игр, выманивание паролей и данных карты родителей, агрессия и травля в комментариях, а в последние годы — поддельные голосовые и видео, сделанные нейросетями. Большинство этих рисков обезвреживаются одной привычкой: сомневаться и проверять."
  },
  {
    question: "Стоит ли просто запретить ребёнку интернет?",
    answer: "Полный запрет почти не работает: школьник всё равно встретит сеть — у друзей, в школе, позже сам. Гораздо надёжнее научить пользоваться безопасно. Запрет растит беспомощность, а навык — самостоятельность. Цель не «оградить навсегда», а «научить узнавать опасное и звать на помощь»."
  },
  {
    question: "Как связаны кибербезопасность и IT-лагерь?",
    answer: "В IT-лагере школьники смотрят на технологии изнутри: как устроены боты, как программы обрабатывают данные, почему пароль — это «ключ». Когда понимаешь, как всё работает, манипуляция мошенника становится заметной. Цифровая грамотность — это и есть лучшая защита."
  }
];
---

<Base
  title="Кибербезопасность для детей — правила, о которых стоит договориться"
  description="Реальные риски в сети для школьников: фишинг, мошенники в играх, пароли, дипфейки. Что делать родителю и каким правилам научить ребёнка — простой разбор."
  ogImage="/images/articles/ii-programmista-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Кибербезопасность для детей: чему учить и как защитить",
        "description": "Реальные онлайн-риски для школьников — фишинг, мошенники в играх и чатах, пароли, личные данные, дипфейки. Что делать родителю и чему учить ребёнка.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-22",
        "dateModified": "2026-06-22",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kiberbezopasnost-dlya-detej"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Кибербезопасность для детей: чему учить и как защитить"
    subtitle="Реальные риски в сети, понятные действия для мамы и то, чему ребёнок учится сам, когда понимает, как устроены технологии."
    imageBase="ii-programmista"
    imageAlt="Кибербезопасность для детей — школьник за компьютером"
    readTime="8 мин чтения"
    breadcrumbsLast="Кибербезопасность"
    daryaQuote="Я не пугаю дочь интернетом и не запрещаю его. Я объясняю, как он устроен. Когда она понимает, как работает ссылка-обманка или бот в игре, её уже не так-то просто провести — и мне спокойнее."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Запрещать интернет бессмысленно — школьник всё равно в нём живёт: уроки, игры, переписка с друзьями. Вопрос не в том, пускать или нет, а в том, умеет ли он распознавать опасное. Разбираемся, какие риски встречаются на самом деле, что может сделать мама и чему ребёнок учится сам, когда понимает, как технологии устроены изнутри.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Реальные риски: чего стоит опасаться
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Страшилок в новостях много, но по-настоящему частых угроз для школьников всего несколько. Если узнать их в лицо, большую часть проблем можно обойти заранее.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-link-45deg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Фишинг.</strong> Ссылка-обманка: «получи бесплатные скины», «ты выиграл приз», «подтверди аккаунт». Переходишь — и отдаёшь логин, пароль или данные карты. Самая массовая ловушка.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-controller text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Мошенники в играх и чатах.</strong> «Подари мне игровой предмет — верну вдвое», «давай созвонимся», «скинь фото». Под маской ровесника часто прячется взрослый с дурными намерениями.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-key text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Слабые пароли.</strong> Одинаковый простой пароль на всех сайтах — взломали один, получили доступ ко всему. Плюс школьники часто сами пересылают пароль «другу».</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-person-badge text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Личные данные.</strong> Адрес, школа, геометки на фото, телефон родителей — всё это не для публичных профилей и не для незнакомцев в переписке.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-robot text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Дипфейки и подделки на AI.</strong> Нейросети уже умеют подделать голос или видео. «Звонит мама» или «пишет друг» — а на деле это сгенерированная подделка, чтобы выманить деньги или данные.</p>
          </div>
        </div>
        <StatCallout
          value="62%"
          label="школьников 7–17 лет в России сталкивались с теми или иными угрозами в интернете — от агрессивного контента до попыток обмана."
          source="Исследование «Лаборатории Касперского» о детях в сети, 2023"
          icon="shield-exclamation"
          tone="warn"
        />
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что может сделать родитель
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хорошая новость: для безопасности не нужно быть айтишником. Достаточно нескольких простых привычек и спокойного разговора — без нотаций и запугивания.
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-chat-heart text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Договоритесь, что приходить можно с любым.</strong> Главное правило: «увидел странное или испугался — скажи мне, ругать не буду». Большинство бед случаются, когда школьник боится признаться.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-lock text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Включите базовую защиту.</strong> Двухфакторный вход на почту и игры, разные пароли, настройки приватности в профилях. Это десять минут — а уровень безопасности вырастает заметно.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-pause-circle text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Научите правилу паузы.</strong> «Спешат, торопят, обещают приз» — это красный флаг. Остановиться и спросить взрослого важнее, чем успеть «забрать подарок».</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-eye text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Будьте рядом, а не сверху.</strong> Спрашивайте про игры и блогеров с интересом, а не с подозрением. Тогда школьник сам расскажет, если в чате появился странный собеседник.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Иногда самый полезный шаг — просто дать передышку от экрана. Смена обстановки, живое общение и пара недель без бесконечной ленты возвращают вниманию здоровый формат. Об этом — наша статья про <a href="/lager-bez-telefonov/" class="font-semibold text-primary hover:underline">лагерь без телефонов</a>.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чему учится сам ребёнок
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самая прочная защита — это не родительский контроль, а понимание. Когда школьник знает, как устроена ссылка, пароль или бот, манипуляция перестаёт быть магией и становится заметной уловкой.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Цифровая грамотность — это привычка задавать себе простые вопросы. Кто это написал на самом деле? Зачем у меня просят пароль? Почему всё так срочно? Ребёнок, у которого эти вопросы включаются автоматически, защищён лучше, чем тот, кому просто всё запретили.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И ещё важное: понимающий школьник не теряется, а действует. Не «я что-то нажал и теперь боюсь сказать», а «я увидел подозрительную ссылку и не стал переходить». Это уверенность, а не страх перед технологиями.
        </p>
      </div>

      <!-- Section 4: связь с IT-лагерем -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему IT-лагерь помогает с цифровой грамотностью
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В IT-лагере ребята смотрят на технологии не как пользователи, а как создатели. Сами пишут простого бота — и понимают, что за «умным» собеседником стоит код, а не живой человек. Работают с данными — и видят, почему личную информацию нельзя разбрасывать. Знакомятся с нейросетями — и узнают, как делаются те самые подделки, которыми пугают в новостях.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда понимаешь механику изнутри, обмануть тебя сложнее. Об этом — подробнее на страницах нашего <a href="/ai-lager/" class="font-semibold text-primary hover:underline">AI-лагеря</a>, где школьники осваивают нейросети без страха, и <a href="/it-lager/" class="font-semibold text-primary hover:underline">IT-лагеря</a>, где цифровая грамотность вырастает сама собой из реальной практики.
        </p>
      </div>

      <!-- 5 простых правил -->
      <section class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5 правил, которые стоит запомнить школьнику
          </h2>
        </div>
        <div class="space-y-4">
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-[15px] font-bold text-slate-900 mb-1">1. Пароль — только мой</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Никому не говорю и не пересылаю, даже лучшему другу. На разных сайтах — разные пароли.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-[15px] font-bold text-slate-900 mb-1">2. Бесплатный сыр — в ловушке</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">«Получи приз», «забери скины бесплатно» — почти всегда обман. Не перехожу по таким ссылкам.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-[15px] font-bold text-slate-900 mb-1">3. Незнакомец остаётся незнакомцем</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Не отправляю фото, адрес и личные данные тем, кого не знаю вживую. И не иду на встречи.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-[15px] font-bold text-slate-900 mb-1">4. Срочно — значит подозрительно</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Если торопят и давят — делаю паузу и спрашиваю взрослого. Спешка нужна мошеннику, не мне.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-[15px] font-bold text-slate-900 mb-1">5. Испугался — сразу к своим</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Что-то напугало или случайно нажал — говорю родителям. Меня не будут ругать, мне помогут.</p>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите, чтобы ребёнок понимал технологии, а не боялся их?"
    bookingSubtitle="В АйДаКемп школьники создают ботов и проекты — и заодно учатся цифровой безопасности на практике."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
