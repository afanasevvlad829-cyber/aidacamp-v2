---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov/", icon: "phone", description: "Как мы сделали экранное время платным" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-detskom-lagere/", icon: "lightning-charge", description: "10 часов от идеи до стартапа" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Среда где телефон не нужен" },
];

const faqItems = [
  {
    question: "Зависимость от телефона у ребёнка — это болезнь?",
    answer: "Формально — нет, это не диагноз по МКБ-11. Но поведенческие паттерны очень похожи: нарастающая потребность, раздражение при ограничении, потеря интереса к другим занятиям. Лагерь не лечит — он создаёт среду, где телефон объективно проигрывает конкуренцию другим занятиям. Ребёнок сам делает этот выбор."
  },
  {
    question: "Что если ребёнок устроит скандал из-за телефона в первые дни?",
    answer: "Первые 1-2 дня бывают сложными — это нормально. Наши вожатые к этому готовы: они знают, как переключить внимание, дать задачу, создать момент вовлечённости. По опыту: к третьему дню почти все дети перестают требовать телефон. Не из-за запрета — просто появляется что-то интереснее."
  },
  {
    question: "Как долго нужно быть без телефона, чтобы был эффект?",
    answer: "Перелом происходит на 3-й день. Полноценная перестройка — к концу первой недели. Поэтому самый заметный эффект дают смены от 7 дней — именно столько нужно, чтобы пройти полный цикл: от «хочу телефон» до «а зачем мне телефон, когда есть хакатон»."
  },
  {
    question: "Ребёнок вернётся домой и снова возьмётся за телефон?",
    answer: "Возможно. Но опыт остаётся. Ребёнок видел, что без телефона ему было хорошо — и это его личный опыт, который нельзя отобрать. Многие семьи после лагеря переносят систему «у экранного времени есть цена» домой. Не как наказание, а как разговор о выборе."
  },
  {
    question: "Можно ли получить налоговый вычет за лагерь?",
    answer: "Да. У АйДаКемп есть образовательная лицензия Минобрнауки, поэтому вы можете вернуть 13% от стоимости образовательной части путёвки через ФНС. Документы для вычета выдаём автоматически."
  },
];
---

<Base
  title="Зависимость от телефона у детей: что происходит за 7 дней в лагере | АйДаКемп"
  description="Как лагерь меняет отношение ребёнка к телефону за неделю — день за днём. Не запрет, а переключение: экономика, хакатон, живое общение. Опыт IT-лагеря АйДаКемп."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/zavisimost-ot-telefona-u-detej-lager" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Зависимость от телефона у детей: что происходит за 7 дней в лагере",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru"},
        "datePublished": "2026-06-17",
        "dateModified": "2026-06-17",
        "url": "https://aidacamp.ru/stati/zavisimost-ot-telefona-u-detej-lager"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {"@type": "Answer", "text": item.answer}
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
        {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
        {"@type": "ListItem", "position": 3, "name": "Зависимость от телефона: 7 дней в лагере", "item": "https://aidacamp.ru/stati/zavisimost-ot-telefona-u-detej-lager/"}
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость от телефона у ребёнка: что происходит за 7 дней в лагере"
    subtitle="Не запрет, не конфискация. Переключение — и почему оно работает там, где война с гаджетами проигрывается."
    imageBase="bez-telefonov"
    imageAlt="Дети в IT-лагере АйДаКемп работают над проектом без телефонов"
    imagePosition="center 85%"
    readTime="6 мин чтения"
    breadcrumbsLast="Зависимость от телефона: лагерь"
    daryaQuote="Мне каждый год пишут: «Дарья, заберите у него телефон, хотя бы на неделю». Я понимаю этих мам — у меня самой дочь-подросток. Но мы давно перестали «забирать». Расскажу, что происходит вместо этого."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Intro -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Семь часов в день. Столько в среднем российский подросток проводит в экране — и это не считая уроков. Вы пробовали ограничить. Скандал. Вы договаривались. Час превращался в два. Вы устали. И где-то в голове засела мысль: «Вот бы на лето куда-нибудь без этого телефона».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы видели это много раз. И вот что происходит с ребёнком, который приезжает к нам — день за днём.
        </p>

        <StatCallout
          value="7+ часов"
          label="среднее экранное время подростка в России в сутки — это больше, чем он спит."
          source="Mediascope, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <!-- Infographic: 7-day timeline -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-5">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            7 дней: как меняется отношение к телефону
          </h2>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 mb-5 max-w-[620px]">
          Инфографика по реальным наблюдениям из смен АйДаКемп. Цифры — среднее по группе, не отдельный ребёнок.
        </p>

        <!-- SVG Infographic -->
        <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0">
          <svg viewBox="0 0 720 320" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[720px] min-w-[540px]" role="img" aria-label="График: снижение экранного времени за 7 дней в лагере">
            <defs>
              <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f97316" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#fb923c" stop-opacity="0.5"/>
              </linearGradient>
              <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#f97316"/>
                <stop offset="100%" stop-color="#22c55e"/>
              </linearGradient>
            </defs>

            <!-- Background -->
            <rect width="720" height="320" rx="16" fill="#f8fafc"/>

            <!-- Grid lines -->
            {[0, 25, 50, 75, 100].map((v, i) => (
              <line x1="60" y1={240 - v * 1.6} x2="700" y2={240 - v * 1.6} stroke="#e2e8f0" stroke-width="1" stroke-dasharray={v === 0 ? "0" : "4,4"}/>
            ))}
            {[0, 25, 50, 75, 100].map((v, i) => (
              <text x="52" y={244 - v * 1.6} text-anchor="end" font-size="10" fill="#94a3b8">{v}%</text>
            ))}

            <!-- Y axis label -->
            <text x="12" y="160" text-anchor="middle" font-size="10" fill="#94a3b8" transform="rotate(-90, 12, 160)">экранное время</text>

            <!-- Bars + labels for 7 days -->
            {[
              {day: 1, pct: 90, label: "День 1", event: "Ищет телефон", color: "#ef4444"},
              {day: 2, pct: 72, label: "День 2", event: "Первый код", color: "#f97316"},
              {day: 3, pct: 42, label: "День 3", event: "Перелом ↓", color: "#eab308"},
              {day: 4, pct: 28, label: "День 4", event: "Экономика", color: "#84cc16"},
              {day: 5, pct: 18, label: "День 5", event: "Переговоры", color: "#22c55e"},
              {day: 6, pct: 10, label: "День 6", event: "Подготовка", color: "#14b8a6"},
              {day: 7, pct: 5,  label: "День 7", event: "Хакатон 🏆", color: "#6366f1"},
            ].map((d, i) => {
              const x = 72 + i * 92;
              const barH = d.pct * 1.6;
              const barY = 240 - barH;
              return (
                <g key={d.day}>
                  <rect x={x - 22} y={barY} width="44" height={barH} rx="6" fill={d.color} opacity="0.85"/>
                  <text x={x} y={barY - 6} text-anchor="middle" font-size="11" font-weight="700" fill={d.color}>{d.pct}%</text>
                  <text x={x} y="258" text-anchor="middle" font-size="11" font-weight="600" fill="#475569">{d.label}</text>
                  <text x={x} y="272" text-anchor="middle" font-size="10" fill="#94a3b8">{d.event}</text>
                </g>
              );
            })}

            <!-- Trend line -->
            <polyline
              points="72,96 164,125 256,173 348,195 440,211 532,224 624,232"
              fill="none"
              stroke="url(#lineGrad)"
              stroke-width="2.5"
              stroke-dasharray="6,3"
              stroke-linecap="round"
            />

            <!-- Legend -->
            <rect x="60" y="290" width="12" height="4" rx="2" fill="#f97316" opacity="0.8"/>
            <text x="77" y="296" font-size="10" fill="#64748b">доля дня, потраченная на телефон (% от вечернего бюджета)</text>
          </svg>
        </div>
      </div>

      <!-- Day 1-2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День 1–2: самые сложные
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Первые два дня — это детокс. Ребёнок не устраивает скандалов (телефон ведь не забрали — он лежит в рюкзаке). Но оглядывается. Скучает. Пару раз в час тянется рукой к карману.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это нормально — и это именно зависимость. Не «плохое воспитание» и не «избалованность». Мозг привык к постоянному потоку дофамина из ленты — и теперь ему нужно время, чтобы перестроиться.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В эти два дня у нас специально плотная программа: знакомства, первые задачи, выбор трека. Дети из разных городов, общая задача — мозг переключается. К вечеру первого дня большинство уже меньше думают о телефоне, чем утром.
        </p>
      </div>

      <!-- Day 3: Перелом -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День 3: перелом
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На третий день происходит то, ради чего всё и задумывалось. Ребёнок получает первый рабочий результат — написал игру, собрал бота, сделал модель в 3D. Что-то, что существует в реальном мире и работает.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это принципиально другое ощущение, чем скроллинг. Там ты потребляешь. Здесь — создаёшь. Мозг это чувствует. И телефон с очередным видео про котиков вдруг кажется скучным по сравнению с тем, что только что произошло.
        </p>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-5 max-w-[720px] mb-4">
          <p class="text-base font-semibold text-orange-700 mb-2">Что переключает внимание на практике:</p>
          <ul class="space-y-1.5">
            {[
              "Python — первая программа, которая работает. Это магия в 11 лет.",
              "Команда из незнакомых людей, которые стали своими за 48 часов.",
              "Задача, которая не решается в одиночку — нужна чья-то помощь.",
              "Физический эксперимент, который взрывается (или не взрывается, но должен был).",
            ].map(item => (
              <li class="flex items-start gap-2.5">
                <i class="bi bi-lightning-charge text-orange-500 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          FOMO — страх пропустить что-то важное в телефоне — исчезает сам собой, когда вокруг 20 человек в таких же условиях. Нечего пропускать: все здесь, всё происходит вживую.
        </p>
      </div>

      <!-- Day 4-5: Экономика -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День 4–5: включается экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На четвёртый день ребёнок впервые сталкивается с настоящим выбором. У него в кармане — дневной бюджет в игровых рублях. Одна минута экранного времени стоит 10 монет. Весь бюджет — примерно час телефона. Но на те же монеты можно купить кое-что другое.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5 max-w-[680px]">
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
            <p class="text-base font-semibold text-slate-400 uppercase tracking-wide mb-2">Потратить на телефон</p>
            <p class="text-[22px] font-bold text-slate-700">60 мин</p>
            <p class="text-base text-slate-500 mt-1">YouTube, ВКонтакте, сторис</p>
          </div>
          <div class="rounded-xl bg-orange-50 border border-orange-100 p-4">
            <p class="text-base font-semibold text-orange-500 uppercase tracking-wide mb-2">Или потратить на</p>
            <ul class="space-y-1">
              {[
                "Костёр с зефирками на всю группу",
                "Фильм вечером",
                "Набор для химических опытов",
                "Отбой на час позже",
              ].map(item => (
                <li class="flex items-center gap-1.5">
                  <i class="bi bi-check2 text-orange-400 text-base" aria-hidden="true"></i>
                  <span class="text-base text-slate-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Но есть нюанс: на костёр одному не хватит. Нужно скинуться группой. И вот тут начинается настоящая жизнь: переговоры, коалиции, торги. Ребёнок, который утром хотел залипнуть в телефоне, к обеду ведёт переговоры с соседями по комнате о совместной покупке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не педагогика. Это реальная экономика в миниатюре — со всеми её законами. Закон убывающей отдачи дети открывают сами: вторая «ночь с телефонами» кажется уже не такой ценной, как первая. И они начинают выбирать другое.
        </p>
      </div>

      <!-- Day 6-7: Хакатон -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День 6–7: хакатон — когда телефон просто не нужен
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Финал каждой смены — хакатон «Стартап из будущего». Команды по 4 человека, 10 часов, задача: придумать продукт, написать код, сделать презентацию и защитить её перед жюри.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В этот день никто не берёт телефон — не потому что нельзя. Просто некогда. Дедлайн через 10 часов, команда ждёт, инвесторы задают неудобные вопросы на промежуточном питче. Мозг занят совсем другим.
        </p>

        <div class="rounded-[14px] border border-slate-200 bg-slate-50 px-5 py-4 max-w-[680px] mb-4">
          <p class="text-base font-semibold text-slate-500 uppercase tracking-wide mb-3">10 часов хакатона: что делает ребёнок</p>
          <div class="grid grid-cols-2 gap-2">
            {[
              ["09:00", "Объявление темы, мозговой штурм"],
              ["10:00", "Паспорт продукта, распределение ролей"],
              ["11:00–15:00", "Пишем код, делаем дизайн"],
              ["15:00", "Промежуточный питч — первые инвестиции"],
              ["15:30–18:00", "Доработка, подготовка финала"],
              ["18:00", "Питч перед всем лагерем и жюри"],
            ].map(([time, event]) => (
              <div class="flex gap-2 items-start">
                <span class="text-[12px] font-mono text-orange-500 shrink-0 mt-0.5">{time}</span>
                <span class="text-base text-slate-700">{event}</span>
              </div>
            ))}
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Дети, которые в понедельник тосковали по TikTok, в субботу стоят перед аудиторией и защищают стартап. Это происходит каждую смену — и каждую смену это удивляет.
        </p>
      </div>

      <!-- После лагеря -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что говорят родители после смены
          </h2>
        </div>

        <div class="space-y-3 mb-5 max-w-[680px]">
          {[
            { icon: "phone", text: "«Приехала домой и сама попросила установить Screen Time. Говорит: хочу контролировать себя, как в лагере».  — мама Полины, 13 лет" },
            { icon: "coin", text: "«Сын впервые предложил вести семейный бюджет. Ему 11. Говорит: хочу понимать, на что тратим».  — папа Миши" },
