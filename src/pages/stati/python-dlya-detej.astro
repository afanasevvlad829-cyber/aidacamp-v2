---
import { Icon } from 'astro-icon/components';
import { PRICE_MIN, VYCHET_MAX, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_FROM_TO } from '../../data/evergreen';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Лагерь Python", url: "/python-lager/", icon: "code-slash", description: "С нуля до проекта за 10 дней" },
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "keyboard", description: "От кода до готового проекта" },
  { title: "AI-лагерь", url: "/ai-lager/", icon: "cpu", description: "AI-проекты для детей" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "С какого возраста можно учить Python ребёнку?",
    answer: "С 10–11 лет, после Scratch — с 9."
  },
  {
    question: "Нужен ли опыт Scratch перед Python?",
    answer: "Не обязателен, но ускоряет старт — закладывает логику циклов."
  },
  {
    question: "Нужен ли хороший компьютер для Python?",
    answer: "Нет, подойдёт любой ноутбук — или браузер на replit.com."
  },
  {
    question: "Сколько времени нужно, чтобы ребёнок написал первую программу?",
    answer: "Что-то рабочее — уже в первый день. Проект — за 10–14 дней."
  },
  {
    question: "Python или JavaScript — что лучше для ребёнка?",
    answer: "Он — лучший старт: проще синтаксис, понятнее ошибки."
  },
  {
    question: "Как мотивировать ребёнка продолжать программировать дома?",
    answer: "Личный проект: бот для друзей, игра по своей теме."
  },
  {
    question: "Как Python связан с искусственным интеллектом?",
    answer: "Главный язык AI — на нём TensorFlow, PyTorch, scikit-learn."
  },
  {
    question: "Зачем Python ребёнку, если есть ChatGPT?",
    answer: "Не конкуренты, а связка — с ним AI работает точнее."
  }
];
---

<Base
  title="Python для детей — с какого возраста и что успевают за две недели"
  description="Программирование на Python для детей: с какого возраста начинать, почему язык подходит новичкам и какой первый проект ребёнок создаст за две недели в лагере."
  ogImage="/images/articles/og-python-dlya-detej.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Python для детей — как и с какого возраста начать | АйДаКемп",
        "description": "Python для детей: с какого возраста, как начать с нуля, онлайн vs лагерь. Что дети создают за 2 недели и почему Python — лучший первый язык.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-24",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/python-dlya-detej"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Программирование на Python для детей: проект с нуля"
    subtitle="Лучший первый язык и что успевают создать ребята."
    imageBase="ii-programmista"
    imageAlt="Ребёнок учит Python — первый язык программирования"
    readTime="6 мин"
    breadcrumbsLast="Python для детей"
    daryaQuote="Дочь написала первого Telegram-бота — на хакатоне. Стоит больше любого репетитора."
  />

  <main id="main-content" class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Python сейчас — не просто язык, а ворота в AI, автоматизацию и данные. Он подходит ребятам: понятный и применим сразу.
        </p>
      </div>

      <!-- Section: Как начать дома -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как начать дома
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для детей — проще на <strong>replit.com</strong>, прямо в браузере.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Книги для занятий дома: «Python для детей» Джейсона Бриггса и «Учим Python, программируя игры» Брайсона Пейна — пошаговые проекты без интернета.
        </p>
      </div>

      <!-- Section: Сравнение языков -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сравнение языков для ребят
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Сравнение вариантов для старта:
        </p>
        <div class="overflow-x-auto rounded-[14px] border border-slate-200 mb-4">
          <table class="w-full text-base">
            <thead>
              <tr class="bg-slate-100 border-b border-slate-200">
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Язык</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Сложность старта</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Что создаём</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Применение в IT</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Возраст</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100 bg-orange-50">
                <td class="px-4 py-3 font-semibold text-orange-700">Python</td>
                <td class="px-4 py-3 text-slate-600">Легко</td>
                <td class="px-4 py-3 text-slate-600">Боты, игры, AI, автоматизация</td>
                <td class="px-4 py-3 text-slate-600">Очень широкое</td>
                <td class="px-4 py-3 text-slate-600">от 9–10 лет</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-semibold text-slate-700">Scratch</td>
                <td class="px-4 py-3 text-slate-600">Очень легко</td>
                <td class="px-4 py-3 text-slate-600">Анимации, простые игры</td>
                <td class="px-4 py-3 text-slate-600">Обучение / старт</td>
                <td class="px-4 py-3 text-slate-600">7–11 лет</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="px-4 py-3 font-semibold text-slate-700">JavaScript</td>
                <td class="px-4 py-3 text-slate-600">Средне</td>
                <td class="px-4 py-3 text-slate-600">Сайты, веб-приложения</td>
                <td class="px-4 py-3 text-slate-600">Фронтенд, бэкенд</td>
                <td class="px-4 py-3 text-slate-600">от 12 лет</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-slate-700">C++</td>
                <td class="px-4 py-3 text-slate-600">Сложно</td>
                <td class="px-4 py-3 text-slate-600">Игры, системный код</td>
                <td class="px-4 py-3 text-slate-600">Геймдев, системы</td>
                <td class="px-4 py-3 text-slate-600">от 14–15 лет</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-base leading-[1.6] text-slate-500">
          <Icon name="bi:info-circle" class="bi bi-info-circle text-slate-400 mr-1" aria-hidden="true" />
          Путь: Scratch → этот язык.
        </p>
      </div>

      <!-- Section 8: FAQ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы о занятиях программированием
          </h2>
        </div>
        <div class="space-y-3">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 9: АйДаКемп -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Python в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Наш трек — для ребят 10–15 лет: пишут ботов, игры на Pygame, скрипты, защищают проект на хакатоне.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Лагерь в Подмосковье, 66 км от МКАД. Смены {SEASON_FROM_TO} {SEASON_YEAR}, от {PRICE_MIN}, вычет до {VYCHET_MAX}.
        </p>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Школьник хочет научиться программировать?"
    bookingSubtitle="Расскажем, что ребята делают и успевают за 2 недели."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
