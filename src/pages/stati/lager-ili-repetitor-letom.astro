---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Полезный отдых для детей", url: "/stati/poleznyj-otdyh-dlya-detej/", icon: "sun", description: "Сравнение форматов" },
  { title: "Лагерь или репетитор", url: "/stati/lager-ili-repetitor-letom/", icon: "question-circle", description: "Что выбрать" },
  { title: "Образовательный лагерь", url: "/obrazovatelnyy-lager/", icon: "book", description: "Польза + отдых" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "Можно ли совмещать лагерь и репетиторов летом?",
    answer: "Да, и это нередко оптимальный вариант. Смена в АйДаКемп — 10 дней. Остальное лето можно использовать для занятий с репетитором по слабым предметам. Главное — не делать всё лето одним сплошным учебным процессом. Мозгу нужна смена форматов."
  },
  {
    question: "Что если ребёнку нужно подготовиться к экзаменам — стоит ли ехать в лагерь?",
    answer: "Зависит от того насколько критична подготовка. Если речь об ОГЭ или ЕГЭ — смену лучше поставить в июнь, до начала активной подготовки. Или в конце августа как «перезагрузку» после интенсивного лета. Ребёнок который вернулся из лагеря мотивированным — учится эффективнее уставшего от репетиторов."
  },
  {
    question: "Правда ли что в IT-лагере дают столько знаний как за несколько месяцев занятий?",
    answer: "Смотря что считать знаниями. За смену в АйДаКемп школьник не выучит Python так же глубоко как за год занятий. Но он получит практический опыт создания настоящего проекта — чего нет ни на каких занятиях с репетитором. Это другой тип обучения: не «знаю теорию», а «сделал сам». И мотивация после этого — тоже другая."
  },
  {
    question: "Сколько стоит час знаний у репетитора vs в лагере?",
    answer: "Если считать честно: репетитор по математике в Москве — 1500–3000 ₽ в час, 1–2 раза в неделю. За лето это 40–80 часов за 60–120 тысяч. IT-лагерь — 10 дней, 4–5 часов занятий в день + вечерняя командная работа. Итого 50–60 часов практики за 48–74 тысячи. Но главное не цена часа — а что остаётся. От репетитора — улучшение оценки. От лагеря — реальный проект и другое отношение к учёбе."
  },
  {
    question: "Помогает ли лагерь когда ребёнок потерял мотивацию к учёбе?",
    answer: "Да, и это один из лучших сценариев для лагеря. Усталость от учёбы — это не лень, это сигнал. Смена среды, новые ребята, задача которую сам выбрал и сам сделал — это перезапуск. Школьники часто возвращаются из лагеря с вопросом «а когда следующий урок по Python?» — хотя до этого не хотели ничего. Репетитор в таком состоянии только усугубит усталость."
  }
];
---

<Base
  title="Лагерь или репетитор летом — что выбрать для ребёнка | АйДаКемп"
  description="Лагерь или репетитор летом: честное сравнение. Что даёт каждый формат, когда что выбирать и почему это не одно и то же."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь или репетитор летом — что выбрать для ребёнка",
        "description": "Лагерь или репетитор летом: честное сравнение. Что даёт каждый формат и когда что выбирать.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/lager-ili-repetitor-letom"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Лагерь или репетитор летом", "item": "https://aidacamp.ru/stati/lager-ili-repetitor-letom/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь vs репетитор летом: где ребёнок получит больше"
    subtitle="Это не вопрос «что лучше» — это вопрос «что нужно именно вашему ребёнку прямо сейчас». Разбираемся."
    imageBase="lager-na-leto-2026"
    imageAlt="Ребёнок работает над проектом в IT-лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Лагерь или репетитор летом"
    daryaQuote="Репетитор даёт знания. Лагерь даёт опыт. Это разные вещи, и одна не заменяет другую."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждое лето родители сталкиваются с этим выбором. С одной стороны — «нельзя терять время, надо подтянуть математику». С другой — «ребёнок весь год работал, ему нужно нормально отдохнуть». Попробуем разобраться без крайностей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что даёт репетитор
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Репетитор — это целенаправленная работа над конкретными пробелами. Математика, русский, подготовка к ОГЭ — если есть чёткая задача «подтянуть предмет», репетитор решает её эффективно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Но у летних занятий с репетитором есть особенность: мотивация падает. Ребёнок всю учебу занимался, теперь снова занимается — только без класса и без оценок. Часто к концу августа это выглядит как принудительный труд.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Репетиторы — отличный инструмент для закрытия конкретных пробелов. Но они не дают нового опыта, не создают мотивацию к учёбе в целом, не формируют команду.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что даёт лагерь
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь — это прежде всего опыт. Не «узнал как работает функция в Python», а «сделал игру с командой и защитил её перед всем лагерем». Это другой уровень.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          За 10 дней в IT-лагере ребёнок получает:
        </p>
        <ul class="list-none space-y-2 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Практический опыт создания продукта — игры, бота, сайта</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Опыт работы в команде и публичной защиты результата</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Окружение сверстников с похожими интересами</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Мотивацию — ребёнок возвращается с желанием продолжать, а не с усталостью</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это то, что репетитор не даст — не потому что плохой, а потому что формат другой.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Они решают разные задачи
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Репетитор — это про «закрыть пробел в знаниях». Лагерь — это про «получить опыт и мотивацию». Это не конкуренты, это разные инструменты.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Спросите себя: что сейчас нужнее вашему ребёнку? Если он устал и потерял интерес к учёбе — репетитор летом, скорее всего, ещё больше снизит мотивацию. Если он энергичен, интересуется технологиями и хочет пробовать новое — лагерь даст ему буст на следующий учебный год.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Идеальный вариант для многих: короткая смена в <a href="/lager-dlya-shkolnikov-na-leto/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагере для школьников</a> в начале лета + несколько месяцев занятий с репетитором. Лагерь заряжает, репетитор структурирует.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Про объём знаний: честно
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Иногда говорят: «за 10 дней в IT-лагере ребёнок получит столько знаний как за 3–4 месяца занятий». Это не совсем точно. За 10 дней ребёнок получает другой тип знаний — прикладной, через действие. Глубину теории репетитор за 3 месяца даёт больше.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Но ребёнок который сам написал игру — понимает зачем учить переменные и циклы. Ребёнок после 3 месяцев занятий с репетитором — не всегда. Мотивация через смысл работает лучше мотивации через оценку.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сравнение по ключевым параметрам
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-base border-collapse">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tl-xl">Параметр</th>
                <th class="text-left p-3 font-semibold text-slate-700">Репетитор</th>
                <th class="text-left p-3 font-semibold text-orange-600 rounded-tr-xl">IT-лагерь</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="p-3 text-slate-600 font-medium">Тип знаний</td>
                <td class="p-3 text-slate-600">Теория, закрытие пробелов</td>
                <td class="p-3 text-slate-700">Практика, проект, командная работа</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="p-3 text-slate-600 font-medium">Мотивация</td>
                <td class="p-3 text-slate-600">Зависит от ребёнка, часто падает летом</td>
                <td class="p-3 text-slate-700">Создаётся средой — нельзя не участвовать</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="p-3 text-slate-600 font-medium">Социализация</td>
                <td class="p-3 text-slate-600">Нет</td>
                <td class="p-3 text-slate-700">Команда, новые друзья</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="p-3 text-slate-600 font-medium">Результат</td>
                <td class="p-3 text-slate-600">Улучшение по предмету</td>
                <td class="p-3 text-slate-700">Готовый проект + опыт защиты</td>
              </tr>
              <tr>
                <td class="p-3 text-slate-600 font-medium rounded-bl-xl">Лучше когда</td>
                <td class="p-3 text-slate-600">Нужно закрыть конкретный пробел</td>
                <td class="p-3 text-slate-700 rounded-br-xl">Нужна мотивация и опыт</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <!-- CTA к коммерческой странице -->
  <div class="max-w-2xl mx-auto px-4 mt-6 mb-2">
    <div class="rounded-[14px] bg-orange-50 border border-orange-200 p-4">
      <p class="text-base text-slate-700">Хотите узнать подробнее? → <a href="/obrazovatelnyy-lager/" class="font-semibold text-primary hover:underline">Образовательный лагерь АйДаКемп</a></p>
    </div>
  </div>

  <ArticleBottomCta
    bookingTitle="Дайте ребёнку опыт, который не даст ни один репетитор"
    bookingSubtitle={`АйДаКемп — IT-лагерь в Подмосковье. Смены с 30 мая по 26 августа ${SEASON_YEAR}.`}
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
