---
import { PRICE_MAX, PRICE_MIN } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Лагерь для жителей Новой Москвы", url: "/lager-novaya-moskva/", icon: "geo-alt-fill", description: "Цены, смены, форма записи" },
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove/", icon: "tree", description: "66 км, Киевское шоссе" },
  { title: "Лагерь из Москвы", url: "/lager-v-moskve/", icon: "geo-alt", description: "1 час от МКАД" },
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove/", icon: "houses", description: "Полный пансион" },
  { title: "Цены 2026", url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];
---

<Base
  title="Как добраться из Новой Москвы до лагеря АйДаКемп — маршрут 2026"
  description={`Маршрут из Новой Москвы до IT-лагеря АйДаКемп: 40-60 км по Киевскому шоссе (М-3), трансфер от метро Солнцево. Python, AI, Minecraft. Смены 2026 от ${PRICE_MIN}.`}
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Как добраться из Новой Москвы до лагеря АйДаКемп — маршрут 2026",
      "description": `Маршрут из Новой Москвы до IT-лагеря АйДаКемп: 40-60 км по Киевскому шоссе (М-3), трансфер от метро Солнцево. Python, AI, Minecraft. Смены 2026 от ${PRICE_MIN}.`,
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/lager-novaya-moskva"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли детский лагерь рядом с Новой Москвой?",
          "acceptedAnswer": {"@type": "Answer", "text": "Да. АйДаКемп находится в 40–60 км (35–50 минут) от Троицка, Коммунарки и Внуково — по Киевскому шоссе (М-3). Добраться можно без выезда на МКАД."}
        },
        {
          "@type": "Question",
          "name": "Как далеко лагерь от Новой Москвы?",
          "acceptedAnswer": {"@type": "Answer", "text": "Из Троицка — около 40 минут, из Внуково — 35 минут, из Коммунарки — 45 минут по Калужскому шоссе с выездом на Киевское (М-3)."}
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Новой Москвы?",
          "acceptedAnswer": {"@type": "Answer", "text": "Организуем трансфер от метро Солнцево (ТиНАО/ЮЗАО) в день заезда. Подробности уточняйте при бронировании."}
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для детей рядом с Новой Москвой?",
          "acceptedAnswer": {"@type": "Answer", "text": `От ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Доступна рассрочка и налоговый вычет.`}
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Детский лагерь в Новой Москве и рядом 2026", "item": "https://aidacamp.ru/stati/lager-novaya-moskva/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как добраться из Новой Москвы до лагеря АйДаКемп"
    subtitle="Маршрут: Калужское шоссе (А-101) → Киевское шоссе (М-3), 40–60 км от Коммунарки. Python, AI, Minecraft, бассейн. Трансфер через партнёра по запросу от метро Солнцево."
    imageBase="kuda-letom"
    imageAlt="Дети на IT-смене — лагерь рядом с Новой Москвой"
    readTime="4 мин чтения"
    breadcrumbsLast="Маршрут из Новой Москвы"
    daryaQuote="Мы живём в Коммунарке — это уже Новая Москва, у нас Калужское шоссе. До лагеря едем с выездом на Киевское — тот же юго-запад, только чуть дальше. Очень удобно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Для семей из Новой Москвы — Коммунарки, Щербинки, Троицка, Московского — АйДаКемп оказывается одним из самых близких вариантов. Новая Москва растёт вдоль Калужского шоссе (А-101), а сам лагерь стоит на соседнем Киевском шоссе (М-3) — трассы сходятся рядом, без выезда в центр.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Маршрут: от Калужского шоссе к Киевскому</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Новая Москва расширялась вдоль Калужского шоссе (А-101) — Троицк, Коммунарка, Ватутинки стоят именно на нём. АйДаКемп — соседняя трасса, Киевское шоссе (М-3): от А-101 до лагеря — короткий переезд без выезда на МКАД. От Коммунарки до лагеря — около 45–55 км, от Троицка — 40–50 км. Это не «за Москвой», а продолжение того же юго-западного направления.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь расположен на базе санатория «Изумруд» в Наро-Фоминском городском округе — лес, чистый воздух, полноценная инфраструктура.
        </p>
        <StatCallout
          value="40-60 км"
          label="от Новой Москвы до АйДаКемп: Калужское шоссе (А-101) с выездом на Киевское (М-3). Трансфер через партнёра по запросу от метро Солнцево."
          source="Маршрут А-101 → М-3"
          icon="geo-alt"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Трансфер и как добраться</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Трансфер через партнёра по запросу:</strong> от метро «Солнцево» (Калининско-Солнцевская линия). Для жителей Новой Москвы — это рядом: автобус или несколько остановок на метро. Организуется при бронировании, стоимость уточняйте у менеджера.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>На машине:</strong> из Коммунарки или Троицка — по Калужскому шоссе (А-101) с выездом на Киевское (М-3) в направлении Наро-Фоминска. Никаких заездов в центр, никаких пробок. Время в пути — 40–55 минут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Точные координаты лагеря и время отправления трансфера уточняются при бронировании.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">IT-программа и что дети делают</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый выбирает трек по возрасту и интересам:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-braces text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Python</strong> — для детей 10–15 лет. Первые программы, логика, работающий проект</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-cpu text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>AI и нейросети</strong> — для 11–15 лет. Как устроен искусственный интеллект, практические задачи</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-globe text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Scratch и Roblox</strong> — для детей 7–10 лет. Визуальное программирование и первые игры</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-lightning-charge text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Minecraft с кодингом</strong> — для всех возрастов. Любимая вселенная плюс азы программирования</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Группы до 8 человек. В конце смены — финальный хакатон: каждый представляет собственный проект команде.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Территория: бассейн, лес, спорт</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Санаторий «Изумруд» — это комфортные корпуса в лесу, бассейн, спортивные площадки, 5-разовое питание. Медпункт работает круглосуточно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После IT-занятий дети идут купаться, играют в спортивные игры, вечером — командные активности. Именно потому что жизнь в лагере насыщенная, дети не сидят в телефоне — просто нет повода.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Смены 2026</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Открыты августовские смены. Стоимость от {PRICE_MIN} за 10 дней до {PRICE_MAX} за 13 дней — питание, проживание, IT-программа, всё включено. Трансфер — через партнёра по запросу. Никаких доплат на месте.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Группы небольшие, мест немного. Родители из Новой Москвы бронируют заранее — к маю свободных мест обычно почти не остаётся.
        </p>
        <StatCallout
          value={`от ${PRICE_MIN}`}
          label="за смену — питание, проживание, IT-программа всё включено. Трансфер — через партнёра по запросу."
          source="Прайс АйДаКемп 2026"
          icon="check-circle"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Почему это лучший вариант для семей из Новой Москвы</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главный плюс — не нужно ехать через центр Москвы. Калужское шоссе выводит прямо на Киевское — короткий переезд без петель по МКАД: утром отвезли на трансфер, вечером — тишина на две недели. Или сами привезли на машине за 40–55 минут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный лагерь с лицензией РТО, медик 24/7, реальные проекты на хакатоне. Дети уезжают с чем-то, что сделали сами — это не просто «отдохнуть».
        </p>
        <StatCallout
          value="5.0"
          label="— рейтинг АйДаКемп на Яндекс.Картах. 40+ отзывов от родителей"
          source="Яндекс.Карты, 2026"
          icon="stars"
          tone="neutral"
        />
      </div>


      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Время в пути из основных точек Новой Москвы</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Калужское шоссе (А-101) с выездом на Киевское (М-3) — один маршрут, без МКАД и МЦК:
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-base border-collapse">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tl-xl">Откуда</th>
                <th class="text-left p-3 font-semibold text-slate-700">Расстояние</th>
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tr-xl">Время на машине</th>
              </tr>
            </thead>
            <tbody>
              {[
                ["Коммунарка", "~50 км", "~45 мин"],
                ["Московский (Внуково)", "~45 км", "~40 мин"],
                ["Троицк", "~45 км", "~40 мин"],
                ["Щербинка", "~50 км", "~45 мин"],
                ["Метро Солнцево (трансфер)", "~55 км", "~50 мин"],
              ].map(([from, dist, time]) => (
                <tr class="border-b border-slate-100">
                  <td class="p-3 text-slate-800 font-medium">{from}</td>
                  <td class="p-3 text-slate-600">{dist}</td>
                  <td class="p-3 text-orange-600 font-semibold">{time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-base text-slate-500 italic">Время приблизительное, без учёта пробок в утренние часы. Лучше выезжать в 10–11 утра в день заезда.</p>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Забронировать смену — для семей из Новой Москвы"
    bookingSubtitle="Трансфер через партнёра по запросу от метро Солнцево. Смены с мая по август 2026."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
