---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "check-circle", description: "7 критериев от мамы к маме" },
  { title: "Отзывы родителей", url: "/otzyvy", icon: "chat", description: "40+ отзывов на Яндекс.Картах" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Кто мы и как устроен день" },
];
---

<Base
  title="Детский лагерь в Новой Москве и рядом 2026 — IT-смены"
  description="Детский IT-лагерь рядом с Новой Москвой: 40-70 км, трансфер от метро Тёплый Стан. Python, AI, Minecraft. Смены 2026 от 48 000 ₽."
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-novaya-moskva" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Детский IT-лагерь рядом с Новой Москвой — смены 2026",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/lager-novaya-moskva"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детский IT-лагерь рядом с Новой Москвой — смены 2026"
    subtitle="АйДаКемп — по трассе А-101, 35–50 км от Коммунарки. Python, AI, Minecraft, бассейн. Трансфер от метро Тёплый Стан."
    imageBase="kuda-letom"
    imageAlt="Дети на IT-смене — лагерь рядом с Новой Москвой"
    date="2026-04-24"
    readTime="4 мин чтения"
    breadcrumbsLast="Лагерь рядом с Новой Москвой"
    daryaQuote="Мы живём в Коммунарке — это уже Новая Москва. Лагерь нашли по трассе А-101. Оказалось это ровно наш маршрут, только чуть дальше. Очень удобно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Для семей из Новой Москвы — Коммунарки, Щербинки, Троицка, Московского — АйДаКемп оказывается одним из самых близких вариантов. Лагерь стоит прямо по трассе А-101, по которой Новая Москва и расширялась на юго-запад. Никаких пробок через центр, никаких сложных маршрутов.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">АйДаКемп — по трассе А-101 из Новой Москвы</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Новая Москва расширялась именно вдоль Калужского шоссе (А-101) — и АйДаКемп находится по той же трассе, чуть дальше за административной границей. От Коммунарки до лагеря — около 35–50 км, от Троицка — примерно столько же. Это не «за Москвой», а просто продолжение вашего направления.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь расположен на базе санатория «Изумруд» в Наро-Фоминском городском округе — лес, чистый воздух, полноценная инфраструктура.
        </p>
        <StatCallout
          value="~35-50 км"
          label="от южной части Новой Москвы до АйДаКемп по трассе А-101. Наш трансфер отправляется от метро Тёплый Стан."
          source="Маршрут А-101"
          icon="geo-alt"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Трансфер и как добраться</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Трансфер от метро:</strong> в день заезда автобус отправляется от станции «Тёплый Стан» — это последняя станция Калининско-Солнцевской линии. Для жителей Новой Москвы метро «Тёплый Стан» близко: автобус, маршрутка или несколько остановок на метро. Трансфер включён в стоимость смены.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>На машине:</strong> если вы живёте вблизи А-101 — это самый удобный вариант. Выезжаете из Коммунарки или Троицка на Калужское шоссе и едете в направлении Наро-Фоминска. Никаких заездов в Москву, никаких пробок. Время в пути — 30–50 минут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Точные координаты лагеря и время отправления трансфера уточняются при бронировании.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">IT-программа и что дети делают</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый ребёнок выбирает трек по возрасту и интересам:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-braces text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Python</strong> — для детей 10–15 лет. Первые программы, логика, работающий проект</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-cpu text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>AI и нейросети</strong> — для 11–15 лет. Как устроен искусственный интеллект, практические задачи</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-globe text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Scratch и Roblox</strong> — для детей 7–10 лет. Визуальное программирование и первые игры</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-lightning-charge text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Minecraft с кодингом</strong> — для всех возрастов. Любимая вселенная плюс азы программирования</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Группы до 8 человек. В конце смены — финальный хакатон: каждый ребёнок представляет собственный проект команде.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Территория: бассейн, лес, спорт</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Санаторий «Изумруд» — это комфортные корпуса в лесу, бассейн, спортивные площадки, 5-разовое питание. Медпункт работает круглосуточно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После IT-занятий дети идут купаться, играют в спортивные игры, вечером — командные активности. Именно потому что жизнь в лагере насыщенная, дети не сидят в телефоне — просто нет повода.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Смены 2026</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смены с конца мая по август. Стоимость от 48 000 ₽ за две недели — питание, проживание, IT-программа, трансфер, страховка, всё включено. Никаких доплат на месте.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Группы небольшие, мест немного. Родители из Новой Москвы бронируют заранее — к маю свободных мест обычно почти не остаётся.
        </p>
        <StatCallout
          value="от 48 000 ₽"
          label="за 2-недельную смену — питание, проживание, IT-программа, трансфер, страховка всё включено."
          source="Прайс АйДаКемп 2026"
          icon="check-circle"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Почему это лучший вариант для семей из Новой Москвы</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главный плюс — не нужно ехать через Москву. Трасса А-101 идёт прямо из Новой Москвы в нужном направлении: утром отвезли на трансфер, вечером — тишина на две недели. Или сами привезли на машине за полчаса-час.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный лагерь с лицензией РТО, медик 24/7, реальные проекты на хакатоне. Дети уезжают с чем-то, что сделали сами — это не просто «отдохнуть».
        </p>
        <StatCallout
          value="5.0"
          label="— рейтинг АйДаКемп на Яндекс.Картах. 40+ отзывов от родителей"
          source="Яндекс.Карты, 2026"
          icon="stars"
          tone="neutral"
        />
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Забронировать смену — для семей из Новой Москвы"
    bookingSubtitle="Трансфер от метро Тёплый Стан включён. Смены с мая по август 2026."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
