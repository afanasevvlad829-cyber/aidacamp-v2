---
import { PRICE_MIN, PRICE_MAX, VYCHET_MAX, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены и цены ${SEASON_YEAR}`, url: "/ceny/", icon: "calendar-event", description: "Все смены, даты и стоимость" },
  { title: "Список вещей в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "bag-check", description: "Полный список одежды, документов и гаджетов" },
  { title: "Обычная смена глазами ребят", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "house-heart", description: "Как проходит смена — глазами ребят" },
  { title: "Об АйДаКемп", url: "/o-lagere/", icon: "info-circle", description: "Территория, команда и философия АйДаКемп" },
];

const schedule = [
  { time: '8:00',  icon: 'sunrise',        phase: 'Утро',    title: 'Подъём и завтрак',
    desc: 'Зарядка по желанию. Завтрак — каша, яйцо, чай или какао.' },
  { time: '9:30',  icon: 'laptop',         phase: 'День',    title: 'Первый IT-блок',
    desc: 'Программирование с преподавателем, группы до 8 человек.' },
  { time: '12:00', icon: 'water',          phase: 'День',    title: 'Бассейн или спорт',
    desc: 'Закрытый бассейн, футбол, волейбол — каждый раз новое.' },
  { time: '13:30', icon: 'cup-hot-fill',   phase: 'День',    title: 'Обед',
    desc: 'Суп, второе, компот. Меню — с учётом аллергий.' },
  { time: '14:00', icon: 'moon',           phase: 'День',    title: 'Тихий час',
    desc: 'Спать не обязательно: можно читать или просто лежать. Главное — час без беготни.' },
  { time: '15:00', icon: 'cpu-fill',       phase: 'День',    title: 'Второй IT-блок',
    desc: 'Продолжение проекта — к хакатону готовят игру, бота или приложение.' },
  { time: '18:00', icon: 'controller',     phase: 'Вечер',   title: 'Свободное время',
    desc: 'Настолки, игры, прогулки — каждый выбирает сам.' },
  { time: '19:00', icon: 'cup-hot-fill',   phase: 'Вечер',   title: 'Ужин',
    desc: 'Горячий ужин. Заодно время позвонить родителям.' },
  { time: '20:30', icon: 'people-fill',    phase: 'Вечер',   title: 'Вечерняя активность',
    desc: 'Квест, конкурс, кино или командная игра — каждый вечер своя.' },
  { time: '22:00', icon: 'moon-stars',     phase: 'Ночь',    title: 'Отбой',
    desc: 'Вожатые дежурят всю ночь. Младшим (7–9 лет) — на полчаса раньше.' },
];

const faqItems = [
  {
    q: 'В 8 утра вы правда поднимаете детей?',
    a: 'Да. Первые сутки самые сложные, а через 2–3 дня ребята сами просыпаются раньше будильника.'
  },
  {
    q: 'Сколько времени дети проводят за компьютером?',
    a: 'Около 4–5 часов в два блока — этого хватает для прогресса и не перегружает.'
  },
  {
    q: 'Когда можно позвонить ребёнку?',
    a: 'Лучше всего в 19:00–20:00, между ужином и свободным временем.'
  },
  {
    q: 'Есть ли тихий час?',
    a: 'Есть — с 14:00 до 15:00, сразу после обеда. Спать не обязательно: можно читать, лежать с наушниками или просто поболтать в комнате, но час проходит без беготни. Свободное время — отдельно, с 18:00.'
  },
  {
    q: 'Сколько дней нужно, чтобы привыкнуть?',
    a: 'Обычно 2–3 суток. К третьему дню большинство уже освоились и ждут занятий.'
  },
  {
    q: 'Бывает ли скучно вечером?',
    a: 'Редко — каждый вечер новая активность. Но полежать с книгой тоже можно.'
  },
  {
    q: 'Как быть, если пойдёт дождь?',
    a: 'Уличные форматы меняются на форматы в помещении: теннис, квиз, кино. Программа не меняется.'
  },
];

const phaseColors = {
  'Утро': '#FF9800', 'День': '#4361EE', 'Вечер': '#9C27B0', 'Ночь': '#1a1a2e'
} as Record<string, string>;

// Pre-compute schedule with phase change markers
const scheduleWithPhases = schedule.map((item, i) => ({
  ...item,
  phaseChanged: i === 0 || item.phase !== schedule[i - 1].phase,
  color: phaseColors[item.phase] ?? '#4361EE',
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Расписание дня в АйДаКемп: от подъёма до отбоя",
    "description": "Расписание по часам в АйДаКемп — подъём, занятия, бассейн, свободное время и отбой.",
    "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
    "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru"},
    "datePublished": "2026-06-17",
    "dateModified": "2026-08-02",
    "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/raspisanie-v-lagere/"}
  }];
---

<Base
  title="Расписание и режим дня в лагере АйДаКемп"
  description="Распорядок дня в АйДаКемп: подъём 8:00, IT-занятия, бассейн, вечерняя активность, отбой 22:00. Расписание смен, Подмосковье."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main>
    <ArticleHero
      title="Расписание и подъём по часам"
      subtitle="Расписание от подъёма до отбоя на протяжении лета — по часам, честно"
      breadcrumbs={[
        { label: "АйДаКемп", href: "/" },
        { label: "Статьи", href: "/stati/" },
        { label: "Расписание" },
      ]}
      breadcrumbsLast="Расписание"
    />

    <article class="mx-auto max-w-[780px] px-4 pb-16">

      <p class="lead">
        Каждый год спрашивают: «Встаёте правда в 8?» и «Когда звонить?»
        Отвечаем честно: вот как ребята проводят время у нас — от подъёма до отбоя.
      </p>

      <StatCallout tone="info">
        К третьему дню большинство ребят просыпаются сами — организм быстро привыкает к новому ритму.
      </StatCallout>

      <!-- Schedule timeline -->
      <h2>По часам: от подъёма до отбоя</h2>

      <div class="schedule-timeline">
        {scheduleWithPhases.map(item => (
          <div class="schedule-block">
            {item.phaseChanged && (
              <div class="phase-label" style={`color: ${item.color}`}>
                {item.phase}
              </div>
            )}
            <div class="schedule-item">
              <div class="schedule-time">{item.time}</div>
              <div class="schedule-dot" style={`background: ${item.color}`}></div>
              <div class="schedule-content">
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p>
        Блоки чередуются с бассейном и спортом — так легче держать концентрацию, чем шесть часов подряд.
      </p>

      <h2>Расписание по возрастам</h2>

      <p>Внутри отряда — свой вожатый и IT-группа до 8 человек.</p>

      <div class="age-grid">
        <div class="age-card">
          <div class="age-badge">7–9 лет</div>
          <p>Отбой на полчаса раньше, программа проще: Scratch и Minecraft, вожатый рядом почти всегда.</p>
        </div>
        <div class="age-card">
          <div class="age-badge">10–12 лет</div>
          <p>Python и pygame, первые алгоритмы. Быстро включаются в общий ритм.</p>
        </div>
        <div class="age-card">
          <div class="age-badge">13–15 лет</div>
          <p>AI-модули, Telegram-боты, работа с API — сложнее, но интереснее.</p>
        </div>
      </div>

      <h2>Вечерние активности</h2>

      <p>Формат каждый вечер новый. Примеры, которые повторяются из года в год:</p>

      <ul>
        <li><strong>Квесты по территории</strong> — командные, с загадками</li>
        <li><strong>«Что? Где? Когда?»</strong> — команда ребят против команды взрослых</li>
        <li><strong>Кино под открытым небом</strong> — или в холле, если дождь</li>
        <li><strong>Творческий вечер</strong> — рисуем, поём, играем</li>
        <li><strong>Хакатон-презентации</strong> — в последние дни смены</li>
      </ul>

      <h2>Первый день</h2>

      <p>
        Заезд — с 10:00 до 13:00, вечером игра-знакомство: к ужину ребята уже знают соседей по именам.
      </p>

      <ArticleBottomCta
        heading="Хотите узнать расписание конкретной смены?"
        bookingSubtitle="Напишите — расскажем про даты и программу ближайших смен."
      />

    </article>

    <section class="mx-auto max-w-[780px] px-4 pb-12">
      <h2 class="text-[22px] font-bold mb-6">Частые вопросы</h2>
      {faqItems.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-q">{item.q}</summary>
          <div class="faq-a">{item.a}</div>
        </details>
      ))}
    </section>

    <RelatedPages title="Полезные страницы" pages={relatedPages} />
  </main>

  <RelatedArticlesAuto />
  <Footer />
  <FAQSchema items={faqItems} />
</Base>

<style>
  .lead {
    font-size: 1.1rem;
    color: #444;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* Schedule timeline */
  .schedule-timeline {
    margin: 32px 0 40px;
    position: relative;
  }
  .phase-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
    margin-top: 24px;
  }
  .phase-label:first-child { margin-top: 0; }
  .schedule-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .schedule-time {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    min-width: 52px;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .schedule-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .schedule-content strong {
    font-size: 1rem;
    color: #1a1a2e;
    display: block;
    margin-bottom: 4px;
  }
  .schedule-content p {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.55;
  }

  /* Age grid */
  .age-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 24px 0 32px;
  }
  .age-card {
    border: 1px solid #e8eaf0;
    border-radius: 12px;
    padding: 16px;
    background: #f8f9ff;
  }
  .age-badge {
    display: inline-block;
    background: #4361EE;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 20px;
    padding: 2px 12px;
    margin-bottom: 10px;
  }
  .age-card p { font-size: 0.88rem; color: #444; line-height: 1.55; margin: 0; }

  /* FAQ */
  .faq-item { border-bottom: 1px solid #e8eaf0; }
  .faq-q {
    cursor: pointer;
    font-weight: 600;
    padding: 14px 0;
    color: #1a1a2e;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.98rem;
  }
  .faq-q::after { content: '+'; font-size: 1.4rem; color: #4361EE; }
  details[open] .faq-q::after { content: '−'; }
  .faq-a {
    font-size: 0.92rem;
    color: #555;
    line-height: 1.65;
    padding-bottom: 14px;
  }

  /* Article content */
  article h2 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 36px 0 16px; }
  article p { font-size: 0.97rem; color: #444; line-height: 1.7; margin-bottom: 16px; }
  article ul { padding-left: 20px; margin-bottom: 20px; }
  article li { font-size: 0.95rem; color: #444; line-height: 1.65; margin-bottom: 6px; }
</style>
