---
import { PRICE_MIN, PRICE_MAX, VYCHET_MAX, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены и цены ${SEASON_YEAR}`, url: "/ceny/", icon: "calendar-event", description: "Расписание всех смен, стоимость, что входит" },
  { title: "Список вещей в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "bag-check", description: "Полный список одежды, документов и гаджетов" },
  { title: "Обычная смена глазами ребят", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "house-heart", description: "Как проходит каждый день — глазами ребят" },
  { title: "Об АйДаКемп", url: "/o-lagere/", icon: "info-circle", description: "Территория, команда и философия АйДаКемп" },
];

const schedule = [
  { time: '8:00',  icon: 'sunrise',        phase: 'Утро',    title: 'Подъём и завтрак',
    desc: 'Зарядка не обязательна, но большинство идёт. Завтрак: горячая каша, яйцо, чай или какао.' },
  { time: '9:30',  icon: 'laptop',         phase: 'День',    title: 'Первый IT-блок',
    desc: 'Программирование с преподавателем. Группы до 8 человек — всегда есть время задать вопрос.' },
  { time: '12:00', icon: 'water',          phase: 'День',    title: 'Бассейн или спорт на свежем воздухе',
    desc: 'Закрытый бассейн, футбол, волейбол — каждый раз новая активность.' },
  { time: '13:30', icon: 'cup-hot-fill',   phase: 'День',    title: 'Обед',
    desc: 'Горячий обед: суп, второе, компот. Меню на неделю с учётом аллергий.' },
  { time: '15:00', icon: 'cpu-fill',       phase: 'День',    title: 'Второй IT-блок',
    desc: 'Продолжение проекта. К концу смены — игра, бот или приложение перед хакатоном.' },
  { time: '18:00', icon: 'controller',     phase: 'Вечер',   title: 'Свободное время',
    desc: 'Настолки, подвижные игры, прогулки. Ребята сами выбирают, чем заняться.' },
  { time: '19:00', icon: 'cup-hot-fill',   phase: 'Вечер',   title: 'Ужин',
    desc: 'Горячий ужин. Обычно в это время звонят родителям — есть время для связи.' },
  { time: '20:30', icon: 'people-fill',    phase: 'Вечер',   title: 'Вечерняя активность',
    desc: 'Квест, творческий конкурс, кино, командная игра — каждый вечер своя.' },
  { time: '22:00', icon: 'moon-stars',     phase: 'Ночь',    title: 'Отбой',
    desc: 'В корпусах тишина, вожатые на дежурстве всю ночь. Для младших (7–9 лет) — на полчаса раньше.' },
];

const faqItems = [
  {
    q: 'В 8 утра вы правда поднимаете детей?',
    a: 'Да. Первые сутки — самое сложное, а через 2–3 дня подъем уже не проблема: ребята просыпаются раньше будильника сами.'
  },
  {
    q: 'Сколько времени дети проводят за компьютером?',
    a: 'Около 4–5 часов в день в два блока. Это оптимум: достаточно для реального прогресса, не перегружает. Остальное время — активность, еда, общение.'
  },
  {
    q: 'Когда можно позвонить ребёнку?',
    a: 'Лучше всего в 19:00–20:00, когда ужин и свободное время. Утром и в блоки программирования ребята заняты.'
  },
  {
    q: 'Есть ли тихий час?',
    a: 'Нет. Для подростков обязательный тихий час — это стресс, а не отдых. Вместо него — свободное время с 18:00, и каждый выбирает сам, чем заняться.'
  },
  {
    q: 'Как долго ребёнок привыкает к новому расписанию?',
    a: 'В среднем 2–3 суток. Первое утро может быть сложным, а к третьему дню большинство ребят уже освоились: встают сами, знают свой отряд по именам и ждут начала занятий.'
  },
  {
    q: 'Бывает ли скучно вечером?',
    a: 'Обычно нет — вожатые планируют разные активности на каждый вечер. Но если ребёнок хочет просто лежать и читать — это тоже нормально.'
  },
  {
    q: 'Как распределяют по отрядам?',
    a: 'По возрасту: 7–9, 10–12 и 13–15 лет. Внутри отряда — свой вожатый и IT-группа до 8 человек.'
  },
  {
    q: 'Как быть, если пойдёт дождь?',
    a: 'Уличные активности заменяют на форматы в помещении: настольный теннис, квиз, кино. Смена идёт по тому же расписанию — меняется только место проведения.'
  },
];

const phaseColors = {
  'Утро': '#FF9800', 'День': '#4361EE', 'Вечер': '#9C27B0', 'Ночь': '#1a1a2e'
} as Record<string, string>;

// Pre-compute schedule with phase change markers
const scheduleWithPhases = schedule.map((item, i) => ({
  ...item,
  phaseChanged: i === 0 || item.phase !== schedule[i - 1].phase,
  color: phaseColors[item.phase] ?? '#4361EE',
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Режим дня в детском лагере: расписание от подъёма до отбоя",
    "description": "Подробное расписание дня в детском лагере — по часам: подъём, занятия, бассейн, свободное время и отбой. Реальное расписание АйДаКемп.",
    "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
    "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru"},
    "datePublished": "2026-06-17",
    "dateModified": "2026-06-17",
    "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/raspisanie-v-lagere/"}
  }];
---

<Base
  title="Расписание, режим дня, подъём в летнем детском лагере | АйДаКемп"
  description="Распорядок дня в детском летнем лагере: подъём 8:00, IT-занятия, бассейн, вечерняя активность, отбой 22:00. Реальное расписание лета в АйДаКемп, Подмосковье."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main>
    <ArticleHero
      title="Подъём и режим дня лагеря по часам"
      subtitle="Расписание от подъёма до отбоя на протяжении лета — по часам, честно"
      breadcrumbs={[
        { label: "АйДаКемп", href: "/" },
        { label: "Статьи", href: "/stati/" },
        { label: "Расписание" },
      ]}
      breadcrumbsLast="Расписание"
    />

    <article class="mx-auto max-w-[780px] px-4 pb-16">

      <p class="lead">
        Каждый год спрашивают: «А вы правда в 8 поднимаете?» и «Когда можно позвонить?»
        Отвечаем честно, без купюр: дальше — по часам, чем ребята заняты в лагере с подъёма до отбоя.
      </p>

      <StatCallout tone="info">
        К третьему дню большинство ребят встают сами — за 5–10 минут до будильника. Организм перестраивает внутренние часы быстро.
      </StatCallout>

      <!-- Schedule timeline -->
      <h2>Расписание лагеря — по часам</h2>

      <p>Летнее расписание лагеря АйДаКемп — от подъёма до отбоя.</p>

      <div class="schedule-timeline">
        {scheduleWithPhases.map(item => (
          <div class="schedule-block">
            {item.phaseChanged && (
              <div class="phase-label" style={`color: ${item.color}`}>
                {item.phase}
              </div>
            )}
            <div class="schedule-item">
              <div class="schedule-time">{item.time}</div>
              <div class="schedule-dot" style={`background: ${item.color}`}></div>
              <div class="schedule-content">
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h2>Почему именно такое расписание?</h2>

      <p>
        Это не случайность: два IT-блока разнесены бассейном и спортом, чтобы мозг ребёнка не
        перегревался — концентрация выше, чем при 6 часах подряд. Физическая активность буквально
        «перезагружает» голову: во втором блоке ребята работают лучше, это физиология, не педагогика.
        Формула сложилась по обратной связи от вожатых и самих ребят — короче блоки, больше
        восстановления между ними.
      </p>

      <h2>Расписание по возрастам</h2>

      <div class="age-grid">
        <div class="age-card">
          <div class="age-badge">7–9 лет</div>
          <p>Отбой на полчаса раньше — этому возрасту физиологически нужно больше сна. Программа: Scratch и Minecraft, меньше текста, больше игровых механик, вожатый рядом почти постоянно.</p>
        </div>
        <div class="age-card">
          <div class="age-badge">10–12 лет</div>
          <p>Python, pygame, первые алгоритмы. Быстро включаются в общий ритм и реже скучают по дому — самый лёгкий на подъем возраст в отряде.</p>
        </div>
        <div class="age-card">
          <div class="age-badge">13–15 лет</div>
          <p>Программа сложнее: AI-модули, Telegram-боты, работа с API. Старшие сами задерживаются на занятиях — вожатым приходится говорить «стоп». Чаще всего доводят проект до результата, который правда работает.</p>
        </div>
      </div>

      <h2>Вожатые и отряды — как устроено внутри</h2>

      <p>
        Ребят делят на отряды по возрасту: 7–9, 10–12 и 13–15 лет. Внутри — своя IT-группа до 8 человек,
        свой вожатый и общий чат с родителями смены: если кто-то заскучал, вожатый видит это первым.
        Вожатые не только присматривают — ведут вечерние активности, следят за безопасностью (бассейн
        только под наблюдением, ночное дежурство без перерывов) и держат ровный настрой без любимчиков.
      </p>

      <h2>Чем занимаются в «свободное время»?</h2>

      <p>
        С 18:00 — зона свободного времени без обязательных активностей: кто-то в настолки, кто-то
        с книгой, кто-то гоняет мяч. А несколько ребят каждую смену добровольно возвращаются
        к ноутбуку — доделать проект.
      </p>

      <StatCallout tone="warn">
        Первые 1–2 дня в лагере ребята могут скучать в «свободное время» — не привыкли к нему без телефона. К третьему дню сами придумывают, чем заняться.
      </StatCallout>

      <h2>Вечерние активности — какие бывают?</h2>

      <p>
        Вечерняя активность (20:30–22:00) каждый день разная. Вот форматы, которые повторяются каждым летом:
      </p>

      <ul>
        <li><strong>Квесты по территории</strong> — командные, с загадками и тайными заданиями</li>
        <li><strong>«Что? Где? Когда?»</strong> — команды ребят против команды взрослых</li>
        <li><strong>Кино под открытым небом</strong> — или в холле если дождь</li>
        <li><strong>Творческий вечер с вожатым</strong> — кто умеет рисовать, кто умеет петь</li>
        <li><strong>Хакатон-презентации</strong> — в последние дни смены</li>
      </ul>

      <h2>А если пойдёт дождь?</h2>

      <p>
        Дождь меняет только формат: уличный спорт — на настольный теннис в холле, квест по
        территории — на квиз или кино под крышей. Запасной вариант в помещении есть всегда,
        программа не срывается.
      </p>

      <h2>Связь с родителями</h2>

      <p>
        Лучшее время для звонка — 19:00–20:00, между ужином и вечерней активностью. Утром и на
        занятиях ребята заняты, а после 22:00 уже отбой. Если трубку не взяли — это нормально,
        просто занят или уже лёг: вожатые держат родителей в курсе через общий чат смены.
      </p>

      <h2>Первый день — свои правила</h2>

      <p>
        В заезд расписание немного другое: ребята приезжают с 10:00 до 13:00, размещаются и
        знакомятся с командой. Первый IT-блок короткий, вводный, а вечером — большая
        игра-знакомство: к ужину уже почти все знают соседей по комнате по именам.
      </p>

      <StatCallout tone="info">
        Дети, у которых сложности с социализацией, чаще всего «раскрываются» именно на вечерней игре в первый вечер. Это работает.
      </StatCallout>

      <ArticleBottomCta
        heading="Хотите узнать расписание конкретной смены?"
        bookingSubtitle="Напишите — расскажем про даты и программу ближайших смен."
      />

    </article>

    <section class="mx-auto max-w-[780px] px-4 pb-12">
      <h2 class="text-[22px] font-bold mb-6">Частые вопросы о расписании</h2>
      {faqItems.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-q">{item.q}</summary>
          <div class="faq-a">{item.a}</div>
        </details>
      ))}
    </section>

    <RelatedPages title="Полезные страницы" pages={relatedPages} />
  </main>

  <RelatedArticlesAuto />
  <Footer />
  <FAQSchema items={faqItems} />
</Base>

<style>
  .lead {
    font-size: 1.1rem;
    color: #444;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* Schedule timeline */
  .schedule-timeline {
    margin: 32px 0 40px;
    position: relative;
  }
  .phase-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
    margin-top: 24px;
  }
  .phase-label:first-child { margin-top: 0; }
  .schedule-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .schedule-time {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    min-width: 52px;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .schedule-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .schedule-content strong {
    font-size: 1rem;
    color: #1a1a2e;
    display: block;
    margin-bottom: 4px;
  }
  .schedule-content p {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.55;
  }

  /* Age grid */
  .age-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 24px 0 32px;
  }
  .age-card {
    border: 1px solid #e8eaf0;
    border-radius: 12px;
    padding: 16px;
    background: #f8f9ff;
  }
  .age-badge {
    display: inline-block;
    background: #4361EE;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 20px;
    padding: 2px 12px;
    margin-bottom: 10px;
  }
  .age-card p { font-size: 0.88rem; color: #444; line-height: 1.55; margin: 0; }

  /* FAQ */
  .faq-item { border-bottom: 1px solid #e8eaf0; }
  .faq-q {
    cursor: pointer;
    font-weight: 600;
    padding: 14px 0;
    color: #1a1a2e;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.98rem;
  }
  .faq-q::after { content: '+'; font-size: 1.4rem; color: #4361EE; }
  details[open] .faq-q::after { content: '−'; }
  .faq-a {
    font-size: 0.92rem;
    color: #555;
    line-height: 1.65;
    padding-bottom: 14px;
  }

  /* Article content */
  article h2 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 36px 0 16px; }
  article p { font-size: 0.97rem; color: #444; line-height: 1.7; margin-bottom: 16px; }
  article ul { padding-left: 20px; margin-bottom: 20px; }
  article li { font-size: 0.95rem; color: #444; line-height: 1.65; margin-bottom: 6px; }
</style>
