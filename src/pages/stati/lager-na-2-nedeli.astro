---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Смены 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Адаптация в лагере", url: "/stati/adaptaciya-rebenka-v-lagere", icon: "heart-pulse-fill", description: "Первые 3 дня и как помочь ребёнку" },
];

const faqItems = [
  {
    question: "Подходит ли двухнедельная смена ребёнку первый раз?",
    answer: "Зависит от ребёнка. Если он легко адаптируется, общительный и сам хочет ехать — две недели отлично. Если едет первый раз и немного тревожный — начните с короткой смены (7 дней), посмотрите как пройдёт, и уже следующим летом берите длинную."
  },
  {
    question: "Что дают две недели в лагере, чего нет за одну?",
    answer: "Время на раскрытие. За первую неделю ребёнок адаптируется, завязывает дружбу и входит в ритм. За вторую — углубляется в проект, дружба становится настоящей, и к финалу он уходит с реальным результатом, а не только с впечатлениями."
  },
  {
    question: "Есть ли в АйДаКемп смены на 7 и на 14 дней?",
    answer: "Да. У нас есть смены разной длины — от 7 до 14 дней. Конкретное расписание смен 2026 — на странице с ценами. Можно выбрать удобные даты и длину смены под ваше лето."
  },
  {
    question: "Если ребёнку понравится короткая смена — можно ли сразу записать на следующую?",
    answer: "Да, и многие именно так и делают. Берут короткую смену в июне, а если понравилось — записывают на длинную в июле или августе. Скидка постоянным участникам — на странице с ценами."
  }
];
---

<Base
  title="Лагерь на 2 недели для ребёнка — стоит ли брать длинную смену"
  description="Сравниваем короткие (7 дней) и длинные (14 дней) смены: кому подходит каждая, что даёт длинная смена и как выбрать. Смены АйДаКемп 2026."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-na-2-nedeli" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь на 2 недели или 1 неделю: что выбрать и для кого | АйДаКемп",
        "description": "Сравниваем короткие и длинные смены в детском лагере: кому подходит каждая, что даёт длинная смена и как решить. Смены АйДаКемп 2026.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/lager-na-2-nedeli"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь на 2 недели или 1 неделю: что выбрать и для кого"
    subtitle="Коротко и насыщенно или долго и глубоко — разбираем, что подходит вашему ребёнку."
    imageBase="lager-na-leto-2026"
    imageAlt="Ребёнок в летнем лагере на занятии — счастливый и увлечённый"
    readTime="5 мин чтения"
    breadcrumbsLast="Лагерь на 2 недели"
    daryaQuote="Дочь после первой короткой смены сама попросила: «В следующий раз хочу на две недели». Я поняла — это лучшее, что она могла сказать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Один из самых частых вопросов при выборе смены: «Нам брать длинную или короткую?» Однозначного ответа нет — у каждого варианта своя логика. Разберём честно.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Короткая смена (7 дней): для кого подходит
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Короткая смена — хороший выбор в трёх случаях.
        </p>
        <ul class="flex flex-col gap-4 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Первый раз в лагере.</strong> Если ребёнок никогда не уезжал надолго, 7 дней — хорошее испытание. Не слишком страшно, но достаточно, чтобы понять — нравится или нет.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тревожный ребёнок.</strong> Для детей с повышенной тревожностью разлука на неделю — уже большой шаг. Поработайте с ним сначала. Если прошло хорошо — в следующий раз берите две недели.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Занятое лето.</strong> Если у ребёнка уже запланированы поездки, секции или поступление — 7 дней легко вписываются в плотный график, не съедая всё лето.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          За 7 дней ребёнок успевает адаптироваться, познакомиться, поработать над проектом и показать его на финале. Это полноценная смена, просто в более концентрированном формате.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Длинная смена (14 дней): почему это другое
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В короткой смене ребёнок адаптируется к концу первой недели — и сразу начинается обратный отсчёт. В длинной — вторая неделя это совсем другое состояние. Он уже свой, уже знает как тут всё устроено, и может просто жить и работать — без тревоги адаптации.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для образовательного лагеря это особенно важно. За две недели проект становится глубже. Командные связи — настоящими. Дружба — той, с которой переписываются и после смены.
        </p>
        <ul class="flex flex-col gap-4 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Любит лагерь.</strong> Если ребёнок уже был в лагере и хочет вернуться — берите сразу длинную. Он не будет скучать по дому, он будет скучать по лагерю когда уедет.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Хочет углублённую программу.</strong> Больше времени — более сложный проект, более глубокий трек. За две недели можно сделать то, что за одну только начнёшь.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Лето свободно.</strong> Если нет жёстких обязательств и хочется, чтобы ребёнок провёл лето с пользой и удовольствием — две недели в хорошем лагере это именно это.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Смены АйДаКемп 2026 — что есть
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп работают смены разной длины начиная с конца мая и до конца августа. Есть варианты на 7 дней, 10 дней и 14 дней — можно выбрать под ваше лето. Все смены включают программу по IT-направлениям, хакатон в финале, питание, проживание и трансфер.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Треки: Python, веб-разработка, Roblox и 3D-моделирование — для разных возрастов и уровней от 8 до 16 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-500 italic">
          Конкретное расписание смен и цены — <a href="/ceny" class="text-[#ff8a00] font-semibold hover:underline">на странице бронирования →</a>
        </p>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
