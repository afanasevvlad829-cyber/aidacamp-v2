---
import { DATES_SHORT_S3, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Адаптация в лагере", url: "/stati/adaptaciya-rebenka-v-lagere/", icon: "heart-pulse-fill", description: "Первые 3 дня и как помочь ребёнку" },
];

const faqItems = [
  {
    question: "Подходит ли двухнедельная смена ребёнку первый раз?",
    answer: "Зависит от ребёнка. Если он легко адаптируется, общительный и сам хочет ехать — 2 недели отлично. Если едет первый раз и немного тревожный — начните с короткого варианта (7 дней), посмотрите как пройдёт, и уже следующим летом берите длинную."
  },
  {
    question: "Что даёт длинная смена, чего нет в короткой?",
    answer: "Время на раскрытие. За первую неделю ребёнок адаптируется, завязывает дружбу и входит в ритм. За вторую — углубляется в проект, дружба становится настоящей, и к финалу он уходит с реальным результатом, а не только с впечатлениями."
  },
  {
    question: "Есть ли в АйДаКемп смены на 7 и на 14 дней?",
    answer: `Да. У нас есть форматы разной длины — от 7 до 14 дней. Точное расписание на ${SEASON_YEAR} год — на странице с ценами. Можно выбрать удобные даты под ваше лето.`
  },
  {
    question: "Если ребёнку понравится короткая смена — можно ли сразу записать на следующую?",
    answer: "Да, и многие именно так и делают. Берут короткий вариант в июне, а если понравилось — записывают на длинную во второй половине лета, в июле или августе. Скидка постоянным участникам — на странице с ценами."
  },
  {
    question: "Почему 14-дневная смена считается оптимальной для образовательного лагеря?",
    answer: "Есть конкретная динамика: первые 2–3 дня — адаптация, ребёнок осматривается, знакомится. Дни 4–7 — вхождение в ритм, начало настоящей работы над проектом. Дни 8–12 — пик: командные связи устоялись, проект обрёл форму, уровень вовлечённости максимальный. Дни 13–14 — финал, хакатон, защита. Двухнедельный формат захватывает весь этот цикл. Недельный обрывается на пике адаптации."
  },
  {
    question: "Как долго ребёнок тоскует по дому в длинной смене?",
    answer: "По нашему опыту — первые два-три дня. После этого большинство школьников переключаются на новую жизнь и перестают думать о доме. Ближе к концу смены многие уже не хотят уезжать — просят продлить или записаться снова. Звонки родителям в середине срока чаще инициируют сами родители, а не дети."
  }
];
---

<Base
  title="Лагерь на 2 недели для ребёнка — выбор длинной смены"
  description={`Сравниваем короткие и длинные смены: лагерь на 1 или 2 недели, кому подходит каждый формат, что даёт ребёнку длинная смена и как выбрать родителям. АйДаКемп ${SEASON_YEAR}.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь на 2 недели или 1 неделю: что выбрать и для кого | АйДаКемп",
        "description": `Сравниваем короткие и длинные смены в детском лагере: кому подходит каждая, что даёт длинная смена и как решить. Смены АйДаКемп ${SEASON_YEAR}.`,
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/lager-na-2-nedeli"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь на 2 недели: плюсы длинной смены"
    subtitle="Коротко и насыщенно или долго и глубоко — разбираем, что подходит вашему ребёнку."
    imageBase="lager-na-leto-2026"
    imageAlt="Ребёнок в летнем лагере на занятии — счастливый и увлечённый"
    readTime="5 мин чтения"
    breadcrumbsLast="Выбор смены"
    daryaQuote="Дочь после первой короткой поездки сама попросила: «В следующий раз хочу на длинную смену». Я поняла — это лучшее, что она могла сказать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Один из самых частых вопросов при выборе лагеря: «Нам брать длинную смену или короткую?» Однозначного ответа нет — у каждого варианта своя логика. Разберём честно.
         Двухнедельный формат — золотая середина: путёвка на отдых в Подмосковье на все каникулы, стоимость понятна заранее, ребёнок из Москвы успевает и влиться, и довести проект, а городской лагерь столько не даёт.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Короткая смена (7 дней): для кого подходит
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Такой формат — хороший выбор в трёх случаях.
        </p>
        <ul class="flex flex-col gap-4 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Первый раз в лагере.</strong> Если ребёнок никогда не уезжал надолго, 7 дней — хорошее испытание. Не слишком страшно, но достаточно, чтобы понять — нравится или нет.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Тревожный ребёнок. Для детей с повышенной тревожностью такая разлука — уже большой шаг. Поработайте с ним сначала. Если прошло хорошо — в следующий раз берите более длинный вариант.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Занятое лето. Если у ребёнка уже запланированы поездки, секции или поступление — 7 дней легко вписываются в плотный график, не съедая всё лето.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          За 7 дней ребёнок успевает адаптироваться, познакомиться, поработать над проектом и показать его на финале. Это полноценная программа, просто в более концентрированном формате.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Длинная смена (14 дней): почему это другое
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В короткой смене ребёнок адаптируется к концу первых семи дней — и сразу начинается обратный отсчёт. В длинной — вторая её половина это совсем другое состояние. Он уже свой, уже знает как тут всё устроено, и может просто жить и работать — без тревоги адаптации.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для образовательного лагеря это особенно важно (двухнедельные смены есть в <a href="/lager-na-leto-2026/" class="text-primary underline underline-offset-2">летнем лагере АйДаКемп</a>). За этот срок проект становится глубже. Командные связи — настоящими. Дружба — той, с которой переписываются и после отъезда.
        </p>
        <ul class="flex flex-col gap-4 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Любит лагерь.</strong> Если ребёнок уже был в лагере и хочет вернуться — берите сразу длинную. Он не будет скучать по дому, он будет скучать по лагерю когда уедет.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Хочет углублённую программу. Больше времени — более сложный проект, более глубокий трек. За этот срок можно сделать то, что за 7 дней только начнёшь.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Лето свободно. Если нет жёстких обязательств и хочется, чтобы ребёнок провёл лето с пользой и удовольствием — летний лагерь на 14 дней закрывает именно этот запрос.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Смены АйДаКемп {SEASON_YEAR} — что есть
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Наш лагерь работает по сменам разной длины начиная с конца мая и до конца августа. Есть варианты на 7 дней, 10 дней и 14 дней — можно выбрать под ваше лето. Все они включают программу по IT-направлениям, хакатон в финале, питание, проживание и трансфер.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Треки: Python, веб-разработка, Roblox и 3D-моделирование — для разных возрастов и уровней от 8 до 16 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если сомневаетесь между лагерями с разной длиной формата — приезжайте на день открытых дверей в лагерь или почитайте отзывы родителей, чьи дети уже были на короткой и на длинной программе. Часто именно чужой опыт помогает увидеть разницу быстрее, чем любое описание на сайте.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-500 italic">
          Конкретное расписание смен и цены — <a href="/ceny/" class="text-primary font-semibold hover:underline">на странице бронирования →</a>
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Динамика 14-дневной смены: план по дням
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В длинном формате время распределяется предсказуемо — и именно это делает его эффективнее короткого для образовательного результата.
        </p>
        <div class="flex flex-col gap-3">
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <span class="shrink-0 w-14 text-base font-bold text-orange-500 pt-0.5">День 1–3</span>
            <div>
              <p class="text-base font-semibold text-slate-800">Адаптация</p>
              <p class="text-base text-slate-600 leading-[1.6]">Знакомство с командой, распорядком, базой. Небольшая тревога — это нормально. К концу третьего дня большинство чувствуют себя «своими».</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <span class="shrink-0 w-14 text-base font-bold text-orange-500 pt-0.5">День 4–7</span>
            <div>
              <p class="text-base font-semibold text-slate-800">Вход в ритм</p>
              <p class="text-base text-slate-600 leading-[1.6]">Начинается настоящая работа над проектом. Команда сложилась, педагог знает каждого. Дружба уже не случайная — она через общее дело.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-orange-200 bg-orange-50 rounded-xl p-4">
            <span class="shrink-0 w-14 text-base font-bold text-orange-500 pt-0.5">День 8–12</span>
            <div>
              <p class="text-base font-semibold text-slate-800">Пик вовлечённости</p>
              <p class="text-base text-slate-600 leading-[1.6]">Именно здесь происходит главное. Проект обретает форму, школьники не хотят уходить с занятий. В короткой смене этого дня просто нет.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <span class="shrink-0 w-14 text-base font-bold text-orange-500 pt-0.5">День 13–14</span>
            <div>
              <p class="text-base font-semibold text-slate-800">Финал и хакатон</p>
              <p class="text-base text-slate-600 leading-[1.6]">Публичная защита проекта перед всем лагерем. Именно это ребята рассказывают дома в первый вечер после возвращения.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять, что подходит именно вашему ребёнку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Универсального ответа нет — но есть несколько практических ориентиров, которые помогают решить быстрее, не гадая наугад. Первый — опыт. Если ребёнок уже ночевал вне дома без родителей (у бабушки, в гостях, в детском саду с выездом) и спокойно это переносил, длинный лагерь скорее всего пройдёт без проблем. Если нет — начните с короткого варианта, чтобы протестировать формат с меньшими рисками.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Второй ориентир — сам ребёнок. Спросите прямо: «Хочешь на неделю или на две?» Дети старше 9–10 лет обычно неплохо чувствуют собственные границы и честно отвечают. Если колеблется — выбирайте среднюю длину (10 дней): она снимает тревогу первого раза, но всё равно даёт время на настоящий проект и дружбу, которая не обрывается на полуслове.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          И третий — ваш собственный ресурс. Родителям тоже нужно время привыкнуть к тому, что ребёнок сам справляется без вас. Если для вас короткая разлука уже испытание — необязательно сразу брать двухнедельную смену. Лагерь никуда не денется: попробуйте формат покороче в этом сезоне, а на следующий — уже увеличивайте её длину осознанно, а не через силу.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хороший загородный лагерь всегда подскажет, какая длительность реалистична именно для вашего ребёнка — вожатые видят десятки детей за сезон и быстро понимают, кому нужно больше времени на адаптацию, а кто готов к длинной программе с первого дня. Не стесняйтесь спрашивать у организаторов: в нормальном лагере вам ответят честно, а не просто продадут самую дорогую путёвку.
        </p>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>


  <ArticleBottomCta
    bookingTitle="Запишите ребёнка на длинную смену"
    bookingSubtitle={`Смена 3 (${DATES_SHORT_S3}, 13 дней) — самая насыщенная программа августа.`}
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
