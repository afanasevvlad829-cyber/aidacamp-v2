---
import { PRICE_MAX, PRICE_MIN, SEASON_YEAR, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import { SEASON_FROM_TO } from '../../data/evergreen';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Как помочь подростку, который ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", icon: "lightbulb", description: "Чтобы лето не прошло на диване" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov/", icon: "phone", description: "Как работает наша среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Лето с пользой" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "С какого возраста можно отправлять ребёнка в лагерь?",
    answer: "В хорошие загородные лагери берут с 7 лет. В АйДаКемп — с 7 до 15 лет, с делением на группы 7–9, 10–12, 13–15 лет: смешивать возраста нельзя, 8-летнему с 14-летними будет стресс. Первую смену лучше брать короткую — 7–10 дней."
  },
  {
    question: "Что если ребёнок не хочет ехать?",
    answer: "Это нормально, особенно перед первой поездкой. Поможет: посмотреть фото и видео вместе, поговорить с ребятами, которые уже ездили, дать взять с собой что-то своё. Главное — не давить; при сильном сопротивлении стоит начать с короткой смены."
  },
  {
    question: "Как совместить лагерь с другими планами на лето?",
    answer: `Лагерь занимает 10–15 дней — остальное лето свободно. Хорошая схема: одна смена в июне, остальное — по обстоятельствам. Бронировать лучше заранее, популярные лагери заполняются к апрелю. В АйДаКемп смены ${SEASON_FROM_TO} — даты на странице цен.`
  },
  {
    question: "Можно ли поехать на несколько смен подряд?",
    answer: "Да, и многие так делают. Каждая смена — новая программа. Второй раз в одном лагере — статус «старожила»: правила уже знакомы, включается быстрее. В АйДаКемп 60% ребят возвращаются на вторую смену — редкая цифра для лагерей."
  }
];
---

<Base
  title="Куда деть ребёнка летом — варианты и цены работающим родителям глазами мамы"
  description={`Куда деть ребёнка летом работающим родителям: сад, бабушка, лагерь, море, репетиторы. Честный разбор от мамы, которая перепробовала всё. Обновлено на лето ${SEASON_YEAR}.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Куда деть ребёнка летом: реальные варианты глазами работающей мамы",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-03-10",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/kuda-det-rebenka-letom"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Как выбрать летний лагерь для ребёнка — пошаговый гайд",
      "description": "Как работающей маме выбрать летний лагерь: на что смотреть, о чём спрашивать, как не пожалеть о выборе.",
      "totalTime": "P1D",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Определить тип лагеря по интересам школьника",
          "text": "Спортивный, творческий, IT или комбинированный. Лучший лагерь — тот, куда ребёнок хочет ехать, а не тот, который выбрала мама."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Проверить безопасность и документы",
          "text": "Лицензия на образовательную деятельность, лицензия на оздоровительный лагерь, медработник на территории."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Изучить отзывы и рейтинги",
          "text": "Яндекс Карты, Google Maps — смотрите не средний балл, а конкретные тексты. Хорошие отзывы конкретны: что понравилось, что нет."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Проверить соотношение педагог : дети",
          "text": "Оптимально — 1:6 или лучше. При 1:15 индивидуального внимания не будет."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Уточнить что входит в стоимость",
          "text": "Питание, проживание, программа, экскурсии, трансфер — по каждому пункту должен быть чёткий ответ."
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Куда деть ребёнка летом"
    subtitle="Сравниваю варианты — цены, плюсы и минусы: бабушка, дневной лагерь, загородный, языковой, городской формат. Что реально работает и для кого."
    imageBase="kuda-letom"
    imageAlt="Дети на активном отдыхе летом — варианты летней занятости"
    readTime="8 мин чтения"
    breadcrumbsLast="Куда деть ребёнка летом"
    daryaQuote="Мы с дочерью перебрали всё: дача, город, моря. В итоге самое стабильно-рабочее — смена в лагере: ребёнок занят, в кругу ровесников, я имею 10 дней на свою жизнь."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый май начинается одна и та же головоломка: школа заканчивается, а работа — нет, и совершенно непонятно, куда его деть на три месяца. Каникулы нужно чем-то заполнить так, чтобы всем было хорошо: ему полезно, а маме — спокойно. Разберём основные варианты по возрасту и бюджету — честно, что работает, а что нет.
        </p>

        <StatCallout
          value="3 месяца"
          label="летних каникул — родителям нужна хотя бы одна организованная смена для выдоха."
          source="очевидный факт"
          icon="calendar-week"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 1 — Бабушка и дедушка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самый привычный ответ на вопрос, куда деть ребёнка на пару недель. Ребёнок в безопасности, накормлен, под присмотром. Бесплатно. Но есть нюансы.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: бесплатно, доверие, связь поколений</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет развития, много экранного времени, бабушка устаёт</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Подростку скучно — начинаются конфликты</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хороший вариант на часть лета, но не на все три месяца.
        </p>

        <StatCallout
          value="48–95 тыс. ₽"
          label="средний бюджет хорошего детского лагеря за 7–15 дней с питанием и программой."
          source="наш мониторинг рынка 2026"
          icon="coin"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 2 — Городской дневной лагерь
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Куда деть ребёнка на будни, если оба родителя работают полный день? Школьник ходит как на работу: с 9 до 18, активности, обед, забираете вечером. Есть при школах, при кружках, при коммерческих центрах.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: он при деле, вы на работе, недорого (от 15 000 ₽/нед.)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет эффекта погружения, вечером — опять телефон</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Качество сильно зависит от конкретного места</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошее дополнение к другим вариантам, но не замена: за неделю ребята не успевают по-настоящему включиться.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 3 — Загородный лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вопрос «куда деть ребёнка» нужно закрыть не на пару дней, а на всё лето — школьник уезжает на 7–15 дней. Живёт в коллективе, занимается по программе, учится быть самостоятельным. Это единственный вариант, где происходит настоящая перезагрузка.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: полное погружение, новые навыки, самостоятельность</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Ребята отрываются от экрана — и это не стресс, а выбор</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: дороже (от {PRICE_MIN}), нужно доверие к организатору</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Загородный лагерь — это не «сплавить ребёнка», а инвестиция в его рост: за 10 дней он учится жить в коллективе и справляться без родителей. А маме — 10 дней без чувства вины.
        </p>
      </div>

      <!-- Вариант 4: Языковой лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 4 — Языковой лагерь (если цель — английский)
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Куда деть ребёнка, если приоритет — не IT, а язык? Если главная задача лета — прокачать английский, языковой лагерь — честный выбор. Обычно это либо выезд за рубеж (Великобритания, Мальта, Кипр), либо российский лагерь с носителями языка. Занятия по 3–4 часа в день, среда — только английский.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: реальная языковая среда, быстрый прогресс в разговорной речи</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: дорого (от 100 000 ₽ за рубеж), нет IT-направления, цель одна</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Подойдёт тому, кто уже занимается языком и хочет закрепить</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Честно: мы не языковой лагерь — у нас нет носителей языка, зато есть программирование, хакатон и реальный проект на Python. Приоритет языка — идите в языковой, приоритет технологий — к нам.
        </p>
      </div>

      <!-- Что получит ребёнок + АйДаКемп для работающих родителей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Куда деть ребёнка так, чтобы он вернулся с результатом — АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп — <a href="/detskiy-lager-podmoskove/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагерь в Подмосковье</a>, 66 км от МКАД, с IT-программой для детей и подростков 7–15 лет. <a href="/ceny/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Смены от 7 до 15 дней</a>, в стоимость входит всё: проживание, 5-разовое питание, программа, бассейн, охрана. За 10 дней школьник собирает свою игру или сайт на Python и заводит 10–15 новых друзей — «я сделал игру» звучит в разговоре с одноклассниками куда лучше, чем «я лежал на даче».
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Группы по возрасту: 7–9, 10–12, 13–15 лет</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Телефоны не запрещены — экранное время зарабатывается</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Итог смены — собственный проект и хакатон</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Образовательная лицензия — налоговый вычет 13%</span></li>
        </ul>

        <StatCallout
          value="~30%"
          label="родителей выгорают именно в летние каникулы — без пауз в графике."
          source="опросы семейных психологов"
          icon="emoji-frown"
          tone="info"
        />
      </div>

      <!-- Льготы и субсидии -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Льготы и субсидии: кто может сэкономить на лагере
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Реальные расходы часто на 10–20% ниже стикерной цены — если знать, что спросить.
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <i class="bi bi-cash-coin text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Налоговый вычет 13% — если у лагеря есть образовательная лицензия</p>
              <p class="text-base leading-[1.6] text-slate-600">Государство возвращает 13% от образовательной части стоимости смены. За смену АйДаКемп — от ~2 800 до ~{VYCHET_MAX} в зависимости от длительности. Оформляется онлайн через <a href="/stati/nalogovyj-vychet-za-lager-poshagovaya-instrukciya/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">личный кабинет ФНС</a> за 15–20 минут по договору и справке об оплате.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <i class="bi bi-building text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Корпоративная компенсация от работодателя</p>
              <p class="text-base leading-[1.6] text-slate-600">Многие крупные компании (Сбер, Яндекс, Газпром, госструктуры) компенсируют часть стоимости путёвки — от 5 000 до 30 000 ₽. Спросите в HR: «Есть ли компенсация детских путёвок в лагерь?»</p>
            </div>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
