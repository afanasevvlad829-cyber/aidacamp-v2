---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Как помочь подростку, который ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", icon: "lightbulb", description: "Чтобы лето не прошло на диване" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov", icon: "phone", description: "Как работает наша среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Лето с пользой" },
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "С какого возраста можно отправлять ребёнка в лагерь?",
    answer: "В хорошие загородные лагери берут с 7 лет. В АйДаКемп — с 7 до 15 лет, с разделением по возрастным группам: 7–9, 10–12, 13–15 лет. Для младших важна группа своего возраста — если 8-летний попадёт к 14-летним, это гарантированный стресс. Первую смену лучше выбирать короткую — 7–10 дней."
  },
  {
    question: "Что если ребёнок не хочет ехать?",
    answer: "Это нормально — особенно если едет впервые. Поможет: посмотреть фото и видео из лагеря вместе, поговорить с другими детьми, которые уже ездили, дать ребёнку взять что-то своё (книгу, игру). Главное — не давить. Если сопротивление очень сильное, возможно, стоит начать с более короткого формата или дневного лагеря, чтобы привыкнуть к идее."
  },
  {
    question: "Как совместить лагерь с другими планами на лето?",
    answer: "Лагерь занимает 10–15 дней — остальное лето свободно. Хорошая схема: одна смена в июне (ребёнок выдохнул после учёбы и занят), остальное — по обстоятельствам. Бронировать лучше заранее — популярные лагери заполняются к апрелю. В АйДаКемп смены с июня по август, можно выбрать удобные даты на странице цен."
  },
  {
    question: "Можно ли поехать на несколько смен подряд?",
    answer: "Да, и многие дети так делают. Каждая смена — новая программа, новые активности. Второй раз в одном лагере — это уже статус «старожила»: ребёнок знает правила, быстрее включается, может помогать новичкам. В АйДаКемп 60% детей возвращаются на вторую смену — это редкая цифра для лагерей."
  },
  {
    question: "Что взять с собой ребёнку на лето в лагерь?",
    answer: "Базовый список: одежда по погоде (минимум 2 смены), дождевик, удобная обувь для активностей, сланцы для бассейна, средство от комаров, солнцезащитный крем, личные гигиенические принадлежности. В IT-лагере ноутбук не нужен — всё оборудование предоставляется. Подробный список высылаем вместе с договором."
  }
];
---

<Base
  title="Куда деть ребёнка летом: реальные варианты глазами работающей мамы"
  description="Сад, бабушка, лагерь, море, репетиторы — что выбрать и не сойти с ума. Честный разбор от мамы, которая перепробовала всё. Обновлено на лето 2026."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/kuda-det-rebenka-letom" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Куда деть ребёнка летом: реальные варианты глазами работающей мамы",
        "author": { "@type": "Organization", "name": "АйДаКемп" },
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-03-10",
        "url": "https://aidacamp.ru/stati/kuda-det-rebenka-letom"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Как выбрать летний лагерь для ребёнка — пошаговый гайд",
      "description": "Как работающей маме выбрать лагерь для ребёнка летом: на что смотреть, о чём спрашивать, как не пожалеть о выборе.",
      "totalTime": "P1D",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Определить тип лагеря по интересам ребёнка",
          "text": "Спортивный, творческий, IT или комбинированный. Лучший лагерь — тот, куда ребёнок хочет ехать, а не тот, который выбрала мама."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Проверить безопасность и документы",
          "text": "Лицензия на образовательную деятельность, лицензия на оздоровительный лагерь, страховка, медработник на территории."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Изучить отзывы и рейтинги",
          "text": "Яндекс Карты, Google Maps — смотрите не средний балл, а конкретные тексты. Хорошие отзывы конкретны: что понравилось, что нет."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Проверить соотношение педагог : дети",
          "text": "Оптимально — 1:6 или лучше. При 1:15 индивидуального внимания не будет."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Уточнить что входит в стоимость",
          "text": "Питание, проживание, программа, экскурсии, трансфер — по каждому пункту должен быть чёткий ответ."
        }
      ]
    })}</script>
  </Fragment>
  <Header />

  <ArticleHero
    title="Куда деть ребёнка летом — 5 вариантов + что учесть"
    subtitle="Сравнение: дача, город, лагерь, море, репетиторы. Плюсы, минусы, цены — и как не выгореть."
    imageBase="kuda-letom"
    imageAlt="Дети на активном отдыхе летом — варианты летней занятости"
    readTime="8 мин чтения"
    breadcrumbsLast="Куда деть ребёнка летом"
    daryaQuote="Мы с дочерью перебрали всё: дача, город, моря. В итоге самое стабильно-рабочее — смена в лагере: ребёнок занят, в кругу ровесников, я имею 10 дней на свою жизнь."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый май начинается одна и та же головоломка: школа заканчивается, а работа — нет. Три месяца каникул нужно чем-то заполнить. Причём так, чтобы ребёнку было полезно, а родителям — спокойно. Разберём основные варианты и честно скажем, что работает, а что — нет.
        </p>

        <StatCallout
          value="3 месяца"
          label="летних каникул — родителям нужна хотя бы одна организованная смена для выдоха."
          source="очевидный факт"
          icon="calendar-week"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 1 — Бабушка и дедушка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самый привычный вариант. Ребёнок в безопасности, накормлен, под присмотром. Бесплатно. Но есть нюансы.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: бесплатно, доверие, связь поколений</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет развития, много экранного времени, бабушка устаёт</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Подростку скучно — начинаются конфликты</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хороший вариант на часть лета. Но на все три месяца — тяжело и для бабушки, и для ребёнка.
        </p>

        <StatCallout
          value="48–95 тыс. ₽"
          label="средний бюджет хорошего детского лагеря за 7–15 дней с питанием и программой."
          source="наш мониторинг рынка 2026"
          icon="coin"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 2 — Городской дневной лагерь
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ребёнок ходит как на работу: с 9 до 18, активности, обед, забираете вечером. Есть при школах, при кружках, при коммерческих центрах.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: ребёнок при деле, вы на работе, недорого (от 15 000 ₽/нед.)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет эффекта погружения, вечером — опять телефон</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Качество сильно зависит от конкретного места</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подходит как дополнение к другим вариантам. Но за неделю дети не успевают по-настоящему включиться — каждый вечер возвращаются к привычному укладу.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 3 — Загородный лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ребёнок уезжает на 7–15 дней. Живёт в коллективе, занимается по программе, учится быть самостоятельным. Это единственный вариант, где происходит настоящая перезагрузка.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: полное погружение, новые навыки, самостоятельность</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Дети отрываются от экрана — и это не стресс, а выбор</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: дороже (от 48 000 ₽), нужно доверие к организатору</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Загородный лагерь — это не «сплавить ребёнка». Это инвестиция в его рост. За 10 дней происходит то, чего не добиться за полгода кружков: ребята учатся жить в коллективе, принимать решения и справляться без родителей.
        </p>
      </div>

      <!-- Новый раздел: Сравнение вариантов -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сравнение вариантов: что выбрать летом 2026
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Быстрое сравнение по четырём параметрам — без осуждения, просто факты:
        </p>

        <div class="grid gap-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
                <i class="bi bi-house-door text-slate-500 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800">С бабушкой</p>
                <p class="text-[12px] text-slate-500">Бесплатно</p>
              </div>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Безопасно и привычно. Риск: телефон + сериалы на весь день. Бабушка устаёт за три недели. Для короткого периода — отлично.</p>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
                <i class="bi bi-building text-slate-500 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800">Городские курсы</p>
                <p class="text-[12px] text-slate-500">от 15 000 ₽/нед.</p>
              </div>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">2–3 часа занятий в день. Остальное время ребёнок дома — то есть в привычной среде. Погружения нет.</p>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
                <i class="bi bi-sun text-slate-500 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800">Дневной лагерь при школе</p>
                <p class="text-[12px] text-slate-500">от 8 000 ₽/нед.</p>
              </div>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Дёшево и ребёнок при деле. Программа часто скучная — летний продлёнок. Вечером всё то же самое.</p>
          </div>

          <div class="border border-slate-200 rounded-xl p-4 border-orange-200 bg-orange-50">
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
                <i class="bi bi-laptop text-orange-500 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800">Загородный IT-лагерь</p>
                <p class="text-[12px] text-orange-600">от 48 000 ₽ за 10 дней</p>
              </div>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Полное погружение, реальный IT-проект, 10–15 новых друзей. Родителям спокойно. Налоговый вычет 13% — до 5 200 ₽ возврата.</p>
          </div>
        </div>
      </div>

      <!-- Новый раздел: Что ребёнок получит -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что ребёнок получит за лето в IT-лагере
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Конкретно, без преувеличений — то, что мы видим после каждой смены:
        </p>

        <div class="grid sm:grid-cols-2 gap-3 mb-6">
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <i class="bi bi-laptop text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-semibold text-slate-800 mb-1">Реальный IT-проект</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Готовая игра, сайт или бот — то, что можно показать одноклассникам и поставить в портфолио.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <i class="bi bi-code-slash text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-semibold text-slate-800 mb-1">Навык программирования</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Python с нуля до рабочего кода — за 10 дней интенсивной практики в мини-группах.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <i class="bi bi-people text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-semibold text-slate-800 mb-1">10–15 новых друзей</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Одни интересы, совместные проекты — дружба завязывается иначе, чем в школе.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <i class="bi bi-star-fill text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-semibold text-slate-800 mb-1">Опыт самостоятельности</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">10 дней без родителей рядом — ребёнок возвращается другим: уверенней, самостоятельнее.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4 sm:col-span-2">
            <i class="bi bi-chat-dots-fill text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-semibold text-slate-800 mb-1">Тема для разговора в школе</p>
