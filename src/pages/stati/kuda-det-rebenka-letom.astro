---
import { PRICE_MAX, PRICE_MIN, SEASON_YEAR, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import { SEASON_FROM_TO } from '../../data/evergreen';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Как помочь подростку, который ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", icon: "lightbulb", description: "Чтобы лето не прошло на диване" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov/", icon: "phone", description: "Как работает наша среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Лето с пользой" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "С какого возраста можно отправлять ребёнка в лагерь?",
    answer: "В хорошие загородные лагери берут с 7 лет. В АйДаКемп — с 7 до 15 лет, с разделением по возрастным группам: 7–9, 10–12, 13–15 лет. Для младших важна группа своего возраста — если 8-летний попадёт к 14-летним, это гарантированный стресс. Первую смену лучше выбирать короткую — 7–10 дней."
  },
  {
    question: "Можно ли отправить ребёнка в лагерь первый раз в 7 лет?",
    answer: "Да, и это хороший возраст для первого опыта. Главное — выбрать лагерь с группами именно для 7–9-летних, а не смешанный. В АйДаКемп младшая группа 7–9 лет работает отдельно: другой режим, другие активности, педагоги специализируются именно на этом возрасте. Для первой поездки лучше взять короткую смену — 7 дней. Он успевает освоиться, но не успевает сильно соскучиться. Большинство семилеток к концу смены сами просят ехать ещё."
  },
  {
    question: "Что если ребёнок не хочет ехать?",
    answer: "Это нормально — особенно если едет впервые. Поможет: посмотреть фото и видео из лагеря вместе, поговорить с другими ребятами, которые уже ездили, дать ему взять что-то своё (книгу, игру). Главное — не давить. Если сопротивление очень сильное, возможно, стоит начать с более короткого формата или дневного лагеря, чтобы привыкнуть к идее."
  },
  {
    question: "Как совместить лагерь с другими планами на лето?",
    answer: `Лагерь занимает 10–15 дней — остальное лето свободно. Хорошая схема: одна смена в июне (он уже выдохнул после учёбы и занят), остальное — по обстоятельствам. Бронировать лучше заранее — популярные лагери заполняются к апрелю. В АйДаКемп смены ${SEASON_FROM_TO}, можно выбрать удобные даты на странице цен.`
  },
  {
    question: "Можно ли поехать на несколько смен подряд?",
    answer: "Да, и многие ребята так делают. Каждая смена — новая программа, новые активности. Второй раз в одном лагере — это уже статус «старожила»: он знает правила, быстрее включается, может помогать новичкам. В АйДаКемп 60% ребят возвращаются на вторую смену — это редкая цифра для лагерей."
  },
  {
    question: "Что взять с собой ребёнку на лето в лагерь?",
    answer: "Базовый список: одежда по погоде (минимум 2 смены), дождевик, удобная обувь для активностей, сланцы для бассейна, средство от комаров, солнцезащитный крем, личные гигиенические принадлежности. В IT-лагере ноутбук не нужен — всё оборудование предоставляется. Подробный список высылаем вместе с договором."
  }
];
---

<Base
  title="Куда деть ребёнка летом — варианты и цены работающим родителям глазами мамы"
  description={`Куда деть ребёнка летом работающим родителям: сад, бабушка, лагерь, море, репетиторы. Честный разбор от мамы, которая перепробовала всё. Обновлено на лето ${SEASON_YEAR}.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Куда деть ребёнка летом: реальные варианты глазами работающей мамы",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-03-10",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/kuda-det-rebenka-letom"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Как выбрать летний лагерь для ребёнка — пошаговый гайд",
      "description": "Как работающей маме выбрать летний лагерь: на что смотреть, о чём спрашивать, как не пожалеть о выборе.",
      "totalTime": "P1D",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Определить тип лагеря по интересам школьника",
          "text": "Спортивный, творческий, IT или комбинированный. Лучший лагерь — тот, куда ребёнок хочет ехать, а не тот, который выбрала мама."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Проверить безопасность и документы",
          "text": "Лицензия на образовательную деятельность, лицензия на оздоровительный лагерь, медработник на территории."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Изучить отзывы и рейтинги",
          "text": "Яндекс Карты, Google Maps — смотрите не средний балл, а конкретные тексты. Хорошие отзывы конкретны: что понравилось, что нет."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Проверить соотношение педагог : дети",
          "text": "Оптимально — 1:6 или лучше. При 1:15 индивидуального внимания не будет."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Уточнить что входит в стоимость",
          "text": "Питание, проживание, программа, экскурсии, трансфер — по каждому пункту должен быть чёткий ответ."
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Куда деть ребёнка летом: варианты глазами работающей мамы", "item": "https://aidacamp.ru/stati/kuda-det-rebenka-letom/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Куда деть ребёнка летом"
    subtitle="Сравниваю варианты — цены, плюсы и минусы: бабушка, дневной лагерь, загородный, языковой, городской формат. Что реально работает и для кого."
    imageBase="kuda-letom"
    imageAlt="Дети на активном отдыхе летом — варианты летней занятости"
    readTime="8 мин чтения"
    breadcrumbsLast="Куда деть ребёнка летом"
    daryaQuote="Мы с дочерью перебрали всё: дача, город, моря. В итоге самое стабильно-рабочее — смена в лагере: ребёнок занят, в кругу ровесников, я имею 10 дней на свою жизнь."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый май начинается одна и та же головоломка: школа заканчивается, а работа — нет. Как проводить летние каникулы с умом — разбираем варианты для детей разных возрастов и бюджетов. Три месяца каникул нужно чем-то заполнить. Причём так, чтобы всем было хорошо: и ему полезно, и маме — спокойно. Отдых, который заодно даёт результат, устраивает работающую маму куда больше. Разберём основные варианты и честно скажем, что работает, а что — нет.
        </p>

        <StatCallout
          value="3 месяца"
          label="летних каникул — родителям нужна хотя бы одна организованная смена для выдоха."
          source="очевидный факт"
          icon="calendar-week"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 1 — Бабушка и дедушка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самый привычный вариант. Ребёнок в безопасности, накормлен, под присмотром. Бесплатно. Но есть нюансы.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: бесплатно, доверие, связь поколений</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет развития, много экранного времени, бабушка устаёт</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Подростку скучно — начинаются конфликты</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хороший вариант на часть лета. Но на все три месяца — тяжело и для бабушки, и для него.
        </p>

        <StatCallout
          value="48–95 тыс. ₽"
          label="средний бюджет хорошего детского лагеря за 7–15 дней с питанием и программой."
          source="наш мониторинг рынка 2026"
          icon="coin"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 2 — Городской дневной лагерь
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Школьник ходит как на работу: с 9 до 18, активности, обед, забираете вечером. Есть при школах, при кружках, при коммерческих центрах.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: он при деле, вы на работе, недорого (от 15 000 ₽/нед.)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет эффекта погружения, вечером — опять телефон</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Качество сильно зависит от конкретного места</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подходит как дополнение к другим вариантам. Но за неделю ребята не успевают по-настоящему включиться — каждый вечер возвращаются к привычному укладу.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 3 — Загородный лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Школьник уезжает на 7–15 дней. Живёт в коллективе, занимается по программе, учится быть самостоятельным. Это единственный вариант, где происходит настоящая перезагрузка.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: полное погружение, новые навыки, самостоятельность</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Ребята отрываются от экрана — и это не стресс, а выбор</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: дороже (от {PRICE_MIN}), нужно доверие к организатору</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Загородный лагерь — это не «сплавить ребёнка». Это инвестиция в его рост. Для работающей семьи это ещё и 10 дней, когда мама может выдохнуть — без чувства вины. За 10 дней происходит то, чего не добиться за полгода кружков: ребята учатся жить в коллективе, принимать решения и справляться без родителей.
        </p>
      </div>

      <!-- Вариант 4: Языковой лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 4 — Языковой лагерь (если цель — английский)
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если главная задача лета — прокачать английский, языковой лагерь — честный выбор. Обычно это либо выезд за рубеж (Великобритания, Мальта, Кипр), либо российский лагерь с носителями языка. Занятия по 3–4 часа в день, среда — только английский.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: реальная языковая среда, быстрый прогресс в разговорной речи</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: дорого (от 100 000 ₽ за рубеж), нет IT-направления, цель одна</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Подойдёт тому, кто уже занимается языком и хочет закрепить</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Честно: мы не языковой лагерь — у нас нет носителей и цели подтянуть грамматику. Зато есть программирование, хакатон и реальный проект на Python. Если приоритет языка — идите в языковой. Если приоритет технологий — к нам. Разные задачи, разные форматы.
        </p>
      </div>

      <!-- Вариант 5: Дневной городской лагерь для тех кто не готов к проживанию -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 5 — Дневной городской IT-лагерь (без ночёвки)
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не готов ночевать без взрослых? Это нормально — особенно если первый раз и возраст 7–8 лет. Городской дневной формат: с утра привёл, вечером забрал. Программирование, проект — но без отрыва от дома.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700">Плюсы: меньше стресс от разлуки, он дома каждый вечер</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-[16px] text-slate-700">Минусы: нет эффекта погружения, каждый вечер — привычная среда и телефон</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хороший вариант как первый шаг перед загородным лагерем. Попробовал дневной — понял, что нравится — на следующее лето уже смело едет на смену с проживанием. Получается плавный переход без стресса.
        </p>
      </div>

      <!-- Новый раздел: Сравнение вариантов -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сравнение вариантов: что выбрать летом {SEASON_YEAR}
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Не знаете, куда его денете на ближайшие три месяца? Быстрое сравнение по четырём параметрам — без осуждения, просто факты:
        </p>

        <div class="grid gap-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3 mb-2">
