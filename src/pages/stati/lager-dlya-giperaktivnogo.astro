---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import RelatedPages from '../../components/RelatedPages.astro';

const relatedPages = [
  { title: "Лагерь для интроверта", url: "/stati/lager-dlya-introverta/", icon: "bi-person", description: "Как устроен лагерь для разных темпераментов" },
  { title: "Детский лагерь", url: "/detskiy-lager/", icon: "bi-house-heart", description: "Что такое АйДаКемп — формат, программа, условия" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "bi-phone-flip", description: "Как режим без гаджетов помогает сфокусироваться" },
  { title: "О лагере", url: "/o-lagere/", icon: "bi-patch-check-fill", description: "Команда, лицензия, история АйДаКемп" },
];

const faqItems = [
  {
    question: "А если ребёнок будет мешать другим во время занятий?",
    answer: "В группах по 8 человек вожатый видит каждого. Если кто-то устал сидеть — можно переключиться: покрутиться на стуле, выйти попить воды, взять паузу на 2–3 минуты. Это не нарушение, а часть режима. Принудительного «сиди и слушай» нет."
  },
  {
    question: "Мой ребёнок не доводит начатое до конца — справится ли с проектом?",
    answer: "Проект разбит на маленькие шаги, каждый из которых можно завершить за одно занятие. Видимый результат на каждом этапе — это именно то, что удерживает внимание. Большинство гиперактивных ребят как раз хорошо работают в формате «сделал и вижу, что получилось»."
  },
  {
    question: "Нужно ли сообщать об СДВГ при записи?",
    answer: "Желательно, но необязательно. Если вы расскажете о особенностях ребёнка при записи — вожатый будет готов заранее. Мы не требуем медицинских справок, но чем больше знаем о ребёнке, тем лучше можем выстроить работу с ним."
  },
  {
    question: "Есть ли успокоительные или медикаменты в лагере?",
    answer: "Медработник в лагере есть. Если ребёнок принимает назначенные препараты — сообщите при заезде, всё будет организовано по расписанию. Самостоятельно мы ничего не назначаем и не отменяем."
  },
];
---

<Base
  title="Лагерь для гиперактивного ребёнка с СДВГ — подходит ли IT-лагерь"
  description="Подходит ли IT-лагерь гиперактивному ребёнку с СДВГ? Разбираем формат АйДаКемп: группы 8 человек, смена деятельности каждые 45 мин, физическая нагрузка."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
            { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
            { "@type": "ListItem", "position": 3, "name": "Лагерь для гиперактивного ребёнка — подходит ли IT", "item": "https://aidacamp.ru/stati/lager-dlya-giperaktivnogo" }
          ]
        },
        {
          "@type": "Article",
          "headline": "Лагерь для гиперактивного ребёнка — подходит ли IT",
          "description": "Подходит ли IT-лагерь гиперактивному ребёнку с СДВГ? Разбираем формат АйДаКемп: группы 8 человек, смена деятельности каждые 45 мин, физическая нагрузка.",
          "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
          "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru"},
          "datePublished": "2026-05-16",
          "dateModified": "2026-05-16",
          "url": "https://aidacamp.ru/stati/lager-dlya-giperaktivnogo"
        },
        {
          "@type": "FAQPage",
          "mainEntity": faqItems.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {"@type": "Answer", "text": item.answer}
          }))
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь для гиперактивного ребёнка — подходит ли IT"
    subtitle="Разбираем честно: что в IT-лагере помогает, а что нет — и почему АйДаКемп работает там, где обычный лагерь не справляется."
    imageBase="lager-programmirovaniya"
    imageAlt="Подросток работает над программным проектом в небольшой группе"
    readTime="7 мин чтения"
    breadcrumbsLast="Лагерь для гиперактивного ребёнка"
    daryaQuote="Я всегда говорю родителям: расскажите мне про вашего ребёнка. Не диагноз — а человека. Дальше мы разберёмся вместе."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Вступление -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда мама гиперактивного подростка звонит нам первый раз, она обычно сразу предупреждает: «Он очень активный, вы справитесь?» Вопрос понятный. За плечами — опыт школьных замечаний, кружков, откуда уходили через месяц, и лагерей, после которых вожатые вежливо просили «попробовать что-нибудь другое».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Мы не гарантируем чудес. Но можем объяснить, почему IT-формат часто работает там, где другие варианты не срабатывали.
        </p>
      </div>

      <!-- Секция 1: Гиперактивность и СДВГ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Гиперактивность и СДВГ — одно и то же?
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нет, хотя эти слова часто используют как синонимы. Гиперактивность — это черта: высокий уровень двигательной активности, импульсивность, трудности с долгим удержанием внимания. СДВГ (синдром дефицита внимания и гиперактивности) — медицинский диагноз, который ставит врач по совокупности признаков.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для нашей темы разница не критична: и те, и другие ребята нуждаются в одном и том же — коротких циклах активности, видимом результате и среде без лишнего шума. Именно это определяет, подойдёт ли им формат.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Важно понимать: ни гиперактивность, ни СДВГ не делают ребёнка менее умным или менее способным. Часто — наоборот: высокая энергия, нестандартные решения и умение быстро переключаться становятся преимуществом там, где нужна скорость мышления.
        </p>
      </div>

      <!-- Секция 2: Почему обычные лагеря сложны -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему обычные лагеря сложны для гиперактивных ребят
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Стандартный загородный лагерь строится вокруг больших групп, общих линеек, длинных пассивных мероприятий и правила «все делают одно». Это не плохая модель для большинства — но для гиперактивного подростка каждый из этих пунктов становится источником напряжения.
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Большая группа — больше отвлекающих факторов.</strong> 25–30 человек в одном пространстве означает постоянный фоновый шум, который труднее игнорировать, чем тишину.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Долгие пассивные активности.</strong> Полуторачасовой концерт или двухчасовая лекция — это просто неподъёмно, если тело требует движения.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Нет ощутимого результата здесь и сейчас.</strong> «Веди себя хорошо до конца дня» — слишком длинный горизонт. «Сделай эту функцию» — понятная цель на 20 минут.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Ярлык «проблемного».</strong> В большой группе вожатый замечает активность быстрее, чем старание — и ребёнок снова становится тем, кому делают замечания.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не вина лагерей — просто формат не совпадает с потребностями. <a href="/detskiy-lager/" class="text-orange-700 hover:underline">Детский лагерь</a> должен подбираться под ребёнка, а не наоборот.
        </p>
      </div>

      <!-- Секция 3: Чем IT-лагерь подходит лучше -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чем IT-лагерь подходит лучше — 4 причины
          </h2>
        </div>

        <div class="space-y-4 mb-4">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">1</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Маленькая группа — меньше отвлекающих факторов</p>
              <p class="text-base leading-[1.6] text-slate-600">В АйДаКемп группы до 8 человек. Это принципиально: меньше людей — меньше фонового шума, проще договориться, легче сфокусироваться. Вожатый знает каждого по имени и видит, когда кому-то нужна пауза.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">2</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Занятия по 45–50 минут с перерывами</p>
              <p class="text-base leading-[1.6] text-slate-600">Не полтора часа «слушай и записывай» — а короткий цикл: объяснение, задача, результат, перерыв. Именно такой ритм хорошо работает с теми, кому трудно долго удерживать внимание на одном.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">3</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Программирование даёт «состояние потока»</p>
              <p class="text-base leading-[1.6] text-slate-600">Поток — это когда задача ровно по силам: не слишком легко и не слишком сложно. В этом состоянии даже очень активные подростки перестают ёрзать и могут работать час без пауз — сами, без напоминаний. Многие родители видят это впервые и удивляются.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">4</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Физическая нагрузка после занятий</p>
              <p class="text-base leading-[1.6] text-slate-600">После учебного блока — бассейн, спорт, командные активности на воздухе. Это не «довесок», а часть системы: тело разгружается, и следующий блок работы даётся легче. Смена видов деятельности — именно то, что нужно.</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-[#fff8f0] border border-primary/20 p-4 mt-2">
          <p class="text-base leading-[1.6] text-slate-700">Подробнее о том, как мы работаем с разными темпераментами — в статье <a href="/stati/lager-dlya-introverta/" class="text-orange-700 hover:underline">про лагерь для интроверта</a>. Принципы во многом те же: среда важнее диагноза.</p>
        </div>
      </div>

      <!-- Секция 4: Как устроен день -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроен день в АйДаКемп: смена активностей
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          День разбит на блоки, между которыми переключение — физическое или смысловое. Вот как это выглядит на практике:
        </p>
        <div class="space-y-2 mb-4">
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">9:00</div>
            <div class="text-base text-slate-700">Подъём, завтрак — никаких линеек и речёвок</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">10:00</div>
            <div class="text-base text-slate-700">Первый учебный блок — 45–50 минут. Конкретная задача, конкретный результат</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">11:00</div>
            <div class="text-base text-slate-700">Перерыв с движением — 15 минут на воздухе или в зале</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">11:15</div>
            <div class="text-base text-slate-700">Второй учебный блок — другая тема или следующий шаг проекта</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">13:00</div>
            <div class="text-base text-slate-700">Обед и свободное время — можно побыть в тишине или с друзьями</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">15:00</div>
            <div class="text-base text-slate-700">Бассейн или спорт на воздухе — физическая нагрузка обязательна</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">17:00</div>
            <div class="text-base text-slate-700">Третий блок — проектная работа или мастерская по выбору</div>
          </div>
          <div class="flex gap-3 items-start border border-slate-100 rounded-xl p-3">
            <div class="text-base font-mono text-slate-400 shrink-0 pt-0.5 w-[60px]">19:00+</div>
            <div class="text-base text-slate-700">Ужин, вечерняя активность по желанию, личное время</div>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Такой ритм устроен не случайно. Когда мозг знает, что впереди смена деятельности, ему легче удерживать концентрацию на текущем. Это работает и для взрослых, и для подростков — особенно тех, кому обычный школьный формат даётся тяжелее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-3">
          Если хотите подробнее — посмотрите раздел <a href="/o-lagere/" class="text-orange-700 hover:underline">о лагере</a> или страницу про <a href="/lager-bez-telefonov/" class="text-orange-700 hover:underline">лагерь без телефонов</a>: там рассказываем, как среда без постоянных уведомлений меняет качество внимания.
        </p>
      </div>

      <!-- Секция 5: Отзывы родителей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Отзывы родителей гиперактивных ребят
          </h2>
        </div>
        <div class="space-y-3">
          <div class="rounded-xl bg-[#fff8f0] border border-primary/20 p-4">
            <p class="text-base leading-[1.6] text-slate-700 italic">«Сын у меня с СДВГ, мы уже объездили много кружков. Везде через месяц-два говорили, что он "трудный". В АйДаКемп он провёл 10 дней и сделал игру на Scratch. Первый раз за долгое время что-то довёл до конца — и сам этим гордился.»</p>
            <p class="text-base text-slate-500 mt-2">Елена, мама Артёма, 10 лет, смена 2025</p>
          </div>
          <div class="rounded-xl bg-[#fff8f0] border border-primary/20 p-4">
            <p class="text-base leading-[1.6] text-slate-700 italic">«Боялась, что будут жалобы от других родителей. Ничего такого не было. Вожатая написала мне на третий день: "Максим очень энергичный, но на задачах сосредотачивается хорошо. Всё в порядке." Я, честно, чуть не заплакала.»</p>
            <p class="text-base text-slate-500 mt-2">Ольга, мама Максима, 12 лет, смена 2024</p>
          </div>
          <div class="rounded-xl bg-[#fff8f0] border border-primary/20 p-4">
            <p class="text-base leading-[1.6] text-slate-700 italic">«Дочь очень импульсивная, в школе постоянно замечания. В лагере то же самое — она шумная, быстро переключается. Но там никто не делал из этого проблему. Просто давали задачи и следующие задачи. Она вернулась довольная и сразу спросила, когда следующая смена.»</p>
            <p class="text-base text-slate-500 mt-2">Светлана, мама Даши, 11 лет, смена 2025</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
