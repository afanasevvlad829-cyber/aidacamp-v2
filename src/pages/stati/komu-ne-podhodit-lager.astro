---
import { PRICE_MIN } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Какую смену выбрать", url: "/stati/kakuyu-smenu-vybrat/", icon: "signpost-2", description: "Инструкция для мамы, которая запуталась" },
  { title: "Что вы покупаете на самом деле", url: "/stati/chestno-pro-detskiy-lager/", icon: "chat-heart", description: "Честная колонка Дарьи о лагере" },
  { title: "Ребёнок первый раз без родителей", url: "/stati/pervyj-raz-bez-roditeley/", icon: "house-heart", description: "Страхи мамы и то, как это работает на практике" },
  { title: "Как оплатить лагерь", url: "/stati/oplata-detskogo-lagerya/", icon: "credit-card", description: "Рассрочка 50/50 и возврат 13%" },
];

const REASONS = [
  { id: "adapt", icon: "moon-stars", short: "Не готов к первым дням" },
  { id: "tech", icon: "laptop", short: "Ищете лагерь без техники" },
  { id: "format", icon: "person", short: "Нужен только формат 1:1" },
  { id: "medical", icon: "heart-pulse-fill", short: "Серьёзные медограничения" },
  { id: "budget", icon: "wallet2", short: "Сумма не по карману" },
  { id: "rules", icon: "hand-index-thumb", short: "Хотите менять правила" },
];
---

<Base
  title="Кому не подходит АйДаКемп — говорим честно | АйДаКемп"
  description="Шесть причин, по которым ребёнку или семье пока лучше не ехать именно к нам. Честная колонка основателя — без уговоров и «успейте купить»."
  ogImage="/images/og-default.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Кому не подходит АйДаКемп — говорим честно",
      "description": "Честная колонка основателя АйДаКемп: шесть причин, по которым семье или ребёнку пока лучше не ехать именно к нам, а куда-то ещё.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-07-10",
      "dateModified": "2026-07-10",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/komu-ne-podhodit-lager"}
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Кому не подходит АйДаКемп — и мы скажем это сами"
    subtitle="Не каждому лагерю стоит доверять, и не каждому ребёнку стоит ехать именно к нам. Честный список от основателя — без уговоров."
    breadcrumbsLast="Кому не подходит АйДаКемп"
    readTime="7 минут"
    daryaQuote="Мне проще сказать это заранее, чем потом извиняться. Лагерь — это среда, и среда подходит не всем одинаково. Это нормально."
    icon="chat-heart"
    iconLabel="Честная колонка Дарьи"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Обычно на сайтах лагерей пишут только про то, кому у них хорошо. Я решила сделать наоборот. Не потому что люблю самобичевание — а потому что мама, которая честно понимает, что мы не про неё, экономит и своё время, и наше. И, что важнее, не разочаровывается через две недели.
        </p>
      </div>

      <!-- Section: НЕ повод отказаться -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Это НЕ повод отказаться
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Три вещи, которые мамы часто принимают за противопоказания — а на деле ими не являются.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-circle-fill text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Не обязательно уже разбираться в IT.</strong> Мы каждую смену берём ребят с нуля — есть отдельная статья <a href="/stati/it-lager-dlya-nachinayushchih/" class="text-primary hover:underline">IT-лагерь для начинающих</a>.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-people text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Главный навык — не код, а совместная жизнь.</strong> Ужиться в комнате с тем, кого раньше не знал, подстроиться под чужое расписание, доесть то, что сегодня не по вкусу — вот что реально прокачивается за смену.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-egg-fried text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Еда не будет домашней.</strong> И вообще две недели ничего не будет как дома — это часть смысла, а не минус.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          А вот шесть ситуаций, где я сама не советую записываться именно к нам.
        </p>
      </div>

      <!-- Quick-view: 6 причин -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-10 max-w-[720px]">
        {REASONS.map((r, i) => (
          <a href={`#reason-${r.id}`} class="flex flex-col items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-center no-underline hover:border-primary/40 hover:bg-primary/5 transition-colors">
            <span class="flex items-center justify-center h-7 w-7 rounded-full bg-white border border-slate-200 text-[11px] font-bold text-primary">{i + 1}</span>
            <i class={`bi bi-${r.icon} text-orange-400 text-[18px]`} aria-hidden="true"></i>
            <span class="text-[12.5px] font-semibold text-slate-700 leading-tight">{r.short}</span>
          </a>
        ))}
      </div>

      <!-- 1. Адаптация -->
      <div class="mb-8 pt-2" id="reason-adapt">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            1. Если ребёнок правда не готов пережить первые дни без вас
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не путайте это с обычным волнением — оно есть почти у всех, и это нормально (подробнее — в статье про <a href="/stati/pervyj-raz-bez-roditeley/" class="text-primary hover:underline">первый раз без родителей</a>).
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">1</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>День 1–2 — самое тяжёлое.</strong> Слёзы, «заберите меня», хочется домой. Так бывает почти у всех.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">2</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Ориентир — детский сад.</strong> Если тогда тоже были тяжёлые первые дни и истерики у порога, но потом всё наладилось — скорее всего, наладится и здесь.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-emerald-100 text-emerald-700 text-[13px] font-bold mt-0.5">3</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Дальше — легче.</strong> <a href="/stati/adaptaciya-rebenka-v-lagere/" class="text-primary hover:underline">Первые три дня почти всегда самые трудные</a>, а потом отпускает.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Речь про другую ситуацию: если ребёнок в принципе никогда не отпускал вас ни на одну ночёвку, у бабушки на выходных начинается паника, а мысль о двух неделях в другом городе вызывает у него настоящий ужас — не первую смену честнее начинать с интерната в 66 км от дома.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          АйДаКемп — лагерь с проживанием, не дневной. Это сила для тех, кто готов пережить первые дни, и минус для тех, кто пока не готов. Тогда честнее начать с городского формата или короткой смены поближе — а к нам вернуться через год-два.
        </p>
      </div>

      <!-- 2. Без техники -->
      <div class="mb-8 pt-2" id="reason-tech">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            2. Если ищете лагерь совсем без техники
          </h2>
        </div>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-laptop text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Мы не про цифровой детокс.</strong> Ноутбук, код и свой AI-проект — часть программы, а не факультатив. Экран здесь инструмент, а не то, от чего мы прячем.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-tree text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Хотите совсем без экранов — это ОК, но не к нам.</strong> Спорт, лес, поделки из шишек — прекрасно. Не стоит переплачивать за IT-программу, если сама идея компьютера в лагере вам не близка.</p>
          </div>
        </div>
      </div>

      <!-- 3. Индивидуальный формат -->
      <div class="mb-8 pt-2" id="reason-format">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            3. Если нужен только формат один на один
          </h2>
        </div>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-people-fill text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Мы работаем группами по 5–8 человек.</strong> Так строится и программа, и хакатон, и вечера в отряде — командная работа и живое общение, ради которых вообще стоит ехать в лагерь.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-person-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Нужен именно индивидуальный преподаватель — это не к нам.</strong> Если у ребёнка особенности, при которых группа реально мешает, а не просто пугает с непривычки — честнее сразу присмотреть частного наставника. Мы отряд, а не персональный гувернёр.</p>
          </div>
        </div>
      </div>

      <!-- 4. Медограничения -->
      <div class="mb-8 pt-2" id="reason-medical">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            4. Если есть серьёзные медицинские ограничения
          </h2>
        </div>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Медсестра на территории — 24/7.</strong> Аптечка и протокол на случай простуды или мелких травм — это база, и здесь мы спокойны.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-exclamation-triangle text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Но мы не медицинское учреждение.</strong> Постоянный врачебный контроль, процедуры по расписанию или состояние, требующее стационарного наблюдения, — это задача санаторного или специализированного лагеря.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-question-circle text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Сомневаетесь — спросите прямо, до оплаты.</strong> Скажем честно, потянем ситуацию или нет.</p>
          </div>
        </div>
      </div>

      <!-- 5. Бюджет -->
      <div class="mb-8 pt-2" id="reason-budget">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5. Если сумма реально не по карману
          </h2>
        </div>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-wallet2 text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Рассрочка и вычет 13% реально снижают чек</strong> — подробно в статье <a href="/stati/oplata-detskogo-lagerya/" class="text-primary hover:underline">как оплатить лагерь</a>.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Но если даже с рассрочкой сумма от {PRICE_MIN} выбивает семью из бюджета на пару месяцев вперёд — это не повод занимать или влезать в неудобный кредит ради путёвки. Хороший летний отдых можно устроить и без лагеря такого уровня, и от этого вы не становитесь хуже как родитель. Правда не становитесь.
        </p>
      </div>

      <!-- 6. Правила -->
      <div class="mb-8 pt-2" id="reason-rules">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            6. Если требовать будете вы, а не ребёнок
          </h2>
        </div>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-hand-index-thumb text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>У нас свои правила — из договора.</strong> Расписание, дисциплина, формат питания выверены не одной сменой. Даже если в моменте кажется, что можно иначе, — мы всё равно будем следовать протоколу, а не подстраивать его под каждого родителя лично.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-cup-hot text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Это касается и еды.</strong> Рацион сбалансированный, а не тот, что выбрал бы дома сам ребёнок. Буфета в этом году нет — раз в два дня возим общую доставку из «ВкусВилла»: чипсы, шоколадка, маленькая бутылка газировки. Осознанный релакс для тех, кто скучает по сухарикам и бургерам, а не то, что можно расширить по отдельной просьбе.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-x-circle text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Хотите лично контролировать программу или спорить с вожатыми — тоже не к нам.</strong> Если вам кажется, что вы сделаете лучше — сделайте лучше самостоятельно. Мы не обидимся.</p>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А если ни один пункт не про вас?
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Тогда, скорее всего, мы вам подойдём — и дальше вопрос уже не «стоит ли», а <a href="/stati/kakuyu-smenu-vybrat/" class="text-primary hover:underline">какую смену выбрать</a>.
        </p>
        <StatCallout
          value="Решение — за вами"
          label="Пишу этот список не для того, чтобы кого-то отговорить, а чтобы те, кому подходит, ехали спокойно — без «а вдруг мы не такие, как надо»."
          source="Дарья Афанасьева, основатель АйДаКемп"
          icon="signpost-2"
          tone="info"
        />
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Сомневаетесь, подходим ли мы вам?"
    bookingSubtitle="Расскажите о ребёнке — за один разговор честно скажем, наш это случай или нет."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
