---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Признаки компьютерной зависимости", url: "/stati/priznaki-kompyuternoj-zavisimosti", icon: "phone", description: "Как понять что пора" },
  { title: "Как избавиться от зависимости", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", icon: "controller", description: "Пошаговый план" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Среда без игр" },
];
---

<Base
  title="Игромания у детей и подростков — когда увлечение становится болезнью"
  description="Что такое игромания, чем она отличается от увлечения играми. МКБ-11, возрастные группы риска, как распознать и что делать — без паники."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/igromaniya-u-detej" />
  </Fragment>
  <Header />

  <ArticleHero
    title="Игромания у детей"
    subtitle="Отличие от обычного увлечения + 5 признаков когда пора действовать — и что работает."
    imageBase="igromaniya"
    imageAlt="Ребёнок за игрой на мобильном устройстве — грань увлечения и зависимости"
    date="Апрель 2026"
    readTime="6 мин чтения"
    breadcrumbsLast="Игромания у детей"
    daryaQuote="Моя дочь провела лето «в играх» — а потом сама заметила: скучно без цели, сколько ни играй. Новая среда и реальный проект сработали там, где уговоры только ссорили нас."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Термин «игромания» в России часто используется как синоним «много играет в компьютер». Но у слова есть точное значение — это расстройство, которое с 2019 года официально признано Всемирной организацией здравоохранения и внесено в МКБ-11 под кодом 6C51 «Игровое расстройство». Рассмотрим что это значит для родителя.
        </p>

        <StatCallout
          value="9 из 10"
          label="российских подростков играют регулярно — граница нормы проходит по продолжительности и ущербу."
          source="Mediascope, 2024"
          icon="controller"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое игромания по определению ВОЗ
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Согласно МКБ-11, игровое расстройство — это паттерн поведения, характеризующийся:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Утратой контроля над игровым поведением (не могу остановиться, даже если хочу)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Приоритетом игры над другими интересами и ежедневными делами</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Продолжением игры несмотря на негативные последствия (учёба, отношения, здоровье)</span></li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Чтобы поставить диагноз — все 3 признака должны наблюдаться минимум 12 месяцев (у подростков может быть меньше — 6 месяцев при выраженных симптомах). Если у вашего ребёнка есть 1–2 пункта и меньше полугода — это пока ещё не игромания по ВОЗ, но уже повод начинать профилактику.
        </p>
      
        <StatCallout
          value="5+ часов"
          label="игры в день — ВОЗ относит к критерию «игрового расстройства» у подростков."
          source="ВОЗ, МКБ-11"
          icon="phone"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Группы риска — кто уязвимее
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Исследования показывают, что игромания развивается неравномерно. Вот факторы риска по данным WHO и российских клинических исследований:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Мальчики в 4 раза чаще чем девочки</strong> — не социальное, а нейробиологическое (дофаминовый ответ)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Возраст 10–16 лет</strong> — пик уязвимости, пластичность мозга + формирование идентичности</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Дети с СДВГ</strong> — значительно выше риск (в 2–3 раза)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Интроверты с трудностями в социализации</strong> — игры закрывают потребность в общении</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Дети в конфликтных семьях или пережившие стресс</strong> — игра как побег</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Наследственность</strong> — если в роду были зависимости (алкогольная, игровая взрослая)</span></li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Какие игры вызывают зависимость чаще
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не все игры одинаково рискованные. Наибольший аддиктивный потенциал имеют:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Free-to-play с внутриигровыми покупками</strong> — механика lootbox работает по принципу игрового автомата</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>MMO и онлайн-шутеры</strong> — Fortnite, PUBG, CS2, Valorant — социальное давление «подведи команду»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Игры с бесконечным прогрессом</strong> — Roblox, Genshin Impact — всегда «ещё уровень»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700"><strong>Гача-игры</strong> — выдача случайных наград механически как «однорукий бандит»</span></li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Важно: сам Minecraft, если играть в «Creative» режиме и создавать свои миры — не очень аддиктивен. Он меньше про «награду» и больше про «творчество». Именно поэтому в нашем лагере Minecraft используется как обучающий инструмент, а не игрушка.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Куда обращаться если подозреваете игроманию
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Первый шаг — не клиника. Первый шаг — <strong>семейный психолог или подростковый психолог</strong>. Одна консультация — чтобы понять: это действительно расстройство или тревога родителей + нормальное подростковое поведение. В Москве принимает Научный центр психического здоровья (бесплатно при наличии ОМС). В частных клиниках — от 4 000 ₽ за приём.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Параллельно — действовать. Не ждать «пока психолог разрешит». Вводить правила (экран не в спальне, договор по времени), искать альтернативные увлечения, планировать смену среды на ближайшие каникулы. В 70% случаев комплексный подход работает без медикаментов.
        </p>
      </div>

    </article>
  </main>
  <ArticleBottomCta
    bookingTitle="Разорвите круг «игра-скука-игра»"
    bookingSubtitle="Оставьте телефон — перезвоним за 10 минут, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
