---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Программа IT-лагеря", url: "/stati/programma-it-lagerya/", icon: "calendar-week", description: "Чем занимаются каждый день" },
  { title: "Питание в лагере", url: "/stati/pitanie-v-detskom-lagere/", icon: "cup-hot", description: "Меню и 5-разовое питание" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-detskom-lagere/", icon: "trophy", description: "Главное событие смены" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Скучают ли ребята в лагере?",
    answer: "Редко. В лагере насыщенный распорядок: IT-занятия, спорт, бассейн, вечерние активности. В первые день-два может быть тоска по дому — это нормально. Но уже к третьему дню большинство ребят забывают проверить, не написала ли мама. Они просто заняты — расписание построено так, чтобы свободных минут для скуки почти не оставалось."
  },
  {
    question: "Обязательно ли спать во время тихого часа?",
    answer: "Нет. Тихий час — это про отдых, а не про сон по команде: можно читать, лежать с наушниками, валяться с книжкой. Главное правило — час без беготни. К середине смены тихий час перестаёт быть повинностью: после утреннего IT-блока и бассейна пауза нужна всем, и многие сами первыми идут в комнату полежать."
  },
  {
    question: "Есть ли в лагере свободное время?",
    answer: "Да, каждый день: пауза после обеда и свободное время с 18:00 до ужина. Можно отдохнуть в комнате, поиграть в настолки, поговорить с друзьями или просто побыть в тишине. Лагерь — это не военная часть, где каждая минута расписана. Баланс между активностями и отдыхом — намеренный, и это заметно уже в первые дни смены."
  },
  {
    question: "Чем занимаются вечером в лагере?",
    answer: "Вечерняя программа — одна из самых любимых частей смены. Это может быть тематическая дискотека, командные игры, кино под открытым небом, творческий конкурс или общелагерное мероприятие. Каждый вечер — что-то разное. Вечером ребята расслаблены и открыты — именно в это время завязывается настоящая дружба, а вожатые становятся не просто взрослыми рядом, а частью компании."
  },
  {
    question: "Во сколько подъём в лагере АйДаКемп?",
    answer: "Подъём в 8:00 — вожатый включает музыку, 10–15 минут на пробуждение, потом зарядка по желанию и завтрак. Первые сутки самые сложные, а через 2–3 дня ребята сами просыпаются раньше будильника. Отбой — в 22:00, младшим (7–9 лет) на полчаса раньше."
  },
  {
    question: "Сколько раз в день проходят IT-занятия?",
    answer: "Дважды в день: утренний блок (9:30–12:00) и дневной (15:00–18:00, после тихого часа). Итого около 4–5 часов программирования в день — в расслабленном формате, с перерывами и промежуточными защитами. Не чувствуется как уроки — больше похоже на работу в команде над общим проектом."
  }
];
---

<Base
  title="Жизнь в детском лагере: как проходит день и тихий час | АйДаКемп"
  description="Как проходит день в детском IT-лагере: подъём, занятия, бассейн, тихий час и вечерние игры. Честный рассказ о жизни в АйДаКемп глазами ребёнка."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Жизнь в детском лагере — как проходит обычный день в АйДаКемп",
        "description": "Как проходит день в детском IT-лагере: подъём, занятия, бассейн, вечерние игры. Честный рассказ о жизни в АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/zhizn-v-lagere-dlya-detej"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что ждёт ребёнка в детском лагере: как проходит день и тихий час"
    subtitle="Подъём, IT-блок, бассейн, вечерние посиделки — обычный день смены по часам."
    imageBase="lager-na-leto-2026"
    imageAlt="Ребята на вечерней активности в летнем лагере"
    readTime="6 мин чтения"
    breadcrumbsLast="Жизнь в лагере"
    daryaQuote="Дочь вернулась со смены и начала рассказывать про каждый день — не могла остановиться. Я сидела и думала: вот это я хотела для неё. Не просто «поехала куда-то», а реально прожила."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «А чем они там заняты целыми днями?» — первый вопрос почти каждой мамы. Отвечаем честно, без рекламных слов: вот обычный день смены в АйДаКемп. Примерно так он выглядит глазами ребёнка — от подъёма до отбоя. Будни в лагере расписаны по часам, но ощущения казармы нет — судите сами.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            08:00 — Подъём, зарядка и завтрак
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый заходит в 8:00 и включает музыку. Никто особо не спешит — 15 минут на «пробудиться». Потом зарядка, и она по желанию: не жёсткая физкультура, а скорее разминка под весёлую музыку на улице или в зале. 10–15 минут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После зарядки — умывание, привести себя в порядок, и все идут на завтрак: каша, яйцо, чай или какао. Говорят: «После первой ночи никто не хочет вставать, после третьей — уже сами просыпаются». К завтраку присоединяется вожатый отряда — за столом обсуждают планы на день, а не только едят. Такое утро в лагере задаёт тон всему дню.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            09:30–12:00 — IT-блок №1: утренние занятия
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это ядро дня. Около 2,5 часов программирования с преподавателем, в группах до 8 человек, с короткими перерывами. Никакой скуки учебника — занятия построены как задачи.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Зависит от потока: одни пишут код на Python, другие собирают игру в Scratch, третьи возятся с Telegram-ботом. Педагог объясняет, потом команда пробует сама. В конце утреннего блока — промежуточная защита: показали результат, разобрали застрявшие места.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В 12:00 — в бассейн или на спортплощадку. После кода двигаться хочется, и переход между блоками короткий: переодеться и вперёд. Смена ритма — часть распорядка в лагере, а не исключение.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            12:00–13:30 — Бассейн, спорт и активности на улице
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После кода — движение. Закрытый бассейн работает через день и чередуется с играми на улице: футбол, волейбол, командные эстафеты. Иногда это тематические активности: квест по территории, полоса препятствий, «живой робот».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В этот блок никто не сидит в комнате. Вожатые выходят с отрядом на улицу — и задают энергию. Ребята кричат, бегают, смеются. Именно здесь чаще всего завязывается дружба — общая игра сближает быстрее любого знакомства за столом. Такие моменты потом вспоминают о жизни в лагере чаще всего.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            13:30–15:00 — Обед и тихий час
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В 13:30 — обед: суп, второе, компот, меню с учётом аллергий. Идут с аппетитом — после бассейна иначе не бывает.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          С 14:00 до 15:00 — время тихого часа. Спать не обязательно, но лежать и отдыхать — да. Многие ребята поначалу возмущаются («я же не маленький!»), а к середине смены уходят на паузу первыми: день насыщенный, тело само просит отдыха. Тихий час здесь не про дисциплину, а про запас сил к вечеру — без него к 18:00 многие бы просто вымотались. Кто-то забегает переодеться перед тихим часом, кто-то просто ложится как есть — в лагере на этот счёт никто не давит.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            15:00–18:00 — IT-блок №2: работа над проектом
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Второй блок — продолжение проекта: к хакатону команды готовят игру, бота или приложение. Режим здесь более расслабленный, чем утром: можно задавать любые вопросы педагогу, пробовать что-то своё, спорить внутри команды.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Итого около 4–5 часов программирования в день на два блока. Этого хватает для прогресса и не перегружает — между блоками бассейн, обед и пауза на отдых. К вечеру у каждой команды уже есть что показать на защите. Учёба в лагере совсем не похожа на школьную — здесь нет оценок, только реальный результат.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            18:00–20:30 — Свободное время, ужин и вечернее мероприятие
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С 18:00 — свободное время: настолки, игры, прогулки, можно читать или просто общаться в комнате. Это время ребята ценят — не потому что «делать нечего», а потому что можно побыть собой. Кто-то доигрывает партию в шахматы, кто-то просто валяется на траве с телефоном — здесь никого не подгоняют. Свободное время в лагере — это про выбор, а не про безделье.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В 19:00 — ужин. Заодно самое удобное время позвонить родителям: между ужином и вечерней активностью — как раз есть о чём рассказать за день.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В 20:30 — вечернее мероприятие. Каждый день разное: командный турнир, дискотека, кино, творческий конкурс или общелагерная игра. Это любимая часть дня у большинства ребят — именно вечером отряд чувствуется как одна команда. После — подготовка ко сну и гигиена.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            22:00 — Отбой: «ещё немного поговорим»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый обходит комнаты, пересчитывает всех по головам, и дежурит всю ночь. Младшим (7–9 лет) отбой на полчаса раньше. Разговоры в комнате ещё полчаса — это нормально: ребята делятся впечатлениями дня, обсуждают проекты, смеются над чем-то своим. Если совсем не спится — вожатый рядом, достаточно позвать.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Именно вечера в комнате — то, что потом вспоминают дольше всего. «Мы разговаривали допоздна» — это и есть настоящая дружба, которую не купишь ни в каком кружке. На следующее утро всё повторится: подъём, музыка, зарядка — и новый насыщенный день в лагере. Именно такой баланс активности и отдыха делает жизнь в лагере насыщенной, но не выматывающей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Точный распорядок дня АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вот как выглядит обычный день смены в цифрах — без маркетинга, просто расписание:
        </p>
        <ul class="flex flex-col gap-3 max-w-[680px]">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>8:00</strong> — подъём, музыка от вожатого, зарядка по желанию, завтрак</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>9:30–12:00</strong> — IT-блок №1 (группы до 8 человек, с перерывами)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>12:00–13:30</strong> — бассейн (через день) или спортивные активности на улице</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>13:30</strong> — обед</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>14:00–15:00</strong> — тихий час</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>15:00–18:00</strong> — IT-блок №2 (работа над проектом, расслабленный режим)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>18:00</strong> — свободное время (настолки, игры, прогулки)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>19:00</strong> — ужин</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>20:30</strong> — вечернее мероприятие (квест, конкурс, кино, командная игра)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-clock text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>22:00</strong> — отбой (младшим 7–9 лет — на полчаса раньше)</span>
          </li>
        </ul>
        <p class="text-base text-slate-500 mt-3 italic">Бассейн работает через день — чередуется с активными играми на улице. В дождливые дни активности переносятся в закрытые помещения.</p>
      </div>

      <BlogCTA variant="summer" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите, чтобы ваш ребёнок прожил такое лето?"
    bookingSubtitle="Расскажем про свободные смены и ответим на все вопросы."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
