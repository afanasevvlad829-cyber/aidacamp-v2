---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Программа IT-лагеря", url: "/stati/programma-it-lagerya", icon: "calendar-week", description: "Чем занимаются каждый день" },
  { title: "Питание в лагере", url: "/stati/pitanie-v-detskom-lagere", icon: "cup-hot", description: "Меню и 5-разовое питание" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-detskom-lagere", icon: "trophy", description: "Главное событие смены" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Скучают ли дети в лагере?",
    answer: "Редко. В лагере насыщенный распорядок: IT-занятия, спорт, бассейн, вечерние активности. В первые день-два может быть тоска по дому — это нормально. Но уже к третьему дню большинство детей забывают проверить, не написала ли мама. Они просто заняты."
  },
  {
    question: "Есть ли в лагере свободное время?",
    answer: "Да, каждый день есть свободное время — обычно 1–1,5 часа. Дети могут отдохнуть в комнате, поиграть в настолки, поговорить с друзьями или просто побыть в тишине. Лагерь — это не военная часть, где каждая минута расписана. Баланс между активностями и отдыхом — намеренный."
  },
  {
    question: "Что делают вечером в лагере?",
    answer: "Вечерняя программа — одна из самых любимых частей смены. Это может быть тематическая дискотека, командные игры, кино под открытым небом, творческий конкурс или общелагерное мероприятие. Каждый вечер — что-то разное. Вечером дети расслаблены и открыты — именно в это время завязывается настоящая дружба."
  }
];
---

<Base
  title="Жизнь в детском лагере — как проходит обычный день в АйДаКемп | АйДаКемп"
  description="Как проходит день в детском IT-лагере: подъём, занятия, бассейн, вечерние игры. Честный рассказ о жизни в АйДаКемп глазами ребёнка."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/zhizn-v-lagere-dlya-detej" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Жизнь в детском лагере — как проходит обычный день в АйДаКемп",
        "description": "Как проходит день в детском IT-лагере: подъём, занятия, бассейн, вечерние игры. Честный рассказ о жизни в АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/zhizn-v-lagere-dlya-detej"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как проходит день в детском лагере: распорядок глазами ребёнка"
    subtitle="Рассказываем честно: что происходит от подъёма до отбоя в обычный день АйДаКемп."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети на вечерней активности в летнем лагере"
    readTime="6 мин чтения"
    breadcrumbsLast="Жизнь в лагере для детей"
    daryaQuote="Дочь вернулась со смены и начала рассказывать про каждый день — не могла остановиться. Я сидела и думала: вот это я хотела для неё. Не просто «поехала куда-то», а реально прожила."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Что там вообще происходит?» — это первый вопрос каждой мамы. Мы решили ответить честно: вот обычный день в АйДаКемп, без прикрас и рекламных слов. Примерно так он выглядит с точки зрения ребёнка.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            08:00 — Подъём и утренняя зарядка
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый заходит в 8:00 и включает музыку. Никто особо не спешит — 15 минут на «пробудиться». Потом лёгкая зарядка: не жёсткая физкультура, а скорее зарядка под весёлую музыку на улице или в зале. 10–15 минут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После зарядки — умывание, привести себя в порядок. В 8:30–8:45 все идут на завтрак. Говорят: «После первой ночи никто не хочет вставать, после третьей — уже сами просыпаются».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            09:00–12:30 — IT-блок: утренние занятия
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это ядро дня. Примерно 3–3,5 часа программирования, разбитые на блоки с короткими перерывами. Никакой скуки учебника — занятия построены как задачи.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Зависит от потока: одни пишут код на Python, другие делают игру в Scratch, третьи работают над Telegram-ботом. Педагог объясняет, потом команда пробует сама. В конце утреннего блока — промежуточная защита: «что сделали, что не получилось».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В 12:30 — обед. Идут с аппетитом: после кода двигаться хочется.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            14:00–15:30 — Тихий час и свободное время
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После обеда — тихий час. Спать не обязательно, но лежать и отдыхать — да. Многие дети поначалу возмущаются («я же не маленький!»), а к середине смены уходят в тихий час первыми — потому что день насыщенный и тело просит отдыха.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После тихого часа — свободное время: можно читать, играть в настолки, просто общаться в комнате. Это время дети ценят — не потому что «делать нечего», а потому что можно побыть собой.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            15:30–17:30 — Спорт, бассейн и активности на улице
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После отдыха — движение. Бассейн работает ежедневно. Помимо этого — футбол, волейбол, командные игры на улице. Иногда это тематические активности: квест по территории, полоса препятствий, «живой робот».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В этот блок никто не сидит в комнате. Вожатые выходят с отрядом на улицу — и задают энергию. Дети кричат, бегают, смеются. Именно здесь чаще всего завязывается дружба.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            18:00–21:00 — Ужин, вечерний IT-блок и вечернее мероприятие
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После ужина — короткий вечерний IT-блок (1–1,5 часа): продолжение работы над проектом, дообсуждение идей. Это более расслабленный режим: можно задавать любые вопросы педагогу, пробовать что-то своё.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Потом — вечернее мероприятие. Каждый день разное: командный турнир, дискотека, кино, творческий конкурс или общелагерная игра. Это любимая часть дня у большинства детей.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В 21:00–21:30 — вечерний перекус (чай, печенье). После — подготовка ко сну, гигиена. Отбой — 22:30.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            22:30 — Отбой: «ещё немного поговорим»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый обходит комнаты, убеждается что все на месте. Разговоры в комнате ещё полчаса — это нормально. Дети делятся впечатлениями дня, обсуждают проекты, смеются над чем-то своим.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Именно вечера в комнате — то, что дети потом вспоминают дольше всего. «Мы разговаривали до часу ночи» — это и есть настоящая дружба, которую не купишь ни в каком кружке.
        </p>
      </div>

      <BlogCTA variant="summer" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите, чтобы ваш ребёнок прожил такое лето?"
    bookingSubtitle="Расскажем про свободные смены и ответим на все вопросы."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.add('hidden');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
