---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "person-badge", description: "Специальная программа для школьников 12–15 лет" },
  { title: "Детский лагерь АйДаКемп", url: "/detskiy-lager/", icon: "house-heart", description: "О лагере: программа, условия, возраст и стоимость смен" },
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "backpack", description: "Как подготовить ребёнка к первой смене" },
  { title: "Адаптация в лагере", url: "/stati/adaptaciya-rebenka-v-lagere/", icon: "heart-pulse-fill", description: "Как проходит адаптация и что делать, если скучает по дому" },
];

const faqItems = [
  {
    question: "Подходит ли IT-лагерь ребёнку с диагнозом СДВГ?",
    answer: "Многие наши ребята приезжают с диагнозом СДВГ — и чувствуют себя хорошо. Короткие активные блоки, смена деятельности каждые 40–50 минут и маленькая группа (до 8 человек) работают в плюс именно для таких школьников. При записи просим сообщить особенности — педагог будет знать заранее."
  },
  {
    question: "Нужна ли справка от психолога или невролога?",
    answer: "Справки от специалистов мы не требуем — только стандартная медицинская документация для лагеря (справка от педиатра, прививки). Если ребёнок принимает препараты, сообщите нам: медицинский сотрудник будет следить за приёмом по расписанию."
  },
  {
    question: "Как проходит адаптация в первые дни?",
    answer: "Первый день — всегда про знакомство, а не про нагрузку. Вожатые специально следят за новичками, особенно за теми, кто впервые в лагере. Активным школьникам как правило легче — они быстрее вписываются в общий ритм и находят новых друзей. К третьему дню большинство ребят уже в своей тарелке."
  },
  {
    question: "Что если ребёнку не пойдёт — можно забрать?",
    answer: "Да, конечно. Мы всегда на связи с родителями. Если ситуация некомфортная и не разрешается — обсуждаем индивидуально. Но по опыту: активным школьникам лагерь подходит лучше, чем кажется заранее. Движение, реальные задачи и новые друзья — это именно то, что им нужно."
  },
];
---

<Base
  title="Лагерь для гиперактивного ребёнка — подходит ли IT?"
  description="Как IT-лагерь работает с гиперактивными детьми: режим, физическая активность, группы по 8 человек. Честный разбор."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь для гиперактивного ребёнка: подходит ли IT и что важно знать",
        "description": "Как IT-лагерь работает с гиперактивными детьми: режим, физическая активность, группы по 8 человек. Честный разбор.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/lager-dlya-giperaktivnogo-rebenka/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
          {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
          {"@type": "ListItem", "position": 3, "name": "Лагерь для гиперактивного ребёнка", "item": "https://aidacamp.ru/stati/lager-dlya-giperaktivnogo-rebenka/"}
        ]
      }
    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title="Лагерь для гиперактивного ребёнка: подходит ли IT и что важно знать"
    subtitle="Честный разбор: как устроен день в IT-лагере и почему активным школьникам здесь часто лучше, чем в обычном."
    breadcrumb="Лагерь для гиперактивного ребёнка"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Активный школьник работает над проектом в IT-лагере АйДаКемп"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <!-- СЕКЦИЯ 1 -->
    <h2>Что происходит с гиперактивным ребёнком в стандартном лагере</h2>
    <p>
      Представьте смену, где основная программа — отрядные мероприятия, тихий час, вечерние дискотеки и длинные линейки. Для большинства школьников это нормально. Для гиперактивного — это испытание, которое заканчивается конфликтами, жалобами вожатых и слезами в трубку.
    </p>
    <p>
      Активные, импульсивные ребята плохо переносят неструктурированное «свободное время» — именно оно обычно становится источником проблем. Когда нечем заняться и нет чёткой задачи, накапливается энергия, которая выходит через шум, конфликты или просто бесцельное носение по территории.
    </p>
    <p>
      Вторая проблема стандартного лагеря — большие группы. Когда в отряде 25–30 человек, вожатому физически не хватает времени отслеживать, что происходит с конкретным школьником. Гиперактивный ребёнок в такой ситуации либо становится источником проблем для всего отряда, либо просто теряется на фоне остальных — и получает ещё меньше внимания.
    </p>
    <p>
      Это не значит, что стандартные лагеря плохие — просто формат не всегда подходит под конкретный темперамент. И здесь IT-формат оказывается неожиданно хорошим решением.
    </p>

    <!-- СЕКЦИЯ 2 -->
    <h2>Почему IT-лагерь — неожиданно хорошее решение</h2>
    <p>
      Когда родители с активным школьником звонят нам, часто слышим: «Вы уверены, что IT подходит? Он же не может спокойно сидеть за компьютером больше десяти минут». Это понятный страх — и он основан на неправильном представлении о том, как выглядит наш день.
    </p>
    <p>
      IT-лагерь — это не восемь часов за экраном. День устроен иначе: короткие рабочие сессии чередуются с физической активностью, творческими задачами и командными играми. Для гиперактивного ребёнка смена деятельности каждые 45–60 минут — это не проблема, а норма и спасение.
    </p>
    <p>
      Второй ключевой момент — наличие реальной задачи. Активные ребята плохо переносят абстрактные занятия, где непонятно зачем что-то делать. Программирование даёт быстрый, видимый результат: написал код — что-то произошло на экране. Эта немедленная обратная связь работает на них гораздо лучше, чем долгие проекты с отложенным результатом.
    </p>
    <p>
      Наконец — статус. Школьник, которого дома считают «неусидчивым», в лагере может оказаться быстрее всех схватывающим новое, первым сдать задание, предложить неожиданное решение. Это меняет самовосприятие — и такое мы видим каждую смену.
    </p>

    <!-- СЕКЦИЯ 3 -->
    <h2>Как устроен режим в АйДаКемп для активных школьников</h2>
    <p>
      Обычный день в лагере — это не «с утра до вечера за компьютером». День структурирован так, что у активного ребёнка всегда есть куда выплеснуть энергию.
    </p>
    <p>
      Утро начинается с зарядки и завтрака — это настоящая физическая нагрузка, не символическая. После — первый учебный блок, около 45 минут. Затем перемена с возможностью поиграть во дворе или посетить спортивную площадку. Второй учебный блок. Обед. После обеда — бассейн или спорт: футбол, настольный теннис, активные командные игры.
    </p>
    <p>
      Вечером — либо продолжение проекта (добровольно, для тех, кто увлёкся), либо общелагерные мероприятия: квесты, соревнования, тематические вечера. Это не тихое «посидим у костра» — это движение, команды, реальное соревнование.
    </p>
    <p>
      Важно: у нас нет жёсткого тихого часа, обязательного для всех. Ребята, которым трудно лежать в кровати и «отдыхать», могут в это время почитать или просто побыть в тихом пространстве — без давления.
    </p>
    <ul>
      <li>Физическая зарядка каждое утро</li>
      <li>Учебные блоки по 45 минут с переменами</li>
      <li>Бассейн и спорт в послеобеденное время</li>
      <li>Активные вечерние мероприятия: квесты, командные игры</li>
      <li>Гибкий тихий час без давления</li>
    </ul>

    <!-- СЕКЦИЯ 4 -->
    <h2>Маленькие группы по 8 человек — почему это важно</h2>
    <p>
      Это, пожалуй, самый важный структурный элемент для активных школьников. В группе из 8 человек педагог физически видит каждого — буквально. Нет возможности «затеряться» и нет возможности незаметно отвлечься на двадцать минут.
    </p>
    <p>
      Маленькая группа означает больше индивидуального внимания. Если у кого-то что-то не получается — педагог замечает сразу, не через час. Если ребёнок схватил быстрее остальных и скучает — педагог даёт усложнённое задание, не ждёт, пока остальные догонят.
    </p>
    <p>
      Для гиперактивных школьников это критично по ещё одной причине: в маленькой группе легче выстраивать отношения. Нет хаоса большого отряда, где нужно постоянно конкурировать за внимание. Есть несколько конкретных людей, с которыми можно по-настоящему сдружиться и сработаться.
    </p>
    <p>
      Кстати, именно в маленьких командах активные ребята часто берут на себя роль лидера — и справляются с ней отлично. Это не то, что им обычно разрешают в школе. Здесь — можно.
    </p>

    <!-- СЕКЦИЯ 5 -->
    <h2>Что важно сообщить лагерю при записи</h2>
    <p>
      Мы не требуем никаких специальных документов и не ставим диагнозы — это не наша функция. Но чем больше мы знаем о конкретном ребёнке заранее, тем лучше подготовится педагог и вожатый.
    </p>
    <p>
      При записи расскажите нам: есть ли поставленный диагноз (СДВГ, расстройство внимания, другое), принимает ли школьник препараты и по какому расписанию, есть ли особые триггеры или ситуации, которых стоит избегать, что помогает успокоиться и сосредоточиться.
    </p>
    <p>
      Эта информация остаётся только у педагога и медицинского сотрудника — не распространяется по лагерю. Другие ребята ничего не знают и знать не должны. Никаких ярлыков, никакого выделения «особых» в общем потоке.
    </p>
    <p>
      Медицинский сотрудник лагеря следит за приёмом препаратов по расписанию, если это нужно. Если у вас есть письменные рекомендации от невролога или педиатра — возьмите их с собой: это помогает медперсоналу понять логику назначений.
    </p>

    <!-- FAQ -->
    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}

  </main>
  <ArticleBottomCta
    title="Есть вопросы по конкретной ситуации? Напишите нам"
    subtitle="Расскажите об особенностях школьника — подберём смену и подготовим педагога."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
