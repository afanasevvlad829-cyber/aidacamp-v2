---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "laptop", description: "IT-лагерь с геймдев-треком — проект за смену с нуля" },
  { title: "Minecraft-лагерь", url: "/minecraft-lager/", icon: "blocks", description: "Строим миры, учимся думать алгоритмами" },
  { title: "Minecraft для детей", url: "/stati/minecraft-dlya-detej/", icon: "controller", description: "Чему реально учит Minecraft и как использовать это" },
  { title: "Scratch для детей", url: "/stati/scratch-dlya-detej/", icon: "puzzle", description: "Первый шаг в программирование без страха" },
];

const faqItems = [
  {
    question: "С какого возраста можно начать геймдев?",
    answer: "Практически с любого — важно подобрать правильный инструмент. В 7–9 лет начинают со Scratch: рисуют персонажей, задают им поведение, делают простые платформеры без единой строки кода. В 10–12 лет переходят к Roblox Studio — там уже базовый Lua-скрипт, но визуальная среда снижает порог входа. После 13 лет можно смотреть в сторону Godot или Unity. Главное — не торопиться: лучше хорошо освоить Scratch, чем бросить Unity на второй день."
  },
  {
    question: "Нужно ли знать математику для разработки игр?",
    answer: "Базовую — да: координаты, векторы, простая физика. Но это не та математика из учебника. Её понимаешь в процессе: «почему шар летит криво» объяснить через уравнение движения — и всё становится понятно. Продвинутый геймдев (3D-движки, шейдеры) требует линейной алгебры и тригонометрии. Но до этого уровня большинство школьников доходят к 14–16 годам — как раз когда математика в школе становится серьёзнее."
  },
  {
    question: "Какой движок лучше выбрать первым — Unity или Godot?",
    answer: "Для новичка — Godot. Он бесплатный, с открытым кодом, значительно проще в установке и интерфейсе. GDScript (язык Godot) напоминает Python — легко читается и пишется. Unity мощнее и используется в индустрии шире, но требует C# и более сложной конфигурации. Начать с Godot, сделать несколько проектов — а потом перейти на Unity с уже сформированным пониманием принципов. Это рабочий путь."
  },
  {
    question: "Сколько зарабатывают разработчики игр в России?",
    answer: "По данным HH.ru (2025): Junior-разработчик игр — от 70 до 130 тысяч рублей, Middle — 150–250 тысяч, Senior и выше — 300+ тысяч. Геймдизайнеры в среднем чуть ниже программистов, 3D-художники — в широком диапазоне в зависимости от специализации. Рынок мобильных игр и инди-студии активно растут. Международные компании (удалённая работа) платят в разы выше. Геймдев — одна из немногих IT-специальностей, где портфолио важнее диплома."
  },
];
---

<Base
  title="Геймдев для детей — как начать делать игры | АйДаКемп"
  description="Как ребёнку 10–15 лет начать создавать игры с нуля: путь Scratch → Roblox → Godot/Unity, реальные карьеры и что делают на геймдев-треке в АйДаКемп."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/geymdevelopment-dlya-detej/" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Геймдев для детей: как начать делать игры с нуля в 10-15 лет",
        "description": "Как ребёнку начать создавать игры: путь от Scratch до Unity, реальные карьеры в геймдеве и что происходит на геймдев-треке в IT-лагере АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/geymdevelopment-dlya-detej/"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Геймдев для детей", "item": "https://aidacamp.ru/stati/geymdevelopment-dlya-detej/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Геймдев для детей: как начать делать игры с нуля в 10–15 лет"
    subtitle="Путь от игрока к разработчику — какие инструменты выбрать, что учат на каждом этапе и куда это ведёт."
    imageBase="lager-programmirovaniya"
    imageAlt="Подросток создаёт игру за компьютером — геймдев для детей"
    readTime="7 мин чтения"
    breadcrumbsLast="Геймдев для детей"
    daryaQuote="Моя дочь начала с рисования персонажей в Scratch — а через год уже показывала мне свою первую платформер-игру. Я честно не понимала половину, но её лицо говорило само за себя."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Геймдев — это создание игр. Не просто «играть», а придумывать механики, рисовать персонажей, писать код, тестировать и выпускать. Для ребёнка, который часами проводит в играх, это самый органичный способ перейти от потребления к созданию. Индустрия игр в России и мире активно растёт — и в ней нужны люди самых разных профессий, не только программисты.
        </p>

        <StatCallout
          value="$183 млрд"
          label="объём мирового рынка игр в 2023 году — больше, чем кино и музыка вместе взятые."
          source="Newzoo, 2024"
          icon="controller"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое геймдев — без пафоса
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда говорят «разработка игр», многие представляют огромную студию с сотнями сотрудников. Но большинство культовых инди-игр — Hollow Knight, Undertale, Stardew Valley — созданы одним человеком или небольшой командой. Школьник вполне может за один-два года сделать собственную игру и опубликовать её на Itch.io или в магазине приложений.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Геймдев складывается из нескольких направлений: программирование игровой логики, дизайн уровней и механик, 2D/3D-графика, звук, сторителлинг. На старте важно попробовать каждое из них — и понять, что больше нравится. Это и есть точка входа.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Путь от игрока к разработчику: четыре ступени
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Нет единственно правильного пути. Но есть логичная лестница, по которой большинство идут снизу вверх — каждый уровень готовит к следующему.
        </p>
        <div class="space-y-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-3 mb-2">
              <div class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-base font-semibold shrink-0">Ступень 1</div>
              <p class="text-base font-semibold text-slate-800">Scratch — 7–10 лет</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Визуальные блоки вместо кода, моментальный результат. Типичный проект за неделю: простой платформер с персонажем, препятствиями и счётом. Учит логике, условиям и циклам — без пугающих синтаксических ошибок.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-3 mb-2">
              <div class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 text-base font-semibold shrink-0">Ступень 2</div>
              <p class="text-base font-semibold text-slate-800">Roblox Studio — 10–13 лет</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">3D-среда и язык Lua. Можно публиковать игры и получать реальных игроков. Проект за неделю: мультиплеерный obstacle course с уровнями. Учит пространственному мышлению и первому настоящему коду.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-3 mb-2">
              <div class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-base font-semibold shrink-0">Ступень 3</div>
              <p class="text-base font-semibold text-slate-800">Godot — 12–15 лет</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Профессиональный движок с понятным GDScript (похож на Python). Проект за неделю: 2D-RPG с диалогами, инвентарём и несколькими уровнями. Учит архитектуре проекта, сценам и компонентам.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-3 mb-2">
              <div class="px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-700 text-base font-semibold shrink-0">Ступень 4</div>
              <p class="text-base font-semibold text-slate-800">Unity / Unreal Engine — 14+ лет</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Движки коммерческого уровня, которые используют в студиях. Unity — C#, логика через скрипты. Unreal — C++ и Blueprints (визуальное программирование). Проект за месяц: полноценная мобильная игра или 3D-шутер-прототип.</p>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Реальные карьеры в геймдеве
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Разработчик игр — не одна профессия, а целый спектр. Вот куда реально можно прийти:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-code-slash text-orange-400 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Программист игр</strong> — пишет игровую логику, физику, сетевой код. Самая высокооплачиваемая роль. Язык: C++, C#, иногда Lua/Python.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-lightbulb text-orange-400 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Геймдизайнер</strong> — придумывает механики, баланс, уровни, прогрессию. Не обязательно умеет кодить — но должен понимать, как работает «интересно».</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-palette-fill text-orange-400 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>3D/2D-художник</strong> — рисует персонажей, фоны, интерфейс. Работает в Blender, Photoshop, Substance Painter. Портфолио важнее диплома.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-chat-quote text-orange-400 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нарративный дизайнер</strong> — пишет диалоги, создаёт истории, строит разветвлённые сюжеты. Пересечение игр и литературы — редкая и ценная специальность.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-music-note-beamed text-orange-400 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Звуковой дизайнер</strong> — создаёт звуковые эффекты, музыку, звуковую атмосферу. В инди-командах часто совмещается с другими ролями.</span>
          </li>
        </ul>

        <StatCallout
          value="97 млн"
          label="новых рабочих мест появится в IT и смежных отраслях к 2025 году по прогнозу World Economic Forum."
          source="WEF Future of Jobs Report"
          icon="graph-up-arrow"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Геймдев в АйДаКемп: что происходит за смену
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп геймдев — один из треков <a href="/lager-programmirovaniya/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагеря программирования</a>. Не курс и не лекции — а именно проектная работа. За 10–14 дней команда из 3–4 человек проходит полный цикл: от идеи до рабочего прототипа.
        </p>
        <div class="space-y-4 mb-5">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">1</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Дни 1–2: концепция и питч</p>
              <p class="text-base leading-[1.6] text-slate-600">Команды придумывают идею, описывают жанр, механики и сеттинг. Представляют концепцию — как настоящий питч инвесторам.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">2</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Дни 3–9: разработка</p>
              <p class="text-base leading-[1.6] text-slate-600">Код, арт, уровни, тестирование. Наставник помогает разбираться с движком и не застревать на одном месте дольше часа.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">3</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">День 10: Game Jam — презентация</p>
              <p class="text-base leading-[1.6] text-slate-600">Все команды показывают игры. Остальные играют и голосуют. Это самый живой момент смены — когда видишь, как твоим проектом увлечён кто-то другой.</p>
            </div>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подробнее о том, какие навыки даёт геймдев-трек, — в статье <a href="/stati/game-dev-skills/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">«Что умеет ребёнок после курса геймдева»</a>. Расписание смен и цены — на странице <a href="/lager-programmirovaniya/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагеря программирования</a>.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>

        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Хочет создавать, а не только играть?</p>
        <p class="mt-2 text-base text-[#0d1a2b]/70">В АйДаКемп за смену ребята делают настоящую игру — от концепции до Game Jam. Без скучных лекций, только проект в команде.</p>
        <a href="/lager-programmirovaniya/" class="mt-4 inline-block rounded-xl bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-[#d67000] transition-colors">Узнать про геймдев-трек</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-base font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/lager-programmirovaniya/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            Лагерь программирования АйДаКемп — все треки
          </a>
          <a href="/minecraft-lager/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
