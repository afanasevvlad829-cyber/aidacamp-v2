---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import DonutChart from '../../components/DonutChart.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';

const relatedPages = [
  { title: "85% профессий ещё не существует", url: "/stati/meta-skills", icon: "graph-up", description: "Что с этим делать" },
  { title: "Навыки которые не устареют", url: "/stati/navyki-kotorye-ne-ustareut", icon: "hourglass-split", description: "Конкретный список" },
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", icon: "cpu", description: "Разбор реальных данных" },
];
---

<Base
  title="ROI образовательных инвестиций: что считать и как | АйДаКемп"
  description="Родители тратят 100–250 тысяч в год на допобразование. IBM: знание устаревает за 5 лет. Какие инвестиции работают дольше других — разбор с данными."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/future-skills" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "ROI образовательных инвестиций: что считать и как",
      "description": "Родители тратят 100–250 тысяч в год на допобразование. IBM: знание устаревает за 5 лет. Какие инвестиции работают дольше других.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-02",
      "dateModified": "2026-06-09",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/future-skills"}
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="ROI образовательных инвестиций: что считать и как"
    subtitle="Родители тратят 100–250 тысяч в год на допобразование. Объясняю, какие вложения окупаются дольше всего."
    imageBase="lager-programmirovaniya"
    imageAlt="ROI образовательных инвестиций для детей"
    breadcrumbsLast="Образование и инвестиции"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-10 pb-0">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Родители в Москве тратят на дополнительное образование детей от 100 до 250 тысяч рублей в год. Это серьёзные деньги. Как любые серьёзные деньги, они заслуживают вопроса: какую отдачу мы ожидаем и через сколько лет?
        </p>
      </div>

      <!-- ═══ SECTION 1: ПЕРИОД ПОЛУРАСПАДА ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Период полураспада знания — что это такое
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          IBM Institute for Business Value ввёл термин «период полураспада профессионального знания» — по аналогии с ядерной физикой. Это время, за которое актуальность знания снижается вдвое. В 2000-е в IT этот период составлял около пяти лет. Сейчас IBM оценивает его в два с половиной года.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Половина того, что знает сегодняшний IT-специалист, через два с половиной года перестанет быть конкурентным преимуществом. Это не катастрофа — просто новая реальность, о которой не принято говорить вслух.
        </p>

        <!-- 2 ключевые цифры -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <AnimatedStat
            value="2.5"
            unit=" лет"
            label="до потери актуальности IT-знания"
            source="IBM IBV 2023"
            tone="red"
            size="lg"
          />
          <AnimatedStat
            value="5"
            unit=" лет"
            label="полураспад офисного специалиста"
            source="IBM IBV 2023"
            tone="orange"
            size="lg"
          />
        </div>

        <!-- Доноты: визуализация распада -->
        <div class="rounded-[20px] bg-slate-50 border border-slate-100 p-6">
          <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-slate-400 mb-5 text-center">Актуальность знания через период полураспада</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
            <DonutChart
              percentage={50}
              label="IT-специалист"
              sublabel="через 2,5 года"
              color="#EF4444"
              size={120}
              centerText="50%"
            />
            <DonutChart
              percentage={50}
              label="Офисный работник"
              sublabel="через 5 лет"
              color="#F97316"
              size={120}
              centerText="50%"
            />
            <DonutChart
              percentage={70}
              label="Медицина / право"
              sublabel="через 10+ лет"
              color="#10B981"
              size={120}
              centerText="70%"
            />
          </div>
          <p class="text-[11px] text-slate-400 mt-4 font-mono text-center">IBM Institute for Business Value (2023)</p>
        </div>
      </div>

      <!-- ═══ SECTION 2: РАЗНЫЙ СРОК ГОДНОСТИ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чем отличаются инвестиции с разным сроком годности
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Репетитор по математике — инвестиция в конкретный навык. Срок годности: 5–7 лет. Курс программирования на конкретном языке — аналогично. Python сегодня популярен. Через пять лет будет популярен другой язык или AI-агент, который пишет на Python за вас.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Проектное обучение — другой класс. Умение работать с незнакомой задачей без готового алгоритма. Умение найти ошибку в собственной логике. Умение довести проект до результата, когда хочется бросить. Срок годности — вся карьера.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          NTL — National Training Laboratories, США: при лекции усваивается 5% информации через две недели. При практике с обратной связью — 75%. Без практики деньги на образование работают значительно хуже.
        </p>

        <!-- Пирамида обучения: анимированные бары -->
        <AnimatedBarChart
          title="Усвоение при разных форматах обучения — NTL Learning Pyramid"
          items={[
            { label: "Лекция", value: 5,  badge: "5%",  color: "#EF4444" },
            { label: "Обсуждение", value: 20, badge: "20%", color: "#F97316" },
            { label: "Практика с обратной связью", value: 75, badge: "75%", color: "#10B981" },
            { label: "Объясняю другому", value: 90, badge: "90%", color: "#3B82F6" },
          ]}
          source="NTL (National Training Laboratories) — Learning Pyramid"
        />

        <!-- Пончик: лекция vs практика -->
        <div class="mt-6 flex flex-col sm:flex-row items-center gap-6 justify-center">
          <DonutChart
            percentage={5}
            label="лекция"
            sublabel="остаётся через 2 недели"
            color="#EF4444"
            trackColor="#FEE2E2"
            size={110}
          />
          <div class="text-[32px] text-slate-300 font-light hidden sm:block">vs</div>
          <DonutChart
            percentage={75}
            label="практика"
            sublabel="остаётся через 2 недели"
            color="#10B981"
            trackColor="#D1FAE5"
            size={110}
          />
        </div>

        <div class="mt-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Самые долгоживущие инвестиции — не в конкретные знания, а в скорость их замены.»
          </p>
        </div>

        <div class="mt-5 rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-[12px] font-semibold text-slate-400 uppercase tracking-[0.07em] mb-3">ИСТОЧНИКИ</p>
          <ul class="space-y-1.5 text-[13px] text-slate-500">
            <li>— IBM Institute for Business Value «Facing the talent disruption of generative AI» (2023)</li>
            <li>— NTL (National Training Laboratories) — Learning Pyramid</li>
            <li>— MIT Media Lab — проектное обучение и долгосрочная память</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Инвестиция в мышление — не устаревает"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
