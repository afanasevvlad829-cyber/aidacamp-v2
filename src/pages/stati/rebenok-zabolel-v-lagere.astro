---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import FAQ from '../../components/FAQ.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove/", icon: "houses", description: "Медработник на территории" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Безопасность, условия" },
  { title: "Отзывы родителей", url: "/otzyvy/", icon: "chat-quote", description: "Опыт реальных семей" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Что входит в стоимость" },
];
---

<Base
  title="Ребёнок заболел в лагере — когда везти домой, а когда ждать врача"
  description="Позвонили из лагеря — ребёнок заболел? Медпункт, температура, кто решает забирать — разбираем по шагам. В 80% случаев забирать не нужно: справляются на месте."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Ребёнок заболел в лагере — что делать и как не паниковать",
      "description": "Ребёнок заболел в детском лагере: как работает медпункт, когда сообщают родителям, когда забирать, как не паниковать. Советы для мамы.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/rebenok-zabolel-v-lagere"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок заболел в лагере — спокойно разбираемся"
    subtitle="Что на самом деле происходит, когда ребёнок заболевает в лагере, и как правильно реагировать маме."
    imageBase="hakaton"
    imageAlt="Дети в летнем лагере — безопасность и медицинская помощь"
    readTime="6 мин чтения"
    breadcrumbsLast="Ребёнок заболел в лагере"
    daryaQuote="Первый раз когда дочь заболела в лагере — температура 38 — я уже собирала вещи ехать. Воспитатель позвонил раньше меня. «Всё под контролем, медик осмотрела, даём жаропонижающее, смотрим динамику». Я выдохнула."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мысль «а вдруг заболеет?» — одна из главных причин, почему мамы откладывают отправку ребёнка в лагерь. Это нормально — хочется контролировать ситуацию. Но страх чаще всего больше реального риска. Разбираемся что происходит, если ребёнок всё-таки заболел, и что нужно сделать заранее.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что обычно случается в лагере — без паники
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство случаев обращения в медпункт — бытовые и не опасные:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>ОРВИ и лёгкие простуды</strong> — смена климата, новая среда, много активности на улице. Первые 2–3 дня особенно.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Мелкие травмы</strong> — ссадины, ушибы, занозы. Дети бегают, играют — это нормально</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Лёгкие расстройства пищеварения</strong> — новая еда, перемена воды, первые дни</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Солнечный ожог</strong> — если дети забыли нанести крем. Напомните взять его с собой</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Серьёзное случается редко — и только в плохо организованных лагерях. В официальном лагере с лицензией всё иначе.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как работает медпункт — что должно быть по закону
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный детский лагерь обязан по закону иметь:
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Медицинского работника на территории лагеря в течение всей смены.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Оборудованный медпункт с необходимыми медикаментами и инструментами</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Журнал учёта всех обращений — каждый случай фиксируется письменно. Медицинская документация ведётся в установленных формах: родители вправе запросить сведения об обращении</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Договор с ближайшей скорой помощью или клиникой на случай госпитализации</p>
          </div>
        </div>
        <StatCallout
          value="24/7"
          label="— медик в АйДаКемп дежурит круглосуточно на территории. Не по вызову — живой человек рядом."
          source="Организация смен АйДаКемп"
          icon="shield-check"
          tone="neutral"
        />
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда и как родителям сообщают
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В нормально работающем лагере родители не узнают о болезни ребёнка последними. Вот как это устроено:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">1</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">При любом обращении в медпункт — делается запись в журнале</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">2</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">При температуре выше 38°C — родителям звонят в тот же день.</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">3</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Если нужна специализированная помощь или госпитализация — немедленно</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Уточните при заезде: контакт медика или воспитателя, который отвечает за вашего ребёнка. Это нормальный вопрос, и хороший лагерь всегда даёт такой контакт без лишних объяснений. Заодно уточните политику лагеря по лекарствам: что медик может дать без вашего звонка, а что — только после согласования.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делать маме: алгоритм
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если позвонили из лагеря — вот как реагировать:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">1</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Выслушайте до конца, не паникуйте</strong> — медик уже при ребёнке, ситуация под контролем</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">2</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Задайте конкретные вопросы:</strong> какая температура? что уже дали? как ребёнок себя чувствует прямо сейчас?</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">3</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Решение о приезде принимайте вместе с медиком</strong> — он видит ребёнка и оценивает динамику</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">4</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Не уезжайте при первом чихе</strong> — изоляция от лагеря при обычной ОРВИ только лишает ребёнка смены, не улучшая выздоровление</p>
          </div>
        </div>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда стоит забрать ребёнка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Есть ситуации, когда действительно нужно ехать:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Ребёнок сам просит домой — это важный сигнал, стоит прислушаться</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Температура держится больше 3 дней несмотря на лечение</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Требуется специализированная медицинская помощь, которой нет рядом с лагерем</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Не нужно забирать при обычной ОРВИ, которую лечат на месте — если ребёнок не просится домой и динамика положительная.
        </p>
      </div>

      <!-- Section: temperature algorithm -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Алгоритм при высокой температуре — по шагам
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Температура — самая частая причина звонков из лагеря. Вот что происходит в нормально организованном лагере:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">1</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Ребёнок обратился к вожатому или самостоятельно пришёл в медпункт</strong> — медик измеряет температуру, осматривает, фиксирует в журнале.</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">2</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>При температуре 37,5–38°C</strong> — жаропонижающее, покой, наблюдение. Родителям сообщают в тот же день</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">3</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>При температуре выше 38,5°C</strong> — родителям звонят немедленно, медик оценивает динамику, при необходимости вызывает скорую</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">4</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Если температура держится больше 2 суток</strong> — организуется консультация врача или транспортировка. Ребёнок не остаётся без наблюдения</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В АйДаКемп лагерь расположен на базе санатория с собственной медицинской базой. Ближайшая районная больница — в Наро-Фоминске, 15–20 минут. Родители узнают о температуре выше 38°C раньше, чем ребёнок успеет позвонить сам.
        </p>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как подготовиться: что сделать до поездки
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство проблем можно предотвратить заранее:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Сообщите лагерю об аллергиях и хронических заболеваниях</strong> — устно и письменно при заезде</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Регулярные препараты (если ребёнок их принимает постоянно) передайте медику с письменной инструкцией — не просто оставьте в сумке</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Положите запас регулярных лекарств</strong> — с инструкцией и вашим именем на упаковке.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Проверьте что медкарта актуальна</strong> — без неё лагерь не обязан принимать ребёнка. Медицинская справка для лагеря (форма 079/у) должна быть оформлена не ранее чем за 3 дня до заезда</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Уточните контакт медика при заезде</strong> — не через администрацию, а прямой номер</p>
          </div>
        </div>
      </div>


      <BlogCTA />
    </article>

  {/* Вопросы были только в JSON-LD и не показывались читателю — Google требует
      видимости. only={[]} — рендерим ровно их, схему кладёт сам <FAQ /> */}
  <FAQ only={[]} extraLabel="Частые вопросы" extraItems={[
        { q: "Что делать если ребёнок заболел в лагере?",
          a: "Ребёнок обращается к медработнику лагеря. Родителям немедленно сообщают. При необходимости вызывают скорую или организуют доставку ребёнка домой. В АйДаКемп медработник дежурит 24/7." },
        { q: "Есть ли в лагере медицинский работник?",
