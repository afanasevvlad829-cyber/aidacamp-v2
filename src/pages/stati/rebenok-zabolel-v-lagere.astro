---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove", icon: "houses", description: "Медработник на территории" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Безопасность, условия" },
  { title: "Отзывы родителей", url: "/otzyvy", icon: "chat-quote", description: "Опыт реальных семей" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Что входит в стоимость" },
];
---

<Base
  title="Ребёнок заболел в лагере — что делать и как не паниковать"
  description="Ребёнок заболел в детском лагере: как работает медпункт, когда сообщают родителям, когда забирать, как не паниковать. Советы для мамы."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/rebenok-zabolel-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Ребёнок заболел в лагере — спокойно разбираемся",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/rebenok-zabolel-v-lagere"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что делать если ребёнок заболел в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ребёнок обращается к медработнику лагеря. Родителям немедленно сообщают. При необходимости вызывают скорую или организуют доставку ребёнка домой. В АйДаКемп медработник дежурит 24/7." }
        },
        {
          "@type": "Question",
          "name": "Есть ли в лагере медицинский работник?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. В АйДаКемп медработник на территории круглосуточно. Лагерь расположен на базе санатория «Изумруд» в Наро-Фоминском районе — медицинская база там серьёзная." }
        },
        {
          "@type": "Question",
          "name": "Нужно ли забирать ребёнка домой при болезни?",
          "acceptedAnswer": { "@type": "Answer", "text": "Зависит от состояния. При ОРВИ и лёгком недомогании — обычно нет, ребёнок остаётся под наблюдением медика. При высокой температуре дольше 3 дней или серьёзных симптомах — да, рекомендуем забрать." }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок заболел в лагере — спокойно разбираемся"
    subtitle="Что на самом деле происходит, когда ребёнок заболевает в лагере, и как правильно реагировать маме."
    imageBase="hakaton"
    imageAlt="Дети в летнем лагере — безопасность и медицинская помощь"
    readTime="6 мин чтения"
    breadcrumbsLast="Ребёнок заболел в лагере"
    daryaQuote="Первый раз когда дочь заболела в лагере — температура 38 — я уже собирала вещи ехать. Воспитатель позвонил раньше меня. «Всё под контролем, медик осмотрела, даём жаропонижающее, смотрим динамику». Я выдохнула."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мысль «а вдруг заболеет?» — одна из главных причин, почему мамы откладывают отправку ребёнка в лагерь. Это нормально — хочется контролировать ситуацию. Но страх чаще всего больше реального риска. Разбираемся что происходит, если ребёнок всё-таки заболел, и что нужно сделать заранее.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что обычно случается в лагере — без паники
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство случаев обращения в медпункт — бытовые и не опасные:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>ОРВИ и лёгкие простуды</strong> — смена климата, новая среда, много активности на улице. Первые 2–3 дня особенно</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Мелкие травмы</strong> — ссадины, ушибы, занозы. Дети бегают, играют — это нормально</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Лёгкие расстройства пищеварения</strong> — новая еда, перемена воды, первые дни</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Солнечный ожог</strong> — если дети забыли нанести крем. Напомните взять его с собой</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Серьёзное случается редко — и только в плохо организованных лагерях. В официальном лагере с лицензией всё иначе.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как работает медпункт — что должно быть по закону
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный детский лагерь обязан по закону иметь:
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Медицинского работника на территории лагеря в течение всей смены</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Оборудованный медпункт с необходимыми медикаментами и инструментами</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Журнал учёта всех обращений — каждый случай фиксируется письменно</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-shield-check text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Договор с ближайшей скорой помощью или клиникой на случай госпитализации</p>
          </div>
        </div>
        <StatCallout
          value="24/7"
          label="— медик в АйДаКемп дежурит круглосуточно на территории. Не по вызову — живой человек рядом."
          source="Организация смен АйДаКемп"
          icon="shield-check"
          tone="neutral"
        />
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда и как родителям сообщают
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В нормально работающем лагере родители не узнают о болезни ребёнка последними. Вот как это устроено:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">1</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600">При любом обращении в медпункт — делается запись в журнале</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">2</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600">При температуре выше 38°C — родителям звонят в тот же день</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">3</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600">Если нужна специализированная помощь или госпитализация — немедленно</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Уточните при заезде: контакт медика или воспитателя, который отвечает за вашего ребёнка. Это нормальный вопрос, и хороший лагерь всегда даёт такой контакт без лишних объяснений.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делать маме: алгоритм
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если позвонили из лагеря — вот как реагировать:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">1</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Выслушайте до конца, не паникуйте</strong> — медик уже при ребёнке, ситуация под контролем</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">2</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Задайте конкретные вопросы:</strong> какая температура? что уже дали? как ребёнок себя чувствует прямо сейчас?</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">3</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Решение о приезде принимайте вместе с медиком</strong> — он видит ребёнка и оценивает динамику</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[12px] font-bold text-orange-600">4</span>
            </div>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Не уезжайте при первом чихе</strong> — изоляция от лагеря при обычной ОРВИ только лишает ребёнка смены, не улучшая выздоровление</p>
          </div>
        </div>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда стоит забрать ребёнка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Есть ситуации, когда действительно нужно ехать:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Ребёнок сам просит домой — это важный сигнал, стоит прислушаться</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Температура держится больше 3 дней несмотря на лечение</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Требуется специализированная медицинская помощь, которой нет рядом с лагерем</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Не нужно забирать при обычной ОРВИ, которую лечат на месте — если ребёнок не просится домой и динамика положительная.
        </p>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как подготовиться: что сделать до поездки
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство проблем можно предотвратить заранее:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Сообщите лагерю об аллергиях и хронических заболеваниях</strong> — устно и письменно при заезде</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Положите запас регулярных лекарств</strong> — с инструкцией и вашим именем на упаковке</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Проверьте что медкарта актуальна</strong> — без неё лагерь не обязан принимать ребёнка</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Уточните контакт медика при заезде</strong> — не через администрацию, а прямой номер</p>
          </div>
        </div>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Доверяете лагерю — спите спокойно"
    bookingSubtitle="Расскажем как устроена медицинская поддержка в АйДаКемп — без лишних слов, по делу."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
