---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Хакатон в детском лагере", url: "/stati/hakaton-v-detskom-lagere", icon: "lightbulb", description: "Другой формат активности" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov", icon: "phone", description: "Как устроена среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программа смен" },
];
---

<Base
  title="Монополия в лагере: как телефонное время стало валютой — и подростки сами от него отказались"
  description="Как в АйДаКемп устроена внутренняя экономика: 500 рублей за день + 100 за уборку, минута телефона = 10 рублей. Реальные истории: стартапер с вулканом, финдиректор с 15 000 в конце, два телефона и шантаж."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere" />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Монополия в детском лагере: телефонное время как валюта — и подростки сами от него отказываются | АйДаКемп",
      "description": "Как IT-лагерь АйДаКемп учит школьников 7–15 лет финансовой грамотности через игровую экономику, где экранное время — ресурс с ценой.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-01",
      "dateModified": "2026-05-09",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое внутренняя экономика в детском лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Игровая система, где школьники получают рубли за прожитый день и уборку, а тратят на коллективные привилегии или возможности. Учит базовым принципам экономики: планирование, бюджет, приоритеты." }
        },
        {
          "@type": "Question",
          "name": "Как внутренняя экономика помогает в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "На практике осваиваются понятия «заработать», «сэкономить», «скинуться отрядом». Геймификация делает обучение экономике ненасильственным." }
        },
        {
          "@type": "Question",
          "name": "Используется ли внутренняя экономика в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. В АйДаКемп ребята получают рубли за прожитый день и инициативу, а тратят на ночь с гаджетами, кино на вечер, прощальный костёр и физические эксперименты." }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Монополия в детском лагере: как телефонное время стало валютой — и подростки сами от него отказались"
    subtitle="Прожил день — получи 600 рублей. Как в Монополии проходишь круг — получаешь 200 рублей. Что происходит дальше — никто не планировал."
    imageBase="ekonomika-lagerya"
    imageAlt="Подростки в лагере обсуждают внутреннюю экономику и распределение рублей"
    readTime="6 мин чтения"
    breadcrumbsLast="Внутренняя экономика в лагере"
    daryaQuote="Все психологи говорят: ограничьте телефон. Сказать легко. А ты попробуй заменить — и объяснить. Самое простое — переключи с игры на телефоне на игру за компьютером: там тоже играют, но там другие навыки. Мы пошли дальше."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Дисклеймер про игровую валюту -->
      <div class="mb-6 max-w-[720px] rounded-xl bg-slate-50 border border-slate-200 px-4 py-3">
        <p class="text-[13px] md:text-[14px] leading-[1.55] text-slate-600">
          <span class="font-semibold text-slate-700">Маленькое уточнение перед чтением.</span> Дальше в статье мы говорим про «рубли» — это <strong>внутренняя игровая валюта лагеря</strong>, как фишки в Монополии. К настоящим деньгам отношения не имеет: за смену никто реально ничего не платит и не зарабатывает в живых деньгах.
        </p>
      </div>

      <!-- Intro: Монополия-крючок -->
      <div class="mb-10">
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-700 max-w-[720px] mb-4">
          Вы играли в Монополию? Тогда вы уже понимаете, как устроена наша экономика.
        </p>
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          В Монополии есть базовое правило: прошёл круг — получи 200 рублей. В российских правилах это именно так. Не заработал их, не победил кого-то. Просто прожил раунд — и вот они, твои 200. Распоряжайся.
        </p>
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-600 max-w-[720px]">
          В АйДаКемп то же самое. Прожил день — получи 500 рублей. Убрался в комнате — ещё 100. Итого 600. Без условий, без «заслужи сначала». Просто факт нового дня. Что с ними делать дальше — твой выбор.
        </p>
      </div>

      <!-- VIDEO 1: про монополию — 2 колонки на desktop (видео+текст), 1 колонка на мобилке -->
      <div class="article-video-row mb-10 grid grid-cols-1 md:grid-cols-[280px_1fr] gap-6 md:gap-8 items-center">
        <div class="article-video-frame mx-auto md:mx-0 w-full max-w-[280px] rounded-2xl overflow-hidden bg-black shadow-[0_18px_36px_rgba(15,23,42,0.18)]" style="aspect-ratio:9/16">
          <iframe
            src="https://kinescope.io/embed/wSsd3WTG8RWRFwg2usdpJC?autoplay=1&muted=1&loop=1&controls=1"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer; clipboard-write"
            allowfullscreen
            loading="lazy"
            title="Видео: Монополия в лагере"
            class="w-full h-full block border-0"></iframe>
        </div>
        <div class="article-video-text">
          <p class="text-[12px] font-bold uppercase tracking-[0.18em] text-orange-500 mb-2">Видео · 30 секунд</p>
          <h3 class="text-[18px] md:text-[22px] font-bold leading-[1.25] tracking-[-0.01em] text-slate-900 mb-3">
            Как ребята впервые слышат про 600 рублей
          </h3>
          <p class="text-[15px] md:text-[16px] leading-[1.6] text-slate-600 max-w-[520px]">
            Первый день смены. Вожатый рассказывает правила игры: прожил день — получи внутреннюю валюту, трать как хочешь. Минута телефона стоит 10 рублей. Можно копить на «Ночь с гаджетами», а можно скинуться всем отрядом на вечер у костра.
          </p>
        </div>
      </div>

      <!-- Section 1: Как мы к этому пришли -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как мы к этому пришли
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Сначала мы делали как все: телефоны сдай на входе — заберёшь на выходе. Технически это работало. Психологически — нет.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Первые три дня проходили в тихом протесте. Когда телефон возвращали — школьники кидались в него с удвоенной жадностью, как будто нагоняли упущенное. В голове ничего не менялось: подросток не начинал ценить живое общение, просто терпел до выдачи.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Поэтому мы пошли другим путём. Не забирать. Сделать дорогим. И завести свою внутреннюю валюту.
        </p>
      </div>

      <!-- Авторский блок: "Отобрать легко. Замени и объясни" -->
      <div class="mb-10 pt-2">
        <div class="rounded-2xl border-l-4 border-orange-400 bg-orange-50/60 px-5 py-5 md:px-6 md:py-6 max-w-[720px]">
          <p class="text-[12px] font-bold uppercase tracking-[0.18em] text-orange-700 mb-3">Авторская позиция</p>
          <h3 class="text-[18px] md:text-[20px] font-bold leading-[1.25] text-slate-900 mb-3">
            Отобрать — легко. Попробуй замени.
          </h3>
          <p class="text-[16px] leading-[1.75] text-slate-700 mb-3">
            Все детские психологи в один голос говорят: ограничьте телефон. Это расхожая, социально одобряемая позиция взрослых. Сказать легко — а ты попробуй сам у себя отбери смартфон. И главное — попробуй <strong>заменить</strong> и <strong>объяснить</strong>, чем именно.
          </p>
          <p class="text-[16px] leading-[1.75] text-slate-700 mb-3">
            Самое простое, что можно сделать дома: переключить с игры на телефоне на игру за компьютером. Все играют — это нормально. Но за компьютером качаются <strong>другие навыки</strong>: мышь, клавиатура, длинная сессия внимания, понимание интерфейсов, иногда — первый код.
          </p>
          <p class="text-[16px] leading-[1.75] text-slate-700">
            В лагере мы пошли дальше: сделали из времени ресурс с ценой. Чтобы выбор «телефон или костёр» делался не нами, а самим школьником.
          </p>
        </div>
      </div>

      <!-- Section 2: Механика -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроена внутренняя экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          600 рублей в день — базовый доход. Из них 500 — за то, что прожил день. Ещё 100 — за уборку в комнате. Минута экранного времени — 10 рублей. Значит, 60 минут телефона — это весь дневной бюджет. Окно использования — час после ужина.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Но тратить всё на экран необязательно. Самое интересное начинается, когда отряд скидывается на коллективные покупки:
        </p>
        <ul class="flex flex-col gap-3 mb-6 max-w-[680px]">
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Кино на вечер</strong> — общим отрядом или подгруппой.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Прощальный костёр с зефирками</strong> — он не идёт по умолчанию, на него надо скидываться.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>«Преподаватель на день — вожатый»</strong> — игровой обмен ролями, отряд выкупает.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Отбой на час позже</strong> — копят пару дней.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Ночь с гаджетами</strong> — около 12 000 рублей на отряд из ~25 человек. Чтобы её взять, всё отделение два дня не тратит на собственный экран и плюс скидывается.</span></li>
        </ul>

        <!-- Подсветка: цены адаптируются + переговоры -->
        <div class="mb-6 rounded-2xl bg-orange-50 border border-orange-200 px-5 py-4 max-w-[720px]">
          <p class="text-[12px] font-bold uppercase tracking-[0.18em] text-orange-700 mb-2">Важная деталь</p>
          <p class="text-[15px] leading-[1.65] text-slate-700 mb-2">
            Цифры — не догма. <strong>Экономика подкручивается под количество ребят в смене и их возраст.</strong> Цели должны быть достижимыми за 3–4 дня скидывания всем отрядом — но не настолько, чтобы получить даром.
          </p>
          <p class="text-[15px] leading-[1.65] text-slate-700">
            И тут начинается самое интересное — <strong>надо договориться</strong>. Кто скидывается, кто пасует, кому уступить, как разделить «прибыль», если кто-то заработал больше. Базовая социальная механика, которой не учат в школе.
          </p>
        </div>
      </div>

      <!-- Section 3: Что покупают чаще всего -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что покупают чаще всего
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Самая популярная покупка — <strong>ночь с гаджетами</strong>. Настолько популярная, что мы сами ввели ограничение: <strong>не больше двух раз за смену</strong>. Иначе она перестаёт быть событием.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          На втором месте — <strong>кино на вечер</strong>. Любопытная деталь: старшие и младшие почти всегда скидываются отдельно и смотрят два разных фильма. Это происходит само, никто их не делит — выбор контента разный, и логичнее разойтись.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Прощальный костёр с зефирками выкупают всегда. За все смены не было ни одного исключения. И вот про него — отдельно.
        </p>
      </div>

      <!-- Финальный костёр и нити дружбы — фото + текст -->
      <div class="article-photo-row mb-12 grid grid-cols-1 md:grid-cols-[300px_1fr] gap-6 md:gap-8 items-start">
        <figure class="article-photo-frame mx-auto md:mx-0 w-full max-w-[300px] rounded-2xl overflow-hidden bg-slate-100 shadow-[0_18px_36px_rgba(15,23,42,0.18)]">
          <img
            src="/images/articles/koster-niti-druzhby.jpg"
            alt="Ритуал завязывания нитей дружбы у финального костра в АйДаКемп"
            loading="lazy"
            class="w-full h-auto block" />
          <figcaption class="px-3 py-2 text-[12px] leading-[1.4] text-slate-500 bg-white">
            Ритуал нитей дружбы у финального костра — для тех, с кем подружился за смену.
          </figcaption>
        </figure>
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
            <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
              Финальный костёр и нити дружбы
            </h2>
          </div>
          <p class="text-[16px] leading-[1.75] text-slate-600 mb-3">
            На финальный костёр скидывается весь лагерь. Вообще весь — не только один отряд. И покупают всегда: за все смены ни одного исключения.
          </p>
          <p class="text-[16px] leading-[1.75] text-slate-600 mb-3">
            Но самое важное здесь — не сам костёр и даже не зефирки. Самое важное — <strong>ритуал нитей дружбы</strong>. В последний вечер каждый завязывает разноцветные нити на запястье тем, с кем по-настоящему подружился за смену. Нить оставляют до тех пор, пока она сама не развяжется. Считается, что чем дольше держится — тем крепче дружба.
          </p>
          <p class="text-[16px] leading-[1.75] text-slate-600">
            И вот ради этого момента весь лагерь две недели копит. Не ради телефонов, не ради экспериментов. Ради того, чтобы в последний вечер всем вместе сидеть у огня и завязывать друг другу ниточки.
          </p>
        </div>
      </div>

      <!-- Section 4: Физические подарки -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Физические подарки — добавили со следующей смены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          После первого запуска стало понятно: не всем нужны коллективные ивенты. Кому-то ближе материальная история — то, что можно унести с собой.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          В магазине лагеря появились эксперименты — «вулкан», наборы для опытов, конструкторы. Цена 1 500–2 000 рублей за штуку. Раскупили всё.
        </p>
      </div>

      <!-- Section 5: Внутренняя экономика «снизу» — прайс на дверях -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Снизу появляется своя экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Мы придумали механику. Ребята придумали экономику поверх неё.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          На второй-третий день смены на дверях комнат появляются прайсы. Каждая комната — что-то предлагает за рубли. Как правило, услуги и цифровые штуки: <strong>моды для Minecraft</strong>, помощь в чём-то, доступ к чему-то редкому.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
