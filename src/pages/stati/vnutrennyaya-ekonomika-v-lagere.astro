<script>
  // Count-up анимация цифр в article-stats-card при попадании в viewport.
  // prefers-reduced-motion → сразу финальное значение, без анимации.
  (function(){
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stats = document.querySelectorAll('.article-stat[data-stat-num]');
    if (!stats.length) return;

    function animate(el: Element){
      const e = el as HTMLElement;
      const target = parseFloat(e.dataset.statNum || '0');
      const suffix = e.dataset.statSuffix || '';
      const valueEl = e.querySelector('.article-stat-value');
      if (!valueEl) return;
      if (reduceMotion) { (valueEl as HTMLElement).textContent = target + suffix; return; }
      const duration = 1400;
      const start = performance.now();
      function tick(now: number){
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        const cur = Math.round(target * eased);
        (valueEl as HTMLElement).textContent = (suffix === ' ч' ? cur.toString().replace(/^0$/, '0') : cur.toString()) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4, rootMargin: '0px 0px -40px 0px' });

    stats.forEach((s) => io.observe(s));

    const chartRows = document.querySelectorAll('.article-chart-row[data-chart-pct]');
    function animateChartRow(row: Element){
      const r = row as HTMLElement;
      const pct = parseFloat(r.dataset.chartPct || '0');
      const num = parseFloat(r.dataset.chartNum || '0');
      const fill = r.querySelector<HTMLElement>('.article-chart-fill');
      const numEl = r.querySelector<HTMLElement>('.article-chart-num');
      if (fill) fill.style.width = pct + '%';
      if (!numEl) return;
      if (reduceMotion) { numEl.textContent = num.toString().replace('.', ',') + ' ч'; return; }
      const duration = 1400;
      const start = performance.now();
      function tick(now: number){
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        const cur = (num * eased).toFixed(1);
        numEl!.textContent = cur.replace('.', ',') + ' ч';
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    const chartIo = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateChartRow(entry.target);
          chartIo.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3, rootMargin: '0px 0px -30px 0px' });
    chartRows.forEach((r) => chartIo.observe(r));
  })();
</script>
