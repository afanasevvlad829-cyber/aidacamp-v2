---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Хакатон в детском лагере", url: "/stati/hakaton-v-detskom-lagere", icon: "lightbulb", description: "Другой формат активности" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov", icon: "phone", description: "Как устроена среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программа смен" },
];
---

<Base
  title="Монополия в лагере: как телефонное время стало валютой — и дети сами от него отказались"
  description="Как в АйДаКемп устроена внутренняя экономика: 600 единиц в день — как в Монополии. Реальные истории: стартапер, финдир с 15 000 в конце, два телефона и шантаж. И почему запрет не работает."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere" />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Монополия в детском лагере: телефонное время как валюта — и дети сами от него отказываются | АйДаКемп",
      "description": "Как IT-лагерь АйДаКемп учит детей 7–15 лет финансовой грамотности через игровую экономику, где экранное время — ресурс с ценой. Опыт 6 лет, 1200+ детей.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-01",
      "dateModified": "2026-05-08",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое внутренняя экономика в детском лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Игровая система ресурсов, где дети зарабатывают «валюту» за выполнение заданий и тратят её на привилегии или возможности. Учит базовым принципам экономики: планирование, бюджет, приоритеты." }
        },
        {
          "@type": "Question",
          "name": "Как внутренняя экономика помогает детям?",
          "acceptedAnswer": { "@type": "Answer", "text": "Дети на практике понимают понятия «заработать», «потратить», «сэкономить». Геймификация мотивирует активнее участвовать в жизни лагеря и делает обучение экономике ненасильственным." }
        },
        {
          "@type": "Question",
          "name": "Используется ли внутренняя экономика в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. В АйДаКемп есть элементы игровой экономики: дети получают «монеты» за выполненные IT-задания и хакатон, тратят на дополнительные активности. Это повышает вовлечённость в программу." }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Монополия в детском лагере: как телефонное время стало валютой — и дети сами от него отказались"
    subtitle="Прожил день — получи 600 единиц. Как в Монополии проходишь круг — получаешь 200 рублей. Что происходит дальше — никто не планировал."
    imageBase="ekonomika-lagerya"
    imageAlt="Дети в лагере обсуждают внутреннюю экономику и распределение ресурсов"
    readTime="6 мин чтения"
    breadcrumbsLast="Внутренняя экономика в лагере"
    daryaQuote="Дочь вернулась и сама попросила лимит на телефон дома. Она сказала: «Мам, в лагере я поняла, что время — ресурс». Это был тот самый момент."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Intro: Монополия-крючок -->
      <div class="mb-10">
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-700 max-w-[720px] mb-4">
          Вы играли в Монополию? Тогда вы уже понимаете, как устроена наша экономика.
        </p>
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          В Монополии есть базовое правило: прошёл круг — получи 200 рублей. В российских правилах это именно так. Ты не заработал их, не победил кого-то. Просто прожил раунд — и вот они, твои 200 рублей. Распоряжайся.
        </p>
        <p class="text-[16px] md:text-[17px] leading-[1.75] text-slate-600 max-w-[720px]">
          В АйДаКемп то же самое. Прожил день — получи 600 игровых единиц. Это твои деньги. Никаких условий, никаких «заслужи сначала». Просто факт нового дня. Что с ними делать дальше — твой выбор.
        </p>

        <StatCallout
          value="600"
          label="игровых единиц за прожитый день — как 200 рублей в Монополии за пройденный круг."
          source="механика АйДаКемп"
          icon="cash-coin"
          tone="warn"
        />
      </div>

      <!-- VIDEO PLACEHOLDER 1: про монополию -->
      <div class="mb-10 rounded-2xl bg-slate-100 border border-slate-200 overflow-hidden">
        <div class="flex items-center gap-3 px-5 py-3 border-b border-slate-200 bg-white">
          <i class="bi bi-play-circle-fill text-orange-500 text-[18px]" aria-hidden="true"></i>
          <span class="text-[13px] font-semibold text-slate-700">Видео — место зарезервировано</span>
        </div>
        <div class="relative flex items-center justify-center bg-slate-200" style="aspect-ratio: 9/16; max-height: 560px;">
          <div class="text-center px-6">
            <i class="bi bi-camera-video text-[40px] text-slate-400 mb-3 block" aria-hidden="true"></i>
            <p class="text-[14px] font-medium text-slate-500">Видео: «Монополия в лагере»</p>
            <p class="text-[13px] text-slate-400 mt-1">Как дети впервые слышат про 600 единиц и что они с ними делают в первый час</p>
          </div>
        </div>
      </div>

      <!-- Section 1: Почему запрет не работает -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему запрет на телефоны не работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Многие лагеря забирают телефоны на входе. Сдай — получишь на выходе. Технически это работает. Психологически — нет.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Мы пробовали. Первые три дня проходили в тихом протесте. Когда телефон возвращали — дети бросались в него с удвоенной жадностью, как будто нагоняли упущенное. Ничего не менялось в голове. Ребёнок не начинал ценить живое общение — просто терпел до выдачи.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Поэтому мы пошли другим путём. Не забирать. Сделать дорогим.
        </p>
      </div>

      <!-- Section 2: Механика -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроена внутренняя экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          600 единиц в день — базовый доход. Одна минута экранного времени стоит 10 единиц. Значит, 60 минут телефона — это весь дневной бюджет. Но тратить всё на экран необязательно. Вот что ещё можно купить:
        </p>
        <ul class="flex flex-col gap-3 mb-6 max-w-[680px]">
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Вечер у костра</strong> (всей группой) — 5 000 единиц. При 12 людях каждый скидывается по 420. Остаётся 180 — это 18 минут телефона. Или не остаётся ничего, если уже потратил.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Отбой на час позже</strong> — 4 000 единиц. Ради этого подростки экономят два дня подряд.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Подарки из лагерного магазина</strong> — физические эксперименты, конструкторы, мерч. У каждого своя цена.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Ночь с телефонами</strong> — 8 000 единиц. При повторной покупке цена вырастает до 12 000. Дети быстро понимают, что такое убывающая отдача.</span></li>
        </ul>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-3">
          Бонусы за успехи в учёбе, инициативу, победы в конкурсах — до 200 дополнительных единиц в день. Штрафы за нарушения — от 200 до 500. Все балансы — на доске. Публично. Каждый видит, у кого сколько.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          И важное: участие добровольное. Можно просто пользоваться телефоном без всякой экономики. Примерно 10% выбирают этот путь. Но из неё выпадает — из социальной жизни группы тоже. Больше двух дней никто не продержался. Возвращали телефон сами.
        </p>
      </div>

      <!-- Section 3: Стихийная экономика — новый раздел -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что мы не планировали: стихийная экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Мы придумали механику. Дети придумали экономику поверх неё.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          На третий день смены, как правило, начинается рынок услуг. «Я помою за тебя посуду — ты отдашь мне 80 единиц». «Помогу с заданием по Python — 150». Кто-то предлагает «консультации» по тому, как заработать бонусы быстрее. Появляются первые предприниматели.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Потом начинается торговля из буфета. Сок, шоколадки — за игровую валюту. Один ребёнок покупает за реальные деньги, перепродаёт за игровые. Маржа небольшая, но логика абсолютно предпринимательская.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Несколько раз были случаи, когда дети пытались <em>привезти с собой</em> запас игровой валюты — напечатать или нарисовать заранее. И был прецедент с попыткой вскрыть сейф вожатых, где хранились банкноты. Серьёзных санкций не последовало — обсудили вечером, почему это не работает и что называется воровством.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Самое показательное: были случаи, когда дети покупали игровую валюту за реальные карманные деньги — у тех, кому единицы были не нужны. Именно поэтому мы советуем родителям: <strong>много карманных денег не давайте</strong>. Это часть обучения — жить на то, что заработал, а не докупать.
        </p>
      </div>

      <!-- Section 4: Три архетипа — главный новый раздел -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кем станет ваш ребёнок — видно уже на первый день
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-6">
          Мы наблюдаем детей уже несколько лет. И из года в год видим одни и те же модели поведения — чётче, чем в любом психологическом тесте.
        </p>

        <!-- Стартапер -->
        <div class="rounded-2xl border border-orange-200 bg-orange-50 p-5 mb-4 max-w-[680px]">
          <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-orange-600 mb-2">Архетип 1 — Стартапер</p>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Мальчик пришёл в первый же день, нашёл список подарков и сразу выбрал самый дорогой — химический эксперимент, «вулкан», несколько тысяч единиц. Денег на него не было. Он начал занимать у всех вокруг. Быстро набрал нужное, купил.
          </p>
          <p class="text-[16px] leading-[1.7] text-slate-700 mt-2">
            Когда его спросили зачем, он ответил примерно так: «Ну, я же хочу это прямо сейчас. А заработаю потом». Стопроцентная стартаперская логика. Сначала продукт — потом fundraising.
          </p>
        </div>

        <!-- Финдир -->
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-5 mb-6 max-w-[680px]">
          <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-600 mb-2">Архетип 2 — Финансовый директор</p>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Другой мальчик не потратил ни единицы. Копил весь лагерь. Когда группа скидывалась на костёр — он тихонько пристраивался рядом. Никто не выгонял. Он это знал и пользовался.
          </p>
          <p class="text-[16px] leading-[1.7] text-slate-700 mt-2">
            В последний день пришёл к руководителю смены с суммой в 15 000 единиц. «Что я могу купить?» — спросил он. К тому моменту все подарки разобраны, все активности куплены, народ давно скинулся на финальный костёр. Купить было уже нечего.
          </p>
          <p class="text-[16px] leading-[1.7] text-slate-700 mt-2">
            Это был горький, но важный урок. Никто его не организовывал специально. Никто не советовал и не предупреждал. Просто так получилось — в абсолютно безопасных условиях, где единственная потеря это 15 000 игровых единиц, а не реальные деньги и не годы жизни.
          </p>
        </div>

        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Ещё есть дети, которые становятся «центральными банками» — скупают долги, выдают кредиты, контролируют курс. Есть «венчурные инвесторы», которые вкладывают в чужие идеи в расчёте на долю с прибыли. Есть те, кто просто работает и тратит — стабильно, предсказуемо, без рисков.
        </p>
      </div>

      <!-- VIDEO PLACEHOLDER 2: про родителей -->
      <div class="mb-10 rounded-2xl bg-slate-100 border border-slate-200 overflow-hidden">
        <div class="flex items-center gap-3 px-5 py-3 border-b border-slate-200 bg-white">
          <i class="bi bi-play-circle-fill text-orange-500 text-[18px]" aria-hidden="true"></i>
          <span class="text-[13px] font-semibold text-slate-700">Видео — место зарезервировано</span>
        </div>
        <div class="relative flex items-center justify-center bg-slate-200" style="aspect-ratio: 9/16; max-height: 560px;">
          <div class="text-center px-6">
            <i class="bi bi-camera-video text-[40px] text-slate-400 mb-3 block" aria-hidden="true"></i>
            <p class="text-[14px] font-medium text-slate-500">Видео: «Родители и гаджеты — откупная стратегия»</p>
            <p class="text-[13px] text-slate-400 mt-1">Почему «купи-купи» работает против ребёнка и при чём здесь телефонное время</p>
          </div>
        </div>
      </div>

      <!-- Section 5: Два телефона -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Два телефона и шантаж — реальный кейс
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Некоторые дети, которые уже были в лагере и знают правила, приезжают с двумя телефонами. Один сдают. Второй прячут.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Соседи по комнате, конечно, видят. И начинается шантаж. «Или платишь — или сдаём вожатым». Откупная стоит, понятно, в игровой валюте. Человек платит день-два. Потом устаёт. И сам, без всякого давления взрослых, сдаёт второй телефон.
        </p>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px]">
          Важная оговорка: буллинг мы пресекаем жёстко. То, что описано выше — это дети, которые сами выстраивают систему давления внутри игровых правил. Граница тонкая, и за ней мы следим. Но когда всё остаётся в рамках «ты должен мне игровых денег» — это жизнь, а не насилие.
        </p>
      </div>

      <!-- Section 6: Бунт против системы -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            «Я бунтую против системы»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.75] text-slate-600 max-w-[720px] mb-4">
          Один мальчик несколько раз выкрадывал свой телефон из общего сейфа. Никакой особой причины — просто мог, и делал.
        </p>
