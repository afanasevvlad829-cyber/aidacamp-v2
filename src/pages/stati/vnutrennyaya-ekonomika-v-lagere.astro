---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov", icon: "phone", description: "Как устроена среда" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программа смен" },
  { title: "Купить путёвку в лагерь", url: "/kupit-putevku-v-lager", icon: "ticket-perforated", description: "Смены 2026" },
];
---

<Base
  title="Экранное время как валюта — почему участники сами отказываются от телефона"
  description="В АйДаКемп телефон не запрещают — его нужно купить за внутреннюю валюту. Как игровая экономика меняет отношение к ресурсам и почему ни один конкурент этого не делает."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Внутренняя экономика в детском лагере — как учат управлять ресурсами без нотаций | АйДаКемп",
      "description": "Как IT-лагерь АйДаКемп учит финансовой грамотности через игровую экономику, где экранное время — ресурс с ценой. Опыт 6 лет, 1200+ участников.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-01",
      "dateModified": "2026-05-08",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/vnutrennyaya-ekonomika-v-lagere"}
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое внутренняя экономика в детском лагере?",
          "acceptedAnswer": {"@type": "Answer", "text": "Игровая система ресурсов, где участники зарабатывают внутреннюю валюту за задания и тратят её на привилегии. Учит планированию, бюджету и умению расставлять приоритеты через живой опыт."}
        },
        {
          "@type": "Question",
          "name": "Почему телефон в АйДаКемп не запрещают, а продают?",
          "acceptedAnswer": {"@type": "Answer", "text": "Запрет вызывает протест и не меняет привычку. Когда за экранное время нужно платить внутренней валютой — каждый сам решает, стоит ли оно того. Практика показывает: большинство выбирают что-то интереснее."}
        },
        {
          "@type": "Question",
          "name": "Есть ли аналогичная система в других IT-лагерях?",
          "acceptedAnswer": {"@type": "Answer", "text": "Нет. Мы изучили десятки IT-лагерей в Подмосковье. Ни один не встроил в повседневную жизнь смены полноценную экономическую игру с валютой, балансами, штрафами и коллективными покупками."}
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Внутренняя экономика в лагере: как мы учим управлять ресурсами без нотаций"
    subtitle="Что происходит, когда экранное время перестаёт быть бесплатным — и почему участники сами отказываются от телефона."
    imageBase="ekonomika-lagerya"
    imageAlt="Участники лагеря обсуждают внутреннюю экономику и распределение ресурсов"
    readTime="6 мин чтения"
    breadcrumbsLast="Внутренняя экономика в лагере"
    daryaQuote="Дочь вернулась и сама попросила лимит на телефон дома. Она сказала: «Мам, в лагере я поняла, что время — ресурс». Это был тот самый момент."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Intro -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый родитель, отправляя ребёнка в лагерь, думает примерно одно и то же: «Хоть бы оторвался от телефона. Хоть бы пообщался с живыми людьми». Мы в АйДаКемп тоже об этом думали. А потом перестали запрещать и начали считать. И это изменило всё.
        </p>
        <StatCallout
          value="14 дней"
          label="смены достаточно для первого настоящего опыта «я зарабатываю, решаю, трачу»."
          source="наш формат"
          icon="calendar-week"
          tone="warn"
        />
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему запрет не работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Можно забрать телефон силой. Многие лагеря так делают — «сдайте гаджеты, получите на выходе». Ребята подчиняются, но внутри протестуют. Первые три дня — в тоске. Когда телефон возвращают — бросаются в него с удвоенной жадностью.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы пробовали. Работает технически, но не меняет ничего в голове. Не начинаешь ценить реальную жизнь — просто терпишь. Поэтому мы пошли другим путём. Мы не стали забирать телефоны. Мы сделали их <strong>дорогими</strong>.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроена внутренняя экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый участник смены получает ежедневный бюджет — 600 единиц внутренней валюты. Это его деньги. Он распоряжается ими сам. Одна минута экранного времени стоит 10 единиц. Значит, 600 единиц — это ровно 60 минут телефона. Можно потратить всё на экран. Можно — иначе.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Бонусы:</strong> за успехи в обучении, победы в конкурсах, инициативу — до 200 дополнительных единиц в день</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Штрафы:</strong> за нарушение дисциплины, беспорядок в комнате — от 200 до 500 единиц</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Все начисления и списания — прозрачны. Висят на доске. Каждый видит свой баланс и балансы остальных.
        </p>
      </div>

      <!-- Section 3 — коллективные покупки -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Коллективные покупки: здесь начинается настоящая экономика
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Внутреннюю валюту можно объединять. Группа скидывается — и покупает что-то для всех:
        </p>
        <ul class="flex flex-col gap-4 mb-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Вечер у костра</strong> — 5 000 единиц. Если в группе 12 человек — каждый скидывается по 420. Остаётся 180 единиц: 18 минут экрана. Или что-то ещё.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Киносеанс</strong> — 3 000 единиц. Доступнее, но всё равно требует коллективного решения.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Отбой на час позже</strong> — 4 000 единиц. Подростки готовы ради этого экономить два дня.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Ночь с телефонами</strong> — 8 000 единиц. Самый дорогой пункт. После первой покупки цена повторной вырастает до 12 000 — это закон убывающей отдачи, прожитый на своей шкуре.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Ещё есть мерч, сувениры, наборы для экспериментов — индивидуальные покупки от 1 800 до 4 800 единиц, то есть от трёх до восьми дней накоплений.
        </p>
      </div>

      <!-- VERTICAL VIDEO SLOT -->
      <div class="mb-8 rounded-[20px] bg-slate-100 border border-slate-200 overflow-hidden" style="aspect-ratio:9/16;max-width:360px;margin-left:auto;margin-right:auto;">
        <!-- TODO: вставить вертикальное видео (reels/shorts) про экономику лагеря -->
        <div class="flex flex-col items-center justify-center h-full gap-3 text-slate-400 p-6 text-center">
          <i class="bi bi-camera-video text-[40px]" aria-hidden="true"></i>
          <p class="text-[13px] leading-[1.5]">Место под вертикальное видео<br>о внутренней экономике лагеря</p>
        </div>
      </div>

      <!-- Section 4 — третий день -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что происходит на третий день
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На третий день мы наблюдаем один и тот же эффект. Перестают тратить всё на телефон. Не потому что запретили. А потому что появились вещи, которых хочется больше.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Кто-то копит на мерч. Кто-то агитирует всю группу скинуться на костёр. Кто-то ведёт переговоры: «Я сделаю за тебя уборку — ты дашь мне 100 единиц». Начинаются сделки, торги, коалиции.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Появляется и теневая экономика. Это не проблема — это обучающий момент. Мы не наказываем за попытки «взломать систему». Мы разбираем их вечером всей группой: «Что произошло? Где граница между предприимчивостью и манипуляцией? Если бы это была взрослая работа — что случилось бы?» Система регулирует сама себя. Группа сама начинает реагировать на тех, кто играет нечестно.
        </p>
      </div>

      <!-- Section 5 — что это даёт -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что это даёт на самом деле
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы не ставим себе цель «научить финансовой грамотности» в академическом смысле. Но за смену участники осваивают набор понятий, которые обычно преподают в старших классах или вузе:
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Бюджетирование.</strong> Каждый день — выбор: потратить сейчас или накопить на что-то большее. Через неделю импульсивные решения уходят сами.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Коллективные инвестиции.</strong> Скинуться на мероприятие — это буквально общий вклад. Нужно договориться, убедить, иногда пожертвовать своим ради общего результата.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Инфляция.</strong> Повторная «ночь с телефонами» стоит дороже. Не прочитано в учебнике — прочувствовано на своём балансе.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Управление рисками.</strong> Штраф может обнулить дневной бюджет. Учит считать последствия до действия.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Переговоры.</strong> Торговля услугами, обмен, аргументация — это навыки, которые невозможно «преподать» на уроке.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          И самое важное: всё это происходит добровольно. Ещё никто не продержался «вне игры» дольше одного дня.
        </p>
      </div>

      <!-- Section 6 — монополия -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Это «Монополия». Настоящая.
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Все знают «Монополию». Прошёл круг — получи 200 рублей. Попал на чужую клетку — заплати. Хочешь купить улицу — копи или торгуйся с соседом. Попал в тюрьму — сиди и смотри, как другие зарабатывают. Простые правила, за которыми можно просидеть до часа ночи — потому что каждое решение имеет последствие прямо сейчас.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Так вот. Каждый день в лагере — это новый круг. Прошёл день — получи 600 единиц. Нарушил дисциплину — заплати штраф. Хочешь вечер у костра — убеждай всю группу скидываться. Хочешь спать на час позже — копи два дня. Сделаешь за соседа уборку — он даст тебе 100 единиц. Один в один «Монополия». Только доску не убирают в коробку — в ней живёшь.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Но есть кое-что, чего нет ни в одной настольной игре. В «Монополии» деньги — просто картонные карточки. Они ценны только потому, что игроки договорились так считать. Доллар держится на мощи американской экономики. А чем обеспечена наша валюта?
        </p>
        <p class="text-[20px] md:text-[22px] font-bold text-slate-900 max-w-[720px] mb-5 leading-[1.3]">
          Экранным временем. Одна минута телефона — 10 единиц. Что может быть ценнее для подростка, который всю жизнь привык, что телефон просто лежит в кармане?
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Теперь он стоит денег. Настоящих — только в другой валюте. Именно это превращает игру в экономику: у валюты есть реальное обеспечение, которое каждый понимает на уровне рефлексов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы изучили десятки IT-лагерей в Подмосковье. Везде одно и то же: программирование, проект, сертификат. Ни один не встроил в повседневную жизнь смены живую экономику — с валютой, балансами, штрафами, торгами и теневым рынком, который возникает сам. Потому что это не придумывается за вечер. Оно растёт из шести лет смен — из ошибок, из наблюдений за тем, как именно группа начинает объединяться, конкурировать и договариваться.
        </p>
      </div>

      <!-- Section 7 — родители -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что говорят родители
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Чаще всего слышим одну и ту же фразу в разных вариациях: «Вернулся другим». Не в смысле «перестал сидеть в телефоне» — а в смысле «стал считать, думать, планировать».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Один папа написал после смены: впервые в жизни сам предложил вести семейный бюджет расходов на каникулы. Ему 11 лет. Другая мама: дочка перестала просить телефон каждые пять минут — не потому что испугалась, а потому что поняла, что есть вещи интереснее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          На Яндекс.Картах — более 40 отзывов с оценкой 5.0. И 60% участников возвращаются на следующую смену. Для лагеря — редкая цифра.
        </p>
