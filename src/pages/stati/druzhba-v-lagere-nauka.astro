---
import { Icon } from 'astro-icon/components';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Первый раз без мамы: что происходит с ребёнком на смене", url: "/stati/pervyy-raz-bez-mamy/", icon: "heart", description: "Тоска по дому и как она проходит" },
  { title: "Мозг без гаджетов: что происходит за 5 дней", url: "/stati/mozg-bez-gadgetov-v-lagere/", icon: "cpu", description: "Ещё исследования на тему цифрового детокса" },
  { title: "Как мир воспитывает самостоятельность", url: "/stati/kak-mir-vospityvaet-samostoyatelnost/", icon: "globe", description: "Финляндия, США, Китай — три разных ответа" },
];
---

<Base
  ogImage="/images/articles/og-druzhba-v-lagere-nauka.jpg"
  title="Дружба в лагере: почему она крепче школьной | АйДаКемп"
  description="Нейробиология привязанности и 7 столпов дружбы по Данбару объясняют, почему приятели со смены остаются на всю жизнь — и почему это не ностальгия, а наука. Разбираем исследования ACA о 40 000 участников, «боль как клей» Бастьяна и Йеттена и то, как устроена смена в Подмосковье, где друзья появляются сами."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="druzhba-v-lagere-nauka"
      title="Дружба в лагере: почему она крепче школьной"
      description="Нейробиология привязанности и 7 столпов дружбы по Данбару объясняют, почему приятели со смены остаются на всю жизнь — и почему это не ностальгия, а наука."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Дружба в лагере: почему она крепче школьной"
    subtitle="Нейробиология привязанности и 7 столпов дружбы по Данбару объясняют, почему приятели со смены остаются на всю жизнь — и почему это не ностальгия, а наука."
    breadcrumbsLast="Дружба в лагере"
    readTime="6 мин"
  />

  <main id="main-content" class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-8 pt-2">
          <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            96% находят приятелей — это не случайность
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Американская ассоциация ACA опросила более 40 000 участников: <strong>96% детей нашли новых приятелей.</strong> Это не совпадение, а конструкция среды — она проектирует дружбу.
        </p>
      </div>

      <div class="mb-8 pt-2">
          <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            7 столпов Данбара: 5–6 из них активны
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Антрополог Робин Данбар выделил <strong>7 условий крепкой дружбы</strong>. Школа активирует 2–3 из них, смена — 5–6.
        </p>
        <div class="space-y-2.5">
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-green-200 text-green-700 text-[14px] font-bold">1</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Совместный физический опыт</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-green-200 text-green-700 text-[14px] font-bold">2</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Общая история</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-green-200 text-green-700 text-[14px] font-bold">3</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Общие ценности</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-green-200 text-green-700 text-[14px] font-bold">4</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Контакт лицо к лицу</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-green-200 text-green-700 text-[14px] font-bold">5</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Преодоление трудностей вместе</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-amber-50 border border-amber-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-amber-200 text-amber-700 text-[14px] font-bold">6</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Общее чувство юмора</p>
              </div>
            </div>
          </div>
          <div class="rounded-[14px] bg-amber-50 border border-amber-200 p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white border border-amber-200 text-amber-700 text-[14px] font-bold">7</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14.5px] font-bold text-slate-900">Взаимная доброта и щедрость</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
          <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Наука о «боли как клее»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Психологи Бастьян и Йеттен (2014) показали: группы, прошедшие через общую трудность, доверяют партнёрам заметнее.
        </p>
      </div>

      <div class="mb-8 pt-2">
          <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему приятели со смены «остаются»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Две недели вместе 24 часа в сутки — это около <strong>336 часов живого контакта</strong>, столько же школьный год набирает за 180 учебных дней. Journal of Leisure Research (2024): навыки сохраняются и через 6 месяцев.
        </p>
      </div>

      <div class="mb-8 pt-2">
          <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Где ребёнок всё это проживёт
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На сменах в Подмосковье день выстроен вокруг совместных дел: походов, командных мероприятий, вечерних сборов у костра. Ребёнок проживает смену с одним отрядом, и дружба складывается сама.
        </p>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
