---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Все статьи о зависимостях", url: "/stati/zavisimost-u-detej", icon: "grid", description: "Полный гид по детским цифровым зависимостям" },
  { title: "Признаки компьютерной зависимости", url: "/stati/priznaki-kompyuternoj-zavisimosti", icon: "search", description: "Как понять что пора лечить" },
  { title: "Как избавиться от зависимости от игр", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", icon: "arrow-repeat", description: "Пошаговый план" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-x", description: "Среда без телефонов — смена" },
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];
---

<Base
  title="Как вылечить компьютерную зависимость — 3 шага без клиники и таблеток"
  description="Поход к психиатру — не первый шаг. Узнайте что реально работает: смена среды, замещение и новые интересы. Опыт 1200+ подростков из IT-лагеря без телефонов."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lechenie-kompyuternoj-zavisimosti" />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Лечение компьютерной зависимости у подростков — без клиники и таблеток | АйДаКемп",
      "description": "Психиатр не нужен. Что на самом деле лечит компьютерную зависимость: смена среды + замещение + новое окружение. Опыт 1200+ подростков.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-02-20",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/lechenie-kompyuternoj-zavisimosti"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Нужен ли врач при компьютерной зависимости у ребёнка?",
          "acceptedAnswer": { "@type": "Answer", "text": "В большинстве случаев нет. Клиническое вмешательство нужно при тяжёлых формах (агрессия, суицидальные мысли). В остальных случаях помогают: смена обстановки, альтернативные занятия, живое общение." }
        },
        {
          "@type": "Question",
          "name": "Как лечить компьютерную зависимость у ребёнка дома?",
          "acceptedAnswer": { "@type": "Answer", "text": "Главный принцип — замена, а не запрет. Создайте интерес в реальном мире: спорт, друзья, хобби. IT-лагерь — один из лучших способов: ребёнок продолжает работать с технологиями, но продуктивно." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени нужно чтобы преодолеть зависимость?",
          "acceptedAnswer": { "@type": "Answer", "text": "При планомерной работе — 1–3 месяца. Ключевое — не «выбить» технологии из жизни, а наполнить жизнь другим содержанием. Резкий запрет обычно приводит к обратному эффекту." }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лечение компьютерной зависимости у подростка"
    subtitle="Без клиники и психолога — что реально работает: смена среды + новое дело + окружение."
    imageBase="zavisimost-lechenie"
    imageAlt="Дети за ноутбуками на занятии — учёба становится собственным проектом"
    readTime="6 мин чтения"
    breadcrumbsLast="Лечение компьютерной зависимости"
    daryaQuote="Я долго искала психолога. Потом поняла: «лечение» игровой зависимости у подростка это не разговоры, а новая среда где есть другое дело. У дочери этим стал лагерь — не специально, а как побочный эффект."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Слово «лечение» обычно вызывает картинку белого халата, таблеток и клиники. В случае компьютерной зависимости у подростков всё иначе. ВОЗ официально включила «игровое расстройство» в МКБ-11 — но лечат его не медикаментами, а изменением условий жизни. Разберёмся что реально работает.
        </p>

        <StatCallout
          value="7+ часов"
          label="среднее экранное время российского подростка в день — главная причина цифровой зависимости."
          source="Mediascope, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нужен ли психиатр
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В 90% случаев — нет. Психиатр нужен если зависимость сопровождается депрессией, суицидальными мыслями, агрессией направленной на себя или других, или если за 3 месяца комплексных действий (смена среды + замещение + режим) нет никакого сдвига. В остальных случаях ребёнок хорошо реагирует на немедикаментозные методы — потому что физиологическая зависимость у подростков обратима в короткие сроки. Взрослый алкоголик «сохнет» месяцами. Подростковый мозг пластичен — меняется за недели.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что предлагают клиники и частные центры
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В Москве работает несколько центров «детокса от гаджетов». Средняя стоимость — 80–150 тыс. ₽ за 2–3 недели. Что там делают: индивидуальный психолог (1–2 раза в неделю), групповая терапия, режим дня, спорт, иногда прогулки. Результат — смешанный. Плюс: реально структурированная среда. Минус: стерильная атмосфера, ребёнок чувствует себя «пациентом», после возвращения домой эффект быстро тает.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Альтернатива — IT-лагерь как место терапии. Звучит парадоксально: отправить зависимого от компьютера в место где компьютеры. Но разница в контексте: здесь экран — не развлечение, а инструмент создания. Ребёнок перестаёт быть потребителем контента и становится автором. Это и есть переворот отношений с экраном. <a href="/ceny" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Посмотреть даты и цены смен 2026 →</a>
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Рабочая схема — что делать по шагам
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Готовая последовательность, которая работает у большинства подростков 11–14 лет при трёх и более признаках зависимости:
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Неделя 1–2. Мотивирующая беседа и смена правил.</strong> Не «я тебя отключу», а «давай попробуем по-новому». Телефоны уходят из спальни. Экранное время обсуждается, не прячется. Родители сами соблюдают правила.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Неделя 3–4. Смена среды на 10–14 дней.</strong> Летом — выездной лагерь. Зимой — лыжная база, кемп выходного дня. Главное — физическое отключение от привычного места с компьютером.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Неделя 5–8. Закрепление новой идентичности.</strong> После возвращения — новая активность 2–3 раза в неделю (спорт, творчество, проект). Ребёнок уже не «только геймер», он — «и ещё» что-то.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Месяцы 3–6. Ретест.</strong> Проверка что признаки зависимости ушли. Если да — закрепляем правила как образ жизни семьи. Если нет — консультация психолога + пересмотр шагов.</span>
          </li>
        </ul>
      </div>

        <StatCallout
          value="~46%"
          label="подростков онлайн «почти всё время» — формальных игр мало, но экран постоянно в руке."
          source="Pew Research, 2024"
          icon="emoji-frown"
          tone="neutral"
        />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Статистика — что происходит у наших подростков
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          По итогам опросов родителей через 3 месяца после смены:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700"><strong>73%</strong> отмечают что ребёнок стал спокойнее относиться к ограничениям экранного времени</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700"><strong>68%</strong> говорят что ребёнок начал новое увлечение (программирование, спорт, творчество)</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-green-400"></span><span class="text-[16px] text-slate-700"><strong>55%</strong> отмечают улучшение успеваемости в школе</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>27%</strong> сообщают что ребёнок возвращается к старым привычкам без поддержки изменений в семье</span></li>
        </ul>
        <p class="text-[13px] text-slate-400 mt-4">Опрос проведён среди 412 родителей детей 11–14 лет, прошедших смены АйДаКемп в 2023–2025. Внутренние данные.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что именно делает АйДаКемп лагерем «без зависимости»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ни запретов, ни лекций, ни психолога на каждом шагу. Вместо этого — 3 встроенных механизма:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Экранное время — валюта.</strong> Хочешь играть — покупай внутренней валютой. Стимул учиться её зарабатывать = учиться быть продуктивным.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Проект за смену.</strong> В конце ребята защищают свою работу на хакатоне. Первый раз в жизни получают результат, сравнимый с «я прошёл игру» — но за который хвалят взрослые, а не тиммейты в чате.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Живое сообщество.</strong> 20–30 таких же подростков с таким же бэкграундом. Все 14 дней — общение вживую без буфера экрана.</span></li>
        </ul>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Помогает ли лагерь при зависимости от гаджетов?</p>
        <p class="mt-2 text-[15px] text-[#0d1a2b]/70">В АйДаКемп телефоны сдают при заезде. За 10 дней без гаджетов дети сами начинают общаться, делать что-то руками и... забывают про телефон. 60% просятся обратно в следующую смену.</p>
        <a href="/lager-bez-telefonov" class="mt-4 inline-block rounded-xl bg-primary px-6 py-3 text-[15px] font-semibold text-white hover:bg-[#d67000] transition-colors">Узнать про лагерь без телефонов</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-[14px] font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/stati/zavisimost-u-detej" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Все статьи о детских зависимостях — полный гид
          </a>
          <a href="/stati/kak-izbavitsya-ot-zavisimosti-ot-igr" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Как избавиться от зависимости от игр — 5 шагов
          </a>
          <a href="/stati/profilaktika-kompyuternoj-zavisimosti" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Профилактика компьютерной зависимости — 7 правил семьи
          </a>
          <a href="/lager-bez-telefonov" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Лагерь без телефонов — как работает детокс
          </a>
        </div>
      </div>

    </article>
  </main>
  <ArticleBottomCta
    bookingTitle="Сменим среду — зависимость растворится"
    bookingSubtitle="Оставьте телефон — перезвоним за 10 минут, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
