    align-items: flex-start;
    background: #fdf6ec;
    border-left: 4px solid #f59e0b;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    margin: 1.5rem 0;
    gap: 0.75rem;
  }
  .checklist-section {
    background: #f9fafb;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid #3b82f6;
  }
  .checklist-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .checklist-header h3 { font-size: 1.1rem; font-weight: 700; margin: 0; }
