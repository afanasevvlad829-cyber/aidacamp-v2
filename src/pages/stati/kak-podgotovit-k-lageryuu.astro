    margin-top: 1.5rem;
  }
  .things-tip strong { display: block; margin-bottom: 0.35rem; }
  .farewell-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }
