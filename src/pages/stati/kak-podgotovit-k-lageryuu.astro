---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Первый раз без мамы: что происходит с ребёнком в лагере", url: "/stati/pervyy-raz-bez-mamy/", icon: "house-heart", description: "Что чувствует ребёнок в первые дни разлуки" },
  { title: "Ребёнок не хочет ехать в лагерь: что делать маме", url: "/stati/rebenok-ne-khochet-v-lager/", icon: "chat-dots", description: "Разбираем частый родительский страх" },
  { title: "Топ-5 родительских страхов перед лагерем", url: "/stati/strakhi-pered-lagerem/", icon: "shield-exclamation", description: "Что тревожит родителей чаще всего" },
];
---

<Base
  title="Как подготовить ребёнка к лагерю: полный чеклист | АйДаКемп"
  description="Психологическая, физическая подготовка, документы и список вещей — всё что нужно за 4 недели до отъезда. С научными данными о том, что реально снижает тревогу."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="kak-podgotovit-k-lageryuu"
      title="Как подготовить ребёнка к лагерю: полный чеклист"
      description="Психологическая, физическая подготовка, документы и список вещей — всё что нужно за 4 недели до отъезда. С научными данными о том, что реально снижает тревогу."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как подготовить ребёнка к лагерю: полный чеклист"
    subtitle="Психологическая, физическая подготовка, документы и список вещей — всё что нужно за 4 недели до отъезда. С научными данными о том, что реально снижает тревогу."
    breadcrumbsLast="Подготовка к лагерю"
    readTime="8 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="83" unit="%" label="детей испытывают тоску хотя бы один день — это нормально" tone="orange" size="lg" />
          <AnimatedStat value="7" label="факторов, которые снижают стресс адаптации по данным науки" tone="green" size="lg" />
          <AnimatedStat value="90" label="дней — срок действия справки 079/у" tone="blue" size="lg" />
          <AnimatedStat value="3" label="дня — нормальный период адаптации у большинства" tone="slate" size="lg" />
        </div>
      </div>

      <!-- Что наука говорит -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что наука говорит о подготовке
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Исследователь Кристофер Тёрбер (Christopher Thurber) двадцать лет изучал тоску по дому у детей в лагерях. Его вывод: <strong>7 факторов снижают стресс адаптации</strong> — и большинство из них происходят до отъезда, а не в лагере. Ключевые: участие ребёнка в выборе лагеря, опыт ночёвок вне дома, предварительная информация о среде лагеря и — самое важное — спокойствие родителя.
        </p>
        <div class="rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <div class="flex items-start gap-3">
            <i class="bi bi-lightbulb-fill text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-700">
              Исследование ACA на 275 детях: тревожность родителя — <strong>независимый предиктор тоски по дому у ребёнка</strong>. Дети тревожных родителей показали тоску 2.53 vs 1.76 у детей спокойных родителей. Разница значимая (p&lt;0.05).
            </p>
          </div>
        </div>
      </div>

      <!-- За 4 недели: психологическая подготовка -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            За 4 недели: психологическая подготовка
          </h2>
        </div>

        <div class="space-y-4">
          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-people-fill text-blue-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-800">Вовлеките ребёнка в выбор</p>
            </div>
            <div class="space-y-2">
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Просматривайте сайт и фото лагеря <em>вместе</em> — пусть задаёт вопросы</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Дайте ей/ему выбрать: какую смену, какое направление</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Обсуждайте программу конкретно: «вот здесь будет хакатон, а это — вечерний костёр»</p>
              </div>
            </div>
            <p class="mt-3 text-[13px] leading-[1.5] text-slate-500 italic bg-white rounded-[8px] p-3">Почему это работает: участие в выборе создаёт ощущение контроля. Дети, которые сами выбрали лагерь, адаптируются быстрее — это доказано в нескольких исследованиях.</p>
          </div>

          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-house text-green-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-800">Практикуйте ночёвки вне дома</p>
            </div>
            <div class="space-y-2">
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Ночёвка у бабушки или у подруги — сначала одна ночь, потом две</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Каждый успешный опыт снижает тревогу перед лагерем</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Если ребёнок никогда не ночевал вне дома — двухнедельный лагерь слишком большой шаг</p>
              </div>
            </div>
            <p class="mt-3 text-[13px] leading-[1.5] text-slate-500 italic bg-white rounded-[8px] p-3">Это самая доказательно обоснованная превентивная мера по данным Тёрбера. Мозг учится на опыте: «я уже разлучался и всё было хорошо».</p>
          </div>

          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-chat-dots text-purple-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-800">Честный разговор о разлуке</p>
            </div>
            <div class="space-y-2">
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">«Мы не увидимся N дней. Я буду скучать по тебе — и при этом у тебя будет много интересного»</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">Дайте конкретику по дате: «В воскресенье 20 июля я буду ждать тебя у ворот»</p>
              </div>
              <div class="flex gap-3 items-start">
                <i class="bi bi-check2 text-orange-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[14px] leading-[1.6] text-slate-600">НЕ говорите «не волнуйся» или «всё будет хорошо» — это обесценивает эмоцию и не даёт стратегии</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- За 2 недели: инструменты совладания -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            За 2 недели: инструменты совладания
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4">
            <i class="bi bi-activity text-blue-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-800 mb-1.5">Техника «квадратного дыхания»</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Вдох 3 сек — пауза 3 — выдох 3 — пауза 3. Научите и назовите «секретным способом успокоиться ночью». Подростки тоже берут — просто под другим названием.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4">
            <i class="bi bi-journal-bookmark text-orange-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-800 mb-1.5">«Дневник страхов»</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Слева — страх («А вдруг меня не возьмут в команду?»), справа — рациональный ответ («В лагере специально делают игры на знакомство, вожатые помогут»). Работает с 8 лет.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4">
            <i class="bi bi-chat-quote-fill text-green-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-800 mb-1.5">Совместный план действий</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">«Если станет совсем грустно — что будешь делать?» Пусть ребёнок сам придумает: написать тебе, поговорить с вожатым, пойти к подруге. Его план, не твой — работает лучше.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4">
            <i class="bi bi-envelope text-red-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-800 mb-1.5">Письмо-сюрприз</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Напишите тёплое письмо заранее и положите в чемодан — ребёнок найдёт при разборе вещей уже в лагере. Положите конверты и марки «для ответа». Создаёт связь с первого дня.</p>
          </div>
        </div>
      </div>

      <!-- За 1 неделю: режим и физподготовка -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            За 1 неделю: режим и физподготовка
          </h2>
        </div>
        <div class="space-y-3">
          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-center gap-2 mb-2.5">
              <i class="bi bi-moon-stars-fill text-blue-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-800">Режим сна</p>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600 mb-2">Стандартный подъём в лагере — 8:00, отбой — 22:00–22:30. Если ребёнок привык ложиться в полночь — первые дни в лагере будут вдвойне тяжёлыми. Начните перестройку режима: сдвигайте отбой на 15–20 минут раньше каждые 2 дня.</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Самый тяжёлый момент тоски по дому — вечер перед сном. Отработайте дома вечерний ритуал (чтение, разговор) и попросите ребёнка воспроизводить его в лагере самостоятельно.</p>
          </div>
          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-center gap-2 mb-2.5">
              <i class="bi bi-person-arms-up text-green-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-800">Физическая активность</p>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Если весь учебный год ребёнок малоактивен — резкое увеличение нагрузки в лагере даст усталость и раздражительность в первые дни, что усугубит адаптацию. Начните прогулки, велосипед, плавание за 2–3 недели — постепенно.</p>
          </div>
        </div>
      </div>

      <!-- Документы -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Документы: что нужно собрать
          </h2>
        </div>
        <div class="space-y-3">
          <div class="rounded-[16px] bg-blue-50 border-2 border-blue-200 p-5">
            <div class="flex items-start gap-3">
              <i class="bi bi-clipboard-check text-blue-600 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-bold text-slate-800 mb-1.5">Справка 079/у</p>
                <p class="text-[14px] leading-[1.6] text-slate-600 mb-3">Главный документ. Действует 90 дней. С 2025 года — обновлённый бланк. Содержит: прививки, хронические диагнозы, аллергии, медицинская группа. Получить у школьной медсестры (1 день, бесплатно) или в поликлинике (2–3 дня).</p>
                <div class="space-y-1.5">
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-emerald-600 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-emerald-700">Кал на энтеробиоз (срок: 10 дней)</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-emerald-600 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-emerald-700">Проба Манту / диаскинтест (не старше 1 года)</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-emerald-600 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-emerald-700">Справка об отсутствии контактов с инфекционными больными</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-start gap-3">
              <i class="bi bi-list-check text-green-600 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-bold text-slate-800 mb-2">Остальные документы</p>
                <div class="space-y-1.5">
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-orange-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-slate-600">Полис ОМС (оригинал)</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-orange-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-slate-600">Свидетельство о рождении (до 14 лет) или паспорт</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-orange-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-slate-600">Паспорт родителя при регистрации</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-orange-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-slate-600">Фото 3×4 (2–3 штуки — уточняйте у лагеря)</p>
                  </div>
                  <div class="flex gap-2 items-start">
                    <i class="bi bi-check2 text-orange-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                    <p class="text-[13px] leading-[1.5] text-slate-600">Прививочный сертификат (копия)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
            <div class="flex items-start gap-3">
              <i class="bi bi-capsule text-red-600 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-bold text-slate-800 mb-1.5">Если принимает лекарства</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Лекарства хранятся в медпункте лагеря, не в комнате. Нужно: рецепт с указанием дозировки и кратности, письменное разрешение родителей. Обязательно предупредить вожатого и медпункт об аллергиях лично в день заезда.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Список вещей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Список вещей: что брать и что оставить дома
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-[16px] bg-green-50 border border-green-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-bag-check text-green-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-green-800">Брать с собой</p>
            </div>

            <div class="mb-3">
              <div class="flex items-center gap-1.5 mb-1.5">
                <i class="bi bi-person text-slate-500 text-[13px]" aria-hidden="true"></i>
                <p class="text-[12.5px] font-bold text-slate-700">Одежда</p>
              </div>
              <p class="text-[13px] leading-[1.6] text-slate-600">Футболки — 7–10 штук; длинный рукав — 3–4 (вечер, прохлада); худи/свитер — 1–2; дождевик — обязательно; купальник/плавки — 2 комплекта; нарядный комплект для вечерних мероприятий; нижнее бельё — 7–10 пар; пижама — 2 комплекта.</p>
            </div>
            <div class="mb-3">
              <div class="flex items-center gap-1.5 mb-1.5">
                <i class="bi bi-bag text-slate-500 text-[13px]" aria-hidden="true"></i>
                <p class="text-[12.5px] font-bold text-slate-700">Обувь</p>
              </div>
              <p class="text-[13px] leading-[1.6] text-slate-600">Разношенные кроссовки (не новые!); сандалии или кеды; шлёпки для душа/бассейна; тапочки домашние.</p>
            </div>
            <div class="mb-3">
              <div class="flex items-center gap-1.5 mb-1.5">
                <i class="bi bi-droplet-fill text-slate-500 text-[13px]" aria-hidden="true"></i>
                <p class="text-[12.5px] font-bold text-slate-700">Гигиена и уход</p>
              </div>
              <p class="text-[13px] leading-[1.6] text-slate-600">Полотенца: банное + пляжное; солнцезащитный крем SPF 30+; средство от насекомых; зубная щётка + паста, шампунь, мыло; влажные салфетки, антисептик.</p>
            </div>
            <div>
              <div class="flex items-center gap-1.5 mb-1.5">
                <i class="bi bi-heart-fill text-slate-500 text-[13px]" aria-hidden="true"></i>
                <p class="text-[12.5px] font-bold text-slate-700">Личное</p>
              </div>
              <p class="text-[13px] leading-[1.6] text-slate-600">Бутылка для воды (обязательно); книга, блокнот, ручки; небольшой «якорь» — семейное фото.</p>
            </div>
          </div>

          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-x-circle text-red-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-red-800">Оставить дома</p>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13px] leading-[1.5] text-slate-600"><strong>Дорогая брендовая одежда</strong> — лагерь не несёт ответственности за потери</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13px] leading-[1.5] text-slate-600"><strong>Планшеты и ноутбуки</strong> — все источники единогласно против</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13px] leading-[1.5] text-slate-600"><strong>Скоропортящиеся продукты</strong> из дома</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13px] leading-[1.5] text-slate-600"><strong>Новая обувь</strong> — мозоли в первые дни усугубят адаптацию</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13px] leading-[1.5] text-slate-600"><strong>Слишком много обуви</strong> — 3–4 пары максимум</p>
              </div>
            </div>
            <div class="rounded-[12px] bg-white p-4">
              <i class="bi bi-phone-x text-orange-500 text-[18px] mb-1.5 block" aria-hidden="true"></i>
              <p class="text-[13.5px] font-bold text-slate-800 mb-1">Телефон — отдельный вопрос</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Если берёте — простой кнопочный для звонков, без интернета. Смартфон снижает социализацию: ребёнок уходит в экран вместо общения с отрядом. Лагерь не несёт ответственности за гаджеты.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- День отъезда -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День отъезда: главное правило
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Все исследования по сепарационной тревоге сходятся в одном: <strong>чем дольше родитель «колеблется» у автобуса, тем дольше ребёнок плачет</strong>. Прощание должно быть тёплым, конкретным и коротким.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-[16px] bg-green-50 border border-green-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-check-circle text-green-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-green-800">Делайте</p>
            </div>
            <div class="space-y-2">
              <div class="flex gap-2 items-start">
                <i class="bi bi-check2 text-green-500 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Конкретная дата встречи: «В воскресенье в 14:00 я буду у ворот»</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-check2 text-green-500 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Тактильный «якорь»: небольшой предмет «от мамы» в карман</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-check2 text-green-500 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Уйдите уверенно после объятий — без повторных возвратов</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-check2 text-green-500 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Предупредите вожатого о тревожности ребёнка заранее</p>
              </div>
            </div>
          </div>
          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5">
            <div class="flex items-center gap-2 mb-3">
              <i class="bi bi-x-circle text-red-600 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-red-800">Не делайте</p>
            </div>
            <div class="space-y-2">
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Не кричите вдогонку инструкции — это создаёт образ опасного мира</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Не плачьте на виду у ребёнка у автобуса</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Не говорите «если что — сразу заберём»</p>
              </div>
              <div class="flex gap-2 items-start">
                <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
                <p class="text-[13.5px] leading-[1.55] text-slate-600">Не принимайте решение «забрать» в первые 3–5 дней без объективных причин</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="rounded-[16px] bg-green-50 border border-green-200 p-6 text-center">
          <i class="bi bi-shield-check text-green-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            <strong>Три объективные причины для досрочного возвращения:</strong> подтверждённый буллинг, болезнь, физическое насилие. «Скучает» и «не хочет тут быть» — рабочий материал адаптации, не повод забирать.
          </p>
        </div>
      </div>

