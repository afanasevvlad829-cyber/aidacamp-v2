  .things-leave { background: #fef2f2; border-radius: 1rem; padding: 1.5rem; }
  .things-category { margin-top: 1rem; }
  .things-cat-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: #374151;
    display: flex;
