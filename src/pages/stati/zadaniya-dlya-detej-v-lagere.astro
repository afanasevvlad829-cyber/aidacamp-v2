---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Программа смены", url: "/stati/programma-it-lagerya", icon: "calendar-week", description: "Как устроен день в АйДаКемп" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-detskom-lagere", icon: "trophy", description: "Главное событие смены" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "rocket-takeoff", description: "Программа 12–16 лет" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Дети реально делают проекты в лагере или только играют?",
    answer: "Реально делают. Каждая смена заканчивается хакатоном — публичной защитой проекта перед жюри. За 7–10 дней команды делают игру на Python, телеграм-бота или сайт. Это не «поделочка» — это рабочий код, который можно показать друзьям и добавить в портфолио."
  },
  {
    question: "Сколько часов в день занимают IT-задания?",
    answer: "Около 4–5 часов в день — два блока по 90 минут: утром и вечером после ужина. Остальное время: спорт, бассейн, вечерние игры и командные активности. IT-блоки чередуются с физической активностью, поэтому ребята не устают."
  },
  {
    question: "Подходят ли задания для детей без опыта в программировании?",
    answer: "Да, специально подобраны задания для разного уровня. Новички начинают с визуального программирования и простых скриптов. Те, кто уже знает основы — переходят к более сложным задачам. В каждой команде есть разные уровни, и это норм — старшие помогают младшим, это тоже часть программы."
  },
  {
    question: "Каждый раз задания разные или одинаковые из смены в смену?",
    answer: "Основа программы повторяется, но конкретные задачи и тема хакатона — каждый раз новые. Ребята, которые едут во второй раз, получают задания сложнее, и их команды иногда берут роль менторов для новичков. Поэтому второй лагерь не повтор, а следующий уровень."
  },
  {
    question: "Как задания связаны с реальной IT-работой?",
    answer: "Напрямую. «Взломай пароль» — это перебор вариантов, как в настоящем пентесте. «Телеграм-бот за 2 часа» — это работа с API, как у бэкенд-разработчиков. «Стартап за день» — это питч идеи, как в настоящих акселераторах. Мы специально используем формат «задача из реальной жизни» — потому что это мотивирует сильнее, чем учебные упражнения."
  }
];
---

<Base
  title="Задания и игры для детей в лагере — 20 идей от вожатых АйДаКемп"
  description="20 конкретных заданий и игр которые используются в IT-лагере АйДаКемп: IT-квесты, командные активности, вечерние игры. Рассказывают вожатые."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/zadaniya-dlya-detej-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Задания и игры для детей в лагере — 20 идей от вожатых АйДаКемп",
        "description": "20 конкретных заданий и игр которые используются в IT-лагере АйДаКемп: IT-квесты, командные активности, вечерние игры.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/zadaniya-dlya-detej-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Задания и игры для детей в лагере", "item": "https://aidacamp.ru/stati/zadaniya-dlya-detej-v-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="20 заданий и игр для детей в лагере — что делают в АйДаКемп"
    subtitle="Делимся реальными активностями из наших смен — от кодовых квестов до вечерних турниров."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети работают в команде на IT-занятии в лагере"
    readTime="6 мин чтения"
    breadcrumbsLast="Задания и игры в лагере"
    daryaQuote="Лагерь — это не просто «уехать на лето». Дочь возвращается с новыми друзьями и реальным проектом в руках. Именно для этого мы и придумали эти задания."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Родители часто спрашивают: «А что там реально происходит? Это не просто сидят за компьютерами целый день?» Нет. Вот честный список того, что дети делают каждый день — от утреннего кода до вечерних игр.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            IT-задания и кодовые квесты
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это ядро программы. Задания подбираются под уровень: новичкам — вход без боли, опытным — реальный вызов.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">1</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Взломай пароль»</span>
              <p class="text-[15px] text-slate-600 mt-1">Командная игра: нужно написать скрипт, который перебирает варианты пароля. Учит циклы и логику — весело и без скуки учебника.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">2</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Квест «Найди баг»</span>
              <p class="text-[15px] text-slate-600 mt-1">Вожатый намеренно ломает код. Ребята ищут ошибку за время. Победитель — кто нашёл первым и объяснил почему.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">3</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Телеграм-бот за 2 часа»</span>
              <p class="text-[15px] text-slate-600 mt-1">Задача: сделать работающего бота с нуля до обеда. Вожатый объясняет API, потом команды делают сами. Кайф — когда бот отвечает на твои сообщения.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">4</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Стартап за день»</span>
              <p class="text-[15px] text-slate-600 mt-1">Команда придумывает идею приложения, рисует интерфейс и защищает перед «инвесторами» (вожатыми). Учит презентовать идеи — не хуже взрослых питчей.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">5</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Марафон алгоритмов</span>
              <p class="text-[15px] text-slate-600 mt-1">10 задач на скорость — сортировки, поиск пути, работа со списками. Атмосфера как на спортивных соревнованиях: таймер, очки, победители.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">6</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Нейросеть рисует, ты угадываешь»</span>
              <p class="text-[15px] text-slate-600 mt-1">Детям показывают результаты нейросетей — рисунки, тексты, голоса. Задача: угадать, что просили нейросеть сделать. Потом сами пробуют промпты.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Командные игры на улице
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После блока за компьютером — выход на улицу. Это обязательная часть дня, не опция.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 font-bold text-[14px] shrink-0 mt-0.5">7</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Шифр на полосе»</span>
              <p class="text-[15px] text-slate-600 mt-1">Команды проходят полосу препятствий, на каждом этапе — зашифрованное задание. Расшифровал — получи подсказку к следующему. Финал: ключ от «сундука».</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 font-bold text-[14px] shrink-0 mt-0.5">8</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Захват флага «Код vs Спорт»</span>
              <p class="text-[15px] text-slate-600 mt-1">Классический capture the flag — только флаги защищены кодовыми замками. Чтобы пройти — нужно решить логическую задачу.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 font-bold text-[14px] shrink-0 mt-0.5">9</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Живой робот»</span>
              <p class="text-[15px] text-slate-600 mt-1">Один из команды — «робот»: стоит с завязанными глазами. Остальные дают команды только словами: «шаг вперёд», «повернись на 90°». Задача: провести через полосу. Учит давать точные инструкции — прямо как в программировании.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 font-bold text-[14px] shrink-0 mt-0.5">10</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Спортивный хакатон</span>
              <p class="text-[15px] text-slate-600 mt-1">Волейбол, бадминтон, эстафета — в зависимости от интереса отряда. Не обязательный для всех, но почти всегда собирает полный двор.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вечерние активности
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После ужина — время для общения и игр без гаджетов. Именно здесь рождается настоящая дружба.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 font-bold text-[14px] shrink-0 mt-0.5">11</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Мафия для программистов»</span>
              <p class="text-[15px] text-slate-600 mt-1">Классическая мафия с ролями из IT-мира: хакер, антивирус, системный администратор. Дети в восторге от тематических ролей.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 font-bold text-[14px] shrink-0 mt-0.5">12</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Кино под открытым небом</span>
              <p class="text-[15px] text-slate-600 mt-1">Раз в смену — показ фильма на большом экране на улице. Голосование за фильм — отдельное событие.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 font-bold text-[14px] shrink-0 mt-0.5">13</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Что? Где? Когда?» про технологии</span>
              <p class="text-[15px] text-slate-600 mt-1">Командная игра: вопросы про историю интернета, известные стартапы, гаджеты. Без зубрёжки — просто интересно.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 font-bold text-[14px] shrink-0 mt-0.5">14</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Дискотека и творческий вечер</span>
              <p class="text-[15px] text-slate-600 mt-1">Середина смены — традиционная дискотека. Дети сами выбирают плейлист через внутренний голосовалку-бот (который сами и написали).</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 font-bold text-[14px] shrink-0 mt-0.5">15</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Настольные игры по интересам</span>
              <p class="text-[15px] text-slate-600 mt-1">Каждый вечер в общем зале — шахматы, «Имаджинариум», «Колонизаторы», карты. Без обязаловки, по желанию.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Специальные события смены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Есть задания, которые происходят раз за смену — и именно их дети вспоминают потом годами.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 font-bold text-[14px] shrink-0 mt-0.5">16</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Большой хакатон (финал смены)</span>
              <p class="text-[15px] text-slate-600 mt-1">48 часов работы над финальным проектом. Команды защищают его перед жюри — публично, как настоящий стартап. Родители могут смотреть онлайн.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 font-bold text-[14px] shrink-0 mt-0.5">17</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«День профессии»</span>
              <p class="text-[15px] text-slate-600 mt-1">Гость из IT-индустрии рассказывает про свою работу. Дети задают любые вопросы — включая «сколько получаешь» и «правда что можно работать из дома».</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 font-bold text-[14px] shrink-0 mt-0.5">18</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Ночной квест</span>
              <p class="text-[15px] text-slate-600 mt-1">Один раз за смену — приключение после отбоя. Задания по всей территории, фонарики, командная работа в темноте. Легендарное событие каждой смены.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 font-bold text-[14px] shrink-0 mt-0.5">19</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Экономика лагеря»</span>
              <p class="text-[15px] text-slate-600 mt-1">Дети зарабатывают внутреннюю валюту — «айдакоины» — за задания, помощь, активность. Тратят на экранное время, бонусы, призы. Настоящая симуляция экономики.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 font-bold text-[14px] shrink-0 mt-0.5">20</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">«Презентация себя»</span>
              <p class="text-[15px] text-slate-600 mt-1">В конце смены каждый делает короткий рассказ: что узнал, что получилось, что хочет попробовать дальше. Не оценивается — просто рефлексия вслух. Родители потом говорят, что не узнают ребёнка — он говорит уверенно и по делу.</p>
            </div>
          </li>
        </ul>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
