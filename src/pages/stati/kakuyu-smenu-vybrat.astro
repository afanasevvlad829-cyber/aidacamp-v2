---
import { PRICE_MIN, DATES_S3, DATES_S4, PRICE_S3, PRICE_S4 } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';
import DonutChart from '../../components/DonutChart.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Периоды смен: 1, 2 и 3 смена", url: "/stati/periody-smeny-v-lagere/", icon: "calendar-week", description: "Чем заезды отличаются на самом деле" },
  { title: "Как устроен день в лагере", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "calendar-week", description: "Как устроен день ребят" },
  { title: "Цены 2026", url: "/ceny/", icon: "coin", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "Чек-лист для мамы" },
  { title: "Кому не подходит АйДаКемп", url: "/stati/komu-ne-podhodit-lager/", icon: "chat-heart", description: "Честный список от основателя" },
];

const faqItems = [
  {
    question: "Смены отличаются друг от друга по теме или программе?",
    answer: "Нет. В АйДаКемп нет «смены по Minecraft» и «смены по Python» — программа с ИИ, хакатоном и игровой экономикой лагеря одинаковая в каждом заезде. Отличаются только даты, длительность и состав ребят."
  },
  {
    question: "Ребёнок точно найдёт себе компанию, если поедет один?",
    answer: "Да. В отряде всегда разновозрастная компания — в среднем 4–8 девочек разного возраста в смену, часто в 4-местных комнатах. Мальчики распределяются так же. За несколько смен подряд не было случая, чтобы школьник не нашёл с кем общаться."
  },
  {
    question: "Стоит ли брать трансфер, если ребёнок едет один?",
    answer: "Да, это заметно ускоряет адаптацию. На трансфере ребята из разных городов знакомятся ещё в автобусе — обычно именно там складываются первые компании среди тех, кто едет один. Дети, которых привозят родители, приезжают позже и присоединяются к уже знакомой группе — это тоже нормально, просто чуть медленнее."
  },
  {
    question: "В какую смену едут ребята постарше?",
    answer: "Ближе к концу августа возрастной состав немного смещается в сторону старшаков — ребята готовятся психологически ко школе и хотят провести последние недели лета ярко. В начале августа состав более смешанный по возрасту."
  },
  {
    question: "Что делать, если совсем не могу определиться со сменой?",
    answer: "Оставьте заявку или позвоните — за 10 минут разговора мы поймём, что важно именно вашему школьнику, и подскажем, какой заезд подойдёт лучше по датам, составу и загрузке. Программа сильная в обеих сменах — бояться «не той» смены не нужно."
  }
];
---

<Base
  title="Какую смену выбрать в АйДаКемп: инструкция для мамы, которая запуталась"
  description="Смены АйДаКемп не делятся по темам — ИИ, хакатон и экономика есть в каждой. Разбираем, чем заезды правда отличаются: возраст, расселение, новизна круга."
  ogImage="/images/hero/lager-na-avgust-podmoskove.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Какую смену выбрать: инструкция для мамы, которая запуталась",
        "description": "Смены АйДаКемп не делятся по темам — ИИ, хакатон и игровая экономика есть в каждом заезде. Разбираем, чем смены правда отличаются.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-07-01",
        "dateModified": "2026-07-01",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kakuyu-smenu-vybrat"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Какую смену выбрать", "item": "https://aidacamp.ru/stati/kakuyu-smenu-vybrat/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Какую смену выбрать? Инструкция для мамы, которая запуталась"
    subtitle="Смены не делятся по темам — ИИ, хакатон и своя экономика есть в каждом заезде. Разбираем, что правда меняется от смены к смене, а что нет."
    readTime="7 мин чтения"
    breadcrumbsLast="Какую смену выбрать"
    daryaQuote="Мне часто пишут: «А какая смена лучше подходит моему ребёнку?» — как будто есть одна правильная тема. На деле все смены одинаково сильные. Разница не в программе, а в том, кто рядом и в какое время лета вы едете."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Знакомая ситуация: открываешь сайт лагеря, видишь несколько дат — и не понимаешь, чем они отличаются. Может, в одной смене «упор на роботов», а в другой «упор на игры»? Может, стоит подождать «более удачную» тему? Спойлер: в АйДаКемп такой развилки нет. Ниже — честный разбор, что в каждой смене одинаково, а что действительно меняется.
        </p>
      </div>

      <!-- Section 1: главное -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Смены не делятся по темам — и вот почему
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В некоторых лагерях смены реально разные: одна про программирование, другая про рисование, третья про спорт. У нас не так. В АйДаКемп в основе каждого заезда — один и тот же костяк программы, проверенный и одинаково сильный от смены к смене.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-cpu text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>ИИ-проект.</strong> Каждый школьник — независимо от смены — делает свой проект с искусственным интеллектом: от идеи до работающего результата.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-trophy text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Хакатон.</strong> В каждой смене есть финальная защита проектов — командная гонка на скорость и результат, а не скучная презентация в конце.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-coin text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Игровая экономика лагеря.</strong> Своя внутренняя валюта, которую можно заработать и потратить — она есть в каждом заезде, без исключений.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-people text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Разновозрастный отряд.</strong> В каждой смене — ребята разного возраста в одной компании, а не строго по годам рождения.</p>
          </div>
        </div>
        <AnimatedBarChart
          title="Что есть в КАЖДОЙ смене АйДаКемп"
          items={[
            { label: 'ИИ-проект', value: 100, badge: '100%' },
            { label: 'Хакатон', value: 100, badge: '100%' },
            { label: 'Игровая экономика', value: 100, badge: '100%' },
            { label: 'Разновозрастной отряд', value: 100, badge: '100%' },
          ]}
          source="АйДаКемп, программа смен 2026"
        />
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Поэтому вопрос «а не пропустим ли мы смену получше» можно снять сразу — хуже или лучше по содержанию заездов не бывает. Дальше расскажем, что действительно стоит учитывать при выборе.
        </p>
      </div>

      <!-- Section 2: компания -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Компания найдётся — даже если едет один
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Частый страх: «А вдруг не с кем будет общаться?» Или наоборот — «вдруг рядом окажутся только малыши или только старшие?» На практике отряд всегда собирается разновозрастным, и именно это чаще всего помогает быстрее найти своих — компания получается живее, чем строго одногодки.
        </p>
        <div class="flex flex-col md:flex-row gap-6 items-center md:items-start mb-4">
          <DonutChart
            percentage={100}
            centerText="4–8"
            label="девочек разного возраста"
            sublabel="в среднем в одной смене"
            source="АйДаКемп, данные по сменам 2026"
            color="#FF6B1A"
          />
          <div class="flex-1">
            <p class="text-[15px] leading-[1.6] text-slate-600 mb-3">
              Девочек в смене обычно расселяют вместе — часто в 4-местных комнатах, независимо от точного возраста. У мальчиков компания собирается по такому же принципу: старшие и младшие в одном отряде, а не отдельными группами.
            </p>
            <p class="text-[15px] leading-[1.6] text-slate-600">
              За смены 2026 не было случая, чтобы школьник остался совсем без компании — вожатые целенаправленно перемешивают ребят в первый же день, а не оставляют это на волю случая.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 2.5: трансфер и расселение -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Если едет один — берите трансфер: вот что происходит в первые два дня
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Яркий пример, почему не стоит переживать заранее «а вдруг попадёт не в ту комнату»: расселение в первые два дня меняется несколько раз, и в этом весь смысл. Если школьник едет один — лучше взять трансфер: именно в автобусе обычно завязываются первые знакомства среди тех, кто едет без компании.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-slate-100 text-slate-500 text-[13px] font-bold mt-0.5">0</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>До заезда — автоматическое расселение.</strong> Система заранее распределяет места по полу и возрасту — это предварительная раскладка, черновик, а не финальное решение.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">1</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Автобус — первое перезнакомство.</strong> Те, кто уже знал, с кем едет, изначально живут вместе. А ребята, которые едут в одиночку, знакомятся друг с другом прямо в трансфере — и это первый этап реального расселения.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">2</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Приезд самостоятельных ребят.</strong> Те, кого привезли родители на машине, присоединяются чуть позже — и здесь снова все перезнакомятся заново. Второй этап расселения.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">3</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Через день-два — расселение по симпатиям.</strong> Когда ребята уже пожили вместе и разобрались, кто есть кто, происходит самостоятельная пересадка — уже по собственному выбору, а не по алгоритму.</p>
          </div>
        </div>

        <!-- Иллюстративная схема этажа (по мотивам реальной планировки 3 корпуса, без персональных данных) -->
        <div class="rounded-[16px] bg-slate-50 border border-slate-100 p-4 md:p-5 mb-2">
          <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-400 mb-3">Как выглядит этаж — схема расселения (без реальных имён)</p>
          <svg viewBox="0 0 720 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Схема этажа с комнатами" class="w-full h-auto">
            <!-- корридор -->
            <rect x="336" y="10" width="8" height="200" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4 5" />
            <!-- левое крыло: верхний ряд -->
            {[
              { n: 20, x: 10 },
              { n: 19, x: 92 },
              { n: 18, x: 174 },
              { n: 17, x: 256 },
            ].map((r) => (
              <g>
                <rect x={r.x} y="10" width="72" height="70" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
                <text x={r.x + 36} y="30" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">№{r.n}</text>
                <circle cx={r.x + 26} cy="55" r="9" fill="none" stroke="#cbd5e1" stroke-width="2" />
                <circle cx={r.x + 46} cy="55" r="9" fill="none" stroke="#cbd5e1" stroke-width="2" />
                <text x={r.x + 36} y="70" text-anchor="middle" font-size="9" fill="#94a3b8">2 места</text>
              </g>
            ))}
            <!-- правое крыло: верхний ряд -->
            {[
              { n: 11, x: 392 },
              { n: 12, x: 474 },
              { n: 13, x: 556 },
              { n: 14, x: 638 },
            ].map((r) => (
              <g>
                <rect x={r.x} y="10" width="72" height="70" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
                <text x={r.x + 36} y="30" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">№{r.n}</text>
                <circle cx={r.x + 26} cy="55" r="9" fill="none" stroke="#cbd5e1" stroke-width="2" />
                <circle cx={r.x + 46} cy="55" r="9" fill="none" stroke="#cbd5e1" stroke-width="2" />
                <text x={r.x + 36} y="70" text-anchor="middle" font-size="9" fill="#94a3b8">2 места</text>
              </g>
            ))}
            <!-- нижний ряд: левое крыло (широкие комнаты) -->
            <g>
              <rect x="10" y="130" width="154" height="80" rx="10" fill="#fff7ed" stroke="#fed7aa" stroke-width="1.5" />
              <text x="87" y="152" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">№21</text>
              <circle cx="60" cy="180" r="9" fill="#FF6B1A" opacity="0.85" />
              <circle cx="87" cy="180" r="9" fill="#FF6B1A" opacity="0.85" />
              <circle cx="114" cy="180" r="9" fill="none" stroke="#fdba74" stroke-width="2" />
              <text x="87" y="204" text-anchor="middle" font-size="9" fill="#b45309">2-3 места</text>
            </g>
            <g>
              <rect x="174" y="130" width="154" height="80" rx="10" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.5" opacity="0.6" />
              <text x="251" y="152" text-anchor="middle" font-size="12" font-weight="700" fill="#94a3b8">№22</text>
              <text x="251" y="175" text-anchor="middle" font-size="9" fill="#94a3b8">персонал</text>
            </g>
            <!-- нижний ряд: правое крыло (широкие комнаты) -->
            <g>
              <rect x="392" y="130" width="154" height="80" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
              <text x="469" y="152" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">№16</text>
              <circle cx="442" cy="180" r="9" fill="none" stroke="#cbd5e1" stroke-width="2" />
              <circle cx="469" cy="180" r="9" fill="#FF6B1A" opacity="0.85" />
              <text x="469" y="204" text-anchor="middle" font-size="9" fill="#94a3b8">2 места</text>
            </g>
            <g>
              <rect x="556" y="130" width="154" height="80" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" />
              <text x="633" y="152" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">№15</text>
              <circle cx="606" cy="180" r="9" fill="#FF6B1A" opacity="0.85" />
              <circle cx="633" cy="180" r="9" fill="#FF6B1A" opacity="0.85" />
              <text x="633" y="204" text-anchor="middle" font-size="9" fill="#94a3b8">2 места</text>
            </g>
          </svg>
          <div class="flex items-center gap-4 mt-3 pl-1">
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-3 w-3 rounded-full border-2 border-slate-300"></span>
              <span class="text-[11px] text-slate-500">место свободно</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-3 w-3 rounded-full bg-orange-400"></span>
              <span class="text-[11px] text-slate-500">место занято</span>
            </div>
          </div>
          <p class="text-[11px] text-slate-400 mt-2">Схема иллюстративная, по реальной планировке этажа корпуса — без реальных имён и текущего расселения.</p>
        </div>
      </div>

      <!-- Section 3: что реально отличается -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
