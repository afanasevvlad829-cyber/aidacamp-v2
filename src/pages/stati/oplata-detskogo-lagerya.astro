---
import { VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Цены и смены 2026", url: "/ceny", icon: "calendar-week", description: "Стоимость и расписание" },
  { title: "Налоговый вычет", url: "/nalogovyj-vychet", icon: "cash-coin", description: "Как вернуть 13% за лагерь" },
  { title: "Купить путёвку в лагерь", url: "/kupit-putevku-v-lager", icon: "bag-check", description: "Как забронировать место" },
  { title: "О лагере АйДаКемп", url: "/o-lagere", icon: "info-circle", description: "Что входит в стоимость" },
];

const faqItems = [
  {
    question: "Можно ли оплатить лагерь в рассрочку?",
    answer: "Да. В АйДаКемп действует рассрочка 50/50: первая половина стоимости при бронировании, вторая — за 2 недели до начала смены. Никаких процентов и переплат. Это удобно: места занимаете сейчас, пока есть выбор, а платите частями. Напишите нам при оформлении — менеджер всё объяснит."
  },
  {
    question: "Что входит в стоимость смены АйДаКемп?",
    answer: "В стоимость включено: проживание, 5-разовое питание, IT-программа с педагогами, все спортивные и вечерние активности, бассейн, базовая страховка, трансфер от метро на заезд и отъезд. Дополнительно оплачивается только расширенная страховка и личные расходы ребёнка."
  },
  {
    question: "Как получить налоговый вычет за лагерь?",
    answer: `По закону вы можете вернуть 13% от стоимости путёвки как социальный налоговый вычет на образование или оздоровление ребёнка. Для этого нужны: договор с лагерем, чек об оплате и лицензия организации. Мы выдаём все документы. Подробнее — на странице налогового вычета. Максимальная сумма возврата — до ${VYCHET_MAX} за одного ребёнка в год.`
  },
  {
    question: "Когда лучше бронировать, чтобы не пропустить нужную смену?",
    answer: "На популярные смены (июль, первые недели августа) места заканчиваются в феврале–марте. Смены на июнь и конец августа доступны дольше. Если у вас есть конкретные даты — не откладывайте. Бронирование с предоплатой фиксирует место: даже если потом что-то изменится, можно перенести на другую смену без потери депозита."
  },
  {
    question: "Что будет, если нужно отменить бронирование?",
    answer: "Политика возврата: при отмене за 30+ дней до начала смены — возвращаем полную сумму. За 14–29 дней — возвращаем 50% или предлагаем перенос на другую смену. Менее чем за 14 дней — возврат не производится, но возможен перенос при наличии мест. При отмене по медицинским показаниям (официальная справка) — рассматриваем индивидуально. Подробные условия — в договоре."
  },
  {
    question: "Можно ли оплатить лагерь через организацию (юридическое лицо)?",
    answer: "Да. Если работодатель оплачивает путёвку или компенсирует её стоимость — это вполне рабочая схема. Мы выставляем счёт на юридическое лицо, предоставляем договор, акт и все закрывающие документы. Свяжитесь с нами — согласуем детали."
  }
];
---

<Base
  title="Как оплатить детский лагерь 2026 — рассрочка 50/50, возврат 13%"
  description={`Три способа оплаты: онлайн, рассрочка 50/50 без переплат, сертификат. Налоговый вычет до ${VYCHET_MAX}. Бронируете сейчас — доплачиваете за 3 недели до смены.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/oplata-detskogo-lagerya" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Как оплатить детский лагерь — способы, рассрочка, налоговый вычет",
        "description": "Способы оплаты детского лагеря, рассрочка 50/50, что входит в стоимость и как вернуть 13% через налоговый вычет.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/oplata-detskogo-lagerya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Как оплатить детский лагерь 2026", "item": "https://aidacamp.ru/stati/oplata-detskogo-lagerya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Оплата детского лагеря: способы, рассрочка и как вернуть 13%"
    subtitle="Рассказываем, как платить удобно, что включено в цену — и как вернуть часть денег через вычет."
    imageBase="lager-na-leto-2026"
    imageAlt="Мама оформляет путёвку в детский лагерь онлайн"
    readTime="5 мин чтения"
    breadcrumbsLast="Оплата детского лагеря"
    daryaQuote="Многие мамы узнают про налоговый вычет только после оплаты — и расстраиваются, что не сохранили документы. Мы сразу выдаём всё что нужно. Главное — не потерять."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Оплата лагеря — это не только «сколько стоит». Это ещё и когда платить, как платить, что за эти деньги получит ребёнок — и можно ли часть вернуть. Разбираем всё по порядку.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Способы оплаты
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп можно оплатить несколькими способами — выбирайте удобный:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Банковская карта онлайн</strong> — через форму на сайте. Быстро, безопасно, место бронируется мгновенно. Visa, Mastercard, Мир — всё принимаем.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Перевод по реквизитам</strong> — для юридических лиц и тех, кто предпочитает безналичный расчёт с документами. Счёт выставляем в течение дня.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>СБП (Система быстрых платежей)</strong> — перевод по номеру телефона. Без комиссии, мгновенно зачисляется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Рассрочка 50/50</strong> — половина при бронировании, половина за 2 недели до смены. Без переплат и процентов. Подробнее — в следующем разделе.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Рассрочка: как это работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Рассрочка — удобный вариант, если смена нужная, а платить сразу всю сумму неудобно. Схема простая:
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">1</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Бронируете место и платите 50%</span>
              <p class="text-[15px] text-slate-600 mt-1">Место фиксируется за вашим ребёнком. Ни одно другое семья не может занять его.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">2</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Напоминаем за 2 недели до смены</span>
              <p class="text-[15px] text-slate-600 mt-1">Присылаем уведомление — вносите оставшиеся 50%. Никаких штрафов за просрочку, если договорились заранее.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 font-bold text-[14px] shrink-0 mt-0.5">3</span>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Ребёнок едет в лагерь</span>
              <p class="text-[15px] text-slate-600 mt-1">Всё оплачено, документы готовы, место занято. Никаких сюрпризов.</p>
            </div>
          </li>
        </ul>
        <p class="text-[15px] text-slate-500 italic">Рассрочка доступна при бронировании не позже чем за 3 недели до начала смены.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что входит в стоимость — без скрытых доплат
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы не любим сюрпризы при заезде. Цена на сайте — финальная. Вот что в неё включено:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Проживание в корпусе (2–4 человека в комнате)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Питание 5 раз в день — завтрак, обед, полдник, ужин, вечерний перекус</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">IT-программа: занятия по программированию, хакатон, проектная работа</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Спортивные и вечерние активности — бассейн, футбол, настолки, дискотека</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Базовое страхование от несчастного случая</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Трансфер от метро на заезд и отъезд</span>
          </li>
        </ul>
        <p class="text-[15px] text-slate-500 mt-3 italic">Дополнительно: расширенная страховка, фотоальбом смены, мерч АйДаКемп — по желанию.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Налоговый вычет — как вернуть 13%
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это то, о чём многие родители не знают. По Налоговому кодексу РФ можно вернуть 13% от стоимости путёвки в детский лагерь — через социальный налоговый вычет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При стоимости смены 50 000 ₽ возврат составит 6 500 ₽. Это реальные деньги, которые просто нужно оформить.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для вычета нужны: договор с лагерем, платёжный документ (чек или квитанция), лицензия организации. Мы выдаём все необходимые документы — просто сохраните их.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подробная инструкция как оформить вычет через Госуслуги или налоговую — <a href="/nalogovyj-vychet" class="text-primary font-semibold hover:underline">на отдельной странице</a>.
        </p>

        <div class="mt-5 bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-coin text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-[15px] font-bold text-slate-900 mb-1">Сохраните документы при оплате</div>
            <div class="text-[14px] text-slate-700 leading-[1.6]">
              Договор и чек нужны для налогового вычета. Мы отправляем их на почту автоматически. Но на всякий случай — сохраните в отдельную папку, чтобы не искать потом.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда бронировать, чтобы занять место
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На июльские смены мест обычно не остаётся уже в феврале–марте. Смены в июне и конце августа живут дольше, но тоже разбираются.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Наш совет: если знаете, что хотите в АйДаКемп — бронируйте сейчас с первым взносом 50%. Место будет зафиксировано за вами, а доплату внесёте ближе к лету.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Правила отмены и возврата
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Планы меняются — мы это понимаем. Вот как работает возврат:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start rounded-[14px] bg-green-50 border border-green-100 px-4 py-4">
            <i class="bi bi-check-lg text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-800">За 30+ дней до смены — полный возврат</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Вернём всю сумму без удержаний. Место освобождается для другой семьи.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-amber-50 border border-amber-100 px-4 py-4">
            <i class="bi bi-exclamation-triangle-fill text-amber-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-800">За 14–29 дней — 50% или перенос на другую смену</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Перенос на другую смену текущего сезона без потери суммы — если есть свободные места.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-red-50 border border-red-100 px-4 py-4">
            <i class="bi bi-x-lg text-red-400 text-[14px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-800">Менее 14 дней — возврат не производится</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">По медицинским показаниям с официальной справкой — рассматриваем индивидуально. Свяжитесь с менеджером.</p>
            </div>
          </div>
        </div>
        <p class="text-[14px] text-slate-500 italic">Детали прописаны в договоре, который вы получаете при оплате.</p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Готовы забронировать место?"
    bookingSubtitle="Напишите нам — расскажем про свободные смены и оформим рассрочку."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
