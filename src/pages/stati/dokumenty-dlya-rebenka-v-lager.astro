---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Справки для лагеря", url: "/stati/spravki-dlya-lagera/", icon: "file-earmark-text", description: "Как оформить 079у и 086у" },
  { title: "Страховка в лагерь", url: "/stati/strakhovka-v-lager/", icon: "shield-check", description: "Нужна ли отдельная страховка" },
  { title: "Что взять в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "bag-check", description: "Полный чек-лист" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Какая справка требуется для смены — 079у или 086у?",
    answer: "Для летнего отдыха действует форма 079у — это стандарт для оздоровительных учреждений по СанПиН. Форма 086у — это про учебные заведения, а не про лагерь. Точные детали уточняйте у нас — в редких случаях они отличаются."
  },
  {
    question: "Когда лучше оформить справку — за сколько дней до смены?",
    answer: "Справка 079у действует 90 дней, поэтому оформлять её можно за 2–3 месяца до смены. Обычно мы рекомендуем сделать это за 2–4 недели: педиатр должен убедиться, что ребёнок здоров и не имел контакта с инфекционными больными. В пик сезона (май–июнь) педиатры загружены — записывайтесь заранее."
  },
  {
    question: "Что делать, если нет страхового полиса ОМС?",
    answer: "Полис ОМС — обязательный документ. Если у ребёнка нет полиса или он просрочен, его переоформляют в страховой компании до отъезда. Это бесплатно и занимает 1–3 рабочих дня. Без полиса заселение в большинстве лагерей невозможно по законодательным требованиям."
  },
  {
    question: "Обязательно ли согласие второго родителя, если едут с одним?",
    answer: "По российским законам согласие обоих родителей для поездки внутри страны не требуется. Ребёнка принимают от одного родителя. Если едет с бабушкой или другим взрослым — понадобится нотариальная доверенность от одного из родителей."
  },
  {
    question: "Можно ли привезти справку 079/у после заезда?",
    answer: "Нет. Справка 079/у обязательна в момент заселения — без неё ребенка физически не примут. Это требование СанПиН, а не наша прихоть. Если справка осталась дома, придётся привезти её до старта смены или поехать за ней. Поэтому бумаги лучше паковать в отдельный пакет первыми."
  },
  {
    question: "Требуется ли отдельная справка в бассейн, помимо 079/у?",
    answer: "В большинстве случаев достаточно справки 079/у для допуска к бассейну — педиатр отмечает это в самой справке. Но иногда просят отдельную справку от дерматолога с пометкой «допущен к занятиям в бассейне». Уточните этот момент при оформлении путёвки — в АйДаКемп мы сообщаем об этом при подтверждении брони."
  },
  {
    question: `Какие документы нужны ребенку для лагеря в ${SEASON_YEAR} году?`,
    answer: "Обязательный минимум: справка по форме 079у, полис ОМС, свидетельство о рождении или паспорт, и согласие на обработку персональных данных. Остальное — по ситуации: список лекарств, контакт педиатра, расширенная страховка. Точный список мы присылаем сразу после оплаты."
  }
];
---

<Base
  title={`Какие документы нужны ребёнку для детского летнего лагеря ${SEASON_YEAR} — полный чек-лист`}
  description={`Какие документы нужны для летнего детского лагеря ${SEASON_YEAR}: справка 079у, полис ОМС, свидетельство о рождении. Что обязательно, что рекомендуется.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Документы для ребёнка в лагерь ${SEASON_YEAR} — полный список`,
        "description": `Полный список документов для детского лагеря: справка 079у, полис ОМС, свидетельство о рождении, страховка. Чек-лист ${SEASON_YEAR} с пояснениями.`,
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/dokumenty-dlya-rebenka-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": `Документы в летний лагерь ${SEASON_YEAR}`, "item": "https://aidacamp.ru/stati/dokumenty-dlya-rebenka-v-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title={`Какие документы нужны ребёнку — детский лагерь ${SEASON_YEAR}`}
    subtitle="Собрали список для оформления путёвки — что обязательно, а что можно решить позже."
    imageBase="lager-na-leto-2026"
    imageAlt="Родитель собирает справки для летнего отдыха ребёнка"
    readTime="4 мин чтения"
    breadcrumbsLast="Чек-лист"
    daryaQuote="Первый раз я чуть не забыла полис ОМС — хорошо, что нашла его в последний момент. Теперь делаю папку заранее. Документы — это то, что нельзя довезти потом."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Родители часто спрашивают, какие документы нужны ребёнку перед заездом — и что будет, если чего-то не хватит. Собрали список для оформления детского отдыха в {SEASON_YEAR} году: что обязательно, что можно передать позже. Без справки 079/у и полиса ОМС заселение невозможно — это требование закона, а не наша прихоть. Точные детали уточните у нас при бронировании.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что обязательно взять — без этого не заселят
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Детский лагерь по закону обязан всё проверить, поэтому эти бумаги обязательны без исключения. Держите их в отдельной папке или файле и кладите сверху при сборах.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка по форме 079у</strong> — для загородного лагеря. Оформляется педиатром в детской поликлинике по месту жительства или прикрепления — бесплатно по ОМС. Справка отражает текущее состояние здоровья ребёнка на момент осмотра. Действует 90 дней. Обязательно должна содержать отметку об отсутствии контакта с инфекционными больными. Для её получения требуется осмотр врача-педиатра и общий анализ крови и мочи. Педиатр вписывает результаты анализов и заключение об отсутствии противопоказаний. Подробнее — в статье <a href="/stati/spravki-dlya-lagera/" class="text-primary font-semibold hover:underline">справки для лагеря</a>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Прививочный сертификат или выписка из карты прививок (форма Ф63)</strong> — часть стандартного пакета в большинстве лагерей. Педиатр выдаёт его вместе со справкой 079/у.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис обязательного медицинского страхования (ОМС)</strong> — оригинал или качественная копия. Понадобится при любом обращении к медику на территории.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Свидетельство о рождении</strong> — для ребенка до 14 лет (копия). После 14 лет вместо него — паспорт. Некоторые лагеря просят иметь при себе оригинал.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Договор с лагерем</strong> — или путёвка. Его выдают при оплате смены. Обычно родитель привозит его на заезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Согласие родителей на обработку персональных данных</strong> — мы присылаем бланк при оформлении. Подписывается и сдаётся при заезде. Заполненные формы содержат сведения о ребёнке и контактные данные родителей — их используют в экстренных ситуациях.</span>
          </li>
        </ul>

        <div class="mt-5 bg-red-50 border border-red-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-exclamation-triangle-fill text-red-400 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Важно: справку нельзя привезти потом</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Справка 079у и полис ОМС — единственные бумаги, без которых заселение в большинство лагерей физически невозможно. Их нельзя прислать позже или выслать фотографией. Положите их первыми. Заранее убедитесь в наличии действующего полиса ОМС — нередко родители обнаруживают, что он просрочен, только перед самым отъездом. Некоторые лагеря дополнительно просят справку об отсутствии педикулёза — её оформляет педиатр за 1–2 дня до заезда.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что ещё пригодится
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не всегда требуют при заезде, но может понадобиться в нестандартных ситуациях. Лучше взять с собой.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Справки выдают в поликлиниках по ОМС бесплатно; в частных клиниках — платно, но быстрее. При заезде всё сверяет медик — полный пакет ускоряет заселение.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страховой полис от несчастного случая</strong> — базовое страхование, как правило, включено в стоимость смены. Но расширенная страховка стоит 300–600 ₽ и покрывает больше рисков. Подробности — в статье <a href="/stati/strakhovka-v-lager/" class="text-primary font-semibold hover:underline">страховка в лагерь</a>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Список принимаемых лекарств с дозировкой</strong> — если ребёнок принимает что-то регулярно. Написанный от руки листок с именем педиатра и контактом. Наш медик будет знать, что делать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Справка об аллергии</strong> — если есть аллергические реакции на лекарства или продукты. Передайте медику при заезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Контакт лечащего педиатра</strong> — на случай нестандартной ситуации. Просто номер телефона в блокноте или в телефоне вожатого.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что именно проверяет детский лагерь АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп при заезде проверяют:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Медицинская справка 079у с печатью педиатра и отметкой об эпидокружении</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Полис ОМС — оригинал или копия</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Свидетельство о рождении (до 14 лет) или паспорт</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Заполненные формы согласий — мы высылаем их при оформлении путёвки</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Полный список приходит сразу после оформления путёвки — на вашу почту. Актуальные детали уточняйте у менеджера: они могут немного отличаться от смены к смене.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Семьям из Москвы и области записаться к педиатру удобно через Госуслуги или ЕМИАС. Чтобы спокойно отправить ребёнка на смену, начните получение документов за 3–4 недели до заезда.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Точный перечень документов для конкретной смены менеджер высылает после бронирования. Проверьте пакет за неделю до отправки — не в день заезда.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что будет, если не привезти один из документов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не все бумаги одинаково критичны. Вот как это выглядит на практике:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start rounded-[14px] bg-red-50 border border-red-200 px-4 py-4">
            <i class="bi bi-x-lg text-red-400 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Справка 079/у или полис ОМС — заселение невозможно</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">Это требование закона. Без этих двух бумаг детский лагерь не имеет права принять ребенка. Их придётся привезти до начала смены или забрать ребенка.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-amber-50 border border-amber-200 px-4 py-4">
            <i class="bi bi-exclamation-triangle-fill text-amber-400 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Свидетельство о рождении / паспорт — обычно дают время привезти</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">В большинстве лагерей допускают привезти копию в первые 1–2 дня. Уточните этот момент заранее — мы подскажем.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-green-50 border border-green-100 px-4 py-4">
            <i class="bi bi-check-lg text-green-500 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Список лекарств, контакт педиатра — можно передать дистанционно</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">Если забыли написать — отправьте на почту или в мессенджер вожатого в первый день. Это не блокирует заселение.</p>
            </div>
          </div>
        </div>
        <p class="text-base text-slate-500 italic">
          Правило одно: справку 079/у и полис кладите первыми — в отдельный файл или пакет, который берёте с собой в руках, а не в чемодане.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Есть вопросы по документам?"
    bookingSubtitle="Напишите нам — уточним точный список для вашей смены и поможем разобраться."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
