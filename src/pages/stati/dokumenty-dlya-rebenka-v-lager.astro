---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Справки для лагеря", url: "/stati/spravki-dlya-lagera/", icon: "file-earmark-text", description: "Как оформить 079у и 086у" },
  { title: "Страховка в лагерь", url: "/stati/strakhovka-v-lager/", icon: "shield-check", description: "Нужна ли отдельная страховка" },
  { title: "Что взять в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "bag-check", description: "Полный чек-лист" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Какая справка нужна для загородного лагеря — 079у или 086у?",
    answer: "Для загородного детского лагеря нужна справка по форме 079у — это стандарт для оздоровительных учреждений согласно СанПиН. Форма 086у — это медицинская справка для поступления в учебные заведения, её для лагеря не берут. Уточните у конкретного лагеря: в редких случаях требования могут различаться."
  },
  {
    question: "За сколько дней до смены нужно оформить справку?",
    answer: "Справка 079у действует 90 дней, поэтому оформлять её можно за 2–3 месяца до смены. Обычно мы рекомендуем сделать это за 2–4 недели: педиатр должен убедиться, что ребёнок здоров и не имел контакта с инфекционными больными. В пик сезона (май–июнь) педиатры загружены — записывайтесь заранее."
  },
  {
    question: "Что делать, если нет страхового полиса ОМС?",
    answer: "Полис ОМС — обязательный документ. Если у ребёнка нет полиса или он просрочен, нужно переоформить его в страховой компании до отъезда. Это бесплатно и занимает 1–3 рабочих дня. Без полиса заселение в большинство лагерей невозможно по законодательным требованиям."
  },
  {
    question: "Нужно ли согласие второго родителя, если едут с одним?",
    answer: "По российскому законодательству, согласие обоих родителей для поездки внутри страны не требуется. Лагерь принимает ребёнка от одного родителя. Если ребёнок едет с бабушкой или другим сопровождающим — нужна нотариальная доверенность от одного из родителей."
  },
  {
    question: "Можно ли привезти справку 079/у после заезда?",
    answer: "Нет. Справка 079/у нужна в момент заселения — без неё лагерь физически не может принять ребёнка. Это требование СанПиН, а не прихоть. Если справка осталась дома, придётся либо привезти её до официального старта смены, либо поехать за ней. Поэтому документы лучше паковать в отдельный пакет первыми."
  },
  {
    question: "Нужна ли справка в бассейн отдельно от 079/у?",
    answer: "В большинстве лагерей достаточно справки 079/у для допуска к бассейну — педиатр вписывает туда допуск к физической активности. Но некоторые лагеря просят отдельную справку от дерматолога или педиатра с пометкой «допущен к занятиям в бассейне». Уточните у конкретного лагеря при оформлении — в АйДаКемп мы сообщаем об этом при подтверждении бронирования."
  }
];
---

<Base
  title="Документы в летний лагерь 2026 — полный чек-лист для заезда"
  description="Какие документы нужны ребёнку в лагерь: справка 079у, полис ОМС, свидетельство о рождении. Список с пояснениями — что обязательно, что рекомендуется."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/dokumenty-dlya-rebenka-v-lager" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Документы для ребёнка в лагерь 2026 — полный список",
        "description": "Полный список документов для детского лагеря: справка 079у, полис ОМС, свидетельство о рождении, страховка. Чек-лист 2026 с пояснениями.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/dokumenty-dlya-rebenka-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Документы в летний лагерь 2026", "item": "https://aidacamp.ru/stati/dokumenty-dlya-rebenka-v-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Какие документы нужны ребёнку в летний лагерь — чек-лист 2026"
    subtitle="Собрали полный список с пояснениями — что обязательно, что рекомендуется и где это оформить."
    imageBase="lager-na-leto-2026"
    imageAlt="Родитель собирает документы для ребёнка в летний лагерь"
    readTime="4 мин чтения"
    breadcrumbsLast="Документы для лагеря"
    daryaQuote="Первый раз я чуть не забыла полис ОМС — хорошо, что нашла его в последний момент. Теперь делаю папку заранее. Документы — это то, что нельзя довезти потом."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Без правильно собранных документов ребёнка могут не заселить в лагерь — и это не бюрократия ради бюрократии. Лагерь по закону обязан убедиться в здоровье ребёнка и иметь данные для страховки. Этот список — то, что нужно почти везде. Конкретные требования уточните в своём лагере.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Обязательные документы — без них не заселят
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Эти документы нужны в каждом лагере без исключения. Храните их в отдельной папке или файле и кладите сверху при сборах.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка по форме 079у</strong> — для загородного лагеря. Оформляется в детской поликлинике педиатром. Действует 90 дней. Обязательно должна содержать отметку об отсутствии контакта с инфекционными больными. Подробнее — в статье <a href="/stati/spravki-dlya-lagera/" class="text-primary font-semibold hover:underline">справки для лагеря</a>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис обязательного медицинского страхования (ОМС)</strong> — оригинал или качественная копия. Нужен при любом обращении к медику на территории.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Свидетельство о рождении</strong> — для детей до 14 лет (копия). После 14 лет вместо него — паспорт. Некоторые лагеря просят иметь при себе оригинал.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Договор с лагерем</strong> — или путёвка. Этот документ выдаёт лагерь при оплате. Обычно его привозит родитель на заезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Согласие родителей на обработку персональных данных</strong> — лагерь присылает бланк при оформлении. Подписывается и сдаётся при заезде.</span>
          </li>
        </ul>

        <div class="mt-5 bg-red-50 border border-red-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-exclamation-triangle-fill text-red-400 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Важно: справку нельзя привезти потом</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Справка 079у и полис ОМС — единственные документы, без которых заселение в большинство лагерей физически невозможно. Их нельзя прислать позже или выслать фотографией. Положите их первыми.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Рекомендуемые документы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Эти документы не всегда требуют при заезде, но они могут понадобиться в нестандартных ситуациях. Лучше взять.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страховой полис от несчастного случая</strong> — базовое страхование, как правило, включено в стоимость смены. Но расширенная страховка стоит 300–600 ₽ и покрывает больше рисков. Подробности — в статье <a href="/stati/strakhovka-v-lager/" class="text-primary font-semibold hover:underline">страховка в лагерь</a>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Список принимаемых лекарств с дозировкой</strong> — если ребёнок принимает что-то регулярно. Написанный от руки листок с именем педиатра и контактом. Медик лагеря будет знать, что делать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Справка об аллергии</strong> — если есть аллергические реакции на лекарства или продукты. Передайте медику при заезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Контакт лечащего педиатра</strong> — на случай нестандартной ситуации. Просто номер телефона в блокноте или в телефоне вожатого.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что конкретно нужно в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп при заезде проверяют:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Медицинская справка 079у с печатью педиатра и отметкой об эпидокружении</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Полис ОМС — оригинал или копия</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Свидетельство о рождении (до 14 лет) или паспорт</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Заполненные формы согласий — мы высылаем их при оформлении путёвки</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          После оплаты мы отправляем точный список на вашу почту. Всегда уточняйте актуальные требования у менеджера — правила могут немного меняться от смены к смене.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что будет, если не привезти один из документов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не все документы одинаково критичны. Вот как выглядит ситуация на практике:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start rounded-[14px] bg-red-50 border border-red-200 px-4 py-4">
            <i class="bi bi-x-lg text-red-400 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Справка 079/у или полис ОМС — заселение невозможно</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">Это требование закона. Без этих двух документов лагерь не имеет права оформить ребёнка. Нужно привезти до начала смены или забрать ребёнка.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-amber-50 border border-amber-200 px-4 py-4">
            <i class="bi bi-exclamation-triangle-fill text-amber-400 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Свидетельство о рождении / паспорт — обычно дают время привезти</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">В большинстве лагерей допускают привезти копию в первые 1–2 дня. Уточните у конкретного лагеря заранее.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-green-50 border border-green-100 px-4 py-4">
            <i class="bi bi-check-lg text-green-500 text-base shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Список лекарств, контакт педиатра — можно передать дистанционно</p>
              <p class="text-base text-slate-500 leading-[1.5] mt-0.5">Если забыли написать — отправьте на почту или в мессенджер вожатого в первый день. Это не блокирует заселение.</p>
            </div>
          </div>
        </div>
        <p class="text-base text-slate-500 italic">
          Правило одно: справку 079/у и полис кладите первыми — в отдельный файл или пакет, который берёте с собой в руках, а не в чемодане.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Есть вопросы по документам?"
    bookingSubtitle="Напишите нам — уточним точный список для вашей смены и поможем разобраться."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
