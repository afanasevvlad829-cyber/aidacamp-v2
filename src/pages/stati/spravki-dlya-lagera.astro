---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "check-circle", description: "7 критериев от мамы к маме" },
  { title: "Отзывы родителей", url: "/otzyvy", icon: "chat", description: "40+ отзывов на Яндекс.Картах" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Кто мы и как устроен день" },
];
---

<Base
  title="Справки для детского лагеря 2026 — полный список | АйДаКемп"
  description="Какие справки нужны в детский лагерь в 2026 году: форма 079/у, 026/у, прививочный сертификат, страховка. Список документов + советы по страховым."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/spravki-dlya-lagera" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Справки для детского лагеря — полный список 2026",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/spravki-dlya-lagera"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Справки для детского лагеря — полный список 2026"
    subtitle="Собираем без паники: какие документы нужны, где их взять и нужна ли дополнительная страховка."
    imageBase="hakaton"
    imageAlt="Подготовка документов для детского лагеря — справки и страховка"
    date="2026-04-24"
    readTime="6 мин чтения"
    breadcrumbsLast="Справки для лагеря"
    daryaQuote="Собирать справки в последний момент — больно. Поэтому написали этот список. Скорее всего вы уже знаете куда едете этим летом — ну и отлично! Этот список пригодится всё равно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Практически в каждый лагерь нужен один и тот же базовый набор документов. Список стабильный год от года — меняются только сроки действия справок. Сохраните эту страницу в закладки и идите собирать, пока поликлиники ещё не завалены очередями.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Честно: скорее всего, вы уже знаете куда едете
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы ищете эту статью в мае или июне — скорее всего, место в лагере уже забронировано. Отлично! Тогда этот список пригодится вам прямо сейчас — успеете оформить всё без спешки.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если ещё выбираете — добро пожаловать к нам в АйДаКемп. Но в любом случае список документов одинаковый почти для всех лагерей, так что читайте дальше.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Обязательные документы для любого лагеря
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Этот набор требует каждый лагерь без исключений — независимо от формата и программы:
        </p>
        <div class="space-y-4 mb-4">
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Медицинская справка формы 079/у</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">«Справка о состоянии здоровья ребёнка для школы/лагеря». Срок действия — 90 дней от даты выдачи.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Прививочный сертификат / выписка из карты прививок (Ф63)</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Подтверждает актуальный прививочный статус ребёнка. Выдаёт педиатр.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Копия свидетельства о рождении или паспорта ребёнка</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Обычно достаточно копии. Уточните в конкретном лагере — иногда просят оригинал для сверки.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Медицинский полис ОМС</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Копия или оригинал. Понадобится при любом обращении к врачу.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Для иностранных граждан</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Нотариально заверенный перевод документов ребёнка на русский язык.</p>
            </div>
          </div>
        </div>
        <p class="text-[14px] text-slate-400">
          Уточняйте полный список у конкретного лагеря — некоторые дополнительно просят справку об отсутствии педикулёза (оформляется за день до отъезда) и согласие на медицинское вмешательство.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Где получить справку 079/у
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Справку 079/у выдаёт педиатр в поликлинике по месту прикрепления. Это бесплатно по ОМС.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что понадобится для её получения:
        </p>
        <div class="space-y-2 mb-4">
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Осмотр педиатра</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Общий анализ крови и мочи (обычно требуют не позднее 30 дней)</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Справка об отсутствии контакта с инфекционными больными (форма 079)</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Важный момент: справка действует <strong>90 дней</strong>. Считайте от даты выдачи — она должна «доехать» до даты начала смены. Не берите справку слишком рано.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нужна ли дополнительная страховка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          ОМС покрывает базовую медицинскую помощь в государственных учреждениях. Но есть случаи, когда ОМС не поможет:
        </p>
        <div class="space-y-2 mb-6">
          <div class="flex gap-2 items-center">
            <i class="bi bi-exclamation-triangle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Несчастный случай с компенсацией пострадавшему</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-exclamation-triangle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Экстренная эвакуация в другой город</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-exclamation-triangle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Стоматологические услуги</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-exclamation-triangle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Дорогостоящие анализы и МРТ</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Рекомендуем добавить страховку от несчастного случая (НС) плюс медицинские расходы. Это спокойствие за очень небольшие деньги.
        </p>
        <StatCallout
          value="от 300 ₽"
          label="стоит базовая страховка ребёнка на 2 недели лагеря. Защищает от НС, травм, стоматологии"
          source="Средняя цена по рынку 2026"
          icon="shield-check"
          tone="info"
        />
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страховые компании для лагеря 2026 — подборка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не реклама — просто популярные варианты, которые оформляются онлайн за 10 минут. Актуальные условия уточняйте на сайтах страховщиков.
        </p>
        <div class="space-y-3">
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <p class="text-[15px] font-semibold text-slate-700">Сбербанк Страхование</p>
            <p class="text-[13px] text-slate-500 leading-[1.5] mt-1">Полис «Дети в лагере» — оформляется онлайн на sberbank-insurance.ru. Одна из самых доступных цен по рынку.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <p class="text-[15px] font-semibold text-slate-700">РЕСО-Гарантия</p>
            <p class="text-[13px] text-slate-500 leading-[1.5] mt-1">Полис от несчастного случая для детей — известный страховщик, оформление онлайн и в офисах.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <p class="text-[15px] font-semibold text-slate-700">Ингосстрах — «Мой ребёнок»</p>
            <p class="text-[13px] text-slate-500 leading-[1.5] mt-1">Включает НС плюс медицинские расходы. Популярный выбор для загородных лагерей.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <p class="text-[15px] font-semibold text-slate-700">Альфастрахование — «Летний лагерь»</p>
            <p class="text-[13px] text-slate-500 leading-[1.5] mt-1">Экспресс-оформление онлайн, полис приходит на email сразу после оплаты.</p>
          </div>
        </div>
      </div>

      <!-- Section 6: АйДаКемп soft CTA -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Немного про АйДаКемп на следующий год
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если этим летом вы едете в другой лагерь — удачной смены! Посмотрите на следующий год: в АйДаКемп каждый год появляются новые треки, новая техника и новые форматы. IT-программы для детей 7–15 лет, Подмосковье, 66 км от Москвы.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Открытие бронирования на 2027 год — обычно в феврале. Оставьте заявку ниже — напомним, когда откроются места. Без спама, только одно сообщение в начале февраля.
        </p>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Едете к нам этим летом? Или планируете следующий?"
    bookingSubtitle="Расскажем про смены 2026 — остались свободные места. Или напомним весной 2027 когда откроется бронирование."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
