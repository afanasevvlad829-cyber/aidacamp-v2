---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Купить путёвку", url: "/kupit-putevku-v-lager", icon: "credit-card", description: "Оплата, договор, документы" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Стоимость смен" },
  { title: "Детский лагерь в Подмосковье", url: "/detskiy-lager-podmoskove", icon: "houses", description: "66 км от Москвы" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Как устроен день" },
];

const faqItems = [
  {
    question: "Что такое справка 079/у и зачем она нужна?",
    answer: "Справка 079/у — это «Медицинская справка о состоянии здоровья ребёнка, выезжающего в организацию отдыха детей и их оздоровления». Она подтверждает, что ребёнок здоров, прошёл медосмотр и не имел контакта с инфекционными больными. Без этой справки ни один загородный лагерь не имеет права заселить ребёнка — это требование федерального законодательства."
  },
  {
    question: "За сколько дней до смены нужно взять справку 079/у?",
    answer: "Справка действует 90 дней с момента выдачи. Не берите её слишком рано: если взяли в феврале, а смена в конце августа — справка уже не будет действовать. Оптимально — за 2–4 недели до начала смены. Учтите, что анализы крови и мочи тоже нужны свежие — обычно не позднее 30 дней. Поэтому лучше сначала сдать анализы, потом идти к педиатру за справкой."
  },
  {
    question: "Можно ли въехать в лагерь без справки 079/у?",
    answer: "Нет. Это требование закона, а не прихоть лагеря. Без справки 079/у заселение невозможно — лагерь несёт ответственность за здоровье каждого ребёнка на территории. Если вы забыли справку дома, нужно её привезти до официального начала смены. Пожалуйста, не оставляйте этот вопрос на последний момент — очередь к педиатру в мае-июне бывает длинной."
  },
  {
    question: "Нужна ли справка от психиатра и нарколога (026/у) для лагеря?",
    answer: "Нет, для обычного детского лагеря справка 026/у не нужна. Она требуется для отдельных категорий: некоторые спортивные секции, военно-патриотические сборы, отдельные профильные программы. Для АйДаКемп достаточно стандартного пакета: справка 079/у, полис ОМС и копия документа ребёнка. Если вы не уверены — уточните у нас при бронировании."
  },
  {
    question: "Что делать если у ребёнка хроническое заболевание?",
    answer: "Обсудите это с нашим медицинским работником заранее — до смены, а не в день заезда. Большинство хронических заболеваний не являются противопоказанием для лагеря, если ребёнок получает поддерживающую терапию. Привезите лекарства на всю смену, напишите список с дозировкой и временем приёма — наш медик возьмёт это под контроль. При необходимости попросим педиатра сделать в справке отметку о диагнозе и назначениях."
  },
  {
    question: "Какая страховка нужна в лагерь?",
    answer: "Базовая страховка от несчастного случая (НС) уже включена в стоимость смены АйДаКемп. Она покрывает травмы на территории лагеря. Дополнительная расширенная страховка (стоматология, медицинские расходы, эвакуация) — по желанию, оформляется отдельно через Сбербанк Страхование, РЕСО-Гарантия или Ингосстрах. Стоит от 300 ₽ на смену — это спокойствие за очень небольшие деньги."
  }
];
---

<Base
  title="Справки для детского лагеря 2026 — справка 079/у, полный список | АйДаКемп"
  description="Какие справки нужны в детский лагерь 2026: справка 079/у (форма, где взять, срок действия), 026/у, прививочный сертификат, страховка. Пошаговая инструкция."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/spravki-dlya-lagera" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Справки для детского лагеря 2026 — справка 079/у, полный список | АйДаКемп",
        "description": "Какие справки нужны в детский лагерь 2026: справка 079/у (форма, где взять, срок действия), 026/у, прививочный сертификат, страховка. Пошаговая инструкция.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-24",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/spravki-dlya-lagera"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Справки для детского лагеря — полный список 2026"
    subtitle="Собираем без паники: какие документы нужны, где их взять и нужна ли дополнительная страховка."
    imageBase="hakaton"
    imageAlt="Подготовка документов для детского лагеря — справки и страховка"
    readTime="6 мин чтения"
    breadcrumbsLast="Справки для лагеря"
    daryaQuote="Собирать справки в последний момент — больно. Поэтому написали этот список. Скорее всего вы уже знаете куда едете этим летом — ну и отлично! Этот список пригодится всё равно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Практически в каждый лагерь нужен один и тот же базовый набор документов. Список стабильный год от года — меняются только сроки действия справок. Сохраните эту страницу в закладки и идите собирать, пока поликлиники ещё не завалены очередями.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Честно: скорее всего, вы уже знаете куда едете
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы ищете эту статью в мае или июне — скорее всего, место в лагере уже забронировано. Отлично! Тогда этот список пригодится вам прямо сейчас — успеете оформить всё без спешки.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если ещё выбираете — добро пожаловать к нам в АйДаКемп. Но в любом случае список документов одинаковый почти для всех лагерей, так что читайте дальше.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Обязательные документы для любого лагеря
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Этот набор требует каждый лагерь без исключений — независимо от формата и программы:
        </p>
        <div class="space-y-4 mb-4">
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Медицинская справка формы 079/у</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">«Справка о состоянии здоровья ребёнка для школы/лагеря». Срок действия — 90 дней от даты выдачи.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Прививочный сертификат / выписка из карты прививок (Ф63)</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Подтверждает актуальный прививочный статус ребёнка. Выдаёт педиатр.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Копия свидетельства о рождении или паспорта ребёнка</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Обычно достаточно копии. Уточните в конкретном лагере — иногда просят оригинал для сверки.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Медицинский полис ОМС</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Копия или оригинал. Понадобится при любом обращении к врачу.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <i class="bi bi-check-lg text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[15px] font-semibold text-slate-700">Для иностранных граждан</p>
              <p class="text-[13px] text-slate-500 leading-[1.5] mt-0.5">Нотариально заверенный перевод документов ребёнка на русский язык.</p>
            </div>
          </div>
        </div>
        <p class="text-[14px] text-slate-400">
          Уточняйте полный список у конкретного лагеря — некоторые дополнительно просят справку об отсутствии педикулёза (оформляется за день до отъезда) и согласие на медицинское вмешательство.
        </p>
      </div>

      <!-- Section 3: пошаговая инструкция 079/у -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Справка 079/у — пошаговая инструкция
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Официальное название — «Медицинская справка о состоянии здоровья ребёнка, выезжающего в организацию отдыха детей и их оздоровления» (форма 079/у, утверждена приказом Минздрава России №834н). Это главный документ для любого загородного лагеря.
        </p>

        <div class="space-y-4 mb-6">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-[14px] font-bold shrink-0 mt-0.5">1</div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Запишитесь к педиатру в вашу поликлинику</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Справку выдаёт только участковый педиатр по месту прикрепления. Частные клиники тоже могут — если у них есть лицензия на форму 079/у. Уточните заранее.</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-[14px] font-bold shrink-0 mt-0.5">2</div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Сдайте анализы — до визита к педиатру</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Общий анализ крови и мочи. Обычно требуют свежие — не позднее 30 дней до смены. Сдайте заранее, чтобы педиатр мог вписать результаты в справку.</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-[14px] font-bold shrink-0 mt-0.5">3</div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Педиатр осматривает ребёнка и заполняет справку</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Врач вписывает заключение об отсутствии противопоказаний к нахождению в лагере и делает отметку об отсутствии контакта с инфекционными больными за последние 21 день.</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-[14px] font-bold shrink-0 mt-0.5">4</div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Проверьте срок действия и подписи</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Справка действует <strong>90 дней</strong> с момента выдачи. Убедитесь, что на ней стоит печать поликлиники, подпись педиатра и дата. Без этого лагерь справку не примет.</p>
            </div>
          </div>
        </div>

        <div class="bg-orange-50 border border-orange-200 rounded-[14px] p-5 flex items-start gap-4">
          <i class="bi bi-info-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <p class="text-[14px] font-semibold text-slate-800 mb-1">Стоимость и сроки</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">По ОМС в своей поликлинике — <strong>бесплатно</strong>. Анализы тоже по ОМС. В частных клиниках — платно, но быстрее (обычно день в день). Очереди в мае-июне большие — не тяните до последней недели перед сменой.</p>
          </div>
        </div>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Где получить справку 079/у
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Справку 079/у выдаёт педиатр в поликлинике по месту прикрепления. Это бесплатно по ОМС.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что понадобится для её получения:
        </p>
        <div class="space-y-2 mb-4">
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Осмотр педиатра</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Общий анализ крови и мочи (обычно требуют не позднее 30 дней)</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-arrow-right text-orange-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Справка об отсутствии контакта с инфекционными больными (форма 079)</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Важный момент: справка действует <strong>90 дней</strong>. Считайте от даты выдачи — она должна «доехать» до даты начала смены. Не берите справку слишком рано.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нужна ли дополнительная страховка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          ОМС покрывает базовую медицинскую помощь в государственных учреждениях. Но есть случаи, когда ОМС не поможет:
        </p>
        <div class="space-y-2 mb-6">
          <div class="flex gap-2 items-center">
            <i class="bi bi-info-circle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Несчастный случай с компенсацией пострадавшему</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-info-circle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Экстренная эвакуация в другой город</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-info-circle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Стоматологические услуги</p>
          </div>
          <div class="flex gap-2 items-center">
            <i class="bi bi-info-circle text-slate-400 text-[14px] shrink-0" aria-hidden="true"></i>
            <p class="text-[15px] text-slate-600">Дорогостоящие анализы и МРТ</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Рекомендуем добавить страховку от несчастного случая (НС) плюс медицинские расходы. Это спокойствие за очень небольшие деньги.
        </p>
        <StatCallout
          value="от 300 ₽"
          label="стоит базовая страховка ребёнка на 2 недели лагеря. Защищает от НС, травм, стоматологии"
          source="Средняя цена по рынку 2026"
          icon="shield-check"
          tone="info"
        />
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
