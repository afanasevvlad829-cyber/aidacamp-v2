---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';

const relatedPages = [
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-coin", description: "Как вернуть до 5 434 ₽ — пошаговая инструкция" },
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "laptop", description: "IT-смены АйДаКемп — чему учат и сколько стоит" },
  { title: "Детский лагерь", url: "/detskiy-lager/", icon: "house-heart", description: "Всё о летнем отдыхе в АйДаКемп" },
  { title: "Лагерь недорого", url: "/lager-nedorogo/", icon: "coin", description: "Как попасть в хороший лагерь с выгодой" },
];

const faqItems = [
  {
    question: "Почему IT-лагерь стоит дороже обычного загородного?",
    answer: "В стоимость IT-лагеря входит не только проживание и питание, но и лицензионный доступ к программным инструментам, оборудование (ноутбуки на смену или компьютерный класс), преподаватели с реальным опытом разработки. В обычном загородном лагере главная статья расходов — это питание и педагоги-вожатые. IT-специалисты стоят дороже, и это справедливо: разница в качестве подготовки заметна."
  },
  {
    question: "Что будет, если записаться и цена потом вырастет?",
    answer: "В АйДаКемп действует фиксация цены: на какую стоимость вы записались — по той и платите, даже если цена потом поднимется. Ранняя запись — это и экономия, и гарантия места в конкретной смене."
  },
  {
    question: "Можно ли получить налоговый вычет за IT-лагерь?",
    answer: "Да. АйДаКемп — образовательная организация с лицензией Министерства образования. Это значит, что вы можете подать на социальный налоговый вычет по ст. 219 НК РФ и вернуть 13% от стоимости образовательной части смены. Сумма возврата зависит от длины смены: от ~2 800 ₽ за 7-дневную смену до ~5 434 ₽ за 14-дневную. Мы выдаём все нужные документы."
  },
  {
    question: "Что делать, если нет возможности оплатить сразу?",
    answer: "Большинство лагерей, в том числе АйДаКемп, принимают рассрочку: часть суммы при записи, остаток за 2–4 недели до заезда. Также существуют сертификаты на лагерь от работодателей — если у вас есть социальный пакет, стоит уточнить в HR. Часть семей используют налоговый вычет с предыдущего года как источник для оплаты следующей смены."
  },
];
---

<Base
  title="Сколько стоит детский лагерь 2026 — цены и как сэкономить"
  description="Реальные цены на детские лагеря в 2026: дневной от 15 000 ₽, загородный 40–100 000 ₽, IT-лагерь 48–95 000 ₽. Что входит в стоимость, как вернуть до 5 434"
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/skolko-stoit-detskiy-lager/" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Сколько стоит детский лагерь в 2026 году — цены, что входит и как сэкономить",
        "description": "Реальные цены на детские лагеря в 2026: дневной от 15 000 ₽, загородный 40–100 000 ₽, IT-лагерь 48–95 000 ₽. Что входит в стоимость, как вернуть до 5 434 ₽ через налоговый вычет.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/skolko-stoit-detskiy-lager/"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Сколько стоит детский лагерь", "item": "https://aidacamp.ru/stati/skolko-stoit-detskiy-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Сколько стоит детский лагерь в 2026 году"
    subtitle="Цены по рынку, что реально входит в стоимость и как сэкономить до 5 434 ₽ через налоговый вычет."
    imageBase="lager-programmirovaniya"
    imageAlt="Дети за ноутбуками на IT-смене — летний лагерь программирования АйДаКемп"
    readTime="7 мин чтения"
    breadcrumbsLast="Сколько стоит детский лагерь"
    daryaQuote="Когда я впервые увидела ценник на IT-лагерь — честно, чуть не закрыла вкладку. Но когда разобралась, что реально входит в стоимость и что можно вернуть через вычет, всё встало на место. Делюсь тем, что узнала."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Вступление -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вопрос «сколько стоит лагерь» — один из первых, которые задают родители. И ответ зависит от формата: разброс на рынке огромный — от 15 000 до 150 000 ₽ и выше за одну смену. Разберём конкретно: что за что платите и как сориентироваться в цифрах.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если коротко: <strong>дневной лагерь</strong> — 15 000–25 000 ₽ за смену (без ночёвки), <strong>загородный стандарт</strong> — 40 000–70 000 ₽, <strong>профильный IT-лагерь</strong> — 48 000–95 000 ₽. Дальше — детали, которые объясняют разницу.
        </p>
      </div>

      <!-- Что входит в стоимость -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что входит в стоимость лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          В большинстве лагерей стоимость складывается из нескольких блоков. Проблема в том, что рекламируют обычно итоговую цифру — а что именно в неё входит, нужно уточнять отдельно.
        </p>

        <div class="space-y-3 mb-6">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-house-heart text-primary text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Проживание</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Корпуса или коттеджи, наполняемость комнат (2–4–8 человек), наличие санузла в номере или на этаже. Это самая крупная статья расходов в загородном лагере — до 40% стоимости.</p>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-cup-hot text-primary text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Питание</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Обычно 4-разовое (завтрак, обед, полдник, ужин). Качество и меню — большая переменная. В хорошем лагере это ~600–900 ₽ в день на ребёнка.</p>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-laptop text-primary text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Образовательная или профильная программа</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">В обычном лагере — вожатые и общая анимация. В профильном (IT, спорт, языки) — специалисты, оборудование, лицензионный софт. Именно этот блок объясняет разницу в цене между стандартным и IT-лагерем.</p>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-bus-front text-primary text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Трансфер</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Часто включён в цену для московских лагерей — автобус до базы и обратно. Если не включён — уточняйте заранее, это ещё 1 500–3 000 ₽ в одну сторону.</p>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-shield-check text-primary text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Страховка</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Обязательно входит в стоимость по закону. Обычно это базовый НС-полис. Для активных смен — проверяйте лимит покрытия.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-amber-50 border border-amber-200 p-4">
          <p class="text-[14px] leading-[1.6] text-slate-700">
            <strong>На что обратить внимание при сравнении цен:</strong> уточните, включён ли трансфер, сколько детей в комнате и какова наполняемость отряда. Лагерь за 40 000 ₽ с 20 детьми в отряде и лагерь за 65 000 ₽ с 12 детьми — это разный опыт для ребёнка.
          </p>
        </div>
      </div>

      <!-- Сравнение форматов -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Дневной, загородный или IT: сравнение форматов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Три основных формата отличаются не только ценой, но и тем, что ребёнок получает в итоге.
        </p>

        <div class="overflow-x-auto rounded-xl border border-slate-200 mb-5">
          <table class="w-full text-[14px] text-slate-700">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="text-left px-4 py-3 font-semibold text-slate-800">Формат</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-800">Цена смены</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-800">Длина</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-800">Что входит</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-800">Кому подходит</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="px-4 py-3 font-medium text-slate-800">Дневной</td>
                <td class="px-4 py-3">15 000–25 000 ₽</td>
                <td class="px-4 py-3">2–3 недели</td>
                <td class="px-4 py-3">Активности, питание днём, без ночёвки</td>
                <td class="px-4 py-3">6–10 лет, первый лагерь</td>
              </tr>
              <tr class="bg-slate-50/50">
                <td class="px-4 py-3 font-medium text-slate-800">Загородный стандарт</td>
                <td class="px-4 py-3">40 000–70 000 ₽</td>
                <td class="px-4 py-3">10–21 день</td>
                <td class="px-4 py-3">Проживание, питание, общая программа, спорт</td>
                <td class="px-4 py-3">7–16 лет, активный отдых</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-slate-800">IT / профильный</td>
                <td class="px-4 py-3">48 000–95 000 ₽</td>
                <td class="px-4 py-3">7–14 дней</td>
                <td class="px-4 py-3">Всё выше + спецы-разработчики, оборудование, реальный проект</td>
                <td class="px-4 py-3">10–17 лет, интерес к технологиям</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-[14px] leading-[1.6] text-slate-500">
          Цены актуальны для рынка Московского региона на лето 2026. В регионах загородный лагерь может быть на 20–30% дешевле.
        </p>
      </div>

      <!-- АйДаКемп: смены и цены -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            АйДаКемп: смены 2026 и реальные цены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Мы IT-лагерь с образовательной лицензией. Дети не просто «отдыхают за компьютером» — они делают реальные проекты: игры, ботов, сайты. Вожатые — студенты технических специальностей, преподаватели — действующие разработчики.
        </p>

        <div class="space-y-3 mb-5">
          <div class="rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <p class="text-[15px] font-semibold text-slate-800">Смена 2.1</p>
              <p class="text-[14px] text-slate-500">7 дней · июль</p>
            </div>
            <div class="sm:text-right">
              <p class="text-[18px] font-bold text-primary">48 000 ₽</p>
              <p class="text-[12px] text-slate-400">~2 800 ₽ вычет</p>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <p class="text-[15px] font-semibold text-slate-800">Смена 2.2</p>
              <p class="text-[14px] text-slate-500">8 дней · июль</p>
            </div>
            <div class="sm:text-right">
              <p class="text-[18px] font-bold text-primary">75 000 ₽</p>
              <p class="text-[12px] text-slate-400">~5 800 ₽ вычет</p>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <p class="text-[15px] font-semibold text-slate-800">Смены 1 и 4</p>
              <p class="text-[14px] text-slate-500">10 дней · июнь / август</p>
            </div>
            <div class="sm:text-right">
              <p class="text-[18px] font-bold text-primary">74 900 ₽</p>
              <p class="text-[12px] text-slate-400">~4 800 ₽ вычет</p>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <p class="text-[15px] font-semibold text-slate-800">Смена 3</p>
              <p class="text-[14px] text-slate-500">13 дней · июль–август</p>
            </div>
            <div class="sm:text-right">
              <p class="text-[18px] font-bold text-primary">89 400 ₽</p>
              <p class="text-[12px] text-slate-400">~5 200 ₽ вычет</p>
            </div>
          </div>

          <div class="rounded-xl border border-primary/30 bg-primary/5 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <div class="inline-flex items-center gap-1.5 bg-primary text-white text-[11px] font-semibold px-2 py-0.5 rounded-full mb-1">
                <i class="bi bi-star-fill text-[9px]" aria-hidden="true"></i>
                Максимум
              </div>
              <p class="text-[15px] font-semibold text-slate-800">Смена 2</p>
              <p class="text-[14px] text-slate-500">14 дней · июль</p>
            </div>
            <div class="sm:text-right">
              <p class="text-[18px] font-bold text-primary">95 000 ₽</p>
              <p class="text-[12px] text-slate-400">~5 434 ₽ вычет</p>
            </div>
          </div>
        </div>

        <p class="text-[14px] leading-[1.6] text-slate-500 mb-3">
          Все смены — в Подмосковье, трансфер включён. В стоимость входят: проживание в корпусе, 4-разовое питание, образовательная программа по IT, все материалы, страховка и доступ к оборудованию.
        </p>

        <a href="/ceny/" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-[14px] font-semibold text-white hover:bg-[#d67000] transition-colors">
          Смотреть все смены с ценами
          <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
        </a>
      </div>

      <!-- Как сэкономить -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как сэкономить на лагере
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Три реальных способа снизить итоговые расходы — без поиска «лагеря подешевле».
        </p>

        <div class="space-y-3">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[13px] font-bold shrink-0 mt-0.5">1</div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Ранняя запись</p>
                <p class="text-[14px] leading-[1.6] text-slate-600">Большинство IT-лагерей открывают продажи в ноябре–феврале по ценам «старта». К апрелю–маю цена обычно вырастает на 5 000–10 000 ₽. В АйДаКемп при записи до конца февраля — фиксируем цену старта без доплат.</p>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[13px] font-bold shrink-0 mt-0.5">2</div>
              <div>
                <p class="text-[15px] font-semibold text-slate-800 mb-1">Налоговый вычет</p>
