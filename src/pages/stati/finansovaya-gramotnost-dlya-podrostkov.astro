---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "IT-смены для детей 12–17 лет с командными проектами" },
  { title: "Внутренняя экономика лагеря", url: "/stati/vnutrennyaya-ekonomika-v-lagere/", icon: "cash-coin", description: "Как работает игровая валюта в АйДаКемп" },
  { title: "Как ребёнок может заработать", url: "/stati/kak-rebenok-mozhet-zarabotat/", icon: "graph-up", description: "Первые деньги, карманные расходы и финансовые привычки" },
  { title: "Детский лагерь", url: "/detskiy-lager/", icon: "house-door", description: "IT-лагерь АйДаКемп — полное описание программы" },
];

const faqItems = [
  {
    question: "С какого возраста учить ребёнка финансовой грамотности?",
    answer: "Базовые понятия — «деньги», «обмен», «копить» — можно вводить уже с 6–7 лет через игру. Подросткам 12–14 лет уже доступны бюджет, сбережения и простые инвестиции. К 16 годам стоит обсуждать кредиты, налоги и первый заработок."
  },
  {
    question: "Карманные деньги — давать или нет?",
    answer: "Давать — но с условиями. Зафиксированная сумма раз в неделю или месяц учит планированию. Важно не добавлять деньги «по требованию» — иначе навык не формируется. Пусть ребёнок сам решает, на что тратить, и видит последствия."
  },
  {
    question: "Объяснять ли ребёнку, сколько зарабатывают родители?",
    answer: "Психологи и финансисты в большинстве рекомендуют — да, но в общих чертах и в правильном контексте. Не «нам мало платят», а «в нашей семье мы распределяем деньги вот так». Это снимает тревогу и формирует реалистичное отношение к деньгам."
  },
  {
    question: "Стоит ли подростку объяснять про крипту и NFT?",
    answer: "Да — честно и без паники. Объясните, что это инструменты с высоким риском, а не способ «быстро разбогатеть». Покажите примеры потерь. Подросток всё равно узнает об этом из интернета — лучше пусть первую версию услышит от вас."
  },
];
---

<Base
  title="Финансовая грамотность для подростков — как и когда учить"
  description="Почему школа не учит финансам. Бюджет, инвестиции, крипта простыми словами. Внутренняя экономика лагеря как тренажёр."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Финансовая грамотность для подростков: как и когда учить",
        "description": "Почему школа не учит финансам. Бюджет, инвестиции, крипта простыми словами. Внутренняя экономика лагеря как тренажёр.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/finansovaya-gramotnost-dlya-podrostkov/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
          {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
          {"@type": "ListItem", "position": 3, "name": "Финансовая грамотность для подростков", "item": "https://aidacamp.ru/stati/finansovaya-gramotnost-dlya-podrostkov/"}
        ]
      }
    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title="Финансовая грамотность для подростков: как и когда учить"
    subtitle="Школа молчит. Интернет пугает. Рассказываем, как говорить с подростком о деньгах без нотаций — и почему лагерь работает лучше учебника."
    breadcrumb="Финансовая грамотность для подростков"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Подростки обсуждают финансовый проект в IT-лагере АйДаКемп"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <h2>Почему школа не учит финансовой грамотности</h2>
    <p>
      Спросите любого выпускника: знает ли он, что такое сложный процент, как работает кредитная карта
      или почему инфляция съедает сбережения под подушкой? В большинстве случаев — нет. Школьная программа
      заканчивается на задачках про «Маша купила 5 кг картошки», но не объясняет, как устроен реальный мир денег.
    </p>
    <p>
      Это не случайность. Российская школа исторически ориентирована на передачу академических знаний,
      а финансовая грамотность — прикладная дисциплина. Она требует практики, ошибок и разбора реальных ситуаций.
      По данным исследований, больше 60% россиян не могут правильно рассчитать переплату по кредиту.
      Большинство из них тоже ходили в школу — просто этому там не учили.
    </p>
    <p>
      Итог предсказуем: подростки, которые не получили финансового образования дома, входят во взрослую жизнь
      с нулевой базой. Первая зарплата — и сразу кредитная карта. Первый доход — и «куплю что давно хотел».
      Никаких сбережений, никакого плана. Именно поэтому финансовой грамотности нужно учить — и лучше начинать
      до того, как появятся первые настоящие деньги.
    </p>

    <h2>Три базовых понятия: бюджет, сбережения, инвестиции</h2>
    <p>
      Сложные термины пугают — и взрослых, и подростков. Но за каждым из них стоит очень простая идея,
      которую можно объяснить на примере из жизни школьника.
    </p>
    <p>
      <strong>Бюджет</strong> — это план. Ты знаешь, сколько у тебя денег на неделю, и заранее решаешь,
      на что они пойдут. Не «трачу пока есть», а «сначала откладываю, потом трачу остаток». Подростку
      с карманными деньгами легко попробовать: 500 рублей в неделю, из них 100 — в копилку, 400 — на всё остальное.
    </p>
    <p>
      <strong>Сбережения</strong> — это деньги, которые работают на будущую цель, а не на сиюминутное желание.
      «Хочу iPhone через год» — сбережения. «Куплю сейчас в кредит» — антисбережения. Подросткам важно понять:
      накопить 30 000 рублей за год, откладывая по 2 500 в месяц, вполне реально.
    </p>
    <p>
      <strong>Инвестиции</strong> — это когда деньги приносят другие деньги. Банковский вклад — уже инвестиция.
      Акции, облигации, ETF — чуть сложнее, но суть та же: ты не тратишь деньги сейчас,
      чтобы в будущем иметь больше. Для подростка достаточно понять принцип — детали придут позже.
    </p>

    <h2>Как разговаривать с подростком о деньгах</h2>
    <p>
      Главная ошибка — читать лекцию. «Деньги надо беречь», «ты не умеешь ценить то, что зарабатывается трудом» —
      эти фразы закрывают разговор, а не открывают его. Подросток слышит нотацию и отключается.
    </p>
    <p>
      Работает другое: конкретные ситуации без осуждения. Он потратил карманные деньги за три дня —
      не ругайте, а спросите: «Что купил? Доволен? Как думаешь, почему так быстро закончились?»
      Пусть сам придёт к выводу. Ошибка, которую ребёнок осмыслил сам, запоминается лучше любого урока.
    </p>
    <p>
      Карманные деньги — лучший учебный инструмент, который у вас есть. Фиксированная сумма, регулярная выплата,
      полная свобода в расходах — и полная ответственность за последствия. Если кончились в понедельник,
      новые придут в пятницу. Это не жестокость — это обучение. Именно так устроен взрослый мир.
    </p>
    <p>
      Можно идти дальше: обсуждать семейный бюджет в общих чертах, показывать коммунальные квитанции,
      объяснять, почему отпуск в этом году короче. Подростки способны понять больше, чем кажется,
      — главное, говорить с ними, как с людьми, а не как с детьми.
    </p>

    <h2>Внутренняя экономика лагеря как тренажёр</h2>
    <p>
      В АйДаКемп есть своя система внутренней валюты — рубли (далее — игровая валюта лагеря).
      Это не просто «начисление за хорошее поведение» — это полноценная мини-экономика, в которой подростки
      оказываются участниками уже в первый день смены.
    </p>
    <p>
      Игровые рубли зарабатываются за реальные действия: участие в активностях, прогресс в проекте,
      помощь другим участникам, выступление на презентации. Тратятся — на дополнительное экранное время,
      выбор места в столовой или другие привилегии. Аналогия простая: как в «Монополии» — прошёл круг,
      получил 200 рублей. Но здесь «круг» — это реальная задача, а не бросок кубика.
    </p>
    <p>
      Что происходит в голове подростка? Он начинает думать стратегически. Потратить сейчас или накопить?
      Что для меня ценнее — экранное время сегодня или возможность выбрать проект завтра?
      Эти решения — маленькие, с небольшими «ставками» — формируют именно те навыки,
      которые потом работают с настоящими деньгами. Подробнее о том, как устроена эта система,
      читайте в статье <a href="/stati/vnutrennyaya-ekonomika-v-lagere/">«Внутренняя экономика лагеря»</a>.
    </p>
    <p>
      Родители часто удивляются: ребёнок вернулся из лагеря и вдруг стал думать, прежде чем тратить.
      Это не магия — это две недели практики в безопасной среде, где ошибка стоит игровых рублей,
      а не настоящих денег.
    </p>

    <h2>Крипта и NFT для подростков — как объяснить</h2>
    <p>
      Подросток в {SEASON_YEAR} году точно слышал слова «биткоин», «крипта», «NFT». Скорее всего, он видел
      в интернете истории про тех, кто «разбогател за ночь». Игнорировать эту тему — значит оставить
      его один на один с непроверенной информацией.
    </p>
    <p>
      Честный разговор выглядит так: криптовалюта — это реальный финансовый инструмент,
      но с очень высоким риском. Цена может вырасти вдвое — и упасть в десять раз за один месяц.
      Большинство историй «я купил биткоин за 100 долларов» умалчивают о тех, кто купил на пике
      и потерял всё. NFT в большинстве случаев обесценились до нуля.
    </p>
    <p>
      Это не значит «крипта — зло». Это значит: нельзя вкладывать деньги, которые не готов потерять.
      И нельзя принимать финансовые решения на основе советов незнакомцев из Telegram-каналов.
      Подросток, который это понял, защищён лучше многих взрослых.
    </p>
    <p>
      Хорошее упражнение: попросить подростка «вложить» небольшую сумму в демо-портфель
      (многие биржи дают виртуальные деньги для обучения) и понаблюдать за ним месяц.
      Реальный опыт волатильности запоминается надёжнее любой лекции.
    </p>

    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}
  </main>
  <ArticleBottomCta
    title="Хотите, чтобы ребёнок научился думать о деньгах?"
    subtitle="В АйДаКемп подростки управляют собственным бюджетом внутри лагеря — и возвращаются домой с новым мышлением."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
