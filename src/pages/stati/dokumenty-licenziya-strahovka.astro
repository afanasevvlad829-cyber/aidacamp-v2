---
import { VYCHET_MAX, SEASON_YEAR } from '../../data/shifts';
import { STAT_LICENSE, STAT_RTO } from '../../data/contacts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const faqItems = [
  {
    question: "Какие документы нужны при выборе детского лагеря?",
    answer: "Лицензия Минобрнауки (обязательна для образовательного лагеря), свидетельство туроператора в реестре РТО, страховка от несчастного случая. Проверяйте наличие договора с условиями возврата."
  },
  {
    question: "Зачем лагерю образовательная лицензия?",
    answer: `Без лицензии нельзя официально давать образовательные услуги и оформить налоговый вычет 13% от стоимости. АйДаКемп — лицензия ${STAT_LICENSE} Минобрнауки.`
  },
  {
    question: "Как проверить, что лагерь — реальный туроператор?",
    answer: `Через реестр tourinfo.ru — введите ИНН или название. АйДаКемп — РТО ${STAT_RTO}, ООО «ВОИП КОННЕКТ», ИНН 7729713637.`
  },
  {
    question: "Как проверить лицензию лагеря самостоятельно?",
    answer: "Зайдите на сайт Рособрнадзора (obrnadzor.gov.ru) в раздел «Реестр лицензий» и введите ИНН организации. Для АйДаКемп — ИНН 693203571312. Там увидите статус лицензии, дату выдачи и перечень образовательных программ. Это занимает 2 минуты и снимает все вопросы."
  },
  {
    question: "Можно ли получить налоговый вычет за лагерь с иностранным гражданством ребёнка?",
    answer: "Налоговый вычет получает родитель, который платит НДФЛ в России. Гражданство ребёнка значения не имеет — важен статус налогового резидента родителя. Если вы работаете в России и платите НДФЛ — вычет доступен."
  }
];

const relatedPages = [
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-coin", description: "Калькулятор возврата 13%" },
  { title: "Документы и договор", url: "/legal/", icon: "file-text", description: "Все юридические документы лагеря" },
  { title: "Внутренняя экономика в лагере", url: "/stati/vnutrennyaya-ekonomika-v-lagere/", icon: "coin", description: "Как работает валюта АйДаКемп" },
];
---

<Base
  title="Документы лагеря: лицензия, страховка, налоговый вычет | АйДаКемп"
  description={`Лицензия Минобра, налоговый вычет 13% (до ${VYCHET_MAX} возврат), страховка туроператора 500 000 ₽. Все документы АйДаКемп для родителей.`}
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Документы лагеря: лицензия, страховка, налоговый вычет | АйДаКемп",
      "description": `Лицензия Минобра, налоговый вычет 13% (до ${VYCHET_MAX} возврат), страховка туроператора 500 000 ₽. Все документы АйДаКемп для родителей.`,
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-21",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/dokumenty-licenziya-strahovka"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какие документы нужны при выборе детского лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Лицензия Минобрнауки (обязательна для образовательного лагеря), свидетельство туроператора в реестре РТО, страховка от несчастного случая. Проверяйте наличие договора с условиями возврата." }
        },
        {
          "@type": "Question",
          "name": "Зачем лагерю образовательная лицензия?",
          "acceptedAnswer": { "@type": "Answer", "text": `Без лицензии нельзя официально давать образовательные услуги и оформить налоговый вычет 13% от стоимости. АйДаКемп — лицензия ${STAT_LICENSE} Минобрнауки.` }
        },
        {
          "@type": "Question",
          "name": "Как проверить, что лагерь — реальный туроператор?",
          "acceptedAnswer": { "@type": "Answer", "text": `Через реестр tourinfo.ru — введите ИНН или название. АйДаКемп — РТО ${STAT_RTO}, ООО «ВОИП КОННЕКТ», ИНН 7729713637.` }
        }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Документы лагеря: лицензия, страховка и налоговый вычет"
    subtitle="Всё, что мамы спрашивают перед оплатой — собрали в одном месте. Без юридического жаргона."
    imageBase="hakaton"
    imageAlt="Дети на хакатоне АйДаКемп — безопасный лагерь с лицензией"
    breadcrumbsLast="Документы и безопасность"
    readTime="4 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <nav class="mb-10 p-4 bg-slate-50 rounded-xl border border-slate-100">
        <p class="text-base font-semibold text-slate-500 uppercase tracking-wide mb-3">В этой статье</p>
        <ul class="flex flex-col gap-2">
          <li><a href="#licenziya" class="text-[16px] text-orange-600 hover:underline">Лицензия Министерства образования</a></li>
          <li><a href="#nalogovyj-vychet" class="text-[16px] text-orange-600 hover:underline">Налоговый вычет 13%</a></li>
          <li><a href="#strahovka" class="text-[16px] text-orange-600 hover:underline">Страховка туроператора</a></li>
          <li><a href="#medsestra" class="text-[16px] text-orange-600 hover:underline">Медицинское обеспечение</a></li>
        </ul>
      </nav>

      <div id="licenziya" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            <a href="#licenziya" class="text-slate-900 hover:text-orange-600 no-underline transition-colors">Лицензия Министерства образования</a>
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп работает по государственной лицензии на образовательную деятельность — ОКВЭД 85.41 (дополнительное образование детей и взрослых). Это не маркетинговый значок, а реальный документ из реестра Рособрнадзора.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что это означает на практике: лагерь проверен государством, программы одобрены, педагоги с документами. И главное — именно эта лицензия даёт вам право на налоговый вычет 13% (о нём ниже).
        </p>
        <div class="p-4 bg-orange-50 border border-orange-100 rounded-xl mb-4">
          <p class="text-base text-slate-600">
            <strong class="text-slate-800">Номер лицензии:</strong>{' '}
            <a
              href="/docs/licenziya-rosobrnadzor.pdf"
              target="_blank"
              rel="noopener"
              class="font-semibold text-orange-700 hover:underline inline-flex items-center gap-1"
              data-analytics-goal="doc_download"
              data-analytics-label="licenziya_pdf"
            >
              <i class="bi bi-file-earmark-pdf-fill text-base" aria-hidden="true"></i>
              {STAT_LICENSE}
            </a>.
            Лицензия уже скачана выше в формате PDF.
            Ищется по ИНН <span class="font-mono font-semibold text-slate-800">693203571312</span><button
              type="button"
              data-copy-inn="693203571312"
              aria-label="Скопировать ИНН в буфер обмена"
              class="ml-1.5 inline-flex items-center justify-center w-6 h-6 rounded hover:bg-orange-100 active:bg-orange-200 transition-colors align-middle"
            ><i class="bi bi-clipboard text-base text-orange-600" aria-hidden="true"></i></button>
          </p>
        </div>
        <script is:inline>
          document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-copy-inn]');
            if (!btn) return;
            const value = btn.getAttribute('data-copy-inn');
            const icon = btn.querySelector('i');
            const setIcon = (cls) => { if (icon) icon.className = cls; };
            const ok = () => {
              setIcon('bi bi-clipboard-check text-base text-green-600');
              setTimeout(() => setIcon('bi bi-clipboard text-base text-orange-600'), 1800);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(value).then(ok).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = value; document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); ok(); } catch(_){}
                document.body.removeChild(ta);
              });
            } else {
              const ta = document.createElement('textarea');
              ta.value = value; document.body.appendChild(ta); ta.select();
              try { document.execCommand('copy'); ok(); } catch(_){}
              document.body.removeChild(ta);
            }
          });
        </script>
      </div>

      <div id="nalogovyj-vychet" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            <a href="#nalogovyj-vychet" class="text-slate-900 hover:text-orange-600 no-underline transition-colors">Налоговый вычет 13%</a>
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы платите НДФЛ — вы можете вернуть 13% от стоимости смены. Это социальный вычет на образование ребёнка, и лагерь с лицензией под него подходит. <a href="/ceny/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Выбрать смену и посмотреть цены →</a>
        </p>
        <ul class="flex flex-col gap-3 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Лимит:</strong> до 110 000 ₽ в год на обучение ребёнка → вернёте до {VYCHET_MAX}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Что нужно от нас:</strong> договор + кассовый чек — выдаём при оплате</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Сроки:</strong> декларацию за {SEASON_YEAR} год можно подать в {SEASON_YEAR + 1}-м — у вас есть 3 года</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Как подать:</strong> через Госуслуги или личный кабинет налоговой (nalog.ru) — занимает 20 минут</span>
          </li>
        </ul>
        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <p class="text-[16px] text-slate-700 mb-2">Посчитайте свой возврат за пару секунд:</p>
          <a href="/nalogovyj-vychet/" class="inline-flex items-center gap-2 text-[16px] font-semibold text-orange-600 hover:underline">
            Калькулятор налогового вычета →
          </a>
        </div>
      </div>

      <div id="strahovka" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            <a href="#strahovka" class="text-slate-900 hover:text-orange-600 no-underline transition-colors">Страховка туроператора</a>
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Деятельность лагеря застрахована как туроператора (локальный туризм) по ФЗ № 132-ФЗ «Об основах туристской деятельности в Российской Федерации».
        </p>
        <ul class="flex flex-col gap-3 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Страховая сумма:</strong> 500 000 ₽</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Что покрывает:</strong> неисполнение или ненадлежащее исполнение обязательств по договору о реализации туристского продукта</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Личная страховка ребёнка</strong> — приобретается родителями отдельно. Стандартный полис НС (несчастный случай) на 14 дней стоит около 1 000–1 500 ₽ с покрытием от 500 000 ₽ — оформляется за 5 минут онлайн в Сбере, Т-Банке или Ингосстрахе.</span>
          </li>
        </ul>
      </div>

      <div id="medsestra" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            <a href="#medsestra" class="text-slate-900 hover:text-orange-600 no-underline transition-colors">Медицинское обеспечение</a>
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          На территории санатория «Изумруд» круглосуточно дежурит медсестра с медицинским образованием. Это не «на всякий случай» — это часть стандарта работы лагеря.
        </p>

        <!-- Что делает медсестра -->
        <div class="mb-6">
          <p class="text-base font-semibold text-slate-800 uppercase tracking-wide mb-3">Что входит в её работу</p>
          <ul class="flex flex-col gap-3">
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700">Приём лекарств по расписанию — вы передаёте подписанную коробочку при заезде, дальше всё на ней</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700">Первая помощь при ушибах, температуре, головной боли — стандартный медпункт</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700">Контроль аллергиков и детей с хроническими заболеваниями — данные передаются на брифинге при заезде</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700">Связь с родителями — при любом недомогании звоним сразу, не ждём «само пройдёт»</span>
            </li>
          </ul>
        </div>

        <!-- Что если заболел серьёзнее -->
        <div class="mb-6 p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <p class="text-base font-semibold text-slate-800 mb-2">Если нужна врачебная помощь</p>
          <p class="text-base leading-[1.6] text-slate-600">
            Санаторий «Изумруд» находится в Наро-Фоминском районе. Ближайшая районная больница — в Наро-Фоминске, 15 минут на машине. При необходимости везём туда или вызываем скорую — всё как у взрослых, только родители в курсе на каждом шаге.
          </p>
        </div>

        <!-- Документы при заезде -->
        <div class="mb-6">
          <p class="text-base font-semibold text-slate-800 uppercase tracking-wide mb-3">Документы о здоровье при заезде</p>
          <ul class="flex flex-col gap-3">
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700"><strong>Справка 079/у</strong> («справка в лагерь») — выдаёт педиатр в поликлинике, действует 3 месяца. Обязательна.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700"><strong>Сведения о прививках</strong> (выписка из прививочного карты или сертификат) — нужны при заезде.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
              <span class="text-[16px] text-slate-700"><strong>Лекарства</strong> — в оригинальной упаковке, с именем ребёнка на вкладыше и инструкцией дозировки. Медсестра не принимает препараты без подписи родителя.</span>
            </li>
          </ul>
          <p class="mt-3 text-base text-slate-500">Напоминание со списком документов приходит на почту за 2 недели до смены автоматически.</p>
        </div>

        <!-- Хронические / аллергики -->
        <div class="p-4 bg-orange-50 border border-orange-100 rounded-xl">
          <p class="text-base font-semibold text-slate-800 mb-2">Хронические заболевания и аллергии</p>
          <p class="text-base leading-[1.6] text-slate-600">
            Принимаем детей с большинством хронических состояний — диабет, бронхиальная астма, аллергии на еду. Уточните при бронировании: опишем, как мы работаем с конкретным случаем, и вы решите. Не берём только при острых состояниях и заразных заболеваниях в активной фазе.
          </p>
        </div>
      </div>


      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <BlogCTA />
