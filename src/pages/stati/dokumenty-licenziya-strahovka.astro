---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';

const relatedPages = [
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "currency-ruble", description: "Калькулятор возврата 13%" },
  { title: "Документы и договор", url: "/legal/", icon: "file-text", description: "Все юридические документы лагеря" },
  { title: "Внутренняя экономика в лагере", url: "/stati/vnutrennyaya-ekonomika-v-lagere", icon: "coin", description: "Как работает валюта АйДаКемп" },
];
---

<Base
  title="Документы лагеря: лицензия, страховка, налоговый вычет | АйДаКемп"
  description="Лицензия Минобра, налоговый вычет 13% (до 14 300 ₽ возврат), страховка туроператора 500 000 ₽. Все документы АйДаКемп для родителей."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/dokumenty-licenziya-strahovka" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Документы лагеря: лицензия, страховка, налоговый вычет",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-21",
      "url": "https://aidacamp.ru/stati/dokumenty-licenziya-strahovka"
    })} />
  </Fragment>
  <Header />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <nav class="mb-6 text-[13px] text-slate-400">
        <a href="/" class="hover:text-orange-500">Главная</a>
        <span class="mx-2">/</span>
        <a href="/stati/" class="hover:text-orange-500">Статьи</a>
        <span class="mx-2">/</span>
        <span class="text-slate-600">Документы и безопасность</span>
      </nav>

      <h1 class="text-[28px] md:text-[38px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900 mb-4">
        Документы лагеря: лицензия, страховка и налоговый вычет
      </h1>
      <p class="text-[16px] md:text-[18px] leading-[1.6] text-slate-500 mb-10 max-w-[680px]">
        Всё, что мамы спрашивают перед оплатой — собрали в одном месте. Без юридического жаргона.
      </p>

      <nav class="mb-10 p-4 bg-slate-50 rounded-xl border border-slate-100">
        <p class="text-[13px] font-semibold text-slate-500 uppercase tracking-wide mb-3">В этой статье</p>
        <ul class="flex flex-col gap-2">
          <li><a href="#licenziya" class="text-[15px] text-orange-600 hover:underline">Лицензия Министерства образования</a></li>
          <li><a href="#nalogovyj-vychet" class="text-[15px] text-orange-600 hover:underline">Налоговый вычет 13%</a></li>
          <li><a href="#strahovka" class="text-[15px] text-orange-600 hover:underline">Страховка туроператора</a></li>
          <li><a href="#medsestra" class="text-[15px] text-orange-600 hover:underline">Медицинское обеспечение</a></li>
        </ul>
      </nav>

      <div id="licenziya" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Лицензия Министерства образования
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп работает по государственной лицензии на образовательную деятельность — ОКВЭД 85.41 (дополнительное образование детей и взрослых). Это не маркетинговый значок, а реальный документ из реестра Рособрнадзора.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что это означает на практике: лагерь проверен государством, программы одобрены, педагоги с документами. И главное — именно эта лицензия даёт вам право на налоговый вычет 13% (о нём ниже).
        </p>
        <div class="p-4 bg-orange-50 border border-orange-100 rounded-xl mb-4">
          <p class="text-[14px] text-slate-600">
            <strong class="text-slate-800">Номер лицензии:</strong> уточняйте у менеджера — вышлем скан на почту или в мессенджер.
            Проверить можно в реестре Рособрнадзора на сайте <span class="text-orange-600 font-medium">obrnadzor.gov.ru</span>.
          </p>
        </div>
      </div>

      <div id="nalogovyj-vychet" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Налоговый вычет 13%
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы платите НДФЛ — вы можете вернуть 13% от стоимости смены. Это социальный вычет на образование ребёнка, и лагерь с лицензией под него подходит.
        </p>
        <ul class="flex flex-col gap-3 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Лимит:</strong> до 110 000 ₽ в год на обучение ребёнка → вернёте до 14 300 ₽</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Что нужно от нас:</strong> договор + кассовый чек — выдаём при оплате</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Сроки:</strong> декларацию за 2026 год можно подать в 2027-м — у вас есть 3 года</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Как подать:</strong> через Госуслуги или личный кабинет налоговой (nalog.ru) — занимает 20 минут</span>
          </li>
        </ul>
        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <p class="text-[15px] text-slate-700 mb-2">Посчитайте свой возврат за пару секунд:</p>
          <a href="/nalogovyj-vychet/" class="inline-flex items-center gap-2 text-[15px] font-semibold text-orange-600 hover:underline">
            Калькулятор налогового вычета →
          </a>
        </div>
      </div>

      <div id="strahovka" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страховка туроператора
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Деятельность лагеря застрахована как туроператора (локальный туризм) по ФЗ № 132-ФЗ «Об основах туристской деятельности в Российской Федерации».
        </p>
        <ul class="flex flex-col gap-3 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Страховая сумма:</strong> 500 000 ₽</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Что покрывает:</strong> неисполнение или ненадлежащее исполнение обязательств по договору о реализации туристского продукта</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Личная страховка ребёнка</strong> включена в стоимость смены — дополнительно ничего покупать не нужно</span>
          </li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-500">
          Реквизиты страхового полиса — в договоре, который получаете при оформлении путёвки.
        </p>
      </div>

      <div id="medsestra" class="mb-10 pt-2 scroll-mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Медицинское обеспечение
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На территории лагеря круглосуточно дежурит медсестра. Медпункт укомплектован — от пластыря до всего необходимого для первой помощи.
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700">Медсестра 24/7 на территории</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700">Аллергии и особенности здоровья ребёнка указываете при оформлении путёвки — передаём медсестре и поварам</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700">При необходимости — связь с родителями сразу, без лишних слов</span>
          </li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-500 italic">
          АйДаКемп — IT-лагерь в Подмосковье, 66 км от Москвы. Смены 2026 — с 30 мая по 26 августа, от 48 000 ₽. <a href="/" class="text-[#ff8a00] font-semibold hover:underline">Узнать про ближайшую смену →</a>
        </p>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Остались вопросы по документам?"
    bookingSubtitle="Позвоним за 10 минут — ответим на любой вопрос и вышлем сканы документов."
  />

  <RelatedPages title="Полезные ссылки" pages={relatedPages} />
  <Footer />
</Base>
