---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Программа для 12–16 лет" },
  { title: `Смены ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как помочь подростку который ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", icon: "heart", description: "Честный разбор для мам" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
];

const faqItems = [
  {
    question: "С какого возраста подростку интересно в IT-лагере?",
    answer: "В АйДаКемп принимают детей от 8 до 16 лет. Для подростков 12–15 лет программа специально сложнее: более серьёзные проекты, командная работа с реальными задачами, больше самостоятельности. В этом возрасте как раз интересно — потому что не скучно."
  },
  {
    question: "А вдруг подросток откажется ехать?",
    answer: "Это распространённая ситуация. Лучший способ — не давить, а показать конкретику: что он там будет делать, какие проекты делали в прошлых сменах, кто туда едет. Подростки хотят смысла, а не «отдохни от нас». Когда они видят реальный проект — интерес появляется."
  },
  {
    question: "Как устроено общение без телефонов?",
    answer: "Телефоны не запрещены полностью — но расписание построено так, что свободного времени для них мало. Дети заняты с утра до вечера. По нашему опыту, подростки сами удивляются: «Я почти не смотрел телефон — и нормально». Живое общение в итоге выигрывает."
  },
  {
    question: "Подросток интроверт — не будет ли ему сложно в группе?",
    answer: "Интровертам часто именно в лагере хорошо — потому что общение идёт через дело, а не светские разговоры. Работаешь над проектом с командой — и дружба возникает сама, без необходимости «быть общительным» в обычном смысле."
  },
  {
    question: "Что делать если подросток категорически отказывается ехать?",
    answer: "Не давить — это точно не работает. Лучше показать конкретику: видео с прошлых смен, отзывы ровесников, проекты которые делали участники. Подростки реагируют на реальный пример, а не на слова «там тебе понравится». Попробуйте: «Посмотри что они делали на хакатоне — тебе было бы интересно такое?» Интерес появляется тогда, когда виден смысл."
  },
  {
    question: "Можно ли родителям навещать ребёнка во время смены?",
    answer: "В АйДаКемп действует стандартная практика: в первые дни лучше не приезжать — даём подростку адаптироваться. Через 3–4 дня большинство уже «вошли» в ритм и не хотят уезжать домой. Родители получают фото каждый день в общий чат смены, а связаться по телефону можно в любое время."
  }
];
---

<Base
  title={`Лучшие лагеря для подростков ${SEASON_YEAR} — что искать и на что смотреть`}
  description="Почему подростки не хотят в обычный лагерь и что их зацепляет. Как устроена программа АйДаКемп для 12–15 лет — реальные проекты, сверстники с похожими"
  ogImage="/images/hero/lager-dlya-podrostkov.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь для подростка: как выбрать, чтобы он сам захотел ехать | АйДаКемп",
        "description": "Почему подростки не хотят в обычный лагерь и что их зацепляет. Как устроена программа АйДаКемп для 12–15 лет.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/luchshie-lagerya-dlya-podrostkov"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": `Лучшие лагеря для подростков ${SEASON_YEAR}`, "item": "https://aidacamp.ru/stati/luchshie-lagerya-dlya-podrostkov/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь для подростка: как выбрать, чтобы он сам захотел ехать"
    subtitle="Не «нужно отдохнуть от телефона» — а по-настоящему захотел. Разбираем что работает."
    imageBase="lager-dlya-podrostkov"
    imageAlt="Подростки работают над проектом в IT-лагере АйДаКемп"
    readTime="6 мин чтения"
    breadcrumbsLast="Лучшие лагеря для подростков"
    daryaQuote="Дочь в 13 лет ехала скептически: «Ну ладно, раз вы настаиваете». Вернулась с фотками, новыми друзьями и словами «можно я летом снова поеду». Вот тогда я поняла — нашли."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Найти лагерь для подростка сложнее, чем для ребёнка помладше. Десятилетний едет потому что «там весело». Тринадцатилетний спрашивает: «А зачем?» И это честный вопрос, который заслуживает честного ответа.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему подростки не хотят в обычный лагерь
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Обычный летний лагерь строится на логике «развлечь и занять». Это работает для детей 7–10 лет. Подросток в 12–15 лет уже не хочет быть развлечённым — он хочет быть значимым. Делать что-то настоящее. Чувствовать, что это не зря.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Типичный лагерь с конкурсами «кто громче кричит» и дискотекой под одни и те же песни — это не про смысл. Подростки это чувствуют и называют одним словом: скучно. Не потому что им вообще всё скучно — а потому что конкретно это им не подходит.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Ещё один барьер — социальный. Подросток едет в незнакомое место к незнакомым людям. Если там нет ничего общего с его интересами — зачем туда ехать? А если там будут такие же, кто любит программирование, игры, создание чего-то своего — совсем другое дело.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что их зацепляет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Из нашего опыта — три вещи, которые работают для подростков лучше всего.
        </p>
        <ul class="flex flex-col gap-5 mb-4">
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center">1</span>
            <div>
              <p class="text-[16px] font-semibold text-slate-800 mb-1">Реальный проект, а не учебное задание</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">Подростку важно сделать что-то настоящее. Игру, сайт, приложение — которое работает и которое можно показать. Не «выполнить задание для преподавателя», а создать своё. В АйДаКемп финал каждой смены — хакатон: команды делают проект за несколько часов и представляют всему лагерю.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center">2</span>
            <div>
              <p class="text-[16px] font-semibold text-slate-800 mb-1">Сверстники с похожими интересами</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">В школьном классе подросток, который любит программирование, часто белая ворона. В IT-лагере таких, как он, большинство. Это меняет самоощущение: из «странного» — в «нормального». Дружба завязывается быстро, потому что есть общий язык с первого дня.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center">3</span>
            <div>
              <p class="text-[16px] font-semibold text-slate-800 mb-1">Нет телефонов — есть живое общение</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">Звучит парадоксально для IT-лагеря — но это работает. Когда телефон не нужен (рядом интересные люди и интересное дело), подростки открываются. Разговаривают по-настоящему, шутят, спорят, придумывают вместе. Это та социализация, которую не заменит онлайн.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как в АйДаКемп устроена программа для 12–15 лет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для подростков в АйДаКемп — отдельные треки с более сложными задачами. Не «пишем первую программу», а уже — алгоритмы, структуры данных, командная разработка. Темп выше, проекты серьёзнее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Группы по возрасту — 12–13 и 14–16 лет — чтобы не было ситуации «десятилетний рядом с пятнадцатилетним». Это важно для подростков: они острее воспринимают разницу в возрасте и интересах.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вечерняя программа — не «обязательные конкурсы», а выбор: настольные игры, кино, прогулки, разговоры у костра. Подростки ценят возможность самим решать, как проводить свободное время.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-500 italic">
          АйДаКемп — IT-лагерь в Подмосковье, 66 км от МКАД. Смены {SEASON_YEAR} с мая по август. <a href="/ceny/" class="text-primary font-semibold hover:underline">Посмотреть расписание →</a>
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять что лагерь подходит именно подростку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Подросток — не ребёнок помладше. Критерии выбора лагеря для 12–16-летних отличаются от критериев для 8-летних.
        </p>
        <div class="flex flex-col gap-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-person-check text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-base font-semibold text-slate-800 mb-1">Возрастные группы раздельные</p>
                <p class="text-base leading-[1.6] text-slate-600">Смешивать 10-летних и 15-летних — плохая идея. Проверьте: есть ли отдельный трек для подростков, своё расписание, свои задачи.</p>
              </div>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-lightning-charge text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-base font-semibold text-slate-800 mb-1">Уровень сложности — выше</p>
                <p class="text-base leading-[1.6] text-slate-600">Подросток скучает, если задачи слишком простые. Уточните: какие конкретно проекты делали участники 13–15 лет в прошлых сменах. Это сразу скажет об уровне.</p>
              </div>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <i class="bi bi-chat-square-text text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-base font-semibold text-slate-800 mb-1">Свобода выбора в свободное время</p>
                <p class="text-base leading-[1.6] text-slate-600">Подростки плохо переносят «обязательное веселье». Лучший лагерь предлагает варианты, а не расписывает каждую минуту. Спросите как устроены вечера.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>


  <ArticleBottomCta
    bookingTitle="Подберём смену для вашего подростка"
    bookingSubtitle="Программа 12–16 лет: Python, AI, хакатон. Перезвоним в течение 10 минут."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
