---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';

const relatedPages = [
  { title: "Лагеря в необычных местах планеты", url: "/stati/lagerya-v-neobychnykh-mestakh/", icon: "globe2", description: "Куда ещё возят детей — от пустыни до тайги" },
  { title: "Знаменитости, которые побывали в лагере", url: "/stati/znamenitosti-v-lagere/", icon: "star-fill", description: "Известные люди, чьё детство прошло в лагере" },
  { title: "Финляндия: почему дети учатся в лесу", url: "/stati/finlyandiya-deti-v-lesu/", icon: "tree-fill", description: "Скандинавский подход к образованию на природе" },
];
---

<Base
  title="IT-лагеря в странах без интернета: дети, которые изобрели мир без Wi-Fi | АйДаКемп"
  description="Мальчик из Сьерра-Леоне построил радиостанцию из мусора и попал в MIT. Малавийский подросток прочитал одну книгу и построил ветряк. Что происходит, когда дети учатся без интернета."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="it-lagerya-bez-interneta"
      title="IT-лагеря в странах без интернета: дети, которые изобрели мир без Wi-Fi"
      description="Мальчик из Сьерра-Леоне построил радиостанцию из мусора и попал в MIT. Малавийский подросток прочитал одну книгу и построил ветряк. Что происходит, когда дети учатся без интернета."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="IT-лагеря в странах без интернета: дети, которые изобрели мир без Wi-Fi"
    subtitle="Мальчик из Сьерра-Леоне построил радиостанцию из мусора и попал в MIT. Малавийский подросток прочитал одну книгу и построил ветряк. Что происходит, когда дети учатся без интернета."
    breadcrumbsLast="IT-лагеря без интернета"
    readTime="8 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="6.67" unit="%" label="детей в Южном Судане имеют доступ к интернету (2024)" tone="red" size="lg" />
          <AnimatedStat value="15" label="лет было Кельвину Дои, когда его пригласили в MIT — самый молодой участник программы" tone="orange" size="lg" />
          <AnimatedStat value="10" unit=" млн" label="просмотров набрало видео о Кельвине после поездки в MIT" tone="blue" size="lg" />
          <AnimatedStat value="2000" unit="+" label="домов в Кении защищены изобретением Ричарда Туреры" tone="green" size="lg" />
        </div>
      </div>

      <!-- Вступление -->
      <div class="mb-10">
        <div class="rounded-[16px] bg-amber-50 border-l-4 border-amber-400 px-6 py-5">
          <p class="text-[15px] leading-[1.6] text-slate-700">
            В мире 40 стран, где уровень проникновения интернета ниже 20%: Чад — 12,6%, Нигер — 15,6%, Эфиопия — 16,7%, Южный Судан — 6,7%. Педагоги ломают голову, как учить там программированию. А дети просто берут мусор с улицы и начинают изобретать.
          </p>
        </div>
      </div>

      <!-- Кельвин Дои -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кельвин Дои, 13 лет, Сьерра-Леоне: радиостанция из мусора
          </h2>
        </div>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">1996 год рождения, Фритаун</span>
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Без интернета, без учителя, без учебников</span>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С 10 лет Кельвин Дои разбирал выброшенную электронику с городских свалок. Не из любопытства — из необходимости. В районе постоянно отключали электричество. Он хотел дать соседям свет.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">1</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Аккумулятор</strong> из кислоты, соды и металлолома. Дал соседям электричество во время отключений.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">2</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Генератор</strong> с ручным приводом из деталей разобранных устройств.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">3</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Аудиомикшер</strong> с несколькими каналами — из компонентов, которые другие выбросили.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">4</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>FM-передатчик</strong> для своей радиостанции. Ему было 13. Псевдоним — DJ Focus.</p>
          </div>
        </div>
        <div class="rounded-[16px] bg-white border-l-4 border-orange-400 px-6 py-5 mb-6">
          <p class="text-[16px] italic leading-[1.6] text-slate-700 mb-2">«Творчество — это не привилегия. Оно появляется там, где его не ждут.»</p>
          <p class="text-[13px] font-semibold text-slate-500">Кельвин Дои, TED×Teen 2013</p>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Метод обучения:</strong> никакого интернета, никаких учителей, никаких учебников. Только принцип: разобрать каждую деталь, понять как работает, собрать по-новому. Мама находила гостиную «похожей на мусорный двор» после его ночных сессий.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <strong>2012, MIT:</strong> 15 лет. Конкурс Innovate Salone, на котором Кельвин представил генератор из металлолома, привлёк внимание учёных. Приглашение в MIT — самый молодой участник Visiting Practitioner's Program в истории программы. Видео о нём набрало 10 миллионов просмотров. Сегодня — основатель K-Doe Tech, Inc.
        </p>
      </div>

      <!-- Уильям Камквамба -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Уильям Камквамба, 14 лет, Малави: ветряк из книги
          </h2>
        </div>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">1987 год рождения, деревня Вимбе</span>
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Одна библиотечная книга + мусор</span>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          2001 год. В Малави — катастрофический голод. Семья Уильяма больше не может платить $80 ежегодного взноса за школу. Ему 14 лет, он выпадает из системы образования.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вместо того чтобы сдаться, он идёт в маленькую деревенскую библиотеку. Берёт американский учебник «Using Energy». Внутри — схемы ветряков. Электричества в доме нет. Настоящего ветряка он никогда не видел.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">1</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Материалы:</strong> стволы голубой эвкалиптовой камеди для башни, ПВХ-трубы для лопастей, велосипедное динамо, тракторные вентиляторные лопасти — найденные, не купленные.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-7 w-7 rounded-full bg-orange-100 text-orange-600 text-[13px] font-bold mt-0.5">2</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Результат:</strong> ветряк высотой 5 метров. Даёт электричество для четырёх лампочек и двух радиоприёмников в доме. Соседи думали, что он сошёл с ума.</p>
          </div>
        </div>
        <div class="rounded-[16px] bg-white border-l-4 border-orange-400 px-6 py-5 mb-6">
          <p class="text-[16px] italic leading-[1.6] text-slate-700">Когда зажглись огни, деревня собралась в изумлении.</p>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <strong>TEDGlobal 2007, Аруша:</strong> первое выступление на ломаном английском с переводчиком. Венчурные капиталисты в зале финансировали его возвращение в школу. Потом — African Leadership Academy, потом — Дартмут (выпуск 2014). Книга «The Boy Who Harnessed the Wind», фильм Netflix 2019. Фонд Moving Windmills Project работает до сих пор.
        </p>
      </div>

      <!-- Ричард Туреро -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Ричард Туреро, 11 лет, Кения: огни против львов
          </h2>
        </div>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Китенгела, край Найробийского нацпарка</span>
          <span class="text-[12px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Инструмент обучения: разобрал все телевизоры в доме</span>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Семья Туреро — масаи. Основное богатство — скот. Львы из национального парка регулярно убивали коров, коз, овец. Фермеры убивали львов в ответ.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В 11 лет Ричарду поручили охранять стадо ночью. Он заметил: огонь и пугала не останавливали львов. Но движущийся фонарик — останавливал.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          <strong>Изобретение без бюджета:</strong> LED-огни по периметру загона + автомобильные поворотники (те самые, что заставляют мигать фары) + аккумулятор от машины + маленькая солнечная панель. Стоимость материалов — около $15. Огни вращаются по очереди, имитируя движение человека с фонарём. Общая сумма материалов — ~$15.
        </p>
        <div class="rounded-[16px] bg-green-50 border-l-4 border-green-400 px-6 py-5 mb-6">
          <div class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-700"><strong>Результат: нападения на скот семьи прекратились немедленно.</strong> Система Lion Lights теперь стоит в 2000+ домах по всей Кении, Танзании, Ботсване, Намибии, Аргентине и Индии.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <strong>TED2013, Лонг-Бич:</strong> один из самых молодых спикеров TED в истории конференции. После — стипендия школы Brookhouse в Найроби. Степень по глобальным проблемам и охране дикой природы.
        </p>
      </div>

      <!-- Общий паттерн -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Общий паттерн: что объединяет этих троих
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[14px] bg-red-50 border border-red-200 p-4 text-center">
            <i class="bi bi-bullseye text-red-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-900 mb-1">Конкретная проблема</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Не абстрактное «изучение технологий». Конкретная боль: нет света, нет еды, убивают скот.</p>
          </div>
          <div class="rounded-[14px] bg-blue-50 border border-blue-200 p-4 text-center">
            <i class="bi bi-book text-blue-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-900 mb-1">Ноль формальных инструкций</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Без интернета, без учителя, без курсов. Максимум — одна книга (Камквамба). Остальные — разбор и сборка.</p>
          </div>
          <div class="rounded-[14px] bg-amber-50 border border-amber-200 p-4 text-center">
            <i class="bi bi-tools text-amber-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-900 mb-1">Физическая работа руками</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Демонтаж, анализ, сборка по-другому. Обучение через прикосновение, а не через экран.</p>
          </div>
          <div class="rounded-[14px] bg-purple-50 border border-purple-200 p-4 text-center">
            <i class="bi bi-geo-alt-fill text-purple-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[14px] font-bold text-slate-900 mb-1">Локальное решение → глобальное признание</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Никто из них не стремился стать знаменитым. Они просто чинили то, что сломалось рядом.</p>
          </div>
        </div>
      </div>

      <!-- Как учат программированию без компьютеров -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как учат программированию без компьютеров
          </h2>
        </div>
        <div class="space-y-3">
          <div class="rounded-[16px] bg-white border border-slate-200 p-5">
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <p class="text-[15px] font-bold text-slate-900">Tangible Africa</p>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700">ЮАР, Кения, Гана</span>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Обучение программированию через физические игры и офлайн-приложения для телефона. Игра RANGERS — «поймай браконьера, спаси носорога» — учит логике алгоритмов. 120 000 участников в 22 странах к 2023 году.</p>
          </div>
          <div class="rounded-[16px] bg-white border border-slate-200 p-5">
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <p class="text-[15px] font-bold text-slate-900">Kenya Smart Coders</p>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700">Кения</span>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Учебники Oxford University Press по программированию без компьютеров. Кения — первая страна в Африке, где школьники могут официально изучать программирование под деревом, без устройств и без интернета.</p>
          </div>
          <div class="rounded-[16px] bg-white border border-slate-200 p-5">
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <p class="text-[15px] font-bold text-slate-900">Rwanda Coding Academy</p>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700">Ньябиху, Западная провинция</span>
            </div>
            <p class="text-[14px] leading-[1.6] text-slate-600">Государственная школа для самых талантливых детей Руанды. Расположена намеренно в сельской местности. 70+ технологических проектов в сферах здравоохранения, образования, безопасности. Финалист Global Schools Prize.</p>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-6 text-center">
          <i class="bi bi-lightbulb-fill text-amber-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Интернет ускоряет обучение. Но самые изобретательные решения рождаются там, где его нет. Когда нельзя найти ответ на сайте — приходится думать самому. Именно этому и учит хороший лагерь.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <Footer />
</Base>
