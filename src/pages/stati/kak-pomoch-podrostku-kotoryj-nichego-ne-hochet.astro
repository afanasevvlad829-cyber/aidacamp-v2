---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Проблемы в общении подростков", url: "/stati/problemy-v-obschenii-podrostkov/", icon: "chat", description: "Почему замкнулся — ещё одна грань апатии" },
  { title: "Подросток не хочет учиться", url: "/stati/podrostok-ne-hochet-uchitsya/", icon: "book", description: "Частая форма «ничего не хочет»" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Среда где интерес возвращается" },
];
---

<Base
  title="Подросток ничего не хочет — апатия или лень: 5 шагов помочь"
  description="«Весь день в телефоне, ничего не интересует» — узнайте почему так бывает и 5 шагов, которые помогли другим мамам вытащить детей из апатии. Без давления."
  ogImage="/images/hero/lager-dlya-podrostkov.avif"
>
  <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Подросток ничего не хочет — как помочь без давления и лекций | АйДаКемп",
      "description": "«Ему ничего не интересно», «весь день в телефоне» — это не лень, это апатия. 5 шагов что работает по опыту мам, чьи дети выбрались из апатии.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-03-01",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Почему подросток ничего не хочет делать?",
          "acceptedAnswer": { "@type": "Answer", "text": "Причины разные: апатия как защитная реакция, страх провала, скука от отсутствия интересного занятия, перегрузка школой. Важно не давить, а найти то, что реально вызывает интерес — даже если это компьютерные игры." }
        },
        {
          "@type": "Question",
          "name": "Как мотивировать подростка без скандалов?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не запрещать то, что нравится, а расширять: из игр в создание игр, из YouTube в видеопроизводство. Важно, чтобы подросток видел результат своих действий — что-то, чем можно гордиться." }
        },
        {
          "@type": "Question",
          "name": "Помогает ли лагерь подростку найти интерес к жизни?",
          "acceptedAnswer": { "@type": "Answer", "text": "Часто — да. Смена среды, новые ровесники с похожими интересами, реальный проект в финале — многие подростки в лагере находят то, чем хотят заниматься дальше." }
        },
        {
          "@type": "Question",
          "name": "Когда апатия — это уже не про лень, а про психологию?",
          "acceptedAnswer": { "@type": "Answer", "text": "Если апатия длится более 3 месяцев и сопровождается нарушением сна, отказом от еды, замкнутостью, самокритикой или мыслями о себе в очень негативном ключе — это повод обратиться к детскому психологу или психиатру. Лагерь помогает при «бытовой» апатии, но не заменяет профессиональную помощь при депрессии." }
        },
        {
          "@type": "Question",
          "name": "Как отличить апатию от лени?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ленивый подросток всё же включается, когда ему интересно — игра, встреча с другом, что-то приятное. Апатичный не включается даже тогда. Ещё признак: при апатии подросток сам не рад своему состоянию — «я не знаю почему мне скучно всё». При лени обычно чёткое понимание: «не хочу, потому что неинтересно»." }
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Подросток ничего не хочет", "item": "https://aidacamp.ru/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как помочь подростку, который ничего не хочет"
    subtitle="«Ничего не хочу», «мне ничего не интересно» — не лень, это апатия. Что реально работает."
    imageBase="apatiya"
    imageAlt="Подростки увлечены настольной/мобильной игрой — активность возвращается когда появляется занятие"
    readTime="6 мин чтения"
    breadcrumbsLast="Как помочь подростку который ничего не хочет"
    daryaQuote="Дочь говорила «мне ничего не хочется». В лагере на 3-й день — сама первой предложила идею проекта. Апатия не лечится уговорами, она уходит когда появляется задача, которая твоя."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Что тебе интересно?» — «ничего». «Чем хочешь заниматься?» — «не знаю». «А может попробуем?» — «не хочу». Знакомые диалоги? Если вы застряли в них надолго — нужно менять подход. Рассказываем 5 шагов, которые по нашему опыту работают у 70% семей. Без психолога и без скандалов.
        </p>

        <StatCallout
          value="~46%"
          label="подростков признают, что проводят почти всё свободное время онлайн — уход от реальности."
          source="Pew Research, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему подросток «ничего не хочет» — причины
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Апатия — не болезнь ребёнка, а симптом. У него есть причина. Чаще всего одна из этих:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Переутомление.</strong> Школа + 3 кружка + репетитор = подросток физически и эмоционально истощён. Сил на новое просто нет.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Дофаминовая яма от экрана.</strong> Если подросток 4+ часов в день в TikTok/играх — мозг привыкает к интенсивному дофамину. Обычная жизнь не может конкурировать, кажется «скучной».</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Все решения за него принимают взрослые.</strong> Если 12 лет у ребёнка не было реального выбора — у него атрофируется мотивационная мышца. «Что хочешь» превращается в «не знаю».</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Страх провала.</strong> Раньше что-то попробовал и не получилось — взрослые раскритиковали. Теперь подросток не пробует заранее, чтобы избежать повтора.</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Депрессия или тревожное расстройство.</strong> Если апатия +3 месяца и сопровождается нарушением сна, аппетита, мыслями о себе в негативном ключе — это медицина, не лагерь.</span></li>
        </ul>
      </div>

        <StatCallout
          value="6 мес"
          label="средний срок, за который апатия подростка закрепляется без вмешательства."
          source="клиническая практика"
          icon="emoji-frown"
          tone="neutral"
        />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 1. Убрать перегрузку
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Первое — парадоксально. Не добавлять новое, а <strong>убирать старое</strong>. Отмените один кружок (самый нелюбимый), сократите репетитора до одного раза в неделю, договоритесь чтобы в выходные никаких обязательств. Подростку нужно 2-3 недели простоя чтобы «накопились» силы и желания. На пустой батарейке хотеть невозможно.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 2. Ограничить экран (без скандала)
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Договор вместо запрета: «предлагаю на месяц эксперимент — по 2 часа экрана в день, остальное мы вместе». Важно чтобы вы тоже соблюдали (не сидели в своём телефоне рядом с его 2 часами). Через 2-3 недели подросток начнёт замечать мир вне экрана. Появится скука — это нормально, из неё рождается интерес.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 3. Дать выбирать самому
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не «я записала тебя в секцию по плаванию», а «есть 3 варианта — плавание, бокс, лыжи. Выбирай или предложи своё». Даже если выберет «ничего» — это тоже выбор. Запомните: мотивационная мышца растёт только когда ребёнок сам принимает решения.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хитрость: дайте выбор из реалистичных вариантов которые вы сами готовы поддержать. Не «что хочешь», а «вот список из 5 вариантов, выбери 2».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 4. Сменить среду на 10-14 дней
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Самый мощный инструмент. Когда подросток вырывается из привычной среды (дом, школа, друзья, гаджеты, ритуалы) в новую — психика перезагружается. Одни дети хорошо реагируют на лагерь, другие на поход или поездку к бабушке в деревню. Главное условие — чтобы в новой среде была <strong>команда сверстников + какое-то общее дело</strong>. Просто «отдых» не работает: подросток в санатории будет лежать и скучать ещё больше.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Идеальная «смена среды» имеет: другую географию, новых ровесников, структурированные занятия, результат в конце. Например: <a href="/ceny/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">IT-лагерь с проектом и хакатоном в финале</a>.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 5. Первое «хочу» — закрепить
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда у подростка наконец появляется первый интерес — даже маленький — главная ошибка родителей: обесценить. «Ой опять какая-то ерунда», «это не серьёзно», «лучше бы учёбой занялся». Последствия: следующее «хочу» не появится ещё полгода.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Правило: любое первое «хочу» поддерживаем безоговорочно. Хочет кататься на скейте — покупаем скейт. Хочет научиться Python — записываем. Хочет свою собаку — долго и вдумчиво обсуждаем, но всерьёз. Цена поддержки этого первого «хочу» всегда меньше цены апатии на 6 месяцев вперёд.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Апатия или лень — как отличить
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это важный вопрос — от ответа зависит подход. Грубая проверка:
        </p>
        <div class="space-y-4 mb-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="border border-slate-200 rounded-xl p-5">
              <p class="text-base font-semibold text-slate-800 mb-3">
                <i class="bi bi-battery-half text-orange-500 me-2" aria-hidden="true"></i>
                Скорее лень, если:
              </p>
              <ul class="flex flex-col gap-2">
                <li class="text-base text-slate-600">Включается когда что-то реально нравится (игра, встреча с другом)</li>
                <li class="text-base text-slate-600">Чётко знает что хочет — просто не делает</li>
                <li class="text-base text-slate-600">Нет нарушений сна и аппетита</li>
                <li class="text-base text-slate-600">Настроение нормальное, просто инертный</li>
              </ul>
            </div>
            <div class="border border-orange-200 rounded-xl p-5 bg-orange-50">
              <p class="text-base font-semibold text-slate-800 mb-3">
                <i class="bi bi-battery text-red-500 me-2" aria-hidden="true"></i>
                Скорее апатия, если:
              </p>
              <ul class="flex flex-col gap-2">
                <li class="text-base text-slate-600">Не включается даже на приятное — игра тоже «скучная»</li>
                <li class="text-base text-slate-600">Сам не знает чего хочет и искренне расстроен этим</li>
                <li class="text-base text-slate-600">Изменился сон, аппетит, общение с друзьями</li>
                <li class="text-base text-slate-600">Больше 2–3 месяцев без улучшений</li>
              </ul>
            </div>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Лень лечится интересной задачей и сменой среды. Апатия дольше 3 месяцев — повод поговорить с детским психологом. Это не стыдно и не «сдаться» — это умное решение.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частая история из нашего лагеря
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мама приводит подростка 13 лет: «ничего не хочет, только в телефоне». Первые 2 дня в лагере ребёнок сидит в стороне, говорит «мне всё скучно». На 3-4 день начинает вникать в Python-проект. К 7 дню — работает с командой над ботом. В финале смены — защищает проект перед всем лагерем и родителями. Через месяц мама пишет: «он сам просит продолжать курс, учится самостоятельно, ставит цели». Это типичный сценарий, не исключение.
        </p>
      </div>

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {[
            { q: "Когда апатия — это уже не про лень, а про психологию?", a: "Если апатия длится более 3 месяцев и сопровождается нарушением сна, отказом от еды, замкнутостью или мыслями о себе в очень негативном ключе — это повод обратиться к детскому психологу. Лагерь помогает при «бытовой» апатии, но не заменяет профессиональную помощь при депрессии." },
            { q: "Как отличить апатию от лени?", a: "Ленивый подросток всё же включается, когда ему интересно — игра, встреча с другом, что-то приятное. Апатичный не включается даже тогда. Ещё признак: при апатии подросток сам не рад своему состоянию — «не знаю почему мне скучно всё». При лени обычно чёткое понимание: «не хочу, потому что неинтересно»." },
            { q: "Помогает ли лагерь подростку найти интерес к жизни?", a: "Часто — да. Смена среды, новые ровесники с похожими интересами, реальный проект в финале — многие подростки в лагере находят то, чем хотят заниматься дальше. Типичная история: приезжает с «всё скучно», уезжает с вопросом «а где записаться на курс по Python»." }
          ].map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.q}</span>
