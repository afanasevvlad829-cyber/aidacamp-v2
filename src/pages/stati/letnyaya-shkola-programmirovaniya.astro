---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "laptop", description: "IT-лагерь с проживанием — полное погружение на 10–14 дней" },
  { title: "Летняя IT-школа", url: "/letnyaya-it-shkola/", icon: "mortarboard", description: "Дневной формат без отъезда — для тех, кто рядом" },
  { title: "IT-лагерь vs кружок", url: "/stati/it-lager-vs-kruzhok/", icon: "arrow-left-right", description: "Сравниваем форматы — что реально даёт каждый" },
  { title: "Как выбрать IT-лагерь", url: "/stati/kak-vybrat-it-lager/", icon: "list-check", description: "Чек-лист из 12 вопросов для родителя" },
];

const faqItems = [
  {
    question: "Чем летняя школа программирования отличается от кружка?",
    answer: "Кружок работает в течение учебного года — раз в неделю, 1–2 часа. Летняя школа — интенсивный формат каждый день, 4–6 часов, обычно 1–3 недели. По объёму учебного времени одна летняя школа сопоставима с несколькими месяцами кружка. Плюс: летом нет давления школьных оценок, дети расслаблены и усваивают быстрее."
  },
  {
    question: "С какого возраста берут в летние школы и лагеря программирования?",
    answer: "Летние дневные школы, как правило, с 7–8 лет — родители забирают ребёнка вечером домой. Лагеря с проживанием чаще всего с 10–12 лет, хотя у некоторых операторов есть смены с 9 лет. В АйДаКемп — с 10 лет: в этом возрасте дети уже справляются с разлукой, командной работой и могут самостоятельно выстраивать режим дня."
  },
  {
    question: "Что ребёнок должен знать до летней школы?",
    answer: "Ничего особенного — большинство летних школ и лагерей рассчитаны на детей без предварительного опыта. Важнее не знания, а базовая усидчивость и желание пробовать. Если ребёнок уже знаком с Scratch или делал что-то в Roblox — это бонус, но не обязательное условие. На старте всегда идёт вводный блок с выравниванием уровня группы."
  },
  {
    question: "Стоит ли отправлять ребёнка в лагерь, если он никогда не жил без родителей?",
    answer: "Это один из самых частых вопросов. Первый раз — всегда волнительно и для ребёнка, и для родителя. Опыт показывает: большинство детей адаптируются за 1–2 дня, потому что вокруг интересная среда и сверстники. В АйДаКемп первый день организован так, чтобы максимально быстро познакомить ребят: совместный обед, командные знакомства, выбор проекта. К вечеру первого дня большинство уже нашли друзей."
  },
];
---

<Base
  title="Летняя школа программирования для детей | АйДаКемп"
  description="Летняя школа программирования или лагерь — в чём разница и что выбрать. Сравнение форматов по погружению, социализации и результату. АйДаКемп — лагерь с проживанием."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/letnyaya-shkola-programmirovaniya/" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Летняя школа программирования для детей: чем отличается от лагеря",
        "description": "Сравнение форматов летней школы программирования и IT-лагеря с проживанием: погружение, социализация, стоимость, результат. Когда что выбрать.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/letnyaya-shkola-programmirovaniya/"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Летняя школа программирования", "item": "https://aidacamp.ru/stati/letnyaya-shkola-programmirovaniya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Летняя школа программирования для детей: чем отличается от лагеря"
    subtitle="Разбираем два формата — дневная школа и лагерь с проживанием — и объясняем, кому что подойдёт."
    imageBase="lager-programmirovaniya"
    imageAlt="Дети на летних занятиях программированием — летняя школа и лагерь"
    readTime="6 мин чтения"
    breadcrumbsLast="Летняя школа программирования"
    daryaQuote="Мы сначала выбирали дневную школу — дочь маленькая была, страшно отпускать. А потом попробовали лагерь. Она вернулась другим человеком — не в смысле навыков, в смысле самостоятельности."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда родитель набирает в поиске «летняя школа программирования», он может иметь в виду совершенно разные вещи: дневные занятия рядом с домом, выездной лагерь на природе, онлайн-курс или городской интенсив. Разберём честно — в чём разница и как выбрать то, что подойдёт именно вашему ребёнку.
        </p>

        <StatCallout
          value="3 из 5"
          label="родителей выбирают формат с проживанием повторно — после первого раза. По опросу участников АйДаКемп 2025."
          source="АйДаКемп, опрос родителей 2025"
          icon="people-fill"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое летняя школа программирования
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Классическая летняя школа программирования — это дневной формат. Ребёнок приходит утром, занимается 4–6 часов, уходит домой вечером. Как продлёнка, только вместо уроков — проекты на Python, Scratch или веб.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Такие школы чаще всего работают в городе: при детских центрах, коворкингах, образовательных компаниях. Продолжительность — от одной до трёх недель. Многие предлагают разбивку по уровням: начинающие, продолжающие, продвинутые. Плюс: ребёнок дома каждый вечер, стоимость ниже, не нужно готовиться к «отъезду».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Школа vs лагерь: честное сравнение
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Один формат не лучше другого — они закрывают разные запросы.
        </p>

        <div class="overflow-x-auto mb-4">
          <table class="w-full text-[14px] border-collapse">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tl-lg">Критерий</th>
                <th class="text-left p-3 font-semibold text-slate-700">Дневная школа</th>
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tr-lg">Лагерь с проживанием</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="p-3 text-slate-600 font-medium">Погружение</td>
                <td class="p-3 text-slate-600">Частичное — вечер дома, переключается</td>
                <td class="p-3 text-slate-600">Полное — живёт в проекте 24/7</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50/50">
                <td class="p-3 text-slate-600 font-medium">Социализация</td>
                <td class="p-3 text-slate-600">Дневные знакомства, без вечерних событий</td>
                <td class="p-3 text-slate-600">Друзья, команда, общие вечера</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="p-3 text-slate-600 font-medium">Самостоятельность</td>
                <td class="p-3 text-slate-600">Минимально развивает</td>
                <td class="p-3 text-slate-600">Серьёзно прокачивает</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50/50">
                <td class="p-3 text-slate-600 font-medium">Результат (проект)</td>
                <td class="p-3 text-slate-600">Упражнение или мини-проект</td>
                <td class="p-3 text-slate-600">Полноценный проект — в портфолио</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="p-3 text-slate-600 font-medium">Стоимость</td>
                <td class="p-3 text-slate-600">Ниже (нет проживания и питания)</td>
                <td class="p-3 text-slate-600">Выше, но «всё включено»</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50/50">
                <td class="p-3 text-slate-600 font-medium">Возраст</td>
                <td class="p-3 text-slate-600">От 7–8 лет</td>
                <td class="p-3 text-slate-600">От 10–12 лет</td>
              </tr>
              <tr>
                <td class="p-3 text-slate-600 font-medium">Подходит когда</td>
                <td class="p-3 text-slate-600">Первый опыт, младший возраст, не готов к отъезду</td>
                <td class="p-3 text-slate-600">Готов к самостоятельности, хочет глубины</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Для кого подходит летняя школа без проживания
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дневной формат — хороший выбор в нескольких ситуациях:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Ребёнку 7–9 лет</strong> — в этом возрасте ночевать вдали от родителей ещё рано для большинства. Дневная школа — хорошее начало.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Первый опыт в программировании</strong> — если ребёнок совсем не знаком с темой, дневная школа поможет понять, нравится ли это вообще.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Семья не готова к долгой разлуке</strong> — или у ребёнка тревожность, которую важно сначала проработать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Бюджет ограничен</strong> — дневные форматы дешевле при сопоставимом количестве учебных часов.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Для кого подходит лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь — другой формат, с другой отдачей. Он работает, когда:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Ребёнку 11–17 лет</strong> — есть базовая самостоятельность, готов к новым людям и новой среде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Хочет создать настоящий проект</strong> — не учебное упражнение, а что-то, что покажет друзьям и добавит в резюме.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Важна социализация</strong> — найти единомышленников, научиться работать в команде, обрести друзей с похожими интересами.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 text-[16px] mt-[3px] shrink-0" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Родители хотят «перезагрузки»</strong> — 10 дней в новой среде меняют детей сильнее, чем полгода занятий по часу в неделю.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему в АйДаКемп только формат с проживанием
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы сознательно выбрали лагерный формат — не потому что дневная школа плохая, а потому что верим: полное погружение даёт качественно другой результат.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда ребёнок живёт рядом с командой — они обсуждают проект за ужином, дорабатывают идею перед сном, приходят утром с новым решением. Это ритм настоящей разработки, который невозможно воспроизвести в дневном формате.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Кроме того, лагерь — это среда, в которой все вокруг увлечены тем же. Это важно для подростков особенно: быть «таким же» — сильный мотиватор. Ребёнок, который дома стесняется интереса к коду, в лагере обнаруживает, что это круто и нормально.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если ваш ребёнок хочет попробовать дневной формат сначала — у нас есть <a href="/letnyaya-it-shkola/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">летняя IT-школа</a> как вариант для начала. А для тех, кто готов к полному погружению — <a href="/lager-programmirovaniya/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагерь программирования</a> на 10–14 дней.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>

        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-[14px] leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Не знаете, какой формат выбрать?</p>
        <p class="mt-2 text-[15px] text-[#0d1a2b]/70">Напишите нам — расскажем про оба варианта, поможем выбрать под возраст и готовность ребёнка. Без давления и скриптов продаж.</p>
        <a href="/lager-programmirovaniya/" class="mt-4 inline-block rounded-xl bg-primary px-6 py-3 text-[15px] font-semibold text-white hover:bg-[#d67000] transition-colors">Посмотреть лагерь программирования</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-[14px] font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/stati/it-lager-vs-kruzhok/" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            IT-лагерь vs кружок — что реально даёт каждый формат
          </a>
          <a href="/stati/kak-vybrat-it-lager/" class="text-[15px] text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
            Как выбрать IT-лагерь — чек-лист из 12 вопросов
          </a>
