---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import DonutChart from '../../components/DonutChart.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';

const relatedPages = [
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista/", icon: "cpu", description: "Разбираем реальные данные WEF" },
  { title: "ROI образовательных инвестиций", url: "/stati/future-skills/", icon: "cash-coin", description: "Что считать и как" },
  { title: "Навыки которые не устареют", url: "/stati/navyki-kotorye-ne-ustareut/", icon: "graph-up", description: "IBM: знание устаревает за 5 лет" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Программирование + мышление" },
];
---

<Base
  title="AI и ВВП: почему статистика не видит революции | АйДаКемп"
  description="Корпорации вложили $40 млрд в AI — у 95% ноль эффекта на прибыль. Нобелевский лауреат Асемоглу: +0.5% ВВП за 10 лет. Объясняю механику."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "AI и ВВП: почему статистика не видит революции",
      "description": "Корпорации вложили $40 млрд в AI — у 95% ноль эффекта на прибыль. Нобелевский лауреат Асемоглу: +0.5% ВВП за 10 лет. Объясняю механику.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-09",
      "dateModified": "2026-06-09",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/ai-economy"}
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "AI и ВВП: почему статистика не видит революции", "item": "https://aidacamp.ru/stati/ai-economy/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="AI и ВВП: почему статистика не видит революции"
    subtitle="Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Это не случайность. Объясняю механику — через данные MIT и Нобелевского лауреата."
    imageBase="lager-programmirovaniya"
    imageAlt="AI и экономика — почему статистика не видит революции"
    breadcrumbsLast="AI и экономика"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-10 pb-0">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Корпорации вкладывают миллиарды в AI, а ВВП не растёт. Это не случайность. Объясняю механику — опираясь на данные MIT и Нобелевского лауреата, а не на интуицию.
        </p>
      </div>

      <!-- ═══ SECTION 1: MIT ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что показало исследование MIT
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          В 2025 году MIT NANDA — исследовательский центр при Массачусетском технологическом институте — опубликовал «The GenAI Divide». 150 интервью с руководителями, анализ 300 публичных кейсов. Результат: 95% пилотных проектов не дали измеримого эффекта на P&L — прибыль и убытки.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          374 компании из S&P 500 упоминают AI в отчётах. Большинство говорит что всё прекрасно. Прибыль стоит на месте. Дарон Асемоглу, лауреат Нобелевской премии по экономике 2024 года, оценивает суммарный вклад AI в рост ВВП США в 0.5–1% за следующие 10 лет.
        </p>

        <!-- 3 большие цифры -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <AnimatedStat
            value="40"
            prefix="$"
            unit="B"
            label="вложено в генеративный AI корпорациями мира"
            source="MIT NANDA 2025"
            tone="orange"
            size="lg"
          />
          <AnimatedStat
            value="95"
            unit="%"
            label="пилотных проектов — ноль эффекта на прибыль"
            source="MIT NANDA 2025"
            tone="red"
            size="lg"
          />
          <AnimatedStat
            value="0.5"
            prefix="+"
            unit="%"
            label="прирост ВВП за 10 лет по прогнозу нобелевского лауреата"
            source="Асемоглу, MIT 2024"
            tone="blue"
            size="lg"
          />
        </div>

        <!-- Пончик: 5% успеха vs 95% провала -->
        <div class="mt-6 rounded-[20px] bg-slate-50 border border-slate-100 p-6">
          <p class="text-base font-semibold uppercase tracking-[0.08em] text-slate-400 mb-5 text-center">Только 5% компаний реально изменили свою экономику</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
            <DonutChart
              percentage={5}
              label="реальный эффект"
              sublabel="создали новый спрос"
              color="#10B981"
              trackColor="#FECACA"
              size={130}
            />
            <DonutChart
              percentage={95}
              label="ноль на P&L"
              sublabel="оптимизация без роста"
              color="#EF4444"
              trackColor="#E2E8F0"
              size={130}
            />
          </div>
          <p class="text-base text-slate-400 mt-4 font-mono text-center">MIT NANDA «The GenAI Divide» 2025</p>
        </div>
      </div>

      <!-- ═══ SECTION 2: НУЛЕВАЯ СУММА ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему оптимизация не создаёт рост
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Это нулевая сумма. Один McDonald's сократил трёх юристов с помощью AI. Экономия — несколько миллионов в год. Но три уволенных юриста перестали тратить деньги. Покупательная способность снижается — в том числе тех, кто покупает бургеры. Рынок не вырос.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          AI работает там, где создаёт новый спрос, а не просто снижает затраты. Uber сделал такси удобнее — люди стали ездить больше — рынок вырос. Именно это называется созданием ценности. Именно поэтому Uber стоит $150B, а не $5B.
        </p>

        <!-- S&P 500 цифра -->
        <AnimatedStat
          value="374"
          label="компании из S&P 500 упоминают AI в отчётах — и почти ни одна не показала рост прибыли"
          source="Financial Times, анализ отчётов 2025"
          tone="slate"
          size="lg"
        />
      </div>

      <!-- ═══ SECTION 3: КОНТЕЙНЕР ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Контейнерная революция как метафора
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Стандартный морской контейнер изобрели в 1956 году. К 1980-м стоимость перевозки тонны груза морем упала в 20 раз. Это изменило мировую торговлю навсегда — но за 30 лет, а не за 3 года.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          AI сейчас примерно там же, где контейнер в 1960-м. Технология работает. Эффект накапливается медленно. Компании, которые разбираются в механике сейчас, получат преимущество через 10 лет — не через квартал.
        </p>

        <!-- Временная шкала контейнерной революции -->
        <AnimatedBarChart
          title="Контейнерная революция: падение стоимости перевозки"
          items={[
            { label: "1956 — контейнер изобрели", value: 100, badge: "100%", color: "#94A3B8" },
            { label: "1966 — первые маршруты", value: 80, badge: "−20%", color: "#FB923C" },
            { label: "1975 — массовое внедрение", value: 45, badge: "−55%", color: "#F97316" },
            { label: "1985 — стандарт отрасли", value: 15, badge: "−85%", color: "#10B981" },
          ]}
          source="Marc Levinson «The Box» — история контейнерной революции"
          maxValue={100}
        />
      </div>

      <!-- ═══ SECTION 4: ПРОФЕССИИ WEF ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            85 млн профессий исчезнут — 97 млн появятся
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          World Economic Forum в отчёте Future of Jobs 2025 приводит конкретные цифры: к 2030 году автоматизация вытеснит 85 миллионов рабочих мест — но создаст 97 миллионов новых. Разница в том, что новые места потребуют принципиально иных навыков.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div class="rounded-[16px] bg-red-50 border border-red-100 p-5">
            <p class="text-base font-semibold uppercase tracking-[0.08em] text-red-500 mb-3">Под угрозой к 2030</p>
            <ul class="space-y-2">
              {[
                "Операторы ввода данных",
                "Бухгалтеры и аудиторы",
                "Клерки административной поддержки",
                "Кассиры и кассиры-операционисты",
                "Агенты по продажам по телефону",
              ].map(item => (
                <li class="flex items-start gap-2">
                  <i class="bi bi-dash-circle text-red-400 shrink-0 mt-0.5" aria-hidden="true"></i>
                  <span class="text-base text-slate-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-[16px] bg-green-50 border border-green-100 p-5">
            <p class="text-base font-semibold uppercase tracking-[0.08em] text-green-600 mb-3">Профессии будущего</p>
            <ul class="space-y-2">
              {[
                "AI-специалисты и ML-инженеры",
                "Аналитики данных и BI-разработчики",
                "Специалисты по кибербезопасности",
                "Операторы «зелёных» технологий",
                "Промт-инженеры и AI-архитекторы",
              ].map(item => (
                <li class="flex items-start gap-2">
                  <i class="bi bi-plus-circle text-green-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                  <span class="text-base text-slate-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Ключевой вывод WEF: критически важным становится не знание одного языка программирования, а <strong>AI-грамотность</strong> — умение работать с нейросетями, ставить задачи, оценивать результаты и понимать ограничения. Это применимо в любой профессии — от юриста до дизайнера.
        </p>

        <div class="rounded-[16px] bg-blue-50 border-l-4 border-blue-400 px-6 py-5 mb-4">
          <p class="text-base font-semibold text-blue-800 mb-1">WEF Future of Jobs 2025</p>
          <p class="text-[16px] leading-[1.6] text-slate-700">
            «Аналитическое мышление и AI-грамотность — навыки №1 и №2 для работодателей к 2030 году. Опередили даже математику и коммуникацию.»
          </p>
        </div>
      </div>

      <!-- ═══ SECTION 5: ЧТО ДЕЛАТЬ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делать прямо сейчас
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Это не повод расслабляться. Гонка идёт, просто результаты не видны в квартальных отчётах. Компания, которая не понимает AI-инструменты, проигрывает конкурентам, которые понимают.
        </p>

        <div class="rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5 mb-6">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «Понимать механику раньше, чем она стала очевидной всем — уже само по себе конкурентное преимущество.»
          </p>
        </div>

        <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-base font-semibold text-slate-400 uppercase tracking-[0.07em] mb-3">ИСТОЧНИКИ</p>
          <ul class="space-y-1.5 text-base text-slate-500">
            <li>— MIT NANDA «The GenAI Divide: State of AI in Business 2025»</li>
            <li>— Daron Acemoglu «The Simple Macroeconomics of AI», MIT (2024)</li>
            <li>— Financial Times — анализ упоминаний AI в отчётах S&P 500 (2025)</li>
            <li>— Marc Levinson «The Box» — история контейнерной революции</li>
          </ul>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Помогите ребёнку понять AI раньше, чем это стало очевидным"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
