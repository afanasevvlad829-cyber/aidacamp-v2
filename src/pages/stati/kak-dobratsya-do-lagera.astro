---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Что взять в летний лагерь", url: "/stati/chto-vzyat-v-lager", icon: "backpack", description: "Полный список — ничего не забыть" },
  { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere", icon: "house-heart", description: "Страхи мамы и реальность" },
];
---

<Base
  title="Как добраться до лагеря АйДаКемп — маршруты и трансфер"
  description="АйДаКемп — 66 км от МКАД по Киевскому шоссе, ~1 час. На машине, трансфером от м. Солнцево или электричкой с Киевского вокзала. Адрес и схема проезда."
  ogImage="/images/articles/kuda-letom-1200.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/kak-dobratsya-do-lagera" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Как добраться до лагеря АйДаКемп в Подмосковье — маршруты и трансфер | АйДаКемп",
      "description": "АйДаКемп — 66 км от МКАД по Киевскому шоссе, ~1 час. На машине, трансфером от м. Солнцево или электричкой с Киевского вокзала. Адрес и схема проезда.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/kak-dobratsya-do-lagera"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Где находится лагерь АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп расположен в Наро-Фоминском городском округе Московской области, на территории санатория «Изумруд». 66 км от МКАД по Киевскому шоссе, около 1 часа езды от Москвы." }
        },
        {
          "@type": "Question",
          "name": "Как добраться до АйДаКемп на машине?",
          "acceptedAnswer": { "@type": "Answer", "text": "По Киевскому шоссе (А-101) от МКАД — 66 км, около 50–80 минут в зависимости от трафика. Координаты: 55.265643, 36.724185. Парковка для родителей в день заезда/выезда бесплатная." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер до лагеря из Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Организуем трансфер — автобус от метро «Солнцево» в день заезда. Сопровождающий едет до самого лагеря. Стоимость около 2 000 ₽ в один конец." }
        },
        {
          "@type": "Question",
          "name": "Можно ли добраться на электричке?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Два варианта: станция Нара (Наро-Фоминск) — поезда каждые ~25 минут, около 1 ч 10 мин в пути, далее такси ~20 минут; или станция Башкино — всего 14 поездов в сутки, но ближе к лагерю (~8 км, ~10 мин такси). Для заезда без привязки ко времени рекомендуем Нару." }
        },
        {
          "@type": "Question",
          "name": "Как далеко АйДаКемп от Новой Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Троицка, Коммунарки, Внуково — 30–50 минут по местным дорогам, не выезжая на МКАД. Жителям ЮЗАО и ТиНАО добираться удобнее всего." }
        }
      ]
    })} />
  </Fragment>

  <Header />

  <ArticleHero
    title="Как добраться до лагеря"
    subtitle="66 км от МКАД — час езды. Три маршрута: на машине, трансфером или электричкой."
    imageBase="kuda-letom"
    imageAlt="Дорога к детскому лагерю в Подмосковье"
    readTime="5 мин чтения"
    breadcrumbsLast="Как добраться до лагеря"
    daryaQuote="Я всегда говорю родителям: час — это не далеко. Это как съездить из одного конца Москвы в другой в пятницу вечером."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          АйДаКемп находится в <strong>Наро-Фоминском городском округе</strong> Московской области — на территории санатория «Изумруд». Сосновый лес, закрытая охраняемая территория, в 66 км от МКАД. Ниже — три способа добраться и схема для тех, кто едет впервые.
        </p>
      </div>

      <StatCallout
        value="66 км"
        label="— от МКАД по Киевскому шоссе. Около 1 часа на машине без пробок. Координаты: 55.265643, 36.724185."
        source="Санаторий «Изумруд», Наро-Фоминский городской округ"
        icon="geo-alt"
        tone="neutral"
      />

      <!-- КАРТА МАРШРУТА -->
      <div class="mb-10 pt-6 max-w-[720px]">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Маршрут на карте
          </h2>
        </div>
        <div class="rounded-[18px] overflow-hidden border border-[#e2d9c9]">
          <iframe
            src="https://yandex.ru/map-widget/v1/?rtext=55.755814%2C37.617635~55.265643%2C36.724185&rtt=auto&z=9&lang=ru_RU"
            width="100%"
            height="380"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="Маршрут до АйДаКемп из Москвы — Яндекс.Карты"
            class="block"
          ></iframe>
          <div class="px-4 py-3 bg-[#faf6ef] border-t border-[#ede5d8] flex items-center justify-between flex-wrap gap-2">
            <span class="text-[13px] text-slate-500">Маршрут: Москва — Наро-Фоминский округ · 66 км · ~1 час</span>
            <a
              href="https://yandex.ru/maps/?rtext=55.755814,37.617635~55.265643,36.724185&rtt=auto"
              target="_blank"
              rel="noopener"
              class="text-[13px] font-semibold text-primary hover:underline flex items-center gap-1"
            >
              Открыть в Яндекс.Картах
              <i class="bi bi-box-arrow-up-right text-[11px]" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- ВАРИАНТ 1 -->
      <div class="mb-8 pt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            На машине — самый удобный вариант
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Выезжайте на <strong>Киевское шоссе (А-101)</strong> и двигайтесь в сторону Наро-Фоминска. Через 66 км от МКАД будет поворот на санаторий «Изумруд» — навигатор приведёт точно.
        </p>
        <ul class="flex flex-col gap-2.5 mb-4 max-w-[720px]">
          {[
            "Из центра Москвы — 50–80 минут в зависимости от трафика",
            "Из Южного Бутово, Ясенево — 40–55 минут",
            "Из Одинцово — около 40 минут (не заезжая в Москву)",
            "Из Подольска — 35–45 минут",
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700">{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <strong>Координаты для навигатора:</strong> <a href="https://yandex.ru/maps/?ll=36.724185,55.265643&z=15&pt=36.724185,55.265643,pm2rdm" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">55.265643, 36.724185 →</a> Или найдите «Санаторий Изумруд Наро-Фоминский» в <a href="https://yandex.ru/maps/?text=Санаторий+Изумруд+Наро-Фоминский" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">Яндекс.Картах →</a>
        </p>
      </div>

      <!-- ВАРИАНТ 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Трансфер — удобно, если нет машины
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы организуем <strong>автобус с сопровождающим</strong> в день заезда. Едет напрямую до ворот лагеря — не нужно никуда пересаживаться.
        </p>
        <ul class="flex flex-col gap-2.5 mb-4 max-w-[720px]">
          {[
            ["Точка посадки", "Метро «Солнцево» (Солнцевская линия)"],
            ["Время", "Отправление утром в день заезда смены — точное время сообщается заранее"],
            ["Стоимость", "~2 000 ₽ в одну сторону, оплачивается отдельно при бронировании"],
            ["Обратно", "В день выезда — трансфер обратно до тех же точек"],
          ].map(([title, desc]) => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700"><strong>{title}:</strong> {desc}</span>
            </li>
          ))}
        </ul>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px]">
          <p class="text-[15px] leading-[1.6] text-slate-700">
            <strong>Важно:</strong> трансфер нужно заказывать при бронировании смены — позже мест может не быть. Спросите менеджера при оформлении путёвки.
          </p>
        </div>
      </div>

      <!-- ВАРИАНТ 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Электричка + такси — для самостоятельных
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Подходит для подростков 12–14 лет или как резервный вариант. На Киевском направлении есть две рабочие станции с разным балансом удобства.
        </p>

        <!-- Станция 1: Нара -->
        <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 md:p-5 mb-4 max-w-[720px]">
          <p class="text-[15px] font-bold text-slate-900 mb-2">
            Станция Нара (Наро-Фоминск)
            <span class="ml-2 inline-flex items-center bg-green-50 text-green-700 text-[11px] font-semibold px-2 py-0.5 rounded-full border border-green-200">часто ходит</span>
          </p>
          <ul class="flex flex-col gap-1.5">
            {[
              "Киевский вокзал → Нара — ~1 ч 10 мин–1 ч 28 мин",
              "Поездов ~46 в сутки, интервал ~25 минут днём — самый надёжный вариант",
              "От станции до лагеря — ~19 км, ~20 минут на такси (Яндекс.Такси работает)",
              "Итого: около 1 ч 30 мин от Киевского вокзала",
            ].map(item => (
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5 text-[13px]" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Станция 2: Башкино -->
        <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 md:p-5 mb-4 max-w-[720px]">
          <p class="text-[15px] font-bold text-slate-900 mb-2">
            Станция Башкино
            <span class="ml-2 inline-flex items-center bg-amber-50 text-amber-700 text-[11px] font-semibold px-2 py-0.5 rounded-full border border-amber-200">смотрите расписание</span>
          </p>
          <ul class="flex flex-col gap-1.5">
            {[
              "Киевский вокзал → Башкино — ~1 ч 19 мин",
              "Только 14 поездов в сутки — большие перерывы (например, с 10:15 до 14:07 поездов нет)",
              "Зато ближайшая к лагерю: ~8 км, ~10 минут на такси",
              "Итого: около 1 ч 30 мин, но нужно точно попасть в расписание",
            ].map(item => (
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5 text-[13px]" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 max-w-[720px]">
          <p class="text-[14px] leading-[1.6] text-slate-700">
            <strong>Совет:</strong> если нет чёткого времени — берите до <strong>Нары</strong>, поезда ходят часто и не нужно подстраиваться. Если заезд запланирован заранее — проверьте расписание до <strong>Башкино</strong> на <a href="https://www.tutu.ru/prigorod/" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">tutu.ru</a> или <a href="https://rasp.yandex.ru/" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">Яндекс.Расписании</a> — там ближе и такси дешевле.
          </p>
        </div>
      </div>

      <!-- ОТКУДА УДОБНЕЕ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Откуда ехать — ориентир по районам
          </h2>
        </div>
        <ul class="flex flex-col gap-3 max-w-[720px]">
          {[
            ["Новая Москва (Троицк, Коммунарка, Внуково)", "30–50 минут по местным дорогам, не выезжая на МКАД — самый удобный маршрут"],
            ["ЮЗАО (Солнцево, Ясенево, Бутово)", "40–55 минут, выезд через Киевское шоссе"],
            ["Центр и другие округа Москвы", "50–80 минут в зависимости от пробок и района"],
            ["Одинцово, Красногорск", "40–55 минут в объезд МКАД или через А-107"],
            ["Подольск, Чехов", "35–50 минут на машине"],
            ["Балашиха, Щёлково, Мытищи", "1 час 20–40 минут через МКАД или МСД"],
          ].map(([place, time]) => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-geo-alt text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700"><strong>{place}</strong> — {time}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- ЧТО ВЗЯТЬ В ДОРОГУ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            В день заезда — что взять с собой в дорогу
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Документы нужны при регистрации на въезде — заранее положите в отдельный пакет, чтобы не искать в сумках.
        </p>
        <ul class="flex flex-col gap-2.5 max-w-[720px]">
          {[
            ["Документ ребёнка", "копия свидетельства о рождении или паспорта"],
            ["Полис ОМС", "копия полиса обязательного медицинского страхования"],
            ["Справка 079/у", "о состоянии здоровья отъезжающего в лагерь — срок действия 3 месяца с даты выдачи"],
            ["Справка об эпидокружении", "об отсутствии контактов с инфекционными больными — срок действия 3 дня, берётся в поликлинике накануне заезда"],
            ["Согласие на обработку персональных данных", "подписывается родителем или законным представителем"],
            ["Справка в бассейн", "о допуске к занятиям в бассейне — берётся у педиатра или дерматолога"],
          ].map(([title, desc]) => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-circle-fill text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700"><strong>{title}</strong> — {desc}</span>
            </li>
          ))}
          <li class="flex items-start gap-2.5 mt-2 pt-2 border-t border-slate-100">
            <i class="bi bi-shield-check text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">
              <span class="inline-flex items-center bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2 py-0.5 rounded-full border border-emerald-200 mr-1.5">рекомендуем</span>
              <strong>Страховка от несчастных случаев</strong> — необязательна, но советуем. Покрытие 500 000 ₽, стоит ~1 000–1 500 ₽. Оформляется онлайн за 2 минуты — Т-Банк, Сбер, Ингосстрах.
            </span>
          </li>
        </ul>
        <p class="mt-5 text-[15px] text-slate-500">
          Полный список вещей — в статье <a href="/stati/chto-vzyat-v-lager" class="text-primary font-semibold hover:underline">«Что взять в летний лагерь»</a>.
        </p>
      </div>

      <p class="text-[15px] text-slate-500 italic mb-8">
        Есть вопросы по проезду — напишите нам, подскажем точный маршрут из вашего района.
      </p>


      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Забронировать смену и уточнить трансфер"
    bookingSubtitle="Ответим за 10 минут — расскажем про маршрут, трансфер и свободные места."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
