---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere", icon: "star", description: "Как помочь ребёнку адаптироваться" },
  { title: "Телефон в лагере", url: "/stati/telefon-v-lagere", icon: "phone", description: "Брать или нет — честный разбор" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-vibrate", description: "Как работает связь в АйДаКемп" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Как часто писать ребёнку в лагерь?",
    answer: "Раз в 1–2 дня — оптимально. Каждый день писать «ну как ты там, я скучаю» создаёт больше тревоги, чем успокоения. Ребёнок начинает ждать сообщений вместо того чтобы жить жизнью лагеря. Если хочется знать как дела — смотрите фото в Telegram-группе, там публикуем ежедневно."
  },
  {
    question: "Ребёнок написал что ему плохо. Что делать?",
    answer: "Не паниковать и не ехать сразу. Сначала позвоните вожатому — они на месте и видят реальную картину. Часто «мне здесь не нравится» в тексте выглядит страшнее, чем есть на самом деле. Вожатый расскажет как ребёнок выглядит в реальности: нормально ест, общается, участвует — значит всё в порядке, просто скучает."
  },
  {
    question: "Как отправить письмо или посылку в лагерь?",
    answer: "В АйДаКемп работает электронная переписка через Telegram-группу — вы пишете вожатому, он передаёт сообщение. Физические письма и посылки можно привезти лично или передать через организаторов в московском офисе. Уточните актуальный адрес при бронировании."
  }
];
---

<Base
  title="Письмо ребёнку в лагерь — что писать и как не ляпнуть лишнего"
  description="Практичное руководство: что писать ребёнку в лагерь, примеры поддерживающих фраз, что НЕ писать. Как работает связь в АйДаКемп."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/pismo-rebenku-v-lager" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Письмо ребёнку в лагерь — что писать и как не ляпнуть лишнего",
        "description": "Практичное руководство: что писать ребёнку в лагерь, примеры поддерживающих фраз, что НЕ писать. Как работает связь в АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pismo-rebenku-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Письмо ребёнку в лагерь: примеры, советы, чего лучше не писать"
    subtitle="Как написать так, чтобы поднять настроение — а не добавить тоску по дому."
    imageBase="lager-na-leto-2026"
    imageAlt="Мама пишет письмо ребёнку в летний лагерь"
    readTime="4 мин чтения"
    breadcrumbsLast="Письмо ребёнку в лагерь"
    daryaQuote="Я написала дочери в первый день: «Ты там уже нашла кого-то классного?» Она ответила: «Да, трёх!» И сразу всё встало на свои места."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Первый раз отпустить ребёнка в лагерь — это отдельный родительский экзамен. Хочется написать много, поддержать, но одновременно не расстроить. Оказывается, одна неудачная фраза может сбить настроение на полдня. А правильная — наоборот зарядить и помочь раскрыться.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что писать — конкретные фразы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хорошее письмо делает одно: напоминает ребёнку, что дома всё хорошо и мама/папа спокойны. Это разрешение — жить жизнью лагеря без вины.
        </p>

        <div class="space-y-3 mb-6">
          <div class="bg-green-50 border border-green-200 rounded-xl p-4">
            <div class="text-[13px] font-semibold text-green-700 uppercase tracking-wide mb-2">Хорошо работает</div>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">«Ты там уже кого-нибудь нашла интересного?»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">«Мы тут видели фото — ты там что-то делаешь с ребятами, расскажи что это было!»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">«Дома всё нормально, кот живой, ждём тебя»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">«Расскажи про самый смешной момент сегодня»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-[15px] text-slate-700">«Я тобой горжусь — ты там, всё решаешь сама, молодец»</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Вопросы про жизнь лагеря — лучший инструмент. Ребёнку приятно рассказывать про своё, а не успокаивать маму. Когда вопрос про «что интересного», ребёнок сам начинает вспоминать хорошее.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чего лучше не писать
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Некоторые фразы кажутся заботливыми, но на деле включают тревогу у ребёнка. Вот список — не потому что вы плохой родитель, а просто чтобы знать.
        </p>

        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
          <div class="text-[13px] font-semibold text-red-700 uppercase tracking-wide mb-2">Лучше избегать</div>
          <ul class="flex flex-col gap-3">
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
              <div>
                <span class="text-[15px] font-semibold text-slate-800">«Я так по тебе скучаю, дома так тихо без тебя»</span>
                <p class="text-[14px] text-slate-600 mt-0.5">Ребёнок начинает чувствовать себя виноватым за то, что уехал и маме плохо. Веселиться с этим чувством сложно.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
              <div>
                <span class="text-[15px] font-semibold text-slate-800">«Ты там хорошо кушаешь? А то я переживаю»</span>
                <p class="text-[14px] text-slate-600 mt-0.5">Транслирует тревогу — ребёнок начинает думать что с едой что-то не то. Или что нужно отчитываться.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
              <div>
                <span class="text-[15px] font-semibold text-slate-800">«Осталось уже 6 дней, скоро домой»</span>
                <p class="text-[14px] text-slate-600 mt-0.5">Включает режим обратного отсчёта. Ребёнок начинает ждать конца вместо того чтобы жить смену.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
              <div>
                <span class="text-[15px] font-semibold text-slate-800">«Ты дружишь с кем-нибудь? А то я боюсь что ты один»</span>
                <p class="text-[14px] text-slate-600 mt-0.5">Страх родителя становится страхом ребёнка. Лучше спросить «кого там интересного встретил» — без тревожного подтекста.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как часто писать — без фанатизма
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Один раз в день — хорошо. Два раза — нормально. Десять сообщений за день — уже много. Ребёнок, которому постоянно пишут, начинает жить ожиданием ответа, а не жизнью лагеря.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если очень хочется знать как дела — смотрите фото в Telegram-группе лагеря. Это ежедневные снимки из жизни отряда. По ним обычно сразу видно: ребёнок улыбается, что-то делает с другими — значит всё в порядке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Пауза в переписке — это не катастрофа. Это значит ребёнку было некогда, потому что интересно. Хороший знак.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроена связь в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефоны хранятся в боксах у вожатых. Ребёнок сам решает когда использовать лимит экранного времени — и если хочет написать маме, это его выбор, не расписание.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для родителей — ежедневные фото и короткое видео в Telegram. Вы видите как дочь смеётся на занятии, как отряд играет вечером. Это куда информативнее одного скомканного звонка «у меня всё норм, пока».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Экстренная связь с ребёнком доступна всегда — достаточно написать вожатому.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Готовитесь к первой смене?"
    bookingSubtitle="Расскажем как устроена связь с родителями и как ребёнок будет чувствовать себя в первые дни."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.add('hidden');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
