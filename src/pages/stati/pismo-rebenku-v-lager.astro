---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "star", description: "Как помочь школьнику адаптироваться" },
  { title: "Телефон в лагере", url: "/stati/telefon-v-lagere/", icon: "phone", description: "Брать или нет — честный разбор" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-vibrate", description: "Как работает связь в АйДаКемп" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Как часто писать в лагерь?",
    answer: "Раз в 1–2 дня — оптимально. Каждый день писать «ну как ты там, я скучаю» создаёт больше тревоги, чем успокоения. Он начинает ждать сообщений вместо того чтобы жить жизнью лагеря. Если хочется знать как дела — смотрите фото в Telegram-группе, там публикуем ежедневно."
  },
  {
    question: "Ребёнок написал что ему плохо. Что делать?",
    answer: "Не паниковать и не ехать сразу. Сначала позвоните вожатому — они на месте и видят реальную картину. Часто «мне здесь не нравится» в тексте выглядит страшнее, чем есть на самом деле. Вожатый расскажет как он выглядит в реальности: нормально ест, общается, участвует — значит всё в порядке, просто скучает."
  },
  {
    question: "Как отправить письмо или посылку в лагерь?",
    answer: "В АйДаКемп работает электронная переписка через Telegram-группу — вы пишете вожатому, он передаёт сообщение. Физические письма и посылки родителей можно привезти лично или передать через организаторов в офисе. Уточните актуальный адрес при бронировании."
  },
  {
    question: "Как не передать свою тревогу в переписке?",
    answer: "Простое правило: перечитайте сообщение перед отправкой и спросите себя — это про то что у него всё хорошо, или про то что вам плохо? Если второе — перепишите. Ваш настрой передаётся через текст. Спокойное, уверенное письмо помогает ему расслабиться и продолжать жить лагерем."
  },
  {
    question: "Школьник не отвечает на сообщения — стоит ли волноваться?",
    answer: "Пауза в переписке — хороший знак. Значит ему некогда, потому что интересно. Если прошло больше двух дней без ответа — напишите вожатому, они проверят. Но в большинстве случаев всё просто: лагерный день плотный, и отвечать маме в нём не самый приоритет."
  }
];
---

<Base
  title="Письмо ребёнку в лагерь: что писать и чего избегать"
  description="Письмо ребёнку в лагерь: поддерживающие фразы и примеры, что написать и чего не писать. Как работает связь в АйДаКемп."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Письмо ребёнку в лагерь: что писать и чего избегать",
        "description": "Практичное руководство: что писать ребёнку в лагерь, примеры поддерживающих фраз, что НЕ писать. Как работает связь в АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pismo-rebenku-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Письмо ребёнку в лагерь: примеры"
    subtitle="Как писать письма, чтобы поднять настроение — а не добавить тоску по дому."
    imageBase="lager-na-leto-2026"
    imageAlt="Мама пишет письмо в летнюю смену"
    readTime="4 мин чтения"
    breadcrumbsLast="Переписка со школьником в лагере"
    daryaQuote="Я написала дочери в первый день: «Ты там уже нашла кого-то классного?» Она ответила: «Да, трёх!» И сразу всё встало на свои места."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Первый раз отпустить школьника в смену — отдельный родительский экзамен: хочется поддержать, но не расстроить. Одна неудачная фраза в письме может сбить настрой на полдня, а точная — наоборот зарядить и помочь раскрыться.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что писать — конкретные фразы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хорошая весточка делает одно: напоминает, что дома всё хорошо и родители спокойны — это разрешение жить лагерной жизнью без вины.
        </p>

        <div class="space-y-3 mb-6">
          <div class="bg-green-50 border border-green-200 rounded-xl p-4">
            <div class="text-base font-semibold text-green-700 uppercase tracking-wide mb-2">Хорошо работает</div>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">«Ты там уже кого-нибудь нашла интересного?»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">«Мы тут видели фото — ты там что-то делаешь с ребятами, расскажи что это было!»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">«Дома всё нормально, кот живой, ждём тебя»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">«Расскажи про самый смешной момент сегодня»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">«Я тобой горжусь — ты там, всё решаешь сама, молодец»</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Вопросы про лагерную жизнь — лучший инструмент: рассказывать про своё приятнее, чем успокаивать маму. Спросите «что было интересного» — и он сам вспомнит хорошее. Иногда важное проще сказать коротким письмом, чем разговором по телефону.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чего лучше не писать
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Некоторые фразы кажутся заботливыми, но на деле включают тревогу у детей. Вот список — не потому что вы плохой родитель, а просто чтобы знать.
        </p>

        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
          <div class="text-base font-semibold text-red-700 uppercase tracking-wide mb-2">Лучше избегать</div>
          <ul class="flex flex-col gap-3">
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
              <div>
                <span class="text-base font-semibold text-slate-800">«Я так по тебе скучаю, дома так тихо без тебя»</span>
                <p class="text-base text-slate-600 mt-0.5">Он начинает чувствовать себя виноватым, что уехал и маме плохо — веселиться с этим чувством сложно.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
              <div>
                <span class="text-base font-semibold text-slate-800">«Ты там хорошо кушаешь? А то я переживаю»</span>
                <p class="text-base text-slate-600 mt-0.5">Транслирует тревогу — он начинает думать что с едой что-то не то. Или что нужно отчитываться.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
              <div>
                <span class="text-base font-semibold text-slate-800">«Осталось уже 6 дней, скоро домой»</span>
                <p class="text-base text-slate-600 mt-0.5">Включает режим обратного отсчёта. Школьник начинает ждать конца вместо того чтобы жить смену.</p>
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
              <div>
                <span class="text-base font-semibold text-slate-800">«Ты дружишь с кем-нибудь? А то я боюсь что ты один»</span>
                <p class="text-base text-slate-600 mt-0.5">Страх родителей становится страхом детей. Лучше спросить «кого там интересного встретил» — без тревожного подтекста.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как часто писать — без фанатизма
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Писать раз в день — хорошо, два раза — нормально, а десять сообщений за день — уже перебор. Школьник, которому постоянно пишут, начинает жить ожиданием ответа, а не жизнью лагеря.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если очень хочется знать как дела — смотрите фото в Telegram-группе лагеря: ежедневные снимки из жизни отряда. Обычно сразу видно — он улыбается, что-то делает с другими, значит всё в порядке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Пауза в переписке — не катастрофа, а хороший знак: значит ему было некогда, потому что интересно.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроена связь в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефоны хранятся в боксах у вожатых. Школьник сам решает когда использовать лимит экранного времени — и если хочет черкнуть маме, это его выбор, не расписание.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для родителей — ежедневные фото и короткое видео в Telegram: видно, как дочь смеётся, как играет отряд. Это куда информативнее скомканного звонка «у меня всё норм, пока».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Экстренная связь со школьником доступна всегда — достаточно сообщить вожатому.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Записка до отъезда: положите в сумку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Такие письма работают лучше, чем кажется. Записка в рюкзаке — которую он найдёт сам вечером — особенный момент. В таком письме важнее тон, чем длина: несколько тёплых слов работают лучше длинного текста. Несколько советов что туда написать:
        </p>
        <div class="space-y-3 max-w-[680px]">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">Тёплое личное приветствие — «Привет! Ты уже там. Как здорово!»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">Слова поддержки: «Ты справишься, у тебя это хорошо получается»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">Что-то смешное или личное — внутренняя шутка, которую поймёт только он</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">Разрешение веселиться: «Не думай о нас, просто живи этим летом»</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span class="text-base text-slate-700">Дома всё хорошо и ждут с нетерпением — но без обратного отсчёта «осталось 9 дней»</span>
              </li>
            </ul>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Дочь Дарьи до сих пор хранит такие записки. «Я кладу записку в боковой карман рюкзака — знаю что она найдёт сама. Это наша традиция», — говорит Дарья.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Готовитесь к первой смене?"
    bookingSubtitle="Расскажем как устроена связь с родителями и как он будет чувствовать себя в первые дни."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
