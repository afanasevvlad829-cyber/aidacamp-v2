---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const articles = [
  {
    title: "Зависимость от компьютерных игр",
    url: "/stati/zavisimost-ot-kompyuternyh-igr/",
    description: "Как отличить увлечение от зависимости: 5 признаков + 4 шага которые реально возвращают ребёнка в жизнь. По опыту 1 200 семей.",
    readTime: "7 мин",
    icon: "controller",
  },
  {
    title: "Зависимость от телефона у подростков",
    url: "/stati/zavisimost-ot-telefona-u-podrostkov/",
    description: "Почему подросток не выпускает телефон из рук — и что реально работает вместо запретов. Без конфискации и скандалов.",
    readTime: "6 мин",
    icon: "phone",
  },
  {
    title: "Игромания у детей",
    url: "/stati/igromaniya-u-detej/",
    description: "Официальный диагноз ВОЗ (МКБ-11), стадии развития зависимости и группы риска. Чем игромания отличается от обычного увлечения.",
    readTime: "6 мин",
    icon: "controller",
  },
  {
    title: "Как избавиться от зависимости от игр",
    url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr/",
    description: "5-шаговый план без запретов и скандалов — через замещение и смену среды. Работает для подростков 10–16 лет.",
    readTime: "6 мин",
    icon: "arrow-repeat",
  },
  {
    title: "Лечение компьютерной зависимости",
    url: "/stati/lechenie-kompyuternoj-zavisimosti/",
    description: "Без клиники и таблеток — что реально работает. Смена среды + замещение + новое окружение. Опыт 1200+ подростков.",
    readTime: "6 мин",
    icon: "heart-pulse-fill",
  },
  {
    title: "Профилактика компьютерной зависимости",
    url: "/stati/profilaktika-kompyuternoj-zavisimosti/",
    description: "7 семейных правил, которые предотвращают зависимость от гаджетов ещё до того как она возникла. Для детей 6–14 лет.",
    readTime: "6 мин",
    icon: "shield-check",
  },
  {
    title: "Признаки компьютерной зависимости",
    url: "/stati/priznaki-kompyuternoj-zavisimosti/",
    description: "6 конкретных маркеров зависимости — не «просто много играет». Понятный чек-лист чтобы понять есть ли проблема.",
    readTime: "6 мин",
    icon: "search",
  },
];

const faqItems = [
  {
    question: "Как понять, есть ли у ребёнка зависимость от гаджетов?",
    answer: "Главный признак — потеря контроля. Зависимый ребёнок не может остановиться сам, даже если хочет. Конкретные маркеры: агрессия или истерика при попытке ограничить экранное время, ложь о времени за устройством, потеря интереса ко всему кроме экрана, нарушение сна. Один признак — не диагноз. Три и больше в течение месяца — повод действовать."
  },
  {
    question: "Помогает ли запрет телефонов и игр?",
    answer: "Краткосрочно — да. Долгосрочно — создаёт «запретный плод»: чем строже запрет, тем сильнее тяга. Когда ребёнок получает устройство обратно — бросается к нему с удвоенной жадностью. Работает другое: замена, а не запрет. Найти занятие, которое даёт тот же дофамин через созидание, а не потребление."
  },
  {
    question: "С какого возраста может развиться зависимость?",
    answer: "С 7–8 лет, как только ребёнок начинает пользоваться устройствами самостоятельно. Пик уязвимости — 10–14 лет: именно тогда дофаминовая система мозга особенно восприимчива к игровым механикам. Чем раньше установлены правила работы с экраном, тем проще их придерживаться."
  },
  {
    question: "Может ли IT-лагерь помочь с зависимостью от гаджетов?",
    answer: "Часто да — через переключение с потребления на созидание. Ребёнок, который создал свою игру или бота, смотрит на игры совсем иначе: понимает как это устроено изнутри. В АйДаКемп телефоны сдают при заезде, а экранное время является внутренней валютой — за 10 дней большинство детей сами перестают думать о телефоне."
  },
  {
    question: "Когда нужен психолог?",
    answer: "Если три и больше таких признаков держатся дольше месяца, и домашние методы не дают результата — стоит проконсультироваться с подростковым психологом. Одна встреча помогает понять: это уже расстройство или сильное увлечение, с которым можно справиться домашними методами. При явной агрессии, депрессии или суицидальных мыслях — обратиться к специалисту нужно сразу."
  },
  {
    question: "Какой специалист лечит цифровую зависимость?",
    answer: "Психолог или психотерапевт с опытом КПТ (когнитивно-поведенческой терапии). Не нарколог — она поведенческая, а не химическая. При сопутствующей депрессии или СДВГ — нужен психиатр для решения вопроса о медикаментах. В России первый шаг — ПМПК (психолого-медико-педагогическая комиссия) по месту учёбы (бесплатно) или частный подростковый психолог."
  },
  {
    question: "Есть ли официальный диагноз «цифровая зависимость»?",
    answer: "Частично. С 2022 года действует МКБ-11 (международная классификация болезней ВОЗ), которая включает Gaming Disorder — «игровое расстройство» (код 6C51). Это официальный диагноз. «Зависимость от телефона» или «зависимость от соцсетей» как отдельные диагнозы пока не включены — они в категории «состояний, требующих дальнейшего изучения». На практике врачи работают с симптомами, а не ждут официального диагноза."
  },
];
---

<Base
  title="Зависимость от гаджетов у детей — признаки и 5 шагов, как помочь"
  description="Зависимость от телефона и гаджетов у детей: как распознать, в чём разница с нормой, что делать родителям — без криков и изъятия."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Зависимость у детей от гаджетов: как распознать и помочь",
        "description": "Полный гид по детским цифровым зависимостям: 7 статей о признаках, причинах и способах помочь ребёнку.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-02-15",
        "dateModified": "2026-04-01",
        "url": "https://aidacamp.ru/stati/zavisimost-u-detej",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/zavisimost-u-detej"},
        "image": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/hero/lager-bez-telefonov.avif"}
      },
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "headline": "Зависимость у детей от гаджетов: как распознать и помочь",
        "description": "Полный гид по детским цифровым зависимостям: 7 статей о признаках, причинах и способах помочь ребёнку.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-02-15",
        "dateModified": "2026-04-01",
        "url": "https://aidacamp.ru/stati/zavisimost-u-detej",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/zavisimost-u-detej"}
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость у детей: как распознать и помочь"
    subtitle="Среднестатистический подросток проводит за экраном 7–9 часов в день. Само по себе это не значит, что у ребёнка есть признаки зависимости. Зависимость начинается, когда он не может остановиться сам. Собрали всё, что знаем об этом, в одном месте."
    breadcrumbsLast="Зависимость у детей"
    readTime="хаб"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-10">

    <!-- Darya quote -->
    <div class="mb-10 rounded-2xl bg-[#fdf8f4] border border-primary/15 p-5 md:p-6">
      <div class="flex gap-4 items-start">
        <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
          <i class="bi bi-chat-quote text-primary text-[18px]" aria-hidden="true"></i>
        </div>
        <div>
          <p class="text-base leading-[1.7] text-slate-700 italic mb-2">
            «Когда дочь перестала реагировать на моё "пора заканчивать" — я поняла: это уже не "много сидит", это другое. Прошли этот путь сами. Главное что поняла — запретами здесь не поможешь. Нужна среда, а не правила.»
          </p>
          <p class="text-base text-slate-500 font-medium">Дарья Афанасьева, основатель АйДаКемп</p>
        </div>
      </div>
    </div>

    <!-- What is addiction block -->
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <div class="list-accent-dot"></div>
        <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
          Что такое цифровая зависимость у детей
        </h2>
      </div>
      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
        У цифровой или компьютерной зависимости у ребёнка простое определение: он теряет контроль над временем за экраном. Он знает что «слишком много», хочет остановиться, но не может. Любое ограничение вызывает у ребёнка агрессию или панику. Реальная жизнь постепенно теряет для ребёнка привлекательность.
      </p>
      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
        В 2019 году ВОЗ официально включила «игровое расстройство» в МКБ-11. Это не значит что каждый ребёнок, который много играет — болен. Для такого диагноза нужны три конкретных критерия минимум на протяжении 12 месяцев. Но признание ВОЗ важно: это не каприз и не лень, а расстройство.
      </p>
      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
        Дело не в слабоволии ребёнка. Мозг подростка физиологически уязвим у большинства детей: префронтальная кора — часть, отвечающая за самоконтроль у ребёнка, — ещё только формируется. А игры и соцсети спроектированы на максимальное удержание внимания. Понимание этого снимает половину тревоги — и помогает действовать правильно.
      </p>
    </div>

    <!-- How camp helps -->
    <div class="mb-10 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
      <p class="font-semibold text-[#0d1a2b] text-[18px] mb-2">Помогает ли лагерь при зависимости от гаджетов?</p>
      <p class="text-base text-[#0d1a2b]/70 mb-4">
        В АйДаКемп телефоны сдают при заезде. За 10 дней без гаджетов дети сами начинают общаться, делать что-то руками и... забывают про телефон. Экранное время работает как внутренняя валюта — ребёнок учится управлять им сам, а не потому что мама запрещает ребёнку. 60% детей просятся обратно в следующую смену.
      </p>
      <a href="/lager-bez-telefonov/" class="inline-block rounded-xl bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-[#d67000] transition-colors">
        Узнать про лагерь без телефонов
      </a>
    </div>

    <!-- Articles grid -->
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <div class="list-accent-dot"></div>
        <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
          Все статьи о детских зависимостях
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {articles.map((article) => (
          <a
            href={article.url}
            class="group flex flex-col gap-3 rounded-2xl border border-slate-200 p-5 hover:border-orange-300 hover:bg-[#fffaf5] transition-all"
          >
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-9 h-9 rounded-xl bg-orange-100 flex items-center justify-center">
                <i class={`bi bi-${article.icon} text-orange-600 text-[17px]`} aria-hidden="true"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-base font-semibold text-slate-900 group-hover:text-orange-700 transition-colors leading-[1.35] mb-1">
                  {article.title}
                </p>
                <span class="text-base text-slate-400">
                  <i class="bi bi-clock text-base mr-1" aria-hidden="true"></i>{article.readTime} чтения
                </span>
              </div>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">
              {article.description}
            </p>
            <span class="text-base font-medium text-orange-600 group-hover:text-orange-700 flex items-center gap-1">
              Читать статью <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- New sections: норма vs зависимость + что помогает -->
    <div class="mb-8 pt-2">
      <div class="flex items-center gap-2 mb-4">
        <div class="list-accent-dot"></div>
        <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
          Чем гаджет-зависимость отличается от нормального использования
        </h2>
      </div>
      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
        Норма — ребёнок пользуется гаджетом, но легко откладывает его при просьбе родителей. Тревожный знак у ребёнка — агрессия, слёзы или ступор при попытке забрать телефон. Ещё один маркер: полная потеря интереса ко всему, что не связано с экраном.
      </p>
    </div>
    <div class="mb-8 pt-2">
      <div class="flex items-center gap-2 mb-4">
        <div class="list-accent-dot"></div>
        <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
          Что реально помогает — и что нет
        </h2>
      </div>
      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
        Не помогает: силовое изъятие у ребёнка без объяснений — тяга возвращается ещё сильнее. Не помогает: «договор» без контроля и последствий — учит манипулировать. Помогает: замена — когда вместо экрана у детей появляется что-то столь же захватывающее. Именно поэтому в IT-лагере телефоны сдают без скандалов: школьники заняты кодом, который сами считают крутым.
      </p>
    </div>

    <!-- FAQ Section -->
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-6">
        <div class="list-accent-dot"></div>
        <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
          Частые вопросы
        </h2>
      </div>

      <div class="space-y-3">
        {faqItems.map((item) => (
          <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
            <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
              <span>{item.question}</span>
              <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
            </button>
            <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
              <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>            </div>
          </div>
        ))}
      </div>
    </div>

  </main>

      <!-- Читайте также -->
    <div class="not-prose my-8 rounded-[16px] bg-slate-50 border border-slate-100 p-5">
      <p class="text-base font-bold uppercase tracking-[0.1em] text-slate-400 mb-3">Читайте также</p>
      <ul class="flex flex-col gap-2">
        <li><a href="/zavisimost-ot-gadzetov/" class="text-primary hover:underline">← Полный гид: зависимость от гаджетов у детей</a></li>
        <li><a href="/lager-bez-telefonov/" class="text-orange-600 hover:underline">Лагерь без телефонов — как среда помогает</a></li>
        <li><a href="/stati/zavisimost-ot-kompyuternyh-igr/" class="text-slate-700 hover:underline">Зависимость от компьютерных игр у детей</a></li>
        <li><a href="/stati/profilaktika-kompyuternoj-zavisimosti/" class="text-slate-700 hover:underline">Профилактика компьютерной зависимости</a></li>
      </ul>
    </div>
  <ArticleBottomCta
    bookingTitle="Дайте ребёнку 10 дней без экрана"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время, расскажем про ближайшую смену."
  />

  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
