---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import { STAT_LICENSE } from '../../data/contacts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import FAQ from '../../components/FAQ.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_FROM_TO } from '../../data/evergreen';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "house-heart", description: "Страхи мамы и реальность" },
  { title: "Что взять в летний лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "backpack", description: "Полный список — ничего не забыть" },
];
---

<Base
  title="7 мифов об IT-лагерях — почему родители боятся зря и отказываются"
  description="«Нужен ноутбук», «надо уметь программировать», «дорого» — разбираем 7 мифов об IT-лагерях, которые мешают сделать выбор. Что из этого правда, а что нет."
  ogImage="/images/articles/bez-telefonov-1200.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "7 мифов о детских лагерях, которые мешают родителям сделать выбор | АйДаКемп",
      "description": "Ноутбук нужен обязательно? Ребёнок должен уметь программировать? Разбираем 7 главных мифов о детских IT-лагерях на основе реальных вопросов родителей.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-23",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/mify-o-detskikh-lageryakh"
      }
    })} />
  </Fragment>

  <Header />

  <ArticleHero
    title="7 мифов о детских лагерях"
    subtitle="Разбираем то, что родители спрашивают чаще всего — и что из этого правда, а что нет."
    imageBase="bez-telefonov"
    imageAlt="Дети занимаются программированием в летнем IT-лагере"
    imagePosition="center_30%"
    readTime="8 мин чтения"
    breadcrumbsLast="7 мифов о детских лагерях"
    daryaQuote="Я сама каждый год отвечаю на одни и те же вопросы. Про ноутбук, про опыт, про безопасность. Решила собрать всё в одном месте — и честно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый апрель-май родители задают одни и те же вопросы: <em>«А ноутбук надо своё брать?»</em>, <em>«Он же не умеет программировать»</em>, <em>«А вдруг скучно без телефона?»</em> Большинство из них выросли из мифов. Разбираем главные — честно, без маркетинга.
        </p>
      </div>

      <!-- МИФ 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 1. «В IT-лагерь надо везти свой ноутбук»
          </h2>
        </div>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px] mb-4">
          <p class="text-base font-semibold uppercase tracking-[0.08em] text-orange-700 mb-2">Откуда это берётся</p>
          <p class="text-base leading-[1.6] text-slate-700 italic">«Нам написали — нужен ноутбук с установленным Python. Мы так и не разобрались»</p>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В хорошем IT-лагере <strong>всё оборудование предоставляется</strong>. Компьютеры, ноутбуки, лицензионное ПО, 3D-принтеры — всё это лагерь обеспечивает сам. Ребёнок приезжает с рюкзаком с личными вещами, а не с техникой на 80 000 рублей.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если организаторы просят привезти своё оборудование — это сигнал: либо лагерь рассчитан не на детей, либо экономят на инфраструктуре.
        </p>

        <StatCallout
          value="Ноутбук не нужен"
          label="— в АйДаКемп всё оборудование предоставляется. Компьютеры, ПО, 3D-принтеры, материалы для проектов."
          source={`Лицензия Минобрнауки ${STAT_LICENSE}`}
          icon="laptop"
          tone="neutral"
        />
      </div>

      <!-- МИФ 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 2. «Ребёнок должен уметь программировать»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство детей приезжают в IT-лагерь <strong>с нулём опыта</strong>. Программа в хорошем лагере строится с самого начала — через визуальные редакторы, Scratch, Minecraft Education. К концу смены ребята уезжают с готовым проектом независимо от стартового уровня.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Важнее опыта — <strong>характер и интерес</strong>. Дети, которые задают вопросы «как это устроено», зависают в Roblox или Minecraft, хотят сделать игру — уже готовы.
        </p>
      </div>

      <!-- МИФ 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 3. «Ребёнку без телефона будет плохо»
          </h2>
        </div>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px] mb-4">
          <p class="text-base leading-[1.6] text-slate-700 italic">«Психологически им тяжело вот так сразу отказаться от гаджетов. Я не ставила цели ограничить ребёнка в телефоне»</p>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В реальности детям в лагере <strong>некогда скучать по телефону</strong>. Полный день: занятия, проект, бассейн, спорт, вечерняя программа. Телефон выдаётся по расписанию — не потому что «запрещено», а потому что он просто не нужен.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Многие родители удивляются: ребёнок звонит домой первые два дня, потом перестаёт — не потому что плохо, а потому что <em>не успевает</em>. Он занят.
        </p>
      </div>

      <!-- МИФ 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 4. «В лагере только учёба, досуга нет»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Страх из 90-х, когда «детский лагерь» означал скудное расписание. Сейчас хороший летний лагерь — это полноценный детский курорт с программой. IT-занятия занимают 4–5 часов в день. Остальное:
        </p>
        <ul class="flex flex-col gap-2.5 mb-4 max-w-[720px]">
          {[
            "Бассейн — ежедневно",
            "Спорт: волейбол, футбол",
            "Вечерние мероприятия: кино, квесты, дискотека",
            "Творческие активности и командные игры",
            "Финальный хакатон — главное событие смены",
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- МИФ 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 5. «Дорогой лагерь — значит лучший»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Цена путёвки определяется <strong>базой проживания</strong>, а не качеством обучения. Дорогой санаторий с мраморными полами не гарантирует хороших преподавателей. Смотрите на авторов программы и их реальный опыт с детьми.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-3">На что реально смотреть:</p>
        <ul class="flex flex-col gap-2.5 max-w-[720px]">
          {[
            ["Кто ведёт занятия", "Преподаватели-практики, работающие с детьми несколько лет — не разовые фрилансеры"],
            ["Сколько лет работает лагерь", "Первый сезон — высокий риск «учимся на ваших детях»"],
            ["Образовательная лицензия", "Обязательна для IT-лагеря. Без неё нельзя законно вести обучение детей и оформить налоговый вычет"],
            ["Реальные отзывы", "На Яндекс.Картах, а не на сайте лагеря — туда не попадает негатив"],
            ["С чем ребёнок уедет", "Конкретный проект, а не просто сертификат «участника»"],
          ].map(([title, desc]) => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700"><strong>{title}</strong> — {desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- МИФ 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 6. «Онлайн-курсы эффективнее лагеря»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Онлайн-курс</strong> — это 2 урока в неделю. За 3 месяца ~24 занятия, каждый раз «вспоминаем прошлый урок».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Летний лагерь (10 дней)</strong> — это 40–50 часов работы над проектом без перерывов. Преподаватель рядом, ошибку разберут через 5 минут, а не через неделю в переписке. Концентрация x3 по сравнению с занятиями дома.
        </p>

        <StatCallout
          value="= 3–4 месяца"
          label="— столько онлайн-занятий заменяет одна смена в лагере по реальному прогрессу ребёнка. При этом он ещё и отдохнул."
          source="Оценка на основе учебных программ АйДаКемп 2022–2025"
          icon="mortarboard"
          tone="info"
        />
      </div>

      <!-- МИФ 7 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 7. «Непонятно, что ребёнок получит — деньги в никуда»
          </h2>
        </div>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px] mb-4">
          <p class="text-base leading-[1.6] text-slate-700 italic">«А что конкретно он там сделает? Непонятно, получит ли что-то реальное»</p>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хороший IT-лагерь даёт <strong>конкретный осязаемый результат</strong>: дети уезжают с собственными проектами. Не с сертификатами на полке — с реально работающей игрой, ботом в Telegram или 3D-моделью.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Проверить просто: спросите у лагеря «что конкретно сделает мой ребёнок?». Хороший лагерь ответит конкретно. Если в ответе только «получит знания и навыки» — это уже сигнал.
        </p>
      </div>

      <!-- МИФ ДОПОЛНИТЕЛЬНЫЙ: ПИТАНИЕ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 8. «В лагере плохо кормят»
          </h2>
        </div>

        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px] mb-4">
          <p class="text-base leading-[1.6] text-slate-700 italic">«Слышала, что там дают невкусную еду, подростки ходят голодные»</p>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Страх родом из советских пионерлагерей, где меню было ограничено по смете. В хорошем современном лагере питание — 5 раз в день, с учётом аллергий и предпочтений. Меню согласовывается с диетологом, блюда разнообразные.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Как проверить: попросите у организаторов примерное меню или фото из столовой. Хороший лагерь покажет это без вопросов. Если скрывают — задумайтесь.
        </p>
      </div>

      <!-- МИФ ДОПОЛНИТЕЛЬНЫЙ: БУЛЛИНГ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 9. «Ребята будут издеваться над тихонями»
          </h2>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          IT-лагерь — специфическая среда. Сюда приезжают школьники, которым интересны технологии, игры, создание проектов. Это не стандартный класс с его иерархией. «Тихоня» здесь вполне может оказаться самым уважаемым в группе — если он лучше всех настраивает API или придумывает механику игры.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатые на хорошей смене — это не «дяди-надзиратели», а взрослые ровесники, которые наблюдают за динамикой в каждой группе. При первых признаках конфликта — вмешиваются. Жалобы родителей на группповое давление в IT-лагерях — крайне редкое явление. Проверяйте отзывы на Яндекс.Картах.
        </p>
      </div>

      <!-- МИФ ДОПОЛНИТЕЛЬНЫЙ: УЧЁБА -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Миф 10. «Потеряет неделю учёбы»
          </h2>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смены в АйДаКемп проходят летом — {SEASON_FROM_TO}. Пропускать учебный год не придётся. Майская смена начинается после окончания уроков. Если всё же есть пересечение с учебными днями — большинство директоров подписывают справку без вопросов, особенно если смена образовательная и есть лицензия.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Что точно не потеряет: за 10–14 дней интенсивной работы над проектом ребёнок приобретает больше практических навыков, чем за месяц кружка раз в неделю. По нашим наблюдениям, после смены ребята возвращаются в школу с новым интересом к информатике и математике.
        </p>
      </div>

      <!-- ИТОГ / ЧЕК-ЛИСТ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чек-лист: как проверить лагерь за 5 минут
          </h2>
        </div>
        <ul class="flex flex-col gap-3 max-w-[720px]">
          {[
            "Образовательная лицензия Минобрнауки — обязательно для IT-лагеря",
            "Оборудование предоставляется — ноутбук, ПО, материалы",
            "Медработник 24/7 — не по вызову, а постоянно на территории",
            "Закрытая охраняемая территория — КПП, контроль входа",
            "Опытные преподаватели — не вожатые, а специалисты по работе с детьми",
            "Конкретный результат — дети уезжают с готовым проектом",
            "Отзывы на Яндекс.Картах — реальные, не на сайте лагеря",
            "Ежедневный фото-отчёт — родительский чат со связью через вожатых",
            "Несколько сезонов работы — лагерь с историей, не первый год",
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <i class="bi bi-check-circle-fill text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
              <span class="text-[16px] text-slate-700">{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-[16px] leading-[1.7] text-slate-500 italic">
          АйДаКемп — IT-лагерь в Подмосковье, 66 км от МКАД. Смены {SEASON_YEAR} с 30 мая по 26 августа, от {PRICE_MIN}. <a href="/ceny/" class="text-primary font-semibold hover:underline">Посмотреть смены и цены →</a>
        </p>
      </div>


      <BlogCTA />
    </article>

  {/* Вопросы были только в JSON-LD и не показывались читателю — Google требует
      видимости. only={[]} — рендерим ровно их, схему кладёт сам <FAQ /> */}
