---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere", icon: "star-fill", description: "6 страхов мамы и что будет на самом деле" },
  { title: "Что взять в лагерь", url: "/stati/chto-vzyat-v-lager", icon: "backpack", description: "Полный список — ничего не забыть" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Смены 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Что делать если ребёнок звонит и плачет в первый день?",
    answer: "Это нормально и это пройдёт. Выслушайте, скажите что любите, напомните про что-то интересное из программы — и мягко завершите разговор. Длинные разговоры с плачущей мамой не помогают — они фиксируют тревогу. Если через два-три дня ситуация не улучшается — звоните вожатому."
  },
  {
    question: "Стоит ли ехать в лагерь ребёнку с повышенной тревожностью?",
    answer: "Зависит от степени. Если ребёнок в принципе справляется с новыми ситуациями, просто небыстро — лагерь ему поможет, не навредит. Если тревожность сильная и раньше был негативный опыт разлуки — поговорите с нами до заезда. Мы подберём подходящую смену и вожатого."
  },
  {
    question: "Как вожатые помогают с адаптацией?",
    answer: "Первый день — насыщенный намеренно: знакомство, экскурсия, игры. Некогда грустить. Вожатый знает каждого ребёнка в своём отряде по имени и следит за настроением. Если ребёнок замкнулся — вожатый идёт к нему первым, не ждёт пока тот попросит."
  },
  {
    question: "Как часто можно звонить ребёнку в лагере?",
    answer: "Мы рекомендуем один звонок в день, в одно и то же время — например, после ужина. Это даёт ребёнку якорь («мама позвонит вечером») и не разрушает ритм дня. Частые звонки в первые дни, наоборот, затягивают адаптацию."
  }
];
---

<Base
  title="Адаптация ребёнка в лагере — 3 дня которые решают всё"
  description="Как проходит адаптация в детском лагере: первый вечер, второй и третий день. Что делают вожатые и что НЕ делать родителям в это время. Честно от мамы к маме."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/adaptaciya-rebenka-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Адаптация ребёнка в лагере — первые 3 дня | АйДаКемп",
        "description": "Как проходит адаптация в детском лагере: первый вечер, второй и третий день. Что делают вожатые АйДаКемп и что не делать родителям.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/adaptaciya-rebenka-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Адаптация в лагере: первые 3 дня и как помочь ребёнку"
    subtitle="Первый вечер — самый тяжёлый. На третий день он уже свой. Как это работает и что делать маме."
    imageBase="o-lagere"
    imageAlt="Дети знакомятся в первый день лагеря"
    readTime="6 мин чтения"
    breadcrumbsLast="Адаптация ребёнка в лагере"
    daryaQuote="Дочь написала мне в первый вечер: «хочу домой». Я не поехала. Написала в ответ: «утром станет лучше». Утром она прислала фото с новой подругой. Я знала, что так будет — но всё равно было сложно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Адаптация ребёнка в лагере — это не проблема, которую нужно предотвратить. Это нормальный процесс, через который проходит большинство детей, особенно первый раз. Понимание того, как он устроен, помогает маме не паниковать и не мешать ребёнку самому пройти этот путь.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День первый: тоска — это нормально
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Первый день — самый насыщенный специально. Приезд, распаковка, знакомство с отрядом, экскурсия по территории, первый обед вместе, вечерняя игра. Всё это — не развлечение ради развлечения, а инструмент адаптации.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Тоска по дому, если она есть, обычно приходит вечером — когда заканчивается программа и ребёнок остаётся с мыслями. Это нормально. Вожатые знают об этом и специально придумывают что-то на первый вечер: игры, знакомство в кружке, шуточные конкурсы.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если ребёнок пишет или звонит «хочу домой» — не паникуйте. Скажите что любите, что завтра будет новый день и там будет интересное. Не обещайте забрать — это усиливает тревогу, а не снижает её.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Важно: не звоните первыми в первый вечер. Дайте ребёнку самому справиться с новой средой. Если он не написал — значит, справляется. Это хорошо.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День второй: начинает включаться
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На второй день у большинства детей происходит перелом. Они уже знают, как выглядит территория, как зовут соседа по комнате, что на завтрак. Неизвестность уменьшается — тревога снижается.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Начинаются занятия по программе — и ребёнок втягивается в дело. В АйДаКемп занятия начинаются с первого полного дня: группы, треки, первое знакомство с проектом. Когда есть задача и команда — некогда думать о доме.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Второй день — это ещё не «всё хорошо», но уже «терпимо и даже интересно». Дети сами замечают это — и удивляются, что вчера казалось хуже.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            День третий: уже свой
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          К третьему дню у ребёнка уже есть свои — те, с кем он ест, работает над проектом, купается в бассейне. Есть ритм: подъём, завтрак, занятие, обед, свободное время, вечерняя активность. Ритм = ощущение безопасности.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефонные звонки резко сокращаются. Не потому что запретили — потому что некогда. Ребёнок занят, ему интересно, и мысли о доме уже не занимают первое место.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          По нашему опыту, дети которые на третий день уже смеются вместе с отрядом — к концу смены будут плакать, что уезжать. Это то, ради чего стоит пережить первые три дня.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делают вожатые АйДаКемп в эти три дня
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый знает каждого ребёнка в отряде по имени к концу первого дня. Это не метафора — это стандарт. Знает, кто едет первый раз, у кого были опасения, кто тревожный, кто сам по себе.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если ребёнок замкнулся — вожатый идёт к нему первым. Ненавязчиво, без лекций: «Пойдём покажу кое-что» или «Нам нужен ещё один в команду, ты умеешь...». Включение через дело работает лучше, чем психологические беседы.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Родителям мы отправляем фото из отряда каждый день. Если есть что-то важное — вожатый звонит сам, не ждёт звонка от родителей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что НЕ делать родителям
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Не звоните каждый час.</strong> Частые звонки — особенно тревожные, с вопросом «ну как ты там?» — поддерживают тревогу, а не снижают её. Один звонок в день в одно и то же время — это якорь, который помогает.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Не обещайте забрать «если захочет».</strong> Это размывает границу и ребёнок начинает воспринимать лагерь как что-то, из чего можно убежать. Лучше: «Ты справишься. Три дня — и станет лучше».</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Не транслируйте свою тревогу.</strong> «Я так за тебя переживаю» — это о вас, не о ребёнке. Ему от этого не легче. «Я знаю что у тебя всё получится» — это опора.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Занимайтесь собой.</strong> Лучшее, что вы можете сделать, пока ребёнок в лагере — сходить куда-то для себя. Это не эгоизм, это пример того, как проводить время с удовольствием.</span>
          </li>
        </ul>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>


  <ArticleBottomCta
    bookingTitle="Беспокоитесь, как ребёнок приживётся?"
    bookingSubtitle="Позвоните — расскажем как работает поддержка детей в первые дни смены."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
