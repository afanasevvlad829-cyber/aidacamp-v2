---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

// Эта статья — хаб темы «компьютерная зависимость».
// Ссылки на 5 статей серии + 1 LP (для CTA-конверсии)
const relatedPages = [
  { title: "Полный гид: зависимость от гаджетов", url: "/zavisimost-ot-gadzetov/", icon: "grid", description: "8 статей о детской гаджет-зависимости — все темы в одном месте" },
  { title: "Все статьи о зависимостях", url: "/stati/zavisimost-u-detej", icon: "grid", description: "Полный гид по детским цифровым зависимостям" },
  { title: "Признаки зависимости", url: "/stati/priznaki-kompyuternoj-zavisimosti", icon: "search", description: "6 конкретных признаков — что это уже зависимость" },
  { title: "Как избавиться от игр", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", icon: "arrow-repeat", description: "5-шаговый план без запретов и скандалов" },
  { title: "Лечение зависимости", url: "/stati/lechenie-kompyuternoj-zavisimosti", icon: "heart-pulse-fill", description: "Без клиники и без таблеток — что реально работает" },
  { title: "Профилактика зависимости", url: "/stati/profilaktika-kompyuternoj-zavisimosti", icon: "shield-check", description: "7 правил здоровой семьи" },
  { title: "Игромания у детей", url: "/stati/igromaniya-u-detej", icon: "controller", description: "Что говорит ВОЗ, группы риска" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-x", description: "Смена среды — что реально работает" },
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Со скольки лет может развиться зависимость от игр?",
    answer: "Зависимость может формироваться с 7–8 лет, как только ребёнок начинает играть самостоятельно. Но пик уязвимости — 10–14 лет: именно в этом возрасте дофаминовая система мозга особенно восприимчива к игровым механикам. Подростки играют больше и сложнее, а значит — риск выше."
  },
  {
    question: "Сколько часов за игрой — это нормально?",
    answer: "По рекомендациям ВОЗ: для детей до 12 лет — не более 1 часа экранного времени в день (включая игры, видео, соцсети). Для подростков 12–18 — до 2 часов в учебный день. В выходные немного больше — норма. Важнее не часы сами по себе, а то, вытесняют ли игры сон, общение, учёбу."
  },
  {
    question: "Помогает ли запрет игр?",
    answer: "Краткосрочно — да, ребёнок перестаёт играть пока запрет действует. Долгосрочно — создаёт «запретный плод»: чем строже запрет, тем сильнее тяга. Исследования показывают, что подростки, у которых игры полностью запрещали, впоследствии играли больше. Работает договор — чёткое время и правила, которые ребёнок принял сам."
  },
  {
    question: "Когда обращаться к специалисту?",
    answer: "Если три и больше признаков зависимости держатся дольше месяца — стоит поговорить с подростковым психологом. Не чтобы «лечить», а чтобы понять: это уже расстройство или сильное увлечение, которое можно скорректировать дома. Одна консультация даёт ясность и снимает тревогу."
  },
  {
    question: "Может ли IT-лагерь помочь с зависимостью?",
    answer: "Да — через переключение интереса с потребления на создание. Подросток, который сделал свою игру или бота, смотрит на игры иначе: он понимает как это устроено изнутри. В АйДаКемп 60% ребят приходят «из геймеров» — и уходят с собственным проектом. Лагерь не заменяет психолога при клинической зависимости, но как мягкое переключение среды — работает очень хорошо."
  },
  {
    question: "Почему переменное подкрепление в играх так опасно?",
    answer: "Переменное подкрепление — когда награда выдаётся случайно, а не стабильно — создаёт самый сильный тип поведенческой зависимости. Именно так работают игровые автоматы. В компьютерных играх это лутбоксы, случайный дроп редких предметов, непредсказуемые победы в рейтинговых матчах. Мозг «застревает» в ожидании следующей награды. Netflix не использует эту механику — именно поэтому игры затягивают сильнее сериалов."
  },
  {
    question: "Что делать если у ребёнка зависимость, а психолог говорит «всё нормально»?",
    answer: "Попросите второе мнение у специалиста с опытом работы с игровой зависимостью — не все подростковые психологи специализируются именно на этом. Параллельно действуйте сами: введите режим экранного времени, уберите гаджеты из спальни, найдите занятие-замену. Если поведение ребёнка меняется к лучшему за 2–4 недели — значит, была привычка, а не клиническая зависимость."
  }
];
---

<Base
  title="Зависимость от компьютерных игр у детей — 4 шага помочь"
  description="Игры — не враг, а симптом. Узнайте 4 шага, которые реально возвращают ребёнка в жизнь — мягко, без конфискации и скандалов. Опыт 1 200 семей."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Ребёнок не отрывается от компьютерных игр — что делать | АйДаКемп",
        "description": "Игры — не враг, а симптом. 4 шага которые реально возвращают ребёнка в жизнь: мягко, без конфискации и скандалов. По опыту 1 200 семей.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-02-01",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Зависимость от компьютерных игр у детей", "item": "https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость от компьютерных игр у детей и подростков"
    subtitle="Разбираем признаки, причины и способы помочь ребёнку — без паники и запретов."
    imageBase="zavisimost-hub"
    imageAlt="Ребёнок за компьютером — зависимость от компьютерных игр"
    imagePosition="center 55%"
    readTime="7 мин чтения"
    breadcrumbsLast="Зависимость от компьютерных игр"
    daryaQuote="Когда моя дочь выходила из комнаты только поесть — я поняла: что-то пошло не так. Игры — не враг, но симптом, который нельзя игнорировать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Section 1 -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять, что это уже зависимость
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Разница между «много играет» и «зависим» — в потере контроля. Зависимый ребёнок не может остановиться по своей воле: любая попытка прервать игру вызывает агрессию, слёзы или манипуляции. Он думает об игре постоянно — даже когда не играет. Реальная жизнь перестаёт приносить удовольствие.
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Невозможность самостоятельно остановить игру</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Агрессия или истерика при отключении компьютера</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Потеря интереса к другим занятиям, друзьям, учёбе</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Нарушение сна — засиживается до ночи</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ложь о времени за компьютером</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Снижение успеваемости в школе</span></li>
        </ul>
      </div>

      <!-- Section NEW: Как отличить увлечение от зависимости -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как отличить увлечение от зависимости: 5 признаков
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Один признак — не зависимость. Три и больше — повод поговорить с ребёнком.
        </p>
        <div class="space-y-3 mb-5">
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[13px] font-bold text-orange-600">1</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-0.5">Скандалы при попытке оторвать от игры</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Обычный ребёнок поворчит и выйдет. Зависимый — устраивает настоящую сцену: крики, слёзы, агрессия. Каждый раз.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[13px] font-bold text-orange-600">2</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-0.5">Игра важнее еды, сна и друзей</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Забывает поесть, ложится в 2 ночи, отказывается от прогулки с друзьями — лишь бы не прерываться.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[13px] font-bold text-orange-600">3</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-0.5">Ложь о времени за компьютером</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Говорит «я только на час», а прошло три. Прячет телефон, закрывает экран — сам чувствует, что «слишком много».</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[13px] font-bold text-orange-600">4</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-0.5">Тревога и агрессия без игры</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">В поездке без Wi-Fi или в дни без компьютера — раздражён, не находит себе места, ни на чём не может сосредоточиться.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[13px] font-bold text-orange-600">5</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-0.5">Потеря интереса ко всему остальному</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Хобби, которые раньше нравились, — забыты. Предложение пойти куда-нибудь встречает равнодушием: «не хочу, неинтересно».</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему возникает игровая зависимость
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Компьютерные игры спроектированы так, чтобы удерживать внимание. Система наград, прокачки, социального давления («не подведи команду») — всё это создаёт петли привязанности. Мозг ребёнка, особенно подростка, особенно уязвим: дофаминовая система ещё формируется, а игры дают быстрое и предсказуемое удовольствие. В реальной жизни результаты приходят медленнее.
        </p>
      </div>

      <!-- Section NEW: Почему игры опаснее Netflix -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему игры затягивают сильнее Netflix: механика дофамина
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Netflix тоже делает сериалы аддиктивными — клиффхэнгеры, автопроигрывание следующей серии. Но у компьютерных игр есть три механики, которых у сериала нет:
        </p>
        <div class="space-y-3 mb-5">
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-[15px] font-semibold text-slate-800 mb-1">Переменное подкрепление (variable ratio reinforcement)</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Та же механика, что делает игровые автоматы самыми аддиктивными устройствами в мире. В игре: иногда выпадает редкий лут, иногда нет — именно эта непредсказуемость создаёт максимальный дофаминовый отклик. Netflix всегда предсказуем — следующая серия точно выйдет.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-[15px] font-semibold text-slate-800 mb-1">Агентность и чувство контроля</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">В игре ты принимаешь решения: пойти налево или направо, атаковать или отступить. Это создаёт иллюзию контроля над миром — мощный психологический крючок для подростка, у которого в реальной жизни мало что зависит от него самого. Сериал ты только смотришь.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-[15px] font-semibold text-slate-800 mb-1">Социальное давление и FOMO</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">В командных играх (Fortnite, CS2, Valorant) нельзя «поставить на паузу» — команда ждёт. Выйти = подвести тиммейтов. Netflix не обидится. Это создаёт социальное обязательство, которое удерживает в игре даже когда хочется остановиться.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Понимание этих механик важно не для того чтобы «запретить игры» — а чтобы найти замену, которая даёт похожий дофамин через созидание. Программирование, создание игр, соревновательный спорт — всё это использует те же механизмы мозга, но в продуктивном ключе.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что не работает: частые ошибки родителей
          </h2>
        </div>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Резкий запрет — вызывает обратный эффект и конфликт</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Изъятие компьютера без объяснений — подрывает доверие</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">«Ты всё равно ничего не добьёшься с этими играми» — унижение не помогает</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Бесконечные переговоры и торг — ребёнок учится манипулировать</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Игнорирование проблемы в надежде «само пройдёт»</span></li>
        </ul>
      </div>

      <!-- Section NEW: Что реально помогает -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
