---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';

const relatedPages = [
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", emoji: "📵", description: "Как работает наша механика" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", emoji: "🚀", description: "Программа 12–16 лет" },
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove", emoji: "🌲", description: "Смены и цены" },
];
---

<Base
  title="Зависимость от компьютерных игр у детей и подростков — как бороться"
  description="Признаки компьютерной зависимости, причины игромании у подростков и детей. Как бороться с зависимостью от компьютерных игр — советы и стратегии от АйДаКемп."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr" />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость от компьютерных игр у детей и подростков"
    subtitle="Разбираем признаки, причины и способы помочь ребёнку — без паники и запретов."
    image="/images/article-hero-igry.avif"
    tags={["Игры", "Зависимость", "Помощь"]}
    readTime="6 минут"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">

    <p class="text-[16px] text-slate-500 mb-10">
      Разбираем признаки, причины и способы помочь ребёнку — без паники и запретов.
    </p>

    <!-- Article content -->
    <article>

      <!-- Stats block -->
      <div class="my-8 grid grid-cols-3 gap-4 rounded-2xl bg-slate-50 p-6">
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">3–4 ч.</div>
          <div class="text-[13px] text-slate-500 mt-1">критический порог игрового времени в день (ВОЗ)</div>
        </div>
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">1 из 10</div>
          <div class="text-[13px] text-slate-500 mt-1">геймеров имеет признаки зависимости</div>
        </div>
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">12–17 лет</div>
          <div class="text-[13px] text-slate-500 mt-1">пиковый возраст риска формирования зависимости</div>
        </div>
      </div>

      <!-- Section 1 -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять, что это уже зависимость
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Разница между «много играет» и «зависим» — в потере контроля. Зависимый ребёнок не может остановиться по своей воле: любая попытка прервать игру вызывает агрессию, слёзы или манипуляции. Он думает об игре постоянно — даже когда не играет. Реальная жизнь перестаёт приносить удовольствие.
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Невозможность самостоятельно остановить игру</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Агрессия или истерика при отключении компьютера</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Потеря интереса к другим занятиям, друзьям, учёбе</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Нарушение сна — засиживается до ночи</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Ложь о времени за компьютером</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Снижение успеваемости в школе</span></li>
        </ul>
      </div>

      <!-- Red flags -->
      <div class="my-8 rounded-2xl bg-red-50 border border-red-100 p-6">
        <h3 class="text-[16px] font-bold text-red-700 mb-3">⚠ 6 признаков игровой зависимости</h3>
        <ul class="space-y-2">
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Невозможность самостоятельно остановить игру</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Агрессия или истерика при отключении компьютера</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Полная потеря интереса к другим занятиям и друзьям</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Нарушение сна — засиживается до ночи, не хочет вставать</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Систематическая ложь о времени за компьютером</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-red-400 shrink-0">✗</span> Резкое снижение успеваемости в школе</li>
        </ul>
      </div>

      <!-- Section 2 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему возникает игровая зависимость
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Компьютерные игры спроектированы так, чтобы удерживать внимание. Система наград, прокачки, социального давления («не подведи команду») — всё это создаёт петли привязанности. Мозг ребёнка, особенно подростка, особенно уязвим: дофаминовая система ещё формируется, а игры дают быстрое и предсказуемое удовольствие. В реальной жизни результаты приходят медленнее.
        </p>
      </div>

      <!-- Comparison: addiction vs hobby -->
      <div class="my-8 grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-red-50 border border-red-100 p-5">
          <div class="text-[13px] font-bold text-red-600 uppercase tracking-wide mb-3">✗ Зависимость</div>
          <ul class="space-y-2 text-[14px] text-slate-600">
            <li>Не может остановиться сам</li>
            <li>Агрессия при любом ограничении</li>
            <li>Всё остальное — скучно</li>
            <li>Игра — способ избежать реальности</li>
          </ul>
        </div>
        <div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-5">
          <div class="text-[13px] font-bold text-emerald-600 uppercase tracking-wide mb-3">✓ Увлечение</div>
          <ul class="space-y-2 text-[14px] text-slate-600">
            <li>Может остановиться при необходимости</li>
            <li>Недоволен, но понимает правила</li>
            <li>Есть другие интересы и друзья</li>
            <li>Игра — один из способов отдохнуть</li>
          </ul>
        </div>
      </div>

      <!-- Section 3 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что не работает: частые ошибки родителей
          </h2>
        </div>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Резкий запрет — вызывает обратный эффект и конфликт</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Изъятие компьютера без объяснений — подрывает доверие</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">«Ты всё равно ничего не добьёшься с этими играми» — унижение не помогает</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Бесконечные переговоры и торг — ребёнок учится манипулировать</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Игнорирование проблемы в надежде «само пройдёт»</span></li>
        </ul>
      </div>

      <!-- Section 4 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как бороться с зависимостью от компьютерных игр
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Эффективные подходы строятся не на запрете, а на замещении и структуре.
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Установить чёткие временные рамки — и соблюдать их самим</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Найти альтернативу которая даёт похожий дофамин: спорт, творчество, код</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Вовлечь в реальные проекты — где есть прогресс и результат</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Договориться о правилах заранее, а не в момент конфликта</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Обратиться к психологу если конфликты стали постоянными</span></li>
        </ul>
      </div>

      <!-- Green checklist: how to help -->
      <div class="my-8 rounded-2xl bg-emerald-50 border border-emerald-100 p-6">
        <h3 class="text-[16px] font-bold text-emerald-800 mb-4">✓ Как помочь без конфликтов</h3>
        <ul class="space-y-2">
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Установить правила заранее — в спокойный момент, не во время конфликта</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Найти альтернативу, которая даёт похожий дофамин: спорт, создание кода</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Дать ребёнку реальный проект с прогрессом и видимым результатом</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Соблюдать правила самому — не сидеть в телефоне на виду</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Обратиться к психологу, если ситуация не меняется 2+ месяца</li>
        </ul>
      </div>

      <!-- Section 5 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как IT-лагерь помогает справиться с игровой зависимостью
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          АйДаКемп — не лечебное учреждение, но многие родители замечают положительные изменения после смены. Механика «жизнь без телефона» переключает ребёнка в живую среду. IT-занятия дают похожий дофамин — но через созидание, а не потребление. Ребёнок, который создал игру или бота своими руками, смотрит на игры иначе: он понимает, как это устроено изнутри.
        </p>
      </div>

    </article>
  </main>
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
