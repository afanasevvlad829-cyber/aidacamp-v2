---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

// Эта статья — хаб темы «компьютерная зависимость».
// Ссылки на 5 статей серии + 1 LP (для CTA-конверсии)
const relatedPages = [
  { title: "Полный гид: зависимость от гаджетов", url: "/zavisimost-ot-gadzetov/", icon: "grid", description: "8 статей о детской гаджет-зависимости — все темы в одном месте" },
  { title: "Все статьи о зависимостях", url: "/stati/zavisimost-u-detej/", icon: "grid", description: "Полный гид по детским цифровым зависимостям" },
  { title: "Признаки зависимости", url: "/stati/priznaki-kompyuternoj-zavisimosti/", icon: "search", description: "6 конкретных признаков — что это уже зависимость" },
  { title: "Как избавиться от игр", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr/", icon: "arrow-repeat", description: "5-шаговый план без запретов и скандалов" },
  { title: "Лечение зависимости", url: "/stati/lechenie-kompyuternoj-zavisimosti/", icon: "heart-pulse-fill", description: "Без клиники и без таблеток — что реально работает" },
  { title: "Профилактика зависимости", url: "/stati/profilaktika-kompyuternoj-zavisimosti/", icon: "shield-check", description: "7 правил здоровой семьи" },
  { title: "Игромания у детей", url: "/stati/igromaniya-u-detej/", icon: "controller", description: "Что говорит ВОЗ, группы риска" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Смена среды — что реально работает" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Со скольки лет может развиться зависимость от игр?",
    answer: "Зависимость может формироваться с 7–8 лет, как только ребёнок начинает играть самостоятельно. Но пик уязвимости — 10–14 лет: именно в этом возрасте дофаминовая система мозга особенно восприимчива к игровым механикам. В период активного развития мозга риск формирования зависимости выше — поэтому реагировать стоит раньше, а не ждать, когда признаки станут очевидны. Подростки играют больше и сложнее, а значит — риск выше."
  },
  {
    question: "Сколько часов за игрой — это нормально?",
    answer: "По рекомендациям ВОЗ: для детей до 12 лет — не более 1 часа экранного времени в день (включая игры, видео, соцсети). Для подростков 12–18 — до 2 часов в учебный день. В выходные немного больше — норма. Важнее не часы сами по себе, а то, вытесняют ли игры сон, общение, учёбу."
  },
  {
    question: "Помогает ли запрет игр?",
    answer: "Краткосрочно — да, ребёнок перестаёт играть пока запрет действует. Долгосрочно — создаёт «запретный плод»: чем строже запрет, тем сильнее тяга. Исследования показывают, что подростки, у которых игры полностью запрещали, впоследствии играли больше. Работает договор — чёткое время и правила, которые ребёнок принял сам."
  },
  {
    question: "Когда обращаться к специалисту?",
    answer: "Если три и больше таких признаков держатся дольше месяца — стоит поговорить с подростковым психологом. Не чтобы «лечить», а чтобы понять: это уже расстройство или сильное увлечение, которое можно скорректировать дома. Помощь специалиста на этом этапе — не признание катастрофы, а простой способ получить ясность и план действий. Одна консультация даёт ясность и снимает тревогу."
  },
  {
    question: "Может ли IT-лагерь помочь с зависимостью?",
    answer: "Да — через переключение интереса с потребления на создание. Подросток, который сделал свою игру или бота, смотрит на игры иначе: он понимает как это устроено изнутри. В АйДаКемп 60% ребят приходят «из геймеров» — и уходят с собственным проектом. Лагерь не заменяет психолога в серьёзных случаях, но как мягкое переключение среды — работает очень хорошо."
  },
  {
    question: "Почему переменное подкрепление в играх так опасно?",
    answer: "Переменное подкрепление — когда награда выдаётся случайно, а не стабильно — создаёт самый сильный тип поведенческой привязанности. Именно так работают игровые автоматы. В компьютерных играх это лутбоксы, случайный дроп редких предметов, непредсказуемые победы в рейтинговых матчах. Мозг «застревает» в ожидании следующей награды. Netflix не использует эту механику — именно поэтому игры затягивают сильнее сериалов."
  },
  {
    question: "Что делать если у ребёнка зависимость, а психолог говорит «всё нормально»?",
    answer: "Попросите второе мнение у специалиста с опытом в этой теме — не все подростковые психологи специализируются именно на этом. Параллельно действуйте сами: введите режим экранного времени, уберите гаджеты из спальни, найдите занятие-замену. Если поведение ребёнка меняется к лучшему за 2–4 недели — значит, была привычка, а не клиническая зависимость."
  }
];
---

<Base
  title="Зависимость от компьютерных игр у детей и подростков: что делать"
  description="Компьютерная зависимость у детей: что делать, если игры — не враг, а симптом. 4 шага, которые возвращают ребёнка в жизнь — мягко, без конфискации и скандалов. Опыт 1 200 семей."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Ребёнок не отрывается от компьютерных игр — что делать | АйДаКемп",
        "description": "Игры — не враг, а симптом. 4 шага которые реально возвращают ребёнка в жизнь: мягко, без конфискации и скандалов. По опыту 1 200 семей.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-02-01",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/zavisimost-ot-kompyuternyh-igr"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость от компьютерных игр: что делать"
    subtitle="Разбираем признаки, причины и способы помочь ребёнку — без паники и запретов."
    imageBase="zavisimost-hub"
    imageAlt="Ребёнок за компьютером — зависимость от компьютерных игр"
    imagePosition="center 55%"
    readTime="7 мин чтения"
    breadcrumbsLast="Зависимость от компьютерных игр"
    daryaQuote="Когда моя дочь выходила из комнаты только поесть — я поняла: что-то пошло не так. Игры — не враг, но симптом, который нельзя игнорировать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Section 1 -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять, что это уже зависимость
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Компьютерная зависимость начинается незаметно. Разница между «много играет» и «зависим» — в потере контроля. Зависимый ребёнок не может остановиться по своей воле: любая попытка прервать игру вызывает агрессию, слёзы или манипуляции. Он думает об игре постоянно — даже когда не играет. Реальная жизнь перестаёт приносить удовольствие. Первые признаки зависимости легко перепутать с обычным увлечением: важно смотреть не на то, сколько времени подросток играет, а на то, что происходит, когда игру пытаются прервать.
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Невозможность самостоятельно остановить игру</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Агрессия или истерика при отключении компьютера</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Потеря интереса к другим занятиям, друзьям, учёбе</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Нарушение сна — засиживается до ночи</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ложь о времени за компьютером</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Снижение успеваемости в школе</span></li>
        </ul>
      </div>

      <!-- Section NEW: Как отличить увлечение от зависимости -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как отличить увлечение от зависимости: 5 признаков
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Один признак — не зависимость. Три и больше — повод поговорить с ребёнком.
        </p>
        <div class="space-y-3 mb-5">
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">1</span>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Скандалы при попытке оторвать от игры</p>
              <p class="text-base leading-[1.6] text-slate-600">Обычный ребёнок поворчит и выйдет. Тут — другая картина: крики, слёзы, агрессия. Каждый раз.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">2</span>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Игра важнее еды, сна и друзей</p>
              <p class="text-base leading-[1.6] text-slate-600">Забывает поесть, ложится в 2 ночи, отказывается от прогулки с друзьями — лишь бы не прерываться.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">3</span>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Ложь о времени за компьютером</p>
              <p class="text-base leading-[1.6] text-slate-600">Говорит «я только на час», а прошло три. Прячет телефон, закрывает экран — сам чувствует, что «слишком много».</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">4</span>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Тревога и агрессия без игры</p>
              <p class="text-base leading-[1.6] text-slate-600">В поездке без Wi-Fi или в дни без компьютера — раздражён, не находит себе места, ни на чём не может сосредоточиться.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">5</span>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Потеря интереса ко всему остальному</p>
              <p class="text-base leading-[1.6] text-slate-600">Хобби, которые раньше нравились, — забыты. Предложение пойти куда-нибудь встречает равнодушием: «не хочу, неинтересно».</p>
            </div>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Иногда за этим стоят скрытые трудности — в учёбе, в общении со сверстниками или дома. Игра становится способом избежать того, что давит снаружи, и чем раньше это заметить, тем легче помочь ребёнку вернуться к обычной жизни без потерь. Разных зависимостей у подростков бывает несколько сразу, поэтому один тест — не диагноз, а повод присмотреться внимательнее.
        </p>
      </div>

      <!-- Section NEW: Тест для подростка -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Мини-тест для подростка: узнаёшь себя?
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Эту часть можно показать самому ребёнку — иногда честный разговор начинается легче, если вопросы звучат не от родителя, а как обычный тест. Ответь себе честно, без оглядки на то, что «правильно».
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ты садишься «на 20 минут», а потом замечаешь, что играешь уже два часа?</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Садишься за игру даже когда неинтересно, просто чтобы не думать о другом?</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Когда родители спрашивают, сколько времени сегодня прошло за игрой, тебе проще соврать, чем сказать правду?</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ты злишься сильнее обычного, если тебя отвлекают именно в момент игры?</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ты замечал, что думаешь об игре даже вдали от неё — на уроке, за столом, перед сном?</span></li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если ты ответил «да» хотя бы на три вопроса — это ещё не диагноз, но повод честно поговорить со взрослыми, а не притворяться, что всё в порядке. Признать, что игра отнимает больше времени, чем хотелось бы, — не стыдно. Стыдно только продолжать врать себе, что всё под контролем, когда это давно не так. И даже если это тянется много лет подряд без перерывов — начать разговор никогда не поздно. Даже если ты играешь каждый день и постоянно хочешь играть ещё, — это повод не для стыда, а для честного разговора с близкими.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему возникает игровая зависимость
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Компьютерные игры спроектированы так, чтобы удерживать внимание. Система наград, прокачки, социального давления («не подведи команду») — всё это создаёт петли привязанности. Мозг ребёнка, особенно подростка, особенно уязвим: дофаминовая система ещё формируется, а игры дают быстрое и предсказуемое удовольствие. В реальной жизни результаты приходят медленнее.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Дофаминовая система головного мозга у подростков работает интенсивнее, чем у взрослых, — именно поэтому одни и те же игры затягивают их сильнее и отпускают труднее. Так постепенно и формируется зависимость: чем чаще срабатывает система вознаграждения, тем сложнее остановиться самому, даже когда очень хочется.
        </p>
      </div>

      <!-- Section NEW: Почему игры опаснее Netflix -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему игры затягивают сильнее Netflix: механика дофамина
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Netflix тоже делает сериалы аддиктивными — клиффхэнгеры, автопроигрывание следующей серии. Но у компьютерных игр есть три механики, которых у сериала нет:
        </p>
        <div class="space-y-3 mb-5">
          <div class="border border-slate-200 rounded-xl p-4">
