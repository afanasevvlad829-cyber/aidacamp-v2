---
import { PRICE_S4, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Что взять с собой", url: "/stati/chto-vzyat-v-lager/", icon: "bag-check", description: "Полный чек-лист собранных вещей" },
  { title: "Документы для лагеря", url: "/stati/dokumenty-dlya-rebenka-v-lager/", icon: "file-earmark-text", description: "Какие справки нужны на заезд" },
  { title: "Как выбрать IT-лагерь", url: "/stati/kak-vybrat-it-lager/", icon: "laptop", description: "На что смотреть при выборе" },
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "code-slash", description: "АйДаКемп — программирование для подростков в Подмосковье" },
];

const faqItems = [
  {
    question: "Когда лучше всего записывать ребенка на смену?",
    answer: "Январь–февраль — оптимальное время. Большинство хороших вариантов к апрелю уже заполнены на 70–80%. Популярные смены (начало июня, середина июля) могут закрыться ещё раньше. Если ориентируетесь на конкретную смену — не ждите весны."
  },
  {
    question: "Где проверить лицензию лагеря?",
    answer: "На сайте Рособрнадзора (obrnadzor.gov.ru) в разделе «Реестр лицензий». Введите название организации или ИНН. Лицензия на образовательную деятельность — не то же самое, что разрешение на оздоровительный лагерь. Уточняйте вид деятельности в реестре."
  },
  {
    question: "Можно ли получить налоговый вычет за смену ребенка?",
    answer: "Да, если у организации есть лицензия на образовательную деятельность. Возврат 13% от образовательной составляющей стоимости смены. В АйДаКемп лицензия есть — при оформлении мы выдаём все нужные документы для вычета."
  },
  {
    question: "Какой пакет документов нужен при записи, а что требуется только на заезд?",
    answer: "При записи: обычно достаточно заявки и договора (+ оплата брони). При заезде потребуются медицинская справка 079у, полис ОМС, свидетельство о рождении (или паспорт с 14 лет), подписанное согласие на обработку данных. Некоторые лагеря просят справку о прививках. Подробный список — в статье о документах для ребенка в лагере."
  },
];
---

<Base
  title={`Как записать ребенка в лагерь и оформить заезд на ${SEASON_YEAR}: документы, договор`}
  description={`Как записать ребенка в лагерь и оформить заезд: пошаговая инструкция, проверка лицензии, вопросы организатору, какие документы нужны для заявки, договор, оплата смены и порядок действий в ${SEASON_YEAR} году.`}
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Как записать ребенка в лагерь: инструкция и порядок действий на ${SEASON_YEAR} год`,
        "description": "Пошаговая инструкция: когда начинать, как проверить лицензию, какие вопросы задать организатору, какие документы собрать на заявку и что обратить внимание в договоре — от выбора формата до оплаты смены.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-07-16",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kak-zapisat-rebenka-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title={`Как записать ребенка в лагерь на ${SEASON_YEAR}`}
    subtitle="Шесть шагов — от выбора формата смены до подписания договора. Плюс чек-лист и ответы на частые вопросы."
    imageBase="lager-na-leto-2026"
    imageAlt="Школьники на занятии в летнем лагере"
    readTime="6 мин чтения"
    breadcrumbsLast="Запись ребенка в лагерь"
    daryaQuote="Первый раз я начала искать смену в мае — и потеряла почти все нормальные варианты. Теперь всегда смотрю в январе, а в феврале уже бронирую. Хорошие места заканчиваются быстрее, чем кажется."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Записать ребенка в летний лагерь — это не просто заполнить форму на сайте. Нужно выбрать подходящий формат, проверить документы организатора, задать правильные вопросы и собрать пакет документов. Разбираем всё по шагам: как выбрать формат и как подготовить ребёнка к заезду.
        </p>
      </div>

      <!-- Когда начинать -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда начинать: январь — февраль, не позже
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не преувеличение. Популярные смены в хороших местах заполняются за 3–4 месяца до старта. К маю от лучших вариантов на июнь и начало июля зачастую остаются только свободные места в слабых сменах или у малоизвестных организаторов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы читаете это в марте–апреле — не паникуйте, но действуйте быстро. Варианты на вторую половину июля и август ещё есть. Смены на конец июня и первую половину июля скорее всего уже закрыты.
        </p>
        <div class="mt-4 bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-calendar-event text-orange-400 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Оптимальный план</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Январь — смотрите варианты и задаёте вопросы. Февраль — бронируете место и платите предоплату. Апрель–май — собираете справки. За неделю до смены — финальная сборка.
            </div>
          </div>
        </div>
      </div>

      <!-- Шаг 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 1. Выбрать формат смены для ребенка
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Три основных формата летнего отдыха — и у каждого свои плюсы:
        </p>
        <div class="flex flex-col gap-4 mb-4">
          <div class="bg-slate-50 rounded-2xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-sun-fill text-orange-400 text-[18px]" aria-hidden="true"></i>
              <span class="text-base font-bold text-slate-900">Дневной формат</span>
            </div>
            <p class="text-base text-slate-600 leading-[1.6]">Ребенок приходит утром и уходит вечером домой. Подходит для тех, кто не готов к ночёвкам или живёт рядом. Дешевле, но и погружение в программу меньше — нет вечерних мероприятий и командной жизни.</p>
          </div>
          <div class="bg-slate-50 rounded-2xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-tree-fill text-green-500 text-[18px]" aria-hidden="true"></i>
              <span class="text-base font-bold text-slate-900">Загородный лагерь</span>
            </div>
            <p class="text-base text-slate-600 leading-[1.6]">Классический летний лагерь: несколько дней или недель вдали от города. Полное погружение в программу, природа, командная жизнь. Требует готовности ребенка к самостоятельности. Для первого раза лучше выбирать смены 7–10 дней.</p>
          </div>
          <div class="bg-slate-50 rounded-2xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-laptop text-blue-500 text-[18px]" aria-hidden="true"></i>
              <span class="text-base font-bold text-slate-900">Тематическая смена</span>
            </div>
            <p class="text-base text-slate-600 leading-[1.6]">Смена с конкретной специализацией: IT, робототехника, языки, спорт, творчество. Ребёнок занимается тем, что ему интересно — и не скучает. Самый высокий уровень вовлечённости из всех форматов.</p>
          </div>
        </div>
        <p class="text-base text-slate-500 leading-[1.6] italic">Один вопрос, который помогает определиться: чем ваш ребёнок занимался бы всё лето, если бы мог выбрать сам?</p>
      </div>

      <!-- Шаг 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 2. Проверить лицензию Минобрнауки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не формальность — это базовая проверка, которую пропускают многие. Лицензия на образовательную деятельность означает, что лагерь прошёл государственную проверку: программа, педагоги, условия соответствуют требованиям.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Без лицензии невозможно оформить налоговый вычет 13% от стоимости смены. Для смены в {PRICE_S4} это возврат около 4 800 ₽ — не мелочь.
        </p>
        <div class="mt-4 bg-blue-50 border border-blue-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-info-circle-fill text-blue-400 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Как проверить</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Зайдите на сайт Рособрнадзора (obrnadzor.gov.ru) → «Реестр лицензий». Введите название организации или ИНН — они должны быть на сайте лагеря или в договоре. Лицензия выдаётся юрлицу, не «лагерю» как бренду — ищите полное название ООО или ИП.
            </div>
          </div>
        </div>
      </div>

      <!-- Шаг 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 3. Изучить отзывы на Яндекс.Картах и 2GIS
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Отзывы на собственном сайте — не показатель: их выбирает сам лагерь. Яндекс.Карты и 2GIS сложнее накрутить, и там больше живых историй от родителей.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На что обращать внимание:
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Средняя оценка 4.5 и выше</strong> — хороший ориентир. Ниже 4.2 — стоит насторожиться.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Как организатор отвечает на негатив</strong> — важнее самого негатива. Если отвечают по делу и предлагают решение — это признак зрелой организации.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Паттерн негативных отзывов</strong> — если несколько разных людей пишут об одном и том же (еда, дисциплина, связь) — это не случайность.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Фото от реальных родителей</strong> — не постановочные съёмки с сайта, а живые снимки из Telegram-чата родителей или историй в соцсетях.</span>
          </li>
        </ul>
        <p class="text-base text-slate-500 leading-[1.6] italic">Дополнительный способ: поищите название лагеря в Telegram или ВКонтакте — там часто есть отдельные чаты бывших участников, где говорят откровенно.</p>
      </div>

      <!-- Шаг 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 4. Связаться с организатором — 5 вопросов, которые надо задать
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Звонок или переписка с менеджером — это не только способ получить информацию. Это ещё и тест: как быстро отвечают, насколько конкретны ответы. Организатор с хаотичной коммуникацией на этапе продаж не станет лучше в смену — это прямой показатель того, как будут решать вопросы ребенка во время смены.
        </p>
        <div class="flex flex-col gap-3 mb-4">
          <div class="flex gap-3 items-start bg-slate-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center mt-0.5">1</span>
            <div>
              <p class="text-base font-semibold text-slate-900 mb-1">Какое соотношение вожатых и ребят в группе?</p>
              <p class="text-base text-slate-600 leading-[1.6]">Норма — 1 вожатый на 6–8 человек. Больше 10 — стоит уточнить, как строится работа.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start bg-slate-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center mt-0.5">2</span>
            <div>
              <p class="text-base font-semibold text-slate-900 mb-1">Есть ли медработник на территории круглосуточно?</p>
              <p class="text-base text-slate-600 leading-[1.6]">«Медик по вызову» — это не то же самое. Уточните: живёт ли он на базе в течение смены.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start bg-slate-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center mt-0.5">3</span>
            <div>
              <p class="text-base font-semibold text-slate-900 mb-1">Как организована связь с ребенком?</p>
              <p class="text-base text-slate-600 leading-[1.6]">Ежедневные фото в Telegram-канале, расписание звонков, имя куратора — это признак открытости. Расплывчатое «созвонитесь когда захотите» — нет.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start bg-slate-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center mt-0.5">4</span>
            <div>
              <p class="text-base font-semibold text-slate-900 mb-1">Что конкретно происходит каждый день по программе?</p>
              <p class="text-base text-slate-600 leading-[1.6]">Попросите расписание или хотя бы описание типичного дня. «Творческое развитие и командная работа» — не ответ.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start bg-slate-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-primary text-white text-base font-bold flex items-center justify-center mt-0.5">5</span>
            <div>
              <p class="text-base font-semibold text-slate-900 mb-1">Что будет, если смена не понравится ребенку — условия возврата?</p>
              <p class="text-base text-slate-600 leading-[1.6]">В хорошем договоре условия возврата прописаны заранее. Размытые формулировки «разберёмся» — повод перечитать его внимательно.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Шаг 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Шаг 5. Собрать пакет документов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Пакет документов на ребенка лучше начать собирать за 3–4 недели до смены — в пик сезона педиатры загружены и записи может не быть. Вот какие бумаги нужны почти всем организаторам:
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка по форме 079у</strong> — для загородной смены. Оформляется педиатром, действует 90 дней. Нужна запись об отсутствии контакта с инфекционными больными.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис ОМС</strong> — оригинал. Без него заселение невозможно физически.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Свидетельство о рождении</strong> (до 14 лет) или <strong>паспорт</strong> (после 14 лет).</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
