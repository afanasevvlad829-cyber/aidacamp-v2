---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';

const relatedPages = [
  { title: "Проблемы в общении подростков", url: "/stati/problemy-v-obschenii-podrostkov/", icon: "chat", description: "Почему замкнулся и как помочь" },
  { title: "Подросток не хочет учиться", url: "/stati/podrostok-ne-hochet-uchitsya/", icon: "book", description: "Связанная тема — мотивация" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Среда где получают опыт успеха" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];
---

<Base
  title="Низкая самооценка у ребёнка — почему так и 5 способов помочь дома"
  description="«Я не умею», «у меня не получится» — откуда это берётся и что реально работает. 5 способов поднять самооценку ребёнка без психолога — от мамы к маме."
  ogImage="/images/hero/lager-dlya-podrostkov.avif"
>
  <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Низкая самооценка у ребёнка — 5 способов помочь без психолога | АйДаКемп",
      "description": "«Я неудачник», «у меня не получится» — 5 работающих способов поднять самооценку ребёнка. От мамы к маме: причины и что реально делает результат.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-01-25",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/nizkaya-samootsenka-u-rebenka"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как понять, что у ребёнка низкая самооценка?",
          "acceptedAnswer": { "@type": "Answer", "text": "Признаки: постоянное «я не могу», «у меня не получится», отказ пробовать новое, сравнение себя с другими не в свою пользу, болезненная реакция на критику. Часто сопровождается страхом ошибки." }
        },
        {
          "@type": "Question",
          "name": "Что реально помогает при низкой самооценке ребёнка?",
          "acceptedAnswer": { "@type": "Answer", "text": "Видимый успех в чём-то конкретном. Не похвала «ты молодец», а реальное достижение — написал игру, сделал проект, выступил перед другими. Ребёнок должен сам почувствовать «я это сделал»." }
        },
        {
          "@type": "Question",
          "name": "Помогает ли лагерь ребёнку с низкой самооценкой?",
          "acceptedAnswer": { "@type": "Answer", "text": "Часто — да. Новая среда без оценок класса, реальный проект, хакатон с защитой. Ребята, которые в школе стеснялись, в лагере открываются — потому что здесь они делают то, что сами выбрали." }
        },
        {
          "@type": "Question",
          "name": "Что говорить ребёнку с низкой самооценкой?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не «ты умный», а «я вижу как ты старался». Не «у тебя всё получится» (пустое обещание), а «в прошлый раз не вышло — давай разберём вместе почему». Конкретика и процесс работают лучше общих слов. И главное — не сравнивать с другими детьми никогда, даже в позитивную сторону." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли психолог при низкой самооценке ребёнка?",
          "acceptedAnswer": { "@type": "Answer", "text": "Если 3+ месяца вы применяете разные подходы и ничего не меняется, или если появились признаки депрессии (апатия, нарушения сна, мысли о себе в очень негативном ключе) — да, стоит обратиться к детскому психологу. Это нормально и правильно. Одна консультация даёт намного больше ясности, чем месяц самостоятельных попыток." }
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Низкая самооценка у ребёнка", "item": "https://aidacamp.ru/stati/nizkaya-samootsenka-u-rebenka/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Низкая самооценка у ребёнка: причины и способы помочь"
    subtitle="Причины и что реально помогает — без походов к психологу."
    imageBase="samootsenka"
    imageAlt="Группа детей за столом играют в настольную игру — лагерь даёт среду для роста уверенности"
    readTime="6 мин чтения"
    breadcrumbsLast="Низкая самооценка у ребёнка"
    daryaQuote="Моя дочь думала, что не справится с хакатоном. На защите сказала: «я не думала, что могу». Самооценка меняется не от слов, а от реального результата."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Я не смогу», «у меня ничего не получается», «зачем я пробую — всё равно провалю» — если вы слышите это от ребёнка 7-15 лет чаще чем один раз в неделю, и уже не понимаете что делать — вы не одни. Низкая самооценка у детей — массовая история, но справляться с ней можно своими силами. Объясняем как.
        </p>

        <StatCallout
          value="~50%"
          label="российских подростков сомневаются в собственных способностях в ключевых сферах."
          source="ВЦИОМ, опрос 2023"
          icon="chat-quote"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как проявляется низкая самооценка у ребёнка
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не все дети с низкой самооценкой тихие и скромные — некоторые ровно наоборот хвастаются и агрессивны. Это защитная реакция. Смотрим на реальные признаки:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Отказ пробовать что-то новое — из страха что «не получится»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Самокритика непропорциональная к ошибке — «я всё испортил», «я всегда так»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Сравнивает себя с другими детьми в негативную сторону — «а Вася лучше меня»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Перфекционизм — переделывает 10 раз одно и то же, боится сдавать работу</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Защитная агрессия или хвастовство — «у меня лучший телефон», «я всё знаю»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Избегает лидерских ролей — «нет, пусть кто-то другой»</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Плохо переносит критику — слёзы или срыв даже от мелкого замечания</span></li>
        </ul>
      </div>

        <StatCallout
          value="100+"
          label="раз в день подросток сравнивает себя со сверстниками в соцсетях."
          source="Pew Research, 2024"
          icon="phone"
          tone="neutral"
        />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Причины — откуда это берётся
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Родительская критика больше похвалы.</strong> Считайте: за день сколько раз вы сказали что-то критическое и сколько похвалили. Норма — 1 к 3. Если наоборот — ребёнок слышит «ты плохой» в 3 раза чаще чем «ты молодец».</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Сравнения с другими детьми.</strong> «А Петя уже читает…», «Маша же умеет…» — даже если говорите в позитивном ключе, ребёнок слышит что он не соответствует.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Перфекционизм в семье.</strong> Если вы сами не прощаете себе ошибок, ребёнок копирует это. Каждая «плохая» оценка становится катастрофой.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Отсутствие «своего» успеха.</strong> У школьника нет деятельности где он объективно хорош и это видят другие. Все хвалят «за обучение», но пятёрки не работают — это норма, а не достижение.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Буллинг в школе или классе.</strong> Может быть неочевидным — никто не бьёт, но «не принимают», смеются за спиной. Проверяется прямым разговором с учителем.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Соцсети и образ «идеальных сверстников».</strong> Подростки видят в инстаграме только успехи друзей — и верят что у всех так. Свою обычную жизнь считают провальной.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5 способов поднять самооценку ребёнка
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>1. Хвалить за процесс, не за результат.</strong> Вместо «какой ты умный, пятёрку получил» — «я видела как ты готовился, молодец что не сдался». Результат может не получиться, процесс — всегда в руках ребёнка. Хвалите именно его.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>2. Дать свою область в которой он лучший.</strong> Не обязательно математика или спорт. Может быть Minecraft-моды, графика, пекарня печенья, настолки — что угодно. Важно чтобы в этой области он был лучше вас и мог учить вас. Это меняет самовосприятие.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>3. Внешнее признание от значимых взрослых.</strong> Учитель, тренер, вожатый — если они заметили ребёнка и похвалили, это действует в разы сильнее чем слова родителя. Организуйте ребёнку попадание в место где с ним занимаются внимательно — репетитор, хороший кружок, <a href="/ceny/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">выездной лагерь этим летом</a>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>4. Разрешить ошибаться.</strong> Покажите на своём примере что вы ошибаетесь — и ничего страшного. Разбейте чашку, ошибитесь в рецепте, проиграйте в настолке — проговорите «ну ок, буваем, давай попробуем ещё». Ребёнок копирует вашу реакцию на свои ошибки в будущем.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>5. Видимый конкретный результат, который можно показать.</strong> Рисунок, проект, поделка, код игры, испечённое печенье — что-то физическое или цифровое. Хранить, фотографировать, показывать бабушке. Это внешняя фиксация «я создал это», которая долго держит самооценку.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что говорить и что не говорить ребёнку
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Слова важны. Некоторые фразы которые кажутся поддерживающими — на деле усиливают тревогу. Быстрая шпаргалка:
        </p>
        <div class="space-y-3 mb-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="border border-red-200 rounded-xl p-4 bg-red-50">
              <p class="text-base font-semibold text-red-700 mb-2">
                <i class="bi bi-x-lg me-1" aria-hidden="true"></i>
                Не работает
              </p>
              <ul class="flex flex-col gap-2">
                <li class="text-base text-slate-700">«Ты такой умный, у тебя всё получится»</li>
                <li class="text-base text-slate-700">«Посмотри как Маша/Петя справляется»</li>
                <li class="text-base text-slate-700">«Ну что за нытьё, всё нормально»</li>
                <li class="text-base text-slate-700">«Не выдумывай, ты же умный»</li>
              </ul>
            </div>
            <div class="border border-green-200 rounded-xl p-4 bg-green-50">
              <p class="text-base font-semibold text-green-700 mb-2">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                Работает
              </p>
              <ul class="flex flex-col gap-2">
                <li class="text-base text-slate-700">«Я вижу как ты старался — это важно»</li>
                <li class="text-base text-slate-700">«В прошлый раз не вышло — давай разберём почему»</li>
                <li class="text-base text-slate-700">«Я сама иногда ошибаюсь — и ничего, продолжаю»</li>
                <li class="text-base text-slate-700">«Что тебе нужно чтобы попробовать ещё раз?»</li>
              </ul>
            </div>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Главное правило: конкретика и процесс вместо общих оценок. «Ты молодец» не работает — ребёнок не понимает за что. «Ты придумал идею, которой раньше не было» — работает.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда нужен психолог
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если 3+ месяцев применяете эти 5 способов и ничего не меняется, или если появились признаки депрессии (апатия, упадок сил, нарушения сна, еда или мысли о себе в негативном ключе сильнее обычного) — это повод идти к детскому психологу. Одна консультация стоит 4-8 тыс. ₽, обычно достаточно 3-5 встреч. Это нормально и не стыдно. Стыдно — ждать и игнорировать.
        </p>
      </div>

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {[
            { q: "Что говорить ребёнку с низкой самооценкой?", a: "Не «ты умный», а «я вижу как ты старался». Не «у тебя всё получится» (пустое обещание), а «в прошлый раз не вышло — давай разберём вместе почему». Конкретика и процесс работают лучше общих слов. И главное — не сравнивать с другими ребятами никогда, даже в позитивную сторону." },
            { q: "Помогает ли лагерь ребёнку с низкой самооценкой?", a: "Часто — да. Новая среда без оценок класса, реальный проект, хакатон с защитой. Ребята, которые в школе стеснялись, в лагере открываются — потому что здесь они делают то, что сами выбрали." },
            { q: "Нужен ли психолог при низкой самооценке?", a: "Если 3+ месяца ничего не меняется или появились признаки депрессии — да. Это нормально и правильно. Одна консультация даёт намного больше ясности, чем месяц самостоятельных попыток." }
          ].map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.q}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

