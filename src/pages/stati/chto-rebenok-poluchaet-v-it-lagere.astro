---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop", description: "Программирование + летний отдых" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
  { title: "Детский лагерь", url: "/detskiy-lager", icon: "house", description: "О лагере подробнее" },
  { title: "IT-лагерь или кружок", url: "/stati/it-lager-vs-kruzhok", icon: "arrow-left-right", description: "Сравниваем форматы обучения" },
];

const faqItems = [
  {
    question: "Что конкретно узнает ребёнок за 2 недели в IT-лагере?",
    answer: "Конкретные навыки зависят от программы и уровня ребёнка. За 2 недели большинство детей освоят: основы выбранного языка программирования (Python, JavaScript или другой), принципы алгоритмического мышления, работу с готовыми библиотеками для своей задачи. Главное — ребёнок не просто «читает про код», а пишет реальный код и видит результат. К концу смены у каждого есть работающий проект, который он может показать семье и друзьям."
  },
  {
    question: "Какой проект сделает ребёнок в лагере?",
    answer: "В АйДаКемп каждый ребёнок самостоятельно выбирает направление проекта в начале смены. Чаще всего дети делают: простые 2D-игры (платформеры, аркады), телеграм-ботов с командами и ответами, веб-сайты с интерактивными элементами, небольшие мобильные приложения. На финальном хакатоне они презентуют проект перед всей сменой — это настоящая защита, как у взрослых разработчиков."
  },
  {
    question: "Подойдёт ли лагерь ребёнку без опыта в программировании?",
    answer: "Да, и это один из самых частых запросов. Около 70% детей приезжают без какого-либо опыта — и это нормально. Программы в АйДаКемп строятся от нуля: педагоги умеют объяснять с самого начала, без предположений об уже имеющихся знаниях. Единственное условие — базовая уверенность в работе с компьютером (набирать текст, пользоваться браузером). Этого достаточно."
  },
  {
    question: "Как закрепить результат лагеря дома?",
    answer: "Три работающих способа. Первый — поддержите ребёнка в продолжении своего проекта: задайте вопрос «что ты хочешь добавить?» — и дайте время. Второй — подпишите на кружок программирования или дайте доступ к онлайн-платформе, пока мотивация высокая. Третий — найдите ребёнку единомышленников: Telegram-чат выпускников лагеря живёт весь год, там общаются, помогают друг другу и делятся проектами."
  },
  {
    question: "Почему дети хотят вернуться в лагерь второй раз?",
    answer: "Потому что лагерь — это не только программирование. Это лето, друзья, азарт соревнований и ощущение «я могу». Дети возвращаются за знакомыми педагогами, которых уже знают и которым доверяют. За ровесниками с похожими интересами — некоторые дружат годами после лагеря. За новым уровнем программы — каждый год усложняется и открывает новые направления. И просто потому что было хорошо."
  }
];
---

<Base
  title="Что ребёнок получает в IT-лагере — результат за 2 недели"
  description="Конкретные результаты детей после IT-лагеря АйДаКемп: навыки, проекты, новые друзья, уверенность. Отзывы мам и реальные истории детей."
  ogImage="/images/articles/ii-programmista-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/chto-rebenok-poluchaet-v-it-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Что ребёнок получает в IT-лагере — результат за 2 недели от родителей",
        "description": "Конкретные результаты детей после IT-лагеря АйДаКемп: навыки, проекты, новые друзья, уверенность. Отзывы мам и реальные истории детей.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-03",
        "dateModified": "2026-05-03",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/chto-rebenok-poluchaet-v-it-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что ребёнок получает в IT-лагере"
    subtitle="Конкретные результаты за 2 недели — рассказываем честно, от мамы к маме."
    breadcrumb={[
      { label: "Главная", href: "/" },
      { label: "Статьи", href: "/stati" },
      { label: "Что ребёнок получает в IT-лагере", href: "" }
    ]}
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Что ребёнок получает в IT-лагере — один из главных вопросов, который я слышу
          от мам перед записью. Понять это непросто: обещать можно что угодно,
          а хочется знать про конкретный результат. Собрала честный ответ — не рекламный,
          а из реальных историй детей и мам, которые уже прошли через АйДаКемп.
        </p>
      </div>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Конкретные технические навыки</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          За 2 недели интенсивной работы дети осваивают реальный язык программирования —
          не «основы основ из учебника», а рабочий инструмент. В зависимости от программы
          это Python, JavaScript, разработка игр на Unity или веб-технологии.
          После смены ребёнок понимает синтаксис, умеет читать чужой код и исправлять
          ошибки — это уже уровень джуниора.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Важнее конкретного языка — алгоритмическое мышление. Умение разбить задачу
          на шаги, найти логическую ошибку, придумать более простое решение.
          Это навык, который работает и в программировании, и в математике, и в жизни.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          На финальном хакатоне каждый ребёнок защищает проект. Это работающий продукт,
          написанный самостоятельно. Мамы часто удивляются — не ожидали, что за 2 недели
          можно сделать что-то настоящее.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Уверенность в себе — это не банальность</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Это то, что мамы замечают первым, когда забирают детей. Не знания,
          а изменившийся взгляд. Ребёнок, который раньше говорил «у меня не получится»,
          теперь сам объясняет маме, как работает его программа. Это другое —
          это ощущение себя как человека, который умеет создавать.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Уверенность в IT-лагере рождается не из похвалы педагогов, а из конкретного
          опыта: «я написал код — он работает». Это честная уверенность, не накрученная.
          И она переносится за пределы программирования — дети начинают иначе
          относиться к трудностям в других областях.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Особенно заметно у детей, которые приезжали с тревожностью или «боялись ошибиться».
          Программирование учит: ошибка — это часть процесса, а не катастрофа. Запустил —
          не работает — исправил — работает. Этот цикл формирует резильентность,
          и это ценнее любого сертификата.
        </p>
      </section>

      <StatCallout
        stat="9 из 10"
        label="детей хотят вернуться в АйДаКемп на следующее лето"
        description="По опросу родителей после смены 2025 года."
      />

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Новые друзья с теми же интересами</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Это недооценённый результат, но мамы называют его одним из самых важных.
          Многие дети приезжают, не имея в школьном окружении никого,
          кому интересны технологии. В лагере они впервые оказываются среди людей,
          с которыми можно говорить о коде, играх и проектах и не быть «белой вороной».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          После смены дети продолжают общаться — в Telegram-чате, в совместных онлайн-проектах,
          в играх. Некоторые дружат годами. Для ребёнка, которому не хватало «своих»,
          это может быть важнее любого технического навыка.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Социальная среда лагеря работает и на мотивацию: видя, что ровесник уже умеет делать
          сложные вещи, ребёнок хочет тоже. Не из зависти — из азарта. Конкуренция
          в лагере здоровая, потому что все на одной стороне и помогают друг другу.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Что говорят мамы после лагеря</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          «Сын вернулся и сразу попросил купить книгу по Python — первый раз сам
          попросил учебник» — мама Артёма, 11 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          «Дочь показывала свой проект всем подругам — вот этот вот сайт я сделала
          сама, за неделю. Мы были в шоке» — мама Насти, 13 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          «Он поехал с большим скептицизмом — не хотел, говорил что скучно.
          Уже на третий день написал: мама, тут очень круто. И приехал совсем другим.
          Теперь каждый день что-то программирует» — мама Даниила, 12 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Моя дочь тоже была «той самой» скептиком. Сейчас она объясняет мне,
          что такое рекурсия. Я этим горжусь — и рада, что мы рискнули.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-8">
        <h2 class="text-2xl font-bold mb-6">Частые вопросы</h2>
        <div itemscope itemtype="https://schema.org/FAQPage">
          {faqItems.map(item => (
            <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="mb-6">
              <h3 itemprop="name" class="text-lg font-semibold mb-2">{item.question}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p itemprop="text" class="text-gray-700">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <ArticleBottomCta />
    </article>
  </main>

  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
