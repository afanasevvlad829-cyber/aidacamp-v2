---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove", icon: "tree", description: "66 км от Москвы, Наро-Фоминск" },
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove", icon: "houses", description: "Проживание, питание" },
  { title: "Лагерь из Москвы", url: "/lager-v-moskve", icon: "geo-alt", description: "Ближнее Подмосковье" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Стоимость смен" },
];
---

<Base
  title="Детский лагерь рядом с Подольском 2026 — IT-программа"
  description="Детский IT-лагерь рядом с Подольском: 55 км, Python, AI, Minecraft. Смены 2026 от 48 000 ₽. Трансфер от метро, бассейн, хакатон."
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-podolsk" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Детский лагерь рядом с Подольском — IT-смены 2026",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/lager-podolsk"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детский лагерь рядом с Подольском — IT-смены 2026"
    subtitle="АйДаКемп — 55 км от Подольска. Python, AI, Minecraft, бассейн. Трансфер через партнёра по запросу от метро Солнцево."
    imageBase="kuda-letom"
    imageAlt="Дети на IT-смене в подмосковном лагере"
    readTime="4 мин чтения"
    breadcrumbsLast="Лагерь рядом с Подольском"
    daryaQuote="Мы из Подольска и я долго искала IT-лагерь недалеко от дома. 55 километров — это меньше часа на машине. Дочь сначала не хотела ехать, а потом не хотела возвращаться."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы живёте в Подольске и ищете IT-лагерь для ребёнка — необязательно ехать в Москву или далеко в область. АйДаКемп находится в Наро-Фоминском округе, примерно в 55 км от Подольска. Расскажем конкретно: как добраться, что входит в программу, сколько стоит.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">АйДаКемп — IT-лагерь в 55 км от Подольска</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь расположен на базе санатория «Изумруд» в Наро-Фоминском городском округе Московской области. Это живописное место в лесу — не городская атмосфера, при этом недалеко от дома.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Расстояние от центра Подольска — около 55 км по маршруту через А-101. На машине это примерно 50–60 минут в нормальных дорожных условиях. Трансфер — через партнёра по запросу от метро Солнцево.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Как добраться из Подольска</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>На машине:</strong> из Подольска — по Серпуховскому шоссе в сторону Москвы, затем на Московское шоссе (А-101) в направлении Наро-Фоминска. Время в пути — около часа без пробок.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Трансфер через партнёра по запросу:</strong> из Подольска удобнее всего доехать до метро «Солнцево» (автобус или электричка до Москвы, затем метро). Трансфер от «Солнцево» организуется через партнёра — оформляется при бронировании, стоимость уточняйте у менеджера.
        </p>
        <StatCallout
          value="~55 км"
          label="от Подольска до АйДаКемп. Один трансфер или час на машине"
          source="Маршрут А-101"
          icon="geo-alt"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">IT-программа лагеря</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый выбирает трек в зависимости от возраста и интересов:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-braces text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Python</strong> — для детей 10–15 лет. Программирование с нуля до первой игры или бота</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-cpu text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>AI и нейросети</strong> — для 11–15 лет. Как работает искусственный интеллект, практические задачи</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-globe text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Scratch и Roblox</strong> — для детей 7–10 лет. Визуальное программирование и создание игр</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-lightning-charge text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Minecraft с основами кодинга</strong> — для всех возрастов. Строительство и первые шаги в программировании</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Группы до 8 человек — каждый ребёнок получает внимание преподавателя, не теряется в толпе.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Территория: бассейн и спорт</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь расположен на территории санатория с полноценной инфраструктурой. Есть бассейн, спортивные площадки, лесные прогулки. IT — это главное, но ребята проводят время не только за компьютером.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          День устроен так: утром — учёба, после обеда — спорт, вечером — командные активности. Никто не сидит в комнате 24 часа.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Смены 2026 и цены</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смены проходят с конца мая по август. Стоимость — от 48 000 ₽ за двухнедельную смену. В цену входит: проживание, питание 5 раз в день, IT-программа, страховка. Трансфер — через партнёра по запросу.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Места ограничены: группы маленькие, набор закрывается заранее. Родители из Подольска бронируют обычно в феврале-марте.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Почему это лучший вариант рядом с Подольском</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный лагерь с лицензией РТО. Медик работает круглосуточно. В конце смены — хакатон: каждый защищает собственный проект перед командой. Уезжают не просто с новыми знакомыми, а с готовой игрой или ботом.
        </p>
        <StatCallout
          value="5.0"
          label="— рейтинг АйДаКемп на Яндекс.Картах. 40+ отзывов от родителей из Подольска и всего Подмосковья"
          source="Яндекс.Карты, 2026"
          icon="stars"
          tone="neutral"
        />
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Забронировать смену из Подольска"
    bookingSubtitle="Трансфер через партнёра по запросу от метро Солнцево. Смены с мая по август 2026."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
