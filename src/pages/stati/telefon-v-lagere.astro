---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-vibrate", description: "Как устроено экранное время в АйДаКемп" },
  { title: "Игромания у детей", url: "/stati/igromaniya-u-detej", icon: "controller", description: "Признаки и что с этим делать" },
  { title: "Экранное время: нормы", url: "/stati/ekrannoe-vremya-detej-norma", icon: "clock-history", description: "Сколько экранного времени норма" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Можно ли взять телефон в АйДаКемп?",
    answer: "Да, телефон брать можно и нужно — для связи с родителями. При заезде телефон сдаётся в специальный бокс на хранение. Ребята зарабатывают «экранное время» за активность и задания, потом сами решают когда его использовать. Это не наказание — это часть формата лагеря."
  },
  {
    question: "Как мне позвонить ребёнку в лагере?",
    answer: "Каждый день в Telegram-группе для родителей публикуются фото и короткое видео из жизни отряда. Ребёнок может позвонить через бокс с телефоном — для этого достаточно попросить вожатого. Экстренная связь — всегда, без ограничений."
  },
  {
    question: "Что говорят дети про отсутствие телефона?",
    answer: "В первые день-два бывает дискомфорт — привычка. Потом большинство перестаёт думать о телефоне: слишком много всего происходит. По нашей статистике, около 60% детей сами говорят родителям, что телефон не был нужен. Многие возвращаются домой и продолжают общаться с новыми друзьями вживую."
  },
  {
    question: "А если ребёнок не сдаст телефон — что будет?",
    answer: "Никакого наказания нет. Вожатые объясняют формат до заезда — родители и ребёнок знают заранее. При заезде телефон сдаётся добровольно. Если ребёнок категорически против — можно договориться об индивидуальном расписании. Но практика показывает: через сутки большинство сами рады были сдать."
  }
];
---

<Base
  title="Телефон в детском лагере — брать или нет? Мнение родителей и вожатых"
  description="Честный разбор: телефон в лагере брать, не брать или сдать? Аргументы за и против, как устроено в АйДаКемп, что говорят родители после смены."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/telefon-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Телефон в детском лагере — брать или нет? Мнение родителей и вожатых",
        "description": "Честный разбор: телефон в лагере брать, не брать или сдать? Аргументы за и против, как устроено в АйДаКемп, что говорят родители после смены.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/telefon-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Телефон в лагере: брать, не брать или сдать? Честный разбор"
    subtitle="Разбираем аргументы с обеих сторон и рассказываем, как это работает в АйДаКемп."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети в лагере общаются вживую без телефонов"
    readTime="5 мин чтения"
    breadcrumbsLast="Телефон в лагере"
    daryaQuote="У дочери был страх: «Мама, а вдруг скучно без телефона?» Через два дня она написала мне из бокса: «Мам, здесь некогда скучать». Это всё, что нужно знать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Телефон в лагерь — один из самых болезненных вопросов для родителей. Взять — не отпустит от соцсетей. Не взять — как он будет без связи? Мы разобрали оба аргумента честно, без педагогических нотаций.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Аргументы «взять телефон»
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Связь с родителями</span>
              <p class="text-[15px] text-slate-600 mt-1">Ребёнок может позвонить если плохо, страшно или просто захотел услышать голос. Это реальная безопасность — психологическая.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Доступ к музыке и книгам</span>
              <p class="text-[15px] text-slate-600 mt-1">В свободное время — слушать плейлист или читать без интернет-зависимости. Не все дети хотят только играть в настолки.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Фотографировать воспоминания</span>
              <p class="text-[15px] text-slate-600 mt-1">Дети хотят фотать смешные моменты с друзьями. Это нормально — это часть их социализации.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Аргументы «не брать» или «сдать»
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Телефон мешает включиться в жизнь лагеря</span>
              <p class="text-[15px] text-slate-600 mt-1">Ребёнок с телефоном остаётся в своём привычном цифровом пузыре. Соцсети, игры, ютуб — всё это не даёт переключиться и познакомиться с людьми рядом.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Создаёт неравенство в отряде</span>
              <p class="text-[15px] text-slate-600 mt-1">Один ребёнок снимает ролики, другой без телефона наблюдает. Это реальный источник обид и конфликтов внутри группы.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Постоянный контакт с родителями мешает адаптации</span>
              <p class="text-[15px] text-slate-600 mt-1">Ребёнок звонит маме каждые два часа — мама переживает, ребёнок не включается в лагерную жизнь. Это не вина никого: просто телефон убирает необходимость адаптироваться самостоятельно.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Риск потери или кражи</span>
              <p class="text-[15px] text-slate-600 mt-1">Дорогой флагман в общей спальне — это всегда риск. И потеря настроения на несколько дней у всех.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроено в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы нашли третий путь — между «можно всё» и «запрещено всё». Телефоны принимаются при заезде и хранятся в специальных боксах у вожатых. Это не конфискация — это хранение. Ребёнок знает, где его телефон и что он цел.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дальше работает система «экранного времени»: за активность на занятиях, за помощь другу, за участие в командных играх дети получают внутреннюю валюту лагеря — «айдакоины». На них можно купить время с телефоном: 30 минут, час, два часа. Они сами решают когда и сколько.
        </p>

        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4 my-6">
          <i class="bi bi-info-circle text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-[15px] font-bold text-slate-900 mb-1">Что говорят родители после смены</div>
            <div class="text-[14px] text-slate-700 leading-[1.6]">
              «Я боялась что дочь будет скучать без телефона. Но каждый день в Telegram-группе были фото — она там смеётся, делает что-то с друзьями. Когда забрала её — она не просила сразу же телефон. Для меня это было что-то новое». <span class="text-slate-500">— Марина, мама участницы смены 2025</span>
            </div>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подробнее о том, как работает формат без телефонов — на странице <a href="/lager-bez-telefonov" class="text-[#ec7c00] font-semibold hover:underline">«Лагерь без телефонов»</a>.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что взять вместо дорогого телефона
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если всё-таки берёте телефон — возьмите простой запасной, не флагман. Поцарапать, уронить, перепутать с чужим — риски реальные. Дорогой телефон в общей спальне — это постоянная тревога для ребёнка, которая мешает расслабиться.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошая альтернатива — электронная книга или старый телефон только для музыки, без sim-карты. Тогда и волков сытых нет, и овец целых тоже.
        </p>
      </div>

      <BlogCTA variant="addiction" />

      <!-- FAQ -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-[#ec7c00] rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Интересует формат лагеря без телефонов?"
    bookingSubtitle="Расскажем подробнее как работает система экранного времени и что говорят родители."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.add('hidden');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
