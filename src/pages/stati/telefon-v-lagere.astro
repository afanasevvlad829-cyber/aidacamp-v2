---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Формат без гаджетов", url: "/lager-bez-telefonov/", icon: "phone-vibrate", description: "Как устроено экранное время в АйДаКемп" },
  { title: "Игромания у детей", url: "/stati/igromaniya-u-detej/", icon: "controller", description: "Признаки и что с этим делать" },
  { title: "Экранное время: нормы", url: "/stati/ekrannoe-vremya-detej-norma/", icon: "clock-history", description: "Сколько экранного времени норма" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Можно ли взять телефон в АйДаКемп?",
    answer: "Да, брать можно и нужно — для связи с родителями. При заезде гаджет сдаётся в бокс на хранение, а ребёнок зарабатывает «экранное время» за активность и сам решает, когда его потратить. Это не наказание, а часть формата лагеря."
  },
  {
    question: "Как мне позвонить ребёнку на смене?",
    answer: "Каждый день в Telegram-группе — фото и видео из жизни отряда. Ребёнок может позвонить через бокс: достаточно попросить вожатого. Экстренная связь — всегда, без ограничений."
  },
  {
    question: "Что говорят дети про отсутствие телефона?",
    answer: "Первые день-два бывает дискомфорт — привычка. Дальше большинство перестаёт о нём думать: слишком много всего происходит. По нашей статистике, около 60% ребят сами говорят, что мобильный был не нужен."
  },
  {
    question: "А если ребёнок не сдаст телефон — что будет?",
    answer: "Никакого наказания нет. Вожатые объясняют формат ещё до заезда, сдача добровольная. Если ребёнок категорически против — можно договориться индивидуально. Но обычно уже на второй день большинство сдают сами."
  },
  {
    question: "Почему система покупки экранного времени работает лучше запрета?",
    answer: "Запрет — это борьба, а покупка — игра. Ребёнок, который сам заработал рубли и сам решил их потратить, чувствует контроль над своим временем. Многие копят рубли на «марафон» в последний вечер — это их осознанный выбор."
  },
  {
    question: "Как работает Telegram-канал для родителей?",
    answer: "Каждый день вожатые публикуют фото и видео из жизни отряда — обычные моменты: занятие, обед, вечерняя игра. Мамы, которые смотрят канал, звонят реже и спокойнее — видят, что всё хорошо."
  }
];
---

<Base
  title="Забирают ли телефон у ребёнка в детском лагере? Мнение родителей"
  description="Честный разбор: брать ли ребёнку телефон в лагерь , и что значит «сдать»? Аргументы за и против, как устроено в АйДаКемп, что говорят родители после смены."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Телефон в детском лагере — брать или нет? Мнение родителей и вожатых",
        "description": "Честный разбор: телефон в лагере брать, не брать или сдать? Аргументы за и против, как устроено в АйДаКемп, что говорят родители после смены.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/telefon-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Телефон ребёнку в лагере : брать, не брать или сдать?"
    subtitle="Разбираем аргументы с обеих сторон и рассказываем, как это работает в АйДаКемп."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети в лагере общаются вживую без телефонов"
    readTime="5 мин чтения"
    breadcrumbsLast="Брать или сдать"
    daryaQuote="У дочери был страх: «Мама, а вдруг скучно без гаджета?» Через два дня она написала мне из бокса: «Мам, здесь некогда скучать». Это всё, что нужно знать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Брать телефон в лагерь или нет — вопрос, от которого голова идёт кругом: оставишь дома, а вдруг не дозвонишься, если что-то случится? Дашь с собой — и всё лето мобильный не выпустит его из соцсетей. Мы честно разобрали оба аргумента, без нотаций.
         Спокойнее, когда правило про гаджет понятно заранее: это не запретная вещь, а обычный пункт в списке сборов ребенку — вожатый просто следит, чтобы мобильник не съедал смену.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Аргументы «взять с собой»
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Связь с родителями</span>
              <p class="text-base text-slate-600 mt-1">Ребёнок может позвонить, если плохо, страшно или просто захотелось услышать голос, — это реальная психологическая безопасность.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Доступ к музыке и книгам</span>
              <p class="text-base text-slate-600 mt-1">В свободное время — слушать плейлист или читать. Не все хотят играть только в настолки.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-check-circle-fill text-green-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Фотографировать воспоминания</span>
              <p class="text-base text-slate-600 mt-1">Хочется фотать смешные моменты с друзьями — это нормальная часть социализации.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Аргументы «не брать» или «сдать»
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Гаджеты мешают включиться в жизнь лагеря</span>
              <p class="text-base text-slate-600 mt-1">Ребёнок остаётся в привычном цифровом пузыре — соцсети, игры, ютуб не дают переключиться и познакомиться с людьми рядом.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Создаёт неравенство в отряде</span>
              <p class="text-base text-slate-600 mt-1">Один ребёнок снимает ролики, другой без гаджета наблюдает — реальный источник обид и конфликтов внутри группы.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Постоянный контакт с родителями мешает адаптации</span>
              <p class="text-base text-slate-600 mt-1">Ребёнок звонит маме каждые два часа и не включается в жизнь отряда — гаджет убирает необходимость адаптироваться самостоятельно.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <div>
              <span class="text-[16px] font-semibold text-slate-800">Риск потери или кражи</span>
              <p class="text-base text-slate-600 mt-1">Дорогой флагман в общей спальне — всегда риск, а с ним и потеря настроения на несколько дней.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроено в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы нашли средний путь — не «всё можно» и не «всё нельзя». Гаджеты у нас не запрещены совсем: при заезде гаджет сдаётся в именной бокс у вожатых, это не конфискация, а хранение, как в раздевалке. Дальше работает «осознанное экранное время» — вот как это устроено по шагам:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">1</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>При заезде</strong> — в именной бокс, на хранение. Ребёнок знает, где его вещи и что всё цело.</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">2</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Зарабатывают внутреннюю валюту смены</strong> (игровые рубли, не настоящие деньги) за активность: участие в занятии, помощь в команде, победа в игре.</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">3</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>На рубли покупают экранное время</strong>: 30 минут, час, блок на вечер — сами решают, когда и на что потратить.</p>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-base font-bold text-orange-600">4</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600"><strong>Экстренная связь</strong> — без ограничений, всегда. Попросил вожатого — получил его, позвонил маме.</p>
          </div>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4 my-6">
          <i class="bi bi-info-circle text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Что говорят родители после смены</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              «Я боялась что дочь будет скучать без телефона. Но каждый день в Telegram-группе были фото — она там смеётся, делает что-то с друзьями. Когда забрала её — она не просила его сразу же». <span class="text-slate-500">— Марина, мама участницы смены 2025</span>
            </div>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подробнее — на странице <a href="/lager-bez-telefonov/" class="text-primary font-semibold hover:underline">«Лагерь без телефонов»</a>.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что взять вместо дорогого флагмана
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если всё-таки берёте с собой — возьмите простой запасной аппарат, не флагман: поцарапать, уронить, перепутать с чужим в общей спальне — риски реальные, а дорогая вещь только добавляет тревоги. Хорошая альтернатива — электронная книга или старый смартфон только для музыки, без sim-карты.
        </p>
      </div>

      <BlogCTA variant="addiction" />

      <!-- FAQ -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Интересует формат смены без гаджетов?"
    bookingSubtitle="Расскажем подробнее как работает система экранного времени и что говорят родители."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
