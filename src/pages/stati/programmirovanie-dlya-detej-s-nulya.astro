---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "keyboard", description: "От нуля до проекта" },
  { title: "Лагерь Python", url: "/python-lager/", icon: "code-slash", description: "Python с нуля" },
  { title: "Лагерь Scratch", url: "/scratch-lager/", icon: "blocks", description: "Старт с 7 лет" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "С какого возраста учить ребёнка программированию?",
    answer: "С 7 лет — Scratch: визуальные блоки, никакого синтаксиса, результат сразу. С 10 лет — Python или Roblox/Lua: настоящий код, первые боты и игры. С 10-12 лет — можно добавить AI-инструменты. Нет смысла торопить — главное попасть в правильный инструмент для возраста, а не форсировать взрослый подход."
  },
  {
    question: "Сколько времени нужно, чтобы ребёнок написал первую программу?",
    answer: "В лагере — первый день. Буквально. Scratch позволяет сделать простую анимацию за 30 минут. Python — первый скрипт (например, «угадай число») за час. Это не значит, что ребёнок станет программистом за день — но первый успех случается быстро. Именно поэтому важна среда: в группе с педагогом это происходит, дома один на один с учебником — реже."
  },
  {
    question: "Какой язык программирования выбрать для начала?",
    answer: "Зависит от возраста и интереса ребёнка. 7-10 лет — Scratch, без вариантов: визуальный, без ошибок синтаксиса, сразу красивый результат. 10-13 лет — Python: самый читаемый язык, огромное комьюнити, применяется везде от ботов до AI. 8-13 лет и ребёнок играет в Roblox — Lua прямо в Roblox Studio: язык несложный, мотивация понятная. 10-15 лет и интересен AI — не язык, а промтинг и ChatGPT API."
  },
  {
    question: "Нужно ли специальное оборудование?",
    answer: "Нет. Для Scratch хватит любого браузера — работает онлайн на scratch.mit.edu без установки. Для Python достаточно любого ноутбука старше 5 лет — Replit работает в браузере. В АйДаКемп всё оборудование предоставляется: ноутбуки, периферия, интернет. Дома дополнительно ничего покупать не нужно."
  },
  {
    question: "Что ребёнок создаст за смену в лагере?",
    answer: "Зависит от трека: Python-трек — Telegram-бот или простая игра на pygame. Scratch-трек — анимация или мини-игра с собственными персонажами. Roblox-трек — своя карта или мини-игра внутри Roblox. AI-трек — чат-бот с ChatGPT API или AI-арт-проект. Все проекты защищаются публично на хакатоне в последний день смены — это отдельный опыт."
  },
  {
    question: "Как продолжить программирование после лагеря?",
    answer: "Scratch и Python полностью бесплатны — ребёнок может продолжать дома в тот же день. Scratch: scratch.mit.edu, проекты сохраняются в облаке. Python: Replit.com или установить VS Code + Python бесплатно. Из лагеря ребёнок уезжает с готовым проектом и ссылками на ресурсы. Хорошие следующие шаги: онлайн-секция раз в неделю, свой небольшой проект дома, следующая смена в лагере — уже с другого уровня."
  }
];
---

<Base
  title="Программирование для детей с нуля — с чего начать, какой язык"
  description="Scratch, Python или сразу AI? Пошаговый гид для родителей: с какого возраста, какой язык первый, онлайн или лагерь — и что ребёнок создаст уже в первый день."
  ogImage="/images/articles/ii-programmista-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Программирование для детей с нуля — как начать в любом возрасте",
        "description": "Программирование для детей с нуля: с чего начать, какой язык первый, онлайн или лагерь, что создают дети. Пошаговый путь для родителей.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-24",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/programmirovanie-dlya-detej-s-nulya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Программирование для детей с нуля", "item": "https://aidacamp.ru/stati/programmirovanie-dlya-detej-s-nulya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Программирование с нуля: путь от «ничего не умею» до первого проекта"
    subtitle="Как начать, в каком возрасте, какой язык первым — без теорий, только практика."
    imageBase="ii-programmista"
    imageAlt="Ребёнок учится программированию на ноутбуке"
    readTime="10 мин чтения"
    breadcrumbsLast="Программирование с нуля"
    daryaQuote="Дочь «не умела программировать» до лагеря. Это значит: никакого опыта вообще. За 2 недели она написала игру на Python. Нет никакой магии — просто правильная среда."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          «Он же не умеет программировать» — это не причина не начинать. Большинство детей приходят в IT с нулём знаний. И это нормально. Рассказываем, с чего начать, какой путь реалистичен по возрастам и почему среда важнее учебника.
        </p>

        <!-- Матрица: С чего начать по возрасту -->
        <div class="overflow-x-auto mb-2">
          <table class="w-full text-base border-collapse">
            <thead>
              <tr class="bg-orange-50">
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200 rounded-tl-lg">Возраст</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200">Язык / инструмент</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200">Что создаст</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200 rounded-tr-lg">Платформа</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-800 font-medium border border-slate-200">7–9 лет</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Scratch</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Анимацию, простую игру</td>
                <td class="px-4 py-3 border border-slate-200"><a href="https://scratch.mit.edu" target="_blank" rel="noopener" class="text-orange-600 underline underline-offset-2">scratch.mit.edu</a></td>
              </tr>
              <tr class="bg-slate-50 border-b border-slate-100">
                <td class="px-4 py-3 text-slate-800 font-medium border border-slate-200">10–12 лет</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Python</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Бота или мини-игру</td>
                <td class="px-4 py-3 border border-slate-200">VS Code / Replit</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-800 font-medium border border-slate-200">11–15 лет</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">AI-инструменты</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Бота с ChatGPT API</td>
                <td class="px-4 py-3 border border-slate-200">Браузер</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="px-4 py-3 text-slate-800 font-medium border border-slate-200 rounded-bl-lg">9–13 лет</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Roblox Studio</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Собственную карту</td>
                <td class="px-4 py-3 border border-slate-200 rounded-br-lg">Roblox</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-base text-slate-400 mb-2">Возрасты примерные — ориентируйтесь на интерес и темп ребёнка, не только на цифры.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Никакой базы — это нормально</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Программирование — это навык, а не талант. Не нужен «математический склад ума», не нужно с детства разбирать компьютеры. Нужны любопытство и желание что-то создать — это есть почти у каждого ребёнка, который любит игры.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Любой взрослый программист когда-то написал первую строчку кода. У детей это происходит быстрее — они не боятся ошибаться.
        </p>
        <StatCallout
          value="0 → проект"
          label="— столько опыта нужно ребёнку до лагеря. За 2 недели в АйДаКемп дети без опыта пишут первый настоящий проект"
          source="Опыт АйДаКемп, 2024-2025"
          icon="braces"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Дорожная карта по возрастам</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Разные возрасты — разный подход. Не нужно учить 7-летнего ребёнка тому, что подходит 13-летнему:
        </p>
        <ul class="list-none space-y-4 mb-4">
          <li class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <div class="flex items-center gap-2 mb-1">
              <i class="bi bi-lightbulb text-orange-500 shrink-0" aria-hidden="true"></i>
              <strong class="text-slate-800">7–9 лет — Scratch и визуальное программирование</strong>
            </div>
            <p class="ml-6">Блоки вместо кода. Ребёнок видит результат сразу — персонаж движется, звуки играют. Логика без синтаксиса.</p>
          </li>
          <li class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <div class="flex items-center gap-2 mb-1">
              <i class="bi bi-lightbulb text-orange-500 shrink-0" aria-hidden="true"></i>
              <strong class="text-slate-800">10–12 лет — Python базовый</strong>
            </div>
            <p class="ml-6">Первый «настоящий» язык. Простые программы, первые игры, основы логики. Python — читаемый и дружелюбный для новичков.</p>
          </li>
          <li class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <div class="flex items-center gap-2 mb-1">
              <i class="bi bi-lightbulb text-orange-500 shrink-0" aria-hidden="true"></i>
              <strong class="text-slate-800">12–15 лет — Python средний, боты, AI, веб</strong>
            </div>
            <p class="ml-6">Telegram-боты, работа с API нейросетей, основы веб-разработки. Уже видна связь с реальными проектами.</p>
          </li>
        </ul>
      </div>

      <!-- NEW: 4 пути в программирование -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">С чего начать: 4 пути в программирование</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Нет одного правильного первого шага — всё зависит от возраста и интереса ребёнка. Вот четыре рабочих пути:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">

          <!-- Scratch -->
          <div class="border border-slate-200 rounded-xl p-5">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
                <i class="bi bi-blocks text-orange-600 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[16px] font-bold text-slate-900 leading-tight">Scratch</p>
                <p class="text-base text-slate-500">Для детей 7–10 лет</p>
              </div>
            </div>
            <ul class="space-y-1.5 mb-0">
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Визуальные блоки — никакого синтаксиса</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Создаёт анимации и простые игры сразу</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Лучший старт для самых маленьких</span>
              </li>
            </ul>
          </div>

          <!-- Python -->
          <div class="border border-slate-200 rounded-xl p-5">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
                <i class="bi bi-code-slash text-blue-600 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[16px] font-bold text-slate-900 leading-tight">Python</p>
                <p class="text-base text-slate-500">Для детей 10–15 лет</p>
              </div>
            </div>
            <ul class="space-y-1.5 mb-0">
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-blue-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Настоящий текстовый код, читается почти как русский</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-blue-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Боты, автоматизация, математика</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-blue-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Самый популярный язык в мире</span>
              </li>
            </ul>
          </div>

          <!-- Roblox / Lua -->
          <div class="border border-slate-200 rounded-xl p-5">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0">
                <i class="bi bi-controller text-emerald-600 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[16px] font-bold text-slate-900 leading-tight">Roblox / Lua</p>
                <p class="text-base text-slate-500">Для детей 8–13 лет</p>
              </div>
            </div>
            <ul class="space-y-1.5 mb-0">
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Если ребёнок уже играет — сразу делает свои игры</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Язык Lua несложный, результат виден моментально</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Мотивация максимальная — делает то, во что играет</span>
              </li>
            </ul>
          </div>

          <!-- AI / нейросети -->
          <div class="border border-slate-200 rounded-xl p-5">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-purple-100 flex items-center justify-center shrink-0">
                <i class="bi bi-cpu text-purple-600 text-[16px]" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-[16px] font-bold text-slate-900 leading-tight">AI / нейросети</p>
                <p class="text-base text-slate-500">Для детей 10–15 лет</p>
              </div>
            </div>
            <ul class="space-y-1.5 mb-0">
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-purple-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Не писать код, а управлять AI-инструментами</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-purple-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>ChatGPT API, Kandinsky, практические проекты</span>
              </li>
              <li class="flex items-start gap-2 text-base leading-[1.6] text-slate-600">
                <i class="bi bi-check-lg text-purple-500 shrink-0 mt-0.5" aria-hidden="true"></i>
                <span>Навык управления AI — самый востребованный сейчас</span>
              </li>
            </ul>
          </div>

        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">С чего начать дома прямо сейчас</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Несколько ресурсов, которые работают без специальной подготовки:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>scratch.mit.edu</strong> — для детей 7+. Бесплатно, браузер, без установки. Визуальное программирование от MIT.</span>
          </li>
