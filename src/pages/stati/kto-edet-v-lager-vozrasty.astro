---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import VozrastyTents from '../../components/VozrastyTents.astro';
import VozrastyAnatomy from '../../components/VozrastyAnatomy.astro';
import VozrastySeason from '../../components/VozrastySeason.astro';
import VozrastyGirls from '../../components/VozrastyGirls.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const faqItems = [
  {
    question: "Моему 8 — не рано?",
    answer: "Не рано, но честно: у нас таких немного — около 5% смены (см. цифры выше), поэтому для них отдельная группа со своим темпом. Восьмилетки часто адаптируются быстрее подростков: у них ещё нет привычки к бесконечному телефону. Сомневаетесь — начните с короткой смены и следите за ежедневными фотоотчётами.",
  },
  {
    question: "Моему 14 — не поздно? Он уже сам всё решает",
    answer: "Каждый четвёртый ребёнок смены — 13+. И вот что показывают цифры: подростки интересуются лагерем сами, чаще любого другого возраста относительно своей доли. Если ваш подросток заговорил про лагерь — это он попросился. Такое желание встречается реже, чем кажется.",
  },
  {
    question: "Дочке будет некомфортно среди мальчишек?",
    answer: "Статистика возвращений говорит обратное: девочки возвращаются к нам втрое чаще. Группы делятся по возрасту и уровню, а не по полу — и девочка за Python'ом здесь никого не удивляет.",
  },
];

const relatedPages = [
  { title: "Какую смену выбрать? Инструкция для мамы, которая запуталась", url: "/stati/kakuyu-smenu-vybrat/", icon: "calendar-check", description: "Что правда меняется от смены к смене, а что нет" },
  { title: "Ребёнок первый раз едет в лагерь — страхи мамы и реальность", url: "/stati/pervyj-raz-v-lagere/", icon: "heart-pulse-fill", description: "Честные ответы на главные родительские тревоги" },
  { title: "Как подготовить ребёнка к лагерю: полный чеклист", url: "/stati/kak-podgotovit-k-lageryuu/", icon: "clipboard", description: "Чеклист подготовки за 4 недели" },
];
---

<Base
  title="Кто едет в IT-лагерь: честный расклад по возрастам | АйДаКемп"
  description="Честная статистика IT-лагеря АйДаКемп: какие возрасты интересуются лагерем, кто реально едет, как устроена типичная смена — по данным сезона-2026."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="kto-edet-v-lager-vozrasty"
      title="Кто едет в IT-лагерь: честный расклад по возрастам"
      description="Честная статистика IT-лагеря АйДаКемп: какие возрасты интересуются лагерем, кто реально едет, как устроена типичная смена — по данным сезона-2026."
      datePublished="2026-07-13"
    />
    <FAQSchema items={faqItems.map((f) => ({ q: f.question, a: f.answer }))} />
  </Fragment>
  <Header />

  <ArticleHero
    title="«А будут ли там ровесники моего?» Мы посчитали. Будут."
    subtitle="Родители спрашивают об этом чаще всего — и заслуженно: ребёнку в лагере хорошо тогда, когда вокруг свои. Вместо обещаний показываем настоящие расклады по возрастам: кто интересуется лагерем и кто реально приезжает."
    breadcrumbsLast="Возрасты в лагере"
    readTime="6 мин"
    icon="graph-up"
    iconLabel="Статистика сезона-2026"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Кто интересуется — и кто едет -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто интересуется — и кто едет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Слева в каждой паре — доля возраста среди запросов о лагере, справа — среди детей, реально приехавших в этом сезоне.
        </p>
        <VozrastyTents />
      </div>

      <!-- Анатомия типичной смены -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Анатомия типичной смены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Так выглядит возрастной состав полной смены. Внутри смены дети делятся на группы по возрасту и уровню — восьмилетка и девятиклассник не окажутся за одной задачей.
        </p>
        <VozrastyAnatomy />
      </div>

      <!-- Как устроено лето -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как устроено лето
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Сезон живёт двумя волнами: июньской — сразу после последнего звонка, и августовской — чтобы вернуть режим перед школой.
        </p>
        <VozrastySeason />
      </div>

      <!-- Отдельная история — девочки -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Отдельная история — девочки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Да, в IT-лагере мальчиков больше — примерно семь из восьми детей. Но самая красноречивая цифра не про долю, а про возвращения.
        </p>
        <VozrastyGirls />
      </div>

      <!-- CTA к смене 4 -->
      <a
        href="/shifts/shift-4/"
        class="group my-10 block no-underline rounded-[22px] bg-primary text-white p-7 md:p-9 text-center card-shadow hover:bg-primary-hover transition-colors"
        data-analytics-goal="blog_cta_click"
        data-analytics-label="vozrasty-shift4-cta"
      >
        <h2 class="text-white text-[20px] md:text-[24px] font-bold leading-[1.25] tracking-[-0.01em]">
          Последняя смена этого лета: 17–26 августа
        </h2>
        <p class="mt-3 text-[15px] md:text-[16px] text-white/90 leading-[1.6] max-w-[520px] mx-auto">
          10 дней, возраст 8–16, группы по возрасту и уровню. Проект, хакатон, защита перед залом — и сентябрь без раскачки.
        </p>
        <span class="mt-5 inline-flex items-center gap-1.5 rounded-xl bg-white px-6 py-3 text-primary font-bold text-[15px]">
          Посмотреть программу и места
          <i class="bi bi-arrow-right icon-arrow-right-hover" aria-hidden="true"></i>
        </span>
      </a>

      <!-- FAQ аккордеон -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые родительские сомнения — против нашей статистики
          </h2>
        </div>

        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="text-[13px] text-slate-400 leading-[1.6] mb-2">
        Все цифры — собственная статистика АйДаКемп по сезону-2026: запросы о лагере и реальные путёвки этого лета.
      </p>
      <!-- TODO: добавить ссылку на статью-дневник смены про «ночь с телефонами», когда она будет опубликована
           (поиск по слову «телефон» в заголовках /stati/ на 2026-07-13 такой статьи не нашёл). -->

    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />

  <script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
