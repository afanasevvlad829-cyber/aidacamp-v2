---
import { PRICE_MIN, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop", description: "Программирование + летний отдых" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
  { title: "Детский лагерь", url: "/detskiy-lager", icon: "house", description: "О лагере подробнее" },
  { title: "Что ребёнок получает в IT-лагере", url: "/stati/chto-rebenok-poluchaet-v-it-lagere", icon: "trophy-fill", description: "Конкретные результаты за 2 недели" },
];

const faqItems = [
  {
    question: "Что даёт IT-лагерь, чего не даёт кружок?",
    answer: "Три вещи: интенсивность, среда и полное погружение. На кружке ребёнок занимается 2 часа в неделю — в лагере по 4–6 часов каждый день в течение 2 недель. Но главное — это не только про время. В лагере ребёнок живёт в среде, где все вокруг увлечены программированием: за завтраком, на прогулке, поздно вечером. Такая среда формирует идентичность — ребёнок начинает думать о себе как о человеке, который умеет создавать. Этого не даст ни один кружок."
  },
  {
    question: "Лагерь дороже кружка — стоит ли переплачивать?",
    answer: "Если считать только по часам занятий, лагерь выходит дешевле. За год кружок программирования стоит от 30 000 до 60 000 рублей — это 60–80 занятий по 1.5–2 часа. За 2 недели в АйДаКемп ребёнок получает сопоставимое время за партой плюс вечерние хакатоны, неформальное общение с педагогами и финальный проект. Но главная ценность — не часы, а интенсивность прогресса и новый круг общения, который часто остаётся на годы."
  },
  {
    question: "Можно ли совмещать кружок и лагерь?",
    answer: "Не просто можно — это лучшая связка. Кружок в течение года закладывает базу и поддерживает ритм. Лагерь летом даёт мощный толчок вперёд, новых друзей и реальный проект. После лагеря дети обычно возвращаются в кружок с новым уровнем мотивации и конкретными вопросами — потому что видят, чего хотят достичь. Лагерь и кружок усиливают друг друга, а не конкурируют."
  },
  {
    question: "Какой возраст лучше подходит для IT-лагеря?",
    answer: "В АйДаКемп принимают детей с 8 до 17 лет, и программы разделены по уровням и возрасту. Оптимальный возраст для первого лагеря — 9–12 лет: ребёнок уже достаточно самостоятелен, чтобы жить без родителей, и при этом восприимчив к новому. Подростки 13–15 лет тоже отлично вписываются — они быстрее схватывают сложные концепции. Важнее возраста — желание и хотя бы базовая уверенность в себе."
  },
  {
    question: "Насколько быстро виден результат после лагеря?",
    answer: "Ощутимый результат — уже на финальном хакатоне, в последние 2 дня смены. Ребёнок защищает проект: игру, сайт, бота или мобильное приложение — сделанный с нуля за 2 недели. После возвращения домой дети обычно сразу садятся доделывать проект или начинают новый. Пик мотивации — первые 2–3 недели после лагеря. Именно в это время важно поддержать кружком или самостоятельными проектами."
  },
  {
    question: "Сколько реально часов занятий в IT-лагере за смену?",
    answer: "В АйДаКемп за 10-дневную смену — около 60–70 часов практической работы: 4–5 часов основных занятий в день плюс вечерние проекты и хакатон. Для сравнения: годовой кружок (36 учебных недель × 2 занятия × 1,5 часа) даёт около 100 часов за 9 месяцев. То есть за 2 недели лагеря школьник получает примерно половину годового объёма — с тем преимуществом, что прогресс непрерывный и задачи каждый день новые."
  },
  {
    question: "Влияет ли лагерь на социализацию, не только на знания?",
    answer: "Это один из самых важных эффектов, о котором мало говорят. В АйДаКемп дети живут вместе 10 дней: общаются за едой, вечером, во время хакатона. Когда рядом другие ребята, которым тоже интересно программирование — это формирует идентичность. После лагеря многие продолжают переписываться, создают общие проекты, поддерживают друг друга. Такой круг общения в школьном возрасте — редкость и ценность."
  }
];
---

<Base
  title="IT-лагерь или кружок программирования — что лучше для ребёнка"
  description="Сравниваем IT-лагерь и кружок по программированию: интенсивность, результат, цена, социализация. Поможем выбрать формат под возраст и цель ребёнка."
  ogImage="/images/articles/programmirovanie-v-lagere-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/it-lager-vs-kruzhok" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "IT-лагерь или кружок программирования — что лучше для ребёнка",
        "description": "Сравниваем IT-лагерь и кружок по программированию: интенсивность, результат, цена, социализация. Поможем выбрать формат под возраст и цель ребёнка.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-03",
        "dateModified": "2026-05-03",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/it-lager-vs-kruzhok"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "IT-лагерь или кружок программирования", "item": "https://aidacamp.ru/stati/it-lager-vs-kruzhok/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="IT-лагерь или кружок программирования"
    subtitle="Разбираем честно: что подходит под ваш запрос, бюджет и возраст ребёнка."
    breadcrumb={[
      { label: "Главная", href: "/" },
      { label: "Статьи", href: "/stati" },
      { label: "IT-лагерь или кружок", href: "" }
    ]}
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          IT-лагерь или кружок программирования — частый вопрос в нашем родительском чате.
          Кружок — это стабильность и ритм. Лагерь — интенсивность и погружение.
          Правда в том, что это разные инструменты для разных задач, и выбор зависит от того,
          чего вы хотите достичь. Разберём честно плюсы и минусы каждого формата.
        </p>
      </div>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Кружок программирования: стабильность и системность</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Кружок — это регулярность. 1–3 занятия в неделю в течение учебного года.
          Ребёнок постепенно движется по программе, педагог знает его уровень и пробелы,
          есть время закрепить каждую тему. Если ребёнок нацелен на олимпиады или
          планомерно движется к профессии разработчика — кружок незаменим.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Минус кружка — медленный прогресс и высокий риск потери мотивации. Два часа
          в неделю — это мало, чтобы почувствовать реальный результат. Дети часто бросают
          через 2–3 месяца, потому что не видят, куда движутся. И это не их вина —
          формат просто не создаёт азарт.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Ещё один момент: в кружке дети разного уровня занимаются по одной программе.
          Быстрые скучают, медленные не успевают. Индивидуальный темп — редкость.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">IT-лагерь: интенсивность и эффект погружения</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Лагерь — это другая физика времени. За 2 недели ребёнок проходит то,
          что в кружке занимает полгода. Не потому что педагоги гонят программу,
          а потому что мозг в условиях погружения работает иначе. Нет домашних забот,
          отвлекающих факторов, усталости от школы — только программирование, новые
          друзья и проект.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Социальный компонент — огромный бонус. Дети живут и работают с теми, кому
          интересно то же самое. Вечером после занятий обсуждают код, спорят о технологиях,
          помогают друг другу. Такая среда формирует то, что не купить на кружке —
          ощущение себя частью IT-сообщества.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Финальный проект — точка гордости. Ребёнок уезжает домой не просто с новыми
          знаниями, а с работающим продуктом. Это конкретное доказательство себе
          и окружающим: «я умею делать».
        </p>
      </section>

      <StatCallout
        stat="2 недели"
        label="в IT-лагере = примерно полгода на обычном кружке"
        description="По объёму практического кода и завершённых проектов — по данным наших педагогов АйДаКемп."
      />

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Честное сравнение по ключевым параметрам</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Скорость прогресса:</strong> лагерь явно выигрывает за счёт концентрации.
          Ребёнок не успевает «остыть» между занятиями.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Социализация:</strong> лагерь — новые друзья на всё лето и иногда на годы.
          Кружок — знакомые одноклассники или дети из района.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Цена за час занятий:</strong> при детальном расчёте лагерь часто оказывается
          сопоставимым или даже дешевле кружка за год. Плюс — вы решаете вопрос летних каникул.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Подходит для старта:</strong> лагерь — отличная точка входа, после которой
          ребёнок точно понимает, интересно ему программирование или нет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          <strong>Для планомерного роста:</strong> кружок в течение года + лагерь летом —
          лучшая связка для тех, кто серьёзно смотрит в сторону IT.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Когда выбрать кружок, а когда — лагерь</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Выбирайте кружок, если: ребёнку нужна плавная системная подготовка к олимпиадам
          или профессии, родители хотят регулярно видеть прогресс, и у ребёнка пока нет
          уверенности ночевать вне дома.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Выбирайте лагерь, если: ребёнок «завис» в игровой зависимости и нужна смена среды,
          нужен быстрый старт и конкретный результат, или вы хотите проверить — есть ли вообще
          интерес к IT, без долгих обязательств. Лагерь — лучшая «проба» с высоким шансом
          на успех.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Стоимость часа занятий: лагерь дешевле, чем кажется</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Многие родители видят цену смены и думают: «дорого». Но если считать по часам практической работы — картина другая.
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-base md:text-base border-collapse">
            <thead>
              <tr class="bg-slate-50">
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200">Параметр</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-700 border border-slate-200">Кружок (год)</th>
                <th class="text-left px-4 py-3 font-semibold text-orange-700 border border-slate-200 bg-orange-50">IT-лагерь (10 дней)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Стоимость</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">30 000–60 000 ₽</td>
                <td class="px-4 py-3 text-slate-700 font-medium border border-slate-200 bg-orange-50">от {PRICE_MIN}</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Часов практики</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">~100 ч за 9 мес.</td>
                <td class="px-4 py-3 text-slate-700 font-medium border border-slate-200 bg-orange-50">60–70 ч за 10 дней</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Стоимость часа</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">300–600 ₽/ч</td>
                <td class="px-4 py-3 text-slate-700 font-medium border border-slate-200 bg-orange-50">~700–800 ₽/ч</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Размер группы</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">10–20 человек</td>
                <td class="px-4 py-3 text-slate-700 font-medium border border-slate-200 bg-orange-50">до 8 человек</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Готовый проект</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">редко</td>
                <td class="px-4 py-3 text-emerald-700 font-medium border border-slate-200 bg-orange-50">всегда</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">Налоговый вычет</td>
                <td class="px-4 py-3 text-slate-600 border border-slate-200">как правило, да</td>
                <td class="px-4 py-3 text-emerald-700 font-medium border border-slate-200 bg-orange-50">да, до {VYCHET_MAX}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-base text-slate-500 leading-[1.6]">
          Разница в стоимости часа — небольшая. Но в лагере к цене добавляются: проживание, питание, 24/7 среда погружения и финальный проект. Если считать всё вместе — лагерь даёт значительно больше за сопоставимые деньги.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-8">
        <h2 class="text-2xl font-bold mb-6">Частые вопросы</h2>
        <div itemscope itemtype="https://schema.org/FAQPage">
          {faqItems.map(item => (
            <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="mb-6">
              <h3 itemprop="name" class="text-lg font-semibold mb-2">{item.question}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p itemprop="text" class="text-gray-700">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <ArticleBottomCta />
    </article>
  </main>

  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
