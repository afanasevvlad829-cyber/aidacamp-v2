---
import { PRICE_MIN, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Куда деть ребёнка летом", url: "/stati/kuda-det-rebenka-letom/", icon: "sun", description: "Все варианты на лето — честное сравнение от мамы" },
  { title: "Сколько стоит детский лагерь", url: "/stati/skolko-stoit-detskiy-lager/", icon: "wallet2", description: "Реальные цены 2026: от городских до загородных" },
  { title: "Лагерь или репетитор летом", url: "/stati/lager-ili-repetitor-letom/", icon: "book", description: "Что выбрать, если лето одно, а задач много" },
  { title: "IT-лагерь АйДаКемп", url: "/it-lager/", icon: "laptop", description: "Загородный, с проживанием — Python, AI, Minecraft" },
  { title: "Детский лагерь в Подмосковье", url: "/detskiy-lager-podmoskove/", icon: "tree", description: "Как устроена загородная смена: жильё, питание, программа" },
];

const faqItems = [
  {
    question: "Что дешевле — городской или загородный лагерь?",
    answer: "Городской: обычно 15 000–25 000 ₽ за две недели, без ночёвки и ужина. Загородный — дороже, но в цену входят проживание, 5-разовое питание и вечерняя программа. Если пересчитать на час занятости, разница заметно меньше, чем кажется по ценнику.",
  },
  {
    question: "С какого возраста можно в загородный лагерь?",
    answer: "В АйДаКемп принимаем с 7 лет. Практика такая: 7–9 лет чаще выбирают короткую смену (7 дней) как первый опыт, 10+ спокойно едут на 10–14 дней. Если сомневаетесь — короткая смена и есть способ проверить.",
  },
  {
    question: "А если в городском лагере скучно, а в загородный страшно отпускать?",
    answer: "Это самый частый расклад. Компромисс — короткая загородная смена на 7 дней: достаточно, чтобы прожить «настоящий лагерь» с кострами и сменой среды, и достаточно коротко, чтобы мама выдохнула. Фото в родительском чате каждый день.",
  },
  {
    question: "Можно ли получить налоговый вычет за лагерь?",
    answer: `За образовательный загородный лагерь с лицензией — да, 13% от образовательной части путёвки, до ${VYCHET_MAX} за смену. За городские лагеря при школах вычет обычно не оформляется. Документы выдаём по запросу.`,
  },
  {
    question: "Чем загородный IT-лагерь отличается от городского IT-кружка летом?",
    answer: "Городской формат — это занятия 2–4 часа и домой. Загородный — полное погружение: проект делается каждый день, рядом команда, вечером не соцсети, а костёр и настолки. Результат за смену — готовый проект, который ребята защищают на хакатоне.",
  },
];
---

<Base
  title="Городской или загородный лагерь на лето 2026 — что выбрать | АйДаКемп"
  description="Городской лагерь в Москве на лето или загородный с проживанием? Честное сравнение от мамы: цены, режим, безопасность, кому что подходит. Без агитации."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/gorodskoy-ili-zagorodnyy-lager" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Городской или загородный лагерь: как выбрать на лето 2026",
        "description": "Сравнение городского (дневного) и загородного лагеря: цены, режим дня, безопасность, плюсы и минусы. Опыт мамы, без агитации за один формат.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru"},
        "datePublished": "2026-06-10",
        "dateModified": "2026-06-10",
        "mainEntityOfPage": { "@type": "WebPage", "@id": "https://aidacamp.ru/stati/gorodskoy-ili-zagorodnyy-lager" }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Городской или загородный лагерь", "item": "https://aidacamp.ru/stati/gorodskoy-ili-zagorodnyy-lager" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Городской или загородный лагерь"
    subtitle="Что выбрать на лето 2026: честное сравнение двух форматов — без агитации"
    imageBase="kuda-letom"
    imageAlt="Ребята на летней смене — выбор между городским и загородным форматом"
    readTime="6 мин чтения"
    breadcrumbsLast="Городской или загородный лагерь"
    daryaQuote="Я сама год выбирала между «рядом с домом» и «с проживанием». В итоге поняла: это два разных продукта, и сравнивать их по цене — ошибка."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы ищете «городской лагерь в Москве на лето» — скорее всего, вы решаете не про лагерь, а про лето целиком: куда деть школьника на каникулах, чтобы он не сидел дома, а вы спокойно работали. Городской (дневной) лагерь и загородный с проживанием решают эту задачу по-разному. Ниже — честное сравнение, без агитации: у нас загородный лагерь, но городской формат для части семей объективно удобнее, и мы об этом прямо говорим.
        </p>
      </div>

      <section class="mb-12">
        <h2 class="text-[24px] md:text-[28px] font-bold text-body mb-5">В чём разница на самом деле</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Городской лагерь — это «продлёнка с программой»: привели к 9, забрали в 18, ночует дома. Загородный — смена среды: ребята живут на закрытой территории, день расписан от подъёма до отбоя, родители на связи через чат с фото. Это не «лучше/хуже», это разные продукты под разные задачи.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-base border border-slate-200 rounded-[12px] overflow-hidden">
            <thead>
              <tr class="bg-slate-50 text-left">
                <th class="p-3 font-semibold text-slate-700"></th>
                <th class="p-3 font-semibold text-slate-700">Городской (дневной)</th>
                <th class="p-3 font-semibold text-slate-700">Загородный (с проживанием)</th>
              </tr>
            </thead>
            <tbody class="text-slate-600">
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Режим</td><td class="p-3">9:00–18:00, ночует дома</td><td class="p-3">Полный день, проживание на смене</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Цена за 2 недели</td><td class="p-3">~15 000–25 000 ₽</td><td class="p-3">от {PRICE_MIN} за 10 дней, всё включено</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Питание</td><td class="p-3">Обед, иногда полдник</td><td class="p-3">5 раз в день</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Логистика родителей</td><td class="p-3">Возить каждый день</td><td class="p-3">Один раз отвезти и забрать (или трансфер)</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Смена среды</td><td class="p-3">Нет — вечером те же соцсети</td><td class="p-3">Да — природа, команда, вечерняя программа</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Самостоятельность</td><td class="p-3">Почти как в школе</td><td class="p-3">Главный «продукт» формата</td></tr>
              <tr class="border-t border-slate-200"><td class="p-3 font-medium text-slate-700">Налоговый вычет</td><td class="p-3">Обычно нет</td><td class="p-3">До {VYCHET_MAX} (образовательная лицензия)</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-[24px] md:text-[28px] font-bold text-body mb-5">Когда городской лагерь — правильный выбор</h2>
        <ul class="space-y-3 text-[16px] leading-[1.7] text-slate-600 list-disc pl-5">
          <li><strong>Первоклашка или тревожный возраст 6–8 лет.</strong> Если сын или дочь ещё ни разу не ночевали вне дома — дневной формат мягче.</li>
          <li><strong>Жёсткий бюджет.</strong> Городской при школе может стоить как пара недель продлёнки.</li>
          <li><strong>Лето «кусочками».</strong> Между поездками к бабушке и морем удобно закрыть неделю-другую без логистики загородного заезда.</li>
          <li><strong>Медицинские причины</strong> — когда нужно быть рядом с конкретным врачом.</li>
        </ul>
      </section>

      <section class="mb-12">
        <h2 class="text-[24px] md:text-[28px] font-bold text-body mb-5">Когда стоит смотреть загородный</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Есть три ситуации, в которых городской формат честно не справляется:
        </p>
        <ul class="space-y-3 text-[16px] leading-[1.7] text-slate-600 list-disc pl-5">
          <li><strong>Нужна смена среды.</strong> Если школьник вечером возвращается в ту же комнату к тому же телефону — лето по ощущениям не наступает. В загородном среда меняется целиком: <a href="/stati/lager-dlya-rebenka-kotoryy-tselymi-dnyami-v-telefone/" class="text-primary hover:underline">особенно заметно это по ребятам, которые «живут в телефоне»</a>.</li>
          <li><strong>Запрос на самостоятельность.</strong> Сам встал, сам собрался, сам договорился с соседями по комнате — этому не научиться, ночуя дома.</li>
          <li><strong>Хочется результата, а не присмотра.</strong> В формате полного погружения за смену реально довести проект до конца — в дневном формате на это просто не хватает часов.</li>
        </ul>
        <div class="mt-6">
          <StatCallout
            value="7 дней"
            label="— короткая загородная смена: самый частый «первый раз» для тех, кто выбирал между форматами"
            source="наблюдение по сменам АйДаКемп"
            icon="calendar-check"
            tone="info"
          />
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-[24px] md:text-[28px] font-bold text-body mb-5">Как решали мы (и что говорят мамы)</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          У дочери первый загородный опыт случился именно после городского лагеря: неделя при школе прошла «нормально», но вечером она всё равно сидела в телефоне, а к пятнице спрашивала, можно ли не ходить. Контраст с выездной сменой был разительный: там вечером не до экрана — костёр, своя команда, проект, который завтра показывать.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Если склоняетесь к загородному формату и при этом школьник «дружит с компьютером» — посмотрите <a href="/it-lager/" class="text-primary hover:underline">IT-лагерь АйДаКемп в Подмосковье</a>: смены от 10 дней, группы до 8 человек, путёвка от {PRICE_MIN}, фото в родительском чате каждый день. А если пока сомневаетесь — начните со статьи <a href="/stati/kuda-det-rebenka-letom/" class="text-primary hover:underline">«Куда деть ребёнка летом»</a>, там все варианты, включая бабушку.
        </p>
      </section>

      <section class="mb-12">
        <h2 class="text-[24px] md:text-[28px] font-bold text-body mb-6">Частые вопросы</h2>
        <div class="space-y-5">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-white p-5">
              <h3 class="text-[17px] font-semibold text-body mb-2">{item.question}</h3>
              <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    title="Загородная смена, после которой есть результат"
    subtitle="IT-лагерь в Подмосковье: Python, AI, Minecraft. Смены от 7 дней — удобный «первый раз» после городского формата."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
