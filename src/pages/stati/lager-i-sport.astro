---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Мозг без гаджетов: что происходит за 5 дней в лагере", url: "/stati/mozg-bez-gadgetov-v-lagere/", icon: "cpu", description: "Наука о цифровом детоксе в лагере" },
  { title: "Дружба в лагере: почему она крепче школьной", url: "/stati/druzhba-v-lagere-nauka/", icon: "people-fill", description: "Что говорит наука о лагерной дружбе" },
  { title: "Как подготовить ребёнка к лагерю: полный чеклист", url: "/stati/kak-podgotovit-k-lageryuu/", icon: "calendar-check", description: "Чеклист подготовки за 4 недели" },
];
---

<Base
  title="Лагерь и физическое развитие: что даёт, чего не дают секции | АйДаКемп"
  description="Акселерометры, PACER-тесты и 63 000 подростков в 9 странах. Цифры о том, что происходит с физической формой в лагере — и что теряется за летом без активности."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="lager-i-sport"
      title="Лагерь и физическое развитие: что даёт, чего не дают секции"
      description="Акселерометры, PACER-тесты и 63 000 подростков в 9 странах. Цифры о том, что происходит с физической формой в лагере — и что теряется за летом без активности."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь и физическое развитие: что даёт, чего не дают секции"
    subtitle="Акселерометры, PACER-тесты и 63 000 подростков в 9 странах. Цифры о том, что происходит с физической формой в лагере — и что теряется за летом без активности."
    breadcrumbsLast="Лагерь и спорт"
    readTime="7 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="78" label="минут активного движения в день в среднем по лагерям (данные акселерометров)" tone="orange" size="lg" />
          <AnimatedStat value="22000" label="шагов в день в загородном лагере — против 8 700 до него" tone="blue" size="lg" />
          <AnimatedStat value="17" unit="%" label="падение выносливости за 12 недель летних каникул без активности" tone="red" size="lg" />
          <AnimatedStat value="50" unit="%" label="рост на тесте творческого мышления после 4 дней в природе" tone="green" size="lg" />
        </div>
      </div>

      <!-- Что показывают акселерометры -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что показывают акселерометры
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Исследователи перестали доверять самоотчётам и прикрепили к детям акселерометры. Данные по 153 детям из бостонских лагерей: в среднем <strong>78 минут в день умеренной и интенсивной физической активности</strong> (MVPA). Норма ВОЗ — 60 минут. Лагерь перекрывает её с запасом.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Но ещё интереснее данные японского исследования (Frontiers in Pediatrics, 2022) с 31-дневным загородным лагерем:
        </p>

        <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5 mb-6">
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <div class="text-center px-4 py-3 rounded-[12px] bg-white border border-slate-200 min-w-[140px]">
              <p class="text-[11px] font-semibold uppercase text-slate-400 mb-1">До лагеря</p>
              <p class="text-[26px] font-black leading-none text-slate-700">8 658</p>
              <p class="text-[12px] text-slate-500 mt-1">шагов в день</p>
              <p class="text-[11px] text-slate-400 mt-1">MVPA: 5% дня</p>
            </div>
            <i class="bi bi-arrow-right text-[22px] text-orange-400 rotate-90 sm:rotate-0" aria-hidden="true"></i>
            <div class="text-center px-4 py-3 rounded-[12px] bg-green-50 border border-green-200 min-w-[140px]">
              <p class="text-[11px] font-semibold uppercase text-green-600 mb-1">В лагере</p>
              <p class="text-[26px] font-black leading-none text-green-700">22 405</p>
              <p class="text-[12px] text-slate-500 mt-1">шагов в день</p>
              <p class="text-[11px] text-slate-400 mt-1">MVPA: 9,6% дня</p>
            </div>
            <i class="bi bi-arrow-right text-[22px] text-slate-300 rotate-90 sm:rotate-0" aria-hidden="true"></i>
            <div class="text-center px-4 py-3 rounded-[12px] bg-red-50 border border-red-200 min-w-[140px]">
              <p class="text-[11px] font-semibold uppercase text-red-500 mb-1">После лагеря</p>
              <p class="text-[26px] font-black leading-none text-red-600">7 719</p>
              <p class="text-[12px] text-slate-500 mt-1">шагов в день</p>
              <p class="text-[11px] text-slate-400 mt-1">MVPA: 3,6% дня</p>
            </div>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере дети двигаются в <strong>2,6 раза больше</strong>, чем до него. И возвращаются к исходному уровню сразу после — что само по себе показывает: без структурированной среды движение исчезает.
        </p>
      </div>

      <!-- Летнее падение -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            «Летнее падение» физической формы: реальные цифры
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          В США существует хорошо задокументированный феномен «summer slide» — летняя деградация. Обычно его знают применительно к учёбе, но с физической формой всё ещё хуже.
        </p>

        <div class="rounded-[16px] bg-red-50 border border-red-200 p-6 text-center mb-6">
          <i class="bi bi-bar-chart-fill text-red-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[15px] font-bold text-slate-800 mb-4">PACER-тест (бег с нарастающей скоростью): 1 232 ребёнка</p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <div class="text-center">
              <p class="text-[30px] font-black leading-none text-green-600">31.2</p>
              <p class="text-[12px] text-slate-500 mt-1">круга весной</p>
            </div>
            <i class="bi bi-arrow-right text-[20px] text-slate-400" aria-hidden="true"></i>
            <div class="text-center">
              <p class="text-[30px] font-black leading-none text-red-600">25.8</p>
              <p class="text-[12px] text-slate-500 mt-1">круга осенью</p>
            </div>
            <i class="bi bi-arrow-right text-[20px] text-slate-400" aria-hidden="true"></i>
            <div class="text-center">
              <p class="text-[30px] font-black leading-none text-red-600">−17%</p>
              <p class="text-[12px] text-slate-500 mt-1">кардиовыносливости за лето</p>
            </div>
          </div>
          <p class="mt-4 text-[12px] text-slate-400">Данные: Journal of Environmental and Public Health, 2017 (p&lt;0.001)</p>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Австралийское когортное исследование (2023, 381 ребёнок) показало: <strong>летняя потеря аэробной формы в 4–5 раз быстрее, чем в учебном году.</strong> И одновременно — рост жировой массы в 4 раза быстрее. Каникулы без активного отдыха буквально обнуляют результаты школьных программ физкультуры.
        </p>
      </div>

      <!-- Что меняется за 6 недель -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что меняется за 6 недель лагеря: конкретные цифры
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Исследование Forever-Fit Camp (179 участников, возраст 8–12 лет, 6 недель):
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4 text-center">
            <i class="bi bi-arrow-up text-green-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-green-700 mt-1">+5.8</p>
            <p class="text-[12px] text-slate-500 mt-1">отжиманий</p>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4 text-center">
            <i class="bi bi-arrow-up text-green-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-green-700 mt-1">+7.7</p>
            <p class="text-[12px] text-slate-500 mt-1">приседаний</p>
          </div>
          <div class="rounded-[14px] bg-green-50 border border-green-200 p-4 text-center">
            <i class="bi bi-arrow-up text-green-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-green-700 mt-1">+6.7</p>
            <p class="text-[12px] text-slate-500 mt-1">скручиваний</p>
          </div>
          <div class="rounded-[14px] bg-blue-50 border border-blue-200 p-4 text-center">
            <i class="bi bi-arrow-down text-blue-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-blue-700 mt-1">−8.5</p>
            <p class="text-[12px] text-slate-500 mt-1">уд/мин пульс в покое</p>
          </div>
          <div class="rounded-[14px] bg-blue-50 border border-blue-200 p-4 text-center">
            <i class="bi bi-arrow-down text-blue-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-blue-700 mt-1">−6.4</p>
            <p class="text-[12px] text-slate-500 mt-1">мм рт.ст. систолическое АД</p>
          </div>
          <div class="rounded-[14px] bg-blue-50 border border-blue-200 p-4 text-center">
            <i class="bi bi-arrow-down text-blue-600 text-[18px]" aria-hidden="true"></i>
            <p class="text-[24px] font-black leading-none text-blue-700 mt-1">−0.8</p>
            <p class="text-[12px] text-slate-500 mt-1">кг/м² ИМТ</p>
          </div>
        </div>
      </div>

      <!-- Лагерь vs секция -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Лагерь vs секция: в чём принципиальная разница
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          72% детей бросают организованный спорт к 13 годам. Это цифра национальной статистики США — и она говорит о кризисе модели «одна секция на годы».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Психологи объясняют через Self-Determination Theory: для устойчивой мотивации человеку нужны три вещи — <strong>автономия</strong> (сам выбираю), <strong>компетентность</strong> (чувствую, что умею), <strong>принадлежность</strong> (я с «моими»). Специализированная секция системно подрывает автономию: тренер решает, что и когда. Лагерь удовлетворяет все три потребности одновременно.
        </p>

        <div class="rounded-[16px] border border-slate-200 overflow-hidden text-[13px]">
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] bg-slate-50 font-bold">
            <div class="p-3"></div>
            <div class="p-3 text-center text-slate-600">Секция</div>
            <div class="p-3 text-center bg-green-50 text-green-700">Лагерь</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Видов активности</div>
            <div class="p-3 text-center border-l border-slate-100">1</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">8–12 за смену</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Автономия</div>
            <div class="p-3 text-center border-l border-slate-100">Тренер решает</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">Выбор + структура</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Соотношение MVPA</div>
            <div class="p-3 text-center border-l border-slate-100">42% времени</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">62% времени</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Давление результата</div>
            <div class="p-3 text-center border-l border-slate-100">Высокое</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">Отсутствует</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Развитие моторики</div>
            <div class="p-3 text-center border-l border-slate-100">Один паттерн</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">Весь двигательный репертуар</div>
          </div>
          <div class="grid grid-cols-[1.5fr_1fr_1.2fr] border-t border-slate-100">
            <div class="p-3 text-slate-600">Риск выгорания</div>
            <div class="p-3 text-center border-l border-slate-100">Высокий (раняя специализация)</div>
            <div class="p-3 text-center border-l border-slate-100 bg-green-50 text-green-700 font-semibold">Низкий</div>
          </div>
        </div>
      </div>

      <!-- Природа и мозг -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Природа и мозг: неожиданные числа
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Физическое движение в природной среде работает иначе, чем в зале. Исследование Университета Иллинойса: 30 минут в природе дают более стабильные и быстрые показатели теста на внимание у детей, чем аналогичная прогулка в городе.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-stars text-yellow-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-800 mb-1">+50% творческое мышление</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">4 дня похода без устройств — результат PLOS One (2012) на туристах</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-moon-stars-fill text-blue-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-800 mb-1">Сон улучшается на 1+ час</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Японское исследование: засыпание в 01:32 → 00:24 в лагере</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-heart-pulse-fill text-red-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-800 mb-1">Тревога SMD −0.94</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Мета-анализ природных активностей: больший эффект, чем у многих медикаментов</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-book text-green-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-800 mb-1">Связь с успеваемостью</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Исследование 63 228 подростков в 9 странах: физическая активность коррелирует с успехом по математике, чтению и науке</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Итог -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Итог: лагерь не заменяет секцию, но делает другое
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Спорт в секции — это углубление. Лагерь — это широта. Ребёнок, который весь год ходит в одну секцию, отлично знает один вид движения. Ребёнок, прошедший лагерь, за две недели попробовал плавание, верёвочный курс, командные игры, поход, велосипед — и развил координацию, баланс и моторику, которые ни одна специализация не формирует.
        </p>
        <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-6 text-center">
          <i class="bi bi-stars text-amber-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            И при этом получил тот уровень физической нагрузки, который ВОЗ рекомендует как ежедневный — а большинство городских детей не набирает за весь учебный год.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
