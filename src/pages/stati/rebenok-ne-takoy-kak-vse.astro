---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Лагерь для интроверта", url: "/stati/lager-dlya-introverta/", icon: "person", description: "Среда без давления — страхи и реальность" },
  { title: "Лагерь для гиперактивного", url: "/stati/lager-dlya-giperaktivnogo/", icon: "lightning-charge", description: "Короткие блоки и маленькие группы" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Меньше фонового шума — легче удерживать внимание" },
  { title: "Кому не подходит лагерь", url: "/stati/komu-ne-podhodit-lager/", icon: "info-circle", description: "Честно о том, когда лучше не ехать" },
];

const faqItems = [
  {
    question: "Нужно ли рассказывать об особенностях при записи?",
    answer: "Желательно — и лучше своими словами, а не диагнозами. «Тяжело переносит внезапную смену планов», «в шуме через час выключается», «может уйти в задачу и не слышать» — такие фразы полезнее любой справки. Педагог будет знать это до начала смены, а не выяснять по ходу. Информация остаётся у педагога и медработника, остальным ребятам её не сообщают."
  },
  {
    question: "Требуется ли заключение специалиста?",
    answer: "Нет. Мы не запрашиваем заключений психолога или невролога и не оцениваем их. Нужны только стандартные справки для заезда — те же, что в любой лагерь. Если есть письменные рекомендации врача и вы хотите их показать — берите, медработнику будет понятнее логика назначений."
  },
  {
    question: "А если ребёнок принимает препараты по расписанию?",
    answer: "Медработник в лагере круглосуточно. Препараты передаёте при заезде вместе с назначением врача — дальше их выдают по расписанию. Мы ничего не назначаем и не отменяем самостоятельно."
  },
  {
    question: "Есть ли у вас сопровождение один на один?",
    answer: "Нет. У нас нет тьютора, который весь день находится рядом с одним человеком, нет дефектолога и отдельной коррекционной программы. Если нужно постоянное сопровождение — наш формат не подойдёт, и лучше выяснить это до оплаты, а не в первый день смены."
  },
  {
    question: "Что будет, если станет тяжело прямо в середине смены?",
    answer: "Мы на связи с родителями каждый день. Если видим, что человеку плохо — звоним и обсуждаем: иногда достаточно снять часть нагрузки и дать больше тишины, иногда правильнее забрать. Решение всегда совместное, никто не будет уговаривать «дотерпеть»."
  },
];
---

<Base
  title="«Он у меня немного другой» — подойдёт ли IT-лагерь | АйДаКемп"
  description="Ребёнок, которому тяжело в шумной компании, залипает на одной теме или не выносит смены планов. Почему формат IT-лагеря часто подходит лучше обычного — и о чём мы говорим честно."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "«Он у меня немного другой» — и что с этим делать летом",
        "description": "Ребёнок, которому тяжело в шумной компании, залипает на одной теме или не выносит смены планов. Почему формат IT-лагеря часто подходит лучше обычного — и о чём мы говорим честно.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-08-13",
        "dateModified": "2026-08-13",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/rebenok-ne-takoy-kak-vse/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {"@type": "Answer", "text": item.answer}
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="«Он у меня немного другой»"
    subtitle="Разговор про ребят, которым обычный формат даётся тяжелее — без ярлыков и диагнозов."
    imageBase="lager-programmirovaniya"
    imageAlt="Подросток сосредоточенно работает над своим проектом в IT-лагере"
    readTime="7 мин чтения"
    breadcrumbsLast="Он у меня немного другой"
    daryaQuote="Мамы почти всегда делают паузу перед этой фразой. Я научилась не задавать следующий вопрос — пусть расскажет так, как ей удобно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Есть разговор, который начинается почти одинаково. Мама пишет — и делает паузу перед второй фразой. «Он у нас… ну, немного другой». Дальше по-разному, но узнаваемо.
        </p>
      </div>

      <!-- Секция 1: Как это выглядит -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как это обычно выглядит
          </h2>
        </div>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Залипает на одной теме так, что может говорить про неё сорок минут и не заметить, что собеседник ушёл</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">В шумной комнате через час становится колючим и просится домой</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Не выносит, когда меняются планы: сказали в три — значит в три</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Не смотрит в глаза — но собрал в Minecraft работающий калькулятор на редстоуне</span></li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Иногда за этим стоит формулировка от специалиста. Иногда — ничего, кроме десяти лет наблюдений мамы и фразы «он просто такой». Мы не спрашиваем, что там в бумагах. Нам интереснее, что происходит в комнате.
        </p>
      </div>

      <!-- Секция 2: Почему обычная смена тяжёлая -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему обычная смена бывает тяжёлой
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Классический лагерь построен на общем: общий отряд в двадцать пять человек, общая зарядка, общий конкурс талантов, общая дискотека до отбоя. Кому-то это счастье. А кому-то — восемь часов ежедневного шума, из которых спрятаться некуда, и вечное «ну что ты стоишь, иди танцуй со всеми».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Такой школьник обычно не жалуется. Он выдерживает. А потом вы забираете его в конце смены — и он молчит всю дорогу, а через неделю говорит: «Больше не поеду».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Дело редко в лагере как таковом. Дело в том, что весь день собран из ситуаций, где надо быть как все и быстро.
        </p>
      </div>

      <!-- Секция 3: Что меняет формат -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что меняет формат с компьютером
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Половину дня ребята сидят за задачей. И тут начинают работать вещи, которые в обычном отряде не работают вообще.
        </p>
        <div class="space-y-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Есть куда деть внимание</p>
            <p class="text-base leading-[1.6] text-slate-600">Не «посиди спокойно», а «допиши этот кусок». Гиперфокус, который в школе выглядит как проблема, здесь просто способ решать задачи. Ушёл на два часа в свой уровень и вынырнул с готовым — отлично, так и надо.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Правила понятные и не меняются</p>
            <p class="text-base leading-[1.6] text-slate-600">Код либо работает, либо нет. Никаких «догадайся, чего от тебя ждут» и никаких обид на то, что ты не так посмотрел. Для многих ребят это единственная за год среда, где ничего не надо считывать между строк.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Разговор появляется сам</p>
            <p class="text-base leading-[1.6] text-slate-600">Не через «а давайте познакомимся, назови своё любимое животное», а через «слушай, у тебя тоже персонаж сквозь стену проходит?». Общая задача — самый мягкий вход в общение из существующих: не надо быть обаятельным, надо делать общее дело за соседним компьютером.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Группа маленькая</p>
            <p class="text-base leading-[1.6] text-slate-600">До восьми человек на педагога. Это не про сервис, это про то, что человека видно. Если он час не поднимает голову — это замечают. Если вышел в коридор посидеть один — это тоже замечают и не тащат обратно в круг.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">День нарезан кусками по 40–50 минут</p>
            <p class="text-base leading-[1.6] text-slate-600">Не потому что мы такие продвинутые, а потому что иначе никто не выдержит. Побочный эффект: тем, кому тяжело сидеть на месте, тоже становится нормально.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Подробнее про темпераменты — в статьях <a href="/stati/lager-dlya-introverta/" class="text-orange-700 hover:underline">про лагерь для интроверта</a> и <a href="/stati/lager-dlya-giperaktivnogo/" class="text-orange-700 hover:underline">про гиперактивных ребят</a>. Принцип один: среда важнее ярлыка.
        </p>
      </div>

      <!-- Секция 4: Честно -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Про что мы говорим честно
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы не коррекционный центр. У нас нет дефектолога, нет тьютора, который ходит рядом с одним человеком весь день, и нет специальной программы. Если нужно сопровождение один на один — это не к нам, и лучше узнать об этом сейчас, а не в первый день смены.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Медработник на территории круглосуточно. Если есть препараты по расписанию — отдаёте при заезде вместе с назначением, дальше следят.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И ещё одно. Расскажите нам заранее, как есть. Не для анкеты — чтобы педагог в понедельник утром уже знал, что этого человека не надо вытаскивать к доске, а этому нужно предупреждение за пять минут до смены задания. Это не про особый статус. Это про то, чтобы первый день не пришлось тратить на выяснение.
        </p>
      </div>

      <!-- Секция 5: Что обычно случается -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что обычно случается
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не превращение. Никто не приезжает домой другим человеком, и обещать это было бы враньём.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Случается другое: две недели, в течение которых он был нормальным. Не «трудным», не «тем, с кем сложно», а парнем, который делает игру и знает про Godot больше остальных. Иногда впервые за долгое время.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Этого, как правило, хватает надолго.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Расскажите про вашего — а мы честно скажем, подойдёт ли</p>
        <p class="mt-2 text-base text-[#0d1a2b]/70">Оставьте номер: поговорим без скриптов, без анкет и без обещаний. Если наш формат не подходит — так и скажем.</p>
        <a href="/lager-programmirovaniya/" class="mt-4 inline-block rounded-xl bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-[#d67000] transition-colors">Узнать про программу лагеря</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-base font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/stati/lager-dlya-introverta/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            Лагерь для интроверта — среда без давления
          </a>
          <a href="/stati/lager-dlya-giperaktivnogo/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            Лагерь для гиперактивного — короткие блоки и малые группы
          </a>
          <a href="/stati/komu-ne-podhodit-lager/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            Кому не подходит лагерь — честный список
          </a>
          <a href="/lager-bez-telefonov/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
            Лагерь без телефонов — почему это работает
          </a>
        </div>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Узнайте, подойдёт ли лагерь вашему ребёнку"
    bookingSubtitle="Расскажите про особенности своими словами — подберём смену и предупредим педагога заранее."
  />

  <div class="mx-auto max-w-[720px] px-4 py-8">
    <div class="rounded-[16px] bg-[#fff8f0] border border-primary/20 p-6">
      <p class="text-base text-slate-700 mb-3">Смотрите программы смен на лето {SEASON_YEAR}</p>
      <a href="/lager-dlya-podrostkov/" class="inline-block bg-primary text-white font-semibold text-base px-5 py-2.5 rounded-[10px] hover:bg-[#d67000] transition">
        Летний IT-лагерь для подростков →
      </a>
    </div>
  </div>

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />

<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
