---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Адаптация ребенка в лагере", url: "/stati/adaptaciya-rebenka-v-lagere/", icon: "heart", description: "Первый вечер, второй и третий день — изнутри" },
  { title: "Ребенок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "star-fill", description: "6 страхов мамы и что будет на самом деле" },
  { title: "Как подготовить ребенка к лагерю", url: "/stati/kak-podgotovit-rebenka-k-lageru/", icon: "backpack", description: "Что сделать до заезда, чтобы было легче" },
  { title: "Смены 2026 — цены", url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Ребенок звонит и плачет «забери меня» — что делать?",
    answer: "Выслушать, сказать, что любите и верите в него — и мягко завершить разговор. Не обещать приехать: запасной выход ребенок будет искать при малейшем дискомфорте. Пик тоски по статистике — самое начало смены, потом проходит само. Если к четвёртому дню легче не стало — напишите старшему вожатому смены, разберёмся вместе."
  },
  {
    question: "Это правда нормально, что ребенок хочет домой?",
    answer: "Да. По исследованию психолога Кристофера Тёрбера (329 детей) 83% детей за смену успевают затосковать по дому — это почти все. При этом меньше 1% возвращаются домой досрочно. Тосковать — норма, не справиться — редкость."
  },
  {
    question: "Как долго ребенок тоскует по дому?",
    answer: "Пик — первые три дня, особенно у тех, кто едет впервые. Потом включается программа, появляются друзья — и ребенка отпускает, тоска уходит на фон. Спустя неделю большинство уже не помнит, как просилось обратно."
  },
  {
    question: "Чем я могу помочь, пока ребенок в лагере?",
    answer: "Вы знаете своего ребенка лучше всех. Самое полезное — написать старшему вожатому смены и рассказать, чего он боится и что обычно его успокаивает. Команда мягко и незаметно поможет на месте: подсадит к нужным ребятам, даст роль, в которой он раскроется. Это не контроль — это ключ, который есть только у вас."
  },
  {
    question: "Можно ли звонить ребенку когда захочется?",
    answer: "Лучше договориться о конкретном времени — например, после ужина — и держаться его. Звонок в середине активности выдёргивает ребенка обратно «домой» в тот момент, когда он только начал включаться. Одного звонка-якоря в день достаточно, шесть — затягивают адаптацию."
  }
];
---

<Base
  title="Первый день в лагере: ребенок хочет домой, просится — что делать"
  description="Ребенок тоскует по дому в первый день лагеря — это норма, не сигнал SOS. Что делать и чем помочь — от мамы к маме."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Первые три дня в лагере: почему ребенок хочет домой — и что делать | АйДаКемп",
        "description": "Тоска по дому в первые дни смены — норма, а не сигнал SOS. Что не делать родителю и чем реально помочь ребенку-первоходу.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-11",
        "dateModified": "2026-06-11",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pervye-tri-dnya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Первый день в лагере: ребенок хочет домой, просится — что делать"
    subtitle="83% детей за смену успевают затосковать по дому. Меньше 1% возвращаются досрочно. Что происходит с ребенком на старте смены — и почему то, что подсказывает сердце, лучше придержать."
    imageBase="o-lagere"
    imageAlt="Дети на старте смены в лагере АйДаКемп"
    readTime="7 мин чтения"
    breadcrumbsLast="Ребенок просится домой"
    daryaQuote="Три года дочь ездила в другие лагеря — и всякий заезд заканчивался одинаково: вечерний звонок, слёзы, «забери меня». Я слушала. Не забирала. Не обещала приехать. Потому что знала: начало такое. Это пройдёт. И проходило."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы впервые отпустили ребенка на смену — поздравляю. Вы, скорее всего, уже готовитесь к звонку. Или он уже был. «Мама, мне тут плохо. Заберите меня». Прежде чем паниковать, стоит узнать чуть больше о том, как обычно проходит адаптация — почти всегда это не то, чем кажется в стартовый вечер.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Тоска по дому в начале смены — норма, а не сигнал SOS
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Согласно исследованию психолога Кристофера Тёрбера (Phillips Exeter Academy, 329 детей), <strong>83% детей хотя бы однажды за смену испытывают тоску по дому</strong>. Почти все. Не слабые и не домашние — просто все. Самый тяжёлый — день заезда и следующий за ним.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При этом <strong>меньше 1% возвращаются домой досрочно</strong>. То есть: тосковать — нормально. Не справиться — редкость.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Пик приходится на первые три дня. Потом включается программа, появляются друзья, начинается жизнь — и «хочу домой» уходит на фон. Четвёртый день обычно проходит уже без слёз, а про «забери меня» никто и не вспоминает.
        </p>

        <figure class="my-6">
          <img
            src="/images/articles/pervye-tri-dnya-adaptaciya.svg"
            alt="Таймлайн эмоционального состояния ребенка в начале смены: пик тоски — первые три дня, к концу недели включение в жизнь лагеря. 83% детей скучают по дому, меньше 1% возвращаются досрочно."
            width="680"
            height="427"
            loading="lazy"
            class="w-full max-w-[680px] mx-auto rounded-xl border border-slate-200 bg-white"
          />
          <figcaption class="mt-2 text-center text-base text-slate-400">
            Как меняется настроение ребенка по ходу смены. Данные: Thurber C.A., American Camp Association.
          </figcaption>
        </figure>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Первоход — это вы, не он
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Первоход — это мама или папа, которые впервые отпускают ребенка. У вас нет внутренней точки опоры «помню, тогда позвонил со слезами — а потом прислал фото с улыбкой». Вы не знаете, что «потом» вообще бывает. Поэтому каждый звонок звучит как сигнал SOS.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          И вот важный момент: решение о поездке почти всегда принимаете вы. Он согласился — но это не то же самое, что захотел сам. Вы ему плохого не посоветовали, и он это тоже знает. Просто когда становится некомфортно, нет внутреннего «я сам выбрал — значит буду держаться». Есть только «меня сюда привезли».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не трагедия. Это просто контекст. И он одинаковый почти у всех первоходов — и детей, и родителей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Это как садик
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Помните адаптацию в садике? Слёзы на пороге. «Не уходи». Иногда — крики. Через полчаса после вашего ухода ребенок уже строил башню из кубиков и думать забыл про расставание.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В лагере то же самое. Только дети уже постарше, и сигналы стали немного взрослее. Не рёв у двери, а «тут все злые», «мне никто не нравится», «еда невкусная». Это не факты о лагере. Так ребенок говорит: мне сейчас непривычно, верните меня туда, где всё знакомо.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Механизм тот же, что в садике. И точно так же — проходит само, как только новое место становится своим.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Дети переокружены заботой. И это проблема
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы живём в эпоху, когда наши дети практически никогда не остаются один на один с дискомфортом. Не понравилась еда — другая. Скучно — телефон. Страшно — мама рядом.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не плохое воспитание. Это любовь. Но у неё есть побочный эффект: дети разучились переживать дискомфорт. Не знают, что неприятное чувство можно просто пережить. Оно пройдёт само. Можно потерпеть — и через час будет нормально.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере это встречается с реальностью. Старт смены — момент, когда ребенок либо обнаруживает в себе этот ресурс, либо нет. Вы здесь — главная переменная.
        </p>
      </div>

      <div class="mb-8">
        <div class="relative w-full" style="padding-top: 56.25%">
          <iframe
            src="https://kinescope.io/embed/bzcM78WGX8orERDY4Wn1Zp"
            title="Первые дни в лагере — как это выглядит"
            loading="lazy"
            class="absolute inset-0 w-full h-full rounded-xl"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media;"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Четыре ошибки, которые затягивают адаптацию
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не спрашивайте «ты скучаешь?»</strong> Это звучит как забота — а на самом деле это подсказка. Он слышит: «у тебя должна быть скука» — и начинает её обнаруживать. Спросите конкретное: что было на обед, кто живёт в комнате. Факты, не чувства.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не обещайте забрать.</strong> «Если совсем плохо — позвони, приедем» — это не поддержка. Этот запасной выход останется у ребенка в голове и найдётся при малейшем дискомфорте. Если выход есть — зачем справляться?</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не звоните в любое время.</strong> Звонок в середине активности — это выдёргивание ребенка обратно в «дом». Только-только начал включаться в жизнь лагеря — и тут ваш голос, и всё по новой. Договоритесь о конкретном времени и держитесь его.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не просите команду «последить».</strong> Узнать как дела — нормально. Передавать через вожатых «мама скучает и ждёт звонка» — нет. Это не забота, это контрабанда тревоги прямо на смену.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А что можно сделать — и это правда помогает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Здесь хорошая новость: <strong>вы знаете своего ребенка лучше всех на свете</strong> — лучше любого вожатого, психолога и уж точно лучше нас. И это ваш главный инструмент. Только вы можете дать подсказку, которая правда поможет.
        </p>
        <div class="space-y-4 mb-4">
          <div class="border border-slate-200 rounded-xl p-5">
            <p class="text-base font-semibold text-slate-800 mb-2">
              <i class="bi bi-x-circle text-red-400 me-2" aria-hidden="true"></i>
              Худшее, что можно сделать
            </p>
            <p class="text-base leading-[1.6] text-slate-600">Встать в позицию «мы заплатили — вот и воспитывайте, развлекайте, придумывайте, вы же оказываете нам услугу». Так это не работает. Никакой аниматор за деньги не заменит собственного включения: смена — живая среда, в неё ребенок входит сам, а не по щелчку.</p>
          </div>
          <div class="border border-orange-200 bg-orange-50/40 rounded-xl p-5">
            <p class="text-base font-semibold text-slate-800 mb-2">
              <i class="bi bi-check-circle text-orange-500 me-2" aria-hidden="true"></i>
              Лучшее, что можно сделать
            </p>
            <p class="text-base leading-[1.6] text-slate-600">Пообщаться с теми, кто рядом на площадке. У вас есть контакты старших вожатых смены — напишите им. Подскажите про страхи, которыми поделились именно с вами: чего боится, что обычно успокаивает. Мы в рамках имеющихся ресурсов мягко, незаметно постараемся снять это на месте — подсадим к нужным ребятам, дадим роль, в которой раскроется, подойдём сами. Потому что снять страх проще всего тогда, когда знаешь, какой он именно. А знаете это — только вы.</p>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А если тревога нужна вам, а не им
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это тоже нормально, честно. Ни одна смена не обходится без того самого супер-тревожного первохода, который звонит шесть раз в день. Даша знает каждого по имени. Если в этот раз им окажетесь вы — мы не закатим глаза: позвоним, успокоим, пришлём фото, расскажем, как всё там. Это часть работы, и мы её любим.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          А если совсем невмоготу — берите путёвку и приезжайте сами. Место на диванчике, пятиразовое питание и проект с ИИ гарантируем.
        </p>
      </div>

      <div class="mb-8">
        <div class="relative w-full" style="padding-top: 56.25%">
          <iframe
            src="https://kinescope.io/embed/c9oEdi5RS7Q83RdA6hFiZZ"
            title="День в лагере глазами родителя"
            loading="lazy"
            class="absolute inset-0 w-full h-full rounded-xl"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media;"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История Дарьи
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дарья — сооснователь АйДаКемп. Её дочь ездит на смены с 10 лет. Три года — в чужие лагеря, и всякий заезд начинался одинаково: вечерний звонок, слёзы, «тут всё плохо, забери меня».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Даша слушала. Не забирала. Не обещала приехать. Потом дочь начала ездить к нам — это продолжается уже несколько лет, и вечерних звонков со слезами давно нет. Ни одного.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
