---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Адаптация ребёнка в лагере", url: "/stati/adaptaciya-rebenka-v-lagere", icon: "heart", description: "Первый вечер, второй и третий день — изнутри" },
  { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere", icon: "star-fill", description: "6 страхов мамы и что будет на самом деле" },
  { title: "Как подготовить ребёнка к лагерю", url: "/stati/kak-podgotovit-rebenka-k-lageru", icon: "backpack", description: "Что сделать до заезда, чтобы было легче" },
  { title: "Смены 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Ребёнок звонит и плачет «забери меня» — что делать?",
    answer: "Выслушать, сказать что любите, что верите в него и что станет легче — и мягко завершить разговор. Не обещать приехать: запасной выход ребёнок будет искать при первом дискомфорте. По статистике пик тоски приходится на первые три дня, потом проходит само. Если через три-четыре дня лучше не стало — напишите старшему вожатому смены, разберёмся вместе."
  },
  {
    question: "Это правда нормально, что ребёнок хочет домой?",
    answer: "Да. По исследованию психолога Кристофера Тёрбера (329 детей) 83% детей хотя бы раз за смену тоскуют по дому — это почти все. При этом меньше 1% уезжают домой досрочно. Тосковать — норма, не справиться — редкость."
  },
  {
    question: "Сколько длится тоска по дому?",
    answer: "Пик — первые три дня, особенно у тех, кто едет впервые. Потом включается программа, появляются друзья, начинается ритм — и «хочу домой» уходит на фон. К четвёртому-пятому дню большинство уже не вспоминают, что хотели уехать."
  },
  {
    question: "Чем я могу помочь, пока ребёнок в лагере?",
    answer: "Вы знаете своего ребёнка лучше всех. Самое полезное — написать старшему вожатому смены и рассказать, чего он боится и что обычно его успокаивает. Команда мягко и незаметно поможет на месте: подсадит к нужным ребятам, даст роль, в которой он раскроется. Это не контроль — это ключ, который есть только у вас."
  },
  {
    question: "Можно ли звонить ребёнку когда захочется?",
    answer: "Лучше договориться о конкретном времени — например, после ужина — и держаться его. Звонок в середине активности выдёргивает ребёнка обратно «домой» в тот момент, когда он только начал включаться. Один звонок-якорь в день помогает, шесть звонков — затягивают адаптацию."
  }
];
---

<Base
  title="Первые три дня в лагере: почему ребёнок хочет домой — и что делать"
  description="Тоска по дому в первые дни смены — норма, а не сигнал SOS. 83% детей скучают, меньше 1% уезжают. Что НЕ делать родителю и чем реально помочь. Честно от мамы к маме."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/pervye-tri-dnya" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Первые три дня в лагере: почему ребёнок хочет домой — и что делать | АйДаКемп",
        "description": "Тоска по дому в первые дни смены — норма, а не сигнал SOS. Что не делать родителю и чем реально помочь ребёнку-первоходу.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-11",
        "dateModified": "2026-06-11",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pervye-tri-dnya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Первые три дня в лагере", "item": "https://aidacamp.ru/stati/pervye-tri-dnya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Первые три дня: почему ребёнок хочет домой — и что с этим делать"
    subtitle="83% детей хотя бы раз за смену тоскуют по дому. Меньше 1% уезжают. Что происходит в эти дни — и почему почти всё, что хочется сделать в ответ, лучше не делать."
    imageBase="o-lagere"
    imageAlt="Дети в первый день смены в лагере АйДаКемп"
    readTime="7 мин чтения"
    breadcrumbsLast="Первые три дня в лагере"
    daryaQuote="Первые три года дочь ездила в другие лагеря — и каждый раз первые дни заканчивались одинаково: вечерний звонок, слёзы, «забери меня». Я слушала. Не забирала. Не обещала приехать. Потому что знала: первые дни такие. Это пройдёт. И проходило."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если ваш ребёнок поехал в лагерь впервые — поздравляю. Вы, скорее всего, уже готовитесь к звонку. Или он уже был. «Мама, мне тут плохо. Заберите меня».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Расскажу честно, что происходит в эти дни — и почему почти всё, что хочется сделать в ответ, лучше не делать.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Первые три дня — это норма, а не сигнал SOS
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Согласно исследованию психолога Кристофера Тёрбера (Phillips Exeter Academy, 329 детей), <strong>83% детей испытывают тоску по дому хотя бы в один из дней смены</strong>. Почти все. Не слабые и не домашние — просто все.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При этом <strong>меньше 1% уезжают домой досрочно</strong>. То есть: тосковать — нормально. Не справиться — редкость.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Пик приходится на первые три дня. Потом включается программа, появляются люди, начинается жизнь — и «хочу домой» само собой уходит на фон. К четвёртому-пятому дню большинство уже не вспоминают, что вообще хотели уехать.
        </p>

        <figure class="my-6">
          <img
            src="/images/articles/pervye-tri-dnya-adaptaciya.svg"
            alt="Таймлайн эмоционального состояния ребёнка в первые дни смены: пик тоски — первые три дня, к концу недели включение в жизнь лагеря. 83% детей скучают по дому, меньше 1% уезжают досрочно."
            width="680"
            height="427"
            loading="lazy"
            class="w-full max-w-[680px] mx-auto rounded-xl border border-slate-200 bg-white"
          />
          <figcaption class="mt-2 text-center text-[13px] text-slate-400">
            Как меняется настроение в первые дни смены. Данные: Thurber C.A., American Camp Association.
          </figcaption>
        </figure>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему именно первоход
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Первоход — это ребёнок, у которого нет прошлого опыта. Нет внутренней точки опоры «помню, в прошлый раз тоже было странно, а потом стало круто». Он не знает, что «потом» вообще бывает.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          И вот важный момент: решение поехать в лагерь почти всегда принимает родитель, не ребёнок. Ребёнок согласился — но это не то же самое, что захотел. Вы ему плохого не посоветовали, и он это тоже знает. Просто когда становится некомфортно, у него нет внутреннего «я сам выбрал — значит буду держаться». Есть только «меня сюда привезли».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не трагедия. Это просто контекст, который важно понимать.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Это как садик
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Помните первые недели в садике? Слёзы на пороге. «Не уходи». Иногда — крики. Через полчаса после того, как вы ушли, ребёнок уже строил башню из кубиков и думать забыл про расставание.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В лагере то же самое. Только дети постарше, и манипуляции стали немного взрослее и сложнее. Не «хочу домой» с рёвом у двери, а «тут все злые», «мне никто не нравится», «еда невкусная». Это не факты о лагере. Это способ сказать: мне сейчас непривычно и я хочу туда, где всё знакомо.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Механизм тот же, что в садике. И точно так же — проходит само, как только новое место становится своим.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Дети переокружены заботой. И это проблема
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы живём в эпоху, когда ребёнок практически никогда не остаётся один на один с дискомфортом. Не понравилась еда — другая. Скучно — телефон. Страшно — мама рядом.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не плохое родительство. Это любовь. Но у неё есть побочный эффект: дети разучились переживать дискомфорт. Они не знают, что неприятное чувство можно просто пережить. Что пройдёт само. Что можно потерпеть — и через час будет нормально.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере это встречается с реальностью. И первые три дня — это как раз момент, когда ребёнок либо обнаруживает в себе этот ресурс, либо нет. Родитель в этот момент — главная переменная.
        </p>
      </div>

      <div class="mb-8">
        <div class="relative w-full" style="padding-top: 56.25%">
          <iframe
            src="https://kinescope.io/embed/bzcM78WGX8orERDY4Wn1Zp"
            class="absolute inset-0 w-full h-full rounded-xl"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media;"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что НЕ нужно делать (и почему)
          </h2>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не спрашивайте «ты скучаешь?»</strong> Это звучит как забота — а на самом деле это подсказка. Ребёнок слышит: «у тебя должна быть скука» — и начинает её обнаруживать. Спросите конкретное: что ел на обед, кто живёт в комнате. Факты, не чувства.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не обещайте забрать.</strong> «Если совсем плохо — позвони, приедем» — это не поддержка. Это запасной выход, который ребёнок будет активно искать при первом же дискомфорте. Если выход есть — зачем справляться?</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не звоните в любое время.</strong> Звонок в середине активности — это выдёргивание обратно в «дом». Ребёнок только-только начал включаться — и тут ваш голос, и всё по новой. Договоритесь о конкретном времени и держитесь его.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1" aria-hidden="true"></i>
            <span class="text-[16px] leading-[1.6] text-slate-700"><strong>Не просите вожатых «последить».</strong> Попросить подсмотреть, как ребёнок, — нормально. Передавать через вожатых «мама скучает и ждёт звонка» — нет. Это не забота, это контрабанда тревоги прямо в лагерь.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А что можно сделать — и это правда помогает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Здесь хорошая новость: <strong>вы знаете своего ребёнка лучше всех на свете</strong> — лучше любого вожатого, психолога и уж точно лучше нас. И это ваш главный инструмент. Вы можете дать совет, который правда поможет.
        </p>
        <div class="space-y-4 mb-4">
          <div class="border border-slate-200 rounded-xl p-5">
            <p class="text-[15px] font-semibold text-slate-800 mb-2">
              <i class="bi bi-x-circle text-red-400 me-2" aria-hidden="true"></i>
              Худшее, что можно сделать
            </p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Встать в позицию «мы заплатили — вот и воспитывайте, развлекайте, придумывайте, вы же оказываете нам услугу». Так это не работает. Лагерь — не аниматор за деньги. Это живая среда, в которую ребёнок включается сам, а не по щелчку.</p>
          </div>
          <div class="border border-orange-200 bg-orange-50/40 rounded-xl p-5">
            <p class="text-[15px] font-semibold text-slate-800 mb-2">
              <i class="bi bi-check-circle text-orange-500 me-2" aria-hidden="true"></i>
              Лучшее, что можно сделать
            </p>
            <p class="text-[14px] leading-[1.6] text-slate-600">Пообщаться с теми, кто рядом с ребёнком на площадке. У вас есть контакты старших вожатых смены — напишите им. Подскажите про страхи, которыми ребёнок поделился именно с вами: чего боится, что обычно его успокаивает. А мы в рамках имеющихся ресурсов мягко, незаметно постараемся снять это на месте — подсадим к нужным ребятам, дадим роль, в которой он раскроется, подойдём первыми. Потому что снять детский страх проще всего тогда, когда знаешь, какой он именно. А знаете это — вы.</p>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А если психотерапия нужна не ребёнку, а вам
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это тоже нормально, честно. В каждой смене есть тот самый супер-тревожный родитель, который беспокоится и звонит шесть раз в день. Даша знает каждого такого по имени. Если в этот раз им окажетесь вы — мы не закатим глаза: позвоним, успокоим, пришлём фото, расскажем, как он там. Это часть работы, и мы её любим.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          А если совсем невмоготу — берите путёвку и приезжайте сами. Место на диванчике, пятиразовое питание и проект с ИИ гарантируем.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История Дарьи
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дарья — сооснователь АйДаКемп. Её дочь ездит в лагерь с 10 лет. Первые три года были в других лагерях — и каждый раз первые дни заканчивались одинаково: вечерний звонок, слёзы, «тут всё плохо, я хочу домой».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
