---
import { PRICE_MIN } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Полный гид: зависимость от гаджетов", url: "/zavisimost-ot-gadzetov/", icon: "grid", description: "8 статей о детской гаджет-зависимости — все темы в одном месте" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-x", description: "Цифровой детокс 10–14 дней" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "rocket-takeoff", description: "12–14 лет" },
  { title: "AI-лагерь", url: "/ai-lager", icon: "cpu", description: "Экран по делу — AI-проекты" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
];
---

<Base
  title="Норма экранного времени для детей по ВОЗ 2026 — по возрастам"
  description="Сколько времени детям можно проводить за экраном по рекомендациям ВОЗ и педиатров: 2–5 лет, 6–10 лет, 11–17 лет. Что считается, что нет."
  ogImage="/images/articles/bez-telefonov-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/ekrannoe-vremya-detej-norma" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Экранное время детей — нормы, риски и как найти баланс",
      "description": "Сколько экранного времени можно детям по нормам ВОЗ и педиатров. Признаки избытка, как считать время, роль летнего отдыха без экранов.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/ekrannoe-vremya-detej-norma"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько часов в день ребёнок может проводить за экраном?",
          "acceptedAnswer": { "@type": "Answer", "text": "По рекомендациям ВОЗ: дети до 2 лет — не рекомендуется вообще; 2–5 лет — не более 1 часа в день; 6–17 лет — не более 2 часов развлекательного экрана. Учёба за компьютером считается отдельно." }
        },
        {
          "@type": "Question",
          "name": "Как снизить экранное время ребёнка без конфликтов?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ключевой принцип — замена, а не запрет. Дайте альтернативу: спорт, творчество, живое общение, интересное хобби. IT-лагерь — один из лучших способов: ребёнок работает за экраном продуктивно, а не пассивно." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста можно давать ребёнку телефон?",
          "acceptedAnswer": { "@type": "Answer", "text": "Рекомендации разнятся: большинство психологов советуют не раньше 10–12 лет. Смартфон с соцсетями — с 12–14 лет. Но важнее не возраст, а правила использования: что смотрит, сколько, когда." }
        },
        {
          "@type": "Question",
          "name": "Вредно ли программирование с точки зрения экранного времени?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Программирование — активное экранное время: ребёнок создаёт, решает задачи, думает. В отличие от пассивного (соцсети, видео), оно развивает логику и концентрацию." }
        },
        {
          "@type": "Question",
          "name": "Отличается ли вред от мультиков и от YouTube?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Мультики с нарративом (история, персонажи) — более «медленный» контент, мозг успевает обрабатывать. YouTube Shorts и TikTok — быстрые петли по 15–60 секунд, которые приучают мозг к гиперстимуляции. После такого контента обычные занятия кажутся скучными. Это и есть начало проблемы с вниманием." }
        },
        {
          "@type": "Question",
          "name": "Считается ли время в видеозвонках экранным?",
          "acceptedAnswer": { "@type": "Answer", "text": "Педиатры относят видеозвонки к «коммуникативному» использованию экрана — это менее вредная категория, чем пассивный просмотр или игры. ВОЗ и AAP делают исключение для видеосвязи с родственниками даже для детей до 2 лет. Но всё равно ограничение по времени актуально — из-за нагрузки на глаза и осанку." }
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Норма экранного времени для детей по ВОЗ 2026", "item": "https://aidacamp.ru/stati/ekrannoe-vremya-detej-norma/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Экранное время детей — нормы и как найти баланс"
    subtitle="Сколько можно, как считать правильно и почему не всё экранное время одинаково."
    imageBase="bez-telefonov"
    imageAlt="Ребёнок за экраном — как найти баланс экранного времени"
    readTime="7 мин чтения"
    breadcrumbsLast="Экранное время детей"
    daryaQuote="Я долго пыталась считать экранные часы у дочери. Потом поняла: важнее не сколько, а что она делает на экране. Смотрит ролики 4 часа — одно. Программирует 4 часа — совсем другое."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Вопрос «сколько можно сидеть в телефоне» — один из самых частых у родителей школьников. Ответ не такой однозначный, как хотелось бы: нормы есть, но они не про часы. Разбираем, что говорят педиатры, как считать правильно и что помогает найти баланс без скандалов.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Нормы экранного времени — что говорят педиатры</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          ВОЗ даёт чёткие рекомендации только для маленьких детей: до 2 лет — экраны нежелательны совсем, 2–5 лет — не больше 1 часа в день. Для детей старше 5 лет и подростков жёстких норм нет — формулировка «разумное ограничение с балансом физической активности».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Российские педиатры ориентируются на 1–2 часа в будни для школьников — без учёта учёбы за компьютером. В выходные и каникулы рамки мягче, но педиатры советуют сохранять ритм: не больше 3–4 часов «развлекательного» экрана в день.
        </p>
        <StatCallout
          value="1-2 часа"
          label="в день — рекомендация педиатров для школьников в будни. В выходные и каникулы — гибче, но с балансом."
          source="Рекомендации ВОЗ и педиатров, 2023"
          icon="clock"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Всё экранное время одинаковое?</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нет, и это принципиальный момент. Педиатры и психологи всё чаще говорят о разнице между активным и пассивным использованием экрана.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Активное использование</strong> — программирование, создание видео или музыки, учёба, общение с друзьями, решение задач. Ребёнок что-то создаёт или взаимодействует осмысленно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Пассивное использование</strong> — бесконечный скролл, просмотр роликов без цели, игры с простой петлёй вознаграждения (открыть кейс, получить лут). Мозг потребляет, не производя ничего.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Разница принципиальная. Если ребёнок три часа пишет свою игру на Python — это не то же самое, что три часа TikTok. Считайте время иначе.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Признаки что экранного времени слишком много</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не часы — главный сигнал. Смотрите на поведение:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Нарушения сна</strong> — ребёнок в телефоне до часу ночи, утром не может встать, днём вялый</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Агрессия при изъятии</strong> — попытка забрать телефон вызывает сильную эмоциональную реакцию</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Отказ от живого общения</strong> — друзья, прогулки, семейный ужин — всё это скучнее, чем экран</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Снижение успеваемости</strong> — ребёнок не успевает делать домашние задания, теряет концентрацию</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Нет других интересов</strong> — кроме экрана ничего не радует, от всего отказывается</span>
          </li>
        </ul>
        <StatCallout
          value="73%"
          label="подростков используют смартфон в постели перед сном, что нарушает циркадные ритмы — исследования нарушений сна у детей"
          source="Исследования по детскому сну, 2024"
          icon="exclamation-triangle"
          tone="warn"
        />
      </div>

      <BlogCTA variant="detox" />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Нормы ВОЗ по возрастам — точные цифры</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          ВОЗ и Американская академия педиатрии (AAP) дают конкретные рекомендации. Вот что говорит доказательная база:
        </p>
        <div class="space-y-3 mb-5">
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">0–2</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Экран не рекомендован совсем</p>
              <p class="text-base leading-[1.6] text-slate-600">Исключение — видеозвонки с близкими. В остальном: мозг в этом возрасте формирует нейронные связи через тактильный опыт, а не через экран.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">2–5</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Не более 60 минут в день</p>
              <p class="text-base leading-[1.6] text-slate-600">Только качественный образовательный контент. Не YouTube Shorts — а мультики с нарративом или развивающие приложения. Лучше вместе с родителем.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">6–12</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">До 2 часов развлекательного экрана</p>
              <p class="text-base leading-[1.6] text-slate-600">Учёба за компьютером — отдельно, не считается. Важно сохранять баланс: спорт, прогулки, живое общение со сверстниками.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">13+</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Нет жёсткого лимита — есть принципы</p>
              <p class="text-base leading-[1.6] text-slate-600">ВОЗ не называет конкретных часов для подростков — формулировка «разумный баланс с физической активностью и сном». Практически: не более 3–4 часов досугового экрана в будни, спальня без телефона.</p>
            </div>
          </div>
        </div>
        <p class="text-base text-slate-400">Источники: ВОЗ (2019), American Academy of Pediatrics (2016, обновление 2023), Российские педиатрические рекомендации.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Как считать время правильно</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Встроенные инструменты работают хорошо: «Экранное время» на iPhone и iPad, Digital Wellbeing на Android. Они показывают не просто общие часы, а разбивку по приложениям — это главное.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смотрите на категории: сколько уходит на соцсети и видео, сколько на образование и общение. Если соцсети занимают 80% — это сигнал. Если ребёнок 2 часа в Duolingo и час в YouTube — совсем другой разговор.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И главное — не устраивайте разборы «ты вчера сидел 4 часа». Это не работает и создаёт только конфликт. Лучше договориться про правила заранее — спокойно и как с равным.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Летний отдых как перезагрузка</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лето — хороший момент снизить экранное время органично. Не через запрет, а через замену: лагерь, прогулки, спорт, встречи с друзьями вживую. Когда жизнь насыщенная — телефон сам отходит на второй план.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере мы не забираем телефоны. Просто там всё время что-то происходит — занятия, бассейн, хакатон, игры вечером. Ребёнок возвращается домой и иногда замечает, что вообще не открывал Instagram две недели. Это органика, не насилие.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">В АйДаКемп: IT плюс живая жизнь</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это кажется парадоксом: IT-лагерь, а дети проводят меньше времени в телефоне. Но логика простая: компьютер используется для создания, а не потребления. Ребёнок пишет игру, решает задачи, делает проект. Это совсем другое состояние, чем скролл.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После IT-занятий — бассейн, спортивные игры, мафия до полуночи. Телефон просто не нужен — живые события интереснее. И это лучшая «детоксикация» от экрана, которую мы знаем: не запрет, а конкуренция.
        </p>
      </div>


      <!-- Сводная таблица норм ВОЗ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нормы экранного времени по ВОЗ — сводная таблица
          </h2>
        </div>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-base border-collapse">
            <thead>
