---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import FAQ from '../../components/FAQ.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Полный гид: зависимость от гаджетов", url: "/zavisimost-ot-gadzetov/", icon: "grid", description: "8 статей о детской гаджет-зависимости — все темы в одном месте" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Цифровой детокс 10–14 дней" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "rocket-takeoff", description: "12–14 лет" },
  { title: "AI-лагерь", url: "/ai-lager/", icon: "cpu", description: "Экран по делу — AI-проекты" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];
---

<Base
  title={`Норма экранного времени по ВОЗ ${SEASON_YEAR}: сколько можно сидеть в телефоне`}
  description="Норма экранного времени для детей по ВОЗ: сколько можно сидеть в телефоне и за компьютером. Нормы по возрасту — 2–5, 6–10 и 11–17 лет."
  ogImage="/images/articles/bez-telefonov-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Экранное время детей — нормы, риски и как найти баланс",
      "description": "Сколько экранного времени можно детям по нормам ВОЗ и педиатров. Признаки избытка, как считать время, роль летнего отдыха без экранов.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/ekrannoe-vremya-detej-norma"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Норма экранного времени для ребёнка по возрастам: рекомендации ВОЗ"
    subtitle="Что можно, а что нет, как считать правильно и почему не всё экранное время одинаково."
    imageBase="bez-telefonov"
    imageAlt="Ребёнок за экраном — как найти баланс времени у экрана"
    readTime="7 мин чтения"
    breadcrumbsLast="Экранное время детей"
    daryaQuote="Я долго пыталась считать экранные часы у дочери. Потом поняла: важнее не сколько, а что она делает на экране. Смотрит ролики 4 часа — одно. Программирует 4 часа — совсем другое."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Вопрос «сколько можно сидеть в телефоне» — один из самых частых у родителей школьников. Время использования телефона и подходящий возраст для первого гаджета — тема, где однозначного ответа нет: нормы есть, но они не про часы. Разбираем, что говорят педиатры, как считать правильно для ребёнка любого возраста и что помогает найти баланс без скандалов.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Нормы экранного времени — что говорят педиатры</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          ВОЗ даёт чёткие рекомендации только для маленьких детей: до 2 лет — экраны нежелательны совсем, 2–5 — не больше 1 часа в сутки. Для ребёнка старше пяти и для подростков жёстких норм нет — формулировка «разумное ограничение с балансом физической активности».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Педиатры в России ориентируются на 1–2 часа в будни, без учёта учёбы за компьютером — если ребёнок программирует или делает уроки за компьютером, это отдельная история. В выходные и каникулы рамки мягче, но педиатры советуют сохранять ритм: не больше 3–4 часов в сутки смотреть ролики.
        </p>
        <StatCallout
          value="1-2 часа"
          label="в сутки — рекомендация педиатров для школьников в будни. В выходные и каникулы — гибче, но с балансом."
          source="Рекомендации ВОЗ и педиатров, 2023"
          icon="clock"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Всё экранное время одинаковое?</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нет, и это принципиальный момент. Педиатры и психологи всё чаще говорят о разнице между активным и пассивным использованием экрана.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Активное использование</strong> — это когда дети садятся за компьютером не ради скролла, а ради дела: программируют, создают видео или музыку, учатся, общаются с друзьями, решают задачи. Ребёнок создаёт или взаимодействует осмысленно — можно сказать, компьютер тут работает на него, а не наоборот.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Пассивное использование</strong> — бесконечный скролл, привычка часами смотреть ролики без цели, желание просто играть ради простой петли вознаграждения (открыть кейс, получить лут). Мозг потребляет, не производя ничего.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Разница принципиальная. Если ребёнок три часа пишет свою игру на Python — это не то же самое, что три часа TikTok. Считайте время иначе, а не по часам на экране: у одного ребёнка это будет один результат, у другого — совсем другой.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Признаки, что ребенок сидит у экрана слишком долго</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не часы — главный сигнал. В любом возрасте смотрите, как ребёнок ведёт себя в обычной жизни, он сам подскажет, где перебор:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Нарушения сна</strong> — ребёнок допоздна сидит с гаджетом, до часу ночи, утром не может встать, а после обеда клюёт носом</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Агрессия при изъятии</strong> — попытка забрать гаджет вызывает у ребёнка сильную эмоциональную реакцию</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Отказ от живого общения</strong> — друзья, прогулки, семейный ужин — всё это скучнее, чем экран, если он раз за разом выбирает ленту вместо них</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Снижение успеваемости</strong> — ребёнок не успевает делать домашние задания, теряет концентрацию</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-exclamation-triangle text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Нет других интересов</strong> — кроме экрана ничего не радует, от всего отказывается</span>
          </li>
        </ul>
        <StatCallout
          value="73%"
          label="подростков используют смартфон в постели перед сном, что нарушает циркадные ритмы — исследования нарушений сна у детей"
          source="Исследования по детскому сну, 2024"
          icon="exclamation-triangle"
          tone="warn"
        />
      </div>

      <BlogCTA variant="detox" />

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Нормы ВОЗ по возрастам — точные цифры</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          ВОЗ и Американская академия педиатрии (AAP) дают конкретные рекомендации. Вот что говорит доказательная база:
        </p>
        <div class="space-y-3 mb-5">
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">0–2</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Экран не рекомендован совсем</p>
              <p class="text-base leading-[1.6] text-slate-600">Исключение — видеозвонки с близкими. В остальном: мозг ребёнка в этом возрасте формирует нейронные связи через тактильный опыт, а не через экран.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">2–5</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Не более 60 минут в сутки</p>
              <p class="text-base leading-[1.6] text-slate-600">Только качественный образовательный контент. Не YouTube Shorts — а мультики с нарративом или развивающие приложения. Лучше, если ребенок смотрит вместе с родителем.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">6–12</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">До 2 часов развлекательного экрана</p>
              <p class="text-base leading-[1.6] text-slate-600">Учёба за компьютером — отдельно, не считается. Важно, чтобы ребёнку хватало баланса: спорт, прогулки, живое общение со сверстниками.</p>
            </div>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 flex gap-4 items-start">
            <div class="shrink-0 w-16 text-center">
              <span class="text-[22px] font-bold text-slate-900">13+</span>
              <p class="text-base text-slate-400 mt-0.5">лет</p>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Нет жёсткого лимита — есть принципы</p>
              <p class="text-base leading-[1.6] text-slate-600">ВОЗ не называет конкретных часов для подростков — формулировка «разумный баланс с физической активностью и сном». Практически: не более 3–4 часов досугового экрана в будни у ребёнка, спальня без гаджета.</p>
            </div>
          </div>
        </div>
        <p class="text-base text-slate-400">Источники: ВОЗ (2019), American Academy of Pediatrics (2016, обновление 2023), Российские педиатрические рекомендации.</p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Отдельный вопрос — когда ребенок может завести смартфон с соцсетями: специалисты советуют не торопиться, ближе к 14, чем сразу в начальной школе.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Как считать время правильно</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Встроенные инструменты работают хорошо: «Экранное время» на iPhone и iPad, Digital Wellbeing на Android. Они показывают не просто общие часы, а разбивку времени по приложениям — это главное.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смотрите на категории: что уходит на соцсети и видео, а что — на образование и общение. Если соцсети занимают 80% — это сигнал для родителя. Если ребёнок 2 часа в Duolingo и час в YouTube — совсем другой разговор, тут можно особо не переживать.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И главное — не устраивайте разборы «ты вчера сидел 4 часа». Это не работает и создаёт только конфликт. Лучше договориться с ребёнком про правила — спокойно, как с равным, и заранее объяснить, что можно, а что нет.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Летний отдых как перезагрузка</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лето — хороший момент снизить экранное время органично, если ребёнку это в радость, а не в наказание. Не через запрет, а через замену: лагерь, прогулки, спорт, встречи с друзьями вживую. Когда жизнь насыщенная — гаджет сам отходит на второй план.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере мы не забираем телефоны. Просто там всё время что-то происходит, и внимание ребёнка занято живыми делами — занятия, бассейн, хакатон, игры вечером. Ребёнок возвращается домой и иногда замечает, что вообще не открывал Instagram две недели — она сама удивляется, что ни разу не вспомнила про ленту. Это органика, не насилие.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">В АйДаКемп: IT плюс живая жизнь</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это кажется парадоксом: IT-лагерь, а дети за компьютером проводят меньше времени в телефоне. Компьютер тут — инструмент созидания: ребенок садится за компьютер, чтобы построить что-то своё, а не спрятаться от реальности. Он пишет игру, решает задачи. Это совсем другое состояние, чем скролл.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После IT-занятий — бассейн, спортивные игры, мафия до полуночи. Гаджет просто не нужен — живые события интереснее ребёнку, чем лента. И это лучшая «детоксикация» от экрана, которую мы знаем: не запрет, а конкуренция.
        </p>
      </div>


      <!-- Сводная таблица норм ВОЗ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нормы времени у экрана по ВОЗ — сводная таблица
          </h2>
        </div>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-base border-collapse">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tl-xl">Возраст</th>
                <th class="text-left p-3 font-semibold text-slate-700">Рекомендация ВОЗ</th>
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tr-xl">Что включается</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="p-3 font-medium text-slate-700">До 2 лет</td>
                <td class="p-3 text-slate-600">0 минут (кроме видеозвонков)</td>
                <td class="p-3 text-slate-600">Любые экраны</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="p-3 font-medium text-slate-700">2–5 лет</td>
                <td class="p-3 text-slate-600">До 1 часа в сутки</td>
                <td class="p-3 text-slate-600">ТВ, планшет, телефон</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="p-3 font-medium text-slate-700">6–10 лет</td>
                <td class="p-3 text-slate-600">До 2 часов в сутки</td>
                <td class="p-3 text-slate-600">Развлекательный контент</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-slate-700 rounded-bl-xl">11–17 лет</td>
                <td class="p-3 text-slate-600">Нет жёсткого лимита</td>
                <td class="p-3 text-slate-600 rounded-br-xl">Акцент на качество контента</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 italic max-w-[720px]">Образовательное использование (программирование, учёба за компьютером) — отдельная категория для ребёнка любого возраста, не входит в лимит по рекомендациям большинства педиатров. Например, за 10 дней в лагере такого «образовательного» экрана набегает немало, а вот тревоги за него нет.</p>
      </div>

      <BlogCTA variant="detox" />
    </article>

