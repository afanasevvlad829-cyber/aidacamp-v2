---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';
import { SEASON_FROM_TO } from '../../data/evergreen';

const faqItems = [
  {
    question: "Что покрывает страховка НС — и что не покрывает?",
    answer: "Покрывает: травмы и переломы (выплата в % от страховой суммы), ожоги, вывихи, экстренную стоматологию при травме зуба. НЕ покрывает: плановое лечение (ОРВИ, аллергии, хронические болезни), плановую стоматологию, лекарства по рецепту — для этого нужен расширенный полис с медицинскими расходами."
  },
  {
    question: "Нужна ли дополнительная страховка, если в путёвке уже есть базовая?",
    answer: "Зависит от суммы покрытия. Стандартная страховка лагеря — обычно 50 000–100 000 ₽, при серьёзной травме этого может не хватить. Дополнительный полис НС на 200 000–500 000 ₽ стоит 300–800 ₽ и оформляется за 5 минут онлайн."
  },
  {
    question: "Что делать, если ребёнок получил травму в лагере?",
    answer: "Алгоритм такой: 1) Лагерный медик оказывает первую помощь и фиксирует факт травмы. 2) Родителям сообщают о произошедшем. 3) При серьёзной травме вызывается скорая или ребёнка везут в ближайшую больницу. 4) Для страховой выплаты нужны: медицинская справка о травме, акт о несчастном случае (лагерь обязан его составить), документы о расходах. Сохраняйте все бумаги — они понадобятся при подаче заявления в страховую."
  },
  {
    question: "Какая страховка есть у АйДаКемп и нужна ли своя?",
    answer: "В стоимость входит страхование ответственности туроператора (Росгосстрах) — оно защищает вас как клиента. Личную страховку ребёнка от несчастных случаев на время смены родитель оформляет самостоятельно: по закону выгодоприобретателем должен быть сам родитель. Это недорого — 300–800 ₽ и 5 минут онлайн; рекомендуем оформить до заезда."
  }
];

const relatedPages = [
  { title: "Купить путёвку", url: "/putevka-v-lager/", icon: "credit-card", description: "Оплата и документы" },
  { title: "Детский лагерь в Подмосковье", url: "/detskiy-lager-podmoskove/", icon: "houses", description: "Закрытая территория, охрана" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Что входит в стоимость" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Безопасность и условия" },
];
---

<Base
  title={`Страховка ребёнка для детского лагеря ${SEASON_YEAR}: нужна ли, как оформить полис онлайн от несчастного случая`}
  description={`Страховка ребёнка для детского лагеря: нужна ли, что покрывает полис от несчастного случая и как оформить страхование онлайн в ${SEASON_YEAR} году. Сравнение условий страховых компаний.`}
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": `Страховка в детский лагерь ${SEASON_YEAR} — нужна ли и какую выбрать`,
      "description": `Страховка для ребёнка в лагерь: нужна ли дополнительная к ОМС, какие риски покрывает, что выбрать в ${SEASON_YEAR}. Подборка страховых компаний.`,
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-04-24",
      "dateModified": "2026-04-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/strakhovka-v-lager"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": `Страховка в детский лагерь ${SEASON_YEAR}`, "item": "https://aidacamp.ru/stati/strakhovka-v-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Страховка ребёнка для детского лагеря: нужна ли и как оформить"
    subtitle="ОМС есть у всех. Но это не то же самое, что страховка от несчастного случая. Разбираемся, в чём разница и нужна ли вам дополнительная защита."
    imageBase="kuda-letom"
    imageAlt="Ребёнок в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Страховка в лагерь"
    daryaQuote="Я долго думала: зачем страховка если у ребёнка есть полис ОМС? Оказывается, ОМС — это про лечение. А страховка НС — это про то, что произошло. Разница есть."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Есть же полис ОМС, зачем ещё что-то?» — но ОМС и страховка от несчастных случаев решают разные задачи. Разбираем коротко.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">ОМС и дополнительная страховка — в чём разница</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          ОМС даёт бесплатное лечение по стандартам — в государственной больнице, в плановом режиме. Он покрывает помощь, но не компенсирует сам несчастный случай.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что ОМС не даёт:
        </p>
        <ul class="list-none space-y-2 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Денежной выплаты при переломе, вывихе или ожоге</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Покрытия стоматологических расходов (кроме острой боли)</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Компенсации расходов на транспортировку ребёнка</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Быстрого получения денег — без очередей и бюрократии</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Страховка от несчастных случаев (НС) — отдельный полис: деньги выплачиваются напрямую родителям, по таблице выплат в зависимости от тяжести травмы.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Что покрывает страховка НС для лагеря</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Стандартный полис НС для ребёнка в лагере обычно включает:
        </p>
        <ul class="list-none space-y-2 mb-6">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-shield-check text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Травмы и переломы — выплата по таблице</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-shield-check text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Ожоги и вывихи</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-shield-check text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Экстренная стоматология</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-shield-check text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Экстренная госпитализация</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-shield-check text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>В некоторых программах — отмена поездки по уважительной причине</span>
          </li>
        </ul>
        <StatCallout
          value="от 300 ₽"
          label="стоит базовая страховка ребёнка на 2 недели лагеря при страховой сумме 200–500 тыс. ₽"
          source={`Средняя цена по рынку ${SEASON_YEAR}`}
          icon="shield-check"
          tone="info"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Нужна ли страховка если лагерь официальный</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Да. Лицензированный лагерь обязан иметь медпункт и медработника, но ответственность организации юридически ограничена: её страховка покрывает только гражданскую ответственность, выплаты минимальны.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Личную страховку НС оформляют именно поэтому: она не зависит от того, кто «виноват» — ребёнок упал и сломал руку, выплата придёт независимо от иска к лагерю.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Подборка страховых для лагеря {SEASON_YEAR}</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Варианты с онлайн-оформлением (не реклама — сверяйте условия перед покупкой):
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Сбербанк Страхование</strong> — «Дети — застрахованы», онлайн за 5 минут</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>РЕСО-Гарантия</strong> — полис НС для детей, офис или онлайн</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Ингосстрах</strong> — продукт «Мой ребёнок»: НС + медицинские расходы + стоматология в одном полисе</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Альфастрахование</strong> — «Летний лагерь», экспресс-оформление, конкурентная цена</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-arrow-right text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>ВСК</strong> — недорогой полис НС онлайн, удобен для одной смены</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Уточняйте: покрывает ли полис период в лагере, страховую сумму и порядок выплат.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Как оформить страховку быстро</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Оформить страховку онлайн можно за 5–10 минут. Вам понадобятся:
        </p>
        <ul class="list-none space-y-2 mb-6">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>ФИО ребёнка и дата рождения</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Срок действия полиса — период смены плюс 1–2 дня с каждой стороны</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Страховая сумма — рекомендуем от 200 000 ₽</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-check-lg text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span>Email для получения полиса</span>
          </li>
        </ul>
        <StatCallout
          value="5–10 минут"
          label="— время оформления страховки онлайн. Лучше сделать сейчас, чем искать её в день отъезда"
          source="По опыту родителей"
          icon="clock"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">В АйДаКемп: медицинское обеспечение</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Медик дежурит круглосуточно, медпункт на территории. О любом инциденте сразу сообщаем родителям.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Личное страхование от несчастных случаев — дополнительное спокойствие: ребята активны, иногда падают, и это нормально.
        </p>
      </div>


      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Что делать если ребёнок травмировался в лагере</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Алгоритм действий при страховом случае — чтобы не растеряться в нужный момент:
        </p>
        <div class="space-y-3 mb-4">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">1</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Медик лагеря оказывает помощь и составляет акт</p>
              <p class="text-base leading-[1.6] text-slate-600">Перелом, вывих, ожог — лагерь обязан составить акт о несчастном случае. Этот документ понадобится страховой.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">2</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Сохраните все медицинские документы</p>
              <p class="text-base leading-[1.6] text-slate-600">Справки, снимки, заключения врача, чеки за лечение — всё нужно для заявления. Попросите копию акта при выписке.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">3</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Позвоните в страховую в течение 30 дней</p>
              <p class="text-base leading-[1.6] text-slate-600">Большинство страховых требуют заявление не позднее 30 дней. Горячая линия — на обороте полиса или сайте страховщика.</p>
            </div>
          </div>
        </div>
        <div class="bg-orange-50 border border-orange-100 rounded-[14px] p-4 flex items-start gap-3">
          <i class="bi bi-info-circle text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <p class="text-base leading-[1.6] text-slate-700">Страховая выплата рассчитывается по таблице — например, перелом лучевой кости = 5% от страховой суммы. При страховке на 300 000 ₽ это 15 000 ₽. Таблицу выплат смотрите в условиях конкретного полиса.</p>
        </div>
      </div>

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы о страховке
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

