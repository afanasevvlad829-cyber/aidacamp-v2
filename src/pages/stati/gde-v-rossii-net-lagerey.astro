---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Артек и советские лагеря: как это было", url: "/stati/artek-i-sovetskie-lagerya/", icon: "star-fill", description: "Как рождалась легендарная советская лагерная система" },
  { title: "Лагеря в необычных местах планеты", url: "/stati/lagerya-v-neobychnykh-mestakh/", icon: "globe2", description: "Куда ещё возят детей — от пустыни до тайги" },
  { title: "Мозг без гаджетов в лагере", url: "/stati/mozg-bez-gadgetov-v-lagere/", icon: "cpu", description: "Что говорит наука о цифровом детоксе" },
];
---

<Base
  title="Где в России нет ни одного детского лагеря — и почему | АйДаКемп"
  description="40 000 советских лагерей vs 45 000 сегодня — но охват упал с 40 млн до 6 млн детей. Где в России лагерей практически нет и что с этим делать."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="gde-v-rossii-net-lagerey"
      title="Где в России нет ни одного детского лагеря — и почему"
      description="40 000 советских лагерей vs 45 000 сегодня — но охват упал с 40 млн до 6 млн детей. Где в России лагерей практически нет и что с этим делать."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Где в России нет ни одного детского лагеря — и почему"
    subtitle="40 000 советских лагерей vs 45 000 сегодня — но охват упал с 40 млн до 6 млн детей. Где в России лагерей практически нет и что с этим делать."
    breadcrumbsLast="Где в России нет лагерей"
    readTime="6 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="40" unit=" млн" label="детей ездили в лагеря каждое лето в СССР" tone="orange" size="lg" />
          <AnimatedStat value="6" unit=" млн" label="детей охватывают лагеря сегодня — в 6 раз меньше" tone="red" size="lg" />
          <AnimatedStat value="45000" label="организаций отдыха и оздоровления зарегистрировано в России (включая городские)" tone="slate" size="lg" />
          <AnimatedStat value="17" label="миллионов кв. км — площадь России. Большая часть — без лагерей" tone="blue" size="lg" />
        </div>
      </div>

      <!-- Вступление -->
      <div class="mb-10">
        <div class="rounded-[16px] bg-amber-50 border-l-4 border-amber-400 px-6 py-5">
          <p class="text-[15px] leading-[1.6] text-slate-700">
            Советский Союз создал крупнейшую в мире систему детского отдыха. Сегодня в России формально больше «организаций оздоровления», чем было лагерей в СССР — но их охват в шесть раз меньше. Как так получилось и что это значит для страны с 17 миллионами квадратных километров?
          </p>
        </div>
      </div>

      <!-- Где лагерей практически нет -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Где лагерей практически нет
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-snow text-blue-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-900">Крайний Север</p>
            </div>
            <p class="text-[13px] font-semibold text-slate-700 mb-1">Ямало-Ненецкий АО, Чукотка, Магаданская область</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Суровый климат, малая численность населения, отсутствие туристической инфраструктуры. Лагеря почти исключительно городские, санаторного типа. Полноценного загородного лагеря в понимании «корпуса у реки» здесь практически нет.</p>
          </div>
          <div class="rounded-[16px] bg-orange-50 border border-orange-200 p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-geo-alt text-yellow-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-900">Дальний Восток (малонаселённые районы)</p>
            </div>
            <p class="text-[13px] font-semibold text-slate-700 mb-1">Якутия, Еврейская АО, Амурская область — удалённые районы</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">При огромной площади — крошечная плотность населения. Построить лагерь в 500 км от ближайшего города с персоналом и инфраструктурой — экономически невозможно. Дети летят в Приморье или Сочи.</p>
          </div>
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-globe2 text-green-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-900">Новые регионы</p>
            </div>
            <p class="text-[13px] font-semibold text-slate-700 mb-1">ЛНР, ДНР, Запорожская и Херсонская область</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Инфраструктура оздоровления была ориентирована на украинскую систему. С 2022 года идёт перестройка — детей вывозят в Крым, Краснодарский край и другие регионы России по федеральным программам.</p>
          </div>
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-5">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-tree text-slate-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-900">Сибирь — тайга</p>
            </div>
            <p class="text-[13px] font-semibold text-slate-700 mb-1">Красноярский край, Иркутская область — вне крупных центров</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">В крупных городах (Красноярск, Иркутск) лагеря есть. За пределами городского кольца — огромные пространства без инфраструктуры. Не потому что нет природы — потому что нет дорог и не к кому ехать.</p>
          </div>
        </div>
      </div>

      <!-- Почему в 6 раз меньше детей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему в 6 раз меньше детей — при тех же 45 000 лагерей
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5">
            <p class="text-[15px] font-bold text-red-700 mb-3">СССР, 1970-е</p>
            <div class="space-y-1.5">
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-red-400">&bull;</span><span>40 000 загородных лагерей</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-red-400">&bull;</span><span>Путёвки бесплатные (от профсоюза)</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-red-400">&bull;</span><span>Цель: охватить всех</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-red-400">&bull;</span><span>Смена: 21–24 дня</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-red-400">&bull;</span><span>40 млн детей в год</span></p>
            </div>
          </div>
          <div class="rounded-[16px] bg-green-50 border border-green-200 p-5">
            <p class="text-[15px] font-bold text-green-700 mb-3">Россия сегодня</p>
            <div class="space-y-1.5">
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-green-400">&bull;</span><span>~45 000 организаций — но это включает городские лагеря при школах</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-green-400">&bull;</span><span>Путёвки платные — цена 50 000–150 000 ₽</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-green-400">&bull;</span><span>Цель: рынок + субсидии</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-green-400">&bull;</span><span>Смена: 7–21 день</span></p>
              <p class="text-[13px] leading-[1.5] text-slate-600 flex gap-2"><span class="text-green-400">&bull;</span><span>~6 млн детей в год</span></p>
            </div>
          </div>
        </div>
        <div class="rounded-[16px] bg-amber-50 border-l-4 border-amber-400 px-6 py-5">
          <div class="flex items-start gap-3">
            <i class="bi bi-lightbulb-fill text-amber-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-700">
              Городские лагеря при школах — это тоже организации оздоровления в реестре. Ребёнок, который три недели после уроков ходил в «лагерь» в родном дворе, считается охваченным. Загородный формат с ночёвками и полным погружением — это принципиально другое.
            </p>
          </div>
        </div>
      </div>

      <!-- Карта концентрации лагерей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Карта концентрации лагерей
          </h2>
        </div>
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Краснодарский край, Крым</p>
              <p class="text-[12.5px] text-slate-500">Море, климат, советское наследие</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-green-100 text-green-700">Очень высокая</span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Московская область</p>
              <p class="text-[12.5px] text-slate-500">Крупнейший рынок потребителей</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-green-100 text-green-700">Очень высокая</span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Ленинградская, Тверская, Ярославская</p>
              <p class="text-[12.5px] text-slate-500">Сосны, озёра, близость к мегаполисам</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">Средняя</span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Поволжье, Урал</p>
              <p class="text-[12.5px] text-slate-500">Региональная инфраструктура</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">Средняя</span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Якутия, Чукотка, Магадан</p>
              <p class="text-[12.5px] text-slate-500">Климат, отдалённость, население</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-red-100 text-red-700">Крайне низкая</span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-[12px] bg-white border border-slate-200 px-4 py-3">
            <div class="min-w-0">
              <p class="text-[14px] font-semibold text-slate-900">Дальний Восток (тайга)</p>
              <p class="text-[12.5px] text-slate-500">Нет дорог, нет спроса</p>
            </div>
            <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full bg-red-100 text-red-700">Крайне низкая</span>
          </div>
        </div>
      </div>

      <!-- Что это значит для детей -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что это значит для детей
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Ребёнок, выросший в Сочи или Подмосковье, имеет десятки вариантов лагерей в радиусе 100 км. Ребёнок из Певека или Нерюнгри — практически ни одного. Это не просто неравенство доступа к отдыху. Это неравенство доступа к опыту жизни в коллективе, к первым шагам самостоятельности, к тому, что меняет детей.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[16px] bg-green-50 border border-green-200 p-5 text-center">
            <i class="bi bi-check-circle-fill text-green-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[15px] font-bold text-slate-900 mb-1">Центральная Россия и юг</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Конкуренция между лагерями. Специализации: IT, языковые, спортивные, творческие. Цены от 30 000 до 250 000 ₽ за смену.</p>
          </div>
          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5 text-center">
            <i class="bi bi-x-circle-fill text-red-500 text-[20px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[15px] font-bold text-slate-900 mb-1">Арктика и глубокий Дальний Восток</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Городские «лагеря» при школах. Для полноценного загородного опыта — перелёт за 50 000+ ₽, даже прежде чем платить за путёвку.</p>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="rounded-[16px] bg-blue-50 border border-blue-200 p-6 text-center">
          <i class="bi bi-map text-blue-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Советская система доказала: если государство хочет, лагерный опыт доступен каждому. Современная реальность доказывает другое: когда за него платит рынок, он концентрируется там, где платёжеспособный спрос. Для семей, живущих у трассы на Сочи, это хорошая новость. Для остальных — повод думать.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
