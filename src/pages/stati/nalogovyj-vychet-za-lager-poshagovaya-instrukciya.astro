---
import { PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S4, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const faqItems = [
  {
    question: "За какие лагеря можно получить вычет?",
    answer: "Только за лагеря с образовательной лицензией — то есть за лагеря, которые официально оказывают образовательные услуги. Обычный оздоровительный лагерь без образовательной лицензии под вычет не попадает. IT-лагеря с лицензией — попадают. АйДаКемп имеет образовательную лицензию и выдаёт все нужные документы."
  },
  {
    question: "Можно ли получить вычет за несколько лагерей в один год?",
    answer: "Да. Лимит социального вычета на обучение — 110 000 рублей в год на ребёнка. Если ребёнок ездил в несколько лагерей с образовательной лицензией, расходы суммируются. Возврат — 13% от суммы всех расходов, но не более 14 300 рублей (13% от 110 000 рублей). На практике стоимость одной смены IT-лагеря редко превышает 100 000 рублей, поэтому лимит почти никогда не задействуется."
  },
  {
    question: "Что если я самозанятый или ИП?",
    answer: "Налоговый вычет доступен только плательщикам НДФЛ (13%). Если вы платите НПД как самозанятый или работаете на УСН как ИП — вычет через НДФЛ не получить. Но если у вас есть официальная зарплата по трудовому договору (даже частичная) — с неё можно получить вычет."
  },
  {
    question: "Когда придут деньги после подачи декларации?",
    answer: "Через работодателя — в следующей зарплате после уведомления (обычно 1–2 месяца). Через налоговую — до 4 месяцев: камеральная проверка декларации занимает до 3 месяцев, выплата — ещё до 1 месяца. Если подавать через личный кабинет ФНС онлайн и без ошибок — обычно быстрее, 1,5–2,5 месяца."
  },
  {
    question: "Какие документы даёт АйДаКемп для вычета?",
    answer: "Договор об оказании образовательных услуг с реквизитами организации, справку об оплате образовательных услуг (форма, утверждённая ФНС) и копию образовательной лицензии. Всё это выдаётся автоматически — не нужно специально просить. Если потеряли — обратитесь к нам, вышлем повторно."
  },
  {
    question: "Можно ли вернуть налоговый вычет за прошлые годы?",
    answer: `Да. Срок давности — 3 года. В ${SEASON_YEAR} году можно подать декларацию за 2023, 2024 и 2025 годы одновременно. То есть если вы пропустили вычет за лагерь в прошлые сезоны — деньги ещё не потеряны. Для каждого года нужна отдельная декларация 3-НДФЛ и соответствующие документы того года.`
  }
];

const relatedPages = [
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-coin", description: "Подробная страница о вычете" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Документы для лагеря", url: "/stati/dokumenty-dlya-rebenka-v-lager/", icon: "file-earmark-text", description: "Что взять с собой" },
  { title: "Оплата лагеря", url: "/stati/oplata-detskogo-lagerya/", icon: "credit-card", description: "Рассрочка и способы оплаты" },
];
---

<Base
  title={`Как получить налоговый вычет за детский лагерь — пошаговая инструкция ${SEASON_YEAR} | АйДаКемп`}
  description="Как получить налоговый вычет за детский лагерь через Госуслуги: какие документы собрать, куда загрузить, когда придут деньги. Пошаговая инструкция и реальный опыт родителей АйДаКемп."
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Налоговый вычет за детский лагерь ${SEASON_YEAR} — пошаговая инструкция`,
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-05-03",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/nalogovyj-vychet-za-lager-poshagovaya-instrukciya"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": `Налоговый вычет за детский лагерь ${SEASON_YEAR}`, "item": "https://aidacamp.ru/stati/nalogovyj-vychet-za-lager-poshagovaya-instrukciya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title={`Как получить налоговый вычет за лагерь ${SEASON_YEAR} — через Госуслуги`}
    subtitle="Пошаговая инструкция: документы, сайт, сроки. Без бухгалтеров и очередей в налоговую."
    imageBase="o-lagere"
    imageAlt="Документы для налогового вычета за детский лагерь"
    readTime="7 мин чтения"
    breadcrumbsLast="Налоговый вычет за лагерь"
    daryaQuote="Первый раз я потратила на это три часа и чуть не бросила. Второй раз — 15 минут. Разница только в том, что я заранее знала какие именно бумажки нужны. Вот эта инструкция — чтобы у вас было 15 минут сразу."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-sm text-slate-500 mb-4">Правовая основа: <a href="https://www.consultant.ru/document/cons_doc_LAW_28165/6bce38481d3c84d61c0a61b00498b2d04b7daead/" target="_blank" rel="noopener" class="underline">статья 219 НК РФ, пункт 2</a> — социальный налоговый вычет на обучение. Материал актуален на {SEASON_YEAR} год. Закон требует, чтобы организация вела образовательную деятельность на основании лицензии Минобрнауки — только тогда вычет разрешён.</p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Налоговый вычет за детский лагерь — это социальный вычет на обучение по ст. 219 НК РФ: если ребёнок ездил в детский лагерь с образовательной лицензией, государство возвращает 13% от стоимости. По открытым августовским сменам АйДаКемп возврат составляет от ~{VYCHET_S4} (10 дней) до ~{VYCHET_MAX} (13 дней). Оформляется онлайн через личный кабинет ФНС или Госуслуги.
         Получение вычета — это компенсация за образовательную услугу в путёвке на отдых ребёнка: оформлять можно за прошлые годы, и это не про лечение, а про обучение.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто имеет право на вычет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вычет может получить родитель или опекун ребёнка до 24 лет, который:
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Является налоговым резидентом России (живёт в стране более 183 дней в год)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Платит НДФЛ 13% — то есть работает официально или имеет другой облагаемый доход</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Оплатил обучение в организации с образовательной лицензией</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700">Договор и платёжные документы оформлены на родителя, а не на ребёнка</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы работаете неофициально или как самозанятый без НДФЛ — вычет не положен. Если есть хотя бы частичная официальная зарплата — можно получить с неё.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сколько вернут — конкретные суммы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Формула: 13% от суммы, которую вы заплатили за образовательную часть смены. Для лагерей с лицензией — это стоимость смены минус нормативные расходы на питание и проживание (3 800 рублей в день по нормативу). При расчёте вычета учитывается только образовательная часть стоимости — за питание и проживание вычет не положен.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          13% от стоимости путёвки — сумма, которая возвращается на счёт родителя после подачи декларации.
        </p>

        <StatCallout
          value={`до ${VYCHET_MAX}`}
          label={`максимальный возврат по открытым сменам — за 13-дневную смену. За 10-дневную — от ~${VYCHET_S4}.`}
          icon="cash-coin"
          tone="neutral"
        />

        <div class="space-y-2 mt-5 mb-4">
          {[
            [`Смена 4 — 10 дней (${PRICE_S4})`, `~${VYCHET_S4}`],
            [`Смена 3 — 13 дней (${PRICE_S3})`, `~${VYCHET_MAX}`],
            [`Смена 2.1 (завершена) — 7 дней (${PRICE_S21})`, `~${VYCHET_S21}`],
            [`Смена 2.2 (завершена) — 8 дней (${PRICE_S22})`, `~${VYCHET_S22}`],
            [`Смена 2 (завершена) — 14 дней (${PRICE_S2})`, `~${VYCHET_S2}`],
          ].map(([smena, sum]) => (
            <div class="flex items-center justify-between border border-slate-200 rounded-xl px-4 py-3">
              <span class="text-base text-slate-700">{smena}</span>
              <span class="text-base font-semibold text-orange-600">{sum}</span>
            </div>
          ))}
        </div>
        <p class="text-base leading-[1.6] text-slate-500">
          Суммы расчётные, зависят от конкретных условий смены. Точная сумма указывается в справке об оплате образовательных услуг.
        </p>

        <div class="my-6 rounded-xl bg-blue-50 border border-blue-200 p-5">
          <p class="font-semibold text-slate-800 mb-1">Оба родителя могут получить вычет независимо</p>
          <p class="text-slate-600 text-sm">Каждый родитель получает вычет со своего НДФЛ — на одни и те же расходы. За открытую 13-дневную смену каждый может вернуть до <strong>{VYCHET_MAX}</strong>, а оба вместе — вдвое больше.</p>
        </div>

        <div class="my-6 rounded-xl bg-orange-50 border border-orange-200 p-5">
          <p class="font-semibold text-slate-800 mb-1">АйДаКемп предоставляет полный пакет документов для вычета</p>
          <p class="text-slate-600 text-sm mb-3">Справка об оплате образовательных услуг, договор с номером лицензии — всё приходит автоматически после смены.</p>
          <a href="/ceny/" class="inline-block bg-[#EC7C00] text-white rounded-lg px-4 py-2 text-sm font-semibold hover:bg-orange-700 transition-colors">Посмотреть смены и цены</a>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Какие документы нужны от лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Собрать документы — самое важное. Потом без них вычет не оформить. Необходимо собрать четыре документа — без любого из них налоговая откажет в вычете. Вот что нужно взять у лагеря:
        </p>
        <div class="space-y-3 mb-4">
          {[
            ["Договор об оказании образовательных услуг", "Подписывается при записи. Должен быть оформлен на родителя, а не на ребёнка. Содержит реквизиты организации."],
            ["Справка об оплате образовательных услуг", "Специальная форма, утверждённая приказом ФНС. Лагерь выдаёт по запросу или автоматически. В ней указана именно «образовательная» часть оплаты."],
            ["Копия образовательной лицензии лагеря", "Подтверждает, что лагерь имеет право оказывать образовательные услуги. АйДаКемп выдаёт по запросу."],
            ["Платёжные документы", "Чек, квитанция или банковская выписка, подтверждающая оплату. Сохраняйте все платёжки."],
          ].map(([title, desc], i) => (
            <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
              <div class="w-7 h-7 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center text-base font-bold shrink-0 mt-0.5">{i + 1}</div>
              <div>
                <p class="text-base font-semibold text-slate-800">{title}</p>
                <p class="text-base leading-[1.6] text-slate-500 mt-0.5">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Через Госуслуги — шаг за шагом
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Это самый удобный способ — декларацию можно подать онлайн, не приходя в налоговую.
        </p>
        <div class="space-y-3 mb-4">
          {[
            ["Зайдите в личный кабинет ФНС", "Через сайт nalog.gov.ru или через Госуслуги (вкладка «ФНС России»). Вход через учётную запись Госуслуг. Прямая ссылка: lkfl2.nalog.ru"],
            ["Выберите «Получить налоговый вычет»", "Раздел «Жизненные ситуации» → «Подать декларацию 3-НДФЛ» или воспользуйтесь упрощённым вычетом если доступен."],
            ["Заполните декларацию 3-НДФЛ", "Укажите доходы (ФНС подтянет автоматически из справок 2-НДФЛ от работодателя) и добавьте вычет на обучение ребёнка."],
            ["Загрузите документы", "Скан договора, справки об оплате образовательных услуг, платёжных документов и копии лицензии. Форматы: PDF или JPG."],
            ["Подпишите и отправьте", "Заявление подписывается электронной подписью. Она формируется прямо в личном кабинете ФНС — это занимает несколько минут."],
          ].map(([title, desc], i) => (
            <div class="flex items-start gap-3 bg-slate-50 border border-slate-200 rounded-xl p-4">
              <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">{i + 1}</div>
              <div>
                <p class="text-base font-semibold text-slate-800">{title}</p>
                <p class="text-base leading-[1.6] text-slate-600 mt-0.5">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Через работодателя — как это работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Альтернатива декларации — получить вычет через работодателя. Тогда с ваших ближайших зарплат перестанут удерживать НДФЛ, пока вся сумма вычета не будет выплачена. Это быстрее, чем ждать возврата от ФНС.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Как это сделать: подайте в ФНС заявление на подтверждение права на вычет (через личный кабинет, без декларации). Получите уведомление — и передайте его в бухгалтерию работодателя. Уведомление ФНС сформирует автоматически примерно за 30 дней.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Этот способ удобен если не хочется возиться с декларацией, и вы работаете в одном месте официально.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Упрощённый порядок — без декларации 3-НДФЛ
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С 2021 года часть вычетов можно получить совсем без декларации — через личный кабинет ФНС в разделе «Вычеты → Упрощённый порядок». ФНС сама запрашивает данные у работодателя и формирует заявление. Вы только проверяете и подписываете.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
