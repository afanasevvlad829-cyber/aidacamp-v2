---
import { PRICE_MIN, PRICE_S3, VYCHET_MAX, VYCHET_S21 } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Зависимость от телефона у подростков", url: "/stati/zavisimost-ot-telefona-u-podrostkov", icon: "phone", description: "Признаки и что реально помогает без скандала" },
  { title: "Экранное время — нормы по ВОЗ", url: "/stati/ekrannoe-vremya-detej-norma", icon: "clock", description: "Сколько экрана допустимо по возрастам" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov", icon: "phone-x", description: "Как работает цифровой детокс 10–14 дней" },
  { title: "Подросток ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", icon: "emoji-frown", description: "Апатия или лень — 5 шагов помочь" },
  { title: "IT-лагерь для подростков", url: "/it-lager", icon: "laptop", description: "Превратить экран в дело — программирование и AI" },
];

const faqItems = [
  {
    question: "Заберёте ли телефон на весь срок смены?",
    answer: "Нет, не забираем силой. Телефоны разрешены, но экранное время покупается за внутренние лагерные рубли из дневного бюджета. К третьему-четвёртому дню большинство школьников сами выбирают костёр, бассейн и проект вместо скроллинга. Среднее время за личным телефоном к концу смены — 5–10 минут в день. Не потому что запрещено — потому что не нужно."
  },
  {
    question: "Не будет ли у подростка «ломки» без соцсетей?",
    answer: "Первые два дня могут быть беспокойными — это нормальная реакция на смену среды. Программа первых дней максимально насыщена: знакомства, квест по территории, первый проект. К концу второго дня большинство ребят уже не вспоминают про ленту — слишком много всего происходит."
  },
  {
    question: "А после лагеря снова начнёт сидеть в телефоне?",
    answer: "Полностью исключить это невозможно — смартфон никуда не денется из жизни. Но привычка реально меняется: мы видим это по отзывам мам. Когда подросток умеет создавать игры и AI-проекты сам, пассивный скроллинг становится менее интересным. Это не магия — это другой уровень самооценки и другое отношение к экрану."
  },
  {
    question: "Как объяснить ребёнку, что его отправляют в лагерь?",
    answer: "Не надо объяснять «из-за телефона» — это звучит как наказание. Сработает по-другому: там учат делать игры, как те, в которые он сам играет. Там живые проекты, хакатон, команда. Мотивация через интерес работает лучше, чем через запрет."
  },
  {
    question: "Какой возраст — нужен ли опыт программирования?",
    answer: "Основной возраст 10–14 лет. Опыт не нужен — группы формируются по уровню, начинающие занимаются отдельно. За 7–14 дней с нуля доходят до рабочего проекта: игра, сайт, Telegram-бот или AI-помощник."
  },
  {
    question: "Можно ли оформить налоговый вычет?",
    answer: `Да. АйДаКемп — образовательный лагерь с лицензией Минобра. Вычет от ~${VYCHET_S21} (7-дневная смена) до ~${VYCHET_MAX} (14-дневная) — зависит от длины смены. Все документы для оформления выдаём автоматически после оплаты.`
  }
];
---

<Base
  title="Ребёнок целыми днями в телефоне: куда отдать летом, чтобы не ругаться | АйДаКемп"
  description="«Куда отдать ребёнка если целыми днями в телефоне» — реальный опыт мамы. Запреты не сработали. Что сработало: IT-лагерь, где экран становится инструментом, а не привычкой."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-dlya-rebenka-kotoryy-tselymi-dnyami-v-telefone" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Если ребёнок не вылезает из телефона — отбирать бесполезно. Что сработало у меня",
        "description": "Личный опыт мамы: запреты, родительский контроль, лекции о вреде — ничего не работало. Сработала смена среды: IT-лагерь, где экран становится инструментом, а не привычкой.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-08",
        "dateModified": "2026-06-08",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/lager-dlya-rebenka-kotoryy-tselymi-dnyami-v-telefone"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Ребёнок целыми днями в телефоне: куда отдать летом", "item": "https://aidacamp.ru/stati/lager-dlya-rebenka-kotoryy-tselymi-dnyami-v-telefone/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок целыми днями в телефоне"
    subtitle="Куда отдать летом, чтобы не ругаться — и чтобы сам захотел отложить."
    imageBase="zavisimost-telefona"
    imageAlt="Подросток за работой над IT-проектом — вовлечённость вместо скроллинга"
    readTime="7 мин чтения"
    breadcrumbsLast="Ребёнок целыми днями в телефоне"
    daryaQuote="Я орала. Забирала зарядку. Устанавливала родительский контроль — дочь взломала его за двадцать минут. Помогло не отнять экран, а дать ему смысл."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если вы ищете «куда отдать ребёнка, который целыми днями в телефоне» — вы уже попробовали договориться, ограничить, объяснить. И, скорее всего, это не очень работает. Я прошла через то же самое. Дальше — честно о том, что не сработало, почему, и что в итоге изменило ситуацию.
        </p>

        <StatCallout
          value="7–9 часов"
          label="проводят за экраном подростки 12–17 лет в обычный день по данным 2024 года."
          source="Common Sense Media, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <!-- Заход Дарьи -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            «Я тоже орала — и это не помогало»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Моей дочери было 12, когда я поняла: мы разговариваем с телефоном, а не друг с другом. Ужин — она в ленте. Утро — она в ленте. Я что-то говорю — она смотрит в экран и отвечает «угу».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Я пробовала по-хорошему: объясняла, договаривалась, устанавливала лимиты времени через настройки. Дочь научилась их обходить примерно через неделю. Я пробовала по-плохому: забирала телефон, кричала, угрожала. Это давало час тишины и потом — ещё большую напряжённость в отношениях.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Я читала статьи о зависимости, пересказывала их за ужином. Дочь слушала, кивала — и шла в комнату листать ленту. Через полтора года такого «воспитания» я поняла, что дело не в ней и не в телефоне. Дело в среде.
        </p>

        <div class="rounded-[14px] border border-primary/20 bg-[#fff8f0] p-4 md:p-5 mb-4">
          <p class="text-[15px] leading-[1.65] text-slate-700 italic">
            «Телефон — не проблема, телефон — симптом. Проблема в том, что больше ничего не конкурирует с ним по интересности. Не потому что вы плохая мама — а потому что соцсети на это и рассчитаны.»
          </p>
          <p class="text-[15px] text-slate-500 mt-2 not-italic">— Дарья Афанасьева, основатель АйДаКемп</p>
        </div>
      </div>

      <!-- Почему запреты не работают -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему отобрать телефон — не решение
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда что-то запрещают, мозг фиксируется на запрещённом. Подросток, у которого забрали телефон, думает только о телефоне. Когда возвращают — бросается с удвоенной жадностью. Это не слабоволие. Это физиология.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мозг подростка буквально устроен иначе, чем взрослый: префронтальная кора — часть, отвечающая за самоконтроль — ещё формируется. При этом дофаминовая система работает на полную. TikTok, YouTube Shorts, Reels дают 300–500 коротких вспышек удовольствия в час. Реальная жизнь в таком темпе конкурировать не может. Но может — по глубине.
        </p>

        <ul class="flex flex-col gap-3 mb-5">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Запрет создаёт дефицит</strong> — и одержимость. Подросток будет думать о телефоне больше, чем если бы его не запрещали.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Родительский контроль обходится</strong> — за 20 минут на YouTube найдётся инструкция. А заодно — потеря доверия к вам.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Лекции о вреде</strong> не работают — подросток уже знает, что это «плохо». Он не может остановиться — это другая проблема.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Договорённости без альтернативы</strong> — «час в день, не больше» — работают неделю, потом рассыпаются.</span>
          </li>
        </ul>

        <p class="text-[15px] leading-[1.65] text-slate-500 mb-2">
          Подробнее о механизмах — в статье <a href="/stati/zavisimost-ot-telefona-u-podrostkov" class="text-primary underline underline-offset-2 hover:text-primary-700">зависимость от телефона у подростков</a>. А про нормы экранного времени по возрастам — в материале <a href="/stati/ekrannoe-vremya-detej-norma" class="text-primary underline underline-offset-2 hover:text-primary-700">экранное время детей: что говорит ВОЗ</a>.
        </p>
      </div>

      <!-- Идея переключения -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Не отнять экран — а дать ему смысл
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Есть принципиальная разница между двумя видами экранного времени. Пассивный — это скроллинг, бесконечная лента, TikTok: ты потребляешь то, что создал алгоритм. Активный — это создание: пишешь код, делаешь игру, собираешь проект. Мозг работает по-другому.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда подросток делает свою игру — он пишет правила, придумывает механику, решает задачи. Это тот же экран. Только теперь он не потребляет, а создаёт. И это меняет отношение к гаджетам в целом.
        </p>

        <div class="grid md:grid-cols-2 gap-3 mb-5">
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-phone text-slate-400 text-[18px]" aria-hidden="true"></i>
              <p class="text-[14px] font-semibold text-slate-500 uppercase tracking-wide">Пассивный экран</p>
            </div>
            <ul class="flex flex-col gap-1.5">
              <li class="text-[14px] text-slate-600">Скроллинг ленты без цели</li>
              <li class="text-[14px] text-slate-600">YouTube Shorts / Reels / TikTok</li>
              <li class="text-[14px] text-slate-600">Игры-убийцы времени</li>
              <li class="text-[14px] text-slate-600">Алгоритм решает, что смотреть</li>
            </ul>
          </div>
          <div class="rounded-[14px] border border-primary/30 bg-[#fff8f0] p-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-laptop text-primary text-[18px]" aria-hidden="true"></i>
              <p class="text-[14px] font-semibold text-orange-700 uppercase tracking-wide">Активный экран</p>
            </div>
            <ul class="flex flex-col gap-1.5">
              <li class="text-[14px] text-slate-700">Написание кода — создание проекта</li>
              <li class="text-[14px] text-slate-700">Своя игра / сайт / AI-помощник</li>
              <li class="text-[14px] text-slate-700">Цель, результат, гордость</li>
              <li class="text-[14px] text-slate-700">Ты решаешь, что делать</li>
            </ul>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Именно поэтому <a href="/it-lager" class="text-primary underline underline-offset-2 hover:text-primary-700">IT-лагерь, где гаджет становится инструментом</a>, работает там, где запреты не работают. Подросток приходит с привычкой потреблять — уходит с навыком создавать.
        </p>
      </div>

      <!-- Как 10-14 дней сбивают привычку -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как 10–14 дней меняют привычку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп телефоны не изымают — но экранное время за личным смартфоном покупается за внутренние лагерные рубли. Это не запрет — это выбор. Потратить рубли на листание ленты или на кино для всей группы у костра.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При этом работа за компьютером весь день — это не ограничение, это программа. Ребята пишут код, делают игры, собирают AI-проекты. Экран здесь — не источник развлечений, а рабочий инструмент.
        </p>

        <div class="space-y-3 mb-5">
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-orange-50 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[15px] font-bold text-orange-500">1–2</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">День 1–2: перестройка</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Первые два дня могут быть неспокойными — это нормальная реакция на смену среды. Программа максимально насыщена: новые знакомства, квест по территории, первые строчки кода. Скучать буквально некогда.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-orange-50 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[15px] font-bold text-orange-500">3–5</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">День 3–5: переключение</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Происходит перелом. Проект начинает работать — и это куда интереснее, чем чужая лента. Ребята сами начинают выбирать: потратить лагерные рубли на телефон или на кино вечером у костра.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-orange-50 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-[15px] font-bold text-orange-500">7+</span>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">День 7 и дальше: новая норма</p>
              <p class="text-[14px] leading-[1.6] text-slate-600">Среднее время за личным телефоном — 5–10 минут в день. Не из-за запрета. Просто появились дела важнее. У многих — ноль. Это не подавление привычки: это замена её другой.</p>
            </div>
          </div>
        </div>

        <p class="text-[15px] leading-[1.65] text-slate-500">
          Подробнее о том, как устроена смена без телефонов: <a href="/lager-bez-telefonov" class="text-primary underline underline-offset-2 hover:text-primary-700">лагерь без телефонов — как работает цифровой детокс</a>.
        </p>
      </div>

      <!-- Цитаты вернувшихся -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
