---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "rocket-takeoff", description: "Программа 12–16 лет" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Стоит ли везти ноутбук в IT-лагерь?",
    answer: "Нет. Оборудование уже готово: ноутбуки, мыши, наушники, мониторы для хакатона. Свой ноутбук — лишний вес и риск поцарапать его в рюкзаке. Исключение — своя игровая мышка, если ребёнок привык, но и это необязательно."
  },
  {
    question: "Сколько одежды брать на смену?",
    answer: "Ориентируйтесь на длительность: чем дольше смена, тем больше комплектов понадобится, но и тем чаще работает стирка — закладывайте запас на неделю. Подпишите всё маркером или термонаклейками, иначе всё теряется в стирке."
  },
  {
    question: "Можно ли брать телефон в лагерь?",
    answer: "Да, обязательно — для связи с родителями. Телефоны сдаются на хранение в специальные боксы при заселении, а лимит экранного времени ребята «покупают» за внутреннюю валюту лагеря. Лучше взять запасной телефон попроще — не жалко, если поцарапают."
  },
  {
    question: "Что делать если ребёнок забыл что-то важное дома?",
    answer: "Не паниковать. Забытое можно довезти в первые дни смены — если не получается приехать, рядом с базой есть магазин с самым необходимым, а вожатые помогут на месте. Исключение — медицинская справка 079/у и полис ОМС: без них заселение невозможно, поэтому их кладут первыми."
  },
  {
    question: "Свои подушка и одеяло — обязательны?",
    answer: "Нет, всё включено — постельное бельё, подушки и одеяла уже есть, везти своё незачем. При особенностях (например, аллергия на синтепон) уточните при бронировании — подберём вариант."
  },
  {
    question: "Ребёнок едет в лагерь впервые — что учесть?",
    answer: "Помимо стандартных сборов — прихватите что-нибудь из дома для адаптации: любимую мягкую игрушку, семейное фото или маленький предмет с памятью — это серьёзно помогает в первые дни. Никто не засмеёт: у половины отряда в первую ночь есть что-то подобное. Ещё хорошо работает скетчбук или раскраска — привычное занятие снижает тревогу."
  },
  {
    question: "Своя мышка или клавиатура для IT-лагеря — обязательны?",
    answer: "Нет. Всё оборудование предоставляется: ноутбуки с рабочим ПО, мыши, наушники. Если ребёнок привык к конкретной мышке и хочет взять свою — можно, не запрещаем."
  },
  {
    question: "Куда деваются потеряшки из лагеря?",
    answer: "После смены мы собираем всё забытое и привозим в московский офис — забрать можно в течение 2 недель. Поэтому важно подписывать всё маркером: подписанное возвращается к хозяину, неподписанное остаётся в общей куче."
  }
];
---

<Base
  title="Что взять с собой в лагерь: список вещей на 14 дней — для мальчика и девочки"
  description="Что взять ребёнку в лагерь на 14 дней: полный список вещей, одежды, еды и гаджетов для мальчика и девочки. Документы, что взять с собой и что часто забывают."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Что взять с собой в летний лагерь — полный список ${SEASON_YEAR} | АйДаКемп`,
        "description": "Полный список что взять в летний лагерь ребёнку: одежда, гаджеты, документы. Что точно не нужно, что забывают чаще всего. Скачайте чек-лист.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-21",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/chto-vzyat-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что взять с собой в лагерь: список"
    subtitle="Чек-лист по одежде, документам и еде — ничего лишнего, ничего забытого."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети с рюкзаками готовятся к смене в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Сборы в лагерь"
    daryaQuote="Каждый год перед сменой меня спрашивают: «А ноутбук брать?» Не надо. Берите ребёнка, документы и крем от солнца. Остальное у нас есть."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Сборы вещей ребёнку в лагерь без паники — дело одного вечера, если под рукой чек-лист. Одни родители везут чемодан как на зимовку, другие забывают крем от солнца и тапки для бассейна. Этот чек-лист — выжимка из нескольких сезонов и сотен ребят.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Документы и медицина
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Без документов ребенку не разрешат заселиться. Сложите их в отдельный пакет — и сразу отдайте при заезде.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка 079/у</strong> — выдаёт педиатр, действует 90 дней. Стандарт для детских лагерей, но иногда просят 086/у — уточните заранее.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис ОМС</strong> — оригинал или качественная копия. При любом обращении к медику на территории потребуется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Копия свидетельства о рождении</strong> — детям младше 14. После — достаточно паспорта.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страховой полис от несчастного случая</strong> — рекомендуем оформить отдельно, помимо страхования ответственности туроператора у организатора. Дополнительная защита за 300–600 ₽ на смену.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Лекарства по назначению</strong> — если ребёнок пьёт что-то постоянно, составьте перечень с дозировкой и отдайте медику при заезде, приложив сами лекарства в том же объёме.</span>
          </li>
        </ul>

        <StatCallout
          value="079/у"
          label="— стандартная форма для загородного лагеря. Убедитесь, что педиатр отметил отсутствие контакта с инфекционными больными."
          source="Требования СанПиН 2.4.4.3048-13"
          icon="shield-check"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Одежда — сколько взять
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Чемодан на колёсах с горкой ни к чему — хватит рюкзака или дорожной сумки. Здесь есть стирка, поэтому одежду собирайте с запасом на неделю, а не на весь срок.
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Обувь: 2 пары.</strong> Кроссовки — для активностей, сланцы — для бассейна и душевой.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Повседневная одежда: 3–5 комплектов.</strong> Футболки, шорты или лёгкие брюки — с поправкой на прохладные утро и вечер.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Спортивный костюм</strong> — 1 комплект. Для зарядки и прохладных вечеров.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тёплая кофта: 1 штука.</strong> С капюшоном или флиска — вечера у воды бывают прохладными.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Головной убор — обязательно.</strong> Кепка или панама: без него ребята перегреваются уже к полудню.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Купальник или плавки: 2–3 штуки.</strong> Один всегда будет сохнуть после бассейна — запас пригодится.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Дождевик или лёгкая куртка</strong> — дождь случается внезапно, зонтик неудобен.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нарядная одежда</strong> — один комплект на дискотеку или итоговый концерт. Больше не нужно — показ мод тут ни при чём.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нижнее бельё и носки: по 5–7 пар</strong> — теряются стремительно и в промышленных масштабах.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Пижама</strong> — 1–2 штуки, для прохладных ночей.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Собирайте чемодан вместе с ребёнком и подпишите всё маркером или термонаклейками — в общей стирке быстро путается.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Гаджеты и телефон
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефоны при заселении сдаются на хранение в специальные боксы — это часть формата, а не наказание. Экранное время ребята «покупают» за свою внутреннюю валюту лагеря.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Ноутбук с собой везти незачем</strong> — всё оборудование для IT-занятий уже здесь.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Наушники</strong> — для музыки в свободное время. Проводные надёжнее, беспроводные удобнее.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зарядное устройство</strong> — для телефона. Кабель, адаптер и power bank возьмите с собой.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Электронная книга</strong> — замена телефону: не даёт листать соцсети, но позволяет читать.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Личная гигиена
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Возьмите то, чем ребёнок пользуется дома — в незнакомом месте дети цепляются за привычное.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Шампунь и гель для душа</strong> — в дорожных мини-флаконах, литровые бутыли ни к чему.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зубная щётка и паста</strong> — стандартно, плюс зубная нить, если пользуется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Солнцезащитный крем SPF 30+</strong> — обязательно, забывают его чаще всего. Наносите и на лицо отдельно — там кожа обгорает быстрее.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Солнцезащитные очки</strong> — не обязательно, но в яркий летний день лишними не будут.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тапки для бассейна и душа</strong> — закрытые или с фиксацией на пятке: скользкий пол и грибок — реальный риск.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полотенца: 2 штуки</strong> — одно для душа, одно для бассейна или пляжа. Желательно подписать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Дезодорант</strong> — актуален с 10–11, при активном дне и жаре.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Репеллент от комаров</strong> — Подмосковье, лето, природа. Без комментариев.</span>
          </li>
        </ul>

        <StatCallout
          value="SPF 30+"
          label="— минимальный фактор защиты при долгом пребывании на улице. Для светлокожих детей лучше SPF 50."
          source="Рекомендации дерматологов"
          icon="sun"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Еда и перекусы
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Питание 5 раз в день уже входит в путёвку — покупать ребенку еду про запас не имеет смысла. Но небольшой перекус на дорогу и первый вечер практичен: он помогает ребёнку быстрее освоиться.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Перекус в дорогу</strong> — бутерброд, фрукт, батончик. Трансфер идёт 2–3 часа, и без еды в пути тяжело.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Сладости — только в закрытой заводской упаковке.</strong> Открытое и скоропортящееся медик заберёт при заезде: требование СанПиН.</span>
