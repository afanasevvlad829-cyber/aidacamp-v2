---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "rocket-takeoff", description: "Программа 12–16 лет" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Нужно ли брать ноутбук в IT-лагерь?",
    answer: "Нет. В АйДаКемп всё оборудование предоставляется лагерем: ноутбуки с нужным ПО, мыши, наушники для работы, мониторы для хакатона. Везти свой ноутбук — лишний вес и риск, что его поцарапают или уронят в рюкзаке. Единственное исключение — если у ребёнка есть своя игровая мышка, к которой он привык. Но и это не обязательно."
  },
  {
    question: "Сколько одежды брать на смену 7, 10 или 14 дней?",
    answer: "На 7 дней — 4–5 комплектов одежды плюс 2–3 купальника. На 10 дней — 5–6 комплектов, на 14 дней — 6–7. В лагере работает стирка, поэтому брать одежду «на каждый день» не нужно. Главное: подписать всё маркером или термонаклейками — иначе вещи смешиваются в общем пространстве и теряются."
  },
  {
    question: "Можно ли брать телефон в лагерь?",
    answer: "Да, телефон брать можно и нужно — для связи с родителями. В АйДаКемп телефоны сдаются на хранение в специальные боксы при заселении, а ребята сами решают, когда использовать лимит экранного времени. Они «покупают» его за внутреннюю валюту лагеря. Поэтому лучше взять запасной телефон попроще — не жалко, если поцарапают."
  },
  {
    question: "Что делать если ребёнок забыл что-то важное дома?",
    answer: "Не паниковать. Родители могут довезти забытые вещи в первые дни смены — на территорию можно приехать во время заезда. Если не получается приехать — рядом с базой есть магазин, где можно купить самое необходимое. Вожатые помогут разобраться на месте. Единственное исключение — медицинская справка 079/у и полис ОМС: без них заселение невозможно, поэтому их кладут первыми."
  },
  {
    question: "Нужна ли подушка и одеяло?",
    answer: "Нет, всё включено. В АйДаКемп постельное бельё, подушки и одеяла предоставляются лагерем. Брать своё не нужно — только лишний вес. Если у ребёнка есть особенности (например, аллергия на синтепон) — уточните заранее при бронировании, подберём подходящий вариант."
  },
  {
    question: "Что взять если ребёнок едет в лагерь впервые?",
    answer: "Помимо стандартного списка — возьмите что-нибудь из дома, что поможет адаптироваться. Любимая небольшая мягкая игрушка, распечатанная семейная фотография или маленький предмет с памятью — это серьёзно помогает в первые дни. Никто не засмеёт: у половины отряда в первую ночь что-то подобное есть. Ещё хорошо работает скетчбук или раскраска — привычное занятие в новом месте снижает тревогу."
  },
  {
    question: "Нужна ли своя мышка или клавиатура для IT-лагеря?",
    answer: "Нет, не нужна. В АйДаКемп всё оборудование предоставляется: ноутбуки с нужным ПО, мыши, наушники для работы. Если ребёнок привык к конкретной мышке и хочет взять свою — не запрещаем, но это не обязательно. Ничего специфически «айтишного» брать с собой не нужно."
  },
  {
    question: "Что делать с вещами, которые потерялись в лагере?",
    answer: "После каждой смены мы собираем потеряшки и привозим их в московский офис. Родители могут забрать вещи в течение 2 недель после окончания смены. Именно поэтому так важно подписывать всё маркером или термонаклейками — подписанная вещь возвращается к хозяину, неподписанная остаётся в общей куче."
  }
];
---

<Base
  title="Что взять с собой в летний лагерь — полный список 2026 | АйДаКемп"
  description="Полный список что взять в летний лагерь ребёнку: одежда, гаджеты, документы. Что точно не нужно, что забывают чаще всего. Скачайте чек-лист."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/chto-vzyat-v-lager" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Что взять с собой в летний лагерь — полный список 2026 | АйДаКемп",
        "description": "Полный список что взять в летний лагерь ребёнку: одежда, гаджеты, документы. Что точно не нужно, что забывают чаще всего. Скачайте чек-лист.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-21",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/chto-vzyat-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Что взять с собой в летний лагерь", "item": "https://aidacamp.ru/stati/chto-vzyat-v-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что взять в летний лагерь — полный список"
    subtitle="Чек-лист по одежде, документам и гаджетам — чтобы ничего не забыть и не взять лишнего."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети с рюкзаками готовятся к смене в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Что взять в летний лагерь"
    daryaQuote="Каждый год перед сменой меня спрашивают: «А ноутбук брать?» Не надо. Берите ребёнка, документы и крем от солнца. Остальное у нас есть."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Собрать ребёнка в лагерь с первого раза без паники — реально. Мы каждый год наблюдаем две крайности: одни приезжают с огромными чемоданами, как на зимовку, другие забывают солнцезащитный крем и тапки для бассейна. Этот список — выжимка из нескольких сезонов и сотен ребят, которые через нас прошли.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Документы и медицина
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Документы — это то, без чего ребёнка просто не заселят. Собирайте их в отдельный файл или папку, не вперемежку с остальным. Лучше всего — отдельный пакет, который сразу отдаёте при заезде.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка форма 079/у</strong> — для загородного лагеря. Выдаёт педиатр в поликлинике, действует 90 дней. Уточните у лагеря: иногда просят 086/у, но для детских лагерей стандарт — 079/у.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис ОМС</strong> — оригинал или качественная копия. При любом обращении к медику на территории нужен.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Копия свидетельства о рождении</strong> — для детей до 14 лет. После 14 достаточно паспорта.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страховой полис</strong> — рекомендуем оформить отдельно. У организатора есть страхование ответственности туроператора, а личную страховку ребёнка от несчастного случая родитель оформляет отдельно — это дополнительная защита. Стоит 300–600 ₽ на смену.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Список принимаемых лекарств</strong> — если ребёнок пьёт что-то постоянно, напишите список с дозировкой и отдайте медику при заезде. Лекарства тоже возьмите с собой в том количестве, которого хватит на смену.</span>
          </li>
        </ul>

        <StatCallout
          value="079/у"
          label="— стандартная форма справки для загородного лагеря. Убедитесь, что педиатр поставил отметку об отсутствии контакта с инфекционными больными."
          source="Требования СанПиН 2.4.4.3048-13"
          icon="shield-check"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Одежда — сколько брать
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главный принцип: на смену 7–10 дней не нужно везти чемодан на колёсах с горкой. Достаточно среднего рюкзака или дорожной сумки. В большинстве лагерей есть стирка — используйте это. Одежды берите на 5–6 дней, не больше.
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Обувь: 2 пары.</strong> Кроссовки для активностей — основная пара. Сланцы или шлёпанцы — для бассейна и душевой. Босоножки или вторые кроссовки по желанию, но не обязательно.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Повседневная одежда: 3–5 комплектов.</strong> Футболки, шорты или лёгкие брюки — в зависимости от погоды. Летом в Подмосковье днём жарко, но не забывайте про утро и вечер.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тёплая вещь: 1 штука.</strong> Лёгкая кофта с капюшоном или флиска. Вечера в июне–июле в Подмосковье бывают прохладными, особенно у воды. Дети мёрзнут на вечерних активностях.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Купальник или плавки: 2–3 штуки.</strong> Один всегда будет сохнуть после бассейна — нужен запас.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Дождевик или лёгкая куртка.</strong> Лето есть лето — дождь случается внезапно. Зонтик неудобен при активностях, дождевик лучше.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нижнее бельё и носки: по 5–7 пар.</strong> Носки теряются стремительно и в промышленных масштабах. Это не шутка.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Лайфхак: подпишите одежду маркером или приклейте термонаклейки с именем. Особенно — однотипные вещи (футболки, носки). В общем пространстве всё смешивается.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Гаджеты и телефон
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Здесь сразу честно: в АйДаКемп телефоны сдаются на хранение в специальные боксы при заселении. Это не наказание — это часть формата. Ребята сами выбирают, когда использовать лимит экранного времени. Покупают его за внутреннюю валюту лагеря. Подробнее об этом — в статье про зависимость от телефона.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Ноутбук брать не нужно.</strong> В АйДаКемп всё оборудование для IT-занятий предоставляется: ноутбуки, мыши, кабели, мониторы для хакатона. Лишний ноутбук в чемодане — это лишний вес и риск, что его поцарапают или уронят.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Что можно взять из гаджетов:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Наушники</strong> — для музыки в свободное время. Проводные надёжнее, беспроводные удобнее. На выбор.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зарядное устройство</strong> — для телефона. Возьмите с собой кабель и адаптер. Power bank приветствуется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Электронная книга</strong> — отличная замена телефону в свободное время. Не даёт соблазна листать соцсети, но позволяет читать.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Личная гигиена
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Берите то, чем ребёнок пользуется дома — не покупайте специально «лагерный» комплект из самого дешёвого. Дети в незнакомом месте цепляются за привычное.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Шампунь и гель для душа</strong> — в небольших флаконах. Не надо литровых бутылей.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зубная щётка и паста</strong> — стандартно. Добавьте зубную нить, если пользуется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Солнцезащитный крем SPF 30+</strong> — обязательно. Это самая важная вещь в списке. Дети проводят много времени на улице, и ожоги случаются даже в облачный день. Берите тюбик на каждый день, не жалейте.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тапки для бассейна и душа</strong> — закрытые или с фиксацией на пятке надёжнее. Грибок и скользкий пол — реальные риски в любом общем пространстве.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полотенца: 2 штуки</strong> — одно для душа, одно для бассейна или пляжа. Желательно подписать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
