---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "rocket-takeoff", description: "Программа 12–16 лет" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Нужно ли брать ноутбук в IT-лагерь?",
    answer: "Нет. В АйДаКемп всё оборудование уже есть: ноутбуки с нужным ПО, мыши, наушники для работы, мониторы для хакатона. Везти свой ноутбук — лишний вес и риск, что его поцарапают или уронят в рюкзаке. Единственное исключение — если у ребёнка есть своя игровая мышка, к которой он привык. Но и это не обязательно."
  },
  {
    question: "Сколько одежды брать на смену?",
    answer: "Ориентируйтесь на длительность: чем дольше смена, тем больше комплектов нужно, но и тем чаще работает стирка — берите с запасом на неделю, а не на весь срок. Главное: подписать всё маркером или термонаклейками, иначе вещи теряются в общей стирке."
  },
  {
    question: "Можно ли брать телефон в лагерь?",
    answer: "Да, телефон брать можно и нужно — для связи с родителями. В АйДаКемп телефоны сдаются на хранение в специальные боксы при заселении, а ребята сами решают, когда использовать лимит экранного времени. Они «покупают» его за внутреннюю валюту лагеря. Поэтому лучше иметь запасной телефон попроще — не жалко, если поцарапают."
  },
  {
    question: "Что делать если ребёнок забыл что-то важное дома?",
    answer: "Не паниковать. Родители могут довезти забытые вещи в первые дни смены — на территорию можно приехать во время заезда. Если не получается приехать — рядом с базой есть магазин, где можно купить самое необходимое. Вожатые помогут разобраться на месте. Единственное исключение — медицинская справка 079/у и полис ОМС: без них заселение невозможно, поэтому их кладут первыми."
  },
  {
    question: "Нужна ли подушка и одеяло?",
    answer: "Нет, всё включено. В АйДаКемп постельное бельё, подушки и одеяла уже есть. Брать своё не нужно — только лишний вес. Если у ребёнка есть особенности (например, аллергия на синтепон) — уточните заранее при бронировании, подберём подходящий вариант."
  },
  {
    question: "Ребёнок едет в лагерь впервые — что учесть?",
    answer: "Помимо стандартного списка — прихватите что-нибудь из дома, что поможет адаптироваться. Любимая небольшая мягкая игрушка, распечатанная семейная фотография или маленький предмет с памятью — это серьёзно помогает в первые дни. Никто не засмеёт: у половины отряда в первую ночь что-то подобное есть. Ещё хорошо работает скетчбук или раскраска — привычное занятие в новом месте снижает тревогу."
  },
  {
    question: "Нужна ли своя мышка или клавиатура для IT-лагеря?",
    answer: "Нет, не нужна. В АйДаКемп всё оборудование предоставляется: ноутбуки с нужным ПО, мыши, наушники для работы. Если ребёнок привык к конкретной мышке и хочет использовать свою — не запрещаем, но это не обязательно. Ничего специфически «айтишного» брать с собой не нужно."
  },
  {
    question: "Куда деваются вещи, которые потерялись в лагере?",
    answer: "После каждой смены мы собираем потеряшки и привозим их в московский офис. Родители могут забрать вещи в течение 2 недель после окончания смены. Именно поэтому так важно подписывать всё маркером или термонаклейками — подписанная вещь возвращается к хозяину, неподписанная остаётся в общей куче."
  }
];
---

<Base
  title="Что нужно взять ребёнку в лагерь: список вещей, еды на 14 дней — для мальчика и девочки"
  description="Что взять ребёнку с собой в летний лагерь на 14 дней: список вещей, еды, одежды, гаджетов и документов. Что точно не нужно и что забывают чаще всего."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Что взять с собой в летний лагерь — полный список ${SEASON_YEAR} | АйДаКемп`,
        "description": "Полный список что взять в летний лагерь ребёнку: одежда, гаджеты, документы. Что точно не нужно, что забывают чаще всего. Скачайте чек-лист.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-21",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/chto-vzyat-v-lager"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что взять в лагерь: список вещей, еды"
    subtitle="Чек-лист по вещам, документам и еде — ничего лишнего, ничего забытого."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети с рюкзаками готовятся к смене в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Чек-лист вещей в лагерь"
    daryaQuote="Каждый год перед сменой меня спрашивают: «А ноутбук брать?» Не надо. Берите ребёнка, документы и крем от солнца. Остальное у нас есть."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Собрать вещи ребёнку в лагерь без паники — реально, если действовать по списку. Одни родители везут чемодан как на зимовку, другие забывают крем от солнца и тапки для бассейна. Этот чек-лист — выжимка из нескольких сезонов АйДаКемп и сотен ребят: действительно нужное ребенку, а не лишний груз.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Документы и медицина
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Без документов ребенку не разрешат заселиться. Сложите их в отдельный пакет — и сразу отдайте при заезде.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинская справка форма 079/у</strong> — для загородного лагеря. Выдаёт педиатр в поликлинике, действует 90 дней. Уточните у лагеря: иногда просят 086/у, но для детских лагерей стандарт — 079/у.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полис ОМС</strong> — оригинал или качественная копия. При любом обращении к медику на территории нужен.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Копия свидетельства о рождении</strong> — детям младше 14. После — достаточно паспорта.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страховой полис</strong> — рекомендуем оформить отдельно. У организатора есть страхование ответственности туроператора, а личную страховку ребёнка от несчастного случая родитель оформляет отдельно — это дополнительная защита. Стоит 300–600 ₽ на смену.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Список принимаемых лекарств</strong> — если ребёнок пьёт что-то постоянно, напишите список с дозировкой и отдайте медику при заезде, приложив сами лекарства в нужном количестве.</span>
          </li>
        </ul>

        <StatCallout
          value="079/у"
          label="— стандартная форма справки для загородного лагеря. Убедитесь, что педиатр поставил отметку об отсутствии контакта с инфекционными больными."
          source="Требования СанПиН 2.4.4.3048-13"
          icon="shield-check"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Одежда — сколько брать
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Чемодан на колёсах с горкой не нужен — хватит рюкзака или дорожной сумки. Здесь есть стирка, поэтому одежды берите с запасом на неделю, а не на весь срок.
        </p>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Обувь: 2 пары.</strong> Кроссовки — для активностей, сланцы или шлёпанцы — для бассейна и душевой. Вторая пара по желанию.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Повседневная одежда: 3–5 комплектов.</strong> Футболки, шорты или лёгкие брюки — днём жарко, но не забывайте про прохладное утро и вечер.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Спортивный костюм</strong> — 1 комплект. Для зарядки и прохладных вечеров.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тёплая вещь: 1 штука.</strong> Лёгкая кофта с капюшоном или флиска — вечера у воды бывают прохладными.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Головной убор — обязательно.</strong> Кепка или панама: без него ребята перегреваются уже к полудню.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Купальник или плавки: 2–3 штуки.</strong> Один всегда будет сохнуть после бассейна — нужен запас.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Дождевик или лёгкая куртка.</strong> Дождь случается внезапно, зонтик на активностях неудобен.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нарядная одежда</strong> — один комплект на дискотеку или итоговый концерт. Больше не нужно, показ мод тут ни при чём.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нижнее бельё и носки: по 5–7 пар.</strong> Теряются стремительно и в промышленных масштабах. Это не шутка.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Пижама</strong> — 1–2 штуки, для прохладных ночей.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Собирайте чемодан вместе с ребёнком и подпишите вещи маркером или термонаклейками — в общей стирке всё быстро путается.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Гаджеты и телефон
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефоны при заселении сдаются на хранение в специальные боксы — это часть формата, а не наказание. Экранное время ребята «покупают» за свою внутреннюю валюту. Подробнее — в статье про зависимость от телефона.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Ноутбук брать не нужно.</strong> Всё оборудование для IT-занятий уже здесь: ноутбуки, мыши, кабели, мониторы для хакатона. Лишний вес в чемодане и риск его поцарапать — ни к чему.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Из гаджетов пригодится:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Наушники</strong> — для музыки в свободное время. Проводные надёжнее, беспроводные удобнее. На выбор.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зарядное устройство</strong> — для телефона. Кабель, адаптер и power bank берите с собой.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Электронная книга</strong> — отличная замена телефону в свободное время. Не даёт соблазна листать соцсети, но позволяет читать.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Личная гигиена
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Берите то, чем ребёнок пользуется дома — в незнакомом месте дети цепляются за привычное.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Шампунь и гель для душа</strong> — в дорожных мини-флаконах, литровые бутыли ни к чему.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зубная щётка и паста</strong> — стандартно, плюс зубная нить, если пользуется.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Солнцезащитный крем SPF 30+</strong> — обязательно, самая частая забытая вещь. Наносите и на лицо отдельно — там кожа обгорает быстрее.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Солнцезащитные очки</strong> — не обязательно, но в яркий летний день лишними не будут.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тапки для бассейна и душа</strong> — закрытые или с фиксацией на пятке. Скользкий пол и грибок — реальный риск в общем пространстве.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полотенца: 2 штуки</strong> — одно для душа, одно для бассейна или пляжа. Желательно подписать.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
