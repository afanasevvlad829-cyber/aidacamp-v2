---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import DonutChart from '../../components/DonutChart.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';

const relatedPages = [
  { title: "Подросток не хочет учиться", url: "/stati/podrostok-ne-hochet-uchitsya", icon: "book", description: "Как вернуть интерес без нотаций" },
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", icon: "cpu", description: "Разбираем данные, не заголовки" },
  { title: "Программирование с нуля", url: "/stati/programmirovanie-dlya-detej-s-nulya", icon: "code-slash", description: "С чего начать и какой язык выбрать" },
  { title: "Смены лета 2026 — цены", url: "/ceny", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];
---

<Base
  title="Навыки которые не устареют — чему учить ребёнка"
  description="IBM посчитал: профессиональное знание устаревает за 5 лет, IT-знание — за 2.5 года. Что это значит для родителя, который хочет подготовить ребёнка к будущему."
  ogImage="/images/articles/ne-hochet-uchitsya-1200.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/navyki-kotorye-ne-ustareut" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Навыки которые не устареют — чему учить ребёнка",
      "description": "IBM посчитал: профессиональное знание устаревает за 5 лет, IT-знание — за 2.5 года. Что это значит для родителя, который хочет подготовить ребёнка к будущему.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-09",
      "dateModified": "2026-06-09",
      "image": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/articles/ne-hochet-uchitsya-1200.avif"},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/navyki-kotorye-ne-ustareut"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какие навыки не устареют через 10 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Навыки, которые не привязаны к конкретному инструменту: умение разобраться в новом за 2–3 дня, спокойствие перед задачей без готового ответа, умение декомпозировать проблему, работа в команде с незнакомыми людьми, критическое мышление. Эти навыки востребованы в любой профессии и не обесцениваются при смене технологий." }
        },
        {
          "@type": "Question",
          "name": "Что означает период полураспада знания?",
          "acceptedAnswer": { "@type": "Answer", "text": "Период полураспада знания — это время, за которое актуальность профессионального знания снижается вдвое. Термин из исследования IBM Institute for Business Value (2023): среднее профессиональное знание устаревает за 5 лет, в IT-сфере — за 2,5 года." }
        },
        {
          "@type": "Question",
          "name": "Стоит ли отдавать ребёнка к репетитору?",
          "acceptedAnswer": { "@type": "Answer", "text": "Репетитор — разумное вложение для конкретных задач: подготовка к ЕГЭ, подтягивание отстающего предмета. Проблема в другом: родители часто воспринимают конкретные знания как главную цель, тогда как способность быстро осваивать новое важнее любого набора фактов." }
        },
        {
          "@type": "Question",
          "name": "Как IT-лагерь помогает развить навыки будущего?",
          "acceptedAnswer": { "@type": "Answer", "text": "В IT-лагере ребёнок попадает в ситуации, где готового ответа нет: нужно разобраться в новом инструменте за день, договориться с командой, сдать проект в срок. Это формирует именно те навыки, у которых нет срока годности — адаптивность, инициативность, умение учиться самостоятельно." }
        }
      ]
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Навыки которые не устареют", "item": "https://aidacamp.ru/stati/navyki-kotorye-ne-ustareut/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Срок жизни знания — пять лет. Запись к репетитору — на год вперёд."
    subtitle="IBM посчитал: каждые пять лет половина профессионального знания устаревает. В IT — каждые два с половиной года. Это меняет всё, что мы думаем об образовании детей."
    imageBase="ne-hochet-uchitsya"
    imageAlt="Ребёнок занимается за ноутбуком — думает над задачей, а не смотрит ответ"
    readTime="7 мин чтения"
    breadcrumbsLast="Навыки которые не устареют"
    daryaQuote="Я долго думала, что главное — дать дочери конкретные знания. Потом поняла: главное — чтобы она не паниковала перед новым. Всё остальное она разберётся сама."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          IBM — 115 лет на рынке, переживших пишущие машинки, мейнфреймы, персональные компьютеры и три волны интернета — в 2023 году посчитали одну неудобную вещь. Период полураспада профессионального знания равен пяти годам. В IT — двум с половиной.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Период полураспада — как у радиоактивного вещества. Не «знание исчезает». А «через пять лет оно вдвое менее актуально». Тихо, без предупреждения, без срока годности на упаковке.
        </p>

        <!-- Анимированные цифры: зеркало -->
        <div class="grid grid-cols-2 gap-3 my-5">
          <AnimatedStat
            value="5"
            unit=" лет"
            label="знание устаревает вдвое"
            source="IBM IBV 2023"
            tone="orange"
            size="lg"
          />
          <AnimatedStat
            value="1"
            unit=" год"
            label="очередь к репетитору"
            tone="slate"
            size="lg"
          />
        </div>
        <p class="text-[13px] text-slate-400 mb-4 text-center">Мы готовимся к прошлому.</p>

        <!-- Пончик: актуальность знания через период полураспада -->
        <div class="rounded-[20px] bg-slate-50 border border-slate-100 p-5 flex flex-col sm:flex-row items-center gap-6 justify-center">
          <DonutChart
            percentage={50}
            label="IT-знание через 2,5 года"
            sublabel="половина уже не актуальна"
            color="#EF4444"
            size={110}
            centerText="50%"
          />
          <DonutChart
            percentage={50}
            label="Офисное знание через 5 лет"
            sublabel="та же история"
            color="#F97316"
            size={110}
            centerText="50%"
          />
          <p class="text-[11px] text-slate-400 font-mono sm:hidden text-center">IBM Institute for Business Value (2023)</p>
        </div>
        <p class="text-[11px] text-slate-400 font-mono mt-2 mb-4 hidden sm:block">IBM Institute for Business Value (2023)</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Это не значит «не учиться»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Репетитор, курсы, олимпиадная подготовка — осмысленные вложения. Никто не спорит. Проблема в другом: родители часто думают, что цель образования — накопить конкретные знания. Выучить Python. Знать наизусть исторические даты. Уметь решить интеграл.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Python — отличный язык. Он появился в 1991 году. Сколько он проживёт — никто не знает. Специалист по COBOL в 1975-м тоже был востребован. Потом это знание устарело. Не потому что COBOL плохой язык — а потому что появились лучше.
        </p>

        {/* Таблица срока актуальности карьерных советов */}
        <div class="my-6 rounded-[12px] border border-slate-200 overflow-hidden">
          <div class="bg-slate-50 px-4 py-3 border-b border-slate-200">
            <p class="text-[11px] font-mono tracking-widest text-slate-400 uppercase">Срок актуальности карьерного совета по десятилетиям</p>
          </div>
          <div class="divide-y divide-slate-100">
            <div class="grid grid-cols-[90px_1fr_100px] items-center px-4 py-3 bg-slate-50/50">
              <span class="text-[12px] font-mono text-slate-400">1950–70-е</span>
              <span class="text-[14px] text-slate-700">Инженер / врач / учитель</span>
              <span class="text-[13px] font-bold text-emerald-600 text-right">30+ лет</span>
            </div>
            <div class="grid grid-cols-[90px_1fr_100px] items-center px-4 py-3">
              <span class="text-[12px] font-mono text-slate-400">1980–90-е</span>
              <span class="text-[14px] text-slate-700">Юрист / экономист</span>
              <span class="text-[13px] font-bold text-blue-600 text-right">15–20 лет</span>
            </div>
            <div class="grid grid-cols-[90px_1fr_100px] items-center px-4 py-3 bg-slate-50/50">
              <span class="text-[12px] font-mono text-slate-400">2000-е</span>
              <span class="text-[14px] text-slate-700">IT-специалист / маркетолог</span>
              <span class="text-[13px] font-bold text-orange-500 text-right">5–10 лет</span>
            </div>
            <div class="grid grid-cols-[90px_1fr_100px] items-center px-4 py-3">
              <span class="text-[12px] font-mono text-slate-400">2010–20-е</span>
              <span class="text-[14px] text-slate-700">Data / UX / DevOps</span>
              <span class="text-[13px] font-bold text-red-500 text-right">3–5 лет</span>
            </div>
            <div class="grid grid-cols-[90px_1fr_100px] items-center px-4 py-3 bg-red-50/60">
              <span class="text-[12px] font-mono text-slate-400">2026+</span>
              <span class="text-[14px] text-slate-700 italic">AI-специализации</span>
              <span class="text-[13px] font-bold text-red-600 text-right">1–2 года?</span>
            </div>
          </div>
          <div class="px-4 py-2.5 bg-red-50 border-t border-red-100">
            <p class="text-[11px] text-slate-500">Тренд: срок актуальности совета сокращается с каждым поколением · McKinsey Future of Work 2023 · BLS career trajectory data</p>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошее образование не спорит с этим трендом. Оно учитывает его.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что на самом деле происходит, когда скорость изменений превышает скорость передачи опыта
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Родитель, который вырос в 1990-е, транслирует стратегию выживания, которая сработала в его молодости. «Будь юристом. Учи английский. Поступи в хороший вуз.» Это не плохой совет — это был отличный совет. Для мира, который существовал тогда.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Но в 1995-м мир менялся медленнее, чем сменялись поколения. Сейчас — ровно наоборот. Это первый раз в истории человечества, когда опыт родителей устаревает <em>до того</em>, как дети вырастут.
        </p>

        <AnimatedStat
          value="375"
          unit=" млн"
          label="человек сменят категорию занятости к 2030 году из-за автоматизации"
          source="McKinsey Global Institute, Future of Work 2023"
          tone="blue"
          size="lg"
        />

        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Средний работник сменит 12 работ за карьеру — данные BLS. Это не потому что он неудачник. Это потому что так устроен рынок. Вопрос не «какая профессия не исчезнет», а «как быть человеком, которому нормально менять профессии».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Навыки которые не устареют через 10 лет — конкретный список
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не «soft skills» из корпоративного буклета. Конкретные вещи, которые востребованы вне зависимости от инструментов:
        </p>

        <!-- WEF: востребованность метанавыков -->
        <AnimatedBarChart
          title="Топ навыков будущего — WEF Future of Jobs 2025"
          items={[
            { label: "Адаптивность и гибкость", value: 73, badge: "73%", color: "#FF6B1A" },
            { label: "Критическое мышление", value: 68, badge: "68%", color: "#F97316" },
            { label: "Технологическая грамотность", value: 62, badge: "62%", color: "#FB923C" },
            { label: "Умение задавать правильные вопросы", value: 55, badge: "55%", color: "#FED7AA" },
          ]}
          source="World Economic Forum «Future of Jobs Report 2025»"
        />

        <ul class="flex flex-col gap-5 mt-4">
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-1 flex h-7 w-7 items-center justify-center rounded-full bg-orange-100">
              <i class="bi bi-lightning-charge text-[14px] text-orange-600" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Разобраться в новом инструменте за 2 дня</p>
              <p class="text-[15px] leading-[1.7] text-slate-600">Не знать заранее — а быстро учиться. Ребёнок, который привык что задачи не имеют готового решения, не ломается при встрече с новым фреймворком или новой профессией.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-1 flex h-7 w-7 items-center justify-center rounded-full bg-orange-100">
              <i class="bi bi-chat-text text-[14px] text-orange-600" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Объяснить другому человеку то, что сам только что понял</p>
              <p class="text-[15px] leading-[1.7] text-slate-600">Это проверка понимания глубиннее любого теста. И одновременно — навык, который нужен везде: в команде, в презентации, в переговорах.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-1 flex h-7 w-7 items-center justify-center rounded-full bg-orange-100">
              <i class="bi bi-person-check text-[14px] text-orange-600" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Спокойствие перед задачей без готового ответа</p>
              <p class="text-[15px] leading-[1.7] text-slate-600">Большинство взрослых паникуют при виде незнакомой проблемы — не потому что они глупые, а потому что их всю жизнь учили по шаблону. Умение сказать «я не знаю, но разберусь» — это навык, не черта характера.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-1 flex h-7 w-7 items-center justify-center rounded-full bg-orange-100">
              <i class="bi bi-people text-[14px] text-orange-600" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Договориться с незнакомыми людьми о совместном результате</p>
              <p class="text-[15px] leading-[1.7] text-slate-600">Не «дружить с одноклассниками». А работать в команде, где роли непонятны, цели расплывчаты, и дедлайн завтра. Это другое.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-1 flex h-7 w-7 items-center justify-center rounded-full bg-orange-100">
              <i class="bi bi-question-circle text-[14px] text-orange-600" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">Задать правильный вопрос вместо поиска правильного ответа</p>
              <p class="text-[15px] leading-[1.7] text-slate-600">В мире, где Google знает все ответы, ценность человека — в качестве вопросов. Это и есть то, что Carol Dweck называет growth mindset — но на практике, а не в теории.</p>
            </div>
          </li>
        </ul>

        <blockquote class="my-6 border-l-4 border-orange-400 pl-4 text-[16px] italic text-slate-700 leading-[1.8]">
          «Самая ценная часть родительского опыта — не конкретные ответы. А умение находить ответы в условиях, которых раньше не было.»
        </blockquote>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как разговаривать с ребёнком о будущем без тревоги
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самый непродуктивный вопрос — «кем ты хочешь стать?». Он загоняет ребёнка в необходимость выбрать профессию, которая возможно исчезнет к тому моменту, как он вырастет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Два вопроса работают лучше. Первый: «что тебе по-настоящему интересно — и почему?». Второй: «что ты готов делать, даже когда сложно?». Эти два ответа дают гораздо больше информации о навигации в будущем, чем любой рейтинг профессий.
        </p>

        <div class="my-5 rounded-[10px] bg-slate-50 border border-slate-200 divide-y divide-slate-200">
          <div class="px-4 py-3">
            <p class="text-[11px] font-mono tracking-widest text-slate-400 uppercase mb-2">Вместо этого вопроса</p>
            <div class="flex flex-col gap-3">
              <div class="flex items-start gap-3">
