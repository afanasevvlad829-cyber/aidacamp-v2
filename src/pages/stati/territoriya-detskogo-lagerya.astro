---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Как выбрать лагерь", url: "/stati/kak-vybrat-lager", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Документы и лицензия", url: "/stati/dokumenty-licenziya-strahovka", icon: "shield-check", description: "Что проверить перед покупкой путёвки" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Что должно быть на территории хорошего детского лагеря?",
    answer: "Минимум: жилые корпуса с нормальными кроватями и отоплением, столовая с четырёхразовым питанием, медицинский пункт с фельдшером, спортивная площадка и зона для активностей. Плюс — закрытый периметр с охраной и возможность родителей приехать и проверить всё лично до начала смены."
  },
  {
    question: "Обязателен ли бассейн в лагере?",
    answer: "Не обязателен, но желателен для летних смен. Бассейн должен быть с чистой водой (хлорирование или озонирование), регулярными анализами и дежурным. Открытый водоём — хуже: сложнее контролировать безопасность. В АйДаКемп есть крытый бассейн с ежедневными занятиями."
  },
  {
    question: "Можно ли посмотреть территорию до начала смены?",
    answer: "В АйДаКемп — да. Мы проводим дни открытых дверей перед каждым сезоном. Родители могут приехать, посмотреть корпуса, столовую, IT-класс, поговорить с вожатыми. Это не обязательно, но многим помогает успокоиться перед первой сменой ребёнка."
  }
];
---

<Base
  title="Территория детского лагеря — что должно быть и на что смотреть"
  description="Что включает в себя территория детского лагеря: корпуса, столовая, спорт, IT-класс. На что смотреть при выборе лагеря — чек-лист от АйДаКемп."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/territoriya-detskogo-lagerya" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Территория детского лагеря — что должно быть и на что смотреть",
        "description": "Что включает в себя территория детского лагеря: корпуса, столовая, спорт, IT-класс. На что смотреть при выборе лагеря.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/territoriya-detskogo-lagerya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Территория лагеря: что включено в АйДаКемп и почему это важно"
    subtitle="На что смотреть при выборе лагеря — от корпусов до IT-класса."
    imageBase="lager-na-leto-2026"
    imageAlt="Территория детского лагеря АйДаКемп в Подмосковье"
    readTime="5 мин чтения"
    breadcrumbsLast="Территория детского лагеря"
    daryaQuote="Когда я сама искала лагерь для дочери, первое что смотрела — фото территории. Спальни, столовая, где дети проводят время. Потом поехала проверить лично. Это нормально и правильно."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Территория лагеря — это не просто «красивые фото на сайте». Это среда, в которой ребёнок проведёт 7–14 дней. Где спит, ест, занимается, отдыхает. Вот что стоит проверить и что вы найдёте в АйДаКемп.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Жилые корпуса — на что смотреть
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Корпуса — первое что видит ребёнок при заезде. Обстановка в спальне напрямую влияет на то, как быстро он адаптируется.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Размер комнаты.</strong> Оптимально 4–8 человек в комнате. Больше — анонимность, дети не знакомятся. Меньше — можно, но нужно проверить вентиляцию.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Постельное бельё и подушки.</strong> Должны предоставляться лагерем. Хорошо если есть смена белья раз в 3–4 дня при длинных сменах.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Туалет и душ.</strong> В корпусе или рядом — важно. Идти ночью через двор в туалет — стресс для ребёнка и риск простуды.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Отопление или кондиционер.</strong> Июнь в Подмосковье бывает холодным, август — жарким. Возможность регулировать температуру — базовый комфорт.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          В АйДаКемп — двух- и четырёхместные комнаты с отдельным санузлом. Бельё предоставляется, при длинных сменах меняется.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Столовая и питание
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          По нормам СанПиН в детском лагере должно быть не менее 4 приёмов пищи в день. Хорошие лагеря дают 5. Смотрите на это при выборе.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Питание 5 раз в день</strong> — завтрак, второй завтрак, обед, полдник, ужин. Активные дети расходуют много энергии.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Меню с учётом аллергий.</strong> Лагерь должен знать об ограничениях ребёнка до заезда и учитывать их.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Свежая еда, не разогретая.</strong> Спросите прямо: готовят ли на месте или привозят готовое. Разница в качестве ощутимая.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Спортивные и активные зоны
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хороший лагерь даёт выбор: не хочешь играть в футбол — плыви в бассейне. Не хочешь в бассейн — иди на площадку с настолками под навесом. Разнообразие важно.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Бассейн</strong> — крытый или открытый с регулярными анализами воды и дежурным.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Спортивные площадки</strong> — для волейбола, футбола, бадминтона. Желательно с покрытием, а не на щебне.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зелёная территория</strong> — деревья, трава. Дети должны проводить время на природе, не только в корпусах.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Зона для отдыха</strong> — лавочки, навесы, где можно посидеть в тени. Не у всех детей одинаковый уровень энергии.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            IT-класс и учебные зоны
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для IT-лагеря это ключевое. Не просто «есть компьютеры» — а нормально оборудованное рабочее место для каждого ребёнка.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Ноутбук на каждого ребёнка</strong> — не «на двоих», не «по очереди». Каждый работает сам.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Нормальные столы и стулья.</strong> 4–5 часов за ноутбуком — это нагрузка на спину. Эргономика важна даже для детей.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Проектор или большой экран</strong> — для объяснений группе и финальных защит проектов.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Стабильный интернет.</strong> Для работы с API, загрузки библиотек, хакатона — нужен нормальный канал.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          В АйДаКемп — два IT-класса, каждый ребёнок работает на отдельном ноутбуке. Оборудование предоставляется лагерем: свой ноутбук брать не нужно.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Безопасность территории
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Закрытый периметр — не паранойя, а норма для детского лагеря. Вот что стоит проверить:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-shield-check text-orange-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Огороженная территория</strong> с контрольно-пропускным пунктом. Посторонние не должны заходить свободно.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-shield-check text-orange-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медицинский пункт с фельдшером 24/7.</strong> Не просто аптечка в корпусе, а живой медработник на территории.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-shield-check text-orange-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Наличие лицензии на образовательную деятельность</strong> — если в лагере есть учебные программы. Спрашивайте документы без смущения.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-shield-check text-orange-500 shrink-0 mt-0.5 text-[18px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Страхование детей</strong> — от несчастных случаев. Должно быть включено в стоимость или оформляться отдельно.</span>
          </li>
        </ul>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хочете посмотреть территорию АйДаКемп лично?"
    bookingSubtitle="Проводим дни открытых дверей перед каждым сезоном. Напишите нам — расскажем когда ближайший."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
