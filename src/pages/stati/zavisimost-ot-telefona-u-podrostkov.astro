---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Полный гид: зависимость от гаджетов", url: "/zavisimost-ot-gadzetov/", icon: "grid", description: "8 статей о детской гаджет-зависимости — все темы в одном месте" },
  { title: "Детский лагерь без телефонов", url: "/stati/detskiy-lager-bez-telefonov/", icon: "phone", description: "Как работает 10-дневный детокс" },
  { title: "Как избавиться от зависимости", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr/", icon: "controller", description: "Пошаговый план" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Среда без телефонов" },
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
];

const faqItems = [
  {
    question: "Сколько часов за телефоном — это норма для подростка?",
    answer: "По рекомендациям ВОЗ и American Academy of Pediatrics — не более 2 часов экранного времени в день для досуга (без учёта учёбы). Реальность другая: у российских подростков это обычно 7+ часов. Ключевое слово — не «сколько», а «как». Если ребенок постоянно берёт телефон в руки, но сам может отложить его, отвлечься на разговор, поспать без него — это ещё не симптом зависимости. Если не может — есть повод задуматься."
  },
  {
    question: "Как отобрать телефон без скандала?",
    answer: "Короткий ответ: не отбирать. Это создаёт дефицит и одержимость. Работает другое: договориться заранее о «зонах без телефона» (за столом, в спальне после 22:00) и соблюдать их самим. Копировать поведение родителей свойственно подросткам — а не следовать правилам на словах. Также помогает не запрет, а замена — когда у ребенка появляется что-то, ради чего он сам откладывает экран."
  },
  {
    question: "Помогает ли лагерь с телефонной зависимостью?",
    answer: "Да, и вот почему: лагерь меняет среду целиком. Когда все вокруг заняты делом и телефоны не нужны — FOMO (страх пропустить) исчезает. В АйДаКемп мы не запрещаем телефоны, но делаем экранное время платным через внутреннюю валюту. К третьему дню большинство детей сами выбирают костёр вместо TikTok. Среднее экранное время к концу смены — 5–10 минут в день."
  },
  {
    question: "В каком возрасте давать ребенку смартфон?",
    answer: "Нет единственно правильного ответа, но большинство психологов называют 11–12 лет как минимальный возраст для личного смартфона. До этого — кнопочный телефон для связи или смартфон только дома. Важнее возраста — готовность ребенка к разговору о правилах использования: что можно скачивать, сколько времени, что делать если увидел что-то тревожное."
  },
  {
    question: "Зависимость от телефона лечится?",
    answer: "Да, особенно у подростков — мозг пластичен. Главное условие — смена среды и появление альтернатив, которые дают сопоставимый уровень вовлечённости. Серьёзные случаи (агрессия при изъятии, отказ от еды, полная социальная изоляция) — повод обратиться к детскому психологу или психиатру. Большинство случаев — не признаки клинической зависимости, а привычка, которая меняется через изменение условий жизни."
  },
  {
    question: "Почему подросток тянется к телефону каждые 2–3 минуты?",
    answer: "Это называется «номофобия» (nomophobia) и поведенческая зависимость от уведомлений. Соцсети намеренно используют непредсказуемые уведомления — ты не знаешь, пришло ли что-то новое, и мозг посылает сигнал «проверить». После 200–300 проверок в день этот рефлекс становится автоматическим. Поможет: отключить все уведомления кроме звонков, убрать гаджет с видимых мест, установить приложение для отслеживания частоты разблокировок."
  },
  {
    question: "Как помочь подростку самому захотеть реже сидеть в телефоне?",
    answer: "Подростки не откажутся от телефона, пока он остаётся самым интересным в их жизни. Работает обратное: заполнить жизнь более насыщенными событиями. Не лекции о вреде, а реальный интерес — проект, хобби, живые друзья, занятие где есть прогресс и признание. Когда есть что-то, ради чего хочется отложить телефон — он откладывается сам. Это и есть суть подхода в АйДаКемп: не запрет, а конкуренция."
  },
  {
    question: "Как отучить ребёнка сидеть в телефоне ночью?",
    answer: "Начните с зарядки: телефон заряжается не в комнате ребёнка, а на кухне или в коридоре — тогда взять его посреди ночи физически неудобно. Договоритесь с ребёнком заранее, а не устраивайте разбирательство в 23:00 — правило, принятое совместно, соблюдается охотнее. Если ребёнок объясняет, что сидит по ночам из-за тревоги или бессонницы — это повод не столько отобрать гаджет, сколько поговорить о том, что его беспокоит. Иногда экран ночью — не про зависимость, а про то, что человеку не с кем поговорить о тревоге при свете дня."
  }
];
---

<Base
  title="Как отучить ребёнка сидеть в телефоне ночью: зависимость от гаджетов у подростков"
  description="Зависимость от телефона и гаджетов у подростка: почему ребенок сидит в социальных сетях весь день и ночью, как отучить ребёнка от привычки хвататься за гаджет, нужно ли лечение и что делать родителям без скандалов, запретов и конфискации."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Подросток «залип» в телефоне — как отвлечь, не ссорясь",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-03-05",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/zavisimost-ot-telefona-u-podrostkov"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зависимость от телефона и гаджетов у подростков: как отучить ребёнка"
    subtitle="Почему подросток не выпускает телефон из рук — и что реально работает вместо запретов."
    imageBase="zavisimost-telefona"
    imageAlt="Подростки на совместной активности — жизнь вне гаджета"
    readTime="8 мин чтения"
    breadcrumbsLast="Зависимость от гаджетов у подростков"
    daryaQuote="Моя дочь шутит: «телефон это моё пятое продолжение руки». За этой шуткой — настоящая проблема. Помогло не забирать, а давать взамен что-то, от чего не захочешь отвлекаться на экран."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Среднестатистический подросток проводит в телефоне 5–7 часов в день. Это не статистика из интернета — это то, что мы видим на входе в каждую смену АйДаКемп. Родители приводят детей со словами: «Он постоянно в телефоне». Чаще всего тревожат две проблемы: сколько часов подростки проводят в соцсетях и что они смотрят в интернете ночью. Но не каждый, кто постоянно сидит в телефоне, зависим. Давайте разберёмся.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Если ваш ребёнок хватается за гаджет в любую свободную минуту, вопрос обычно один: как отучить от этой привычки, не разрушив отношения. Универсального рецепта нет — у каждого свой темперамент, своя причина и своя мера тревоги родителей. Но есть общая логика: сначала разобраться, где норма, а где симптом, и только потом решать, что делать.
        </p>

        <StatCallout
          value="8ч 39мин"
          label="в день — среднее экранное время подростка 13–18 лет в 2024 году."
          source="Common Sense Media, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Подростки сидят в телефоне весь день — зависимость или норма?
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          «Много» — это ещё не признаки зависимости. Зависимость — это когда ребенок не может остановиться сам, даже если хочет. Вот конкретные признаки:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Агрессия или паника при изъятии гаджета — не просто недовольство, а истерика</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Первое действие утром — схватить телефон. Последнее перед сном — тоже</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Потеря интереса к тому, что раньше нравилось: спорт, друзья, хобби</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ложь о времени за телефоном — прячется, включает ночью</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Снижение успеваемости — не потому что глупый, а потому что не может сосредоточиться</span></li>
        </ul>

        <StatCallout
          value="~46%"
          label="подростков говорят что онлайн «почти всё время» — и это не геймеры, это обычные."
          source="Pew Research, 2024"
          icon="emoji-frown"
          tone="neutral"
        />

        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Родителям сложно определить эту грань на глаз — кажется, что раз ребёнок в телефоне почти всё свободное время, значит, дело плохо. Но у ребёнка может быть просто такой возраст: подростки вообще много общаются, и часть этого общения естественно переехала в переписку. Тревожиться стоит не за факт «сидит в телефоне», а за то, что стоит за этим у конкретного подростка — скука, тревога или реальная зависимость.
        </p>
      </div>

      <!-- 5 признаков зависимости -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5 признаков зависимости от телефона
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Эти признаки работают в связке. Одна-две проблемы — не повод паниковать. Три и более — стоит обратить внимание.
        </p>

        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-phone-x text-red-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Паника при разряде батарейки</p>
              <p class="text-base leading-[1.6] text-slate-600">Не просто беспокойство, а тревога и раздражение. Даже 20 минут без него на зарядке — источник паники у ребенка. Если у ребёнка начинается настоящая паника, а не лёгкое ворчание — это самый явный из всех признаков.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-phone text-red-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Смартфон на столе во время еды</p>
              <p class="text-base leading-[1.6] text-slate-600">Не просто привычка — невозможность поесть без параллельного скроллинга. Еда воспринимается как помеха, а не как ритуал. Разговор с ребёнком за столом в такие моменты не клеится — экран забирает всё внимание.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-clock text-red-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Проверка гаджета каждые 2–3 минуты</p>
              <p class="text-base leading-[1.6] text-slate-600">Рефлекторное «потянуться за телефоном» без конкретной причины. Ребенок не может сосредоточиться на разговоре, книге или занятии дольше пары минут.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-clock text-red-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Ухудшение сна из-за гаджета ночью</p>
              <p class="text-base leading-[1.6] text-slate-600">Гаджет под подушкой, звуки уведомлений в 2 часа ночи, засыпание после часового скроллинга. Утром — раздражительность и трудности с концентрацией. Хронический недосып из-за гаджета по ночам сказывается на ребёнке сильнее, чем кажется родителям: страдают память, настроение и иммунитет.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-emoji-frown text-red-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Агрессия, если гаджет забрать</p>
              <p class="text-base leading-[1.6] text-slate-600">Не просто недовольство — взрыв эмоций, крики, хлопание дверью. Реакция непропорциональна ситуации. Это сигнал, что гаджет стал основным источником удовольствия. Такая реакция у ребёнка — не про характер, а про то, что гаджет занял место, которое раньше принадлежало живым эмоциям и общению с человеком напротив.</p>
            </div>
          </div>
        </div>

        <StatCallout
          value="4+ часа"
          label="экрана в день у подростков — фактор риска для психического здоровья по данным ВОЗ"
          source="ВОЗ, рекомендации по экранному времени"
          icon="phone-x"
          tone="warn"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему подростки особенно уязвимы
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Зависимость от гаджетов — это не слабоволие, так устроен человек, а не потому что ребенок слабый. Мозг ребенка предрасположен к ней ещё сильнее. Префронтальная кора — часть мозга, отвечающая за самоконтроль — ещё формируется. А дофаминовая система уже работает на полную.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Ленты социальных сетей — TikTok, YouTube Shorts — построены на коротких дофаминовых петлях: свайп → награда → ещё свайп. Подростки получают 300–500 микро-доз удовольствия в час. Реальная жизнь не может конкурировать с этим по интенсивности. Но может — по глубине. И это ключ.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          У одного человека этот механизм проявляется слабее, у другого — сильнее: многое зависит от темперамента ребенка и от того, чем заняты его гаджеты помимо соцсетей — играми, музыкой или перепиской с друзьями.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Это не значит, что взрослому человеку проще: дофаминовые петли работают на всех. Но у ребёнка меньше опыта, чтобы распознать манипуляцию алгоритма, и не хватает ресурсов самоконтроля, чтобы ей противостоять. Поэтому требовать «просто взять и перестать» — то же самое, что требовать этого от взрослого человека без всякой подготовки.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что не работает: ошибки родителей
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          У ребенка эти способы чаще вызывают протест, чем результат.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Забрать телефон.</strong> Создаёт дефицит → одержимость. Ребенок думает только о телефоне, а когда получает его обратно — бросается с удвоенной жадностью.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Установить родительский контроль.</strong> Обойти его для подростка — 15 минут, не больше. А заодно вы потеряете его доверие.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Шантаж и угрозы.</strong> «Не уберёшь гаджет — не пойдёшь гулять». Ребенок учится врать, а не контролировать себя.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Лекции о вреде.</strong> У подростков и так всё под контролем — они знают, что это вредно. Они не могут остановиться — это другая проблема.</span>
          </li>
        </ul>
      </div>

      <!-- Что реально помогает — расширенный раздел -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что реально помогает
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Не запрет, а перенаправление. От дофамина подросткам отказаться непросто — так устроен человек, но можно предложить другие его источники.
        </p>

        <div class="space-y-4 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Договориться о зонах без гаджета</p>
              <p class="text-base leading-[1.6] text-slate-600">Спальня после 22:00, стол во время еды, первые 30 минут утра. Не «нельзя», а «здесь мы договорились не брать» — и родители соблюдают то же самое. Правило работает только если оно общее. Обсуждать эти зоны стоит вместе с ребёнком, а не спускать сверху — тогда ребёнку проще их соблюдать.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Физическая активность как замена</p>
              <p class="text-base leading-[1.6] text-slate-600">Спорт, прогулки, велосипед — всё это даёт реальный дофамин через движение. Даже 20 минут в движении — и тянет к телефону не так сильно. После часа активности тяга к скроллингу снижается. Ключевое слово — «после», а не «вместо». Не запрещать, а добавлять. Предложите ребёнку то, что двигает его тело, а не только пальцы — и желание сидеть в гаджете упадёт само.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Смена среды — лагерь как естественное переключение</p>
              <p class="text-base leading-[1.6] text-slate-600">Когда все вокруг заняты делом и гаджет просто не нужен — привычка ослабевает сама. Не потому что запретили, а потому что появились дела интереснее. Именно так работает загородный лагерь: среда меняется, и вместе с ней — поведение ребёнка.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Не запрет, а перенаправление</p>
              <p class="text-base leading-[1.6] text-slate-600">Экран заполняет пустоту. Заполните её чем-то другим — проектом, хобби, реальной задачей с реальным результатом. У подростков, если есть дела, меньше тяги к бесконечной ленте. Чем раньше у ребёнка появится своё дело, тем ниже вероятность, что его место займёт лента гаджетов.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Как отучить ребёнка — практический план -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как отучить ребёнка сидеть в телефоне: 5 шагов
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Родители часто спрашивают не «почему так вышло», а «что делать сегодня вечером». Вот пошаговый план, который не про запреты, а про то, как постепенно снизить проявления зависимости и отучить ребёнка от привычки сидеть в гаджете, предложив ему что-то взамен. Механизм зависимости у подростка и у взрослого человека почти одинаков — разница лишь в том, сколько ресурсов самоконтроля есть у каждого.
        </p>

        <div class="space-y-4 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-1-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Понаблюдайте, а не запрещайте сразу</p>
              <p class="text-base leading-[1.6] text-slate-600">Неделю фиксируйте, когда и зачем ребёнок тянется к телефону — от скуки, тревоги или чтобы избежать разговора. Это подскажет, какую именно потребность ребёнка закрывает экран, и что можно предложить вместо него.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Договоритесь о правилах вместе с ребёнком</p>
              <p class="text-base leading-[1.6] text-slate-600">Правило, придуманное родителем в одиночку, ребёнок саботирует. Правило, которое обсудили вместе — соблюдает охотнее. Спросите ребёнка, сколько времени в телефоне ему самому кажется нормальным, и стройте разговор от этой цифры.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-3-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Уберите гаджет из спальни по ночам</p>
              <p class="text-base leading-[1.6] text-slate-600">Именно ночью формируется большая часть нездоровой привычки: ребёнок листает ленту вместо сна, а утром встаёт разбитым. Зарядка на кухне, а не под подушкой у ребёнка — простое правило, которое возвращает несколько часов здорового сна.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Будьте примером, а не контролёром</p>
              <p class="text-base leading-[1.6] text-slate-600">Требовать от ребёнка отложить гаджет, держа собственный телефон в руке — не работает ни с одним человеком, ни взрослым, ни подростком. Ребёнок копирует поведение родителей быстрее, чем слушает их лекции. Правило одно: меньше гаджетов на виду у взрослых — меньше гаджетов в руках у детей.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check2-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Дайте ребёнку жизнь интереснее ленты</p>
              <p class="text-base leading-[1.6] text-slate-600">Зависимость от гаджетов слабеет там, где у ребёнка появляется занятие, ради которого хочется отложить экран: спорт, друзья вживую, проект, поездка в лагерь. Это не разовая мера, а смена среды вокруг ребёнка — и именно она даёт стойкий результат, а не временное затишье.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как лагерь помогает справиться с зависимостью от гаджетов
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп мы не забираем телефоны силой. Мы сделали экранное время платным — оно покупается за внутреннюю валюту лагеря. Одна минута стоит 10 монет из дневного бюджета в 600.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          К третьему дню происходит перелом. Дети обнаруживают, что за те же деньги можно купить вечер у костра, киносеанс для всей группы или мерч. И начинают выбирать реальную жизнь — не потому что заставили, а потому что она оказалась интереснее для ребенка. Родителям не приходится отучать ребёнка от гаджета лично — за них это делает среда, в которой ребёнку самому интереснее быть рядом с другими людьми, чем в ленте.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          То же касается планшетов и других гаджетов — время экрана покупается за монеты, а не запрещается. Ребенок сам решает, на что потратить бюджет: на полчаса в телефоне перед отбоем или на что-то более интересное днём. Вожатые не читают ребёнку нотаций и не ходят за ребёнком с секундомером — они просто рядом, когда хочется поговорить, а не полистать ленту.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Среднее экранное время к концу смены: 5–10 минут в день. У ребенка это происходит само — не из-за запрета, а из-за выбора. <a href="/ceny/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Забронировать место в смене {SEASON_YEAR} →</a>
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-500 italic">
          АйДаКемп — IT-лагерь в Подмосковье, 66 км от МКАД. Смены {SEASON_YEAR} — с 30 мая по 26 августа, от {PRICE_MIN}. <a href="/lager-dlya-podrostkov/" class="text-primary font-semibold hover:underline">Лагерь для подростков 11–14 лет →</a>
        </p>
      </div>

      <!-- FAQ аккордеон -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы родителей
          </h2>
        </div>

