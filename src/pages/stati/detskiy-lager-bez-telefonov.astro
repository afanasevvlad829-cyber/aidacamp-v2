---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Зависимость от телефона", url: "/stati/zavisimost-ot-telefona-u-podrostkov", icon: "phone", description: "Почему подросток уходит в экран" },
  { title: "Как избавиться от зависимости", url: "/stati/kak-izbavitsya-ot-zavisimosti-ot-igr", icon: "controller", description: "Пошаговый план" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Среда где телефон не нужен" },
];

const faqItems = [
  {
    question: "Полностью ли запрещены телефоны в лагере?",
    answer: "Нет. В АйДаКемп телефоны не запрещены — они работают по системе внутренней валюты. Каждый день ребёнок получает бюджет в игровых деньгах, и одна минута экранного времени стоит 10 монет. Вечером доступно 30–40 минут бесплатно. Важно: при необходимости ребёнок может позвонить через вожатого в любое время."
  },
  {
    question: "Как родители связываются с ребёнком?",
    answer: "Через вожатого — это самый надёжный способ. Вожатый всегда рядом с группой и передаёт сообщения моментально. Также мы публикуем фото и видео из лагеря в родительском чате каждый день. Ребёнок знает, что связь с родителями доступна — это снимает тревогу с обеих сторон."
  },
  {
    question: "Ребёнок будет переживать без телефона?",
    answer: "В первый-второй день — да, возможно. Это нормально: телефон — привычная опора. Но уже к третьему дню происходит перелом: программа настолько насыщена, что скучать просто некогда. Дети сами начинают выбирать костёр или волейбол вместо скроллинга. Это не стресс — это переключение."
  },
  {
    question: "Что если ребёнок не может без телефона?",
    answer: "Именно такие дети чаще всего приезжают к нам снова. Наша система работает с привычкой, а не против неё: телефон доступен, но у него есть цена. Когда появляются альтернативы, которые стоят того же или дороже — ребёнок сам делает выбор. К концу смены среднее экранное время падает до 5–10 минут в день."
  },
  {
    question: "Разрешены ли другие гаджеты (планшет, часы)?",
    answer: "Умные часы — да, они удобны для связи. Планшеты и игровые приставки работают по той же системе валюты, что и телефоны. Ноутбуки используются на занятиях по программированию — это учебный инструмент, а не развлечение. Всё, что связано с развлекательным экранным временем, входит в единый бюджет дня."
  },
  {
    question: "Что такое игровые рубли в лагере — это настоящие деньги?",
    answer: "Нет. Игровые рубли — внутренняя валюта лагеря, аналог денег из Монополии. Ими нельзя ничего купить в магазине — только внутри лагерной экономики: экранное время, участие в вечерних активностях, коллективные покупки типа костра с зефирками или фильма на вечер. Родители не пополняют этот счёт — ребёнок зарабатывает рубли за активности, задания и участие в жизни группы."
  },
  {
    question: "Как лагерь без телефонов влияет на ребёнка после возвращения домой?",
    answer: "По отзывам родителей, дети возвращаются спокойнее и без прежнего «телефонного голода». Многие сами замечают, что за смену привыкли выбирать занятия, а не тянуться к экрану по привычке. Это не гарантия — дома старые паттерны могут вернуться. Но инструмент «у телефона есть цена» некоторые семьи переносят домой: договариваются с ребёнком о правилах сами. Самое важное — ребёнок видел, что без постоянного телефона ему было хорошо. Этот опыт остаётся."
  }
];
---

<Base
  title="Детский лагерь без телефонов — где их не забирают, а делают ненужными"
  description="Мы не забираем телефоны. Мы сделали экранное время платным — и дети сами выбрали костёр вместо TikTok. Опыт IT-лагеря АйДаКемп в Подмосковье."
  ogImage="/images/hero/lager-bez-telefonov.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/detskiy-lager-bez-telefonov" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Детский лагерь без телефонов — как дети сами выбирают реальную жизнь",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-03-15",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/detskiy-lager-bez-telefonov"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Детский лагерь без телефонов", "item": "https://aidacamp.ru/stati/detskiy-lager-bez-telefonov/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детский лагерь без телефонов: как мы перестали запрещать гаджеты и дали детям выбор"
    subtitle="Почему «забрать телефон» — это путь в тупик, и что работает вместо этого."
    imageBase="bez-telefonov"
    imageAlt="Дети в IT-лагере АйДаКемп за ноутбуками в лагере"
    imagePosition="center 85%"
    readTime="7 мин чтения"
    breadcrumbsLast="Лагерь без телефонов"
    daryaQuote="Мы не забираем телефоны силой. Дети сами кладут их в корзину, когда начинается что-то интереснее. Это был главный инсайт за 6 лет."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Intro -->
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый год одна и та же история. Родители пишут: «Пожалуйста, заберите у него телефон. Хотя бы на десять дней». И мы раньше так и делали — просто забирали. А потом поняли, что это не работает. И придумали кое-что получше.
        </p>

        <StatCallout
          value="7+ часов"
          label="среднее экранное время российского подростка в день — основа цифровой зависимости."
          source="Mediascope, 2024"
          icon="phone"
          tone="warn"
        />
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Телефон — это не враг. Это валюта
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда мы запускали АйДаКемп, первый сезон прошёл по классической схеме: гаджеты сдаём, выдаём после ужина на час. Технически — порядок. По факту — хаос.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дети без телефонов не становятся вовлечёнными. Они становятся скучающими. А скучающие подростки — это отдельный вид стихийного бедствия. Энергия, которая обычно уходит в экран, начинает выплёскиваться на мебель и друг на друга.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И тогда появилась идея: а что, если телефон — это не проблема, которую надо запретить, а ресурс, который можно сделать дорогим?
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Так родилась внутренняя валюта
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый день ребята получают бюджет в игровых деньгах. Одна минута экранного времени стоит 10 монет. Хочешь звонить маме — пожалуйста. Хочешь сидеть в YouTube — тоже можно. Но за свои деньги.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Бюджета хватает примерно на час телефона. Можно потратить всё на экран. А можно — на кое-что поинтереснее.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы создали целое меню возможностей:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Отложить отбой на час</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Купить фильм на вечер</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Костёр с зефирками</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Телефоны на всю ночь</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Физические и химические эксперименты в коробках</span></li>
        </ul>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Цены на эти вещи такие, что одному не потянуть — нужно скидываться группой. И вот тут начинается настоящая магия.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда дети начинают договариваться
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ребёнок, который утром хотел «просто посидеть в телефоне», к обеду уже ведёт переговоры с соседями по комнате. Потому что на костёр с зефирками нужно скинуться всем вместе. А кто-то хочет не костёр, а кино. А кто-то вообще копит на набор для экспериментов.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Появляются коалиции. Кто-то предлагает: «Я сделаю за тебя уборку — ты дашь мне 100 монет». Кто-то берёт на себя роль агитатора и убеждает группу проголосовать за конкретную коллективную покупку.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          На одной из смен мы попробовали ввести должность «шерифа» — выборного менеджера порядка, который следит за дисциплиной и получает за это зарплату. Затея провалилась: шериф получал деньги и ничего не делал. Мы быстро эту позицию упразднили. Но сам эксперимент стал для детей уроком: оплата без контроля результата — это бесполезная трата ресурсов.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Теневая экономика — и налёт на сейф
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самое удивительное началось, когда дети стали обменивать игровую валюту на настоящие деньги — те, что родители дали на буфет. Появился чёрный рынок. Появился шантаж. И даже был налёт на сейф, где хранилась общая касса.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы не стали наказывать за «теневую экономику». Мы стали обсуждать её вечером всей группой. Где граница между предприимчивостью и мошенничеством? Что случится, если в реальной жизни подделать деньги? Почему шантаж работает только один раз? Эти разговоры дали больше, чем любой урок обществознания.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что происходит к концу смены
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Обычно на третий-четвёртый день мы видим перелом. Дети перестают тратить весь бюджет на телефон. Не потому что запретили — а потому что появились вещи, которых они хотят сильнее.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          К концу смены среднее экранное время падает до 5–10 минут в день. А у многих — до нуля. Тыкание в YouTube заменяется настолками, мафией, волейболом.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Ночь с телефонами» — самая дорогая покупка в нашем меню. После первой покупки цена повторной растёт. Дети быстро чувствуют на себе закон убывающей отдачи. Вторая «ночь с телефонами» уже не кажется такой ценной. И они начинают выбирать другое.
        </p>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему это работает (и почему запрет — нет)
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Запрет создаёт дефицит. А дефицит создаёт одержимость. Забрали телефон — ребёнок думает только о телефоне. Вернули — бросается в него с удвоенной жадностью.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Наша система работает наоборот. Телефон доступен всегда. Но у него есть цена. И есть альтернативы, которые стоят тех же денег. Ребёнок сам решает, что для него ценнее — 60 минут ленты TikTok или костёр с друзьями. Когда выбор настоящий — результат тоже настоящий.
        </p>
      </div>

      <!-- Новый раздел: Как это работает у нас -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как это работает у нас: телефоны в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Не запрет, а расписание. Вот как выглядит работа с гаджетами в лагере на практике:
        </p>

        <div class="grid gap-3 mb-6">
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
              <i class="bi bi-clock text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Телефон доступен вечером 30–40 минут</p>
              <p class="text-base leading-[1.6] text-slate-600">Каждый день после ужина есть свободное окно — позвонить родителям, написать другу. Это предсказуемо, и ребёнок знает об этом с первого дня.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
              <i class="bi bi-telephone text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Связь с родителями — через вожатого всегда</p>
              <p class="text-base leading-[1.6] text-slate-600">При необходимости ребёнок обращается к вожатому в любое время — тот организует звонок домой. Родители могут написать вожатому в любой момент. Это снимает тревогу с обеих сторон.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
              <i class="bi bi-phone text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Телефон есть — просто не в кармане весь день</p>
              <p class="text-base leading-[1.6] text-slate-600">Это принципиальная разница с запретом. Ребёнок знает, что телефон существует, он в безопасности, никто его не забрал. Просто сейчас есть кое-что поинтереснее.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Новый раздел: Почему дети легко расстаются с телефоном -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
