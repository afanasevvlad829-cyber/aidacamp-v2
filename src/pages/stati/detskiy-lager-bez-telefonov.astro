---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';

const relatedPages = [
  { title: "Хакатон для детей", url: "/stati/hakaton-v-detskom-lagere", icon: "bi-rocket-takeoff", description: "10 часов от идеи до питча" },
  { title: "Внутренняя экономика", url: "/stati/vnutrennyaya-ekonomika-v-lagere", icon: "bi-coin", description: "Как дети управляют ресурсами" },
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove", icon: "bi-tree", description: "Смены и цены" },
];
---

<Base
  title="Детский лагерь без телефонов — как дети сами выбирают реальную жизнь | АйДаКемп"
  description="Мы не забираем телефоны. Мы сделали экранное время платным — и дети сами выбрали костёр вместо TikTok. Опыт IT-лагеря АйДаКемп в Подмосковье."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/detskiy-lager-bez-telefonov" />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детский лагерь без телефонов: как мы перестали запрещать гаджеты и дали детям выбор"
    subtitle="Почему «забрать телефон» — это путь в тупик, и что работает вместо этого."
    image="/images/article-hero-bez-telefonov.avif"
    tags={["Гаджеты", "Воспитание", "7–14 лет"]}
    readTime="5 минут"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">

    <p class="text-[16px] text-slate-500 mb-10">
      Почему «забрать телефон» — это путь в тупик, и что работает вместо этого.
    </p>

    <!-- Article content -->
    <article>

      <!-- Intro -->
      <div class="mb-10">
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждый год одна и та же история. Родители пишут: «Пожалуйста, заберите у него телефон. Хотя бы на десять дней». И мы раньше так и делали — просто забирали. А потом поняли, что это не работает. И придумали кое-что получше.
        </p>
      </div>

      <!-- Stats block -->
      <div class="my-8 grid grid-cols-3 gap-4 rounded-2xl bg-slate-50 p-6">
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">4 часа</div>
          <div class="text-[13px] text-slate-500 mt-1">среднее экранное время подростка в день (ВОЗ)</div>
        </div>
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">73%</div>
          <div class="text-[13px] text-slate-500 mt-1">детей чувствуют тревогу без телефона (Ofcom 2023)</div>
        </div>
        <div class="text-center">
          <div class="text-[36px] font-bold text-orange-500">2 дня</div>
          <div class="text-[13px] text-slate-500 mt-1">через столько дети перестают просить телефон</div>
        </div>
      </div>

      <!-- Section 1 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Телефон — это не враг. Это валюта
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда мы запускали АйДаКемп, первый сезон прошёл по классической схеме: гаджеты сдаём, выдаём после ужина на час. Технически — порядок. По факту — хаос.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дети без телефонов не становятся вовлечёнными. Они становятся скучающими. А скучающие подростки — это отдельный вид стихийного бедствия. Энергия, которая обычно уходит в экран, начинает выплёскиваться на мебель и друг на друга.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          И тогда появилась идея: а что, если телефон — это не проблема, которую надо запретить, а ресурс, который можно сделать дорогим?
        </p>
      </div>

      <!-- Blockquote -->
      <blockquote class="my-8 rounded-2xl border-l-4 border-orange-400 bg-orange-50 px-6 py-5">
        <p class="text-[16px] italic text-slate-700 leading-[1.6]">«Запрет без альтернативы — это борьба с симптомом. Ребёнок уходит в телефон от скуки или одиночества.»</p>
        <footer class="mt-3 text-[13px] font-semibold text-slate-500">— Михаил Лабковский, психолог</footer>
      </blockquote>

      <!-- Section 2 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Так родилась внутренняя валюта
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый день ребёнок получает бюджет в игровых деньгах. Одна минута экранного времени стоит 10 единиц. Хочешь звонить маме — пожалуйста. Хочешь сидеть в YouTube — тоже можно. Но за свои деньги.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Бюджета хватает примерно на час телефона. Можно потратить всё на экран. А можно — на кое-что поинтереснее.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мы создали целое меню возможностей:
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Отложить отбой на час</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Купить фильм на вечер</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Костёр с зефирками</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Телефоны на всю ночь</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[15px] text-slate-700">Физические и химические эксперименты в коробках</span></li>
        </ul>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Цены на эти вещи такие, что одному не потянуть — нужно скидываться группой. И вот тут начинается настоящая магия.
        </p>
      </div>

      <!-- Comparison block -->
      <div class="my-8 grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-red-50 border border-red-100 p-5">
          <div class="text-[13px] font-bold text-red-600 uppercase tracking-wide mb-3">✗ Запрет</div>
          <ul class="space-y-2 text-[14px] text-slate-600">
            <li>Дети терпят и ждут конца смены</li>
            <li>Мысли только о телефоне</li>
            <li>Бросаются в экран с удвоенной силой</li>
            <li>Нет реального выбора и понимания</li>
          </ul>
        </div>
        <div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-5">
          <div class="text-[13px] font-bold text-emerald-600 uppercase tracking-wide mb-3">✓ Замещение</div>
          <ul class="space-y-2 text-[14px] text-slate-600">
            <li>Телефон доступен — но стоит денег</li>
            <li>Дети сами сравнивают ценность</li>
            <li>Выбирают костёр и командные активности</li>
            <li>Навык принятия осознанных решений</li>
          </ul>
        </div>
      </div>

      <!-- Section 3 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда дети начинают договариваться
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ребёнок, который утром хотел «просто посидеть в телефоне», к обеду уже ведёт переговоры с соседями по комнате. Потому что на костёр с зефирками нужно скинуться всем вместе. А кто-то хочет не костёр, а кино. А кто-то вообще копит на набор для экспериментов.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Появляются коалиции. Кто-то предлагает: «Я сделаю за тебя уборку — ты дашь мне 100 единиц». Кто-то берёт на себя роль агитатора и убеждает группу проголосовать за конкретную коллективную покупку.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          На одной из смен мы попробовали ввести должность «шерифа» — выборного менеджера порядка, который следит за дисциплиной и получает за это зарплату. Затея провалилась: шериф получал деньги и ничего не делал. Мы быстро эту позицию упразднили. Но сам эксперимент стал для детей уроком: оплата без контроля результата — это бесполезная трата ресурсов.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Теневая экономика — и налёт на сейф
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самое удивительное началось, когда дети стали обменивать игровую валюту на настоящие деньги — те, что родители дали на буфет. Появился чёрный рынок. Появился шантаж. И даже был налёт на сейф, где хранилась общая касса.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы не стали наказывать за «теневую экономику». Мы стали обсуждать её вечером всей группой. Где граница между предприимчивостью и мошенничеством? Что случится, если в реальной жизни подделать деньги? Почему шантаж работает только один раз? Эти разговоры дали больше, чем любой урок обществознания.
        </p>
      </div>

      <!-- Checklist block -->
      <div class="my-8 rounded-2xl bg-emerald-50 border border-emerald-100 p-6">
        <h3 class="text-[16px] font-bold text-emerald-800 mb-4">✓ Что работает вместо запрета</h3>
        <ul class="space-y-2">
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Сделать экранное время платным — ребёнок сам считает ценность</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Создать конкурирующие альтернативы: костёр, кино, эксперименты</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Коллективные покупки — дети учатся договариваться</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Повышение цены при повторе — закон убывающей отдачи на практике</li>
          <li class="flex items-start gap-2 text-[15px] text-slate-700"><span class="text-emerald-500 font-bold shrink-0">✓</span> Ежедневный бюджет — навык планирования и самостоятельности</li>
        </ul>
      </div>

      <!-- Section 5 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что происходит к концу смены
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Обычно на третий-четвёртый день мы видим перелом. Дети перестают тратить весь бюджет на телефон. Не потому что запретили — а потому что появились вещи, которых они хотят сильнее.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          К концу смены среднее экранное время падает до 5–10 минут в день. А у многих — до нуля. Тыкание в YouTube заменяется настолками, мафией, волейболом.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Ночь с телефонами» — самая дорогая покупка в нашем меню. После первой покупки цена повторной растёт. Дети быстро чувствуют на себе закон убывающей отдачи. Вторая «ночь с телефонами» уже не кажется такой ценной. И они начинают выбирать другое.
        </p>
      </div>

      <!-- Section 6 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему это работает (и почему запрет — нет)
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Запрет создаёт дефицит. А дефицит создаёт одержимость. Забрали телефон — ребёнок думает только о телефоне. Вернули — бросается в него с удвоенной жадностью.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Наша система работает наоборот. Телефон доступен всегда. Но у него есть цена. И есть альтернативы, которые стоят тех же денег. Ребёнок сам решает, что для него ценнее — 60 минут ленты TikTok или костёр с друзьями. Когда выбор настоящий — результат тоже настоящий.
        </p>
      </div>

      <!-- Section 7 -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Побочные эффекты
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          За несколько сезонов мы заметили устойчивые паттерны:
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Начинают считать.</strong> Один папа написал после смены: ребёнок впервые в жизни предложил вести семейный бюджет расходов на каникулы. Ему 11 лет.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Перестают просить телефон «просто так».</strong> Не из страха — а потому что научились видеть альтернативы.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Меняют приоритеты.</strong> У нас был случай, когда ребёнок после смены перестал мечтать быть курьером и захотел стать дизайнером.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[15px] text-slate-700"><strong>Возвращаются.</strong> 60% детей приезжают на следующую смену. Для лагеря это редкая цифра.</span>
          </li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="mb-10 border-t border-slate-100 pt-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Для родителей, которые узнают себя
          </h2>
        </div>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если вы каждое лето думаете: «Хоть бы он оторвался от экрана», — мы вас понимаем. Мы тоже через это прошли. И перестали воевать с телефоном. Мы сделали его частью системы, в которой ребёнок учится выбирать.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп — это выездной IT-лагерь в Подмосковье для детей 7–14 лет. 66 км от Москвы, бассейн, 5-разовое питание, образовательная лицензия. Программа: Python, AI, дроны, 3D-моделирование — в зависимости от возраста.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Но главное отличие — не в программировании. А в том, что здесь ребёнок каждый день принимает настоящие решения. И учится жить с их последствиями.
        </p>
        <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-500 italic">
          Смены лета 2026: с 30 мая по 26 августа. Забронировать место: <a href="https://aidacamp.ru" class="text-[#ff8a00] hover:underline">aidacamp.ru</a>
        </p>
      </div>

    </article>
  </main>
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
