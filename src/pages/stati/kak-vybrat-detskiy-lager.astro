---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Лицензия, условия, программа" },
  { title: "Смены 2026", url: "/ceny/", icon: "calendar-event", description: "Расписание и цены смен" },
  { title: "Отзывы родителей", url: "/otzyvy/", icon: "chat-quote", description: "Опыт реальных семей" },
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove/", icon: "houses", description: "Медработник на территории" },
];
---

<Base
  title="Как выбрать детский лагерь 2026 — 7 критериев | АйДаКемп"
  description="Как выбрать детский лагерь и не ошибиться: лицензия, программа, размер группы, безопасность, отзывы. Чек-лист для родителей с примерами."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/kak-vybrat-detskiy-lager" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Как выбрать детский лагерь 2026 — 7 критериев, которые реально важны",
      "description": "Как выбрать детский лагерь и не ошибиться: лицензия, программа, размер группы, безопасность, отзывы. Чек-лист для родителей с примерами.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-05-15",
      "dateModified": "2026-05-15",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/kak-vybrat-detskiy-lager"
      }
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Как выбрать детский лагерь 2026", "item": "https://aidacamp.ru/stati/kak-vybrat-detskiy-lager/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как выбрать детский лагерь — 7 критериев, которые реально важны"
    subtitle="Выбор лагеря — одно из тех решений, где ошибка дорого обходится и деньгами, и нервами. Собрали семь критериев, которые действительно влияют на то, каким будет лето ребёнка."
    imageBase="hakaton"
    imageAlt="Подростки на занятии в летнем лагере"
    readTime="7 мин чтения"
    breadcrumbsLast="Как выбрать детский лагерь"
    daryaQuote="Когда я выбирала лагерь для дочери — смотрела на всё: сайт, отзывы, лицензию, размер групп. В итоге оказалось, что самые важные вещи не те, о которых пишут в рекламе."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Выбор лагеря — одно из тех решений, где ошибка дорого обходится и деньгами, и нервами. Собрали семь критериев, которые действительно влияют на то, каким будет лето ребёнка.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            1. Лицензия и документы
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не формальность. Лицензия на образовательную деятельность от Минобрнауки означает, что лагерь прошёл проверку — программа, педагоги, условия. Без неё невозможно оформить налоговый вычет 13%. Реестровый номер туроператора (РТО) означает страховку ответственности. Проверяйте оба в открытых реестрах, не верьте на слово.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            2. Размер группы
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          8–10 человек — комфортный размер. 20+ — конвейер. В маленькой группе преподаватель знает каждого по имени, видит прогресс, замечает настроение. В большой — нет. АйДаКемп держит группы до 8 человек — принципиально.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            3. Конкретная программа
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          «Творческое развитие» и «командная работа» — не программа. Программа — это: что именно делает школьник с 9 до 11, с 16 до 18, что получает в итоге. Хороший признак — хакатон или защита проекта в конце смены: значит, есть реальный результат, а не «мы занимались».
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            4. Возраст и разделение по группам
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          7-летнему и 14-летнему нельзя в одной группе — разные задачи, разная динамика, разные правила. Спросите: как делятся группы? Кто с кем живёт? Если «все вместе» — это сигнал.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5. Безопасность и медицина
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Охрана 24/7, видеонаблюдение, закрытая территория — необходимый минимум. Важнее: есть ли медработник физически на территории, а не «по звонку».
        </p>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            6. Отзывы из первых уст
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Яндекс.Карты и 2ГИС сложнее накрутить, чем собственный сайт. Смотрите среднюю оценку, читайте негативные отзывы — как лагерь реагирует на критику, важнее самой критики. Хороший признак — ответы директора в каждом комментарии.
        </p>
      </div>

      <!-- Section 7 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            7. Связь с ребёнком
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ежедневные фото в Telegram, расписание звонков, имя конкретного вожатого — признаки прозрачности. «Мы не даём телефон — это вредно» без альтернативы — признак закрытости.
        </p>
      </div>

      <!-- Чек-лист -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чек-лист перед бронированием
          </h2>
        </div>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Лицензия Минобрнауки — проверена в реестре</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Реестровый номер туроператора — проверен</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Группы до 10 человек</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Конкретная программа с результатом</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Раздельные группы по возрасту</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Медработник живёт на территории</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Отзывы 4.5+ на Яндекс.Картах</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Ежедневные фото родителям</p>
          </div>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="АйДаКемп — всё из чек-листа в одном лагере"
    bookingSubtitle="Лицензия, группы до 8 человек, медработник 24/7, ежедневные фото. Расскажем подробнее — без давления."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
