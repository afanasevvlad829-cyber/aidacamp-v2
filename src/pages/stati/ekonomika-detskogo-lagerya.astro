---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Лагеря мира: сравнение цен", url: "/stati/detskie-lagerya-v-mire/", icon: "cash-coin", description: "США, Швейцария, Япония — кто сколько платит" },
  { title: "Сколько стоит лагерь?", url: "/stati/skolko-stoit-detskiy-lager/", icon: "coin", description: "Разбор всех статей расходов" },
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "receipt", description: "Как вернуть до 6 200 ₽" },
  { title: "ИТ-лагерь для детей", url: "/it-lager-dlya-detey/", icon: "cpu", description: "Что умеют ребята после смены" },
];
---

<Base
  title="Почему детский лагерь стоит столько, сколько стоит: экономика изнутри | АйДаКемп"
  description="44% выручки уходит на аренду базы. В США эту статью несёт НКО-фонд с землёй 1950-х годов. В Норвегии — государство. В России — вы. Разбираем экономику детских лагерей по цифрам."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Почему детский лагерь стоит столько, сколько стоит: экономика изнутри",
      "description": "Разбираем структуру затрат детского лагеря: аренда базы, персонал, питание, маржа. Сравниваем с США, Францией, Норвегией — и объясняем, почему цена в России такая, какая есть.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-29",
      "dateModified": "2026-06-29",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/ekonomika-detskogo-lagerya"}
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Почему детский лагерь стоит столько, сколько стоит: экономика изнутри"
    subtitle="44% выручки уходит на аренду базы — ещё до первого ребёнка. В Норвегии это платит государство. В США — НКО-фонд с землёй 1950-х. В России — вы. Разбираем по цифрам."
    imageBase="lager-programmirovaniya"
    imageAlt="Экономика детского лагеря — из чего складывается цена путёвки"
    breadcrumbsLast="Экономика лагеря"
    readTime="7 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-10 pb-0">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «Почему так дорого?» — самый частый вопрос про лагерь. Обычно за ним стоит ощущение, что кто-то наживается. Давайте разберём, куда реально уходят деньги — по данным реальных лагерей, а не по ощущениям.
        </p>
      </div>

      <!-- ═══ КУДА УХОДЯТ ДЕНЬГИ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Куда уходят деньги: структура затрат российского лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Возьмём реальный кейс: коммерческий лагерь в Подмосковье, смена 14 дней, путёвка в среднем ценовом сегменте. Лагерь работает на арендованной базе — самая распространённая модель на рынке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          По данным vc.ru (кейс лагеря «Мирайны», выручка 116,5 млн руб.) и отраслевым бизнес-планам, картина такая:
        </p>

        <!-- Визуальная разбивка затрат -->
        <div class="rounded-[20px] border border-slate-100 overflow-hidden mb-6">
          {[
            { label: "Аренда базы (с питанием)", pct: "44–50%", rub: "30 800–35 000 ₽", color: "bg-red-400", width: "47%", note: "Главная статья. Платится до начала смены." },
            { label: "Зарплата персонала", pct: "20–23%", rub: "14 000–16 100 ₽", color: "bg-orange-400", width: "21%", note: "Вожатые, методист, врач, охрана." },
            { label: "Питание (если не в аренде)", pct: "~18%", rub: "~12 600 ₽", color: "bg-amber-400", width: "18%", note: "300–600 ₽/день на ребёнка по нормативам." },
            { label: "Программа и материалы", pct: "~5%", rub: "~3 500 ₽", color: "bg-blue-400", width: "5%", note: "Расходники, инвентарь, педагоги-специалисты." },
            { label: "Маркетинг", pct: "3–10%", rub: "2 100–7 000 ₽", color: "bg-purple-400", width: "6%", note: "Зависит от модели продаж." },
            { label: "Маржа оператора", pct: "6–13%", rub: "4 200–9 100 ₽", color: "bg-green-400", width: "8%", note: "До уплаты налогов и кассовых разрывов." },
          ].map((row, i) => (
            <div class={`px-5 py-4 ${i % 2 === 0 ? 'bg-white' : 'bg-slate-50'} border-b border-slate-100 last:border-0`}>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[14px] font-semibold text-slate-800">{row.label}</span>
                <span class="text-[14px] font-mono font-bold text-slate-700">{row.pct}</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                <div class={`h-2 rounded-full ${row.color}`} style={`width: ${row.width}`}></div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[12px] text-slate-400">{row.note}</span>
                <span class="text-[13px] font-mono text-slate-500">{row.rub}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="rounded-[16px] bg-red-50 border-l-4 border-red-400 px-6 py-5 mb-4">
          <p class="text-[16px] leading-[1.6] text-slate-700">
            <strong>Реальный кейс (vc.ru, 2022):</strong> лагерь с выручкой 116,5 млн рублей заработал чистой прибыли 7,3 млн — <strong>маржа 6,3%</strong>. Если бы та же база была в собственности, прибыль была бы в 2,4 раза выше.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <AnimatedStat
            value="44"
            unit="%"
            label="выручки уходит на аренду базы у коммерческого лагеря без собственной земли"
            source="beboss.ru, отраслевые данные 2024"
            tone="red"
            size="lg"
          />
          <AnimatedStat
            value="6"
            unit="%"
            label="реальная маржа оператора — меньше, чем в большинстве малых бизнесов"
            source="vc.ru, кейс лагеря «Мирайны» 2022"
            tone="orange"
            size="lg"
          />
          <AnimatedStat
            value="2.4"
            unit="x"
            label="во столько раз выше прибыль, если лагерь владеет базой, а не арендует"
            source="расчёт на основе данных vc.ru"
            tone="blue"
            size="lg"
          />
        </div>
      </div>

      <!-- ═══ СОВЕТСКОЕ НАСЛЕДИЕ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Куда исчезли советские лагеря — и почему государство не помогает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          В 1989 году в СССР работало около 5 300 загородных лагерей. Сегодня — примерно 2 100. Ещё около 2 000 объектов стоят заброшенными: принадлежат муниципалитетам, разрушаются, никому не нужны.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Казалось бы — вот готовая инфраструктура. Почему государство не сдаёт её коммерческим операторам по льготной цене? По данным «Известий», за всё время концессионные соглашения заключены лишь по <strong>20–30 объектам</strong> по всей стране. Не потому что государство не хочет, а потому что не может найти инвесторов: восстановление одного корпуса на 60 мест стоит ~30 млн рублей, окупаемость — 5–7 лет. Бизнес хочет 2–3 года.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Для восстановления всей советской сети лагерей нужно, по оценке АСИ, <strong>135 млрд рублей</strong>. Деньги не выделены. Рынок живёт без государственной инфраструктурной поддержки — на рыночной аренде частных баз.
        </p>

        <AnimatedBarChart
          title="Детские лагеря в России: что осталось"
          items={[
            { label: "Лагерей в 1989 году", value: 5300, badge: "5 300", color: "#94A3B8" },
            { label: "Работают сейчас", value: 2100, badge: "2 100", color: "#10B981" },
            { label: "Стоят заброшенными", value: 2000, badge: "~2 000", color: "#EF4444" },
            { label: "Концессионных соглашений", value: 30, badge: "20–30", color: "#F97316" },
          ]}
          source="Роспотребнадзор 2023, «Известия», АСИ 2019"
          maxValue={5300}
        />
      </div>

      <!-- ═══ А КАК В ДРУГИХ СТРАНАХ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            А как в других странах: кто несёт стоимость базы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Разница в цене путёвки между странами — это не разница в качестве программы. Это разница в том, <strong>кто платит за землю и инфраструктуру</strong>.
        </p>

        <div class="space-y-4 mb-6">
          <!-- Норвегия -->
          <div class="rounded-[16px] border border-slate-100 overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-slate-900">
              <span class="text-[28px] leading-none">🇳🇴</span>
              <p class="text-white font-semibold text-[15px]">Норвегия: лагерь — часть образования</p>
              <span class="ml-auto text-green-400 font-mono text-[14px] font-bold">Бесплатно</span>
            </div>
            <div class="px-5 py-4 bg-white">
              <p class="text-[15px] leading-[1.7] text-slate-600">
                <em>Leirskole</em> — выездной лагерь минимум на 2 ночи — входит в обязательную школьную программу согласно §2-3 Закона об образовании. Все дети 6-го класса государственных школ едут обязательно. Финансирование — из муниципальных бюджетов образования. Базы принадлежат муниципалитетам, никакой ипотеки нет. Для семьи — бесплатно.
              </p>
            </div>
          </div>

          <!-- Финляндия -->
          <div class="rounded-[16px] border border-slate-100 overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-slate-900">
              <span class="text-[28px] leading-none">🇫🇮</span>
              <p class="text-white font-semibold text-[15px]">Финляндия: НКО владеют базами совместно</p>
              <span class="ml-auto text-green-400 font-mono text-[14px] font-bold">Минимум</span>
            </div>
            <div class="px-5 py-4 bg-white">
              <p class="text-[15px] leading-[1.7] text-slate-600">
                Некоммерческие организации владеют базами совместно и предоставляют их другим НКО бесплатно или по себестоимости. Ежегодные волонтёрские трудовые лагеря обслуживают инфраструктуру. Нулевые расходы на аренду базы — минимальная цена путёвки. Часть лагерей субсидируется через муниципальные спортивные и культурные программы.
              </p>
            </div>
          </div>

          <!-- Франция -->
          <div class="rounded-[16px] border border-slate-100 overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-slate-900">
              <span class="text-[28px] leading-none">🇫🇷</span>
              <p class="text-white font-semibold text-[15px]">Франция: субсидируют спрос, не предложение</p>
              <span class="ml-auto text-amber-400 font-mono text-[14px] font-bold">−40–70%</span>
            </div>
            <div class="px-5 py-4 bg-white">
              <p class="text-[15px] leading-[1.7] text-slate-600">
                CAF (Caisse d'Allocations Familiales) покрывает <strong>40–70% стоимости путёвки</strong> в зависимости от дохода семьи. С 2024 года работает Pass Colo — прямая субсидия €200–350 детям 11 лет. Организаторы — ассоциации 1901 закона (аналог НКО) с льготным налогообложением. Муниципалитеты сдают свои «centres de vacances» НКО по символической цене. Модель: государство субсидирует и инфраструктуру, и доступ.
              </p>
            </div>
          </div>

          <!-- США -->
          <div class="rounded-[16px] border border-slate-100 overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-slate-900">
              <span class="text-[28px] leading-none">🇺🇸</span>
              <p class="text-white font-semibold text-[15px]">США: земля НКО — подарок 1950-х годов</p>
              <span class="ml-auto text-orange-400 font-mono text-[14px] font-bold">$50–325/день</span>
            </div>
            <div class="px-5 py-4 bg-white">
              <p class="text-[15px] leading-[1.7] text-slate-600">
                США — парадокс. Дорогие частные лагеря ($200–325/день) несут полную стоимость земли и ипотеки — это главный драйвер цены. Но НКО-лагеря (YMCA, BSA, еврейские федерации) стоят на земле, которую <strong>получили в подарок или купили за копейки в 1920–1960-х</strong>. Никакой амортизации недвижимости — маржа 17% против 2–3% у частных overnight camp. Именно поэтому YMCA-лагерь дешевле, чем лагерь в Малибу: не программа хуже, а история владения другая.
              </p>
              <div class="mt-3 grid grid-cols-2 gap-3">
                <div class="rounded-[12px] bg-green-50 px-4 py-3">
                  <p class="text-[12px] font-bold uppercase text-green-700 mb-1">НКО-лагерь (YMCA)</p>
                  <p class="text-[18px] font-bold text-slate-900">17% маржа</p>
                  <p class="text-[12px] text-slate-500">Земля амортизирована</p>
                </div>
                <div class="rounded-[12px] bg-red-50 px-4 py-3">
                  <p class="text-[12px] font-bold uppercase text-red-700 mb-1">Частный overnight</p>
                  <p class="text-[18px] font-bold text-slate-900">2–3% маржа</p>
                  <p class="text-[12px] text-slate-500">Несёт стоимость земли</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Россия -->
          <div class="rounded-[16px] border-2 border-slate-200 overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-slate-800">
              <span class="text-[28px] leading-none">🇷🇺</span>
              <p class="text-white font-semibold text-[15px]">Россия: платите вы</p>
              <span class="ml-auto text-red-400 font-mono text-[14px] font-bold">44–50% в аренду</span>
            </div>
            <div class="px-5 py-4 bg-white">
              <p class="text-[15px] leading-[1.7] text-slate-600">
                Государство владеет тысячами заброшенных баз, но субсидированной аренды для операторов практически нет. Концессионных соглашений — 20–30 на всю страну. Правительство компенсирует до 5% затрат на инфраструктуру. Остальное — рыночная аренда частных баз. Оператор несёт полную стоимость инфраструктуры — и транслирует её в цену путёвки.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ ГЛАВНЫЙ ВОПРОС ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто несёт стоимость инфраструктуры: сравнение по странам
          </h2>
        </div>

        <div class="rounded-[16px] border border-slate-200 overflow-hidden mb-6">
          <table class="w-full text-[14px]">
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="text-left px-4 py-3 font-semibold">Страна</th>
                <th class="text-left px-4 py-3 font-semibold">Кто платит за базу</th>
                <th class="text-left px-4 py-3 font-semibold hidden sm:table-cell">Механизм</th>
                <th class="text-right px-4 py-3 font-semibold">Цена/день</th>
              </tr>
            </thead>
            <tbody>
              {[
                { flag: "🇳🇴", name: "Норвегия", who: "Государство (полностью)", mech: "Муниципальный бюджет образования", price: "0 ₽", hi: false },
                { flag: "🇫🇮", name: "Финляндия", who: "НКО-сети совместно", mech: "Волонтёрское обслуживание, субсидии", price: "~0–500 ₽", hi: false },
                { flag: "🇫🇷", name: "Франция", who: "Государство + семья", mech: "CAF 40–70%, Pass Colo, муниципалитеты", price: "~1 500–3 000 ₽", hi: false },
                { flag: "🇺🇸", name: "США (НКО)", who: "Исторические фонды", mech: "Земля подарена в 1920–1960-х, нет амортизации", price: "~4 500–8 000 ₽", hi: false },
                { flag: "🇷🇺", name: "Россия (коммерч.)", who: "Оператор → родители", mech: "Рыночная аренда частных баз, 44–50% выручки", price: "~7 500–9 000 ₽", hi: true },
                { flag: "🇺🇸", name: "США (частный)", who: "Оператор (ипотека)", mech: "Земля $500 тыс.–$5 млн, стоимость в путёвке", price: "~14 000–29 000 ₽", hi: false },
              ].map((row) => (
                <tr class={`border-t border-slate-100 ${row.hi ? 'bg-orange-50' : 'odd:bg-white even:bg-slate-50'}`}>
                  <td class="px-4 py-3">
                    <span class="text-[20px] mr-2">{row.flag}</span>
                    <span class={`font-medium ${row.hi ? 'text-orange-800' : 'text-slate-700'}`}>{row.name}</span>
                  </td>
                  <td class={`px-4 py-3 ${row.hi ? 'text-orange-700 font-medium' : 'text-slate-600'}`}>{row.who}</td>
                  <td class="px-4 py-3 hidden sm:table-cell text-slate-400 text-[13px]">{row.mech}</td>
                  <td class={`px-4 py-3 text-right font-mono font-bold ${row.hi ? 'text-orange-700' : 'text-slate-600'}`}>{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="rounded-[16px] bg-slate-50 border-l-4 border-slate-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700">
            <strong>Главный вывод:</strong> Российский коммерческий лагерь (~7 500–9 000 ₽/день) стоит примерно столько же, сколько американский НКО-лагерь с историческими активами. Только американский НКО получил землю в подарок в 1950-х. Российский оператор платит рыночную аренду прямо сейчас — каждый сезон.
          </p>
        </div>
      </div>

      <!-- ═══ ПОЧЕМУ ДЕШЁВЫЕ ДЕШЁВЫЕ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему самый дешёвый лагерь — самый дешёвый
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Если оператор не снижает цену за счёт субсидий или собственной базы — он снижает её за счёт чего-то другого. Вот на чём реально экономят:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          {[
            { icon: "egg-fried", title: "Питание", bad: "200–250 ₽/день на ребёнка", norm: "400–600 ₽/день по СанПиН", text: "Убирают фрукты, второе, разнообразие. Роспотребнадзор фиксирует нарушения хранения как самые частые." },
            { icon: "person", title: "Вожатые", bad: "Студенты без опыта, 20–25 тыс./смену", norm: "Опытный педагог 35–50 тыс./смену", text: "Плюс повышенная нагрузка: не 1:15, а 1:25 и выше." },
            { icon: "house", title: "База", bad: "Ветхие корпуса 1970-х без ремонта", norm: "Современная база, кондиционеры, нормальные душевые", text: "Ставка аренды у ветхих объектов в 2–3 раза ниже." },
            { icon: "calendar-check", title: "Программа", bad: "Тихий час + дискотека + «кружки на бумаге»", norm: "Специалисты, расходники, реальные проекты", text: "Экономия на педагогах-специалистах полностью убирает эту статью из бюджета." },
          ].map(row => (
            <div class="rounded-[16px] bg-white border border-slate-200 p-5">
              <div class="flex items-center gap-2 mb-3">
                <i class={`bi bi-${row.icon} text-slate-400 text-[18px]`} aria-hidden="true"></i>
                <p class="font-semibold text-slate-900">{row.title}</p>
              </div>
              <p class="text-[13px] text-slate-500 mb-1">{row.text}</p>
              <div class="mt-3 space-y-1.5">
                <div class="flex items-center gap-2">
                  <i class="bi bi-x-circle text-red-400 text-[14px] shrink-0" aria-hidden="true"></i>
                  <span class="text-[13px] text-red-700">{row.bad}</span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="bi bi-check-circle text-green-500 text-[14px] shrink-0" aria-hidden="true"></i>
                  <span class="text-[13px] text-green-800">{row.norm}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="rounded-[16px] bg-amber-50 border border-amber-100 px-6 py-4">
          <p class="text-[15px] leading-[1.7] text-slate-700">
            <strong>Парадокс дешёвого лагеря:</strong> оператор при цене 30 000 ₽ тратит на питание ~4 200 ₽ за смену (200 ₽/день) и нанимает студентов-вожатых. Родитель экономит 40 000 ₽ — но получает совершенно другой продукт. Экономия видна в путёвке. Разница — в том, что происходит с ребёнком.
          </p>
        </div>
      </div>

      <!-- ═══ ВЫВОД ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Так почему лагерь стоит столько, сколько стоит?
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Потому что кто-то должен платить за землю, базу и инфраструктуру. В Норвегии это делает государство. В США — НКО с историческими активами. Во Франции — государство субсидирует 40–70% прямо из налогов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          В России этих механизмов нет. Государство владеет тысячами заброшенных баз, но не восстанавливает и не субсидирует. Коммерческий оператор арендует рыночную базу — и 44–50% каждой путёвки уходит собственнику площадки ещё до того, как ребёнок приехал.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-8">
          Маржа оператора при этом — 6–13%. Это меньше, чем у большинства малых бизнесов. «Дорогой» лагерь — это не жадность. Это структура рынка, в которой государство не участвует.
        </p>

        <div class="rounded-[20px] bg-slate-900 text-white px-7 py-6">
          <p class="text-[17px] font-bold mb-3">Цена путёвки — это не прибыль организатора. Это стоимость всей системы</p>
          <p class="text-[15px] leading-[1.7] text-slate-300 mb-4">
            Когда вы платите за смену в АйДаКемп, 44–50% уходит за аренду базы, 20–23% — персоналу, ещё ~18% — питанию. На программу — то, ради чего всё и делается — остаётся около 5%. И ~6–13% — операционная маржа, из которой оператор платит налоги, закрывает кассовые разрывы и строит следующий сезон.
          </p>
          <p class="text-[15px] leading-[1.7] text-slate-300">
            Именно поэтому мы так серьёзно относимся к программе: она стоит меньше всего — и при этом определяет всё.
          </p>
        </div>
      </div>

