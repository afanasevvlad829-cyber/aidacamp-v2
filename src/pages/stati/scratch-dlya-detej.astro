---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь Scratch", url: "/scratch-lager", icon: "blocks", description: "Первый язык для детей 7–10 лет" },
  { title: "Лагерь для школьников", url: "/lager-dlya-shkolnikov", icon: "backpack", description: "1–8 класс, IT-проект" },
  { title: "Следующий шаг — Python", url: "/python-lager", icon: "code-slash", description: "После Scratch" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
];
---

<Base
  title="Scratch для детей — что это и почему с него начинают | АйДаКемп"
  description="Scratch для детей 7-11 лет: что такое Scratch, почему это лучший старт в программировании, что создают дети и как перейти к Python."
  ogImage="/images/articles/ii-programmista-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/scratch-dlya-detej" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Scratch для детей: первые шаги в программировании",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/scratch-dlya-detej"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Scratch для детей: первые шаги в программировании"
    subtitle="Почему миллионы детей начинают программировать именно со Scratch — и как плавно перейти к Python."
    imageBase="ii-programmista"
    imageAlt="Ребёнок создаёт анимацию в Scratch — первые шаги в программировании"
    readTime="5 мин чтения"
    breadcrumbsLast="Scratch для детей"
    daryaQuote="Когда дочь была младше, я не знала с чего начать с программированием. Оказалось — Scratch. За один вечер она сделала мультик с говорящей кошкой. Гордости не было предела — у неё и у меня."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Scratch — это не упрощённое программирование для малышей. Это полноценная среда разработки, где вместо набора кода ребёнок собирает блоки как конструктор. Всё работает сразу — и именно поэтому первый успех приходит быстро, а не через месяц изучения синтаксиса.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое Scratch и почему он такой популярный
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch создали в MIT Media Lab — одном из самых известных технологических университетов мира. Идея простая: дать детям возможность программировать без необходимости запоминать синтаксис. Вместо строчек кода — цветные блоки, которые соединяются друг с другом.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Результат виден мгновенно: персонаж на экране двигается, говорит, реагирует на нажатие кнопки. Это важно — дети мотивируются видимым результатом, а не абстрактными объяснениями.
        </p>
        <StatCallout
          value="100 млн+"
          label="пользователей у Scratch по всему миру. Это самая популярная платформа для первых шагов в программировании"
          source="scratch.mit.edu, 2024"
          icon="globe"
          tone="neutral"
        />
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            С какого возраста подходит Scratch
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Идеальный возраст — 7–11 лет. Ребёнок уже умеет читать и работать с мышкой, но ещё не привык бояться «непонятного». Именно в этом возрасте Scratch даётся легче всего.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С 6 лет тоже возможно — если рядом есть взрослый, который объясняет задание и помогает с чтением.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После 12 лет Scratch начинает «тормозить» — у подростков появляется желание сделать что-то серьёзное, а Scratch ограничивает. Это хороший знак: пора переходить на Python.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что создают дети на Scratch
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Диапазон проектов — от простых анимаций до вполне серьёзных игр:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-[14px] font-semibold text-slate-700 mb-1">Анимированные истории</p>
            <p class="text-[13px] text-slate-500 leading-[1.5]">Персонажи разговаривают, двигаются, реагируют на события</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-[14px] font-semibold text-slate-700 mb-1">Простые игры</p>
            <p class="text-[13px] text-slate-500 leading-[1.5]">Платформеры, лабиринты, викторины, «поймай предмет»</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-[14px] font-semibold text-slate-700 mb-1">Интерактивные открытки</p>
            <p class="text-[13px] text-slate-500 leading-[1.5]">Поздравления с анимацией и музыкой для мамы или бабушки</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-[14px] font-semibold text-slate-700 mb-1">Мультфильмы</p>
            <p class="text-[13px] text-slate-500 leading-[1.5]">Придуманные истории с диалогами, сценами и эффектами</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Все эти проекты — не «учебные задания», а настоящие вещи, которые можно показать друзьям и поделиться ссылкой.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Scratch → Python: как происходит переход
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch — не конечная точка, а трамплин. Пока ребёнок работает в Scratch, он незаметно для себя усваивает ключевые концепции программирования: условия (если... то...), циклы (повторять 10 раз), переменные (счёт, жизни, очки).
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда ребёнок начинает «упираться» в ограничения Scratch — хочет сделать игру с базой данных, создать бота или сделать что-то, чего в Scratch просто нет — это сигнал: пора на Python. И переход даётся легко, потому что фундамент уже есть.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Дети, которые начали со Scratch, осваивают Python заметно быстрее тех, кто начинает с нуля.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как попробовать дома
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch полностью бесплатен и не требует установки. Достаточно открыть браузер:
        </p>
        <div class="rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5 mb-4">
          <p class="text-[15px] font-semibold text-slate-700 mb-2">scratch.mit.edu</p>
          <p class="text-[14px] text-slate-500 leading-[1.6]">Бесплатно, без регистрации, есть на русском языке. Работает в любом браузере без установки. Тысячи готовых проектов других детей — можно смотреть, копировать и изменять.</p>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошее начало — открыть любой понравившийся проект другого ребёнка и попробовать что-то в нём изменить. Это сразу даёт ощущение «я тоже так умею».
        </p>
      </div>

      <!-- Section 6: АйДаКемп -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Scratch в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для детей 7–9 лет в АйДаКемп есть отдельный Scratch-трек. За смену дети создают анимированные истории и мини-игры — каждый со своим проектом, который можно показать родителям на финальном хакатоне.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Лагерь в Подмосковье, 66 км от Москвы. Группы до 8 человек — наставник знает каждого ребёнка. Смены с июня по август 2026, возраст 7–15 лет.
        </p>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Ребёнку 7-9 лет и хочется попробовать?"
    bookingSubtitle="Scratch-трек в АйДаКемп — для самых маленьких программистов. Расскажем подробнее."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
