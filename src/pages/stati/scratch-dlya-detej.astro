---
import { PRICE_MIN, VYCHET_MAX, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_FROM_TO } from '../../data/evergreen';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Лагерь Scratch", url: "/scratch-lager/", icon: "blocks", description: "Первый язык для детей 7–10 лет" },
  { title: "Лагерь для школьников", url: "/lager-dlya-shkolnikov/", icon: "backpack", description: "1–8 класс, IT-проект" },
  { title: "Следующий шаг — Python", url: "/python-lager/", icon: "code-slash", description: "После Scratch" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "С какого возраста Scratch для детей оптимален?",
    answer: "Идеально — 7–11 лет. В этом возрасте ребёнок уже умеет читать и работать с мышкой, но ещё не боится ошибиться. С 6 лет возможно при участии взрослого. После 12 лет Scratch начинает «тормозить» — у подростков появляется желание сделать что-то серьёзнее, и это сигнал переходить на Python."
  },
  {
    question: "Scratch — это «настоящее» программирование?",
    answer: "Да. Scratch — это полноценная среда разработки с условиями, циклами, переменными, событиями и параллельными процессами. Просто вместо строк кода — цветные блоки. Все концепции, которые учат в Scratch, есть и в Python, и в JavaScript. Это не «детская игрушка», а нормальный первый язык."
  },
  {
    question: "После Scratch — что дальше?",
    answer: "Следующий шаг — Python. Он ближайший по логике к Scratch, но уже «настоящий» код. Дети, которые начали со Scratch, осваивают Python в 1,5–2 раза быстрее. После Python — специализация по интересу: веб (JavaScript), AI (Python дальше), игры (Unity/C#), мобильные приложения."
  },
  {
    question: "Нужно ли платить за Scratch?",
    answer: "Нет. Scratch полностью бесплатен — сайт scratch.mit.edu, регистрация не обязательна, работает в браузере без установки. Тысячи готовых проектов других детей открыты для просмотра и изменения. Единственное, что стоит денег — это обучение с наставником, если нужно системное развитие."
  },
  {
    question: "Scratch в школе или в лагере — в чём разница?",
    answer: "В школе Scratch — один урок в неделю, в классе 25 человек, наставник не успевает помочь каждому. В лагере — 6–8 часов практики каждый день, группы до 8 человек, наставник видит где застрял каждый ребёнок. За 10 дней лагеря ребёнок проходит то, на что в школе ушёл бы год."
  },
  {
    question: "Можно ли в Scratch создать игру и поделиться с друзьями?",
    answer: "Да, это одна из лучших особенностей Scratch. После публикации проект получает ссылку — отправьте её в чат класса, и одноклассники смогут сыграть прямо в браузере. Никакой установки, никаких лишних шагов. Школьники часто устраивают неформальные соревнования: чья игра наберёт больше сердечек. Это настоящая публикация для реальной аудитории — очень мотивирует."
  },
  {
    question: "Что ребёнок 7–8 лет реально сделает в Scratch за первый месяц?",
    answer: "За первый месяц занятий по 30–60 минут несколько раз в неделю школьник 7–8 лет обычно делает: анимацию с говорящим персонажем (неделя 1–2), простую игру «поймай предмет» (неделя 3), интерактивный мультик с выборами (неделя 4). Это не теория — это результаты, которые мы видим на Scratch-треке в АйДаКемп у самых маленьких участников."
  }
];
---

<Base
  title="Scratch для детей: как начать программировать с первого проекта"
  description="Без страшного кода, с первого дня работает. Почему Scratch — лучший старт, что создадут дети и как плавно перейти к Python."
  ogImage="/images/articles/ii-programmista-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Scratch для детей — что это и почему с него начинают | АйДаКемп",
        "description": "Scratch для детей 7-11 лет: что такое Scratch, почему это лучший старт в программировании, что создают дети и как перейти к Python.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-24",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/scratch-dlya-detej"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Scratch для детей", "item": "https://aidacamp.ru/stati/scratch-dlya-detej/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Scratch для детей: как сделать первые шаги в программировании"
    subtitle="Почему миллионы детей начинают программировать именно со Scratch — и как плавно перейти к Python."
    imageBase="ii-programmista"
    imageAlt="Ребёнок создаёт анимацию в Scratch — первые шаги в программировании"
    readTime="5 мин чтения"
    breadcrumbsLast="Scratch для детей"
    daryaQuote="Когда дочь была младше, я не знала с чего начать с программированием. Оказалось — Scratch. За один вечер она сделала мультик с говорящей кошкой. Гордости не было предела — у неё и у меня."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Scratch — это не упрощённое программирование для малышей. Это полноценная среда разработки, где вместо набора кода ребёнок собирает блоки как конструктор. Всё работает сразу — и именно поэтому первый успех приходит быстро, а не через месяц изучения синтаксиса.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое Scratch и почему он такой популярный
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch создали в MIT Media Lab — одном из самых известных технологических университетов мира. Идея простая: дать детям возможность программировать без необходимости запоминать синтаксис. Вместо строчек кода — цветные блоки, которые соединяются друг с другом.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Результат виден мгновенно: персонаж на экране двигается, говорит, реагирует на нажатие кнопки. Это важно — дети мотивируются видимым результатом, а не абстрактными объяснениями.
        </p>
        <StatCallout
          value="100 млн+"
          label="пользователей у Scratch по всему миру. Это самая популярная платформа для первых шагов в программировании"
          source="scratch.mit.edu, 2024"
          icon="globe"
          tone="neutral"
        />
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            С какого возраста подходит Scratch
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Идеальный возраст — 7–11 лет. Ребёнок уже умеет читать и работать с мышкой, но ещё не привык бояться «непонятного». Именно в этом возрасте Scratch даётся легче всего.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С 6 лет тоже возможно — если рядом есть взрослый, который объясняет задание и помогает с чтением.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          После 12 лет Scratch начинает «тормозить» — у подростков появляется желание сделать что-то серьёзное, а Scratch ограничивает. Это хороший знак: пора переходить на Python.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что создают дети на Scratch
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Диапазон проектов — от простых анимаций до вполне серьёзных игр:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-base font-semibold text-slate-700 mb-1">Анимированные истории</p>
            <p class="text-base text-slate-500 leading-[1.5]">Персонажи разговаривают, двигаются, реагируют на события</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-base font-semibold text-slate-700 mb-1">Простые игры</p>
            <p class="text-base text-slate-500 leading-[1.5]">Платформеры, лабиринты, викторины, «поймай предмет»</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-base font-semibold text-slate-700 mb-1">Интерактивные открытки</p>
            <p class="text-base text-slate-500 leading-[1.5]">Поздравления с анимацией и музыкой для мамы или бабушки</p>
          </div>
          <div class="rounded-[14px] bg-orange-50 border border-orange-100 px-4 py-3">
            <p class="text-base font-semibold text-slate-700 mb-1">Мультфильмы</p>
            <p class="text-base text-slate-500 leading-[1.5]">Придуманные истории с диалогами, сценами и эффектами</p>
          </div>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Все эти проекты — не «учебные задания», а настоящие вещи, которые можно показать друзьям и поделиться ссылкой.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Scratch → Python: как происходит переход
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch — не конечная точка, а трамплин. Пока ребёнок работает в Scratch, он незаметно для себя усваивает ключевые концепции программирования: условия (если... то...), циклы (повторять 10 раз), переменные (счёт, жизни, очки).
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда ребёнок начинает «упираться» в ограничения Scratch — хочет сделать игру с базой данных, создать бота или сделать что-то, чего в Scratch просто нет — это сигнал: пора на Python. И переход даётся легко, потому что фундамент уже есть.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Дети, которые начали со Scratch, осваивают Python заметно быстрее тех, кто начинает с нуля.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как попробовать дома
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Scratch полностью бесплатен и не требует установки. Достаточно открыть браузер:
        </p>
        <div class="rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5 mb-4">
          <p class="text-base font-semibold text-slate-700 mb-2">scratch.mit.edu</p>
          <p class="text-base text-slate-500 leading-[1.6]">Бесплатно, без регистрации, есть на русском языке. Работает в любом браузере без установки. Тысячи готовых проектов других детей — можно смотреть, копировать и изменять.</p>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошее начало — открыть любой понравившийся проект другого ребёнка и попробовать что-то в нём изменить. Это сразу даёт ощущение «я тоже так умею».
        </p>
      </div>

      <!-- Section 6: Реальные примеры проектов -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что создают дети в Scratch: реальные примеры
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Это не список из учебника — а то, что дети реально делают в Scratch, когда им интересно:
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <div class="w-9 h-9 rounded-[10px] bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-controller text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Платформеры</p>
              <p class="text-base leading-[1.6] text-slate-500">Персонаж прыгает по платформам, собирает монеты, избегает врагов. Дети часто делают собственные уровни и дают играть друзьям по ссылке.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-9 h-9 rounded-[10px] bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-camera-video text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Анимации и мультфильмы</p>
              <p class="text-base leading-[1.6] text-slate-500">Мини-сериалы про придуманных персонажей, пересказы любимых книг или мультиков, поздравления с днём рождения для мамы — с анимацией и музыкой.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-9 h-9 rounded-[10px] bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-keyboard text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Интерактивные истории</p>
              <p class="text-base leading-[1.6] text-slate-500">Игры-выборы: «нажми A — герой идёт налево, нажми B — направо». Это уже полноценная логика, условия и ветвления.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-9 h-9 rounded-[10px] bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-bar-chart-line text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Математические игры-тренажёры</p>
              <p class="text-base leading-[1.6] text-slate-500">Программа задаёт примеры, считает правильные ответы, показывает счёт. Некоторые дети делают такие тренажёры для своих младших братьев и сестёр.</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="w-9 h-9 rounded-[10px] bg-orange-100 flex items-center justify-center shrink-0 mt-0.5">
              <i class="bi bi-lightbulb text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-0.5">Квизы и викторины для друзей</p>
              <p class="text-base leading-[1.6] text-slate-500">Вопросы с вариантами ответов, таймер, финальный счёт. Дети отправляют ссылку в класс и устраивают соревнование — кто наберёт больше очков.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 7: Scratch vs другие среды -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Scratch vs другие среды: когда переходить дальше
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Scratch — это старт, а не финиш. Вот как выглядит нормальный путь развития:
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-center">
            <div class="flex items-center gap-2">
              <div class="rounded-[8px] bg-orange-100 px-3 py-1.5">
                <span class="text-base font-bold text-orange-700">Scratch</span>
              </div>
              <i class="bi bi-arrow-right text-slate-400 text-base" aria-hidden="true"></i>
              <div class="rounded-[8px] bg-slate-100 px-3 py-1.5">
                <span class="text-base font-bold text-slate-700">Python / JavaScript</span>
              </div>
              <i class="bi bi-arrow-right text-slate-400 text-base" aria-hidden="true"></i>
              <div class="rounded-[8px] bg-slate-800 px-3 py-1.5">
                <span class="text-base font-bold text-white">Реальные проекты</span>
              </div>
            </div>
          </div>
        </div>
