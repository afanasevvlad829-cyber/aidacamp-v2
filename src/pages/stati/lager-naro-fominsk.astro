          <div class="flex gap-3 items-start border border-slate-200 rounded-xl p-4">
            <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
              <i class="bi bi-train-front text-orange-500 text-[16px]" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-[15px] font-semibold text-slate-800 mb-1">~1,5 ч от Киевского вокзала на электричке</p>
