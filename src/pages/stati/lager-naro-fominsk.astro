---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove", icon: "tree", description: "Наро-Фоминский район" },
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove", icon: "houses", description: "66 км от Москвы" },
  { title: "Лагерь из Москвы", url: "/lager-v-moskve", icon: "geo-alt", description: "Час от МКАД" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
];
---

<Base
  title="Детский лагерь в Наро-Фоминском районе 2026 — IT-смены"
  description="Детский IT-лагерь в Наро-Фоминском районе Московской области: Python, AI, Minecraft. Смены 2026 от 48 000 ₽. 66 км от Москвы, бассейн."
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-naro-fominsk" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Детский лагерь в Наро-Фоминском районе — IT-смены 2026",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-04-24",
      "url": "https://aidacamp.ru/stati/lager-naro-fominsk"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детский лагерь в Наро-Фоминском районе — IT-смены 2026"
    subtitle="АйДаКемп — лагерь в лесу Наро-Фоминского округа. Python, AI, Minecraft, бассейн. 66 км от Москвы, трансфер включён."
    imageBase="kuda-letom"
    imageAlt="Дети на IT-смене в лагере Наро-Фоминского района"
    date="2026-04-24"
    readTime="4 мин чтения"
    breadcrumbsLast="Лагерь в Наро-Фоминском районе"
    daryaQuote="Мы искали лагерь в Подмосковье — поближе к Москве, подальше от городской суеты. Наро-Фоминский район оказался идеальным: лес, воздух, и до города недалеко."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          АйДаКемп находится в Наро-Фоминском городском округе Московской области — в лесу, в 66 км от Москвы. Если вы ищете детский лагерь в Наро-Фоминском районе с реальной IT-программой, бассейном и небольшими группами — вот всё, что нужно знать.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">АйДаКемп — лагерь в Наро-Фоминском округе</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь расположен на территории санатория «Изумруд» в Наро-Фоминском городском округе. Вокруг — смешанный лес, чистый воздух, никакого городского шума. При этом инфраструктура вполне городского уровня: бассейн, спортивные площадки, медицинский корпус.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Наро-Фоминский район — один из самых экологически чистых в Подмосковье. Сосновые и берёзовые леса, реки, никакой промышленной застройки рядом. Дети две недели дышат нормальным воздухом — и это уже ценность.
        </p>
        <StatCallout
          value="66 км"
          label="от Москвы до АйДаКемп — трасса А-101 (Калужское шоссе). Трансфер от метро Тёплый Стан."
          source="Маршрут от МКАД"
          icon="geo-alt"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Как добраться: маршруты</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>На машине:</strong> из Москвы — МКАД, затем Калужское шоссе (А-101) в направлении Наро-Фоминска. Дорога хорошая, без светофоров на большей части маршрута. В нормальных условиях — 1–1,5 часа от МКАД.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Наш трансфер:</strong> самый удобный вариант. В день заезда автобус отправляется от метро «Тёплый Стан» — это последняя станция Калининско-Солнцевской линии. В день отъезда трансфер привозит детей обратно. Всё включено в стоимость смены.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          <strong>На электричке:</strong> Киевский вокзал — Нара (направление Наро-Фоминск), время в пути около 1,5 часов. От станции Нара до лагеря потребуется дополнительный трансфер — уточняйте при бронировании.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">IT-программа лагеря</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый ребёнок выбирает трек по возрасту и интересам:
        </p>
        <ul class="list-none space-y-3 mb-4">
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-braces text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Python</strong> — для детей 10–15 лет. От нуля до первой программы или игры</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-cpu text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>AI и нейросети</strong> — для 11–15 лет. Как работает ИИ, практические задачи с реальными инструментами</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-globe text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Scratch и Roblox</strong> — для детей 7–10 лет. Визуальное программирование и создание собственных игр</span>
          </li>
          <li class="flex items-start gap-2 text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
            <i class="bi bi-lightning-charge text-orange-500 mt-1 shrink-0" aria-hidden="true"></i>
            <span><strong>Minecraft с кодингом</strong> — для всех возрастов. Любимая игра плюс первые шаги в программировании</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Занятия проходят в группах до 8 человек — каждый ребёнок получает внимание преподавателя. В конце смены — хакатон: дети защищают собственные проекты.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Территория и быт</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Санаторий «Изумруд» — это не советский пионерлагерь. Комфортные корпуса, хорошее питание пять раз в день, медицинский пункт с дежурным врачом круглосуточно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После IT-занятий дети идут в бассейн, на спортивные площадки, в лес. Вечером — командные игры, мафия, творческие активности. Телефон лежит в кармане, потому что живые события интереснее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Родители могут позвонить в любое время — связь хорошая. Фотографии из лагеря публикуются ежедневно в родительском чате.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Смены и цены 2026</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смены проходят с конца мая по август. Стоимость от 48 000 ₽ за двухнедельную смену — в цену включено всё: питание, проживание, IT-программа, трансфер от метро, страховка. Никаких доплат на месте.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Группы маленькие — мест немного. Обычно ближе к лету остаются только отдельные места, а не свободные смены целиком.
        </p>
        <StatCallout
          value="от 48 000 ₽"
          label="за 2-недельную смену в АйДаКемп. Включено всё: питание, проживание, программа, трансфер, страховка."
          source="Прайс АйДаКемп 2026"
          icon="check-circle"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">Почему выбирают АйДаКемп</h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Официальный лагерь с лицензией РТО. Медик работает 24/7. Дети уезжают домой с реальным проектом — игрой, ботом или приложением, которое сделали сами на хакатоне.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Группы до 8 человек — это принципиально. Не 20 детей на одного преподавателя, а нормальный формат занятий, где виден каждый ребёнок.
        </p>
        <StatCallout
          value="5.0"
          label="— рейтинг АйДаКемп на Яндекс.Картах. 40+ отзывов родителей из Москвы и Подмосковья"
          source="Яндекс.Карты, 2026"
          icon="stars"
          tone="neutral"
        />
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Забронировать смену в Наро-Фоминском"
    bookingSubtitle="Трансфер от метро Тёплый Стан включён. Смены с мая по август 2026."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
