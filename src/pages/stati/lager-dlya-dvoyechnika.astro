---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';

const relatedPages = [
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "laptop", description: "Что делают в IT-лагере — про программу и результат" },
  { title: "Что делать если подросток ничего не хочет", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", icon: "lightbulb", description: "Мотивация без давления — как выйти из ступора" },
  { title: "Подросток не хочет учиться", url: "/stati/podrostok-ne-hochet-uchitsya/", icon: "book", description: "Причины и честный разговор с ребёнком" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Смены, программы, возраст — всё о летнем лагере" },
];

const faqItems = [
  {
    question: "Лагерь поможет ребёнку начать лучше учиться?",
    answer: "Прямой гарантии нет — и мы не будем её давать. Лагерь даёт ребёнку опыт успеха через конкретный проект, а не через оценку. Иногда этого достаточно, чтобы он по-другому посмотрел на обучение в целом. Но если причина плохих оценок — конфликт с учителем, домашняя обстановка или нераспознанная дисграфия — лагерь эти причины не устранит."
  },
  {
    question: "Ребёнок вообще не интересуется компьютерами — имеет смысл?",
    answer: "Зависит от того, чем интересуется. В лагере есть направления с игровым дизайном, анимацией, 3D-моделированием — не только «чистое программирование». Если ребёнок любит рисовать или строить — скорее всего, найдёт себя в каком-то проекте. Если же он вообще не хочет что-либо делать — это уже другой разговор."
  },
  {
    question: "Не унизительно ли отправлять «двоечника» в «умный» лагерь?",
    answer: "Это зависит от подачи. Если сказать «тебя отправляют, потому что ты плохо учишься» — да, унизительно. Если «там делают классные штуки, ты хочешь попробовать?» — совсем другая история. Оценки в лагере не спрашивают, никто не знает, кто у кого по математике. Здесь все начинают с нуля."
  },
  {
    question: "Сколько времени нужно, чтобы увидеть результат?",
    answer: "Результат в лагере виден сразу — ребёнок делает что-то конкретное за 10–14 дней. Изменения в отношении к учёбе, если они будут, заметны через несколько недель после возвращения. Мы видели ребят, которые после лагеря сами начинали учить Python дома. Но мы видели и тех, кто вернулся и продолжил как прежде — это тоже честный результат."
  },
];
---

<Base
  title="Лагерь для двоечника — поможет ли IT? | АйДаКемп"
  description="Ребёнок плохо учится — поможет ли IT-лагерь? Разбираемся честно: кому действительно поможет, кому нет, и как говорить с ребёнком без давления."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Ребёнок плохо учится — поможет ли IT-лагерь? Отвечаем честно",
        "description": "Ребёнок плохо учится — поможет ли IT-лагерь? Разбираемся честно: кому действительно поможет, кому нет, и как говорить с ребёнком без давления.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/lager-dlya-dvoyechnika/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {"@type": "Answer", "text": item.answer}
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Лагерь для двоечника", "item": "https://aidacamp.ru/stati/lager-dlya-dvoyechnika/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок плохо учится — поможет ли IT-лагерь?"
    subtitle="Отвечаем честно — кому поможет, кому нет и как говорить об этом с ребёнком."
    imageBase="lager-programmirovaniya"
    imageAlt="Подросток увлечённо работает над проектом на компьютере в лагере"
    readTime="7 мин чтения"
    breadcrumbsLast="Лагерь для двоечника"
    daryaQuote="Я сама была не отличницей. И знаете что — это никак не помешало мне разобраться в том, что мне было интересно. Оценки и способности — разные вещи."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Вводный абзац -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда ребёнок приносит двойки, первая мысль — исправить. Репетиторы, дополнительные занятия, строже контролировать. Иногда в этот список попадает и лагерь — как способ «встряхнуть» или «подтянуть». Давайте разберёмся, в чём IT-лагерь реально помогает, а чего от него ждать не стоит.
        </p>
      </div>

      <!-- Секция 1: Успеваемость ≠ способности -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему оценки — не то же самое, что способности
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Школьная оценка измеряет очень конкретную вещь: насколько ребёнок выполнил задание в заданном формате в заданное время. Это полезный навык — но не единственный показатель интеллекта и способности к обучению.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ребёнок может плохо списывать с доски, но отлично разбираться в том, как устроена игра, которую он обожает</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ребёнок может путаться в формулах, но придумывать нестандартные решения, которые не предполагал учебник</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Ребёнок может не делать домашнее задание, но часами разбираться в том, что ему самому интересно</span></li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не значит, что оценки не важны. Это значит, что плохие оценки — симптом, а не диагноз. Причины могут быть разными: скука, конфликт с учителем, проблемы дома, непереработанный стресс — или просто формат школы, который не подходит конкретному ребёнку.
        </p>
      </div>

      <!-- Секция 2: Скучающий гений vs старательный троечник -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            «Скучающий гений» и «старательный троечник» — в чём разница
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Понять тип ситуации важно — потому что подходы разные.
        </p>
        <div class="space-y-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Скучающий гений</p>
            <p class="text-base leading-[1.6] text-slate-600">Не делает задания, потому что они неинтересные или слишком простые. Может пересказать сложную тему, которую «не проходили». В своём интересе копает глубоко. Оценки низкие из-за отсутствия мотивации — не из-за отсутствия способностей. Таким ребятам нужна среда, где интерес важнее послушания.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-semibold text-slate-800 mb-2">Старательный троечник</p>
            <p class="text-base leading-[1.6] text-slate-600">Старается, но не получается. Может быть нераспознанная дислексия, дисграфия, СДВГ — или просто другой темп обучения. Ему нужна другая педагогика, а не другой лагерь. Лагерь поможет найти область, где он успешен — но не заменит работу со специалистом.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В обоих случаях IT-лагерь может дать что-то важное — опыт успеха, новую среду, конкретный результат. Но делать это нужно с разными ожиданиями.
        </p>
      </div>

      <!-- Секция 3: Что даёт лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что IT-лагерь даёт ребёнку с плохими оценками
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главное отличие лагеря от школы: здесь нет оценок. Есть проект — и он либо работает, либо нет. Это принципиально другой тип обратной связи.
        </p>
        <ul class="flex flex-col gap-2 mb-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Успех через конкретный результат:</strong> сделал игру — она работает. Это видно сразу, без ожидания контрольной</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Ошибка — это шаг, а не оценка:</strong> программа не работает → ищем баг → исправляем. Ошибка не красная отметка в дневнике, а просто следующий шаг</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Никто не знает, кто «двоечник»:</strong> все начинают с нуля. Репутация из школы сюда не приезжает</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Самостоятельный выбор направления:</strong> игровой дизайн, анимация, программирование, 3D — ребёнок делает то, что выбрал сам</span></li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы видели ребят, которые приехали с историей «он ничего не делает в школе» — и за две недели сделали полноценный проект, которым гордились. Это не магия. Это просто другая среда, где их сильные стороны оказались видны.
        </p>
      </div>

      <!-- Секция 4: Кому поможет, кому нет -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кому лагерь поможет — а кому нет. Честно
          </h2>
        </div>
        <div class="space-y-3 mb-4">
          <div class="border border-emerald-200 rounded-xl p-4 bg-emerald-50">
            <p class="text-base font-semibold text-emerald-800 mb-2">Скорее поможет</p>
            <ul class="flex flex-col gap-1">
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span><span class="text-base text-emerald-900">Ребёнок скучает в школе, но дома занят своими делами с интересом</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span><span class="text-base text-emerald-900">Ребёнок хочет попробовать, но стесняется / нет среды</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span><span class="text-base text-emerald-900">Ребёнок любит игры, технологии, конструктор, «как это устроено»</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span><span class="text-base text-emerald-900">У ребёнка низкая самооценка из-за сравнения с успешными одноклассниками</span></li>
            </ul>
          </div>
          <div class="border border-red-200 rounded-xl p-4 bg-red-50">
            <p class="text-base font-semibold text-red-800 mb-2">Скорее не поможет</p>
            <ul class="flex flex-col gap-1">
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-base text-red-900">Ребёнок едет против воли — «мама отправила»</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-base text-red-900">Причина плохих оценок — нераспознанные трудности обучения, которые требуют специалиста</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-base text-red-900">Ребёнок в состоянии острого стресса или конфликта дома — сначала нужна стабилизация</span></li>
              <li class="flex items-start gap-2"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span><span class="text-base text-red-900">Родитель ждёт «волшебного исправления» за две недели</span></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Секция 5: Как говорить с ребёнком -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как говорить с ребёнком — без «надо» и давления
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это, пожалуй, важнее всего остального. Если ребёнок едет с ощущением наказания — не поможет ни один лагерь.
        </p>
        <div class="space-y-4 mb-5">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">1</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Не упоминайте оценки в разговоре о лагере</p>
              <p class="text-base leading-[1.6] text-slate-600">«Едешь, потому что плохо учишься» — плохой старт. Лучше: «там делают классные вещи, мне кажется, тебе может понравиться». Лагерь — не наказание и не лечение. Это место, где интересно.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">2</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Спросите, что ему интересно прямо сейчас</p>
              <p class="text-base leading-[1.6] text-slate-600">Может оказаться, что ребёнок мечтает понять, как создаются игры — и тогда лагерь попадает прямо в точку. А может выяснится, что его тянет к музыке или спорту — и стоит искать что-то другое.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">3</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Не ставьте условий вроде «если исправишься — поедешь»</p>
              <p class="text-base leading-[1.6] text-slate-600">Это превращает лагерь в награду за учёбу — и создаёт ненужное давление. Лагерь работает лучше, когда воспринимается как нейтральное новое место, а не как «заслуженное».</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-base font-bold shrink-0 mt-0.5">4</div>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Будьте готовы к «мне не понравилось»</p>
              <p class="text-base leading-[1.6] text-slate-600">Это тоже честный результат. Спросите: что именно не понравилось? Иногда за «скучно» скрывается «было сложно и стыдно не понять» — и это уже разговор о чём-то важном.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA block -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
