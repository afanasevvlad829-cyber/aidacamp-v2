---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Документы и лицензия лагеря", url: "/stati/dokumenty-licenziya-strahovka", icon: "patch-check-fill", description: "Что проверить до оплаты" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Справки для лагеря", url: "/stati/spravki-dlya-lagera", icon: "check-lg", description: "Какие документы нужны ребёнку" },
  { title: "О лагере АйДаКемп", url: "/o-lagere", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Как убедиться, что в лагере есть медицинский работник?",
    answer: "Спросите напрямую: есть ли медработник с медицинским образованием, живущий на территории 24/7, или он приезжает по вызову. Второй вариант — не медицинское обеспечение, а его имитация. В АйДаКемп медработник живёт в отдельном домике на территории и дежурит круглосуточно с первого до последнего дня смены."
  },
  {
    question: "Как проверить лицензию детского лагеря?",
    answer: "Лицензию на образовательную деятельность можно проверить в официальном реестре Рособрнадзора. Вы можете скачать лицензию в формате PDF на нашей странице о документах. Лицензию на оздоровительный лагерь (РТО) проверяют через реестр туроператоров на tourism.gov.ru."
  },
  {
    question: "Страховка в лагере — что она покрывает?",
    answer: "Базовая страховка покрывает травмы и несчастные случаи на территории лагеря. Важно уточнить: включена ли страховка в стоимость путёвки или нужно оформлять отдельно, есть ли страховка от клещевого энцефалита (актуально для летних лесных лагерей), какой лимит выплат. В АйДаКемп страховка включена в путёвку, лимит — 500 000 ₽ на ребёнка."
  },
  {
    question: "Что делать, если ребёнок заболел в лагере?",
    answer: "Медработник осматривает ребёнка, ставит диагноз и при необходимости вызывает скорую или организует госпитализацию. Родители получают звонок в течение 30 минут. В лагере должны быть: изолятор для карантина, список аллергий и хронических заболеваний каждого ребёнка, аптечка с базовыми препаратами. При поступлении в АйДаКемп родители заполняют медкарту — информируют обо всех особенностях."
  }
];
---

<Base
  title="Безопасность ребёнка в лагере — что проверить до отъезда"
  description="Медработник 24/7, охрана и КПП, страховка, лицензия Роспотребнадзора, связь с родителями. Чек-лист для проверки любого детского лагеря перед бронированием."
  ogImage="/images/hero/lager-v-podmoskove.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/bezopasnost-v-detskom-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Безопасность в детском лагере: чек-лист для родителей | АйДаКемп",
        "description": "Как проверить безопасность детского лагеря до оплаты: медработник, охрана, страховка, лицензия, связь. Чек-лист от мамы-основателя АйДаКемп.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/bezopasnost-v-detskom-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>

  <Header />

  <ArticleHero
    title="Безопасность в детском лагере: чек-лист для родителей"
    subtitle="Что на самом деле обеспечивает безопасность ребёнка — и как это проверить до бронирования."
    imageBase="lager-v-podmoskove"
    imageAlt="Территория детского лагеря с охраняемым КПП"
    imagePosition="center"
    readTime="9 мин чтения"
    breadcrumbsLast="Безопасность в детском лагере"
    daryaQuote="Я сама мама, и первый вопрос который задала себе при открытии лагеря — как я объясню другим родителям что здесь безопасно? С тех пор всё, что делаем — делаем так, чтобы не пришлось оправдываться."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «А там безопасно?» — первый вопрос, который задаёт каждая мама при выборе лагеря. Правильный вопрос. Разбираем по пунктам: что реально влияет на безопасность ребёнка и как это проверить, не заходя на территорию.
        </p>
      </div>

      <!-- Раздел 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Медицинское обеспечение: медработник 24/7
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Медработник — это не «есть контакт с ближайшей поликлиникой». Это живой человек с медицинским образованием, который живёт и дежурит на территории лагеря круглосуточно. Без этого — всё остальное не имеет значения.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп медработник живёт на территории с первого до последнего дня каждой смены. При заселении каждый ребёнок проходит первичный осмотр. Родители заполняют медкарту: аллергии, хронические заболевания, список лекарств. Все препараты хранятся у медработника и выдаются по расписанию.
        </p>
        <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 md:p-5 max-w-[720px]">
          <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-slate-500 mb-2">Что спросить организаторов</p>
          <ul class="space-y-1">
            <li class="flex items-start gap-2 text-[14px] text-slate-700">
              <i class="bi bi-check-lg text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
              Медработник живёт на территории или приезжает по вызову?
            </li>
            <li class="flex items-start gap-2 text-[14px] text-slate-700">
              <i class="bi bi-check-lg text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
              Какое у него образование — фельдшер, медсестра, врач?
            </li>
            <li class="flex items-start gap-2 text-[14px] text-slate-700">
              <i class="bi bi-check-lg text-orange-500 mt-0.5 shrink-0" aria-hidden="true"></i>
              Как хранятся и выдаются лекарства ребёнка?
            </li>
          </ul>
        </div>
      </div>

      <!-- Раздел 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Охрана и закрытая территория
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Безопасная территория — это не «забор из сетки». Это КПП с контролем входа-выхода, видеонаблюдение на ключевых точках, охрана которая знает каждого ребёнка по имени. Ребёнок не может уйти с территории самостоятельно без ведома вожатых.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп территория полностью огорожена, въезд через КПП. Посторонних нет. Вожатые знают, где находится каждый ребёнок — пересчёт проводится несколько раз в день: после завтрака, перед занятиями, перед отбоем. При любом несовпадении — сразу поднимаем группу.
        </p>
      </div>

      <!-- Раздел 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страховка и лицензия: как проверить документы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Два обязательных документа для любого официального лагеря:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 max-w-[720px]">
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-patch-check-fill text-orange-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[14px] font-bold text-slate-900">Лицензия Минобрнауки</p>
            </div>
            <p class="text-[13px] leading-[1.6] text-slate-600">Подтверждает, что программа официально одобрена. Проверяется в реестре Рособрнадзора по ИНН или названию организации.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-shield-check text-orange-500 text-[18px]" aria-hidden="true"></i>
              <p class="text-[14px] font-bold text-slate-900">Страховка ребёнка</p>
            </div>
            <p class="text-[13px] leading-[1.6] text-slate-600">Должна быть включена в стоимость или оформляться отдельно до заезда. Покрывает травмы и несчастные случаи на территории.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В АйДаКемп страховка на 500 000 ₽ включена в стоимость путёвки. Лицензия Минобрнауки — в открытом реестре, номер указан на сайте. Документы на налоговый вычет выдаём при выезде автоматически.
        </p>
      </div>

      <!-- Раздел 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Связь с родителями: как это устроено
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Смартфоны в АйДаКемп сдают при заезде — это сознательное решение, и вот почему: ребёнок, который может позвонить домой в любой момент, не адаптируется к лагерю. Первые 2–3 дня самые трудные — именно тогда хочется домой. Если в этот момент мама на связи — адаптация затягивается до конца смены.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Родители получают информацию через лагерный Telegram-канал: фотографии каждый день, общие новости смены, важные объявления. При любой нестандартной ситуации — звонок от вожатого или администратора лично. Для экстренной связи с ребёнком — звонок через администратора.
        </p>
        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px]">
          <p class="text-[14px] font-semibold text-orange-700 mb-1">Из практики</p>
          <p class="text-[14px] leading-[1.6] text-slate-700">
            90% мам, которые переживали за связь, признаются через неделю: «Фотографий в канале хватало с лихвой. Я видела его счастливым — и успокоилась». Дети возвращаются с телефоном при выезде. Никто ни разу не попросил его раньше.
          </p>
        </div>
      </div>

      <!-- Чек-лист -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чек-лист: что проверить до бронирования любого лагеря
          </h2>
        </div>
        <div class="space-y-2 max-w-[720px]">
          {[
            "Медработник живёт на территории — не приезжает, а живёт",
            "Территория закрыта и охраняется — есть КПП",
            "Лицензия Минобрнауки — проверить в реестре Рособрнадзора",
            "Страховка на каждого ребёнка включена в путёвку или оформляется отдельно",
            "Есть лагерный чат для родителей с фотографиями",
            "Соотношение вожатых и детей — не хуже 1:8",
            "Документы для налогового вычета выдаются по запросу",
            "Еда приготовлена на месте, не привозная"
          ].map((item) => (
            <div class="flex items-start gap-3 py-2 border-b border-slate-100 last:border-0">
              <i class="bi bi-check-circle-fill text-orange-500 text-[16px] mt-0.5 shrink-0" aria-hidden="true"></i>
              <p class="text-[15px] text-slate-700 leading-[1.5]">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-[14px] leading-[1.7] text-slate-600">{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.add('hidden');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
