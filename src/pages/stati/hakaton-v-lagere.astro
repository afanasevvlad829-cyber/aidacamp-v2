---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Программирование, проекты, команда" },
  { title: "Что такое IT-лагерь?", url: "/blog/it-lager-dlya-shkolnikov", icon: "laptop", description: "Чем занимаются ребята на сменах" },
  { title: "AI и экономика", url: "/blog/ai-economy", icon: "cpu", description: "Почему важно понимать AI раньше всех" },
];
---

<Base
  title="Хакатон в лагере: монеты, призы и командная битва идей | АйДаКемп"
  description="Как устроен хакатон в IT-лагере АйДаКемп: внутренняя валюта, настоящие призы, коллективные активности и две истории — предприниматель и накопитель."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/hakaton-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Хакатон в лагере: монеты, призы и командная битва идей",
      "description": "Как устроен хакатон в IT-лагере АйДаКемп: внутренняя валюта, настоящие призы, коллективные активности и две истории — предприниматель и накопитель.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-12",
      "dateModified": "2026-06-12",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/hakaton-v-lagere"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Хакатон в лагере: монеты, призы и командная битва идей"
    subtitle="Внутри каждой смены живёт маленькая экономика. Рассказываю, как работает хакатон, на что тратят монеты и чем заканчиваются две очень разные стратегии."
    imageBase="lager-programmirovaniya"
    imageAlt="Хакатон в IT-лагере АйДаКемп — команды работают над проектами"
    breadcrumbsLast="Хакатон в лагере"
    readTime="6 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Меня часто спрашивают: «А что такое хакатон в детском лагере?» Отвечаю честно: это не скучный конкурс с грамотами. Это финальная битва смены, где команды показывают то, что успели создать — приложение, сайт, игру, бота. А победители получают монеты. Настоящие. Те самые, на которые в лагере работает вся внутренняя экономика.
        </p>
      </div>

      <!-- Фотогалерея хакатона 2026 -->
      <div class="mb-10">
        <!-- Строка 1: паспорта игр + рекламный щит -->
        <div class="grid grid-cols-2 gap-3 mb-3">
          <figure class="rounded-[12px] overflow-hidden bg-slate-100">
            <img
              src="/images/articles/hakaton-pasporta-igr.jpg"
              alt="Команды представляют паспорта своих будущих игр на хакатоне АйДаКемп 2026"
              width="800" height="600"
              loading="lazy"
              class="w-full h-auto block"
            />
            <figcaption class="px-3 py-2 text-[12px] text-slate-500 bg-white">Первый этап: паспорта будущих игр</figcaption>
          </figure>
          <figure class="rounded-[12px] overflow-hidden bg-slate-100">
            <img
              src="/images/articles/hakaton-reklamny-shit.jpg"
              alt="Команды делают рекламный щит для своей игры — этап хакатона АйДаКемп"
              width="800" height="600"
              loading="lazy"
              class="w-full h-auto block"
            />
            <figcaption class="px-3 py-2 text-[12px] text-slate-500 bg-white">Один из этапов — рекламный щит</figcaption>
          </figure>
        </div>
        <!-- Строка 2: кодинг + победитель -->
        <div class="grid grid-cols-2 gap-3">
          <figure class="rounded-[12px] overflow-hidden bg-slate-100">
            <img
              src="/images/articles/hakaton-koding.jpg"
              alt="Напряжённый кодинг на хакатоне — участники пишут код для своей игры"
              width="800" height="600"
              loading="lazy"
              class="w-full h-auto block"
            />
            <figcaption class="px-3 py-2 text-[12px] text-slate-500 bg-white">Очень напряжённый кодинг</figcaption>
          </figure>
          <figure class="rounded-[12px] overflow-hidden bg-slate-100">
            <img
              src="/images/articles/hakaton-pobeditel.jpg"
              alt="Победитель хакатона АйДаКемп 2026 — игра-стратегия"
              width="800" height="600"
              loading="lazy"
              class="w-full h-auto block"
            />
            <figcaption class="px-3 py-2 text-[12px] text-slate-500 bg-white">Победители — игра-стратегия</figcaption>
          </figure>
        </div>
        <p class="text-[12px] text-slate-400 mt-2">Хакатон АйДаКемп 2026 — 5 команд, задание: создать свою игру</p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое хакатон в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Хакатон — это командный марафон, где за ограниченное время нужно придумать и создать работающий продукт. У нас он проходит в последние дни смены: отряды делятся на команды, получают тему и — вперёд. Никаких домашних заготовок, только то, чему научились за смену.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Результаты презентуют перед всем лагерем. Жюри — вожатые, преподаватели, иногда приглашённые специалисты — оценивают идею, реализацию и то, как команда умеет её защищать. Победители получают монеты — и это уже не просто символ: монеты в лагере работают.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Монеты — внутренняя валюта лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          С первого дня у каждого подростка появляется счёт. Каждое утро — <strong>600 монет</strong>: базовый ежедневный доход. Плюс поощрения за успехи на занятиях, победы в конкурсах, хакатон, инициативу. Минус штрафы за беспорядок или нарушение правил.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Аналогия, которую я люблю давать родителям: помните «Монополию»? Там каждый круг — 200 ₽. У нас примерно так же, только играть интереснее — потому что монеты тратятся на реальные вещи внутри лагеря.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">КАК РАБОТАЕТ ЭКОНОМИКА</p>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="rounded-[12px] bg-[#FFF3EC] p-4">
              <div class="text-[24px] font-bold text-orange-500">600</div>
              <div class="text-[13px] text-slate-500 mt-1">монет в день базово</div>
            </div>
            <div class="rounded-[12px] bg-[#FFF3EC] p-4">
              <div class="text-[24px] font-bold text-orange-500">+200</div>
              <div class="text-[13px] text-slate-500 mt-1">максимальный бонус</div>
            </div>
            <div class="rounded-[12px] bg-[#EDFAF4] p-4">
              <div class="text-[24px] font-bold text-emerald-600">10</div>
              <div class="text-[13px] text-slate-500 mt-1">монет = 1 мин телефона</div>
            </div>
          </div>
          <p class="text-[12px] text-slate-400 mt-4">Все расходы включены в стоимость путёвки — доплат от родителей нет</p>
        </div>
      </div>

      <!-- Section 3 — Activities -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            На что тратят монеты: активности
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Телефоны при заезде сдаются вожатому — и это, пожалуй, главный стимул копить. Но телефонное время — далеко не единственное, что можно купить. Ребята скидываются на коллективные события всем отрядом.
        </p>

        <div class="my-6 overflow-x-auto">
          <table class="w-full text-[14px] text-slate-700 border-collapse">
            <thead>
              <tr class="bg-slate-50 text-slate-500 text-[12px] uppercase tracking-[0.05em]">
                <th class="text-left px-4 py-3 border-b border-slate-100 rounded-tl-[8px]">Активность</th>
                <th class="text-left px-4 py-3 border-b border-slate-100">Что это</th>
                <th class="text-right px-4 py-3 border-b border-slate-100 rounded-tr-[8px]">Стоимость</th>
              </tr>
            </thead>
            <tbody>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">📱 Минута телефона</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Базовая ценность — минимум 5 минут за раз</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">10 монет/мин</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">🧹 Уборка от вожатого</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Вожатый убирает комнату вместо отряда</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">~300 монет/чел</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">🎬 Кино на вечер</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Команда выбирает фильм — все голосуют и скидываются</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">~360 монет/чел</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">👩‍🏫 Стать вожатым на день</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Преподаватель работает вожатым на полдня</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">~480 монет/чел</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">🔥 Прощальный костёр с зефирками</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Финал смены — не идёт по умолчанию</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">~900 монет/чел</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 font-medium">📵 Телефоны на всю ночь</td>
                <td class="px-4 py-3 text-slate-500">Самый дорогой лот — редкое событие</td>
                <td class="px-4 py-3 text-right font-medium text-orange-600">~960 монет/чел</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-[13px] text-slate-400">* Вклад одного участника при полном отряде ~25 человек. Точные суммы зависят от смены и рассчитываются вожатыми индивидуально.</p>
      </div>

      <!-- Section 4 — Prizes -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            На что тратят монеты: призы и сувениры
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Отдельная радость — магазин призов. Там не игрушки из аркадного автомата, а нормальные вещи: наборы для опытов, мерч лагеря, декор. Всё заранее в каталоге с ценами — ребята могут планировать, на что копят.
        </p>

        <div class="my-6 overflow-x-auto">
          <table class="w-full text-[14px] text-slate-700 border-collapse">
            <thead>
              <tr class="bg-slate-50 text-slate-500 text-[12px] uppercase tracking-[0.05em]">
                <th class="text-left px-4 py-3 border-b border-slate-100 rounded-tl-[8px]">Приз</th>
                <th class="text-left px-4 py-3 border-b border-slate-100">Категория</th>
                <th class="text-right px-4 py-3 border-b border-slate-100 rounded-tr-[8px]">Цена</th>
              </tr>
            </thead>
            <tbody>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">Опыты «Дыхание дракона»</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Опыты</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">650 монет</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">Брелки Minecraft</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Сувенир</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">750 монет</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">Опыты «Фараонова змея»</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Опыты</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">900 монет</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">Ночник Minecraft — Факел</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Декор</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">2 000 монет</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 border-b border-slate-100 font-medium">Набор опытов «10 в 1»</td>
                <td class="px-4 py-3 border-b border-slate-100 text-slate-500">Опыты</td>
                <td class="px-4 py-3 border-b border-slate-100 text-right font-medium text-orange-600">3 400 монет</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 font-medium">Мерч АйДаКемп (футболка / худи)</td>
                <td class="px-4 py-3 text-slate-500">Мерч</td>
                <td class="px-4 py-3 text-right font-medium text-orange-600">3 600 монет</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-[13px] text-slate-400">* Полный каталог с актуальными ценами — на портале лагеря. Всё включено в путёвку, доплат нет.</p>
      </div>

      <!-- Section 5 — Hackathon mechanics -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как работает хакатон
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          За несколько дней до конца смены ребятам объявляют тему. Команды 3–5 человек — часто из разных направлений: один программирует, другой рисует интерфейс, третий придумывает идею. Это намеренно: в реальной разработке так и работают.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          В день защиты каждая команда выходит перед всем лагерем: показывает продукт, объясняет решение, отвечает на вопросы жюри. Оценивается не только код — важно, как команда умеет рассказать о своей работе. Победители получают дополнительные монеты и — что важнее — ощущение, что сделали что-то настоящее.
        </p>

        <div class="my-6 rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <p class="text-[16px] leading-[1.6] text-slate-700 italic">
            «На защите прошлой смены одна команда сделала бота, который помогает планировать режим дня. Когда они вышли защищаться — их аплодировали стоя. Я сама чуть не заплакала.»
          </p>
          <p class="text-[13px] text-slate-500 mt-2">— Дарья Афанасьева, руководитель АйДаКемп</p>
        </div>
      </div>

      <!-- Section 6 — Two stories -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Две истории из реальных смен
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          Экономика всегда выявляет характер. За несколько смен у нас накопились два полярных кейса — и оба учат чему-то важному.
        </p>

        <div class="my-6 grid md:grid-cols-2 gap-4">
          <div class="rounded-[16px] border border-orange-100 bg-orange-50 px-5 py-5">
            <div class="text-[13px] font-semibold uppercase tracking-[0.06em] text-orange-500 mb-3">Предприниматель</div>
            <p class="text-[15px] leading-[1.65] text-slate-700">
              На второй день смены подошёл к вожатому и сказал: «Хочу самый дорогой приз». Монет у него не было — только стартовые 600. Тогда он пошёл по всему отряду и занял у всех, у кого мог. Набрал нужную сумму, купил приз — и весь остаток смены отдавал долги, зарабатывал, расплачивался.
            </p>
            <p class="text-[14px] text-slate-500 mt-3 italic">Вышел в ноль. Зато с призом и опытом управления долгом.</p>
          </div>
          <div class="rounded-[16px] border border-slate-200 bg-slate-50 px-5 py-5">
            <div class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-3">Накопитель</div>
            <p class="text-[15px] leading-[1.65] text-slate-700">
