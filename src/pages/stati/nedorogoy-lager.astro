---
import '../../styles/global.css';
import { SEASON_YEAR, PRICE_MIN, PRICE_MAX } from '../../data/shifts';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Как выбрать летний лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев без воды" },
  { title: "Документы и лицензия", url: "/stati/dokumenty-licenziya-strahovka/", icon: "patch-check-fill", description: "Что проверить до оплаты" },
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-stack", description: "Как вернуть часть стоимости" },
  { title: "О лагере АйДаКемп", url: "/o-lagere/", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Бывают ли хорошие недорогие лагеря?",
    answer: "Да, если разницу доплачивает кто-то третий: профсоюз, работодатель, региональная программа субсидирования. Тогда вы платите 15 000–20 000 ₽, а реальная стоимость — 45 000–55 000 ₽. Это честная схема. Проблема начинается, когда лагерь за 20 000 ₽ обещает бассейн, педагогов и «развивающую программу» — тут математика не сходится."
  },
  {
    question: "Можно ли сэкономить на хорошем лагере?",
    answer: "Три реальных способа: (1) бронировать заранее — большинство лагерей держат цену до определённой даты, потом она растёт каждый день; (2) оформить налоговый вычет — если лагерь лицензирован как образовательный, можно вернуть 13% от суммы; (3) уточнить рассрочку — многие оформляют её без переплаты."
  },
  {
    question: "Сколько минимально стоит нормальный лагерь в Подмосковье?",
    answer: "По рыночным данным 2025 года, честный минимум без образовательной программы — 35 000–40 000 ₽ за две недели. Это покрывает питание по нормам СанПиН, проживание, базовый персонал и обязательные санитарные мероприятия. Всё, что ниже, — либо субсидировано, либо где-то сэкономлено на скрытых статьях."
  },
  {
    question: "Чем отличается «смена обстановки» от образовательного лагеря?",
    answer: "Целью. Если задача — чтобы было безопасно, накормлено и не скучно — подойдёт любой нормальный лагерь по вашим возможностям. Если задача — чтобы школьник что-то реально освоил, — важны педагоги с практическим опытом, маленькие группы и предметное оборудование. Это другой продукт с другой ценой."
  },
];
---

<Base
  title={`Лагерь недорого в Подмосковье: честная математика цены путёвки ${SEASON_YEAR}`}
  description="Почему недорогой детский лагерь стоит столько, сколько стоит, что срезают в бюджетных вариантах и когда лагерь в Подмосковье недорого — это нормально. Цифры без рекламы."
  canonical="https://aidacamp.ru/stati/nedorogoy-lager"
>
  <Header />

  <ArticleHero
    title="Недорогой лагерь: из чего складывается цена и что за ней стоит"
    subtitle="Честная математика без рекламы и морали"
    readTime="8 минут"
    category="Как выбрать лагерь"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] md:text-[17px] leading-[1.7] text-slate-600 max-w-[720px]">
          Скажем сразу: мы делаем лагерь, и он не дешёвый. Конфликт интересов есть, не скроем.
          Поэтому ниже — только цифры и факты. Что реально входит в стоимость путёвки
          детского лагеря в Подмосковье, почему одни стоят 30 000 ₽, а другие 90 000 ₽,
          и когда недорогой лагерь — это именно то, что нужно.
        </p>
      </div>

      <!-- Раздел 1: Питание -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Питание: от нормы до «вкусно»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Четыре приёма пищи в день — завтрак, обед, полдник, ужин. По нормам СанПиН 2.3/2.4.3590-20
          минимальная суточная стоимость питания на школьника — <strong>около 600 ₽ в день</strong> (нормы
          индексируются ежегодно). Это «соответствует требованиям», но не значит «вкусно».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нормальная еда, которую ребёнок не будет вспоминать с содроганием, начинается
          от 900–1 000 ₽ в день. Хорошая, с выбором блюд и живыми фруктами на каждый перекус, —
          от 1 200–1 400 ₽. <strong>За 14 дней: 8 400–19 600 ₽.</strong>
        </p>

        <StatCallout
          value="600+ ₽/день"
          label="— минимальная стоимость питания по нормам СанПиН 2.3/2.4.3590-20. Хорошее питание в загородном лагере стоит вдвое больше."
          source="СанПиН 2.3/2.4.3590-20, рыночные данные 2024–2025"
          icon="basket2"
          tone="info"
        />
      </div>

      <!-- Раздел 2: Проживание -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Проживание и коммунальные расходы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Корпус, электричество, вода, отопление, вывоз мусора. Старый советский корпус
          с деревянными окнами — от 350–500 ₽ в день на человека. Современный корпус
          с нормальными кроватями и розетками — от 800–1 200 ₽.
          <strong>За 14 дней: 5 000–17 000 ₽.</strong>
        </p>
      </div>

      <!-- Раздел 3: Персонал -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Персонал: это самая большая строка
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вожатый с зарплатой 70 000–90 000 ₽ в месяц на отряд из 20 человек —
          это 3 500–4 500 ₽ с человека за смену только на одного вожатого.
          Но вожатый — далеко не единственный сотрудник.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Медработник</strong> (обязателен по закону) — 80 000–100 000 ₽ в месяц,
          работает круглосуточно. <strong>Повар</strong> — 65 000–80 000 ₽.
          <strong>Охранники</strong> — минимум двое в смену, по 50 000–65 000 ₽ каждый.
          <strong>Завхоз, уборщики, администратор, бухгалтер, директор</strong> — тоже зарплата.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В пересчёте на одного участника — весь персонал (без педагогов) обходится
          в <strong>15 000–25 000 ₽ за смену.</strong>
        </p>

        <StatCallout
          value="1 : 8"
          label="— норма соотношения вожатых и детей в отряде по СанПиН. В экономных лагерях один вожатый на 20–25 человек: в два-три раза меньше внимания к каждому."
          source="СанПиН 2.4.4.3048-13, раздел об организации работы вожатых"
          icon="people"
          tone="warn"
        />
      </div>

      <!-- Раздел 4: Охрана и видеонаблюдение -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Охрана, видеонаблюдение, уборка территории
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это отдельная статья, о которой на сайтах лагерей почти не пишут, но в смете
          она всегда есть.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Охрана</strong> — это не «мужчина у шлагбаума». Это контроль въезда и выезда, сопровождение
          при выходах, ночное дежурство. Нормальная охрана на объект с детьми — частное охранное
          предприятие с лицензией, 2–3 поста. Стоимость: от 150 000 ₽ за сезон и выше.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Видеонаблюдение</strong> — периметр, корпуса, столовая, спортплощадка. Монтаж
          системы стоит от 300 000–500 000 ₽ (разовая инвестиция), плюс обслуживание и хранение
          записей — еще несколько тысяч в месяц.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Уборка и содержание территории</strong> — покос травы (по нормам обязателен,
          не реже 2–3 раз за сезон), вывоз мусора, уборка помещений ежедневно.
          В пересчёте на одного участника: <strong>1 500–3 500 ₽ за смену.</strong>
        </p>
      </div>

      <!-- Раздел 5: Санобработки -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Противоклещевые обработки и дезинсекция
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не опция и не паранойя — это обязательное требование СанПиН 3.5.3.3223-14
          и условие работы загородного детского лагеря.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Противоклещевая обработка территории</strong> проводится минимум дважды за сезон.
          Стоимость на типовую территорию лагеря (2–5 гектаров) — 20 000–60 000 ₽ за обработку,
          итого 40 000–120 000 ₽ за лето. Не потому что кто-то что-то привозит из города — просто мы
          на природе, и клещи здесь живут вне зависимости от желания организаторов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          <strong>Дезинсекция помещений</strong> — обработка всех комнат, столовой, санузлов
          после каждой смены. Это про бытовых насекомых: мы на природе, лето, окна открыты.
          Стоимость: 800–1 500 ₽ за помещение, в лагере на 100 мест — от 20 000–40 000 ₽
          за обработку. В пересчёте на одного участника: <strong>ещё 1 500–3 000 ₽ за смену.</strong>
        </p>

        <StatCallout
          value="2×/сезон"
          label="— минимальная частота противоклещевой обработки территории детского лагеря по СанПиН 3.5.3.3223-14. Плюс дезинсекция помещений после каждой смены."
          source="СанПиН 3.5.3.3223-14, требования к санитарной обработке"
          icon="bug"
          tone="warn"
        />
      </div>

      <!-- Раздел 6: Ремонт -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Ремонт и амортизация
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          После каждой смены что-то нужно ремонтировать. Не капитально, не тотально — но всегда.
          Кровать, дверная ручка, облупившаяся краска, сломанный шкаф.
          Дети проверяют мебель на прочность в режиме 24/7 без выходных.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хороший лагерь закладывает это в смету заранее и не удивляется. Бюджет
          на межсезонный ремонт в нормальном лагере на 100 мест — от 500 000 ₽ в год.
          В пересчёте на путёвку: <strong>3 000–8 000 ₽ за смену.</strong>
        </p>
      </div>

      <!-- Итоговая таблица -->
      <div class="mb-10 pt-2">
        <div class="flex items-center gap-2 mb-5">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Итого: честный минимум за 14 дней
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Это стоимость без всякой программы. Просто крыша, еда, вожатый смотрит
          чтобы всё было в порядке — и всё то невидимое, что обязано быть по закону.
        </p>

        <div class="overflow-x-auto rounded-[14px] border border-slate-200 mb-5">
          <table class="w-full text-base">
            <thead>
              <tr class="bg-slate-100 border-b border-slate-200">
                <th class="text-left px-4 py-3 font-semibold text-slate-700">Статья расходов</th>
                <th class="text-right px-4 py-3 font-semibold text-slate-700">Минимум</th>
                <th class="text-right px-4 py-3 font-semibold text-slate-700">Нормально</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-700">Питание (14 дней, 4 раза/день)</td>
                <td class="px-4 py-3 text-right text-slate-600">8 400 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">14 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="px-4 py-3 text-slate-700">Проживание + коммунальные</td>
                <td class="px-4 py-3 text-right text-slate-600">5 000 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">12 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-700">Персонал (вожатые, медик, повар, завхоз)</td>
                <td class="px-4 py-3 text-right text-slate-600">12 000 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">20 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="px-4 py-3 text-slate-700">Охрана, видеонаблюдение</td>
                <td class="px-4 py-3 text-right text-slate-600">1 500 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">3 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-700">Санобработки, покос травы, уборка</td>
                <td class="px-4 py-3 text-right text-slate-600">1 500 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">3 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="px-4 py-3 text-slate-700">Страховка, медикаменты, лицензии</td>
                <td class="px-4 py-3 text-right text-slate-600">1 500 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">3 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 text-slate-700">Ремонт и амортизация корпусов</td>
                <td class="px-4 py-3 text-right text-slate-600">2 000 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">6 000 ₽</td>
              </tr>
              <tr class="border-b border-slate-100 bg-slate-50">
                <td class="px-4 py-3 text-slate-700">Маркетинг, администрация, резерв</td>
                <td class="px-4 py-3 text-right text-slate-600">2 000 ₽</td>
                <td class="px-4 py-3 text-right text-slate-600">5 000 ₽</td>
              </tr>
              <tr class="bg-orange-50 border-t-2 border-orange-200">
                <td class="px-4 py-3 font-bold text-slate-900">Итого без программы</td>
                <td class="px-4 py-3 text-right font-bold text-primary">~34 000 ₽</td>
                <td class="px-4 py-3 text-right font-bold text-primary">~66 000 ₽</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-base leading-[1.6] text-slate-500 max-w-[720px]">
          <i class="bi bi-info-circle text-slate-400 mr-1" aria-hidden="true"></i>
          Данные основаны на рыночных ценах Подмосковья 2024–2025: продовольственные нормы СанПиН,
          данные по зарплатам hh.ru, прайсы компаний по дезинсекции и охранных предприятий.
        </p>
      </div>

      <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
        Если детский лагерь в Подмосковье стоит меньше 35 000–40 000 ₽ за две недели —
        кто-то доплачивает разницу: профсоюз, работодатель или государство. Либо что-то
        срезано внутри. Математика не врёт.
      </p>

      <!-- Что отрезают в первую очередь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что отрезают в первую очередь в дешёвых лагерях
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Обычно экономят не на одной большой статье — режут понемногу везде, и это незаметно до приезда.
        </p>

        <div class="space-y-4 max-w-[720px]">
          <div class="flex gap-3 p-4 rounded-[12px] bg-slate-50 border border-slate-100">
            <i class="bi bi-x-circle text-red-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800 mb-1">Бассейн</p>
              <p class="text-base leading-[1.6] text-slate-600">
                Обслуживание бассейна — 400 000–700 000 ₽ за сезон: химия, фильтрация, штатный спасатель,
                требования Роспотребнадзора. В пересчёте на 100 участников — плюс 4 000–7 000 ₽
                к каждой путёвке. В недорогих лагерях бассейна не бывает не потому что плохие,
                а потому что математика.
              </p>
            </div>
          </div>
          <div class="flex gap-3 p-4 rounded-[12px] bg-slate-50 border border-slate-100">
