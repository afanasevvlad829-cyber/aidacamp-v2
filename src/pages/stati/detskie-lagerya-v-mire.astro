---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';

const relatedPages = [
  { title: "Самостоятельность: что делают в других странах", url: "/stati/kak-mir-vospityvaet-samostoyatelnost/", icon: "globe", description: "Финляндия, США, Китай — три разных ответа" },
  { title: "Сколько стоит лагерь?", url: "/skolko-stoit-lager-dlya-rebenka/", icon: "cash-coin", description: "Разбор всех статей расходов" },
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "receipt", description: "Как вернуть до 6 200 ₽" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Программирование + командная работа" },
];
---

<Base
  title="Детские лагеря в мире: сколько стоит и чему учат | АйДаКемп"
  description="США — $179 в день, Швейцария — 23 000 ₽ в день, Калифорния — $325. Сравниваем стоимость детских лагерей по всему миру в рублях и долларах. И смотрим, что за эти деньги воспитывают."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Детские лагеря в мире: сколько стоит и чему учат",
      "description": "Сравниваем стоимость детских лагерей в США, Европе, Азии и России — в рублях и долларах. Таблица, барчарт и неудобные вопросы про «дорого».",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-28",
      "dateModified": "2026-06-28",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/detskie-lagerya-v-mire"}
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Детские лагеря в мире: цены", "item": "https://aidacamp.ru/stati/detskie-lagerya-v-mire/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Детские лагеря в мире: цены и самый дорогой лагерь"
    subtitle="США — $179 в день. Швейцария — 23 000 ₽ в день. Калифорния — вообще отдельная история. А вы говорите, что наш лагерь дорогой."
    imageBase="lager-programmirovaniya"
    imageAlt="Сколько стоят детские лагеря в разных странах"
    breadcrumbsLast="Лагеря в мире: цены"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-10 pb-0">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В России каждое лето один и тот же разговор: стоит ли лагерь своих денег? Давайте посмотрим на цифры по всему миру — и переведём их в один масштаб. Сравнение получится неожиданным.
        </p>
      </div>

      <!-- ═══ США ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            🇺🇸 США: $179 в день — и это средняя цена
          </h2>
        </div>
        <figure class="mb-5 rounded-[16px] overflow-hidden">
          <img src="/images/articles/story-usa-sleepaway.jpg" alt="Дети на природе в традиционном американском лагере (иллюстрация)" width="1000" height="667" loading="lazy" class="w-full h-[200px] object-cover" />
          <figcaption class="text-[11px] text-slate-400 mt-1">Фото: ADKPhoto / Wikimedia Commons, CC0</figcaption>
        </figure>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Американский <em>sleepaway camp</em> существует с 1880-х годов и давно стал национальной традицией. Сегодня средняя стоимость недели в загородном лагере с ночёвкой — около <strong>$1 257</strong>, то есть $179 в день. Но разброс огромный: от $300 до $2 500 в неделю — в зависимости от штата и программы.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Калифорния — самый дорогой штат: $2 270 за неделю, то есть <strong>$325 в день</strong>. Северная Дакота — самый доступный: $383 в неделю. Для сравнения: российский загородный лагерь в Подмосковье — 60 000–90 000 рублей за смену в 12–14 дней, то есть примерно $75–80 в день. Уже в одной весовой категории с несетевыми лагерями Среднего Запада США.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-2">
          <AnimatedStat
            value="179"
            prefix="$"
            label="средняя стоимость одного дня в американском лагере"
            source="American Camp Association 2025"
            tone="blue"
            size="lg"
          />
          <AnimatedStat
            value="325"
            prefix="$"
            label="стоимость дня в Калифорнии — самый дорогой штат"
            source="ACA California survey"
            tone="red"
            size="lg"
          />
          <AnimatedStat
            value="55"
            prefix="$"
            label="стоимость дня на Среднем Западе — самый доступный регион"
            source="ACA 2025"
            tone="orange"
            size="lg"
          />
        </div>
      </div>

      <!-- ═══ ЕВРОПА ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            🇪🇺 Европа: от «бесплатно» до 334 000 ₽
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          В Европе нет единой модели — три разных страны, три разных философии, три совершенно разных ценника.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="rounded-[16px] bg-blue-50 border border-blue-100 overflow-hidden">
            <img src="/images/articles/story-uk-cambridge.jpg" alt="Кингс-колледж, Кембридж (иллюстрация британского кампуса)" width="1000" height="667" loading="lazy" class="w-full h-[120px] object-cover" />
            <div class="p-5">
            <p class="text-sm font-bold uppercase tracking-[0.08em] text-blue-600 mb-2">🇬🇧 Британия</p>
            <p class="text-[22px] font-bold text-slate-900 mb-1">от 161 000 ₽</p>
            <p class="text-sm text-slate-500 mb-3">за 2 недели · ~11 500 ₽/день</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">
              Лагерь как мини-элитная школа. Дисциплина, традиции, правила общежития. Программа в британском колледже с экскурсиями в Лондон и Оксфорд. «The whole person, the whole point» — целый человек, целая цель.
            </p>
            <p class="text-[10px] text-slate-400 mt-2">Фото: Martinvl / Wikimedia Commons, CC BY-SA 4.0</p>
            </div>
          </div>
          <div class="rounded-[16px] bg-indigo-50 border border-indigo-100 overflow-hidden">
            <img src="/images/articles/story-switzerland-geneva-jtcamp.jpg" alt="Женевское озеро и Альпы (иллюстрация)" width="1000" height="667" loading="lazy" class="w-full h-[120px] object-cover" />
            <div class="p-5">
            <p class="text-sm font-bold uppercase tracking-[0.08em] text-indigo-600 mb-2">🇨🇭 Швейцария</p>
            <p class="text-[22px] font-bold text-slate-900 mb-1">от 334 000 ₽</p>
            <p class="text-sm text-slate-500 mb-3">за программу · ~23 800 ₽/день</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">
              Женева, Collège du Léman. Два языка на выбор, альпинизм, теннис, исторический отель. Востребована среди семей, которым важна связка «безопасность + престиж + результат». Никакой романтики палаток и комаров.
            </p>
            <p class="text-[10px] text-slate-400 mt-2">Фото: Giles Laurent / Wikimedia Commons, CC BY-SA 4.0</p>
            </div>
          </div>
          <div class="rounded-[16px] bg-teal-50 border border-teal-100 overflow-hidden">
            <img src="/images/articles/story-finland-archival.jpg" alt="Финские школьники на занятии в лесу (архивное фото, 1956)" width="1000" height="667" loading="lazy" class="w-full h-[120px] object-cover" />
            <div class="p-5">
            <p class="text-sm font-bold uppercase tracking-[0.08em] text-teal-600 mb-2">🇫🇮 Финляндия</p>
            <p class="text-[22px] font-bold text-slate-900 mb-1">бесплатно</p>
            <p class="text-sm text-slate-500 mb-3">или субсидируется государством</p>
            <p class="text-[14px] leading-[1.6] text-slate-600">
              Подростки едут добровольно. Каждый день — обсуждение серьёзных тем: экология, зависимости, дискриминация, будущее. Ребята сами стирают одежду и следят за бытом. В России это называют «неудобствами». В Финляндии — педагогикой.
            </p>
            <p class="text-[10px] text-slate-400 mt-2">Фото: Erkki Voutilainen / Finnish Heritage Agency, CC BY 4.0</p>
            </div>
          </div>
        </div>

        <div class="rounded-[16px] bg-slate-50 border-l-4 border-indigo-300 px-6 py-4">
          <p class="text-[16px] leading-[1.6] text-slate-700">
            Швейцарский лагерь на 2 недели = <strong>334 000 ₽</strong>, то есть ~23 800 ₽ в день. Это в три раза дороже среднего подмосковного лагеря с ночёвкой. Педагогика при этом та же: временная сепарация от родителей и жизнь в коллективе.
          </p>
        </div>
      </div>

      <!-- ═══ АЗИЯ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            🌏 Азия: от $350 до $2 100 — и совсем другая логика
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <figure class="rounded-[16px] overflow-hidden">
            <img src="/images/articles/story-japan-shichigosan.jpg" alt="Японские дети в традиционной одежде на культурном празднике (иллюстрация)" width="1000" height="667" loading="lazy" class="w-full h-[160px] object-cover" />
            <figcaption class="text-[11px] text-slate-400 mt-1">Фото: Katorisi / Wikimedia Commons, CC BY 3.0</figcaption>
          </figure>
          <figure class="rounded-[16px] overflow-hidden">
            <img src="/images/articles/story-china-classroom.jpg" alt="Китайские школьники в классе (иллюстрация)" width="1000" height="667" loading="lazy" class="w-full h-[160px] object-cover" />
            <figcaption class="text-[11px] text-slate-400 mt-1">Фото: Jeff chenqinyi / Wikimedia Commons, CC BY-SA 3.0</figcaption>
          </figure>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Япония</strong> делает ставку на культурное погружение и командный дух: каллиграфия, боевые искусства, чайные церемонии — всё это даёт практический опыт идентичности. Стоимость жилого лагеря — от ¥50 000 до ¥300 000 ($350–2 100).
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Китай</strong> — прямая противоположность скандинавскому подходу. Родители там не «отпускают» ребёнка — они инвестируют в его академический результат. Китайский лагерь — это интенсив по математике или программированию. Никакого «просто отдохнуть». И тем не менее платят не меньше, чем в США.
        </p>
        <div class="rounded-[16px] bg-amber-50 border border-amber-100 px-6 py-4">
          <p class="text-[15px] text-slate-700 leading-[1.7]">
            То, что на Западе называют «helicopter parenting», в Восточной Азии воспринимается как норма. Независимость подростка от родителей там — не цель, а тревожный симптом.
          </p>
        </div>
      </div>

      <!-- ═══ ТАБЛИЦА ЦЕН ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Всё в одной таблице: стоимость дня в лагере по миру
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Переводим всё в один масштаб — стоимость <strong>одного дня</strong> пребывания. Курс: 90 ₽ за доллар.
        </p>

        <div class="rounded-[16px] border border-slate-200 overflow-hidden mb-6">
          <table class="w-full text-[14px]">
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="text-left px-4 py-3 font-semibold">Страна / лагерь</th>
                <th class="text-right px-4 py-3 font-semibold">$/день</th>
                <th class="text-right px-4 py-3 font-semibold">₽/день</th>
                <th class="text-left px-4 py-3 font-semibold hidden sm:table-cell">Тип</th>
              </tr>
            </thead>
            <tbody>
              {[
                { name: "США — Калифорния", usd: "~325", rub: "~29 200", type: "Элитный sleepaway", highlight: false },
                { name: "Швейцария (Женева)", usd: "~265", rub: "~23 800", type: "Образовательный курорт", highlight: false },
                { name: "США — в среднем", usd: "179", rub: "~16 100", type: "Sleepaway camp", highlight: false },
                { name: "Япония (топ-лагерь)", usd: "~150", rub: "~13 500", type: "Культурный интенсив", highlight: false },
                { name: "Британия (2 нед.)", usd: "~115", rub: "~10 350", type: "Boarding-style camp", highlight: false },
                { name: "АйДаКемп", usd: "~85–95", rub: "~7 500–8 600", type: "ИТ + творчество + команда", highlight: true },
                { name: "США — Средний Запад", usd: "~55", rub: "~4 950", type: "Базовый sleepaway", highlight: false },
              ].map((row) => (
                <tr class={row.highlight ? "bg-green-50 border-t-2 border-green-200" : "border-t border-slate-100 odd:bg-white even:bg-slate-50"}>
                  <td class={`px-4 py-3 font-medium ${row.highlight ? 'text-green-800' : 'text-slate-700'}`}>{row.name}</td>
                  <td class={`px-4 py-3 text-right font-mono ${row.highlight ? 'font-bold text-green-700' : 'text-slate-600'}`}>{row.usd}</td>
                  <td class={`px-4 py-3 text-right font-mono ${row.highlight ? 'font-bold text-green-700' : 'text-slate-600'}`}>{row.rub}</td>
                  <td class={`px-4 py-3 hidden sm:table-cell ${row.highlight ? 'text-green-700 font-medium' : 'text-slate-500'}`}>{row.type}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <AnimatedBarChart
          title="Стоимость одного дня в лагере (₽)"
          items={[
            { label: "🇺🇸 США — Калифорния", value: 29200, badge: "29 200 ₽", color: "#EF4444" },
            { label: "🇨🇭 Швейцария", value: 23800, badge: "23 800 ₽", color: "#6366F1" },
            { label: "🇺🇸 США — в среднем", value: 16100, badge: "16 100 ₽", color: "#F97316" },
            { label: "🇯🇵 Япония (топ)", value: 13500, badge: "13 500 ₽", color: "#EC4899" },
            { label: "🇬🇧 Британия", value: 10350, badge: "10 350 ₽", color: "#8B5CF6" },
            { label: "АйДаКемп 🌲", value: 8600, badge: "8 600 ₽", color: "#10B981" },
            { label: "🇺🇸 США — Средний Запад", value: 4950, badge: "4 950 ₽", color: "#94A3B8" },
          ]}
          source="ACA 2025, Collège du Léman, данные АйДаКемп"
          maxValue={32000}
        />
      </div>

      <!-- ═══ ЧТО УЧАТ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что учат в лагере: приоритеты по странам
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          Цена — только часть картины. За одни и те же деньги в разных культурах воспитывают принципиально разное. Американский лагерь и японский лагерь при схожем чеке дают почти противоположный опыт.
        </p>

        <div class="rounded-[20px] border border-slate-100 overflow-hidden mb-6">
          {[
            { flag: "🇺🇸", country: "США", priority: "Самостоятельность и личная ответственность", how: "Запрет звонков домой, домашние обязанности с 5 лет, самообслуживание" },
            { flag: "🇬🇧", country: "Британия", priority: "Жизнь в сообществе с чёткими нормами", how: "Дисциплина, традиции, устав лагеря, boarding school DNA" },
            { flag: "🇨🇭", country: "Швейцария", priority: "Безопасность + престиж + измеримый результат", how: "Языки, спорт, образовательный туризм, именитый кампус" },
            { flag: "🇫🇮", country: "Финляндия", priority: "Самоопределение и критическое мышление", how: "Дискуссии о жизни, быт — своими руками, добровольное участие" },
            { flag: "🇯🇵", country: "Япония", priority: "Культурная идентичность и командный дух", how: "Традиционные практики, ритуалы, коллектив важнее индивидуума" },
            { flag: "🇨🇳", country: "Китай", priority: "Академический результат и конкурентоспособность", how: "Интенсивы по математике, программированию, олимпиадные задачи" },
            { flag: "🇷🇺", country: "Россия (лучшие)", priority: "Навыки + взросление + командная работа", how: "Профессиональные навыки + временная сепарация от родителей" },
          ].map((row, i) => (
            <div class={`flex items-start gap-4 px-5 py-4 ${i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
              <span class="text-[36px] shrink-0 leading-none">{row.flag}</span>
              <div class="flex-1 min-w-0">
                <p class="text-[15px] font-semibold text-slate-900 mb-0.5">{row.country}</p>
                <p class="text-[14px] text-slate-700 mb-0.5">{row.priority}</p>
                <p class="text-[13px] text-slate-400">{row.how}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ═══ ВЫВОД ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            И после этого вы говорите, что наш лагерь дорогой?
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
