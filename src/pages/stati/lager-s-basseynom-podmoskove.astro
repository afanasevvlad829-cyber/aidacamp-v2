---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Детский лагерь АйДаКемп", url: "/detskiy-lager/", icon: "house-door", description: "Всё о программе и сменах" },
  { title: "Лагерь в Подмосковье", url: "/lager-v-podmoskove/", icon: "geo-alt", description: "Расположение, как добраться" },
  { title: "Лагерь в лесу", url: "/stati/detskiy-lager-v-lesu/", icon: "tree", description: "Природа и активности на свежем воздухе" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "История, команда, ценности АйДаКемп" },
];

const faqItems = [
  {
    question: "Какая глубина бассейна в санатории «Изумруд»?",
    answer: "Бассейн рассчитан на детей: мелкая часть около 90 см, глубокая — 130 см. Дети в нарукавниках или без — всегда под присмотром вожатых и инструктора."
  },
  {
    question: "По какому расписанию дети купаются?",
    answer: "Купание входит в дневную программу: как правило, после обеда или в первой половине дня, в зависимости от расписания смены. Точное время сообщаем перед заездом."
  },
  {
    question: "Что делать, если ребёнок не умеет плавать?",
    answer: "Не умеющих плавать детей не оставляем без подстраховки. Вожатые помогают с плавательными нарукавниками, учат держаться на воде. Бассейн — место для удовольствия, а не соревнований."
  },
  {
    question: "У ребёнка аллергия на хлор — можно ли купаться?",
    answer: "В бассейне санатория «Изумруд» используется ионизированная вода — без хлора. Это мягкий метод очистки, безопасный для кожи и слизистых. Большинство детей с чувствительной кожей переносят его хорошо. При серьёзных аллергиях лучше проконсультироваться с педиатром."
  },
];
---

<Base
  title="Лагерь с бассейном в Подмосковье 2026 — АйДаКемп"
  description="Бассейн с ионизированной водой в санатории Изумруд. IT-программа + водные активности. 66 км от Москвы, смены от 48 000 ₽."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-s-basseynom-podmoskove/" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Детский лагерь с бассейном в Подмосковье: что важно знать",
        "description": "Бассейн с ионизированной водой в санатории Изумруд. IT-программа + водные активности. 66 км от Москвы, смены от 48 000 ₽.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/lager-s-basseynom-podmoskove/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
          {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
          {"@type": "ListItem", "position": 3, "name": "Лагерь с бассейном в Подмосковье", "item": "https://aidacamp.ru/stati/lager-s-basseynom-podmoskove/"}
        ]
      }
    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title="Детский лагерь с бассейном в Подмосковье: что важно знать"
    subtitle="IT-программа плюс настоящий бассейн с ионизированной водой — в одном месте"
    breadcrumb="Лагерь с бассейном"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Дети в летнем лагере с бассейном в Подмосковье"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <h2>Почему бассейн важен для летнего лагеря</h2>
    <p>
      Лето в Подмосковье — это жара, и если ребёнок целый день проводит на улице или за занятиями, ему нужна возможность нормально охладиться. Не просто полить из шланга, а по-настоящему поплескаться. Бассейн — это и физическая активность, и способ сбросить усталость после насыщенного дня.
    </p>
    <p>
      Для многих школьников лагерь — первое место, где они плавают не по расписанию физкультуры, а просто потому что хочется. Это другой формат удовольствия: без оценок, без норматива, просто вода и летнее настроение. Родители, которые ищут <a href="/detskiy-lager-podmoskove/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">лагерь в Подмосковье</a> с бассейном, часто говорят, что именно бассейн становится главным аргументом для ребёнка согласиться поехать.
    </p>

    <StatCallout
      value="66 км"
      label="от МКАД до санатория «Изумруд» по Киевскому шоссе"
      source="АйДаКемп"
      icon="geo-alt"
      tone="info"
    />

    <h2>Бассейн в АйДаКемп — как это устроено</h2>
    <p>
      АйДаКемп проводит смены на базе санатория «Изумруд» — и там есть настоящий крытый бассейн. Это не надувной бассейн во дворе, а полноценная чаша с мелкой и глубокой зоной, лесенками и душевыми.
    </p>
    <p>
      Вода в бассейне очищается методом ионизации — без хлора. Это важно для детей с чувствительной кожей и тех, кого раздражает характерный запах. Ионизированная вода мягче воздействует на кожу и слизистые, и большинство ребят после купания не чувствуют никакого дискомфорта.
    </p>
    <p>
      Купание проходит по расписанию: вожатые приводят отряд, присутствуют весь сеанс. Дети, которые плохо держатся на воде, получают нарукавники и дополнительное внимание инструктора. Никаких «прыгайте как хотите» — но и зажатой дисциплины нет. Это похоже на пляж с присмотром.
    </p>

    <StatCallout
      value="Ионизация"
      label="метод очистки воды в бассейне — без хлора, безопасен для чувствительной кожи"
      source="Санаторий «Изумруд»"
      icon="shield-check"
      tone="neutral"
    />

    <h2>IT-лагерь плюс бассейн — почему это сочетание работает</h2>
    <p>
      На первый взгляд кажется странным: программирование и бассейн — что общего? На деле — очень много. Ребёнок, который час сидел за задачей по Python или собирал схему в Minecraft, нуждается в переключении. Не просто «погуляй во дворе», а в настоящей смене режима: тело в движении, голова отдыхает.
    </p>
    <p>
      Исследования в области когнитивистики подтверждают: физическая активность после умственной нагрузки улучшает консолидацию памяти. Проще говоря, то, что ребёнок узнал на занятии, лучше усваивается, если после он побегал или поплавал. В лагере это работает естественно — занятия, потом активность, потом снова занятия.
    </p>
    <p>
      Ещё один плюс: школьники, у которых есть «бонус» в виде бассейна после обеда, охотнее включаются в учебные блоки. Мотивация работает в обе стороны.
    </p>

    <StatCallout
      value="2–3 раза"
      label="в неделю — купание в расписании смены"
      source="Программа АйДаКемп"
      icon="calendar-event"
      tone="neutral"
    />

    <h2>Инфраструктура санатория «Изумруд»</h2>
    <p>
      Санаторий «Изумруд» — это не просто корпус с кроватями. Это закрытая территория с лесом, спортивными площадками, столовой и несколькими корпусами. Ребята живут в комнатах по 3–4 человека, питаются четыре раза в день, вечером — общие мероприятия на открытой площадке.
    </p>
    <p>
      Из физических активностей помимо бассейна: футбольное поле, волейбольная площадка, теннис, настольный теннис. Вечером — костры, квесты, кинопоказы. Программа насыщена так, что скучать буквально некогда.
    </p>
    <p>
      Питание — четырёхразовое, адаптировано под активных подростков. Учитываются аллергии и пищевые ограничения — это нужно указать при записи. Лагерь находится в лесной зоне: свежий воздух, тишина по ночам, отсутствие городского шума.
    </p>

    <h2>Как добраться до лагеря с бассейном</h2>
    <p>
      Санаторий «Изумруд» находится в 66 км от МКАД по Киевскому шоссе — это чуть больше часа езды без пробок. Для Москвы и ближнего Подмосковья это комфортное расстояние: и не слишком далеко, и не «в городе».
    </p>
    <p>
      АйДаКемп организует трансфер от метро в начале и конце смены. Родители могут привезти ребёнка самостоятельно — парковка на территории есть. Точное время заезда, адрес и инструкции приходят в Telegram-группу перед каждой сменой.
    </p>
    <p>
      Если вы живёте в Москве или ближнем Подмосковье, добраться несложно. Регионам — прилетающим в московские аэропорты — тоже удобно: Киевское шоссе ведёт прямо от Внуково.
    </p>

    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}

  </main>
  <ArticleBottomCta
    title="Бассейн, IT и лес — всё в одном лагере"
    subtitle="Записывайтесь на смену 2026. Места заполняются быстро."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
