---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { PRICE_S1, PRICE_S2, PRICE_S3, PRICE_S4, PRICE_S21, PRICE_S22 } from '../../data/shifts';

const relatedPages = [
  { title: "Летние смены 2026", url: "/ceny/", icon: "calendar-week", description: "Все смены, даты и цены" },
  { title: "Лагерь в Подмосковье", url: "/lager-na-leto-2026/", icon: "geo-alt", description: "66 км от МКАД, хвойный лес" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Цены и бронирование", url: "/ceny/", icon: "tag", description: "Стоимость смен и рассрочка" },
];

const faqItems = [
  {
    question: "Бассейн в АйДаКемп — крытый или открытый?",
    answer: "Крытый, с ионизированной водой. Работает по расписанию примерно через день — не каждый день, чтобы программа оставалась разнообразной. В жаркую погоду купание может быть чаще. Закрытый формат означает, что бассейн работает в любую погоду."
  },
  {
    question: "Есть ли контроль за безопасностью в воде?",
    answer: "Да, на каждом купании присутствует дежурный инструктор. Ребята заходят в воду только под контролем взрослых, в отведённое время по расписанию. Если ребёнок не умеет плавать — это не проблема: в бассейне есть мелкая зона, где можно просто плескаться и привыкать к воде."
  },
  {
    question: "Подходит ли лагерь с бассейном, если ребёнок не любит плавание?",
    answer: "Подходит. Бассейн в лагере — это не урок плавания с дорожками и секундомером. Это время с друзьями в воде: прыгать, плескаться, зависать на надувных кругах. Школьники, которые дома говорили «не хочу на плавание», в лагере сами бегут купаться — потому что рядом все."
  },
  {
    question: "Как далеко лагерь от Москвы?",
    answer: "66 км от МКАД по Киевскому шоссе, Наро-Фоминский район. Около часа на машине или полтора часа на электричке. В начале и в конце смены организуем трансфер из Москвы — уточните детали при бронировании."
  }
];
---

<Base
  title="Лагерь с бассейном в Подмосковье — детский отдых с плаванием"
  description="Детский лагерь с бассейном в Подмосковье — крытый бассейн с ионизированной водой, хвойный лес, 66 км от МКАД. IT-программа + плавание. Смены 2026."
  ogImage="/images/hero/lager-v-podmoskove.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/lager-s-basseynom-podmoskove" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Лагерь с бассейном в Подмосковье — детский отдых с плаванием",
        "description": "Детский лагерь с бассейном в Подмосковье — крытый бассейн с ионизированной водой, хвойный лес, 66 км от МКАД. IT-программа + плавание. Смены 2026.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-17",
        "dateModified": "2026-06-17",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/lager-s-basseynom-podmoskove"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Лагерь с бассейном в Подмосковье", "item": "https://aidacamp.ru/stati/lager-s-basseynom-podmoskove/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Лагерь с бассейном в Подмосковье"
    subtitle="Про то, почему бассейн в лагере — это совсем другое, чем городские секции. И как выбрать место, где ребята сами бегут купаться."
    imageBase="kuda-letom"
    imageAlt="Ребята в детском лагере с бассейном в Подмосковье"
    readTime="5 мин чтения"
    breadcrumbsLast="Лагерь с бассейном в Подмосковье"
    daryaQuote="Когда я выбирала лагерь для дочери, бассейн стоял в списке «хорошо бы было». Но когда я увидела, как она сама бежит на купание без напоминаний — поняла, что дело не в бассейне, а в том, что рядом друзья."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Бассейн — один из первых пунктов в списке, когда мамы выбирают летний лагерь в Подмосковье. Оно понятно: жара, июль, ребёнку нужно где-то охладиться. Но между «бассейн есть» и «ребята счастливы» — большая разница. Разберём, что на самом деле важно.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему бассейн в лагере работает иначе, чем секция плавания
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Городская секция плавания — это дорожки, секундомер, тренер с замечаниями и обязательная поездка через полгорода. Большинство школьников это переносят через «не хочу». Именно поэтому фраза «мне неохота на плавание» звучит дома регулярно.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В лагере всё устроено иначе. Купание — это не урок и не тренировка. Это часть дня: после обеда все идут к воде вместе, прыгают, плещутся, дурачатся с надувными кругами. Когда рядом двадцать друзей, которые уже в воде, — даже самый ленивый ребёнок сам бежит в бассейн.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Мы видим это каждый сезон: те, кто дома ныл «не хочу плавать», в лагере не вылезают из воды. Среда меняет мотивацию быстрее любых уговоров.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Бассейн в АйДаКемп: как это устроено
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп расположен в 66 км от МКАД по Киевскому шоссе, Наро-Фоминский район. На территории — крытый бассейн с ионизированной водой. Крытый — значит, купание возможно в любую погоду, а резкого запаха хлора, который так не любят школьники, здесь нет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Купание проходит по расписанию примерно через день: не каждый день, чтобы программа оставалась разнообразной. В жаркую погоду может быть чаще. На каждом купании дежурит инструктор — ребята заходят в воду только под присмотром взрослых.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Не умеет плавать — не проблема. В бассейне есть и мелкая зона, где можно просто плескаться. Никто не заставляет нырять и плыть на время.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что ещё из активностей — бассейн только начало
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Бассейн — одна из активностей, но не единственная. День в АйДаКемп построен так, чтобы переключение происходило само: после занятий — на улицу, после обеда — в воду или на спорт, вечером — командный квест или дискотека.
        </p>
        <ul class="flex flex-col gap-3 max-w-[680px] mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-water text-blue-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Бассейн</strong> — крытый, с ионизированной водой. Купание по расписанию, дежурный инструктор рядом.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-dribbble text-green-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Спорт</strong> — волейбол, футбол, пионербол. Чемпионаты лагеря встроены в программу и проходят регулярно.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-tree text-green-600 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>40 соток хвойного леса</strong> — территория с соснами, где есть место для прогулок и командных игр, а не тесный двор.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-laptop text-primary shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>IT-программа</strong> — программирование и работа с AI каждый день. К концу смены — собственный проект: игра, приложение или интерактивная история.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Сочетание физической активности и умственной работы — не случайное. Ребята, которые поплавали и набегались, работают над проектами с другим уровнем концентрации. Это слышно в отзывах мам каждый сезон.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Смены 2026: когда и сколько стоит
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В 2026 году в АйДаКемп шесть смен: от 7-дневных коротких до 14-дневных. Бассейн работает во всех сменах — это часть стандартной программы, а не платная опция.
        </p>
        <div class="grid gap-3 max-w-[680px] mb-4">
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 1 (завершена) · 10 дней · 30 мая — 8 июня</span>
              <span class="text-base font-bold text-primary">{PRICE_S1}</span>
            </div>
            <p class="text-base text-slate-600">Старт сезона. Спокойный вход, хороший вариант для первого раза. Бассейн, IT-программа, хакатон.</p>
          </div>
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 2.1 (завершена) · 7 дней · 10–16 июня</span>
              <span class="text-base font-bold text-primary">{PRICE_S21}</span>
            </div>
            <p class="text-base text-slate-600">Короткий, но насыщенный формат — для тех, кто хочет попробовать лагерь без долгой разлуки.</p>
          </div>
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 2.2 (завершена) · 8 дней · 16–23 июня</span>
              <span class="text-base font-bold text-primary">{PRICE_S22}</span>
            </div>
            <p class="text-base text-slate-600">Чуть больше времени на проект и активности — оптимальный баланс для первой смены.</p>
          </div>
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 2 (завершена) · 14 дней · 10–23 июня</span>
              <span class="text-base font-bold text-primary">{PRICE_S2}</span>
            </div>
            <p class="text-base text-slate-600">Полный цикл: больше самостоятельности, более сложный итоговый проект, максимум активностей.</p>
          </div>
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 3 · 13 дней · 3–15 августа</span>
              <span class="text-base font-bold text-primary">{PRICE_S3}</span>
            </div>
            <p class="text-base text-slate-600">Командный акцент, август — самое тёплое купание. Хороший вариант для тех, кому важна работа в команде.</p>
          </div>
          <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-base font-semibold text-slate-900">Смена 4 · 10 дней · 17–26 августа</span>
              <span class="text-base font-bold text-primary">{PRICE_S4}</span>
            </div>
            <p class="text-base text-slate-600">Закрытие лета: сильный итоговый проект, бассейн, спорт. Хорошо заходит как «последнее лето перед школой».</p>
          </div>
        </div>
        <p class="text-base text-slate-500">
          Подробные программы и свободные места — на странице <a href="/ceny/" class="text-primary underline underline-offset-2 hover:no-underline">Смены 2026</a>.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            На что смотреть при выборе лагеря с бассейном
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда изучаете варианты лагерей с бассейном в Подмосковье, есть несколько вопросов, которые стоит задать напрямую — а не просто смотреть на фотографии.
        </p>
        <ul class="flex flex-col gap-3 max-w-[680px]">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Крытый или открытый?</strong> Открытый бассейн в дождливое лето превращается в пустышку. Крытый работает всегда.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Есть ли инструктор на каждом купании?</strong> Это не лишний вопрос — это вопрос безопасности.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Как часто купание в расписании?</strong> Раз в неделю — это не «лагерь с бассейном», а лагерь, где бассейн иногда есть.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-circle-fill text-emerald-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Что за программа кроме бассейна?</strong> Летний отдых — это не только вода. Важно, чем ребята заняты в остальное время.</span>
          </li>
        </ul>
      </div>

      <BlogCTA variant="default" />

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-4 max-w-[720px]">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-white p-5">
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-base leading-[1.65] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>

  <RelatedPages pages={relatedPages} />
  <ArticleBottomCta />
  <Footer />
</Base>
