---
import { PRICE_MIN, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const faqItems = [
  {
    question: "С какого возраста отправлять ребёнка в первый лагерь?",
    answer: "В большинстве лагерей принимают с 7 лет, но возраст — не главное: важнее самостоятельность (три проверочных вопроса — в разделе «Как понять что ребёнок готов»). В АйДаКемп принимаем от 7 до 15 лет, группы формируются по возрасту."
  },
  {
    question: "Что делать если ребёнок плачет и хочет домой?",
    answer: "Первые 2–3 дня — самые сложные для большинства детей. Это нормальная адаптация, а не сигнал что что-то не так. Лучшее что можно сделать: договориться о фиксированном времени звонка (например, в 20:00), не обещать забрать раньше срока и дать ребёнку три дня. Вожатые видят состояние ребёнка вживую — доверяйте им. Если через 3 дня всё ещё плохо — это повод поговорить с вожатым, не с ребёнком."
  },
  {
    question: "Можно ли приехать проведать ребёнка?",
    answer: "Зависит от правил конкретного лагеря. В большинстве лагерей родительские визиты не приветствуются в первую неделю — это мешает адаптации. Ребёнок только начал вживаться, и визит мамы возвращает тревогу с начала. Уточните правила до заезда. Лучший способ «проведать» — фото в родительском чате и звонок в договорённое время."
  },
  {
    question: "Что взять с собой первый раз?",
    answer: "Минимальный список: удобная одежда по погоде (3–4 комплекта), закрытая обувь и сланцы, купальник/плавки, полотенце, средства гигиены, солнцезащитный крем, небольшая аптечка (пластыри, антигистаминное). Важно: подпишите маркером или термонаклейками всё — одежду, полотенца, обувь. Это резко снижает количество потеряшек. Полный чеклист — на странице «Что взять в летний лагерь»."
  },
  {
    question: "Как выбрать смену для первого раза?",
    answer: "Для первого раза лучше короткая смена — 7 дней, а не 14 или 21. Меньше срок — меньше тревога, проще пережить первые дни адаптации. Также выбирайте тематику, которая ребёнку уже интересна: если любит игры — IT-лагерь с геймдев-треком. Тогда программа сама по себе становится мотивацией, и первые дни проходят легче."
  },
  {
    question: "Нормально ли что мама сама плачет при расставании?",
    answer: "Абсолютно нормально. Но постарайтесь не делать этого на виду у ребёнка в момент прощания. Ваша тревога — это топливо для его тревоги. Скажите уверенно: «Всё отлично, я тебя люблю, увидимся через неделю» — и уходите. Поплачете в машине. Дети считывают эмоции мгновенно, и ваша уверенность при прощании реально влияет на то, как пройдут первые часы."
  },
];

const relatedPages = [
  { title: `Смены лета ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и забронировать" },
  { title: "Что взять в летний лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "backpack", description: "Полный список — ничего не забыть" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Кто мы и как устроен день" },
];
---

<Base
  title="Ребёнок первый раз в лагере — страхи мамы и реальность | АйДаКемп"
  description='Ребёнок первый раз в лагере: «А вдруг он будет плакать?» — разбираем 6 главных страхов мамы. Что из них реально, что нет, и как подготовиться без тревоги.'
  ogImage="/images/hero/o-lagere.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Ребёнок первый раз в лагере — страхи мамы и реальность",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
        "datePublished": "2026-04-21",
        "dateModified": "2026-05-06",
        "url": "https://aidacamp.ru/stati/pervyj-raz-v-lagere"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Ребёнок первый раз в лагере", "item": "https://aidacamp.ru/stati/pervyj-raz-v-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок первый раз едет в лагерь — страхи мамы и реальность"
    subtitle="Шесть вещей, которые боятся мамы — и что происходит на самом деле."
    imageBase="o-lagere"
    imageAlt="Ребёнок в лагере с вожатым — улыбается и чувствует себя комфортно"
    readTime="8 мин чтения"
    breadcrumbsLast="Ребёнок первый раз в лагере"
    daryaQuote="Когда дочь уехала в первый раз, я написала ей три сообщения ещё до того, как автобус выехал за ворота. Она прочитала первое и больше не отвечала. Вечером скинула фото с новой подругой. Я плакала от облегчения."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждое лето одно и то же: мамы стоят у ворот с тревожными глазами, а дети через 10 минут уже бегут знакомиться. Страхи перед первым лагерем нормальны, но большинство из них не совпадает с реальностью. Разберём самые частые.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 1: «Он будет плакать и звонить каждые два часа»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Самый распространённый страх — и самый часто опровергаемый опытом. Большинство перестают скучать по дому на второй-третий день, когда втягиваются в программу. Первый вечер тяжелее всего, дальше легче.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Механизм простой: когда ребёнок занят и увлечён, он физически не успевает скучать. В хорошем лагере от завтрака до отбоя нет пустых дыр в расписании, которые заполняются тоской по маме.
        </p>

        <StatCallout
          value="2–3 дня"
          label="— обычно столько нужно ребёнку, чтобы адаптироваться и почувствовать себя «своим» в новой группе."
          source="Наблюдения вожатых АйДаКемп, 2022–2025"
          icon="clock"
          tone="neutral"
        />
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 2: «Его обидят, а я не узнаю»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Этот страх — про невидимость: вы не рядом и не можете контролировать. Но это не значит, что никто не смотрит. В хорошем лагере на восьмерых один вожатый — конкретный человек, который знает ребят по именам, видит настроение и замечает изменения.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп у каждого отряда есть вожатый с прямым номером телефона. Родительский чат обновляется ежедневными фото и короткими отчётами — новости из лагеря приходят каждый день, пропустить ничего не получится. Если ребёнок чем-то расстроен — вожатый звонит родителям сам, не ждёт, пока позвонят ему.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Конфликты между детьми случаются — это нормальная часть социализации. Задача вожатого не предотвратить все конфликты, а помочь детям их разрешить. И это тоже навык, который ребёнок увезёт домой.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 3: «Он ничего не ест, у нас особый рацион»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Аллергии и пищевые особенности нужно закрыть до заезда. Нормальный лагерь принимает список аллергий при регистрации и учитывает его в меню — это стандарт, а не одолжение.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп питание 5 раз в день: завтрак, перекус, обед, полдник, ужин. При регистрации мы просим указать аллергии — и меню адаптируется. Если у ребёнка серьёзная аллергия, лучше также передать информацию медику при заезде.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Про аппетит есть закономерность, которую замечают все родители: в лагере едят заметно больше, чем дома. Тот, кто дома ковыряет кашу, здесь просит добавки — воздух, активность и компания делают своё.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 4: «Лагерь — это скучная теория, он и так дома с компьютером сидит»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это один из самых важных вопросов для IT-лагеря. И разница здесь принципиальная: дома ребята потребляют контент — смотрят YouTube, листают TikTok, играют в чужие игры. В IT-лагере они создают — делают свой проект, который работает и его можно показать.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это другой режим мозга: потребление пассивно, создание требует концентрации и командной работы. Из такого дня выходят усталыми, но довольными — не опустошёнными, как после часа в TikTok.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп финал каждой смены — хакатон. Команды из 3–5 человек за несколько часов делают готовый проект и представляют его перед всем лагерем. Тот, кто до этого только смотрел YouTube про игры — вдруг делает игру сам. Это меняет отношение к технологиям.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          При этом за экраном ноутбука дети проводят только часть дня. Остальное — физическая активность, бассейн, вечерние игры, командные конкурсы. Это не программирование 8 часов подряд.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 5: «А вдруг заболеет, упадёт, что-то случится»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Царапины и ссадины — часть активного детства, они были бы и дома. Разница в том, что здесь рядом медработник и чёткий протокол.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Медработник дежурит 24/7: при любом обращении, от укуса комара до температуры, осматривает и решает — справиться на месте или звонить родителям. О серьёзном происшествии сообщают всегда.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Территория застрахована. Есть протокол действий при различных инцидентах: от медицинских до ЧС. Вожатые проходят инструктаж по безопасности.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если сравнивать с альтернативой «ребёнок дома один или во дворе» — в лагере взрослых рядом больше и они более подготовлены к нештатным ситуациям, чем среднестатистический двор.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Страх 6: «Потеряет все вещи»
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Потеряет. Особенно носки. Это не предположение — это гарантия. Но масштаб потерь сильно преувеличен в родительской фантазии.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Из нашего опыта: за смену из чемодана бесследно исчезает 1–2 носка и иногда футболка. Дорогие вещи теряются редко и обычно находятся в потеряшках после смены.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Простое решение: подпишите всё маркером или термонаклейками с именем. Одежда, полотенца, обувь — всё. Тогда потеряшки возвращаются к владельцу, а не лежат в общей куче до конца смены.
        </p>
      </div>

      <!-- Как понять что ребёнок готов -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как понять что ребёнок готов ехать в лагерь
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Три простых вопроса. Если хотя бы два из трёх — «да», скорее всего готов:
        </p>
        <div class="space-y-3 mb-5">
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <i class="bi bi-check-circle-fill text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Может ночевать вне дома без родителей?</p>
              <p class="text-base leading-[1.6] text-slate-500 mt-0.5">Хотя бы у бабушки, у друга, на даче. Если ночевал и не просился домой — базовая готовность есть.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <i class="bi bi-check-circle-fill text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Умеет сам поесть, помыться, одеться?</p>
              <p class="text-base leading-[1.6] text-slate-500 mt-0.5">Базовая самостоятельность снижает тревогу в первые дни — ребёнок не растерян в бытовых ситуациях.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 border border-slate-200 rounded-xl p-4">
            <i class="bi bi-check-circle-fill text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-base font-semibold text-slate-800">Есть хотя бы один интерес за пределами дома?</p>
              <p class="text-base leading-[1.6] text-slate-500 mt-0.5">Игры, программирование, рисование — любой интерес, по которому ему будет интересна программа лагеря. В лагере ребята быстро находят друзей с похожими интересами — именно это делает первые дни легче.</p>
            </div>
          </div>
        </div>
        <div class="bg-orange-50 border border-orange-100 rounded-xl p-5">
          <div class="flex items-start gap-3">
            <i class="bi bi-info-circle text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-700">Если ни одного «да» — не форсируйте. Подождите год и попробуйте снова. Насилие в этом вопросе гарантирует плохой первый опыт и нежелание ехать снова.</p>
          </div>
        </div>
      </div>

      <!-- Как подготовить: разговор до отъезда -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как подготовить ребёнка: разговор до отъезда
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-5">
          Как подготовить ребёнка к детскому лагерю — особенно если это первый раз. Несколько вещей, которые реально помогают сделать первый опыт лагеря хорошим:
        </p>
        <ul class="flex flex-col gap-4 mb-6">
          <li class="flex items-start gap-2.5">
