---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "AI-лагерь для детей", url: "/ai-lager/", icon: "cpu", description: "Нейросети, ChatGPT API, AI-проекты" },
  { title: "Лагерь Python", url: "/python-lager/", icon: "laptop", description: "Python с нуля до бота" },
  { title: "Нейросети для детей", url: "/stati/nejroseti-dlya-detej/", icon: "cpu", description: "С чего начать и зачем" },
  { title: `Смены ${SEASON_YEAR} — цены`, url: "/ceny/", icon: "calendar-week", description: "Выбрать смену и записаться" },
];

const faqItems = [
  {
    question: "Нужно ли ребёнку знать программирование перед AI-сменой?",
    answer: "Нет. На AI-смене АйДаКемп дети работают с нейросетями через готовые инструменты — ChatGPT API, Gemini, Kandinsky. Базовое понимание логики помогает, но не обязательно. Для тех, у кого уже есть опыт в Python — есть отдельный трек, где AI интегрируется с кодом."
  },
  {
    question: "Что конкретно делают дети на AI-смене — какой проект получается на выходе?",
    answer: "Зависит от возраста и интересов. Чаще всего ребята делают одно из трёх: AI-бот (Telegram-бот с ChatGPT внутри), AI-игру (генерация сюжетов, персонажей, диалогов через нейросеть) или AI-арт-проект (серия иллюстраций с описаниями, собственная «нейростудия»). Каждый проект защищается на хакатоне в последний день смены."
  },
  {
    question: "С какого возраста подходит AI-смена в лагере?",
    answer: "С 10 лет. В этом возрасте дети уже понимают причинно-следственные связи, умеют формулировать запросы и критически оценивать ответы. Для детей 7–9 лет в АйДаКемп есть другие треки — Scratch, Minecraft — где элементы AI-инструментов тоже присутствуют, но в более простом формате."
  },
  {
    question: "Чем AI-смена в лагере отличается от онлайн-курса по нейросетям?",
    answer: "Три принципиальных отличия. Первое — финальный проект: в лагере нельзя бросить на середине, потому что есть хакатон и живая аудитория. Второе — команда: ребята работают в группах, учатся делить задачи и объяснять решения другим — это само по себе навык. Третье — интенсивность: 40–50 часов работы за 10–14 дней дают прогресс, которого не достичь за 3 месяца занятий раз в неделю. Онлайн-курс хорош для закрепления; лагерь — для старта и прорыва."
  },
  {
    question: "Безопасно ли давать ребёнку доступ к ChatGPT API?",
    answer: "Да, в образовательном контексте — безопасно. В АйДаКемп мы используем API с системными промтами, которые ограничивают темы ответов. Ребёнок работает не с открытым чатом ChatGPT, а с настроенным программным доступом. Родительского контроля и фильтрации достаточно, чтобы все взаимодействия оставались образовательными. Кроме того, все проекты создаются под наблюдением преподавателя."
  },
  {
    question: "Нужно ли уметь программировать чтобы работать с AI на смене?",
    answer: "Нет. Начинаем с промтинга — как разговаривать с AI чтобы получить нужный результат. Это без кода. Потом добавляем Python: 3 строки кода чтобы спросить OpenAI API что-то. Потом усложняем. К концу смены большинство участников 12+ делают AI-ассистента с памятью разговора. Это реальная программа, не маркетинг."
  }
];
---

<Base
  title="Нейросети для детей в лагере — чему учат на AI-смене АйДаКемп"
  description="Что такое AI-смена в детском IT-лагере: ChatGPT API, Gemini, реальные проекты детей 10–15 лет. Нужно ли знать программирование. Подробно про AI-трек АйДаКемп."
  ogImage="/images/hero/ai-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Нейросети для детей в лагере: чему учат на AI-смене | АйДаКемп",
        "description": "AI-смена в детском IT-лагере: ChatGPT API, Gemini, проекты детей 10-15 лет. Нужно ли знать программирование до лагеря и что ребёнок получит на выходе.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/ai-proekty-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>

  <Header />

  <ArticleHero
    title="Нейросети в детском лагере: что делают дети 12–15 лет с AI"
    subtitle="Разбираем AI-смену изнутри: инструменты, проекты, результаты — и нужно ли уметь программировать."
    imageBase="ai-lager"
    imageAlt="Дети работают с AI-инструментами в летнем лагере"
    imagePosition="center"
    readTime="7 мин чтения"
    breadcrumbsLast="Нейросети в детском лагере"
    daryaQuote="Когда дочь первый раз показала мне бота, которого сделала вместе с ChatGPT — я честно не сразу поняла, что половину кода написал AI. Это и есть настоящий навык: знать, как поставить задачу."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          «AI-смена» — это не курс по ChatGPT. Это когда ребёнок за 10–14 дней создаёт проект, где нейросеть — не цель, а инструмент. Рассказываем, как это устроено в АйДаКемп и что получается на выходе.
        </p>
      </div>

      <!-- Раздел 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое AI-смена — в двух словах
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          AI-смена — это специальный трек в рамках стандартной смены АйДаКемп. Дети 10–15 лет учатся работать с нейросетями не как с развлечением, а как с инструментом для решения задач. Ключевое отличие от кружка по ChatGPT: здесь есть финальный проект, который нужно защитить на хакатоне.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Инструменты, с которыми работают дети: ChatGPT API (не просто чат, а настоящий программный доступ), Gemini, Kandinsky (генерация изображений), Suno (генерация музыки), а для старших — интеграция нейросетей в Python-код.
        </p>
        <div class="rounded-[14px] bg-orange-50 border border-orange-100 p-4 md:p-5 max-w-[720px] mb-4">
          <p class="text-base font-semibold text-orange-700 mb-1">Важно понимать</p>
          <p class="text-base leading-[1.6] text-slate-700">
            AI-смена — не замена программированию. Дети, которые уже умеют писать код, используют нейросети как помощника. Те, кто с нуля — начинают с промтинга и постепенно приходят к пониманию логики.
          </p>
        </div>
      </div>

      <!-- Раздел 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Реальные проекты детей — что они делают за смену
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вот несколько типичных проектов, которые дети 10–15 лет создают на AI-смене. Все они реальные — были защищены на хакатонах прошлых сезонов.
        </p>

        <div class="space-y-4 mb-6">
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-base font-bold text-slate-900 mb-2">
              <i class="bi bi-cpu text-orange-500 mr-2" aria-hidden="true"></i>
              AI-бот «Помощник по урокам» (13 лет)
            </p>
            <p class="text-base leading-[1.6] text-slate-600">
              Telegram-бот, который отвечает на школьные вопросы с объяснением, а не просто даёт готовый ответ. Промт настроен так, чтобы бот задавал наводящие вопросы, как учитель. Написан на Python с подключением к ChatGPT API.
            </p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-base font-bold text-slate-900 mb-2">
              <i class="bi bi-controller text-orange-500 mr-2" aria-hidden="true"></i>
              Текстовый квест с AI-персонажем (11 лет)
            </p>
            <p class="text-base leading-[1.6] text-slate-600">
              Интерактивная история, где главный злодей — это ChatGPT с особым системным промтом. Игрок переписывается с ним, пытаясь «победить». Сюжет и иллюстрации к сценам сгенерированы через Kandinsky.
            </p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4 md:p-5">
            <p class="text-base font-bold text-slate-900 mb-2">
              <i class="bi bi-star-fill text-orange-500 mr-2" aria-hidden="true"></i>
              AI-арт: «Мой город в 2076 году» (12 лет)
            </p>
            <p class="text-base leading-[1.6] text-slate-600">
              Серия из 12 изображений: родной город глазами нейросети через 50 лет. Каждая картинка — отдельный промт, описание района, архитектурного стиля, времени суток. Итог собран в PDF-журнал с авторскими подписями.
            </p>
          </div>
        </div>

        <p class="text-base leading-[1.6] text-slate-500 max-w-[720px]">
          Один из таких проектов стал проходным на городской олимпиаде по информатике. Ребята сами удивились — думали, что AI-проект «ненастоящий».
        </p>
      </div>

      <!-- Раздел 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Нужно ли знать программирование — честный ответ
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нет, не нужно. Берём с нуля. На AI-смене есть два уровня:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 max-w-[720px]">
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-2">Уровень 1 — Промтинг и инструменты</p>
            <p class="text-base leading-[1.6] text-slate-600">Для тех, кто не программирует. Учатся правильно ставить задачи нейросети, работать с разными AI-инструментами, делать проект без кода.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-2">Уровень 2 — AI + Python</p>
            <p class="text-base leading-[1.6] text-slate-600">Для тех, кто уже знает Python. Подключают ChatGPT API в свой код, делают ботов и приложения с настоящим AI под капотом.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          При регистрации мы спрашиваем про опыт — и определяем ребёнка в правильную группу. Никого не теряем: ни новичков, ни тех, кто уже писал код.
        </p>
      </div>

      <!-- Раздел: почему AI-грамотность важнее одного языка -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему AI-грамотность важнее знания одного языка программирования
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          WEF Future of Jobs 2025 назвал AI-грамотность навыком №2 для работодателей к 2030 году — опередив математику, коммуникацию и критическое мышление. Знание конкретного языка программирования — хорошо. Умение работать с AI-инструментами — важнее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Вот почему: языки программирования меняются. 10 лет назад учили Flash ActionScript — сейчас его нет. 5 лет назад был пик Kotlin — сейчас конкуренция сильнее. AI-инструменты меняются ещё быстрее, но принцип остаётся: умение ставить задачу нейросети, оценивать ответ и итерировать — это навык, а не знание конкретного инструмента.
        </p>
        <div class="rounded-[16px] bg-blue-50 border-l-4 border-blue-400 px-6 py-5 mb-4">
          <p class="text-[16px] leading-[1.6] text-slate-700">
            Школьник, который умеет работать с ChatGPT API, Gemini и Kandinsky — уже сейчас может создавать продукты, которые раньше требовали команды из 3–5 специалистов.
          </p>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Именно поэтому на AI-смене в АйДаКемп мы не учим «ChatGPT» как инструмент — мы учим методологии: как разбить задачу на части, как написать промт, как проверить результат и как интегрировать AI в рабочий проект. Эти навыки останутся с ребёнком, даже если через 5 лет ChatGPT будет заменён чем-то принципиально другим.
        </p>
      </div>
      <!-- AI-проекты которые делают на сменах -->
      <section class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            AI-проекты которые создают на сменах АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Примеры реальных проектов, которые участники защищали на хакатонах:
        </p>
        <div class="space-y-3 mb-4">
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-1">Бот-репетитор</p>
            <p class="text-base leading-[1.6] text-slate-600">Отвечает на вопросы по школьным предметам через GPT, задаёт наводящие вопросы вместо готовых ответов.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-1">AI-рекомендатор книг</p>
            <p class="text-base leading-[1.6] text-slate-600">Анализирует что уже читал пользователь — предлагает следующую книгу с объяснением почему подойдёт.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-1">Автоматический конспектировщик</p>
            <p class="text-base leading-[1.6] text-slate-600">Берёт длинный текст — выдаёт краткое содержание с ключевыми тезисами.</p>
          </div>
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-1">AI-игра с живым NPC</p>
            <p class="text-base leading-[1.6] text-slate-600">Персонаж в игре отвечает не по скрипту, а через языковую модель — каждый диалог уникален.</p>
          </div>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 max-w-[720px]">
          Каждый из этих проектов реален, работает и опубликован на GitHub участниками.
        </p>
      </section>

      <BlogCTA variant="default" />

      <!-- FAQ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>


  <ArticleBottomCta
    bookingTitle="Хотите, чтобы ваш ребёнок работал с AI?"
    bookingSubtitle="Запишите на IT-смену — за две недели ребята создают реальные AI-проекты."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
