---
import { Icon } from 'astro-icon/components';
import { DAYS_MAX, DAYS_MIN, PRICE_MAX, PRICE_MIN, SEASON_YEAR, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "IT-лагерь для школьников", url: "/lager-programmirovaniya/", icon: "laptop", description: "Программирование, игры, проекты — 10 дней в Подмосковье" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Что происходит когда ребята отключаются от экранов" },
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-coin", description: `Как вернуть до ${VYCHET_MAX} от государства за детский лагерь` },
  { title: `Смены и цены ${SEASON_YEAR}`, url: "/ceny/", icon: "calendar-event", description: "Расписание всех смен, стоимость, что входит" },
];

const faqItems = [
  {
    question: "С какого возраста школьника берут в загородный лагерь?",
    answer: "Большинство лагерей принимают с 8–9 лет. В АйДаКемп — с 9 до 17 лет. Младшим, как правило, сложно первое время без мамы, и это честнее признать заранее, чем обнаружить в первую ночь."
  },
  {
    question: "Что лучше — дневной или загородный лагерь?",
    answer: "Зависит от школьника и задачи. Дневной — меньший стресс, школьник каждый вечер дома, стоит дешевле. Загородный даёт полное погружение, новую среду и живое общение без родителей — именно это работает как «перезагрузка». Если у подростка проблемы с самостоятельностью или телефонной зависимостью — загородный эффективнее."
  },
  {
    question: `Сколько стоит детский лагерь в Подмосковье в ${SEASON_YEAR} году?`,
    answer: `Диапазон широкий: от 30 000–40 000 ₽ за короткую смену (${DAYS_MIN}) до 90 000–100 000 ₽ за длинную (14 дней). Августовские смены АйДаКемп завершились; их стоимость составляла от ${PRICE_MIN} за смену 4 (${DAYS_MAX}) до ${PRICE_MAX} за смену 3 (13 дней). Часть суммы можно вернуть через налоговый вычет — до ${VYCHET_MAX}.`
  },
  {
    question: "Как выбрать IT-лагерь — на что смотреть?",
    answer: "Три главных вопроса: (1) Ребята создают что-то своё или только проходят готовые уроки? Проектная работа даёт результат, который школьник покажет друзьям. (2) Каков размер группы? Больше 12 человек на педагога — внимание размывается. (3) Есть ли живое общение и активность вне экрана? Лагерь, где школьники сидят за компьютером 8 часов подряд — это не лагерь, а буткемп."
  },
];
---

<Base
  title={`Куда отдать ребёнка на лето — 8 вариантов, честное сравнение для родителей ${SEASON_YEAR}`}
  description="Куда отдать ребёнка на лето: дача у бабушки, кружки, дневной лагерь или IT-смена? Сравниваем 8 вариантов, их плюсы и минусы — без рекламного глянца."
  ogImage="/images/articles/og-kuda-otdat-rebenka-na-leto.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Куда отдать ребёнка на лето — 8 вариантов, честное сравнение",
        "description": "Дача у бабушки, кружки, дневной лагерь или IT-смена? Разбираем 8 реальных вариантов с плюсами и минусами — без рекламного глянца.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kuda-otdat-rebenka-na-leto/"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Куда отдать ребёнка на лето — 8 вариантов"
    subtitle="8 вариантов для школьников и родителей — честное сравнение с плюсами, минусами и реальными ценами."
    imageBase="lager-programmirovaniya"
    imageAlt="Школьники в летнем лагере — выбор варианта отдыха на лето"
    readTime="7 мин чтения"
    breadcrumbsLast="Куда отдать ребёнка на лето"
    daryaQuote="Каждую весну меня спрашивают одно и то же: что лучше — лагерь или кружки? Я разобрала все варианты, которые сама рассматривала для дочери. Без прикрас."
  />

  <main id="main-content" class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Введение -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Три месяца лета — ресурс, который легко потратить впустую: школьник в режиме «телефон — холодильник — телефон» к сентябрю не отдохнул, а заскучал. Набить каникулы кружками и репетиторами тоже не выход. Разобрала 8 вариантов, которые рассматривает большинство родителей: у каждого — плюсы, минусы и кому подходит.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 1: Дача у бабушки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Воздух, природа, почти бесплатно, и все спокойны. Но без сверстников скучно, телефон заполняет пустоту, а подростки от 12 лет открыто злятся. Подходит до 10 лет, если рядом есть компания.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 2: Секции и кружки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Конкретный навык за лето и привычная среда. Но каникулы превращаются в продолжение учёбы, а вечером снова экран и прежние привычки. Подходит школьнику с целью — например, подготовиться к соревнованиям.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 3: Репетитор на лето
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Точечно закрывает пробелы в знаниях, график гибкий. Но подросток воспринимает это как наказание, и конфликты с родителями растут. Лучше как дополнение к основному варианту, 1–2 раза в неделю.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 4: Дневной городской лагерь
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Сверстники и структура дня, вечером школьник дома, а стоит в 2–3 раза дешевле загородного. Зато нет полного погружения, а программа часто слабее. Подходит до 10 лет и тем, кто не готов ночевать вдали от дома.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 5: Загородный лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Полная смена среды, самостоятельность и дружба без родителей. Но разброс качества большой, выбирать нужно тщательно, и не все сразу готовы к разлуке. Подходит от 9 лет.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 6: IT-лагерь — программирование и технологии
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Школьник живёт в загородном лагере, но вместо «кружков для галочки» делает реальные проекты: пишет игры, собирает сайты, программирует роботов. В <a href="/lager-bez-telefonov/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">хороших IT-лагерях телефоны сдают при заезде</a> — детокс без войны, а часть стоимости можно вернуть через <a href="/nalogovyj-vychet/" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">налоговый вычет</a>. Минусы: дороже обычного лагеря — от {PRICE_MIN} за смену, а красивого маркетинга при слабой программе много, так что надо проверять. Подходит школьникам 9–17 лет, которым интересны игры и технологии.
        </p>
        <div class="rounded-xl bg-[#fff8f0] border border-primary/20 p-4 mt-4">
          <p class="text-base text-slate-700 mb-2">В <strong>АйДаКемп</strong> каждый участник создаёт собственный проект — игру, сайт или телеграм-бот. Не «проходит уроки», а делает что-то настоящее.</p>
          <a href="/lager-programmirovaniya/" class="inline-block mt-2 text-base font-semibold text-orange-700 hover:text-orange-900 hover:underline">Посмотреть программу IT-лагеря →</a>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 7: Языковой лагерь
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Языковая среда без учебника и ребята из других городов. Но дороже обычного лагеря, а настоящих носителей в России не всегда найти. Подходит школьнику с уровнем от Pre-Intermediate, который хочет говорить.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 8: Отдых за рубежом
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Максимальная смена контекста и опыт самостоятельности. Зато от 200 000 ₽, плюс визы и перелёты, и не у всех семей есть возможность в {SEASON_YEAR} году. Подходит подросткам от 14 лет с хорошим уровнем языка.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как выбрать осознанно, а не по инерции
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Спросите самого подростка: школьники старше 8–9 лет обычно понимают, чего хотят. И не бойтесь комбинировать — два-три варианта часто работают лучше одного на всё лето. Летний сезон {SEASON_YEAR} завершён.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как проверить конкретный лагерь перед покупкой путёвки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Проверьте четыре вещи: лицензию (образовательная даёт право на налоговый вычет 13%), договор с расшифровкой, что входит в цену, свежие тексты отзывов вместо средней оценки и число ребят на одного вожатого — 1 к 6–8 рабочий вариант.
        </p>
      </div>


      <!-- FAQ -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4" data-faq-answer>
                <p class="text-base leading-[1.7] text-slate-600">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 rounded-2xl bg-[#f7f5f2] p-6 border border-primary/20">
        <p class="font-semibold text-[#0d1a2b] text-[18px]">Если школьнику интересны технологии — покажите, что из этого делают взрослые</p>
        <p class="mt-2 text-base text-[#0d1a2b]/70">В АйДаКемп школьники пишут реальный код и уезжают с готовым проектом. Без скучных лекций и домашних заданий — только практика и команда таких же.</p>
        <a href="/lager-programmirovaniya/" class="mt-4 inline-block rounded-xl bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-[#d68830] transition-colors">Посмотреть программу и смены</a>
      </div>

      <!-- Читайте также -->
      <div class="mt-8 mb-4 pt-8 border-t border-slate-100">
        <p class="text-base font-semibold text-slate-500 uppercase tracking-wider mb-4">Читайте также</p>
        <div class="flex flex-col gap-2">
          <a href="/lager-programmirovaniya/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <Icon name="bi:arrow-right" class="bi bi-arrow-right text-base" aria-hidden="true" />
            IT-лагерь АйДаКемп — программа, смены, цены
          </a>
          <a href="/lager-bez-telefonov/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <Icon name="bi:arrow-right" class="bi bi-arrow-right text-base" aria-hidden="true" />
            Лагерь без телефонов — как работает и зачем
          </a>
          <a href="/nalogovyj-vychet/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <Icon name="bi:arrow-right" class="bi bi-arrow-right text-base" aria-hidden="true" />
            Налоговый вычет за лагерь — как вернуть до {VYCHET_MAX}
          </a>
          <a href="/ceny/" class="text-base text-orange-700 hover:text-orange-900 hover:underline flex items-center gap-1.5">
            <Icon name="bi:arrow-right" class="bi bi-arrow-right text-base" aria-hidden="true" />
            Смены и цены АйДаКемп {SEASON_YEAR}
          </a>
        </div>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите лето, после которого школьник скажет спасибо?"
    bookingSubtitle="Оставьте телефон — расскажем про ближайшую свободную смену и ответим на все вопросы."
  />

  <RelatedPages title="Смотрите также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />

  <script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
