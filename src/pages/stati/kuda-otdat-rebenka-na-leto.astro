    bookingTitle="Хотите лето, после которого ребёнок скажет спасибо?"
    bookingSubtitle="Оставьте телефон — расскажем про ближайшую свободную смену и ответим на все вопросы."
  />

  <RelatedPages title="Смотрите также" pages={relatedPages} />
  <Footer />

  <script>
    document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('[data-faq-item]');
        const answer = item.querySelector('[data-faq-answer]');
        const icon = btn.querySelector('[data-faq-icon]');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          answer.classList.remove('is-open');
          if (icon) icon.style.transform = '';
          btn.setAttribute('aria-expanded', 'false');
        } else {
          answer.classList.add('is-open');
          if (icon) icon.style.transform = 'rotate(45deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</Base>
