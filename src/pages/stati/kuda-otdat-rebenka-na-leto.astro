---
import { PRICE_MAX, PRICE_MIN, VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';

const relatedPages = [
  { title: "IT-лагерь для школьников", url: "/lager-programmirovaniya/", icon: "laptop", description: "Программирование, игры, проекты — 10 дней в Подмосковье" },
  { title: "Лагерь без телефонов", url: "/lager-bez-telefonov/", icon: "phone-x", description: "Что происходит когда ребята отключаются от экранов" },
  { title: "Налоговый вычет за лагерь", url: "/nalogovyj-vychet/", icon: "cash-coin", description: `Как вернуть до ${VYCHET_MAX} от государства за детский лагерь` },
  { title: "Смены и цены 2026", url: "/ceny/", icon: "calendar-event", description: "Расписание всех смен, стоимость, что входит" },
];

const faqItems = [
  {
    question: "С какого возраста ребёнка берут в загородный лагерь?",
    answer: "Большинство лагерей принимают с 8–9 лет. В АйДаКемп — с 9 до 17 лет. Ниже этого порога ребёнку, как правило, сложно первое время без мамы, и это честнее признать заранее, чем обнаружить в первую ночь."
  },
  {
    question: "Что лучше — дневной или загородный лагерь?",
    answer: "Зависит от ребёнка и задачи. Дневной — меньший стресс, ребёнок каждый вечер дома, стоит дешевле. Загородный даёт полное погружение, новую среду и живое общение без родителей — именно это работает как «перезагрузка». Если у подростка проблемы с самостоятельностью или телефонной зависимостью — загородный эффективнее."
  },
  {
    question: "Сколько стоит детский лагерь в Подмосковье в 2026 году?",
    answer: `Диапазон широкий: от 30 000–40 000 ₽ за короткую смену (7 дней) до 90 000–100 000 ₽ за длинную (14 дней). В АйДаКемп цены от ${PRICE_MIN} за смену 2.1 (7 дней) до ${PRICE_MAX} за смену 2 (14 дней). Часть суммы можно вернуть через налоговый вычет — до ${VYCHET_MAX}.`
  },
  {
    question: "Как выбрать IT-лагерь — на что смотреть?",
    answer: "Три главных вопроса: (1) Дети создают что-то своё или только проходят готовые уроки? Проектная работа даёт результат, который ребёнок покажет друзьям. (2) Каков размер группы? Больше 12 человек на педагога — внимание размывается. (3) Есть ли живое общение и активность вне экрана? Лагерь, где дети сидят за компьютером 8 часов подряд — это не лагерь, а буткемп."
  },
];
---

<Base
  title="Куда отдать ребёнка на лето — 8 вариантов, честное сравнение 2026"
  description="Дача у бабушки, кружки, дневной лагерь или IT-смена? Разбираем 8 реальных вариантов с плюсами и минусами — без рекламного глянца."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/kuda-otdat-rebenka-na-leto/" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Куда отдать ребёнка на лето — 8 вариантов, честное сравнение",
        "description": "Дача у бабушки, кружки, дневной лагерь или IT-смена? Разбираем 8 реальных вариантов с плюсами и минусами — без рекламного глянца.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kuda-otdat-rebenka-na-leto/"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Куда отдать ребёнка на лето", "item": "https://aidacamp.ru/stati/kuda-otdat-rebenka-na-leto/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Куда отдать ребёнка на лето"
    subtitle="8 вариантов, честное сравнение — с плюсами, минусами и реальными ценами."
    imageBase="lager-programmirovaniya"
    imageAlt="Школьники в летнем лагере — выбор варианта отдыха на лето"
    readTime="7 мин чтения"
    breadcrumbsLast="Куда отдать ребёнка на лето"
    daryaQuote="Каждую весну меня спрашивают одно и то же: что лучше — лагерь или кружки? Я разобрала все варианты, которые сама рассматривала для дочери. Без прикрас."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Введение -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Три месяца лета — это не проблема, которую надо «решить», а ресурс, который легко потратить впустую. Школьник, который провёл лето в режиме «телефон — холодильник — телефон», к сентябрю не отдохнул, а деградировал. И дело не в том, что он «ленился»: просто не было среды, которая давала бы что-то новое.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          С другой стороны, набить каникулы до краёв кружками и репетиторами — тоже не выход. Подросток устал не меньше, просто по расписанию.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Разобрала 8 реальных вариантов, которые рассматривает большинство родителей. Для каждого — честные плюсы, минусы и кому подходит. В конце — сравнительная таблица, чтобы быстро сориентироваться.
        </p>
      </div>

      <!-- Вариант 1: Дача -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 1: Дача у бабушки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Классика. Самый распространённый и самый «по умолчанию» вариант. Ребёнок в безопасности, бабушка счастлива, родители работают. Звучит хорошо — и часто так и есть. Но давайте честно.
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="text-base font-semibold text-emerald-700 uppercase tracking-wide mb-3">Плюсы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Воздух, движение, природа — хорошо физически</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Бесплатно или почти бесплатно</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Родители спокойны: ребёнок под присмотром близких</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Свобода режима, нет давления расписания</span></li>
            </ul>
          </div>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-base font-semibold text-red-700 uppercase tracking-wide mb-3">Минусы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Без сверстников скучно — телефон заполняет пустоту</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Бабушка контролирует плохо или не контролирует вообще</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Никакого нового опыта и развития — просто пауза</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Подростки от 12 лет открыто скучают и злятся</span></li>
            </ul>
          </div>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 italic">Кому подходит: до 10 лет, если рядом есть компания сверстников-соседей. Старшим — скорее нет, особенно если нет занятия.</p>
      </div>

      <!-- Вариант 2: Кружки и секции -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 2: Секции и кружки
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Летние интенсивы, продолжение учебного года, новые курсы. Вариант для тех, кто хочет чтобы лето не прошло даром.
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="text-base font-semibold text-emerald-700 uppercase tracking-wide mb-3">Плюсы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Конкретный навык или результат за лето</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Ребёнок занят и не скучает в будни</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Привычная среда — меньше стресса от новизны</span></li>
            </ul>
          </div>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-base font-semibold text-red-700 uppercase tracking-wide mb-3">Минусы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Лето воспринимается как продолжение учёбы — усталость копится</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Вечерами всё равно дома, прогресс с телефоном не меняется</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Нет смены среды и настоящего приключения</span></li>
            </ul>
          </div>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 italic">Кому подходит: ребёнку с конкретной целью — подготовиться к соревнованиям, добрать пропущенное. Как основной вариант на всё лето — быстро надоедает.</p>
      </div>

      <!-- Вариант 3: Репетитор -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 3: Репетитор на лето
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Популярный выбор перед переходными классами. Родитель видит конкретную задачу — подтянуть математику или английский — и нанимает специалиста.
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="text-base font-semibold text-emerald-700 uppercase tracking-wide mb-3">Плюсы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Точечное закрытие пробелов в знаниях</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Гибкий график — можно совмещать с другим вариантом</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Индивидуальный темп, не надо подстраиваться под класс</span></li>
            </ul>
          </div>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-base font-semibold text-red-700 uppercase tracking-wide mb-3">Минусы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Ребёнок воспринимает как наказание, а не лето</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Сопротивление и конфликты с родителями растут</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Не даёт ни отдыха, ни нового опыта, ни общения</span></li>
            </ul>
          </div>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 italic">Кому подходит: как дополнение к основному варианту, 1–2 раза в неделю. Полное лето с репетитором — редко работает без потерь в отношениях.</p>
      </div>

      <!-- Вариант 4: Дневной лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 4: Дневной городской лагерь
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При школах или досуговых центрах. Ребёнок с утра до 17:00 занят, потом возвращается домой. Для многих родителей — компромисс между «под присмотром» и «не тоскует дома».
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="text-base font-semibold text-emerald-700 uppercase tracking-wide mb-3">Плюсы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Сверстники, общение, структура дня</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Ребёнок каждый вечер дома — для тревожных мам идеально</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Дешевле загородного лагеря в 2–3 раза</span></li>
            </ul>
          </div>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-base font-semibold text-red-700 uppercase tracking-wide mb-3">Минусы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Нет полного погружения и «лагерного» эффекта смены среды</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Вечером снова экран и прежние привычки</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-x-lg text-red-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Программа часто слабее, чем в выездных лагерях</span></li>
            </ul>
          </div>
        </div>
        <p class="text-base leading-[1.6] text-slate-500 italic">Кому подходит: ребёнку до 10 лет или тому, кто ещё не готов ночевать вдали от дома. Старшим — скорее переходный вариант.</p>
      </div>

      <!-- Вариант 5: Загородный лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Вариант 5: Загородный лагерь с проживанием
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Классический формат — вывезти школьника на природу, с вожатыми и программой на 2–3 недели. До сих пор работает, если лагерь нормальный.
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="text-base font-semibold text-emerald-700 uppercase tracking-wide mb-3">Плюсы</p>
            <ul class="flex flex-col gap-2">
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Полная смена среды — мозг перезагружается</span></li>
              <li class="flex items-start gap-2"><i class="bi bi-check-lg text-emerald-600 text-base mt-0.5 shrink-0" aria-hidden="true"></i><span class="text-base text-slate-700">Самостоятельность, дружба, живое общение — без родителей</span></li>
