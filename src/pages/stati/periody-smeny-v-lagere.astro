---
import { PRICE_MIN, DATES_S3, DATES_S4, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Как устроен день в лагере", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "calendar-week", description: "Почасовой распорядок дня" },
  { title: `Лагерь на лето ${SEASON_YEAR}`, url: "/lager-na-leto-2026/", icon: "sun", description: "Все заезды и даты" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать заезд" },
  { title: "Как выбрать лагерь", url: "/stati/kak-vybrat-lager/", icon: "search", description: "Чек-лист для мамы" },
];

const faqItems = [
  {
    question: "Что такое заезд и период в детском лагере?",
    answer: "Период (в лагере его так и называют — сменой) — это один заезд: группа ребят приезжает в один день и уезжает в один день. За лето лагерь обычно делает 2–4 таких заезда. Первая смена — в начале лета, вторая — в середине, третья — ближе к августу. Между ними 1–3 дня перерыва на уборку и подготовку."
  },
  {
    question: "Чем второй заезд отличается от первого и третьего?",
    answer: "Главное отличие — погода и загрузка. Первый заезд — самый ранний, вода ещё прохладная, зато мест больше всего. Второй (середина лета) — тёплая вода, пик сезона, мест меньше всего. Третий — ближе к августу, погода стабильная, можно совместить с подготовкой к школе. Программа в АйДаКемп во всех заездах одинаково сильная."
  },
  {
    question: "Какой заезд дешевле?",
    answer: "Цена зависит не от порядкового номера, а от длительности заезда и того, насколько рано вы бронируете. Чем ближе к старту — тем дороже: за 30 дней до заезда цена подрастает. Поэтому самый дешёвый вариант — забронировать любой заезд заранее, а не ждать «удачного периода»."
  },
  {
    question: "Можно ли отправить школьника сразу на два заезда?",
    answer: "Да. Многие так и делают: если ребятам нравится, двух недель им мало. Едут на два заезда подряд или с небольшим перерывом дома. В АйДаКемп для постоянных участников есть приятные условия — уточняйте при бронировании."
  }
];
---

<Base
  title="Сколько длится смена в детском лагере: даты и периоды"
  description="Сколько длится смена в детском лагере: первая, вторая и третья — периоды 1, 2 и 3 сезона, количество дней, погода, загрузка и цены."
  ogImage="/images/articles/kuda-letom-1600.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Заезды в детском лагере: чем отличаются периоды 1, 2 и 3",
        "description": "Что такое заезд и период в детском лагере, чем 1-я отличается от 2-й и 3-й по погоде, загрузке и цене, и как выбрать вариант под ребёнка.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-06-22",
        "dateModified": "2026-06-22",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/periody-smeny-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ])} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Периоды смен в детском лагере", "item": "https://aidacamp.ru/stati/periody-smeny-v-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Периоды смены в детском оздоровительном лагере: первая, вторая, третья"
    subtitle="Чем заезды отличаются по погоде, загрузке и цене — и как выбрать тот, что подойдёт именно вашему школьнику."
    imageBase="kuda-letom"
    imageAlt="Летний детский лагерь — заезды и периоды сезона"
    readTime="7 мин чтения"
    breadcrumbsLast="Периоды смен"
    daryaQuote="Меня часто спрашивают: «А какой заезд лучше?» Честно — лучше тот, на который вы успеете спокойно собраться. Программа у нас в каждом заезде одинаково сильная, а вот свободные места заканчиваются по-разному."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда выбираешь лагерь впервые, сразу натыкаешься на цифры: первая, вторая, третья. И непонятно — это просто разные даты или между ними есть реальная разница. Разбираемся по-простому: какие бывают периоды заезда, чем они отличаются и как выбрать тот, что подойдёт вашему школьнику.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое заезд и период — простыми словами
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Заезд и период в оздоровительном лагере — это одно и то же. Группа ребят приезжает и уезжает в один день, живёт вместе всю программу. Закончился заезд — приезжает следующая группа. За лето лагеря обычно успевают сделать от двух до четырёх таких заездов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Нумерация простая и по календарю: первый летний заезд идёт под номером один, следующий — под номером два, и так далее. Между заездами лагерь делает паузу в 1–3 дня — на уборку, проверку и подготовку к новой группе.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Иногда длинный летний заезд делят на две короткие половинки — например, недельную и восьмидневную. Тогда школьник может приехать на короткий вариант, а может остаться на весь период целиком. Это удобно, если вы хотите попробовать формат «на пробу», не отправляя ребёнка сразу на две недели.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чем отличаются 1, 2 и 3 заезда
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Сама программа в хороших лагерях от номера заезда не зависит — вожатые, расписание и качество одинаковые. А вот какие три вещи меняются от заезда к заезду: погода, загрузка и цена.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Структурно каждый заезд лагеря делится на три этапа, и эти этапы одинаковы: первые дни — знакомство команды, основной период — работа идёт в полную силу, заключительный этап — доработка проекта и хакатон.
        </p>
        <div class="space-y-3 mb-6">
          <div class="flex gap-3 items-start">
            <i class="bi bi-thermometer-sun text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Погода.</strong> Первая смена — самая ранняя: воздух уже тёплый, но вода в бассейне и на улице ещё прохладная. К середине лета становится по-настоящему жарко, а к августу погода ровная и стабильная — без майских сюрпризов.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-people text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Загрузка.</strong> Середина лета — пик: июльские и серединные заезды разбирают первыми, мест меньше всего. На ранних и поздних периодах свободнее — и выбрать удобную дату проще.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-coin text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Цена.</strong> Зависит не от порядкового номера, а от длительности заезда и от того, как рано вы бронируете. Чем ближе к старту — тем дороже.</p>
          </div>
        </div>
        <StatCallout
          value="69%"
          label="родителей в России отправляют детей в лагерь именно летом — отсюда и пик загрузки на серединных заездах. Раннее бронирование снимает эту гонку за места."
          source="ВЦИОМ, опрос об организации детского отдыха, 2023"
          icon="people"
          tone="neutral"
        />
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Короткий или длинный заезд — что выбрать
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Сколько длится заезд — важнее, чем его номер. Короткий период (7–10 суток) — хороший старт, если школьник едет в лагерь впервые или переживает из-за разлуки. За эти дни он успевает влиться, найти приятелей и понять, что без мамы рядом — нормально.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Длинный период (13–14 дней) — для тех, кому уже хочется большего. Здесь больше времени на сам проект, на дружбу, на то, чтобы по-настоящему расслабиться и не считать дни до отъезда. Опытные участники почти всегда выбирают вариант подлиннее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          За полторы-две недели интенсивной работы ребята успевают выработать устойчивые навыки: в длинном заезде есть время повторить, доработать и довести проект до защиты.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если сомневаетесь — начните с короткого заезда. Понравится (а так чаще всего и бывает) — в следующий раз возьмёте заезд подлиннее.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему важен режим заезда, а не «удачная» дата
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Многие мамы ищут «самую удачную» дату, как будто есть один правильный ответ. На деле всё проще: хороший заезд — это тот, к которому удобно подготовиться и который вписывается в ваше лето. Отпуск родителей, дача, занятия, отъезды бабушки — всё это влияет на выбор сильнее, чем номер периода.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Режим заезда — это график: когда приезжать, когда забирать, сколько дней школьник проведёт без вас. Под этот график вы планируете свои дела, родительский день и встречу. Удобный режим важнее красивой даты в календаре.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- Section 5: Заезды 2026 АйДаКемп -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Летние заезды {SEASON_YEAR} в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В нашем IT-лагере в Подмосковье на лето {SEASON_YEAR} открыты заезды на август — погода в это время самая стабильная. Разберём, какие заезды ещё доступны и чем они отличаются:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 max-w-[720px]">
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[14px] font-bold text-slate-900 mb-1">Смена 3</p>
            <p class="text-[15px] leading-[1.6] text-slate-600">{DATES_S3} · 13 дней. Полный цикл проекта с акцентом на командную работу. От {PRICE_S3}.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[14px] font-bold text-slate-900 mb-1">Смена 4</p>
            <p class="text-[15px] leading-[1.6] text-slate-600">{DATES_S4} · 10 дней. Закрытие лета: сильный проект и уверенный результат. От {PRICE_S4}.</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Финал каждого периода — итоговый хакатон: ребята защищают готовый проект перед всеми участниками — это и есть настоящее подведение итогов заезда.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Цена в обоих заездах растёт по мере приближения старта, поэтому выгоднее забронировать заранее. Подробный почасовой распорядок дня — в статье <a href="/stati/zhizn-v-lagere-dlya-detej/" class="font-semibold text-primary hover:underline">как устроен день в лагере</a>, а все даты и условия лета — в разделе <a href="/lager-na-leto-2026/" class="font-semibold text-primary hover:underline">лагерь на лето {SEASON_YEAR}</a>. Лагерь в Подмосковье, 66 км от МКАД, 7–15 лет, от {PRICE_MIN}.
        </p>
      </div>

      <!-- FAQ -->
      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Не знаете, какой заезд выбрать?"
    bookingSubtitle="Расскажем про свободные места, режим заезда и поможем подобрать период под вашего школьника."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
