---
import { VYCHET_MAX } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "IT-лагерь АйДаКемп", url: "/it-camp/", icon: "laptop", description: "Программирование + летний отдых" },
  { title: "Цены 2026", url: "/ceny/", icon: "coin", description: "Выбрать смену" },
  { title: "Детский лагерь", url: "/detskiy-lager/", icon: "house", description: "О лагере подробнее" },
  { title: "IT-лагерь или кружок", url: "/stati/it-lager-vs-kruzhok/", icon: "arrow-left-right", description: "Честное сравнение форматов" },
];

const faqItems = [
  {
    question: "Как выбрать между лагерем и онлайн-курсами по программированию?",
    answer: "Зависит от цели. Если нужно проверить — интересно ли ребёнку вообще — начните с бесплатных онлайн-ресурсов (Scratch, Code.org, Khan Academy). Если интерес уже есть и нужен реальный скачок — лагерь не заменить ничем: живая среда, наставники рядом, проект от идеи до результата за 2 недели. Онлайн-курсы хороши для закрепления и самостоятельного движения вперёд — после того как лагерь дал первый толчок."
  },
  {
    question: "Сколько стоит IT-лагерь на летние каникулы?",
    answer: `Открытые августовские смены АйДаКемп: от 74 900 рублей за 10-дневную смену до 89 400 рублей за 13-дневную смену. При этом часть стоимости возвращается через налоговый вычет: до ${VYCHET_MAX} рублей для 13-дневной смены. Лагерь включает проживание, питание, программу и все материалы — отдельно ничего доплачивать не нужно.`
  },
  {
    question: "Можно ли выучить программирование самостоятельно летом?",
    answer: "Теоретически — да, практически — немногие. Самостоятельное обучение требует высокой самодисциплины, умения ставить себе цели и не бросать при первой трудности. Для большинства детей 8–14 лет это сложно. Но если ребёнок уже мотивирован, хорошие бесплатные ресурсы есть: Codecademy, freeCodeCamp, Stepik. Главное — конкретная цель («сделать эту игру»), а не абстрактное «выучить Python»."
  },
  {
    question: "Какую программу выбрать для ребёнка 10 лет?",
    answer: "В 10 лет ребёнок готов к реальному программированию. Python — отличный первый язык: читаемый синтаксис, огромное сообщество, применяется в играх, ИИ и веб-разработке. Scratch — если совсем без опыта, для лёгкого входа без синтаксических ошибок. Разработка игр на Unity или Godot — если ребёнок мечтает создавать игры. В АйДаКемп программа 10-летних детей включает Python и разработку игр — это оптимальный старт с реальным результатом в конце."
  },
  {
    question: "Что ребёнок успеет выучить за 2 недели в IT-лагере?",
    answer: "Реальный результат за 2 недели: базовый Python или JavaScript, логику алгоритмов и структур данных, работу с готовыми библиотеками, создание и защита финального проекта — игры, сайта, бота или мобильного приложения. Не глубина, а широта и уверенность: ребёнок понимает, как это всё работает, и знает, в каком направлении двигаться дальше."
  },
  {
    question: "Стоит ли учить программирование летом или лучше отдыхать?",
    answer: "Учёба и отдых — не противоположности, если учёба в правильном формате. 2 часа кода в день в лагере плюс бассейн, друзья и природа — это не «работа летом». Это ближе к тому, как работают будущие разработчики: решил интересную задачу, пошёл отдыхать. Летний лагерь по программированию — именно этот баланс."
  }
];
---

<Base
  title="Программирование на каникулах — лагерь, курсы или самостоятельно"
  description="Как организовать летние каникулы ребёнка с пользой: сравниваем IT-лагерь, онлайн-курсы и самостоятельное изучение программирования. Плюсы и минусы каждого"
  ogImage="/images/articles/programmirovanie-v-lagere-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/programmirovanie-na-kanikuly" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Программирование на каникулах — лагерь, курсы онлайн или самостоятельно",
        "description": "Как организовать летние каникулы ребёнка с пользой: сравниваем IT-лагерь, онлайн-курсы и самостоятельное изучение программирования. Плюсы и минусы каждого варианта.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-03",
        "dateModified": "2026-05-03",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/programmirovanie-na-kanikuly"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Программирование на каникулах", "item": "https://aidacamp.ru/stati/programmirovanie-na-kanikuly/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Программирование на каникулах"
    subtitle="Лагерь, онлайн-курсы или сам — честно разбираем каждый вариант."
    breadcrumb={[
      { label: "Главная", href: "/" },
      { label: "Статьи", href: "/stati" },
      { label: "Программирование на каникулах", href: "" }
    ]}
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Программирование на каникулах — звучит как идеальный план: ребёнок занят полезным
          делом, а не «зависает» в играх. Но как организовать это с умом? Три пути —
          IT-лагерь, онлайн-курсы и самостоятельное изучение — дают очень разные результаты.
          Разбираем плюсы и минусы каждого, чтобы вы выбрали то, что подходит именно вашему
          ребёнку.
        </p>
      </div>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Вариант 1. IT-лагерь: максимальное погружение</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          IT-лагерь — самый интенсивный и результативный способ провести летние каникулы
          с программированием. Ребёнок живёт в среде, где все вокруг пишут код, дышат
          технологиями и соревнуются на хакатоне. За 2 недели происходит то, что в обычных
          условиях занимает несколько месяцев.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Плюсы:</strong> живые наставники, которые объясняют здесь и сейчас;
          финальный проект как конкретный результат; социализация с ровесниками с похожими
          интересами; полное отключение от домашней рутины; никакой усталости от школы.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          <strong>Минусы:</strong> выше стоимость; нужна самостоятельность (ребёнок живёт
          без родителей); ограниченные сроки смены.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Вариант 2. Онлайн-курсы: удобство и доступность</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Онлайн-курсы по программированию для детей — огромный рынок. Здесь есть качественные
          варианты: Яндекс Практикум для детей, Skysmart, Учи.ру, Kodland, международные
          Codecademy и Khan Academy. Диапазон цен — от бесплатных до 10 000 рублей в месяц
          за интенсивный курс с живым педагогом.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Плюсы:</strong> занимайся в удобное время и из любой точки; нет необходимости
          никуда ехать; дешевле лагеря; можно начать прямо сейчас.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          <strong>Минусы:</strong> большой процент детей бросают на полпути — нет среды
          и социальной мотивации; технические проблемы со связью; педагог не видит ребёнка
          вживую и не всегда замечает затруднения.
        </p>
      </section>

      <StatCallout
        stat="80%"
        label="детей, записавшихся на онлайн-курсы, не завершают программу"
        description="По данным исследований EdTech. Главная причина — отсутствие живой среды и социальной мотивации."
      />

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Вариант 3. Самостоятельное изучение: для самодисциплинированных</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Самостоятельное программирование летом работает для детей, у которых уже есть
          чёткий интерес и конкретная цель. Бесплатные ресурсы: Scratch (для младших),
          freeCodeCamp, Stepik, Codecademy, YouTube-каналы типа Traversy Media или CS50
          от Гарварда (на английском, но с субтитрами).
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          <strong>Плюсы:</strong> бесплатно или почти бесплатно; максимальная гибкость;
          формирует самостоятельность и навык учиться самому — ценнейшее качество.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          <strong>Минусы:</strong> требует высокой мотивации; некому помочь когда «завис»
          на непонятном месте; без цели и дедлайна легко затухает; одиноко — нет общения
          с ровесниками.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Идеальная формула летних каникул с программированием</h2>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Лучшая связка, которую мы видим у детей, которые делают реальный прогресс:
          IT-лагерь в июне или августе как точка старта и мощного ускорения + онлайн-кружок
          или самостоятельные проекты в промежутке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          После лагеря ребёнок возвращается с конкретным проектом, новыми друзьями
          в телеграм-чате и чётким пониманием — что ему интересно в IT. Это снимает
          вопрос «а вдруг не понравится» и даёт направление для самостоятельного роста.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          В АйДаКемп две летних смены — июньская и августовская. Можно выбрать одну,
          а можно обе — есть дети, которые приезжают каждое лето и каждый раз берут
          программу на уровень сложнее. Это самый честный показатель результата.
        </p>
      </section>

      <section class="max-w-3xl mx-auto px-0 py-8">
        <h2 class="text-2xl font-bold mb-6">Частые вопросы</h2>
        <div itemscope itemtype="https://schema.org/FAQPage">
          {faqItems.map(item => (
            <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="mb-6">
              <h3 itemprop="name" class="text-lg font-semibold mb-2">{item.question}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p itemprop="text" class="text-gray-700">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Почему лето — лучшее время для старта -->
      <section class="max-w-3xl mx-auto px-0 py-6">
        <h2 class="text-2xl font-bold mb-4">Почему лето — лучшее время для старта в программировании</h2>
        <ul class="flex flex-col gap-3 mb-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Нет школьного давления</strong> — ни оценок, ни домашних заданий, ни расписания. Мозг в режиме игры — открыт к новому.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>2 недели непрерывного погружения</strong> равны 3–4 месяцам вечерних кружков — за счёт концентрации и отсутствия отвлечений.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Ровесники рядом</strong> — мотивация через среду, не через дисциплину. Когда сосед по комнате делает крутого бота — хочется тоже.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Конкретный результат в конце</strong> — бот, игра или сайт — ощутимый итог лета, который можно показать в сентябре.</span>
          </li>
        </ul>
      </section>

      <ArticleBottomCta />
    </article>
  </main>

  <RelatedPages pages={relatedPages} />
  <Footer />
</Base>
