---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import DonutChart from '../../components/DonutChart.astro';
import AnimatedBarChart from '../../components/AnimatedBarChart.astro';

const relatedPages = [
  { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista/", icon: "cpu", description: "Разбираем реальные данные WEF" },
  { title: "ROI образовательных инвестиций", url: "/stati/future-skills/", icon: "cash-coin", description: "Что считать и как" },
  { title: "Навыки которые не устареют", url: "/stati/navyki-kotorye-ne-ustareut/", icon: "graph-up", description: "Конкретный список на 10 лет" },
];
---

<Base
  title="85% профессий ещё не существует. Что с этим делать | АйДаКемп"
  description="IFTF прогнозирует рынок труда с 1968 года. Их цифра про 85% пугает. Объясняю, что она значит и как готовить ребёнка не к профессии, а к быстрому освоению"
  ogImage="/images/articles/ii-programmista-1200.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/meta-skills" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "85% профессий ещё не существует. Что с этим делать",
      "description": "IFTF прогнозирует рынок труда с 1968 года. Их цифра про 85% пугает. Объясняю, что она значит и как готовить ребёнка к быстрому освоению следующей профессии.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-05-26",
      "dateModified": "2026-06-09",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/meta-skills"}
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "85% профессий ещё не существует. Что с этим делать", "item": "https://aidacamp.ru/stati/meta-skills/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="85% профессий ещё не существует. Что с этим делать"
    subtitle="IFTF прогнозирует рынок труда с 1968 года. Их цифра вызывает панику — объясняю, что с этим реально делать."
    imageBase="ii-programmista"
    imageAlt="Профессии будущего — как готовить детей к рынку труда"
    breadcrumbsLast="Профессии будущего"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-10 pb-0">
    <article>

      <!-- Лид -->
      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          IFTF — Institute for the Future, Калифорния — публикует прогнозы рынка труда с 1968 года. Их цифра про 85% вызывает два чувства: кто-то отмахивается, кто-то паникует. Ни то, ни другое не помогает.
        </p>
      </div>

      <!-- ═══ HERO STAT: 85% ═══ -->
      <AnimatedStat
        value="85"
        unit="%"
        label="профессий, в которых будут работать сегодняшние школьники, ещё не существует"
        source="IFTF — Institute for the Future, 2023"
        tone="purple"
      />

      <!-- ═══ SECTION 1: ОТКУДА ЦИФРА ═══ -->
      <div class="mb-10 mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Откуда взялась цифра и что она значит
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          85% — это оценка порядка величины на горизонте 10 лет. Даже авторы говорят, что точность здесь невозможна. Но даже если реальная цифра вдвое меньше — 42% профессий ещё не существует — это уже меняет логику образовательных инвестиций.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-6">
          В 2000 году не существовало: UX-исследователь, data analyst, специалист по кибербезопасности, SMM-менеджер, prompt-инженер. Это не экзотика — это востребованные позиции с хорошими зарплатами сейчас. В 2035 году будут востребованы профессии, которые сегодня нельзя назвать.
        </p>

        <!-- WEF: топ навыков будущего — анимированные полосы -->
        <AnimatedBarChart
          title="Топ навыков будущего — WEF Future of Jobs Report 2025"
          items={[
            { label: "Адаптивность и гибкость",      value: 73, badge: "73%", color: "#8B5CF6" },
            { label: "Критическое мышление",          value: 68, badge: "68%", color: "#6366F1" },
            { label: "Технологическая грамотность",   value: 62, badge: "62%", color: "#3B82F6" },
            { label: "Творческое мышление",           value: 58, badge: "58%", color: "#0EA5E9" },
          ]}
          source="World Economic Forum «Future of Jobs Report 2025»"
        />

        <!-- Заметка: всё это не ИТ-навыки -->
        <div class="mt-5 rounded-[14px] bg-purple-50 border border-purple-100 px-5 py-4">
          <p class="text-base text-slate-700 leading-[1.6]">
            <strong>Обратите внимание:</strong> ни один из топ-4 навыков WEF — не конкретный язык программирования и не знание конкретного ПО. Всё это метанавыки — способность быстро учиться, критически мыслить, адаптироваться.
          </p>
        </div>
      </div>

      <!-- ═══ SECTION 2: ПОЧЕМУ СПЕЦИАЛЬНОСТЬ НЕ РАБОТАЕТ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему выбор «правильной специальности» больше не работает
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          BLS — Бюро трудовой статистики США — фиксирует: средний работник сменит 12 работ за карьеру. McKinsey оценивает: к 2030 году 375 миллионов человек сменят категорию занятости из-за автоматизации. Выигрывает не тот, кто угадал профессию в 17 лет. Выигрывает тот, кто умеет быстро переключаться без паники.
        </p>

        <!-- 2 цифры рядом -->
        <div class="grid grid-cols-2 gap-3">
          <AnimatedStat
            value="375"
            unit=" млн"
            label="человек сменят категорию занятости к 2030 году"
            source="McKinsey Global Institute 2023"
            tone="blue"
            size="lg"
          />
          <AnimatedStat
            value="12"
            unit=" работ"
            label="сменит средний работник за всю карьеру"
            source="BLS, США"
            tone="slate"
            size="lg"
          />
        </div>

        <!-- Пончик: смена работ за карьеру -->
        <div class="mt-6 rounded-[20px] bg-slate-50 border border-slate-100 p-6 flex flex-col sm:flex-row items-center gap-6 justify-center">
          <DonutChart
            percentage={42}
            label="минимальная оценка"
            sublabel="даже если IFTF ошибается вдвое"
            color="#8B5CF6"
            size={120}
            centerText="42%"
          />
          <div class="text-center sm:text-left max-w-[220px]">
            <p class="text-base font-semibold text-slate-700">Даже при оценке вдвое ниже</p>
            <p class="text-base text-slate-500 mt-1 leading-[1.5]">42% профессий, в которых будут работать дети, ещё не существует. Это всё равно меняет логику образовательных инвестиций.</p>
          </div>
        </div>
      </div>

      <!-- ═══ SECTION 3: МЕТАНАВЫКИ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что такое метанавыки и как они развиваются
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-4">
          Метанавык — навык, не привязанный к конкретному инструменту. Умение разобраться в незнакомом ПО за два-три дня, не паниковать перед задачей без готового ответа, декомпозировать большую непонятную задачу на маленькие понятные. Ни один не устаревает при смене языка, платформы или отрасли.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          World Economic Forum в «Future of Jobs 2025» называет три формата наиболее эффективными: проектное обучение, работа в смешанных командах, решение задач без готового ответа. Общее: ученик несёт ответственность за результат, а не за правильное воспроизведение чужого решения.
        </p>

        <!-- Но всё равно запишете на юриста -->
        <div class="rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5 mb-5">
          <p class="text-[16px] leading-[1.6] text-slate-700">
            Но вы всё равно запишете на юриста. Потому что надёжно, потому что так делают. Это нормально — человек принимает решения на основе того, что видел. Просто горизонт видимости сократился лет до пяти.
          </p>
          <p class="text-base text-slate-500 mt-3 italic">
            «Рынок всё меньше вознаграждает за конкретную специальность. Всё больше — за скорость освоения следующей.»
          </p>
        </div>

        <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
          <p class="text-base font-semibold text-slate-400 uppercase tracking-[0.07em] mb-3">ИСТОЧНИКИ</p>
          <ul class="space-y-1.5 text-base text-slate-500">
            <li>— IFTF (Institute for the Future) «Future Work Skills 2030» (2023)</li>
            <li>— McKinsey «Jobs lost, jobs gained: Workforce transitions» (2023)</li>
            <li>— World Economic Forum «Future of Jobs Report 2025»</li>
            <li>— BLS (Bureau of Labor Statistics, США) — данные о смене работы за карьеру</li>
          </ul>
        </div>
      </div>

      <!-- ═══ SECTION 4: КАК РАЗВИВАТЬ ═══ -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как развивать метанавыки — конкретно, без теории
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          Метанавыки не передаются через лекции и объяснения. Они формируются только через повторяемые ситуации с конкретными требованиями. Вот форматы, которые работают:
        </p>
        <div class="space-y-3 mb-6">
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-lightning-charge text-orange-500 text-[17px]" aria-hidden="true"></i>
              <p class="text-base font-semibold text-slate-800">Проекты с дедлайном и публичной защитой</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Не «сдать домашнее задание», а представить работающий продукт аудитории. Хакатон формата «от идеи до питча за 10 часов» — максимально интенсивная тренировка декомпозиции, управления временем и умения объяснять.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-people text-orange-500 text-[17px]" aria-hidden="true"></i>
              <p class="text-base font-semibold text-slate-800">Командная работа с незнакомыми людьми</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">Работать с теми, кого знаешь — легко. Работать с незнакомыми, договариваться о ролях, не конфликтовать при разногласиях — это другая задача. Именно такую среду создаёт IT-лагерь: команды формируются по задаче, не по симпатиям.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-4 py-4">
            <div class="flex items-center gap-2 mb-2">
              <i class="bi bi-arrow-repeat text-orange-500 text-[17px]" aria-hidden="true"></i>
              <p class="text-base font-semibold text-slate-800">Регулярный контакт с незнакомыми инструментами</p>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">В АйДаКемп школьники каждые 2–3 дня встречают новый инструмент или библиотеку. После десяти таких встреч появляется рефлекс: «не знаю — значит разберусь». Этот рефлекс переносится за пределы IT.</p>
          </div>
        </div>
        <div class="rounded-[16px] bg-orange-50 border border-orange-100 px-5 py-4">
          <p class="text-base leading-[1.6] text-slate-700">
            <strong>Суть:</strong> 85% профессий не существует — это не повод паниковать. Это повод растить ребёнка, которому нормально не знать профессию заранее. Умение быстро разобраться в новом — лучший ответ на любую неопределённость.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Научите ребёнка учиться — любая профессия будет по плечу"
    bookingSubtitle="Оставьте телефон — свяжемся в удобное вам время, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
