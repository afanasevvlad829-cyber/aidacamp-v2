---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: 'Финляндия: почему дети учатся в лесу', url: '/stati/finlyandiya-deti-v-lesu/', description: 'Что говорит наука о детях на природе' },
  { title: 'Артек и советские лагеря: как это было', url: '/stati/artek-i-sovetskie-lagerya/', description: '40 миллионов детей в год — крупнейшая лагерная система в истории' },
  { title: 'IT-лагеря в странах без интернета', url: '/stati/it-lagerya-bez-interneta/', description: 'Что происходит, когда дети учатся без интернета' },
];
---

<Base
  title="Почему японские дети убирают свою школу: 500 лет практики | АйДаКемп"
  description="В 58% стран мира дети не убирают школу — это делают уборщики. В Японии дети моют полы, туалеты и окна уже 500 лет. Зачем — и что это реально даёт."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="yaponiya-deti-ubirayut-shkolu"
      title="Почему японские дети убирают свою школу: 500 лет практики"
      description="В 58% стран мира дети не убирают школу — это делают уборщики. В Японии дети моют полы, туалеты и окна уже 500 лет. Зачем — и что это реально даёт."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Почему японские дети убирают свою школу: 500 лет практики"
    subtitle="В 58% стран мира дети не убирают школу — это делают уборщики. В Японии дети моют полы, туалеты и окна уже 500 лет. Зачем — и что это реально даёт."
    breadcrumbsLast="Уборка в японских школах"
    readTime="7 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="500" label="лет японские дети убирают свою школу — традиция уходит в буддийские монастыри" tone="orange" size="lg" />
          <AnimatedStat value="15" label="минут ежедневно — столько времени отведено на «сoji» (уборку) после обеда" tone="blue" size="lg" />
          <AnimatedStat value="58" unit="%" label="стран мира, где ученики НЕ убираются: за них это делают профессиональные уборщики" tone="red" size="lg" />
          <AnimatedStat value="13" unit="%" label="учебного времени в японских школах занимают внеакадемические практики (OECD, 2015)" tone="green" size="lg" />
        </div>
      </div>

      <!-- Откуда это взялось -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Откуда это взялось
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Японские дети убирают свою школу — классы, коридоры, туалеты, столовую — уже несколько веков. Традиция уходит корнями в буддийские монастыри, где уборка была не бытовой обязанностью, а духовной практикой. Принцип: «Сначала уборка, потом медитация, потом изучение сутр».
        </p>
        <div class="rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <div class="flex items-start gap-3">
            <i class="bi bi-lightbulb-fill text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-700">
              В эпоху Эдо (1603–1868) в народных школах-теракоя уборка была формальной ежедневной обязанностью наравне с чтением и письмом. Менялись ученики, менялись роли — система называлась тобан (当番, дежурство). Это прямой предшественник современной школьной уборки.
            </p>
          </div>
        </div>
      </div>

      <!-- Как это работает сегодня -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как это работает сегодня
          </h2>
        </div>
        <figure class="my-4 rounded-[16px] overflow-hidden">
          <img src="/images/articles/story-japan-cleaning.jpg" alt="Японские школьники убирают классную комнату" width="1000" height="667" loading="lazy" class="w-full max-w-[680px] mx-auto block h-[260px] object-cover" />
          <figcaption class="text-[12px] text-slate-400 text-center mt-1.5">Фото: ajari, начальная школа Хэйва, Токио, CC BY 2.0</figcaption>
        </figure>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый день после обеда — 15–20 минут содзи (掃除, уборка). Весь класс делится на группы, каждая отвечает за свой участок: пол, парты, доска, мусорные вёдра, коридор. Роли ротируются еженедельно — никто не моет одно и то же больше недели подряд.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-door-open text-blue-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Классная комната</p>
            <p class="text-[12px] text-slate-500">Парты, пол, доска, окна</p>
          </div>
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-arrow-right text-green-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Коридор</p>
            <p class="text-[12px] text-slate-500">Пол, шкафчики, лестница</p>
          </div>
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-cup-hot text-yellow-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Столовая</p>
            <p class="text-[12px] text-slate-500">Столы, стулья, пол</p>
          </div>
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-droplet text-cyan-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Туалеты</p>
            <p class="text-[12px] text-slate-500">Раковины, полы, зеркала</p>
          </div>
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-tree text-emerald-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Двор</p>
            <p class="text-[12px] text-slate-500">Листья, мусор, дорожки</p>
          </div>
          <div class="rounded-[14px] bg-white border border-slate-200 p-4 text-center">
            <i class="bi bi-people text-purple-500 text-[20px] mb-1.5 inline-block" aria-hidden="true"></i>
            <p class="text-[13px] font-bold text-slate-900 mb-1">Библиотека</p>
            <p class="text-[12px] text-slate-500">Полки, столы, ковры</p>
          </div>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Никаких уборщиков в здании в это время нет. Дети делают всё сами — включая туалеты. Это принципиальная часть системы: никакой работы «только для некоторых».
        </p>
      </div>

      <!-- Тобан -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Тобан: когда каждый — дежурный
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Уборка — только часть системы тобан (当番). Каждый ученик ежедневно выполняет ту или иную роль в классе: проверяет явку, делает объявления, раздаёт материалы, вытирает доску. Роли ротируются, чтобы каждый побывал в каждой роли.
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-arrow-repeat text-blue-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Ротация создаёт равенство.</strong> Нет «грязной работы» для одних и «чистой» для других. Все убирают всё, по очереди.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-people-fill text-green-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Группа — ячейка ответственности.</strong> Уборка — не личная задача, а командная. Если твоя группа не справилась — это видно всем.</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-star-fill text-yellow-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Нет привилегий за успехи.</strong> Отличник убирает туалет так же, как двоечник. Академические заслуги не освобождают от общей жизни.</p>
          </div>
        </div>
      </div>

      <!-- Токкацу -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Токкацу: 13% учебного времени на «жизнь»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Уборка и тобан — часть большей системы под названием токкацу (特別活動, «особые виды деятельности»). По данным OECD, японские школьники тратят <strong>13% учебного времени</strong> на внеакадемические практики — это в три раза больше среднемирового показателя в 4%.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          В это время входит: уборка, обед, ежедневные собрания класса, школьный совет учеников, клубная деятельность. Всё управляется самими учениками — учитель наблюдает, но не руководит.
        </p>
        <div class="rounded-[16px] bg-slate-50 border border-slate-200 p-5">
          <div class="mb-4">
            <p class="text-[13px] font-semibold text-slate-700 mb-1.5">Япония</p>
            <div class="flex items-center gap-3">
              <div class="h-6 rounded-md bg-red-500" style="width: 65%"></div>
              <span class="text-[13px] font-bold text-slate-700 whitespace-nowrap">13%</span>
            </div>
          </div>
          <div>
            <p class="text-[13px] font-semibold text-slate-700 mb-1.5">Мировой средний</p>
            <div class="flex items-center gap-3">
              <div class="h-6 rounded-md bg-slate-400" style="width: 20%"></div>
              <span class="text-[13px] font-bold text-slate-700 whitespace-nowrap">4%</span>
            </div>
          </div>
          <p class="text-[13px] text-slate-400 mt-3">Доля учебного времени на внеакадемические практики (OECD, 2015)</p>
        </div>
      </div>

      <!-- Школьные лагеря -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Школьные лагеря: уборка берёт отпуск в природе
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Раз или дважды за школьную жизнь японские дети ездят в <strong>рин:кан гакко</strong> (林間学校, «школа в лесу») — многодневный лагерь в горах или лесу. Всё то, что в школе делают по учебной программе, в лагере становится реальной необходимостью.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-moon-stars-fill text-indigo-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-900 mb-1">Общее проживание</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Дети живут в спальнях на 6–8 человек, без родителей. Все бытовые задачи — на них.</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-fire text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-900 mb-1">Готовят сами</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">В большинстве программ дети разводят костёр и готовят еду в группах. Не как квест — как реальная задача дня.</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-tree text-green-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-900 mb-1">Природа как учебник</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Наблюдение за животными, ориентирование, ночные походы — часть программы «шizen таiken» (природного опыта).</p>
            </div>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-200 p-4 flex gap-3 items-start">
            <i class="bi bi-people-fill text-blue-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <div>
              <p class="text-[14px] font-bold text-slate-900 mb-1">Хан: маленькая группа</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Каждые 5–6 детей — это хан (班), отвечающий за свой угол лагеря. Маленькая команда внутри большой.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Распространение в мире -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Распространяется ли это в мире
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В 2016 году Сингапур законодательно ввёл ежедневную уборку в школах, явно указав в документах на японский и тайваньский опыт как на образец. По данным одного исследования (105 стран), только 34,3% из них практикуют уборку силами учеников. 58% нанимают профессионалов.
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-circle-fill text-green-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>34%</strong> стран — ученики убирают сами</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-x-circle-fill text-red-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>58%</strong> стран — профессиональные уборщики</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-arrow-right-circle-fill text-blue-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-600">Перу, Египет — внедрили в рамках SDG-4; задокументирован рост автономии и лидерства</p>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-6 text-center">
          <i class="bi bi-stars text-amber-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Убирая туалет, ты не становишься уборщиком. Ты понимаешь, что уборщик — не кто-то другой. Это то самое, чего сложнее всего добиться в классе, но что происходит само собой в лагере: жизнь вместе — это и есть образование.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
