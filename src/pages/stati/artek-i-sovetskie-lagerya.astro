---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import AnimatedStat from '../../components/AnimatedStat.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "История детского лагеря: от 1861 до наших дней", url: "/stati/istoriya-detskogo-lagerya/", icon: "clock-history", description: "165 лет истории — от первого летнего лагеря до наших дней" },
  { title: "Самые дорогие лагеря в мире", url: "/stati/samye-dorogie-lagerya-v-mire/", icon: "gem", description: "От пары тысяч долларов в неделю до частных островов" },
  { title: "Лагерь в необычных местах планеты", url: "/stati/lagerya-v-neobychnykh-mestakh/", icon: "globe2", description: "Куда ещё возят детей — от пустыни до тайги" },
];
---

<Base
  title="Артек и советские лагеря: как это было на самом деле | АйДаКемп"
  description="40 000 лагерей, 40 миллионов детей в год — советская лагерная система была крупнейшей в истории человечества. Что из этого выжило и зачем это знать."
>
  <Fragment slot="head">
    <ArticleSchema
      slug="artek-i-sovetskie-lagerya"
      title="Артек и советские лагеря: как это было на самом деле"
      description="40 000 лагерей, 40 миллионов детей в год — советская лагерная система была крупнейшей в истории человечества. Что из этого выжило и зачем это знать."
      datePublished="2026-06-29"
    />
  </Fragment>
  <Header />

  <ArticleHero
    title="Артек и советские лагеря: как это было на самом деле"
    subtitle="40 000 лагерей, 40 миллионов детей в год — советская лагерная система была крупнейшей в истории человечества. Что из этого выжило и зачем это знать."
    breadcrumbsLast="Артек и советские лагеря"
    readTime="8 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <!-- Верхняя сводка цифр -->
      <div class="mb-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <AnimatedStat value="40 000" label="лагерей работало в СССР на пике в 1970-е" tone="orange" size="lg" />
          <AnimatedStat value="40" unit=" млн" label="детей отдыхало в советских лагерях каждое лето" tone="blue" size="lg" />
          <AnimatedStat value="135" label="гектаров — территория Артека (больше 180 футбольных полей)" tone="green" size="lg" />
          <AnimatedStat value="27 000" label="детей прошли через Артек за советскую историю из 130+ стран" tone="purple" size="lg" />
        </div>
      </div>

      <!-- Самый большой лагерь -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Самый большой лагерь, который когда-либо существовал
          </h2>
        </div>
        <figure class="mb-4 rounded-[16px] overflow-hidden">
          <img src="/images/articles/story-soviet-pioneer-camp.jpg" alt="Дети отдыхают в пионерском лагере, архивное фото 1979 года" width="1000" height="667" loading="lazy" class="w-full h-[240px] object-cover" />
          <figcaption class="text-[11px] text-slate-400 mt-1">Фото: Яков Берлинер / РИА Новости, 1979, CC BY-SA 3.0</figcaption>
        </figure>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда говорят «советский лагерь», большинство людей представляют деревянные корпуса с панцирными кроватями и линейкой по утрам. Реальность была значительно интереснее — и масштабнее.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          На пике в конце 1970-х в СССР работало <strong>около 40 000 детских оздоровительных лагерей</strong>. Каждое лето через них проходило от 35 до 40 миллионов школьников — больше половины всех детей страны. Ни одна страна в истории не организовывала детский отдых в таком масштабе.
        </p>
        <div class="rounded-[16px] bg-orange-50 border-l-4 border-orange-400 px-6 py-5">
          <div class="flex items-start gap-3">
            <i class="bi bi-lightbulb-fill text-orange-500 text-[20px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-[15px] leading-[1.6] text-slate-700">
              Для сравнения: сегодня в России работает около <strong>45 000 организаций отдыха и оздоровления детей</strong> всех форм — включая городские лагеря и санатории. Но охват несравнимо меньше: около 6 миллионов детей в год.
            </p>
          </div>
        </div>
      </div>

      <!-- Артек: история места -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Артек: история места
          </h2>
        </div>
        <figure class="mb-4 rounded-[16px] overflow-hidden">
          <img src="/images/articles/story-artek-coast.jpg" alt="Территория лагеря Артек, Гурзуф, Крым" width="1000" height="667" loading="lazy" class="w-full h-[240px] object-cover" />
          <figcaption class="text-[11px] text-slate-400 mt-1">Фото: Vyacheslav Argenberg / Wikimedia Commons, CC BY 4.0</figcaption>
        </figure>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Артек открылся в 1925 году как туберкулёзный санаторий для рабочих детей Крыма. Первая смена — 80 человек, четыре брезентовые палатки на берегу моря у посёлка Артек (сейчас это Гурзуф). Никакой идеологии, только лечебный воздух и солнце.
        </p>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1925</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Первая смена.</strong> 80 детей, палатки, берег моря. Основатель — Зиновий Соловьёв, заместитель наркома здравоохранения. Цель: оздоровление, не идеология.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1927</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Первые иностранные гости.</strong> Немецкие дети рабочих приехали в Артек — начало международной традиции. Потом будут турецкие, китайские, кубинские...</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1941</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Война.</strong> 22 июня 1941 в Артеке шла смена. Детей эвакуировали в Сталинград, потом в Алтайский край. Артек работал в эвакуации всю войну.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1957</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Самунга Маконнен из Эфиопии</strong> стала первым африканским ребёнком в Артеке. После этого лагерь принял детей из 130+ стран — от Кубы до Вьетнама, от Монголии до ГДР.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1961</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Юрий Гагарин в Артеке.</strong> Через несколько недель после полёта в космос. Фотография Гагарина с артековцами стала одной из самых растиражированных в советской прессе.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1969</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>Пик масштаба.</strong> Артек принимает 5 000 детей одновременно в 9 лагерях на единой территории. Это маленький город со своими школой, театром, стадионами, кино.</p>
          </div>
          <div class="flex gap-3 items-start">
            <span class="shrink-0 flex items-center justify-center h-8 min-w-[56px] px-1 rounded-full bg-orange-100 text-orange-700 text-[12.5px] font-bold mt-0.5">1991</span>
            <p class="text-[15px] leading-[1.6] text-slate-600"><strong>СССР нет, Артек есть.</strong> После распада — несколько лет упадка, потом украинский, потом снова российский. Сегодня работает, принимает до 40 000 детей в год.</p>
          </div>
        </div>
      </div>

      <!-- Кто попадал в Артек -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто попадал в Артек — и как
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Попасть в Артек было непросто. Путёвки распределялись через предприятия, обкомы партии, школы — за отличную учёбу, спортивные победы, пионерские достижения. Это был реальный конкурс.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 overflow-hidden">
            <img src="/images/articles/story-gagarin-artek.jpg" alt="Ю. А. Гагарин в Артеке с пионерами" width="1000" height="667" loading="lazy" class="w-full h-[140px] object-cover" />
            <div class="p-5">
              <i class="bi bi-star-fill text-amber-500 text-[18px] mb-2 inline-block" aria-hidden="true"></i>
              <p class="text-[15px] font-bold text-slate-900 mb-1">Юрий Гагарин</p>
              <p class="text-[13px] leading-[1.5] text-slate-600">Приехал в 1961 году сразу после полёта в космос. Говорил детям: «Учитесь хорошо, и вы тоже полетите». На фото — визит на Всесоюзный слёт пионеров 1962 года: Гагарин бывал в Артеке не раз.</p>
              <p class="text-[11px] text-slate-400 mt-2">Фото: М. Д. Гусев, 1962, CC BY-SA 4.0</p>
            </div>
          </div>
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-5">
            <i class="bi bi-star-fill text-amber-500 text-[18px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[15px] font-bold text-slate-900 mb-1">Хо Ши Мин</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Лидер Вьетнама посетил Артек в 1959 году — дипломатия через детей была частью советской мягкой силы.</p>
          </div>
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-5">
            <i class="bi bi-star-fill text-amber-500 text-[18px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[15px] font-bold text-slate-900 mb-1">Индира Ганди</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">Будущий премьер-министр Индии побывала в Артеке ребёнком — одна из немногих иностранных девочек тех лет.</p>
          </div>
          <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-5">
            <i class="bi bi-star-fill text-amber-500 text-[18px] mb-2 inline-block" aria-hidden="true"></i>
            <p class="text-[15px] font-bold text-slate-900 mb-1">Самоа Маконнен</p>
            <p class="text-[13px] leading-[1.5] text-slate-600">1957 год, первый ребёнок из Африки. Открыла эпоху «лагерной дипломатии» — когда дружба между странами начинается с детей.</p>
          </div>
        </div>
      </div>

      <!-- Другие советские «большие лагеря» -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Другие советские «большие лагеря»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Артек был самым известным, но не единственным лагерем-городом.
        </p>
        <div class="overflow-x-auto mb-2">
          <table class="w-full text-base border-collapse">
            <thead>
              <tr class="bg-slate-100">
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tl-xl">Лагерь</th>
                <th class="text-left p-3 font-semibold text-slate-700">Где</th>
                <th class="text-left p-3 font-semibold text-slate-700">Специализация</th>
                <th class="text-left p-3 font-semibold text-slate-700 rounded-tr-xl">Одновременно</th>
              </tr>
            </thead>
            <tbody>
              {[
                ["Артек", "Крым, берег моря", "Лучшие ученики, международный", "5 000"],
                ["Орлёнок", "Краснодарский край", "Творчество, искусство", "3 500"],
                ["Океан", "Приморский край", "Дети Дальнего Востока", "2 000"],
                ["Молодая гвардия", "Одесса", "Пионерский актив Украины", "2 500"],
              ].map(([name, where, spec, count]) => (
                <tr class="border-b border-slate-100">
                  <td class="p-3 text-slate-800 font-medium">{name}</td>
                  <td class="p-3 text-slate-600">{where}</td>
                  <td class="p-3 text-slate-600">{spec}</td>
                  <td class="p-3 text-orange-600 font-semibold">{count}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Что выжило -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что выжило — и что изменилось
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Советская система была огромной, но однородной. Один тип программы, одна идеология, одна форма. Современные лагеря — противоположность: их меньше в разы, но они разнообразнее.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-[16px] bg-red-50 border border-red-200 p-5">
            <p class="text-[15px] font-bold text-red-700 mb-3">Советский лагерь</p>
            <div class="space-y-2.5">
              <div class="flex gap-2.5 items-start"><i class="bi bi-gift-fill text-red-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Бесплатно (профсоюз, предприятие)</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-people text-red-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Один тип для всех</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-megaphone-fill text-red-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Идеологическая составляющая</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-calendar2-check text-red-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Жёсткий распорядок</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-door-open text-red-400 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Доступен почти каждому ребёнку</p></div>
            </div>
          </div>
          <div class="rounded-[16px] bg-green-50 border border-green-200 p-5">
            <p class="text-[15px] font-bold text-green-700 mb-3">Современный лагерь</p>
            <div class="space-y-2.5">
              <div class="flex gap-2.5 items-start"><i class="bi bi-credit-card text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Платно (налоговый вычет 13%)</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-laptop text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Специализации: IT, спорт, языки</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-check-circle text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Без идеологии, фокус на навыках</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-sliders text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Баланс свободы и структуры</p></div>
              <div class="flex gap-2.5 items-start"><i class="bi bi-exclamation-triangle text-green-500 text-[16px] shrink-0 mt-0.5" aria-hidden="true"></i><p class="text-[13px] leading-[1.5] text-slate-600">Доступен не всем — проблема</p></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Закрытие -->
      <div class="mb-8 pt-2">
        <div class="rounded-[16px] bg-amber-50 border border-amber-200 p-6 text-center">
          <i class="bi bi-hourglass-split text-amber-500 text-[28px] mb-3 inline-block" aria-hidden="true"></i>
          <p class="text-[16px] leading-[1.7] text-slate-700">
            Советская система доказала одно: когда государство хочет, лагерный опыт может быть доступен каждому ребёнку. Современные лагеря доказывают другое: когда программа сфокусирована, три недели меняют детей сильнее, чем целый учебный год. Лучший вариант — где-то между.
          </p>
        </div>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta />
  <RelatedPages title="Читайте также" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
