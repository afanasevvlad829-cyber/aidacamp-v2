const allArticles = clusters.flatMap(c => c.articles);
const totalCount = allArticles.length;

// Category filter mapping: returns filter key based on article URL slug
function getArticleCategory(url: string): string {
  const slug = url.replace(/^\/stati\//, '').replace(/\/$/, '');

  // Зависимость — gadget/phone addiction
  if (/zavisimost|telefon|kompyuter|igr|ekrannoe|gadget/.test(slug)) return 'zavisimost';

  // Финансы — tax returns, costs
  if (/nalog|ceny|vychet|finansov/.test(slug)) return 'finansy';

  // IT и образование — programming, AI, tech
  if (/\bit\b|python|nejroseti|programmirovan|scratch|roblox|3d|game-dev|meta-skills|future-skills|ai-economy|ai-studio|hakaton|navyki|vnutrennyaya|ii-zamenit|programmirovanie|detskiy-lager-bez-telefonov/.test(slug)) return 'it';

  // Выбор лагеря — choosing camps
  if (/kak-vybrat|mify|reiting|otzyvy/.test(slug)) return 'vybor';

  // Жизнь в лагере — daily life, health, safety
  if (/pitanie|zabolel|vzyat|pervyj-raz|bezopasnost|obshhenie|obshchenie|socializaciya|spravki|strakhovka|dokumenty|kak-dobratsya|kuda-det|letom|lager-podolsk|lager-naro|lager-novaya|rebenok-ne-hochet|podrostok|nizkaya|problemy|nichego-ne-hochet/.test(slug)) return 'lager';

  return 'lager'; // fallback
}
---

<Base
  title="Статьи для родителей о детях, лагере и IT — АйДаКемп"
  description={`Честные статьи о подростках, гаджетах, выборе лагеря и IT-образовании. Без нотаций — от мамы к маме. ${totalCount} материалов от команды АйДаКемп.`}
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи для родителей", "item": "https://aidacamp.ru/stati" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Статьи для родителей — АйДаКемп",
      "description": "Честные статьи о подростках, гаджетах, выборе лагеря и IT-образовании.",
      "url": "https://aidacamp.ru/stati",
      "hasPart": allArticles.map(a => ({
        "@type": "Article",
        "name": a.title,
        "url": `https://aidacamp.ru${a.url}`,
        "description": a.description,
      })),
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" }
    })} />
  </Fragment>

  <Header />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#0d1a2b]" style="background-image: radial-gradient(ellipse 110% 150% at -20% 65%, rgba(249,115,22,0.45) 0%, rgba(234,88,12,0.18) 38%, transparent 62%), radial-gradient(ellipse 60% 70% at 8% 100%, rgba(249,115,22,0.28) 0%, transparent 52%), radial-gradient(ellipse 55% 90% at 112% 15%, rgba(124,58,237,0.14) 0%, transparent 58%), repeating-linear-gradient(135deg, transparent 0px, transparent 37px, rgba(255,255,255,0.018) 37px, rgba(255,255,255,0.018) 39px), radial-gradient(circle, rgba(255,255,255,0.038) 1px, transparent 1px); background-size: auto, auto, auto, auto, 26px 26px;">
    <div class="relative z-10 mx-auto max-w-[1120px] px-5 pt-10 pb-11 md:pt-14 md:pb-14">
      <nav class="mb-4 text-[13px] text-white/55" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-white/80 transition-colors">Главная</a>
        <span class="mx-1.5 text-white/25">›</span>
        <span class="text-white/75 font-medium">Статьи</span>
      </nav>
      <h1 class="text-[30px] md:text-[46px] font-bold leading-[1.07] tracking-[-0.03em] text-white max-w-[640px]">
        Статьи для родителей
      </h1>
      <p class="mt-3 text-[16px] md:text-[17px] text-white/70 max-w-[560px] leading-[1.6]">
        Честно о подростках, гаджетах и летнем отдыхе — без педагогических терминов и нотаций. {totalCount} материалов.
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-[1120px] px-4 py-8 pb-20">

    <!-- Фильтры по категориям -->
    <div class="mb-10">
      <div id="category-filters" class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none;">
        <button data-filter="all"     class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] font-semibold bg-primary text-[#0d1a2b] transition-colors">Все</button>
        <button data-filter="zavisimost" class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">Зависимость</button>
        <button data-filter="vybor"   class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">Выбор лагеря</button>
        <button data-filter="it"      class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">IT и образование</button>
        <button data-filter="finansy" class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">Финансы</button>
        <button data-filter="lager"   class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-[13px] bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">Жизнь в лагере</button>
      </div>
    </div>

    <!-- Кластеры -->
    {clusters.map(cluster => (
      <section id={cluster.id} data-cluster class="mb-14 scroll-mt-6">
        <div class="flex items-center gap-3 mb-6">
          <div class={`w-1 h-6 rounded-full shrink-0
            ${cluster.color === 'emerald' ? 'bg-emerald-500' :
              cluster.color === 'orange' ? 'bg-primary' :
              cluster.color === 'red' ? 'bg-red-500' :
              cluster.color === 'sky' ? 'bg-sky-500' : 'bg-purple-500'}`}
          ></div>
          <h2 class="text-[20px] md:text-[22px] font-bold text-slate-900 tracking-[-0.01em]">
            {cluster.label}
          </h2>
          <span class="text-[13px] text-slate-400 font-normal">{cluster.articles.length} статьи</span>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cluster.articles.map(article => (
            <a
              href={article.url}
              data-category={getArticleCategory(article.url)}
              class="article-card group flex flex-col rounded-[22px] border border-border bg-card p-5 card-shadow card-shadow-hover hover:border-slate-300 transition-all duration-200"
            >
              <div class="flex items-start justify-between gap-2 mb-3">
                <span class={`inline-block rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${article.tagColor}`}>
                  {article.tag}
                </span>
                {article.readTime && (
                  <span class="text-[11px] text-slate-400 shrink-0 mt-0.5">{article.readTime}</span>
                )}
              </div>
              <h3 class="text-[15px] font-semibold leading-[1.4] text-slate-900 group-hover:text-primary transition-colors mb-2 flex-1">
                {article.title}
              </h3>
              <p class="text-[13px] leading-[1.55] text-slate-500 mb-4">
                {article.description}
              </p>
              <div class="flex items-center justify-between mt-auto">
                <span class="text-[12px] text-slate-400">
                  <i class="bi bi-person text-[11px]" aria-hidden="true"></i> Дарья Афанасьева
                </span>
                <span class="flex items-center gap-1 text-[13px] font-medium text-primary">
                  Читать
                  <i class="bi bi-arrow-right text-[12px] group-hover:translate-x-0.5 transition-transform" aria-hidden="true"></i>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- CTA -->
    <div class="rounded-[24px] bg-[#0d1a2b] px-6 py-8 text-center md:px-12 md:py-10">
      <p class="text-[13px] font-semibold uppercase tracking-wider text-white/50 mb-2">Детский IT-лагерь</p>
      <h2 class="text-[22px] font-bold text-white md:text-[26px]">АйДаКемп — где статьи становятся практикой</h2>
      <p class="mt-2 text-[15px] text-white/70 max-w-[500px] mx-auto leading-[1.6]">
        Лагерь, где ребята программируют, общаются и возвращаются с проектом. 66 км от МКАД.
      </p>
      <a href="/ceny" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-[15px] font-semibold text-white hover:bg-primary-hover transition-colors">
        Смотреть смены и цены 2026
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

  </main>

  <Footer />

  <script>
    (function () {
      const buttons = document.querySelectorAll<HTMLButtonElement>('#category-filters .filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.article-card');
      const clusters = document.querySelectorAll<HTMLElement>('[data-cluster]');

      const ACTIVE = ['bg-primary', 'text-[#0d1a2b]', 'font-semibold'];
      const INACTIVE = ['bg-slate-100', 'text-slate-600', 'hover:bg-slate-200'];

      function setActive(btn: HTMLButtonElement) {
        buttons.forEach(b => {
          ACTIVE.forEach(c => b.classList.remove(c));
          INACTIVE.forEach(c => b.classList.add(c));
        });
        INACTIVE.forEach(c => btn.classList.remove(c));
        ACTIVE.forEach(c => btn.classList.add(c));
      }

      function filter(value: string) {
        cards.forEach(card => {
          if (value === 'all' || card.dataset.category === value) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide cluster section when all its cards are hidden
        clusters.forEach(section => {
          const visible = section.querySelectorAll('.article-card:not(.hidden)');
          if (visible.length === 0) {
            section.classList.add('hidden');
          } else {
            section.classList.remove('hidden');
          }
        });
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.filter ?? 'all';
          setActive(btn);
          filter(value);
        });
      });
    })();
  </script>
</Base>
