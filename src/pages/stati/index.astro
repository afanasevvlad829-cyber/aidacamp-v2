---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import CLUSTERS from '../../data/articleClusters.json';
import { getViews, VIEWS_THRESHOLD } from '../../data/articleViews';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const articleEntries = await getCollection('articles');
const ARTICLES = articleEntries
  .map(e => ({ slug: e.id, ...e.data }))
  .sort((a, b) => (b.date || '').localeCompare(a.date || '') || a.slug.localeCompare(b.slug));
const ARTICLE_COUNT = ARTICLES.length;

// Просмотры (снимок Метрики; на проде уточняются живым счётчиком через /api/article-views)
const withViews = ARTICLES.map(a => ({ ...a, views: getViews(a.slug) }));

// Популярное — топ-4 по просмотрам, выносим наверх большими блоками
const popular = [...withViews].sort((a, b) => b.views - a.views).slice(0, 4);
const popularSlugs = new Set(popular.map(a => a.slug));

function plural(n: number, one: string, few: string, many: string): string {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
  return many;
}
function viewsLabel(n: number): string {
  return `${n.toLocaleString('ru-RU')} ${plural(n, 'просмотр', 'просмотра', 'просмотров')}`;
}

const clusterColorBar: Record<string, string> = {
  emerald: 'bg-emerald-500',
  orange: 'bg-primary',
  red: 'bg-red-500',
  purple: 'bg-purple-500',
  amber: 'bg-amber-500',
  sky: 'bg-sky-500',
};
---

<Base
  title="Статьи для родителей о детях, лагере и IT — АйДаКемп"
  description={`Честные статьи о подростках, гаджетах, выборе лагеря и IT-образовании. Без нотаций — от мамы к маме. ${ARTICLE_COUNT} материалов от команды АйДаКемп.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи для родителей", "item": "https://aidacamp.ru/stati" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Статьи для родителей — АйДаКемп",
      "description": "Честные статьи о подростках, гаджетах, выборе лагеря и IT-образовании.",
      "url": "https://aidacamp.ru/stati",
      "hasPart": ARTICLES.map(a => ({
        "@type": "Article",
        "name": a.title,
        "url": `https://aidacamp.ru${a.url}`,
        "description": a.description,
      })),
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" }
    })} />
  </Fragment>

  <Header />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#0d1a2b]" style="background-image: radial-gradient(ellipse 110% 150% at -20% 65%, rgba(249,115,22,0.45) 0%, rgba(234,88,12,0.18) 38%, transparent 62%), radial-gradient(ellipse 60% 70% at 8% 100%, rgba(249,115,22,0.28) 0%, transparent 52%), radial-gradient(ellipse 55% 90% at 112% 15%, rgba(124,58,237,0.14) 0%, transparent 58%), repeating-linear-gradient(135deg, transparent 0px, transparent 37px, rgba(255,255,255,0.018) 37px, rgba(255,255,255,0.018) 39px), radial-gradient(circle, rgba(255,255,255,0.038) 1px, transparent 1px); background-size: auto, auto, auto, auto, 26px 26px;">
    <div class="relative z-10 mx-auto max-w-[1120px] px-5 pt-10 pb-11 md:pt-14 md:pb-14">
      <nav class="mb-4 text-base text-white/55" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-white/80 transition-colors">Главная</a>
        <span class="mx-1.5 text-white/25">›</span>
        <span class="text-white/75 font-medium">Статьи</span>
      </nav>
      <h1 class="text-[30px] md:text-[46px] font-bold leading-[1.07] tracking-[-0.03em] text-white max-w-[640px]">
        Статьи для родителей
      </h1>
      <p class="mt-3 text-[16px] md:text-[17px] text-white/70 max-w-[560px] leading-[1.6]">
        Честно о подростках, гаджетах и летнем отдыхе — без педагогических терминов и нотаций. {ARTICLE_COUNT} материалов.
      </p>

      <!-- Поиск -->
      <div class="mt-6 max-w-[520px]">
        <div class="flex items-center gap-2.5 rounded-full bg-white/10 ring-1 ring-white/15 px-4 py-2.5 focus-within:ring-white/40 transition">
          <i class="bi bi-search text-white/50 text-base" aria-hidden="true"></i>
          <input
            id="article-search"
            type="search"
            placeholder="Поиск по статьям — «телефон», «первый раз», «Python»…"
            autocomplete="off"
            aria-label="Поиск по статьям"
            class="flex-1 min-w-0 bg-transparent border-0 outline-none text-white placeholder:text-white/45 text-base"
          />
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-[1120px] px-4 py-8 pb-20">

    <!-- ПОПУЛЯРНОЕ — большие блоки -->
    {popular.length > 0 && popular[0].views > 0 && (
      <section id="popular-section" class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <i class="bi bi-fire text-primary text-[22px]" aria-hidden="true"></i>
          <h2 class="text-[20px] md:text-[22px] font-bold text-slate-900 tracking-[-0.01em]">Популярное</h2>
          <span class="text-base text-slate-400 font-normal">Читают чаще всего</span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {popular.map((article, i) => (
            <a
              href={article.url}
              data-slug={article.slug}
              class="group relative flex flex-col justify-end overflow-hidden rounded-[24px] border border-border bg-card p-6 md:p-7 card-shadow card-shadow-hover hover:border-slate-300 transition-all min-h-[190px]"
            >
              <div class="absolute top-5 right-5 flex items-center gap-1.5 rounded-full bg-[#0d1a2b] px-3 py-1 text-base font-semibold text-white">
                <i class="bi bi-eye-fill text-base" aria-hidden="true"></i>
                <span data-view-num>{article.views.toLocaleString('ru-RU')}</span>
              </div>
              <span class={`mb-3 inline-block w-fit rounded-full px-2.5 py-0.5 text-base font-semibold ${article.tagColor}`}>
                {i === 0 ? '🔥 ' : ''}{article.tag}
              </span>
              <h3 class="text-[18px] md:text-[20px] font-bold leading-[1.3] text-slate-900 group-hover:text-primary transition-colors mb-2">
                {article.title}
              </h3>
              <p class="text-base leading-[1.5] text-slate-500 mb-3 line-clamp-2">{article.description}</p>
              <span class="inline-flex items-center gap-1.5 text-base text-slate-400">
                <i class="bi bi-eye text-base" aria-hidden="true"></i>
                <span data-view-full>{viewsLabel(article.views)}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Фильтры по рубрикам -->
    <div class="mb-8">
      <div id="category-filters" class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none;">
        <button data-filter="all" class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-base font-semibold bg-primary text-[#0d1a2b] transition-colors">
          Все {ARTICLE_COUNT}
        </button>
        {CLUSTERS.map(c => (
          <button data-filter={c.id} class="filter-btn shrink-0 rounded-full px-4 py-1.5 text-base bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">
            {c.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Пусто (поиск) -->
    <p id="no-results" class="hidden py-12 text-center text-base text-slate-400">
      Ничего не нашлось. Попробуйте другой запрос.
    </p>

    <!-- Кластеры -->
    {CLUSTERS.map(cluster => {
      const items = withViews.filter(a => a.cluster === cluster.id && !popularSlugs.has(a.slug));
      if (items.length === 0) return null;
      return (
        <section id={cluster.id} data-cluster={cluster.id} class="mb-14 scroll-mt-6">
          <div class="flex items-center gap-3 mb-6">
            <div class={`w-1 h-6 rounded-full shrink-0 ${clusterColorBar[cluster.color] ?? 'bg-slate-400'}`}></div>
            <h2 class="text-[20px] md:text-[22px] font-bold text-slate-900 tracking-[-0.01em]">{cluster.label}</h2>
            <span data-cluster-count class="text-base text-slate-400 font-normal">{items.length}</span>
          </div>

          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {items.map(article => (
              <a
                href={article.url}
                data-slug={article.slug}
                data-category={article.cluster}
                data-search={`${article.title} ${article.description} ${article.tag}`.toLowerCase()}
                class="article-card group flex flex-col rounded-[22px] border border-border bg-card p-5 card-shadow card-shadow-hover hover:border-slate-300 transition-all duration-200"
              >
                <div class="flex items-start justify-between gap-2 mb-3">
                  <span class={`inline-block rounded-full px-2.5 py-0.5 text-base font-semibold ${article.tagColor}`}>{article.tag}</span>
                </div>
                <h3 class="text-base font-semibold leading-[1.4] text-slate-900 group-hover:text-primary transition-colors mb-2 flex-1">
                  {article.title}
                </h3>
                <p class="text-base leading-[1.55] text-slate-500 mb-4">{article.description}</p>
                <div class="flex items-center justify-between mt-auto">
                  <span class="inline-flex items-center gap-1 text-base text-slate-400">
                    {article.views >= VIEWS_THRESHOLD
                      ? (<><i class="bi bi-eye text-base" aria-hidden="true"></i> <span data-view-full>{viewsLabel(article.views)}</span></>)
                      : article.readTime
                        ? (<><i class="bi bi-clock text-base" aria-hidden="true"></i> {article.readTime}</>)
                        : (<><i class="bi bi-person text-base" aria-hidden="true"></i> Дарья Афанасьева</>)
                    }
                  </span>
                  <span class="flex items-center gap-1 text-base font-medium text-primary">
                    Читать
                    <i class="bi bi-arrow-right text-base group-hover:translate-x-0.5 transition-transform" aria-hidden="true"></i>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <!-- CTA -->
    <div class="rounded-[24px] bg-[#0d1a2b] px-6 py-8 text-center md:px-12 md:py-10">
      <p class="text-base font-semibold uppercase tracking-wider text-white/50 mb-2">Детский IT-лагерь</p>
      <h2 class="text-[22px] font-bold text-white md:text-[26px]">АйДаКемп — где статьи становятся практикой</h2>
      <p class="mt-2 text-base text-white/70 max-w-[500px] mx-auto leading-[1.6]">
        Лагерь, где ребята программируют, общаются и возвращаются с проектом. 66 км от МКАД.
      </p>
      <a href="/ceny/" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-hover transition-colors">
        Смотреть смены и цены {SEASON_YEAR}
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

  </main>

  <RelatedArticlesAuto />
  <Footer />

  <script>
    (function () {
      const buttons = document.querySelectorAll<HTMLButtonElement>('#category-filters .filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.article-card');
      const clusters = document.querySelectorAll<HTMLElement>('[data-cluster]');
      const popular = document.getElementById('popular-section');
      const noResults = document.getElementById('no-results');
      const search = document.getElementById('article-search') as HTMLInputElement | null;

      const ACTIVE = ['bg-primary', 'text-[#0d1a2b]', 'font-semibold'];
      const INACTIVE = ['bg-slate-100', 'text-slate-600', 'hover:bg-slate-200'];

      let category = 'all';
      let query = '';

      function setActive(btn: HTMLButtonElement) {
        buttons.forEach(b => {
          ACTIVE.forEach(c => b.classList.remove(c));
          INACTIVE.forEach(c => b.classList.add(c));
        });
        INACTIVE.forEach(c => btn.classList.remove(c));
        ACTIVE.forEach(c => btn.classList.add(c));
      }

      function apply() {
        let visible = 0;
        cards.forEach(card => {
          const okCat = category === 'all' || card.dataset.category === category;
          const okText = !query || (card.dataset.search ?? '').includes(query);
          const show = okCat && okText;
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });

        clusters.forEach(section => {
          const shown = section.querySelectorAll('.article-card:not(.hidden)').length;
          section.classList.toggle('hidden', shown === 0);
          const counter = section.querySelector('[data-cluster-count]');
          if (counter) counter.textContent = String(shown);
        });

        if (popular) popular.classList.toggle('hidden', category !== 'all' || query.length > 0);
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          category = btn.dataset.filter ?? 'all';
          setActive(btn);
          apply();
        });
      });

      if (search) {
        search.addEventListener('input', () => {
          query = search.value.trim().toLowerCase();
          apply();
        });
      }

      // Живой счётчик: обновляем числа из БД (Стадия 2). Тихо игнорируем, если эндпоинта ещё нет.
      const fmt = (n: number) => n.toLocaleString('ru-RU');
      const pl = (n: number, a: string, b: string, c: string) => {
        const m10 = n % 10, m100 = n % 100;
        if (m10 === 1 && m100 !== 11) return a;
        if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return b;
        return c;
      };
      const viewsLabel = (n: number) => `${fmt(n)} ${pl(n, 'просмотр', 'просмотра', 'просмотров')}`;
      fetch('/api/article-views')
        .then(r => (r.ok ? r.json() : null))
        .then((data: Record<string, number> | null) => {
          if (!data) return;
          document.querySelectorAll<HTMLElement>('a[data-slug]').forEach(card => {
            const live = data[card.dataset.slug!];
            if (typeof live !== 'number') return;
            const num = card.querySelector<HTMLElement>('[data-view-num]');
            if (num) num.textContent = fmt(live);
            const full = card.querySelector<HTMLElement>('[data-view-full]');
            if (full) full.textContent = viewsLabel(live);
          });
        })
        .catch(() => {});
    })();
  </script>
</Base>
