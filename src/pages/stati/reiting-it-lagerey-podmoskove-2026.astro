---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Детский лагерь", url: "/detskiy-lager/", icon: "house-door", description: "Всё о формате АйДаКемп" },
  { title: "Как выбрать детский лагерь", url: "/stati/kak-vybrat-detskiy-lager/", icon: "search", description: "7 критериев от мамы к маме" },
  { title: "Отзывы о детских лагерях", url: "/stati/otzyvy-o-detskih-lageryah/", icon: "star-fill", description: "Как читать и проверять отзывы" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Кто мы и как устроен день" },
];

const faqItems = [
  {
    question: "Как проверить квалификацию педагогов до покупки путёвки?",
    answer: "Попросите лагерь рассказать о педагогах: образование, опыт работы в IT, примеры проектов выпускников. Хороший лагерь покажет реальные кейсы без уклончивых ответов. Если педагоги — студенты без опыта в индустрии, это стоит учитывать при выборе."
  },
  {
    question: "Как отличить настоящие отзывы от фейковых?",
    answer: "Смотрите отзывы на Яндекс.Картах и 2ГИС — они сложнее накрутить. Обращайте внимание на конкретность: «сын научился делать Telegram-бота» лучше, чем «всё понравилось». Проверьте, отвечает ли лагерь на отрицательные отзывы и как именно. Можно попросить у лагеря контакты родителей прошлых смен — нормальный лагерь не откажет."
  },
  {
    question: "На что смотреть в программе при сравнении лагерей?",
    answer: "Ключевой вопрос: есть ли конкретный проект на выходе? Программа «знакомимся с Python» — это не то же самое, что «создаём Telegram-бота и защищаем его на хакатоне». Просите показать проекты прошлых смен: видео защиты, фотографии, описания. Реальный результат — главный критерий."
  },
  {
    question: "Сколько детей должно быть в группе для хорошего обучения?",
    answer: "Оптимально — 8–12 человек на педагога. При 20–25 детях в группе педагог физически не может уделить время каждому. В АйДаКемп группы по 8–10 человек: педагог знает каждого ребёнка по имени уже к концу первого дня."
  },
];

const criteria = [
  {
    number: "01",
    title: "Безопасность территории",
    items: [
      "Охрана на въезде и периметре базы",
      "Медицинский работник на все дни смены (не «по вызову»)",
      "Страховка от несчастных случаев включена в путёвку",
      "Прозрачный контроль питания: меню, аллергии, диеты"
    ]
  },
  {
    number: "02",
    title: "Педагоги: кто реально учит",
    items: [
      "Действующие IT-специалисты или преподаватели с опытом в индустрии",
      "Не студенты-волонтёры без опыта",
      "Соотношение: максимум 10–12 детей на одного педагога",
      "Фиксированный педагог на всю смену, не ротация"
    ]
  },
  {
    number: "03",
    title: "Реальная программа vs маркетинг",
    items: [
      "Конкретный проект на выходе, а не «основы программирования»",
      "Хакатон или защита проекта в конце смены",
      "Примеры проектов прошлых смен — видео или демо",
      "Разбивка по уровням: новичок и продолжающий на одном занятии — плохо"
    ]
  },
  {
    number: "04",
    title: "Размер группы",
    items: [
      "До 12 детей на педагога — оптимально",
      "13–20 — приемлемо при хорошей организации",
      "Больше 20 — индивидуального внимания не будет"
    ]
  },
  {
    number: "05",
    title: "Питание и быт",
    items: [
      "Питание 4–5 раз в день, не буфет",
      "Учёт аллергий и диет при бронировании",
      "Комнаты по 4–6 человек, отдельные душевые",
      "Стирка в процессе смены"
    ]
  },
  {
    number: "06",
    title: "Отзывы и репутация",
    items: [
      "Реальные отзывы на независимых платформах (Яндекс.Карты, 2ГИС)",
      "Лагерь работает несколько сезонов, не первый год",
      "Лагерь отвечает на отрицательные отзывы по существу",
      "Можно попросить контакты родителей прошлых смен"
    ]
  }
];
---

<Base
  title={`Рейтинг IT-лагерей Подмосковья ${SEASON_YEAR} — критерии выбора`}
  description="Как оценивать IT-лагеря: безопасность, программа, преподаватели, питание. Чек-лист для родителей при выборе."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": `Рейтинг IT-лагерей Подмосковья ${SEASON_YEAR} — критерии и сравнение`,
        "description": "Как оценивать IT-лагеря: безопасность, программа, преподаватели, питание. Чек-лист для родителей при выборе.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/reiting-it-lagerey-podmoskove-2026/"}
      }

    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title={`Рейтинг IT-лагерей Подмосковья ${SEASON_YEAR} — критерии и сравнение`}
    subtitle="Не список лагерей, а инструмент выбора. 6 критериев, которые реально важны — и вопросы, которые стоит задать."
    breadcrumb="Статьи"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Ребёнок на занятии в IT-лагере Подмосковья"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <p>
      Каждое лето в Подмосковье работают десятки лагерей с IT-приставкой. Как отличить настоящую образовательную программу от маркетинга? Мы составили не рейтинг конкурентов, а инструмент оценки — 6 критериев, по которым можно проверить любой лагерь, включая нас.
    </p>

    <h2>Как выбирать IT-лагерь: 6 критериев оценки</h2>
    <p>
      Хороший IT-лагерь отличается от обычного не названием и не логотипом с кодом на фоне. Разница — в конкретных, проверяемых вещах. Вот шесть вопросов, которые стоит задать любому лагерю перед покупкой путёвки.
    </p>

    <div class="not-prose flex flex-col gap-4 my-6">
      {criteria.map(c => (
        <div class="border border-slate-200 rounded-[14px] p-5">
          <div class="flex items-start gap-4">
            <span class="text-[28px] font-black text-orange-200 leading-none shrink-0 select-none">{c.number}</span>
            <div>
              <p class="text-[16px] font-bold text-slate-900 mb-2">{c.title}</p>
              <ul class="flex flex-col gap-1.5">
                {c.items.map(item => (
                  <li class="flex items-start gap-2 text-base text-slate-600">
                    <i class="bi bi-check-lg text-orange-400 shrink-0 mt-0.5 text-base" aria-hidden="true"></i>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <h2>Критерий 1: безопасность</h2>
    <p>
      Безопасность — не «охранник на входе». Это система. Проверьте несколько вещей одновременно:
    </p>
    <ul>
      <li><strong>Медработник</strong> — не «скорая по вызову» и не аптечка в тумбочке, а медицинский сотрудник на территории все дни смены. Спросите прямо: «Кто ваш медик, какая у него квалификация?»</li>
      <li><strong>Территория</strong> — закрытый периметр, охрана при въезде. Ребёнок не может просто выйти за забор.</li>
      <li><strong>Страховка</strong> — от несчастных случаев, включённая в стоимость. Не «можно оформить за доплату».</li>
      <li><strong>Питание</strong> — учёт аллергий при бронировании. Лагерь, который не спрашивает об аллергиях, — это красный флаг.</li>
    </ul>
    <p>
      Хороший лагерь отвечает на вопросы о безопасности подробно и без раздражения. Уклончивые ответы — повод насторожиться.
    </p>

    <h2>Критерий 2: программа и преподаватели</h2>
    <p>
      Самый важный критерий. Задайте два вопроса:
    </p>
    <p>
      <strong>Кто учит?</strong> Хороший ответ: действующие разработчики или преподаватели с реальным опытом в IT. Плохой ответ: «опытные вожатые», студенты или волонтёры без профессионального бэкграунда.
    </p>
    <p>
      <strong>Что ребёнок сделает на выходе?</strong> «Познакомится с основами программирования» — это не результат. Результат: «создаст Telegram-бота и защитит его на хакатоне», «сверстает и задеплоит личный сайт», «напишет игру на Python». Попросите показать проекты прошлых смен.
    </p>
    <p>
      Настоящая образовательная программа имеет финальный продукт — что-то, что ребёнок может показать дома и объяснить как оно работает.
    </p>

    <StatCallout
      value="8–10"
      label="детей на одного педагога — оптимальное соотношение для IT-обучения. При 20+ детях в группе индивидуального внимания не будет физически."
      source="Стандарт АйДаКемп"
      icon="people"
      tone="info"
    />

    <h2>Критерий 3: размер группы</h2>
    <p>
      Размер группы напрямую влияет на качество обучения. Педагог физически не может уделить внимание каждому, если в группе 25 человек.
    </p>
    <ul>
      <li><strong>До 12 детей на педагога</strong> — хорошо. Педагог знает каждого по имени, может подстроить темп, помочь застрявшему.</li>
      <li><strong>13–20</strong> — приемлемо при хорошей организации и наличии ассистентов.</li>
      <li><strong>Больше 20</strong> — будет лекция, не занятие. Вопросы остаются без ответа, медленные теряются.</li>
    </ul>
    <p>
      Спросите конкретно: «Сколько детей в одной учебной группе? Есть ли ассистент педагога?»
    </p>

    <h2>Критерий 4: отзывы — где искать и как отличить фейк</h2>
    <p>
      Отзывы на сайте лагеря — наименее надёжный источник. Искать стоит на независимых платформах:
    </p>
    <ul>
      <li><strong>Яндекс.Карты и 2ГИС</strong> — сложнее накрутить, видно динамику по годам</li>
      <li><strong>Форумы родителей</strong> — Woman.ru, BabyBlog, тематические группы во ВКонтакте</li>
      <li><strong>Личные контакты</strong> — попросите у лагеря контакты нескольких родителей прошлых смен</li>
    </ul>
    <p>
      Признаки настоящего отзыва: конкретика («научился делать Telegram-бота», «на хакатоне занял второе место»), упоминание минусов наряду с плюсами, указание смены и года. Признаки сомнительного: общие слова («всё понравилось», «рекомендую»), один день регистрации у нескольких схожих отзывов.
    </p>
    <p>
      Отдельно: смотрите, как лагерь отвечает на негативные отзывы. Конструктивный ответ по существу — хороший знак. Защитная реакция или удаление — плохой.
    </p>

    <h2>Как АйДаКемп соответствует критериям</h2>
    <p>
      Мы делаем это публично, потому что нам нечего скрывать:
    </p>
    <ul>
      <li><strong>Безопасность:</strong> закрытая территория в Подмосковье, медработник весь период смены от несчастных случаев включена в стоимость, питание 5 раз в день с учётом аллергий.</li>
      <li><strong>Педагоги:</strong> действующие IT-специалисты и преподаватели с опытом в индустрии. Соотношение: 8–10 детей на педагога.</li>
      <li><strong>Программа:</strong> каждая смена — командный проект от идеи до защиты. Хакатон в финале — публичная демонстрация рабочего продукта. Примеры проектов — в нашем Telegram и на странице «О лагере».</li>
      <li><strong>Размер группы:</strong> до 10 человек в учебной группе.</li>
      <li><strong>Питание:</strong> 5-разовое, меню согласовано с диетологом, аллергии учитываются при бронировании.</li>
      <li><strong>Отзывы:</strong> 4.9 на Яндекс.Картах, работаем с 2019 года. Реальные фото и видео каждой смены — в открытом доступе.</li>
    </ul>
    <p>
      Мы не говорим «мы лучшие» — это не наш стиль. Мы говорим: вот конкретные факты, проверьте их и сравните с другими лагерями по тем же критериям.
    </p>

    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}
  </main>
  <ArticleBottomCta
    title="Проверьте АйДаКемп по своим критериям"
    subtitle="Задайте любой вопрос — расскажем про педагогов, программу и условия без маркетинга."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
