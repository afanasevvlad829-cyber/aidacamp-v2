---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Отзывы родителей", url: "/otzyvy", icon: "chat-quote", description: "Что говорят мамы и папы" },
  { title: "О лагере", url: "/o-lagere", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: "Программа смены", url: "/programma-smeny", icon: "calendar-week", description: "Чем занимаются дети" },
  { title: "Цены 2026", url: "/ceny", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "Правда ли что дети скучают по дому в первые дни?",
    answer: "Да, первые 1–2 дня почти всегда непростые — особенно для тех, кто едет впервые. Это нормально и это проходит. По нашему опыту, на третий день большинство детей уже настолько втянулись в программу, что звонят домой меньше. А в последний день — плачут, что уезжать."
  },
  {
    question: "Можно ли приехать посмотреть лагерь до смены?",
    answer: "Да, мы проводим дни открытых дверей перед каждым сезоном. Можно приехать с ребёнком, посмотреть базу, познакомиться с вожатыми и задать все вопросы. Расписание дней открытых дверей — в нашем Telegram-канале."
  },
  {
    question: "Что если ребёнок застенчивый и с трудом заводит друзей?",
    answer: "Именно для таких детей командный формат работает лучше всего. В АйДаКемп дети работают над проектами вместе — и дружба возникает через общее дело, а не через светские разговоры. Вожатые специально строят команды так, чтобы никто не оказался в стороне."
  }
];
---

<Base
  title="Истории из детского лагеря — что происходит на самом деле | АйДаКемп"
  description="5 реальных историй из IT-лагеря АйДаКемп — ребёнок который боялся ехать, ребёнок без друзей и ребёнок который впервые написал код. Читайте от мамы к маме."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/istorii-iz-lagerya" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Истории из детского лагеря — что происходит на самом деле",
        "description": "5 реальных историй из IT-лагеря АйДаКемп — ребёнок который боялся ехать, ребёнок без друзей и ребёнок который впервые написал код.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/istorii-iz-lagerya"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Что на самом деле происходит в детском лагере — 5 историй из АйДаКемп"
    subtitle="Мамы рассказали нам то, что дети не всегда говорят вслух. Публикуем с разрешения."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети работают над проектом в IT-лагере АйДаКемп"
    readTime="6 мин чтения"
    breadcrumbsLast="Истории из лагеря"
    daryaQuote="Меня часто спрашивают: «А что там правда происходит?» Вот пять историй. Настоящих."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда отправляешь ребёнка в лагерь, хочется знать — а что там реально будет? Не по буклету, не по сайту, а по-настоящему. Мы собрали пять историй от мам, которые рассказали нам что происходило с их детьми до, во время и после смены в АйДаКемп. Всё — с их слов.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История 1. Артём, 11 лет: «Я не поеду, и точка»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мама Артёма написала нам через неделю после смены. «Он не хотел ехать вообще. Говорил что там будет скучно, что он никого не знает и вообще лучше останется дома за компьютером. Я почти сдалась». В итоге уговорили на один аргумент: в лагере пишут настоящие игры. Не играют — пишут.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          На второй день смены Артём прислал маме голосовое: «Мам, мы сегодня сделали персонажа который ходит по уровню. Это я написал». На третий — уже не звонил вовсе. На девятый день мама написала нам снова: «Артём сказал, что хочет на следующую смену».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Страх «там будет скучно» — почти всегда про незнакомое. Когда незнакомое становится своим, скуки нет.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История 2. Маша, 13 лет: без друзей — это было до лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Маша — интроверт. В школе у неё была одна подруга, и та уехала в другой город. «Я переживала, что она снова окажется одна», — написала мама. Маша читает фантастику, любит кошек и никогда не первой начинает разговор.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В лагере её поставили в команду где нужно было написать телеграм-бота про кошек. Просто совпало. Через два дня у неё была целая группа собеседников — потому что разговаривать об общем деле легче, чем «о себе». К концу смены Маша обменялась контактами с четырьмя ребятами из разных городов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Командный проект — это не просто педагогический приём. Это способ подружиться без неловкости.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История 3. Ваня, 10 лет: первый код и слёзы на защите проекта
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ваня до лагеря не знал ни одной команды в Python. Мама отправила его «просто попробовать». На хакатоне в последний день его команда представляла игру — простую, но свою. Ваня объяснял жюри как работает логика уровней.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          «Он заплакал когда получили второе место. Не от обиды — от гордости. Я такого у него раньше не видела», — написала мама. Ваня приехал домой и сразу попросил установить Python на домашний компьютер. Не для лагеря — для себя.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Когда ребёнок сделал что-то настоящее — он сам это чувствует. И хочет ещё.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История 4. Лера, 12 лет: «Я не хочу уезжать»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В первый день Лера позвонила маме из автобуса и тихо сказала: «Мам, я скучаю». Мама была готова развернуться. Но удержалась и написала вожатым. Те ответили: «Лера уже смеётся за ужином, всё хорошо».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В последний день мама приехала забирать дочку. Лера вышла, обняла маму — и попросила не уезжать ещё пять минут, потому что они не дорисовали с Катей финальную сцену в игре.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Тоска по дому в первый день и «не хочу уезжать» в последний — это история почти каждого первого лагеря.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            История 5. Глеб, 14 лет: «Я понял чем хочу заниматься»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Глеб приехал уже во второй раз, в прошлом году попробовал направление Python. В этом выбрал AI-трек. На третий день спросил наставника: «А это реально профессия? Ну — делать такие штуки?» Наставник ответил честно: «Одна из самых востребованных».
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Мама написала нам уже осенью: «Глеб записался в онлайн-курс по ML. Сам. Без нашей инициативы. Говорит хочет поступить на CS». Ему 14 лет.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Иногда лагерь — это не просто лето. Это момент когда становится понятно что дальше.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-[#ec7c00] rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="hidden px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите, чтобы у вашего ребёнка тоже была такая история?"
    bookingSubtitle="АйДаКемп — IT-лагерь в Подмосковье. Смены с 30 мая по 26 августа 2026."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.add('hidden');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
