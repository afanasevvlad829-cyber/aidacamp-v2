---
import { SEASON_YEAR } from '../../data/shifts';
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Что взять в лагерь", url: "/stati/chto-vzyat-v-lager/", icon: "bag", description: "Полный список вещей" },
  { title: "Ребёнок не хочет в лагерь", url: "/stati/rebenok-ne-hochet-v-lager/", icon: "emoji-frown", description: "Как договориться без скандала" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
  { title: `Цены ${SEASON_YEAR}`, url: "/ceny/", icon: "coin", description: "Выбрать смену" },
];

const faqItems = [
  {
    question: "В каком возрасте можно отправить ребёнка в лагерь впервые?",
    answer: "В АйДаКемп принимают детей от 8 лет. Но готовность к лагерю зависит не от возраста, а от ребёнка. Если восьмилетка уже спокойно остаётся на ночёвках у бабушки — скорее всего готов. Если десятилетка ни разу не ночевал без мамы — стоит потренироваться сначала. Короткая ночёвка у друга или родственника — хорошая репетиция."
  },
  {
    question: "Что делать если ребёнок звонит и просится домой?",
    answer: "Не паниковать и не торопиться забирать. Первые 1–2 дня звонки с «заберите меня» — нормальная адаптация. Напишите вожатым и спросите как ребёнок вне звонка. Если вожатые пишут что всё в порядке — скорее всего так и есть. Главное: держите обещания. Если договорились звонить в 20:00 — звоните в 20:00."
  },
  {
    question: "Стоит ли рассказывать ребёнку о программе заранее?",
    answer: "Да, и это один из лучших способов снизить тревогу. Покажите сайт вместе, посмотрите фотографии прошлых смен, расскажите что будет в первый день. Конкретика лучше абстрактного «там будет весело». Ребёнок, который знает что его ждёт, едет спокойнее."
  },
  {
    question: "Как объяснить ребёнку про ограничения на телефон в лагере?",
    answer: "Главное — не скрывать это и не преподносить как наказание. Скажите честно: «В лагере телефоны сдают при заезде. Ты сам выбираешь, когда пользоваться — покупаешь время за внутреннюю валюту лагеря». Это воспринимается совсем иначе, чем «тебе запрещено». Ребёнок — участник правил, а не их жертва. Можно добавить: «Я буду звонить тебе каждый вечер в 20:00 — значит, ты точно будешь знать когда мы поговорим»."
  },
  {
    question: "Нужно ли тренироваться ночевать вне дома до первого лагеря?",
    answer: "Хорошая идея, особенно если ребёнок ни разу не ночевал без родителей. Начните с малого: ночёвка у бабушки, у друга, на даче с другими взрослыми. Если прошло нормально — готов. Это не гарантия отсутствия тоски в лагере, но базовый навык «я могу спать вне дома» сильно снижает тревогу в первые дни."
  }
];
---

<Base
  title="Как подготовить ребёнка к первому лагерю — 7 советов мамы"
  description="Как подготовить ребёнка к лагерю: что сказать, что взять, как справляться с тоской по дому. 7 практичных советов от мам которые уже прошли через это."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Как подготовить ребёнка к первому лагерю — 7 советов мамы",
        "description": "Как подготовить ребёнка к лагерю: что сказать, что взять, как справляться с тоской по дому. 7 практичных советов.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/kak-podgotovit-rebenka-k-lageru"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Как подготовить ребёнка к первому лагерю", "item": "https://aidacamp.ru/stati/kak-podgotovit-rebenka-k-lageru/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Как подготовить ребёнка к лагерю: 7 вещей которые стоит сделать заранее"
    subtitle="Первый лагерь — это новый опыт для всей семьи. Несколько простых шагов делают его намного спокойнее."
    imageBase="lager-na-leto-2026"
    imageAlt="Мама и ребёнок собирают вещи перед поездкой в лагерь"
    readTime="6 мин чтения"
    breadcrumbsLast="Как подготовить ребёнка к лагерю"
    daryaQuote="Когда дочь ехала первый раз, я сказала не «я тебя отправляю», а «ты едешь». Маленькая разница в словах — большая разница в ощущении."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Первый раз в лагерь — это стресс. Для ребёнка и честно говоря для мамы тоже. Но подготовка реально помогает. Не нотации и не «тебе понравится», а конкретные действия за несколько дней до отъезда. Вот семь из них — проверенных.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            1. Говорите «ты едешь», а не «тебя отправляют»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Слова важны. «Тебя отправляют» — это про то, что взрослые решили и ребёнок не при делах. «Ты едешь» — это про то, что он сам участник события. Звучит похоже, ощущается по-разному.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Включайте ребёнка в подготовку: пусть сам выбирает что взять из вещей, смотрит программу смены, задаёт вопросы которые его беспокоят. Это не про контроль, а про причастность.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            2. Поговорите о страхах заранее — конкретно
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          «Вдруг не будет друзей», «вдруг не понравится еда», «вдруг там будут обижать» — это реальные страхи, а не капризы. На каждый из них есть конкретный ответ. Но сначала нужно спросить: чего именно боишься?
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Общее «там будет хорошо» не работает. Работает конкретное: «В лагере все новенькие — никто не приедет со своей компанией», «телефон можно», «там есть бассейн».
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            3. Соберите вещи вместе — по списку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это не только про то чтобы ничего не забыть. Это ещё и про ритуал: мы готовимся вместе, значит это важно для нас обоих. У нас есть <a href="/stati/chto-vzyat-v-lager/" class="text-primary font-semibold hover:underline">подробный список что взять в лагерь</a> — с документами, одеждой и гаджетами.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Отдельно: подпишите вещи маркером или термонаклейками. В общем пространстве однотипные футболки и носки мгновенно смешиваются.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            4. Договоритесь про звонки заранее
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Договоритесь о конкретном времени — например, каждый день в 20:00. Ребёнок знает что мама позвонит — и в течение дня не беспокоится. Хаотичные звонки «я просто хотела узнать как ты» создают обратный эффект: ребёнок начинает ждать каждого звонка и не может погрузиться в лагерную жизнь.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Если ребёнок в первые дни звонит и говорит «забери меня» — не торопитесь. Напишите вожатым и спросите как он вне звонков. Часто ответ удивит.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5. Настройте на программу, а не на отдых
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          «Там будет весело» — это хорошо, но неточно. Покажите программу смены: что будет делать ребёнок, какой проект создаст, что такое хакатон. Ребёнок едет не «просто отдыхать», а делать что-то конкретное. Это другой настрой.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В АйДаКемп дети за смену создают настоящую игру или бота — и представляют его на хакатоне. Когда ребёнок едет с пониманием что он будет делать, тревога снижается.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            6. Положите что-то своё из дома
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Небольшая мягкая игрушка, распечатанная семейная фотография, любимый брелок — что-то знакомое в незнакомом месте работает как якорь. Не надо стесняться: по нашему опыту у половины детей в первые дни в рюкзаке что-то такое есть.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Хорошо работает ещё небольшой скетчбук или раскраска — привычное занятие в новом месте снижает тревогу в свободное время.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            7. Доверяйте вожатым — и говорите об этом ребёнку
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Дети считывают тревогу родителей. Если мама нервничает при расставании, ребёнок думает: «Значит там правда страшно». Ваша уверенность передаётся.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Скажите: «Если тебе что-то не понравится или будет неудобно — скажи вожатому. Это их работа — помогать». Ребёнок, который знает что у него есть взрослый на месте, чувствует себя спокойнее.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Разговор про телефон — как объяснить без конфликта
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Для многих подростков «телефон сдают при заезде» — самая тревожная часть разговора про лагерь. Вот как подготовить ребёнка к этому заранее:
        </p>
        <ul class="flex flex-col gap-4 mb-5">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Объясните механику, а не запрет.</strong> «Ты сам выбираешь, когда пользоваться телефоном — покупаешь время за внутреннюю валюту лагеря». Это не «тебе запрещено», это «ты управляешь своим временем». Разница важна.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Договоритесь о времени звонка заранее.</strong> «Я буду звонить каждый день в 20:00» — это конкретный якорь. Ребёнок знает, что связь есть, и не переживает весь день. Хаотичные «просто хотела узнать» — хуже, они держат в напряжении.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Возьмите запасной телефон попроще.</strong> Раз телефон сдаётся — не везите флагман. Запасной телефон — спокойствие мамы и меньше стресса у ребёнка. Если поцарапают — не жалко.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Не накручивайте сами.</strong> Если вы сами говорите «бедненький, вот тебя без телефона оставят» — ребёнок считывает тревогу и едет в лагерь уже заряженным на негатив. Нейтральный тон взрослого: «Это правила лагеря, там всё так делают».</span>
          </li>
        </ul>
        <div class="bg-orange-50 border border-orange-100 rounded-[14px] p-4 flex items-start gap-3">
          <i class="bi bi-chat-dots-fill text-orange-500 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <p class="text-base leading-[1.6] text-slate-700">Фраза, которая работает: <em>«Там все так делают — и все окей. Ты не один, это правило для всего лагеря».</em> Социальная норма снижает протест.</p>
        </div>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <!-- CTA к коммерческой странице -->
  <div class="max-w-2xl mx-auto px-4 mt-6 mb-2">
    <div class="rounded-[14px] bg-orange-50 border border-orange-200 p-4">
      <p class="text-base text-slate-700">Хотите узнать подробнее? → <a href="/o-lagere/" class="font-semibold text-primary hover:underline">О лагере АйДаКемп</a></p>
    </div>
  </div>

  <ArticleBottomCta
    bookingTitle="Готовы к первой смене?"
    bookingSubtitle="Расскажем про программу и ответим на все вопросы до бронирования."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
