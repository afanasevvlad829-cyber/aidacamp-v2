---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Программа IT-лагеря", url: "/stati/programma-it-lagerya/", icon: "calendar-week", description: "Чем занимаются дети каждый день" },
  { title: "Лагерь программирования", url: "/lager-programmirovaniya/", icon: "laptop", description: "От нуля до проекта за смену" },
  { title: "Смены 2026 — цены", url: "/ceny/", icon: "coin", description: "Выбрать смену" },
  { title: "О лагере", url: "/o-lagere/", icon: "info-circle", description: "Как устроен день в АйДаКемп" },
];

const faqItems = [
  {
    question: "С какого возраста можно учиться программированию в лагере?",
    answer: "В АйДаКемп принимают детей с 8 лет. Для младших — визуальное программирование (Scratch, блочные среды), для старших — Python, веб-разработка, Roblox Studio. Предварительных знаний не нужно: принимаем детей с нулевым опытом."
  },
  {
    question: "Чем лагерный формат отличается от кружка по программированию?",
    answer: "В кружке ребёнок учится 1–2 часа в неделю, потом уходит домой к своим отвлечениям. В лагере — 8–10 дней концентрации. Нет отвлечений на телефон, телевизор, друзей по другим интересам. Только проект, команда и задача. Это принципиально другой темп прогресса."
  },
  {
    question: "Нужен ли свой ноутбук?",
    answer: "Нет. В АйДаКемп все занятия проходят на оборудовании лагеря. Своё устройство можно взять, но это не обязательно. Это один из плюсов — не нужно покупать ноутбук «на вырост» перед первой сменой."
  },
  {
    question: "Учат ли в лагере «правильному» коду или лишь бы работало?",
    answer: "Баланс. В начале — важнее чтобы работало: ребёнок получает удовлетворение от результата. Потом вводим код-ревью: смотрим вместе как можно написать элегантнее. К концу смены продвинутые участники уже говорят о читаемости кода и именовании переменных. «Правильный» код — цель, но не с первого дня."
  }
];
---

<Base
  title="Программирование в лагере 2026 — зачем учить код в 7-15 лет"
  description="Честный разбор: зачем ребёнку программирование в лагере. Что реально происходит за 10 дней смены. Почему лагерный формат лучше кружка — концентрация"
  ogImage="/images/hero/it-camp.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Зачем ребёнку программирование в лагере: честный разбор | АйДаКемп",
        "description": "Зачем учить код в детстве, что реально происходит в IT-лагере за 10 дней и почему лагерный формат лучше кружка.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/programmirovanie-v-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Программирование в лагере 2026", "item": "https://aidacamp.ru/stati/programmirovanie-v-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Зачем ребёнку программирование в лагере: честный разбор"
    subtitle="Не «будет программистом». А что на самом деле даёт код — и почему лагерь работает лучше кружка."
    imageBase="it-camp"
    imageAlt="Дети на занятии по программированию в IT-лагере АйДаКемп"
    readTime="6 мин чтения"
    breadcrumbsLast="Программирование в лагере"
    daryaQuote="Меня спрашивают: «Зачем ребёнку учить код, он же не собирается быть программистом?» Я отвечаю: а зачем ему физкультура, если он не собирается быть спортсменом? Потому что это развивает мышление — и это важнее профессии."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Каждое лето мы объясняем родителям, зачем их ребёнку IT-лагерь. И первый вопрос почти всегда один: «А он же не собирается быть программистом — стоит ли?» Стоит. И вот почему.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Не «будет программистом» — а «научится думать системно»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Когда ребёнок учится писать код, он учится разбивать большую задачу на маленькие шаги, находить ошибку в своей логике, не сдаваться когда что-то не работает с первого раза. Это не программирование — это мышление.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Такое мышление пригождается везде: в математике, в планировании, в переговорах, в любом деле где нужно решать задачи, а не просто выполнять инструкции. Программирование — просто один из лучших способов это тренировать, потому что компьютер честен: если логика не так — не работает.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Ещё одно — устойчивость к неудаче. В коде ошибки — норма, а не катастрофа. Дети, которые привыкли к тому, что «не работает → ищем почему → чиним», легче переносят неудачи в жизни вообще.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что реально происходит за 10 дней смены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          День 1–2: знакомство со средой, первые задачи, первые «а, вот как это работает». Дети которые вообще не знали что такое код — пишут первые строчки и видят результат.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          День 3–5: тема углубляется, начинается командная работа. Каждый знает свою часть проекта. Учатся объяснять другим что делают — это важнее, чем кажется.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          День 6–9: финальный рывок на проект. Это не «домашнее задание» — это командная работа под дедлайн. Дети сами удивляются, сколько успели.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          День 10: хакатон. Команды представляют проекты перед всем лагерем. Это не экзамен — это презентация того, что они сделали сами. После этого они говорят о своём проекте так, будто это их изобретение. Потому что это правда их изобретение.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему лагерный формат лучше кружка
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Кружок — это 1–2 часа в неделю. Потом ребёнок идёт домой: телефон, ютуб, игры, всё прочее. Через неделю нужно вспоминать с чего остановились. Прогресс медленный, мотивация прыгает.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Лагерь — это 10 дней концентрации. Ребёнок живёт проектом. Вечером за ужином обсуждает с командой что сделали. Утром встаёт и сразу думает про следующий шаг. Никаких отвлечений — только задача и люди, которые работают над тем же.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Плюс — окружение. В кружке 10–15 детей с разным уровнем мотивации. В лагере — все приехали сами (или почти сами) и хотят делать. Это заражает. Когда рядом кто-то азартно работает — хочется тоже.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Итог: за 10 дней в лагере ребёнок часто продвигается дальше, чем за год кружка. Не потому что в кружке плохо — а потому что концентрация это другой режим обучения.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Треки в АйДаКемп — что выбирают дети
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          В АйДаКемп четыре трека: Python (классическое программирование), веб-разработка (сайты и интерфейсы), Roblox (создание игр в популярной платформе), 3D-моделирование. Выбирает ребёнок — исходя из интересов.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Важно: ноутбук с собой не нужен. Всё оборудование есть на базе. Это снижает порог входа — не нужно сначала покупать устройство, а потом понять что не понравилось.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Занятия по программированию — около 4 часов в день. Остальное время — бассейн, прогулки, вечерние игры, еда, сон. Это не курс с утра до ночи — это лагерь, где IT является главной темой, а не единственной.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- Что умеют дети после 14-дневной смены -->
      <section class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что умеют делать ребята после 14-дневной смены
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Конкретный список навыков, которые остаются после 14-дневной смены АйДаКемп:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 max-w-[720px]">
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-2">Python</p>
            <p class="text-base leading-[1.6] text-slate-600">Переменные, условия, циклы, функции, списки и словари, работа с файлами, базовый ООП, импорт библиотек.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-2">Telegram API</p>
            <p class="text-base leading-[1.6] text-slate-600">Отправка сообщений, обработка команд, кнопки, хранение данных пользователя.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-base font-bold text-slate-900 mb-2">AI</p>
            <p class="text-base leading-[1.6] text-slate-600">Работа с OpenAI API, промтинг, базовый анализ текста.</p>
          </div>
          <div class="bg-orange-50 rounded-xl p-4 border border-orange-100">
            <p class="text-base font-bold text-slate-900 mb-2">Итог</p>
            <p class="text-base leading-[1.6] text-slate-600">Telegram-бот, который отвечает на вопросы пользователей и использует AI для генерации ответов. Реальный продукт, не учебное упражнение.</p>
          </div>
        </div>
      </section>

      <div class="mb-8 pt-4">
        <div class="flex items-center gap-2 mb-6">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Частые вопросы
          </h2>
        </div>
        <div class="flex flex-col gap-6">
          {faqItems.map(item => (
            <div>
              <p class="text-[16px] font-semibold text-slate-900 mb-2">{item.question}</p>
              <p class="text-[16px] leading-[1.7] text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </article>
  </main>


  <ArticleBottomCta
    bookingTitle="Хотите отдать ребёнка на программирование?"
    bookingSubtitle="В АйДаКемп учат Python, AI и разработке — и сразу делают настоящий проект."
  />
  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
