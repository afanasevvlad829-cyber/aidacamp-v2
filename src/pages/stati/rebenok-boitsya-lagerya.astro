---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Ребёнок не хочет в лагерь", url: "/stati/rebenok-ne-hochet-v-lager", icon: "chat-dots-fill", description: "Разбираемся без скандалов" },
  { title: "Как выбрать лагерь", url: "/stati/kak-vybrat-detskiy-lager", icon: "patch-check-fill", description: "7 критериев" },
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove", icon: "houses", description: "Условия, безопасность" },
];
---

<Base
  title="Ребёнок боится лагеря — как помочь и стоит ли настаивать"
  description="Ребёнок боится ехать в лагерь: откуда берётся страх, как говорить, когда стоит настоять, а когда подождать. Практические советы без давления."
  ogImage="/images/articles/hakaton-1600.jpg"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/rebenok-boitsya-lagerya" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Ребёнок боится лагеря — как помочь и стоит ли настаивать",
      "description": "Ребёнок боится ехать в лагерь: откуда берётся страх, как говорить, когда стоит настоять, а когда подождать. Практические советы без давления.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-05-15",
      "dateModified": "2026-05-15",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/rebenok-boitsya-lagerya"
      }
    })} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Ребёнок боится лагеря", "item": "https://aidacamp.ru/stati/rebenok-boitsya-lagerya/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Ребёнок боится лагеря — как помочь и стоит ли настаивать"
    subtitle="Страх перед первым лагерем — нормальная реакция. Разбираемся, откуда он берётся, как говорить с ребёнком, когда мягко настоять и когда не торопить."
    imageBase="hakaton"
    imageAlt="Подростки на занятии в летнем лагере"
    readTime="6 мин чтения"
    breadcrumbsLast="Ребёнок боится лагеря"
    daryaQuote="У нас была ситуация, когда дочь категорически отказывалась ехать. Я боялась настаивать. Потом оказалось — поехала, и через три дня не хотела уезжать."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Страх перед первым лагерем — нормальная реакция. Разбираемся, откуда он берётся, как говорить с ребёнком, когда мягко настоять и когда не торопить.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Откуда берётся страх лагеря
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Чаще всего — не из самого лагеря. Ребёнок боится трёх вещей: разлуки с родителями (особенно до 10 лет), незнакомой среды и неизвестности — что там будет происходить, с кем спать, что есть. Всё это нормальная реакция здоровой нервной системы на неизвестное.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как говорить с ребёнком о страхе
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Не говорите: «Там будет весело, ты точно понравится». Это обещание, которое вы не можете выполнить — и если первые дни окажутся трудными, ребёнок почувствует себя преданным. Говорите иначе: «Там будут новые люди, и сначала может быть непривычно. Это нормально. Ты справишься». Признайте трудность — и обозначьте веру в ребёнка.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда стоит настоять
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если страх — это тревога перед неизвестным (а не реакция на конкретный плохой опыт), то мягкое настаивание часто идёт на пользу. Большинство детей, которые плакали в машине по дороге, через 3 дня не хотят уезжать. Предложите договор: «Поедешь на 3 дня. Если через 3 дня всё равно плохо — заберём». Это даёт ребёнку ощущение контроля.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Когда не стоит торопить
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если ребёнок уже был в лагере и вернулся с травматичным опытом — конфликт, буллинг, болезнь без нормальной помощи — торопить не нужно. Сначала разберитесь с тем, что случилось. И выбирайте следующий лагерь тщательнее.
        </p>
      </div>

      <!-- Section 5 — чек-лист -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что помогает до заезда
          </h2>
        </div>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Покажите фото и видео лагеря — конкретные, не рекламные</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Обсудите распорядок дня: что будет утром, что вечером</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Спросите: что тебя пугает больше всего? И отвечайте честно</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Возьмите с собой любимую мягкую игрушку или «секрет» от мамы</p>
          </div>
          <div class="flex gap-3 items-start">
            <i class="bi bi-check-lg text-orange-400 text-[18px] shrink-0 mt-0.5" aria-hidden="true"></i>
            <p class="text-base leading-[1.6] text-slate-600">Договоритесь о конкретном времени звонка</p>
          </div>
        </div>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Первые дни: что происходит на самом деле
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          По нашему опыту: примерно 30% детей адаптируются за первые сутки, 50% — за 2–3 дня, остальные — к концу первой недели. Слёзы в первый вечер — почти норма. Письма с «хочу домой» в первые 3 дня — тоже. Если через 5 дней ребёнок всё ещё в отчаянии — это разговор с вожатым и, возможно, решение забрать. Но до этого доходит редко.
        </p>
      </div>

      <BlogCTA />
    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="АйДаКемп — безопасная среда для первого раза"
    bookingSubtitle="Медработник 24/7, вожатые с опытом, ежедневные фото. Расскажем подробнее."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
