---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Что происходит на смене", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "calendar3", description: "Программа дня в лагере" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Программирование + мышление" },
  { title: "О лагере", url: "/o-lagere/", icon: "house-heart", description: "Как устроен АйДаКемп" },
];
---

<Base
  title="Совет отряда: как в АйДаКемпе решают то, за что обычно сразу выгоняют | АйДаКемп"
  description="Когда ребёнок нарушает правила, взрослый может просто выгнать. Или дать шанс. Рассказываем, как работает совет отряда — инструмент, за которым стоит серьёзная педагогика."
  ogImage="/images/hero/lager-dlya-podrostkov.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Совет отряда: как в АйДаКемпе решают то, за что обычно сразу выгоняют",
      "description": "Когда ребёнок нарушает правила, взрослый может просто выгнать. Или дать шанс. Рассказываем, как работает совет отряда — инструмент, за которым стоит серьёзная педагогика.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-25",
      "dateModified": "2026-06-25",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/sovet-otryada"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Совет равных: как в АйДаКемпе решают то, за что обычно сразу выгоняют"
    subtitle="Взрослый может выгнать — и это будет конец истории. Или дать шанс. Рассказываем, как работает совет отряда."
    imageBase="lager-dlya-podrostkov"
    imageAlt="Подростки в лагере АйДаКемп"
    breadcrumbsLast="Совет отряда"
    readTime="6 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Представь: утро, завтрак, вожатая заходит в комнату и обнаруживает то, что обнаруживать не хотелось бы. По договору — всё однозначно. Есть список нарушений, за которые следует отчисление. Без апелляций, без обсуждений. Собирай вещи.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Мы долго жили именно так. А потом задали себе вопрос: а где в этом урок?
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Взрослый сказал «ты нарушил, до свидания» — это не воспитание. Это администрирование. Ребёнок уехал обиженным, родители расстроены, остальные тридцать девять человек ничего не поняли — и через неделю всё повторяется с кем-то другим. Поэтому мы придумали совет отряда.
        </p>
      </div>

      <!-- За что созывается -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            За что созывается совет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Не за любое нарушение. В договоре чётко прописан список: порча имущества, воровство, самовольный выход из корпуса ночью, проявление агрессии. Дети разные, и никакое собеседование при записи не покажет, как ребёнок поведёт себя в стрессовой ситуации. Именно поэтому мы не ставим крест сразу — мы даём шанс пройти через разбор и выйти из него с опытом.
        </p>
      </div>

      <!-- Выбор -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Выбор, который меняет всё
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Когда случается нарушение из списка, ребёнку не говорят «собирай вещи». Ему говорят: есть два пути.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          <strong>Первый — стандартный.</strong> Взрослые принимают решение по договору. Быстро и без обсуждений.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-3">
          <strong>Второй — совет отряда.</strong> Твоё дело рассматривают ровесники. Ты можешь объяснить свою позицию. Решение принимают не вожатые.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Участие добровольное. Но если соглашаешься — принимаешь и исход, какой бы он ни был. Родителей предупреждают до начала совета, не после. Если родители против — действуем по договору. Это их право, мы его уважаем.
        </p>
      </div>

      <!-- Механика -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как всё устроено изнутри
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Совет собирается в день нарушения. Пока ситуация живая — она честная.
        </p>

        <div class="mt-6 space-y-4">
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
            <p class="font-semibold text-slate-800 mb-1"><i class="bi bi-people text-[#ec9b44] mr-1" aria-hidden="true"></i> Присяжные</p>
            <p class="text-[15px] text-slate-600 leading-[1.6]">Выбираются жеребьёвкой среди тех, кто сам хочет занять эту роль. Не назначаются сверху — записываются добровольно, рандом решает состав. Присяжный по принуждению думает о чём угодно, кроме дела.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
            <p class="font-semibold text-slate-800 mb-1"><i class="bi bi-clipboard-check text-[#ec9b44] mr-1" aria-hidden="true"></i> Заявитель</p>
            <p class="text-[15px] text-slate-600 leading-[1.6]">Тот, кто созвал совет. При серьёзном нарушении из договора заявителем выступает лагерь. Задача заявителя — изложить только факты: что произошло, какие есть подтверждения. Без эмоций и ярлыков.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
            <p class="font-semibold text-slate-800 mb-1"><i class="bi bi-person-check text-[#ec9b44] mr-1" aria-hidden="true"></i> Участник совета</p>
            <p class="text-[15px] text-slate-600 leading-[1.6]">Тот, чьё дело рассматривается. Может объяснить свою сторону сам или пригласить кого-то из ребят выступить рядом. Задача — не «доказать невиновность», а дать присяжным полную картину: контекст, обстоятельства, своё понимание произошедшего.</p>
          </div>
          <div class="rounded-[14px] bg-slate-50 border border-slate-100 px-5 py-4">
            <p class="font-semibold text-slate-800 mb-1"><i class="bi bi-eye text-[#ec9b44] mr-1" aria-hidden="true"></i> Модератор (вожатый)</p>
            <p class="text-[15px] text-slate-600 leading-[1.6]">Держит формат, не даёт разговору скатиться в балаган. Но в само решение не вмешивается — и это принципиально. Его слово здесь не последнее.</p>
          </div>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600 mt-5">
          Присяжные слушают, задают вопросы обеим сторонам, совещаются и объявляют вердикт. Он финальный.
        </p>
      </div>

      <!-- Раскаяние -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Про наказание — и почему раскаяние важнее тяжести
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Наказание не всегда пропорционально нарушению. Два человека могут совершить одинаковый проступок и выйти из совета с разными исходами — потому что присяжные смотрят не только на то, что случилось, но и на то, понимает ли человек, что он сделал. Есть ли осознание. Есть ли настоящее раскаяние, а не «простите, я больше не буду» для галочки.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Именно это отличает совет от стандартного «нарушил — выгнали». Система оставляет место для человека внутри правила.
        </p>
      </div>

      <!-- Отличие от школы -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Чем это отличается от школы
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          В школе директор вызывает родителей, классный руководитель составляет докладную, ребёнок сидит в стороне и ждёт решения взрослых. Его мнение — формальность. Его объяснение — в лучшем случае смягчающее обстоятельство.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Здесь всё иначе. Ребёнок — не объект разбирательства, а участник. Он говорит, его слышат, его аргументы реально влияют на исход. Решение принимают те, с кем он живёт в одном корпусе, ест за одним столом, делает проекты в одной команде.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Одобрение и осуждение ровесников в подростковом возрасте весит несравнимо больше, чем слово взрослого. Мы не боремся с этим фактом — мы работаем с ним.
        </p>
      </div>

      <!-- Кто ещё может созвать -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто ещё может созвать совет
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Не только вожатые. Любой участник лагеря может потребовать рассмотрения конфликта — спор, несправедливость, что угодно, что кажется важным.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Но за созыв берётся взнос — 500 внутренних коинов. Не ради заработка. Ради того, чтобы совет не превращался в инструмент мести или способ выплеснуть обиду. 500 коинов — достаточно, чтобы остановиться и спросить себя: это действительно важно, или я просто злюсь прямо сейчас?
        </p>
      </div>

      <!-- Что говорит наука -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что говорит наука
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Идея воспитания через коллектив — не наша выдумка. Ещё Макаренко в начале XX века показал: «воспитатель влияет на коллектив, а коллектив влияет на каждого участника». В западной педагогике этот подход живёт под названием <em>restorative justice</em> — восстановительное правосудие.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Исследования в американских школах показывают: там, где конфликты разбираются внутри группы ровесников, снижается число отчислений и улучшается климат в коллективе. Систематический обзор NIH подтверждает: ровесники передают нормы поведения эффективнее взрослых, потому что воспринимаются как «свои» и служат ролевыми моделями. Министерство юстиции США отдельно изучало восстановительные практики для подростков — результат устойчиво положительный.
        </p>

        <!-- Инфографика -->
        <div class="my-8 rounded-[16px] overflow-hidden border border-slate-200 bg-white">
          <div class="bg-[#0d1a2b] px-6 py-5 text-center">
            <span class="inline-block bg-[#ec9b44] text-white text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wide mb-3">Наука + педагогика</span>
            <h3 class="text-white text-[18px] font-bold leading-[1.3]">Совет отряда: почему это работает</h3>
            <p class="text-white/60 text-[13px] mt-1">Российские и западные исследования о воспитании через коллектив</p>
          </div>

          <!-- Механика -->
          <div class="px-5 pt-5 pb-2">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Как проходит совет</p>
            <div class="flex items-center gap-1 overflow-x-auto pb-2">
              {[
                { n: "1", label: "Нарушение", sub: "Серьёзный проступок из договора" },
                { n: "2", label: "Выбор", sub: "Согласие ребёнка и родителей" },
                { n: "3", label: "Жеребьёвка", sub: "Присяжные из добровольцев" },
                { n: "4", label: "Разбор", sub: "Обвинение, защита, вопросы" },
                { n: "5", label: "Вердикт", sub: "Только присяжные решают" },
              ].map((s, i, arr) => (
                <div class="flex items-center gap-1 shrink-0">
                  <div class="bg-white border border-slate-200 rounded-[10px] px-3 py-3 text-center w-[120px]">
                    <div class="w-6 h-6 rounded-full bg-[#ec9b44] text-white text-[11px] font-bold flex items-center justify-center mx-auto mb-1">{s.n}</div>
                    <div class="text-[12px] font-semibold text-[#0d1a2b]">{s.label}</div>
                    <div class="text-[10px] text-slate-500 mt-0.5 leading-tight">{s.sub}</div>
                  </div>
                  {i < arr.length - 1 && <span class="text-slate-300 text-lg">›</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- Роли -->
          <div class="px-5 pt-4 pb-2">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Роли в совете</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-slate-50 border border-slate-100 rounded-[10px] p-3 flex gap-2 items-start">
                <i class="bi bi-eye text-[#ec9b44] text-[18px] shrink-0" aria-hidden="true"></i>
                <div>
                  <div class="text-[12px] font-semibold text-[#0d1a2b]">Модератор (вожатый)</div>
                  <div class="text-[11px] text-slate-500 leading-tight mt-0.5">Следит за форматом. В решение не вмешивается.</div>
                </div>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-[10px] p-3 flex gap-2 items-start">
                <i class="bi bi-people text-[#ec9b44] text-[18px] shrink-0" aria-hidden="true"></i>
                <div>
                  <div class="text-[12px] font-semibold text-[#0d1a2b]">Присяжные</div>
                  <div class="text-[11px] text-slate-500 leading-tight mt-0.5">Жеребьёвка среди желающих. Вердикт — финальный.</div>
                </div>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-[10px] p-3 flex gap-2 items-start">
                <i class="bi bi-clipboard-check text-[#ec9b44] text-[18px] shrink-0" aria-hidden="true"></i>
                <div>
                  <div class="text-[12px] font-semibold text-[#0d1a2b]">Заявитель</div>
                  <div class="text-[11px] text-slate-500 leading-tight mt-0.5">Излагает факты. При серьёзном нарушении — лагерь.</div>
                </div>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-[10px] p-3 flex gap-2 items-start">
                <i class="bi bi-person-check text-[#ec9b44] text-[18px] shrink-0" aria-hidden="true"></i>
                <div>
                  <div class="text-[12px] font-semibold text-[#0d1a2b]">Участник совета</div>
                  <div class="text-[11px] text-slate-500 leading-tight mt-0.5">Объясняет свою сторону сам или с поддержкой.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Research cards -->
          <div class="px-5 pt-4 pb-2">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Исследования</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-white border border-slate-200 rounded-[10px] p-3">
                <span class="inline-block bg-blue-50 text-blue-600 text-[10px] font-semibold px-2 py-0.5 rounded-full mb-2"><i class="bi bi-globe mr-1" aria-hidden="true"></i>Западная педагогика</span>
                <p class="text-[12px] font-semibold text-[#0d1a2b] mb-1">Restorative Circles — США</p>
                <p class="text-[11px] text-slate-600 leading-snug">Школы с восстановительными кругами фиксируют снижение отчислений и улучшение климата в коллективе.</p>
                <p class="text-[10px] text-slate-400 mt-2">University of Maryland Law</p>
              </div>
              <div class="bg-white border border-slate-200 rounded-[10px] p-3">
                <span class="inline-block bg-blue-50 text-blue-600 text-[10px] font-semibold px-2 py-0.5 rounded-full mb-2"><i class="bi bi-globe mr-1" aria-hidden="true"></i>NIH / PMC</span>
                <p class="text-[12px] font-semibold text-[#0d1a2b] mb-1">Ровесники эффективнее взрослых</p>
                <p class="text-[11px] text-slate-600 leading-snug">Систематический обзор: ровесники передают нормы поведения лучше, так как воспринимаются как «свои».</p>
                <p class="text-[10px] text-slate-400 mt-2">NIH / PMC, 2022</p>
              </div>
              <div class="bg-white border border-slate-200 rounded-[10px] p-3">
                <span class="inline-block bg-orange-50 text-orange-600 text-[10px] font-semibold px-2 py-0.5 rounded-full mb-2"><i class="bi bi-flag-fill mr-1" aria-hidden="true"></i>Российская педагогика</span>
                <p class="text-[12px] font-semibold text-[#0d1a2b] mb-1">А.С. Макаренко</p>
                <p class="text-[11px] text-slate-600 leading-snug">«Воспитатель влияет на коллектив, коллектив влияет на каждого участника» — принцип, актуальный по сей день.</p>
                <p class="text-[10px] text-slate-400 mt-2">ELAR USPU</p>
              </div>
              <div class="bg-white border border-slate-200 rounded-[10px] p-3">
