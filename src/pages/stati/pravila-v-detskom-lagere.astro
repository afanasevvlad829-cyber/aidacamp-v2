---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Телефон в лагере", url: "/stati/telefon-v-lagere/", icon: "phone", description: "Как устроено экранное время" },
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "star", description: "Как подготовить ребёнка" },
  { title: "О лагере АйДаКемп", url: "/o-lagere/", icon: "info-circle", description: "Программа и распорядок" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Можно ли брать телефон в лагерь?",
    answer: "Да, телефон берут с собой для связи с родителями, но при заселении он сдаётся в именной бокс. Экранное время не запрещено — его покупают за рубли, внутреннюю игровую валюту лагеря."
  },
  {
    question: "Что будет, если ребёнок нарушит правила?",
    answer: "За нарушения — опоздал на построение, нагрубил — с личного счёта в игровых рублях снимается штраф. Криков и унижений нет: вожатые объясняют, что пошло не так и как исправить."
  },
  {
    question: "Можно ли звонить домой каждый день?",
    answer: "Да. Время для звонков — обычно вечером после ужина, вожатый выдаёт телефон. Если срочно, родители пишут вожатому в WhatsApp в любое время. Договоритесь заранее: «созваниваемся по вечерам» — это снимает тревогу с обеих сторон."
  },
  {
    question: "Что запрещено брать в лагерь?",
    answer: "Запрещены: алкоголь, энергетики, острые предметы, дорогие украшения, большие суммы наличных. Нельзя: покидать территорию без сопровождения вожатого, выходить после отбоя. Всё это — не из вредности, а потому что лагерь несёт ответственность за безопасность школьников. Большинство правил — просто здравый смысл, который ребята принимают нормально."
  },
  {
    question: "Как в АйДаКемп работает система игровых рублей?",
    answer: "Рубли — это внутренняя игровая валюта лагеря (как фишки в Монополии, к реальным деньгам не имеет отношения). Каждый день ребята получают 500 рублей просто за прожитый день плюс 100 за уборку в комнате — итого 600 в день. Тратить можно на экранное время (1 минута = 10 рублей), коллективные события (кино, костёр), физические призы из магазина лагеря. Система учит планировать расходы и договариваться в команде."
  }
];
---

<Base
  title="Правила поведения в детском оздоровительном лагере для ребят и отряда"
  description="Правила поведения в детском лагере: отбой, подъём, распорядок дня, правила отряда, телефоны и что запрещено: спокойный разбор для родителей и ребят — без казармы."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Правила в детском лагере — что важно знать ребёнку и родителям",
        "description": "Типичные правила детского лагеря: распорядок дня, телефоны, отбой, запрещённые вещи. Как в АйДаКемп устроены правила — честно и без страшилок.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pravila-v-detskom-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Правила в детском лагере", "item": "https://aidacamp.ru/stati/pravila-v-detskom-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Правила поведения в летнем детском оздоровительном лагере"
    subtitle="Рассказываем, как устроены правила — чтобы ребёнок знал чего ожидать, а вы не переживали."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети на утреннем построении в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Правила в детском лагере"
    daryaQuote="Когда дочь ехала первый раз, я сама не знала: а вдруг там строгие правила и она будет чувствовать себя в тюрьме? Оказалось — нет. Правила есть, но они понятные. И дочь сама их приняла."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В лагере живут несколько десятков ребят, и без базовых правил было бы хаотично. Это не наказание и не военный режим, а договорённости, которые делают общее пространство удобным и безопасным. Дальше — что обычно принято на летних сменах и как устроено в АйДаКемп.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Распорядок дня: подъём, отбой и всё между ними
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Распорядок — основа лагерной жизни. Это не произвол: при активном дне нужен полноценный сон.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Подъём в 8:00</strong> — лёгкая зарядка 10–15 минут, задаёт тон дню.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Питание по расписанию</strong> — завтрак, обед, полдник, ужин и вечерний перекус. Пропускать нельзя: голодный ребёнок не может ни заниматься, ни общаться.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тихий час после обеда</strong> — 1–1,5 часа. Спать необязательно, лежать и отдыхать — да. Многие сначала возражают, а потом называют это лучшим временем дня.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Отбой в 22:30–23:00</strong> — вожатый остаётся, пока все не улягутся. Разговоры в комнате ещё полчаса — норм, хождение по коридорам — нет.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Телефоны в лагере: как это работает в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефонный вопрос — самый острый для родителей. Сразу честно: в АйДаКемп телефоны сдаются в боксы при заселении. Это сознательный выбор, а не случайность.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Экранное время не запрещено — его покупают за внутреннюю валюту лагеря (как она устроена — ниже). Связь с родителями через вожатого, позвонить вечером можно всегда. Наш опыт: большинство перестают скучать по телефону уже на второй день — просто заняты.
        </p>

        <div class="mt-4 bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-info-circle text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Совет перед отъездом</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Договоритесь с ребёнком заранее: «Звоним по вечерам, раз в 2 дня». Это снижает тревогу у обоих. Дети, у которых есть чёткая договорённость, адаптируются быстрее.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Правила отношений в отряде
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Правила общения проговариваются в первый же день: вожатые обсуждают их вместе с отрядом — не только «не дерись», но и «уважай пространство другого», «не высмеивай».
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Никакого буллинга и унижений</strong> — ни словесных, ни физических. Это красная линия. Вожатые реагируют сразу.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Уважение к чужим вещам</strong> — не брать без спроса, вернуть в том же виде. Это касается и имущества лагеря: оборудования, мебели, инвентаря.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Участие в жизни отряда</strong> — дежурства, чистота в комнате, совместные мероприятия. Это не наказание, а быт: ответственность за общее пространство.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Право на «нет»</strong> — можно отказаться от активности, если не хочется. Но предупредить вожатого и объяснить, почему. Уважение работает в обе стороны.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что запрещено: список без сюрпризов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство запретов — это просто здравый смысл. Ничего неожиданного, но лучше знать заранее.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Покидать территорию без сопровождения</strong> — ни в магазин, ни «просто посмотреть»: лагерь несёт юридическую ответственность за каждого.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Алкоголь, спиртные и энергетические напитки</strong> — полный запрет без исключений.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Острые предметы и пиротехника</strong> — перочинный нож, петарды и всё похожее сдаются при заселении и возвращаются при отъезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-base" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Большие суммы наличных и ценности</strong> — дорогие украшения, брендовые вещи. В общем пространстве они теряются или повреждаются.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Безопасность и самочувствие: то, что стоит знать
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Часть правил — это забота, а не занудство: про пожарную безопасность, здоровье и вылазки за территорию рассказывают в первый же день.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-shield-check text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Пожарная безопасность</strong> — в первый день показывают, как покинуть корпус по сигналу. Курить на территории нельзя.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-heart-pulse-fill text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Самочувствие</strong> — при любом недомогании сразу к вожатому или медработнику, не дожидаясь вечера.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Новичкам хватает одного разговора в первый день. Вожатый и координатор на связи каждый день.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Система игровых рублей — правила вместо запретов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ключевой принцип — не запрещать, а создать среду, где правильное выбирается само. Для этого работает система игровых рублей (внутренняя валюта лагеря, к реальным деньгам не относится).
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждый день все получают 500 рублей за прожитый день плюс 100 за уборку комнаты — 600 без условий, как круг в Монополии. Дальше сам решаешь.
        </p>
        <ul class="flex flex-col gap-3 max-w-[680px] mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-coin text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Бонусы сверх ежедневных:</strong> помощь другим ребятам, активное участие в занятиях — начисляют вожатые.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-cart text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>На что тратят:</strong> экранное время (1 минута = 10 рублей), кино на вечер, ночь с гаджетами, отбой на час позже, физические призы из магазина лагеря.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Штрафы:</strong> за нарушения (опоздание, нарушение правил отряда) с личного счёта снимаются рубли. Без криков, без унижений — просто последствие выбора.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Это не про наказания, а про решения и их последствия: максимальная потеря — несколько тысяч игровых рублей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как подготовить ребёнка к правилам лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главная ошибка — ничего не сказать заранее: ребёнок приезжает и упирается в незнакомые требования.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Поговорите дома: «Правила будут — как в школе, только другие. Телефон сдашь на хранение, зато будешь занят с утра до вечера». Кто знает, чего ждать, принимает правила легче.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
