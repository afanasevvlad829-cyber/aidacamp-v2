---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Телефон в лагере", url: "/stati/telefon-v-lagere", icon: "phone", description: "Как устроено экранное время" },
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere", icon: "star", description: "Как подготовить ребёнка" },
  { title: "О лагере АйДаКемп", url: "/o-lagere", icon: "info-circle", description: "Программа и распорядок" },
  { title: "Записаться на смену", url: "/ceny", icon: "calendar-check", description: "Смены лета 2026" },
];

const faqItems = [
  {
    question: "Можно ли брать телефон в лагерь?",
    answer: "Да, телефон берут с собой — для связи с родителями. В АйДаКемп телефоны сдаются в специальные боксы при заселении. Ребята сами решают, когда использовать лимит экранного времени: покупают его за рубли (это внутренняя игровая валюта лагеря). Это не наказание — это осознанный выбор вместо бездумного листания ленты."
  },
  {
    question: "Что будет, если ребёнок нарушит правила?",
    answer: "В АйДаКемп работает система игровых рублей (внутренняя валюта лагеря). За нарушения правил — опоздал на построение, нагрубил — с личного счёта снимается штраф в рублях. Криков и унижений нет. Вожатые объясняют что именно пошло не так и как исправить. Цель — не наказать, а научить договариваться."
  },
  {
    question: "Можно ли звонить домой каждый день?",
    answer: "Да. Есть отведённое время для звонков — обычно вечером после ужина. Звонить можно через сданный телефон — вожатый выдаёт его на время звонка. Родители могут написать на WhatsApp вожатому в любое время, если срочно. Договоритесь с ребёнком заранее: «пишем по вечерам» — это снимает тревогу с обеих сторон."
  },
  {
    question: "Что запрещено брать в лагерь?",
    answer: "Запрещены: алкоголь, энергетики, острые предметы, дорогие украшения, большие суммы наличных. Нельзя: покидать территорию без сопровождения вожатого, выходить после отбоя. Всё это — не из вредности, а потому что лагерь несёт ответственность за безопасность школьников. Большинство правил — просто здравый смысл, который ребята принимают нормально."
  },
  {
    question: "Как в АйДаКемп работает система игровых рублей?",
    answer: "Рубли — это внутренняя игровая валюта лагеря (как фишки в Монополии, к реальным деньгам не имеет отношения). Каждый день ребята получают 500 рублей просто за прожитый день плюс 100 за уборку в комнате — итого 600 в день. Тратить можно на экранное время (1 минута = 10 рублей), коллективные события (кино, костёр), физические призы из магазина лагеря. Система учит планировать расходы и договариваться в команде."
  }
];
---

<Base
  title="Правила в детском лагере — что важно знать ребёнку и родителям"
  description="Отбой, подъём и распорядок дня в детском лагере, правила отряда, телефоны и что запрещено: спокойный разбор для родителей и ребят — без казармы."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/pravila-v-detskom-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Правила в детском лагере — что важно знать ребёнку и родителям",
        "description": "Типичные правила детского лагеря: распорядок дня, телефоны, отбой, запрещённые вещи. Как в АйДаКемп устроены правила — честно и без страшилок.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pravila-v-detskom-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/" },
        { "@type": "ListItem", "position": 3, "name": "Правила в детском лагере", "item": "https://aidacamp.ru/stati/pravila-v-detskom-lagere/" }
      ]
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Правила в детском лагере: распорядок, телефоны, отбой и другое"
    subtitle="Рассказываем, как устроены правила — чтобы ребёнок знал чего ожидать, а вы не переживали."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети на утреннем построении в летнем лагере"
    readTime="5 мин чтения"
    breadcrumbsLast="Правила в детском лагере"
    daryaQuote="Когда дочь ехала первый раз, я сама не знала: а вдруг там строгие правила и она будет чувствовать себя в тюрьме? Оказалось — нет. Правила есть, но они понятные. И дочь сама их приняла."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Лагерь — это особенная среда. Здесь живут сразу несколько десятков детей, и без базовых правил было бы просто хаотично. Правила в детском лагере — это не наказание и не военный режим. Это договорённости, которые делают жизнь в общем пространстве удобной и безопасной для всех. Рассказываем, что обычно принято в лагерях — и как это работает в АйДаКемп.
         Ребёнку необходимо соблюдать простые правила пребывания на территории ДОЛ — это не казарменный этикет, а действия, о которых родитель договаривается с ним заранее.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Распорядок дня: подъём, отбой и всё между ними
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Распорядок — основа лагерной жизни. Подъём обычно в 8:00, отбой — в 22:00–23:00 в зависимости от возраста. Это не произвол: детям нужен полноценный сон, особенно при активном дне.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Подъём в 8:00</strong> — зарядка не обязательна во всех лагерях, но в АйДаКемп лёгкая утренняя активность есть. Она занимает 10–15 минут и задаёт тон дню.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Питание по расписанию</strong> — завтрак, обед, полдник, ужин и вечерний перекус. Пропускать нельзя — не из-за правил, а потому что голодный ребёнок не может нормально заниматься и общаться.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Тихий час после обеда</strong> — 1–1,5 часа. Спать необязательно, но лежать и отдыхать — да. Некоторые дети поначалу возражают, а потом сами говорят, что это лучшее время дня.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Отбой в 22:30–23:00</strong> — после вечерних активностей. Вожатый остаётся до тех пор, пока все не улягутся. Разговоры в комнате ещё полчаса — норм. Хождение по коридорам после отбоя — нет.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Телефоны в лагере: как это работает в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Телефонный вопрос — самый острый для родителей. Сразу честно: в АйДаКемп телефоны сдаются в боксы при заселении. Это сознательный выбор, а не случайность.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Ребята сами решают, когда тратить лимит экранного времени — и покупают его за внутреннюю валюту лагеря. Хочешь час на телефоне — заработай монеты. Это учит осознанно относиться к экранному времени, а не просто листать ленту по привычке.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Связь с родителями — через вожатого. Позвонить вечером — всегда можно. Наш опыт: большинство детей уже на второй день перестают скучать по телефону. Они просто заняты.
        </p>

        <div class="mt-4 bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-info-circle text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-[15px] font-bold text-slate-900 mb-1">Совет перед отъездом</div>
            <div class="text-[14px] text-slate-700 leading-[1.6]">
              Договоритесь с ребёнком заранее: «Звоним по вечерам, раз в 2 дня». Это снижает тревогу у обоих. Дети, у которых есть чёткая договорённость, адаптируются быстрее.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Правила отношений в отряде
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хорошие лагеря чётко прописывают правила общения — не только «не дерись», но и «уважай пространство другого» и «не высмеивай». В АйДаКемп это часть вводного дня: вожатые проводят разговор о правилах отряда вместе с детьми.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Никакого буллинга и унижений</strong> — ни словесных, ни физических. Это красная линия. Вожатые реагируют сразу.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Уважение к чужим вещам</strong> — не брать без спроса, вернуть в том же виде. Звучит очевидно, но важно проговорить это до конфликтов.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Участие в жизни отряда</strong> — дежурства, уборка комнаты, совместные активности. Это не наказание, это быт. Дети привыкают к ответственности за общее пространство.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Право на «нет»</strong> — можно отказаться от активности, если не хочется. Но предупредить вожатого и объяснить, почему. Уважение работает в обе стороны.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что запрещено: список без сюрпризов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Большинство запретов — это просто здравый смысл. Ничего неожиданного, но лучше знать заранее.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Покидать территорию без сопровождения</strong> — ни в магазин, ни «просто посмотреть». Лагерь несёт юридическую ответственность за каждого ребёнка.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Алкоголь и энергетики</strong> — полный запрет, без исключений.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Острые предметы и пиротехника</strong> — перочинный нож, петарды и всё похожее сдаются при заселении и возвращаются при отъезде.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Хождение после отбоя</strong> — по коридорам и тем более на улице. Это вопрос безопасности, а не строгости вожатых.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-lg text-red-400 shrink-0 mt-1 text-[12px]" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Большие суммы наличных и ценности</strong> — дорогие украшения, брендовые вещи. В общем пространстве они теряются или повреждаются.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Система игровых рублей — правила вместо запретов
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Одно из ключевых правил АйДаКемп — не запрещать, а создать среду где делать правильное выбирается само. Именно для этого работает система игровых рублей (далее под рублями — внутренняя игровая валюта лагеря, к реальным деньгам не относится).
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Как это устроено: каждый день все получают 500 рублей просто за прожитый день плюс 100 за уборку комнаты. Итого 600 рублей в день без условий — как в Монополии, когда проходишь круг и получаешь 200. Дальше — сам решаешь.
        </p>
        <ul class="flex flex-col gap-3 max-w-[680px] mb-4">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-coin text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>За что зарабатывают рубли:</strong> прожитый день (+500), уборка комнаты (+100), помощь другим ребятам, активное участие в занятиях — вожатые могут начислять бонусы.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-cart text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>На что тратят:</strong> экранное время (1 минута = 10 рублей), кино на вечер, ночь с гаджетами, отбой на час позже, физические призы из магазина лагеря.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-x-circle-fill text-red-400 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Штрафы:</strong> за нарушения (опоздание, нарушение правил отряда) с личного счёта снимаются рубли. Без криков, без унижений — просто последствие выбора.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Система не про наказания. Она про то что ребёнок сам принимает решения и сам видит их результат — в безопасной среде, где максимальная потеря это несколько тысяч игровых рублей.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как подготовить ребёнка к правилам лагеря
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Главная ошибка родителей — ничего не говорить заранее. Ребёнок приезжает и сталкивается с незнакомыми требованиями. Это стрессово.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Поговорите дома: «Там будут правила — как в школе, только немного другие. Телефон сдашь на хранение, зато будешь занят с утра до вечера. И да, отбой есть — но это чтобы не ходить на занятия как зомби». Когда ребёнок знает, чего ожидать — он принимает правила гораздо легче.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В АйДаКемп мы рассказываем о правилах в первый день — вместе с детьми, без занудства. Обычно вопросов остаётся мало.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-[15px] font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Хотите узнать больше про АйДаКемп?"
    bookingSubtitle="Расскажем про правила, программу и что ждёт ребёнка на смене — пишите."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
<script>
  document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = item.querySelector('[data-faq-answer]');
      const icon = btn.querySelector('[data-faq-icon]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        answer.classList.remove('is-open');
        if (icon) icon.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.add('is-open');
        if (icon) icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
</Base>
