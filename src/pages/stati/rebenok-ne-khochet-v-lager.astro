    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  .matrix-block {
    background: #f9fafb;
    border-radius: 1rem;
    padding: 1.5rem 2rem;
    margin: 2rem 0;
  }
  .matrix-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .matrix-cell {
    padding: 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
  }
  .matrix-cell.green { background: #f0fdf4; border: 2px solid #86efac; }
  .matrix-cell.blue { background: #eff6ff; border: 2px solid #93c5fd; }
  .matrix-cell.red { background: #fef2f2; border: 2px solid #fca5a5; }
  .matrix-cell.yellow { background: #fefce8; border: 2px solid #fde047; }
