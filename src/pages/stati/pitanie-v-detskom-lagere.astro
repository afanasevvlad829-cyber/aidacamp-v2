---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { SEASON_YEAR } from '../../data/shifts';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Жизнь в лагере", url: "/stati/zhizn-v-lagere-dlya-detej/", icon: "sun", description: "Как проходит обычный день" },
  { title: "О лагере АйДаКемп", url: "/o-lagere/", icon: "info-circle", description: "Территория и условия" },
  { title: "Лагерь с бассейном", url: "/lager-s-basseynom/", icon: "droplet", description: "Бассейн и спортивные активности" },
  { title: "Записаться на смену", url: "/ceny/", icon: "calendar-check", description: `Смены лета ${SEASON_YEAR}` },
];

const faqItems = [
  {
    question: "Учитываются ли аллергии при питании?",
    answer: "Да. При оформлении путёвки мы спрашиваем про аллергии и пищевые ограничения. Медик и повар получают список до начала смены. На месте аллергенные продукты заменяются. Если у ребёнка сложная ситуация с питанием — свяжитесь с нами заранее, обсудим индивидуально."
  },
  {
    question: "Можно ли передавать еду ребёнку?",
    answer: "Небольшое количество сладкого в закрытой упаковке — можно. Скоропортящиеся продукты, домашняя еда, йогурты — нельзя. Это требование СанПиН для общественного питания, не наша прихоть. У нас пятиразовое меню — никто не голодает. Передача еды создаёт неравенство в отряде, а это сложная история."
  },
  {
    question: "А если ребёнок привередливый в еде?",
    answer: "У нас почти все ребята едят лучше, чем дома. Активность, свежий воздух, компания — аппетит появляется сам. Если ребёнок не ест что-то конкретное — скажите нам при оформлении. Повар готовит с запасом вариантов. Но предупреждаем: у нас школьники часто пробуют то, от чего дома отказывались."
  },
  {
    question: "Кто составляет меню лагеря?",
    answer: "Меню составляет шеф-повар совместно с медработником лагеря — с учётом норм питания по СанПиН для детских оздоровительных организаций. Планируется на неделю вперёд, утверждается до начала смены. Родители могут запросить меню при бронировании. Готовят на месте — привозных полуфабрикатов нет."
  },
  {
    question: "Как сообщить о пищевой аллергии ребёнка?",
    answer: "При оформлении путёвки в анкете есть специальный раздел про аллергии и пищевые ограничения. Дополнительно — напишите менеджеру за 5–7 дней до заезда, чтобы информация точно дошла до повара. При сложных аллергиях (например, целиакия или несколько аллергенов одновременно) — свяжитесь с нами заблаговременно, согласуем индивидуальное меню."
  }
];
---

<Base
  title={`Питание в детском лагере: еда и меню для детей | АйДаКемп ${SEASON_YEAR}`}
  description="Как устроено питание в детском лагере АйДаКемп: 5-разовое меню, учёт аллергий, правила про сладкое, никаких полуфабрикатов — готовим на месте. Родители часто пишут про еду в отзывах — и вот почему."
  ogImage="/images/hero/lager-na-leto-2026.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Питание в детском лагере — что едят дети в АйДаКемп",
        "description": "Как устроено питание в детском лагере АйДаКемп: 5-разовое меню, учёт аллергий, правила про сладкое.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere", "sameAs": ["https://aidacamp.ru/o-lagere"]},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-04-25",
        "dateModified": "2026-04-25",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://aidacamp.ru/stati/pitanie-v-detskom-lagere"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ])} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Питание и еда в лагере: 5-разовое меню, учёт аллергий"
    subtitle="Еда у нас — одна из самых обсуждаемых тем в родительских чатах. Рассказываем как есть на самом деле."
    imageBase="lager-na-leto-2026"
    imageAlt="Дети обедают в столовой летнего лагеря"
    readTime="5 мин чтения"
    breadcrumbsLast="Питание в детском лагере"
    daryaQuote="Знаете, про что больше всего пишут в отзывах после смены? Что дочь вернулась домой и попросила готовить «как в лагере». Это и есть лучший отзыв о кухне."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">
    <article>

      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Еда в детском лагере — это не просто «чем кормят». Это часть общего ощущения от смены. Когда ребёнок вкусно поел, у него больше сил на занятия и активности. Когда не поел — настроение падает, и всё остальное тоже. Поэтому к кухне в АйДаКемп относимся серьёзно.
         Столовая и продуманный рацион для ребёнка в летнем оздоровительном лагере — это не «какая-то пища на отдыхе», а меню, которое в Подмосковье и Москве проверяют строже, чем дома.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            5-разовое питание: что и когда
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Пять приёмов пищи в день — это не маркетинг, а норма СанПиН для детских оздоровительных организаций. Родители часто спрашивают, какая еда в лагере на самом деле, а не в рекламных фото — у ребят активный день, и регулярный режим питания реально работает на самочувствие.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Завтрак (~08:45)</strong> — каша или яичное блюдо, хлеб с маслом или сыром, чай или какао. Плотный старт перед IT-занятиями.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Второй завтрак (~11:00)</strong> — фрукты или йогурт. Небольшой, но важный перекус в середине утреннего блока.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Обед (~13:00)</strong> — первое (суп), второе (мясо или рыба с гарниром), салат, компот или сок. Обед в лагере полноценный, а не для галочки.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Полдник (~16:30)</strong> — выпечка или творожный десерт, молоко или кефир. После спортивного блока.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Ужин (~19:00) + вечерний перекус (~21:30)</strong> — горячее блюдо и чай с печеньем или булочкой перед сном.</span>
          </li>
        </ul>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что бывает на столе — примерное меню
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Меню составляется на неделю вперёд с учётом норм детского питания. Никакой экзотики — понятная, вкусная еда:
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Завтраки: гречневая каша с маслом, омлет, блинчики, творожная запеканка</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Супы: борщ, куриный суп с лапшой, суп с фрикадельками, рассольник</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Вторые блюда: котлеты с пюре, курица с рисом, рыба с овощами, гуляш с макаронами</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Гарниры: картофельное пюре, рис, гречка, тушёные овощи</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Салаты: из свежих овощей, из огурцов и помидоров, витаминный с морковью</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700">Напитки: компот, кисель, сок, чай, какао, молоко</span>
          </li>
        </ul>
        <p class="text-base text-slate-500 mt-3 italic">Полуфабрикаты из магазина и фастфуд — не используем.</p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Аллергии и пищевые ограничения
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Это самый частый вопрос от родителей перед сменой. И правильный вопрос.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          При оформлении путёвки мы собираем информацию об аллергиях. До начала смены медик и повар получают список. На заезде ещё раз уточняем у родителя — особенно если реакция серьёзная.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Если ребёнок не ест рыбу, яйца, орехи или молочные продукты — заменяем на альтернативу. Если ситуация нестандартная (например, целиакия) — обсудим отдельно до начала смены.
        </p>

        <div class="mt-4 bg-orange-50 border border-orange-200 rounded-2xl p-5 flex items-start gap-4">
          <i class="bi bi-info-circle text-orange-500 text-[22px] shrink-0 mt-0.5" aria-hidden="true"></i>
          <div>
            <div class="text-base font-bold text-slate-900 mb-1">Важно: напишите нам заранее</div>
            <div class="text-base text-slate-700 leading-[1.6]">
              Не ждите заезда. Чем раньше мы знаем про аллергию — тем лучше подготовимся. Напишите при бронировании или свяжитесь с менеджером за неделю до смены.
            </div>
          </div>
        </div>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сладкое и передачи от родителей
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Сразу честно: сладкое у нас регулируется. Это не запрет — это правила общего питания.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Небольшая коробка конфет или шоколадка при заезде — пожалуйста. Но если привезти целый пакет, медик попросит сдать лишнее на хранение. Причина простая: если у одного ребёнка много сладкого, а у другого нет — это создаёт напряжение в отряде. И это требование СанПиН, не наша прихоть.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Скоропортящиеся продукты (йогурты, фрукты, бутерброды) привозить не нужно: кормим досыта, никто не голодает. Зелёное яблоко в кармане — ок. Пакет продуктов — нет.
        </p>
      </div>

      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="list-accent-dot"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Кто отвечает за питание в АйДаКемп
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          За кухню отвечают две ключевые фигуры: шеф-повар и медработник. Они работают в паре — повар готовит, медработник контролирует соответствие нормам СанПиН и учитывает ограничения по здоровью ребят.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <i class="bi bi-person-check text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Шеф-повар</strong> — составляет меню на неделю, готовит на месте (не привозная еда), работает со списком аллергий каждого ребёнка.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-person-check text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Медработник</strong> — проверяет меню на соответствие нормам, хранит список аллергенов, следит чтобы ребёнок с ограничениями получал правильную тарелку.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <i class="bi bi-people text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>
            <span class="text-[16px] text-slate-700"><strong>Вожатые</strong> — сопровождают отряд на каждый приём пищи, следят чтобы никто не пропустил еду, помогают ребятам с тарелками в первые дни.</span>
          </li>
        </ul>
        <p class="text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          Четырёхразовое меню — это обязательный минимум по СанПиН. В АйДаКемп 5 приёмов пищи: стандартные четыре плюс вечерний перекус перед сном. Активный день требует дополнительной энергии.
        </p>
      </div>

      <BlogCTA variant="default" />

      <!-- FAQ аккордеон -->
      <section class="mt-12 mb-8">
        <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="w-[4px] h-[28px] bg-primary rounded-full flex-shrink-0"></span>
          Частые вопросы
        </h2>
        <div class="space-y-3">
          {faqItems.map(item => (
            <div class="rounded-[14px] border border-slate-200 bg-slate-50" data-faq-item>
              <button type="button" data-faq-toggle class="flex w-full cursor-pointer items-center justify-between p-4 text-left text-base font-semibold text-slate-900" aria-expanded="false">
                <span>{item.question}</span>
                <span class="ml-3 shrink-0 text-lg text-slate-400 transition-transform duration-200" data-faq-icon aria-hidden="true">+</span>
              </button>
              <div class="px-4 pb-4 text-[16px] leading-[1.55] text-slate-600" data-faq-answer>
                <p>{item.answer}</p>              </div>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <ArticleBottomCta
    bookingTitle="Есть вопросы про еду или аллергии?"
    bookingSubtitle="Напишите нам — всё расскажем и при необходимости согласуем меню заранее."
  />

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
<script>
  import { initFaqAccordion } from '../../scripts/faq-accordion';
  initFaqAccordion();
</script>
</Base>
