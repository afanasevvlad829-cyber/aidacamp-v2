---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';

const relatedPages = [
  { title: "Проблемы в общении подростков", url: "/stati/problemy-v-obschenii-podrostkov", icon: "chat-quote", description: "Как хакатон помогает открыться" },
  { title: "Низкая самооценка у ребёнка", url: "/stati/nizkaya-samootsenka-u-rebenka", icon: "chat", description: "Первая победа меняет самовосприятие" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov", icon: "people", description: "Среда хакатонов" },
];
---

<Base
  title="Хакатон в детском лагере: как за 10 часов ребёнок создаёт стартап | АйДаКемп"
  description="Хакатон «Стартап из будущего» в IT-лагере АйДаКемп — 10 часов от идеи до питча перед инвесторами. Роли, бюджет, ИИ-инструменты. Дети 7–15 лет."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/hakaton-v-detskom-lagere" />
      <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Хакатон в детском лагере: как за 10 часов ребёнок создаёт стартап",
      "author": { "@type": "Organization", "name": "АйДаКемп" },
      "publisher": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "datePublished": "2026-03-20",
      "url": "https://aidacamp.ru/stati/hakaton-v-detskom-lagere"
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Хакатон в детском лагере: как за 10 часов ребёнок проживает путь от идеи до питча"
    subtitle="Почему навыки командной работы нельзя преподать на уроке — но можно прожить на хакатоне."
    imageBase="hakaton"
    imageAlt="Дети работают на хакатоне в IT-лагере АйДаКемп"
    imagePosition="center 75%"
    date="Март 2026"
    readTime="5 мин чтения"
    breadcrumbsLast="Хакатон в детском лагере"
    daryaQuote="Дочь пришла после хакатона с горящими глазами: «Мама, мы сделали стартап!» Именно это ощущение — что ты справился — не купишь ни на каком онлайн-курсе."
  />

  <main class="mx-auto max-w-[860px] px-4 pt-8 pb-0 md:pt-12">

    <!-- Article content -->
    <article>

      <!-- Intro -->
      <div class="mb-10">
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Научить ребёнка программировать — не самая сложная задача. Есть Scratch, есть Python, есть тысяча курсов. А вот научить договариваться, распределять роли, укладываться в дедлайн и защищать свою работу перед незнакомыми людьми — это другой уровень. И обычно этому не учат нигде.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mt-4">
          В АйДаКемп мы решили это изменить. В финале каждой смены проходит хакатон «Стартап из будущего» — и это самый интенсивный день за все десять.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Не олимпиада и не конкурс поделок
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Хакатон — это не «кто быстрее напишет код». И не выставка проектов, где все получают грамоты за участие. Это симуляция настоящего стартапа: с ролями, бюджетом, инвесторами и жёстким таймингом.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Каждая команда получает стартовый капитал в специальных фишках. Фишки тратятся на «покупку» консультаций у менторов, доступ к технологиям, дополнительные ресурсы. Кончились фишки — работаешь с тем, что есть. Или идёшь договариваться с другой командой.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Роли распределены как в реальной компании:
        </p>
        <ul class="flex flex-col gap-2 mt-4">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Хакер</strong> — техническая реализация</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Дизайнер</strong> — интерфейс и визуал</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Маркетолог</strong> — название, слоган, продвижение</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Финансовый директор</strong> — бюджет и ресурсы</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700"><strong>Стратег</strong> — общее видение и питч</span></li>
        </ul>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            10 часов от нуля до питча
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Тайминг жёсткий. За 8–10 часов команда должна пройти полный цикл:
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Генерация идей.</strong> Первый час — мозговой штурм. Дети придумывают приложение, сервис или продукт, который решает реальную проблему. Не «ещё одна игра», а что-то, что можно объяснить инвестору.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Паспорт приложения.</strong> Второй час — формализация. Кто целевая аудитория? Какую проблему решаем? Чем отличаемся от конкурентов? Для одиннадцатилетнего сформулировать ценностное предложение — уже подвиг.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Прототип.</strong> Три-четыре часа — на создание рабочего прототипа. Кто-то делает в Figma, кто-то пишет бота, кто-то собирает лендинг. ИИ-инструменты используются открыто: генерация логотипов, маркетинговых текстов, названий.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Презентация.</strong> Последние два часа — подготовка питча. Слайды, речь, демонстрация. Репетиция. Паника. Ещё одна репетиция.</span>
          </li>
        </ul>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Два раунда инвестиций
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Посередине хакатона — первый раунд инвестиций. Команды представляют промежуточные результаты жюри. Жюри задаёт вопросы и распределяет дополнительные фишки. Кто убедительнее — тот получает больше ресурсов на вторую половину.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          Финальный питч — второй раунд. Здесь уже полноценная защита: три минуты на презентацию, две минуты на вопросы. Оценивается не только продукт, но и то, как команда его подаёт. Дети, которые утром стеснялись говорить вслух, к вечеру стоят перед аудиторией и защищают свой стартап. Это происходит каждую смену.
        </p>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему это развивает больше, чем кружок программирования
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Кружок учит писать код. Хакатон учит всему остальному.
        </p>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Работа в команде.</strong> Нельзя быть «самым умным» и тянуть одеяло. У дизайнера нет доступа к коду, у хакера нет навыков презентации. Приходится доверять.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Управление ресурсами.</strong> Фишки кончаются. Время кончается. Нужно решать: потратить на консультацию или сэкономить на финал? Инвестировать в дизайн или в функциональность?</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Переговоры.</strong> Между командами идёт обмен: «мы поможем вам с дизайном, а вы нам — с кодом». Иногда команды сливаются. Иногда — разваливаются и собираются заново.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Публичные выступления.</strong> Три минуты перед жюри — это стресс. Но стресс управляемый, в безопасной среде. После первого питча второй даётся легче.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span>
            <span class="text-[16px] text-slate-700"><strong>Работа с обратной связью.</strong> Жюри не ставит оценки — оно задаёт вопросы. Дети учатся отвечать на неудобные вопросы, а не обижаться на них.</span>
          </li>
        </ul>
      </div>

      <!-- Section 5 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что это даёт за пределами лагеря
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Родители часто ждут от лагеря «навыков программирования». И дети правда их получают — за десять дней каждый собирает проект, будь то бот, игра или сайт. Но хакатон даёт другое — опыт, который пригодится независимо от того, станет ребёнок программистом или нет.
        </p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Умение формулировать идею так, чтобы её поняли другие</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Умение работать в команде, где не все согласны</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Умение принимать решения в условиях ограниченного времени и ресурсов</span></li>
          <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400"></span><span class="text-[16px] text-slate-700">Умение проигрывать — и пробовать снова</span></li>
        </ul>
      </div>

      <!-- Section 6 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Хакатон + внутренняя экономика = двойной опыт
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px]">
          В АйДаКемп хакатон не существует в вакууме. Всю смену ребята живут в системе внутренней экономики — управляют личным бюджетом, принимают решения о тратах, участвуют в коллективных покупках. А на хакатоне каждый управляет ресурсами стартапа. Получается два экономических опыта за одну смену: ежедневный — про личные финансы, и интенсивный — про бизнес. Один учит считать, другой учит рисковать. Вместе — учат думать.
        </p>
      </div>

      <!-- CTA -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Для кого это
          </h2>
        </div>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          АйДаКемп — выездной IT-лагерь в Подмосковье для детей 7–15 лет. 66 км от Москвы, смены от 7 до 15 дней. Бассейн, 5-разовое питание, образовательная лицензия (налоговый вычет 13%). <a href="/ceny" class="text-orange-700 underline underline-offset-2 hover:text-orange-900">Смены лета 2026 — даты и цены</a>.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-4">
          Четыре трека обучения: Python, AI, дроны, 3D-моделирование. Итог смены — собственный проект и хакатон.
        </p>
        <p class="text-[16px] md:text-[16px] leading-[1.7] text-slate-600 max-w-[720px] mb-6">
          Если ваш ребёнок умеет кодить — отлично, он углубит навыки. Если не умеет — тоже отлично, он начнёт. Но в любом случае он уедет с опытом, который не даст ни одна школа: опытом настоящего дела от идеи до результата.
        </p>
      </div>

    </article>
  </main>
  <ArticleBottomCta
    bookingTitle="Первый хакатон — может быть этим летом"
    bookingSubtitle="Оставьте телефон — перезвоним за 10 минут, расскажем про ближайшую смену."
  />

  <RelatedPages title="Похожие статьи" pages={relatedPages} />
  <Footer />
</Base>
