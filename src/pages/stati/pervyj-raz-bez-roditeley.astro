---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleBottomCta from '../../components/ArticleBottomCta.astro';
import StatCallout from '../../components/StatCallout.astro';
import RelatedArticlesAuto from '../../components/RelatedArticlesAuto.astro';

const relatedPages = [
  { title: "Детский лагерь АйДаКемп", url: "/detskiy-lager/", icon: "house-door", description: "Всё о программе и сменах" },
  { title: "Первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", icon: "star-fill", description: "Советы для первого заезда" },
  { title: "Адаптация ребёнка в лагере", url: "/stati/adaptaciya-rebenka-v-lagere/", icon: "heart-pulse-fill", description: "Как помочь освоиться" },
  { title: "Лагерь для подростков", url: "/lager-dlya-podrostkov/", icon: "people", description: "Программа для 10–16 лет" },
];

const faqItems = [
  {
    question: "Можно ли забрать ребёнка досрочно?",
    answer: "Да, в любой момент. Просто предупредите администратора заранее — мы подготовим вещи и документы. Специального разрешения не требуется."
  },
  {
    question: "Как узнать, что с ребёнком всё хорошо?",
    answer: "Каждый вечер в Telegram-канал отряда выкладываем фото и короткую сводку дня. Вы видите, чем занимался ребёнок, с кем подружился, что ел. Для большинства мам это закрывает все вопросы без лишних звонков."
  },
  {
    question: "Что делать, если ребёнок плачет и просится домой?",
    answer: "Это случается — особенно в первые 1–2 дня. Вожатые знают, как с этим работать: переключают внимание, находят точку входа в группу, дают позвонить маме. Если по истечении суток состояние не меняется — сами звоним родителям и обсуждаем ситуацию."
  },
  {
    question: "Можно ли приехать в гости во время смены?",
    answer: "По общему правилу — нет: это мешает ребёнку адаптироваться и выстраивать отношения в отряде. Но в исключительных случаях (медицинские или семейные обстоятельства) — обсуждаем индивидуально."
  },
];
---

<Base
  title="Ребёнок первый раз без родителей — как подготовиться"
  description="Страхи родителей и детей перед первым лагерем. Как говорить с ребёнком, что брать, как контролировать. Опыт мам."
  ogImage="/images/hero/detskiy-lager.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Ребёнок первый раз без родителей: как подготовить и не бояться",
        "description": "Страхи родителей и детей перед первым лагерем. Как говорить с ребёнком, что брать, как контролировать. Опыт мам.",
        "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
        "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
        "datePublished": "2026-05-15",
        "dateModified": "2026-05-15",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "https://aidacamp.ru/stati/pervyj-raz-bez-roditeley/"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
          {"@type": "ListItem", "position": 2, "name": "Статьи", "item": "https://aidacamp.ru/stati/"},
          {"@type": "ListItem", "position": 3, "name": "Ребёнок первый раз без родителей", "item": "https://aidacamp.ru/stati/pervyj-raz-bez-roditeley/"}
        ]
      }
    ])} />
  </Fragment>
  <Header />
  <ArticleHero
    title="Ребёнок первый раз без родителей: как подготовить и не бояться"
    subtitle="Страхи мамы, страхи ребёнка и то, как это всё работает на практике"
    breadcrumb="Первый раз без родителей"
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Подросток в лагере впервые без родителей — новые друзья и новый опыт"
  />
  <main class="mx-auto max-w-[760px] px-4 py-10 prose prose-slate">

    <h2>Страхи родителей — нормально, и что с ними делать</h2>
    <p>
      «А вдруг заскучает и будет плакать?», «А вдруг обидят?», «А вдруг заболеет и никто не заметит?», «А вдруг плохо кормят?» — это стандартный внутренний список любой мамы перед первым лагерем. И это абсолютно нормально.
    </p>
    <p>
      Плохая новость: полностью убрать эти страхи не получится. Хорошая: большинство из них не реализуются. По нашему опыту, дети, которые «точно будут скучать», на второй день уже забывают звонить. Те, кого «точно обидят», к концу первой недели обзаводятся лучшим другом на отряд. Те, кто «точно не будет есть» — съедают всё и просят добавку.
    </p>
    <p>
      Что реально помогает: конкретная информация. Не «там будет хорошо», а «там будет Telegram-канал с фото каждый день, и ты увидишь сама». Страхи живут там, где нет информации. Дайте себе конкретный канал контроля — и тревога снизится.
    </p>

    <StatCallout
      value="2–3 дня"
      label="обычно нужно ребёнку, чтобы адаптироваться и перестать скучать по дому"
      source="Опыт вожатых АйДаКемп"
      icon="clock"
      tone="info"
    />

    <h2>Страхи ребёнка — как с ними говорить</h2>
    <p>
      У ребёнка свои страхи, и они не всегда совпадают с родительскими. Его тревожит другое: «А вдруг я никому не понравлюсь?», «А вдруг там все уже знают друг друга?», «А вдруг я не справлюсь с заданиями?».
    </p>
    <p>
      Это страх одиночества и страх быть «не таким». Они очень конкретные — и с ними можно работать конкретно. Не «там будет весело», а «там все приедут так же, как ты — никто никого не знает заранее. Первый день у всех одинаковый».
    </p>
    <p>
      Ещё важно: не обесценивать страх. «Да ладно, ты же взрослый» работает плохо. Лучше: «Я понимаю, что волнуешься. Я тоже волнуюсь немного. Давай договоримся — если будет совсем плохо, ты позвонишь, и мы поговорим». Это даёт ощущение, что выход всегда есть — и тревога уходит.
    </p>

    <h2>Как подготовить ребёнка к первому лагерю без родителей</h2>
    <p>
      Подготовка начинается не за неделю, а за месяц — и она не про список вещей. Главное — разговор по-взрослому.
    </p>
    <p>
      Объясните формат: что это за место, кто такие вожатые, как устроен день. Не продавайте — просто рассказывайте факты. «Утром занятия, после обеда — активности, вечером — общие мероприятия. Живёте в комнатах по несколько человек. Кормят четыре раза».
    </p>
    <p>
      Договоритесь о звонках заранее. «Я позвоню тебе в первый день вечером, потом через день». Конкретное время снимает тревогу — ребёнок знает, когда ждать, и не висит в неопределённости. А вы не срываетесь с пятью звонками в день от собственного беспокойства.
    </p>
    <p>
      Соберите вещи вместе. Пусть ребёнок сам выбирает, какую футболку взять и какие наушники. Ощущение контроля над собственными вещами снижает тревогу перед поездкой.
    </p>

    <StatCallout
      value="Telegram-канал"
      label="отряда с фото каждый вечер — родители видят, чем занимается ребёнок"
      source="АйДаКемп"
      icon="chat-dots"
      tone="neutral"
    />

    <h2>Как устроена связь с ребёнком в АйДаКемп</h2>
    <p>
      В АйДаКемп у каждого ребёнка смартфон хранится в именном боксе — это помогает не отвлекаться на занятиях и лучше включаться в жизнь отряда. Это не «мы забрали телефон» — это договор, о котором мы честно говорим на берегу.
    </p>
    <p>
      Для связи с родителями — два канала. Первый: Telegram-канал отряда, куда каждый вечер мы выкладываем фото и короткий дайджест дня. Что делали, что ели, кто особенно отличился на занятиях. Большинству мам этого хватает — они видят лица и понимают, что всё хорошо. Второй: звонки в определённые часы — как правило, вечером после ужина.
    </p>
    <p>
      Если что-то пошло не так — вожатый звонит родителям сам, не ждёт. Мы не скрываем ни болячек, ни конфликтов, ни сложностей с настроением. Родители — партнёры, а не люди, от которых нужно прятать информацию.
    </p>

    <h2>История: первый звонок на третий день</h2>
    <p>
      Я сама через это проходила. Когда моя дочь поехала первый раз — в 11 лет — я честно не знала, что делать с собой в первый день. Проверяла телефон каждые полчаса, хотя понимала, что она уже в автобусе.
    </p>
    <p>
      Первый звонок был вечером первого дня. «Мам, тут нормально. Девочки в комнате классные. Завтра будет квест». Не «скучаю», не «хочу домой» — просто факты. Я зависла, потому что ждала чего-то другого.
    </p>
    <p>
      На третий день она не позвонила в обычное время. Я написала вожатому. «Всё хорошо — они были на вечернем мероприятии, только зашли в корпус». На четвёртый день позвонила сама — рассказать про то, как они делали сайт на Python. Голос был такой, будто она там уже живёт сто лет.
    </p>
    <p>
      Потом она сказала: «Мам, я не ожидала, что так понравится». Я тоже не ожидала — ни того, что понравится так сильно, ни того, что я так быстро перестану переживать. Третий день — это примерно тот момент, когда отпускает обеих.
    </p>

    <h2>Часто задаваемые вопросы</h2>
    {faqItems.map(item => (
      <details class="mb-4 rounded-[12px] border border-slate-200 p-4">
        <summary class="font-semibold cursor-pointer text-slate-900">{item.question}</summary>
        <p class="mt-3 text-slate-600">{item.answer}</p>
      </details>
    ))}

  </main>
  <ArticleBottomCta
    title="Первый раз в лагере — вместе сделаем его лучшим"
    subtitle="Вожатые АйДаКемп знают, как провести ребёнка через первые дни мягко."
    buttonText="Выбрать смену"
    buttonUrl="/zapisatsya/"
  />
  <RelatedPages pages={relatedPages} />
  <RelatedArticlesAuto />
  <Footer />
</Base>
