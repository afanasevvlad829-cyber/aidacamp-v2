---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Смены 2026", url: "/ceny", icon: "calendar", description: "Даты и стоимость смен" },
  { title: "О лагере", url: "/o-lagere", icon: "house-heart", description: "Как устроена жизнь в АйДаКемп" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-lagere", icon: "trophy", description: "Монеты, призы и командная битва" },
];
---

<Base
  title="Почему в лагере едят больше, чем дома — и это нормально | АйДаКемп"
  description="Объясняю, зачем пятиразовое питание, почему порции кажутся большими и сколько калорий нужно активному подростку в лагере. Без терминов, по-человечески."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/stati/pitanie-v-lagere" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Почему в лагере едят больше, чем дома — и это нормально",
      "description": "Объясняю, зачем пятиразовое питание, почему порции кажутся большими и сколько калорий нужно активному подростку в лагере.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-12",
      "dateModified": "2026-06-12",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/pitanie-v-lagere"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Почему в лагере едят больше, чем дома — и это нормально"
    subtitle="Первые два дня смены несколько мам пишут одно и то же: «он говорит, что постоянно голодный». Это не жалоба на питание. Это физиология."
    imageBase="lager-programmirovaniya"
    imageAlt="Питание в IT-лагере АйДаКемп — пятиразовое меню для активных ребят"
    breadcrumbsLast="Питание в лагере"
    readTime="5 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Дома — компьютер, диван, в лучшем случае школа и обратно. В лагере с 8 утра до 22 вечера в движении: занятия, улица, игры, бассейн, вечерние мероприятия. Тело тратит в полтора раза больше, чем обычно. И просит соответственно.
        </p>
      </div>

      <!-- Section 1 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сколько калорий нужно активному подростку в лагере
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Вот цифры, которые мы держим в голове при составлении меню:
        </p>

        <div class="my-6 rounded-[16px] overflow-hidden border border-slate-100">
          <table class="w-full text-[14px]">
            <thead>
              <tr class="bg-slate-50">
                <th class="text-left px-4 py-3 text-slate-500 font-semibold">Возраст</th>
                <th class="text-center px-4 py-3 text-slate-500 font-semibold">Норма дома</th>
                <th class="text-center px-4 py-3 text-orange-500 font-semibold">В активном лагере</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">7–8 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">1 700–1 900</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">2 100–2 400</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">9–10 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">1 900–2 100</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">2 400–2 700</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">11–12 лет (мальчики)</td>
                <td class="px-4 py-3 text-center text-slate-500">2 100–2 300</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">2 700–3 100</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">11–12 лет (девочки)</td>
                <td class="px-4 py-3 text-center text-slate-500">1 900–2 100</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">2 500–2 900</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">13–14 лет (мальчики)</td>
                <td class="px-4 py-3 text-center text-slate-500">2 300–2 600</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 000–3 500</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">13–14 лет (девочки)</td>
                <td class="px-4 py-3 text-center text-slate-500">2 100–2 300</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">2 700–3 100</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600">
          Наше меню на обычный день — около 3 000 калорий. Для старших подростков в насыщенный день это почти точное попадание. Для семилетки — с небольшим запасом, потому что растущий организм тратит часть энергии не на движение, а буквально на рост костей и мышц.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что реально тратится за день
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Четыре часа за компьютером на занятиях — это не «сидит без дела». Мозг в режиме обучения и концентрации сжигает примерно столько же, сколько неспешная прогулка. Полтора часа игр на улице — уже активный расход, сравнимый с лёгкой тренировкой.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Час в бассейне или на насыщенном вечернем мероприятии добавляет ещё. Плюс сон — тело восстанавливается и растёт, и это тоже требует энергии. В сумме выходит 2 400–2 600 калорий расхода.
        </p>

        <div class="my-6 rounded-[16px] bg-[#FFF3EC] px-6 py-5">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-orange-400 mb-4">КАК ТРАТИТСЯ ДЕНЬ</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="rounded-[12px] bg-white px-4 py-4 text-center">
              <div class="text-[22px] font-bold text-orange-500">~300</div>
              <div class="text-[12px] text-slate-500 mt-1">занятия 4 ч</div>
            </div>
            <div class="rounded-[12px] bg-white px-4 py-4 text-center">
              <div class="text-[22px] font-bold text-orange-500">~400</div>
              <div class="text-[12px] text-slate-500 mt-1">улица 1.5 ч</div>
            </div>
            <div class="rounded-[12px] bg-white px-4 py-4 text-center">
              <div class="text-[22px] font-bold text-orange-500">~350</div>
              <div class="text-[12px] text-slate-500 mt-1">бассейн / вечер</div>
            </div>
            <div class="rounded-[12px] bg-white px-4 py-4 text-center">
              <div class="text-[22px] font-bold text-emerald-600">рост</div>
              <div class="text-[12px] text-slate-500 mt-1">ночное восстановление</div>
            </div>
          </div>
          <p class="text-[12px] text-slate-500 mt-4">Именно поэтому ребята в лагере буквально вытягиваются — не легенда, а арифметика.</p>
        </div>
      </div>

      <!-- Section 3 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему пять приёмов пищи, а не три
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Завтрак, обед, полдник, ужин и второй ужин — это не избыток. Это режим под конкретный ритм дня.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          После завтрака начинаются занятия — мозгу нужна глюкоза прямо сейчас. К обеду уже успевают набегаться. Полдник — небольшой мост между дневной активностью и вечерней программой: без него к ужину приходят голодными и перевозбуждёнными.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Второй ужин — молочный коктейль и вафля — это не лакомство перед сном, а закрытие дефицита. Растущий организм ночью активно работает, и лечь совсем пустым — значит проснуться без сил.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">РЕЖИМ ПИТАНИЯ В ЛАГЕРЕ</p>
          <div class="space-y-2">
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-[13px] font-mono text-slate-400 w-12 shrink-0">8:00</span>
              <span class="text-[14px] font-semibold text-slate-800 w-28 shrink-0">Завтрак</span>
              <span class="text-[13px] text-slate-500">до занятий — мозгу нужно топливо</span>
            </div>
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-[13px] font-mono text-slate-400 w-12 shrink-0">13:00</span>
              <span class="text-[14px] font-semibold text-slate-800 w-28 shrink-0">Обед</span>
              <span class="text-[13px] text-slate-500">после активного утра</span>
            </div>
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-[13px] font-mono text-slate-400 w-12 shrink-0">16:00</span>
              <span class="text-[14px] font-semibold text-slate-800 w-28 shrink-0">Полдник</span>
              <span class="text-[13px] text-slate-500">мост между днём и вечером</span>
            </div>
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-[13px] font-mono text-slate-400 w-12 shrink-0">19:00</span>
              <span class="text-[14px] font-semibold text-slate-800 w-28 shrink-0">Ужин</span>
              <span class="text-[13px] text-slate-500">после вечерних мероприятий</span>
            </div>
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-[13px] font-mono text-slate-400 w-12 shrink-0">21:30</span>
              <span class="text-[14px] font-semibold text-slate-800 w-28 shrink-0">Второй ужин</span>
              <span class="text-[13px] text-slate-500">закрытие ночного дефицита</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4 -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что делать, если говорит «невкусно»
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Это случается. Особенно в первые два дня, пока вкусовые ожидания перестраиваются с домашней еды на другую кухню.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Наш опыт: к третьему дню 9 из 10 ребят едят всё. Исключение — реальные ограничения по здоровью. Об аллергиях и непереносимостях просим предупреждать заранее — подберём замену.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Если «не ем», а не «не могу есть» — это нормальная адаптация. Голодным никто не останется: порции рассчитаны с запасом, и добавку всегда можно попросить.
        </p>
      </div>

    </article>

    <BlogCTA />

    <RelatedPages pages={relatedPages} />
  </main>

  <Footer />
</Base>
