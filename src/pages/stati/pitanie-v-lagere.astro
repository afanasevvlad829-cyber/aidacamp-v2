---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import BlogCTA from '../../components/BlogCTA.astro';

const relatedPages = [
  { title: "Смены 2026", url: "/ceny", icon: "calendar", description: "Даты и стоимость смен" },
  { title: "О лагере", url: "/o-lagere", icon: "house-heart", description: "Как устроена жизнь в АйДаКемп" },
  { title: "Хакатон в лагере", url: "/stati/hakaton-v-lagere", icon: "trophy", description: "Монеты, призы и командная битва" },
];
---

<Base
  title="Почему в лагере едят больше, чем дома — и это нормально | АйДаКемп"
  description="Объясняю, зачем пятиразовое питание, почему порции кажутся большими и сколько калорий нужно активному подростку в лагере. Без терминов, по-человечески."
  ogImage="/images/hero/lager-programmirovaniya.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Почему в лагере едят больше, чем дома — и это нормально",
      "description": "Объясняю, зачем пятиразовое питание, почему порции кажутся большими и сколько калорий нужно активному подростку в лагере.",
      "author": {"@type": "Person", "name": "Дарья Афанасьева", "url": "https://aidacamp.ru/o-lagere"},
      "publisher": {"@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru", "logo": {"@type": "ImageObject", "url": "https://aidacamp.ru/images/logo.svg"}},
      "datePublished": "2026-06-12",
      "dateModified": "2026-06-23",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aidacamp.ru/stati/pitanie-v-lagere"
      }
    })} />
  </Fragment>
  <Header />

  <ArticleHero
    title="Почему в лагере едят больше, чем дома — и это нормально"
    subtitle="Первые два дня смены несколько мам пишут одно и то же: «он говорит, что постоянно голодный». Это не жалоба на питание. Это физиология."
    imageBase="lager-programmirovaniya"
    imageAlt="Питание в IT-лагере АйДаКемп — пятиразовое меню для активных ребят"
    breadcrumbsLast="Питание в лагере"
    readTime="6 мин"
  />

  <main class="mx-auto max-w-[860px] px-4 py-12">
    <article class="prose-custom">

      <div class="mb-10">
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Дома — компьютер, диван, в лучшем случае школа и обратно. В лагере с 8 утра до 22 вечера в движении: занятия, улица, игры, бассейн, вечерние мероприятия. Тело тратит в полтора раза больше, чем обычно. И просит соответственно.
        </p>
      </div>

      <!-- Section 1: Calories by age -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Сколько калорий нужно активному ребёнку в лагере
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Цифры считаются просто: базовый обмен + расходы на рост (у школьников это отдельная статья) × коэффициент активности. В лагере коэффициент — 1,5. Вот что получается:
        </p>

        <div class="my-6 rounded-[16px] overflow-hidden border border-slate-100">
          <table class="w-full text-base">
            <thead>
              <tr class="bg-slate-50">
                <th class="text-left px-4 py-3 text-slate-500 font-semibold">Возраст</th>
                <th class="text-center px-4 py-3 text-slate-500 font-semibold">Пол</th>
                <th class="text-center px-4 py-3 text-slate-500 font-semibold">Норма в лагере</th>
                <th class="text-center px-4 py-3 text-orange-500 font-semibold">Наше меню</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">7–8 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">м/д</td>
                <td class="px-4 py-3 text-center text-slate-500">~2 175</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-emerald-600 font-normal">(с запасом)</span></td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">9–10 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">м/д</td>
                <td class="px-4 py-3 text-center text-slate-500">~2 475</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-emerald-600 font-normal">(+23%)</span></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">11–12 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">мальчики</td>
                <td class="px-4 py-3 text-center text-slate-500">~2 850</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-emerald-600 font-normal">(+7%)</span></td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">11–12 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">девочки</td>
                <td class="px-4 py-3 text-center text-slate-500">~2 625</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-emerald-600 font-normal">(+16%)</span></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">13–14 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">мальчики</td>
                <td class="px-4 py-3 text-center text-slate-500">~3 150</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-amber-500 font-normal">(≈ норма)</span></td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">13–14 лет</td>
                <td class="px-4 py-3 text-center text-slate-500">девочки</td>
                <td class="px-4 py-3 text-center text-slate-500">~2 850</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">3 040 <span class="text-[12px] text-emerald-600 font-normal">(+7%)</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600">
          Для большинства наше меню — 3 040 ккал в день — даёт нужный запас на рост. Небольшой профицит у растущего организма это норма: часть энергии уходит буквально на строительство костей и мышц, а не на движение.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-3">
          Единственное исключение — мальчики 13–14 лет в очень активный день: по расчёту им нужно чуть больше, разница около 3%. Это не проблема: порции в столовой не лимитированы, и добавку можно попросить всегда. Примерно каждый десятый парень-подросток так и делает — просит вторую котлету или добавку каши. Мы к этому готовы.
        </p>
      </div>

      <!-- Section 2: Activity breakdown -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Что реально тратится за день
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Четыре часа за компьютером на занятиях — это не «сидит без дела». Мозг в режиме концентрации тратит примерно столько же, сколько неспешная прогулка. Дальше — улица, бассейн, вечерняя программа. Плюс 9 часов сна, во время которых тело растёт и восстанавливается.
        </p>

        <div class="my-6 rounded-[16px] overflow-hidden border border-slate-100">
          <table class="w-full text-base">
            <thead>
              <tr class="bg-slate-50">
                <th class="text-left px-4 py-3 text-slate-500 font-semibold">Активность</th>
                <th class="text-center px-4 py-3 text-slate-500 font-semibold">Время</th>
                <th class="text-center px-4 py-3 text-slate-500 font-semibold">Расход</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">Занятия программированием</td>
                <td class="px-4 py-3 text-center text-slate-500">4 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~280 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">Прогулки, переходы</td>
                <td class="px-4 py-3 text-center text-slate-500">1,5 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~260 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">Спорт, игры на улице</td>
                <td class="px-4 py-3 text-center text-slate-500">1,5 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~525 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">Бассейн / вечерние мероприятия</td>
                <td class="px-4 py-3 text-center text-slate-500">1 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~400 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 text-slate-700">Сон и отдых</td>
                <td class="px-4 py-3 text-center text-slate-500">9 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~495 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-3 text-slate-700">Еда, личные дела</td>
                <td class="px-4 py-3 text-center text-slate-500">7 ч</td>
                <td class="px-4 py-3 text-center font-medium text-slate-800">~525 ккал</td>
              </tr>
              <tr class="border-t-2 border-slate-200 bg-emerald-50/50">
                <td class="px-4 py-3 font-semibold text-slate-800">Итого расход</td>
                <td class="px-4 py-3 text-center font-semibold text-slate-800">24 ч</td>
                <td class="px-4 py-3 text-center font-semibold text-emerald-700">~2 485 ккал</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-[16px] leading-[1.7] text-slate-600">
          Наше меню покрывает расход с запасом ~550 ккал — это уходит на рост. Именно поэтому ребята в лагере буквально вытягиваются: не легенда, а арифметика.
        </p>
      </div>

      <!-- Section 3: Menu of the day -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Как выглядит обычный день в столовой
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600 mb-5">
          Пример реального меню пятницы с разбивкой по калориям:
        </p>

        <!-- Завтрак -->
        <div class="mb-4 rounded-[16px] overflow-hidden border border-slate-100">
          <div class="bg-orange-50 px-4 py-2.5 flex items-center gap-2">
            <i class="bi bi-sunrise text-base text-orange-500" aria-hidden="true"></i>
            <span class="text-base font-semibold uppercase tracking-[0.05em] text-orange-600">Завтрак — 810 ккал</span>
          </div>
          <table class="w-full text-base">
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Творожная запеканка с джемом</td>
                <td class="px-4 py-2.5 text-center text-slate-400 w-16">130 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600 w-16">210 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-2.5 text-slate-700">Каша гречневая молочная с маслом</td>
                <td class="px-4 py-2.5 text-center text-slate-400">205 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600">145 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Бутерброд со сливочным маслом</td>
                <td class="px-4 py-2.5 text-center text-slate-400">40 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600">170 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-2.5 text-slate-700">Ванильное молочко + йогурт</td>
                <td class="px-4 py-2.5 text-center text-slate-400">305 мл</td>
                <td class="px-4 py-2.5 text-right text-slate-600">205 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Хлеб, чай с сахаром</td>
                <td class="px-4 py-2.5 text-center text-slate-400"></td>
                <td class="px-4 py-2.5 text-right text-slate-600">80 ккал</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Обед -->
        <div class="mb-4 rounded-[16px] overflow-hidden border border-slate-100">
          <div class="bg-orange-50 px-4 py-2.5 flex items-center gap-2">
            <span class="text-base">☀️</span>
            <span class="text-base font-semibold uppercase tracking-[0.05em] text-orange-600">Обед — 960 ккал</span>
          </div>
          <table class="w-full text-base">
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Салат из редиса и огурцов + салат с кальмарами</td>
                <td class="px-4 py-2.5 text-center text-slate-400 w-16">120 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600 w-16">70 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-2.5 text-slate-700">Суп картофельный с фрикадельками / харчо</td>
                <td class="px-4 py-2.5 text-center text-slate-400">250 мл</td>
                <td class="px-4 py-2.5 text-right text-slate-600">~145 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Котлета куриная</td>
                <td class="px-4 py-2.5 text-center text-slate-400">80 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600">165 ккал</td>
              </tr>
              <tr class="border-t border-slate-100 bg-slate-50/40">
                <td class="px-4 py-2.5 text-slate-700">Макароны + рататуй</td>
                <td class="px-4 py-2.5 text-center text-slate-400">300 г</td>
                <td class="px-4 py-2.5 text-right text-slate-600">245 ккал</td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-4 py-2.5 text-slate-700">Компот, хлеб, чай</td>
                <td class="px-4 py-2.5 text-center text-slate-400"></td>
                <td class="px-4 py-2.5 text-right text-slate-600">190 ккал</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Полдник + Ужин + 2й ужин -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
          <div class="rounded-[16px] overflow-hidden border border-slate-100">
            <div class="bg-orange-50 px-4 py-2.5">
              <div class="text-base font-semibold uppercase tracking-[0.05em] text-orange-600"><i class="bi bi-cup-hot" aria-hidden="true"></i> Полдник</div>
              <div class="text-[20px] font-bold text-slate-800 mt-1">200 ккал</div>
            </div>
            <div class="px-4 py-3 text-base text-slate-600">Печенье, фруктовый сок</div>
          </div>
          <div class="rounded-[16px] overflow-hidden border border-slate-100">
            <div class="bg-orange-50 px-4 py-2.5">
              <div class="text-base font-semibold uppercase tracking-[0.05em] text-orange-600"><i class="bi bi-moon-stars" aria-hidden="true"></i> Ужин</div>
              <div class="text-[20px] font-bold text-slate-800 mt-1">855 ккал</div>
            </div>
            <div class="px-4 py-3 text-base text-slate-600">Шницель куриный, гречка, азу, салаты, компот</div>
          </div>
          <div class="rounded-[16px] overflow-hidden border border-slate-100">
            <div class="bg-orange-50 px-4 py-2.5">
              <div class="text-base font-semibold uppercase tracking-[0.05em] text-orange-600"><i class="bi bi-star" aria-hidden="true"></i> Второй ужин</div>
              <div class="text-[20px] font-bold text-slate-800 mt-1">215 ккал</div>
            </div>
            <div class="px-4 py-3 text-base text-slate-600">Молочный коктейль, вафля</div>
          </div>
        </div>

        <div class="rounded-[16px] bg-emerald-50 border border-emerald-100 px-5 py-4 flex items-center gap-4">
          <div class="text-center shrink-0">
            <div class="text-[28px] font-bold text-emerald-700">3 040</div>
            <div class="text-[12px] text-emerald-600">ккал за день</div>
          </div>
          <div class="w-px h-12 bg-emerald-200 shrink-0"></div>
          <div class="text-base text-slate-600 leading-[1.6]">
            <span class="font-semibold text-slate-700">Белки 133 г · Жиры 104 г · Углеводы 387 г</span><br>
            Соотношение Б:Ж:У = 17% / 31% / 51% — в пределах норм для активных школьников.
          </div>
        </div>
      </div>

      <!-- Section 4: Why 5 meals -->
      <div class="mb-8 pt-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-primary shrink-0"></div>
          <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
            Почему пять приёмов пищи, а не три
          </h2>
        </div>
        <p class="text-[16px] leading-[1.7] text-slate-600">
          Завтрак, обед, полдник, ужин и второй ужин — это не избыток. Это режим под конкретный ритм дня.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          После завтрака начинаются занятия — мозгу нужна глюкоза прямо сейчас. К обеду уже успевают набегаться. Полдник — небольшой мост между дневной активностью и вечерней программой: без него к ужину приходят голодными и перевозбуждёнными.
        </p>
        <p class="text-[16px] leading-[1.7] text-slate-600 mt-4">
          Второй ужин — молочный коктейль и вафля — это не лакомство перед сном, а закрытие дефицита. Растущий организм ночью активно работает, и лечь совсем пустым — значит проснуться без сил.
        </p>

        <div class="my-6 rounded-[16px] bg-slate-50 border border-slate-100 px-6 py-5">
          <p class="text-base font-semibold uppercase tracking-[0.06em] text-slate-500 mb-4">РЕЖИМ ПИТАНИЯ В ЛАГЕРЕ</p>
          <div class="space-y-2">
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
              <span class="text-base font-mono text-slate-400 w-12 shrink-0">8:00</span>
              <span class="text-base font-semibold text-slate-800 w-28 shrink-0">Завтрак</span>
              <span class="text-base text-slate-500">до занятий — мозгу нужно топливо</span>
            </div>
            <div class="flex items-center gap-3 rounded-[10px] bg-white px-4 py-3">
