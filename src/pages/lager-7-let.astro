---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Не рано ли ребёнку 7 лет ехать в лагерь",
    text: "Главный вопрос, который задают все мамы семилеток — не рано ли? Честный ответ: всё зависит от ребёнка, но большинство школьников 6–8 лет отлично справляются. В АйДаКемп группы маленькие — по 6–8 человек, за каждой закреплён вожатый, который рядом 24/7. Первые два дня адаптация — это нормально. К третьему дню 95% малышей уже «свои» в команде и не вспоминают о доме. Смена 2.1 (7 дней) специально создана для первого раза — достаточно коротко, чтобы не было страха, и достаточно долго, чтобы получить результат."
  },
  {
    h2: "Программа для 7 лет: Scratch — логика без кода",
    text: "Scratch создан в MIT специально для малышей 6–7 лет. Никакого текстового кода — только цветные блоки, которые соединяются как пазлы. Почему именно Scratch? Потому что он учит настоящей логике программирования — последовательности, условиям, циклам — без необходимости знать буквы и синтаксис. Это фундамент: освоив его в 7 лет, в 9–10 лет переход на Python проходит в два раза легче.",
    list: [
      "Scratch — визуальные блоки вместо текстового кода (MIT, специально для 6–7 лет)",
      "Анимации, мультфильмы и простые игры — реальный результат",
      "Логика действий: если → то, циклы, условия — без зубрёжки",
      "Подготовка к Python: в 9–10 лет этот фундамент даст фору"
    ]
  },
  {
    h2: "Типичный проект семилетки: что он создаст за смену",
    text: "За 7 дней ребёнок 7 лет делает в Scratch собственный мультфильм или игру-бродилку. Не шаблон из учебника — свой сценарий, свои персонажи, свои правила. На итоговой презентации в последний день показывает проект родителям и другим ребятам. Это не детский рисунок «для мамы» — это работающая программа, которую можно открыть на любом компьютере.",
    list: [
      "Анимированный мультфильм: персонаж двигается, говорит, реагирует",
      "Игра-бродилка: препятствия, победа, финальный экран",
      "Или интерактивная открытка: нажимаешь — что-то происходит",
      "Публичная презентация: ребёнок сам объясняет, что он сделал"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про 7-летних в IT-лагере — отвечаем честно, без маркетинга:",
    list: [
      "«Не слишком ли сложно?» — Scratch создан для этого возраста: никаких букв, только блоки-картинки. Если умеет играть в конструктор — справится.",
      "«Не скучно ли без мамы?» — Вожатый 24/7 рядом, Telegram-фото каждый день, ежедневный звонок в первые дни.",
      "«Готов ли мой ребёнок?» — Если ходит в школу и умеет обращаться с мышкой — готов. Опыт программирования не нужен.",
      "«Что если заскучает по дому?» — Группы по 6–8 человек, вожатый знает каждого по имени. 95% малышей к третьему дню уже «своя команда»."
    ]
  },
  {
    h2: "Как следят за маленькими в лагере",
    text: "Для малышей 6–8 лет в АйДаКемп действуют усиленные правила. Соотношение вожатых к ребятам — 1:8. На территории дежурит медработник 24/7. Связь с ребёнком — каждый день в установленные часы. Telegram-фото из жизни отряда приходят ежедневно.",
    list: [
      "Соотношение 1:8 — вожатый знает каждого по имени",
      "Медработник на базе круглосуточно",
      "Ежедневный звонок родителям в первые 3 дня",
      "Telegram-фото из отряда — каждый день",
      "Закрытая территория с пропускным режимом"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Июль традиционно заполняется первым. Если рассматриваете летний лагерь для семилетки — бронируйте сейчас. Для первого раза рекомендуем смену 2.1 (7 дней): не слишком долго, познакомится с форматом без длинной разлуки.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽ (идеально для первого раза)",
      "Смена 2: 10–23 июня, 14 дней — 99 000 ₽",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть — бронируйте"
    ]
  },
  {
    h2: "Как устроен день: режим, сон, питание, бассейн",
    text: "Распорядок дня чёткий — это то, что любят малыши: предсказуемость и структура. Подъём, завтрак, занятия блоками по 45 минут, обед, тихий час, бассейн или активности на улице, ужин, вечернее мероприятие, отбой. Питание пятиразовое, меню составляет технолог. Бассейн закрытый, с тренером.",
    list: [
      "Подъём 8:00, отбой 22:00 для младших групп",
      "Питание 5 раз в день, меню с учётом аллергий",
      "Закрытый бассейн через день — по расписанию",
      "Тихий час после обеда — обязателен для 6–8 лет"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа меняется вместе с ребёнком. Вот что ждёт на следующий год:",
    list: [
      "<a href='/lager-8-let'>Лагерь для 8 лет</a> — Scratch и Tinkercad 3D: больше самостоятельности, командная работа",
      "<a href='/lager-9-let'>Лагерь для 9 лет</a> — переход к Python: первый «взрослый» язык через игровые задачи",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Летний лагерь 7 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для детей 7 лет в Подмосковье 2026. Scratch, первый код через игру. Малые группы до 8 чел., вожатый 1:8, бассейн. 66 км от МКАД от 48 000 ₽."
  h1="Детский лагерь для детей 7 лет в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-7-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа для детей 7 лет в лагере?", a: "Для детей 6–8 лет — Scratch, визуальное программирование. Никакого текстового кода: цветные блоки-пазлы, анимации, простые игры. За смену ребёнок создаёт собственный мультфильм или игру-бродилку. Это фундамент для Python в 9–10 лет." },
    { q: "Не рано ли ребёнку 7 лет ехать в лагерь?", a: "Большинство школьников 6–8 лет отлично справляются. В АйДаКемп группы по 6–8 человек, вожатый рядом 24/7, соотношение 1:8, медработник на базе. Для первого раза рекомендуем короткую смену 7 дней." },
    { q: "Что сделает ребёнок 7 лет за смену?", a: "Создаст свой первый проект на Scratch — анимацию или простую игру. На итоговой презентации покажет его родителям. Это не учебное задание, а личный результат." },
    { q: "Есть ли места в июле?", a: "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." },
    { q: "Сколько стоит лагерь для детей 7 лет?", a: "Смена 2.1 (7 дней, июнь) — 48 000 ₽. Смена 2 (14 дней, июнь) — 99 000 ₽. Смена 3 (13 дней, август) — 89 400 ₽. Смена 4 (10 дней, август) — 74 900 ₽. В стоимость входят проживание, питание, программа, бассейн." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 7 лет в Подмосковье"
    subtitle="Scratch — первый код для малышей 6–8 лет. Маленькие группы, вожатый 1:8, бассейн и лес в 66 км от МКАД."
    breadcrumb="Лагерь для детей 7 лет"
    keywords={["Scratch — программирование без текстового кода", "Вожатый 1:8, медработник 24/7", "Смена 2.1 (7 дней) — идеально для первого раза"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Детский лагерь для детей 7 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Первый раз в лагере: как подготовить ребёнка", url: "/stati/pervyj-raz-v-lagere", description: "Советы для родителей, чей ребёнок едет в лагерь впервые.", icon: "backpack" },
    { title: "Куда деть ребёнка летом — варианты для занятых родителей", url: "/stati/kuda-det-rebenka-letom", description: "Разбираем форматы летнего отдыха: что подходит для разного возраста.", icon: "sun" },
    { title: "Что взять в лагерь — чеклист для мамы", url: "/stati/chto-vzyat-v-lager", description: "Полный список вещей, которые нужны ребёнку в летнем лагере.", icon: "clipboard-check" },
    { title: "Как выбрать лагерь для ребёнка", url: "/stati/kak-vybrat-lager", description: "На что смотреть при выборе: лицензия, безопасность, программа.", icon: "patch-check-fill" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-[14px] text-slate-500">
    <a href="/lager-8-let/" class="text-primary underline underline-offset-2">Лагерь для 8 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
