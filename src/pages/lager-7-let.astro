---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Не рано ли ребёнку 7 лет ехать в лагерь",
    text: "Главный вопрос, который задают все мамы семилеток — не рано ли? Честный ответ: всё зависит от ребёнка, но большинство детей 6–8 лет отлично справляются. В АйДаКемп группы маленькие — по 6–8 человек, за каждой группой закреплён вожатый, который рядом 24/7. Первые два дня адаптация — это нормально. К третьему дню 95% малышей уже «свои» в команде и не вспоминают о доме."
  },
  {
    h2: "Что изучают дети 7 лет: Scratch — логика без кода",
    text: "Scratch создан в MIT специально для детей 6–7 лет. Никакого текстового кода — только цветные блоки, которые соединяются как пазлы. Ребёнок двигает персонажа, делает анимацию, создаёт простую игру. За смену семилетка успевает сделать свой первый проект — мультфильм или игру-бродилку — и показать его родителям на итоговой презентации.",
    list: [
      "Scratch — визуальные блоки вместо текстового кода",
      "Анимации, мультфильмы и простые игры",
      "Логика действий: если → то, циклы, условия",
      "Итоговый проект — личный, не шаблонный"
    ]
  },
  {
    h2: "Как устроен день: режим, сон, питание, бассейн",
    text: "Распорядок дня в лагере чёткий — это то, что любят дети в 7 лет: предсказуемость и структура. Подъём, завтрак, занятия блоками по 45 минут, обед, тихий час, бассейн или активности на улице, ужин, вечернее мероприятие, отбой. Питание пятиразовое, меню составляет технолог. Бассейн закрытый, с тренером.",
    list: [
      "Подъём 8:00, отбой 22:00 для младших групп",
      "Питание 5 раз в день, меню с учётом аллергий",
      "Закрытый бассейн через день — по расписанию",
      "Тихий час после обеда — обязателен для 6–8 лет"
    ]
  },
  {
    h2: "Как следят за маленькими детьми в лагере",
    text: "Для детей 6–8 лет в АйДаКемп действуют усиленные правила. Группы не более 6 человек — вожатый знает каждого по имени, видит настроение и сигнализирует родителям при любых изменениях. На территории дежурит медработник 24/7. Связь с ребёнком — каждый день в установленные часы.",
    list: [
      "Группы 6–8 человек — вожатый знает каждого",
      "Медработник на базе круглосуточно",
      "Ежедневный звонок родителям в первые 3 дня",
      "Закрытая территория с пропускным режимом"
    ]
  },
  {
    h2: "Смены 2026 для детей 7 лет",
    text: "Для самых маленьких подходят смены от 7 дней. Первый раз — лучше короткая смена 2.1, чтобы познакомиться с форматом без длинной разлуки. Если понравится — в следующий раз берёте длинную смену сами.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Летний детский лагерь для детей 7 лет 2026 в Подмосковье — IT | АйДаКемп"
  description="Летний лагерь для детей 7 лет в Подмосковье 2026. Scratch, первый код через игру. Малые группы до 8 чел., вожатый рядом, бассейн. 66 км от МКАД от 48 000 ₽."
  h1="Детский лагерь для детей 7 лет в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-7-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для детей 7 лет в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 6–8 лет — Scratch, визуальное программирование. Никакого текстового кода: цветные блоки-пазлы, анимации, простые игры. За смену ребёнок создаёт собственный мультфильм или игру-бродилку." }
        },
        {
          "@type": "Question",
          "name": "Не рано ли ребёнку 7 лет ехать в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Большинство детей 6–8 лет отлично справляются. В АйДаКемп группы по 6–8 человек, вожатый рядом 24/7, медработник на базе. Для первого раза рекомендуем короткую смену 7 дней." }
        },
        {
          "@type": "Question",
          "name": "Что сделает ребёнок 7 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "Создаст свой первый проект на Scratch — анимацию или простую игру. На итоговой презентации покажет его родителям. Это не учебное задание, а личный результат с именем ребёнка." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для детей 7 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена 2.1 (7 дней, июнь) — 48 000 ₽. Смена 2 (14 дней, июнь) — 95 000 ₽. Смена 3 (13 дней, август) — 89 400 ₽. Смена 4 (10 дней, август) — 74 900 ₽. В стоимость входят проживание, питание, программа, бассейн." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 7 лет в Подмосковье"
    subtitle="Scratch — первый код для малышей 6–8 лет. Маленькие группы, вожатый рядом всегда, бассейн и лес в 66 км от МКАД."
    breadcrumb="Лагерь для детей 7 лет"
    keywords={["Scratch — программирование без текстового кода", "Группы 6–8 человек, вожатый 24/7", "Первый IT-проект — мультфильм или игра"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Детский лагерь для детей 7 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Первый раз в лагере: как подготовить ребёнка", url: "/stati/pervyj-raz-v-lagere", description: "Советы для родителей, чей ребёнок едет в лагерь впервые.", icon: "backpack" },
    { title: "Куда деть ребёнка летом — варианты для занятых родителей", url: "/stati/kuda-det-rebenka-letom", description: "Разбираем форматы летнего отдыха: что подходит для разного возраста.", icon: "sun" },
    { title: "Что взять в лагерь — чеклист для мамы", url: "/stati/chto-vzyat-v-lager", description: "Полный список вещей, которые нужны ребёнку в летнем лагере.", icon: "clipboard-check" },
    { title: "Как выбрать лагерь для ребёнка", url: "/stati/kak-vybrat-lager", description: "На что смотреть при выборе: лицензия, безопасность, программа.", icon: "patch-check-fill" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
