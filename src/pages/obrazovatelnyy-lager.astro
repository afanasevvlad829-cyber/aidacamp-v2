---
import { PRICE_MAX, PRICE_MIN, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое образовательный лагерь",
    text: "Образовательный лагерь — это формат, где обучение и отдых неразделимы. АйДаКемп — один из немногих лагерей в Подмосковье, где образовательная программа выстроена как полноценный курс: с прогрессией, проектной работой и итоговой защитой. Ребёнок не «проходит» темы — он создаёт продукт. Это летний выездной формат для ребёнка из Москвы и Подмосковья: путёвка на каникулы в хорошее загородное место, где образовательная программа идёт каждый день — без городских «продлёнок»."
  },
  {
    h2: "Образовательная программа по направлениям",
    text: "Программа разделена по возрасту и уровню подготовки.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые проекты",
      "Python (10–14 лет) — основной язык, от синтаксиса до рабочей программы",
      "AI и нейросети (12–14 лет) — ChatGPT API, обучение моделей",
      "Minecraft Education (7–12 лет) — программирование через игру",
      "Дизайн и анимация (8–14 лет) — Figma, графика, интерфейсы"
    ]
  },
  {
    h2: "Кто ведёт занятия",
    text: "Преподаватели АйДаКемп работают с детьми с 2021 года через офлайн-школу программирования #АйДаКодить. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей, тираж 2000 экземпляров. Соотношение преподавателей к детям — 1:6, занятия в малых группах."
  },
  {
    h2: "Итог образовательной смены — хакатон",
    text: "Каждая смена заканчивается хакатоном: дети представляют свои проекты перед всей группой. Это не экзамен — это праздник. Ребёнок уезжает домой с готовым проектом, который можно показать друзьям, выложить в сеть или продолжить развивать. Родители видят конкретный результат, а не просто «провели время»."
  },
  {
    h2: "Чем образовательный лагерь лучше обычного «с занятиями»",
    text: "Многие лагеря заявляют «с образовательной составляющей» — и это означает 1-2 часа «занятий» между бассейном и тихим часом, без прогрессии, без результата. У нас принципиально другой подход — это полноценное обучение, встроенное в лагерный формат:",
    list: [
      "Программа рассчитана на 30 академических часов за смену (5 часов × 6 учебных дней)",
      "Есть диагностика на входе и защита проекта на выходе — можно объективно замерить прогресс",
      "Преподаватель 1 на 8 детей — как в хорошей частной школе, не «массовка»",
      "Материалы даются в виде «рабочей тетради» которую каждый забирает домой — можно продолжить",
      "У каждого ребёнка — индивидуальный план проекта, не «все делают одно и то же»"
    ]
  },
  {
    h2: "Что получает родитель кроме обучения",
    text: "Образовательный лагерь это инвестиция. Мы стараемся дать родителю реальные доказательства того, что инвестиция окупилась — как минимум эмоционально. По итогам смены ребята уезжают с:",
    list: [
      "Сертификатом АйДаКемп — конкретный документ в папку достижений",
      "Цифровым портфолио — проект опубликован в Scratch-community / GitHub / своём канале",
      "Индивидуальным отчётом о прогрессе от преподавателя — что было вначале, что в конце",
      "Рекомендациями что изучать дальше — курсы, книги, youtube-каналы по уровню",
      "Ссылкой на родительский чат выпускников — общение с «коллегами» для поддержки дальнейшего развития"
    ]
  },
  {
    h2: "Можно ли засчитать образовательный лагерь в школу",
    text: "Формально — нет, лицензия не совпадает (лагерь как туроператор, не как школа). Но на практике многие частные школы Москвы засчитывают проект АйДаКемп как «летнее задание» по информатике или даже как зачёт за семестр. Мы выдаём официальную справку с описанием проекта и часами работы — её часто принимают. Также участие в АйДаКемп можно включить в раздел «дополнительное образование» при поступлении в 5-й или 10-й класс — это плюс в портфолио. Некоторые наши выпускники с этим портфолио поступили в Лицей ВШЭ и Политеха."
  },
  {
    h2: "Образовательные программы в АйДаКемп: IT, науки и проекты",
    text: "Образовательная программа в АйДаКемп построена на трёх столпах — IT-навыки, научное мышление и проектная работа. Всё это переплетается внутри каждой смены:",
    list: [
      "IT-направление — Python, Scratch, AI и нейросети, Minecraft, 3D-моделирование. Занятия ведут практикующие IT-специалисты, авторы учебника по Python для детей",
      "Науки и логика — задачи на алгоритмическое и критическое мышление, разбор реальных кейсов из IT-индустрии. Дети учатся формулировать гипотезы и проверять их кодом",
      "Проектная работа — каждый ребёнок разрабатывает собственный продукт: игру, бота, AI-эксперимент или 3D-модель. Финальная защита на хакатоне — навык публичного представления результата"
    ]
  },
  {
    h2: "Почему образовательный лагерь эффективнее репетитора летом",
    text: "Летом родители часто нанимают репетитора по информатике или математике. Вот три причины, почему образовательный лагерь даёт больше за те же деньги:",
    list: [
      "Контекст обучения — репетитор работает за столом, лагерь создаёт живую среду: конкуренция с ровесниками, командный проект, дедлайн. Мотивация в 3–5 раз выше, усвоение глубже",
      "Объём — за 10-дневную смену ребята проходят учебный материал, эквивалентный 3–4 месяцам занятий с репетитором дважды в неделю. Полное погружение без отвлечений работает",
      "Результат — репетитор даёт знания, лагерь даёт продукт. Ребёнок уезжает с реальным проектом, который он создал сам: игра, бот, 3D-модель. Это убедительнее любой оценки в журнале"
    ]
  },
  {
    h2: "Образовательная программа: что конкретно изучают",
    text: "Программа АйДаКемп — не «знакомство с компьютером», а структурированный курс с прогрессией. Направления разбиты по возрасту и уровню подготовки.",
    list: [
      "Python (10–15 лет): переменные, функции, циклы, ООП, работа с модулями — от «Hello, world» до рабочего бота",
      "AI и нейросети (12–15 лет): работа с API ChatGPT, prompting, основы ML, создание собственного AI-ассистента",
      "Minecraft Education (7–12 лет): логика, автоматизация, redstone-схемы — программирование через игровой мир",
      "3D-моделирование в Blender (10–15 лет): базовый меш, текстуры, анимация, рендер",
      "Scratch (7–9 лет): визуальные блоки, анимации, первые игры — идеально для старта",
      "Адаптация под возраст: 7–9, 10–12, 13–15 лет — школьник попадает именно в свою группу"
    ]
  },
  {
    h2: "Результат каждой смены — реальный проект",
    text: "Каждая смена заканчивается хакатоном: подростки и младшие школьники защищают свои проекты перед командой. Это не экзамен — это праздник результата.",
    list: [
      "Telegram-бот: принимает команды, отвечает на вопросы, умеет парсить данные",
      "Игра на Python: графика, управление, сюжет — полноценная программа",
      "AI-ассистент: интеграция с ChatGPT API, собственный промпт, логика диалога",
      "3D-модель: персонаж или сцена в Blender, готова к рендеру или печати",
      "Каждый делает свой проект по индивидуальному плану — не «все одно и то же»"
    ]
  },
  {
    h2: "Преподаватели",
    text: "Занятия ведут практикующие IT-специалисты — не студенты на подработке, а люди, которые сами пишут код каждый день.",
    list: [
      "Никита Брагин и Александр Ташкин — авторы учебника Python для детей (тираж 2 000 экз.)",
      "Педагогический стаж от 5 лет — онлайн и офлайн формат, знают как объяснить сложное просто",
      "Соотношение 1 преподаватель на 6–8 учеников — как в хорошей частной школе",
      "Работают с АйДаКемп с 2021 года — знают программу, знают типичные трудности"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/obrazovatelnyy-lager.avif"
  title="Образовательный лагерь в Подмосковье 2026 | АйДаКемп"
  description={`IT-образовательный лагерь для детей 7–15 лет. Python, AI, Minecraft — реальный проект за смену. 66 км от МКАД, лицензированный туроператор. От ${PRICE_MIN}.`}
  h1="Образовательный лагерь для детей в Подмосковье"
  canonical="https://aidacamp.ru/obrazovatelnyy-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое образовательный лагерь для детей?", a: "Образовательный лагерь — это формат с загородным проживанием и серьёзной учебной программой. В АйДаКемп дети изучают IT: Python, AI, Minecraft, 3D-моделирование. Занятия ведут практикующие IT-специалисты, авторы учебника по Python для детей. Результат — готовый проект с защитой на хакатоне." },
    { q: "Даёт ли образовательный лагерь реальные знания?", a: "Да. Одна смена АйДаКемп по учебному объёму сопоставима с 3–4 месяцами онлайн-курса. В лагере нет отвлечений, занятия каждый день по 90 минут дважды в день, преподаватель рядом. К концу смены каждый ребёнок создаёт и защищает собственный IT-проект." },
    { q: "Есть ли у лагеря образовательная лицензия?", a: "Да. АйДаКемп имеет образовательную лицензию Минобрнауки Л035-01298-77/01082973. Это официальное основание для налогового вычета 13% за обучение ребёнка. Документы для декларации выдаются автоматически после оплаты." },
    { q: "Как образовательный лагерь сочетает учёбу и отдых?", a: "Утром — IT-занятия в малых группах до 8 человек. После обеда — бассейн, спорт, командные игры. Вечером — работа над проектом в свободном темпе. Телефоны сданы, экранное время — как внутренняя валюта за достижения. Дети не успевают скучать." },
    { q: "Почему образовательный лагерь лучше летних курсов с репетитором?", a: "За 10-дневную смену дети проходят материал, эквивалентный 3–4 месяцам занятий с репетитором дважды в неделю. Полное погружение без отвлечений, живая команда ровесников и реальный дедлайн (хакатон) дают глубину усвоения, которую не воспроизведёт домашний урок." },
    { q: "Сколько стоит образовательный лагерь АйДаКемп?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). В стоимость включены проживание, питание, полная IT-программа, бассейн и активности. Налоговый вычет 13% — можно вернуть от 2 800 до ${VYCHET_MAX} в зависимости от смены.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Образовательный лагерь для детей в Подмосковье"
    subtitle="Не просто отдых — каждая смена заканчивается проектом. IT-образование в загородном формате."
    breadcrumb="Образовательный лагерь"
    keywords={["Авторская программа: Python, AI, Minecraft, дизайн", "Преподаватели — авторы учебника по Python для детей", "Результат смены — готовый проект с презентацией"]}
    image="/images/hero/obrazovatelnyy-lager.avif"
    imageAlt="Образовательный лагерь АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={[
    { title: 'IT-лагерь', description: 'Программирование, AI, Minecraft — полное погружение', url: '/it-camp', icon: 'bi-laptop' },
    { title: 'Лагерь для школьников', description: '1–8 класс, IT-проект за смену', url: '/lager-dlya-shkolnikov', icon: 'bi-backpack' },
    { title: 'Цены и смены', description: 'Стоимость и даты всех смен 2026', url: '/ceny', icon: 'bi-receipt' },
    { title: 'Детский лагерь', description: 'Загородный лагерь для детей 7–15 лет', url: '/detskiy-lager', icon: 'bi-house-heart' },
  ]} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
