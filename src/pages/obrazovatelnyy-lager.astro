---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Что такое образовательный лагерь",
    text: "Образовательный лагерь — это формат, где обучение и отдых неразделимы. АйДаКемп — один из немногих лагерей в Подмосковье, где образовательная программа выстроена как полноценный курс: с прогрессией, проектной работой и итоговой защитой. Ребёнок не «проходит» темы — он создаёт продукт."
  },
  {
    h2: "Образовательная программа по направлениям",
    text: "Программа разделена по возрасту и уровню подготовки.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые проекты",
      "Python (10–14 лет) — основной язык, от синтаксиса до рабочей программы",
      "AI и нейросети (12–14 лет) — ChatGPT API, обучение моделей",
      "Minecraft Education (7–12 лет) — программирование через игру",
      "Дизайн и анимация (8–14 лет) — Figma, графика, интерфейсы"
    ]
  },
  {
    h2: "Кто ведёт занятия",
    text: "Преподаватели АйДаКемп работают с детьми с 2019 года через офлайн-школу программирования #АйДаКодить. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей, тираж 2000 экземпляров. Соотношение преподавателей к детям — 1:6, занятия в малых группах."
  },
  {
    h2: "Итог образовательной смены — хакатон",
    text: "Каждая смена заканчивается хакатоном: дети представляют свои проекты перед всей группой. Это не экзамен — это праздник. Ребёнок уезжает домой с готовым проектом, который можно показать друзьям, выложить в сеть или продолжить развивать. Родители видят конкретный результат, а не просто «провели время»."
  },
  {
    h2: "Чем образовательный лагерь лучше обычного «с занятиями»",
    text: "Многие лагеря заявляют «с образовательной составляющей» — и это означает 1-2 часа «занятий» между бассейном и тихим часом, без прогрессии, без результата. У нас принципиально другой подход — это полноценное обучение, встроенное в лагерный формат:",
    list: [
      "Программа рассчитана на 30 академических часов за смену (5 часов × 6 учебных дней)",
      "Есть диагностика на входе и защита проекта на выходе — можно объективно замерить прогресс",
      "Преподаватель 1 на 8 детей — как в хорошей частной школе, не «массовка»",
      "Материалы даются в виде «рабочей тетради» которую ребёнок забирает домой — можно продолжить",
      "У каждого ребёнка — индивидуальный план проекта, не «все делают одно и то же»"
    ]
  },
  {
    h2: "Что получает родитель кроме обучения",
    text: "Образовательный лагерь это инвестиция. Мы стараемся дать родителю реальные доказательства того, что инвестиция окупилась — как минимум эмоционально. По итогам смены ребёнок уезжает с:",
    list: [
      "Сертификатом АйДаКемп — конкретный документ в папку достижений",
      "Цифровым портфолио — проект опубликован в Scratch-community / GitHub / своём канале",
      "Индивидуальным отчётом о прогрессе от преподавателя — что было вначале, что в конце",
      "Рекомендациями что изучать дальше — курсы, книги, youtube-каналы по уровню",
      "Ссылкой на родительский чат выпускников — общение с «коллегами» для поддержки дальнейшего развития"
    ]
  },
  {
    h2: "Можно ли засчитать образовательный лагерь в школу",
    text: "Формально — нет, лицензия не совпадает (лагерь как туроператор, не как школа). Но на практике многие частные школы Москвы засчитывают проект АйДаКемп как «летнее задание» по информатике или даже как зачёт за семестр. Мы выдаём официальную справку с описанием проекта и часами работы — её часто принимают. Также участие в АйДаКемп можно включить в раздел «дополнительное образование» при поступлении в 5-й или 10-й класс — это плюс в портфолио. Некоторые наши выпускники с этим портфолио поступили в Лицей ВШЭ и Политеха."
  }
];

---

<LandingLayout
  heroImage="/images/hero/obrazovatelnyy-lager.avif"
  title="Образовательный лагерь для детей в Подмосковье 2026 — АйДаКемп"
  description="IT-образовательный лагерь для детей 7–15 лет. Python, AI, Minecraft — реальный проект за смену. 66 км от Москвы, лицензированный туроператор. От 48 000 ₽."
  h1="Образовательный лагерь для детей в Подмосковье"
  canonical="https://aidacamp.ru/obrazovatelnyy-lager"
>
  <LandingHero slot="hero"
    h1="Образовательный лагерь для детей в Подмосковье"
    subtitle="Не просто отдых — каждая смена заканчивается проектом. IT-образование в загородном формате."
    breadcrumb="Образовательный лагерь"
    keywords={["Авторская программа: Python, AI, Minecraft, дизайн", "Преподаватели — авторы учебника по Python для детей", "Результат смены — готовый проект с презентацией"]}
    image="/images/hero/obrazovatelnyy-lager.avif"
    imageAlt="Образовательный лагерь АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
