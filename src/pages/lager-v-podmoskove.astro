    keywords={[`${STAT_DISTANCE} от МКАД, Наро-Фоминский район, Санаторий Изумруд`, "IT-программа: Python, AI, Minecraft — проект за смену", "Бассейн, охрана 24/7, лицензированный туроператор"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Летний детский лагерь на природе"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts slim />

  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={faqItems.map(item => ({ q: item.question, a: item.answer }))} only={['medicine', 'safety', 'food', 'accommodation', 'communication', 'payment']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
