---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingContent from '../components/LandingContent.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Где находится лагерь в Подмосковье",
    text: "АйДаКемп расположен в Московской области — в Наро-Фоминском районе, на территории санатория «Изумруд». До лагеря 66 км от МКАД по Калужскому шоссе, около часа езды на машине. Это загородная территория вдали от города: лес, чистый воздух, закрытая охраняемая территория. Трансфер из Москвы — платная опция."
  },
  {
    h2: "Почему родители выбирают лагерь в Подмосковье",
    text: "Подмосковье — оптимальный выбор для московских семей: близко, но уже по-настоящему за городом. Ребёнок в безопасности, родители в доступности. В АйДаКемп дети не просто отдыхают — они создают IT-проекты под руководством преподавателей-практиков, авторов книги по Python для детей.",
    list: [
      "Закрытая территория санатория, охрана 24/7, медработник",
      "Комнаты по 2–4 человека с санузлом, 5-разовое питание",
      "Бассейн с ионизированной водой, спортплощадки",
      "Ежедневные фото и связь с родителями",
      "Договор, страховка, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Детские лагеря Подмосковья: чем АйДаКемп отличается",
    text: "В Подмосковье десятки лагерей. Большинство — спортивные или общего профиля. АйДаКемп — один из немногих с полноценной IT-программой: Python, AI, Minecraft, веб-дизайн. Занятия ведут преподаватели с опытом 6+ лет, авторы учебника по программированию для детей. Результат смены — готовый проект, который ребёнок защищает на итоговом хакатоне."
  },
  {
    h2: "Смены в Подмосковье летом 2026",
    text: "Лагерь работает с конца мая по август 2026. Продолжительность смен — от 7 до 14 дней. Стоимость от 48 000 ₽ включает проживание, питание, полную IT-программу и активности. Трансфер из Москвы — опция.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽",
      "Короткие смены 2.1 и 2.2 — от 7 дней, от 48 000 ₽"
    ]
  },
  {
    h2: "Как добраться до лагеря в Подмосковье",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд». Координаты: 55.265643, 36.724185. На автомобиле: Калужское шоссе (A-101), 66 км от МКАД. Время в пути — около часа. Трансфер: организуем из нескольких точек Москвы, стоимость уточняйте при бронировании."
  }
];

const relatedPages = [
  { title: "Детский лагерь Подмосковье", url: "/detskiy-lager-podmoskove", emoji: "🌲", description: "Условия, проживание, питание" },
  { title: "Лагерь на август", url: "/lager-na-avgust-podmoskove", emoji: "☀️", description: "Смены августа 2026" },
  { title: "Лагерь программирования", url: "/lager-programmirovaniya", emoji: "⌨️", description: "IT-программа подробно" },
];
---

<LandingLayout
  title="Летний лагерь в Подмосковье 2026 — IT-программа для детей | АйДаКемп"
  description="Детский летний лагерь в Подмосковье, 66 км от Москвы. IT, Python, Minecraft, бассейн. Смены июнь–август 2026. Цены от 48 000 ₽, проживание и питание включены."
  h1="Летний лагерь в Подмосковье для детей"
  canonical="https://aidacamp.ru/lager-v-podmoskove"
>
  <LandingHero
    h1="Летний лагерь в Подмосковье для детей"
    subtitle="66 км от Москвы по Калужскому шоссе. IT-программирование, бассейн, 5-разовое питание. Смены от 7 до 14 дней."
    breadcrumb="Лагерь в Подмосковье"
    keywords={["66 км от Москвы, Наро-Фоминский район, Санаторий Изумруд", "IT-программа: Python, AI, Minecraft — проект за смену", "Бассейн, охрана 24/7, лицензированный туроператор"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Летний лагерь в Подмосковье для детей"
  />
  <LandingContent sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={relatedPages} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
