---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Где находится лагерь в Подмосковье",
    text: "АйДаКемп расположен в Московской области — в Наро-Фоминском районе, на территории санатория «Изумруд». До лагеря 66 км от МКАД по Калужскому шоссе, около часа езды на машине. Это загородная территория вдали от города: лес, чистый воздух, закрытая охраняемая территория. Трансфер из Москвы — платная опция."
  },
  {
    h2: "Почему родители выбирают лагерь в Подмосковье",
    text: "Подмосковье — оптимальный выбор для московских семей: близко, но уже по-настоящему за городом. Ребёнок в безопасности, родители в доступности. В АйДаКемп дети не просто отдыхают — они создают IT-проекты под руководством преподавателей-практиков, авторов книги по Python для детей.",
    list: [
      "Закрытая территория санатория, охрана 24/7, медработник",
      "Комнаты по 2–4 человека с санузлом, 5-разовое питание",
      "Бассейн с ионизированной водой, спортплощадки",
      "Ежедневные фото и связь с родителями",
      "Договор, страховка, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Детские лагеря Подмосковья: чем АйДаКемп отличается",
    text: "В Подмосковье десятки лагерей. Большинство — спортивные или общего профиля. АйДаКемп — один из немногих с полноценной IT-программой: Python, AI, Minecraft, веб-дизайн. Занятия ведут преподаватели с опытом 6+ лет, авторы учебника по программированию для детей. Результат смены — готовый проект, который ребята защищают на итоговом хакатоне."
  },
  {
    h2: "Смены в Подмосковье летом 2026",
    text: "Лагерь работает с конца мая по август 2026. Продолжительность смен — от 7 до 15 дней. Стоимость от 48 000 ₽ включает проживание, питание, полную IT-программу и активности. Трансфер из Москвы — опция.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽",
      "Короткие смены 2.1 и 2.2 — от 7 дней, от 48 000 ₽"
    ]
  },
  {
    h2: "Как добраться до лагеря в Подмосковье",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд». Координаты: 55.265643, 36.724185. На автомобиле: Калужское шоссе (A-101), 66 км от МКАД. Время в пути — около часа. Трансфер: организуем из нескольких точек Москвы, стоимость уточняйте при бронировании."
  },
  {
    h2: "Типы лагерей в Подмосковье — краткий обзор рынка",
    text: "Подмосковный рынок детского отдыха большой и очень разный. Чтобы не тонуть в выборе, мы коротко разложим, какие форматы лагерей в принципе работают в Московской области и чем они отличаются.",
    list: [
      "Общетематические — классические «советские» форматы, упор на спорт/дискотеки/кружки. Цена 35–55 тыс. ₽/смена. Подходит, если нужен «просто отдых».",
      "Спортивные лагеря — хоккей, футбол, бассейн, гимнастика. 50–80 тыс. ₽. Для уже занимающихся детей.",
      "Языковые — погружение в английский (иногда с носителями). 60–120 тыс. ₽. Хороший вариант, если ребёнок уже «в теме».",
      "IT и STEM-лагеря — программирование, робототехника, 3D-печать. 48–95 тыс. ₽. Растущий сегмент, подходит детям «в экране», чтобы направить интерес в полезное русло. Это наш формат — АйДаКемп.",
      "Военно-патриотические и «на выживание» — специфика, мальчики 10+. 40–60 тыс. ₽.",
      "Семейные лагеря — где родители живут рядом. Для первого опыта тех, кто боится отпустить."
    ]
  },
  {
    h2: "Как выбирать лагерь в Подмосковье — чек-лист",
    text: "Когда читаете сайт лагеря, смотрите не на красивые фотографии и обещания «научим всему» — смотрите в четыре обязательных пункта. Если хотя бы одного нет — лучше не рисковать.",
    list: [
      "Реестровый номер туроператора (РТО или РТА) на сайте — это юрлицо имеет право продавать путёвки. У нас РТО 025773. Проверить можно на tourism.gov.ru.",
      "Договор на покупку — с перечнем услуг, пунктом о возврате, персональной страховкой на ребёнка. Без договора — это не лагерь, а «нелицензированный проект».",
      "Отзывы — не со страницы лагеря, а независимые: Яндекс.Карты, 2ГИС, Otzovik, родительские чаты. Если отзывов меньше 20 или все 5/5 звёзд — звоночек.",
      "Медик на территории круглосуточно и договор со скорой/ближайшей больницей (а не «мы вызовем если что»)."
    ]
  },
  {
    h2: "Наро-Фоминский район — что вокруг и почему это хорошо",
    text: "Лагерь находится в западной части Подмосковья, на Калужском направлении. Этот район исторически был «дачным» для московской интеллигенции — Наро-Фоминск, Апрелевка, Верея. Здесь мало промышленности, воздух чистый, много лесов и рек. Ближайший крупный районный центр — город Наро-Фоминск (~12 км) с больницами, аптеками и МФЦ. В 5 км от нашего корпуса — усадьба-музей «Архангельское-Тюриково», куда мы возим детей на экскурсии. В радиусе 30 км нет крупных производств и трасс с интенсивным грузовым трафиком. Связь 4G и 5G работает стабильно (важно, если родителям потребуется быстро связаться)."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний лагерь в Подмосковье 2026 — IT для детей | АйДаКемп"
  description="Детский IT-лагерь в Подмосковье, 66 км от МКАД. Python, Minecraft, бассейн, питание. Смены июнь–август 2026 от 48 000 ₽."
  h1="Летний лагерь в Подмосковье для детей"
  canonical="https://aidacamp.ru/lager-v-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Где находится лагерь в Подмосковье АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Наро-Фоминский район, 66 км от МКАД по А-101 (Калужское шоссе). Санаторий «Изумруд»." } },
        { "@type": "Question", "name": "Сколько стоит лагерь в Подмосковье 2026?", "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Всё включено." } },
        { "@type": "Question", "name": "Как добраться до лагеря в Подмосковье из Москвы?", "acceptedAnswer": { "@type": "Answer", "text": "На машине — 40–60 минут. Автобус от м. Солнцево — 2 500 ₽ в одну сторону." } },
        { "@type": "Question", "name": "Какая программа в загородном лагере Подмосковья?", "acceptedAnswer": { "@type": "Answer", "text": "Python, AI, Minecraft, Roblox, 3D-моделирование. 2 занятия в день + бассейн + активности." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь в Подмосковье для детей"
    subtitle={`${STAT_DISTANCE} от Москвы по Калужскому шоссе. IT-программирование, бассейн, 5-разовое питание. Смены от 7 до 15 дней.`}
    breadcrumb="Лагерь в Подмосковье"
    keywords={[`${STAT_DISTANCE} от Москвы, Наро-Фоминский район, Санаторий Изумруд`, "IT-программа: Python, AI, Minecraft — проект за смену", "Бассейн, охрана 24/7, лицензированный туроператор"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Летний лагерь в Подмосковье для детей"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
