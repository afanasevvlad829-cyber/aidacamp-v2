---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Guarantees from '../components/Guarantees.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const relatedPages = getRelatedPages('/garantii');
---

<Base
  title="Гарантии детского лагеря АйДаКемп — возврат, безопасность, страховка"
  description="Полные условия гарантий АйДаКемп: возврат при болезни, безопасность 24/7, застрахованная ответственность туроператора, гарантия результата."
>
  <Header />
  <main>
    <section class="mx-auto max-w-[900px] px-4 pt-10 pb-4 md:pt-14">
      <nav class="text-base text-slate-400 mb-4">
        <a href="/" class="hover:text-orange-600 transition-colors">Главная</a>
        <span class="mx-2">&rarr;</span>
        <span class="text-slate-600">Гарантии</span>
      </nav>
      <h1 class="text-[28px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">Гарантии АйДаКемп</h1>
      <p class="mt-2 text-[16px] leading-[1.6] text-slate-500 max-w-[560px]">
        Мы несём ответственность за спокойствие родителей — юридически и по-человечески.
      </p>
    </section>

    <Guarantees />
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
