---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что делают дети 8 лет на IT-смене",
    text: "В 8 лет ребёнок уже готов к первым шагам в программировании — главное, чтобы это было через игру. В АйДаКемп младшая группа (7–9 лет) работает в Scratch: создаёт собственных персонажей, придумывает сценарии, запускает анимации. Никакого скучного «заучивания команд» — дети делают игру, в которую потом сами же играют.",
    list: [
      "Scratch — визуальное программирование: блоки вместо кода",
      "Minecraft Education — строим механизмы и учим физику через игру",
      "Первый проект: анимированная история или простая игра на Scratch",
      "Командная работа: дети объединяются в пары и маленькие группы",
      "Итог смены — готовый проект, который ребёнок покажет маме и папе"
    ]
  },
  {
    h2: "Как устроен день ребёнка 8 лет в лагере",
    text: "Распорядок дня в АйДаКемп сделан так, чтобы ребёнок успевал и поработать, и отдохнуть. Младшая группа занимается утром 2–3 часа, потом бассейн, обед, тихий час и свободное время. Никаких «ещё один урок» после усталости.",
    list: [
      "Утро: занятие на Scratch или Minecraft Education — 2–3 часа с перерывами",
      "Середина дня: бассейн, прогулка, обед в столовой",
      "Тихий час — обязательно для всех",
      "Вечер: командные игры, квесты, творческие активности",
      "Связь с родителями — звонок вечером, родители всегда в курсе"
    ]
  },
  {
    h2: "Чему научится ребёнок за смену",
    text: "За 7–14 дней ребёнок 8 лет не станет программистом — и мы не обещаем этого. Но он получит то, что важно именно сейчас: опыт создания чего-то своего с нуля. Это другое ощущение, чем потребление контента.",
    list: [
      "Научится создавать анимацию и простые игры в Scratch",
      "Поймёт логику: «если — то», «повтори N раз», «когда нажата кнопка»",
      "Попробует командную работу: распределить роли, договориться, показать результат",
      "Привезёт домой проект — ссылку или файл, который можно открыть на любом компьютере",
      "Вернётся с желанием продолжать — это главное"
    ]
  },
  {
    h2: "Условия: бассейн, питание, безопасность",
    text: "Лагерь расположен в санатории «Изумруд» в Наро-Фоминском районе — 66 км от МКАД по Киевскому шоссе. Для детей 7–9 лет особенно важны условия проживания и питания, и здесь мы не экономим.",
    list: [
      "Закрытый бассейн на территории — купание через день по расписанию",
      "4-разовое питание: завтрак, обед, полдник, ужин",
      "Медицинский персонал на протяжении всей смены",
      "Маленькие отряды — вожатый знает каждого ребёнка по имени",
      "Связь через WhatsApp-чат отряда — родители видят фото каждый день"
    ]
  },
  {
    h2: "Смены 2026 для детей 8 лет",
    text: "Для детей 7–9 лет подходит любая смена — выбирайте по удобству дат. Смена 2.1 (7 дней) идеальна для первого раза: не слишком долго, ребёнок успеет привыкнуть и получить результат.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽ (идеально для первого раза)",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Налоговый вычет 13% — возвращается через ФНС"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Летний детский лагерь для детей 8 лет в Подмосковье 2026 — IT | АйДаКемп"
  description="Летний лагерь для детей 8 лет в Подмосковье 2026. Scratch и Minecraft — первый опыт с кодом через игру. Малые группы, бассейн. 66 км от МКАД от 48 000 ₽."
  h1="Детский лагерь для детей 8 лет в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-8-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для детей 8 лет в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–9 лет в АйДаКемп — Scratch и Minecraft Education. Scratch — визуальное программирование, где вместо написания кода ребёнок собирает блоки как конструктор. За смену дети создают анимированную историю или простую игру, которую можно показать родителям." }
        },
        {
          "@type": "Question",
          "name": "Не рано ли ребёнку 8 лет ехать в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "8 лет — отличный возраст для первого лагеря. Если ребёнок уже ходит в школу, он готов к небольшой самостоятельности. Для первого раза рекомендуем смену 2.1 — всего 7 дней. Вожатые младшей группы специально подбираются с опытом работы с малышами." }
        },
        {
          "@type": "Question",
          "name": "Что будет делать ребёнок 8 лет в IT-лагере кроме кода?",
          "acceptedAnswer": { "@type": "Answer", "text": "Помимо занятий на Scratch и Minecraft — бассейн, командные игры, квесты, творческие вечера. День выстроен так, что занятия занимают 2–3 часа утром, остальное время — отдых и активности. Скучать не придётся." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена для ребёнка 8 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Также доступны смены 10–14 дней от 74 900 ₽. В стоимость входит проживание, 4-разовое питание, все занятия и активности. Можно оформить налоговый вычет 13%." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 8 лет в Подмосковье"
    subtitle="Scratch, Minecraft — первый опыт с кодом через игру. Ребёнок привезёт домой проект, который сделал сам."
    breadcrumb="Лагерь для детей 8 лет"
    keywords={["Scratch и Minecraft Education для 7–9 лет", "Первый лагерь — смена от 7 дней", "Вожатый знает каждого ребёнка по имени"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Детский лагерь для детей 8 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Ребёнок боится ехать в лагерь — что делать", url: "/stati/rebenok-boitsya-lagerya", description: "Как помочь ребёнку справиться с тревогой перед первым лагерем.", icon: "emoji-smile" },
    { title: "Как подготовить ребёнка к лагерю: список вещей", url: "/stati/chto-vzyat-v-lager", description: "Что взять с собой, что оставить дома — практичный список.", icon: "backpack" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Как помочь ребёнку найти своих в коллективе.", icon: "people" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
