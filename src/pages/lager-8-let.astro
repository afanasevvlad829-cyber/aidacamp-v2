---
import { DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_RATING } from '../data/contacts';
import { PAST_SHIFTS_SENTENCE, OPEN_MONTHS_RANGE_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Программа для 8 лет: Scratch и Tinkercad 3D",
    text: "Лагерь для восьмилеток: ребёнку 8 лет — программирование через игру. Каждый год восьмилетки работают на Scratch и в Tinkercad. Та же программа в лагере для детей 6–7 лет и для 9–10 лет.",
    list: [
      "Командная работа в лагере: пары"
    ]
  },
  {
    h2: "Типичный проект восьмилетки",
    text: "Дети делают в лагере в Scratch игру с персонажем. Лагерь помогает ребёнку довести идею до результата.",
    list: [
      "Защита в лагере: ребёнок объясняет идею"
    ]
  },
  {
    h2: "Как устроен день ребёнка в лагере",
    text: "Лагерь: ребёнок утром занят Scratch или Tinkercad, вечером квестами.",
  },
  {
    h2: "Вожатые и безопасность",
    text: "Дети под присмотром: на территории лагеря дежурит медработник 24/7.",
    list: [
      "Соотношение вожатых 1:8: каждый ребёнок 8 лет в поле зрения",
      "Лагерь: закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Смотрите также: программы лагеря по возрасту",
    text: "Что ждёт в 9 и 10 лет, что было в 6–7 лет:",
    list: [
      "<a href='/lager-7-let/'>Лагерь для детей 7 лет</a> — Scratch для малышей 6–7 лет",
      "<a href='/lager-9-let/'>Лагерь для 9-летних</a>",
      "<a href='/lager-10-let/'>Программа лагеря для детей 10 лет</a>",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title={`Летний лагерь для детей 6, 7 и 8 лет в Подмосковье ${SEASON_YEAR} — детские смены, Scratch и 3D | АйДаКемп`}
  description="Летний лагерь для детей 6, 7 и 8 лет в Подмосковье. Scratch и Tinkercad 3D — первый опыт кода. Малые группы, вожатый 1:8, бассейн."
  h1="Летний лагерь для детей 6, 7 и 8 лет"
  canonical="https://aidacamp.ru/lager-8-let"
  breadcrumb="Можно ли в 8 лет"
>
  <LandingHero slot="hero"
    h1="Летний лагерь для детей 6, 7 и 8 лет"
    subtitle="Scratch и Tinkercad 3D — первый опыт с кодом. Лагерь остаётся с ребёнком: игра и 3D-модель, сделанные им самим."
    breadcrumb="Можно ли в 8 лет"
    keywords={["Scratch и Tinkercad 3D — игра + 3D за смену"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Детский лагерь для детей 8 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Какая программа для детей 8 лет в IT-лагере?", a: "Для детей 7–9 лет в лагере — Scratch и Tinkercad 3D." },
    { q: "Не рано ли ребёнку 8 лет ехать в лагерь?", a: "Лагерь отлично подходит для первого раза." },
    { q: "Что конкретно сделает ребёнок 8 лет за смену?", a: "Игру на Scratch и 3D-модель в Tinkercad ребёнок делает сам Файлы остаются." },
    { q: `Какие смены проходили в августе ${SEASON_YEAR} года?`, a: `${PAST_SHIFTS_SENTENCE} — к записи открыты смены ${OPEN_MONTHS_RANGE_NOM}.` },
    { q: `Сколько стоила смена для ребёнка 8 лет в ${SEASON_YEAR} году?`, a: `Смены стоили от ${PRICE_S4} за ${DAYS_S4} до ${PRICE_S3} за ${DAYS_S3}.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedArticles articles={[
    { title: "Ребёнок боится ехать в лагерь — что делать", url: "/stati/rebenok-boitsya-lagerya/", description: "Как помочь ребёнку справиться с тревогой перед первым лагерем.", icon: "emoji-smile" },
    { title: "Как подготовить ребёнка к лагерю: список вещей", url: "/stati/chto-vzyat-v-lager/", description: "Что взять с собой, что оставить дома — практичный список.", icon: "backpack" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Как помочь ребёнку найти своих в коллективе.", icon: "people" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у школьников и конкретные шаги.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-7-let/" class="text-primary underline underline-offset-2">← Лагерь для 7 лет</a> · <a href="/lager-9-let/" class="text-primary underline underline-offset-2">Лагерь для 9 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
