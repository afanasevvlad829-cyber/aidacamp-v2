---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Программа для 8 лет: Scratch и Tinkercad 3D",
    text: "В 8 лет ребёнок уже готов к первым шагам в программировании — главное, чтобы это было через игру. В АйДаКемп восьмилетки работают на Scratch: создают собственных персонажей, придумывают сценарии, запускают анимации. Параллельно — Tinkercad: первый опыт 3D-моделирования, который показывает связь кода с реальным миром. Это переходный возраст к Python: фундамент закладывается прямо сейчас.",
    list: [
      "Scratch — визуальное программирование: создаём игры с несколькими уровнями",
      "Tinkercad 3D — первые объёмные модели: от кубика до своего персонажа",
      "Первый проект: анимированная игра или интерактивная история",
      "Командная работа: пары и маленькие группы, распределение ролей"
    ]
  },
  {
    h2: "Типичный проект восьмилетки: что он создаст за смену",
    text: "За смену ребёнок 8 лет делает в Scratch игру с несколькими уровнями, правилами победы и персонажем с характером. Не шаблон — своя идея. На итоговой презентации объясняет одноклассникам и родителям, как это работает. Параллельно в Tinkercad — небольшая 3D-модель: свой значок, брелок или персонаж.",
    list: [
      "Игра на Scratch: несколько уровней, враги, очки, финал",
      "3D-модель в Tinkercad: персонаж или объект по собственному дизайну",
      "Публичная защита: ребёнок объясняет другим как работает проект",
      "Код и файлы остаются — можно продолжить дома"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про восьмилеток в IT-лагере:",
    list: [
      "«Не слишком ли сложно?» — Scratch специально создан для этого возраста. Никаких букв и синтаксиса — только блоки. Если умеет пользоваться мышкой и читать — справится.",
      "«Не скучно ли без мамы 7–14 дней?» — Вожатый рядом 24/7, соотношение 1:8. Telegram-фото из жизни отряда приходят каждый день.",
      "«Нужен ли опыт программирования?» — Нет. Группа начинает с нуля, задачи подбираются под уровень каждого.",
      "«Подойдёт ли смена 2.1 (7 дней) для первого раза?» — Да, это идеальная длина для знакомства с форматом."
    ]
  },
  {
    h2: "Как устроен день ребёнка 8 лет в лагере",
    text: "Распорядок дня сделан так, чтобы ребёнок успевал и поработать, и отдохнуть. Младшая группа занимается утром 2–3 часа, потом бассейн, обед, тихий час и свободное время. Никаких «ещё один урок» после усталости.",
    list: [
      "Утро: занятие на Scratch или Tinkercad — 2–3 часа с перерывами",
      "Середина дня: бассейн, прогулка, обед в столовой",
      "Тихий час — обязательно для всех",
      "Вечер: командные игры, квесты, творческие активности",
      "Связь с родителями — звонок вечером, Telegram-фото каждый день"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с младшим возрастом. Соотношение — 1 вожатый на 8 ребят. На территории дежурит медработник 24/7. Telegram-чат отряда: мама видит фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый ребёнок в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для восьмилеток подходит любая смена. Смена 2.1 (7 дней) идеальна для первого раза: не слишком долго, ребёнок успеет привыкнуть и получить результат. Июль традиционно заполняется первым — бронируйте заранее.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽ (идеально для первого раза)",
      "Смена 2 — 10–23 июня, 14 дней — 99 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Вот что ждёт ребёнка чуть позже — и что было раньше:",
    list: [
      "<a href='/lager-7-let'>Лагерь для 7 лет</a> — самый первый шаг: Scratch для малышей 6–7 лет",
      "<a href='/lager-9-let'>Лагерь для 9 лет</a> — переход к Python: первый настоящий код через игровые задачи",
      "<a href='/lager-10-let'>Лагерь для 10 лет</a> — Python и Roblox Studio: пишем первый работающий бот",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Летний лагерь 8 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для детей 8 лет в Подмосковье 2026. Scratch и Tinkercad 3D — первый опыт с кодом через игру. Малые группы, вожатый 1:8, бассейн. 66 км от"
  h1="Детский лагерь для детей 8 лет в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-8-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа для детей 8 лет в IT-лагере?", a: "Для детей 7–9 лет в АйДаКемп — Scratch и Tinkercad 3D. Scratch — визуальное программирование. В Tinkercad — первые 3D-модели. За смену создают игру с несколькими уровнями и 3D-модель персонажа." },
    { q: "Не рано ли ребёнку 8 лет ехать в лагерь?", a: "8 лет — отличный возраст для первого лагеря. Для первого раза рекомендуем смену 2.1 — всего 7 дней. Вожатые подбираются с опытом работы с младшим возрастом, соотношение 1:8." },
    { q: "Что конкретно сделает ребёнок 8 лет за смену?", a: "Игру на Scratch с несколькими уровнями и 3D-модель в Tinkercad. На итоговой презентации объясняет другим как работает его проект. Код и файлы остаются — можно продолжить дома." },
    { q: "Есть ли места в июле?", a: "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." },
    { q: "Сколько стоит смена для ребёнка 8 лет?", a: "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Также доступны смены 10–14 дней от 74 900 ₽. В стоимость входит проживание, питание, все занятия и активности. Можно оформить налоговый вычет 13%." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 8 лет в Подмосковье"
    subtitle="Scratch и Tinkercad 3D — первый опыт с кодом через игру. Ребёнок привезёт домой игру и 3D-модель, которые сделал сам."
    breadcrumb="Лагерь для детей 8 лет"
    keywords={["Scratch и Tinkercad 3D — игра + 3D за смену", "Смена 2.1 (7 дней) для первого раза", "Вожатый 1:8 знает каждого по имени"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Детский лагерь для детей 8 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Ребёнок боится ехать в лагерь — что делать", url: "/stati/rebenok-boitsya-lagerya", description: "Как помочь ребёнку справиться с тревогой перед первым лагерем.", icon: "emoji-smile" },
    { title: "Как подготовить ребёнка к лагерю: список вещей", url: "/stati/chto-vzyat-v-lager", description: "Что взять с собой, что оставить дома — практичный список.", icon: "backpack" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Как помочь ребёнку найти своих в коллективе.", icon: "people" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у школьников и конкретные шаги.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-[14px] text-slate-500">
    <a href="/lager-7-let/" class="text-primary underline underline-offset-2">← Лагерь для 7 лет</a> · <a href="/lager-9-let/" class="text-primary underline underline-offset-2">Лагерь для 9 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
