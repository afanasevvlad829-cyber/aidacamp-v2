    { title: "Как подготовить ребёнка к лагерю: список вещей", url: "/stati/chto-vzyat-v-lager/", description: "Что взять с собой, что оставить дома — практичный список.", icon: "backpack" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Как помочь ребёнку найти своих в коллективе.", icon: "people" },
