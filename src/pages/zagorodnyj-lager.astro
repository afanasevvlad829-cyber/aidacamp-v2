---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "АйДаКемп — загородный IT-лагерь в Наро-Фоминском районе",
    text: "АйДаКемп расположен в посёлке Мальчики Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. Закрытая территория санатория «Изумруд» в сосновом лесу — чистый воздух, бассейн, спортивные площадки. Всё то, что родители ждут от загородного лагеря, плюс IT-программа, которую ребята сами просят продолжить дома.",
    list: [
      "66 км от МКАД по Киевскому шоссе — около 1 ч 20 мин на машине",
      "Закрытая территория санатория «Изумруд», сосновый лес",
      "Бассейн с ионизированной водой, спортивные площадки",
      "Бесплатный трансфер из Москвы (м. Солнцево) при заезде и выезде"
    ]
  },
  {
    h2: "Как добраться из Москвы",
    text: "Не нужно думать как везти ребёнка: мы организуем трансфер от м. Солнцево в день заезда — бесплатно в обе стороны. Выезд рано утром, на месте через 1 час 20 минут по Киевскому шоссе. Хотите везти сами — 66 км от МКАД, навигатор: «санаторий Изумруд, Наро-Фоминский район».",
    list: [
      "Бесплатный трансфер: м. Солнцево → лагерь → м. Солнцево",
      "На машине: 66 км по Киевскому шоссе, около 1 ч 20 мин",
      "Маршрутки и автобусы от м. Апрелевка (до посёлка Мальчики)",
      "Встречаем и провожаем по расписанию — координаты скинем в чат за 3 дня"
    ]
  },
  {
    h2: "Что делают ребята в загородном IT-лагере",
    text: "Загородный лагерь — это не только свежий воздух и бассейн. В АйДаКемп каждый выбирает IT-трек по интересу и к концу смены защищает реальный проект. Утром и вечером — занятия по 90 минут, в промежутках — активности, спорт, бассейн, вечерние игры.",
    list: [
      "Python — боты, скрипты, автоматизация, работа с данными",
      "AI и нейросети — ChatGPT API, генерация изображений, обучение моделей",
      "Minecraft — написание модов, редстоун, кастомные механики",
      "Roblox — создание 3D-игр на Lua в Roblox Studio",
      "3D-моделирование — Blender, распечатка модели на 3D-принтере"
    ]
  },
  {
    h2: "Чем загородный лагерь лучше городского кружка",
    text: "Городской кружок даёт знания, загородный IT-лагерь даёт погружение. Один раз поедешь — сравнение очевидное.<br><br><table class='w-full text-sm border-collapse my-2'><thead><tr class='bg-orange-50'><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>Параметр</th><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>Городской кружок</th><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>АйДаКемп (загородный)</th></tr></thead><tbody><tr><td class='border border-gray-200 px-3 py-2'>Длина курса</td><td class='border border-gray-200 px-3 py-2'>Недели / месяцы</td><td class='border border-gray-200 px-3 py-2'>7–14 дней — и готовый проект</td></tr><tr class='bg-gray-50'><td class='border border-gray-200 px-3 py-2'>Отвлечения</td><td class='border border-gray-200 px-3 py-2'>Соцсети, телефон, друзья в соседней вкладке</td><td class='border border-gray-200 px-3 py-2'>Телефон сдан, фокус полный</td></tr><tr><td class='border border-gray-200 px-3 py-2'>Социализация</td><td class='border border-gray-200 px-3 py-2'>Те же одноклассники</td><td class='border border-gray-200 px-3 py-2'>Новые друзья из разных городов</td></tr><tr class='bg-gray-50'><td class='border border-gray-200 px-3 py-2'>Результат</td><td class='border border-gray-200 px-3 py-2'>Знания (теория)</td><td class='border border-gray-200 px-3 py-2'>Работающий проект + хакатон</td></tr><tr><td class='border border-gray-200 px-3 py-2'>Активности</td><td class='border border-gray-200 px-3 py-2'>Только учёба</td><td class='border border-gray-200 px-3 py-2'>Бассейн, спорт, вечерние игры</td></tr></tbody></table>",
    list: []
  },
  {
    h2: "Вожатые и преподаватели",
    text: "Вожатые в АйДаКемп — не случайные люди «на лето». Каждый проходит отбор и двухдневный тренинг по работе с детьми разных возрастов, конфликтным ситуациям и первой помощи. На смене один вожатый закреплён за группой из 8 человек — знает по имени каждого, видит настроение, звонит родителям сам, не ждёт пока попросят.",
    list: [
      "Соотношение вожатый : дети = 1 : 8 — не теряемся в толпе",
      "IT-треки ведут студенты Бауманки, ВШЭ, МФТИ и практикующие разработчики",
      "Каждый вожатый с опытом работы с детьми от 1 сезона",
      "Отдельный старший вожатый на всю смену — координирует и решает нестандартное",
      "Все сотрудники проверены по базам МВД, медкнижки в порядке"
    ]
  },
  {
    h2: "Безопасность и условия проживания",
    text: "Родители, выбирая загородный лагерь, прежде всего думают о безопасности. В АйДаКемп: охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. Если ребёнок простудится — <a href='/stati/rebenok-zabolel-v-lagere' class='text-orange-600 underline underline-offset-2'>читайте, как это работает в нашем лагере</a>. Комнаты на 2–4 человека с собственным санузлом — не казарменные условия. 5-разовое питание, учёт пищевых ограничений. Каждый день в 21:00 родители получают фото в закрытый Telegram-канал — не постановочные, а живые кадры дня.",
    list: [
      "Охрана 24/7, медработник, видеонаблюдение",
      "Комнаты на 2–4 человека с санузлом",
      "5-разовое питание, учёт аллергий",
      "Страховка включена в стоимость путёвки",
      "Ежедневные фото в закрытый Telegram-канал для родителей в 21:00"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "АйДаКемп работает с конца мая по август 2026. Смены 7–14 дней. Оплата частями: 50% при бронировании, 50% за 3 недели до заезда. Июль занят полностью. В июне и августе места ещё есть — уточните актуальность при бронировании.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Отзывы о загородном IT-лагере АйДаКемп",
    text: "Родители, которые выбирали между городским кружком и загородным лагерем:",
    list: [
      "«Хотела кружок, но посоветовали попробовать загородный формат. Две недели — и сын вернулся другим человеком: сам сидит пишет код, просит записать ещё на одну смену» — Ирина, мама Кости, 11 лет",
      "«Дочь впервые в загородном лагере без родителей. Боялась. Теперь сама планирует поехать летом снова — говорит, там «самое крутое место»» — Екатерина, мама Ани, 9 лет",
      "«Территория отличная, кормят хорошо. Главное — программа настоящая, не «покажем как нарисовать котика в Scratch»» — Михаил, папа Ильи, 14 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Загородный IT-лагерь Подмосковье 2026 — АйДаКемп"
  description="Загородный IT-лагерь 66 км от МКАД. Группы по 8 детей, ноутбуки предоставляем, бесплатный трансфер от м. Солнцево. Python, AI, Minecraft для 7–15 лет"
  h1="Загородный IT-лагерь для детей в Подмосковье"
  canonical="https://aidacamp.ru/zagorodnyj-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое загородный лагерь для детей?",
          "acceptedAnswer": { "@type": "Answer", "text": "Загородный лагерь — это лагерь с проживанием вне города, обычно в лесу или на природе. Дети живут 7–14 дней, общаются, занимаются по программе и возвращаются домой с новыми навыками и друзьями. АйДаКемп — IT-лагерь в Наро-Фоминском районе, 66 км от МКАД." }
        },
        {
          "@type": "Question",
          "name": "Чем загородный лагерь лучше городского кружка?",
          "acceptedAnswer": { "@type": "Answer", "text": "Погружением. 10–14 дней без привычного окружения — ребёнок концентрируется на одной теме, обзаводится новыми друзьями, учится работать в команде. Хакатон в конце смены — реальная презентация проекта. Городской кружок даёт знания, загородный лагерь даёт опыт." }
        },
        {
          "@type": "Question",
          "name": "Как далеко загородный лагерь АйДаКемп от Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "66 км от МКАД по Киевскому шоссе, около 1 часа езды. Трансфер от м. Солнцево — 2 000 ₽ в одну сторону. Или самостоятельно на автомобиле." }
        },
        {
          "@type": "Question",
          "name": "Безопасно ли отправлять ребёнка в загородный лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп — да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория санатория. Комнаты на 2–4 человека с санузлом. Страховка включена. Реестровый туроператор РТО 025773." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста можно в загородный лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп принимает детей от 7 до 15 лет. Группы формируются по возрасту: младшая (7–9), средняя (10–12), старшая (13–15). Первый раз без родителей — нормальная практика, вожатые помогают адаптироваться в первые дни." }
        }
      ]
    })} />
    <CourseSchema
      name="Загородный IT-лагерь АйДаКемп Подмосковье 2026"
      description="Загородный IT-лагерь с проживанием в 66 км от МКАД. Группы по 8 детей, ноутбуки предоставляем. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/zagorodnyj-lager"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Загородный IT-лагерь для детей в Подмосковье"
    subtitle="66 км от МКАД, группы по 8, ноутбуки наши. IT-лагерь в сосновом лесу — Python, AI и Minecraft с бассейном и хакатоном в финале."
    breadcrumb="Загородный лагерь"
    keywords={["66 км от МКАД, бесплатный трансфер от м. Солнцево", "Группы по 8 человек — каждый на виду у преподавателя", "IT-треки: Python, AI, Minecraft, Roblox, 3D — по выбору"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Загородный IT-лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
