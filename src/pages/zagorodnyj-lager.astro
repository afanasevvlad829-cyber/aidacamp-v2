---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "АйДаКемп — загородный лагерь в Наро-Фоминском районе",
    text: "АйДаКемп расположен в посёлке Мальчики Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. Закрытая территория санатория «Изумруд» в сосновом лесу — чистый воздух, бассейн, спортивные площадки. Всё то, что родители ждут от загородного лагеря, плюс IT-программа, которую дети сами просят продолжить дома.",
    list: [
      "66 км от МКАД по Киевскому шоссе — около 1 часа от Москвы",
      "Закрытая территория санатория «Изумруд», сосновый лес",
      "Бассейн с ионизированной водой, спортивные площадки",
      "Трансфер из Москвы (м. Солнцево) — 2 500 ₽ в одну сторону"
    ]
  },
  {
    h2: "Что делают дети в загородном IT-лагере",
    text: "Загородный лагерь — это не только свежий воздух и бассейн. В АйДаКемп каждый ребёнок выбирает IT-трек по интересу и к концу смены защищает реальный проект. Утром и вечером — занятия по 90 минут, в промежутках — активности, спорт, бассейн, вечерние игры.",
    list: [
      "Python — боты, скрипты, автоматизация, работа с данными",
      "AI и нейросети — ChatGPT API, генерация изображений, обучение моделей",
      "Minecraft — написание модов, редстоун, кастомные механики",
      "Roblox — создание 3D-игр на Lua в Roblox Studio",
      "3D-моделирование — Blender, распечатка модели на 3D-принтере"
    ]
  },
  {
    h2: "Чем загородный лагерь лучше городского кружка",
    text: "Городской кружок даёт знания, загородный лагерь даёт погружение. 10–14 дней без телефона и без привычного окружения — ребёнок концентрируется на одном треке, обзаводится новыми друзьями из разных городов, учится работать в команде. Хакатон в конце смены — настоящая презентация перед аудиторией, а не задание в тетрадке.",
    list: [
      "Погружение 10–14 дней без городских отвлечений",
      "Новые друзья из разных городов и школ",
      "Командная работа, презентация проекта на хакатоне",
      "Результат — работающий проект, который можно показать родителям"
    ]
  },
  {
    h2: "Безопасность и условия проживания",
    text: "Родители, выбирая загородный лагерь, прежде всего думают о безопасности. В АйДаКемп: охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. Комнаты на 2–4 человека с собственным санузлом — не казарменные условия. 5-разовое питание, учёт пищевых ограничений.",
    list: [
      "Охрана 24/7, медработник, видеонаблюдение",
      "Комнаты на 2–4 человека с санузлом",
      "5-разовое питание, учёт аллергий",
      "Страховка включена в стоимость путёвки"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "АйДаКемп работает с конца мая по август 2026. Смены 7–14 дней. Оплата частями: 50% при бронировании, 50% за 3 недели до заезда.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Отзывы о загородном лагере АйДаКемп",
    text: "Родители, которые выбирали между городским кружком и загородным лагерем:",
    list: [
      "«Хотела кружок, но посоветовали попробовать загородный формат. Две недели — и сын вернулся другим человеком: сам сидит пишет код, просит записать ещё на одну смену» — Ирина, мама Кости, 11 лет",
      "«Дочь впервые в загородном лагере без родителей. Боялась. Теперь сама планирует поехать летом снова — говорит, там «самое крутое место»» — Екатерина, мама Ани, 9 лет",
      "«Территория отличная, кормят хорошо. Главное — программа настоящая, не «покажем как нарисовать котика в Scratch»» — Михаил, папа Ильи, 14 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Загородный лагерь для детей 2026 — АйДаКемп в Подмосковье"
  description="Загородный IT-лагерь в Наро-Фоминском районе: 66 км от Москвы, сосновый лес, бассейн. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Загородный лагерь для детей в Подмосковье"
  canonical="https://aidacamp.ru/zagorodnyj-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое загородный лагерь для детей?",
          "acceptedAnswer": { "@type": "Answer", "text": "Загородный лагерь — это лагерь с проживанием вне города, обычно в лесу или на природе. Дети живут 7–14 дней, общаются, занимаются по программе и возвращаются домой с новыми навыками и друзьями. АйДаКемп — IT-лагерь в Наро-Фоминском районе, 66 км от Москвы." }
        },
        {
          "@type": "Question",
          "name": "Чем загородный лагерь лучше городского кружка?",
          "acceptedAnswer": { "@type": "Answer", "text": "Погружением. 10–14 дней без привычного окружения — ребёнок концентрируется на одной теме, обзаводится новыми друзьями, учится работать в команде. Хакатон в конце смены — реальная презентация проекта. Городской кружок даёт знания, загородный лагерь даёт опыт." }
        },
        {
          "@type": "Question",
          "name": "Как далеко загородный лагерь АйДаКемп от Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "66 км от МКАД по Киевскому шоссе, около 1 часа езды. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону. Или самостоятельно на автомобиле." }
        },
        {
          "@type": "Question",
          "name": "Безопасно ли отправлять ребёнка в загородный лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп — да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория санатория. Комнаты на 2–4 человека с санузлом. Страховка включена. Реестровый туроператор РТО 025773." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста можно в загородный лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп принимает детей от 7 до 15 лет. Группы формируются по возрасту: младшая (7–9), средняя (10–12), старшая (13–15). Первый раз без родителей — нормальная практика, вожатые помогают адаптироваться в первые дни." }
        }
      ]
    })} />
    <CourseSchema
      name="Загородный IT-лагерь АйДаКемп — Наро-Фоминский район"
      description="Загородный лагерь с проживанием в 66 км от Москвы. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/zagorodnyj-lager"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Загородный лагерь для детей в Подмосковье"
    subtitle="IT-лагерь в сосновом лесу, 66 км от Москвы. Бассейн, охрана 24/7, Python и Minecraft для детей 7–15 лет."
    breadcrumb="Загородный лагерь"
    keywords={["66 км от Москвы по Киевскому шоссе, трансфер от м. Солнцево", "Бассейн, закрытая территория санатория, медработник 24/7", "IT-треки: Python, AI, Minecraft, Roblox, 3D — по выбору"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Загородный IT-лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
