---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { STAT_INSURED, STAT_RTO, STAT_LICENSE, STAT_RATING } from '../data/contacts';
import { PAST_SHIFTS_SENTENCE, SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "АйДаКемп — загородный IT-лагерь в Наро-Фоминском районе",
    text: "АйДаКемп — на закрытой территории санатория «Изумруд» в сосновом лесу Наро-Фоминского района: чистый воздух, бассейн, спортивные площадки. Всё, что родители ждут от загородного лагеря, плюс IT-программа, которую ребята сами просят продолжить дома.",
    list: [
      "66 км от МКАД по Киевскому шоссе — около 1 ч 20 мин на машине",
      "Закрытая территория санатория «Изумруд», сосновый лес",
      "Бассейн с ионизированной водой, спортивные площадки",
      `Трансфер от м. Солнцево (${TRANSFER_PRICE_FMT} в один конец) при заезде и выезде`
    ]
  },
  {
    h2: "Что делают ребята в загородном IT-лагере",
    text: "В АйДаКемп каждый выбирает IT-трек по интересу и к концу смены защищает реальный проект. Утром и вечером — занятия по 90 минут, в промежутках — активности, спорт, бассейн, вечерние игры.",
    list: [
      "Python — боты, скрипты, автоматизация, работа с данными",
      "AI и нейросети — ChatGPT API, генерация изображений, обучение моделей",
      "Minecraft — написание модов, редстоун, кастомные механики",
      "Roblox — создание 3D-игр на Lua в Roblox Studio",
      "3D-моделирование — Blender, распечатка модели на 3D-принтере"
    ]
  },
  {
    h2: "Чем загородный лагерь лучше городского кружка",
    text: "Городской кружок даёт знания, АйДаКемп даёт погружение. Один раз поедешь — сравнение очевидное.<br><br><table class='w-full text-sm border-collapse my-2'><thead><tr class='bg-orange-50'><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>Параметр</th><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>Городской кружок</th><th class='border border-orange-200 px-3 py-2 text-left font-semibold'>АйДаКемп (загородный)</th></tr></thead><tbody><tr><td class='border border-gray-200 px-3 py-2'>Длина курса</td><td class='border border-gray-200 px-3 py-2'>Недели / месяцы</td><td class='border border-gray-200 px-3 py-2'>7–14 дней — и готовый проект</td></tr><tr class='bg-gray-50'><td class='border border-gray-200 px-3 py-2'>Отвлечения</td><td class='border border-gray-200 px-3 py-2'>Соцсети, телефон, друзья в соседней вкладке</td><td class='border border-gray-200 px-3 py-2'>Телефон сдан, фокус полный</td></tr><tr><td class='border border-gray-200 px-3 py-2'>Социализация</td><td class='border border-gray-200 px-3 py-2'>Те же одноклассники</td><td class='border border-gray-200 px-3 py-2'>Новые друзья из разных городов</td></tr><tr class='bg-gray-50'><td class='border border-gray-200 px-3 py-2'>Результат</td><td class='border border-gray-200 px-3 py-2'>Знания (теория)</td><td class='border border-gray-200 px-3 py-2'>Работающий проект + хакатон</td></tr><tr><td class='border border-gray-200 px-3 py-2'>Активности</td><td class='border border-gray-200 px-3 py-2'>Только учёба</td><td class='border border-gray-200 px-3 py-2'>Бассейн, спорт, вечерние игры</td></tr></tbody></table>",
    list: []
  },
  {
    h2: "Вожатые и преподаватели",
    text: "Опытные вожатые в АйДаКемп — не случайные люди «на лето». Команда проходит отбор и двухдневный тренинг: работа с детьми разных возрастов, конфликтные ситуации, первая помощь.",
    list: [
      "Соотношение вожатый : дети = 1 : 8 — не теряемся в толпе",
      "IT-треки ведут студенты Бауманки, ВШЭ, МФТИ и практикующие разработчики",
      "Все сотрудники проверены по базам МВД, медкнижки в порядке"
    ]
  },
  {
    h2: "Безопасность и условия проживания",
    text: "Что для родителей важно знать о безопасности — коротко ниже. Если ребёнок простудится — <a href='/stati/rebenok-zabolel-v-lagere/' class='text-orange-600 underline underline-offset-2'>читайте, как это работает в нашем лагере</a>.",
    list: [
      "Охрана 24/7, медработник, видеонаблюдение",
      "Комнаты на 2–4 человека с санузлом",
      "5-разовое питание, учёт аллергий",
      STAT_INSURED,
      "Ежедневные фото в закрытый Telegram-канал для родителей в 21:00",
      `Путёвка оформляется по лицензии на образовательную деятельность Минобрнауки ${STAT_LICENSE}, лагерь в реестре туроператоров (РТО ${STAT_RTO}), рейтинг ${STAT_RATING} на Яндекс.Картах`
    ]
  },
  {
    h2: `Смены и цены ${SEASON_YEAR}`,
    text: `АйДаКемп работает ${SEASON_FROM_TO} ${SEASON_YEAR} — точные даты смен ниже. Оплата частями: 50% при бронировании, 50% за 3 недели до заезда. ${PAST_SHIFTS_SENTENCE} — сейчас открыты августовские смены 3 и 4. Места ещё есть, уточните актуальность при бронировании.`,
    list: [
      `Смена 1 (завершена) — ${DATES_S1}, 10 дней, ${PRICE_S1}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (открыта)`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (открыта)`,
      `Открытые августовские смены — от ${PRICE_MIN} за 10 дней`
    ]
  },
  {
    h2: "Отзывы о загородном IT-лагере АйДаКемп",
    text: "Родители, которые выбирали между городским кружком и загородным лагерем:",
    list: [
      "«Дочь впервые в загородном лагере без родителей. Боялась. Теперь сама планирует поехать летом снова — говорит, там «самое крутое место»» — Екатерина, мама Ани, 9 лет",
      "«Территория отличная, кормят хорошо. Главное — программа настоящая, не «покажем как нарисовать котика в Scratch»» — Михаил, папа Ильи, 14 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Загородный выездной детский IT-лагерь — летние смены, Подмосковье ${SEASON_YEAR} | АйДаКемп`}
  description="Загородный детский IT-лагерь в Подмосковье, 66 км от МКАД. Летние смены, группы по 8 детей, ноутбуки, трансфер от м. Солнцево. Python, AI, Minecraft для 7–15 лет."
  h1="Детские лагеря Подмосковья: детский IT-формат"
  canonical="https://aidacamp.ru/zagorodnyj-lager"
>
  <Fragment slot="head">
    <CourseSchema
      name={`Загородный IT-лагерь АйДаКемп Подмосковье ${SEASON_YEAR}`}
      description="Загородный IT-лагерь с проживанием в 66 км от МКАД. Группы по 8 детей, ноутбуки предоставляем. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/zagorodnyj-lager"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детские лагеря Подмосковья: детский IT-формат"
    subtitle="66 км от МКАД, группы по 8, ноутбуки наши. IT-лагерь в сосновом лесу — Python, AI и Minecraft с бассейном и хакатоном в финале."
    breadcrumb="Загородный лагерь"
    keywords={[`66 км от МКАД, трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT}`, "Группы по 8 человек — каждый на виду у преподавателя", "IT-треки: Python, AI, Minecraft, Roblox, 3D — по выбору"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Загородный IT-лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как далеко загородный лагерь АйДаКемп от Москвы?", a: `66 км от МКАД по Киевскому шоссе, около 1 часа езды. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону. Или самостоятельно на автомобиле.` },
    { q: "С какого возраста можно в загородный лагерь?", a: "АйДаКемп принимает детей от 7 до 15 лет. Группы формируются по возрасту: младшая (7–9), средняя (10–12), старшая (13–15). Первый раз без родителей — нормальная практика, вожатые помогают адаптироваться в первые дни." }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
