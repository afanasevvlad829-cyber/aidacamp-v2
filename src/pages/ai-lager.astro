---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "AI-лагерь для детей: чему учат в 2026 году",
    text: "АйДаКемп — IT-лагерь, где дети 7–15 лет работают с искусственным интеллектом как с инструментом, а не изучают его по учебнику. Старшие группы (12–15 лет) используют ChatGPT API и Gemini для написания собственных ботов, генерации контента и помощников. Младшие — знакомятся с AI через Scratch и образовательные модули: рисуют нейросетью, задают вопросы, изучают как работает распознавание образов."
  },
  {
    h2: "Чем AI-программа 2026 года отличается от обычного лагеря",
    text: "В большинстве детских лагерей «AI-программа» — это просто Scratch с новым названием. В АйДаКемп дети в старших группах реально используют большие языковые модели: пишут промпты, получают ответы, встраивают их в свои боты. Это не презентация о ChatGPT — это руки на клавиатуре и рабочий результат на выходе.",
    list: [
      "ChatGPT API / Gemini API — настоящая работа с LLM, не демонстрация",
      "AI для генерации изображений — Stable Diffusion, Midjourney-подходы",
      "Telegram-бот с AI-модулем — уходишь домой с работающим ботом",
      "Хакатон «Стартап из будущего» — защита AI-проекта перед всем лагерем",
      "Разбор как работают нейросети — на понятных примерах без математики"
    ]
  },
  {
    h2: "Программа AI-лагеря по дням — что осваивают",
    text: "За 10–14 дней AI-трека ребята проходят от «что такое нейросеть» до работающего AI-проекта. Прогрессия по дням:",
    list: [
      "Дни 1–2: что такое AI и как работают языковые модели — на простых примерах без математики. Практика: пишем промпты, сравниваем результаты, учимся формулировать задачи для нейросети",
      "Дни 3–5: Python + AI. Подключение Gemini API или OpenAI API из Python-скрипта. Первый чат-бот который отвечает на вопросы. Понятие токенов, контекстного окна, системного промпта",
      "Дни 6–8: расширение AI-проекта. Добавление памяти (контекст разговора), интеграция с Telegram Bot API. Начало финального AI-проекта — каждый выбирает тему",
      "Дни 9–10 (или до 14): разработка AI-стартапа. Telegram-бот-помощник / AI-арт-генератор / AI-учитель / AI-игра. Упаковка, тестирование, подготовка питча",
      "Финал: хакатон «Стартап из будущего» — каждый за 3 минуты объясняет свой AI-продукт, демо работающего прототипа"
    ]
  },
  {
    h2: "Для какого возраста подходит AI-лагерь",
    text: "AI-программа масштабируется по возрасту — «AI для 8-летнего» и «AI для 15-летнего» принципиально разные треки:",
    list: [
      "7–9 лет: Scratch + AI-блоки. Учатся ставить вопросы нейросети, рисуют с помощью AI-инструментов, делают интерактивные анимации с голосовыми командами. Главное — не боятся AI",
      "10–12 лет: Python + Gemini API. Уже могут писать код — добавляют AI как «умный модуль» в свои программы. Создают чат-ботов с памятью, AI-помощников для школы",
      "13–15 лет: продвинутый AI-трек. ChatGPT API, системные промпты, цепочки вызовов (chain-of-thought). AI-стартап как финальный проект — полноценный питч с демо",
      "12+ лет без опыта Python: программа адаптирована, начинают с визуальных блоков и Gemini через простой Python-шаблон. За 10 дней дойдут до рабочего бота"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену в AI-лагере",
    text: "Финальный AI-проект — не демонстрация, а работающий прототип. Примеры проектов из прошлых смен:",
    list: [
      "AI-помощник для подготовки к ЕГЭ — Telegram-бот, который объясняет темы, задаёт вопросы и проверяет ответы",
      "AI-арт-генератор — бот принимает описание и возвращает изображение через Stable Diffusion API",
      "AI-переводчик жаргона — объясняет сленг для родителей или сленг взрослых для детей",
      "AI-рекомендатор аниме/игр — анализирует вкусы и предлагает что посмотреть, учится на обратной связи",
      "AI-тренер по английскому — диалоговый бот, исправляет ошибки, объясняет правила",
      "AI-игра «Детектив» — история с разветвлёнными диалогами, AI играет роль NPC"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для AI-образования",
    text: "AI-курсы для детей появляются повсюду. Вот что отличает АйДаКемп:",
    list: [
      "Реальные API, не «игрушечные» — дети работают с теми же инструментами что и взрослые разработчики. ChatGPT API, Gemini — то что используется в индустрии",
      "Python как основа — AI без программирования это потребитель. У нас дети создают AI-продукты, а не просто используют готовые",
      "Хакатон-формат финала — защита AI-проекта перед аудиторией. Навык питча, умение объяснить свой продукт — это отдельная ценность",
      "Группы до 8 человек — AI-проекты индивидуальные, преподаватель помогает каждому с его конкретной задачей"
    ]
  },
  {
    h2: "Программа AI-лагеря по возрастам",
    text: "Программа делится по группам, потому что «AI для детей 8 лет» и «AI для детей 14 лет» — это разные вещи.",
    list: [
      "7–9 лет: Scratch + AI-блоки, рисование с помощью нейросети, простые автоматизации",
      "10–12 лет: Python + Gemini API, создание чат-бота, распознавание изображений",
      "13–15 лет: Python Advanced + ChatGPT API, Telegram-бот с AI, AI-стартап на хакатоне"
    ]
  },
  {
    h2: "Почему учить детей AI-инструментам нужно уже сейчас",
    text: "Через 5 лет большинство профессий предполагает работу с AI-инструментами. Дети, которые привыкли к ним в 12–13 лет, не будут испытывать тревоги перед «магией алгоритмов» — они знают, как это работает изнутри. Это не про то, что ребёнок «станет программистом». Это про то, что он не будет чувствовать себя отстающим в технологиях."
  },
  {
    h2: "Нужно ли ребёнку знать программирование для AI-лагеря",
    text: "Нет. Программа выстроена от нуля: дети без опыта начинают с базовых блоков и визуального программирования. Тем, кто уже писал на Python, дадут задачи посложнее. AI-инструменты адаптированы под уровень группы: малышам — картинки и простые вопросы к ботам, старшим — полноценный API. Ноутбук привозить не нужно — все компьютеры в лагере."
  }
];
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title="AI-лагерь для детей в Подмосковье 2026 | АйДаКемп"
  description="Детский AI-лагерь: нейросети, ChatGPT API, Gemini — дети создают AI-ботов. Для 7–15 лет, 66 км от МКАД. Смены июнь–август от 48 000 ₽."
  h1="AI-лагерь для детей в Подмосковье 2026"
  canonical="https://aidacamp.ru/ai-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Что такое AI-лагерь для детей?", "acceptedAnswer": { "@type": "Answer", "text": "Детский IT-лагерь с треком по искусственному интеллекту: ChatGPT API, Kandinsky, Stable Diffusion, практические AI-проекты для детей 10–15 лет." } },
        { "@type": "Question", "name": "С какого возраста AI-лагерь?", "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Для малышей — Scratch + AI-блоки, для старших — Python + ChatGPT API. Опыт программирования не нужен — объясняем с нуля." } },
        { "@type": "Question", "name": "Что создаёт ребёнок на AI-треке?", "acceptedAnswer": { "@type": "Answer", "text": "Реальный проект: AI-помощник в Telegram, AI-арт-генератор, AI-игра с диалогами или AI-учитель. Защита на хакатоне «Стартап из будущего» в последний день." } },
        { "@type": "Question", "name": "Чем AI-лагерь отличается от обычного IT-лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "Фокус на нейросетях как инструменте для своих проектов. Дети не просто используют ChatGPT — они встраивают AI в программы которые пишут сами." } },
        { "@type": "Question", "name": "Нужен ли Python для AI-лагеря?", "acceptedAnswer": { "@type": "Answer", "text": "Нет. Для младших групп (7–9 лет) — Scratch с AI-блоками без Python. Для старших (10–15) — Python даётся параллельно с AI. Если ребёнок уже знает Python, сразу начнёт с более сложных AI-задач." } },
        { "@type": "Question", "name": "Безопасно ли давать детям доступ к ChatGPT?", "acceptedAnswer": { "@type": "Answer", "text": "В лагере используется корпоративный API с настроенными фильтрами контента. Дети работают в контролируемой среде — открытого браузерного доступа к ChatGPT нет. Все запросы через код, который пишет ребёнок под наблюдением преподавателя." } },
        { "@type": "Question", "name": "Что такое хакатон «Стартап из будущего»?", "acceptedAnswer": { "@type": "Answer", "text": "Финальное мероприятие AI-смены. Каждый ребёнок за 3 минуты представляет свой AI-проект: что делает, как работает, кому полезен. Родители присутствуют. Вручаются сертификаты." } }
      ]
    })} />
    <CourseSchema
      name="AI-лагерь для детей — нейросети и ChatGPT API"
      description="Летний AI-лагерь для детей 7–15 лет: работа с ChatGPT API, Gemini, создание AI-ботов и стартапов. Июньские и августовские смены в Подмосковье."
      url="https://aidacamp.ru/ai-lager"
      level="Beginner"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="AI-лагерь для детей: нейросети и искусственный интеллект"
    subtitle="Дети 7–15 лет создают AI-проекты и боты — не смотрят презентации, а работают с реальными API."
    breadcrumb="AI-лагерь"
    keywords={[
      "ChatGPT API, Gemini, Telegram-боты — реальный AI-трек",
      "Python + AI: проект-стартап на хакатоне в финале смены",
      `${STAT_DISTANCE} от Москвы, от ${CAMP_PRICE_FROM}, всё включено`
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="AI-лагерь для детей в Подмосковье 2026 — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Нейросети для детей — с чего начать и зачем", url: "/stati/nejroseti-dlya-detej", description: "С какого возраста учить, что делают дети с ChatGPT и почему код важнее промптов.", icon: "cpu" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej", description: "Python + AI — мощная комбинация. Как дети создают AI-проекты в лагере.", icon: "code-slash" },
    { title: "ИИ заменит программиста?", url: "/stati/ii-zamenit-programmista", description: "Почему умение работать с AI — самый востребованный навык ближайшего десятилетия.", icon: "stars" },
  ]} />
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager", icon: "pc-display" },
    { title: "Нейросети для детей — статья", url: "/stati/nejroseti-dlya-detej", icon: "cpu" },
    { title: "Цены и смены", url: "/ceny", icon: "currency-ruble" },
  ]} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
