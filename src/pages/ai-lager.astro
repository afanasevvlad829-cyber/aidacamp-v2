---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Чем AI-программа 2026 года отличается от обычного лагеря",
    text: "В большинстве детских лагерей «AI-программа» — это просто Scratch с новым названием. В АйДаКемп ребята в старших группах реально используют большие языковые модели: пишут промпты, получают ответы, встраивают их в свои боты. Это не презентация о ChatGPT — руки на клавиатуре и рабочий результат на выходе. АйДаКемп — единственный загородный AI-лагерь с нуля в Подмосковье: такой комбинации нет ни у кого в топ-10 поисковой выдачи. АйДаКемп — <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT-лагерь</a>, где ребята работают с реальными AI-инструментами. Нейросети — одна из программ нашего <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a>.",
    list: [
      "ChatGPT API / Gemini API — настоящая работа с LLM, не демонстрация",
      "AI для генерации изображений — Stable Diffusion, Midjourney-подходы",
      "Telegram-бот с AI-модулем — уходишь домой с работающим ботом",
      "Хакатон «Стартап из будущего» — защита AI-проекта перед всем лагерем",
      "Разбор как работают нейросети — на понятных примерах без математики"
    ]
  },
  {
    h2: "Нужно ли знать программирование для AI-смены?",
    text: "Нет. Программа выстроена от нуля: ребята без опыта начинают с базовых блоков и визуального программирования, потом мягко переходят к Python-шаблонам с готовым каркасом. За 10 дней — рабочий AI-бот. Тем, кто уже писал на Python, дадут задачи сложнее: системные промпты, цепочки вызовов, интеграция внешних API. Ноутбук привозить не нужно — все компьютеры в лагере."
  },
  {
    h2: "AI-лагерь для детей: чему учат в 2026 году",
    text: "АйДаКемп — IT-лагерь, где школьники 7–15 лет работают с искусственным интеллектом как с инструментом, а не изучают его по учебнику. Старшие группы (12–15 лет) используют ChatGPT API и Gemini для написания собственных ботов, генерации контента и помощников. Младшие — знакомятся с AI через Scratch и образовательные модули: рисуют нейросетью, задают вопросы, изучают как работает распознавание образов."
  },
  {
    h2: "Программа AI-лагеря по дням — что осваивают",
    text: "За 10–14 дней AI-трека ребята проходят от «что такое нейросеть» до работающего AI-проекта. Прогрессия по дням:",
    list: [
      "Дни 1–2: что такое AI и как работают языковые модели — на простых примерах без математики. Практика: пишем промпты, сравниваем результаты, учимся формулировать задачи для нейросети",
      "Дни 3–5: Python + AI. Подключение Gemini API или OpenAI API из Python-скрипта. Первый чат-бот который отвечает на вопросы. Понятие токенов, контекстного окна, системного промпта",
      "Дни 6–8: расширение AI-проекта. Добавление памяти (контекст разговора), интеграция с Telegram Bot API. Начало финального AI-проекта — каждый выбирает тему",
      "Дни 9–10 (или до 14): разработка AI-стартапа. Telegram-бот-помощник / AI-арт-генератор / AI-учитель / AI-игра. Упаковка, тестирование, подготовка питча",
      "Финал: хакатон «Стартап из будущего» — каждый за 3 минуты объясняет свой AI-продукт, демо работающего прототипа"
    ]
  },
  {
    h2: "Для какого возраста подходит AI-лагерь — и почему инструменты разные",
    text: "AI-программа масштабируется по возрасту. «AI для 8-летнего» и «AI для 15-летнего» — принципиально разные треки. Мы осознанно выбираем разные инструменты под каждую группу:",
    list: [
      "7–9 лет: Scratch + AI-блоки. Учатся ставить вопросы нейросети, рисуют с помощью AI-инструментов, делают интерактивные анимации с голосовыми командами. Главное — не бояться AI",
      "10–12 лет: Python + Gemini API. Gemini лучше подходит этому возрасту: точнее интерпретирует нечёткие запросы и устойчивее к «детским» промптам. Ребята создают чат-ботов с памятью, AI-помощников для школы, изучают Computer Vision через готовые API",
      "13–15 лет: продвинутый AI-трек. ChatGPT API, системные промпты, промпт-инжиниринг как профессиональный навык управления моделью. NLP-задачи: классификация, суммаризация, перевод. AI-стартап с полноценным питчем и демо",
      "12+ лет без опыта Python: программа адаптирована, начинают с визуальных блоков и Gemini через простой Python-шаблон. За 10 дней дойдут до рабочего бота"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену в AI-лагере",
    text: "Финальный AI-проект — не демонстрация, а работающий прототип. Примеры проектов из прошлых смен:",
    list: [
      "AI-помощник для подготовки к ЕГЭ — Telegram-бот, который объясняет темы, задаёт вопросы и проверяет ответы",
      "AI-арт-генератор — бот принимает описание и возвращает изображение через Stable Diffusion API",
      "AI-переводчик жаргона — объясняет сленг для родителей или сленг взрослых для детей",
      "AI-рекомендатор аниме/игр — анализирует вкусы и предлагает что посмотреть, учится на обратной связи",
      "AI-тренер по английскому — диалоговый бот, исправляет ошибки, объясняет правила",
      "AI-игра «Детектив» — история с разветвлёнными диалогами, AI играет роль NPC"
    ]
  },
  {
    h2: "Этика AI и безопасное использование нейросетей",
    text: "Отдельный блок программы — как использовать AI ответственно. Не нудный инструктаж: ребята приходят к выводам через практические задачи. Откуда берутся данные для обучения? Почему нейросеть может ошибаться или отвечать предвзято? Можно ли доверять AI-решению без проверки?",
    list: [
      "Откуда нейросеть «знает» ответ — и когда она галлюцинирует",
      "Авторство и AI: чей это текст или картинка, если помогала нейросеть?",
      "Личные данные в промптах — что не стоит вводить и почему",
      "Фейки и deepfake — как распознать сгенерированный контент",
      "Корпоративный API с фильтрами контента — в лагере используется закрытая среда, не открытый браузерный доступ"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для AI-образования",
    text: "AI-курсы для подростков появляются повсюду. Вот что отличает АйДаКемп:",
    list: [
      "Реальные API, не «игрушечные» — ребята работают с теми же инструментами что и взрослые разработчики: ChatGPT API, Gemini — то что используется в индустрии",
      "Python как основа — AI без программирования это потребитель. У нас ребята создают AI-продукты, а не просто используют готовые",
      "Промпт-инжиниринг как отдельный навык в программе 13–15 лет — не «пиши запросы», а системный подход к управлению языковой моделью",
      "Хакатон-формат финала — защита AI-проекта перед жюри из IT-специалистов. Навык питча, умение объяснить свой продукт — отдельная ценность",
      "Группы до 8 человек — AI-проекты индивидуальные, преподаватель помогает каждому с его конкретной задачей"
    ]
  },
  {
    h2: "Почему учить подростков AI-инструментам нужно уже сейчас",
    text: "Через 5 лет большинство профессий предполагает работу с AI-инструментами. Ребята, которые привыкли к ним в 12–13 лет, не будут испытывать тревоги перед «магией алгоритмов» — они знают, как это работает изнутри. Это не про то, что ребёнок «станет программистом». Это про то, что он не будет чувствовать себя отстающим в технологиях."
  },
  {
    h2: 'Нейросети для детей — что изучают в лагере',
    text: 'Программа не про «посмотрите как работает ChatGPT». Школьники подключают реальные API и создают работающие AI-инструменты. За смену — конкретный проект с искусственным интеллектом внутри.',
    list: [
      'Промпт-инжиниринг: как правильно формулировать задачи для нейросетей',
      'ChatGPT API: подключение к своему проекту, управление диалогом',
      'Gemini и другие модели: сравнение, выбор под задачу',
      'AI-бот: Telegram-бот с нейросетью внутри — принимает вопросы, отвечает умно',
      'AI-арт и генерация: Midjourney, Stable Diffusion — для тех кто хочет в визуал',
      'Мини-стартап: идея → прототип на AI → защита на хакатоне'
    ]
  },
  {
    h2: 'Лагерь искусственного интеллекта — часто задаваемые вопросы',
    text: 'Что спрашивают родители перед записью на AI-смену.',
    list: [
      'Нужен ли опыт программирования: базовый Python помогает, но не обязателен — объясняем с нуля',
      'Возраст для AI-направления: от 12 лет, но есть адаптированная программа от 10 лет',
      'Ноутбук свой: не нужен — лагерь предоставляет оборудование',
      'Что возьмёт домой: работающий AI-проект — бот, инструмент или прототип стартапа',
      'Безопасность контента: все API настроены на safe mode, нежелательный контент заблокирован'
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title="Лагерь AI — искусственный интеллект и нейросети для детей 2026 | АйДаКемп Подмосковье"
  description={`Летний лагерь AI и нейросетей для детей 7–15 лет в Подмосковье 2026. ChatGPT API, Gemini, промпт-инжиниринг. Реальный проект за смену. От ${PRICE_MIN}.`}
  h1="Лагерь AI и нейросетей для детей 2026 — Подмосковье"
  canonical="https://aidacamp.ru/ai-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое AI-лагерь для детей?", a: "Детский загородный лагерь с треком по искусственному интеллекту: ChatGPT API, Gemini, Stable Diffusion, промпт-инжиниринг, практические AI-проекты для школьников 7–15 лет. Единственный загородный AI-лагерь с нуля в Подмосковье." },
    { q: "Нужно ли знать программирование для AI-смены?", a: "Нет. Программа выстроена от нуля: без опыта начинают с визуальных блоков и Scratch. За 10 дней — рабочий AI-бот. Тем, кто уже писал на Python, дают задачи сложнее: системные промпты, NLP, Computer Vision через API." },
    { q: "Что создаёт ребёнок на AI-треке?", a: "Реальный проект: AI-помощник в Telegram, AI-арт-генератор, AI-игра с диалогами или AI-учитель. Защита на хакатоне «Стартап из будущего» в последний день перед жюри из IT-специалистов." },
    { q: "Чем AI-лагерь отличается от обычного IT-лагеря?", a: "Фокус на нейросетях как инструменте для своих проектов. Ребята не просто используют ChatGPT — они встраивают AI в программы которые пишут сами. Плюс блок по этике AI и промпт-инжинирингу для старших групп." },
    { q: "Безопасно ли давать детям доступ к ChatGPT?", a: "В лагере используется корпоративный API с настроенными фильтрами контента. Ребята работают в контролируемой среде — открытого браузерного доступа к ChatGPT нет. Все запросы через код под наблюдением преподавателя." },
    { q: "Что такое хакатон «Стартап из будущего»?", a: "Финальное мероприятие AI-смены. Каждый ребёнок за 3 минуты представляет свой AI-проект: что делает, как работает, кому полезен. Жюри — преподаватели и IT-специалисты. Родители присутствуют или подключаются онлайн. Вручаются сертификаты." },
    { q: "Можно ли детям изучать нейросети и искусственный интеллект в лагере?", a: `Да. АйДаКемп — загородный лагерь AI и нейросетей в Подмосковье для детей 10–15 лет. Работают с ChatGPT API, Gemini, промпт-инжинирингом. Не смотрят — создают: AI-бот, AI-инструмент или мини-стартап. Смены с 30 мая 2026, от ${PRICE_MIN}.` }
  ]} />
    <CourseSchema
      name="AI-лагерь для детей — нейросети и ChatGPT API"
      description="Летний AI-лагерь для детей 7–15 лет: работа с ChatGPT API, Gemini, создание AI-ботов и стартапов. Июньские и августовские смены в Подмосковье."
      url="https://aidacamp.ru/ai-lager"
      level="Beginner"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь AI и нейросетей для детей 2026 — Подмосковье"
    subtitle="Школьники 7–15 лет работают с ChatGPT API, Gemini и нейросетями. Не смотрят видео — создают реальные AI-проекты. Без опыта, группы до 8 человек."
    breadcrumb="AI-лагерь"
    keywords={[
      "ChatGPT API, Gemini, промпт-инжиниринг — реальный AI-трек",
      "Python + AI: проект-стартап на хакатоне в финале смены",
      `${STAT_DISTANCE} от Москвы, от ${CAMP_PRICE_FROM}, группы до 8 человек`
    ]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="AI-лагерь для детей в Подмосковье 2026 — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Нейросети для детей — с чего начать и зачем", url: "/stati/nejroseti-dlya-detej/", description: "С какого возраста учить, что делают дети с ChatGPT и почему код важнее промптов.", icon: "cpu" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej/", description: "Python + AI — мощная комбинация. Как дети создают AI-проекты в лагере.", icon: "code-slash" },
    { title: "ИИ заменит программиста?", url: "/stati/ii-zamenit-programmista/", description: "Почему умение работать с AI — самый востребованный навык ближайшего десятилетия.", icon: "stars" },
  ]} />
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp/", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager/", icon: "pc-display" },
    { title: "Нейросети для детей — статья", url: "/stati/nejroseti-dlya-detej/", icon: "cpu" },
    { title: "Цены и смены", url: "/ceny/", icon: "currency-exchange" },
  ]} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
