---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Лагерь с бассейном в Подмосковье — что входит в стоимость",
    text: "АйДаКемп — детский IT-лагерь в Наро-Фоминском районе с открытым бассейном на территории. Бассейн, питание 5 раз в день, проживание в корпусах, IT-программа и все активности уже включены в стоимость смены — без доплат. Территория санатория «Изумруд» в 66 км от МКАД: лес, чистый воздух, охраняемая зона."
  },
  {
    h2: "Бассейн в лагере — расписание и правила",
    text: "Открытый бассейн доступен ежедневно в послеобеденные часы. Плавание — свободное и организованное: каждая группа получает своё время, инструктор дежурит у воды. Детей не принуждают — кто боится воды, может наблюдать с бортика. Дополнительных занятий по плаванию нет — это отдых, а не тренировки."
  },
  {
    h2: "Что делают в лагере кроме бассейна",
    text: "Бассейн — это послеобед. Утро и вечер — IT-программа: каждый делает свой проект с нуля. Scratch, Python, Minecraft Education, создание ботов и сайтов. В конце смены — хакатон, где дети защищают проект перед всем лагерем. После хакатона — проект остаётся навсегда.",
    list: [
      "IT-занятия утром и вечером — проект за смену",
      "Бассейн и спортплощадки после обеда",
      "Вечерние активности: настольные игры, квесты, мафия",
      "Хакатон в последние 2 дня смены",
      "Трансфер из Москвы — организованный заезд и выезд"
    ]
  },
  {
    h2: "Детский лагерь с бассейном — для кого подходит",
    text: "Лагерь подходит детям 7–15 лет. Группы делятся по возрасту: 7–9 лет (Scratch, Minecraft), 10–12 лет (Python начальный, Roblox Studio), 13–15 лет (Python Advanced, AI, Telegram-боты). Бассейн — общий, каждая группа купается в своё время. Если у ребёнка аллергия на хлор — есть альтернативные активности на свежем воздухе."
  },
  {
    h2: "Как выбрать смену в лагерь с бассейном на лето 2026",
    text: "Все шесть смен 2026 года проходят на одной и той же территории — с бассейном. Короткие смены (7–8 дней) подойдут для первого раза: ребята успеют и поплавать, и сделать первый проект. Длинные смены (13–14 дней) — для тех, кто хочет результат посерьёзнее.",
    list: [
      "Смена 1: 30 мая — 8 июня, 10 дней — 74 900 ₽",
      "Смена 2: 10 — 23 июня, 14 дней — 95 000 ₽ (флагман)",
      "Смена 2.1: 10 — 16 июня, 7 дней — 48 000 ₽",
      "Смена 2.2: 16 — 23 июня, 8 дней — 65 000 ₽",
      "Смена 3: 3 — 15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17 — 26 августа, 10 дней — 69 600 ₽"
    ]
  },
  {
    h2: "Что взять с собой в лагерь с бассейном",
    text: "Список того, что нужно взять с собой: купальник и плавки (2–3 штуки, они быстро намокают и медленно сохнут), тапки для бассейна, солнцезащитный крем SPF 30+, солнечные очки. Всё остальное — стандартный список лагеря: одежда на погоду, личная гигиена, блокнот. Ноутбук не нужен — все IT-занятия проходят на оборудованных компьютерах лагеря."
  },
  {
    h2: "Лагерь с бассейном — родителям о безопасности",
    text: "Бассейн открытый, за купанием следит дежурный инструктор. Дети плавают в отведённое время, не в одиночку. Дополнительные правила: дети, не умеющие плавать, купаются только у бортика с нарукавниками; есть мелкая и глубокая зоны. Медпункт работает круглосуточно. Территория лагеря охраняется, видеонаблюдение включено на входах."
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагерь с бассейном в Подмосковье 2026 — IT | АйДаКемп"
  description="Детский IT-лагерь с бассейном в Подмосковье. Открытый бассейн, программирование, питание включены. Смены май–август 2026 от 48 000 ₽."
  h1="Детский лагерь с бассейном в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-s-basseynom"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Есть ли бассейн в детском лагере АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Да. На территории санатория «Изумруд» — открытый бассейн с ионизированной водой (без хлора). Купание каждый день или через день по расписанию. Бассейн входит в стоимость смены, без доплат." } },
        { "@type": "Question", "name": "Какие детские лагеря с бассейном есть в Подмосковье?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп работает в санатории «Изумруд» в Наро-Фоминском районе — открытый бассейн с ионизированной водой, 66 км от Москвы. IT-программирование, 5-разовое питание, охрана 24/7. Смены июнь–август 2026 от 48 000 ₽." } },
        { "@type": "Question", "name": "Безопасен ли бассейн для детей?", "acceptedAnswer": { "@type": "Answer", "text": "Да. Бассейн санатория «Изумруд» с ионизированной водой (без хлора, без аллергии). Купание под надзором вожатых. На территории медработник 24/7. Дети купаются по расписанию в своих группах." } },
        { "@type": "Question", "name": "Что кроме бассейна есть в лагере?", "acceptedAnswer": { "@type": "Answer", "text": "IT-программа дважды в день (Python, AI, Minecraft, 3D), спортивные площадки, командные игры, хакатон в конце смены. 5-разовое питание с учётом аллергий, комнаты по 2–4 человека с санузлом, охрана 24/7." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь с бассейном в Подмосковье"
    subtitle="Открытый бассейн + IT-программа + питание — всё включено в стоимость. Смены июнь–август 2026."
    breadcrumb="Лагерь с бассейном"
    keywords={[
      `Бассейн каждый день — открытый, ${STAT_DISTANCE} от Москвы`,
      "IT-проект за смену: Python, Scratch, Minecraft, AI",
      `От ${CAMP_PRICE_FROM} — проживание, питание, бассейн включены`
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь с бассейном в Подмосковье 2026 — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
