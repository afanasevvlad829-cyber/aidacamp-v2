---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM, STAT_LICENSE, STAT_RATING } from '../data/contacts';
import FAQSchema from '../components/FAQSchema.astro';
import { SEASON_MONTHS_NOM, SEASON_SHIFTS_PHRASE } from '../data/evergreen';

const sections = [
  {
    h2: "Лагерь с бассейном в Подмосковье — что входит в стоимость",
    text: "АйДаКемп — детский IT-лагерь в Наро-Фоминском районе с закрытым бассейном на территории. Бассейн, питание 5 раз в день, проживание в корпусах, IT-программа и все активности уже включены в стоимость смены — без доплат. Территория оздоровительного санатория «Изумруд» в Наро-Фоминском районе Московской области, 66 км от МКАД: лес, чистый воздух, охраняемая зона."
  },
  {
    h2: "Технические характеристики бассейна",
    text: "Бассейн санатория «Изумруд» — крытый, с подогревом воды и ионизационной системой очистки. Это значит: никакого хлора, никакого раздражения глаз, минимальный запах. Температура воды поддерживается на уровне 28–30°C круглый год — комфортно даже в прохладный июньский день.",
    list: [
      "Тип: закрытый (крытый), не зависит от погоды",
      "Очистка: ионизация воды — без хлора, без раздражения слизистых",
      "Температура воды: 28–30°C постоянно",
      "Зоны: мелкая (0.9 м) и глубокая (1.5 м) — дорожки разграничены",
      "Дежурный инструктор у воды на протяжении всего купания"
    ]
  },
  {
    h2: "Расписание бассейна — когда и сколько",
    text: "Бассейн открывается после обеда — примерно с 14:30 до 17:00. Каждая возрастная группа купается в своё время (40–50 минут), группы не пересекаются в воде. Купание через день — чтобы не перегружать ребят и оставить время для уличных активностей.",
    list: [
      "Время работы: послеобеденные часы, ~14:30–17:00",
      "Длительность сеанса на группу: 40–50 минут",
      "Периодичность: через день по расписанию смены",
      "Принудительно не загоняем — кто не хочет, остаётся на активностях снаружи"
    ]
  },
  {
    h2: "Структура дня: IT утром + бассейн после обеда",
    text: "День в АйДаКемп устроен так, чтобы мозг и тело получали нагрузку поочерёдно. Утро — голова свежая, занятия идут продуктивно. После обеда — бассейн и спорт на улице, к вечеру снова в режим.",
    list: [
      "9:00–10:30 — первое IT-занятие: код, проект, разбор задач",
      "10:30–11:00 — перерыв, свежий воздух",
      "11:00–12:30 — второе IT-занятие: продолжаем проект",
      "13:00–14:30 — обед и тихий час",
      "14:30–17:00 — бассейн и спортплощадки",
      "19:00–21:00 — вечерние активности: квесты, настольные игры, хакатон (в конце смены)"
    ]
  },
  {
    h2: "Что делают в лагере кроме бассейна",
    text: "Бассейн — это послеобед. Утро — IT-программа: каждый работает над своим проектом с нуля. Scratch, Python, Minecraft Education, создание ботов и сайтов. В конце смены — хакатон, где ребята защищают проект перед всем лагерем. После хакатона — проект остаётся навсегда.",
    list: [
      "IT-занятия утром и вечером — проект за смену",
      "Бассейн и спортплощадки после обеда",
      "Вечерние мероприятия: спортивные игры на улице, квесты, мафия, настольные игры",
      "Хакатон в последние 2 дня смены",
      "Трансфер из Москвы — организованный заезд и выезд"
    ]
  },
  {
    h2: "Детский лагерь с бассейном — для кого подходит",
    text: "Лагерь подходит детям 7–15 лет. Группы делятся по возрасту: 7–9 лет (Scratch, Minecraft), 10–12 лет (Python начальный, Roblox Studio), 13–15 лет (Python Advanced, AI, Telegram-боты). Бассейн — общий, каждая группа купается в своё время. Если у ребёнка аллергия на хлор — есть альтернативные активности на свежем воздухе."
  },
  {
    h2: `Как выбрать смену лагеря с бассейном на лето ${SEASON_YEAR}`,
    text: `Все ${SEASON_SHIFTS_PHRASE} ${SEASON_YEAR} года проходят на одной и той же территории — с бассейном. Июньские смены уже завершены, открыты к брони августовские (10 и 13 дней). Длинные смены — для тех, кто хочет результат посерьёзнее. Путёвки на августовские смены ещё доступны — осталось ограниченное число мест.`,
    list: [
      `Смена 1 (завершена): ${DATES_S1}, 10 дней — ${PRICE_S1}`,
      `Смена 2 (завершена): ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 2.1 (завершена): ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2.2 (завершена): ${DATES_SHORT_S22}, 8 дней — ${PRICE_S22}`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`
    ]
  },
  {
    h2: "Что взять с собой в поездку с бассейном",
    text: "Список того, что нужно взять с собой: купальник и плавки (2–3 штуки, они быстро намокают и медленно сохнут), тапки для бассейна, солнцезащитный крем SPF 30+, солнечные очки. Всё остальное — стандартный список лагеря: одежда на погоду, личная гигиена, блокнот. Ноутбук не нужен — все IT-занятия проходят на оборудованных компьютерах лагеря."
  },
  {
    h2: "Смена с бассейном — родителям о безопасности",
    text: `Бассейн закрытый, за купанием следит дежурный инструктор. Дети плавают в отведённое время, не в одиночку. Дополнительные правила: дети, не умеющие плавать, купаются только у бортика с нарукавниками; есть мелкая и глубокая зоны. Медпункт работает круглосуточно. Территория лагеря охраняется, видеонаблюдение включено на входах. Официальная организация детского отдыха — документы, лицензия и отзывы открыты. Лагерь работает по лицензии Минобрнауки ${STAT_LICENSE}, рейтинг ${STAT_RATING} на Яндекс.Картах — отзывы родителей открыты и проверяемы.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский лагерь с бассейном в Подмосковье ${SEASON_YEAR} — IT | АйДаКемп`}
  description={`Детский IT-лагерь с бассейном в Подмосковье. Крытый бассейн с ионизированной водой, IT-программирование для 7–15 лет, питание 5 раз в день. Все включено. Смены ${SEASON_MONTHS_NOM} ${SEASON_YEAR} от ${PRICE_MIN}.`}
  h1="Детский лагерь с бассейном в Подмосковье"
  canonical="https://aidacamp.ru/lager-s-basseynom"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Есть ли бассейн в детском лагере АйДаКемп?", a: "Да. На территории санатория «Изумруд» — закрытый бассейн с ионизированной водой (без хлора). Купание каждый день или через день по расписанию. Бассейн входит в стоимость смены, без доплат." },
    { q: "Какие детские лагеря с бассейном есть в Подмосковье?", a: `АйДаКемп работает в санатории «Изумруд» в Наро-Фоминском районе — закрытый бассейн с ионизированной водой, 66 км от МКАД. IT-программирование, 5-разовое питание, охрана 24/7. Смены ${SEASON_MONTHS_NOM} ${SEASON_YEAR} от ${PRICE_MIN}.` },
    { q: "Безопасен ли бассейн для детей?", a: "Да. Бассейн санатория «Изумруд» с ионизированной водой (без хлора, без аллергии). Купание под надзором вожатых. На территории медработник 24/7. Дети купаются по расписанию в своих группах." },
    { q: "Что кроме бассейна есть в лагере?", a: "IT-программа дважды в день (Python, AI, Minecraft, 3D), спортивные площадки, командные игры, хакатон в конце смены. 5-разовое питание с учётом аллергий, комнаты по 2–4 человека с санузлом, охрана 24/7." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь с бассейном в Подмосковье"
    subtitle={`Закрытый бассейн + IT-программа + питание — всё включено в стоимость. Смены ${SEASON_MONTHS_NOM} ${SEASON_YEAR}.`}
    breadcrumb="Лагерь с бассейном"
    keywords={[
      `Бассейн через день — закрытый, ${STAT_DISTANCE} от Москвы`,
      "IT-проект за смену: Python, Scratch, Minecraft, AI",
      `От ${CAMP_PRICE_FROM} — проживание, питание, бассейн включены`
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt={`Детский лагерь с бассейном в Подмосковье ${SEASON_YEAR} — АйДаКемп`}
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
