---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';
import { PAYMENT_SPLIT, STAT_RATING, STAT_KIDS, PHONE_MOBILE, PHONE_MOBILE_HREF } from '../data/contacts';

const sections = [
  {
    h2: "IT-лагерь рядом со Звенигородом — оба на западе, ~1 час",
    text: "Звенигород — тихий западный городок Подмосковья, и АйДаКемп находится с той же западной стороны области. До санатория «Изумруд» отсюда всего ~45 км и примерно час по А107, малому бетонному кольцу: без выезда на МКАД и без столичных пробок. Подросток едет не на другой конец света, а в соседний лесной район — и привозит оттуда настоящий IT-проект."
  },
  {
    h2: "Маршрут из Звенигорода в АйДаКемп — около часа",
    text: "Звенигород стоит между Новорижским и Минским шоссе, а наш лагерь — на Киевском: их связывает А107, малое бетонное кольцо. Поездка занимает примерно час — вы движетесь поперёк западного Подмосковья, не заезжая в Москву. АйДаКемп в 66 км от МКАД, но отсюда путь короче, ведь вы уже на западе.",
    list: [
      "На машине: по А107 (малое бетонное кольцо) на Киевское шоссе, около часа",
      "Электричка: ст. Нара (~1 ч 20 мин с пересадкой), далее такси ~20 мин до лагеря",
      `Трансфер лагеря от м. Солнцево — ${TRANSFER_PRICE_FMT}, до метро ~40 мин на машине`
    ]
  },
  {
    h2: "Трансфер из Звенигорода в лагерь",
    text: `Трансфер лагеря (${TRANSFER_PRICE_FMT} в один конец, с сопровождающим) отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Звенигорода до точки сбора — около 40 минут, но многим семьям удобнее ехать напрямую через А107: это тоже около часа, и крюк к метро не нужен.`,
    list: [
      `Трансфер ${TRANSFER_PRICE_FMT} в один конец, от м. Солнцево в день заезда и обратно в день отъезда`,
      "До м. Солнцево — ~40 мин на машине",
      "Альтернатива: привезти ребёнка прямо в лагерь по А107 — около часа"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Звенигорода",
    text: "АйДаКемп — лицензированная образовательная организация. Родители оформляют налоговый вычет точно так же, как москвичи: через личный кабинет налоговой на nalog.ru.",
    list: [
      `Смена 4 — 10 дней (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 — 13 дней (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Чем заняты школьники в IT-лагере",
    text: "АйДаКемп — лагерь с настоящей технологической программой. Загородный лагерь для летнего отдыха детей с проживанием — в 66 км от МКАД, на западе Подмосковья, в той же стороне что и Звенигород. Ребята 7–15 лет выбирают трек по душе: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, ведут их практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортивные площадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: `В АйДаКемп работают преподаватели-практики и воспитатели с педагогическим образованием. Родители из Звенигорода всегда в курсе, чем занят их подросток. Оздоровительная программа и IT-занятия идут параллельно, бронирование смены фиксирует место сразу, а рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей.`,
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Почему семьи из Звенигорода выбирают АйДаКемп",
    text: "Звенигород и наш лагерь — на одной западной стороне Подмосковья, их соединяет бетонка А107. Это близко и без столичного трафика:",
    list: [
      "~1 час от Звенигорода по А107 — без выезда на МКАД и без пробок через Москву",
      "Тот же западный климат и природа — никакой акклиматизации, подросток сразу в ритм",
      "Можно заехать в любой день смены — проведать или привезти забытые вещи",
      "Самостоятельный заезд без трансфера — просто привезти на машине, около часа"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены и наличие мест`,
    text: "Открыты к брони августовские смены — места ещё есть, но сокращаются, бронируйте сейчас. В стоимость входят проживание, питание, полная IT-программа, бассейн и активности.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} отдельно`
    ]
  },
  {
    h2: "Отзывы семей из Звенигорода и западного Подмосковья",
    text: `В АйДаКемп едут ребята из Звенигорода, Кубинки, Голицыно и других городов запада области. Придуманных цитат тут не будет — есть настоящие ${otzyvyLink()} и карточка лагеря на ${yandexReviewsLink()}. Что из них пригодится западным семьям:`,
    list: [
      "Одна сторона области: по бетонке около часа, без Москвы и без МКАД",
      "Родительский день — повод доехать самим и посмотреть территорию санатория «Изумруд» своими глазами",
      "Minecraft-моды: трек, про который ребята рассказывают дома дольше всего"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`IT-лагерь рядом со Звенигородом ${SEASON_YEAR} — ~1 час | АйДаКемп`}
  description={`Летний IT-лагерь ~1 час от Звенигорода по А107. Python и AI для ребят 7–15 лет, вычет до ${VYCHET_MAX}. Смены ${SEASON_YEAR}.`}
  h1="Летний IT-лагерь рядом со Звенигородом"
  canonical="https://aidacamp.ru/lager-zvenigorod"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь рядом со Звенигородом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, около часа от Звенигорода по А107. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-zvenigorod"
      ageMin={7}
      ageMax={15}
    />

  </Fragment>
  <LandingHero slot="hero"
    h1="Летний IT-лагерь рядом со Звенигородом"
    subtitle={`IT-лагерь в Наро-Фоминском районе — около часа от Звенигорода по А107, оба на западе Подмосковья. Трансфер от м. Солнцево ${TRANSFER_PRICE_FMT}.`}
    breadcrumb="Лагерь из Звенигорода"
    keywords={["~1 час от Звенигорода по А107, без выезда на МКАД", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь рядом со Звенигородом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    ...[
    { q: "Как добраться из Звенигорода до лагеря АйДаКемп?", a: "Из Звенигорода — около часа на машине по А107 (малому бетонному кольцу) на Киевское шоссе, без выезда на МКАД. Звенигород и лагерь на западной стороне Подмосковья, поэтому объезжать Москву не нужно. Сам лагерь — 66 км от МКАД." },
    { q: "Есть ли трансфер из Звенигорода?", a: `Прямого трансфера из Звенигорода нет. Есть трансфер лагеря от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец, с сопровождающим; из Звенигорода до метро ~40 минут. Многим удобнее ехать прямо в лагерь по А107 — это около часа.` },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%. Для семей из Звенигорода это работает так же, как для москвичей: документы через nalog.ru. Возврат от ~${VYCHET_S4} (10-дневная смена) до ${VYCHET_MAX} (13-дневная).` },
    { q: "Для каких ребят подходит лагерь?", a: "Для школьников 7–15 лет. Опыт программирования не нужен: группы формируются по уровню — начинающие, средний, продвинутые. Занятия в группах до 8 человек." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — подросток выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ],
    ...[
    { q: "Как быстро добраться из Звенигорода в АйДаКемп?", a: `Около часа на машине: Звенигород и лагерь на западе Подмосковья, по А107 (малому бетонному кольцу) выезжаете на Киевское шоссе без МКАД и пробок. Сам лагерь — 66 км от МКАД. Трансфер лагеря от м. Солнцево — ${TRANSFER_PRICE_FMT} (из Звенигорода ~40 минут до метро).` },
    { q: "Входит ли в стоимость трансфер из Звенигорода?", a: `Трансфер платный — ${TRANSFER_PRICE_FMT} в один конец, от м. Солнцево. Из Звенигорода до Солнцево ~40 минут. Или привезите ребёнка сами по А107 — около часа.` },
    { q: "Можно ли заехать в лагерь в середине смены из Звенигорода?", a: "Да. Близость лагеря (около часа от Звенигорода) позволяет родителям проведывать ребят или привозить забытые вещи во время смены." },
    { q: "Какой налоговый вычет получит родитель из Звенигорода?", a: `На смену 10 дней (${PRICE_S4}) — возврат ~${VYCHET_S4}; на 13 дней (${PRICE_S3}) — до ${VYCHET_MAX}. Оформляется через nalog.ru как у москвичей.` }
  ]
  ]} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-[14px] text-slate-500 mt-2">
      Смотрите также: <a href="/lager-odintsovo/" class="text-primary hover:underline">лагерь рядом с Одинцово</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты {SEASON_YEAR}</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Как быстро добраться из Звенигорода в АйДаКемп?</h2>
  <p><strong>Время:</strong> около часа на машине из Звенигорода — по А107 (малому бетонному кольцу) на Киевское шоссе, без выезда на МКАД и пробок.</p>
  <p><strong>Направление:</strong> Звенигород и лагерь на западной стороне Подмосковья, поэтому объезжать Москву не нужно.</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, {TRANSFER_PRICE_FMT} в один конец (из Звенигорода до Солнцево ~40 минут).</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
