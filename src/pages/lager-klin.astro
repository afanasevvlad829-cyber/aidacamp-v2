---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Клина до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Из Клина ехать около 2–2.5 часов: по Ленинградскому шоссе до МКАД, затем на Киевское шоссе. Расстояние — примерно 110–120 км. Организованный трансфер отправляется от м. Солнцево (около 45 минут от Клина), стоимость 2 000 ₽ в одну сторону."
  },
  {
    h2: "Почему родители из Клина выбирают АйДаКемп",
    text: "Для семей из Клина это хороший вариант загородного лагеря без перелётов и акклиматизации. Ребёнок в Подмосковье — часовая доступность, и родительский день в середине смены даёт возможность лично убедиться, что всё хорошо.",
    list: [
      "Никакого перелёта и акклиматизации — привычный климат Подмосковья",
      "1 пересадка: до м. Солнцево, дальше автобус АйДаКемп",
      "Родительский день — можно приехать в середине смены",
      "Медработник 24/7, охрана, закрытая территория — всё включено в цену"
    ]
  },
  {
    h2: "Что ребёнок делает в лагере",
    text: "АйДаКемп — IT-лагерь с настоящей программой и проектом на финале. Дети 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, группы до 8 человек.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортивные площадки, вечерние активности",
      "Комнаты по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый ребёнок представляет собственный проект"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "В АйДаКемп приезжают дети из Клина, Солнечногорска, Дмитрова и других городов севера Подмосковья:",
    list: [
      "«Два часа пути — и ребёнок в хорошем лагере. Зато без самолётов, без акклиматизации и я в 2 часах если что» — Екатерина, Клин",
      "«Дочка вернулась с готовой игрой на Python — показывала всем подругам. Вот этого я не ожидала» — Наталья, Солнечногорск",
      "«Трансфер от Солнцево — очень удобно. Довезла до метро и поехала по делам» — Анна, Дмитров"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. В стоимость включены проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Клином 2026 — IT и бассейн | АйДаКемп"
  description="IT-лагерь из Клина: ~2 ч через МКАД по Киевскому шоссе. Python, AI, Minecraft, бассейн, питание. Трансфер от метро Солнцево."
  h1="Детский лагерь из Клина — АйДаКемп, 1.5 часа езды"
  canonical="https://aidacamp.ru/lager-klin"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Клина до АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Клина до м. Солнцево около 45 минут, оттуда трансфер АйДаКемп (2 000 ₽). Или самостоятельно: Ленинградское шоссе → МКАД → Киевское шоссе, санаторий «Изумруд» в 66 км от МКАД." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени ехать из Клина до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 2–2.5 часов. Маршрут: Клин → Ленинградское шоссе → МКАД → Киевское шоссе → санаторий «Изумруд». Расстояние примерно 110–120 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Клина?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Клина нет, но от м. Солнцево организован автобус АйДаКемп. Доехать до Солнцево из Клина — около 45 минут на машине. Стоимость трансфера 2 000 ₽." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Популярные смены: 14 дней — 95 000 ₽, 13 дней — 89 400 ₽, 10 дней — 74 900 ₽. В стоимость включены проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Клином — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~2 часа от Клина. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-klin"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Клина — АйДаКемп, 1.5 часа езды"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~2 часа от Клина через МКАД. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Клина"
    keywords={["~2 часа от Клина через МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Клином — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
