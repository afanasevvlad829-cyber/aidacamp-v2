---
import { Icon } from 'astro-icon/components';
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_MAX, DAYS_MIN, DAYS_S2, DAYS_S21, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';
import { STAT_RATING } from '../data/contacts';
import { SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "Как добраться до нас",
    text: `АйДаКемп находится в санатории «Изумруд» в Наро-Фоминском районе Московской области, 66 км от МКАД по Киевскому шоссе. От вас — около 130 км, ~1 ч 40 мин: по Ленинградскому шоссе до МКАД, затем на Киевское шоссе. Организованный трансфер отправляется от м. Солнцево — от вас удобно доехать на электричке (Ленинградское направление), стоимость трансфера ${TRANSFER_PRICE_FMT}. Клин — крупный город на севере области, поэтому логистика получается предсказуемой: можно выехать вечером и уже утром быть на месте. Лагерь принимает ребят оттуда каждую смену — логистика уже отработана десятками семей с севера области.`
  },
  {
    h2: "Клин и Чайковский — но ребята идут в IT",
    text: "Здесь помнят Чайковского и старинную усадьбу. Но сегодняшние подростки смотрят в сторону технологий. Для городских школьников это возможность провести летние каникулы в лагере и вернуться с реальным IT-проектом. Путь к лагерю от вас занимает меньше двух часов, поэтому даже спонтанная поездка на родительский день не станет проблемой.",
    list: [
      "Ленинградское шоссе → МКАД → Киевское шоссе — понятный маршрут",
      "~130 км, ~1 ч 40 мин — доступно даже для однодневной поездки",
      "Родительский день — можно приехать в середине смены",
      "Медработник 24/7, охрана, закрытая территория лагеря — всё включено в цену"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: `Команда — IT-преподаватели-практики и вожатые, прошедшие конкурсный отбор. Один преподаватель на 6–8 участников — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Родители получают фото со смены в Telegram-чат отряда каждый день. Это официальный оздоровительный лагерь: путёвка оформляется по договору, рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей. Организации детского отдыха обязаны соответствовать требованиям Роспотребнадзора — АйДаКемп работает в этом формате с 2019 года.`,
    list: [
      "1 преподаватель на 6–8 ребят — никто не потеряется в потоке",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото из лагеря в Telegram — родители всегда в курсе",
      `Лицензия Минобрнауки, документы для налогового вычета до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Чем занимается участник смены",
    text: "АйДаКемп — детский IT-лагерь с настоящей программой и проектом на финале. Школьники 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут с профессиональными IT-преподавателями, группы до 8 человек. Наш лагерь построен так, чтобы за одну смену успеть и разобраться в теме, и довести проект до финала.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортивные площадки, вечерние активности в лагере",
      "Детский лагерь: комнаты по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый участник лагеря представляет собственный проект"
    ]
  },
  {
    h2: `Августовские смены ${SEASON_YEAR} завершились`,
    text: "Отсюда в детский лагерь едут осознанно, выбирая подходящие даты. Размещение в корпусах санатория «Изумруд» — комнаты по 2–4 человека с санузлом.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, ${DAYS_S3}, ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, ${DAYS_S4}, ${PRICE_S4}`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} отдельно`
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: `В АйДаКемп приезжают из ваших краёв, <a href='/lager-solnechnogorsk/'>Солнечногорска</a>, Дмитрова и других городов севера Подмосковья — и в лагере таких ребят каждую смену набирается целый отряд. Цитат с чужими именами мы не придумываем: настоящие отзывы — ${otzyvyLink('на странице отзывов')} и в карточке на ${yandexReviewsLink()}. Коротко о том, что там пишут северные семьи:`,
    list: [
      "Близость: два часа по области вместо перелёта и акклиматизации, и родители остаются в паре часов от лагеря",
      "Трансфер от м. Солнцево — самый частый выбор для дальних городов: довезли до метро и дальше не переживаете",
      "Результат: игра, бот или 3D-модель, которую есть что показать подругам и одноклассникам"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский лагерь из Клина АйДаКемп ${SEASON_YEAR} | IT-программы, бассейн, трансфер`}
  description={`Детский IT-лагерь из Клина: 1.5 ч езды, Python, AI, Minecraft, Roblox, 3D-моделирование. Бассейн, питание, медработник 24/7, трансфер от м. Солнцево. Смены ${SEASON_FROM_TO}. От ${PRICE_MIN}.`}
  h1="Детский лагерь из Клина"
  canonical="https://aidacamp.ru/lager-klin"
  breadcrumb="Из Клина"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь рядом с Клином — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 часа от Клина. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-klin"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "АйДаКемп",
  "description": "Детский IT-лагерь в Подмосковье для ребят из Клина",
  "url": "https://aidacamp.ru/lager-klin",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "RU",
    "addressRegion": "Московская область",
    "addressLocality": "Наро-Фоминск",
    "streetAddress": "Санаторий Изумруд"
  },
  "areaServed": ["Клин", "Солнечногорск", "Дмитров", "Москва"],
  "knowsAbout": ["Python", "Искусственный интеллект", "Minecraft", "Roblox", "3D-моделирование"]
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Клина"
    subtitle="IT-кемп в Наро-Фоминском районе — ~1.5 часа от вас через МКАД. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Из Клина"
    keywords={["~1.5 часа от вас через МКАД по Киевскому шоссе", "Python, AI, Minecraft для детей 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Клином — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
        { q: "Как добраться из Клина до АйДаКемп?",
          a: `От вас по Ленинградскому шоссе → МКАД → Киевское шоссе, санаторий «Изумруд» в 66 км от МКАД. Или на электричке Ленинградского направления → метро до м. Солнцево → трансфер АйДаКемп (${TRANSFER_PRICE_FMT}).` },
        { q: "Сколько времени ехать из Клина до лагеря?",
          a: "Около 1.5–2 часов. Маршрут: от вас → Ленинградское шоссе → МКАД → Киевское шоссе → санаторий «Изумруд». Расстояние примерно 130 км." },
        { q: "Есть ли трансфер из Клина?",
          a: `Прямого трансфера от вас нет, но от м. Солнцево организован автобус АйДаКемп (${TRANSFER_PRICE_FMT}). От вас удобно добраться на электричке Ленинградского направления до Москвы, затем метро до Солнцево.` },
        { q: "Сколько стоит смена в АйДаКемп?",
          a: `Стоимость прошедших смен: от ${PRICE_MIN} за ${DAYS_MIN} до ${PRICE_MAX} за ${DAYS_MAX}. В стоимость включены проживание, питание, IT-программа, бассейн и страховка. Кемп работает по системе полного пакета — доплат в процессе смены нет.` }
      ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">летний IT-кемп в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>


<section class="landing-section">
  <div class="container">
    <h2>Выбери программу и смену</h2>
    <p>
      Если вы ищете вариант в Подмосковье недалеко от вас, подходящий по программе и датам:
    </p>
    <ul style="list-style: none; padding: 0;">
      <li><Icon name="bi:mortarboard-fill" class="bi bi-mortarboard-fill" aria-hidden="true" /> <strong><a href="/stati/programma-it-lagerya/">Программы IT</a></strong> — выбери Python, AI, Minecraft, Roblox или 3D-моделирование на основной странице</li>
      <li><Icon name="bi:calendar-event" class="bi bi-calendar-event" aria-hidden="true" /> <strong><a href="/ceny/">Смены и даты</a></strong> — посмотри график на июнь, июль и август с полным описанием каждой смены</li>
      <li><Icon name="bi:cash-coin" class="bi bi-cash-coin" aria-hidden="true" /> <strong><a href="/ceny/">Стоимость и льготы</a></strong> — уточни цены, варианты оплаты, налоговый вычет и скидки на длительные смены</li>
    </ul>
    <p style="margin-top: 1.5rem; font-size: 0.95rem; color: #666;">
      Родители оттуда обычно приезжают на родительский день в середине смены или встречают ребят при возврате из трансфера от Солнцево.
    </p>
  </div>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
