---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Клина до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Из Клина — около 130 км, ~1 ч 40 мин: по Ленинградскому шоссе до МКАД, затем на Киевское шоссе. Организованный трансфер отправляется от м. Солнцево — от Клина удобно доехать на электричке (Ленинградское направление → Ленинградский вокзал → метро), стоимость трансфера 2 000 ₽."
  },
  {
    h2: "Клин и Чайковский — но ребята идут в IT",
    text: "Клин знаменит Чайковским и усадьбой. Но сегодняшние подростки из Клина смотрят в сторону технологий. Для семей, которые ищут лагерь «не просто отдохнуть», АйДаКемп — это ~1.5 часа по Ленинградскому шоссе и настоящий IT-проект в конце смены. Родительский день в середине смены — возможность лично убедиться, что ребёнок доволен.",
    list: [
      "Ленинградское шоссе → МКАД → Киевское шоссе — понятный маршрут",
      "~130 км, ~1 ч 40 мин — доступно для семей из Клина",
      "Родительский день — можно приехать в середине смены",
      "Медработник 24/7, охрана, закрытая территория — всё включено в цену"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Родители получают фото из лагеря в Telegram-чат отряда каждый день.",
    list: [
      "1 преподаватель на 6–8 ребят — никто не потеряется в потоке",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram — родители всегда в курсе",
      "Лицензия Минобрнауки, документы для налогового вычета до 5 434 ₽"
    ]
  },
  {
    h2: "Что участник делает в лагере",
    text: "АйДаКемп — IT-лагерь с настоящей программой и проектом на финале. Школьники 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, группы до 8 человек.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортивные площадки, вечерние активности",
      "Комнаты по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый участник представляет собственный проект"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены раскупают первыми — самый популярный сезон. Из Клина едут осознанно: выбирают заранее, бронируют конкретные даты. Июнь и август ещё открыты.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ отдельно"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "В АйДаКемп приезжают из Клина, Солнечногорска, Дмитрова и других городов севера Подмосковья:",
    list: [
      "«Почти два часа пути — и ребёнок в хорошем лагере. Без самолётов, без акклиматизации, и я в двух часах если что» — Екатерина, Клин",
      "«Дочка вернулась с готовой игрой на Python — показывала всем подругам. Вот этого я не ожидала» — Наталья, Солнечногорск",
      "«Трансфер от Солнцево — очень удобно. Довезла до метро и поехала по делам» — Анна, Дмитров"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь из Клина АйДаКемп 2026 | IT-программы, бассейн, трансфер"
  description="IT-лагерь для детей из Клина: 1.5 ч езды, Python, AI, Minecraft, Roblox, 3D-моделирование. Бассейн, питание, медработник 24/7, трансфер от м. Солнцево. Смены с июня по август. От 48 000 ₽."
  h1="Детский IT-лагерь из Клина — АйДаКемп, всего 1.5 часа езды через Москву"
  canonical="https://aidacamp.ru/lager-klin"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Клина до АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Клина по Ленинградскому шоссе → МКАД → Киевское шоссе, санаторий «Изумруд» в 66 км от МКАД. Или на электричке Ленинградского направления → метро до м. Солнцево → трансфер АйДаКемп (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени ехать из Клина до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов. Маршрут: Клин → Ленинградское шоссе → МКАД → Киевское шоссе → санаторий «Изумруд». Расстояние примерно 130 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Клина?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Клина нет, но от м. Солнцево организован автобус АйДаКемп (2 000 ₽). Из Клина удобно добраться на электричке Ленинградского направления до Москвы, затем метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Популярные смены: 14 дней — 95 000 ₽, 13 дней — 89 400 ₽, 10 дней — 74 900 ₽. В стоимость включены проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Клином — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 часа от Клина. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-klin"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "АйДаКемп",
  "description": "Детский IT-лагерь в Подмосковье для ребят из Клина",
  "url": "https://aidacamp.ru/lager-klin",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "RU",
    "addressRegion": "Московская область",
    "addressLocality": "Наро-Фоминск",
    "streetAddress": "Санаторий Изумруд"
  },
  "areaServed": ["Клин", "Солнечногорск", "Дмитров", "Москва"],
  "knowsAbout": ["Python", "Искусственный интеллект", "Minecraft", "Roblox", "3D-моделирование"]
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Клина — АйДаКемп, 1.5 часа езды"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Клина через МКАД. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Клина"
    keywords={["~1.5 часа от Клина через МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Клином — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

<section class="landing-section">
  <div class="container">
    <h2>Почему АйДаКемп выбирают родители из Клина</h2>
    <p>
      АйДаКемп — это специализированный <strong>детский IT-лагерь</strong>, расположенный на базе санатория «Изумруд» в Наро-Фоминском районе Подмосковья. Для семей из Клина лагерь остаётся оптимальным выбором: рядом с домом, без авиаперелётов и акклиматизации, но с серьёзной IT-программой и полной инфраструктурой.
    </p>
    
    <div class="content-block">
      <h3>Программа обучения и проекты</h3>
      <p>
        В <strong>летнем детском лагере в Подмосковье</strong> ребята выбирают IT-направление по интересам. Программа включает <strong>Python для начинающих</strong>, курсы по искусственному интеллекту и нейросетям, моделирование в Minecraft и Roblox, 3D-проектирование. Занятия проводятся дважды в день по 90 минут в малых группах (6–8 человек) с одним преподавателем на группу.
      </p>
      <p>
        Главная фишка — <strong>итоговый IT-хакатон</strong> в конце смены. Каждый участник презентует собственный проект на встречу родителей. Это не просто развлечение: ребята видят реальный результат своего труда, получают первый опыт в портфолио, понимают, что IT — не абстрактная школьная предмет, а реальное дело.
      </p>
    </div>

    <div class="content-block">
      <h3>Условия проживания и питание</h3>
      <p>
        Жилые комнаты рассчитаны на 2–4 человека с собственным санузлом — это стандарт комфорта для <strong>летнего лагеря для школьников</strong>. Завтрак, два перекуса, обед, полдник и ужин (5 приёмов пищи в день) готовят по согласованному меню. Учитываются аллергии и предпочтения.
      </p>
      <p>
        На территории санатория — <strong>ионизированный бассейн</strong>, спортивные площадки, волейбольная площадка, теннисные столы. Вечерние активности включают настольные игры, кино, дискотеку, командные игры. Это балансирует интенсивные IT-занятия физическим отдыхом.
      </p>
    </div>

    <div class="content-block">
      <h3>Безопасность и медицина</h3>
      <p>
        <strong>Детский лагерь рядом с Клином</strong> работает с медработником, дежурящим 24/7. На входе охрана, территория закрыта и контролируется. Всё включено в стоимость смены.
      </p>
      <p>
        Родители получают ежедневные фото в Telegram-чат отряда. В середине смены проводится <strong>родительский день</strong> — можно приехать, увидеть ребёнка, условия, встретиться с вожатыми. Лицензия Минобрнауки, документы для налогового вычета (до 5 434 ₽) предоставляются автоматически.
      </p>
    </div>

    <div class="content-block">
      <h3>Доступность и график смен</h3>
      <p>
        <strong>Летний лагерь для детей из Клина</strong> работает с июня по август. Июльские смены раскупают в первую очередь, но июнь и август остаются открытыми:
      </p>
      <ul>
        <li><strong>Смена 2.1</strong> — 10–16 июня, 7 дней, 48 000 ₽ (идеально для первого опыта)</li>
        <li><strong>Смена 2</strong> — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная, есть льгота)</li>
        <li><strong>Смена 3</strong> — 3–15 августа, 13 дней, 89 400 ₽</li>
        <li><strong>Смена 4</strong> — 17–26 августа, 10 дней, 74 900 ₽</li>
      </ul>
      <p>
        Трансфер от метро Солнцево организован отдельно — 2 000 ₽ туда-обратно. Это удобнее, чем ехать на личном автомобиле: родитель может оставить машину, использовать электричку и метро, пока автобус везёт ребят.
      </p>
    </div>
  </div>
</section>

<section class="landing-section">
  <div class="container">
    <h2>Выбери программу, смену и отправляйся в лагерь</h2>
    <p>
      Если вы ищете <strong>детский лагерь в Подмосковье близко к Клину</strong>, подходящий по программе и датам:
    </p>
    <ul style="list-style: none; padding: 0;">
      <li>🎓 <strong><a href="/programmy">Программы IT</a></strong> — выбери Python, AI, Minecraft, Roblox или 3D-моделирование на основной странице</li>
      <li>📅 <strong><a href="/smeny">Смены и даты</a></strong> — посмотри график на июнь, июль и август с полным описанием каждой смены</li>
      <li>💰 <strong><a href="/stoimost">Стоимость и льготы</a></strong> — уточни цены, варианты оплаты, налоговый вычет и скидки на длительные смены</li>
    </ul>
    <p style="margin-top: 1.5rem; font-size: 0.95rem; color: #666;">
      Бронирование идёт в реальном времени — если интересующая вас смена показана как открытая, мест ещё достаточно. Родители из Клина обычно приезжают на родительский день в середине смены или встречают ребят при возврате из трансфера от Солнцево.
    </p>
  </div>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
