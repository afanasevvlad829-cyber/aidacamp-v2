---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { SEASON_YEAR } from '../data/shifts';

const sections = [
  {
    h2: "Почему компании выбирают АйДаКемп",
    text: "Летний отдых детей — одна из самых востребованных льгот в корпоративном соцпакете. АйДаКемп работает с юридическими лицами: договор, акт, счёт-фактура. Компания может компенсировать сотруднику стоимость путёвки полностью или частично. Это и забота о команде, и реальная польза для детей.",
    list: [
      "Договор с ООО/ИП, все закрывающие документы",
      "Счёт и акт выполненных работ",
      "Групповые условия от 3 путёвок — уточняйте при запросе",
      "Возможность оформить как подарок к Новому году или 1 июня"
    ]
  },
  {
    h2: "Что получают дети сотрудников",
    text: "Полноценная IT-смена в Подмосковье: Python, AI, Minecraft, дизайн. Проживание в комнатах по 2–4 человека, 5-разовое питание, бассейн, охрана 24/7. Ребёнок уезжает с готовым IT-проектом и новыми друзьями.",
    list: [
      "7–15 дней в загородном лагере в Подмосковье",
      "IT-программа по возрасту: 7–10, 10–12, 13–15 лет",
      "Проживание, питание, программа включены в стоимость",
      "Результат — проект, который ребята защищают на хакатоне"
    ]
  },
  {
    h2: "Как оформить путёвки для сотрудников",
    text: 'Напишите нам в <a href="https://wa.me/79688086455" target="_blank" rel="noopener">WhatsApp</a> или на <a href="mailto:hello@codims.ru">hello@codims.ru</a> с пометкой «корпоративный запрос». Укажите количество детей, возраст и желаемые смены. Мы подготовим коммерческое предложение, договор и счёт в течение одного рабочего дня.'
  },
  {
    h2: "Варианты корпоративной программы",
    text: "За 4 года работы с юрлицами мы выработали три формата корпоративного сотрудничества. Выбирайте тот, который подходит вашей компании:",
    list: [
      "Полная компенсация — компания оплачивает 100% стоимости путёвки. Самый мощный HR-bonus, работает для ключевых сотрудников и руководителей отделов",
      "Частичная компенсация (50/50) — половину компания, половину сотрудник. Подходит для массового применения, снижает нагрузку на HR-бюджет",
      "Фиксированная субсидия — компания покрывает фиксированную сумму (например 40 000 ₽), сотрудник доплачивает остаток. Удобно для бюджетирования",
      "Подарочные сертификаты — компания заранее покупает пакет путёвок по сниженной цене, выдаёт как призы лучшим сотрудникам к праздникам",
      "Retention-программа — 1 путёвка = 1 отработанный год в компании, выдаётся как юбилейный бонус"
    ]
  },
  {
    h2: "Корпоративные скидки",
    text: "Мы готовы предоставить групповые условия для компаний, заказывающих более 3 путёвок одновременно. Скидки зависят от объёма и срока заказа:",
    list: [
      "От 3 путёвок — скидка 5%",
      "От 5 путёвок — скидка 8%",
      "От 10 путёвок — скидка 12%",
      "От 20 путёвок — индивидуальные условия + возможность фирменного брендинга смены",
      "При раннем бронировании (до 1 марта) — дополнительно 5% на весь объём"
    ]
  },
  {
    h2: "Кто уже работает с нами",
    text: "С 2019 года мы оформляли корпоративные программы для компаний из разных сфер — от IT-стартапов до крупных производственных холдингов. Среди наших корпоративных клиентов:",
    list: [
      "IT-компании — Т-Банк, VK, Yandex, несколько стартапов. Для них это естественный выбор: детский IT-лагерь = тема, понятная и родителю и компании",
      "Промышленность — Bimeister, Rehau, ТрансЭнергоСнаб. Большие команды, организованное бронирование за 3+ месяца",
      "Консалтинг и финансы — 2UP Consulting, X5 ICh, несколько банков. Обычно компенсация 50/50 как часть социального пакета",
      "Образовательный сектор — АйДаКодить и несколько языковых школ. Путёвки как призы учителям за лучшие результаты года"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/dlya-kompaniy.avif"
  title="Путёвки в лагерь для сотрудников компаний | АйДаКемп"
  description={`IT-лагерь АйДаКемп для детей сотрудников. Корпоративные путёвки, частичная компенсация, договор с юрлицом. Подмосковье, лето ${SEASON_YEAR}. Групповые условия.`}
  h1="Путёвки в лагерь для детей сотрудников"
  canonical="https://aidacamp.ru/dlya-kompaniy"
>
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
            { "@type": "ListItem", "position": 2, "name": "Для компаний", "item": "https://aidacamp.ru/dlya-kompaniy" }
          ]
        },
        {
          "@type": "Service",
          "name": "Корпоративные путёвки в IT-лагерь АйДаКемп",
          "description": `IT-лагерь АйДаКемп для детей сотрудников компаний. Корпоративные путёвки, частичная компенсация, договор с юрлицом. Подмосковье, лето ${SEASON_YEAR}.`,
          "url": "https://aidacamp.ru/dlya-kompaniy",
          "provider": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
          "areaServed": { "@type": "City", "name": "Москва" },
          "serviceType": "Детский образовательный лагерь, корпоративные путёвки"
        }
      ]
    })}</script>
  </Fragment>
  <LandingHero slot="hero"
    h1="Путёвки в лагерь для детей сотрудников"
    subtitle="Помогите сотрудникам решить вопрос летнего отдыха детей — с договором, закрывающими документами и групповыми условиями."
    breadcrumb="Для компаний"
    keywords={["Договор с юридическим лицом, закрывающие документы", "Групповые условия от 3 путёвок", "Частичная компенсация сотруднику через соцпакет"]}
    image="/images/hero/dlya-kompaniy.avif"
    imageAlt="Лагерь для детей сотрудников АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
