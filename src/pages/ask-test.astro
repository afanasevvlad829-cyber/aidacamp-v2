---
export const prerender = true;
const title = 'Тест AI-чата — внутренний';
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--or:#ec9b44;--nv:#060e1a;--sans:'Manrope',sans-serif;--mono:'JetBrains Mono',monospace}
    html,body{height:100%;background:var(--nv);font-family:var(--sans);color:#fff;overflow:hidden}

    /* HEADER */
    .header{padding:10px 16px;background:rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:12px;flex-shrink:0;flex-wrap:wrap;row-gap:6px}
    .header-title{font-size:13px;font-weight:800;color:var(--or);white-space:nowrap}
    .header-sub{font-size:11px;color:rgba(255,255,255,.35);white-space:nowrap}
    .dot{width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 6px #4ade80;flex-shrink:0;transition:.3s}
    .dot.thinking{background:var(--or);box-shadow:0 0 6px var(--or);animation:blink 1s infinite}
    .dot.paused{background:#a78bfa;box-shadow:0 0 6px #a78bfa}
    .dot.idle{background:rgba(255,255,255,.2);box-shadow:none}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    .persona-row{display:flex;gap:5px;margin-left:auto;flex-wrap:wrap}
    .pb{padding:4px 10px;border-radius:20px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);font-size:11px;font-weight:600;color:rgba(255,255,255,.45);cursor:pointer;transition:.15s;font-family:var(--sans)}
    .pb:hover,.pb.on{border-color:var(--or);color:var(--or);background:rgba(236,155,68,.1)}

    .speed-row{display:flex;gap:4px}
    .sp{padding:4px 9px;border-radius:20px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);font-size:10px;font-weight:700;color:rgba(255,255,255,.35);cursor:pointer;transition:.15s;font-family:var(--sans)}
    .sp:hover,.sp.on{border-color:rgba(96,165,250,.4);color:#93c5fd;background:rgba(96,165,250,.08)}

    /* LAYOUT */
    .layout{display:grid;grid-template-columns:400px 1fr;height:calc(100vh - 45px);overflow:hidden}

    /* LEFT PANEL */
    .agent-panel{border-right:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;overflow:hidden;background:rgba(0,0,0,.2)}
    .agent-head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px;flex-shrink:0}
    .agent-avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#ec9b44,#ff9520);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
    .agent-name{font-size:12px;font-weight:700}
    .agent-role{font-size:10px;color:rgba(255,255,255,.35);margin-top:1px}

    .agent-log{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:7px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.06) transparent}
    .agent-log::-webkit-scrollbar{width:3px}
    .agent-log::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:3px}

    .log-entry{line-height:1.55;padding:8px 10px;border-radius:8px;word-break:break-word}
    .log-entry.sys{font-size:10px;font-family:var(--mono);color:rgba(255,255,255,.3);background:rgba(255,255,255,.03)}
    .log-entry.think{font-size:11px;background:rgba(236,155,68,.08);border:1px solid rgba(236,155,68,.12);color:rgba(255,200,100,.7)}
    .log-entry.mama{font-size:12px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.15);color:#a7f3d0}
    .log-entry.bot{font-size:12px;background:rgba(96,165,250,.07);border:1px solid rgba(96,165,250,.14);color:#bfdbfe}
    .log-entry.block-badge{font-size:11px;background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.15);color:#c4b5fd}
    .log-entry.err{font-size:11px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:#fca5a5}
    .log-entry.paused-notice{font-size:11px;background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.25);color:#c4b5fd;text-align:center;font-weight:700}
    .log-ts{font-size:9px;color:rgba(255,255,255,.2);font-family:var(--mono);margin-bottom:3px}
    .log-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;opacity:.6;margin-bottom:3px}

    /* STATS */
    .stats-bar{padding:8px 12px;background:rgba(0,0,0,.15);border-top:1px solid rgba(255,255,255,.05);display:flex;gap:16px;flex-shrink:0}
    .stat-val{font-size:15px;font-weight:800;color:var(--or);display:block}
    .stat-lbl{font-size:8px;color:rgba(255,255,255,.25);text-transform:uppercase;letter-spacing:.07em}

    /* CONTROLS */
    .controls{padding:10px;border-top:1px solid rgba(255,255,255,.06);display:flex;gap:7px;flex-shrink:0}
    .btn{flex:1;padding:9px 6px;border-radius:8px;border:none;font-family:var(--sans);font-size:11px;font-weight:800;cursor:pointer;transition:.15s;letter-spacing:.02em}
    .btn:disabled{opacity:.35;cursor:default}
    .btn-start{background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.2)}
    .btn-start:not(:disabled):hover{background:rgba(34,197,94,.25)}
    .btn-pause{background:rgba(167,139,250,.13);color:#c4b5fd;border:1px solid rgba(167,139,250,.2)}
    .btn-pause:not(:disabled):hover{background:rgba(167,139,250,.22)}
    .btn-stop{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.18)}
    .btn-stop:not(:disabled):hover{background:rgba(239,68,68,.18)}
    .btn-clear{background:rgba(255,255,255,.05);color:rgba(255,255,255,.4);border:1px solid rgba(255,255,255,.08)}
    .btn-clear:hover{background:rgba(255,255,255,.1)}

    /* RIGHT PANEL */
    .chat-panel{position:relative;overflow:hidden}
    .chat-panel iframe{width:100%;height:100%;border:none}
    .chat-flash{position:absolute;inset:0;pointer-events:none;border:2px solid transparent;transition:.4s}
    .chat-flash.on{border-color:rgba(34,197,94,.35);box-shadow:inset 0 0 40px rgba(34,197,94,.06)}

    @media(max-width:860px){.layout{grid-template-columns:1fr}.chat-panel{display:none}}
  </style>
</head>
<body>

<div class="header">
  <span class="dot idle" id="dot"></span>
  <div>
    <div class="header-title">Мама-тестировщик</div>
    <div class="header-sub" id="statusText">Выберите персону и запустите</div>
  </div>
  <div class="speed-row">
    <button class="sp" data-ms="600" onclick="setSpeed(this)">Быстро</button>
    <button class="sp on" data-ms="1800" onclick="setSpeed(this)">Нормально</button>
    <button class="sp" data-ms="3500" onclick="setSpeed(this)">Медленно</button>
  </div>
  <div class="persona-row">
    <button class="pb on" data-persona="anxious" onclick="setPersona(this)">😟 Тревожная</button>
    <button class="pb" data-persona="practical" onclick="setPersona(this)">📊 Практичная</button>
    <button class="pb" data-persona="skeptic" onclick="setPersona(this)">🙄 Скептик</button>
    <button class="pb" data-persona="ready" onclick="setPersona(this)">✅ Почти готова</button>
    <button class="pb" data-persona="dumb" onclick="setPersona(this)">🤔 Не понимает</button>
  </div>
</div>

<div class="layout">
  <div class="agent-panel">
    <div class="agent-head">
      <div class="agent-avatar" id="personaAvatar">😟</div>
      <div>
        <div class="agent-name" id="personaName">Мама Анна, сын 10 лет</div>
        <div class="agent-role" id="personaDesc">Переживает, первый раз отпускает одного</div>
      </div>
    </div>

    <div class="agent-log" id="agentLog">
      <div class="log-entry sys">Готов к тесту. Нажмите ▶ Старт</div>
    </div>

    <div class="stats-bar">
      <div><span class="stat-val" id="sRounds">0</span><span class="stat-lbl">раундов</span></div>
      <div><span class="stat-val" id="sMsgs">0</span><span class="stat-lbl">сообщений</span></div>
      <div><span class="stat-val" id="sBlocks">0</span><span class="stat-lbl">блоков</span></div>
      <div><span class="stat-val" id="sTime">—</span><span class="stat-lbl">время</span></div>
    </div>

    <div class="controls">
      <button class="btn btn-start" id="btnStart" onclick="startTest()">▶ Старт</button>
      <button class="btn btn-pause" id="btnPause" onclick="togglePause()" disabled>⏸ Пауза</button>
      <button class="btn btn-stop" id="btnStop" onclick="stopTest()" disabled>■ Стоп</button>
      <button class="btn btn-clear" onclick="clearAll()">↺</button>
    </div>
  </div>

  <div class="chat-panel">
    <iframe id="chatFrame" src="/ask/" title="Чат"></iframe>
    <div class="chat-flash" id="chatFlash"></div>
  </div>
</div>

<script is:inline>
const PERSONAS = {
  anxious: {
    avatar:'😟', name:'Мама Анна, сын 10 лет', desc:'Первый раз отпускает одного, тревожится',
    prompt:`Ты — мама Анна, сыну 10 лет. Рассматриваешь IT-лагерь АйДаКемп.
Ты тревожная: переживаешь что ребёнок будет скучать, первый раз без тебя, не умеет программировать.
Задаёшь по ОДНОМУ короткому вопросу, как в WhatsApp. Говори живо, иногда с опечатками.
Волнуют: безопасность, связь, что если заболеет, подходит ли возраст.
Начни нейтрально — например спроси про возраст.`
  },
  practical: {
    avatar:'📊', name:'Мама Света, дочь 12 лет', desc:'Смотрит на цифры: цены, даты, документы',
    prompt:`Ты — мама Светлана, дочери 12 лет. Практичная, конкретная.
Интересуют только факты: цены, что входит, вычет, документы, рассрочка.
Один конкретный вопрос за раз. Если ответ расплывчатый — переспрашиваешь.
Начни с вопроса о стоимости.`
  },
  skeptic: {
    avatar:'🙄', name:'Мама Елена, сын 13 лет', desc:'Сын не хочет, сама не уверена',
    prompt:`Ты — мама Елена, сыну 13 лет. Скептически настроена: сын говорит что лагерь это скучно.
Смотришь по просьбе мужа. Возражаешь: "сын не хочет", "он и так немного умеет", "это просто комп-лагерь".
Но в глубине интересуешься. Одно возражение/вопрос за раз.
Начни: "Сын говорит что ему это неинтересно".`
  },
  ready: {
    avatar:'✅', name:'Мама Ирина, сын 9 лет', desc:'Почти решила, уточняет детали',
    prompt:`Ты — мама Ирина, сыну 9 лет. Почти решила записать — уточняешь последнее перед бронью.
Какая смена лучше для 9 лет, какие документы, как оплатить, сроки.
Позитивна но дотошна. Один вопрос за раз.
Начни с вопроса какая смена лучше для 9-летнего.`
  },
  dumb: {
    avatar:'🤔', name:'Мама Наташа, сын 8 лет', desc:'Не понимает IT, спрашивает "что такое Python"',
    prompt:`Ты — мама Наташа, сыну 8 лет. Ты далека от IT совсем.
Задаёшь "простые" вопросы: что такое Scratch, зачем программирование, чем Minecraft-курс отличается от просто игры,
почему нельзя просто в Ютубе посмотреть. Говоришь простыми словами.
Один наивный вопрос за раз. Начни с "а что такое Scratch, я не понимаю".`
  }
};

let persona = 'anxious';
let running = false;
let paused = false;
let pauseResolve = null;
let abort = new AbortController();
let rounds=0, msgs=0, blocks=0, t0=null, timer=null;
let convHistory=[], chatHistory=[];
let stepDelay = 1800; // ms между раундами

function setSpeed(btn){
  document.querySelectorAll('.sp').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  stepDelay = parseInt(btn.dataset.ms);
}

function setPersona(btn){
  document.querySelectorAll('.pb').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  persona = btn.dataset.persona;
  const p = PERSONAS[persona];
  document.getElementById('personaAvatar').textContent = p.avatar;
  document.getElementById('personaName').textContent = p.name;
  document.getElementById('personaDesc').textContent = p.desc;
}

function setDot(state){ // idle | thinking | paused | running
  const d = document.getElementById('dot');
  d.className = 'dot ' + (state==='thinking'?'thinking':state==='paused'?'paused':state==='running'?'':' idle');
}

function status(txt){ document.getElementById('statusText').textContent = txt; }

function log(text, type='sys'){
  const box = document.getElementById('agentLog');
  const d = document.createElement('div');
  d.className = 'log-entry '+type;
  const ts = new Date().toLocaleTimeString('ru',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  d.innerHTML = `<div class="log-ts">${ts}</div>${text}`;
  box.appendChild(d);
  box.scrollTop = box.scrollHeight;
  return d;
}

function updateStats(){
  document.getElementById('sRounds').textContent = rounds;
  document.getElementById('sMsgs').textContent = msgs;
  document.getElementById('sBlocks').textContent = blocks;
  if(t0) document.getElementById('sTime').textContent = Math.floor((Date.now()-t0)/1000)+'s';
}

function flash(){
  const f = document.getElementById('chatFlash');
  f.classList.add('on');
  setTimeout(()=>f.classList.remove('on'), 700);
}

function wait(ms){ return new Promise(r=>setTimeout(r,ms)); }

function waitIfPaused(){
  if(!paused) return Promise.resolve();
  return new Promise(resolve=>{ pauseResolve = resolve; });
}

async function callMama(botReply){
  const p = PERSONAS[persona];
  // Ответ бота — это 'user' с точки зрения мама-агента (бот пишет маме)
  if(botReply) convHistory.push({role:'user', content: botReply});
  const msgs2 = convHistory.length > 0
    ? convHistory.slice(-8)
    : [{role:'user', content:'Начни диалог первым вопросом.'}];
  // Если последнее сообщение от user (бот написал) — мама должна ответить, всё ок
  // Если вдруг последнее от assistant (мама) — добавим стимул
  if(msgs2[msgs2.length-1]?.role === 'assistant')
    msgs2.push({role:'user', content:'Продолжай.'});
  const sys = p.prompt + `\n\nОтвет должен быть КОРОТКИМ (1-2 предложения, мессенджер-стиль).
Если тебя уже всё устроило → "СТОП_ЗАПИСАТЬСЯ". Если тупик после 8+ раундов → "СТОП_КОНЕЦ".`;
  const res = await fetch('/api/ask-test-mama',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({system:sys, history:msgs2}),
    signal: abort.signal
  });
  const d = await res.json();
  return d.text || '';
}

async function callBot(userMsg){
  chatHistory.push({role:'user', content:userMsg});
  const res = await fetch('/api/ask',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({message:userMsg, history:chatHistory.slice(0,-1)}),
    signal: abort.signal
  });
  const d = await res.json();
  if(d.block_type) blocks++;
  chatHistory.push({role:'assistant', content:d.text||''});
  // В convHistory для мама-агента: её сообщения = assistant, ответы бота = user
  convHistory.push({role:'assistant', content:userMsg});
  return d;
}

function setBtns(state){ // idle | running | paused
  document.getElementById('btnStart').disabled = state!=='idle';
  document.getElementById('btnPause').disabled = state==='idle';
  document.getElementById('btnStop').disabled = state==='idle';
  document.getElementById('btnPause').textContent = state==='paused' ? '▶ Продолжить' : '⏸ Пауза';
}

async function runLoop(){
  const p = PERSONAS[persona];
  log(`Персона: <strong>${p.avatar} ${p.name}</strong>`, 'sys');
  log('Генерирую первый вопрос...', 'think');
  setDot('thinking'); status('Мама думает...');

  let mamaMsg = '';
  try{
    mamaMsg = await callMama('');
  } catch(e){
    if(e.name!=='AbortError') log('Ошибка: '+e.message,'err');
    stopTest(); return;
  }

  while(running && rounds < 12){
    rounds++;
    updateStats();

    // Ждём если пауза
    await waitIfPaused();
    if(!running) break;

    // Мама пишет
    setDot('running'); status(`Раунд ${rounds} — мама отправляет...`);
    log(`<div class="log-label">💬 Мама:</div>${mamaMsg}`, 'mama');
    msgs++; updateStats();

    if(mamaMsg.includes('СТОП_')){
      log(mamaMsg.includes('ЗАПИСАТЬСЯ')? '✅ <strong>Мама готова записаться!</strong>' : '🏁 Диалог завершён.', 'sys');
      break;
    }

    // Отправляем в бот
    flash();
    let botData;
    try{
      setDot('thinking'); status('Бот думает...');
      botData = await callBot(mamaMsg);
    } catch(e){
      if(e.name!=='AbortError') log('Ошибка бота: '+e.message,'err');
      stopTest(); return;
    }

    const botText = (botData.text||'').replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim();
    log(`<div class="log-label">🤖 Бот:</div>${botText}`, 'bot');
    if(botData.block_type){
      log(`<div class="log-label">📦 Блок:</div><strong>${botData.block_type}</strong>${botData.block_data?' → '+JSON.stringify(botData.block_data):''}`, 'block-badge');
    }
    if(botData.chips?.length){
      const chipLabels = botData.chips.map(c=>c.label).join(' · ');
      log(`<div class="log-label">🔘 Чипы:</div>${chipLabels}`, 'sys');
    }
    msgs++; blocks=blocks; updateStats();

    await wait(stepDelay * 0.4);
    if(!running) break;
    await waitIfPaused();
    if(!running) break;

    // Мама формулирует ответ
    setDot('thinking'); status('Мама формулирует ответ...');
    try{
      mamaMsg = await callMama(botText);
    } catch(e){
      if(e.name!=='AbortError') log('Ошибка агента: '+e.message,'err');
      stopTest(); return;
    }

    await wait(stepDelay * 0.6);
    if(!running) break;
  }

  if(rounds>=12) log('🏁 Лимит раундов (12).', 'sys');
  stopTest();
}

function startTest(){
  running=true; paused=false;
  abort = new AbortController();
  rounds=0; msgs=0; blocks=0; t0=Date.now();
  convHistory=[]; chatHistory=[];
  timer = setInterval(updateStats, 1000);
  setBtns('running'); setDot('thinking');
  document.getElementById('chatFrame').src='/ask/';
  setTimeout(runLoop, 1200);
}

function togglePause(){
  if(!running) return;
  paused = !paused;
  if(paused){
    setBtns('paused'); setDot('paused'); status('⏸ Пауза — читайте спокойно');
    log('⏸ <strong>Пауза</strong> — нажмите «Продолжить» когда готовы.', 'paused-notice');
  } else {
    setBtns('running'); setDot('thinking'); status('Продолжаем...');
    if(pauseResolve){ pauseResolve(); pauseResolve=null; }
  }
}

function stopTest(){
  running=false; paused=false;
  if(pauseResolve){ pauseResolve(); pauseResolve=null; }
  abort.abort();
  clearInterval(timer);
  setBtns('idle'); setDot('idle'); status('Тест завершён');
  log('— конец —', 'sys');
}

function clearAll(){
  if(running) stopTest();
  document.getElementById('agentLog').innerHTML='<div class="log-entry sys">Лог очищен. Готов к новому тесту.</div>';
  rounds=0; msgs=0; blocks=0; t0=null;
  updateStats();
  document.getElementById('sTime').textContent='—';
  document.getElementById('chatFrame').src='/ask/';
}
</script>
</body>
</html>
