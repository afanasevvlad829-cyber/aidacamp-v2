---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Балашиха — IT-столица востока Подмосковья",
    text: "Балашиха — крупнейший город Московской области (520 тыс. человек). Здесь активная IT-сцена, технопарк «Ногинский» и тысячи семей, где родители работают в технологических компаниях. АйДаКемп — естественный следующий шаг: когда ребёнок видит, что родители работают с технологиями, ему интересно попробовать самому. В лагере он сделает первый шаг — и вернётся домой с готовым IT-проектом."
  },
  {
    h2: "Маршрут из Балашихи в лагерь — ~120 км, ~1 ч 20 мин",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе, около 120 км от Балашихи через МКАД. Самый удобный способ — доехать до м. Солнцево и сесть на бесплатный трансфер лагеря.",
    list: [
      "На машине: Балашиха → МКАД (южный объезд) → Киевское шоссе (M-3) → Апрелевка, ~120 км, ~1 ч 20 мин без пробок",
      "На метро: из Балашихи на метро (синяя ветка через центр) до м. Солнцево — около 55–60 мин",
      "Трансфер: от м. Солнцево бесплатно в день заезда и обратно в день отъезда"
    ]
  },
  {
    h2: "Почему родители из Балашихи выбирают АйДаКемп",
    text: "АйДаКемп — это лагерь с лицензией Минобрнауки, рейтингом 5.0 на Яндекс.Картах и реальными IT-проектами на выходе. Школьник отдыхает в Подмосковье — акклиматизации нет, климат привычный.",
    list: [
      "Без акклиматизации — подмосковная природа, привычный климат",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево бесплатно — из Балашихи около часа на метро",
      "Рейтинг 5.0, 40+ отзывов на Яндекс.Картах от подмосковных семей"
    ]
  },
  {
    h2: "IT-программа для школьников из Балашихи",
    text: "Ребята 7–15 лет выбирают трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек — каждый получает внимание преподавателя. В конце смены — хакатон, где школьники защищают свой проект.",
    list: [
      "Python — от переменных до собственного телеграм-бота",
      "Scratch — визуальное программирование для младших (7–10 лет)",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — работа с ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Отзывы родителей из Балашихи",
    text: "В АйДаКемп едут семьи из Балашихи, Реутова, Железнодорожного и других городов востока Подмосковья:",
    list: [
      "«Мы из Балашихи — добрались до Солнцево на метро, дальше автобус лагеря. Дочь вернулась с готовым приложением на Python — я даже не верила, что за 14 дней можно такому научиться» — Марина, Балашиха",
      "«Сначала казалось далеко, но 1.5 часа по МКАД — это совсем не страшно. А сын после лагеря сам попросил продолжить курс по программированию» — Ольга, Железнодорожный"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽ (налоговый вычет ~2 800 ₽)",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (налоговый вычет до 5 434 ₽)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽ (налоговый вычет ~5 200 ₽)",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽ (налоговый вычет ~4 800 ₽)",
      "Трансфер от м. Солнцево — бесплатно"
    ]
  },
  {
    h2: "Безопасность и связь с ребёнком",
    text: "Родители из Балашихи могут доехать до лагеря за 1,5–2 часа при необходимости. Но до «необходимости» доходит редко: медработник на территории круглосуточно, охрана 24/7, закрытая территория санатория. Каждый вечер — пачка живых фотографий в Telegram-канале отряда. Не постановочных, а настоящих — за едой, за кодом, на хакатоне.",
    list: [
      "1,5–2 ч от Балашихи до лагеря в случае необходимости",
      "Медработник живёт на территории весь сезон, не «на телефоне»",
      "Фото каждый вечер в 21:00 в закрытый Telegram-канал",
      "Страховка ВСК включена в стоимость путёвки"
    ]
  },
  {
    h2: "Что ребёнок привезёт домой",
    text: "Не просто загар и воспоминания. После АйДаКемп дети привозят: работающий проект (бот, игру или приложение — зависит от трека), сертификат участника хакатона, и новых друзей из других городов. По данным опроса выпускников 2025: 78% продолжают заниматься программированием после смены.",
    list: [
      "Работающий код: бот, игра, приложение — зависит от выбранного трека",
      "Сертификат участника хакатона АйДаКемп",
      "78% продолжают программировать после лагеря (опрос 2025)",
      "Друзья из других городов — часто переписка продолжается годами"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Балашиха 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Балашихи: ~120 км через МКАД → Киевское шоссе, ~1 ч 20 мин. IT-программа, бассейн, Python, AI, Minecraft для школьников 7–15 лет. Трансфер от м. Солнцево бесплатно."
  h1="Детский лагерь рядом с Балашихой"
  canonical="https://aidacamp.ru/lager-balashiha"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Балашихи до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Балашихи до лагеря около 120 км и ~1 ч 20 мин: по МКАД → Киевское шоссе (M-3) → Апрелевка. Удобнее: доехать до м. Солнцево (около часа на метро) и сесть на бесплатный трансфер АйДаКемп." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Балашихи до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа 20 минут на автомобиле (120 км через МКАД → Киевское шоссе). До м. Солнцево из Балашихи — около часа на метро, затем бесплатный трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Балашихи?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Балашихи нет. Бесплатный трансфер отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Балашихи до Солнцево — около часа на метро (синяя ветка)." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Балашихи?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево бесплатный." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Балашихой — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~120 км от Балашихи через МКАД. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-balashiha"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Балашихой", "item": "https://aidacamp.ru/lager-balashiha/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Балашихой"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~120 км из Балашихи через МКАД → Киевское шоссе. Python, AI, Minecraft для школьников 7–15 лет."
    breadcrumb="Лагерь из Балашихи"
    keywords={["~1 ч 20 мин из Балашихи, трансфер от м. Солнцево бесплатно", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Балашихой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
