---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Балашихи до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 85 км от Балашихи, примерно 1.5 часа езды. Маршрут: МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Дорога через Москву или по МКАД. Организованный трансфер отправляется от м. Солнцево — туда из Балашихи удобно добраться на метро через Москву."
  },
  {
    h2: "Почему родители из Балашихи выбирают АйДаКемп",
    text: "Балашиха — восток Подмосковья, но расстояние не пугает тех, кто ценит качество. АйДаКемп — это лагерь с лицензией Минобрнауки, рейтингом 5.0 на Яндекс.Картах и реальными IT-проектами на выходе. Ребёнок отдыхает в Подмосковье — акклиматизации нет, климат привычный. Трансфер от м. Солнцево (2 000 ₽) снимает вопрос логистики.",
    list: [
      "Без акклиматизации — подмосковная природа, привычный климат",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево — удобно доехать из Балашихи на метро",
      "Рейтинг 5.0, 40+ отзывов на Яндекс.Картах от подмосковных семей"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Балашихи",
    text: "Дети 7–15 лет выбирают трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек — каждый ребёнок получает внимание преподавателя. В конце смены — хакатон, где дети защищают свой проект.",
    list: [
      "Python — от переменных до собственного телеграм-бота",
      "Scratch — визуальное программирование для младших (7–10 лет)",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — работа с ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "В АйДаКемп едут семьи из Балашихи, Реутова, Железнодорожного и других городов востока Подмосковья:",
    list: [
      "«Мы из Балашихи — добрались до Солнцево на метро, дальше автобус лагеря. Дочь вернулась с готовым приложением на Python — я даже не верила, что за 14 дней можно такому научиться» — Марина, Балашиха",
      "«Сначала казалось далеко, но 1.5 часа по МКАД — это совсем не страшно. А сын после лагеря сам попросил продолжить курс по программированию» — Ольга, Железнодорожный"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Балашиха 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Балашихи: ~1.5 ч по МКАД → Киевское шоссе. IT-программа, бассейн, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Балашихой"
  canonical="https://aidacamp.ru/lager-balashiha"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Балашихи до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Балашихи до лагеря около 85 км и ~1.5 часа езды: по МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или доехать до м. Солнцево и сесть на организованный трансфер АйДаКемп (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Балашихи до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часа на автомобиле (85 км через МКАД → Киевское шоссе). До точки сбора у м. Солнцево из Балашихи — около 40 минут на метро, затем трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Балашихи?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Балашихи нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Балашихи удобно доехать до Солнцево на метро (синяя ветка)." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Балашихи?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Балашихой — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Балашихи. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-balashiha"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Балашихой", "item": "https://aidacamp.ru/lager-balashiha/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Балашихой"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Балашихи по МКАД → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Балашихи"
    keywords={["~1.5 ч из Балашихи через МКАД", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Балашихой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
