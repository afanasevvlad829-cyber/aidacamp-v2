---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Балашиха — IT-столица востока Подмосковья",
    text: "Летний лагерь в Балашихе ищут тысячи семей: город крупный (520 тыс. человек), здесь активная IT-сцена и родители, которые сами работают с технологиями. АйДаКемп — летний IT-лагерь из Балашихи: когда ребёнок видит, чем заняты родители, ему интересно попробовать самому. За смену он сделает первый шаг — и вернётся домой с готовым проектом."
  },
  {
    h2: "Как добраться из Балашихи в лагерь",
    text: "АйДаКемп — санаторий «Изумруд» в Наро-Фоминском городском округе, 66 км от МКАД по Киевскому шоссе (А-101), примерно час без пробок. Из Балашихи добираются на машине через МКАД на Киевское шоссе, либо до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин).",
    list: [
      "На машине: через МКАД на Киевское шоссе (А-101) до санатория «Изумруд» — 66 км от МКАД, ~1 час без пробок",
      "На метро: из Балашихи до м. Солнцево (Солнцевская линия), оттуда трансфер лагеря с сопровождающим",
      "Трансфер: автобус от м. Солнцево, 2 000 ₽ в один конец, сопровождающий до лагеря"
    ]
  },
  {
    h2: "Почему родители из Балашихи выбирают АйДаКемп",
    text: "АйДаКемп — это лагерь с лицензией Минобрнауки, рейтингом 5.0 на Яндекс.Картах и реальными IT-проектами на выходе. Школьник отдыхает в Подмосковье — акклиматизации нет, климат привычный.",
    list: [
      "Без акклиматизации — подмосковная природа, привычный климат",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим до лагеря",
      "Рейтинг 5.0, 40+ отзывов на Яндекс.Картах от подмосковных семей"
    ]
  },
  {
    h2: "IT-программа для школьников из Балашихи",
    text: "Ребята 7–15 лет выбирают трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек — каждый получает внимание преподавателя. В конце смены — хакатон, где школьники защищают свой проект. Подробная разбивка по возрасту — ниже.",
    list: [
      "Python — от переменных до собственного телеграм-бота",
      "Scratch — визуальное программирование для младших (7–10 лет)",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — работа с ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Летний лагерь для детей из Балашихи: возраст и треки",
    text: "В летний лагерь из Балашихи берём школьников 7–15 лет. Группы и треки подбираем по возрасту — младшим попроще и нагляднее, старшим посложнее и ближе к реальной разработке:",
    list: [
      "7–9 лет — Scratch и Minecraft Education: визуальное программирование, первые игры и моды без скучной теории",
      "10–12 лет — Python с нуля и 3D в Blender: первый код, телеграм-бот, своя 3D-модель на печать",
      "13–15 лет — Python поглубже, AI и нейросети: работа с ChatGPT API, проект под защиту на хакатоне"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Отзывы родителей из Балашихи",
    text: "В АйДаКемп едут семьи из Балашихи, Реутова, Железнодорожного и других городов востока Подмосковья:",
    list: [
      "«Мы из Балашихи — добрались до Солнцево на метро, дальше автобус лагеря. Дочь вернулась с готовым приложением на Python — я даже не верила, что за 14 дней можно такому научиться» — Марина, Балашиха",
      "«Сначала казалось далеко, но 1.5 часа по МКАД — это совсем не страшно. А сын после лагеря сам попросил продолжить курс по программированию» — Ольга, Железнодорожный"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "В июне и августе ещё есть места — бронируйте заранее. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности.",
    list: [
      `Смена 2.1: 10–16 июня, 7 дней — ${PRICE_MIN} (налоговый вычет ~2 800 ₽)`,
      `Смена 2: 10–23 июня, 14 дней — ${PRICE_MAX} (налоговый вычет до 5 434 ₽)`,
      `Смена 3: 3–15 августа, 13 дней — ${PRICE_S3} (налоговый вычет ~5 200 ₽)`,
      `Смена 4: 17–26 августа, 10 дней — ${PRICE_S4} (налоговый вычет ~4 800 ₽)`,
      "Трансфер от м. Солнцево — 2 000 ₽ в один конец"
    ]
  },
  {
    h2: "Безопасность и связь с ребёнком",
    text: "Родители из Балашихи могут доехать до лагеря по Киевскому шоссе при необходимости. Но до «необходимости» доходит редко: медработник на территории круглосуточно, охрана 24/7, закрытая территория санатория. Каждый вечер — пачка живых фотографий в Telegram-канале отряда. Не постановочных, а настоящих — за едой, за кодом, на хакатоне.",
    list: [
      "66 км от МКАД по Киевскому шоссе — доедете в случае необходимости",
      "Медработник живёт на территории весь сезон, не «на телефоне»",
      "Фото каждый вечер в 21:00 в закрытый Telegram-канал",
      "Страховка ВСК включена в стоимость путёвки"
    ]
  },
  {
    h2: "Что ребёнок привезёт домой",
    text: "Не просто загар и воспоминания. После АйДаКемп дети привозят: работающий проект (бот, игру или приложение — зависит от трека), сертификат участника хакатона, и новых друзей из других городов. По данным опроса выпускников 2025: 78% продолжают заниматься программированием после смены.",
    list: [
      "Работающий код: бот, игра, приложение — зависит от выбранного трека",
      "Сертификат участника хакатона АйДаКемп",
      "78% продолжают программировать после лагеря (опрос 2025)",
      "Друзья из других городов — часто переписка продолжается годами"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний лагерь в Балашихе 2026 — IT-смены | АйДаКемп"
  description="Летний IT-лагерь для детей из Балашихи: трансфер от м. Солнцево (2 000 ₽), налоговый вычет, бассейн. Python, AI, Minecraft, школьники 7–15 лет."
  h1="Детский лагерь рядом с Балашихой"
  canonical="https://aidacamp.ru/lager-balashiha"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Балашихи до лагеря АйДаКемп?", a: "Из Балашихи до лагеря около 120 км и ~1 ч 20 мин: по МКАД → Киевское шоссе (M-3) → Апрелевка. Удобнее: доехать до м. Солнцево (около часа на метро) и сесть на трансфер АйДаКемп (2 000 ₽)." },
    { q: "Сколько ехать из Балашихи до лагеря?", a: "Около 1 часа 20 минут на автомобиле (120 км через МКАД → Киевское шоссе). До м. Солнцево из Балашихи — около часа на метро, затем трансфер (2 000 ₽) лагеря." },
    { q: "Есть ли трансфер из Балашихи?", a: "Прямого трансфера из Балашихи нет. Бесплатный трансфер отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Балашихи до Солнцево — около часа на метро (синяя ветка)." },
    { q: "Сколько стоит путёвка в лагерь из Балашихи?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево бесплатный.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Балашихой — АйДаКемп"
      description="IT-лагерь в санатории «Изумруд», 66 км от МКАД по Киевскому шоссе. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-balashiha"
      ageMin={7}
      ageMax={15}
    />
    
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Балашихой"
subtitle="Летний IT-лагерь в санатории «Изумруд» — 66 км от МКАД по Киевскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для школьников 7–15 лет."
    breadcrumb="Лагерь из Балашихи"
    keywords={["66 км от МКАД, трансфер от м. Солнцево — 2 000 ₽", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Балашихой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
      <br />Соседние города: <a href="/lager-reutov" class="text-primary hover:underline">лагерь из Реутова</a> — <a href="/lager-zheleznodorozhniy" class="text-primary hover:underline">лагерь из Железнодорожного</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
