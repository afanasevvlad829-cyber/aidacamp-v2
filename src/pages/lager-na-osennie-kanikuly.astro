---
import { PRICE_OSEN, VYCHET_OSEN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import SeasonPreRegister from '../components/SeasonPreRegister.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const sections = [
  {
    h2: "Осенние каникулы — лучшее время для старта",
    text: "Октябрь — идеальный момент. Дети свободны от школы, но ещё не успели уйти в гаджеты и домашнюю рутину. Нет летней жары, нет усталости от длинного сезона. Зато есть свежая мотивация после начала учебного года: «хочу разобраться, как это работает». Именно в этом состоянии новые знания укладываются лучше всего. В IT-лагере на осенние каникулы ребёнок попадает в среду, где все вокруг хотят делать проекты — и это заряжает сильнее любого курса."
  },
  {
    h2: "Программа на осенние каникулы",
    text: "Тот же полноценный IT-трек, адаптированный под неделю. Треки по выбору: Scratch и Minecraft для 7–10 лет, Python и AI для 10–15 лет, Roblox Studio для тех, кто хочет делать игры. Каждый день — занятия, практика и командная работа над общим проектом. В финале — защита мини-проекта: бот, игра или AI-приложение. Всё оборудование в лагере — ноутбук привозить не нужно.",
    list: [
      "Scratch — анимации и первые игры для 7–10 лет",
      "Minecraft Education — редстоун, моды, командная стройка",
      "Python — переменные, функции, мини-бот за неделю",
      "AI и нейросети — работа с ChatGPT API, генерация кода",
      "Roblox Studio — 3D-сцены и Lua-скрипты"
    ]
  },
  {
    h2: "Даты и стоимость осенней смены",
    text: "Осенние каникулы 2026 в большинстве школ — ориентировочно с 26 октября по 3 ноября. Даты смены ниже предварительные: школы опубликуют расписание каникул в сентябре, и мы сразу скорректируем даты под него. Смена 7 дней — специально под каникульный формат: ребёнок не пропускает ни одного учебного дня. Проживание, 5-разовое питание, IT-программа и все активности включены в стоимость.",
    list: [
      `Смена 7 дней (ориентир: 27 октября — 2 ноября) — ${PRICE_OSEN}`,
      "Цена предварительная — зафиксируем за вами при подтверждении дат",
      "Даты уточним в сентябре по расписанию школьных каникул",
      "В стоимость включено: проживание, питание, IT-программа, бассейн",
      "Предзапись до 1 сентября — скидка 5% от финальной цены",
      "Оплата частями: 50% при брони + 50% за 3 недели до старта",
      `Налоговый вычет 13% — возвращаем ~${VYCHET_OSEN} через Госуслуги`
    ]
  },
  {
    h2: "Каникулы по триместрам? Учитываем оба графика",
    text: "Московские школы живут по двум системам: четвертной (осенние каникулы в конце октября) и триместровой (каникулы в начале октября и в середине ноября). Мы планируем заезды под оба графика — в предварительной записи ниже можно отметить, какие даты подходят вашей школе. Окна заездов ориентировочные, подтвердим в сентябре:",
    list: [
      "1-й триместр — ориентировочно начало октября",
      "Традиционные (четвертные) каникулы — конец октября — начало ноября",
      "2-й триместр — ориентировочно середина ноября",
      "Какие заезды откроем — решим по предварительной записи: отметьте свой график"
    ]
  },
  {
    h2: "Что ребёнок успеет за неделю",
    text: "Семь дней — это больше, чем кажется, когда день структурирован и окружение заряжает. За короткую смену ребёнок успевает освоить базовый трек своего возраста, сделать работающий мини-проект и публично его защитить. И главное — найти тех, кому тоже интересно то же самое.",
    list: [
      "День 1–2: знакомство со средой, первые упражнения, команда",
      "День 3–5: основной трек — код, логика, первый прототип",
      "День 6–7: доработка проекта, хакатон и финальная защита",
      "Итог: рабочий проект + новые друзья + понимание, что «это реально»"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="IT-лагерь на осенние каникулы 2026 в Подмосковье | АйДаКемп"
  description={`Детский IT-лагерь на осенние каникулы 2026 в Подмосковье — программирование, AI, командный проект за неделю. Предварительная запись открыта. Ориентир цены — ${PRICE_OSEN}.`}
  h1="IT-лагерь на осенние каникулы 2026"
  canonical="https://aidacamp.ru/lager-na-osennie-kanikuly"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Главная",
              "item": "https://aidacamp.ru"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Лагерь на осенние каникулы",
              "item": "https://aidacamp.ru/lager-na-osennie-kanikuly"
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Когда осенние каникулы 2026?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "В большинстве школ — ориентировочно с 26 октября по 3 ноября. Точное расписание школы опубликуют в сентябре — тогда мы скорректируем даты смен. Оставьте предварительную заявку, и мы напишем первыми."
              }
            },
            {
              "@type": "Question",
              "name": "Как работает предварительная запись?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Оставляете контакт без оплаты. Когда школы подтвердят даты каникул, мы напишем первыми, предложим точные даты смены и зафиксируем раннюю цену. Предзапись ни к чему не обязывает."
              }
            },
            {
              "@type": "Question",
              "name": "У нас триместровая система — каникулы не в конце октября. Есть ли смены?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Да, планируем заезды и под триместровые каникулы: ориентировочно начало октября и середина ноября, помимо традиционного окна в конце октября. Отметьте свой график в предварительной записи — по ней решим, какие заезды открыть."
              }
            },
            {
              "@type": "Question",
              "name": "Подойдёт ли лагерь за одну неделю?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Да. 7-дневная короткая смена — специально для каникульного формата. За неделю ребёнок успеет освоить базовый трек и защитить мини-проект."
              }
            },
            {
              "@type": "Question",
              "name": "Есть ли скидки на осенние смены?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Предзапись до 1 сентября — скидка 5% от финальной цены. Уточняйте актуальные акции у менеджера."
              }
            },
            {
              "@type": "Question",
              "name": "Нужно ли специальное оборудование?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Нет. Ноутбук не нужен — у нас собственный парк техники. Из одежды: удобная повседневная, спортивная форма, тёплая куртка (октябрь в Подмосковье прохладный)."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <LandingHero slot="hero"
    h1="IT-лагерь на осенние каникулы 2026"
    subtitle="Неделя в IT-лагере — и ребёнок возвращается с готовым проектом. Не ноябрьской скукой."
    breadcrumb="Лагерь на осенние каникулы"
    keywords={[
      "Программирование, AI, командный проект — за 7 дней",
      "Ноутбук не нужен — своя техника в лагере",
      "Подмосковье, 66 км от МКАД — трансфер от м. Солнцево"
    ]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="IT-лагерь на осенние каникулы АйДаКемп"
  />

  <LandingTwoCol sections={sections} />
  <SeasonPreRegister
    seasonAcc="осеннюю смену 2026"
    slug="osen-2026"
    windows={[
      "Конец октября (четверти)",
      "Начало октября (1-й триместр)",
      "Середина ноября (2-й триместр)"
    ]}
  />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
