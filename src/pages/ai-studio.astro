---
/**
 * AI Studio — explainer-страница про внутреннюю AI-платформу АйДаКемп.
 * Standalone интерактив: 3 сцены с анимациями и предзаписанной озвучкой (OpenAI TTS-1-HD, голос onyx).
 * Адаптировано из прототипа: брендовые цвета (#ec9b44), Inter, Bootstrap Icons из манифеста.
 */
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'AI Studio: как устроена единая AI-платформа АйДаКемп';
const description = 'Интерактивный рассказ о внутренней системе АйДаКемп для работы с нейросетями: один логин, все инструменты, прозрачный контроль.';
---

<Base title={title} description={description}>
  <Header />

  <main class="ai-studio">
    <!-- HERO -->
    <section class="hero">
      <p class="eyebrow">Внутренняя кухня · 3 минуты</p>
      <h1>AI Studio: как устроена<br/><span class="accent">единая AI-платформа</span></h1>
      <p class="lead">
        Один портал, один логин — и все нейросети в одном месте. Без подписок, без кредиток, без шести интерфейсов.
        Рассказываем как мы это собрали и почему.
      </p>
    </section>

    <!-- INTERACTIVE EXPLAINER -->
    <div class="explainer">
      <div id="prog"><div id="pf"></div></div>

      <div id="tabs">
        <div class="tab on" data-s="1" onclick="go(1)"><div class="n">1</div><i class="bi bi-question-circle"></i><span class="tl">Зачем</span></div>
        <div class="tab" data-s="2" onclick="go(2)"><div class="n">2</div><i class="bi bi-diagram-3"></i><span class="tl">Архитектура</span></div>
        <div class="tab" data-s="3" onclick="go(3)"><div class="n">3</div><i class="bi bi-stars"></i><span class="tl">Результат</span></div>
      </div>

      <div id="main">

        <!-- SCENE 1 -->
        <div class="sc on" id="s1">
          <div class="sh">
            <div class="ey">Постановка задачи</div>
            <div class="st">Зачем нужна единая платформа?</div>
            <div class="sd">Текст, картинки, видео, код — каждая задача требует своей нейросети. Как это обычно выглядит и почему мы сделали иначе.</div>
          </div>
          <div class="s1g">
            <div class="tc">
              <div class="card" id="c1t" style="--ac:var(--bl);--ic:var(--bll)" onclick="inf('text')">
                <div class="ci"><i class="bi bi-chat-text"></i></div>
                <div class="ct">Текст и общение</div>
                <div class="cs">ChatGPT, Claude, Gemini — у каждого своя подписка и свой интерфейс</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('text')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="card" id="c1i" style="--ac:var(--pu);--ic:var(--pul)" onclick="inf('img')">
                <div class="ci"><i class="bi bi-image"></i></div>
                <div class="ct">Генерация изображений</div>
                <div class="cs">Midjourney в Discord, DALL-E в ChatGPT, Firefly отдельно</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('img')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="card" id="c1v" style="--ac:var(--rd);--ic:var(--rdl)" onclick="inf('video')">
                <div class="ci"><i class="bi bi-camera-video"></i></div>
                <div class="ct">Видео и анимация</div>
                <div class="cs">Sora, Runway, Kling — Sora стоит $200 в месяц</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('video')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="card" id="c1c" style="--ac:var(--gn);--ic:var(--gnl)" onclick="inf('code')">
                <div class="ci"><i class="bi bi-code-slash"></i></div>
                <div class="ct">Программирование</div>
                <div class="cs">Copilot только 18+, Cursor — приложение, Replit платный</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('code')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
            </div>
            <div class="ac" id="arrC" style="opacity:0">
              <i class="bi bi-arrow-right"></i>
            </div>
            <div class="sc2">
              <div class="solc" id="c1s" onclick="inf('solution')">
                <div class="ci solc-ic"><i class="bi bi-grid-1x2"></i></div>
                <div class="solc-title">Один адрес. Один логин. Всё внутри.</div>
                <div class="solc-desc">Учащийся получает username в первый день. Открыл браузер — и сразу работает со всеми нейросетями. Без кредиток и регистраций.</div>
                <div class="cr"><i class="bi bi-check-circle-fill"></i>Ноль личных подписок</div>
                <div class="cr"><i class="bi bi-check-circle-fill"></i>Один логин — все инструменты</div>
                <div class="cr"><i class="bi bi-check-circle-fill"></i>В браузере на любом ноутбуке</div>
                <div class="cr"><i class="bi bi-check-circle-fill"></i>Бюджет курса фиксированный</div>
                <button class="info-btn solc-info" onclick="event.stopPropagation();inf('solution')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 2 -->
        <div class="sc" id="s2">
          <div class="sh">
            <div class="ey">Техническая схема</div>
            <div class="st">Как это устроено внутри</div>
            <div class="sd">Запрос учащегося проходит через несколько слоёв. Каждый решает конкретную задачу.</div>
          </div>
          <div class="s2g">
            <div class="s2l">
              <div class="card" id="c2s" style="--ac:var(--bl);--ic:var(--bll)" onclick="inf('student')">
                <div class="ci"><i class="bi bi-person-workspace"></i></div>
                <div class="ct">Учащийся</div>
                <div class="cs">Username + пароль с бумажки. Открыл браузер — готово.</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('student')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="cnv" id="cvs"><div class="fp"></div></div>
              <div class="card" id="c2t" style="--ac:var(--pu);--ic:var(--pul)" onclick="inf('teacher')">
                <div class="ci"><i class="bi bi-person-badge"></i></div>
                <div class="ct">Преподаватель</div>
                <div class="cs">Видит всех в реальном времени. Кто застрял — очевидно.</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('teacher')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
            </div>
            <div class="s2m">
              <div class="card" id="c2w" style="--ac:var(--or);--ic:var(--orl)" onclick="inf('webui')">
                <div class="ci"><i class="bi bi-display"></i></div>
                <div class="ct">Open WebUI · ai.aidacamp.ru</div>
                <div class="cs">Брендированный интерфейс с персонажами, веб-поиском и запуском кода.</div>
                <div class="cb">Фронтенд</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('webui')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="mn" id="mn">
                <strong><i class="bi bi-exclamation-circle"></i> Нейросеть не помнит:</strong>
                каждый запрос — первое знакомство. Open WebUI хранит историю и передаёт контекст автоматически.
              </div>
              <div class="cnv" id="cvw"><div class="fp"></div></div>
              <div class="card" id="c2l" style="--ac:var(--or);--ic:var(--orl)" onclick="inf('litellm')">
                <div class="ci"><i class="bi bi-lightning-charge"></i></div>
                <div class="ct">LiteLLM · Шлюз</div>
                <div class="cs">Считает токены, ставит лимиты, роутит к нужной модели.</div>
                <div class="cb">Gateway</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('litellm')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="cnv" id="cvl"><div class="fp"></div></div>
              <div class="card" id="c2r" style="--ac:var(--rd);--ic:var(--rdl)" onclick="inf('redis')">
                <div class="ci"><i class="bi bi-database"></i></div>
                <div class="ct">Redis · Кеш</div>
                <div class="cs">Повторный вопрос — ответ мгновенно, без токенов. Экономия ~60%.</div>
                <div class="cb" style="--bb:var(--rdl);--ac:var(--rd)">Cache</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('redis')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
            </div>
            <div class="s2r">
              <div class="card" id="c2m" style="--ac:var(--tl);--ic:var(--tll)" onclick="inf('models')">
                <div class="ci"><i class="bi bi-cpu"></i></div>
                <div class="ct">Нейросети</div>
                <div class="cs models-list">
                  <span><i class="bi bi-chat-dots" style="color:var(--or)"></i> Claude Haiku — текст</span>
                  <span><i class="bi bi-image" style="color:var(--pu)"></i> FLUX / SDXL — картинки</span>
                  <span><i class="bi bi-code-slash" style="color:var(--gn)"></i> GPT-4o mini — код</span>
                  <span><i class="bi bi-currency-exchange" style="color:var(--dm)"></i> Mistral — экономия</span>
                </div>
                <div class="cb" style="--bb:var(--tll);--ac:var(--tl)">4+ модели</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('models')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
              <div class="cnv" id="cvm"><div class="fp"></div></div>
              <div class="card" id="c2f" style="--ac:var(--pu);--ic:var(--pul)" onclick="inf('langfuse')">
                <div class="ci"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="ct">Langfuse · Дашборд</div>
                <div class="cs">Каждый вызов залогирован. Преподаватель видит всё — кто и сколько.</div>
                <div class="cb" style="--bb:var(--pul);--ac:var(--pu)">Observability</div>
                <button class="info-btn" onclick="event.stopPropagation();inf('langfuse')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 3 -->
        <div class="sc" id="s3">
          <div class="sh">
            <div class="ey">Для учащегося и преподавателя</div>
            <div class="st">Что в итоге получаем</div>
            <div class="sd">Реальная работа с нейросетями без барьеров. Финал — готовый проект.</div>
          </div>
          <div class="jny" id="jny">
            <div class="jst" id="j1"><div class="jic"><i class="bi bi-door-open"></i></div><div class="jlb">Вход</div></div>
            <i class="bi bi-arrow-right jar" id="ja1"></i>
            <div class="jst" id="j2"><div class="jic"><i class="bi bi-chat-dots"></i></div><div class="jlb">Запрос</div></div>
            <i class="bi bi-arrow-right jar" id="ja2"></i>
            <div class="jst" id="j3"><div class="jic"><i class="bi bi-cpu"></i></div><div class="jlb">Нейросеть</div></div>
            <i class="bi bi-arrow-right jar" id="ja3"></i>
            <div class="jst" id="j4"><div class="jic"><i class="bi bi-check2-circle"></i></div><div class="jlb">Ответ</div></div>
            <i class="bi bi-arrow-right jar" id="ja4"></i>
            <div class="jst" id="j5"><div class="jic"><i class="bi bi-film"></i></div><div class="jlb">Проект</div></div>
          </div>
          <div class="r3g">
            <div class="card" id="c3a" style="--ac:var(--bl);--ic:var(--bll)" onclick="inf('login')">
              <div class="ci"><i class="bi bi-person-check"></i></div>
              <div class="ct">Личный кабинет</div>
              <div class="cs">Username + пароль с бумажки. История только у учащегося.</div>
              <div class="cb" style="--bb:var(--bll);--ac:var(--bl)">Изолировано</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('login')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
            <div class="card" id="c3b" style="--ac:var(--gn);--ic:var(--gnl)" onclick="inf('laptop')">
              <div class="ci"><i class="bi bi-laptop"></i></div>
              <div class="ct">Любой ноутбук</div>
              <div class="cs">Старый HP 2014 справится как MacBook. Всё в браузере.</div>
              <div class="cb" style="--bb:var(--gnl);--ac:var(--gn)">Только браузер</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('laptop')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
            <div class="card" id="c3c" style="--ac:var(--pu);--ic:var(--pul)" onclick="inf('control')">
              <div class="ci"><i class="bi bi-eye"></i></div>
              <div class="ct">Контроль</div>
              <div class="cs">Преподаватель видит все диалоги. Кто завис 7 минут — сразу заметно.</div>
              <div class="cb" style="--bb:var(--pul);--ac:var(--pu)">Реальное время</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('control')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
            <div class="card" id="c3d" style="--ac:var(--tl);--ic:var(--tll)" onclick="inf('memory')">
              <div class="ci"><i class="bi bi-journal-bookmark"></i></div>
              <div class="ct">Память и история</div>
              <div class="cs">Диалоги сохраняются. Open WebUI передаёт контекст автоматически.</div>
              <div class="cb" style="--bb:var(--tll);--ac:var(--tl)">Persistent</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('memory')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
            <div class="card" id="c3e" style="--ac:var(--or);--ic:var(--orl)" onclick="inf('limits')">
              <div class="ci"><i class="bi bi-speedometer2"></i></div>
              <div class="ct">Лимиты токенов</div>
              <div class="cs">50k токенов в день на учащегося. Потратил — сообщение, не ошибка.</div>
              <div class="cb">Защита</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('limits')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
            <div class="card" id="c3f" style="--ac:var(--rd);--ic:var(--rdl)" onclick="inf('project')">
              <div class="ci"><i class="bi bi-film"></i></div>
              <div class="ct">Финальный проект</div>
              <div class="cs">Мини-сериал: сценарий, кадры, озвучка — всё через нейросети.</div>
              <div class="cb" style="--bb:var(--rdl);--ac:var(--rd)">Готовый продукт</div>
              <button class="info-btn" onclick="event.stopPropagation();inf('project')" aria-label="Подробнее"><i class="bi bi-info"></i></button>
            </div>
          </div>
        </div>

      </div><!-- /main -->

      <div id="ctl">
        <button class="cb2" onclick="rst()" title="Сначала" aria-label="К началу"><i class="bi bi-skip-backward-fill"></i></button>
        <button class="cb2 pr" id="pb" onclick="tog()" aria-label="Воспроизведение"><i class="bi bi-play-fill"></i></button>
        <button class="cb2" onclick="nxt()" title="Далее" aria-label="Следующая сцена"><i class="bi bi-skip-forward-fill"></i></button>
        <div id="sub">Нажмите ▶ чтобы запустить рассказ с озвучкой</div>
        <div id="td">0:00</div>
      </div>

      <div id="iov" onclick="closeInf(event)">
        <div id="ip">
          <button class="icl" onclick="closeInf()" aria-label="Закрыть"><i class="bi bi-x"></i></button>
          <div id="ic"></div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <section class="cta-section">
      <h2>Это работает прямо сейчас</h2>
      <p>На сменах АйДаКемп каждый учащийся получает доступ к этой системе в первый же день — username на бумажке и работа со всеми нейросетями в браузере.</p>
      <a href="/shifts/" class="cta-btn">Посмотреть смены 2026 <i class="bi bi-arrow-right"></i></a>
    </section>
  </main>

  <Footer />
</Base>

<style>
  :root{
    --bg:#f0f4f8;--sf:#fff;--bd:#e2e8f0;--tx:#1e293b;--dm:#64748b;
    /* Бренд: основной — наш orange, остальные акцентные оставлены приближённо */
    --or:#ec9b44;--orl:#fff3e0;--orm:#ffd699;
    --bl:#2563eb;--bll:#eff6ff;
    --gn:#16a34a;--gnl:#f0fdf4;
    --pu:#7c3aed;--pul:#f5f3ff;
    --rd:#dc2626;--rdl:#fef2f2;
    --tl:#0d9488;--tll:#f0fdfa;
    --sh:0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06);
    --shl:0 8px 32px rgba(0,0,0,.12);
    --r:13px;
  }

  @keyframes springIn{0%{opacity:0;transform:translateY(18px) scale(.93)}70%{transform:translateY(-3px) scale(1.02)}100%{opacity:1;transform:none}}
  @keyframes wiggle{0%,100%{transform:rotate(0)}20%{transform:rotate(-14deg)}50%{transform:rotate(10deg)}80%{transform:rotate(-5deg)}}
  @keyframes glow{0%,100%{box-shadow:var(--sh)}50%{box-shadow:var(--sh),0 0 0 3px color-mix(in srgb,var(--ac,var(--or)) 25%,transparent),0 6px 24px color-mix(in srgb,var(--ac,var(--or)) 18%,transparent)}}
  @keyframes flowH{0%{left:-6px;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:100%;opacity:0}}
  @keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes scaleIn{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:none}}

  .ai-studio{background:var(--bg);min-height:100vh;color:var(--tx);font-family:'Inter',sans-serif}

  /* HERO */
  .ai-studio .hero{max-width:1100px;margin:0 auto;padding:48px 24px 24px;text-align:center}
  .ai-studio .hero .eyebrow{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--or);margin-bottom:12px}
  .ai-studio .hero h1{font-size:clamp(28px,4vw,44px);line-height:1.1;font-weight:900;letter-spacing:-1px;margin-bottom:14px;color:var(--tx)}
  .ai-studio .hero .accent{color:var(--or)}
  .ai-studio .hero .lead{font-size:17px;line-height:1.55;color:var(--dm);max-width:680px;margin:0 auto}

  /* EXPLAINER container */
  .explainer{max-width:1100px;margin:0 auto 32px;height:80vh;min-height:600px;background:var(--sf);border:1px solid var(--bd);border-radius:18px;overflow:hidden;box-shadow:var(--shl);display:flex;flex-direction:column;position:relative}

  #prog{height:3px;background:var(--bd);flex-shrink:0}
  #pf{height:100%;background:var(--or);width:0;transition:width .3s;box-shadow:0 0 8px rgba(236,155,68,.5)}

  #tabs{display:flex;background:var(--sf);border-bottom:2px solid var(--bd);padding:0 16px;flex-shrink:0;gap:2px}
  .tab{font-size:10px;font-weight:700;letter-spacing:.5px;padding:14px 16px 12px;cursor:pointer;color:var(--dm);border-bottom:3px solid transparent;margin-bottom:-2px;transition:all .2s;display:flex;align-items:center;gap:8px;text-transform:uppercase;background:none;border:none;border-bottom:3px solid transparent}
  .tab i{font-size:14px}
  .tab.on{color:var(--or);border-bottom-color:var(--or)}
  .tab .n{width:20px;height:20px;border-radius:50%;background:var(--bd);display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--dm);transition:all .2s}
  .tab.on .n{background:var(--or);color:#fff}
  .tl{display:inline}
  @media(max-width:520px){.tl{display:none}.tab{padding:14px 12px 12px}}

  #main{flex:1;position:relative;overflow:hidden}
  .sc{position:absolute;inset:0;padding:20px 24px 16px;overflow-y:auto;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s}
  .sc.on{opacity:1;pointer-events:all;transform:none!important}
  .sc.el{transform:translateX(-28px)}
  .sc.er{transform:translateX(28px)}

  .sh{margin-bottom:18px}
  .ey{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--or);margin-bottom:6px;animation:fadeUp .4s both}
  .st{font-size:clamp(18px,2.4vw,26px);font-weight:900;color:var(--tx);line-height:1.1;letter-spacing:-1px;animation:fadeUp .4s .05s both}
  .sd{font-size:13px;color:var(--dm);margin-top:6px;line-height:1.6;max-width:620px;animation:fadeUp .4s .1s both}

  /* INVERSION: cards visible immediately but DIMMED. Active card during narration = bright/scaled */
  .card{background:var(--sf);border:1.5px solid var(--bd);border-radius:var(--r);padding:18px 20px 18px;box-shadow:var(--sh);cursor:pointer;transition:opacity .5s ease,filter .5s ease,transform .35s cubic-bezier(.2,.8,.3,1),box-shadow .35s,border-color .35s;position:relative;opacity:.45;filter:saturate(.55) blur(.3px);transform:scale(.97)}
  .card.on{opacity:1;filter:none;transform:none}
  .card:hover{opacity:1;filter:none;box-shadow:var(--shl);border-color:var(--ac,var(--or));transform:translateY(-3px) scale(1.02)}
  /* Spotlight on active narrated card */
  .card.nar{opacity:1;filter:none;transform:scale(1.04);border-color:var(--ac,var(--or))!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--ac,var(--or)) 18%,transparent),0 12px 32px color-mix(in srgb,var(--ac,var(--or)) 22%,transparent),var(--sh);z-index:5}
  .card.nar .ci i{animation:wiggle .55s ease}
  /* Spotlight mode: когда сцена narrating, не-nar карточки приглушаются */
  .sc[data-narrating] .card.on:not(.nar):not(:hover),
  .sc[data-narrating] .solc.on:not(.nar):not(:hover){opacity:.45;filter:saturate(.5);transform:scale(.96)}
  .mn.nar{box-shadow:0 0 0 3px rgba(252,211,77,.5),0 8px 24px rgba(180,83,9,.18);transform:scale(1.02)}
  .ci{width:42px;height:42px;border-radius:11px;background:var(--ic,var(--orl));display:flex;align-items:center;justify-content:center;margin-bottom:10px;font-size:20px;color:var(--ac,var(--or));transition:transform .25s}
  .card:hover .ci, .card.nar .ci{transform:scale(1.12) rotate(-4deg)}
  .ct{font-size:12px;font-weight:700;color:var(--ac,var(--or));letter-spacing:.3px;margin-bottom:5px;text-transform:uppercase}
  .cs{font-size:13.5px;color:var(--tx);line-height:1.5}
  .cb{position:absolute;top:11px;right:42px;font-size:8.5px;font-weight:700;padding:3px 8px;border-radius:20px;background:var(--bb,var(--orl));color:var(--ac,var(--or));letter-spacing:.5px;text-transform:uppercase}
  /* Always-visible info button */
  .info-btn{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;background:var(--ac,var(--or));border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;opacity:.65;transition:all .2s;padding:0;z-index:10}
  .info-btn:hover{opacity:1;transform:scale(1.15);box-shadow:0 4px 12px color-mix(in srgb,var(--ac,var(--or)) 40%,transparent)}
  .card.nar .info-btn,.card:hover .info-btn{opacity:1}
  .info-btn i{font-size:14px;font-weight:700}
  .solc-info{top:14px;right:14px;width:30px;height:30px;font-size:14px;background:var(--or)}

  /* SCENE 1 */
  .s1g{display:grid;grid-template-columns:1fr 56px 1fr;gap:14px;align-items:center}
  .tc,.sc2{display:flex;flex-direction:column;gap:10px}
  .ac{display:flex;align-items:center;justify-content:center;transition:opacity .4s}
  .ac i{color:var(--or);font-size:28px}
  .solc{background:linear-gradient(135deg,#fff 0%,var(--orl) 100%);border:2px solid var(--orm);border-radius:var(--r);padding:18px 22px;box-shadow:var(--sh);cursor:pointer;transition:opacity .5s,filter .5s,transform .35s,box-shadow .35s;position:relative;opacity:.45;filter:saturate(.55);transform:scale(.97)}
  .solc.on{opacity:1;filter:none;transform:none}
  .solc:hover{opacity:1;filter:none;box-shadow:var(--shl);transform:translateY(-3px) scale(1.02)}
  .solc.nar{opacity:1;filter:none;transform:scale(1.03);box-shadow:0 0 0 3px color-mix(in srgb,var(--or) 22%,transparent),0 14px 36px color-mix(in srgb,var(--or) 24%,transparent);z-index:5}
  .solc-ic{width:42px!important;height:42px!important;font-size:20px!important;background:var(--orl)!important;color:var(--or)!important;border-radius:11px!important}
  .solc-title{font-size:12px;font-weight:700;color:var(--or);text-transform:uppercase;margin-bottom:5px;letter-spacing:.3px}
  .solc-desc{font-size:12px;color:var(--dm);line-height:1.5;margin-bottom:10px}
  .cr{font-size:11px;color:var(--tx);line-height:1.7;display:flex;align-items:center;gap:6px}
  .cr i{color:var(--or);font-size:13px}

  @media(max-width:720px){.s1g{grid-template-columns:1fr;gap:10px}.ac{transform:rotate(90deg);height:40px}}

  /* SCENE 2 */
  .s2g{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:14px;align-items:start}
  .s2l,.s2m,.s2r{display:flex;flex-direction:column;gap:10px;position:relative}
  .cnv{position:relative;height:24px;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .4s}
  .cnv.on{opacity:1}
  .cnv::before{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:80%;height:2px;background:linear-gradient(90deg,var(--c1,var(--bd)) 0%,var(--c2,var(--or)) 100%);border-radius:2px}
  .fp{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--pc,var(--or));top:50%;transform:translateY(-50%);left:0;animation:flowH var(--spd,1.5s) ease-in-out infinite}
  .mn{background:#fef9e7;border:1px solid #fcd34d;border-radius:10px;padding:9px 12px;font-size:11px;color:var(--tx);line-height:1.5;opacity:0;transition:opacity .4s}
  .mn.on{opacity:1}
  .mn strong{color:#b45309}
  .mn i{font-size:13px;margin-right:4px}
  .models-list{display:flex;flex-direction:column;gap:4px}
  .models-list span{display:flex;align-items:center;gap:6px}
  @media(max-width:900px){.s2g{grid-template-columns:1fr}.cnv{display:none}}

  /* SCENE 3 */
  .jny{display:flex;align-items:center;justify-content:center;gap:10px;padding:14px 0;margin-bottom:18px;background:#fff;border-radius:14px;border:1px solid var(--bd);opacity:0;transition:opacity .4s;flex-wrap:wrap}
  .jny.on{opacity:1}
  .jst{display:flex;flex-direction:column;align-items:center;gap:5px;padding:8px 12px;border-radius:10px;transition:all .3s;opacity:.4}
  .jst.nar{opacity:1;background:var(--orl);transform:scale(1.08)}
  .jic{width:40px;height:40px;border-radius:10px;background:var(--bd);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--dm);transition:all .3s}
  .jst.nar .jic{background:var(--or);color:#fff}
  .jlb{font-size:10px;font-weight:700;color:var(--dm);text-transform:uppercase;letter-spacing:.5px}
  .jst.nar .jlb{color:var(--or)}
  .jar{font-size:18px;color:var(--bd);transition:color .3s}
  .jar.nar{color:var(--or)}
  .r3g{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  @media(max-width:720px){.r3g{grid-template-columns:1fr}.jny{font-size:10px}}

  /* CONTROLS */
  #ctl{flex-shrink:0;display:flex;align-items:center;gap:10px;padding:12px 18px;border-top:2px solid var(--bd);background:var(--sf)}
  .cb2{width:36px;height:36px;border-radius:50%;background:var(--bd);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--tx);transition:all .2s}
  .cb2:hover{background:var(--or);color:#fff}
  .cb2.pr{width:42px;height:42px;background:var(--or);color:#fff;font-size:16px}
  .cb2.pr:hover{background:#d68830}
  .cb2.ld i{animation:fadeUp .8s infinite}
  #sub{flex:1;font-size:12px;color:var(--dm);font-style:italic;line-height:1.4}
  #td{font-size:12px;font-weight:600;color:var(--dm);font-variant-numeric:tabular-nums}

  /* INFO MODAL */
  #iov{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s;z-index:100;padding:20px}
  #iov.on{opacity:1;pointer-events:all}
  #ip{background:var(--sf);border-radius:18px;padding:28px 30px;max-width:560px;width:100%;max-height:85vh;overflow-y:auto;position:relative;box-shadow:var(--shl);transform:scale(.9);transition:transform .3s}
  #iov.on #ip{transform:scale(1)}
  .icl{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:var(--bd);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--dm)}
  .icl:hover{background:var(--or);color:#fff}
  .iic{width:54px;height:54px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px}
  .itl{font-size:22px;font-weight:900;letter-spacing:-.5px;line-height:1.15;margin-bottom:8px}
  .itg{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.5px;padding:4px 9px;border-radius:18px;text-transform:uppercase;margin-bottom:14px}
  .ids{font-size:14px;color:var(--tx);line-height:1.55;margin-bottom:14px}
  .il{list-style:none;padding:0;margin-bottom:14px}
  .il li{display:flex;align-items:start;gap:8px;font-size:13px;color:var(--tx);line-height:1.5;padding:5px 0}
  .il li i{color:var(--or);font-size:14px;margin-top:2px;flex-shrink:0}
  .isp{height:1px;background:var(--bd);margin:12px 0}
  .ite{font-size:11px;color:var(--dm);font-family:'Menlo','Monaco',monospace;background:#f8fafc;padding:9px 12px;border-radius:7px;line-height:1.6}

  /* CTA */
  .cta-section{max-width:780px;margin:0 auto 64px;padding:36px 24px;text-align:center;background:linear-gradient(135deg,var(--orl) 0%,#fff 100%);border-radius:18px;border:1px solid var(--orm)}
  .cta-section h2{font-size:clamp(22px,3vw,32px);font-weight:900;line-height:1.15;letter-spacing:-1px;margin-bottom:12px;color:var(--tx)}
  .cta-section p{font-size:15px;color:var(--dm);line-height:1.55;margin-bottom:20px}
  .cta-btn{display:inline-flex;align-items:center;gap:8px;background:var(--or);color:#fff;padding:14px 26px;border-radius:14px;font-size:15px;font-weight:700;text-decoration:none;transition:all .2s;box-shadow:0 4px 16px rgba(236,155,68,.3)}
  .cta-btn:hover{background:#d68830;transform:translateY(-2px);box-shadow:0 6px 20px rgba(236,155,68,.4)}

  @media(max-width:720px){
    .ai-studio .hero{padding:32px 18px 18px}
    .explainer{height:auto;min-height:0;margin:0 12px 24px;border-radius:14px}
    #main{min-height:520px}
  }
</style>

<script is:inline>
const D={
text:{ic:'bi-chat-text',co:'var(--bl)',bg:'var(--bll)',tag:'Текстовые LLM',ti:'Текст и общение — почему это про текст?',de:'Текстовая нейросеть — мозг любого AI-проекта: с неё начинается сценарий, через неё идёт код-ревью, на ней работают все промпты. Без качественного текстового LLM остальное собрать нельзя. Проблема в том, что лучшие модели сидят за подпиской — у каждой свой логин, свой интерфейс, свой счёт.',li:['Три интерфейса — три раза объяснять где кнопка отправки','$60/мес суммарно только за текстовые чаты','Часть сервисов в России не работает официально','Учащийся теряет время на регистрации, а не на учёбе'],te:'ChatGPT Plus: $20/мес · Claude Pro: $20/мес\nGemini Advanced: $20/мес → итого $60+'},
img:{ic:'bi-image',co:'var(--pu)',bg:'var(--pul)',tag:'Image models',ti:'Картинки — зачем нужны?',de:'Финальный проект — мини-сериал, и каждая сцена это картинка. Без генерации изображений учащийся остаётся со стенограммой вместо видео. Беда в том, что каждая нормальная модель живёт в отдельной коробке — Discord, ChatGPT, Adobe.',li:['Midjourney: сначала Discord, потом подписка — два барьера','DALL-E: «уже платите за ChatGPT? Там и нажимайте»','Adobe Firefly: $55/мес за всю Creative Cloud','Один учащийся ≠ ребёнок дизайнера, у него нет всех подписок'],te:'Midjourney: $10–48/мес\nFirefly: $55/мес · DALL-E: только через GPT Plus'},
video:{ic:'bi-camera-video',co:'var(--rd)',bg:'var(--rdl)',tag:'Video models',ti:'Видео — это вообще реально?',de:'Видео-генерация — то место где «AI-курс» обычно сдувается. Преподаватель показывает Sora с экрана, потому что на каждого учащегося её не выдашь. А мы хотим, чтобы каждый сделал свой ролик руками. Поэтому видео-блок нужен, но обычный путь нерабочий.',li:['Runway Gen-3: от $15/мес — квоты на 1–2 ролика в день','Kling AI: от $8/мес, китайский сервис, оплата нетривиальна','Sora: $200/мес — это ChatGPT Pro, не опечатка','«Демо на проекторе» вместо реальной работы — главная подмена'],te:'Итого видео-инструменты: $23–200+/мес\nна одного учащегося'},
code:{ic:'bi-code-slash',co:'var(--gn)',bg:'var(--gnl)',tag:'Code models',ti:'Программирование — почему отдельно?',de:'Код требует AI с другими приоритетами: контекст файла, понимание стека, IDE-интеграция. ChatGPT для кода работает плохо, специализированные сервисы — лучше. Но Copilot официально 18+, Cursor — отдельное приложение, Replit платный. Учащийся 12 лет в эту дверь не пройдёт.',li:['GitHub Copilot: $10/мес — формально только для совершеннолетних','Cursor: $20/мес + установка десктоп-приложения','Replit AI: $20/мес, зато в браузере','Главное: для подростка эти барьеры непреодолимы без взрослого'],te:'GitHub Copilot: $10 · Cursor: $20\nReplit AI: $20 → итого $50/мес'},
solution:{ic:'bi-grid-1x2',co:'var(--or)',bg:'var(--orl)',tag:'Решение',ti:'Один адрес. Один логин. Всё внутри.',de:'Зачем мы вообще это сделали — чтобы между подростком и нейросетью не стояло шесть подписок, восемь интерфейсов и две кредитки. Учащийся приходит на курс и в первый день получает username на бумажке. Открывает браузер — все инструменты уже работают.',li:['Ноль личных подписок — всё покрывает курс','Один логин — и текст, и картинки, и код, и видео','В браузере — подойдёт любой ноутбук','Бюджет курса фиксированный, без сюрпризов «потратил $40 за час»','Преподаватель видит всех в одном дашборде'],te:'Стек: Open WebUI + LiteLLM + Redis + Langfuse\n1 VPS, все сервисы в Docker, ~150₽/учащийся в день'},
student:{ic:'bi-person-workspace',co:'var(--bl)',bg:'var(--bll)',tag:'Учащийся',ti:'Как учащийся попадает в систему',de:'Никакого email, SMS, верификации. Преподаватель создал аккаунт заранее, учащийся получил бумажку. Всё. Дальше только работа.',li:['Логин: простое имя, например ivan_c3','Его диалоги видит только он','Потерял пароль — преподаватель сбрасывает за 10 сек','Лимит токенов защищает от «напиши мне роман»'],te:'Auth: Open WebUI built-in\nИзоляция: по user_id в SQLite'},
teacher:{ic:'bi-person-badge',co:'var(--pu)',bg:'var(--pul)',tag:'Преподаватель',ti:'Что видит преподаватель',de:'Всё. Прямо сейчас. Не нужно ходить по рядам — в дашборде Langfuse видно каждый запрос. Кто работает, кто завис, кто спрашивает нейросеть про смысл жизни.',li:['Каждый запрос и ответ — в реальном времени','Кто застрял — видно сразу, подходим адресно','Стоимость урока в токенах и деньгах','Можно поднять лимит тому, кто работает активно'],te:'Langfuse: traces, sessions, costs\nФильтры по user, model, cost'},
webui:{ic:'bi-display',co:'var(--or)',bg:'var(--orl)',tag:'Open WebUI',ti:'Open WebUI — что видит учащийся',de:'Open source, развёрнут на нашем сервере. Учащийся видит «АйДаКемп AI Studio» с персонажами — не технический интерфейс с настройками температуры.',li:['Персонажи: Профессор Нейрон, Злой Промпт-Мастер','Веб-поиск с источниками прямо в диалоге','Запуск Python: написали → запустили → увидели','Таблица лидеров: лучший промпт недели'],te:'github.com/open-webui\nDocker: latest · порт 3000'},
litellm:{ic:'bi-lightning-charge',co:'var(--or)',bg:'var(--orl)',tag:'LiteLLM',ti:'LiteLLM — строгий кассир',de:'Стоит между Open WebUI и нейросетями. Учащийся не видит API-ключи и не знает сколько стоит запрос — это не его забота.',li:['Лимит: 50k токенов в день — без сюрпризов','Задача на картинку → роутинг к FLUX, не к Claude','Claude лёг → автоматически GPT-4o mini','Один конфиг вместо десяти API-ключей'],te:'litellm.ai · config.yaml\nmax_budget: $0.50/user/day'},
redis:{ic:'bi-database',co:'var(--rd)',bg:'var(--rdl)',tag:'Redis',ti:'Redis — память на повторения',de:'Двадцать учащихся задали один вопрос — нейросеть отвечает один раз, остальные из кеша. Реальная экономия около 60% токенов на типовых уроках.',li:['Повторный вопрос — ответ без токенов','Счётчик токенов учащегося обновляется здесь','Приватные диалоги не кешируются'],te:'Redis 7.x · TTL: 24h\ndocker: redis:alpine · порт 6379'},
models:{ic:'bi-cpu',co:'var(--tl)',bg:'var(--tll)',tag:'AI Models',ti:'Какие нейросети внутри',de:'LiteLLM как витрина — за стеклом разные инструменты. Учащийся выбирает нужный. Не надо знать где живёт каждая модель.',li:['Claude Haiku — основной: дёшево, умно, быстро','FLUX/SDXL — кадры для сериала: текст → картинка','GPT-4o mini — резерв и задачи с кодом','Mistral — бесплатный через OpenRouter'],te:'OpenRouter + Anthropic API\nFLUX: HuggingFace Inference API'},
langfuse:{ic:'bi-graph-up-arrow',co:'var(--pu)',bg:'var(--pul)',tag:'Langfuse',ti:'Langfuse — чёрный ящик наоборот',de:'Обычно что происходит внутри AI — тайна. Langfuse делает всё прозрачным: кто спросил, что ответили, сколько токенов, сколько стоило.',li:['Каждый вызов залогирован — ничего не теряется','Дашборд по деньгам: урок стоил $0.12 — нормально?','Библиотека промптов с версионированием','Преподаватель понимает кто реально учится'],te:'langfuse.com (self-hosted)\nИнтеграция: одна строка в config.yaml'},
login:{ic:'bi-person-check',co:'var(--bl)',bg:'var(--bll)',tag:'Личный кабинет',ti:'Личный кабинет учащегося',de:'Вход без email, телефона, кода из SMS. Username и пароль. История диалогов только у него.',li:['Все диалоги сохраняются — вернёшься к прошлому уроку','Никто другой не видит чужую историю','Забыл пароль — преподаватель сбрасывает за секунду'],te:'Auth: Open WebUI built-in\nDB: SQLite · изоляция по user_id'},
laptop:{ic:'bi-laptop',co:'var(--gn)',bg:'var(--gnl)',tag:'Любой ноутбук',ti:'Любой ноутбук. Серьёзно — любой.',de:'Вся система в браузере. Старый HP 2014 справится как MacBook Pro. Ничего не устанавливается.',li:['Ноль установок — браузер это и есть интерфейс','Windows, macOS, Linux, ChromeOS — без разницы','Все учащиеся в одинаковых условиях'],te:'Требования: браузер + интернет\nChrome 120+, Firefox 121+, Safari 17+'},
control:{ic:'bi-eye',co:'var(--pu)',bg:'var(--pul)',tag:'Контроль',ti:'Контроль без хождения по рядам',de:'Преподаватель видит всё в реальном времени. Новый запрос — в дашборде через секунду. Не нужно заглядывать в экраны.',li:['Кто активно работает, кто завис на 7 минут','Кто тратит токены с угрожающей скоростью','После урока: разбор лучших и худших промптов'],te:'Langfuse Traces\nReal-time: polling каждые 5 сек'},
