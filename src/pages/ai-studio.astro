redis:{ic:'bi-database',co:'var(--rd)',bg:'var(--rdl)',tag:'Redis',ti:'Redis — память на повторения',de:'Двадцать учащихся задали один вопрос — нейросеть отвечает один раз, остальные из кеша. Реальная экономия около 60% токенов на типовых уроках.',li:['Повторный вопрос — ответ без токенов','Счётчик токенов учащегося обновляется здесь','Приватные диалоги не кешируются'],te:'Redis 7.x · TTL: 24h\ndocker: redis:alpine · порт 6379'},
models:{ic:'bi-cpu',co:'var(--tl)',bg:'var(--tll)',tag:'AI Models',ti:'Какие нейросети внутри',de:'LiteLLM как витрина — за стеклом разные инструменты. Учащийся выбирает нужный. Не надо знать где живёт каждая модель.',li:['Claude Haiku — основной: дёшево, умно, быстро','FLUX/SDXL — кадры для сериала: текст → картинка','GPT-4o mini — резерв и задачи с кодом','Mistral — бесплатный через OpenRouter'],te:'OpenRouter + Anthropic API\nFLUX: HuggingFace Inference API'},
langfuse:{ic:'bi-graph-up-arrow',co:'var(--pu)',bg:'var(--pul)',tag:'Langfuse',ti:'Langfuse — чёрный ящик наоборот',de:'Обычно что происходит внутри AI — тайна. Langfuse делает всё прозрачным: кто спросил, что ответили, сколько токенов, сколько стоило.',li:['Каждый вызов залогирован — ничего не теряется','Дашборд по деньгам: урок стоил $0.12 — нормально?','Библиотека промптов с версионированием','Преподаватель понимает кто реально учится'],te:'langfuse.com (self-hosted)\nИнтеграция: одна строка в config.yaml'},
login:{ic:'bi-person-check',co:'var(--bl)',bg:'var(--bll)',tag:'Личный кабинет',ti:'Личный кабинет учащегося',de:'Вход без email, телефона, кода из SMS. Username и пароль. История диалогов только у него.',li:['Все диалоги сохраняются — вернёшься к прошлому уроку','Никто другой не видит чужую историю','Забыл пароль — преподаватель сбрасывает за секунду'],te:'Auth: Open WebUI built-in\nDB: SQLite · изоляция по user_id'},
laptop:{ic:'bi-laptop',co:'var(--gn)',bg:'var(--gnl)',tag:'Любой ноутбук',ti:'Любой ноутбук. Серьёзно — любой.',de:'Вся система в браузере. Старый HP 2014 справится как MacBook Pro. Ничего не устанавливается.',li:['Ноль установок — браузер это и есть интерфейс','Windows, macOS, Linux, ChromeOS — без разницы','Все учащиеся в одинаковых условиях'],te:'Требования: браузер + интернет\nChrome 120+, Firefox 121+, Safari 17+'},
control:{ic:'bi-eye',co:'var(--pu)',bg:'var(--pul)',tag:'Контроль',ti:'Контроль без хождения по рядам',de:'Преподаватель видит всё в реальном времени. Новый запрос — в дашборде через секунду. Не нужно заглядывать в экраны.',li:['Кто активно работает, кто завис на 7 минут','Кто тратит токены с угрожающей скоростью','После урока: разбор лучших и худших промптов'],te:'Langfuse Traces\nReal-time: polling каждые 5 сек'},
memory:{ic:'bi-journal-bookmark',co:'var(--tl)',bg:'var(--tll)',tag:'Память',ti:'Нейросеть не помнит. Мы помним.',de:'Нейросеть амнезична — каждый новый запрос первое знакомство. Open WebUI решает это автоматически: хранит историю и передаёт контекст.',li:['История диалога передаётся в каждый запрос','«Как мы обсуждали выше...» — работает как ожидается','Длинные проекты держат контекст через системный промпт'],te:'Контекстное окно: до 200k токенов\n[system]+[history]+[message]'},
limits:{ic:'bi-speedometer2',co:'var(--or)',bg:'var(--orl)',tag:'Лимиты',ti:'Лимиты токенов — защита бюджета',de:'50 000 токенов в день на учащегося. Этого много для нормальной работы и мало чтобы случайно потратить всё за раз.',li:['Потратил — получает сообщение, не ошибку','Преподаватель повышает лимит активному учащемуся','Статистика расхода видна в Langfuse'],te:'LiteLLM: max_budget: $0.50/user/day\nRedis: счётчик с TTL 24h'},
project:{ic:'bi-film',co:'var(--rd)',bg:'var(--rdl)',tag:'Финальный проект',ti:'Что учащийся приносит домой',de:'Настоящий мини-сериал — не скриншот чата. Видео с текстом, картинками и озвучкой, созданное руками с помощью нескольких нейросетей.',li:['Сценарий — написан с текстовой нейросетью','Кадры — сгенерированы через FLUX или SDXL','Озвучка — через TTS прямо в интерфейсе','Монтаж — финальный экспорт'],te:'Финальный дедлайн: последний урок\nФормат: видео 2–5 мин + портфолио'}
};

// Нарратив: t = время в мс от начала сцены, audio = path к MP3, hi = ids для подсветки
const NAR={
1:[
  {t:0,    audio:'/audio/ai-studio/n1-1.mp3',tx:'Итак. Нейросети для текста — одни. Для картинок — другие. Для видео — третьи. Для кода — четвёртые. Стандартный курс отвечает: разберитесь сами.',hi:['c1t','c1i','c1v','c1c']},
  {t:10500,audio:'/audio/ai-studio/n1-2.mp3',tx:'Обычно так: дайте учащемуся кредитку, зарегистрируйтесь в восьми сервисах, разберитесь с восемью интерфейсами — и тогда, может быть, начнём.',hi:['c1t','c1i','c1v','c1c']},
  {t:21000,audio:'/audio/ai-studio/n1-3.mp3',tx:'Мы сделали иначе. Один адрес, один логин — и всё уже внутри. Никаких подписок и регистраций. Открыл браузер — работаешь.',hi:['c1s']},
  {t:29000,audio:'/audio/ai-studio/n1-4.mp3',tx:'Кликайте на любой блок — расскажем подробнее.',hi:[]},
],
2:[
  {t:0,    audio:'/audio/ai-studio/n2-1.mp3',tx:'Теперь про кухню. Как это вообще работает, если не вдаваться в занудство.',hi:[]},
  {t:5000, audio:'/audio/ai-studio/n2-2.mp3',tx:'Учащийся открывает браузер. Никакого «установите приложение». Логин, пароль — и вот наш интерфейс с персонажами и всеми инструментами.',hi:['c2s','c2w']},
  {t:14000,audio:'/audio/ai-studio/n2-3.mp3',tx:'Главное, о чём обычно молчат: нейросеть не помнит вас от слова совсем. Каждый запрос — первое знакомство. Open WebUI решает это автоматически — хранит историю.',hi:['c2w','mn']},
  {t:24500,audio:'/audio/ai-studio/n2-4.mp3',tx:'Все запросы через LiteLLM — строгий кассир. Считает токены, выбирает нужную модель. Redis запоминает повторяющиеся вопросы — экономим деньги.',hi:['c2l','c2r']},
  {t:33500,audio:'/audio/ai-studio/n2-5.mp3',tx:'Преподаватель видит всё через Langfuse. Кто работает, кто завис, кто спрашивает нейросеть о смысле жизни вместо задания — всё очевидно.',hi:['c2f','c2t']},
],
3:[
  {t:0,    audio:'/audio/ai-studio/n3-1.mp3',tx:'Что получает учащийся? Реальный опыт с нейросетями. Не смотрит демо на экране — сам, своими руками.',hi:['j1','j2','j3']},
  {t:7700, audio:'/audio/ai-studio/n3-2.mp3',tx:'Личный кабинет с историей. Любой ноутбук — всё в браузере. Никакого «принесите MacBook» или «купите подписку заранее».',hi:['c3a','c3b']},
  {t:15500,audio:'/audio/ai-studio/n3-3.mp3',tx:'Преподаватель не ходит по рядам — видит всех одновременно. Кому нужна помощь — очевидно без вопросов.',hi:['c3c']},
  {t:22500,audio:'/audio/ai-studio/n3-4.mp3',tx:'В конце курса у каждого учащегося есть готовый проект. Настоящий мини-сериал: сценарий, картинки, озвучка — всё через нейросети. Не теория. Продукт.',hi:['j4','j5','c3f']},
],
};

let sn=1,pl=false,el=0,tmr=null,aud=null;
let aT=[];
const $=id=>document.getElementById(id);
const at=(d,fn)=>{const t=setTimeout(fn,d);aT.push(t);return t;};
const kill=()=>{aT.forEach(clearTimeout);aT=[];};
const show=(id,d=0)=>at(d,()=>{const e=$(id);if(e)e.classList.add('on');});
const showEl=(id,d=0)=>at(d,()=>{const e=$(id);if(e)e.style.opacity='1';});

function sub(t){const e=$('sub');if(e)e.textContent=t||'Пауза — кликайте на блоки';}

function hl(ids){
  document.querySelectorAll('.card,.solc,.mn').forEach(c=>c.classList.remove('nar'));
  ids.forEach(id=>{const e=$(id);if(e)e.classList.add('nar');});
}

function speak(audioPath, txt){
  if(aud){aud.pause();aud=null;}
  sub(txt);
  if(!audioPath)return;
  aud=new Audio(audioPath);
  aud.play().catch(e=>console.warn('audio play blocked',e));
}

function stopAud(){if(aud){aud.pause();aud=null;}}

function tog(){if(pl)pause();else startPl();}

function startPl(){
  pl=true;$('pb').innerHTML='<i class="bi bi-pause-fill"></i>';
  runAnim(sn);schedNar(sn);startT();
}
function pause(){
  pl=false;$('pb').innerHTML='<i class="bi bi-play-fill"></i>';
  stopAud();kill();stopT();hl([]);sub('Пауза — кликайте на блоки');
}
function rst(){
  pause();el=0;updT();resetAnims();go(1);sub('Нажмите ▶ чтобы запустить рассказ с озвучкой');
}
function nxt(){
  kill();stopAud();el=0;
  const was=pl;if(pl)pause();
  const n=sn<3?sn+1:1;
  go(n);
  if(was)setTimeout(()=>startPl(),320);
}

function resetAnims(){
  document.querySelectorAll('.card,.solc').forEach(c=>{c.classList.remove('on','nar');c.style.opacity='';c.style.transform='';});
  document.querySelectorAll('.mn').forEach(c=>{c.classList.remove('on','nar');c.style.opacity='0';});
  document.querySelectorAll('.cnv').forEach(c=>c.classList.remove('on'));
  const a=$('arrC');if(a)a.style.opacity='0';
  ['x1','x2','x3','x4'].forEach(id=>{const e=$(id);if(e)e.classList.remove('on');});
  const j=$('jny');if(j)j.classList.remove('on');
  document.querySelectorAll('.jst').forEach(e=>e.classList.remove('lit'));
  document.querySelectorAll('.jar').forEach(e=>e.classList.remove('lit'));
}

function runAnim(n){
  if(n===1){
    show('c1t',100);show('c1i',380);show('c1v',660);show('c1c',940);
    at(1400,()=>['x1','x2','x3','x4'].forEach((id,i)=>at(i*170,()=>$(id)&&$(id).classList.add('on'))));
    showEl('arrC',2100);
    show('c1s',2500);
  }
  if(n===2){
    show('c2s',100);show('c2t',450);
    at(650,()=>$('cvs')&&$('cvs').classList.add('on'));
    show('c2w',900);
    at(1500,()=>{const e=$('mn');if(e){e.style.opacity='1';e.classList.add('on');}});
    at(1800,()=>$('cvw')&&$('cvw').classList.add('on'));
    show('c2l',2200);
    at(2800,()=>$('cvl')&&$('cvl').classList.add('on'));
    show('c2r',3200);
    show('c2m',1100);
    at(1900,()=>$('cvm')&&$('cvm').classList.add('on'));
    show('c2f',2300);
  }
  if(n===3){
    const j=$('jny');if(j)j.classList.add('on');
    [['j1','ja1'],['j2','ja2'],['j3','ja3'],['j4','ja4'],['j5',null]].forEach(([js,ja],i)=>{
      at(200+i*480,()=>{
        const s=$(js);if(s)s.classList.add('lit');
        if(ja){const a=$(ja);if(a)a.classList.add('lit');}
      });
    });
    ['c3a','c3b','c3c','c3d','c3e','c3f'].forEach((id,i)=>show(id,350+i*220));
  }
}

function schedNar(n){
  const L=NAR[n]||[];
  L.forEach(({t,audio,tx,hi})=>at(t,()=>{if(!pl)return;speak(audio,tx);if(hi)hl(hi);}));
}

function startT(){stopT();tmr=setInterval(()=>{el+=200;updT();updProg();},200);}
function stopT(){clearInterval(tmr);}
function updT(){const s=Math.floor(el/1000);$('td').textContent=Math.floor(s/60)+':'+(s%60).toString().padStart(2,'0');}
function updProg(){const max=sn===1?32000:sn===2?42500:32000;$('pf').style.width=Math.min(100,el/max*100)+'%';}

function go(n){
  stopAud();kill();el=0;updT();updProg();
  const prev=$('s'+sn),next=$('s'+n);
  if(prev&&prev!==next)prev.classList.remove('on');
  sn=n;if(next)next.classList.add('on');
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',+t.dataset.s===n));
  resetAnims();
  if(pl){runAnim(n);schedNar(n);startT();}
}

function inf(k){
  const d=D[k];if(!d)return;
  $('ic').innerHTML=
    '<div class="iic" style="background:'+d.bg+';color:'+d.co+'"><i class="bi '+d.ic+'"></i></div>'+
    '<div class="itl" style="color:'+d.co+'">'+d.ti+'</div>'+
    '<span class="itg" style="background:'+d.bg+';color:'+d.co+'">'+d.tag+'</span>'+
    '<div class="ids">'+d.de+'</div>'+
    '<ul class="il">'+d.li.map(l=>'<li><i class="bi bi-check2-circle"></i><span>'+l+'</span></li>').join('')+'</ul>'+
    '<div class="isp"></div>'+
    '<div class="ite">'+d.te.replace(/\n/g,'<br>')+'</div>';
  $('iov').classList.add('on');
  if(pl)pause();
}
function closeInf(e){
  if(e&&e.target!==$('iov')&&!e.target.closest('.icl'))return;
  $('iov').classList.remove('on');
}

document.addEventListener('keydown',e=>{
  if(e.code==='Space'&&e.target===document.body){e.preventDefault();tog();}
  if(e.code==='ArrowRight')nxt();
  if(e.code==='Escape')closeInf({target:$('iov')});
});

sub('Нажмите ▶ чтобы запустить рассказ с озвучкой');updT();
</script>
