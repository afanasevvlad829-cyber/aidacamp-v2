// Нарратив. Каждый шаг — фраза с озвучкой. hi = карточки/элементы, которые «зажигаются» во время этой фразы.
// step = массив подсветок, синхронизированных с конкретными словами (микро-таймлайн внутри фразы).
const NAR={
1:[
  {t:0,    audio:'/audio/ai-studio/n1-1.mp3',dur:10200,tx:'Нейросети для текста — одни. Для картинок — другие. Для видео — третьи. Для кода — четвёртые.',
   step:[{at:1500,hi:['c1t']},{at:4000,hi:['c1t','c1i']},{at:6500,hi:['c1t','c1i','c1v']},{at:8500,hi:['c1t','c1i','c1v','c1c']}]},
  {t:10700,audio:'/audio/ai-studio/n1-2.mp3',dur:10700,tx:'Обычно так: дайте учащемуся кредитку, зарегистрируйтесь в восьми сервисах, разберитесь с восемью интерфейсами.',
   hi:['c1t','c1i','c1v','c1c']},
  {t:21900,audio:'/audio/ai-studio/n1-3.mp3',dur:8300,tx:'Мы сделали иначе. Один адрес, один логин — и всё уже внутри.',
   hi:['c1s']},
  {t:30700,audio:'/audio/ai-studio/n1-4.mp3',dur:2800,tx:'Кликайте на любой блок — расскажем подробнее.',
   hi:[]},
],
2:[
  {t:0,    audio:'/audio/ai-studio/n2-1.mp3',dur:5000,tx:'Теперь про кухню. Как это вообще работает, если не вдаваться в занудство.',hi:[]},
  {t:5500, audio:'/audio/ai-studio/n2-2.mp3',dur:9100,tx:'Учащийся открывает браузер. Логин, пароль — и наш интерфейс со всеми инструментами.',
   step:[{at:500,hi:['c2s']},{at:5000,hi:['c2s','c2w']}]},
  {t:15100,audio:'/audio/ai-studio/n2-3.mp3',dur:10600,tx:'Главное: нейросеть не помнит вас. Каждый запрос — первое знакомство. Open WebUI хранит историю автоматически.',
   step:[{at:0,hi:['mn']},{at:5500,hi:['mn','c2w']}]},
  {t:26200,audio:'/audio/ai-studio/n2-4.mp3',dur:9400,tx:'Все запросы через LiteLLM — строгий кассир. Redis запоминает повторяющиеся вопросы.',
   step:[{at:0,hi:['c2l']},{at:5500,hi:['c2l','c2r']}]},
  {t:36100,audio:'/audio/ai-studio/n2-5.mp3',dur:8900,tx:'Преподаватель видит всё через Langfuse. Кто работает, кто завис — очевидно.',
   step:[{at:0,hi:['c2f']},{at:5000,hi:['c2f','c2t']}]},
],
3:[
  {t:0,    audio:'/audio/ai-studio/n3-1.mp3',dur:7500,tx:'Что получает учащийся? Реальный опыт с нейросетями — сам, своими руками.',
   step:[{at:0,hi:['j1']},{at:2500,hi:['j1','j2']},{at:5000,hi:['j1','j2','j3']}]},
  {t:8000, audio:'/audio/ai-studio/n3-2.mp3',dur:8000,tx:'Личный кабинет с историей. Любой ноутбук — всё в браузере.',
   step:[{at:0,hi:['c3a']},{at:4000,hi:['c3a','c3b']}]},
  {t:16500,audio:'/audio/ai-studio/n3-3.mp3',dur:6800,tx:'Преподаватель не ходит по рядам — видит всех одновременно.',
   hi:['c3c']},
  {t:23800,audio:'/audio/ai-studio/n3-4.mp3',dur:9500,tx:'В конце курса — готовый проект. Мини-сериал: сценарий, картинки, озвучка. Не теория. Продукт.',
   step:[{at:0,hi:['j4']},{at:3000,hi:['j4','j5']},{at:6000,hi:['j4','j5','c3f']}]},
],
};

let sn=1,pl=false,el=0,tmr=null,aud=null;
let aT=[];
const $=id=>document.getElementById(id);
const at=(d,fn)=>{const t=setTimeout(fn,d);aT.push(t);return t;};
const kill=()=>{aT.forEach(clearTimeout);aT=[];};
const show=(id,d=0)=>at(d,()=>{const e=$(id);if(e)e.classList.add('on');});
const showEl=(id,d=0)=>at(d,()=>{const e=$(id);if(e)e.style.opacity='1';});

function sub(t){const e=$('sub');if(e)e.textContent=t||'Пауза — кликайте на блоки';}

function hl(ids){
  // Spotlight: только указанные элементы яркие, остальные dimmed (через .sc[data-narrating]).
  document.querySelectorAll('.card,.solc,.mn,.jst,.jar').forEach(c=>c.classList.remove('nar'));
  const sc=$('s'+sn);
  if(!ids||!ids.length){if(sc)sc.removeAttribute('data-narrating');return;}
  if(sc)sc.setAttribute('data-narrating','true');
  ids.forEach(id=>{const e=$(id);if(e)e.classList.add('nar');});
}

function speak(audioPath, txt){
  if(aud){aud.pause();aud=null;}
  sub(txt);
  if(!audioPath)return;
  aud=new Audio(audioPath);
  aud.play().catch(e=>console.warn('audio play blocked',e));
}

function stopAud(){if(aud){aud.pause();aud=null;}}

function tog(){if(pl)pause();else startPl();}

function startPl(){
  pl=true;$('pb').innerHTML='<i class="bi bi-pause-fill"></i>';
  runAnim(sn);schedNar(sn);startT();
}
function pause(){
  pl=false;$('pb').innerHTML='<i class="bi bi-play-fill"></i>';
  stopAud();kill();stopT();hl([]);
  document.querySelectorAll('.sc').forEach(s=>s.removeAttribute('data-narrating'));
  sub('Пауза — кликайте на блоки или ▶ чтобы продолжить');
}
function rst(){
  pause();el=0;updT();resetAnims();go(1,false);sub('Нажмите ▶ чтобы запустить рассказ с озвучкой');
}
function nxt(){
  kill();stopAud();el=0;
  const was=pl;if(pl)pause();
  const n=sn<3?sn+1:1;
  go(n,false);
  if(was)setTimeout(()=>startPl(),320);
}

function resetAnims(){
  // Полный сброс — карточки скрыты до runAnim
  document.querySelectorAll('.card,.solc').forEach(c=>c.classList.remove('on','nar'));
  document.querySelectorAll('.mn').forEach(c=>c.classList.remove('on','nar'));
  document.querySelectorAll('.cnv').forEach(c=>c.classList.remove('on'));
  const a=$('arrC');if(a)a.style.opacity='0';
  const j=$('jny');if(j)j.classList.remove('on');
  document.querySelectorAll('.jst,.jar').forEach(e=>e.classList.remove('nar'));
}

// Показать все карточки сцены сразу (с лёгким staggered fade-in), без подсветки
function showAll(n){
  if(n===1){
    const ids=['c1t','c1i','c1v','c1c'];
    ids.forEach((id,i)=>at(i*120,()=>$(id)&&$(id).classList.add('on')));
    at(700,()=>{const a=$('arrC');if(a)a.style.opacity='1';});
    show('c1s',900);
  }
  if(n===2){
    const ids=['c2s','c2t','c2w','c2l','c2r','c2m','c2f'];
    ids.forEach((id,i)=>at(i*100,()=>$(id)&&$(id).classList.add('on')));
    at(900,()=>{const e=$('mn');if(e)e.classList.add('on');});
    at(800,()=>['cvs','cvw','cvl','cvm'].forEach(id=>$(id)&&$(id).classList.add('on')));
  }
  if(n===3){
    const j=$('jny');if(j)j.classList.add('on');
    const ids=['c3a','c3b','c3c','c3d','c3e','c3f'];
    ids.forEach((id,i)=>at(150+i*100,()=>$(id)&&$(id).classList.add('on')));
  }
}

function runAnim(n){
  showAll(n);
}

function schedNar(n){
  const L=NAR[n]||[];
  L.forEach(({t,audio,tx,hi,step})=>{
    at(t,()=>{
      if(!pl)return;
      speak(audio,tx);
      // Если есть микро-таймлайн внутри фразы — раскручиваем подсветку поэтапно
      if(step&&step.length){
        step.forEach(s=>at(s.at,()=>{if(pl)hl(s.hi);}));
      } else if(hi){
        hl(hi);
      }
    });
  });
  // После последней фразы — снять спотлайт
  const last=L[L.length-1];
  if(last)at(last.t+(last.dur||5000)+500,()=>{if(pl)hl([]);});
}

function startT(){stopT();tmr=setInterval(()=>{el+=200;updT();updProg();},200);}
function stopT(){clearInterval(tmr);}
function updT(){const s=Math.floor(el/1000);$('td').textContent=Math.floor(s/60)+':'+(s%60).toString().padStart(2,'0');}
function updProg(){const max=sn===1?34000:sn===2?45500:33500;$('pf').style.width=Math.min(100,el/max*100)+'%';}

function go(n,anim=true){
  stopAud();kill();el=0;updT();updProg();
  const prev=$('s'+sn),next=$('s'+n);
  if(prev&&prev!==next){
    if(anim){prev.classList.add(n>sn?'el':'er');setTimeout(()=>prev.classList.remove('on','el','er'),320);}
    else prev.classList.remove('on');
  }
  sn=n;if(next)next.classList.add('on');
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',+t.dataset.s===n));
  resetAnims();
  if(pl){runAnim(n);schedNar(n);startT();}
}

function inf(k){
  const d=D[k];if(!d)return;
  $('ic').innerHTML=
    '<div class="iic" style="background:'+d.bg+';color:'+d.co+'"><i class="bi '+d.ic+'"></i></div>'+
    '<div class="itl" style="color:'+d.co+'">'+d.ti+'</div>'+
    '<span class="itg" style="background:'+d.bg+';color:'+d.co+'">'+d.tag+'</span>'+
    '<div class="ids">'+d.de+'</div>'+
    '<ul class="il">'+d.li.map(l=>'<li><i class="bi bi-check2-circle"></i><span>'+l+'</span></li>').join('')+'</ul>'+
    '<div class="isp"></div>'+
    '<div class="ite">'+d.te.replace(/\n/g,'<br>')+'</div>';
  $('iov').classList.add('on');
  if(pl)pause();
}
function closeInf(e){
  if(e&&e.target!==$('iov')&&!e.target.closest('.icl'))return;
  $('iov').classList.remove('on');
}

document.addEventListener('keydown',e=>{
  if(e.code==='Space'&&e.target===document.body){e.preventDefault();tog();}
  if(e.code==='ArrowRight')nxt();
  if(e.code==='Escape')closeInf({target:$('iov')});
});

sub('Нажмите ▶ чтобы запустить рассказ с озвучкой');updT();
</script>
