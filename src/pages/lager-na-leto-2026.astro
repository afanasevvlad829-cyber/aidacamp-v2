---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, mainShifts, shortShifts } from '../data/shifts';
import TaxCalculator from '../components/TaxCalculator.astro';
import { shiftLinkHtml } from '../lib/shift-link';
import FAQSchema from '../components/FAQSchema.astro';

const allShiftsForTable = [...mainShifts, ...shortShifts].sort((a, b) => a.startDate.localeCompare(b.startDate));

const sections = [
  {
    h2: "Летний лагерь для ребёнка АйДаКемп — смены 2026",
    text: "АйДаКемп — выездной летний лагерь для ребёнка 7–15 лет в Подмосковье, 66 км от МКАД. Летом в лагере дети создают настоящий IT-проект: бот, игру, сайт или приложение. Смены с 30 мая по 26 августа. Программа подбирается по возрасту: Scratch и Minecraft для младших, Python и AI для старших."
  },
  {
    h2: "Городской или загородный лагерь на лето?",
    text: "Если выбираете между городским лагерем на каникулы (дневной формат при центре или школе, творческие и спортивные занятия, вечером — домой) и загородной сменой с проживанием — мы разобрали оба варианта честно: кому подходит городской, кому загородный, и как провести лето с пользой. Подробное сравнение — в статье <a href='/stati/gorodskoy-ili-zagorodnyy-lager/'>«Городской или загородный лагерь»</a>. АйДаКемп — загородный формат: смена-погружение, IT-проект и каникулы в лесу без экранной рутины."
  },
  {
    h2: "Летняя смена 2026 — даты и цены",
    text: "Шесть смен на лето 2026 — две длинные (14 дней) и четыре на выбор. Каждая летняя смена — полноценная IT-программа с хакатоном в финале.",
    list: [
      `Смена 1: ${DATES_S1}, 10 дней — ${PRICE_S4}`,
      `Смена 2: ${DATES_SHORT_S2}, 14 дней — ${PRICE_MAX}`,
      `Смена 2.1: ${DATES_SHORT_S21}, 7 дней — ${PRICE_MIN}`,
      `Смена 2.2: ${DATES_SHORT_S22}, 8 дней — ${PRICE_S22}`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "В стоимость включено: проживание, 5-разовое питание, IT-программа, бассейн"
    ]
  },
  {
    h2: "Что нового в программе лагеря 2026",
    text: "В 2026 году мы обновили программу. Добавлены модули по работе с нейросетями и AI-инструментами: дети учатся использовать AI для генерации изображений, текстов и кода. Хакатон «Стартап из будущего» стал ещё масштабнее — с двумя раундами инвестиций и ролевой системой. Внутренняя экономика лагеря теперь включает коллективные покупки и торги между группами."
  },
  {
    h2: "Как записаться на лето 2026",
    text: "Оставьте заявку на сайте — мы перезвоним в течение 10 минут и подберём смену. Бронирование фиксирует цену на 72 часа. Оплата 100% или 50% сейчас + 50% за 3 недели до смены. Образовательная лицензия позволяет оформить налоговый вычет 13%."
  },
  {
    h2: "Полный календарь летних смен лагеря 2026",
    text: "Шесть заездов с конца мая по конец августа. Указаны даты, длительность, цена включая проживание + питание + IT-программу + все активности. Обратите внимание: смены 2.1 и 2.2 — части большой смены 2, но можно брать по отдельности если ребёнку 7 дней достаточно.",
    list: [
      `30.05–08.06 · Смена 1 (ранняя) · 10 дней · ${PRICE_S4} — пока ещё школа не завершилась, тёплые дни, программа «вхождение»`,
      `10.06–23.06 · Смена 2 (флагман) · 14 дней · ${PRICE_MAX} — самая популярная, все модули программы, двойной хакатон`,
      `10.06–16.06 · Смена 2.1 (короткая) · 7 дней · ${PRICE_MIN} — первая половина смены 2, для тех кто впервые`,
      `16.06–23.06 · Смена 2.2 (короткая) · 8 дней · ${PRICE_S22} — вторая половина смены 2, с полноценным хакатоном`,
      `03.08–15.08 · Смена 3 (летняя) · 13 дней · ${PRICE_S3} — после июльской паузы, с обновлёнными модулями`,
      `17.08–26.08 · Смена 4 (финальная) · 10 дней · ${PRICE_S4} — последний заход перед школой, «добор впечатлений»`
    ]
  },
  {
    h2: "Чем лагерь на лето 2026 отличается от прошлых сезонов",
    text: "Каждый год мы смотрим на обратную связь и меняем программу. К лету 2026 обновили три блока. Первое — все IT-занятия теперь ведут AI-модули: дети учат не просто Python, а Python + Gemini/Claude для генерации помощников и ботов. Второе — хакатон стал двухдневным: первый день идея и прототип, второй день доработка по фидбеку и защита. Третье — внутренняя экономика лагеря теперь включает биржу идей и коллективные инвестиции: дети учатся не только зарабатывать валюту, но и вкладывать. Мы специально не повторяли прошлогодние проекты — если ваш ребёнок был у нас в 2024 или 2025, в 2026 он попадёт в новую программу, а не переучивать уже известное."
  },
  {
    h2: "Что взять ребёнку в летний лагерь — чек-лист 2026",
    text: "Ноутбук и технику привозить не нужно — всё оборудование в лагере. Нужны личные вещи и немного подготовки к отъезду.",
    list: [
      "Одежда на каждый день + 1–2 комплекта запасных, лёгкая ветровка",
      "Купальник/плавки и тапочки для бассейна — обязательно",
      "Солнцезащитный крем SPF 30+, очки, лёгкая кепка",
      "Предметы личной гигиены: мыло, шампунь, зубная щётка",
      "Аптечка: личные лекарства (если есть) + что-то от простуды на всякий случай",
      "Блокнот и ручка — для записей на занятиях, многие дети ведут дневник",
      "Хорошее настроение — гаджеты в лагере работают как внутренняя валюта, а не развлечение",
    ],
  },
  {
    h2: "Вопросы о летнем лагере 2026",
    text: "Собрали ответы на то, что чаще всего спрашивают перед первой сменой.",
    list: [
      "С какого возраста берёте? — С 7 лет. Возрастные группы: 7–9, 9–11, 11–13, 13–15 лет. Программа разная.",
      "Нужен ли опыт программирования? — Нет. Все потоки начинаются с нуля внутри возрастной группы.",
      'Что если ребёнку не понравится? — <a href="/politika-vozvrata/">Условия возврата →</a>',
      "Как часто можно звонить ребёнку? — Видеозвонок каждый день в фиксированное время + ежедневные фото в чате.",
      "Есть ли трансфер из Москвы? — Да, организованный трансфер от метро Солнцево.",
      "Принимаете детей с аллергией / особым питанием? — Да, согласовываем рацион заранее.",
    ],
  },
  {
    h2: "Когда бронировать: июль занят, в июне и августе ещё есть места",
    text: "Летний календарь АйДаКемп — без июля: смены проходят в мае–июне и августе. Это не случайно — на территории в июле другая программа. Планируйте заранее:",
    list: [
      "Конец мая (смена 1, 30.05–08.06) — мест ещё достаточно, хороший старт сезона",
      "Июнь (смены 2, 2.1, 2.2) — самые популярные, заполняются к началу мая",
      "Июль — смен нет, это нужно знать при планировании отпуска",
      "Август (смены 3 и 4) — ещё открыты, можно взять оба подряд или выбрать одну",
      "Совет: если хотите июнь — бронируйте сейчас. Если не успели — август ещё ждёт"
    ]
  },
  {
    h2: "Что ждёт летом 2026: новые треки, хакатон, рекорды",
    text: "Лето 2026 — обновлённая программа. Три главных изменения по сравнению с прошлым сезоном:",
    list: [
      "Новый AI-трек: ChatGPT API + Gemini — школьники создают собственных AI-ассистентов на Python",
      "Двухдневный хакатон: первый день — прототип и идея, второй — доработка по фидбеку и питч",
      "Рекорд программы: самый быстрый рабочий бот за смену — 2023 год побит, ставим новую планку",
      "Обновлённая внутренняя экономика лагеря: биржа идей, коллективные проекты, новые механики",
      "Если ваш ребёнок был в 2024 или 2025 — в 2026 его ждёт принципиально новая программа"
    ]
  },
  {
    h2: "Почему записываться на лето 2026 стоит сейчас, а не «ближе к сезону»",
    text: `Три причины действовать сейчас, а не в мае. Первое — цены зафиксированы, после 1 мая повышаются на 10–15%. Второе — по данным прошлых лет, флагманская смена 2 (${DATES_SHORT_S2}) продаётся полностью к началу мая; после этого остаются только короткие куски 2.1/2.2. Третье — при раннем бронировании мы успеваем подготовить комнаты под особенности ребёнка (аллергии, диета, желание быть с другом). В последний момент это уже «куда попадёт». Налоговый вычет 13% работает круглый год, но оформить его проще, когда договор и оплата прошли до начала учебного года.`
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летние лагеря 2026 для детей | Летний лагерь для ребёнка в Подмосковье — АйДаКемп"
  description="Летние детские лагеря в Подмосковье 2026: IT-программа, смены с 30 мая по 26 августа. Летняя смена 7–14 дней — Python, AI, Scratch. Проживание, питание, бассейн. Налоговый вычет 13%."
  h1="Детский лагерь на лето 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-leto-2026"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Когда открываются смены в детском лагере на лето 2026?", a: "Смены с 30 мая по 26 августа. Регистрация открыта, бронь на 72 часа без предоплаты." },
    { q: "Сколько стоит лагерь на лето 2026?", a: `От ${PRICE_MIN} за 7 дней до ${PRICE_MAX} за 14 дней. Цены зафиксированы.` },
    { q: "Какие программы есть в летнем лагере 2026?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает трек при записи." },
    { q: "Можно ли получить налоговый вычет за летний лагерь 2026?", a: "Да, 13% от образовательной части путёвки. У лагеря есть лицензия Минобрнауки." }
  ]} />
