---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';
import { mainShifts, shortShifts } from '../data/shifts';
import TaxCalculator from '../components/TaxCalculator.astro';
import { shiftLinkHtml } from '../lib/shift-link';

const allShiftsForTable = [...mainShifts, ...shortShifts].sort((a, b) => a.startDate.localeCompare(b.startDate));

const sections = [
  {
    h2: "Летний лагерь АйДаКемп — смены 2026",
    text: "АйДаКемп — выездной IT-лагерь для детей 7–15 лет в Подмосковье, 66 км от Москвы. Смены с 30 мая по 26 августа. За каждую смену ребёнок создаёт собственный IT-проект: бот, игру, сайт или приложение. Программа подбирается по возрасту: Scratch и Minecraft для младших, Python и AI для старших."
  },
  {
    h2: "Смены 2026 — даты и цены",
    text: "Шесть смен на лето 2026 — две длинные (14 дней) и четыре на выбор. Каждая смена — полноценная IT-программа с хакатоном в финале.",
    list: [
      "Смена 1: 30 мая — 8 июня, 10 дней — 74 900 ₽",
      "Смена 2: 10 — 23 июня, 14 дней — 95 000 ₽",
      "Смена 2.1: 10 — 16 июня, 7 дней — 48 000 ₽",
      "Смена 2.2: 16 — 23 июня, 8 дней — 65 000 ₽",
      "Смена 3: 3 — 15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17 — 26 августа, 10 дней — 69 600 ₽",
      "В стоимость включено: проживание, 5-разовое питание, IT-программа, бассейн"
    ]
  },
  {
    h2: "Что нового в программе лагеря 2026",
    text: "В 2026 году мы обновили программу. Добавлены модули по работе с нейросетями и AI-инструментами: дети учатся использовать AI для генерации изображений, текстов и кода. Хакатон «Стартап из будущего» стал ещё масштабнее — с двумя раундами инвестиций и ролевой системой. Внутренняя экономика лагеря теперь включает коллективные покупки и торги между группами."
  },
  {
    h2: "Как записаться на лето 2026",
    text: "Оставьте заявку на сайте — мы перезвоним в течение 10 минут и подберём смену. Бронирование фиксирует цену на 72 часа. Оплата 100% или 50% сейчас + 50% за 3 недели до смены. Образовательная лицензия позволяет оформить налоговый вычет 13%. Если ребёнку не понравится в первые два дня — вернём деньги."
  },
  {
    h2: "Полный календарь смен лагеря на лето 2026",
    text: "Шесть заездов с конца мая по конец августа. Указаны даты, длительность, цена включая проживание + питание + IT-программу + все активности. Обратите внимание: смены 2.1 и 2.2 — части большой смены 2, но можно брать по отдельности если ребёнку 7 дней достаточно.",
    list: [
      "30.05–08.06 · Смена 1 (ранняя) · 10 дней · 74 900 ₽ — пока ещё школа не завершилась, тёплые дни, программа «вхождение»",
      "10.06–23.06 · Смена 2 (флагман) · 14 дней · 95 000 ₽ — самая популярная, все модули программы, двойной хакатон",
      "10.06–16.06 · Смена 2.1 (короткая) · 7 дней · 48 000 ₽ — первая половина смены 2, для тех кто впервые",
      "16.06–23.06 · Смена 2.2 (короткая) · 8 дней · 65 000 ₽ — вторая половина смены 2, с полноценным хакатоном",
      "03.08–15.08 · Смена 3 (летняя) · 13 дней · 89 400 ₽ — после июльской паузы, с обновлёнными модулями",
      "17.08–26.08 · Смена 4 (финальная) · 10 дней · 69 600 ₽ — последний заход перед школой, «добор впечатлений»"
    ]
  },
  {
    h2: "Чем лагерь на лето 2026 отличается от прошлых сезонов",
    text: "Каждый год мы смотрим на обратную связь и меняем программу. К лету 2026 обновили три блока. Первое — все IT-занятия теперь ведут AI-модули: дети учат не просто Python, а Python + Gemini/Claude для генерации помощников и ботов. Второе — хакатон стал двухдневным: первый день идея и прототип, второй день доработка по фидбеку и защита. Третье — внутренняя экономика лагеря теперь включает биржу идей и коллективные инвестиции: дети учатся не только зарабатывать валюту, но и вкладывать. Мы специально не повторяли прошлогодние проекты — если ваш ребёнок был у нас в 2024 или 2025, в 2026 он попадёт в новую программу, а не переучивать уже известное."
  },
  {
    h2: "Почему записываться на лето 2026 стоит сейчас, а не «ближе к сезону»",
    text: "Три причины действовать в апреле, а не в мае. Первое — цены зафиксированы до 1 мая, после чего повышаются на 10–15%. Второе — по данным прошлых лет, флагманская смена 2 (10–23 июня) продаётся полностью к началу мая; после этого остаются только короткие куски 2.1/2.2. Третье — при раннем бронировании мы успеваем подготовить комнаты под особенности ребёнка (аллергии, диета, желание быть с другом). В последний момент это уже «куда попадёт». Налоговый вычет 13% работает круглый год, но оформить его проще, когда договор и оплата прошли до начала учебного года."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний лагерь на лето 2026 в Подмосковье — цены и смены от 48 000 ₽ | АйДаКемп"
  description="Лагерь на лето 2026: IT-смены от 48 000 ₽ в Подмосковье, 66 км от Москвы. Цены зафиксированы. Python, AI, Minecraft — проект за смену. Запись открыта, места заканчиваются."
  h1="Летний лагерь на лето 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-leto-2026"
>
  <LandingHero slot="hero"
    h1="Летний лагерь на лето 2026 в Подмосковье"
    subtitle="Смены июнь–август 2026 в Подмосковье. IT-программа, бассейн, питание. Места заканчиваются."
    breadcrumb="Лагерь на лето 2026"
    keywords={["Смены открыты: июнь, август 2026 — места ограничены", "IT-программа 2026: Python, AI, Minecraft — проект за смену", `${STAT_DISTANCE} от Москвы, от ${CAMP_PRICE_FROM}, проживание и питание включены`]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний лагерь 2026 АйДаКемп"
  />
  <!-- Мини-таблица цен: сразу видна без прокрутки, целевой запрос «лагерь на лето 2026 цены» -->
  <section class="mx-auto max-w-[1312px] px-4 pt-8 pb-4 md:pt-10">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-1 h-5 rounded-full bg-orange-500 shrink-0"></div>
      <h2 class="text-[20px] md:text-[24px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900">
        Смены и цены — лето 2026
      </h2>
    </div>
    <div class="overflow-x-auto rounded-[16px] border border-slate-200">
      <table class="w-full min-w-[560px] border-collapse bg-white text-[14px]">
        <thead>
          <tr class="bg-slate-50 text-[12px] font-semibold uppercase tracking-wide text-slate-500">
            <th class="px-4 py-2.5 text-left">Смена</th>
            <th class="px-4 py-2.5 text-left">Даты</th>
            <th class="px-4 py-2.5 text-left">Дней</th>
            <th class="px-4 py-2.5 text-right font-bold text-slate-700">Цена</th>
          </tr>
        </thead>
        <tbody>
          {allShiftsForTable.map((s) => (
            <tr class="border-t border-slate-100 text-slate-700 hover:bg-orange-50/50 transition-colors">
              <td class="px-4 py-2.5 font-semibold text-slate-900">
                <span set:html={shiftLinkHtml(s.id, s.name)} />
                {s.popular && <span class="ml-1.5 text-[10px] font-semibold uppercase tracking-wide text-orange-600 bg-orange-100 rounded px-1.5 py-0.5">хит</span>}
              </td>
              <td class="px-4 py-2.5 text-slate-500">{s.dates}</td>
              <td class="px-4 py-2.5 text-slate-500">{s.duration}</td>
              <td class="px-4 py-2.5 text-right font-bold text-[#ec7c00]">{s.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[13px] text-slate-400">В стоимость включены: проживание, 5-разовое питание, IT-программа, бассейн. <a href="/ceny" class="text-orange-600 hover:underline">Подробнее о ценах →</a></p>
  </section>

  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте налоговый вычет 13% — до 14 300 ₽ возврата" />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
