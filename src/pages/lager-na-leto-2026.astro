---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM, STAT_FOUNDED_YEAR, STAT_KIDS } from '../data/contacts';
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX, mainShifts, shortShifts } from '../data/shifts';
import TaxCalculator from '../components/TaxCalculator.astro';
import { shiftLinkHtml } from '../lib/shift-link';
import FAQSchema from '../components/FAQSchema.astro';

const allShiftsForTable = [...mainShifts, ...shortShifts].sort((a, b) => a.startDate.localeCompare(b.startDate));

const sections = [
  {
    h2: "Детские лагеря Подмосковья 2026 — чем отличается АйДаКемп",
    text: `Детские летние лагеря в Подмосковье бывают разными: спортивные, языковые, творческие, оздоровительные, IT. АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, 66 км от МКАД, около часа езды от Москвы. Работаем с ${STAT_FOUNDED_YEAR} года, приняли более ${STAT_KIDS} школьников и подростков 7–15 лет. Летний сезон длится с мая по август, и все ребята получают одну и ту же программу: IT (Python, AI, Minecraft, Roblox), проживание в корпусе, 5-разовое питание, бассейн, спорт, хакатон и медработника на территории 24/7. Открытые заезды лета 2026 — от ${PRICE_MIN} (Смена 4) до ${PRICE_MAX} (Смена 3).`,
  },
  {
    h2: "Летний лагерь АйДаКемп — программа 2026",
    text: "АйДаКемп — выездной детский IT-лагерь в Подмосковье для ребят 7–15 лет, 66 км от МКАД. Заезды идут с 30 мая по 26 августа: старт в конце мая, основная волна — в июне, финал — в августе. За смену ребята создают собственный IT-проект: бот, игру, сайт или приложение. Программы подбираются по возрасту: Scratch и Minecraft для младших, Python и AI для старших подростков."
  },
  {
    h2: "Городской или загородный лагерь на лето?",
    text: "Если вы в Москве и выбираете между городским лагерем на каникулы (дневной формат при центре или школе, творческие и спортивные занятия, вечером — домой) и загородным отдыхом с проживанием — мы разобрали оба варианта честно: кому подходит городской, кому загородный, и как провести лето с пользой. Подробное сравнение — в статье <a href='/stati/gorodskoy-ili-zagorodnyy-lager/'>«Городской или загородный лагерь»</a>. АйДаКемп — загородный формат: погружение, IT-проект и каникулы в лесу без экранной рутины."
  },
  {
    h2: "Что нового в программе лагеря 2026",
    text: "В 2026 году мы обновили программу. Добавлены модули по работе с нейросетями и AI-инструментами: школьники учатся использовать AI для генерации изображений, текстов и кода. Хакатон «Стартап из будущего» стал ещё масштабнее — с двумя раундами инвестиций и ролевой системой. Внутренняя экономика лагеря теперь включает коллективные покупки и торги между группами."
  },
  {
    h2: "Как записаться на лето 2026",
    text: "Пять шагов от заявки до отъезда ребёнка в лагерь.",
    list: [
      "Оставляете заявку на сайте — короткая форма, без лишних полей",
      "Перезваниваем в течение 10 минут, подбираем заезд под возраст и даты",
      "Бронь фиксирует стоимость на 72 часа — решаете без спешки, сумма не меняется",
      "Оплата: 100% сразу или 50% сейчас + 50% за 3 недели до смены",
      "Получаете документы на email — договор и всё для оформления налогового вычета 13%",
    ],
  },
  {
    h2: "Полный календарь смен лагеря на лето 2026",
    text: "Шесть заездов с конца мая по конец августа — даты и длительность смотрите в таблице выше, в стоимость входят проживание, питание, IT-программа и все активности. Отдельно по месяцам: <a href=\"/lager-na-iyun/\" class=\"text-primary hover:underline\">лагерь на июнь</a>, <a href=\"/lager-na-iyul/\" class=\"text-primary hover:underline\">лагерь на июль</a>, <a href=\"/lager-na-avgust-podmoskove/\" class=\"text-primary hover:underline\">лагерь на август</a>.",
    list: [
      `Смена 3 (открыта): ${DATES_SHORT_S3} · ${PRICE_S3} — после июльской паузы, с обновлёнными модулями`,
      `Смена 4 (открыта): ${DATES_SHORT_S4} · ${PRICE_S4} — последний заход перед школой, «добор впечатлений»`,
      "Заезды 1, 2, 2.1 и 2.2 прошли в мае и в июне — сезон 2026 стартовал ярко, отчёты смотрите в галерее"
    ]
  },
  {
    h2: "Чем лагерь на лето 2026 отличается от прошлых сезонов",
    text: "Каждый год мы смотрим на обратную связь и меняем программу. К лету 2026 обновили три блока. Первое — все IT-занятия теперь ведут AI-модули: дети учат не просто Python, а Python + Gemini/Claude для генерации помощников и ботов. Второе — хакатон стал двухдневным: сначала идея и прототип, затем доработка по фидбеку и защита. Третье — внутренняя экономика лагеря теперь включает биржу идей и коллективные инвестиции: ребята учатся не только зарабатывать валюту, но и вкладывать. Мы специально не повторяли прошлогодние проекты — если ваш ребёнок был у нас в 2024 или 2025, в 2026 он попадёт в новую программу, а не переучивать уже известное. Лагерь работает не только летом — смотрите также <a href=\"/lager-na-osennie-kanikuly/\" class=\"text-primary hover:underline\">осенний лагерь в Подмосковье</a>."
  },
  {
    h2: "Что взять ребёнку в летний лагерь — чек-лист 2026",
    text: "Ноутбук и технику привозить не нужно — всё оборудование в лагере. Нужны личные вещи и немного подготовки к отъезду.",
    list: [
      "Повседневная одежда + 1–2 комплекта запасных, лёгкая ветровка",
      "Купальник/плавки и тапочки для бассейна — обязательно",
      "Солнцезащитный крем SPF 30+, очки, лёгкая кепка",
      "Предметы личной гигиены: мыло, шампунь, зубная щётка",
      "Аптечка: личные лекарства (если есть) + что-то от простуды на всякий случай",
      "Блокнот и ручка — для записей на занятиях, многие ребята ведут дневник",
      "Хорошее настроение — гаджеты в лагере работают как внутренняя валюта, а не развлечение",
    ],
  },
  {
    h2: "Вопросы о летнем лагере 2026",
    text: "Собрали ответы на то, что чаще всего спрашивают перед первой сменой.",
    list: [
      "С какого возраста берёте? — С 7 лет. Возрастные группы: 7–9, 9–11, 11–13, 13–15 лет. Программа разная.",
      "Нужен ли опыт программирования? — Нет. Все потоки начинаются с нуля внутри возрастной группы.",
      'Что если ребёнку не понравится? — <a href="/politika-vozvrata/">Условия возврата →</a>',
      "Как часто можно звонить ребёнку? — Видеозвонок ежедневно в фиксированное время + свежие фото в чате.",
      "Есть ли трансфер из Москвы? — Да, организованный трансфер от метро Солнцево.",
      "Принимаете детей с аллергией / особым питанием? — Да, согласовываем рацион заранее.",
    ],
  },
  {
    h2: "Когда бронировать: открыты августовские смены",
    text: "Летний календарь АйДаКемп — без июля: заезды проходят в мае–июне и августе. Всё, что было в июне, уже прошло, сейчас открыт август. Планируйте заранее:",
    list: [
      "Май и июнь (заезды 1, 2, 2.1, 2.2) — уже прошли, следующий лагерь на июнь откроется в сезоне 2027",
      "Июль — пауза, это нужно знать при планировании отпуска",
      "Август (смены 3 и 4) — открыты, можно взять оба заезда подряд или выбрать один",
      "Совет: мест всё меньше — если хотите август, бронируйте сейчас"
    ]
  },
  {
    h2: "Что ждёт летом 2026: новые треки, хакатон, рекорды",
    text: "Лето 2026 — обновлённая программа. Три главных изменения по сравнению с прошлым сезоном:",
    list: [
      "Новый AI-трек: ChatGPT API + Gemini — школьники создают собственных AI-ассистентов на Python",
      "Двухдневный хакатон: первый этап — прототип и идея, второй — доработка по фидбеку и питч",
      "Рекорд программы: самый быстрый рабочий бот за смену — 2023 год побит, ставим новую планку",
      "Обновлённая внутренняя экономика лагеря: биржа идей, коллективные проекты, новые механики",
      "Если ваш ребёнок был в 2024 или 2025 — в 2026 его ждёт принципиально новая программа"
    ]
  },
  {
    h2: "Почему записываться на лето 2026 стоит сейчас, а не «ближе к сезону»",
    text: `Три причины бронировать августовский заезд заранее, а не в последний момент. Первое — после бронирования стоимость фиксируется договором и не растёт. Второе — по данным прошлых лет, популярные заезды продаются полностью задолго до старта; всё, что шло в июне 2026, уже разобрано, август закрывает сезон. Третье — при раннем бронировании мы успеваем подготовить комнаты под особенности ребёнка (аллергии, диета, желание быть с другом). В последний момент это уже «куда попадёт». Налоговый вычет 13% работает круглый год, но оформить его проще, когда договор и оплата прошли до начала учебного года.`
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский лагерь на лето 2026 — летние смены на 1 и 2 недели для детей в Подмосковье | АйДаКемп"
  description={`Детский лагерь на лето 2026 год в Подмосковье — летние IT-смены для детей на 1 и 2 недели, июнь–август, от ${PRICE_MIN}. Проживание, питание, бассейн, налоговый вычет 13%.`}
  h1="Детский лагерь на лето 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-leto-2026"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какие детские лагеря есть в Подмосковье в 2026 году?", a: `В Подмосковье работают спортивные, языковые, творческие и IT-лагеря. АйДаКемп — IT-лагерь с проживанием в Наро-Фоминском районе. Смены 2026 с 30 мая по 26 августа, для детей 7–15 лет. Открытые смены — от ${PRICE_MIN} за 10 дней.` },
    { q: "Сколько стоит летний лагерь в Подмосковье 2026?", a: `Цены детских лагерей Подмосковья в 2026 году в АйДаКемп: открытые смены от ${PRICE_MIN} за 10 дней (Смена 4) до ${PRICE_MAX} за 13 дней (Смена 3). В стоимость включены проживание, питание, IT-программа, бассейн. Налоговый вычет 13% — возврат до ${VYCHET_MAX} через ФНС.` },
    { q: "Когда открываются смены в летнем лагере в Подмосковье 2026?", a: "Смены с 30 мая по 26 августа. Регистрация открыта, бронь на 72 часа без предоплаты. Июнь — самый популярный, бронируйте заранее." },
    { q: "Можно ли получить налоговый вычет за детский лагерь в Подмосковье?", a: `Да, 13% от образовательной части путёвки. У лагеря есть лицензия Минобрнауки. Возврат до ${VYCHET_MAX} за сезон при подаче декларации в ФНС.` },
    { q: "С какого возраста берёте детей в лагерь?", a: "С 7 лет. Возрастные группы: 7–9, 9–11, 11–13, 13–15 лет — у каждой своя программа." },
    { q: "Нужен ли ребёнку опыт программирования?", a: "Нет. Все потоки начинаются с нуля внутри возрастной группы." },
    { q: "Что если ребёнку не понравится в лагере?", a: "Действуют условия возврата — подробности на странице политики возврата." },
    { q: "Как часто можно звонить ребёнку в лагере?", a: "Видеозвонок каждый день в фиксированное время, плюс ежедневные фото в чате для родителей." },
    { q: "Есть ли трансфер из Москвы до лагеря?", a: "Да, организованный трансфер от метро Солнцево." },
    { q: "Принимаете детей с аллергией или особым питанием?", a: "Да, рацион согласовываем заранее при бронировании." },
  ]} />
