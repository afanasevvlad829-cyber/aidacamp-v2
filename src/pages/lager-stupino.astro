---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Ступино до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 100 км от Ступино, примерно 1.5 часа езды. Маршрут: по М-4 «Дон» на запад → объезд → Калужское шоссе (A-101) → посёлок Атепцево. Организованный трансфер отправляется от м. Солнцево — до Солнцево из Ступино удобно добраться на электричке до Москвы."
  },
  {
    h2: "Почему родители из Ступино выбирают АйДаКемп",
    text: "Ступино — южное Подмосковье, и IT-лагерь с хорошей программой рядом найти непросто. АйДаКемп закрывает этот вопрос: лицензия Минобрнауки, рейтинг 5.0, реальные проекты на выходе. Подмосковный климат — никакой акклиматизации. Налоговый вычет 13% — документы выдаёт лагерь.",
    list: [
      "Без акклиматизации — ребёнок в привычном климате Подмосковья",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево — 2 500 ₽, из Ступино на электричке до Москвы",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ реальных отзывов"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Ступино",
    text: "Дети 7–15 лет выбирают IT-трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек — никто не теряется. Итог смены — собственный проект, который ребёнок защищает на хакатоне.",
    list: [
      "Python — программирование с нуля до телеграм-бота",
      "Scratch — визуальные игры для детей 7–10 лет",
      "Minecraft Education — создание модов и механик",
      "AI и нейросети — ChatGPT API, машинное обучение",
      "3D-моделирование — Blender, финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Ступино и юга Московской области отмечают качество программы:",
    list: [
      "«Из Ступино добираться ~1.5 часа — сначала думала, что долго. Но когда дочь вернулась с проектом на Python и рассказывала про хакатон, все сомнения пропали» — Ирина, Ступино",
      "«Сын был на смене в августе. Дорога через М-4 несложная. Главное — он занялся чем-то полезным, а не провёл лето у экрана дома» — Андрей, Ступино"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 500 ₽ в одну сторону"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Ступино 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Ступино: ~1.5 ч по М-4 → Калужское шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом со Ступино"
  canonical="https://aidacamp.ru/lager-stupino"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Ступино до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Ступино около 100 км и ~1.5 часа: по М-4 «Дон» на запад → Калужское шоссе (A-101) → посёлок Атепцево. Или доехать на электричке до Москвы и пересесть на трансфер от м. Солнцево (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Ступино до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часа на автомобиле (100 км через М-4 → Калужское шоссе). До м. Солнцево из Ступино — около часа на электричке, затем трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Ступино?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Ступино нет. Организованный трансфер отправляется от м. Солнцево (2 500 ₽). Из Ступино удобно добраться до Солнцево на электричке через Москву." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Ступино?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 500 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом со Ступино — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Ступино. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-stupino"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом со Ступино"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Ступино по М-4 → Калужское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Ступино"
    keywords={["~1.5 ч от Ступино через М-4", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом со Ступино — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
