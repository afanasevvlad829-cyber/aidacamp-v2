---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Ступино до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 100 км от Ступино, примерно 1.5 часа езды. Маршрут: по М-4 «Дон» на запад → объезд → Киевское шоссе (M-3) → посёлок Атепцево. Организованный трансфер отправляется от м. Солнцево — до Солнцево из Ступино удобно добраться на электричке до Москвы."
  },
  {
    h2: "Почему родители из Ступино выбирают АйДаКемп",
    text: "Ступино — город металлургии и авиастроения: здесь работают технические производства и живут инженерные семьи. Маршрут МЦД-2 делает путь до Москвы удобным, а оттуда до лагеря — один трансфер. Технические семьи Ступино ценят настоящие проекты, а не показные занятия.",
    list: [
      "Без акклиматизации — ребёнок в привычном климате Подмосковья",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево — 2 000 ₽, из Ступино на электричке МЦД-2 до Москвы",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ реальных отзывов"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают люди, которые искренне занимаются IT и умеют объяснять сложное простым языком. Соотношение взрослых к участникам — одно из лучших среди подмосковных лагерей.",
    list: [
      "1 преподаватель на 6–8 участников — никто не потеряется",
      "Медработник в лагере круглосуточно",
      "Ежедневные фото и видео в Telegram — видно всё, что происходит",
      "Июль 2026 занят полностью. В июне и августе места есть — записывайтесь"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Ступино",
    text: "Дети 7–15 лет выбирают IT-трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек — никто не теряется. Итог смены — собственный проект, который ребёнок защищает на хакатоне.",
    list: [
      "Python — программирование с нуля до телеграм-бота",
      "Scratch — визуальные игры для детей 7–10 лет",
      "Minecraft Education — создание модов и механик",
      "AI и нейросети — ChatGPT API, машинное обучение",
      "3D-моделирование — Blender, финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Ступино и юга Московской области отмечают качество программы:",
    list: [
      "«Из Ступино добираться ~1.5 часа — сначала думала, что долго. Но когда дочь вернулась с проектом на Python и рассказывала про хакатон, все сомнения пропали» — Ирина, Ступино",
      "«Сын был на смене в августе. Дорога через М-4 несложная. Главное — он занялся чем-то полезным, а не провёл лето у экрана дома» — Андрей, Ступино"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 99 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Маршрут из Ступино: на машине и на электричке",
    text: "Из Ступино добраться до лагеря удобнее всего на машине или через электричку до Москвы.",
    list: [
      "На машине: из Ступино по М-4 «Дон» на запад → М-24 в направлении Киевского шоссе → санаторий «Изумруд». ~100 км, ~1 ч 30 мин без пробок",
      "На электричке + трансфер: электричка из Ступино до Курского вокзала (~1 ч) → метро до м. Солнцево → трансфер АйДаКемп 2 000 ₽",
      "Что взять в дорогу: медицинские документы, список вещей от лагеря, перекус"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "В АйДаКемп едут дети из Ступино и всего юга Подмосковья:",
    list: [
      "<a href='/lager-serpuhov'>Серпухов</a> — ~70 км, ~1 ч 10 мин по Симферопольскому шоссе",
      "<a href='/lager-podolsk'>Подольск</a> — ~45 км, ~50 мин по Киевскому шоссе",
      "<a href='/lager-vidnoe'>Видное</a> — ~55 км, ~1 ч прямо по Киевскому шоссе",
      "<a href='/lager-v-podmoskove'>Все лагеря Подмосковья</a> — сравните варианты"
    ]
  },
  {
    h2: "Программа IT-лагеря: что выбирают из Ступино",
    text: "Дети из небольших городов часто выбирают Python и AI — треки, которых нет в местных кружках. За 10–14 дней погружения проходят то, на что в городских кружках уходит полгода. Финал смены — хакатон: каждый защищает проект перед другими командами. Это первый опыт публичной презентации для большинства — и он запоминается.",
    list: [
      "Python — от переменных до работающей программы или бота",
      "AI и нейросети — работа с реальными API (ChatGPT, Stable Diffusion)",
      "Minecraft Education — программирование в знакомой среде",
      "Хакатон — защита проекта в последний день смены"
    ]
  },
  {
    h2: "Первый раз вдали от дома — как подготовить ребёнка",
    text: "Для многих детей из Ступино это первый опыт жизни без родителей. Это нормально волноваться — и ребёнку, и маме. Помогает конкретный договор: «Позвоним в определённое время, если через 3 дня будет плохо — заберём». Большинство детей адаптируются за 2–3 дня, потом не хотят уезжать.",
    list: [
      "Звонки родителям по расписанию — обычно вечером",
      "Ежедневные фото в Telegram-канале отряда",
      "Медработник 24/7 на территории — первая помощь в любое время",
      "Вожатый знает каждого в группе — никто не теряется"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Ступино 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Ступино: ~1.5 ч по М-4 → Киевское шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом со Ступино"
  canonical="https://aidacamp.ru/lager-stupino"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Ступино до лагеря АйДаКемп?", a: "Из Ступино около 100 км и ~1.5 часа: по М-4 «Дон» на запад → Киевское шоссе (M-3) → посёлок Атепцево. Или доехать на электричке до Москвы и пересесть на трансфер от м. Солнцево (2 000 ₽)." },
    { q: "Сколько ехать из Ступино до лагеря?", a: "Около 1.5 часа на автомобиле (100 км через М-4 → Киевское шоссе). До м. Солнцево из Ступино — около часа на электричке, затем трансфер лагеря." },
    { q: "Есть ли трансфер из Ступино?", a: "Прямого трансфера из Ступино нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Ступино удобно добраться до Солнцево на электричке через Москву." },
    { q: "Сколько стоит путёвка в лагерь из Ступино?", a: "Смены от 48 000 ₽ (7 дней) до 99 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом со Ступино — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Ступино. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-stupino"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом со Ступино"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Ступино по М-4 → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Ступино"
    keywords={["~1.5 ч от Ступино через М-4", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом со Ступино — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
