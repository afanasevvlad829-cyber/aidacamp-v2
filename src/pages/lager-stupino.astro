---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { otzyvyLink, yandexReviewsLink } from '../lib/reviews-link';
import { SEASON_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Как добраться до АйДаКемп",
    text: `АйДаКемп — санаторий «Изумруд» в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе (~1 час). Из Ступино удобнее доехать до м. Солнцево и взять трансфер (${TRANSFER_PRICE_FMT}, ~40 мин) — сопровождающий встретит ребёнка и довезёт до детского лагеря.`,
    list: [
      "На машине: Киевское шоссе (А-101) → санаторий «Изумруд», ~66 км от МКАД",
      "С собой: медицинские документы, список вещей от организаторов, перекус"
    ]
  },
  {
    h2: "Почему местные родители выбирают АйДаКемп",
    text: "АйДаКемп — место, где ребёнок совмещает детские летние каникулы с реальным IT-проектом, а не изображает занятость. Ритм смены — с подъёма до отбоя — не даёт заскучать даже самым активным.",
    list: [
      "Без акклиматизации — привычный климат Подмосковья",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ реальных отзывов"
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "В АйДаКемп работают люди, которые искренне занимаются IT и умеют объяснять сложное простым языком. Даже в первые дни ребёнок не остаётся один — рядом вожатый и медработник.",
    list: [
      "1 преподаватель на 6–8 участников — никто не потеряется",
      "Медработник на территории круглосуточно",
      "Ежедневные фото и видео в Telegram",
      "На открытые летние смены есть места — записывайтесь заранее"
    ]
  },
  {
    h2: "IT-программа для детей",
    text: "Дети 7–15 лет выбирают IT-трек по интересу: два занятия в день по 90 минут, группы до 8 человек. Итог смены — свой проект и защита на хакатоне перед другими командами — для многих ребят это первый опыт публичного выступления.",
    list: [
      "Python — программирование с нуля до телеграм-бота",
      "Scratch — визуальные игры для детей 7–10 лет",
      "Minecraft Education — моды и механики",
      "AI и нейросети — ChatGPT API, машинное обучение",
      "3D-моделирование — Blender, 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: `Отзывы семей с юга Московской области мы не переписываем от себя — они лежат как есть: ${otzyvyLink()} на сайте и карточка на ${yandexReviewsLink()}.`,
    list: [
      "Дорога через Солнцево кажется долгой только до первой поездки — по Киевскому шоссе она несложная",
      "Хакатон в финале смены — главный сюжет рассказов дома"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены`,
    text: `Смены идут ${SEASON_MONTHS_NOM} ${SEASON_YEAR}. В стоимость включены проживание 2–4 человека с санузлом, 5-разовое питание, IT-программа, бассейн.`,
    list: [
      `Смена 2.1 (завершена): ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена): ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 3: ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4: ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону`
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "В АйДаКемп из Ступино и соседних городов приезжают ребята со всего юга Подмосковья ради детской IT-программы, которой нет дома:",
    list: [
      "<a href='/lager-serpuhov/'>Серпухов</a> — удобнее через м. Солнцево, общий трансфер",
      "<a href='/lager-podolsk/'>Подольск</a> — удобнее через м. Солнцево, общий трансфер",
      `<a href='/lager-vidnoe/'>Видное</a> — удобнее через м. Солнцево, общий трансфер (${TRANSFER_PRICE_FMT})`,
      "<a href='/lager-v-podmoskove/'>Все программы Подмосковья</a> — сравните варианты"
    ]
  },
  {
    h2: "Первый раз вдали от дома — как подготовить ребёнка",
    text: "Поездка без родителей — стресс для многих ребят, и это нормально. Помогает конкретный договор: «Позвоним в определённое время, если через 3 дня будет плохо — заберём». Большинство адаптируются за 2–3 дня.",
    list: [
      "Звонки родителям по расписанию — обычно вечером",
      "Вожатый знает каждого в группе"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский IT-лагерь рядом со Ступино ${SEASON_YEAR} | АйДаКемп`}
  description={`Детский IT-лагерь для семей из Ступино: смены ${SEASON_MONTHS_NOM}, Python, AI, Minecraft для 7–15 лет. От ${PRICE_MIN}, вычет до ${VYCHET_MAX}.`}
  h1="Детский летний лагерь рядом со Ступино"
  canonical="https://aidacamp.ru/lager-stupino"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детская IT-программа рядом со Ступино — АйДаКемп"
      description="IT-программа в Наро-Фоминском районе, ~1.5 ч отсюда. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-stupino"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский летний лагерь рядом со Ступино"
    subtitle="IT-программа в Наро-Фоминском районе — ~1.5 ч по М-4 → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Из Ступино"
    keywords={["~1.5 ч через М-4", "IT-программа: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Дети на занятии в АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как добраться и сколько ехать?", a: `Около 100 км и ~1.5 часа: по М-4 «Дон» → Киевское шоссе (M-3) → посёлок Атепцево. Прямого трансфера из Ступино нет — удобнее доехать на электричке до Москвы и пересесть на общий трансфер от м. Солнцево (${TRANSFER_PRICE_FMT}, ~40 мин).` },
    { q: "Сколько стоит путёвка?", a: `Открыты к брони августовские смены: от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} отдельно.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">IT-смены в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
