---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Фрязево до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе. Из Фрязево — около 120 км, ~1 ч 30 мин: электричка Горьковского направления → Курский вокзал → метро до м. Солнцево → организованный трансфер АйДаКемп. На машине: Горьковское шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево."
  },
  {
    h2: "Фрязино рядом — технические семьи выбирают IT-лагерь",
    text: "Фрязево стоит рядом с наукоградом Фрязино — здесь работают ФТИ и НПО «Исток». Многие родители из этих мест сами связаны с IT и точными науками. Для них важно, чтобы летний лагерь давал не просто отдых, а настоящий проект. В АйДаКемп ребята не просто «учатся программированию» — в конце каждой смены защищают собственный проект на хакатоне.",
    list: [
      "Практикующие IT-специалисты, авторы учебника по программированию",
      "Занятия дважды в день по 90 минут, группы до 8 человек",
      "Итоговый хакатон — защита проекта перед всем лагерем",
      "Треки: Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 ребят — каждый получает внимание. Медработник дежурит на территории круглосуточно. Родители получают фото и видео из лагеря в Telegram-чат отряда каждый день.",
    list: [
      "Соотношение 1 преподаватель : 6–8 участников",
      "Медработник 24/7, охрана, закрытая территория санатория",
      "Ежедневные фото в Telegram — видно, чем занимается ваш ребёнок",
      `Лицензия Минобрнауки, документы для налогового вычета до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены раскупают первыми — они самые популярные по погоде и расписанию. В июне и августе места ещё открыты. Если хотите определённые даты — лучше бронировать сейчас.",
    list: [
      `Смена 2.1 — ${DATES_SHORT_S21}, 7 дней, ${PRICE_MIN}`,
      `Смена 2 — ${DATES_SHORT_S2}, 14 дней, ${PRICE_MAX} (самая популярная)`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Почему семьи из Фрязево выбирают АйДаКемп",
    text: "До лагеря — около 1.5 часа. Ребёнок в Подмосковье: никакой акклиматизации, никаких перелётов. Родители, которые видели хакатон, записывают снова.",
    list: [
      "Подмосковье — привычный климат, акклиматизации нет",
      "Электричка Горьковского направления + метро до Солнцево — понятный маршрут",
      "Рейтинг 5.0 на Яндекс.Картах, 40+ отзывов от семей со всего Подмосковья",
      "Бассейн с ионизированной водой, комнаты по 2–4 человека с санузлом, 5-разовое питание"
    ]
  },
  {
    h2: "Отзывы семей из востока Подмосковья",
    text: "В АйДаКемп едут ребята из Фрязево, Электростали, Ногинска и других городов востока Подмосковья:",
    list: [
      "«Электричка до Курского, метро до Солнцево — и всё, пересадила в автобус. Дочь вернулась с проектом и новыми друзьями из Подмосковья» — Людмила, Фрязево",
      "«Сын теперь дома сам учит Python. Говорит, что в лагере понял — это интереснее, чем игры» — Сергей, Ногинск"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь рядом с Фрязево 2026 — IT | АйДаКемп"
  description={`Детский IT-лагерь рядом с Фрязево — ~1.5 ч через Горьковское шоссе → МКАД → Киевское. Python, AI, Minecraft для ребят 7–15 лет. От ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Фрязево"
  canonical="https://aidacamp.ru/lager-fryazevo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Фрязево до лагеря АйДаКемп?", a: "Из Фрязево до лагеря около 120 км, ~1.5 часа: электричка Горьковского направления до Курского вокзала, затем метро до м. Солнцево и трансфер АйДаКемп (2 000 ₽). На машине: Горьковское шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево." },
    { q: "Есть ли трансфер из Фрязево?", a: "Прямого трансфера из Фрязево нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Фрязево удобно добраться электричкой до Курского вокзала, затем на метро до Солнцево." },
    { q: "Нужен ли опыт программирования для поступления в лагерь?", a: "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, каждый получает внимание преподавателя." },
    { q: "Сколько стоит путёвка в лагерь из Фрязево?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Фрязево — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Фрязево. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-fryazevo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Фрязево"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Фрязево через МКАД → Киевское шоссе. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Фрязево"
    keywords={["~1.5 ч из Фрязево через МКАД → Киевское шоссе", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Фрязево — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
