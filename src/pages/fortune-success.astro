---
export const prerender = false;
import Base from '../layouts/Base.astro';

const url    = Astro.url;
const disc   = url.searchParams.get('disc')  ?? '?';
const dep    = url.searchParams.get('dep')   ?? '';
const order  = url.searchParams.get('order') ?? '';

const depFmt = dep ? parseInt(dep).toLocaleString('ru-RU') + ' ₽' : '';
---

<Base title="Оплата принята — АйДаКемп" description="Предоплата за путёвку принята">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-b from-green-50 to-white px-4 py-16">
    <div class="w-full max-w-md text-center">

      <!-- Icon -->
      <div class="mb-6 flex justify-center">
        <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center">
          <i class="bi bi-check-circle-fill text-green-500 text-[44px]" aria-hidden="true"></i>
        </div>
      </div>

      <h1 class="text-[28px] font-extrabold text-gray-900 mb-2">Оплата принята!</h1>
      <p class="text-gray-500 text-[15px] mb-8">
        Предоплата{depFmt ? ` ${depFmt}` : ''} прошла успешно.
        {disc !== '?' && <span> Ваша скидка <strong class="text-green-600">{disc}%</strong> зафиксирована.</span>}
      </p>

      <!-- Info card -->
      <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-6 text-left space-y-4 mb-8">

        <div class="flex gap-3">
          <i class="bi bi-calendar-check text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-[14px]">Остаток стоимости</p>
            <p class="text-[13px] text-gray-500">Оплатите оставшиеся 50% до конца сегодняшнего дня любым удобным способом.</p>
          </div>
        </div>

        <div class="flex gap-3">
          <i class="bi bi-telephone-fill text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-[14px]">Ждите звонка</p>
            <p class="text-[13px] text-gray-500">Мы позвоним в течение 30 минут, чтобы подтвердить бронирование и ответить на вопросы.</p>
          </div>
        </div>

        <div class="flex gap-3">
          <i class="bi bi-envelope text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-[14px]">Квитанция на email</p>
            <p class="text-[13px] text-gray-500">Чек придёт на почту, указанную при оплате. Также можно написать нам в Telegram.</p>
          </div>
        </div>

      </div>

      {order && (
        <p class="text-[11px] text-gray-400 mb-6">Номер заказа: {order}</p>
      )}

      <!-- Actions -->
      <div class="space-y-3">
        <a href="https://t.me/AidaCampDarya"
           class="flex items-center justify-center gap-2 rounded-xl bg-[#229ED9] hover:bg-[#1a8cbf] py-3 font-bold text-white text-[14px] transition-colors no-underline">
          <i class="bi bi-telegram text-[16px]" aria-hidden="true"></i>
          Написать в Telegram
        </a>
        <a href="/"
           class="flex items-center justify-center gap-2 rounded-xl border border-gray-200 py-3 font-semibold text-gray-600 text-[14px] hover:bg-gray-50 transition-colors no-underline">
          На главную
        </a>
      </div>

    </div>
  </main>
</Base>
