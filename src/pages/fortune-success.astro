---
export const prerender = true;
import Base from '../layouts/Base.astro';
---

<Base title="Оплата принята — АйДаКемп" description="Предоплата за путёвку принята">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-b from-green-50 to-white px-4 py-16">
    <div class="w-full max-w-md text-center">

      <div class="mb-6 flex justify-center">
        <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center">
          <i class="bi bi-check-circle-fill text-green-500 text-[44px]" aria-hidden="true"></i>
        </div>
      </div>

      <h1 class="text-[28px] font-extrabold text-gray-900 mb-2">Оплата принята!</h1>
      <p id="fs-subtitle" class="text-gray-500 text-base mb-8">
        Предоплата прошла успешно. Скидка зафиксирована.
      </p>

      <div class="rounded-2xl bg-white border border-gray-200 shadow-sm p-6 text-left space-y-4 mb-8">

        <div class="flex gap-3">
          <i class="bi bi-telephone-fill text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-base">В течение 30 минут позвонит представитель</p>
            <p class="text-base text-gray-500">Подтвердим бронирование и ответим на вопросы.</p>
          </div>
        </div>

        <div class="flex gap-3">
          <i class="bi bi-file-earmark-text text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-base">Договор — до конца рабочего дня</p>
            <p class="text-base text-gray-500">Пришлём договор оферты для подписания.</p>
          </div>
        </div>

        <div class="flex gap-3">
          <i class="bi bi-cash-coin text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-base">Остаток 50% — до дня заезда (30 мая)</p>
            <p class="text-base text-gray-500">Оплатите оставшиеся 50% любым удобным способом.</p>
          </div>
        </div>

        <div class="flex gap-3">
          <i class="bi bi-geo-alt text-orange-500 text-[20px] mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-gray-800 text-base">Заехать можно до 1 июня</p>
            <p class="text-base text-gray-500">Успеете собрать справки. Трансфер оплачивается отдельно.</p>
          </div>
        </div>

      </div>

      <p id="fs-order" class="hidden text-[11px] text-gray-400 mb-6"></p>

      <div class="space-y-3">
        <a href="https://t.me/Progaschool"
           class="flex items-center justify-center gap-2 rounded-xl bg-[#229ED9] hover:bg-[#1a8cbf] py-3 font-bold text-white text-base transition-colors no-underline">
          <i class="bi bi-telegram text-[16px]" aria-hidden="true"></i>
          Написать в Telegram
        </a>
        <a href="/"
           class="flex items-center justify-center gap-2 rounded-xl border border-gray-200 py-3 font-semibold text-gray-600 text-base hover:bg-gray-50 transition-colors no-underline">
          На главную
        </a>
      </div>

    </div>
  </main>

  <script>
    var p = new URLSearchParams(window.location.search);
    var disc = p.get('disc');
    var dep  = p.get('dep');
    var order = p.get('order');

    if (disc || dep) {
      var sub = document.getElementById('fs-subtitle');
      if (sub) {
        var depFmt = dep ? parseInt(dep).toLocaleString('ru-RU') + ' ₽' : '';
        sub.textContent = (depFmt ? 'Предоплата ' + depFmt + ' прошла успешно.' : 'Предоплата прошла успешно.')
          + (disc ? ' Ваша скидка ' + disc + '% зафиксирована.' : '');
      }
    }
    if (order) {
      var el = document.getElementById('fs-order');
      if (el) { el.textContent = 'Номер заказа: ' + order; el.classList.remove('hidden'); }
    }
  </script>
</Base>
