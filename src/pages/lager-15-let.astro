---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для 15 лет: FastAPI, Telegram-боты и fullstack-проект",
    text: "Самый продвинутый трек в АйДаКемп. Подростки 13–15 лет здесь уже не «знакомятся с IT» — они строят настоящие продукты. FastAPI на Python — создание REST API. Telegram-боты с базой данных и авторизацией. Fullstack: и бэкенд, и фронтенд в одном проекте. В финале — питч инвесторам: подростки представляют проект жюри из IT-специалистов и объясняют, зачем это нужно рынку.",
    list: [
      "FastAPI (Python): создаём REST API — настоящий бэкенд",
      "Telegram-боты с базой данных: авторизация, хранение данных, команды",
      "Fullstack-проект: бэкенд + фронтенд в связке",
      "ChatGPT API / Gemini API — AI под капотом продукта",
      "Питч инвесторам в финале — защита перед IT-жюри"
    ]
  },
  {
    h2: "Типичный проект пятнадцатилетки: что он создаст за смену",
    text: "Каждый подросток в АйДаКемп заканчивает смену защитой проекта. Для 13–15-летних это уже не учебные задания — это реальные продукты с деплоем:",
    list: [
      "Веб-приложение или API с деплоем на сервер — открывается по ссылке",
      "AI-ассистент с ChatGPT API: отвечает на вопросы по заданной теме",
      "Telegram-бот с базой данных: регистрация, хранение данных, команды",
      "Парсер или скрипт автоматизации — решает реальную задачу",
      "Всё выложено на GitHub — можно добавить в резюме или анкету вуза"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про 15-летних в IT-лагере:",
    list: [
      "«В 15 лет не поздно начать с нуля?» — Не поздно. В 15 лет подросток учится быстрее, чем в 10: лучше концентрация и абстрактное мышление. За интенсивную смену старшие делают проекты, которые у младших заняли бы год кружка.",
      "«Нужен ли опыт программирования?» — Базовый Python желателен. Если нет — первые 2–3 дня программа ускоренная, потом темп выравнивается.",
      "«Это не слишком сложно?» — FastAPI объясняется через практику: подросток сразу делает работающий API, а не читает теорию. Сложно и интересно — это одно и то же.",
      "«Вожатые рядом?» — Соотношение 1:8. Медработник 24/7. Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Почему 15 лет — не поздно начать IT",
    text: "«Уже поздно» — главный страх родителей. Он неверный. В 15 лет подросток обучается быстрее, чем в 10: лучше концентрация, сильнее абстрактное мышление, понятна мотивация. За одну интенсивную смену старшие подростки делают проекты, которые у младших заняли бы год.",
    list: [
      "Взрослое мышление → сложные архитектурные задачи усваиваются за дни",
      "Понятная мотивация: портфолио, поступление, деньги — это работает",
      "Среда равных: рядом такие же 13–15-летние, не «малышня»",
      "Реальный проект с GitHub → уже есть что показать на собеседовании"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Для подростков 13–15 лет предусмотрено больше свободного времени и самостоятельности — это не детский лагерь с построениями, а интенсив с живым общением.",
    list: [
      "Соотношение вожатых 1:8",
      "Медик 24/7, страховка включена",
      "Telegram-фото из отряда ежедневно",
      "Закрытый бассейн — ежедневно по расписанию",
      "Питание 5 раз в день — полноценное меню"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для подростков 13–15 лет лучший результат — на смене от 10 дней. За 7 дней успеваем базу и проект; за 13–14 дней — разработку с нуля до деплоя и питча. Рекомендуем смену 3 или смену 2. Июль занят полностью.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (полноценный проект + деплой)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Смотрите и смежные программы — или всё сразу:",
    list: [
      "<a href='/lager-14-let'>Лагерь для 14 лет</a> — Python Advanced и ChatGPT API",
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python и AI: первые боты и API-проекты",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Лагерь 15 лет в Подмосковье 2026 | АйДаКемп"
  description="Лагерь для подростков 15 лет в Подмосковье 2026. FastAPI, Telegram-боты, fullstack-проект, питч инвесторам. Реальное портфолио. 66 км от МКАД, от 48 000 ₽."
  h1="Лагерь для подростков 15 лет — FastAPI, fullstack и питч инвесторам"
  canonical="https://aidacamp.ru/lager-15-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа в IT-лагере для подростков 15 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Подростки 13–15 лет в АйДаКемп работают с FastAPI (Python), ChatGPT API и разработкой fullstack-приложений. Итог смены — реальный проект с деплоем: веб-приложение, AI-ассистент или Telegram-бот с базой данных, выложенный на GitHub. Финал — питч инвесторам." }
        },
        {
          "@type": "Question",
          "name": "В 15 лет не поздно начать программирование с нуля?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не поздно. В 15 лет подросток учится быстрее, чем в 10: лучше концентрация и абстрактное мышление. За интенсивную смену в АйДаКемп старшие подростки делают проекты, которые у младших заняли бы год кружка." }
        },
        {
          "@type": "Question",
          "name": "Что будет в портфолио после смены?",
          "acceptedAnswer": { "@type": "Answer", "text": "Реальный проект на GitHub: веб-приложение с деплоем на FastAPI, AI-ассистент с ChatGPT API или Telegram-бот с базой данных. Это не учебная работа — это то, что открывается по ссылке и можно показать на собеседовании или в анкете вуза." }
        },
        {
          "@type": "Question",
          "name": "Есть ли места в июле?",
          "acceptedAnswer": { "@type": "Answer", "text": "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для подростков 15 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (смена 2.1, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание 5 раз, IT-занятия, бассейн. Доступен налоговый вычет 13%, до 5 434 ₽ возврата." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 15 лет — FastAPI, fullstack и питч инвесторам"
    subtitle="Самый продвинутый трек. FastAPI + ChatGPT API. За 10–14 дней делают то, на что кружок тратит год. С проектом на GitHub и питчем перед IT-жюри."
    breadcrumb="Лагерь для подростков 15 лет"
    keywords={["FastAPI + ChatGPT API + fullstack-проект", "Питч инвесторам в финале смены", "Портфолио на GitHub — не кружок, а интенсив"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Лагерь для подростков 15 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
