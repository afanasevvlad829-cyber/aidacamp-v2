---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для подростков 15 лет: Python Advanced и AI",
    text: "В 15 лет большинство подростков уже не хотят «знакомиться с IT» — им нужен реальный результат. Старшая группа (13–15 лет) в АйДаКемп работает с Python Advanced, ChatGPT API и разработкой приложений. Здесь нет упрощений: настоящий стек, настоящие задачи.",
    list: [
      "Python Advanced: классы, ООП, работа с API и базами данных",
      "ChatGPT API: интеграция нейросетей в собственные приложения",
      "Разработка веб-приложений: Flask/FastAPI, деплой на сервер",
      "AI-проект в портфолио: что-то реальное, не «hello world»",
      "Командная разработка: разделение ролей, code review, Git"
    ]
  },
  {
    h2: "Почему 15 лет — не поздно начать IT",
    text: "«Уже поздно» — главный страх родителей. Он неверный. В 15 лет подросток обучается быстрее, чем в 10: лучше концентрация, сильнее абстрактное мышление, понятна мотивация. За одну интенсивную смену в АйДаКемп старшие подростки делают проекты, которые у младших заняли бы год.",
    list: [
      "Взрослое мышление → сложные архитектурные задачи усваиваются за дни",
      "Понятная мотивация: портфолио, поступление, деньги — это работает",
      "Среда равных: рядом такие же 13–15-летние, не «малышня»",
      "Интенсив вместо «кружка»: за 10–14 дней — то, что кружок даёт за год",
      "Реальный проект с GitHub → уже есть что показать на собеседовании"
    ]
  },
  {
    h2: "Проект в портфолио после смены",
    text: "Каждый подросток в АйДаКемп заканчивает смену защитой проекта. Для 13–15-летних это уже не учебные задания — это реальные продукты:",
    list: [
      "Веб-приложение или API с деплоем на сервер — открывается по ссылке",
      "AI-ассистент с ChatGPT API: отвечает на вопросы по заданной теме",
      "Telegram-бот с базой данных: регистрация, хранение данных, команды",
      "Парсер или скрипт автоматизации — решает реальную задачу",
      "Всё выложено на GitHub — можно добавить в резюме или анкету вуза"
    ]
  },
  {
    h2: "Условия для подростков",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Для подростков 13–15 лет предусмотрено больше свободного времени и самостоятельности — это не детский лагерь с построениями, а интенсив с живым общением.",
    list: [
      "Закрытый бассейн — ежедневно, по расписанию",
      "Питание 5 раз в день — полноценное меню без столовских компромиссов",
      "Медик 24/7, страховка включена",
      "Небольшие группы — педагог работает с каждым, а не с классом",
      "Ежедневные фото в чате — родители видят как идут дела"
    ]
  },
  {
    h2: "Смены 2026 для подростков 15 лет",
    text: "Для подростков 13–15 лет лучший результат — на смене от 10 дней. За 7 дней успеваем базу и проект; за 13–14 дней — разработку с нуля до деплоя. Рекомендуем смену 3 или смену 2.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (полноценный проект + деплой)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Налоговый вычет 13% — до 5 434 ₽ возврата от ФНС"
    ]
  },
  {
    h2: "Чем 15-летние отличаются от других групп",
    text: "Группа 13–15 лет — самый серьёзный трек. Подростки работают над реальным продуктом с первого дня: выбирают идею, делят роли, пишут код, делают code review. Педагог выступает как tech lead, а не как учитель. Это ближе к стажировке, чем к кружку.",
    list: [
      "Темп — высокий: 2 сессии по 90 минут + вечерний спринт по желанию",
      "Сложность — Python advanced: ООП, деплой, Git, работа с API и базами данных",
      "Формат — команда из 2–4 человек, собственная идея, публичная защита на хакатоне",
      "Результат — проект на GitHub с деплоем: открывается по ссылке, видно всем"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Смотрите и смежные программы — или всё сразу:",
    list: [
      "<a href='/lager-14-let'>Лагерь для подростков 14 лет</a> — Python Advanced и ChatGPT API",
      "<a href='/lager-12-let'>Лагерь для детей 12 лет</a> — Python и AI: первые боты и API-проекты",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для детей</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Лагерь 15 лет в Подмосковье 2026 | АйДаКемп"
  description="Лагерь для подростков 15 лет в Подмосковье 2026. Python Advanced, ChatGPT API, реальный проект в портфолио. 66 км от МКАД, от 48 000 ₽."
  h1="Лагерь для подростков 15 лет — Python Advanced и AI"
  canonical="https://aidacamp.ru/lager-15-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа в IT-лагере для подростков 15 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Подростки 13–15 лет в АйДаКемп работают с Python Advanced, ChatGPT API и разработкой приложений. Итог смены — реальный проект: веб-приложение, AI-ассистент или Telegram-бот с базой данных, выложенный на GitHub." }
        },
        {
          "@type": "Question",
          "name": "В 15 лет не поздно начать программирование с нуля?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не поздно. В 15 лет подросток учится быстрее, чем в 10: лучше концентрация и абстрактное мышление. За интенсивную смену в АйДаКемп старшие подростки делают проекты, которые у младших заняли бы год кружка." }
        },
        {
          "@type": "Question",
          "name": "Что будет в портфолио после смены?",
          "acceptedAnswer": { "@type": "Answer", "text": "Реальный проект на GitHub: веб-приложение с деплоем, AI-ассистент с ChatGPT API или Telegram-бот с базой данных. Это не учебная работа — это то, что открывается по ссылке и можно показать на собеседовании или в анкете вуза." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для подростков 15 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (смена 2.1, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание 5 раз, IT-занятия, бассейн. Доступен налоговый вычет 13%, до 5 434 ₽ возврата." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 15 лет — реальный AI-проект в портфолио"
    subtitle="Python Advanced + ChatGPT API. Не кружок — интенсив. За 10–14 дней делают то, на что кружок тратит год. С проектом на GitHub."
    breadcrumb="Лагерь для подростков 15 лет"
    keywords={["Python Advanced + ChatGPT API", "Проект в портфолио на GitHub", "Не поздно начать в 15"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Лагерь для подростков 15 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
