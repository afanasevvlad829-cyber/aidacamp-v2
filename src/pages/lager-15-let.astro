---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Программа для 15 лет: FastAPI + Telegram-боты + fullstack + pitch инвесторам",
    text: "В 15 лет подросткам не нужно «знакомство с IT» — им нужен реальный стек и реальный результат. Старшая группа (13–15 лет) в АйДаКемп работает с FastAPI (Python-фреймворк для REST API), Telegram-ботами с базами данных, HTML/CSS/JS на фронте. Финал смены — pitch инвесторам: команды защищают продукт перед опытными техническими экспертами и отвечают на жёсткие вопросы.",
    list: [
      "FastAPI: REST API с эндпоинтами, авторизация, база данных SQLite",
      "Telegram-боты с БД: регистрация, хранение данных, команды, webhook-деплой",
      "Fullstack: HTML/CSS/JS фронт подключается к FastAPI-бэку",
      "ChatGPT API: AI-функциональность в бэкенде — умные ответы, генерация контента",
      "Pitch инвесторам: команда защищает продукт перед жюри, объясняет бизнес-ценность"
    ]
  },
  {
    h2: "Типичный проект пятнадцатилетки: что он создаст за смену",
    text: "За смену подросток 15 лет делает полноценный веб-сервис или Telegram-бота с деплоем. Не макет — продукт, который открывается по ссылке из любой точки мира. На финальном pitch перед жюри команда за 7 минут объясняет проблему, решение, архитектуру и отвечает на вопросы. Это ближе к стажировке, чем к кружку.",
    list: [
      "FastAPI-сервис с деплоем: REST API открывается по URL, работает 24/7",
      "Telegram-бот с БД: пользователи регистрируются, данные сохраняются, логика работает",
      "Или fullstack: фронт на HTML/CSS/JS + бэк на FastAPI + AI от ChatGPT",
      "Pitch инвесторам: 7 минут выступления + Q&A от жюри по архитектуре и бизнес-логике"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про пятнадцатилеток в IT-лагере:",
    list: [
      "«В 15 лет не поздно начать с нуля?» — Не поздно. В 15 лет подросток учится быстрее, чем в 10: лучше концентрация и абстрактное мышление. За интенсивную смену старшие подростки делают проекты, которые у младших заняли бы год кружка.",
      "«FastAPI и fullstack — не слишком ли сложно?» — Мы используем Python, который большинство уже знает или быстро осваивает. FastAPI — минималистичный фреймворк, несколько строк — и API работает. Педагог выступает как tech lead, объясняет архитектурные решения.",
      "«Что если не успеет за смену?» — Темп высокий, но педагог ставит реалистичные задачи. Финал — защита того, что успели. Код на GitHub, деплой — как получится. Важен опыт, а не идеальный продукт.",
      "«Как устроен день?» — Вожатый рядом 24/7, соотношение 1:8. Две сессии по 90 минут плюс вечерняя работа над проектом по желанию. Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с подростками 13–15 лет. Соотношение — 1 вожатый на 8 подростков. На территории дежурит медработник 24/7. Telegram-чат отряда: родители видят фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый подросток в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для пятнадцатилеток лучший результат — на смене от 10 дней. За 7 дней успеваем базу и проект; за 13–14 дней — разработку с нуля до деплоя с публичным питчем. Рекомендуем смену 3 или смену 2. Июль традиционно заполняется первым.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX} (полноценный fullstack-проект + деплой)`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Чем 15-летние отличаются от других групп",
    text: "Группа 13–15 лет — самый серьёзный трек. Подростки работают над реальным продуктом с первого дня: выбирают идею, делят роли, пишут код, делают code review. Педагог выступает как tech lead, а не как учитель. Это ближе к стажировке, чем к кружку.",
    list: [
      "Темп — высокий: 2 сессии по 90 минут + вечерний спринт по желанию",
      "Сложность — FastAPI, fullstack, деплой, Git, работа с API и базами данных",
      "Формат — команда из 2–4 человек, собственная идея, pitch перед жюри",
      "Результат — проект на GitHub с деплоем: открывается по ссылке, видно всем"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Смотрите и смежные программы — или всё сразу:",
    list: [
      "<a href='/lager-14-let'>Лагерь для подростков 14 лет</a> — Python Advanced + ChatGPT API + Unity/C# + AI startup pitch",
      "<a href='/lager-12-let'>Лагерь для подростков 12 лет</a> — Python и AI: Gemini API, боты, моддинг",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Лагерь 15 лет в Подмосковье 2026 | АйДаКемп"
  description={`Лагерь для подростков 15 лет в Подмосковье 2026. FastAPI + Telegram-боты + fullstack + pitch инвесторам. Реальный проект с деплоем. Вожатый 1:8. От ${PRICE_MIN}.`}
  h1="Лагерь для подростков 15 лет — FastAPI, fullstack и AI"
  canonical="https://aidacamp.ru/lager-15-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа в IT-лагере для подростков 15 лет?", a: "Подростки 13–15 лет в АйДаКемп работают с FastAPI (Python REST API), Telegram-ботами с базами данных, HTML/CSS/JS фронтом и ChatGPT API. Итог смены — реальный сервис с деплоем и pitch перед жюри: 7 минут защиты продукта + Q&A по архитектуре." },
    { q: "В 15 лет не поздно начать программирование с нуля?", a: "Не поздно. В 15 лет подросток учится быстрее, чем в 10: лучше концентрация и абстрактное мышление. За интенсивную смену в АйДаКемп старшие подростки делают проекты, которые у младших заняли бы год кружка." },
    { q: "Что будет в портфолио после смены?", a: "Реальный проект с деплоем на GitHub: FastAPI-сервис или Telegram-бот с базой данных, открывающийся по ссылке. Плюс опыт публичного питча перед жюри. Это то, что можно показать на собеседовании или в анкете вуза." },
    { q: "Есть ли места в июле?", a: "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." },
    { q: "Сколько стоит лагерь для подростков 15 лет?", a: `От ${PRICE_MIN} за смену 7 дней (смена 2.1, 10–16 июня 2026). Смены 10–14 дней — от ${PRICE_S4}. В стоимость входит всё: проживание, питание 5 раз, IT-занятия, бассейн. Доступен налоговый вычет 13%, до ${VYCHET_MAX} возврата.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 15 лет — FastAPI, fullstack и pitch инвесторам"
    subtitle="Не кружок — интенсив. FastAPI + Telegram-боты + fullstack + ChatGPT API. Проект с деплоем и питч перед жюри."
    breadcrumb="Лагерь для подростков 15 лет"
    keywords={["FastAPI + fullstack + ChatGPT API", "Вожатый 1:8, медработник 24/7", "Pitch инвесторам на финале смены"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Лагерь для подростков 15 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-[14px] text-slate-500">
    <a href="/lager-14-let/" class="text-primary underline underline-offset-2">← Лагерь для 14 лет</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
