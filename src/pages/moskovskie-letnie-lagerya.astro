---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, STAT_LICENSE, STAT_RATING, STAT_RTO } from '../data/contacts';
import { shiftLinkHtml } from '../lib/shift-link';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: `Московские летние лагеря ${SEASON_YEAR} — какие форматы существуют`,
    text: "В Москве и ближнем Подмосковье работает несколько типов летних лагерей. Городские дневные — ребёнок приходит утром и уходит вечером, живёт дома. Загородные с проживанием — уезжает на неделю или две и возвращается с результатом. АйДаКемп — второй формат: загородный IT-лагерь в 66 км от МКАД, в Наро-Фоминском округе Подмосковья. Подробное сравнение форматов — в разделе ниже."
  },
  {
    h2: "АйДаКемп — московский летний лагерь рядом с городом",
    text: "Нас выбирают семьи из всех округов Москвы. Детский IT-лагерь стоит в западном Подмосковье, Киевское шоссе. Санаторий «Изумруд», Наро-Фоминский городской округ, координаты 55.265643, 36.724185. До ближайшего района Москвы (ТиНАО, Солнцево) — 25–40 минут без пробок.",
    list: [
      "Трансфер из Москвы от м. Солнцево — 2 000 ₽ в одну сторону",
      "На машине по Киевскому шоссе (М-3): 66 км от МКАД, 50–70 минут",
      "ТиНАО (Троицк, Внуково, Коммунарка) — 25–40 минут прямой путь",
      "ЮЗАО (Солнцево, Ясенево, Бутово) — 40–55 минут",
      "ЗАО (Очаково, Никулино) — 45–60 минут",
      "ЦАО и остальные округа — 60–90 минут через МКАД"
    ]
  },
  {
    h2: "Чем московский летний лагерь с IT-программой отличается от других",
    text: "2 занятия по 90 минут ежедневно, авторская программа, финальный хакатон. Каждый уезжает с IT-проектом — ботом, игрой, сайтом или AI-приложением.",
    list: [
      "Python и AI — практика с нуля до рабочего проекта",
      "Minecraft Education — программирование через игру для 7–11 лет",
      "Roblox Studio + Lua — создание 3D-игр для 9–13 лет",
      "3D-моделирование в Blender — первая модель за смену",
      "Хакатон в финале — каждый ребёнок защищает свой проект перед командой"
    ]
  },
  {
    h2: `Смены лета ${SEASON_YEAR} — даты и цены для московских семей`,
    text: `Сезон ${SEASON_YEAR} шёл с мая по август. Июньские смены уже прошли — к записи открыты две августовские, от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Каждая смена включает полную IT-программу, проживание, 5-разовое питание и бассейн.`,
    list: [
      `${shiftLinkHtml('shift-2-1', 'Смена 2.1 (завершена)')} — 7 дней, ${DATES_SHORT_S21} — <b>${PRICE_S21}</b>`,
      `${shiftLinkHtml('shift-1', 'Смена 1 (завершена)')} — 10 дней, ${DATES_S1} — <b>${PRICE_S1}</b>`,
      `${shiftLinkHtml('shift-2-2', 'Смена 2.2 (завершена)')} — 8 дней, ${DATES_SHORT_S22} — <b>${PRICE_S22}</b>`,
      `${shiftLinkHtml('shift-2', 'Смена 2 (завершена)')} — 14 дней, ${DATES_SHORT_S2} — <b>${PRICE_S2}</b> (была самой популярной)`,
      `${shiftLinkHtml('shift-3', 'Смена 3')} — 13 дней, ${DATES_SHORT_S3} — <b>${PRICE_S3}</b> (места есть)`,
      `${shiftLinkHtml('shift-4', 'Смена 4')} — 10 дней, ${DATES_SHORT_S4} — <b>${PRICE_S4}</b> (места есть)`
    ]
  },
  {
    h2: "Как добраться из Москвы в АйДаКемп — все варианты",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория санатория «Изумруд». Три способа добраться из Москвы.",
    list: [
      "<b>Организованный трансфер</b> — автобус от м. Солнцево в день заезда, 2 000 ₽, 40–60 минут",
      "<b>Своя машина</b> — М-3 Киевское шоссе на юго-запад, 66 км от МКАД, парковка у лагеря",
      "<b>Электричка + такси</b> — до Нары или Апрелевки, затем такси 20–30 минут",
      "Ориентир для навигатора: «Санаторий Изумруд, Наро-Фоминский округ» или координаты 55.265643, 36.724185",
      "Трансфер удобнее всего для жителей ЮЗАО и ЗАО — садитесь прямо у метро"
    ]
  },
  {
    h2: "Топ-5 летних лагерей Подмосковья для московских детей — чем они отличаются",
    text: "Честное сравнение форматов, между которыми выбирают московские семьи.",
    list: [
      "<b>Языковые лагеря</b> — фокус на английский, но IT-навык не формируется",
      "<b>Спортивные лагеря</b> — футбол, теннис, плавание; выбирайте если цель спорт, не код",
      "<b>Общие оздоровительные</b> — режим и природа без образовательного результата",
      "<b>IT-лагеря без проживания</b> — городские, без полного погружения и новых друзей",
      `<b>АйДаКемп</b> — загородный IT-лагерь с проживанием: проект за смену, хакатон, бассейн, 66 км от Москвы. Рейтинг ${STAT_RATING} на Яндекс.Картах, реестровый туроператор РТО ${STAT_RTO} — отзывы и документы проверяемы`
    ]
  },
  {
    h2: "Что получает ребёнок из Москвы в летнем лагере",
    text: "Детский лагерь в Подмосковье — это две недели без гаджетов и привычного уклада, которые невозможно воспроизвести в городе.",
    list: [
      "Цифровой детокс — телефон сдаётся, зарабатывается активностями. Нервная система «выдыхает»",
      "Хвойно-лиственный лес, чистый воздух — в 10 раз больше кислорода, чем в московском парке",
      "Новые друзья вне школьного круга — из разных районов Москвы и регионов",
      "IT-проект с нуля до результата — за смену то, что онлайн-кружок даёт за 3 месяца",
      "Первый опыт самостоятельной жизни — возвращаются другими"
    ]
  },
  {
    h2: "Летний лагерь рядом с Москвой — ответы на вопросы родителей",
    text: "Собрали вопросы, которые задают родители из Москвы перед первой сменой.",
    list: [
      "<b>Подходит ли ребёнку без опыта программирования?</b> — Да, все группы начинают с нуля",
      "<b>Из каких районов Москвы удобнее всего?</b> — Из ЮЗАО и ЗАО: 40–55 минут по Киевскому шоссе",
      "<b>Есть ли трансфер из центра Москвы?</b> — Из ЦАО удобнее доехать до м. Солнцево и сесть на автобус",
      "<b>Можно ли навестить ребёнка?</b> — Да, родительский день в каждой смене",
      "<b>Как часто можно звонить?</b> — Видеозвонок ежедневно в фиксированное время + фото в родительском чате",
      '<b>Гарантия возврата?</b> — <a href="/politika-vozvrata/">Условия возврата →</a>'
    ]
  },
  {
    h2: "Налоговый вычет 13% — московские родители используют его чаще всего",
    text: `АйДаКемп работает по образовательной лицензии Минобрнауки (${STAT_LICENSE}), поэтому часть стоимости путёвки — образовательная услуга, за которую возвращается 13%. Право на вычет есть у любого работающего родителя, который платит НДФЛ.`,
    list: [
      `10 дней (${PRICE_S4}) → вычет ~${VYCHET_S4}`,
      `13 дней (${PRICE_S3}) → вычет ~${VYCHET_S3}`,
      `максимум по сезону — до ${VYCHET_MAX}`,
      "Документы для вычета выдаём автоматически вместе с договором",
      "Оформляется через налоговую или напрямую через работодателя"
    ]
  },
  {
    h2: `Актуальность мест`,
    text: "Уточните наличие мест по нужным датам при оформлении заявки — состав открытых смен и загрузка меняются."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-moskve.avif"
  title={`Московские детские летние лагеря ${SEASON_YEAR} — смены АйДаКемп, 66 км от МКАД`}
  description={`Московские детские летние лагеря ${SEASON_YEAR}: АйДаКемп в Подмосковье, 66 км от МКАД. IT-программа, бассейн, трансфер от м. Солнцево. Летняя смена с 30 мая. От ${PRICE_MIN}.`}
  h1={`Московские летние лагеря ${SEASON_YEAR}: программа и смены`}
  canonical="https://aidacamp.ru/moskovskie-letnie-lagerya/"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: `Какие московские летние лагеря работают в ${SEASON_YEAR} году?`, a: `АйДаКемп — IT-лагерь в 66 км от Москвы (Наро-Фоминский округ, Киевское шоссе). Смены с 30 мая по 26 августа ${SEASON_YEAR}. Трансфер от м. Солнцево. Программы: Python, AI, Minecraft. Лицензия Минобрнауки. От ${PRICE_MIN}.` },
    { q: "Как добраться из Москвы в летний лагерь АйДаКемп?", a: "Три варианта: трансфер от м. Солнцево (2 000 ₽, 40–60 мин), своя машина по Киевскому шоссе (66 км от МКАД, 50–70 мин), электричка до Нары + такси." },
    { q: "Из каких районов Москвы удобнее добираться в лагерь?", a: "Удобнее всего из ЮЗАО (Солнцево, Ясенево, Бутово) и ЗАО — 40–55 минут. ТиНАО (Троицк, Внуково) — 25–40 минут. Из ЦАО — 60–70 минут." },
    { q: "Сколько стоит московский летний лагерь АйДаКемп?", a: `Открытые августовские смены — от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. В стоимость включены проживание, 5-разовое питание, IT-программа, бассейн. Налоговый вычет 13% — до ${VYCHET_MAX}.` },
    { q: "Нужен ли опыт программирования для летнего лагеря?", a: "Нет. Все группы начинают с нуля внутри возрастной группы (7–9, 9–11, 11–13, 13–15 лет). Программа адаптируется под уровень." },
    { q: "Есть ли гарантия возврата денег за летний лагерь?", a: 'Да. Подробные условия — на странице <a href="/politika-vozvrata/">«Политика возврата»</a>.' }
  ]} />
  </Fragment>

  <LandingHero slot="hero"
    h1={`Московские летние лагеря ${SEASON_YEAR}: программа и смены`}
    subtitle={`IT-лагерь в ${STAT_DISTANCE} от Москвы — трансфер от м. Солнцево. Python, AI, Minecraft. Ребёнок возвращается с IT-проектом.`}
    breadcrumb="Московские летние лагеря"
    keywords={[
      `${STAT_DISTANCE} от МКАД по Киевскому шоссе — около часа из Москвы`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону",
      "IT-программа: Python, AI, Minecraft — проект за смену"
    ]}
    image="/images/hero/lager-v-moskve.avif"
    imageAlt="Московские летние лагеря — АйДаКемп в Подмосковье"
  />

  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте налоговый вычет для московских родителей" />
  <Gallery />
  <Shifts />
  <FAQ />

  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее: <a href="/lager-v-moskve/" class="text-primary hover:underline">летний лагерь в Москве {SEASON_YEAR}</a> —
      <a href="/lager-v-podmoskove/" class="text-primary hover:underline">лагерь в Подмосковье</a> —
      <a href="/lager-na-leto-2026/" class="text-primary hover:underline">летние лагеря Подмосковья</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
