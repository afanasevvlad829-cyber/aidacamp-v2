---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Щёлково до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 95 км от Щёлково, примерно 1.5–2 часа езды. Маршрут: по Щёлковскому шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Организованный трансфер отправляется от м. Солнцево — из Щёлково удобно доехать на автобусе от м. Щёлковская."
  },
  {
    h2: "Почему родители из Щёлково выбирают АйДаКемп",
    text: "Из Щёлково до качественного IT-лагеря с проживанием — выбор небольшой. АйДаКемп решает задачу: лицензия Минобрнауки, реальные проекты на Python и AI, рейтинг 5.0 на Яндекс.Картах. Подмосковный климат — без акклиматизации, ребёнок в привычной среде.",
    list: [
      "Без акклиматизации — Подмосковье, привычный климат",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Трансфер от м. Солнцево (2 000 ₽) — удобно из Щёлково",
      "Группы до 8 человек — индивидуальный подход к каждому ребёнку"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Щёлково",
    text: "Дети 7–15 лет выбирают IT-трек по интересу и уровню подготовки. Опыт программирования не нужен. Занятия дважды в день по 90 минут. Итог — собственный проект, который ребёнок защищает на хакатоне в последний день смены.",
    list: [
      "Python — от нуля до рабочего телеграм-бота",
      "Scratch — визуальные игры для детей 7–10 лет",
      "Minecraft Education — создание модов и игровых миров",
      "AI и нейросети — ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и 3D-печать финального проекта"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Щёлково и северо-востока Подмосковья отправляют детей в АйДаКемп:",
    list: [
      "«Из Щёлково до Солнцево — автобус и метро, несложно. Сын вернулся с AI-проектом и сразу начал объяснять мне, как работают нейросети» — Татьяна, Щёлково",
      "«Я боялась, что будет скучать без нас. Оказалось наоборот — хотела остаться на вторую смену. Отличная программа и дружный коллектив» — Людмила, Щёлково"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Маршрут из Щёлково: на машине и на общественном транспорте",
    text: "Из Щёлково добраться до лагеря можно двумя способами — зависит от того, есть ли машина.",
    list: [
      "На машине: из Щёлково по Щёлковскому шоссе → МКАД → Киевское шоссе (M-3) → санаторий «Изумруд». ~90 км, ~1 ч 30 мин без пробок",
      "На автобусе + метро + трансфер: автобус из Щёлково до м. Щёлковская → метро до м. Солнцево (~45–50 мин) → трансфер АйДаКемп 2 000 ₽",
      "Что взять: документы, список вещей от лагеря, перекус и хорошее настроение"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "В АйДаКемп едут дети из Щёлково и всего северо-востока Подмосковья:",
    list: [
      "<a href='/lager-pushkino'>Пушкино</a> — ~85 км, ~1 ч 30 мин через МКАД",
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-nogink'>Ногинск</a> — ~100 км, ~1 ч 40 мин через МКАД",
      "<a href='/lager-reutov'>Реутов</a> — ~75 км, ~1 ч 20 мин по МКАД"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Щёлково 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Щёлково: ~1.5 ч по МКАД → Киевское шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Щёлково"
  canonical="https://aidacamp.ru/lager-shchelkovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Щёлково до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Щёлково около 95 км и ~1.5–2 часа: по Щёлковскому шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или на автобусе до м. Щёлковская, затем до м. Солнцево и трансфер лагеря (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Щёлково до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часа на автомобиле (95 км через Щёлковское шоссе → МКАД → Киевское). До м. Солнцево из Щёлково — около 50 минут, затем трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Щёлково?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Щёлково нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Щёлково удобно доехать до Солнцево на автобусе или метро." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Щёлково?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Щёлково — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Щёлково. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-shchelkovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Щёлково"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Щёлково через МКАД → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Щёлково"
    keywords={["~1.5 ч от Щёлково через МКАД", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Щёлково — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
