---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "IT как следующий шаг для семей учёных из Щёлково",
    text: "Щёлково — научный город: ГосНИИОХТ, ФМБА, производства с высокотехнологичными производствами. Родители здесь понимают цену реальных знаний. Поэтому АйДаКемп — не просто лагерь, а место, где ребёнок делает настоящий проект и на хакатоне защищает его перед командой. Лицензия Минобрнауки, рейтинг 5.0."
  },
  {
    h2: "Как добраться из Щёлково до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском городском округе — 66 км от МКАД по Киевскому шоссе (~1 час без пробок). Из Щёлково: на машине через МКАД и Киевское шоссе, либо на автобусе и метро до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин).",
    list: [
      "Автобус Щёлково — м. Щёлковская: ~20–30 мин",
      "Метро от Щёлковской до м. Солнцево: ~45 мин",
      "Трансфер от м. Солнцево до лагеря: 2 000 ₽, ~40 мин",
      "66 км от МКАД по Киевскому шоссе — ~1 час без пробок"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Родители из Щёлково доверяют лагерю, где за каждым ребёнком следят профессионалы, а не волонтёры без опыта.",
    list: [
      "1 преподаватель на 6–8 ребят — индивидуальный подход к каждому",
      "Вожатые — конкурсный отбор, проходят обучение до смены",
      "Медработник круглосуточно на территории лагеря",
      "Ежедневные фото в Telegram в 21:00 — видно, чем занимался ваш ребёнок сегодня"
    ]
  },
  {
    h2: "Программа IT-лагеря для ребят из Щёлково",
    text: "Школьники 7–15 лет выбирают IT-трек по интересу и уровню подготовки. Опыт программирования не нужен. Занятия дважды в день по 90 минут. Итог — собственный проект, который ребёнок защищает на хакатоне в последний день смены.",
    list: [
      "Python — от нуля до рабочего телеграм-бота",
      "Scratch — визуальные игры для ребят 7–10 лет",
      "Minecraft Education — создание модов и игровых миров",
      "AI и нейросети — ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и 3D-печать финального проекта"
    ]
  },
  {
    h2: "Лагерь для ребят 10–12 лет — мягкая адаптация",
    text: "Младшим школьникам в АйДаКемп комфортно с первого дня: группы формируем по возрасту и уровню, а не сваливаем в одну кучу с подростками. Для ребят 10–12 лет — визуальное программирование без сложного синтаксиса и кураторы, которые рядом весь день.",
    list: [
      "Scratch и Minecraft Education — программирование через игру, без зубрёжки кода",
      "Группы по уровню: новички отдельно, опытные отдельно",
      "1 преподаватель на 6–8 ребят — никто не теряется",
      "Мягкая адаптация: вожатый помогает влиться, ежедневные фото маме в 21:00"
    ]
  },
  {
    h2: "Отзывы родителей из Щёлково",
    text: "Семьи из Щёлково и северо-востока Подмосковья отправляют ребят в АйДаКемп:",
    list: [
      "«Из Щёлково до Солнцево — автобус и метро, несложно. Сын вернулся с AI-проектом и сразу начал объяснять мне, как работают нейросети» — Татьяна, Щёлково",
      "«Я боялась, что будет скучать без нас. Оказалось наоборот — хотела остаться на вторую смену. Отличная программа и дружный коллектив» — Людмила, Щёлково"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Места на смены 2026 ещё есть — бронируйте сейчас. Цены начинаются от 48 000 ₽ за 7-дневную смену. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности. Положен налоговый вычет — вернётся до 5 434 ₽ (максимум, за 14-дневную смену).",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 99 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "В АйДаКемп едут из Щёлково и всего северо-востока Подмосковья:",
    list: [
      "<a href='/lager-pushkino'>Пушкино</a> — на машине через МКАД и Киевское шоссе, либо трансфер от м. Солнцево",
      "<a href='/lager-balashiha'>Балашиха</a> — на машине через МКАД и Киевское шоссе, либо трансфер от м. Солнцево",
      "<a href='/lager-nogink'>Ногинск</a> — на машине через МКАД и Киевское шоссе, либо трансфер от м. Солнцево",
      "<a href='/lager-reutov'>Реутов</a> — на машине через МКАД и Киевское шоссе, либо трансфер от м. Солнцево"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний лагерь в Щёлково 2026 — IT-смены 7–15 лет | АйДаКемп"
  description="IT-лагерь для ребят 7–15 лет из Щёлково: трансфер от м. Солнцево (2 000 ₽). Python, AI, Minecraft, бассейн. Налоговый вычет до 5 434 ₽. Смены от 48 000 ₽."
  h1="Детский лагерь рядом с Щёлково"
  canonical="https://aidacamp.ru/lager-shchelkovo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Щёлково до лагеря АйДаКемп?", a: "АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час без пробок). Из Щёлково: на машине через МКАД и Киевское шоссе, либо на автобусе до м. Щёлковская, далее метро до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин)." },
    { q: "Сколько ехать из Щёлково до лагеря?", a: "Лагерь — 66 км от МКАД по Киевскому шоссе, ~1 час без пробок плюс дорога от Щёлково до МКАД. До м. Солнцево из Щёлково — около 50 минут на метро, затем трансфер лагеря (2 000 ₽, ~40 мин)." },
    { q: "Есть ли трансфер из Щёлково?", a: "Прямого трансфера из Щёлково нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Щёлково удобно доехать до Солнцево на автобусе или метро." },
    { q: "Сколько стоит путёвка в лагерь из Щёлково?", a: "Смены от 48 000 ₽ (7 дней) до 99 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Щёлково — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Щёлково. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-shchelkovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Щёлково"
    subtitle="IT-лагерь в Наро-Фоминском округе — 66 км от МКАД по Киевскому шоссе. Для ребят 7–15 лет: Python, AI, Minecraft. Смены от 48 000 ₽."
    breadcrumb="Лагерь из Щёлково"
    keywords={["66 км от МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Смены от 48 000 ₽, налоговый вычет до 5 434 ₽"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Щёлково — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
