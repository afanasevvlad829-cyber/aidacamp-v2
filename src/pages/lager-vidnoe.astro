---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Видного до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 30 км от Видного, всего 35 минут езды. Маршрут: по Киевскому шоссе (A-101) на юго-запад → посёлок Атепцево. Видное — один из самых близких к лагерю городов Подмосковья. Трансфер отправляется от м. Солнцево, до которого из Видного 15–20 минут."
  },
  {
    h2: "Почему родители из Видного выбирают АйДаКемп",
    text: "Из Видного до лагеря — 35 минут прямо по Киевскому шоссе. Ближе некуда. Родители ценят, что ребёнок под рукой, и при этом получает полноценную IT-программу с лицензированным учреждением. Налоговый вычет 13%, рейтинг 5.0, документы — всё в порядке.",
    list: [
      "35 минут от Видного — один из ближайших лагерей для города",
      "Прямо по Киевскому шоссе — никаких пробок и сложных маршрутов",
      "Без акклиматизации — Подмосковье рядом с домом",
      "Налоговый вычет 13% — лагерь выдаёт все документы"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Видного",
    text: "Дети 7–15 лет выбирают IT-трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек. Итог смены — хакатон с защитой собственного проекта перед командой.",
    list: [
      "Python — от первой строки кода до рабочего телеграм-бота",
      "Scratch — визуальные игры для детей 7–10 лет",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — ChatGPT API, обучение собственной модели",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Видного, Подольска и юга Подмосковья выбирают АйДаКемп за близость и качество:",
    list: [
      "«Мы из Видного — 35 минут по Киевскому, и мы уже в лагере. Дочь была в июне, вернулась с AI-проектом и хочет снова в августе» — Екатерина, Видное",
      "«Самый близкий лагерь с нормальной IT-программой. Сын сделал игру на Scratch за первую неделю, потом перешёл на Python» — Михаил, Видное"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону (15–20 мин от Видного)"
    ]
  },
  {
    h2: "Маршрут из Видного: самый простой из всего Подмосковья",
    text: "Видное — один из ближайших к лагерю городов Подмосковья. Отсюда две дороги: прямо по Киевскому или через м. Солнцево.",
    list: [
      "На машине: из Видного прямо по Киевскому шоссе (A-101) на запад → санаторий «Изумруд». ~30 км, ~35 мин без пробок — рекорд среди гео-страниц",
      "На метро + трансфер: из Видного до м. Солнцево (~15–20 мин на машине) → трансфер АйДаКемп 2 000 ₽ → и через 40 мин ребёнок в лагере",
      "Родительский день: из Видного удобно заехать в середине смены — 35 мин по Киевскому"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "Рядом с Видным есть другие города, откуда едут в АйДаКемп:",
    list: [
      "<a href='/lager-podolsk'>Подольск</a> — ~45 км, ~50 мин по Киевскому шоссе",
      "<a href='/lager-serpuhov'>Серпухов</a> — ~70 км, ~1 ч 10 мин по Симферопольскому",
      "<a href='/lager-lubertsy'>Люберцы</a> — ~75 км, ~1 ч 20 мин через МКАД",
      "<a href='/lager-stupino'>Ступино</a> — ~100 км, ~1 ч 30 мин через М-4"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Видное 2026 — АйДаКемп, IT-лагерь рядом"
  description="Детский лагерь из Видного: ~35 мин по Киевскому шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Видным"
  canonical="https://aidacamp.ru/lager-vidnoe"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Видного до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Видного около 30 км и ~35 минут: прямо по Киевскому шоссе (A-101) → посёлок Атепцево. Это один из кратчайших маршрутов среди городов Подмосковья. Трансфер от м. Солнцево (2 000 ₽) — 15–20 минут от Видного." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Видного до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 35 минут на автомобиле (30 км прямо по Киевскому шоссе). Это один из самых коротких маршрутов к АйДаКемп среди городов Подмосковья." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Видного?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 000 ₽) — до Солнцево из Видного всего 15–20 минут. Многие семьи из Видного привозят детей самостоятельно — 35 минут по Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Видного?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Видным — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~35 мин от Видного по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-vidnoe"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Видным"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~35 мин из Видного по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Видного"
    keywords={["~35 мин от Видного по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Видным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
