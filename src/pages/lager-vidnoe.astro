---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Загородный лагерь с бассейном рядом с Видным",
    text: "Видное стоит прямо на Киевском шоссе — и лагерь АйДаКемп в той же стороне. АйДаКемп — это санаторий «Изумруд», 66 км от МКАД по Киевскому шоссе (~1 час без пробок). Из Видного вы выезжаете на ту же трассу без объездов и пересадок — один из самых удобных маршрутов на юго-западе Подмосковья. Это загородный лагерь с проживанием и собственным бассейном, а не дневной: ребёнок живёт на территории всю смену. Лицензия Минобрнауки, рейтинг 5.0 на Яндекс.Картах."
  },
  {
    h2: "Как добраться из Видного до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском городском округе — 66 км от МКАД по Киевскому шоссе (А-101), около часа без пробок. Из Видного вы выезжаете на ту же трассу, поэтому дорога идёт без объездов. Можно привезти ребёнка самостоятельно на машине или воспользоваться трансфером лагеря от м. Солнцево.",
    list: [
      "На машине: по Киевскому шоссе (А-101) на юго-запад → санаторий «Изумруд». 66 км от МКАД, ~1 час без пробок",
      "Трансфер лагеря: до м. Солнцево (Солнцевская линия) → автобус с сопровождающим до лагеря, 2 000 ₽ в одну сторону",
      "Электричка: до ст. Нара (~1 ч 10 мин), далее такси ~20 мин, либо до ст. Башкино (~8 км до лагеря)",
      "Родительский день: из Видного удобно заехать в середине смены прямо по Киевскому шоссе"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Родители из Видного ценят, что лагерь близко — и при этом внутри работает полноценная команда.",
    list: [
      "1 преподаватель на 6–8 ребят — успевает поработать с каждым лично",
      "Вожатые — конкурсный отбор, проходят обучение до смены",
      "Медработник круглосуточно на территории лагеря",
      "Ежедневные фото в Telegram в 21:00 — видно, чем занимался ваш ребёнок сегодня"
    ]
  },
  {
    h2: "Программа IT-лагеря для ребят из Видного",
    text: "Школьники 7–15 лет выбирают IT-трек по интересу и уровню. Занятия дважды в день по 90 минут, группы до 8 человек. Итог смены — хакатон с защитой собственного проекта перед командой.",
    list: [
      "Python — от первой строки кода до рабочего телеграм-бота",
      "Scratch — визуальные игры для ребят 7–10 лет",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — ChatGPT API, обучение собственной модели",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Видного",
    text: "Семьи из Видного, Подольска и юга Подмосковья выбирают АйДаКемп за близость и качество:",
    list: [
      "«Мы из Видного — выехали на Киевское шоссе и без пересадок доехали. Дочь была в июне, вернулась с AI-проектом и хочет снова в августе» — Екатерина, Видное",
      "«Самый близкий лагерь с нормальной IT-программой. Сын сделал игру на Scratch за первую неделю, потом перешёл на Python» — Михаил, Видное"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Места на смены 2026 есть — бронируйте заранее. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности. На путёвку оформляется налоговый вычет — возвращается часть суммы.",
    list: [
      `Смена 2.1: 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2: 10–23 июня, 14 дней — ${PRICE_MAX} (самая популярная)`,
      `Смена 3: 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4: 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Трансфер лагеря от м. Солнцево — 2 000 ₽ в одну сторону, с сопровождающим"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "Рядом с Видным есть другие города, откуда едут в АйДаКемп:",
    list: [
      "<a href='/lager-podolsk'>Подольск</a> — соседний город на юге, тот же выезд на Киевское шоссе",
      "<a href='/lager-serpuhov'>Серпухов</a> — юг Подмосковья, дорога через Киевское шоссе",
      "<a href='/lager-lubertsy'>Люберцы</a> — юго-восток Москвы",
      "<a href='/lager-stupino'>Ступино</a> — юг Подмосковья"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Видным 2026 — IT, бассейн | АйДаКемп"
  description={`Загородный IT-лагерь рядом с Видным по Киевскому шоссе: бассейн, проживание, 5-разовое питание. От ${PRICE_MIN}, налоговый вычет до 5 434 ₽. Python, AI для 7–15 лет.`}
  h1="Детский лагерь рядом с Видным"
  canonical="https://aidacamp.ru/lager-vidnoe"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Видного до лагеря АйДаКемп?", a: "Из Видного около 30 км и ~35 минут: прямо по Киевскому шоссе (M-3) → посёлок Атепцево. Это один из кратчайших маршрутов среди городов Подмосковья. Трансфер от м. Солнцево (2 000 ₽) — 15–20 минут от Видного." },
    { q: "Сколько ехать из Видного до лагеря?", a: "Около 35 минут на автомобиле (30 км прямо по Киевскому шоссе). Это один из самых коротких маршрутов к АйДаКемп среди городов Подмосковья." },
    { q: "Есть ли трансфер из Видного?", a: "Организованный трансфер отправляется от м. Солнцево (2 000 ₽) — до Солнцево из Видного всего 15–20 минут. Многие семьи из Видного привозят детей самостоятельно — 35 минут по Киевскому шоссе." },
    { q: "Сколько стоит путёвка в лагерь из Видного?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Видным — АйДаКемп"
      description="Загородный IT-лагерь с бассейном в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе, рядом с Видным. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-vidnoe"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Видным"
subtitle="Загородный IT-лагерь с бассейном по Киевскому шоссе — рядом с Видным. Python, AI, Minecraft, проживание для детей 7–15 лет."
    breadcrumb="Лагерь из Видного"
keywords={["Рядом с Видным по Киевскому шоссе, 66 км от МКАД", "Бассейн, проживание, 5-разовое питание", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Видным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
