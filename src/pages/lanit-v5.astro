    document.getElementById('sov-level').textContent='Junior Dev';
    document.getElementById('sov-food').textContent='npm install ' + foodLabel;
    document.getElementById('sov-msg').innerHTML='нажми <b>пробел</b> или коснись экрана';
    drawSov();
  }

  function randFood() {
    var pos, ok;
    do {
      pos={x:Math.floor(Math.random()*SOV_COLS), y:Math.floor(Math.random()*SOV_ROWS)};
      ok=!snake.some(function(s){ return s.x===pos.x&&s.y===pos.y; });
    } while(!ok);
    return pos;
  }

  function roundRect(c,x,y,w,h,r) {
    c.beginPath(); c.moveTo(x+r,y);
    c.lineTo(x+w-r,y); c.arcTo(x+w,y,x+w,y+r,r);
    c.lineTo(x+w,y+h-r); c.arcTo(x+w,y+h,x+w-r,y+h,r);
    c.lineTo(x+r,y+h); c.arcTo(x,y+h,x,y+h-r,r);
    c.lineTo(x,y+r); c.arcTo(x,y,x+r,y,r); c.closePath();
  }

  function drawSov() {
    var W=sovCanvas.width, H=sovCanvas.height, C=SOV_CELL;
    sovCtx.fillStyle='#0d1117'; sovCtx.fillRect(0,0,W,H);
    // grid dots
    sovCtx.fillStyle='rgba(255,255,255,0.025)';
    for(var r=0;r<SOV_ROWS;r++) for(var c=0;c<SOV_COLS;c++)
      sovCtx.fillRect(c*C+C/2-1,r*C+C/2-1,2,2);
    // food — orange circle + package label
    var fx=food.x*C+C/2, fy=food.y*C+C/2;
    sovCtx.fillStyle='#ff7a3d';
    sovCtx.beginPath(); sovCtx.arc(fx,fy,C/2-1,0,Math.PI*2); sovCtx.fill();
    if(C>=18) {
      sovCtx.font='bold '+(C<22?8:10)+'px SF Mono,monospace';
      sovCtx.fillStyle='#fff'; sovCtx.textAlign='center'; sovCtx.textBaseline='middle';
      sovCtx.fillText(foodLabel,fx,fy);
    }
    // snake — binary body
    snake.forEach(function(s,i){
      var alpha = i===0 ? 1 : Math.max(0.15, 0.9-i*0.025);
      sovCtx.fillStyle = i===0 ? '#28C840' : 'rgba(40,200,64,'+alpha+')';
      roundRect(sovCtx, s.x*C+1, s.y*C+1, C-2, C-2, i===0?4:2);
      sovCtx.fill();
      // binary digit in each body segment
      if(C>=18 && i>0 && i<snake.length) {
        sovCtx.font=(C<22?7:9)+'px SF Mono,monospace';
        sovCtx.fillStyle='rgba(0,0,0,0.45)'; sovCtx.textAlign='center'; sovCtx.textBaseline='middle';
        sovCtx.fillText(i%2===0?'1':'0', s.x*C+C/2, s.y*C+C/2);
      }
      // head cursor
      if(i===0 && C>=18) {
        sovCtx.font='bold '+(C<22?9:11)+'px SF Mono,monospace';
        sovCtx.fillStyle='#0d1117'; sovCtx.textAlign='center'; sovCtx.textBaseline='middle';
        sovCtx.fillText('▮', s.x*C+C/2, s.y*C+C/2);
      }
    });
    // game over overlay
    if(gameOver) {
      sovCtx.fillStyle='rgba(0,0,0,0.78)'; sovCtx.fillRect(0,0,W,H);
      sovCtx.textAlign='center';
      sovCtx.fillStyle='#ff5a1f'; sovCtx.font='bold 20px SF Mono,monospace';
      sovCtx.fillText(deathReason, W/2, H/2-30);
      sovCtx.fillStyle='#E6EDF3'; sovCtx.font='14px SF Mono,monospace';
      sovCtx.fillText('commits: '+commits, W/2, H/2-4);
      sovCtx.fillStyle='#8B949E'; sovCtx.font='12px SF Mono,monospace';
      sovCtx.fillText(getLevel(commits).t, W/2, H/2+18);
      sovCtx.fillStyle='rgba(255,90,31,0.6)'; sovCtx.font='11px SF Mono,monospace';
      sovCtx.fillText('press space or tap to restart', W/2, H/2+42);
    }
  }

  function sovStep() {
    dir=nextDir;
    var head={x:snake[0].x+dir.x, y:snake[0].y+dir.y};
    var hitWall=head.x<0||head.x>=SOV_COLS||head.y<0||head.y>=SOV_ROWS;
    var hitSelf=snake.some(function(s){ return s.x===head.x&&s.y===head.y; });
    if(hitWall){ deathReason=DEATH_WALL[Math.floor(Math.random()*DEATH_WALL.length)]; endSnake(); return; }
    if(hitSelf){ deathReason=DEATH_SELF[Math.floor(Math.random()*DEATH_SELF.length)]; endSnake(); return; }
    snake.unshift(head);
    if(head.x===food.x&&head.y===food.y) {
      commits++;
      score+=10;
      var lv=getLevel(commits);
      document.getElementById('sov-score').textContent=commits+' commit'+(commits===1?'':'s');
      document.getElementById('sov-level').textContent=lv.t;
      food=randFood();
      foodLabel=PACKAGES[Math.floor(Math.random()*PACKAGES.length)];
      document.getElementById('sov-food').textContent='npm install '+foodLabel;
      // speed up every 5 commits
      if(commits%5===0) {
        clearInterval(gameLoop);
        var spd=Math.max(100, 190-commits*5);
        gameLoop=setInterval(sovStep,spd);
      }
    } else { snake.pop(); }
    drawSov();
  }

  function startSnake() {
    if(gameOver){ initSnake(); }
    if(snakeRunning) return;
    snakeRunning=true;
    document.getElementById('sov-msg').textContent='';
    gameLoop=setInterval(sovStep,190);
  }

  function endSnake() {
    clearInterval(gameLoop); snakeRunning=false; gameOver=true;
    document.getElementById('sov-msg').textContent='';
    drawSov();
  }

  function stopSnake() { clearInterval(gameLoop); snakeRunning=false; }

  window.openSnakeOverlay = function() {
    var sw=document.getElementById('snake-wrap');
    sw.classList.add('active');
    initSovSize();
    initSnake();
  };

  window.closeSnakeOverlay = function() {
    stopSnake();
    document.getElementById('snake-wrap').classList.remove('active');
    document.querySelectorAll('.term-tab').forEach(function(b){ b.classList.remove('active'); });
    var pt=document.querySelector('.term-tab[data-mode="python"]');
    if(pt){ pt.classList.add('active'); }
    runMode('python');
  };

  // canvas click
  sovCanvas.addEventListener('click', function(){ startSnake(); });

  // touch swipe
  var touchSX, touchSY;
  sovCanvas.addEventListener('touchstart', function(e){
    e.preventDefault();
    touchSX=e.touches[0].clientX; touchSY=e.touches[0].clientY;
  }, {passive:false});
  sovCanvas.addEventListener('touchend', function(e){
    e.preventDefault();
    var dx=e.changedTouches[0].clientX-touchSX, dy=e.changedTouches[0].clientY-touchSY;
    if(Math.abs(dx)<10&&Math.abs(dy)<10){ startSnake(); return; }
    var nd;
    if(Math.abs(dx)>Math.abs(dy)) nd=dx>0?{x:1,y:0}:{x:-1,y:0};
    else nd=dy>0?{x:0,y:1}:{x:0,y:-1};
    if(!(nd.x===-dir.x&&nd.y===-dir.y)) nextDir=nd;
    if(!snakeRunning) startSnake();
  }, {passive:false});

  // D-pad buttons
  document.querySelectorAll('.dpad-btn').forEach(function(btn){
    btn.addEventListener('touchstart', function(e){
      e.preventDefault();
      var d=btn.dataset.d;
      var map={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};
      var nd=map[d];
      if(nd&&!(nd.x===-dir.x&&nd.y===-dir.y)) nextDir=nd;
      if(!snakeRunning) startSnake();
    }, {passive:false});
    btn.addEventListener('click', function(){
      var d=btn.dataset.d;
      var map={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};
      var nd=map[d];
      if(nd&&!(nd.x===-dir.x&&nd.y===-dir.y)) nextDir=nd;
      if(!snakeRunning) startSnake();
    });
  });

  // keyboard
  document.addEventListener('keydown', function(e) {
    var sw=document.getElementById('snake-wrap');
    if(!sw.classList.contains('active')) return;
    if(e.key==='Escape'){ e.preventDefault(); closeSnakeOverlay(); return; }
    var map={ArrowUp:{x:0,y:-1},ArrowDown:{x:0,y:1},ArrowLeft:{x:-1,y:0},ArrowRight:{x:1,y:0},
             w:{x:0,y:-1},s:{x:0,y:1},a:{x:-1,y:0},d:{x:1,y:0},
             W:{x:0,y:-1},S:{x:0,y:1},A:{x:-1,y:0},D:{x:1,y:0}};
    if(e.key===' '){ e.preventDefault(); startSnake(); return; }
    var nd=map[e.key];
    if(nd&&!(nd.x===-dir.x&&nd.y===-dir.y)){ e.preventDefault(); nextDir=nd; }
  });

  /* ── START ── */
  runMode('python');
})();

