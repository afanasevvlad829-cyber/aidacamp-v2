const html = document.documentElement;
const themeBtn = document.getElementById('themeBtn');
const icoMoon = document.getElementById('ico-moon');
const icoSun = document.getElementById('ico-sun');
const saved = localStorage.getItem('theme') || 'dark';
html.dataset.theme = saved;
function applyThemeIcons(t) {
  if (t === 'dark') { icoMoon.style.display='block'; icoSun.style.display='none'; }
  else { icoMoon.style.display='none'; icoSun.style.display='block'; }
}
applyThemeIcons(saved);
themeBtn.onclick = () => {
  const t = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = t;
  applyThemeIcons(t);
  localStorage.setItem('theme', t);
};

/* CODE RAIN CANVAS */
const canvas = document.getElementById('hero-canvas');
const ctx = canvas.getContext('2d');
const snippets = 'def class return import for if else True False None print len range type async await yield lambda try except with as pass break continue'.split(' ');
const pyColors = ['#FF7B72','#D2A8FF','#A5D6FF','#FFA657','#6E7681','#79C0FF'];
let cols, drops;
function resizeCanvas() {
  canvas.width = window.innerWidth; canvas.height = window.innerHeight;
  cols = Math.floor(canvas.width / 22);
  drops = drops ? drops.slice(0, cols) : Array.from({length: cols}, () => Math.random() * -60);
  while (drops.length < cols) drops.push(Math.random() * -60);
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);
setInterval(() => {
  const isDark = html.dataset.theme === 'dark';
  ctx.fillStyle = isDark ? 'rgba(12,14,17,0.05)' : 'rgba(244,245,248,0.05)';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.font = '13px "SF Mono","Fira Code",monospace';
  for (let i = 0; i < cols; i++) {
    const word = snippets[Math.floor(Math.random() * snippets.length)];
    ctx.fillStyle = pyColors[Math.floor(Math.random() * pyColors.length)];
    ctx.globalAlpha = 0.6;
    ctx.fillText(word[0] || ' ', i * 22, drops[i] * 22);
    ctx.globalAlpha = 1;
    if (drops[i] * 22 > canvas.height && Math.random() > 0.975) drops[i] = 0;
    drops[i] += 0.35;
  }
}, 55);

