  var closeBtn = document.getElementById('rv-modal-close');
  function openRvModal(idx) {
    var r = reviewsData[idx]; if (!r) return;
    document.getElementById('rv-modal-photo').src = r.photo;
    document.getElementById('rv-modal-photo').alt = r.name;
    document.getElementById('rv-modal-name').textContent = r.name;
    document.getElementById('rv-modal-date').textContent = r.date;
    document.getElementById('rv-modal-text').textContent = r.full;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeRvModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-ropen]');
    if (btn) openRvModal(parseInt(btn.dataset.ropen));
  });
  closeBtn && closeBtn.addEventListener('click', closeRvModal);
  backdrop && backdrop.addEventListener('click', closeRvModal);
  // swipe down on mobile
  var startY = 0;
  panel && panel.addEventListener('touchstart', function(e) { startY = e.touches[0].clientY; }, { passive: true });
  panel && panel.addEventListener('touchend', function(e) { if (e.changedTouches[0].clientY - startY > 60) closeRvModal(); }, { passive: true });
})();

