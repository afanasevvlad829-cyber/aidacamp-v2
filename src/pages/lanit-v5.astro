---
import { PRICE_S3 } from '../data/shifts';
// lanit-v5.astro — Astro version of lanit-v5.html
// Archived for reference, not used in production
export const prerender = true;
---

<html lang="ru" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>АйДаКемп 2026 — для сотрудников ГК ЛАНИТ</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<!-- LIGHTBOX -->
<div class="lightbox-overlay" id="lightbox">
  <button class="lightbox-close" id="lb-close" aria-label="Закрыть">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button class="lightbox-nav lightbox-prev" id="lb-prev" aria-label="Назад">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <img class="lightbox-img" id="lb-img" src="" alt="">
  <button class="lightbox-nav lightbox-next" id="lb-next" aria-label="Вперёд">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="lightbox-caption" id="lb-cap"></div>
</div>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <div class="nav-logo">АйДа<em>Кемп</em></div>
    <div class="nav-badge">Партнёрская программа · ГК ЛАНИТ</div>
    <div class="nav-right">
      <a href="tel:+74951284429" class="nav-tel">+7 (495) 128-44-29</a>
      <button class="theme-toggle" id="themeBtn" title="Сменить тему" aria-label="Сменить тему">
        <svg id="ico-moon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="ico-sun" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"  hidden><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
    </div>
  </div>
</nav>

<!-- HERO -->
<canvas id="hero-canvas"></canvas>
<section class="hero"  border-none>
  <div class="hero-content">
    <div>
      <div class="hero-kicker">
        <div class="hero-kicker-line"></div>
        Специальные условия для сотрудников ГК ЛАНИТ
      </div>
      <h1>IT-лагерь для детей<br><em>айтишников</em></h1>
      <p class="hero-desc">Ваш ребёнок видит, что вы делаете? Пора показать ему настоящий стек. Python, JS, Java, ИИ-агенты — и реальный проект на выходе. Летняя инженерная школа в 66 км от Москвы. 7–15 лет.</p>
      <div class="hero-pills">
        <span class="pill">7–15 лет</span>
        <a class="pill pill-link" href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/" target="_blank" rel="noopener" onclick="if(window.ym)ym(96499295,'reachGoal','lanit_contact_click')">★ 5.0 · Яндекс.Карты</a>
        <a class="pill pill-link" href="#gallery" onclick="event.preventDefault();switchGalCat('pool');setTimeout(function(){document.getElementById('gallery').scrollIntoView({behavior:'smooth'})},50)">Крытый бассейн</a>
        <a class="pill pill-link" href="#directions">66 км от Москвы</a>
        <a class="pill pill-link" href="#tracks">8+ треков</a>
        <a class="pill pill-link" href="#gallery" onclick="event.preventDefault();switchGalCat('food');setTimeout(function(){document.getElementById('gallery').scrollIntoView({behavior:'smooth'})},50)">5-разовое питание</a>
        <a class="pill pill-link" href="https://aidacamp.ru/docs/licenziya-rosobrnadzor.pdf" target="_blank" rel="noopener">Лицензия Минобра № Л035-01298-77/01082973</a>
      </div>
      <div class="hero-btns">
        <a href="tel:+74951284429" class="btn-primary">
          <svg class="ico" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          +7 (495) 128-44-29
        </a>
        <a href="https://t.me/Progaschool" class="btn-ghost" target="_blank" rel="noopener" onclick="if(window.ym)ym(96499295,'reachGoal','lanit_contact_click')">
          <svg class="ico" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          Telegram
        </a>
      </div>
    </div>

    <div class="terminal">
      <div class="term-bar">
        <div class="tdot td-r"></div>
        <div class="tdot td-y"></div>
        <div class="tdot td-g"></div>
        <div class="term-tabs" id="term-tabs">
          <button class="term-tab active" data-mode="python">Python</button>
          <button class="term-tab" data-mode="csharp">C#</button>
          <button class="term-tab" data-mode="bash">Bash</button>
          <button class="term-tab" data-mode="game">▶ Snake</button>
        </div>
      </div>
      <div class="term-body" id="code-out"></div>
      <div id="snake-wrap">
        <div id="sw-bar">
          <span id="sov-score">0 commits</span>
          <span id="sov-food">npm install ...</span>
          <span id="sov-level">Junior Dev</span>
        </div>
        <canvas id="sov-canvas"></canvas>
        <div id="sov-msg">нажми <b>пробел</b> или коснись экрана</div>
      </div>
      <!-- Python BSOD -->
      <div id="term-bsod"></div>
      <!-- C# crash -->
      <div id="term-cscrash"></div>
      <!-- Kernel panic -->
      <div id="term-kpanic"></div>
      <div class="term-footer">
        <span class="term-tag" id="term-tag-label">LANIT PARTNER</span>
        <span class="term-ok" id="term-ok-label">скидка применена</span>
      </div>
    </div>
  </div>
</section>

<!-- WHY -->
<section>
  <div class="wrap">
    <div class="s-kicker">Для IT-специалистов</div>
    <h2>Вы знаете,<br>как это <em>работает на самом деле</em></h2>
    <p class="s-lead">Ваши дети заслуживают настоящего стека, а не имитации программирования.</p>
    <div id="why-age-tabs"  hidden gap-lanit-xs p-0 flex-nowrap overflow-x-auto   style="scrollbar-width:none">
      <button class="why-age-tab active" data-age="all">Все</button>
      <button class="why-age-tab" data-age="7-9">7–9 лет</button>
      <button class="why-age-tab" data-age="10-12">10–12 лет</button>
      <button class="why-age-tab" data-age="13-15">13–15 лет</button>
    </div>
    <div class="grid-3 r why-grid">
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">Настоящий стек</div>
        <div class="why-text">Python, Java, JavaScript — не упрощённые аналоги. IDE, реальные библиотеки, та же логика что и в продакшне.</div>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">ИИ как инструмент</div>
        <div class="why-text">GPT и ИИ-агенты встроены в каждый трек — не тема урока, а рабочий инструмент для написания, отладки, тестирования.</div>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">Проект, а не сертификат</div>
        <div class="why-text">Игра, сайт, веб-приложение, дрон-сценарий. Работающая штука, которую можно показать и доработать дома.</div>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">Индивидуальный маршрут</div>
        <div class="why-text">8+ направлений. В первый день педагог оценивает уровень и интересы — нулевой и продвинутый в одной смене.</div>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">Бассейн и полноценный отдых</div>
        <div class="why-text">Крытый бассейн, заплывы через день. Футбол, волейбол. Санаторий «Изумруд». Медсестра 24/7.</div>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <div class="why-title">Ноутбук не нужен</div>
        <div class="why-text">Одинаковый парк машин. Сброс ОС за 15 секунд. Все IDE и библиотеки настроены и проверены заранее.</div>
      </div>
    </div>
    <div class="carousel-dots" id="why-dots"></div>
  </div>
</section>

<!-- TRACKS -->
<section id="tracks" class="alt">
  <div class="wrap">
    <div class="s-kicker">Программа обучения</div>
    <h2>8 треков для детей <em>7–15 лет</em></h2>
    <p class="s-lead">2 занятия по 90 минут каждый день. Подбор в первый день по уровню и интересам ребёнка.</p>
    <div class="grid-4 r" id="tracks-grid">
      <div class="track-card">
        <div class="track-age">7–9 лет</div>
        <div class="track-name">Scratch + ИИ / GPT</div>
        <div class="track-sep"></div>
        <div class="track-res">Интерактивные истории, анимации. ИИ генерирует фоны и идеи. Итог — собственная игра</div>
      </div>
      <div class="track-card">
        <div class="track-age">7–9 лет</div>
        <div class="track-name">Minecraft + код</div>
        <div class="track-sep"></div>
        <div class="track-res">Логика, команды, автоматизация. Итог — мини-игра или автоматизированный мир</div>
      </div>
      <div class="track-card">
        <div class="track-age">7–12 лет</div>
        <div class="track-name">Дрон Scratch / Python</div>
        <div class="track-sep"></div>
        <div class="track-res">Полётные маршруты, автосценарии, съёмка. Итог — сценарий полёта с видео</div>
      </div>
      <div class="track-card">
        <div class="track-age">10–12 лет</div>
        <div class="track-name">Python + Pygame</div>
        <div class="track-sep"></div>
        <div class="track-res">Переменные, условия, циклы через игру. Итог — полноценная игра с уровнями и очками</div>
      </div>
      <div class="track-card">
        <div class="track-age">10–12 лет</div>
        <div class="track-name">JavaScript</div>
        <div class="track-sep"></div>
        <div class="track-res">Современный сайт с интерактивностью. ИИ помогает развивать проект дальше</div>
      </div>
      <div class="track-card">
        <div class="track-age">10–12 лет</div>
        <div class="track-name">Python Advanced</div>
        <div class="track-sep"></div>
        <div class="track-res">Реальное веб-приложение + ИИ-агент для разработки и тестирования</div>
      </div>
      <div class="track-card">
        <div class="track-age">13–15 лет</div>
        <div class="track-name">Python (старшие)</div>
        <div class="track-sep"></div>
        <div class="track-res">Кодинг, отладка, реальный проект уровня junior с применением ИИ-агентов</div>
      </div>
      <div class="track-card">
        <div class="track-age">13–15 лет</div>
        <div class="track-name">Java / ООП</div>
        <div class="track-sep"></div>
        <div class="track-res">Основы ООП и алгоритмов, паттерны проектирования. Проект с реальной архитектурой</div>
      </div>
    </div>
    <div class="carousel-dots" id="tracks-dots"></div>
  </div>
</section>

<!-- HACKATHON -->
<section>
  <div class="wrap">
    <div class="s-kicker">Внутри смены</div>
    <h2>Хакатон: один день —<br><em>настоящий стартап</em></h2>
    <p class="s-lead">Хакатон — это отдельное событие внутри смены, во второй её половине. Не продолжение проекта, а другой формат: команда, стартап, инвесторы.</p>

    <!-- Roles -->
    <div  mb-lanit-xl>
      <div  text-lanit-md font-semibold text-lanit-txt mb-[10px]>Команда собирается с нуля — роли распределяются сразу:</div>
      <div  flex flex-wrap gap-lanit-xs id="hack-roles">
        <button type="button" class="role-badge" data-desc="Пишет код и собирает прототип. Отвечает за техническую часть — без него нечего показывать инвесторам.">Разработчик</button>
        <button type="button" class="role-badge" data-desc="Делает интерфейс и логотип с помощью AI. Отвечает за то, как продукт выглядит.">Дизайнер</button>
        <button type="button" class="role-badge" data-desc="Придумывает название, слоган, готовит питч. Знает кому и зачем это нужно.">Маркетолог</button>
        <button type="button" class="role-badge" data-desc="Управляет бюджетом команды — покупает ресурсы, следит чтобы деньги не кончились раньше защиты.">Финансовый директор</button>
        <button type="button" class="role-badge" data-desc="Определяет что делаем, для кого и чем отличаемся от других команд.">Стратег</button>
        <button type="button" class="role-badge" data-desc="Ищет баги и слабые места до питча. Задаёт неудобные вопросы своей же команде.">Тестировщик</button>
      </div>
      <div id="role-popup"  hidden mt-[10px] rounded-lanit-md text-lanit-base text-lanit-txt leading-lanit-normal  bg-orange-8 border border-orange-25  style="padding:14px 18px">
        <span id="role-popup-name"  font-bold text-lanit-or2></span><span id="role-popup-sep"> — </span><span id="role-popup-desc"></span>
      </div>
    </div>

    <!-- Steps -->
    <div class="hackathon-grid r">
      <div class="hack-steps">
        <div class="hack-step">
          <div class="hack-num">01</div>
          <div>
            <div class="hack-title">Идея и паспорт проекта</div>
            <div class="hack-text">Брейншторм, паспорт проекта: для кого, какую проблему решает, чем отличается от других команд.</div>
          </div>
        </div>
        <div class="hack-step">
          <div class="hack-num">02</div>
          <div>
            <div class="hack-title">Покупка ресурсов</div>
            <div class="hack-text">Рабочее место, интернет, консультации экспертов — всё за игровую валюту. Ресурсы ограничены.</div>
          </div>
        </div>
        <div class="hack-step">
          <div class="hack-num">03</div>
          <div>
            <div class="hack-title">Разработка и AI</div>
            <div class="hack-text">Прототип, техзадание, AI для логотипа и текстов. Тестировщики ищут слабые места в своей же команде.</div>
          </div>
        </div>
        <div class="hack-step">
          <div class="hack-num">04</div>
          <div>
            <div class="hack-title">Питч перед инвесторами</div>
            <div class="hack-text">Два тура инвестиций. Финальная защита — 5 минут на питч и вопросы жюри. Проект уходит домой.</div>
          </div>
        </div>
      </div>
      <div class="hack-visual">
        <div  text-lanit-sm font-bold uppercase text-lanit-or mb-lanit-md   style="letter-spacing:0.12em">Что остаётся после</div>
        <div  flex flex-col gap-lanit-md text-left>
          <div  flex gap-lanit-sm items-start>
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"  text-lanit-or2 flex-shrink-0 mt-[2px]><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            <span  text-lanit-base text-lanit-txt2 leading-lanit-normal>Опыт командной работы с распределёнными ролями</span>
          </div>
          <div  flex gap-lanit-sm items-start>
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"  text-lanit-or2 flex-shrink-0 mt-[2px]><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            <span  text-lanit-base text-lanit-txt2 leading-lanit-normal>Понимание что такое продукт, бюджет и питч</span>
          </div>
          <div  flex gap-lanit-sm items-start>
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"  text-lanit-or2 flex-shrink-0 mt-[2px]><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            <span  text-lanit-base text-lanit-txt2 leading-lanit-normal>Ощущение что сделал что-то настоящее — не учебное задание</span>
          </div>
        </div>
        <div class="hack-tags"  mt-lanit-xl>
          <span class="hack-tag">Python</span>
          <span class="hack-tag">JavaScript</span>
          <span class="hack-tag">Java</span>
          <span class="hack-tag">ИИ-агенты</span>
          <span class="hack-tag">Стартап-формат</span>
          <span class="hack-tag">Публичная защита</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- POOL -->
<section class="alt">
  <div class="wrap">
    <div class="s-kicker">Отдых и инфраструктура</div>
    <div class="pool-grid r">
      <div>
        <h2>Не только код —<br><em>спорт, бассейн и внутренняя экономика</em></h2>
        <p  text-lanit-md text-lanit-txt2 leading-[1.7] mb-lanit-xl>Санаторий «Изумруд» в 66 км от Москвы. Для IT-лагеря важно, чтобы ребёнок отдохнул по-настоящему — а не просто переехал из домашнего компьютера в лагерный.</p>
        <div class="pool-features">
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <!-- вода / бассейн -->
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25C8.344 7.688 6.75 11.063 6.75 13.5a5.25 5.25 0 0010.5 0c0-2.438-1.594-5.813-5.25-11.25z"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">Крытый бассейн</div>
              <div class="pool-feature-text">Заплывы через день. Тёплая вода, инструктор, купание вне зависимости от погоды.</div>
            </div>
          </div>
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <!-- вилка + нож / питание -->
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M6.75 8.25V21m3.75-18v5.25a3 3 0 01-3 3m10.5-8.25V21m0-10.5a3 3 0 013-3h.375"/></svg>
            </div>
            <div>
              <div class="pool-feature-title">5-разовое питание</div>
              <div class="pool-feature-text">Завтрак, обед, полдник, ужин и поздний перекус. Сбалансированное меню без полуфабрикатов.</div>
            </div>
          </div>
          <div class="pool-feature">
            <div class="pool-feature-icon">
              <!-- крест / медицина -->
