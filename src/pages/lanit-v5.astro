@keyframes blink { 50%{opacity:0} }
.cat-line { font-family: 'SF Mono','Fira Code',monospace; font-size:16px; color:#8B949E; white-space: pre; padding: 0 24px 16px; overflow: hidden; }
.term-footer { background: rgba(255,90,31,0.1); border-top: 1px solid rgba(255,90,31,0.2); padding: 11px 18px; display: flex; justify-content: space-between; align-items: center; }
.term-tag { font-size:12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #FF7A3D; font-family: 'SF Mono',monospace; }
.term-ok { font-size:12px; color: #22C76A; display: flex; align-items: center; gap:6px; font-family: 'SF Mono',monospace; }
.term-ok::before { content:''; width:7px; height:7px; border-radius:9999px; background:#22C76A; }

/* SECTIONS */
section { padding: 88px 0; border-top: 1px solid rgba(255,255,255,0.07); background: #0C0E11; }
section.alt { background: #111418; }
.s-kicker { font-size:12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #FF5A1F; display: flex; align-items: center; gap:10px; margin-bottom: 18px; }
.s-kicker::after { content:''; width:40px; height:2px; background:#FF5A1F; opacity:0.5; }
h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(28px, 4vw, 48px); font-weight: 900; line-height: 1.05; letter-spacing: -0.025em; color: #E4E6EF; margin-bottom:16px; }
h2 em { font-style: normal; color: #FF7A3D; }
.s-lead { font-size:20px; color: #9098AB; max-width: 600px; margin-bottom: 52px; line-height: 1.75; }

/* SVG ICONS */
.ico { width: 20px; height: 20px; display: inline-block; flex-shrink: 0; vertical-align: middle; }
.ico-sm { width: 16px; height: 16px; }
.ico-lg { width: 24px; height: 24px; }

/* WHY */
.grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap:16px; }
.why-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; padding: 32px 28px; transition: border-color 0.25s, transform 0.25s; cursor: pointer; }
.why-card:hover { border-color: rgba(255,90,31,0.3); transform: translateY(-3px); }
.why-marker { width: 36px; height: 4px; background: #FF5A1F; border-radius: 2px; margin-bottom:24px; }
.why-title { font-size:20px; font-weight: 700; color: #E4E6EF; margin-bottom:10px; line-height: 1.3; }
.why-text { font-size:18px; color: #9098AB; line-height: 1.7; }
/* WHY AGE TABS */
.why-age-tab { background:#181C22; border:1px solid rgba(255,255,255,0.07); border-radius:20px; padding:6px 16px; font-size:16px; font-weight:500; color:#9098AB; cursor:pointer; white-space:nowrap; font-family:inherit; transition:all 0.15s; }
.why-age-tab.active { background:#FF5A1F; color:#1e2430; border-color:#FF5A1F; }

/* TRACKS */
.grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap:16px; }
.track-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; padding: 24px 20px; transition: border-color 0.2s, transform 0.2s; }
.track-card:hover { border-color: rgba(255,90,31,0.25); transform: translateY(-2px); }
.track-age { font-size:12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #FF5A1F; margin-bottom:10px; font-family: 'SF Mono',monospace; }
.track-name { font-size:20px; font-weight: 700; color: #E4E6EF; margin-bottom:10px; line-height: 1.3; }
.track-sep { height: 1px; background: rgba(255,255,255,0.07); margin-bottom:10px; }
.track-res { font-size:18px; color: #9098AB; line-height: 1.6; }

/* HACKATHON */
.hackathon-grid { display: grid; grid-template-columns: 1fr 1fr; gap:48px; align-items: center; }
.hack-steps { display: flex; flex-direction: column; gap: 0; }
.hack-step { display: flex; gap:24px; align-items: flex-start; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
.hack-step:first-child { padding-top: 0; }
.hack-step:last-child { border-bottom: none; }
.hack-num { font-family: 'Unbounded', sans-serif; font-size: 32px; font-weight: 900; color: rgba(255,90,31,0.55); line-height: 1; flex-shrink: 0; width: 48px; }
.hack-title { font-size:18px; font-weight: 700; color: #E4E6EF; margin-bottom:6px; }
.hack-text { font-size:18px; color: #9098AB; line-height: 1.7; }
.hack-visual { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:12px; padding: 40px 36px; text-align: center; }
.hack-big { font-family: 'Unbounded', sans-serif; font-size: 80px; font-weight: 900; color: #FF5A1F; line-height: 1; margin-bottom:10px; }
.hack-label { font-size:18px; color: #9098AB; margin-bottom:36px; }
.hack-tags { display: flex; flex-wrap: wrap; justify-content: center; gap:6px; }
.hack-tag { font-size:16px; font-weight: 600; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.13); color: #9098AB; padding: 8px 16px; border-radius:4px; }

/* POOL BLOCK */
.pool-grid { display: grid; grid-template-columns: 1fr 1fr; gap:48px; align-items: center; }
.pool-img-grid { display: grid; grid-template-columns: 1fr 1fr; gap:10px; }
.pool-img-btn { background: none; border: none; padding: 0; cursor: pointer; border-radius:8px; overflow: hidden; display: block; }
.pool-img-btn:first-child { grid-column: span 2; }
.pool-img-btn img { border-radius:8px; width: 100%; height: 150px; object-fit: cover; transition: transform 0.3s; display: block; }
.pool-img-btn:hover img { transform: scale(1.04); }
.pool-img-btn:first-child img { height: 190px; }
.pool-features { display: flex; flex-direction: column; gap:16px; margin-top:24px; }
.pool-feature { display: flex; gap:16px; align-items: flex-start; }
.pool-feature-icon { width: 44px; height: 44px; border-radius:8px; background: rgba(255,90,31,0.1); border: 1px solid rgba(255,90,31,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #FF7A3D; }
.pool-feature-title { font-size:18px; font-weight: 700; color: #E4E6EF; margin-bottom: 2px; }
.pool-feature-text { font-size:18px; color: #9098AB; line-height: 1.6; }

/* PRICING CALCULATOR */
.smeny-tabs { display: flex; gap:6px; margin-bottom:36px; flex-wrap: wrap; }
.stab { padding: 11px 22px; border-radius:4px; font-size:17px; font-weight: 600; background: #181C22; border: 1px solid rgba(255,255,255,0.07); cursor: pointer; color: #9098AB; transition: all 0.2s; }
.stab.active { background: #FF5A1F; border-color: #FF5A1F; color:#ffffff; }
.stab:hover:not(.active) { border-color: rgba(255,255,255,0.13); color: #E4E6EF; }
.calc-box { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:12px; padding: 40px; margin-bottom:36px; }
.slider-row { display: flex; align-items: center; gap:24px; margin-bottom:10px; }
.slider-label { font-size:18px; font-weight: 600; color: #E4E6EF; white-space: nowrap; }
.slider-val { font-family: 'Unbounded', sans-serif; font-size:28px; font-weight: 900; color: #FF7A3D; min-width: 48px; }
input[type=range] { flex: 1; -webkit-appearance: none; appearance: none; height: 6px; background: #1F2530; border-radius: 3px; outline: none; touch-action: pan-x; }
input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 28px; height: 28px; border-radius: 50%; background: #FF5A1F; cursor: pointer; box-shadow: 0 0 0 4px rgba(255,90,31,0.2); transition: box-shadow 0.2s; touch-action: none; }
input[type=range]::-webkit-slider-thumb:hover { box-shadow: 0 0 0 7px rgba(255,90,31,0.3); }
input[type=range]::-moz-range-thumb { width: 28px; height: 28px; border-radius: 50%; background: #FF5A1F; border: none; cursor: pointer; box-shadow: 0 0 0 4px rgba(255,90,31,0.2); }
.calc-results { display: grid; grid-template-columns: repeat(4,1fr); gap:16px; margin-top: 32px; }
.calc-res { background: #111418; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; padding: 20px; }
.calc-res-label { font-size:12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #9098AB; margin-bottom:6px; font-family: 'SF Mono',monospace; }
.calc-res-val { font-family: 'Unbounded', sans-serif; font-size: 22px; font-weight: 900; color: #E4E6EF; line-height: 1.1; }
.calc-res-val.green { color: #22C76A; }
.calc-res-val.orange { color: #FF7A3D; }
.calc-res-sub { font-size:16px; color: #9098AB; margin-top:6px; }
.transfer-note { background: rgba(255,90,31,0.07); border: 1px solid rgba(255,90,31,0.25); border-radius:8px; padding: 18px 24px; font-size:17px; color: #9098AB; line-height: 1.7; display: none; }
.transfer-note strong { color: #FF7A3D; }
.transfer-note.show { display: block; }

/* TAX */
.tax-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap:48px; align-items: center; }
.tax-calc-box { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:12px; padding: 36px; }
.tax-row { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
.tax-row:last-child { border-bottom: none; }
.tax-row-label { font-size:17px; color: #9098AB; }
.tax-row-val { font-size:18px; font-weight: 700; color: #E4E6EF; font-family: 'Unbounded', sans-serif; }
.tax-row.highlight .tax-row-val { color: #22C76A; font-size: 22px; }
.tax-steps { list-style: none; display: flex; flex-direction: column; gap:24px; }
.tax-step { display: flex; gap: 20px; align-items: flex-start; }
.tax-step-num { font-family: 'Unbounded', sans-serif; font-size:28px; font-weight: 900; color: #FF7A3D; line-height: 1; flex-shrink: 0; width: 40px; }
.tax-step-title { font-size:18px; font-weight: 700; color: #E4E6EF; margin-bottom:6px; }
.tax-step-text { font-size:17px; color: #9098AB; line-height: 1.65; }

/* GALLERY */
.gallery-tabs { display: flex; gap:6px; margin-bottom:24px; flex-wrap: wrap; }
.gtab { padding: 8px 18px; border-radius:4px; font-size:16px; font-weight: 600; background: #181C22; border: 1px solid rgba(255,255,255,0.07); cursor: pointer; color: #9098AB; transition: all 0.2s; }
.gtab.active { background: #FF5A1F; border-color: #FF5A1F; color:#ffffff; }
.gtab:hover:not(.active) { border-color: rgba(255,255,255,0.13); color: #E4E6EF; }
.gallery-grid { display: grid; grid-template-columns: repeat(3,1fr); gap:10px; }
.gallery-grid .big { grid-column: span 2; }
.gallery-item { border-radius:8px; overflow: hidden; aspect-ratio: 4/3; background: #181C22; position: relative; cursor: pointer; }
.gallery-item.big { aspect-ratio: 16/9; }
.gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.gallery-item:hover img { transform: scale(1.04); }
.gallery-item-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0); transition: background 0.3s; display: flex; align-items: center; justify-content: center; }
.gallery-item:hover .gallery-item-overlay { background: rgba(0,0,0,0.3); }
.gallery-item-overlay svg { opacity: 0; transition: opacity 0.3s; color: white; }
.gallery-item:hover .gallery-item-overlay svg { opacity: 1; }

/* LIGHTBOX */
.lightbox-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
  backdrop-filter: blur(4px);
}
.lightbox-overlay.open { opacity: 1; pointer-events: all; }
.lightbox-img { max-width: 90vw; max-height: 85vh; border-radius:8px; object-fit: contain; }
.lightbox-close { position: absolute; top: 20px; right: 20px; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; transition: background 0.2s; }
.lightbox-close:hover { background: rgba(255,255,255,0.2); }
.lightbox-caption { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: rgba(255,255,255,0.7); font-size:16px; }
.lightbox-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; transition: background 0.2s; }
.lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.lightbox-prev { left: 20px; }
.lightbox-next { right: 20px; }

/* VIDEO */
.video-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap:24px; }
.video-main-wrap iframe { width: 100%; aspect-ratio: 16/9; border: 0; border-radius:8px; background: #181C22; }
.video-list { display: flex; flex-direction: column; gap:10px; }
.vtab { display: flex; gap:16px; align-items: center; cursor: pointer; padding: 14px 16px; background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; transition: border-color 0.2s; }
.vtab:hover { border-color: rgba(255,255,255,0.13); }
.vtab.active { border-color: rgba(255,90,31,0.45); }
.vtab-thumb { width: 80px; height: 52px; border-radius:4px; overflow: hidden; background: #1F2530; flex-shrink: 0; position: relative; }
.vtab-thumb iframe { width: 160%; height: 160%; transform: scale(0.625); transform-origin: top left; pointer-events: none; }
.vtab-name { font-size:16px; font-weight: 700; color: #E4E6EF; }
.vtab-sub { font-size:16px; color: #9098AB; margin-top: 2px; }

/* REVIEWS */
.reviews-grid { display: grid; grid-template-columns: repeat(3,1fr); gap:16px; }
.review-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; padding: 28px; transition: border-color 0.2s, transform 0.2s; display: flex; flex-direction: column; }
.review-card:hover { border-color: rgba(255,255,255,0.13); transform: translateY(-2px); }
.review-top { display: flex; align-items: center; gap:10px; margin-bottom:16px; }
.review-avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: #1F2530; }
.review-avatar img { width: 100%; height: 100%; object-fit: cover; }
.review-name { font-size:17px; font-weight: 700; color: #E4E6EF; }
.review-meta-text { font-size:16px; color: #9098AB; margin-top: 2px; }
.review-stars { margin-left: auto; color:#FF7A3D; font-size:16px; letter-spacing: 1px; }
.review-text { font-size:17px; color: #9098AB; line-height: 1.75; flex: 1; font-style: italic; }
.review-sep { height: 1px; background: rgba(255,255,255,0.07); margin: 16px 0; }

/* TEAM */
.team-layout { display: grid; grid-template-columns: 320px 1fr; gap: 40px; align-items: start; }
.book-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:12px; padding: 28px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.book-img-wrap { cursor: pointer; transition: transform 0.2s; }
.book-img-wrap:hover { transform: scale(1.03); }
.book-img-wrap img { width: 160px; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
.book-title { font-size:18px; font-weight: 700; color: #E4E6EF; margin-top:16px; margin-bottom:6px; }
.book-text { font-size:16px; color: #9098AB; line-height: 1.65; margin-bottom:16px; }
.book-badges { display: flex; gap:6px; flex-wrap: wrap; justify-content: center; margin-bottom:16px; }
.book-badge { font-size:12px; font-weight: 600; background: rgba(255,90,31,0.1); border: 1px solid rgba(255,90,31,0.25); color: #FF7A3D; padding: 5px 12px; border-radius:20px; }
.btn-sm { display: inline-flex; align-items: center; gap:6px; padding: 10px 20px; border-radius:4px; font-size:16px; font-weight: 600; transition: all 0.2s; width: 100%; justify-content: center; }
.btn-sm-primary { background: #FF5A1F; color:#ffffff; }
.btn-sm-primary:hover { background: #FF7A3D; }
.btn-sm-ghost { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.13); color: #E4E6EF; margin-top:6px; }
.btn-sm-ghost:hover { border-color: rgba(255,90,31,0.4); }
.team-grid { display: grid; grid-template-columns: 1fr 1fr; gap:16px; }
.team-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; overflow: hidden; transition: border-color 0.2s, transform 0.2s; display: flex; }
.team-card:hover { border-color: rgba(255,90,31,0.25); transform: translateY(-2px); }
.team-photo { width: 80px; height: 80px; flex-shrink: 0; overflow: hidden; background: #1F2530; }
.team-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
.team-photo-placeholder { width: 80px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #1F2530; }
.team-info { padding: 16px 18px; }
.team-name { font-size:17px; font-weight: 700; color: #E4E6EF; margin-bottom: 3px; }
.team-role { font-size:12px; color: #FF7A3D; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom:6px; }
.team-bio { font-size:18px; color: #9098AB; line-height: 1.6; }

/* BOT CTA */
.bot-banner {
  background: linear-gradient(135deg, rgba(255,90,31,0.12) 0%, rgba(74,158,255,0.08) 100%);
  border: 1px solid rgba(255,90,31,0.25); border-radius:12px; padding: 32px 40px;
  display: flex; align-items: center; justify-content: space-between; gap:24px;
}
.bot-banner-left { display: flex; align-items: center; gap: 20px; }
.bot-icon { width: 60px; height: 60px; border-radius:12px; background: rgba(255,90,31,0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #FF7A3D; }
.bot-title { font-size:22px; font-weight: 700; color: #E4E6EF; margin-bottom:6px; }
.bot-desc { font-size:17px; color: #9098AB; }
.bot-btns { display: flex; gap:10px; flex-wrap: wrap; flex-shrink: 0; }

/* CONTACTS */
.contacts-grid { display: grid; grid-template-columns: 1fr 1fr; gap:48px; align-items: start; }
.contact-cards { display: grid; grid-template-columns: 1fr 1fr; gap:10px; }
.contact-card { background: #181C22; border: 1px solid rgba(255,255,255,0.07); border-radius:8px; padding: 20px 22px; display: flex; flex-direction: column; gap: 5px; transition: border-color 0.2s, transform 0.15s; }
.contact-card:hover { border-color: rgba(255,90,31,0.3); transform: translateY(-2px); }
.contact-card-inner { display: flex; align-items: center; gap:10px; }
.contact-type { font-size:12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #9098AB; font-family: 'SF Mono',monospace; }
.contact-val { font-size:18px; font-weight: 700; color: #E4E6EF; }
.corp-note { background: rgba(255,90,31,0.07); border: 1px solid rgba(255,90,31,0.25); border-radius:8px; padding: 20px 24px; margin-top:16px; font-size:18px; color: #9098AB; line-height: 1.7; }
.corp-note strong { color: #FF7A3D; font-weight: 700; }

/* VIDEO TABS */
.vid-tab-btn { padding: 8px 20px; border-radius:4px; font-size:16px; font-weight: 600; background: #181C22; border: 1px solid rgba(255,255,255,0.07); cursor: pointer; color: #9098AB; transition: all 0.2s; }
.vid-tab-btn.active { background: #FF5A1F; border-color: #FF5A1F; color:#ffffff; }
.vid-tab-btn:hover:not(.active) { border-color: rgba(255,255,255,0.13); color: #E4E6EF; }
.vid-mobile-only { display: none; }
.vid-desktop-only { display: grid; }
@media (max-width: 768px) {
  .vid-mobile-only { display: block !important; }
  .vid-desktop-only { display: none !important; }
}
/* VIDEO CARDS */
.vid-card-btn { background: none; border: none; padding: 0; cursor: pointer; text-align: left; }
.vid-card-thumb { position: relative; overflow: hidden; border-radius: 20px; aspect-ratio: 9/16; }
.vid-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.vid-card-btn:hover .vid-card-thumb img { transform: scale(1.05); }
.vid-play-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.2); }
.vid-play-icon { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; color:#FF5A1F; }
.vid-card-title { margin-top:6px; font-size:16px; font-weight: 600; color: #E4E6EF; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* ROLE BADGES */
.role-badge { font-size:16px; font-weight: 600; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.13); color: #9098AB; padding: 8px 16px; border-radius:4px; cursor: pointer; transition: all 0.2s; }
.role-badge:hover, .role-badge.active-role { background: rgba(255,90,31,0.12); border-color: rgba(255,90,31,0.4); color: #FF7A3D; }

/* REFUND BLOCK */
.refund-table { display: flex; flex-direction: column; border-radius:12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.07); margin-top:16px; }
.refund-row { display: flex; align-items: center; justify-content: space-between; gap:10px; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.07); }
.refund-row:last-child { border-bottom: none; }

/* REVIEW EXPAND */
.review-more-btn { font-size:16px; color: #FF7A3D; background: none; border: none; cursor: pointer; padding: 0; margin-top:6px; font-family: inherit; text-decoration: underline; text-underline-offset: 3px; }
/* Gallery v2 — pill tabs */
