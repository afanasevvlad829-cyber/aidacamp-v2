        var cards = car.querySelectorAll('.rv-card');
        if(!cards.length) return;
        var sl = car.scrollLeft;
        var cardW = cards[0].offsetWidth + 12;
        var idx = Math.round(sl / cardW);
        idx = Math.max(0, Math.min(idx, dots.length-1));
        dots.forEach(function(d,i){ d.classList.toggle('active', i===idx); });
      }
      car.addEventListener('scroll', updateDots, {passive:true});
      dots.forEach(function(d){
        d.addEventListener('click', function(){
          var idx = parseInt(this.dataset.idx);
          var cards = car.querySelectorAll('.rv-card');
          if(!cards.length) return;
          var cardW = cards[0].offsetWidth + 12;
          car.scrollTo({left: idx * cardW, behavior:'smooth'});
        });
      });
      updateDots();
    })();
    

      (function(){
        var tcar = document.getElementById('team-carousel');
        var tdots = document.querySelectorAll('#team-dots .team-dot');
        function updateTeamDots(){
          var cards = tcar.querySelectorAll('.team-card');
          if(!cards.length||!tcar.scrollWidth||tcar.scrollWidth<=tcar.clientWidth) return;
          var cw = tcar.clientWidth;
          var sl = tcar.scrollLeft;
          var cardW = cards[0].offsetWidth + 12;
          var idx = Math.round(sl / cardW);
          idx = Math.max(0, Math.min(idx, tdots.length-1));
          tdots.forEach(function(d,i){ d.classList.toggle('active', i===idx); });
        }
        tcar.addEventListener('scroll', updateTeamDots, {passive:true});
