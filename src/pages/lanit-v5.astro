function galBadge(size, label) {
  const s = size === 'big' ? {top:'12px',left:'12px',bot:'12px',right:'12px',topFs:'14px',botFs:'14px',pad:'4px 10px',r:'6px'} : {top:'8px',left:'8px',bot:'8px',right:'8px',topFs:'10px',botFs:'10px',pad:'2px 8px',r:'4px'};
  return `<span  absolute font-bold   style="left:${s.left};top:${s.top};background:rgba(255,255,255,0.9);border-radius:${s.r};padding:${s.pad};font-size:${s.topFs};color:var(--c-bg-dark);backdrop-filter:blur(4px)">#АЙДАКЕМП</span>
          <span  absolute font-semibold text-white uppercase  bg-black-7  style="bottom:${s.bot};right:${s.right};border-radius:${s.r};padding:${s.pad};font-size:${s.botFs};letter-spacing:0.05em;backdrop-filter:blur(4px)">${label}</span>`;
}

// Carousel dots helper — defined here (Script 1) so renderGalMobile can use it
function initCarouselDots(scrollEl, dotsEl, dotClass) {
  if (!scrollEl || !dotsEl) return;
  var items = Array.from(scrollEl.children).filter(function(el){ return el.style.display !== 'none'; });
  var count = items.length;
  dotsEl.innerHTML = '';
  if (count < 2) { dotsEl.style.display = 'none'; return; }
  dotsEl.style.display = 'flex';
  items.forEach(function(_, idx) {
    var dot = document.createElement('button');
    dot.className = dotClass + (idx === 0 ? ' active' : '');
    dot.setAttribute('aria-label', 'Карточка ' + (idx + 1));
    dot.onclick = function() {
      var iw = items[idx].offsetWidth + parseInt(getComputedStyle(scrollEl).gap || 10);
      scrollEl.scrollTo({ left: idx * iw, behavior: 'smooth' });
    };
    dotsEl.appendChild(dot);
  });
  function updateDots() {
    var sw = scrollEl.scrollLeft;
    var iw = items[0] ? (items[0].offsetWidth + parseInt(getComputedStyle(scrollEl).gap || 10)) : 1;
    var active = Math.round(sw / iw);
    dotsEl.querySelectorAll('.' + dotClass).forEach(function(d, i){ d.classList.toggle('active', i === active); });
  }
  scrollEl.addEventListener('scroll', updateDots, { passive: true });
}

function renderGalDesktop(imgs, label) {
  const el = document.getElementById('gal-desktop');
  const big = imgs[0], smalls = imgs.slice(1, 5);
  el.innerHTML = `
    <button type="button" data-gi="0"  rounded-lanit-xl overflow-hidden cursor-pointer relative   style="flex:0 0 45%;align-self:stretch">
      <img src="${big.src}" alt="${big.alt}" loading="lazy"  w-full h-full object-cover block   style="transition:transform 0.4s">
      <div  absolute inset-0   style="background:linear-gradient(to top,rgba(0,0,0,0.4),transparent);pointer-events:none"></div>
      ${galBadge('big', label)}
    </button>
    <div  grid gap-lanit-sm   style="flex:1;grid-template-columns:1fr 1fr">
      ${smalls.map((img,si) => `
        <button type="button" data-gi="${si+1}"  rounded-lanit-xl overflow-hidden cursor-pointer relative   style="aspect-ratio:1;min-height:0">
          <img src="${img.src}" alt="${img.alt}" loading="lazy"  w-full h-full object-cover block   style="transition:transform 0.4s">
          <div  absolute inset-0   style="background:linear-gradient(to top,rgba(0,0,0,0.4),transparent);pointer-events:none"></div>
          ${galBadge('small', label)}
        </button>`).join('')}
    </div>`;
  el.querySelectorAll('button[data-gi]').forEach(btn => {
    const img = btn.querySelector('img');
    btn.addEventListener('mouseenter', () => img && (img.style.transform='scale(1.05)'));
    btn.addEventListener('mouseleave', () => img && (img.style.transform=''));
    btn.addEventListener('click', () => openLightbox(galCurrentData[+btn.dataset.gi].src, galCurrentData[+btn.dataset.gi].alt, +btn.dataset.gi));
  });
}

function renderGalMobile(imgs, label) {
  const el = document.getElementById('gal-mobile');
  el.innerHTML = imgs.map((img, i) => `
    <button type="button" data-gi="${i}"  rounded-lanit-lg overflow-hidden cursor-pointer relative flex-shrink-0 bg-lanit-bg3   aspect-[4/3] snap-start style="flex:0 0 82vw;max-width:82vw">
      <img src="${img.src}" alt="${img.alt}" decoding="async"  w-full h-full object-cover block>
      ${galBadge('small', label)}
    </button>`).join('');
  el.querySelectorAll('button[data-gi]').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(galCurrentData[+btn.dataset.gi].src, galCurrentData[+btn.dataset.gi].alt, +btn.dataset.gi));
  });
  el.scrollLeft = 0;
  if (window.innerWidth <= 768) {
    initCarouselDots(el, document.getElementById('gal-dots'), 'gal-dot');
  }
}

function switchGalCat(cat) {
  galCurrentData = galData[cat] || [];
  const label = galLabels[cat] || '';
  document.querySelectorAll('.gal-pill').forEach(b => {
    b.classList.toggle('gal-pill-active', b.dataset.gcat === cat);
  });
  if (window.innerWidth >= 768) renderGalDesktop(galCurrentData, label);
  else renderGalMobile(galCurrentData, label);
}

