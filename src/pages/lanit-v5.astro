let curSmena = 0;
function calcPrice(s, kids) {
  const tier = s.tiers.find(t => kids >= t.min && kids <= t.max);
  if (!tier) return null;
  const disc = tier.disc;
  const pricePerChild = Math.round(s.basePrice * (1 - disc));
  return { disc, pricePerChild, total: pricePerChild * kids, savings: (s.basePrice - pricePerChild) * kids };
}
function fmt(n) { return n.toLocaleString('ru-RU') + ' ₽'; }
function kidsWord(n) { return n === 1 ? 'ребёнок' : n < 5 ? 'ребёнка' : 'детей'; }
function updateCalc() {
  const kids = parseInt(document.getElementById('kids-slider').value);
  document.getElementById('kids-count').textContent = kids;
  const s = smenas[curSmena];
  const groupBlock = document.getElementById('calc-group-result');
  const plusBlock  = document.getElementById('calc-10plus');
  if (kids >= 10) {
    if (groupBlock) groupBlock.style.display = 'none';
    if (plusBlock)  plusBlock.style.display  = '';
    document.getElementById('transfer-note').classList.add('show');
    return;
  }
  if (groupBlock) groupBlock.style.display = '';
  if (plusBlock)  plusBlock.style.display  = 'none';
  const result = calcPrice(s, kids);
  if (!result) return;
  const { disc, pricePerChild } = result;
  document.getElementById('res-pp').textContent = fmt(pricePerChild);
  document.getElementById('res-pp-sub').innerHTML = '<s    style="opacity:.5">' + fmt(s.basePrice) + '</s>';
  document.getElementById('res-disc').textContent = '−' + Math.round(disc * 100) + '%';
  document.getElementById('res-tax').textContent = fmt(Math.round((pricePerChild - 3800 * s.days) * 0.13));
  document.getElementById('transfer-note').classList.remove('show');
}
function selectSmena(i, el) {
  curSmena = i;
  document.querySelectorAll('.stab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const s = smenas[i];
  document.getElementById('smena-label').textContent = s.label + ' · ' + s.dates;
  document.getElementById('smena-tag').textContent = s.tag;
  document.getElementById('smena-meta').textContent = s.days + ' дней · базовая цена ' + fmt(s.basePrice) + ' / ребёнок';
  document.getElementById('smena-desc').textContent = s.desc;
  updateCalc();
}
