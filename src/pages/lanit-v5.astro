  if (!track) return;
  var cards = Array.from(track.querySelectorAll('[data-vopen]'));
  var total = cards.length, offset = 0;
  function update() { cards.forEach(function(c, i) { c.style.order = (i - offset + total) % total; }); }
  var prev = document.getElementById('camp-prev'), next = document.getElementById('camp-next');
  if (prev) prev.addEventListener('click', function() { offset = (offset - 1 + total) % total; update(); });
  if (next) next.addEventListener('click', function() { offset = (offset + 1) % total; update(); });
})();

