---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import { mainShifts } from '../data/shifts';

const shift1 = mainShifts[0]; // Смена 1: 30 мая — 8 июня, 10 дней
const openShifts = mainShifts.slice(1); // Смены 2, 3, 4 — ещё открыты
---

<Base
  title="Как прошла Смена 1 — АйДаКемп 30 мая — 8 июня 2026"
  description="Репортаж о первой смене IT-лагеря АйДаКемп: фотографии, впечатления, проекты ребят. Смена 1, 30 мая — 8 июня 2026."
  heroPreloadDesktop="/images/hero-desktop.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/kak-proshla-smena-1" />
  </Fragment>

  <Header />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden border-b border-white/10" data-hero-bg="glass-orbs">
    <div class="relative z-10 mx-auto max-w-4xl px-4 pt-10 pb-10 md:pt-16 md:pb-14">

      <!-- Бейдж -->
      <div class="inline-flex items-center gap-1.5 rounded-full bg-white/15 border border-white/20 px-3 py-1 text-[12px] font-semibold uppercase tracking-widest text-white/80 backdrop-blur-sm">
        <i class="bi bi-check-circle-fill text-emerald-400 text-[11px]" aria-hidden="true"></i>
        Смена завершена
      </div>

      <!-- Даты крупно -->
      <div class="mt-4 flex items-baseline gap-3">
        <span class="text-[52px] md:text-[72px] font-extrabold leading-none text-white">30</span>
        <span class="text-[24px] md:text-[32px] font-light text-white/60">мая</span>
        <span class="text-[32px] md:text-[44px] font-light text-white/40 mx-1">—</span>
        <span class="text-[52px] md:text-[72px] font-extrabold leading-none text-white">8</span>
        <span class="text-[24px] md:text-[32px] font-light text-white/60">июня</span>
      </div>

      <h1 class="mt-3 text-[22px] md:text-[28px] font-bold text-white leading-snug">
        Смена 1 — Как это было
      </h1>
      <p class="mt-2 text-[15px] text-white/70 max-w-xl leading-relaxed">
        {shift1.description} 10 дней, 45 ребят, один большой хакатон в финале.
      </p>

      <!-- Мета-строка -->
      <div class="mt-5 flex flex-wrap gap-3">
        {[
          { icon: 'calendar-check', text: '10 дней' },
          { icon: 'people-fill',    text: '45 участников' },
          { icon: 'geo-alt-fill',   text: 'Наро-Фоминск' },
          { icon: 'cpu-fill',       text: 'Python · AI · Хакатон' },
        ].map(m => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/15 px-3 py-1.5 text-[13px] text-white/80 backdrop-blur-sm">
            <i class={`bi bi-${m.icon} text-[12px] text-primary`} aria-hidden="true"></i>
            {m.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-8 space-y-10">

    <!-- ── Видео: монтаж ── -->
    <section>
      <h2 class="text-[20px] font-bold text-slate-900 mb-1">Видео со смены</h2>
      <p class="text-[14px] text-slate-500 mb-4">Родители, ребята, гости — глазами тех, кто был рядом</p>
      <div class="relative w-full overflow-hidden rounded-[20px] shadow-lg" style="aspect-ratio: 16/9;">
        <iframe
          src="https://kinescope.io/embed/deHKjpFpDksd6rTUTqcpMX"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          class="absolute inset-0 h-full w-full border-0"
          title="Видео со Смены 1 — АйДаКемп"
        ></iframe>
      </div>
    </section>

    <!-- ── Видео: обзор комнаты ── -->
    <section>
      <h2 class="text-[20px] font-bold text-slate-900 mb-1">Обзор комнаты</h2>
      <p class="text-[14px] text-slate-500 mb-4">Как выглядит пространство, где живут ребята</p>
      <div class="relative w-full overflow-hidden rounded-[20px] shadow-lg" style="aspect-ratio: 16/9;">
        <iframe
          src="https://kinescope.io/embed/5FErXxryfYK85pNFzoe3oh"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          class="absolute inset-0 h-full w-full border-0"
          title="Обзор комнаты — Смена 1 АйДаКемп"
        ></iframe>
      </div>
    </section>

  </div>

  <!-- Галерея — полная ширина -->
  <Gallery
    sections={[{ value: 'smena1', label: 'Смена 1' }]}
    title="Фотографии со смены"
  />

  <main class="mx-auto max-w-4xl px-4 pb-16 space-y-10">

    <!-- ── Отзывы ── -->
    <section>
      <h2 class="text-[20px] font-bold text-slate-900 mb-1">Отзывы родителей и ребят</h2>
      <p class="text-[14px] text-slate-500 mb-4">Яндекс.Карты · Смена 1, июнь 2026 · ★ 5.0</p>

      <!-- Большая плашка Елисеевой — полный текст, на всю ширину -->
      <div class="rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm mb-4">
        <div class="flex items-start justify-between gap-2 mb-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-semibold text-slate-800 text-[14px]">Мария Елисеева</span>
            <span class="text-amber-400 text-[13px]">★★★★★</span>
          </div>
          <span class="shrink-0 text-[12px] text-slate-400">9 июня 2026</span>
        </div>
        <p class="text-[14px] text-slate-600 leading-relaxed">Спасибо большое! Очень удобное расположение. Хорошее питание. Обычно накормить ребенка невозможно. Сказал, что в лагере все было вкусно. Отличная программа. Но самое главное не это, а профессионализм организаторов, педагогов, вожатых! Я мама очень непростого ребенка. И верилось с трудом, что получится провести целую смену. Но получилось! Очень отзывчивые вожатые! Варвара — огромная молодец, все вопросы решались. Ребенок очень тепло отзывался о Леше. Отдельно отмечу занятия. Были в группе у Александра. Ребенок защитил свой проект. Сказал, что очень многому научился. Когда спрашивают, что больше всего понравилось в лагере, отвечает — учеба. Было очень много активностей: футбол, бассейн. Действительно сдавались гаджеты, и детям было чем заняться без них. Вожатые были на связи, все вопросы решались. Мне есть с чем сравнить. Команда «АйДаКемп» действительно умеет и хочет находить общий язык с детьми, родителями и создает уникальную атмосферу! Спасибо огромное! Приедем еще!</p>
      </div>

      <!-- Карусель на мобилке / сетка на десктопе -->
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-3 -mx-4 px-4 scrollbar-none
                  md:grid md:grid-cols-2 md:overflow-visible md:snap-none md:gap-4 md:pb-0 md:mx-0 md:px-0">

        <div class="flex-shrink-0 w-[82vw] snap-start md:w-auto rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-800 text-[14px]">Мария</span>
              <span class="text-amber-400 text-[13px]">★★★★★</span>
            </div>
            <span class="shrink-0 text-[12px] text-slate-400">9 июня 2026</span>
          </div>
          <p class="text-[14px] text-slate-600 leading-relaxed">Очень понравилось в лагере! Спасибо вожатым Варваре и Алексею. Спасибо огромное педагогу Александру. Мы обязательно приедем ещё! Остались только положительные впечатления!</p>
        </div>

        <div class="flex-shrink-0 w-[82vw] snap-start md:w-auto rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-800 text-[14px]">Владимир Федотов</span>
              <span class="text-amber-400 text-[13px]">★★★★★</span>
            </div>
            <span class="shrink-0 text-[12px] text-slate-400">7 июня 2026</span>
          </div>
          <p class="text-[14px] text-slate-600 leading-relaxed">Все понравилось, корпус хороший, условия проживания отличные, еда в столовой вкусная. Прекрасно провёл время — самая удачная, на мой взгляд, поездка.</p>
        </div>

        <div class="flex-shrink-0 w-[82vw] snap-start md:w-auto rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-800 text-[14px]">Демид Слекеничс</span>
              <span class="text-amber-400 text-[13px]">★★★★★</span>
            </div>
            <span class="shrink-0 text-[12px] text-slate-400">7 июня 2026</span>
          </div>
          <p class="text-[14px] text-slate-600 leading-relaxed">Очень крутой лагерь, питание просто огонь, вожатые добрые. Есть хакатон, уроки идут на платформе, преподаватель очень хорошо объясняет.</p>
        </div>

        <div class="flex-shrink-0 w-[82vw] snap-start md:w-auto rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-800 text-[14px]">Жеканик Кухтарик</span>
              <span class="text-amber-400 text-[13px]">★★★★★</span>
            </div>
            <span class="shrink-0 text-[12px] text-slate-400">7 июня 2026</span>
          </div>
          <p class="text-[14px] text-slate-600 leading-relaxed">Лагерь очень крутой, мне очень понравилось. Шашлык в столовке — супер. Я сделал игру. Вожатые супер крутые — поддерживали и помогали.</p>
        </div>

        <div class="flex-shrink-0 w-[82vw] snap-start md:w-auto rounded-[16px] bg-white border border-slate-200 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-800 text-[14px]">Рогов</span>
              <span class="text-amber-400 text-[13px]">★★★★★</span>
            </div>
            <span class="shrink-0 text-[12px] text-slate-400">7 июня 2026</span>
          </div>
          <p class="text-[14px] text-slate-600 leading-relaxed">Очень красивая и зелёная природа, кормят очень хорошо, даже пицца была! Есть большой бассейн. Каждый день дают по 500 дублей игровой валюты — следующий раз ещё раз поеду.</p>
        </div>

      </div>

      <div class="mt-4 flex items-center gap-1.5 text-[12px] text-slate-400">
        <i class="bi bi-star-fill text-amber-400 text-[11px]"></i>
        Отзывы с Яндекс.Карты, июнь 2026
      </div>
    </section>

    <!-- ── CTA — ещё можете успеть ── -->
    <section class="rounded-[24px] bg-gradient-to-br from-orange-50 to-amber-50 border-2 border-primary/20 p-6 md:p-8">
      <div class="flex items-start gap-4">
        <div class="shrink-0 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white">
          <i class="bi bi-sun-fill text-[22px]" aria-hidden="true"></i>
        </div>
        <div class="flex-1">
          <p class="text-[12px] font-bold uppercase tracking-wider text-primary mb-1">Лето ещё не закончилось</p>
          <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 leading-snug">
            Вы ещё можете успеть на лето с нами
          </h2>
          <p class="mt-2 text-[14px] text-slate-600 leading-relaxed max-w-lg">
            Три смены впереди — с июня по август. Места ограничены, бронирование фиксирует цену на 72 часа.
          </p>
          <a
            href="/#shifts"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-[14px] font-semibold text-white hover:bg-primary/90 transition-colors shadow-[0_4px_12px_rgba(236,124,0,0.35)]"
          >
            Выбрать смену
            <i class="bi bi-arrow-right text-[14px]" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Карточки открытых смен -->
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {openShifts.map(s => (
          <a
            href={`/shifts/${s.id}/`}
            class="flex flex-col gap-1 rounded-[16px] bg-white border border-slate-200 px-4 py-3.5 hover:border-primary/40 hover:shadow-md transition-all no-underline group"
          >
            <span class="text-[13px] font-bold text-slate-800 group-hover:text-primary transition-colors">{s.name} · {s.dates}</span>
            <span class="text-[12px] text-slate-500">{s.duration} · {s.price}</span>
            <span class="mt-1 text-[12px] text-primary font-semibold">Выбрать →</span>
          </a>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</Base>
