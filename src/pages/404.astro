---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PHONE_MAIN, PHONE_MAIN_HREF, TELEGRAM_URL, WHATSAPP_URL } from '../data/contacts';

// Популярные страницы куда мог стремиться пользователь
const popular = [
  { title: 'Смены лета 2026', href: '/#shifts', desc: 'Цены, даты, программы' },
  { title: 'Как проходит смена', href: '/#journey', desc: 'День в IT-лагере' },
  { title: 'Команда и менторы', href: '/#team', desc: 'Кто работает с детьми' },
  { title: 'Размещение', href: '/#stay', desc: 'Где живут, как кормят' },
  { title: 'Отзывы родителей', href: '/#reviews', desc: '★ 5.0 на Яндекс.Картах' },
  { title: 'Документы и лицензия', href: '/stati/dokumenty-licenziya-strahovka/', desc: 'Налоговый вычет 13%' },
  { title: 'FAQ', href: '/#faq', desc: 'Частые вопросы' },
];
---

<Base title="Страница не найдена — АйДаКемп">
  <Header />
  <main class="min-h-[80vh] px-4 py-12 md:py-20 md:px-6">
    <div class="mx-auto max-w-[720px]">
      <p class="text-[16px] font-semibold uppercase tracking-wider text-primary">404 — Страница не найдена</p>
      <h1 class="mt-3 text-[32px] md:text-[44px] font-extrabold leading-[1.1] tracking-[-0.03em] text-slate-900">
        Возможно, её переехала<br>или удалили
      </h1>
      <p class="mt-4 text-[16px] leading-[1.6] text-slate-600">
        А может, опечатка в адресе. Вот популярные разделы — наверное, искали что-то отсюда:
      </p>

      <!-- Popular pages -->
      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {popular.map(p => (
          <a
            href={p.href}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-primary/50 hover:shadow-[0_4px_16px_rgba(15,23,42,0.06)]"
          >
            <div class="flex items-center gap-2">
              <span class="text-[16px] font-semibold text-slate-900 group-hover:text-primary transition-colors">{p.title}</span>
              <i class="bi bi-arrow-right text-[14px] text-slate-300 group-hover:text-primary group-hover:translate-x-1 transition-all" aria-hidden="true"></i>
            </div>
            <span class="mt-1 text-[13px] text-slate-500">{p.desc}</span>
          </a>
        ))}
      </div>

      <!-- Site search (placeholder for Pagefind) -->
      <div class="mt-10 rounded-2xl bg-slate-50 p-6 border border-slate-200">
        <label for="search-404" class="block text-[14px] font-semibold text-slate-700 mb-2">
          <i class="bi bi-search text-[14px] mr-1" aria-hidden="true"></i>
          Поиск по сайту
        </label>
        <input
          id="search-404"
          type="search"
          placeholder="Например: Python, бассейн, цены..."
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-[15px] focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          autocomplete="off"
        />
        <p class="mt-2 text-[12px] text-slate-400">
          Поиск ищет по статьям, FAQ и описаниям смен
        </p>
      </div>

      <!-- Direct contact -->
      <div class="mt-10 rounded-2xl bg-[#0d1a2b] p-6 text-white">
        <p class="text-[15px] leading-[1.5] text-white/85">
          Не нашли что искали? <strong class="text-white">Напишите нам</strong> — расскажем что есть.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a href={PHONE_MAIN_HREF} class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2.5 text-[14px] font-medium text-white hover:bg-white/15 transition-colors">
            <i class="bi bi-telephone-fill text-[14px]" aria-hidden="true"></i>
            {PHONE_MAIN}
          </a>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2.5 text-[14px] font-medium text-white hover:bg-white/15 transition-colors">
            <i class="bi bi-telegram text-[14px]" aria-hidden="true"></i>
            Telegram
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2.5 text-[14px] font-medium text-white hover:bg-white/15 transition-colors">
            <i class="bi bi-whatsapp text-[14px]" aria-hidden="true"></i>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Anonymous Q&A -->
      <div class="mt-6 text-center">
        <a href="/ask" class="inline-flex items-center gap-2 text-[14px] font-medium text-primary hover:text-[#d68830] transition-colors">
          <i class="bi bi-shield-lock-fill text-[12px]" aria-hidden="true"></i>
          Или спросите анонимно — ответим без вашего телефона
          <i class="bi bi-arrow-right text-[14px]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
