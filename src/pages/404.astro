---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Страница не найдена — АйДаКемп" hideMarketingWidgets>
  <Header />
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <p class="text-[80px] font-bold leading-none text-slate-200">404</p>
    <h1 class="mt-4 text-[24px] font-bold text-slate-900">Страница не найдена</h1>
    <p class="mt-2 text-base text-slate-500">Возможно, она была удалена или вы перешли по неверной ссылке</p>
    <a href="/" class="mt-6 rounded-xl bg-primary px-6 py-3 text-base font-semibold text-[#0d1a2b] transition hover:shadow-[0_4px_16px_rgba(236,124,0,0.35)]">
      На главную
    </a>
  </div>
  <Footer />
<script>
  // G.81: 404 tracking
  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', () => {
      if (typeof window.ym === 'function') {
        window.ym(96499295, 'reachGoal', '404_error', { url: window.location.pathname });
      }
    });
  }
</script>
</Base>
