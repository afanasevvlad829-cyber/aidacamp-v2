---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';

const lines = [
  { prompt: '$', cmd: 'aidacamp --season=2026 --format=family-friendly' },
  { out: 'Загружаю варианты...' },
  { out: '' },
  { out: '✓ Лагерь Python      — 10 дней — от 48 000 ₽' },
  { out: '✓ Лагерь Minecraft   — 7 дней  — от 48 000 ₽' },
  { out: '✓ Лагерь AI / нейро  — 14 дней — от 95 000 ₽' },
  { out: '✓ Лагерь 3D / Blender — 14 дней — от 89 400 ₽' },
  { out: '' },
  { out: '> Что выбрать? Запускаю помощник...' },
];
---

<Base title="Terminal Demo — T6 Conversion Hero (АйДаКемп)">
  <main class="bg-[#0d1a2b] min-h-screen pt-24 pb-16 px-4">
    <div class="mx-auto max-w-[920px]">

      <!-- Заголовок-описание (вне самого hero) -->
      <div class="text-center text-white/70 mb-8">
        <p class="text-[12px] uppercase tracking-[0.2em] text-white/40 mb-2">T6 — Conversion hero · Demo</p>
        <h1 class="text-[28px] md:text-[36px] font-bold text-white mb-2">Terminal typewriter</h1>
        <p class="text-[14px]">Эффект для страниц <code class="text-orange-400">/ask/</code> и <code class="text-orange-400">/попробовать/</code></p>
      </div>

      <!-- Сам терминал -->
      <div class="bg-[#1a1f2e] rounded-[12px] shadow-[0_24px_60px_rgba(0,0,0,0.5)] overflow-hidden border border-white/5">

        <!-- Title-bar -->
        <div class="flex items-center gap-1.5 px-4 py-3 bg-[#0f1218] border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
          </div>
          <div class="flex-1 text-center text-white/40 text-[12px] font-mono">aidacamp@summer-2026 — bash</div>
          <div class="w-[54px]"></div>
        </div>

        <!-- Body -->
        <pre id="term-body" class="m-0 p-6 md:p-8 text-[13px] md:text-[15px] font-mono leading-[1.7] text-[#a8e6cf] whitespace-pre-wrap min-h-[360px] overflow-hidden"
             data-lines={JSON.stringify(lines)}><span id="term-text"></span><span id="term-cursor" class="inline-block w-[8px] h-[18px] bg-[#a8e6cf] align-middle ml-[2px] animate-[blink_1s_steps(2)_infinite]"></span></pre>

        <!-- CTAs внизу терминала -->
        <div id="term-cta" class="px-6 md:px-8 pb-6 md:pb-8 pt-2 flex flex-wrap gap-3 opacity-0 transition-opacity duration-700">
          <a href="/#shifts" class="inline-flex items-center justify-center gap-2 rounded-[8px] bg-primary hover:bg-[#d4700a] text-white font-bold px-6 py-3 text-[15px] transition-colors">
            Выбрать смену <span aria-hidden="true">→</span>
          </a>
          <a href="tel:+74951284429" class="inline-flex items-center justify-center gap-2 rounded-[8px] border border-white/20 hover:border-white/40 text-white font-semibold px-6 py-3 text-[15px] transition-colors">
            +7 (495) 128-44-29
          </a>
        </div>
      </div>

      <!-- Сравнение / описание -->
      <div class="mt-12 bg-white/5 rounded-[12px] p-6 text-white/75 text-[14px] leading-[1.6]">
        <h2 class="text-white font-bold mb-3 text-[16px]">Зачем такой эффект</h2>
        <ul class="space-y-2 list-none">
          <li class="flex gap-3"><span class="text-orange-400">→</span><span>Айтишная эстетика терминала вызывает доверие у целевой аудитории (родители-IT, дети-программисты)</span></li>
          <li class="flex gap-3"><span class="text-orange-400">→</span><span>Анимация печати захватывает внимание на 3-4 секунды — а на конверсионной странице это много</span></li>
          <li class="flex gap-3"><span class="text-orange-400">→</span><span>Контраст с T2/T3 эффектами (mesh/noise/grid градиенты) сигнализирует «здесь важное действие»</span></li>
          <li class="flex gap-3"><span class="text-orange-400">→</span><span>CTA появляется через ~3.5 сек после начала печати — момент когда внимание уже зацеплено</span></li>
        </ul>
      </div>

      <!-- Replay button -->
      <div class="text-center mt-6">
        <button id="term-replay" class="text-white/40 hover:text-white text-[13px] underline underline-offset-2">↻ Запустить заново</button>
      </div>

    </div>
  </main>

  <style>
    @keyframes blink { 50% { opacity: 0; } }
    @keyframes scanline {
      0%   { transform: translateY(0); }
      100% { transform: translateY(100%); }
    }
  </style>

  <script>
    function runTerminal() {
      const body = document.getElementById('term-body');
      const text = document.getElementById('term-text');
      const cta = document.getElementById('term-cta');
      const cursor = document.getElementById('term-cursor');
      if (!body || !text || !cta || !cursor) return;
      const lines = JSON.parse(body.dataset.lines || '[]');

      text.innerHTML = '';
      cta.style.opacity = '0';
      cursor.style.display = 'inline-block';

      let lineIdx = 0;
      let charIdx = 0;
      let html = '';

      function step() {
        if (lineIdx >= lines.length) {
          // done — show CTA
          cursor.style.opacity = '0.4';
          setTimeout(() => { cta.style.opacity = '1'; }, 400);
          return;
        }

        const line = lines[lineIdx];
        const fullLine = line.prompt
          ? `<span class="text-[#5cf2ff]">${line.prompt}</span> <span class="text-white">${line.cmd}</span>`
          : `<span class="text-[#a8e6cf]">${line.out}</span>`;
        const rawLine = line.prompt ? `${line.prompt} ${line.cmd}` : (line.out || '');

        if (charIdx === 0 && rawLine === '') {
          // empty line — skip immediately
          html += '\n';
          text.innerHTML = html;
          lineIdx++;
          setTimeout(step, 80);
          return;
        }

        if (charIdx <= rawLine.length) {
          // For prompt lines: show prompt instantly, type the command
          // For output lines: type char by char with brief delay
          const partial = rawLine.slice(0, charIdx);
          if (line.prompt) {
            html_now = html + `<span class="text-[#5cf2ff]">${line.prompt}</span> <span class="text-white">${partial.slice(line.prompt.length + 1)}</span>`;
          } else {
            html_now = html + `<span class="text-[#a8e6cf]">${partial}</span>`;
          }
          text.innerHTML = html_now;
          charIdx++;
          // Speed: prompt cmds slower, output faster
          const delay = line.prompt ? 35 : 18;
          setTimeout(step, delay);
        } else {
          // Line done — commit to permanent html, newline, next line
          html += fullLine + '\n';
          text.innerHTML = html;
          charIdx = 0;
          lineIdx++;
          // Pause longer between blocks
          const pause = line.prompt ? 350 : 120;
          setTimeout(step, pause);
        }
      }

      let html_now = '';
      step();
    }

    // Auto-run on load
    document.addEventListener('astro:page-load', runTerminal);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      runTerminal();
    }

    // Replay button
    document.getElementById('term-replay')?.addEventListener('click', runTerminal);
  </script>
</Base>
