        ctx.globalAlpha = 1;
        requestAnimationFrame(loop);
      }
      loop();
    }

    /* ===== INTERACTIVE STARS (constellation) ===== */
    function initInteractiveStars(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      let mouse = { x: -1000, y: -1000 };
      cnv.addEventListener('mousemove', (e) => { const rect = cnv.getBoundingClientRect(); mouse.x = e.clientX - rect.left; mouse.y = e.clientY - rect.top; });
      cnv.addEventListener('mouseleave', () => { mouse.x = -1000; mouse.y = -1000; });
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); });
      const stars = [];
      for (let i = 0; i < 110; i++) stars.push({ x: Math.random()*w, y: Math.random()*h, vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4, r: Math.random()*1.4 + 0.6 });
      function loop() {
        const grad = ctx.createLinearGradient(0, 0, 0, h);
        grad.addColorStop(0, '#02021e'); grad.addColorStop(1, '#08104d');
        ctx.fillStyle = grad; ctx.fillRect(0, 0, w, h);
        for (const s of stars) {
          s.x += s.vx; s.y += s.vy;
          if (s.x < 0) s.x = w; if (s.x > w) s.x = 0;
          if (s.y < 0) s.y = h; if (s.y > h) s.y = 0;
          ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI*2); ctx.fillStyle = '#fff'; ctx.fill();
        }
        // Lines between close stars
        ctx.lineWidth = 0.5;
        for (let i = 0; i < stars.length; i++) {
          for (let j = i+1; j < stars.length; j++) {
            const dx = stars[i].x - stars[j].x, dy = stars[i].y - stars[j].y, d = Math.sqrt(dx*dx + dy*dy);
            if (d < 90) { ctx.strokeStyle = `rgba(255,255,255,${0.3 * (1 - d/90)})`; ctx.beginPath(); ctx.moveTo(stars[i].x, stars[i].y); ctx.lineTo(stars[j].x, stars[j].y); ctx.stroke(); }
          }
          // Lines to mouse
          const dx = stars[i].x - mouse.x, dy = stars[i].y - mouse.y, d = Math.sqrt(dx*dx + dy*dy);
          if (d < 130) { ctx.strokeStyle = `rgba(150,200,255,${0.7 * (1 - d/130)})`; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(stars[i].x, stars[i].y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke(); }
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    function fitCanvas(cnv) {
      const dpr = window.devicePixelRatio || 1;
      const rect = cnv.parentElement.getBoundingClientRect();
      cnv.width = rect.width * dpr; cnv.height = rect.height * dpr;
      cnv.style.width = rect.width + 'px'; cnv.style.height = rect.height + 'px';
      const ctx = cnv.getContext('2d'); ctx.scale(dpr, dpr);
      return { ctx, w: rect.width, h: rect.height };
    }

    function initAurora(cnv) {
      let { ctx, w: W, h: H } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w: W, h: H } = fitCanvas(cnv)); });
      const stars = [];
      for (let i = 0; i < 180; i++) stars.push({ x: Math.random()*W, y: Math.random()*H*0.75, size: Math.random()*1.6+0.3, twinkle: Math.random()*Math.PI*2, twinkleSpeed: Math.random()*0.025+0.008, brightness: Math.random()*0.5+0.4 });
      const bands = [
        { yBase: 0.20, amp: 35, fa: 0.0028, fb: 0.0065, sa: 0.007, sb: 0.011, color: [0,255,140], alpha: 0.3, thick: 0.15 },
        { yBase: 0.32, amp: 28, fa: 0.0035, fb: 0.0080, sa: 0.010, sb: 0.015, color: [0,190,255], alpha: 0.25, thick: 0.12 },
        { yBase: 0.45, amp: 22, fa: 0.0045, fb: 0.0055, sa: 0.006, sb: 0.009, color: [130,0,255], alpha: 0.2, thick: 0.10 },
      ];
      let t = 0;
      function loop() {
        ctx.fillStyle = '#000208'; ctx.fillRect(0, 0, W, H);
        for (const s of stars) { s.twinkle += s.twinkleSpeed; const a = s.brightness + Math.sin(s.twinkle)*0.35; ctx.beginPath(); ctx.arc(s.x, s.y, s.size, 0, Math.PI*2); ctx.fillStyle = `rgba(220,240,255,${Math.max(0, Math.min(1, a))})`; ctx.fill(); }
        for (const b of bands) {
          t += 0.18;
          const pts = [];
          for (let i = 0; i <= 80; i++) { const x = (i/80)*W; const wave = Math.sin(x*b.fa + t*b.sa)*b.amp + Math.sin(x*b.fb + t*b.sb)*(b.amp*0.55); pts.push({ x, y: H*b.yBase + wave }); }
          const bandH = H*b.thick;
          ctx.beginPath(); ctx.moveTo(0, pts[0].y - bandH);
          for (const p of pts) ctx.lineTo(p.x, p.y - bandH);
          for (let i = pts.length-1; i >= 0; i--) ctx.lineTo(pts[i].x, pts[i].y);
          ctx.closePath();
          const grad = ctx.createLinearGradient(0, pts[0].y - bandH, 0, pts[0].y + bandH*0.5);
          grad.addColorStop(0, `rgba(${b.color[0]},${b.color[1]},${b.color[2]},0)`);
          grad.addColorStop(0.5, `rgba(${b.color[0]},${b.color[1]},${b.color[2]},${b.alpha})`);
          grad.addColorStop(1, `rgba(${b.color[0]},${b.color[1]},${b.color[2]},0)`);
          ctx.fillStyle = grad; ctx.fill();
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    function initQuantum(cnv) {
      let { ctx, w: W, h: H } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w: W, h: H } = fitCanvas(cnv)); });
      const config = { count: 60, base: '#ec7c00', accent: '#f5a624', conn: 110 };
      const particles = [];
      for (let i = 0; i < config.count; i++) particles.push({ x: Math.random()*W, y: Math.random()*H, vx: (Math.random()-0.5)*1.2, vy: (Math.random()-0.5)*1.2, r: Math.random()*1.5+1, accent: Math.random() > 0.8 });
      function loop() {
        ctx.fillStyle = '#0d1a2b'; ctx.fillRect(0, 0, W, H); ctx.lineWidth = 0.8;
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i]; p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx.fillStyle = p.accent ? config.accent : config.base; ctx.fill();
          for (let j = i+1; j < particles.length; j++) {
            const dx = p.x - particles[j].x, dy = p.y - particles[j].y, d = Math.sqrt(dx*dx + dy*dy);
            if (d < config.conn) {
              const a = Math.floor((1 - d/config.conn)*200).toString(16).padStart(2, '0');
              ctx.strokeStyle = (p.accent ? config.accent : config.base) + a;
              ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(particles[j].x, particles[j].y); ctx.stroke();
            }
          }
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    function initFireflies(cnv) {
      let { ctx, w: W, h: H } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w: W, h: H } = fitCanvas(cnv)); });
      const flies = [];
      for (let i = 0; i < 35; i++) flies.push({ x: Math.random()*W, y: Math.random()*H, vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4, phase: Math.random()*Math.PI*2, phaseSpeed: 0.02 + Math.random()*0.03, r: 1 + Math.random()*1.5 });
      function loop() {
        ctx.fillStyle = 'rgba(8,18,12,0.18)'; ctx.fillRect(0, 0, W, H);
        for (const f of flies) {
          f.x += f.vx; f.y += f.vy; f.phase += f.phaseSpeed;
          if (f.x < 0 || f.x > W) f.vx *= -1; if (f.y < 0 || f.y > H) f.vy *= -1;
          const glow = (Math.sin(f.phase)+1)/2; const a = 0.3 + glow*0.7;
          const grad = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r*6);
          grad.addColorStop(0, `rgba(255,230,100,${a})`); grad.addColorStop(0.4, `rgba(180,220,80,${a*0.4})`); grad.addColorStop(1, 'transparent');
          ctx.fillStyle = grad; ctx.beginPath(); ctx.arc(f.x, f.y, f.r*(1+glow*0.5), 0, Math.PI*2); ctx.fill();
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    function initCircuit(cnv) {
      let { ctx, w: W, h: H } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w: W, h: H } = fitCanvas(cnv)); });
      class T { constructor(){this.reset();} reset(){this.x=Math.random()*W; this.y=Math.random()*H; this.speed=1.5+Math.random(); this.angle=Math.floor(Math.random()*4)*(Math.PI/2); this.life=0; this.maxLife=100+Math.random()*200; this.hue=200+Math.random()*60;} update(){this.x+=Math.cos(this.angle)*this.speed; this.y+=Math.sin(this.angle)*this.speed; this.life++; if(Math.random()<0.04) this.angle += (Math.random()<0.5?1:-1)*Math.PI/2; if(this.x<0||this.x>W||this.y<0||this.y>H||this.life>this.maxLife) this.reset();} draw(){ctx.beginPath(); ctx.arc(this.x, this.y, 1.5, 0, Math.PI*2); ctx.fillStyle=`hsla(${this.hue},90%,75%,1)`; ctx.fill();} }
      const tracers = []; for (let i = 0; i < 35; i++) tracers.push(new T());
      function loop() { ctx.fillStyle='rgba(5,5,16,0.05)'; ctx.fillRect(0,0,W,H); for (const t of tracers){t.update(); t.draw();} requestAnimationFrame(loop); }
      loop();
    }

    function initFiber(cnv) {
      let { ctx, w, h } = fitCanvas(cnv); let cx = w/2, cy = h/2;
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); cx = w/2; cy = h/2; });
      const particles = [];
      const make = () => { const angle = Math.random()*Math.PI*2; const radius = Math.random()*(w/3); return { z: Math.random()*w, x: cx + Math.cos(angle)*radius, y: cy + Math.sin(angle)*radius, speed: 0.4 + Math.random()*0.9, hue: 180 + Math.random()*50 }; };
      for (let i = 0; i < 280; i++) particles.push(make());
      function loop() {
        ctx.fillStyle = 'rgba(0,0,0,0.1)'; ctx.fillRect(0, 0, w, h);
        for (const p of particles) {
          p.z -= p.speed; if (p.z < 1) Object.assign(p, make());
          const scale = w/p.z; const x2d = (p.x-cx)*scale + cx; const y2d = (p.y-cy)*scale + cy;
          const ps = w/(p.z + p.speed*10); const px2 = (p.x-cx)*ps + cx; const py2 = (p.y-cy)*ps + cy;
          ctx.beginPath(); ctx.moveTo(px2, py2); ctx.lineTo(x2d, y2d);
          ctx.lineWidth = scale*1.5;
          ctx.strokeStyle = `hsla(${p.hue},80%,60%,${0.1 + 0.8*(1 - p.z/w)})`; ctx.stroke();
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    function initHexagons(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      const opts = { len: 18, count: 35, baseTime: 10, addedTime: 10, dieChance: 0.05, spawnChance: 1, sparkChance: 0.1, sparkDist: 10, sparkSize: 2, baseLight: 50, addedLight: 10, shadowToTimePropMult: 6, baseLightInputMultiplier: 0.01, addedLightInputMultiplier: 0.02, repaintAlpha: 0.05, hueChange: 0.1 };
      let cx = w/2, cy = h/2; let dieX = w/2/opts.len, dieY = h/2/opts.len;
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); cx = w/2; cy = h/2; dieX = w/2/opts.len; dieY = h/2/opts.len; });
      const baseRad = Math.PI*2/6; const lines = []; let tick = 0;
      ctx.fillStyle = 'black'; ctx.fillRect(0, 0, w, h);
      class L { constructor(){this.reset();} reset(){this.x=0;this.y=0;this.addedX=0;this.addedY=0;this.rad=0;this.lightInputMultiplier=opts.baseLightInputMultiplier+opts.addedLightInputMultiplier*Math.random();this.color=`hsl(${tick*opts.hueChange},100%,light%)`;this.cumulativeTime=0;this.beginPhase();} beginPhase(){this.x+=this.addedX;this.y+=this.addedY;this.time=0;this.targetTime=(opts.baseTime+opts.addedTime*Math.random())|0;this.rad+=baseRad*(Math.random()<0.5?1:-1);this.addedX=Math.cos(this.rad);this.addedY=Math.sin(this.rad);if(Math.random()<opts.dieChance||this.x>dieX||this.x<-dieX||this.y>dieY||this.y<-dieY) this.reset();} step(){this.time++;this.cumulativeTime++;if(this.time>=this.targetTime) this.beginPhase();const prop=this.time/this.targetTime;const wave=Math.sin(prop*Math.PI/2);const x=this.addedX*wave,y=this.addedY*wave;ctx.shadowBlur=prop*opts.shadowToTimePropMult;const light=opts.baseLight+opts.addedLight*Math.sin(this.cumulativeTime*this.lightInputMultiplier);ctx.fillStyle=ctx.shadowColor=this.color.replace('light',light);ctx.fillRect(cx+(this.x+x)*opts.len, cy+(this.y+y)*opts.len, 2, 2);if(Math.random()<opts.sparkChance){ctx.fillRect(cx+(this.x+x)*opts.len+Math.random()*opts.sparkDist*(Math.random()<0.5?1:-1)-opts.sparkSize/2, cy+(this.y+y)*opts.len+Math.random()*opts.sparkDist*(Math.random()<0.5?1:-1)-opts.sparkSize/2, opts.sparkSize, opts.sparkSize);}} }
      function loop() { requestAnimationFrame(loop); tick++; ctx.globalCompositeOperation='source-over'; ctx.shadowBlur=0; ctx.fillStyle=`rgba(0,0,0,${opts.repaintAlpha})`; ctx.fillRect(0,0,w,h); ctx.globalCompositeOperation='lighter'; if(lines.length<opts.count && Math.random()<opts.spawnChance) lines.push(new L()); for(const line of lines) line.step(); }
      loop();
    }

    function initNeonNetwork(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); });
      const particles = [];
      for (let i = 0; i < 50; i++) particles.push({ x: Math.random()*w, y: Math.random()*h, vx: (Math.random()-0.5)*0.8, vy: (Math.random()-0.5)*0.8, r: 2, hue: Math.random()*360 });
      let hueShift = 0;
      function loop() {
        ctx.fillStyle = 'rgba(10,14,26,0.15)'; ctx.fillRect(0, 0, w, h);
        hueShift = (hueShift + 0.3) % 360;
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i]; p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1;
          const hue = (p.hue + hueShift) % 360;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
          ctx.fillStyle = `hsl(${hue},80%,60%)`; ctx.shadowColor = `hsl(${hue},90%,60%)`; ctx.shadowBlur = 8; ctx.fill(); ctx.shadowBlur = 0;
          for (let j = i+1; j < particles.length; j++) {
            const dx = p.x - particles[j].x, dy = p.y - particles[j].y, d = Math.sqrt(dx*dx + dy*dy);
            if (d < 100) { ctx.strokeStyle = `hsla(${hue},80%,60%,${1 - d/100})`; ctx.lineWidth = 0.6; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(particles[j].x, particles[j].y); ctx.stroke(); }
          }
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    /* === VOXEL PARIS — упрощённая мини-версия (минимальный город + Эйфелева башня) === */
    function initVoxelParis(container) {
      if (!container) return;
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
      script.onload = () => buildScene(container);
      document.head.appendChild(script);
    }

    function buildScene(container) {
      const W = container.clientWidth, H = container.clientHeight;
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x87CEEB);
      scene.fog = new THREE.Fog(0x87CEEB, 80, 250);
      const camera = new THREE.PerspectiveCamera(60, W/H, 1, 800);
      camera.position.set(0, 60, 150);
      const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(W, H);
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 0.7));
      const dir = new THREE.DirectionalLight(0xffffee, 1);
      dir.position.set(-100, 200, -200);
      scene.add(dir);

      // Sun (солнышко!)
      const sunGeo = new THREE.SphereGeometry(20, 16, 16);
      const sun = new THREE.Mesh(sunGeo, new THREE.MeshBasicMaterial({ color: 0xffcc00 }));
      sun.position.set(-100, 120, -250); scene.add(sun);

      // Eiffel Tower (упрощённая)
      const towerMat = new THREE.MeshLambertMaterial({ color: 0x807060 });
      const towerGroup = new THREE.Group();
      for (let y = 0; y < 30; y++) {
        const sz = Math.max(1, 10 - y * 0.3);
        for (let dx = -1; dx <= 1; dx++) for (let dz = -1; dz <= 1; dz++) {
          if (Math.abs(dx) === 1 || Math.abs(dz) === 1) {
            const m = new THREE.Mesh(new THREE.BoxGeometry(2,2,2), towerMat);
            m.position.set(dx * sz, y * 2, dz * sz);
            towerGroup.add(m);
          }
        }
      }
      towerGroup.position.y = -10; scene.add(towerGroup);

      // Ground
      const ground = new THREE.Mesh(new THREE.PlaneGeometry(400,400), new THREE.MeshLambertMaterial({ color: 0x5c8a3c }));
      ground.rotation.x = -Math.PI/2; ground.position.y = -10; scene.add(ground);

      // Buildings around (random voxel cubes)
      for (let i = 0; i < 80; i++) {
        const x = (Math.random()-0.5) * 200;
        const z = (Math.random()-0.5) * 200;
        if (Math.abs(x) < 25 && Math.abs(z) < 25) continue;
        const h = 4 + Math.random() * 14;
        const m = new THREE.Mesh(new THREE.BoxGeometry(6, h, 6), new THREE.MeshLambertMaterial({ color: new THREE.Color().setHSL(0.08 + Math.random()*0.05, 0.3, 0.5 + Math.random()*0.2) }));
        m.position.set(x, h/2 - 10, z); scene.add(m);
      }

      // Clouds
      const cloudMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.8 });
      for (let i = 0; i < 12; i++) {
        const c = new THREE.Mesh(new THREE.BoxGeometry(20+Math.random()*15, 6, 14+Math.random()*10), cloudMat);
        c.position.set((Math.random()-0.5)*300, 90 + Math.random()*30, (Math.random()-0.5)*300); scene.add(c);
      }

      let t = 0;
      function animate() {
        requestAnimationFrame(animate);
        t += 0.005;
        camera.position.x = Math.sin(t) * 150;
        camera.position.z = Math.cos(t) * 150;
        camera.lookAt(0, 30, 0);
        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        const w = container.clientWidth, h = container.clientHeight;
        camera.aspect = w/h; camera.updateProjectionMatrix(); renderer.setSize(w, h);
      });
    }
  </script>
