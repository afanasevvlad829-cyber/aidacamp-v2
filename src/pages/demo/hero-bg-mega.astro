  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // На mobile — все эффекты CSS-fallback из @media. JS не запускаем.
      const isMobile = window.matchMedia('(max-width: 768px)').matches || /Mobi|Android/i.test(navigator.userAgent);
      if (isMobile) return;
      // === DATA TUNNEL packets ===
      const dt = document.getElementById('dt-scene');
      if (dt) {
        const tickers = ['BTC/USD', 'ETH/USD', 'USD/CAD', 'MSFT', 'AMZN', 'EUR/GBP', 'SOL/USD', 'XRP/JPY', 'AAPL'];
        for (let i = 0; i < 38; i++) {
          const ticker = tickers[i % tickers.length];
          const isUp = Math.random() > 0.5;
          const value = (1 + Math.random() * 9999).toFixed(2);
          const change = (Math.random() * 3).toFixed(2);
          const p = document.createElement('div'); p.className = 'dt-packet';
          p.innerHTML = `${ticker} ${value} <span class="${isUp ? 'dt-up' : 'dt-down'}">${isUp ? '▲' : '▼'}${change}%</span>`;
          p.style.setProperty('--x', Math.random() * 80 + 10);
          p.style.setProperty('--y', Math.random() * 80 + 10);
          p.style.setProperty('--d', Math.random() * 10);
          dt.appendChild(p);
        }
      }
      // === FINANCIAL STREAM packets ===
      const fs = document.getElementById('fs-scene');
      if (fs) {
        const tickers = ['BTC/USD', 'ETH/USD', 'EUR/USD', 'USD/JPY', 'GBP/CHF', 'AAPL', 'TSLA', 'SOL/EUR', 'XRP/USD'];
        for (let i = 0; i < 36; i++) {
          const ticker = tickers[i % tickers.length];
          const isUp = Math.random() > 0.5;
          const change = (Math.random() * 2.5).toFixed(2);
          const p = document.createElement('div'); p.className = 'fs-packet';
          p.innerHTML = `${ticker} <span class="${isUp ? 'fs-up' : 'fs-down'}">${isUp ? '▲' : '▼'} ${change}%</span>`;
          p.style.setProperty('--y', Math.random() * 95);
          p.style.setProperty('--d', Math.random() * 10);
          p.style.animationDuration = `${Math.random() * 5 + 7}s`;
          p.style.transform = `scale(${Math.random() * 0.4 + 0.8})`;
          fs.appendChild(p);
        }
      }
      // === HYPERSPACE stars ===
      const hs = document.getElementById('hs-hyperspace');
      if (hs) {
        for (let i = 0; i < 240; i++) {
          const sf = document.createElement('div'); sf.className = 'hs-star-field';
          sf.style.setProperty('--ang', `${Math.random() * 360}deg`);
          const s = document.createElement('div'); s.className = 'hs-star';
          s.style.animationDelay = `${Math.random() * -4}s`;
          s.style.animationDuration = `${2 + Math.random() * 2}s`;
          sf.appendChild(s); hs.appendChild(sf);
        }
      }

      // === STAR GENESIS ===
      const sgStatic = document.getElementById('sg-static');
      const sgForm = document.getElementById('sg-form');
      if (sgStatic && sgForm) {
        for (let i = 0; i < 120; i++) {
          const s = document.createElement('div'); s.className = 'sg-static-star';
          const sz = Math.random() * 1.5;
          s.style.width = sz + 'px'; s.style.height = sz + 'px';
          s.style.left = Math.random() * 100 + '%'; s.style.top = Math.random() * 100 + '%';
          s.style.animationDelay = (Math.random() * -10) + 's';
          sgStatic.appendChild(s);
        }
        for (let i = 0; i < 35; i++) {
          const s = document.createElement('div'); s.className = 'sg-forming-star';
          s.style.left = Math.random() * 100 + '%'; s.style.top = Math.random() * 100 + '%';
          s.style.animationDelay = (Math.random() * -10) + 's';
          sgForm.appendChild(s);
        }
      }

      // === COSMIC stars ===
      const cm = document.getElementById('cm-scene');
      if (cm) {
        for (let i = 0; i < 140; i++) {
          const s = document.createElement('div'); s.className = 'cm-star';
          const size = Math.random() * 2.5 + 0.5;
          s.style.width = size + 'px'; s.style.height = size + 'px';
          s.style.left = Math.random() * 100 + '%'; s.style.top = Math.random() * 100 + '%';
          s.style.setProperty('--dur', (Math.random() * 4 + 2) + 's');
          s.style.setProperty('--del', (Math.random() * 5) + 's');
          s.style.setProperty('--glow', (size * 3) + 'px');
          cm.appendChild(s);
        }
        // Periodic shooting stars
        setInterval(() => {
          if (Math.random() > 0.4) {
            const ss = document.createElement('div'); ss.className = 'cm-shooting';
            ss.style.left = (Math.random() * 90) + '%';
            ss.style.top = (Math.random() * 50) + '%';
            const dur = Math.random() * 1 + 0.8;
            ss.style.animation = `cm-shoot ${dur}s linear`;
            cm.appendChild(ss);
            setTimeout(() => ss.remove(), dur * 1000);
          }
        }, 2200);
      }

      // === ASCENDANT motes ===
      const am = document.getElementById('al-motes');
      if (am) {
        for (let i = 0; i < 30; i++) {
          const m = document.createElement('div'); m.className = 'al-mote';
          const size = Math.random() * 3 + 1;
          m.style.width = size + 'px'; m.style.height = size + 'px';
          m.style.left = (Math.random() * 100) + '%';
          m.style.animationDelay = (Math.random() * -10) + 's';
          m.style.animationDuration = (Math.random() * 5 + 8) + 's';
          am.appendChild(m);
        }
      }

      // === HEX CODE WAVE ===
      const hg = document.getElementById('hc-grid');
      if (hg) {
        const chars = '0123456789ABCDEF'.split('');
        const cols = Math.floor((hg.clientWidth || 1280) / 16);
        const rows = Math.floor((hg.parentElement.clientHeight || 520) / 18);
        hg.style.setProperty('--cols', cols);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const c = document.createElement('span'); c.className = 'hc-char';
            c.textContent = chars[Math.floor(Math.random() * chars.length)];
            c.style.animationDelay = ((x + y * 0.5) * 0.05) + 's';
            hg.appendChild(c);
          }
        }
      }

      // === CRT BOOT ===
      const crt = document.getElementById('crt-screen');
      if (crt) {
        const bootLines = [
          'AIDA-BIOS v3.42  © 2026 АйДаКемп Systems',
          'Memory test: 8192K OK',
          '',
          'Detecting hardware...',
          '  CPU      : Intel® Core™ i7-13700K  ✓',
          '  Memory   : 32GB DDR5-6000          ✓',
          '  GPU      : NVIDIA RTX 4070         ✓',
          '  Audio    : Realtek HD Audio        ✓',
          '  Network  : 1 Gbps Ethernet         ✓',
          '',
          'Loading kernel modules...',
          '  [OK] python3.12',
          '  [OK] minecraft-server-1.20.4',
          '  [OK] roblox-studio',
          '  [OK] blender-4.0',
          '  [OK] tensorflow-gpu',
          '',
          'Mounting /home/camper... OK',
          'Starting AidaCamp shell...',
          '',
          'AidaCamp 2026 ready. Welcome, ребята.',
          '',
          'aidacamp@summer-2026:~$ ',
        ];
        function runCrt() {
          crt.innerHTML = '';
          bootLines.forEach((t, i) => {
            const p = document.createElement('p'); p.className = 'crt-line';
            p.textContent = t || ' ';
            p.style.animationDelay = (i * 0.18) + 's';
            crt.appendChild(p);
          });
          // Cursor on last line
          setTimeout(() => {
            const cur = document.createElement('span'); cur.className = 'crt-cursor';
            const last = crt.lastChild;
            if (last) last.appendChild(cur);
          }, bootLines.length * 180 + 100);
        }
        runCrt();
        setInterval(runCrt, 12000);
      }

      // === KERNEL PANIC ===
      const kp = document.getElementById('kp-container');
      if (kp) {
        const lines = [
          '*** KERNEL_PANIC - not syncing: VFS: Unable to mount root fs',
          'CPU: 0 PID: 1 Comm: swapper/0 Not tainted 5.4.0-aidacamp',
          'Hardware name: AidaCamp Server / IT-camp 2026',
          'Call Trace:',
          ' dump_stack+0x6d/0x9a',
          ' panic+0x101/0x2e3',
          ' kernel_init+0x13c/0x140',
          ' return_from_camp+0x1f/0x40',
          'Registers:',
          ' RAX: 0000000000000000  RBX: ffffffff82040d80',
          ' RDX: 0000000000000000  RSI: ffffffff821f5e88',
          '---[ end Kernel panic — рестарт через 10 сек ]---',
        ];
        function runKp() {
          kp.innerHTML = `<h4>!! KERNEL FAULT !!</h4>`;
          lines.forEach((t, i) => {
            const p = document.createElement('p'); p.className = 'kp-line';
            p.textContent = t; p.style.animationDelay = (i * 0.1) + 's';
            kp.appendChild(p);
          });
        }
        runKp();
        setInterval(runKp, 10000);
      }

      // === Lazy-init Canvas effects (НЕ на мобилке — там CSS-fallback) ===
      const isMobile = window.matchMedia('(max-width: 768px)').matches || /Mobi|Android/i.test(navigator.userAgent);
      if (isMobile) return; // на mobile все эффекты — CSS-fallback из @media block
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && !e.target.dataset.fxInited) {
            e.target.dataset.fxInited = '1';
            const fx = e.target.dataset.mega;
            const cnv = e.target.querySelector('.mega-canvas');
            if (fx === 'aurora' && cnv)             initAurora(cnv);
            if (fx === 'quantum' && cnv)            initQuantum(cnv);
            if (fx === 'fireflies' && cnv)          initFireflies(cnv);
            if (fx === 'circuit' && cnv)            initCircuit(cnv);
            if (fx === 'fiber' && cnv)              initFiber(cnv);
            if (fx === 'hexagons' && cnv)           initHexagons(cnv);
            if (fx === 'neon-network' && cnv)       initNeonNetwork(cnv);
            if (fx === 'matrix-rain' && cnv)        initMatrix(cnv);
            if (fx === 'particle-flow' && cnv)      initParticleFlow(cnv);
            if (fx === 'interactive-stars' && cnv)  initInteractiveStars(cnv);
            if (fx === 'voxel-paris')               initVoxelParis(e.target.querySelector('#vp-scene'));
          }
        });
      }, { rootMargin: '300px' });
      document.querySelectorAll('[data-mega]').forEach(el => observer.observe(el));
    });

    /* ===== MATRIX RAIN ===== */
    function initMatrix(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); });
      const characterSize = 16;
      let drops = [];
      function reset() {
        const cols = Math.floor(w / characterSize);
        drops = []; for (let i = 0; i < cols; i++) drops.push(Math.random() * h);
      }
      reset();
      function draw() {
        ctx.fillStyle = 'rgba(13,17,23,0.05)'; ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = '#00ff41'; ctx.font = `${characterSize}px monospace`;
        for (let i = 0; i < drops.length; i++) {
          const text = (Math.random() < 0.5 ? '0' : '1');
          ctx.fillText(text, i * characterSize, drops[i]);
          if (drops[i] > h && Math.random() > 0.975) drops[i] = 0;
          drops[i] += characterSize;
        }
      }
      setInterval(draw, 50);
    }

    /* ===== PARTICLE FLOW (150 colorful) ===== */
    function initParticleFlow(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); });
      const palette = ['#a78bfa','#f472b6','#22d3ee','#fde047','#84cc16'];
      const particles = [];
      for (let i = 0; i < 100; i++) particles.push({
        x: Math.random()*w, y: Math.random()*h,
        vx: (Math.random()-0.5)*1.4, vy: (Math.random()-0.5)*1.4,
        r: Math.random()*2 + 1.5,
        c: palette[Math.floor(Math.random()*palette.length)],
        op: Math.random()*0.5 + 0.5
      });
      function loop() {
        ctx.fillStyle = 'rgba(15, 5, 25, 0.15)'; ctx.fillRect(0, 0, w, h);
        ctx.lineWidth = 0.6;
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i]; p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx.fillStyle = p.c; ctx.globalAlpha = p.op; ctx.fill();
          for (let j = i+1; j < particles.length; j++) {
            const dx = p.x - particles[j].x, dy = p.y - particles[j].y, d = Math.sqrt(dx*dx + dy*dy);
