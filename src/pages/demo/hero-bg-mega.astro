---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

// Mega demo — все эффекты из списка пользователя
// Реализованы: 13 (полный код)
// TODO: 12 (требуют доп. фетча с htmlhub)

const ready = [
  { id: 'aurora',        tech: 'Canvas',  weight: 'heavy',       use: 'Главная — северное сияние + 180 звёзд' },
  { id: 'quantum',       tech: 'Canvas',  weight: 'moderate',    use: 'AI / нейросети — 60 узлов с связями' },
  { id: 'fireflies',     tech: 'Canvas',  weight: 'lightweight', use: 'Лес / природа — 35 светлячков' },
  { id: 'circuit',       tech: 'Canvas',  weight: 'moderate',    use: 'Python / код — электроны 90° на плате' },
  { id: 'fiber',         tech: 'Canvas',  weight: 'heavy',       use: '3D / Try — 350 fiber optic частиц туннелем' },
  { id: 'hexagons',      tech: 'Canvas',  weight: 'moderate',    use: 'Roblox / Minecraft — neon hexagonal grid' },
  { id: 'neon-network',  tech: 'Canvas',  weight: 'moderate',    use: 'Подростки — HSL-cycling сеть с glow' },
  { id: 'synthwave',     tech: 'CSS',     weight: 'lightweight', use: 'Главная — 80s outrun grid + солнце' },
  { id: 'glass-orbs',    tech: 'CSS',     weight: 'moderate',    use: 'Документы / лицензии — glass-morphism' },
  { id: 'star-genesis',  tech: 'CSS',     weight: 'lightweight', use: 'Лагерь + солнце-ассоциация — рождение звёзд в туманности' },
  { id: 'cosmic',        tech: 'CSS',     weight: 'lightweight', use: 'Мечты / финал смены — 200 звёзд + падающие + астероиды' },
  { id: 'ascendant',     tech: 'CSS',     weight: 'lightweight', use: 'Хакатон — восходящий свет + плавающие моты' },
  { id: 'hex-code-wave', tech: 'CSS',     weight: 'lightweight', use: 'Python/код — диагональная волна по hex-сетке' },
  { id: 'matrix-rain',   tech: 'Canvas',  weight: 'lightweight', use: 'Программирование / IT — Matrix rain (зелёные 0/1)' },
  { id: 'particle-flow', tech: 'Canvas',  weight: 'moderate',    use: 'Подростки / творчество — 150 цветных частиц с связями' },
  { id: 'interactive-stars', tech: 'Canvas', weight: 'moderate', use: 'AI / интерактив — 150 звёзд + созвездие к курсору' },
  { id: 'crt-boot',      tech: 'CSS',     weight: 'lightweight', use: 'Программирование / тех-поддержка — CRT-монитор boot sequence' },
];

// Эффекты с сайта — оставлены ТОЛЬКО анимированные.
// Остальные 18 site-эффектов (mesh/noise/grid/editorial/accent-bar/split-stagger/...)
// — статичные CSS-градиенты без motion. На demo не показываем.
const siteEffects = [
  { id: 'fullscreen-cta',   tier: 'T6 Conv', use: 'Резервный — анимированный full-screen CTA (единственный animated в global.css)' },
];

const todo = [
  'Abstract Particles, Particle Flow Field — дубли Quantum Mesh',
  'Colorful Ribbons (WebGL — пропустил, тяжело)',
  'Particle Swarm, Starfield Warp — heavy, оставил на потом',
  'CRT Boot — htmlhub не вернул код, можем написать сами',
];
---

<Base title="Hero BG · MEGA (все эффекты из списка)">
  <Header />
  <div class="bg-amber-100 text-amber-900 text-center text-[13px] py-1.5 border-b border-amber-200">
    <strong>DEMO MEGA:</strong> 13 эффектов готовы · 14 в TODO ·
    Heavy = ⚠️ Voxel Paris (Three.js, грузит CPU) · Aurora · Cyber Fiber
  </div>

  <main class="bg-slate-100">
    {ready.map((b, i) => (
      <section class="mega-section">
        <div class="mega-header">
          <span class="mega-num">{String(i+1).padStart(2,'0')} · {b.tech} · {b.weight}</span>
          <h2 class="mega-name">{b.use}</h2>
        </div>
        <div class={`hero-mega hero-mega--${b.id}`} data-mega={b.id}>
          {b.tech === 'Canvas' && <canvas class="mega-canvas"></canvas>}
          {b.id === 'data-tunnel' && <div id="dt-scene"></div>}
          {b.id === 'financial' && <div id="fs-scene"></div>}
          {b.id === 'synthwave' && <><div class="sw-sun"></div><div class="sw-horizon"></div><div class="sw-plane"></div><div class="sw-scanlines"></div></>}
          {b.id === 'hyperspace' && <><div id={`hs-${b.id}`} class="hs-stars"></div><div class="hs-overlay"></div></>}
          {b.id === 'voxel-paris' && <div id="vp-scene"></div>}
          {b.id === 'star-genesis' && <>
            <div class="sg-static" id="sg-static"></div>
            <div class="sg-nebula"></div>
            <div class="sg-form" id="sg-form"></div>
          </>}
          {b.id === 'cosmic' && <div class="cm-scene" id="cm-scene"></div>}
          {b.id === 'ascendant' && <>
            <div class="al-light"></div>
            <div class="al-light al-two"></div>
            <div class="al-motes" id="al-motes"></div>
          </>}
          {b.id === 'hex-code-wave' && <div class="hc-grid" id="hc-grid"></div>}
          {b.id === 'kernel-panic' && <div class="kp-container" id="kp-container"></div>}
          {b.id === 'crt-boot' && <>
            <div class="crt-screen" id="crt-screen"></div>
            <div class="crt-scanlines"></div>
            <div class="crt-vignette"></div>
          </>}
          <div class="hero-mega-content">
            <h3 class="hero-mega-h">Летний IT-лагерь · 2026</h3>
            <p class="hero-mega-sub">Каждый уезжает с готовым проектом — игрой, ботом, AI-приложением.</p>
            <a href="#" class="hero-mega-cta">Смены 2026 →</a>
          </div>
        </div>
      </section>
    ))}

    <!-- ===== РАЗДЕЛИТЕЛЬ ===== -->
    <div class="mega-divider">
      <div class="mega-divider-line"></div>
      <div class="mega-divider-text">УЖЕ ЖИВЁТ НА САЙТЕ — {siteEffects.length} эффектов из global.css</div>
      <div class="mega-divider-line"></div>
    </div>

    {siteEffects.map((b, i) => (
      <section class="mega-section">
        <div class="mega-header">
          <span class="mega-num">{b.tier} · data-hero-effect="{b.id}"</span>
          <h2 class="mega-name">{b.use}</h2>
        </div>
        <div class={`hero-mega site-fx-${b.id}`} data-hero-effect={b.id}>
          <div class="hero-mega-content">
            <h3 class="hero-mega-h">Летний IT-лагерь · 2026</h3>
            <p class="hero-mega-sub">Каждый уезжает с готовым проектом — игрой, ботом, AI-приложением.</p>
            <a href="#" class="hero-mega-cta">Смены 2026 →</a>
          </div>
        </div>
      </section>
    ))}

    <section class="mega-section">
      <div class="mega-header">
        <span class="mega-num">TODO</span>
        <h2 class="mega-name">Ещё {todo.length} эффектов из списка — требуют доп. фетча</h2>
      </div>
      <div class="mega-todo">
        {todo.map(t => <div class="mega-todo-item">• {t}</div>)}
      </div>
    </section>
  </main>

  <style is:inline>
    .mega-section { max-width: 1280px; margin: 28px auto; padding: 0 24px; }
    .mega-header { padding-bottom: 10px; }
    .mega-num { font-family: ui-monospace, monospace; font-size: 11px; color: #94a3b8; letter-spacing: 0.18em; }
    .mega-name { margin: 4px 0 2px; font-size: 22px; font-weight: 800; color: #0d1a2b; }
    .hero-mega {
      position: relative; overflow: hidden; isolation: isolate;
      min-height: 520px; border-radius: 20px;
      display: flex; align-items: center; padding: 56px;
      background: #050510; color: #fff;
      box-shadow: 0 12px 40px rgba(0,0,0,0.25);
    }
    .mega-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; display: block; }
    #dt-scene, #fs-scene, #vp-scene { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
    #vp-scene canvas { width: 100% !important; height: 100% !important; }
    .hero-mega-content { position: relative; z-index: 20; max-width: 560px; }
    .hero-mega-h { font-size: clamp(30px, 4vw, 46px); font-weight: 800; letter-spacing: -0.025em; line-height: 1.05; margin: 0 0 14px; text-shadow: 0 2px 24px rgba(0,0,0,0.7), 0 0 60px rgba(0,0,0,0.3); }
    .hero-mega-sub { font-size: 17px; color: rgba(255,255,255,0.9); line-height: 1.5; margin: 0 0 24px; max-width: 480px; text-shadow: 0 1px 8px rgba(0,0,0,0.7); }
    .hero-mega-cta { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #0a0e1a; padding: 14px 28px; border-radius: 12px; font-weight: 700; font-size: 15px; text-decoration: none; box-shadow: 0 4px 24px rgba(255,255,255,0.2); }
    .mega-todo { padding: 24px; background: #fff; border-radius: 16px; }
    .mega-divider { display: flex; align-items: center; gap: 16px; max-width: 1280px; margin: 60px auto 32px; padding: 0 24px; }
    .mega-divider-line { flex: 1; height: 1px; background: #cbd5e1; }
    .mega-divider-text { font-family: ui-monospace, monospace; font-size: 11px; color: #475569; letter-spacing: 0.18em; padding: 6px 14px; background: #fff; border: 1px solid #cbd5e1; border-radius: 999px; }

    /* Симуляция «фото-героя» — site-эффекты разрабатывались как overlay поверх фото */
    .hero-mega[class*="site-fx-"] {
      background-image:
        linear-gradient(135deg, rgba(13,26,43,0.85) 0%, rgba(30,41,59,0.55) 50%, rgba(13,26,43,0.85) 100%),
        radial-gradient(ellipse 80% 60% at 30% 30%, #5b6b7e 0%, #0d1a2b 70%) !important;
    }

    /* Усилить видимость semi-transparent T2/T3/T4/T5 эффектов в demo */
    .hero-mega[class*="site-fx-"][data-hero-effect="editorial"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="accent-bar"]::before {
      width: 8px !important;
      box-shadow: 0 0 24px currentColor;
    }
    .hero-mega[class*="site-fx-"][data-hero-effect="split-stagger"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="mesh"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="noise"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="grid"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="mesh-themed"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="mesh-urgency"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="minimal-mesh"]::before,
    .hero-mega[class*="site-fx-"][data-hero-effect="noise-only"]::before {
      filter: saturate(1.6) brightness(1.5);
    }
    .site-fx-editorial .hero-mega-h, .site-fx-accent-bar .hero-mega-h, .site-fx-split-stagger .hero-mega-h,
    .site-fx-minimal-mesh .hero-mega-h, .site-fx-ultraminimal .hero-mega-h, .site-fx-noise-only .hero-mega-h {
      color: #1c1917; text-shadow: none;
    }
    .site-fx-editorial .hero-mega-sub, .site-fx-accent-bar .hero-mega-sub, .site-fx-split-stagger .hero-mega-sub,
    .site-fx-minimal-mesh .hero-mega-sub, .site-fx-ultraminimal .hero-mega-sub, .site-fx-noise-only .hero-mega-sub {
      color: #475569; text-shadow: none;
    }
    .site-fx-editorial .hero-mega-cta, .site-fx-accent-bar .hero-mega-cta, .site-fx-split-stagger .hero-mega-cta,
    .site-fx-minimal-mesh .hero-mega-cta, .site-fx-ultraminimal .hero-mega-cta, .site-fx-noise-only .hero-mega-cta {
      background: #ec7c00; color: #fff;
    }
    .mega-todo-item { padding: 8px 0; font-family: ui-monospace, monospace; font-size: 13px; color: #475569; border-bottom: 1px solid #f1f5f9; }
    @media (prefers-reduced-motion: reduce) { .hero-mega *, .hero-mega::before, .hero-mega::after { animation: none !important; } }

    /* === DATA TUNNEL — финтикеры летят на тебя === */
    .hero-mega--data-tunnel { background: radial-gradient(ellipse at 50% 50%, #1a2c3a 0%, #0a0f14 100%); }
    #dt-scene { perspective: 200px; }
    .dt-packet {
      position: absolute;
      left: calc(var(--x) * 1%); top: calc(var(--y) * 1%);
      font-family: 'Courier New', monospace; font-size: 0.95rem;
      padding: 4px 14px; border-radius: 4px;
      background: linear-gradient(90deg, rgba(23,107,135,0.2), rgba(23,107,135,0.7));
      border: 1px solid #ec7c00; color: #fff5e8;
      text-shadow: 0 0 5px #fff5e8; white-space: nowrap;
      animation: dt-fly 10s linear infinite; animation-delay: calc(var(--d) * -1s);
    }
    @keyframes dt-fly {
      0% { transform: translateZ(-500px) translateY(-50px) scale(0.2); opacity: 0; filter: blur(4px); }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { transform: translateZ(200px) translateY(0) scale(1.5); opacity: 0; filter: blur(0); }
    }
    .dt-up { color: #22c55e; }
    .dt-down { color: #ef4444; }

    /* === FINANCIAL STREAM === */
    .hero-mega--financial { background: #0d1a2b; }
    #fs-scene { filter: blur(0.4px); }
    .fs-packet {
      position: absolute; top: calc(var(--y) * 1%);
      padding: 6px 12px;
      background: linear-gradient(90deg, rgba(0,119,182,0.7), rgba(2,62,138,0.5));
      border: 1px solid #ec7c00; border-radius: 5px;
      color: #fff; font-family: 'Courier New', monospace; font-size: 14px;
      white-space: nowrap; animation: fs-slide 10s linear infinite;
      animation-delay: calc(var(--d) * -1s); box-shadow: 0 0 10px rgba(0,180,216,0.5);
    }
    @keyframes fs-slide {
      0%   { transform: translateX(110vw); }
      100% { transform: translateX(-30vw); }
    }
    .fs-up { color: #fbbf24; }
    .fs-down { color: #ef4444; }

    /* === SYNTHWAVE === */
    .hero-mega--synthwave { background: linear-gradient(to bottom, #110022 0%, #050114 40%); perspective: 600px; }
    .sw-sun { position: absolute; top: 12%; left: 50%; transform: translateX(-50%); width: 240px; height: 240px;
      background: linear-gradient(to bottom, #ffea00 0%, #ff0055 60%, transparent 100%);
      border-radius: 50%; box-shadow: 0 0 50px #ff0055; z-index: 1;
      mask-image: repeating-linear-gradient(180deg, #000 0 12px, transparent 12px 14px, #000 14px 26px, transparent 26px 30px, #000 30px 100%);
    }
    .sw-horizon { position: absolute; top: 50%; left: 0; right: 0; height: 40px; background: #f5a624; filter: blur(20px); opacity: 0.5; z-index: 2; }
    .sw-plane {
      position: absolute; bottom: -50%; left: -50%; width: 200%; height: 200%;
      transform-origin: top center; transform: rotateX(78deg); z-index: 3;
      background-image: linear-gradient(to right, #f0f 2px, transparent 2px), linear-gradient(to bottom, #f0f 2px, transparent 2px);
      background-size: 60px 60px;
      mask-image: linear-gradient(to bottom, transparent 0%, #000 60%);
      animation: sw-grid-rush 1.6s linear infinite;
    }
    .sw-scanlines { position: absolute; inset: 0; z-index: 15; pointer-events: none;
      background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.18) 51%); background-size: 100% 4px; }
    @keyframes sw-grid-rush { 0% { background-position: 0 0; } 100% { background-position: 0 60px; } }

    /* === HYPERSPACE === */
    .hero-mega--hyperspace { background: radial-gradient(circle, #1a082d 0%, #010008 70%); }
    .hs-stars { position: absolute; top: 50%; left: 50%; width: 2px; height: 2px; z-index: 1; }
    .hs-stars .hs-star-field { position: absolute; top: 0; left: 0; width: 2px; height: 2px; }
    .hs-stars .hs-star { position: absolute; width: 100%; height: 100%; background: #fff; border-radius: 50%; animation: hs-travel 4s ease-in infinite; }
    .hs-stars .hs-star::after { content: ''; position: absolute; top: 0; left: 50%; transform: translate(-50%, -100%); width: 120%; height: 1500%; background: linear-gradient(to top, rgba(255,255,255,0.5), transparent); }
    @keyframes hs-travel {
      0% { transform: rotate(var(--ang)) translateY(0) scale(0); opacity: 1; }
      50% { transform: rotate(var(--ang)) translateY(20vmin) scale(1); opacity: 1; }
      100% { transform: rotate(var(--ang)) translateY(60vmin) scale(0); opacity: 1; }
    }
    .hs-overlay { position: absolute; top: 50%; left: 50%; width: 70vmin; height: 70vmin;
      transform: translate(-50%, -50%); border: 2px solid rgba(0,225,255,0.3); border-radius: 50%;
      box-shadow: inset 0 0 20px rgba(0,225,255,0.2); animation: hs-pulse 5s ease-in-out infinite alternate; z-index: 2; }
    @keyframes hs-pulse { from { transform: translate(-50%,-50%) scale(0.95); opacity: 0.5; } to { transform: translate(-50%,-50%) scale(1); opacity: 0.85; } }

    /* === GLASS ORBS === */
    .hero-mega--glass-orbs { background: linear-gradient(to bottom right, #0d1a2b, #1e1b4b); }
    .hero-mega--glass-orbs::before, .hero-mega--glass-orbs::after { content: ''; position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.65; }
    .hero-mega--glass-orbs::before { width: 320px; height: 320px; background: #38bdf8; top: -80px; left: -60px; animation: orb-float 6s infinite ease-in-out alternate; }
    .hero-mega--glass-orbs::after { width: 380px; height: 380px; background: #818cf8; bottom: -100px; right: -80px; animation: orb-float 6s infinite ease-in-out alternate -3s; }
    @keyframes orb-float { 0% { transform: translate(0,0) scale(1); } 50% { transform: translate(80px,-50px) scale(1.15); } 100% { transform: translate(-40px,60px) scale(0.95); } }

    /* === VOXEL PARIS placeholder === */
    .hero-mega--voxel-paris { background: linear-gradient(180deg, #87CEEB 0%, #4a90c2 100%); color: #1c1917; }
    .hero-mega--voxel-paris .hero-mega-h, .hero-mega--voxel-paris .hero-mega-sub { color: #1c1917; text-shadow: 0 1px 4px rgba(255,255,255,0.5); }
    #vp-scene { background: #87CEEB; }

    /* === STAR GENESIS (htmlhub) === */
    .hero-mega--star-genesis { background: #000; }
    .sg-static, .sg-form, .sg-nebula { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
    .sg-static-star { position: absolute; background: white; border-radius: 50%; animation: sg-twinkle 6s infinite; }
    @keyframes sg-twinkle { 0%,100% { opacity: 0.3; } 50% { opacity: 0.8; } }
    .sg-nebula {
      background: radial-gradient(ellipse at 50% 50%, rgba(127,0,255,0.18) 0%, transparent 60%),
                  radial-gradient(ellipse at 20% 80%, rgba(0,255,221,0.12) 0%, transparent 50%),
                  radial-gradient(ellipse at 80% 20%, rgba(255,0,149,0.12) 0%, transparent 50%);
      animation: sg-breathe 6s ease-in-out infinite alternate;
      filter: blur(40px);
    }
    @keyframes sg-breathe { from { transform: scale(1) rotate(0); opacity: 0.7; } to { transform: scale(1.1) rotate(20deg); opacity: 1; } }
    .sg-forming-star { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #fff; animation: sg-birth 6s ease-out infinite; opacity: 0; }
    @keyframes sg-birth {
      0%,40%,100% { transform: scale(0.1); opacity: 0; box-shadow: none; }
      50% { transform: scale(2); opacity: 1; box-shadow: 0 0 15px 3px #fff, 0 0 30px 8px #00eaff; }
      60% { transform: scale(0.8); opacity: 0.5; box-shadow: 0 0 10px 2px #fff, 0 0 20px 5px #00eaff; }
    }

    /* === COSMIC === */
    .hero-mega--cosmic { background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%); }
    .cm-scene { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
    .cm-star { position: absolute; background: white; border-radius: 50%; animation: cm-twinkle var(--dur, 3s) ease-in-out infinite; animation-delay: var(--del, 0s); box-shadow: 0 0 var(--glow, 4px) rgba(255,255,255,0.9); }
    @keyframes cm-twinkle { 0%,100% { opacity: 0.2; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.3); } }
    .cm-shooting { position: absolute; width: 2px; height: 2px; background: white; border-radius: 50%; box-shadow: 0 0 8px 2px rgba(255,255,255,0.9); }
    .cm-shooting::before { content: ''; position: absolute; top: 0; right: 0; width: 80px; height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.8) 100%); transform: translateX(2px); }
    @keyframes cm-shoot {
      0% { transform: translate(0,0) rotate(-45deg); opacity: 1; }
      100% { transform: translate(-300px, 300px) rotate(-45deg); opacity: 0; }
    }

    /* === ASCENDANT LIGHT === */
    .hero-mega--ascendant { background: #1a1a2e; }
    .al-light {
      position: absolute; top: -20%; left: 50%; width: 300%; height: 150%;
      transform: translateX(-50%); z-index: 1;
      background: linear-gradient(45deg, transparent 40%, rgba(255,238,204,0.25) 48%, rgba(255,238,204,0.25) 52%, transparent 60%);
      animation: al-pan 6s infinite linear;
      mask-image: radial-gradient(ellipse at 50% -20%, #000 20%, transparent 70%);
    }
    .al-two { transform: translateX(-50%) rotate(-20deg); animation-duration: 6s; }
    @keyframes al-pan { from { transform: translateX(-50%) rotate(-40deg); } to { transform: translateX(-50%) rotate(40deg); } }
    .al-motes { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
    .al-mote { position: absolute; width: 4px; height: 4px; background: #fff; border-radius: 50%; opacity: 0.5; box-shadow: 0 0 10px #ffeecc; animation: al-float 6s infinite linear; }
    @keyframes al-float {
      0% { transform: translateY(110%) translateX(0) rotate(0); opacity: 0; }
      10% { opacity: 0.7; } 90% { opacity: 0.7; }
      100% { transform: translateY(-10%) translateX(60px) rotate(360deg); opacity: 0; }
    }

    /* === HEX CODE WAVE === */
    .hero-mega--hex-code-wave { background: #0d0d12; color: #2a3c4b; }
    .hc-grid {
      position: absolute; top: 0; right: 0; bottom: 0; width: 55%; z-index: 1;
