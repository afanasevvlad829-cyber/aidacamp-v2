    /* Vignette по краям + curvature illusion */
    .crt-vignette {
      position: absolute; inset: 0; z-index: 9; pointer-events: none;
      box-shadow:
        inset 0 0 80px rgba(0,0,0,0.7),
        inset 0 0 200px rgba(0,30,0,0.4);
