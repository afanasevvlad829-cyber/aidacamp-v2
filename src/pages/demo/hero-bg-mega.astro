    .kp-container { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; z-index: 1; padding: 24px 32px; box-sizing: border-box; animation: kp-glitch 6s infinite; opacity: 0.7; }
    .kp-container h4 { color: #ef4444; text-align: center; margin: 0 0 14px; text-shadow: 0 0 5px #ef4444; font-family: 'VT323', monospace; font-size: 22px; }
    .kp-line { opacity: 0; white-space: pre; animation: kp-type 0.1s forwards; margin: 0; font-family: ui-monospace, monospace; }
    @keyframes kp-type { to { opacity: 1; } }
    @keyframes kp-glitch {
