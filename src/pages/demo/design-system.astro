---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
---

<Base title="АйДаКемп — Дизайн-система v3 (Soft Orange + Attention)" noindex>

<style is:inline>
  body { font-family: 'Inter', sans-serif; background: #f8f9fb; margin: 0; color: #1e2430; }
  .container { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  .nav-side { position: fixed; top: 80px; left: 24px; width: 200px; padding: 16px; background: white; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); font-size: 13px; }
  .nav-side a { display: block; padding: 6px 8px; color: #4b5263; text-decoration: none; border-radius: 6px; margin-bottom: 2px; }
  .nav-side a:hover { background: #f3f6fb; color: #ec9b44; }
  @media (max-width: 1280px) { .nav-side { display: none; } }

  .hero { background: linear-gradient(135deg, #0d1a2b 0%, #1c2740 100%); color: white; padding: 48px 24px; text-align: center; }
  .hero h1 { font-size: 36px; font-weight: 800; margin: 0 0 8px; letter-spacing: -0.03em; }
  .hero .accent { color: #ec9b44; }
  .hero p { color: rgba(255,255,255,0.7); margin: 0; font-size: 15px; }
  .badge-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; background: rgba(236,155,68,0.15); border: 1px solid rgba(236,155,68,0.4); color: #ec9b44; font-size: 12px; font-weight: 600; margin-bottom: 12px; }

  section { padding: 48px 0 24px; border-bottom: 1px solid #e5e7eb; scroll-margin-top: 24px; }
  section h2 { font-size: 28px; font-weight: 800; color: #0d1a2b; margin: 0 0 8px; letter-spacing: -0.02em; }
  section .subtitle { color: #6b7280; font-size: 15px; margin: 0 0 28px; }
  section h3 { font-size: 18px; font-weight: 700; color: #1e2430; margin: 32px 0 12px; }

  .palette { display: grid; grid-template-columns: repeat(11, 1fr); gap: 4px; margin: 8px 0 16px; }
  .swatch { aspect-ratio: 1; border-radius: 8px; display: flex; flex-direction: column; align-items: flex-end; justify-content: end; padding: 6px; font-size: 9px; color: white; font-weight: 600; }
  .swatch-light { color: #1e2430; }
  .swatch .num { font-size: 11px; font-weight: 700; }

  .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .demo-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
  .demo-card h4 { margin: 0 0 12px; font-size: 13px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; }
  .demo-card .label-bad { color: #c4515c; }
  .demo-card .label-good { color: #2fa768; }

  .block-row { display: flex; gap: 16px; padding: 16px; border: 1px solid #e5e7eb; border-radius: 12px; margin-bottom: 12px; align-items: center; }
  .block-row .num { width: 32px; height: 32px; border-radius: 50%; background: #f3f6fb; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #4b5263; font-size: 13px; flex-shrink: 0; }
  .block-row .info { flex: 1; }
  .block-row .info strong { display: block; color: #0d1a2b; font-size: 15px; }
  .block-row .info span { color: #6b7280; font-size: 13px; }
  .block-row .tag-info { background: #e3ebf6; color: #1d3b61; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .block-row .tag-conv { background: rgba(236,155,68,0.15); color: #b66d10; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .block-row .attention { font-size: 11px; color: #4b5263; max-width: 200px; }

  /* Demo button styles */
  .btn-primary-soft { background: #ec9b44; color: white; border: none; padding: 10px 20px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 2px 8px rgba(236,155,68,0.25); transition: all 0.2s; }
  .btn-primary-soft:hover { background: #d68830; }
  .btn-primary-old { background: #ec9b44; color: white; border: none; padding: 10px 20px; border-radius: 12px; font-weight: 700; font-size: 14px; box-shadow: 0 4px 16px rgba(236,155,68,0.45); }

  .btn-secondary { background: white; color: #1e2430; border: 1.5px solid #ec9b44; padding: 9px 18px; border-radius: 12px; font-weight: 600; font-size: 14px; }
  .btn-ghost { background: transparent; color: #ec9b44; border: 1px solid rgba(236,155,68,0.3); padding: 9px 18px; border-radius: 12px; font-weight: 600; font-size: 14px; }

  .type-row { display: flex; align-items: baseline; gap: 16px; padding: 8px 0; border-bottom: 1px solid #f3f6fb; }
  .type-row .label { width: 80px; font-size: 12px; color: #6b7280; font-family: monospace; }
  .type-row .demo { color: #1e2430; flex: 1; }
  .type-row .meta { font-size: 11px; color: #9ca3af; font-family: monospace; }

  .principle { background: white; border-left: 3px solid #ec9b44; padding: 16px 20px; margin: 12px 0; border-radius: 0 12px 12px 0; }
  .principle strong { color: #0d1a2b; }

  .table-clean { width: 100%; border-collapse: collapse; }
  .table-clean th, .table-clean td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #f3f6fb; font-size: 14px; vertical-align: top; }
  .table-clean th { background: #f8f9fb; color: #4b5263; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
  .table-clean td code { background: #f3f6fb; padding: 1px 6px; border-radius: 4px; font-size: 12px; color: #ec9b44; }

  .anchor-target { display: block; height: 60px; margin-top: -60px; visibility: hidden; }
</style>

<!-- ═══ NAV ═══ -->
<aside class="nav-side">
  <a href="#philosophy"><i class="bi bi-bullseye" aria-hidden="true"></i> Философия</a>
  <a href="#palette"><i class="bi bi-palette-fill" aria-hidden="true"></i> Палитра</a>
  <a href="#typography"><i class="bi bi-pencil-square" aria-hidden="true"></i> Типографика</a>
  <a href="#buttons"><i class="bi bi-circle" aria-hidden="true"></i> Кнопки</a>
  <a href="#blocks"><i class="bi bi-box-seam" aria-hidden="true"></i> Блоки сайта</a>
  <a href="#attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Точки внимания</a>
  <a href="#mobile"><i class="bi bi-phone" aria-hidden="true"></i> Mobile vs Desktop</a>
  <a href="#seo"><i class="bi bi-search" aria-hidden="true"></i> SEO / GEO / AEO</a>
  <a href="#ordering"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Порядок блоков</a>
  <a href="#metrika"><i class="bi bi-broadcast" aria-hidden="true"></i> Метрика-цели</a>
  <a href="#voice"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i> Brand Voice</a>
  <a href="#a11y"><i class="bi bi-universal-access" aria-hidden="true"></i> Доступность</a>
  <a href="#motion"><i class="bi bi-stars" aria-hidden="true"></i> Микроанимации</a>
  <a href="#usp"><i class="bi bi-bullseye" aria-hidden="true"></i> USP подсветка</a>
  <a href="#journey"><i class="bi bi-signpost-2" aria-hidden="true"></i> Скользкая горка</a>
  <a href="#menu"><i class="bi bi-list" aria-hidden="true"></i> Меню</a>
  <a href="#pages"><i class="bi bi-file-text" aria-hidden="true"></i> Отдельные страницы</a>
  <a href="#booking"><i class="bi bi-ticket-perforated" aria-hidden="true"></i> Бронирование</a>
  <a href="#bot"><i class="bi bi-chat-dots" aria-hidden="true"></i> Бот без «бот»</a>
  <a href="#ux-details">UX-детали</a>
  <a href="#dont"><i class="bi bi-slash-circle" aria-hidden="true"></i> Чего не делать</a>
</aside>

<!-- ═══ HERO ═══ -->
<header class="hero">
  <span class="badge-pill">v3 · 2026-05-01 · Soft Orange + Attention-driven</span>
  <h1>Дизайн-система <span class="accent">АйДаКемп</span></h1>
  <p>Орientируется на Дарью 35-45, soft orange (как голова робота), photo-emotion вместо эффектов</p>
  <p style="margin-top: 8px; font-size: 12px; color: rgba(255,255,255,0.5);">Используются Bootstrap Icons (как и должно быть в production). Никаких эмодзи.</p>
</header>

<div class="container">

<!-- ═══ ФИЛОСОФИЯ ═══ -->
<section><span id="philosophy" class="anchor-target"></span>
  <h2><i class="bi bi-bullseye" aria-hidden="true"></i> 1. Философия</h2>
  <p class="subtitle">Не дизайнерская, а маркетинговая. Дизайн = инструмент конверсии.</p>

  <div class="principle">
    <strong>Принцип 1: Photo emotion &gt; graphic effects.</strong><br>
    Дарья покупает «социально-одобряемое». Фото улыбающегося ребёнка работает в 10× раз сильнее, чем gradient orbs.
  </div>
  <div class="principle">
    <strong>Принцип 2: Soft orange.</strong><br>
    Brand-color <code style="color:var(--color-primary)">#ec9b44</code> (голова робота), не <code style="color:var(--color-primary)">#ec9b44</code>. Hard orange = «реклама»; soft = «премиум».
  </div>
  <div class="principle">
    <strong>Принцип 3: Avoid aggressive fills.</strong><br>
    Где можно — outline вместо fill. Например, secondary CTA: <code>border 1.5px orange</code> вместо <code>bg orange</code>.
  </div>
  <div class="principle">
    <strong>Принцип 4: Один accent per screen.</strong><br>
    На каждом экране — 1 точка внимания. Если их 3, мама уходит. Это правило важнее эстетики.
  </div>
  <div class="principle">
    <strong>Принцип 5: Информационные vs Конверсионные блоки.</strong><br>
    Info-блоки (Reviews, About, FAQ) = navy + white, без orange. Conversion-блоки (Hero, Shifts, BookingBar) = soft orange acent.
  </div>
  <div class="principle">
    <strong>Принцип 6: Конверсия = звонок.</strong><br>
    Лучшие клиенты ЗВОНЯТ, не оставляют формы. Phone в header = главный CTA, должен быть всегда виден.
  </div>
  <div class="principle">
    <strong>Принцип 7: Mobile-first.</strong><br>
    Дарья на мобиле. Desktop = upscaled mobile с большими отступами, не наоборот.
  </div>
</section>

<!-- ═══ ПАЛИТРА ═══ -->
<section><span id="palette" class="anchor-target"></span>
  <h2><i class="bi bi-palette-fill" aria-hidden="true"></i> 2. Палитра</h2>
  <p class="subtitle">Soft orange (#ec9b44 — как голова робота) + navy + neutrals + 1 success accent.</p>

  <h3>Primary — soft orange (новый, светлее)</h3>
  <div class="palette">
    <div class="swatch swatch-light" style="background:#fdf6ec;"><span class="num">50</span></div>
    <div class="swatch swatch-light" style="background:#faead0;"><span class="num">100</span></div>
    <div class="swatch swatch-light" style="background:#f5d4a4;"><span class="num">200</span></div>
    <div class="swatch swatch-light" style="background:#f0bb78;"><span class="num">300</span></div>
    <div class="swatch swatch-light" style="background:#eba955;"><span class="num">400</span></div>
    <div class="swatch" style="background:var(--color-primary);"><span class="num">500</span> <span style="font-size:8px;">brand</span></div>
    <div class="swatch" style="background:#d68830;"><span class="num">600</span></div>
    <div class="swatch" style="background:#b66d10;"><span class="num">700</span></div>
    <div class="swatch" style="background:#8c540c;"><span class="num">800</span></div>
    <div class="swatch" style="background:#603b08;"><span class="num">900</span></div>
    <div class="swatch" style="background:#321e04;"><span class="num">950</span></div>
  </div>
  <p style="font-size: 13px; color: #6b7280;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Текущий <code>#ec9b44</code> остаётся как алиас для совместимости, но в новых компонентах используем <code>#ec9b44</code> (50<i class="bi bi-arrow-right" aria-hidden="true"></i>950 шкала выше).</p>

  <h3>Navy — фон, тёмные секции</h3>
  <div class="palette">
    <div class="swatch swatch-light" style="background:#f3f6fb;"><span class="num">50</span></div>
    <div class="swatch swatch-light" style="background:#e3ebf6;"><span class="num">100</span></div>
    <div class="swatch swatch-light" style="background:#c4d6ed;"><span class="num">200</span></div>
    <div class="swatch swatch-light" style="background:#99b7e0;"><span class="num">300</span></div>
    <div class="swatch" style="background:#6a97d2;"><span class="num">400</span></div>
    <div class="swatch" style="background:#3b76c3;"><span class="num">500</span></div>
    <div class="swatch" style="background:#3163a4;"><span class="num">600</span></div>
    <div class="swatch" style="background:#285085;"><span class="num">700</span></div>
    <div class="swatch" style="background:#1e3d65;"><span class="num">800</span></div>
    <div class="swatch" style="background:#152a46;"><span class="num">900</span></div>
    <div class="swatch" style="background:#0d1a2b;"><span class="num">950</span> <span style="font-size:8px;">hero bg</span></div>
  </div>

  <h3>Neutrals (текст, рамки) + success</h3>
  <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 8px 0;">
    <div class="swatch swatch-light" style="background:#ffffff; border:1px solid #e5e7eb; width: 90px; height: 70px;"><span class="num">white</span></div>
    <div class="swatch swatch-light" style="background:#f8f9fb; border:1px solid #e5e7eb; width: 90px; height: 70px;"><span class="num">gray-50</span></div>
    <div class="swatch swatch-light" style="background:#e5e7eb; width: 90px; height: 70px;"><span class="num">border</span></div>
    <div class="swatch" style="background:#6b7280; width: 90px; height: 70px;"><span class="num">text-muted</span></div>
    <div class="swatch" style="background:#1e2430; width: 90px; height: 70px;"><span class="num">text-body</span></div>
    <div class="swatch" style="background:#0d1a2b; width: 90px; height: 70px;"><span class="num">text-strong</span></div>
    <div class="swatch" style="background:#2fa768; width: 90px; height: 70px;"><span class="num">success</span></div>
    <div class="swatch" style="background:#ffd86b; width: 90px; height: 70px; color:#1e2430;"><span class="num">stars-only</span></div>
  </div>

  <h3>Сравнение: Hard vs Soft Orange</h3>
  <div class="compare-grid">
    <div class="demo-card">
      <h4 class="label-bad"><i class="bi bi-x-circle-fill" style="color:#c4515c" aria-hidden="true"></i> Текущий (Hard #ec9b44)</h4>
      <button class="btn-primary-old">Записаться</button>
      <p style="margin: 12px 0 0; font-size: 13px; color: #6b7280;">«Реклама», агрессивно, крикливо</p>
    </div>
    <div class="demo-card">
      <h4 class="label-good"><i class="bi bi-check-circle-fill" style="color:#2fa768" aria-hidden="true"></i> Новый (Soft #ec9b44)</h4>
      <button class="btn-primary-soft">Записаться</button>
      <p style="margin: 12px 0 0; font-size: 13px; color: #6b7280;">«Премиум», спокойно, как у Apple/Stripe</p>
    </div>
  </div>
</section>

<!-- ═══ ТИПОГРАФИКА ═══ -->
<section><span id="typography" class="anchor-target"></span>
  <h2><i class="bi bi-pencil-square" aria-hidden="true"></i> 3. Типографика</h2>
  <p class="subtitle">Mobile-first шкала. На десктопе — те же размеры × 1.2-1.5.</p>

  <div class="type-row"><span class="label">Hero H1</span><span class="demo" style="font-size: 38px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05;">Летний IT-лагерь</span><span class="meta">38/44 · 800 · -0.03em</span></div>
  <div class="type-row"><span class="label">Section H2</span><span class="demo" style="font-size: 26px; font-weight: 700; letter-spacing: -0.02em;">Как проходит смена</span><span class="meta">26/32 · 700 · -0.02em</span></div>
  <div class="type-row"><span class="label">Card H3</span><span class="demo" style="font-size: 18px; font-weight: 700;">Программирование</span><span class="meta">18/20 · 700</span></div>
  <div class="type-row"><span class="label">Body large</span><span class="demo" style="font-size: 18px; font-weight: 400; line-height: 1.5;">Дети уезжают с готовым проектом</span><span class="meta">18/18 · 400 · 1.5</span></div>
  <div class="type-row"><span class="label">Body</span><span class="demo" style="font-size: 16px; font-weight: 400; line-height: 1.65;">Основной текст в статьях и описаниях смен</span><span class="meta">16/16 · 400 · 1.65</span></div>
  <div class="type-row"><span class="label">Caption</span><span class="demo" style="font-size: 14px; font-weight: 400; color: #6b7280;">Мета, подписи, дата</span><span class="meta">14/14 · 400</span></div>
  <div class="type-row"><span class="label">Label UC</span><span class="demo" style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-primary);">ЗАПИСЬ ОТКРЫТА</span><span class="meta">12/12 · 600 · 0.06em UC</span></div>

  <p style="margin-top: 16px; font-size: 13px; color: #6b7280;"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> <strong>Минимум на мобилке: 16px</strong> для body. Меньше — только caption/label/disclaimer.</p>
</section>

<!-- ═══ КНОПКИ ═══ -->
<section><span id="buttons" class="anchor-target"></span>
  <h2><i class="bi bi-circle" aria-hidden="true"></i> 4. Кнопки</h2>
  <p class="subtitle">3 уровня + правило: <strong>fill ТОЛЬКО для primary CTA</strong>. Остальное — outline/ghost.</p>

  <div class="compare-grid">
    <div class="demo-card">
      <h4>Primary (1 на экран)</h4>
      <button class="btn-primary-soft">Выбрать смену</button>
      <p style="margin: 8px 0 0; font-size: 12px; color: #6b7280;">Soft orange fill. Только для конверсии.</p>
    </div>
    <div class="demo-card">
      <h4>Secondary</h4>
      <button class="btn-secondary">Узнать больше</button>
      <p style="margin: 8px 0 0; font-size: 12px; color: #6b7280;">Outline orange + text dark.</p>
    </div>
    <div class="demo-card">
      <h4>Ghost (link-style)</h4>
      <button class="btn-ghost">Скачать программу</button>
      <p style="margin: 8px 0 0; font-size: 12px; color: #6b7280;">Лёгкий border, для tertiary actions.</p>
    </div>
    <div class="demo-card">
      <h4>Phone (всегда наверху)</h4>
      <a href="tel:+74951284429" style="display:inline-flex; align-items:center; gap:6px; color: var(--color-primary); font-weight: 700; text-decoration: none; font-size: 16px;">
        <i class="bi bi-telephone-fill"></i> +7 (495) 128-44-29
      </a>
      <p style="margin: 8px 0 0; font-size: 12px; color: #6b7280;">Не fill. Просто текст с иконкой. Главный путь = звонок.</p>
    </div>
  </div>
</section>

<!-- ═══ БЛОКИ САЙТА ═══ -->
<section><span id="blocks" class="anchor-target"></span>
  <h2><i class="bi bi-box-seam" aria-hidden="true"></i> 5. Блоки сайта — Info vs Conversion</h2>
  <p class="subtitle">Каждый блок имеет тип. <strong>Info</strong> = navy/white, без orange. <strong>Conv</strong> = soft orange accent.</p>

  <h3 style="color: #1d3b61; margin-top: 24px;"><i class="bi bi-square-fill" style="color:#3163a4" aria-hidden="true"></i> INFORMATIONAL — закрывают страхи, дают доверие</h3>

  <div class="block-row"><span class="num">1</span><div class="info"><strong>Hero фото</strong><span>Эмоция — улыбающийся мальчик</span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Лицо ребёнка</span></div>
  <div class="block-row"><span class="num">2</span><div class="info"><strong>Stats (7 лет / 1200 детей / <i class="bi bi-star-fill" aria-hidden="true"></i> 5.0)</strong><span>Социальное доказательство</span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Цифры</span></div>
  <div class="block-row"><span class="num">3</span><div class="info"><strong>About (что мы делаем)</strong><span>Кратко, фото, без воды</span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Иконки + 3 факта</span></div>
  <div class="block-row"><span class="num">4</span><div class="info"><strong>Reviews</strong><span>Отзывы реальных мам с <i class="bi bi-star-fill" aria-hidden="true"></i><i class="bi bi-star-fill" aria-hidden="true"></i><i class="bi bi-star-fill" aria-hidden="true"></i><i class="bi bi-star-fill" aria-hidden="true"></i><i class="bi bi-star-fill" aria-hidden="true"></i></span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Лица + рейтинг</span></div>
  <div class="block-row"><span class="num">5</span><div class="info"><strong>Mentors / Team</strong><span>Кому доверяешь ребёнка — фото и опыт</span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Лица педагогов</span></div>
  <div class="block-row"><span class="num">6</span><div class="info"><strong>Stay (размещение)</strong><span>Безопасность, корпуса, столовая</span></div><span class="tag-info">INFO</span><span class="attention"><i class="bi bi-eye-fill" aria-hidden="true"></i> Фото комнат</span></div>
