---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import { STAT_RATING, STAT_YEARS, STAT_KIDS, CAMP_PRICE_FROM } from '../../data/contacts';
---

<Base title="Hero Liquid CALM — sublte glass без пестроты" noindex>

<style is:inline>
  body { font-family: 'Inter', sans-serif; background: #0d1a2b; margin: 0; }
  .nav-bar { position: sticky; top: 0; z-index: 100; background: rgba(13,26,43,0.92); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 12px 16px; display: flex; gap: 16px; align-items: center; }
  .nav-bar a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .nav-bar a:hover { color: white; background: rgba(255,255,255,0.08); }

  /* Side-by-side */
  .compare { display: flex; gap: 24px; padding: 24px; flex-wrap: wrap; justify-content: center; align-items: start; }
  .col { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .col-label { color: white; font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 999px; background: rgba(255,255,255,0.08); }

  /* Mobile frame */
  .mf { width: 390px; height: 844px; border-radius: 36px; overflow: hidden; box-shadow: 0 20px 80px rgba(0,0,0,0.5), inset 0 0 0 8px #1c1c1e, inset 0 0 0 9px #444; position: relative; background: #0d1a2b; }

  /* ─── Hero Calm ─── */
  .h-calm { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .h-calm-photo { position: absolute; inset: 0; background-image: url('/images/hero-mobile-bean-v3.webp'); background-size: cover; background-position: center 25%; }
  /* Только ОДИН orange-tinted glow в углу + navy fade. БЕЗ pink/violet/cyan */
  .h-calm-overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 80% 95%, rgba(236,124,0,0.18) 0%, transparent 55%),
      linear-gradient(180deg, rgba(13,26,43,0.30) 0%, rgba(13,26,43,0.20) 30%, rgba(13,26,43,0.55) 60%, rgba(13,26,43,0.85) 100%);
  }

  .h-nav { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18px 16px 12px; }
  .nb-burger, .nb-phone {
    width: 40px; height: 40px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
    color: white; font-size: 16px; cursor: pointer;
  }
  .nb-brand { display: flex; align-items: center; gap: 8px; padding: 4px 12px 4px 4px; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.18); }
  .nb-brand-logo { width: 28px; height: 28px; border-radius: 50%; background: #ec7c00; display: flex; align-items: center; justify-content: center; font-size: 12px; color: white; font-weight: 800; }
  .nb-brand-text { color: white; font-weight: 700; font-size: 14px; }
  .nb-brand-text .h { color: rgba(255,255,255,0.50); }

  .h-spacer { flex: 1; min-height: 38vh; }

  /* Glass card — БЕЗ orbs, БЕЗ gradient text, БЕЗ multi-color */
  .h-card {
    position: relative; z-index: 10;
    margin: 0 16px 16px; padding: 22px 20px 18px;
    border-radius: 24px;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(36px) saturate(160%);
    -webkit-backdrop-filter: blur(36px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.22),
      0 16px 48px rgba(0,0,0,0.30);
  }

  /* Status pill — только orange (без pulse) */
  .pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 11px; border-radius: 999px;
    background: rgba(236,124,0,0.12);
    border: 1px solid rgba(236,124,0,0.30);
    font-size: 11px; font-weight: 600; color: #ffaa55;
    margin-bottom: 14px;
  }
  .pill-dot { width: 5px; height: 5px; border-radius: 50%; background: #ffaa55; }

  /* H1 — простой белый, БЕЗ gradient text */
  .h-h1 {
    font-size: 32px; font-weight: 800; line-height: 1.04; letter-spacing: -0.04em;
    color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    margin: 0 0 10px;
  }
  .h-h1 .accent { color: #ec7c00; }

  .h-sub {
    font-size: 14px; color: rgba(255,255,255,0.85);
    line-height: 1.5; margin: 0 0 18px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
  }
  .h-sub b { color: white; font-weight: 700; }

  /* CTA — orange solid (без gradient pink) */
  .h-cta-row { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
  .h-cta-pri {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 14px 18px; border-radius: 14px;
    background: #ec7c00;
    border: 1px solid rgba(255,255,255,0.15);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 4px 16px rgba(236,124,0,0.30);
    color: white; font-size: 15px; font-weight: 700; text-decoration: none;
  }
  .h-cta-sec {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 11px 14px; border-radius: 14px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
    color: white; font-size: 13px; text-decoration: none;
  }
  .h-cta-sec .lf { display: flex; align-items: center; gap: 10px; }
  /* Иконка — простой orange circle, БЕЗ gradient teal-violet */
  .ic { width: 30px; height: 30px; border-radius: 50%; background: rgba(236,124,0,0.20); border: 1px solid rgba(236,124,0,0.4); display: flex; align-items: center; justify-content: center; font-size: 13px; color: #ffaa55; }
  .h-cta-sec .topic { font-weight: 700; color: white; }
  .h-cta-sec .anon { font-size: 10px; color: rgba(255,255,255,0.55); margin-top: 1px; }

  .h-stats { display: flex; align-items: center; justify-content: space-around; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.10); color: white; font-size: 12px; }
  .h-stats .s strong { font-size: 14px; font-weight: 700; }
  .h-stats .s .lb { opacity: 0.55; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .h-stats .star { color: #ffd86b; }
  .h-stats .div { width: 1px; height: 18px; background: rgba(255,255,255,0.12); }

  .h-trust { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 10px; color: rgba(255,255,255,0.6); }
  .h-trust .d { color: rgba(255,255,255,0.20); }
  .h-trust span i { color: rgba(255,255,255,0.65); margin-right: 3px; font-style: normal; }

  /* Annotations */
  .annot { background: white; padding: 20px 24px; border-radius: 16px; margin: 24px auto; max-width: 820px; font-size: 14px; line-height: 1.6; color: #1e2430; }
  .annot h3 { margin: 0 0 12px; font-size: 17px; font-weight: 700; color: #0d1a2b; }
  .annot table { width: 100%; border-collapse: collapse; margin-top: 8px; }
  .annot td { padding: 8px 12px; border-bottom: 1px solid #f0f2f5; vertical-align: top; }
  .annot td:first-child { font-weight: 600; color: #4b5263; width: 30%; }
  code { background: #f3f6fb; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #ec7c00; }
</style>

<div class="nav-bar">
  <a href="/demo/hero-liquid-hybrid/">← v1 Pestro (orbs + multi-color)</a>
  <a href="/" style="color:#ffaa55">PROD →</a>
  <span style="color: rgba(255,255,255,0.4); margin-left: auto; font-size: 12px;">v2 CALM · только orange + navy + glass</span>
</div>

<div class="compare">
  <div class="col">
    <div class="col-label">v2 — CALM (без orbs)</div>
    <div class="mf">
      <div class="h-calm">
        <div class="h-calm-photo"></div>
        <div class="h-calm-overlay"></div>

        <div class="h-nav">
          <button class="nb-burger"><i class="bi bi-list"></i></button>
          <div class="nb-brand">
            <div class="nb-brand-logo">A</div>
            <span class="nb-brand-text"><span class="h">#</span>АйДаКемп</span>
          </div>
          <button class="nb-phone"><i class="bi bi-telephone-fill"></i></button>
        </div>

        <div class="h-spacer"></div>

        <div class="h-card">
          <span class="pill">
            <span class="pill-dot"></span>
            Запись открыта · Лето 2026
          </span>

          <h1 class="h-h1">
            Летний <span class="accent">IT-лагерь</span><br>
            в&nbsp;Подмосковье 2026
          </h1>

          <p class="h-sub">
            Пока другие на даче — ваш сделает <b>AI-проект</b>.<br>
            Вам — <b>14 дней для себя</b>.
          </p>

          <div class="h-cta-row">
            <a href="#" class="h-cta-pri">
              <span>от {CAMP_PRICE_FROM} · Выбрать смену</span>
              <i class="bi bi-arrow-right"></i>
            </a>
            <a href="#" class="h-cta-sec">
              <div class="lf">
                <div class="ic"><i class="bi bi-chat-dots-fill"></i></div>
                <div>
                  <div>Спросите про <span class="topic">минусы</span></div>
                  <div class="anon"><i class="bi bi-shield-lock-fill"></i> Анонимно, без регистрации</div>
                </div>
              </div>
              <i class="bi bi-arrow-right" style="opacity: 0.4"></i>
            </a>
          </div>

          <div class="h-stats">
            <div class="s">
              <div><strong class="star">★ {STAT_RATING}</strong></div>
              <div class="lb">Яндекс</div>
            </div>
            <div class="div"></div>
            <div class="s">
              <div><strong>{STAT_YEARS} лет</strong></div>
              <div class="lb">опыта</div>
            </div>
            <div class="div"></div>
            <div class="s">
              <div><strong>{STAT_KIDS}</strong></div>
              <div class="lb">детей</div>
            </div>
          </div>

          <div class="h-trust">
            <span><i class="bi bi-patch-check-fill"></i> Лицензия</span>
            <span class="d">·</span>
            <span><i class="bi bi-heart-pulse-fill"></i> 24/7</span>
            <span class="d">·</span>
            <span><i class="bi bi-shield-check"></i> Страховка</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="annot">
  <h3>Что убрано из v1 (Pestro) → v2 (Calm)</h3>
  <table>
    <tr><td>Iridescent orbs</td><td>❌ убраны (было 2 шт. с conic-gradient pink/violet/cyan)</td></tr>
    <tr><td>Multi-radial overlay</td><td>❌ убраны 3 цветных пятна. Только 1 orange tint в углу</td></tr>
    <tr><td>Gradient text H1</td><td>❌ убран (было orange→pink→violet). Сейчас белый + orange акцент на «IT-лагерь»</td></tr>
    <tr><td>Gradient CTA orange→pink</td><td>❌ убран. Solid <code>#ec7c00</code> с orange glow shadow</td></tr>
    <tr><td>Bot icon teal-violet circle</td><td>❌ убран. Простой orange circle</td></tr>
    <tr><td>Pulse animation</td><td>❌ убран dot pulsation</td></tr>
  </table>
</div>

<div class="annot">
  <h3>Что осталось от Liquid Glass</h3>
  <table>
    <tr><td>Glass card</td><td>✅ <code>backdrop-blur(36px) saturate(160%)</code> + inset highlight</td></tr>
    <tr><td>Glass nav buttons</td><td>✅ burger / phone / brand pill в стекле</td></tr>
    <tr><td>Inset white-1px border</td><td>✅ premium liquid feel</td></tr>
    <tr><td>Subtle orange glow</td><td>✅ один radial в нижнем углу за фото</td></tr>
    <tr><td>Soft photo blend</td><td>✅ navy gradient overlay плавный</td></tr>
  </table>
</div>

<div class="annot">
  <h3>Палитра v2 CALM</h3>
  <table>
    <tr><td><code style="color:var(--color-primary)">#ec7c00</code></td><td>primary (existing) — единственный акцент</td></tr>
    <tr><td><code style="color:#0d1a2b">#0d1a2b</code></td><td>navy (existing) — overlay</td></tr>
    <tr><td><code style="color:#ffd86b">#ffd86b</code></td><td>star yellow — только для ★ rating</td></tr>
    <tr><td><code>white/0.06–0.18</code></td><td>glass tints + borders</td></tr>
  </table>
  <p style="margin-top: 12px; color: #4b5263;"><strong>Итого 3 цвета</strong> (не считая star). Premium, спокойно, фото остаётся главным.</p>
</div>

</Base>
