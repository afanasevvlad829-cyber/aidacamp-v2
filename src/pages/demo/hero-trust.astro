---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import HeroMobile from '../../components/hero/Mobile.astro';
import HeroDesktopTrust from '../../components/hero/DesktopTrust.astro';
import HeroModals from '../../components/HeroModals.astro';
---

<Base title="Hero Trust — параллельный вариант (АйДаКемп)" noindex>
  <Header />
  <main>
    <div class="bg-emerald-100 text-emerald-900 text-center text-[13px] py-1.5 border-b border-emerald-200">
      <strong>DEMO Trust:</strong> ВСЁ кликабельно (контроль темпа Дарьи), CTA визуально доминирует, бейджи/печать/чип = микро-цели в Метрике (data-goal) ·
      <a href="/" class="underline">основной →</a>
    </div>

    <section id="hero" class="relative mx-auto w-full overflow-x-hidden bg-surface-warm md:max-w-[1440px]">
      <HeroMobile hasVariants={true} />
      <HeroDesktopTrust hasVariants={true} />
    </section>

    <HeroModals />

    <section id="shifts" class="py-24 px-6 text-center bg-slate-50">
      <h2 class="text-[24px] font-bold text-slate-700">↓ здесь начинаются смены</h2>
      <p class="text-[14px] text-slate-500 mt-2">(в demo-странице блок смен не подключён, проверяй только Hero выше)</p>
    </section>
  </main>
</Base>
