---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';

// Только те hero-bg, что реально используются на продакшне
const effects = [
  { id: 'glass-orbs',        page: '/o-lagere',              label: 'О нас',               color: '#3b82f6' },
  { id: 'quantum',           page: '/ai-lager',              label: 'AI-лагерь',            color: '#a855f7' },
  { id: 'circuit',           page: '/python-lager',          label: 'Python',               color: '#22c55e' },
  { id: 'interactive-stars', page: '/minecraft-lager',       label: 'Minecraft',            color: '#f59e0b' },
  { id: 'hexagons',          page: '/roblox-lager',          label: 'Roblox',               color: '#ef4444' },
  { id: 'particle-flow',     page: '/scratch-lager',         label: 'Scratch',              color: '#f97316' },
  { id: 'fiber',             page: '/3d-modelirovanie-lager',label: '3D',                   color: '#06b6d4' },
  { id: 'star-genesis',      page: '/lager-na-leto-2026',    label: 'Лето 2026',            color: '#fbbf24' },
  { id: 'neon-network',      page: '/lager-dlya-podrostkov', label: 'Подростки',            color: '#ec4899' },
  { id: 'ascendant',         page: '/lager-programmirovaniya',label: 'Программирование',    color: '#8b5cf6' },
  { id: 'fireflies',         page: '/lager-bez-telefonov',   label: 'Без телефонов',        color: '#84cc16' },
  { id: 'cosmic',            page: '/otzyvy',                label: 'Отзывы',               color: '#38bdf8' },
];
---

<Base title="[Демо] Продакшн-эффекты хиро — АйДаКемп" noindex>

  <div class="fixed top-0 inset-x-0 z-[200] flex items-center justify-center gap-3 bg-amber-400 py-2 text-[13px] font-semibold text-amber-900">
    <span>ДЕМО — hero-bg эффекты, реально используемые на сайте</span>
    <a href="/demo/hero-bg-presets" class="rounded-full bg-amber-900/15 px-3 py-0.5 hover:bg-amber-900/25 transition-colors">Все пресеты →</a>
    <a href="/demo/hero-effects-v3" class="rounded-full bg-amber-900/15 px-3 py-0.5 hover:bg-amber-900/25 transition-colors">Aurora v3 →</a>
  </div>
  <div class="h-9"></div>

  <main class="bg-[#060a12] min-h-screen pb-16">
    <div class="mx-auto max-w-[1312px] px-4 pt-8">
      <h1 class="text-[28px] font-bold text-white mb-2">Продакшн hero-bg эффекты</h1>
      <p class="text-[14px] text-white/50 mb-8">12 анимированных фонов — каждый закреплён за своей страницей</p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {effects.map((e) => (
          <div class="group relative">
            <!-- Превью -->
            <div
              data-hero-bg={e.id}
              class="relative h-[200px] rounded-[16px] overflow-hidden border border-white/10"
            >
              <!-- Overlay gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#060a12]/80 via-transparent to-transparent z-10"></div>
              <!-- Label overlay -->
              <div class="absolute bottom-0 inset-x-0 z-20 p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-[16px] font-bold text-white">{e.label}</p>
                    <code class="text-[11px] text-white/50 font-mono">{e.id}</code>
                  </div>
                  <a
                    href={e.page}
                    target="_blank"
                    rel="noopener"
                    class="flex items-center gap-1 rounded-full bg-white/15 border border-white/20 px-2.5 py-1 text-[11px] text-white/70 hover:bg-white/25 transition-colors"
                  >
                    <i class="bi bi-box-arrow-up-right text-[10px]" aria-hidden="true"></i>
                    сайт
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Легенда CSS-эффектов -->
      <div class="mt-12 rounded-[16px] bg-white/5 border border-white/10 p-6">
        <h2 class="text-[18px] font-bold text-white mb-4">CSS text-эффекты (без canvas)</h2>
        <p class="text-[13px] text-white/50 mb-4">Применяются через <code class="text-orange-400">data-hero-effect</code> на всех SEO-лендингах и статьях</p>
        <div class="grid gap-3 sm:grid-cols-3">
          {[
            { id: 'mesh',           count: '25 лендингов', desc: 'Сетка + свечение' },
            { id: 'noise',          count: '29 лендингов', desc: 'Зернистый фон' },
            { id: 'grid',           count: '33 лендинга',  desc: 'Линии сетки' },
            { id: 'editorial',      count: '25 статей',    desc: 'Редакционный' },
            { id: 'accent-bar',     count: '17 статей',    desc: 'Акцентная полоса' },
            { id: 'split-stagger',  count: '21 статья',    desc: 'Разделённый вход' },
          ].map((e) => (
            <div class="rounded-[10px] bg-white/5 border border-white/8 px-4 py-3">
              <code class="text-[12px] font-mono text-orange-400">{e.id}</code>
              <p class="mt-1 text-[13px] text-white/70">{e.desc}</p>
              <p class="mt-0.5 text-[11px] text-white/35">{e.count}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

</Base>
