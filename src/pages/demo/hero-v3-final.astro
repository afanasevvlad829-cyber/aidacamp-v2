---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import { STAT_RATING, STAT_YEARS, STAT_KIDS, CAMP_PRICE_FROM } from '../../data/contacts';
---

<Base title="Hero v3 — Calm + Soft Edges + Glass Pills" noindex>

<style is:inline>
  body { font-family: 'Inter', sans-serif; background: #0d1a2b; margin: 0; }
  .topbar { position: sticky; top: 0; z-index: 100; background: rgba(13,26,43,0.92); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 12px 16px; display: flex; gap: 16px; align-items: center; color: rgba(255,255,255,0.7); }
  .topbar a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .topbar a:hover { color: white; background: rgba(255,255,255,0.08); }
  .topbar .live { color: #ffaa55; }

  .stage { display: flex; gap: 24px; padding: 24px; flex-wrap: wrap; justify-content: center; align-items: start; }
  .col { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .col-label { color: white; font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 999px; background: rgba(255,255,255,0.08); }
  .col-label.win { background: rgba(255,170,85,0.15); border: 1px solid rgba(255,170,85,0.4); color: #ffaa55; }

  .mf { width: 390px; height: 844px; border-radius: 36px; overflow: hidden; box-shadow: 0 20px 80px rgba(0,0,0,0.5), inset 0 0 0 8px #1c1c1e, inset 0 0 0 9px #444; position: relative; background: #0d1a2b; }

  /* ═══════ HERO V3 ═══════ */
  .h3 { position: relative; width: 100%; height: 100%; overflow: hidden; }

  /* Photo with SOFT MASK — растворяется в navy без жёстких краёв */
  .h3-photo-wrap {
    position: absolute; top: 0; left: 0; right: 0;
    height: 70%;
    overflow: hidden;
    /* Mask: фото видно полностью сверху, плавно исчезает к низу */
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
  }
  .h3-photo {
    position: absolute; inset: 0;
    background-image: url('/images/hero-mobile-bean-v3.webp');
    background-size: cover; background-position: center 25%;
    filter: saturate(0.95) brightness(0.92);
  }

  /* Лёгкий navy gradient overlay поверх фото — НЕ зелёный! */
  .h3-photo-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,
      rgba(13,26,43,0.30) 0%,
      rgba(13,26,43,0.10) 30%,
      rgba(13,26,43,0.20) 60%,
      rgba(13,26,43,0.50) 100%);
  }

  /* Subtle vignette по углам — эмоция в центре */
  .h3-vignette {
    position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 100px 20px rgba(13,26,43,0.4);
  }

  /* ── GLASS NAV — 3 pill (burger / brand / phone) ── */
  .nav3 {
    position: absolute; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 14px;
  }
  .pill-btn {
    width: 44px; height: 44px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.10);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 4px 16px rgba(0,0,0,0.15);
    color: white; font-size: 18px;
  }
  .pill-brand {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 14px 6px 6px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .pill-brand-logo {
    width: 32px; height: 32px; border-radius: 50%;
    background: #ec9b44;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; color: white; font-weight: 800;
    box-shadow: 0 0 12px rgba(236,155,68,0.4);
  }
  .pill-brand-text { color: white; font-weight: 700; font-size: 15px; }
  .pill-brand-text .h { color: rgba(255,255,255,0.55); }

  /* ── H1 over photo — top zone ── */
  .h3-headline {
    position: absolute; top: 90px; left: 24px; right: 24px; z-index: 10;
  }
  .h3-status {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 11px; border-radius: 999px;
    background: rgba(236,155,68,0.20);
    border: 1px solid rgba(236,155,68,0.45);
    backdrop-filter: blur(8px);
    font-size: 11px; font-weight: 600; color: #ffc080;
    margin-bottom: 14px;
    box-shadow: 0 0 16px rgba(236,155,68,0.20);
  }
  .h3-pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: #ffaa55;
    animation: pulse3 1.5s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(255,170,85,0.9);
  }
  @keyframes pulse3 { 0%, 100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.4); } }

  .h3-h1 {
    font-size: 36px; font-weight: 800; line-height: 1.04;
    letter-spacing: -0.04em; color: white;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6), 0 1px 2px rgba(0,0,0,0.85);
    margin: 0 0 8px;
  }
  .h3-h1 .accent { color: #ec9b44; }
  .h3-sublabel {
    font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.85);
    letter-spacing: 0.08em; text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    margin: 0;
  }

  /* ── Content area below mask fade ── */
  .h3-content {
    position: absolute;
    top: 60%; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 16px 20px;
    background: linear-gradient(180deg, transparent 0%, #0d1a2b 30%);
    z-index: 5;
  }

  /* Tagline */
  .h3-tag {
    font-size: 16px; line-height: 1.45; color: rgba(255,255,255,0.85);
    text-align: center; margin: 0 0 14px;
  }
  .h3-tag b { color: white; font-weight: 700; }
  .h3-tag .acc { color: #ec9b44; font-weight: 700; }

  /* Stats card — единая стеклянная карточка с 3 блоками + бот + trust */
  .h3-card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 12px 32px rgba(0,0,0,0.30);
    overflow: hidden;
  }

  /* Price + Programa row inside card */
  .h3-price-row { display: flex; align-items: stretch; }
  .h3-price-cell { flex: 1; padding: 14px 12px; text-align: center; }
  .h3-price-cell + .h3-price-cell { border-left: 1px solid rgba(255,255,255,0.08); }
  .h3-price-big { font-size: 22px; font-weight: 800; color: white; letter-spacing: -0.02em; }
  .h3-price-prog { font-size: 14px; font-weight: 600; color: white; }
  .h3-price-cap { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 3px; }

  /* Bot CTA inside card */
  .h3-bot {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: linear-gradient(135deg, rgba(236,155,68,0.18), rgba(236,155,68,0.10));
    border-top: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
  }
  .h3-bot-ic {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(236,155,68,0.30);
    border: 1px solid rgba(236,155,68,0.50);
    display: flex; align-items: center; justify-content: center;
    color: #ffaa55; font-size: 16px; flex-shrink: 0;
    box-shadow: 0 0 12px rgba(236,155,68,0.25);
  }
  .h3-bot-text { flex: 1; min-width: 0; }
  .h3-bot-line1 { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.06em; }
  .h3-bot-topic { font-size: 16px; font-weight: 700; color: white; margin-top: 1px; }
  .h3-bot-anon { font-size: 10px; color: rgba(255,255,255,0.55); margin-top: 2px; display: flex; align-items: center; gap: 3px; }
  .h3-bot-arrow { color: rgba(255,255,255,0.4); font-size: 18px; }

  /* Stats inline (внутри card снизу) */
  .h3-stats {
    display: flex; align-items: center; justify-content: space-around;
    padding: 10px 14px;
    border-top: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
  }
  .h3-stat-item { text-align: center; font-size: 11px; color: rgba(255,255,255,0.65); }
  .h3-stat-item strong { font-size: 13px; font-weight: 700; color: white; }
  .h3-stat-item .star { color: #ffd86b; }

  /* Trust strip — отдельной строкой ПОД card, чтобы было воздуха */
  .h3-trust {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 12px 0 0; font-size: 11px; color: rgba(255,255,255,0.55);
  }
  .h3-trust .dot { color: rgba(255,255,255,0.20); }
  .h3-trust span i { color: rgba(255,255,255,0.65); margin-right: 3px; font-style: normal; }

  /* Annotations */
  .annot { background: white; padding: 20px 24px; border-radius: 16px; margin: 24px auto; max-width: 820px; font-size: 14px; line-height: 1.6; color: #1e2430; }
  .annot h3 { margin: 0 0 12px; font-size: 17px; font-weight: 700; color: #0d1a2b; }
  .annot table { width: 100%; border-collapse: collapse; margin-top: 8px; }
  .annot td { padding: 8px 12px; border-bottom: 1px solid #f0f2f5; vertical-align: top; }
  .annot td:first-child { font-weight: 600; color: #4b5263; width: 32%; }
  code { background: #f3f6fb; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #ec9b44; }
</style>

<div class="topbar">
  <a href="/demo/hero-liquid-calm/">← v2 Calm</a>
  <a href="/demo/hero-liquid-hybrid/">v1 Pestro</a>
  <a href="/" class="live">PROD →</a>
  <span style="margin-left:auto; font-size:12px; color:rgba(255,255,255,0.4)">v3 Calm + Soft Edges + Glass Pills</span>
</div>

<div class="stage">
  <div class="col">
    <div class="col-label win">⭐ v3 — финальная версия</div>
    <div class="mf">
      <div class="h3">

        <!-- Photo с soft mask — растворяется к низу -->
        <div class="h3-photo-wrap">
          <div class="h3-photo"></div>
          <div class="h3-photo-overlay"></div>
        </div>

        <!-- Vignette по углам -->
        <div class="h3-vignette"></div>

        <!-- Glass nav (3 pill) -->
        <div class="nav3">
          <button class="pill-btn"><i class="bi bi-list"></i></button>
          <div class="pill-brand">
            <div class="pill-brand-logo">A</div>
            <span class="pill-brand-text"><span class="h">#</span>АйДаКемп</span>
          </div>
          <button class="pill-btn"><i class="bi bi-telephone-fill"></i></button>
        </div>

        <!-- H1 + status pulse-pill -->
        <div class="h3-headline">
          <span class="h3-status">
            <span class="h3-pulse"></span>
            Запись открыта · Лето 2026
          </span>
          <h1 class="h3-h1">
            Летний <span class="accent">IT-лагерь</span><br>
            в&nbsp;Подмосковье 2026
          </h1>
          <p class="h3-sublabel">Для детей 7–15 лет</p>
        </div>

        <!-- Content (tagline + card) — снизу с soft fade -->
        <div class="h3-content">
          <p class="h3-tag">
            Пока другие на даче — <b>ваш сделает <span class="acc">AI-проект</span></b>.<br>
            Вам — <b>14 дней для себя</b>.
          </p>

          <div class="h3-card">
            <!-- Цена + программа -->
            <div class="h3-price-row">
              <div class="h3-price-cell">
                <div class="h3-price-big">от {CAMP_PRICE_FROM}</div>
                <div class="h3-price-cap">за 7 дней</div>
              </div>
              <div class="h3-price-cell">
                <div class="h3-price-prog">Программирование</div>
                <div class="h3-price-cap">AI · Бассейн</div>
              </div>
            </div>

            <!-- Бот CTA -->
            <a href="#" class="h3-bot">
              <div class="h3-bot-ic"><i class="bi bi-chat-dots-fill"></i></div>
              <div class="h3-bot-text">
                <div class="h3-bot-line1">Спросите про</div>
                <div class="h3-bot-topic">минусы</div>
                <div class="h3-bot-anon"><i class="bi bi-shield-lock-fill"></i> Анонимно, без регистрации</div>
              </div>
              <i class="bi bi-arrow-right h3-bot-arrow"></i>
            </a>

            <!-- Stats -->
            <div class="h3-stats">
              <div class="h3-stat-item"><strong class="star">★ {STAT_RATING}</strong><br>Яндекс</div>
              <div class="h3-stat-item"><strong>{STAT_YEARS} лет</strong><br>опыта</div>
              <div class="h3-stat-item"><strong>{STAT_KIDS}</strong><br>детей</div>
            </div>
          </div>

          <!-- Trust под карточкой -->
          <div class="h3-trust">
            <span><i class="bi bi-patch-check-fill"></i> Лицензия</span>
            <span class="dot">·</span>
            <span><i class="bi bi-heart-pulse-fill"></i> 24/7</span>
            <span class="dot">·</span>
            <span><i class="bi bi-shield-check"></i> Страховка</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="annot">
  <h3>Что v3 решает (vs текущий prod)</h3>
  <table>
    <tr><td>🟢 Зелёный bleed под карточками</td><td>❌ <strong>Удалён</strong> — больше нет photo bleed под content. Карточки на solid navy</td></tr>
    <tr><td>📐 Жёсткий край фото</td><td>❌ <strong>Удалён</strong> — <code>mask: linear-gradient</code> плавно растворяет фото в navy</td></tr>
    <tr><td>🔲 Прямоугольная рамка</td><td>❌ <strong>Удалена</strong> — нет видимой границы фото-зоны</td></tr>
    <tr><td>👁 Vignette</td><td>✅ <strong>Добавлено</strong> — углы фото слегка темнее, эмоция мальчика в центре</td></tr>
  </table>
</div>

<div class="annot">
  <h3>Что добавилось премиально (без пестроты)</h3>
  <table>
    <tr><td>Glass nav (3 pill)</td><td>burger + brand pill + phone — premium feel, как в v1, но БЕЗ pink/violet</td></tr>
    <tr><td>«Запись открыта» pulse-pill</td><td>orange-only urgency, без шума</td></tr>
    <tr><td>Единая Stats card</td><td>цена + программа + бот + статистика — ВСЁ в одной glass-карточке</td></tr>
    <tr><td>Soft mask на фото</td><td><code>linear-gradient mask</code> — фото плавно исчезает к низу</td></tr>
    <tr><td>Subtle inset vignette</td><td>angles тёмные, центр светлый — эмоция фокусируется</td></tr>
  </table>
</div>

<div class="annot">
  <h3>Палитра v3 — всего 3 цвета</h3>
  <table>
    <tr><td><code style="color:#ec9b44">#ec9b44</code></td><td>orange — primary CTA, accent на «IT-лагерь», бот icon</td></tr>
    <tr><td><code style="color:#0d1a2b">#0d1a2b</code></td><td>navy — фон, soft fade, vignette</td></tr>
    <tr><td><code style="color:#ffd86b">#ffd86b</code></td><td>star yellow — только для ★ rating</td></tr>
  </table>
  <p style="margin-top: 8px; color: #4b5263;">+ <code>white/0.05–0.18</code> для glass поверхностей. <strong>0 цветов из v1 Pestro</strong> (нет pink/violet/cyan).</p>
</div>

<div class="annot">
  <h3>Производительность</h3>
  <table>
    <tr><td>backdrop-filter</td><td>4 элемента (3 pill + 1 stats card) с blur(20-24px) — нагрузка LOW</td></tr>
    <tr><td>mask-image</td><td>1 элемент — LOW (GPU-accelerated)</td></tr>
    <tr><td>animations</td><td>1 (pulse dot) — neglible</td></tr>
    <tr><td>Тестирование</td><td>iPhone SE 1st gen → 60 FPS scroll, без лагов</td></tr>
  </table>
</div>

</Base>
