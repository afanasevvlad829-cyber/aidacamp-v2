---
// Wireframes всех 21 блоков главной страницы
// Mobile (375px) + Desktop (1280px) · Day / Night tabs
// SEO-разметка · Поведение загрузки · design/glassmorphism-v1
import '../../styles/global.css';
import { mainShifts, shortShifts, renderCard } from '../../data/shifts';
import DualRatingPill from '../../components/DualRatingPill.astro';
import IncampBadge from '../../components/IncampBadge.astro';
import Shifts from '../../components/Shifts.astro';
import FAQ from '../../components/FAQ.astro';
import Reviews from '../../components/Reviews.astro';
import { STAT_RATING, YANDEX_MAPS_URL } from '../../data/contacts';
const allDemoShifts = [mainShifts[0], mainShifts[1], ...shortShifts, mainShifts[2], mainShifts[3]];
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>АйДаКемп — 21 блок · День / Ночь</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style is:inline>
    /* ══════════ DESIGN TOKENS (из global.css @theme) ══════════
       Дефолт = светлая тема. Тёмная переопределяет только нужные токены.
       Переключатель День/Ночь меняет только data-theme — CSS делает остальное.
    */
    :root {
      /* Brand */
      --pr:    #ec7c00;  --pr-l: #f59332;  --pr-s: #fff1df;
      --bl:    #1b4fd8;  --bl-s: #eff6ff;
      /* Navy (всегда тёмный — hero-фото, BookingBar) */
      --nv:    #0d1a2b;  --nv2:  #162035;
      /* Поверхности (светлые по дефолту) */
      --bg-page:   #eef1f6;
      --bg-card:   #ffffff;
      --bg-header: rgba(255,255,255,0.96);
      --bg-header-border: #e5e7eb;
      --bg-card-header: #fafafa;
      --bg-notes: #fafafa;
      --sf:    #f7f8fb;  --sf-alt: #f0f4ff;  --sf-warm: #f7f5f2;
      /* Текст */
      --tx:    #1e2430;  --tx-m: #4b5263;  --tx-f: #6b7280;
      /* Граница */
      --bd:    #e5e7eb;  --bd-sub: #f0f2f5;
      /* Фрейм */
      --frame-bg:    #ffffff;
      --frame-shadow: rgba(0,0,0,0.12);
      /* Рамка блок-карточки */
      --card-bg:    #ffffff;
      --card-border: #e5e7eb;
      --card-shadow: 0 1px 6px rgba(0,0,0,0.06);
      /* Бейджи (light) */
      --badge-blue-bg: rgba(59,130,246,0.1);  --badge-blue-tx: #2563eb;
      --badge-red-bg:  rgba(239,68,68,0.08);  --badge-red-tx:  #dc2626;
      --badge-grn-bg:  rgba(16,185,129,0.1);  --badge-grn-tx:  #059669;
      --badge-or-bg:   rgba(236,124,0,0.1);   --badge-or-tx:   #d97706;
      --badge-gr-bg:   rgba(100,116,139,0.1); --badge-gr-tx:   #64748b;
      /* Ноты (метки SEO/Load/UX) */
      --note-seo:  #2563eb;  --note-load: #059669;  --note-ux: #d97706;
      --note-tx:   #6b7280;  --note-dot:  #d1d5db;
      /* Номер блока */
      --num-bg:    rgba(27,79,216,0.1);    --num-tx: #1b4fd8;
      --num1-bg:   rgba(236,124,0,0.1);   --num1-tx: #ec7c00;
      --num2-bg:   rgba(16,185,129,0.1);  --num2-tx: #059669;
      /* Тогл */
      --toggle-bg: rgba(0,0,0,0.06);
    }

    /* ── ТЁМНАЯ ТЕМА: только переопределение токенов ── */
    [data-theme="dark"] {
      --bg-page:   #0a1220;
      --bg-card:   rgba(255,255,255,0.04);
      --bg-header: rgba(15,23,42,0.95);
      --bg-header-border: rgba(255,255,255,0.08);
      --bg-card-header: transparent;
      --bg-notes: transparent;
      --sf:    #0f172a;  --sf-alt: #1e293b;  --sf-warm: #1a1a2e;
      --tx:    #f1f5f9;  --tx-m: #94a3b8;  --tx-f: #64748b;
      --bd:    #1e293b;  --bd-sub: rgba(255,255,255,0.06);
      --frame-bg:    #0f172a;
      --frame-shadow: rgba(0,0,0,0.5);
      --card-bg:    rgba(255,255,255,0.04);
      --card-border: rgba(255,255,255,0.08);
      --card-shadow: none;
      --badge-blue-bg: rgba(59,130,246,0.15);  --badge-blue-tx: #60a5fa;
      --badge-red-bg:  rgba(239,68,68,0.15);   --badge-red-tx:  #f87171;
      --badge-grn-bg:  rgba(16,185,129,0.15);  --badge-grn-tx:  #34d399;
      --badge-or-bg:   rgba(236,124,0,0.15);   --badge-or-tx:   #f59332;
      --badge-gr-bg:   rgba(100,116,139,0.15); --badge-gr-tx:   #94a3b8;
      --note-seo:  #60a5fa;  --note-load: #34d399;  --note-ux: #f59332;
      --note-tx:   #64748b;  --note-dot:  #334155;
      --num-bg:    rgba(27,79,216,0.2);    --num-tx: #60a5fa;
      --num1-bg:   rgba(236,124,0,0.15);  --num1-tx: #f59332;
      --num2-bg:   rgba(16,185,129,0.12); --num2-tx: #34d399;
      --toggle-bg: rgba(255,255,255,0.06);
    }

    html { box-sizing: border-box; }
    body, div, section, article, p, h1, h2, h3, span, a, button, input, label {
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg-page);
      color: var(--tx);
      margin: 0;
      transition: background 0.3s, color 0.3s;
    }

    /* ── Header ── */
    .hdr {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg-header);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--bg-header-border);
      padding: 12px 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .hdr-title { font-size: 15px; font-weight: 700; color: var(--tx); }
    .hdr-sub { font-size: 12px; color: var(--tx-f); margin-top: 2px; }

    /* ── Day/Night toggle ── */
    .toggle-wrap { display: flex; gap: 0; background: var(--toggle-bg); border-radius: 10px; padding: 3px; }
    .toggle-btn {
      padding: 6px 16px; border-radius: 8px; border: none; cursor: pointer;
      font-size: 13px; font-weight: 600; transition: all 0.2s;
      background: transparent; color: var(--tx-f);
    }
    .toggle-btn.active { background: var(--bl); color: white; }

    /* ── Block cards ── */
    .wrap { max-width: 1400px; margin: 0 auto; padding: 24px; }
    .block-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      margin-bottom: 32px;
      overflow: hidden;
      box-shadow: var(--card-shadow);
    }

    /* ── Обёртка реального компонента ── */
    .component-live {
      border-top: 1px solid var(--bd-sub);
    }
    .component-live-label {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 20px;
      font-size: 11px;
      font-weight: 600;
      color: #16a34a;
      background: #f0fdf4;
      border-bottom: 1px solid #dcfce7;
      letter-spacing: 0.01em;
    }
    .component-live-label .bi { font-size: 12px; }
    .component-live-wrap {
      /* Компонент рендерится в своём естественном размере */
      width: 100%;
      overflow-x: auto;
    }
    .block-header {
      display: grid;
      grid-template-columns: 48px 1fr auto;
      align-items: center;
      gap: 14px;
      padding: 16px 20px;
      background: var(--bg-card-header);
      border-bottom: 1px solid var(--bd-sub);
    }
    .block-num {
      width: 40px; height: 40px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 800;
      background: var(--num-bg); color: var(--num-tx);
    }
    .block-num.tier1 { background: var(--num1-bg); color: var(--num1-tx); }
    .block-num.tier2 { background: var(--num2-bg); color: var(--num2-tx); }
    .block-name { font-size: 17px; font-weight: 700; color: var(--tx); }
    .block-file { font-size: 12px; font-family: monospace; color: var(--tx-f); margin-top: 2px; }
    .badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge {
      font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px;
      letter-spacing: 0.06em; text-transform: uppercase;
    }
    .badge-red    { background: var(--badge-red-bg);  color: var(--badge-red-tx); }
    .badge-blue   { background: var(--badge-blue-bg); color: var(--badge-blue-tx); }
    .badge-green  { background: var(--badge-grn-bg);  color: var(--badge-grn-tx); }
    .badge-orange { background: var(--badge-or-bg);   color: var(--badge-or-tx); }
    .badge-gray   { background: var(--badge-gr-bg);   color: var(--badge-gr-tx); }

    /* ── Previews ── */
    .previews {
      display: grid;
      grid-template-columns: 375px 1fr;
      gap: 0;
      border-bottom: 1px solid var(--bd-sub);
    }
    .preview-mobile {
      border-right: 1px solid var(--bd-sub);
      padding: 20px;
    }
    .preview-desktop { padding: 20px; }
    .preview-label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--tx-f); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;
    }

    /* ── Mobile frame ── */
    .phone-frame {
      width: 335px;
      background: var(--frame-bg);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 32px var(--frame-shadow);
    }

    /* ── Desktop frame ── */
    .desktop-frame {
      background: var(--frame-bg);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 20px var(--frame-shadow);
    }

    /* ── Notes row ── */
    .notes { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; background: var(--bg-notes); }
    .note-col { padding: 14px 20px; border-right: 1px solid var(--bd-sub); }
    .note-col:last-child { border-right: none; }
    .note-title {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      margin-bottom: 8px;
    }
    .note-title.seo  { color: var(--note-seo); }
    .note-title.load { color: var(--note-load); }
    .note-title.ux   { color: var(--note-ux); }
    .note-item {
      font-size: 12px; color: var(--note-tx); line-height: 1.5;
      display: flex; gap: 6px; margin-bottom: 4px;
    }
    .note-item::before { content: '·'; color: var(--note-dot); flex-shrink: 0; }

    /* ── Font-size labels (показывают размер шрифта прямо в демо) ── */
    .fs-wrap { position: relative; display: inline-block; }
    .fs-label {
      position: absolute; top: -1px; right: -2px; transform: translateY(-100%);
      background: #ec7c00; color: white;
      font-size: 9px; font-weight: 700; line-height: 1;
      padding: 2px 5px; border-radius: 3px; white-space: nowrap;
      pointer-events: none; z-index: 10; letter-spacing: 0.02em;
    }
    [data-theme="light"] .fs-label { background: #1b4fd8; }

    /* ── Hero variants grid ── */
    .hero-variants { display: grid; grid-template-columns: 335px 335px; gap: 16px; }

    /* ── Pine / forest hero background ── */
    .hero-pine {
      height: 220px;
      background: linear-gradient(160deg, #1a3a1f 0%, #2d5a27 40%, #0d2b10 100%);
      position: relative; display: flex; align-items: flex-end;
    }
    .hero-pine::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 60px 140px at 10% 100%, rgba(30,80,20,0.6) 0%, transparent 70%),
        radial-gradient(ellipse 50px 120px at 25% 100%, rgba(20,60,15,0.5) 0%, transparent 70%),
        radial-gradient(ellipse 70px 150px at 45% 100%, rgba(25,70,18,0.5) 0%, transparent 70%),
        radial-gradient(ellipse 55px 130px at 65% 100%, rgba(20,65,15,0.6) 0%, transparent 70%),
        radial-gradient(ellipse 60px 140px at 85% 100%, rgba(30,80,20,0.5) 0%, transparent 70%),
        linear-gradient(180deg, transparent 40%, rgba(0,15,0,0.7) 100%);
    }

    /* ── Video hero placeholder ── */
    .hero-video-bg {
      height: 220px;
      background: #0d1a2b;
      position: relative; display: flex; align-items: flex-end; overflow: hidden;
    }
    .hero-video-bg::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, #0a1520 0%, #162230 50%, #0d1a2b 100%);
    }
    .video-play-hint {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-60%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.4); font-size: 10px; text-align: center;
    }
    .video-play-icon {
      width: 36px; height: 36px; border-radius: 50%;
      border: 1.5px solid rgba(255,255,255,0.25);
      display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.4); font-size: 14px;
    }
    .video-scan-line {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255,255,255,0.01) 3px, rgba(255,255,255,0.01) 4px);
    }

    /* ══════════ LIGHT THEME COMPONENTS ══════════ */
    /* Used inside phone-frame / desktop-frame when data-theme="light" */

    /* Hero */
    .hero-photo {
      height: 220px;
      background: linear-gradient(135deg, #1e3a5f, #0d1a2b);
      position: relative;
      display: flex; align-items: flex-end;
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, transparent 30%, rgba(13,26,43,0.9) 100%);
    }
    .hero-text { position: relative; z-index: 1; padding: 16px; width: 100%; }
    .tagline-pill {
      display: inline-flex; align-items: center;
      background: rgba(236,124,0,0.15); border: 1px solid rgba(236,124,0,0.4);
      border-radius: 100px; padding: 3px 10px; margin-bottom: 6px;
      font-size: 10px; font-weight: 600; color: #f59332;
    }
    .hero-h1 { font-size: 22px; font-weight: 800; color: white; line-height: 1.1; margin: 0 0 4px; }
    .hero-sub { font-size: 13px; color: rgba(255,255,255,0.7); margin: 0; }
    .hero-btns { display: flex; gap: 8px; padding: 12px 16px; background: #0d1a2b; }
    .btn-outline-or {
      flex: 1; height: 40px; border-radius: 100px;
      border: 1.5px solid rgba(236,124,0,0.7); background: transparent;
      color: #f59332; font-size: 13px; font-weight: 600;
      display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;
    }
    .btn-outline-wh {
      flex: 1; height: 40px; border-radius: 100px;
      border: 1.5px solid rgba(255,255,255,0.25); background: transparent;
      color: rgba(255,255,255,0.8); font-size: 13px; font-weight: 600;
      display: flex; align-items: center; justify-content: center; gap: 5px; cursor: pointer;
    }
    .btn-explain { font-size: 10px; color: rgba(255,255,255,0.35); text-align: center; padding: 4px 16px 8px; background: #0d1a2b; }
    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 10px 14px; background: #0d1a2b; }
    .metric-cell {
      background: rgba(255,255,255,0.06); border-radius: 10px;
      padding: 10px 12px; text-align: center;
    }
    .metric-num { font-size: 18px; font-weight: 800; color: white; line-height: 1; }
    .metric-lbl { font-size: 10px; color: rgba(255,255,255,0.4); margin-top: 2px; }
    .trust-row { display: flex; gap: 6px; padding: 10px 14px 14px; background: #0d1a2b; }
    .trust-pill {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;
      border-radius: 100px; background: rgba(30,64,175,0.4); border: 1px solid rgba(96,165,250,0.4);
      padding: 6px 4px; font-size: 10px; font-weight: 500; color: #bfdbfe;
    }

    /* Shifts section */
    .shifts-section { background: linear-gradient(135deg, #eff6ff, #dbeafe); padding: 14px; }
    .sec-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #1b4fd8; margin-bottom: 4px; }
    .sec-h2 { font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 10px; }
    .shift-card-glass {
      background: rgba(255,255,255,0.72); backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.8); border-radius: 14px; padding: 12px;
      margin-bottom: 8px; box-shadow: 0 4px 16px rgba(27,79,216,0.08);
    }
    .shift-name { font-size: 14px; font-weight: 700; color: #0f172a; }
    .shift-dates { font-size: 11px; color: #475569; margin: 2px 0 6px; }
    .shift-price { font-size: 16px; font-weight: 800; color: #ec7c00; margin-bottom: 8px; }
    .progress-bar { height: 6px; background: rgba(203,213,225,0.5); border-radius: 4px; overflow: hidden; margin-bottom: 8px; }
    .progress-fill { height: 100%; background: #94a3b8; border-radius: 4px; }
    .btn-select {
      width: 100%; height: 36px; border-radius: 100px;
      background: #ec7c00; color: white; border: none;
      font-size: 13px; font-weight: 700; cursor: pointer;
    }

    /* Card white */
    .card-w { background: white; border-radius: 14px; padding: 14px; border: 1px solid #f3f4f6; margin-bottom: 8px; }
    .card-w-dark { background: #1e293b; border-radius: 14px; padding: 14px; border: 1px solid #334155; margin-bottom: 8px; }

    /* Section wrapper light */
    .sec-light { background: #f7f8fb; padding: 14px; }
    .sec-blue { background: #f0f4ff; padding: 14px; }
    .sec-warm { background: #f7f5f2; padding: 14px; }
    .sec-dark { background: #0d1a2b; padding: 14px; }
    .sec-navy { background: #0f172a; padding: 14px; }

    /* Text helpers */
    .t-h2 { font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 6px; }
    .t-h2-d { font-size: 17px; font-weight: 800; color: #f1f5f9; margin: 0 0 6px; }
    .t-p { font-size: 12px; color: #4b5263; line-height: 1.55; margin: 0 0 8px; }
    .t-p-d { font-size: 12px; color: #94a3b8; line-height: 1.55; margin: 0 0 8px; }
    .accent { color: #ec7c00; }
    .t-muted { font-size: 10px; color: #9ca3af; }

    /* Review card */
    .review-card { background: white; border-radius: 12px; padding: 12px; border: 1px solid #f3f4f6; margin-bottom: 6px; }
    .review-card-d { background: #1e293b; border-radius: 12px; padding: 12px; border: 1px solid #334155; margin-bottom: 6px; }
    .stars { color: #f59332; font-size: 11px; margin-bottom: 4px; }
    .review-text { font-size: 11px; color: #4b5263; line-height: 1.5; margin-bottom: 6px; }
    .review-text-d { font-size: 11px; color: #94a3b8; line-height: 1.5; margin-bottom: 6px; }
    .reviewer { font-size: 10px; font-weight: 600; color: #6b7280; }

    /* FAQ item */
    .faq-item { background: white; border: 1px solid #e5e7eb; border-radius: 10px; margin-bottom: 5px; overflow: hidden; }
    .faq-item-d { background: #1e293b; border: 1px solid #334155; border-radius: 10px; margin-bottom: 5px; overflow: hidden; }
    .faq-q { padding: 10px 12px; font-size: 13px; font-weight: 600; color: #1e2430; display: flex; justify-content: space-between; align-items: center; }
    .faq-q-d { padding: 10px 12px; font-size: 13px; font-weight: 600; color: #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
    .faq-a { padding: 0 12px 10px; font-size: 11px; color: #4b5263; line-height: 1.5; border-top: 1px solid #f3f4f6; padding-top: 8px; }
    .faq-a-d { padding: 0 12px 10px; font-size: 11px; color: #94a3b8; line-height: 1.5; border-top: 1px solid #334155; padding-top: 8px; }

    /* CTA block */
    .cta-block { background: #1b4fd8; padding: 16px; border-radius: 14px; }
    .cta-h { font-size: 18px; font-weight: 800; color: white; margin: 0 0 4px; line-height: 1.2; }
    .cta-sub { font-size: 12px; color: rgba(255,255,255,0.65); margin: 0 0 12px; }
    .cta-input { width: 100%; height: 40px; border-radius: 100px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: white; padding: 0 14px; font-size: 13px; margin-bottom: 8px; }
    .cta-btn { width: 100%; height: 44px; border-radius: 100px; background: #ec7c00; color: white; border: none; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }

    /* Gallery grid */
    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    .gallery-cell { background: #cbd5e1; border-radius: 6px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #64748b; }
