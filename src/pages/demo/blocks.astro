<script is:inline>
  // Day / Night theme toggle
  function setTheme(mode) {
    document.documentElement.setAttribute('data-theme', mode);
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.mode === mode);
    });

    // Swap component colors
    const isDark = mode === 'dark';

    // Phone frames
    document.querySelectorAll('.phone-frame').forEach(el => {
      el.style.background = isDark ? '#0f172a' : 'white';
    });
    document.querySelectorAll('.desktop-frame').forEach(el => {
      if (!el.style.background || el.style.background === 'white') {
        el.style.background = isDark ? '#0f172a' : 'white';
      }
    });

    // Section backgrounds
    document.querySelectorAll('.sec-light').forEach(el => {
      el.style.background = isDark ? '#0f172a' : '#f7f8fb';
    });
    document.querySelectorAll('.sec-blue').forEach(el => {
      el.style.background = isDark ? '#0f1729' : '#f0f4ff';
    });
    document.querySelectorAll('.sec-warm').forEach(el => {
      el.style.background = isDark ? '#1a1410' : '#f7f5f2';
    });

    // Text colors
    document.querySelectorAll('.t-h2').forEach(el => {
      el.style.color = isDark ? '#f1f5f9' : '#0f172a';
    });
    document.querySelectorAll('.t-p').forEach(el => {
      el.style.color = isDark ? '#94a3b8' : '#4b5263';
    });

    // Cards
    document.querySelectorAll('.card-w, .review-card, .economy-card, .faq-item, .mentor-card, .shift-card-glass, .softstart-card, .mom-story').forEach(el => {
      el.style.background = isDark ? '#1e293b' : '';
      el.style.borderColor = isDark ? '#334155' : '';
    });
    document.querySelectorAll('.mentor-name, .shift-name, .faq-q, .review-card').forEach(el => {
      el.style.color = isDark ? '#f1f5f9' : '';
    });
    document.querySelectorAll('.occ-label').forEach(el => {
      el.style.color = isDark ? '#e2e8f0' : '#1e2430';
    });
    document.querySelectorAll('.occupancy-bar').forEach(el => {
      el.style.background = isDark ? '#1e293b' : '#eff6ff';
    });
    document.querySelectorAll('.seo-link').forEach(el => {
      el.style.borderColor = isDark ? '#334155' : '#e5e7eb';
      el.style.color = isDark ? '#94a3b8' : '#374151';
    });
    document.querySelectorAll('.occ-bar').forEach(el => {
      el.style.background = isDark ? '#1e3a5f' : '#dbeafe';
    });
  }

  // Init dark
  setTheme('dark');
</script>
</body>
