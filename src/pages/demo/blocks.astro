<script is:inline>
  // Day / Night theme toggle
  function setTheme(mode) {
    // Все структурные токены — через CSS-переменные автоматически.
    // Здесь только переключаем атрибут и кнопки.
    document.documentElement.setAttribute('data-theme', mode);
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.mode === mode);
    });

    // Компоненты внутри фреймов — секции и карточки (пока через JS,
    // полный токен-рефактор внутренних компонентов — следующий шаг)
    const isDark = mode === 'dark';

    // Section backgrounds (используем токены --sf, --sf-alt, --sf-warm)
    const sf     = isDark ? '#0f172a' : '#f7f8fb';
    const sfAlt  = isDark ? '#0f1729' : '#f0f4ff';
    const sfWarm = isDark ? '#1a1a2e' : '#f7f5f2';

    document.querySelectorAll('.sec-light').forEach(el => { el.style.background = sf; });
    document.querySelectorAll('.sec-blue').forEach(el  => { el.style.background = sfAlt; });
    document.querySelectorAll('.sec-warm').forEach(el  => { el.style.background = sfWarm; });

    // Text (--tx, --tx-m)
    const tx  = isDark ? '#f1f5f9' : '#0f172a';
    const txM = isDark ? '#94a3b8' : '#4b5263';
    document.querySelectorAll('.t-h2').forEach(el => { el.style.color = tx; });
    document.querySelectorAll('.t-p').forEach(el  => { el.style.color = txM; });

    // Cards (--sf-alt border --bd)
    const cardBg = isDark ? '#1e293b' : '';
    const cardBd = isDark ? '#334155' : '';
    document.querySelectorAll('.card-w, .review-card, .economy-card, .faq-item, .mentor-card, .shift-card-glass, .softstart-card, .mom-story').forEach(el => {
      el.style.background   = cardBg;
      el.style.borderColor  = cardBd;
    });
    document.querySelectorAll('.mentor-name, .shift-name, .faq-q').forEach(el => {
      el.style.color = isDark ? '#f1f5f9' : '';
    });

    // Occupancy bar
    document.querySelectorAll('.occ-label').forEach(el => {
      el.style.color = isDark ? '#e2e8f0' : '#1e2430';
    });
    document.querySelectorAll('.occupancy-bar').forEach(el => {
      el.style.background = isDark ? '#1e293b' : '#eff6ff';
    });
    document.querySelectorAll('.occ-bar').forEach(el => {
      el.style.background = isDark ? '#1e3a5f' : '#dbeafe';
    });

    // SEO links
    document.querySelectorAll('.seo-link').forEach(el => {
      el.style.borderColor = isDark ? '#334155' : '#e5e7eb';
      el.style.color       = isDark ? '#94a3b8'  : '#374151';
    });

    // sec-dark / card-w-dark / hackathon-dark — намеренно всегда тёмные
  }

  // Init dark
  setTheme('dark');
</script>
