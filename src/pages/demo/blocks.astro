---
// Wireframes всех 21 блоков главной страницы
// Mobile (375px) + Desktop (1280px) · Day / Night tabs
// SEO-разметка · Поведение загрузки · design/glassmorphism-v1
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>АйДаКемп — 21 блок · День / Ночь</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style is:inline>
    :root {
      --pr: #ec7c00; --pr-l: #f59332; --pr-s: #fff1df;
      --bl: #1b4fd8; --bl-s: #eff6ff;
      --nv: #0d1a2b; --nv2: #162035;
      --tx: #1e2430; --tx-m: #4b5263; --tx-f: #6b7280;
      --sf: #f7f8fb; --sf-alt: #f0f4ff; --sf-warm: #f7f5f2;
      --bd: #e5e7eb;
    }
    [data-theme="dark"] {
      --tx: #f1f5f9; --tx-m: #94a3b8; --tx-f: #64748b;
      --sf: #0f172a; --sf-alt: #1e293b; --sf-warm: #1a1a2e;
      --bd: #1e293b;
    }

    html { box-sizing: border-box; }
    body, div, section, article, p, h1, h2, h3, span, a, button, input, label {
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: #0f172a;
      color: #f1f5f9;
      margin: 0;
      transition: background 0.3s, color 0.3s;
    }

    /* ── Header ── */
    .hdr {
      position: sticky; top: 0; z-index: 100;
      background: rgba(15,23,42,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 12px 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .hdr-title { font-size: 15px; font-weight: 700; color: #f1f5f9; }
    .hdr-sub { font-size: 12px; color: #64748b; margin-top: 2px; }

    /* ── Day/Night toggle ── */
    .toggle-wrap { display: flex; gap: 0; background: rgba(255,255,255,0.06); border-radius: 10px; padding: 3px; }
    .toggle-btn {
      padding: 6px 16px; border-radius: 8px; border: none; cursor: pointer;
      font-size: 13px; font-weight: 600; transition: all 0.2s;
      background: transparent; color: #64748b;
    }
    .toggle-btn.active { background: #1b4fd8; color: white; }

    /* ── Block cards ── */
    .wrap { max-width: 1400px; margin: 0 auto; padding: 24px; }
    .block-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      margin-bottom: 32px;
      overflow: hidden;
    }
    .block-header {
      display: grid;
      grid-template-columns: 48px 1fr auto;
      align-items: center;
      gap: 14px;
      padding: 16px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .block-num {
      width: 40px; height: 40px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 800;
      background: rgba(27,79,216,0.2); color: #60a5fa;
    }
    .block-num.tier1 { background: rgba(236,124,0,0.15); color: #f59332; }
    .block-num.tier2 { background: rgba(16,185,129,0.12); color: #34d399; }
    .block-name { font-size: 17px; font-weight: 700; color: #f1f5f9; }
    .block-file { font-size: 12px; font-family: monospace; color: #64748b; margin-top: 2px; }
    .badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge {
      font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px;
      letter-spacing: 0.06em; text-transform: uppercase;
    }
    .badge-red { background: rgba(239,68,68,0.15); color: #f87171; }
    .badge-blue { background: rgba(59,130,246,0.15); color: #60a5fa; }
    .badge-green { background: rgba(16,185,129,0.15); color: #34d399; }
    .badge-orange { background: rgba(236,124,0,0.15); color: #f59332; }
    .badge-gray { background: rgba(100,116,139,0.15); color: #94a3b8; }

    /* ── Previews ── */
    .previews {
      display: grid;
      grid-template-columns: 375px 1fr;
      gap: 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .preview-mobile {
      border-right: 1px solid rgba(255,255,255,0.06);
      padding: 20px;
    }
    .preview-desktop { padding: 20px; }
    .preview-label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: #475569; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;
    }

    /* ── Mobile frame ── */
    .phone-frame {
      width: 335px;
      background: white;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    [data-theme="dark"] .phone-frame { background: #0f172a; }

    /* ── Desktop frame ── */
    .desktop-frame {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    [data-theme="dark"] .desktop-frame { background: #0f172a; }

    /* ── Notes row ── */
    .notes { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; }
    .note-col { padding: 14px 20px; border-right: 1px solid rgba(255,255,255,0.05); }
    .note-col:last-child { border-right: none; }
    .note-title {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      margin-bottom: 8px;
    }
    .note-title.seo { color: #60a5fa; }
    .note-title.load { color: #34d399; }
    .note-title.ux { color: #f59332; }
    .note-item {
      font-size: 12px; color: #64748b; line-height: 1.5;
      display: flex; gap: 6px; margin-bottom: 4px;
    }
    .note-item::before { content: '·'; color: #334155; flex-shrink: 0; }

    /* ══════════ LIGHT THEME COMPONENTS ══════════ */
    /* Used inside phone-frame / desktop-frame when data-theme="light" */

    /* Hero */
    .hero-photo {
      height: 220px;
      background: linear-gradient(135deg, #1e3a5f, #0d1a2b);
      position: relative;
      display: flex; align-items: flex-end;
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, transparent 30%, rgba(13,26,43,0.9) 100%);
    }
    .hero-text { position: relative; z-index: 1; padding: 16px; width: 100%; }
    .tagline-pill {
      display: inline-flex; align-items: center;
      background: rgba(236,124,0,0.15); border: 1px solid rgba(236,124,0,0.4);
      border-radius: 100px; padding: 3px 10px; margin-bottom: 6px;
      font-size: 10px; font-weight: 600; color: #f59332;
    }
    .hero-h1 { font-size: 22px; font-weight: 800; color: white; line-height: 1.1; margin: 0 0 4px; }
    .hero-sub { font-size: 13px; color: rgba(255,255,255,0.7); margin: 0; }
    .hero-btns { display: flex; gap: 8px; padding: 12px 16px; background: #0d1a2b; }
    .btn-outline-or {
      flex: 1; height: 40px; border-radius: 100px;
      border: 1.5px solid rgba(236,124,0,0.7); background: transparent;
      color: #f59332; font-size: 13px; font-weight: 600;
      display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;
    }
    .btn-outline-wh {
      flex: 1; height: 40px; border-radius: 100px;
      border: 1.5px solid rgba(255,255,255,0.25); background: transparent;
      color: rgba(255,255,255,0.8); font-size: 13px; font-weight: 600;
      display: flex; align-items: center; justify-content: center; gap: 5px; cursor: pointer;
    }
    .btn-explain { font-size: 10px; color: rgba(255,255,255,0.35); text-align: center; padding: 4px 16px 8px; background: #0d1a2b; }
    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 10px 14px; background: #0d1a2b; }
    .metric-cell {
      background: rgba(255,255,255,0.06); border-radius: 10px;
      padding: 10px 12px; text-align: center;
    }
    .metric-num { font-size: 18px; font-weight: 800; color: white; line-height: 1; }
    .metric-lbl { font-size: 10px; color: rgba(255,255,255,0.4); margin-top: 2px; }
    .trust-row { display: flex; gap: 6px; padding: 10px 14px 14px; background: #0d1a2b; }
    .trust-pill {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;
      border-radius: 100px; background: rgba(30,64,175,0.4); border: 1px solid rgba(96,165,250,0.4);
      padding: 6px 4px; font-size: 10px; font-weight: 500; color: #bfdbfe;
    }

    /* Shifts section */
    .shifts-section { background: linear-gradient(135deg, #eff6ff, #dbeafe); padding: 14px; }
    .sec-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #1b4fd8; margin-bottom: 4px; }
    .sec-h2 { font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 10px; }
    .shift-card-glass {
      background: rgba(255,255,255,0.72); backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.8); border-radius: 14px; padding: 12px;
      margin-bottom: 8px; box-shadow: 0 4px 16px rgba(27,79,216,0.08);
    }
    .shift-name { font-size: 14px; font-weight: 700; color: #0f172a; }
    .shift-dates { font-size: 11px; color: #475569; margin: 2px 0 6px; }
    .shift-price { font-size: 16px; font-weight: 800; color: #ec7c00; margin-bottom: 8px; }
    .progress-bar { height: 6px; background: rgba(203,213,225,0.5); border-radius: 4px; overflow: hidden; margin-bottom: 8px; }
    .progress-fill { height: 100%; background: #94a3b8; border-radius: 4px; }
    .btn-select {
      width: 100%; height: 36px; border-radius: 100px;
      background: #ec7c00; color: white; border: none;
      font-size: 13px; font-weight: 700; cursor: pointer;
    }

    /* Card white */
    .card-w { background: white; border-radius: 14px; padding: 14px; border: 1px solid #f3f4f6; margin-bottom: 8px; }
    .card-w-dark { background: #1e293b; border-radius: 14px; padding: 14px; border: 1px solid #334155; margin-bottom: 8px; }

    /* Section wrapper light */
    .sec-light { background: #f7f8fb; padding: 14px; }
    .sec-blue { background: #f0f4ff; padding: 14px; }
    .sec-warm { background: #f7f5f2; padding: 14px; }
    .sec-dark { background: #0d1a2b; padding: 14px; }
    .sec-navy { background: #0f172a; padding: 14px; }

    /* Text helpers */
    .t-h2 { font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 6px; }
    .t-h2-d { font-size: 17px; font-weight: 800; color: #f1f5f9; margin: 0 0 6px; }
    .t-p { font-size: 12px; color: #4b5263; line-height: 1.55; margin: 0 0 8px; }
    .t-p-d { font-size: 12px; color: #94a3b8; line-height: 1.55; margin: 0 0 8px; }
    .accent { color: #ec7c00; }
    .t-muted { font-size: 10px; color: #9ca3af; }

    /* Review card */
    .review-card { background: white; border-radius: 12px; padding: 12px; border: 1px solid #f3f4f6; margin-bottom: 6px; }
    .review-card-d { background: #1e293b; border-radius: 12px; padding: 12px; border: 1px solid #334155; margin-bottom: 6px; }
    .stars { color: #f59332; font-size: 11px; margin-bottom: 4px; }
    .review-text { font-size: 11px; color: #4b5263; line-height: 1.5; margin-bottom: 6px; }
    .review-text-d { font-size: 11px; color: #94a3b8; line-height: 1.5; margin-bottom: 6px; }
    .reviewer { font-size: 10px; font-weight: 600; color: #6b7280; }

    /* FAQ item */
    .faq-item { background: white; border: 1px solid #e5e7eb; border-radius: 10px; margin-bottom: 5px; overflow: hidden; }
    .faq-item-d { background: #1e293b; border: 1px solid #334155; border-radius: 10px; margin-bottom: 5px; overflow: hidden; }
    .faq-q { padding: 10px 12px; font-size: 13px; font-weight: 600; color: #1e2430; display: flex; justify-content: space-between; align-items: center; }
    .faq-q-d { padding: 10px 12px; font-size: 13px; font-weight: 600; color: #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
    .faq-a { padding: 0 12px 10px; font-size: 11px; color: #4b5263; line-height: 1.5; border-top: 1px solid #f3f4f6; padding-top: 8px; }
    .faq-a-d { padding: 0 12px 10px; font-size: 11px; color: #94a3b8; line-height: 1.5; border-top: 1px solid #334155; padding-top: 8px; }

    /* CTA block */
    .cta-block { background: #1b4fd8; padding: 16px; border-radius: 14px; }
    .cta-h { font-size: 18px; font-weight: 800; color: white; margin: 0 0 4px; line-height: 1.2; }
    .cta-sub { font-size: 12px; color: rgba(255,255,255,0.65); margin: 0 0 12px; }
    .cta-input { width: 100%; height: 40px; border-radius: 100px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: white; padding: 0 14px; font-size: 13px; margin-bottom: 8px; }
    .cta-btn { width: 100%; height: 44px; border-radius: 100px; background: #ec7c00; color: white; border: none; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }

    /* Gallery grid */
    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    .gallery-cell { background: #cbd5e1; border-radius: 6px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #64748b; }
    .gallery-cell-d { background: #1e293b; border-radius: 6px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #475569; }

    /* Mentor card */
    .mentor-card { display: flex; gap: 10px; align-items: center; background: white; border-radius: 12px; padding: 10px 12px; border: 1px solid #f3f4f6; margin-bottom: 6px; }
    .mentor-card-d { display: flex; gap: 10px; align-items: center; background: #1e293b; border-radius: 12px; padding: 10px 12px; border: 1px solid #334155; margin-bottom: 6px; }
    .mentor-avatar { width: 40px; height: 40px; border-radius: 100px; background: linear-gradient(135deg, #1b4fd8, #ec7c00); flex-shrink: 0; }
    .mentor-name { font-size: 13px; font-weight: 600; color: #1e2430; }
    .mentor-name-d { font-size: 13px; font-weight: 600; color: #f1f5f9; }
    .mentor-role { font-size: 11px; color: #6b7280; }

    /* Journey step */
    .journey-step { display: flex; gap: 10px; margin-bottom: 10px; align-items: flex-start; }
    .j-time { font-size: 11px; font-weight: 700; color: #ec7c00; width: 36px; flex-shrink: 0; padding-top: 2px; }
    .j-dot { width: 8px; height: 8px; border-radius: 50%; background: #ec7c00; flex-shrink: 0; margin-top: 4px; }
    .j-text { font-size: 12px; color: #4b5263; }
    .j-text-d { font-size: 12px; color: #94a3b8; }

    /* Economy */
    .economy-card { background: white; border-radius: 12px; padding: 14px; border: 1px solid #f3f4f6; }
    .economy-card-d { background: #1e293b; border-radius: 12px; padding: 14px; border: 1px solid #334155; }
    .economy-num { font-size: 28px; font-weight: 800; color: #ec7c00; line-height: 1; }
    .economy-label { font-size: 12px; color: #4b5263; margin-top: 4px; }
    .economy-label-d { font-size: 12px; color: #94a3b8; margin-top: 4px; }

    /* Stay */
    .stay-item { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 8px; }
    .stay-icon { color: #ec7c00; flex-shrink: 0; }
    .stay-text { font-size: 12px; color: #4b5263; }
    .stay-text-d { font-size: 12px; color: #94a3b8; }

    /* Contacts */
    .contacts-map { background: #dbeafe; border-radius: 10px; height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; font-size: 11px; color: #1b4fd8; }
    .contacts-map-d { background: #1e293b; border-radius: 10px; height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; font-size: 11px; color: #60a5fa; }

    /* SEO block */
    .seo-link-row { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
    .seo-link { border: 1px solid #e5e7eb; border-radius: 100px; padding: 3px 8px; font-size: 10px; color: #374151; }
    .seo-link-d { border: 1px solid #334155; border-radius: 100px; padding: 3px 8px; font-size: 10px; color: #94a3b8; }

    /* Desktop preview inner */
    .dsk { min-height: 160px; }
    .dsk-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .dsk-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
    .dsk-grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 8px; }

    /* Booking bar */
    .booking-bar { background: #0d1a2b; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .booking-bar-d { background: #0f172a; border: 1px solid #1e293b; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .bb-text { font-size: 13px; font-weight: 600; color: white; }
    .bb-btn { height: 36px; padding: 0 16px; border-radius: 100px; background: #ec7c00; color: white; border: none; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; }

    /* MomStory */
    .mom-story { background: linear-gradient(135deg, #f7f5f2, #fdf8f0); padding: 14px; border-radius: 14px; }
    .mom-story-d { background: linear-gradient(135deg, #1a1a2e, #1e1a2e); padding: 14px; border-radius: 14px; }
    .mom-quote { font-size: 13px; font-style: italic; color: #4b5263; line-height: 1.5; margin-bottom: 8px; }
    .mom-quote-d { font-size: 13px; font-style: italic; color: #94a3b8; line-height: 1.5; margin-bottom: 8px; }
    .mom-author { font-size: 11px; font-weight: 600; color: #ec7c00; }

    /* Hackathon */
    .hackathon-dark { background: linear-gradient(135deg, #0d1a2b, #162035); padding: 14px; }
    .hackathon-accent { display: inline-block; background: rgba(236,124,0,0.15); border: 1px solid rgba(236,124,0,0.3); border-radius: 6px; padding: 2px 8px; font-size: 10px; font-weight: 700; color: #f59332; margin-bottom: 6px; }

    /* SoftStart */
    .softstart-card { background: white; border-radius: 12px; padding: 12px; border-left: 3px solid #ec7c00; margin-bottom: 6px; }
    .softstart-card-d { background: #1e293b; border-radius: 12px; padding: 12px; border-left: 3px solid #ec7c00; margin-bottom: 6px; }

    /* RelatedPages */
    .related-link { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 6px 10px; font-size: 11px; color: #374151; margin: 3px; }
    .related-link-d { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #334155; border-radius: 8px; padding: 6px 10px; font-size: 11px; color: #94a3b8; margin: 3px; }

    /* Footer */
    .footer-block { background: #0d1a2b; padding: 14px; }
    .footer-col-title { font-size: 11px; font-weight: 700; color: white; margin-bottom: 8px; }
    .footer-link { display: block; font-size: 11px; color: rgba(255,255,255,0.45); margin-bottom: 4px; }
    .footer-copy { font-size: 10px; color: rgba(255,255,255,0.2); margin-top: 10px; }

    /* ShiftOccupancy */
    .occupancy-bar { background: #eff6ff; border-radius: 10px; padding: 10px 12px; margin-bottom: 6px; }
    .occupancy-bar-d { background: #1e293b; border-radius: 10px; padding: 10px 12px; margin-bottom: 6px; }
    .occ-label { font-size: 11px; font-weight: 600; color: #1e2430; margin-bottom: 4px; }
    .occ-label-d { font-size: 11px; font-weight: 600; color: #f1f5f9; margin-bottom: 4px; }
    .occ-bar { height: 8px; background: #dbeafe; border-radius: 4px; overflow: hidden; }
    .occ-fill { height: 100%; background: #1b4fd8; border-radius: 4px; }
    .occ-status { font-size: 10px; color: #1b4fd8; margin-top: 3px; font-weight: 600; }

    /* Video */
    .video-thumb { background: #0f172a; border-radius: 12px; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; margin-bottom: 6px; }
    .play-btn { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; color: white; font-size: 16px; }
  </style>
</head>
<body>

<!-- ══ HEADER ══ -->
<div class="hdr">
  <div>
    <div class="hdr-title">АйДаКемп — 21 блок главной страницы</div>
    <div class="hdr-sub">Мобиль 375px + Десктоп · SEO · Загрузка · design/glassmorphism-v1</div>
  </div>
  <div style="display:flex; gap:12px; align-items:center;">
    <div class="toggle-wrap" id="themeToggle">
      <button class="toggle-btn active" data-mode="dark" onclick="setTheme('dark')">
        <i class="bi bi-moon-fill"></i> Ночь
      </button>
      <button class="toggle-btn" data-mode="light" onclick="setTheme('light')">
        <i class="bi bi-sun-fill"></i> День
      </button>
    </div>
