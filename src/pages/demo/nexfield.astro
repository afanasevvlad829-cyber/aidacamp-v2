---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import MomStory from '../../components/MomStory.astro';
import About from '../../components/About.astro';
import Shifts from '../../components/Shifts.astro';
import Gallery from '../../components/Gallery.astro';
import Videos from '../../components/Videos.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import Team from '../../components/Team.astro';
import Mentors from '../../components/Mentors.astro';
import Stay from '../../components/Stay.astro';
import Journey from '../../components/Journey.astro';
import Economy from '../../components/Economy.astro';
import Hackathon from '../../components/Hackathon.astro';
import SoftStart from '../../components/SoftStart.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import SeoTextBlock from '../../components/SeoTextBlock.astro';
import ShiftOccupancy from '../../components/ShiftOccupancy.astro';
import SummerCta from '../../components/SummerCta.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../../data/landing-pages';
---

<Base
  title="[Демо Nexfield 2026] АйДаКемп — Glass + WCAG"
  description=""
  heroPreloadMobile="/images/hero-mobile.avif"
  heroPreloadDesktop="/images/hero-desktop.avif"
  noindex
>
  <Fragment slot="head">
    <SchemaOrg />
  </Fragment>

  <!-- Demo badge -->
  <div class="fixed top-0 inset-x-0 z-[300] flex items-center justify-center gap-3 bg-violet-600 py-1.5 text-[12px] font-semibold text-white">
    <span>ДЕМО — Nexfield Color & UI 2026: Glass + WCAG + Акцент-дисциплина</span>
    <a href="/" class="rounded-full bg-white/20 px-3 py-0.5 hover:bg-white/30 transition-colors text-[11px]">Текущая →</a>
  </div>

  <div data-nexfield>
    <Header />
    <main class="pb-20 md:pb-0">
      <Hero hasVariants={true} />

      <div class="md:hidden flex px-5 py-3">
        <div class="rotate-[-10deg] relative flex h-[96px] w-[96px] items-center justify-center rounded-full border-[2.5px] border-dashed border-[#0d1a2b]/55">
          <div class="absolute inset-[7px] rounded-full border border-[#0d1a2b]/18"></div>
          <div class="flex flex-col items-center gap-0 px-2 text-center">
            <i class="bi bi-laptop text-[20px] leading-none text-[#0d1a2b]" aria-hidden="true"></i>
            <span class="mt-0.5 text-[7.5px] font-black uppercase tracking-[0.14em] text-[#0d1a2b] leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-[#0d1a2b]/30"></div>
            <span class="mt-0.5 text-[6.5px] font-semibold uppercase tracking-[0.09em] text-[#0d1a2b]/55 leading-[1.4]">у нас всё есть!</span>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
        <div class="flex flex-col gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
          <ShiftOccupancy />
          <MomStory compact />
        </div>
      </div>
      <About />
      <Journey />
      <Economy />
      <SoftStart />
      <Shifts />
      <SummerCta />
      <Hackathon />
      <Gallery />
      <Videos />
      <Reviews />
      <FAQ />
      <Team />
      <Mentors />
      <Stay />
      <Contacts />
      <SeoTextBlock />
      <RelatedPages pages={allLandingPages} />
    </main>
    <Footer />
  </div>
</Base>

<style is:global>
  /* ============================================================
     NEXFIELD COLOR & UI 2026 — DEMO LAYER v2 (жирная версия)
     ============================================================ */

  /* --- 1. WCAG: мутный текст → читаемый --- */
  /* Tailwind компилирует opacity в CSS-переменные, проще бить по color напрямую */
  [data-nexfield] *[style*="opacity"],
  [data-nexfield] p,
  [data-nexfield] span:not([class*="bg-"]):not([class*="border-"]) {
    /* Только для тёмных секций — color: inherit если уже белый */
  }

  /* Прицельно по самым частым классам через атрибут-селектор */
  [data-nexfield] [class~="text-white/50"],
  [data-nexfield] [class~="text-white/35"],
  [data-nexfield] [class~="text-white/30"] {
    color: rgba(255,255,255,0.75) !important;
  }

  /* --- 2. Apple Liquid Glass — Хедер (самое видимое изменение) --- */
  [data-nexfield] header {
    position: fixed !important;
    top: 32px !important;
    left: 0 !important;
    right: 0 !important;
    background: rgba(8, 14, 26, 0.72) !important;
    backdrop-filter: blur(28px) saturate(180%) brightness(110%) !important;
    -webkit-backdrop-filter: blur(28px) saturate(180%) brightness(110%) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 8px 32px rgba(0, 0, 0, 0.45) !important;
  }

  /* --- 3. Liquid Glass — все карточки (по структуре, не по классам) --- */

  /* Карточки в тёмных секциях: добавляем градиент + свечение */
  [data-nexfield] #faq [class*="rounded"],
  [data-nexfield] #reviews [class*="rounded"],
  [data-nexfield] #team [class*="rounded"],
  [data-nexfield] #contacts [class*="rounded"] {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.10) 0%,
      rgba(255, 255, 255, 0.04) 100%
    ) !important;
    border-color: rgba(255, 255, 255, 0.16) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 4px 24px rgba(0, 0, 0, 0.25) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
  }

  /* --- 4. Hero CTA кнопка — более насыщенная с glow --- */
  [data-nexfield] a[href*="zapis"],
  [data-nexfield] a[href*="zvonok"],
  [data-nexfield] button[data-modal],
  [data-nexfield] .bg-primary,
  [data-nexfield] [class*="bg-\[#ec7c00\]"],
  [data-nexfield] [class*="bg-primary"] {
    box-shadow:
      0 0 0 1px rgba(249, 115, 22, 0.4),
      0 8px 32px rgba(249, 115, 22, 0.35),
      inset 0 1px 0 rgba(255,255,255,0.15) !important;
  }

  /* --- 5. Навбар-пиллы — стекло --- */
  [data-nexfield] nav a {
    background: rgba(255, 255, 255, 0.07) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08) !important;
    transition: all 200ms ease !important;
  }
  [data-nexfield] nav a:hover {
    background: rgba(255, 255, 255, 0.13) !important;
    border-color: rgba(255, 255, 255, 0.22) !important;
    transform: translateY(-1px) !important;
  }

  /* --- 6. Микровзаимодействия --- */
  [data-nexfield] a, [data-nexfield] button {
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease !important;
  }
  [data-nexfield] a:not(nav a):hover {
    transform: translateY(-1px) !important;
  }
</style>
