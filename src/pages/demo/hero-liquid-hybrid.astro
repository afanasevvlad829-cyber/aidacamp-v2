---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import { STAT_RATING, STAT_YEARS, STAT_KIDS, CAMP_PRICE_FROM, YANDEX_MAPS_URL } from '../../data/contacts';
---

<Base title="Hero Liquid Hybrid — фото + iridescent glass" noindex>

<style is:inline>
  body { font-family: 'Inter', sans-serif; background: #0d1a2b; margin: 0; }
  .nav-bar { position: sticky; top: 0; z-index: 100; background: rgba(13,26,43,0.92); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 12px 16px; display: flex; gap: 16px; align-items: center; }
  .nav-bar a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .nav-bar a:hover { color: white; background: rgba(255,255,255,0.08); }
  .nav-bar .live { background: rgba(236,124,0,0.2); color: #ffaa55; border: 1px solid rgba(236,124,0,0.4); }

  /* ─── Mobile preview frame ─── */
  .mobile-frame { width: 390px; height: 844px; margin: 32px auto; border-radius: 36px; overflow: hidden; box-shadow: 0 20px 80px rgba(0,0,0,0.5), inset 0 0 0 8px #1c1c1e, inset 0 0 0 9px #444; position: relative; background: #0d1a2b; }

  /* ─── Hero (Liquid Hybrid) ─── */
  .hero-liquid { position: relative; width: 100%; height: 100%; overflow: hidden; }

  /* Layer 1: Photo background */
  .hero-photo { position: absolute; inset: 0; background-image: url('/images/hero-mobile-bean-v3.webp'); background-size: cover; background-position: center 25%; }

  /* Layer 2: Iridescent navy gradient overlay (партнёрит с фото) */
  .hero-irid-overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 20% 25%, rgba(236,72,153,0.30) 0%, transparent 45%),
      radial-gradient(ellipse at 80% 65%, rgba(6,182,212,0.30) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 90%, rgba(139,92,246,0.35) 0%, transparent 55%),
      linear-gradient(180deg, rgba(13,26,43,0.40) 0%, rgba(13,26,43,0.55) 50%, rgba(13,26,43,0.85) 100%);
  }

  /* Layer 3: Iridescent floating orbs */
  .orb-1 {
    position: absolute; top: 60%; left: -20%;
    width: 350px; height: 350px; border-radius: 50%;
    background: conic-gradient(from 0deg, #ec7c00, #ec4899, #8b5cf6, #06b6d4, #ec7c00);
    filter: blur(80px); opacity: 0.4;
    animation: orb-float 8s ease-in-out infinite;
  }
  .orb-2 {
    position: absolute; bottom: 5%; right: -15%;
    width: 280px; height: 280px; border-radius: 50%;
    background: conic-gradient(from 180deg, #06b6d4, #ec7c00, #8b5cf6, #06b6d4);
    filter: blur(70px); opacity: 0.35;
    animation: orb-float 10s ease-in-out infinite reverse;
  }
  @keyframes orb-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -20px) scale(1.1); }
  }

  /* Layer 4: Header (glass nav) */
  .hero-nav {
    position: relative; z-index: 10;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 16px 12px;
  }
  .nav-burger, .nav-phone {
    width: 44px; height: 44px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.10);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 4px 16px rgba(0,0,0,0.2);
    color: white; font-size: 18px; cursor: pointer;
  }
  .nav-brand {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.18);
    padding: 6px 14px 6px 6px; border-radius: 22px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .nav-brand-logo {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, #ec7c00, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; color: white; font-weight: 800;
  }
  .nav-brand-text { color: white; font-weight: 700; font-size: 15px; }
  .nav-brand-text .hash { color: rgba(255,255,255,0.55); }

  /* Spacer to push glass card to bottom */
  .hero-spacer { flex: 1; min-height: 36vh; position: relative; z-index: 5; }

  /* Layer 5: Glass card with content */
  .hero-glass-card {
    position: relative; z-index: 10;
    margin: 0 16px 16px; padding: 22px 20px 18px;
    border-radius: 28px;
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.30),
      inset 0 -1px 0 rgba(0,0,0,0.10),
      0 32px 80px rgba(0,0,0,0.4);
  }

  /* Status pill */
  .hero-pill-status {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 999px;
    background: rgba(236,124,0,0.15);
    border: 1px solid rgba(236,124,0,0.40);
    font-size: 11px; font-weight: 600; color: #ffc080;
    margin-bottom: 12px;
  }
  .pulse-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #ffaa55;
    animation: pulse 1.5s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(255,170,85,0.8);
  }
  @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; transform: scale(1.3); } }

  /* H1 with iridescent gradient text */
  .hero-h1 {
    font-size: 32px; font-weight: 800;
    line-height: 1.05; letter-spacing: -0.04em;
    color: white;
    text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    margin: 0 0 10px;
  }
  .hero-h1 .gradient {
    background: linear-gradient(135deg, #ec7c00 0%, #ec4899 50%, #8b5cf6 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: 14px; color: rgba(255,255,255,0.85);
    line-height: 1.5; margin: 0 0 18px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
  }
  .hero-subtitle b { color: white; font-weight: 700; }

  /* CTA — gradient pill button */
  .hero-cta-row { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .hero-cta-primary {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 14px 20px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(236,124,0,1), rgba(236,72,153,0.85));
    border: 1px solid rgba(236,124,0,0.5);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.30),
      0 8px 28px rgba(236,124,0,0.40);
    color: white; font-size: 15px; font-weight: 700; text-decoration: none;
    transition: transform 0.2s;
  }
  .hero-cta-primary:hover { transform: scale(1.02); }
  .hero-cta-secondary {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 12px 16px; border-radius: 16px;
    background: rgba(255,255,255,0.10);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.20);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
    color: white; font-size: 14px; text-decoration: none;
  }
  .hero-cta-secondary .left { display: flex; align-items: center; gap: 10px; }
  .hero-cta-secondary .icon-circle {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(6,182,212,0.7), rgba(139,92,246,0.6));
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .hero-cta-secondary .topic { font-weight: 700; color: white; }
  .hero-cta-secondary .anon { font-size: 11px; color: rgba(255,255,255,0.6); display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* Stats row */
  .hero-stats {
    display: flex; align-items: center; justify-content: space-around;
    padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.10);
    color: white; font-size: 12px;
  }
  .hero-stats .stat strong { font-size: 14px; font-weight: 700; }
  .hero-stats .stat .label { opacity: 0.55; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .hero-stats .star { color: #ffd86b; }
  .hero-stats .divider { width: 1px; height: 20px; background: rgba(255,255,255,0.15); }

  /* Trust line */
  .hero-trust {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.10);
    font-size: 11px; color: rgba(255,255,255,0.65);
  }
  .hero-trust .dot { color: rgba(255,255,255,0.25); }
  .hero-trust span i { color: #06b6d4; margin-right: 3px; font-style: normal; }

  /* Annotations panel */
  .annot { background: white; padding: 24px; border-radius: 16px; margin: 24px auto; max-width: 720px; font-size: 14px; line-height: 1.6; }
  .annot h3 { margin: 0 0 12px; font-size: 18px; font-weight: 700; color: #0d1a2b; }
  .annot ul { padding-left: 20px; color: #4b5263; margin: 0; }
  .annot ul li { margin-bottom: 6px; }
  .annot code { background: #f3f6fb; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #ec7c00; }
</style>

<div class="nav-bar">
  <a href="/demo/styles/#v3-liquid">← Liquid Glass styles</a>
  <a href="/" class="live">PROD →</a>
  <a href="/demo/color-harmony">Color Harmony</a>
  <span style="color: rgba(255,255,255,0.4); margin-left: auto; font-size: 12px;">Hero Liquid Hybrid · фото + iridescent + glass</span>
</div>

<!-- ═══════ MOBILE PREVIEW ═══════ -->
<div class="mobile-frame">
  <div class="hero-liquid">
    <!-- Layer 1: Photo -->
    <div class="hero-photo"></div>
    <!-- Layer 2: Iridescent overlay -->
    <div class="hero-irid-overlay"></div>
    <!-- Layer 3: Floating orbs -->
    <div class="orb-1"></div>
    <div class="orb-2"></div>

    <!-- Layer 4: Glass nav -->
    <div class="hero-nav">
      <button class="nav-burger"><i class="bi bi-list"></i></button>
      <div class="nav-brand">
        <div class="nav-brand-logo">A</div>
        <span class="nav-brand-text"><span class="hash">#</span>АйДаКемп</span>
      </div>
      <button class="nav-phone"><i class="bi bi-telephone-fill"></i></button>
    </div>

    <!-- Spacer (toggles flex) -->
    <div class="hero-spacer"></div>

    <!-- Layer 5: Glass content card -->
    <div class="hero-glass-card">
      <span class="hero-pill-status">
        <span class="pulse-dot"></span>
        Запись открыта · Лето 2026
      </span>

      <h1 class="hero-h1">
        Летний IT-лагерь<br>
        в&nbsp;<span class="gradient">Подмосковье 2026</span>
      </h1>

      <p class="hero-subtitle">
        Пока другие на даче — ваш сделает <b>AI-проект</b>.<br>
        Вам — <b>14 дней для себя</b>.
      </p>

      <div class="hero-cta-row">
        <a href="#" class="hero-cta-primary">
          от {CAMP_PRICE_FROM} · Выбрать смену
          <i class="bi bi-arrow-right"></i>
        </a>
        <a href="#" class="hero-cta-secondary">
          <div class="left">
            <div class="icon-circle"><i class="bi bi-chat-dots-fill"></i></div>
            <div>
              <div>Спросите про <span class="topic">минусы</span></div>
              <div class="anon"><i class="bi bi-shield-lock-fill"></i> Анонимно</div>
            </div>
          </div>
          <i class="bi bi-arrow-right" style="opacity: 0.5"></i>
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <div><strong class="star">★ {STAT_RATING}</strong></div>
          <div class="label">Яндекс</div>
        </div>
        <div class="divider"></div>
        <div class="stat">
          <div><strong>{STAT_YEARS} лет</strong></div>
          <div class="label">опыта</div>
        </div>
        <div class="divider"></div>
        <div class="stat">
          <div><strong>{STAT_KIDS}</strong></div>
          <div class="label">детей</div>
        </div>
      </div>

      <div class="hero-trust">
        <span><i class="bi bi-patch-check-fill"></i> Лицензия</span>
        <span class="dot">·</span>
        <span><i class="bi bi-heart-pulse-fill"></i> 24/7</span>
        <span class="dot">·</span>
        <span><i class="bi bi-shield-check"></i> Страховка</span>
      </div>
    </div>
  </div>
</div>

<div class="annot">
  <h3>Что нового vs текущий prod hero</h3>
  <ul>
    <li><strong>Сохранили:</strong> фото мальчика в bean bag, brand orange <code>#ec7c00</code>, navy bg, бот CTA, cycling word, trust strip, stats</li>
    <li><strong>Добавили:</strong> iridescent orbs (orange→pink→violet→cyan) внизу за стеклом</li>
    <li><strong>Добавили:</strong> glass card снизу с <code>backdrop-blur(40px)</code> + inset highlight</li>
    <li><strong>Добавили:</strong> H1 с gradient text «Подмосковье 2026» (orange→pink→violet)</li>
    <li><strong>Добавили:</strong> primary CTA с gradient orange→pink + glow shadow</li>
    <li><strong>Добавили:</strong> «Запись открыта» pulse-pill в стиле Linear/Vercel</li>
    <li><strong>Добавили:</strong> bot icon в circle с teal-violet gradient</li>
    <li><strong>Glass nav header</strong> — лого в pill, кнопки burger/phone glass-style</li>
  </ul>
</div>

<div class="annot">
  <h3>Цветовая палитра (Liquid Hybrid)</h3>
  <ul>
    <li><code style="color:var(--color-primary)">#ec7c00</code> — primary (existing)</li>
    <li><code style="color:#ec4899">#ec4899</code> — pink-500 (для gradient text + CTA gradient)</li>
    <li><code style="color:#8b5cf6">#8b5cf6</code> — violet-500 (для orbs + bot icon)</li>
    <li><code style="color:#06b6d4">#06b6d4</code> — cyan-500 (для bot icon + accent)</li>
    <li><code style="color:#0d1a2b">#0d1a2b</code> — navy (existing, photo overlay)</li>
  </ul>
  <p style="margin-top: 12px; color: #4b5263;"><strong>Идея:</strong> orange сохраняется как primary CTA, но добавляется iridescent multi-hue для премиум-feel и IT/digital ассоциации. Фото остаётся главным — orbs только намекают на «что-то магическое», не доминируют.</p>
</div>

<div class="annot">
  <h3>Если устраивает — план применения к prod</h3>
  <ol style="padding-left: 20px; color: #4b5263;">
    <li>Добавить токены <code>--color-pink-500</code>, <code>--color-violet-500</code>, <code>--color-cyan-500</code> в <code>@theme</code></li>
    <li>Создать reusable <code>&lt;IridescentOverlay&gt;</code> компонент</li>
    <li>Создать <code>&lt;GlassCard&gt;</code> с пропсами <code>blur</code>, <code>opacity</code></li>
    <li>Обновить <code>src/components/hero/Mobile.astro</code> с новым layout</li>
    <li>Применить gradient text класс <code>.text-iridescent</code> к ключевым акцентам</li>
    <li>Deploy на dev → A/B compare → prod</li>
  </ol>
</div>

</Base>
