---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

// V3.1 — yarche, faster, with separators between blocks.

const effects = [
  { id: 'money',     title: 'Налоговый вычет 13%',    sub: 'Падающие ₽ — изумрудный glow', pages: '/nalogovyj-vychet, /ceny' },
  { id: 'python',    title: 'Python-лагерь',          sub: 'Падающие токены кода',          pages: '/python-lager' },
  { id: 'minecraft', title: 'Minecraft-лагерь',       sub: 'Пиксельные блоки сверху',       pages: '/minecraft-lager' },
  { id: 'roblox',    title: 'Roblox-лагерь',          sub: 'Сферы с bounce',                pages: '/roblox-lager' },
  { id: 'scratch',   title: 'Scratch для младших',    sub: 'Цветные пузыри вверх',          pages: '/stati/scratch-dlya-detej' },
  { id: 'ai',        title: 'AI-лагерь',              sub: 'Нейроузлы + связи',             pages: '/ai-lager' },
  { id: 'three-d',   title: '3D-моделирование',       sub: 'Wireframe-сетка + куб',          pages: '/3d-modelirovanie-lager' },
  { id: 'summer',    title: 'Лето-2026',              sub: 'Тёплый закат + лучи',           pages: '/lager-na-leto-2026' },
  { id: 'food',      title: 'Питание',                sub: 'Карамель + плывущий пар',       pages: '/pitanie' },
  { id: 'pool',      title: 'Бассейн',                sub: 'Капли + волны',                  pages: '/lager-s-basseynom' },
  { id: 'forest',    title: 'Территория',             sub: 'Зелень + dappled-блики',         pages: '/o-lagere' },
  { id: 'no-phone',  title: 'Без телефонов',          sub: 'Иконка телефона + дыхание',      pages: '/lager-bez-telefonov' },
  { id: 'moscow',    title: 'Подмосковье',            sub: 'Закат + силуэт леса',            pages: '/lager-v-podmoskove' },
];
---

<Base title="Hero Effects v3.1 — Aurora-style (АйДаКемп)" noindex>
  <Header />
  <div class="bg-amber-100 text-amber-900 text-center text-base py-1.5 border-b border-amber-200">
    <strong>DEMO v3.1:</strong> 13 эффектов · разделены · ускорены · больше частиц
  </div>

  <main class="bg-slate-200">
    {effects.map((e, i) => (
      <>
        {i > 0 && <div class="fx-divider"></div>}
        <section class={`fx fx-${e.id}`} data-hero-effect={`v3-${e.id}`}>
          <div class="fx-bg"></div>
          <div class="fx-vignette"></div>
          <div class="fx-content">
            <span class="fx-tag">{e.id}</span>
            <h2 class="fx-title">{e.title}</h2>
            <p class="fx-sub">{e.sub}</p>
            <p class="fx-pages">{e.pages}</p>
            <a href="#" class="fx-cta">Смены 2026 →</a>
          </div>
        </section>
      </>
    ))}
  </main>

  <style is:inline>
    /* === Разделитель между блоками === */
    .fx-divider {
      height: 24px;
      background: linear-gradient(180deg, #cbd5e1 0%, #e2e8f0 50%, #cbd5e1 100%);
      box-shadow:
        inset 0 1px 0 rgba(0,0,0,0.05),
        inset 0 -1px 0 rgba(0,0,0,0.05);
    }

    /* === БАЗА === */
    .fx {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      min-height: 480px;
      display: flex; align-items: center;
      padding: 64px 32px;
      background: #0a0e1a;
      color: #fff;
      border-radius: 0;
    }

    /* Aurora — ускорил с 22s до 10s */
    .fx-bg {
      position: absolute; inset: -20% -10%;
      background:
        radial-gradient(ellipse 60% 50% at 20% 30%, var(--aurora-1, rgba(139, 92, 246, 0.55)) 0%, transparent 50%),
        radial-gradient(ellipse 50% 40% at 70% 60%, var(--aurora-2, rgba(99, 102, 241, 0.5)) 0%, transparent 55%),
        radial-gradient(ellipse 55% 45% at 50% 90%, var(--aurora-3, rgba(168, 85, 247, 0.4)) 0%, transparent 60%);
      filter: blur(50px);
      animation: aurora-drift 10s ease-in-out infinite alternate;
      z-index: 1;
    }
    @keyframes aurora-drift {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(4%, -3%) scale(1.08); }
    }

    .fx-vignette {
      position: absolute; inset: 0; z-index: 2; pointer-events: none;
      background:
        radial-gradient(ellipse 100% 70% at 50% 50%, transparent 45%, rgba(10, 14, 26, 0.75) 100%),
        linear-gradient(180deg, transparent 65%, rgba(10, 14, 26, 0.5) 100%);
    }

    .fx-content {
      position: relative; z-index: 10;
      max-width: 720px; margin: 0 auto; width: 100%;
    }
    .fx-tag {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 16px;
    }
    .fx-title {
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.05;
      color: #fff;
      margin: 0 0 12px;
      text-shadow: 0 2px 18px rgba(0,0,0,0.5);
    }
    .fx-sub { font-size: 17px; line-height: 1.55; color: rgba(255, 255, 255, 0.85); margin: 0 0 12px; }
    .fx-pages { font-size: 12px; color: rgba(255, 255, 255, 0.5); margin: 0 0 26px; font-family: ui-monospace, monospace; }
    .fx-cta {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; color: #0a0e1a;
      padding: 13px 26px; border-radius: 12px;
      font-weight: 700; font-size: 15px; text-decoration: none;
      transition: transform .25s, box-shadow .25s;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    .fx-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.4); }

    @media (prefers-reduced-motion: reduce) {
      .fx-bg, .fx::before, .fx::after { animation: none !important; }
    }

    /* === Палитры aurora === */
    .fx-money     { --aurora-1: rgba(16, 185, 129, 0.55); --aurora-2: rgba(5, 150, 105, 0.45); --aurora-3: rgba(52, 211, 153, 0.4); }
    .fx-python    { --aurora-1: rgba(34, 197, 94, 0.55);  --aurora-2: rgba(74, 222, 128, 0.45); --aurora-3: rgba(132, 204, 22, 0.4); }
    .fx-minecraft { --aurora-1: rgba(101, 163, 13, 0.5);  --aurora-2: rgba(132, 204, 22, 0.5);  --aurora-3: rgba(77, 124, 15, 0.45); }
    .fx-roblox    { --aurora-1: rgba(244, 114, 182, 0.5); --aurora-2: rgba(251, 191, 36, 0.45); --aurora-3: rgba(192, 38, 211, 0.42); }
    .fx-scratch   { --aurora-1: rgba(251, 146, 60, 0.55); --aurora-2: rgba(250, 204, 21, 0.45); --aurora-3: rgba(244, 114, 182, 0.4); }
    .fx-ai        { --aurora-1: rgba(139, 92, 246, 0.6);  --aurora-2: rgba(99, 102, 241, 0.5);  --aurora-3: rgba(168, 85, 247, 0.45); }
    .fx-three-d   { --aurora-1: rgba(59, 130, 246, 0.55); --aurora-2: rgba(99, 102, 241, 0.45); --aurora-3: rgba(14, 165, 233, 0.4); }
    .fx-summer    { --aurora-1: rgba(251, 146, 60, 0.6);  --aurora-2: rgba(251, 191, 36, 0.55); --aurora-3: rgba(248, 113, 113, 0.45); }
    .fx-food      { --aurora-1: rgba(251, 146, 60, 0.55); --aurora-2: rgba(245, 158, 11, 0.5);  --aurora-3: rgba(217, 119, 6, 0.4); }
    .fx-pool      { --aurora-1: rgba(14, 165, 233, 0.55); --aurora-2: rgba(56, 189, 248, 0.5);  --aurora-3: rgba(125, 211, 252, 0.4); }
    .fx-forest    { --aurora-1: rgba(34, 197, 94, 0.55);  --aurora-2: rgba(101, 163, 13, 0.45); --aurora-3: rgba(16, 185, 129, 0.4); }
    .fx-no-phone  { --aurora-1: rgba(56, 189, 248, 0.5);  --aurora-2: rgba(14, 165, 233, 0.45); --aurora-3: rgba(125, 211, 252, 0.4); }
    .fx-moscow    { --aurora-1: rgba(251, 113, 133, 0.55); --aurora-2: rgba(244, 114, 182, 0.45); --aurora-3: rgba(168, 85, 247, 0.4); }

    /* ==========================================================
       АКЦЕНТЫ: яркие, быстрые, плотные
       ========================================================== */

    /* MONEY — много ₽ падают быстро */
    .fx-money::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='240' viewBox='0 0 220 240'><text x='10' y='40' font-family='Arial' font-size='28' font-weight='800' fill='%2310b981' opacity='0.7'>₽</text><text x='90' y='110' font-family='Arial' font-size='22' font-weight='800' fill='%2334d399' opacity='0.55'>₽</text><text x='160' y='80' font-family='Arial' font-size='32' font-weight='800' fill='%2310b981' opacity='0.65'>₽</text><text x='40' y='180' font-family='Arial' font-size='26' font-weight='800' fill='%2334d399' opacity='0.6'>₽</text><text x='180' y='200' font-family='Arial' font-size='24' font-weight='800' fill='%2310b981' opacity='0.55'>₽</text></svg>");
      background-repeat: repeat;
      animation: rain-fast 6s linear infinite;
      mask-image: linear-gradient(180deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
    }
    @keyframes rain-fast {
      0%   { background-position: 0 -240px; }
      100% { background-position: 0 240px; }
    }

    /* PYTHON — токены кода падают */
    .fx-python::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='220' viewBox='0 0 260 220'><text x='10' y='30' font-family='monospace' font-size='15' fill='%234ade80' opacity='0.7'>def camp():</text><text x='140' y='70' font-family='monospace' font-size='14' fill='%2386efac' opacity='0.65'>import ai</text><text x='30' y='110' font-family='monospace' font-size='15' fill='%234ade80' opacity='0.7'>True</text><text x='160' y='150' font-family='monospace' font-size='14' fill='%2386efac' opacity='0.6'>return joy</text><text x='10' y='190' font-family='monospace' font-size='15' fill='%234ade80' opacity='0.65'>%23 AidaCamp</text></svg>");
      background-repeat: repeat;
      animation: rain-fast 7s linear infinite;
      mask-image: linear-gradient(180deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
    }

    /* MINECRAFT — пиксельные кубики падают */
    .fx-minecraft::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180' viewBox='0 0 180 180'><rect x='15' y='15' width='28' height='28' fill='%2384cc16' stroke='%23365314' stroke-width='2'/><rect x='90' y='50' width='32' height='32' fill='%2365a30d' stroke='%23365314' stroke-width='2'/><rect x='40' y='100' width='26' height='26' fill='%2384cc16' stroke='%23365314' stroke-width='2'/><rect x='130' y='130' width='30' height='30' fill='%2365a30d' stroke='%23365314' stroke-width='2'/></svg>");
      background-repeat: repeat;
      animation: rain-fast 5.5s linear infinite;
      mask-image: linear-gradient(180deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
    }

    /* ROBLOX — bounce (ускорил с 3.5s до 1.8s) + добавил больше */
    .fx-roblox::before, .fx-roblox::after {
      content: ''; position: absolute; z-index: 3; pointer-events: none;
      width: 56px; height: 56px; border-radius: 50%;
    }
    .fx-roblox::before {
      left: 10%; top: 28%;
      background: radial-gradient(circle at 35% 30%, #ffec8b, #f5c518 60%, #d49b00);
      box-shadow: 0 12px 32px rgba(212, 155, 0, 0.5);
      animation: bounce-fast 1.8s ease-in-out infinite;
    }
    .fx-roblox::after {
      right: 12%; bottom: 26%;
      background: radial-gradient(circle at 35% 30%, #fce7f3, #f472b6 60%, #c026d3);
      box-shadow: 0 12px 32px rgba(192, 38, 211, 0.5);
      animation: bounce-fast 2.2s ease-in-out infinite reverse;
    }
    @keyframes bounce-fast { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-32px); } }

    /* SCRATCH — пузырьки летят вверх */
    .fx-scratch::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='220' viewBox='0 0 200 220'><circle cx='30' cy='200' r='12' fill='%23fb923c' opacity='0.7'/><circle cx='100' cy='180' r='10' fill='%23f472b6' opacity='0.65'/><circle cx='170' cy='200' r='14' fill='%23facc15' opacity='0.7'/><circle cx='60' cy='130' r='9' fill='%2322c55e' opacity='0.65'/><circle cx='140' cy='100' r='11' fill='%2338bdf8' opacity='0.65'/><circle cx='20' cy='80' r='8' fill='%23f472b6' opacity='0.6'/></svg>");
      background-repeat: repeat;
      animation: bubbles-up-fast 4s linear infinite;
      mask-image: linear-gradient(0deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
    }
    @keyframes bubbles-up-fast {
      0%   { background-position: 0 220px; }
      100% { background-position: 0 -220px; }
    }

    /* AI — узлы быстрый пульс + связи */
    .fx-ai::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background:
        radial-gradient(circle 7px at 18% 30%, rgba(196, 181, 253, 1), transparent 70%),
        radial-gradient(circle 7px at 35% 70%, rgba(196, 181, 253, 1), transparent 70%),
        radial-gradient(circle 8px at 55% 25%, rgba(196, 181, 253, 1), transparent 70%),
        radial-gradient(circle 7px at 72% 65%, rgba(196, 181, 253, 1), transparent 70%),
        radial-gradient(circle 7px at 88% 35%, rgba(196, 181, 253, 1), transparent 70%);
      filter: drop-shadow(0 0 6px rgba(196, 181, 253, 0.7));
      animation: pulse-fast 1.5s ease-in-out infinite;
    }
    .fx-ai::after {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background:
        linear-gradient(33deg, transparent 49.6%, rgba(196, 181, 253, 0.35) 49.6% 50.4%, transparent 50.4%),
        linear-gradient(-12deg, transparent 49.6%, rgba(196, 181, 253, 0.3) 49.6% 50.4%, transparent 50.4%),
        linear-gradient(8deg, transparent 49.6%, rgba(196, 181, 253, 0.3) 49.6% 50.4%, transparent 50.4%);
      animation: pulse-fast 1.5s ease-in-out infinite reverse;
    }
    @keyframes pulse-fast { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }

    /* 3D — куб быстрее (с 18s до 6s) */
    .fx-three-d::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background:
        linear-gradient(rgba(147, 197, 253, 0.25) 1px, transparent 1px),
        linear-gradient(90deg, rgba(147, 197, 253, 0.25) 1px, transparent 1px);
      background-size: 60px 60px;
      transform: perspective(800px) rotateX(60deg) translateY(15%) scale(1.5);
      transform-origin: 50% 100%;
      mask-image: linear-gradient(180deg, transparent 0%, #000 35%, #000 100%);
    }
    .fx-three-d::after {
      content: '';
      position: absolute; right: 12%; top: 35%;
      width: 100px; height: 100px;
      border: 2px solid rgba(147, 197, 253, 0.85);
      box-shadow: 0 0 20px rgba(147, 197, 253, 0.4);
      transform: rotateX(45deg) rotateY(45deg);
      animation: cube-fast 6s linear infinite;
      z-index: 4;
    }
    @keyframes cube-fast { 0% { transform: rotateX(0) rotateY(0); } 100% { transform: rotateX(360deg) rotateY(360deg); } }

    /* SUMMER — солнце быстрее пульсирует + лучи */
    .fx-summer::before {
      content: '';
      position: absolute; right: 12%; top: 22%;
      width: 160px; height: 160px;
      background: radial-gradient(circle, rgba(255, 230, 170, 1) 0%, rgba(251, 146, 60, 0.5) 40%, transparent 80%);
      border-radius: 50%;
      filter: blur(2px);
      animation: sun-fast 2.5s ease-in-out infinite alternate;
      z-index: 3;
    }
    .fx-summer::after {
      content: '';
      position: absolute; inset: 0; z-index: 3;
      background: repeating-linear-gradient(72deg, transparent 0 70px, rgba(255, 200, 130, 0.12) 70px 73px);
      animation: light-shift 8s linear infinite;
    }
    @keyframes sun-fast { 0% { opacity: 0.7; transform: scale(1); } 100% { opacity: 1; transform: scale(1.08); } }
    @keyframes light-shift { 0% { background-position: 0 0; } 100% { background-position: 100px 0; } }

    /* FOOD — пар быстрее */
    .fx-food::before, .fx-food::after {
      content: ''; position: absolute; z-index: 3; pointer-events: none;
      border-radius: 50%; filter: blur(28px);
    }
    .fx-food::before {
      width: 240px; height: 240px;
      left: 22%; bottom: 5%;
      background: radial-gradient(circle, rgba(255, 240, 200, 0.7) 0%, transparent 70%);
      animation: steam-fast 4s ease-in-out infinite;
    }
    .fx-food::after {
      width: 200px; height: 200px;
      right: 20%; bottom: 12%;
      background: radial-gradient(circle, rgba(255, 240, 200, 0.6) 0%, transparent 70%);
      animation: steam-fast 5s ease-in-out infinite reverse;
    }
    @keyframes steam-fast {
      0%,100% { transform: translateY(0) scale(1); opacity: 0.5; }
      50% { transform: translateY(-70px) scale(1.3); opacity: 1; }
    }

    /* POOL — частые капли */
    .fx-pool::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='180' viewBox='0 0 160 180'><ellipse cx='20' cy='30' rx='3' ry='10' fill='%23bae6fd' opacity='0.85'/><ellipse cx='60' cy='90' rx='3' ry='12' fill='%23bae6fd' opacity='0.7'/><ellipse cx='110' cy='50' rx='3' ry='10' fill='%23bae6fd' opacity='0.85'/><ellipse cx='140' cy='130' rx='3' ry='11' fill='%23bae6fd' opacity='0.75'/><ellipse cx='40' cy='160' rx='3' ry='9' fill='%23bae6fd' opacity='0.7'/></svg>");
      background-repeat: repeat;
      animation: rain-fast 2.5s linear infinite;
    }
    .fx-pool::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0; height: 50%;
      background: repeating-linear-gradient(transparent 0 30px, rgba(255,255,255,0.18) 30px 31px);
      mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
      z-index: 3;
    }

    /* FOREST — блики быстро шевелятся */
    .fx-forest::before {
      content: '';
      position: absolute; inset: 0; z-index: 3; pointer-events: none;
      background:
        radial-gradient(circle 50px at 18% 25%, rgba(255, 250, 200, 0.6), transparent 70%),
        radial-gradient(circle 60px at 65% 60%, rgba(255, 250, 200, 0.55), transparent 70%),
        radial-gradient(circle 40px at 85% 30%, rgba(255, 250, 200, 0.6), transparent 70%),
        radial-gradient(circle 55px at 40% 80%, rgba(255, 250, 200, 0.5), transparent 70%);
      filter: blur(8px);
      animation: dappled-fast 5s ease-in-out infinite alternate;
    }
    @keyframes dappled-fast {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(30px, -25px); }
    }

    /* NO-PHONE — нормальная иконка iPhone через SVG + перечёркивание */
    .fx-no-phone::before {
      content: '';
      position: absolute; right: 14%; top: 50%;
      width: 120px; height: 200px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='200' viewBox='0 0 120 200'><rect x='10' y='10' width='100' height='180' rx='18' ry='18' fill='none' stroke='%23bae6fd' stroke-width='3.5'/><rect x='18' y='28' width='84' height='150' rx='4' fill='%2338bdf8' opacity='0.15'/><circle cx='60' cy='184' r='3.5' fill='%23bae6fd'/><line x1='-10' y1='220' x2='130' y2='-20' stroke='%23ef4444' stroke-width='5' stroke-linecap='round'/></svg>");
      background-repeat: no-repeat;
      background-size: contain;
      transform: translateY(-50%);
      filter: drop-shadow(0 0 16px rgba(186, 230, 253, 0.5));
      animation: phone-breathe-fast 2.2s ease-in-out infinite;
      z-index: 3;
    }
    @keyframes phone-breathe-fast {
      0%,100% { opacity: 0.7; transform: translateY(-50%) scale(1); }
      50% { opacity: 1; transform: translateY(-50%) scale(1.07); }
    }

    /* MOSCOW — закат + лес силуэт */
    .fx-moscow::before {
      content: '';
      position: absolute; right: 18%; top: 18%;
      width: 130px; height: 130px;
      background: radial-gradient(circle, rgba(255, 200, 150, 1) 0%, rgba(251, 113, 133, 0.6) 50%, transparent 80%);
      border-radius: 50%;
      filter: blur(2px);
      box-shadow: 0 0 60px rgba(251, 113, 133, 0.5);
      animation: sun-fast 3s ease-in-out infinite alternate;
      z-index: 3;
    }
    .fx-moscow::after {
      content: '';
      position: absolute; left: 0; right: 0; bottom: 0; height: 42%;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='150' viewBox='0 0 400 150' preserveAspectRatio='none'><path d='M 0 150 L 0 100 L 30 100 L 30 80 L 50 80 L 50 110 L 80 110 L 80 70 L 110 70 L 110 95 L 140 95 L 140 60 L 175 60 L 175 90 L 210 90 L 210 75 L 240 75 L 240 100 L 270 100 L 270 65 L 300 65 L 300 95 L 330 95 L 330 80 L 360 80 L 360 105 L 400 105 L 400 150 Z' fill='%230f172a' opacity='0.95'/></svg>");
      background-repeat: no-repeat;
