---
/**
 * Прототип редизайна главной — 2026, направление «Editorial + тёплый премиум».
 * Страница закрыта от индексации и живёт отдельно от боевой главной:
 * ничего в src/pages/index.astro и в global.css не меняется.
 *
 * Что здесь настоящее: все цены, даты, вычет, трансфер, отзывы, FAQ и фото —
 * из штатных источников проекта (shifts.ts, seasons.ts, contacts.ts, reviews.ts,
 * faq.ts, /public/images). Прототипное — только отправка формы.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/redesign.css';

import RHeader from '../../components/redesign/RHeader.astro';
import RHero from '../../components/redesign/RHero.astro';
import RShifts from '../../components/redesign/RShifts.astro';
import RDay from '../../components/redesign/RDay.astro';
import RStay from '../../components/redesign/RStay.astro';
import RMoney from '../../components/redesign/RMoney.astro';
import RProject from '../../components/redesign/RProject.astro';
import RGallery from '../../components/redesign/RGallery.astro';
import RTeam from '../../components/redesign/RTeam.astro';
import RVoices from '../../components/redesign/RVoices.astro';
import RFaq from '../../components/redesign/RFaq.astro';
import RCta from '../../components/redesign/RCta.astro';
---

<Base
  title="Редизайн главной 2026 — прототип"
  description="Прототип редизайна главной страницы АйДаКемп: направление Editorial + тёплый премиум."
  noindex
  hideMarketingWidgets
  heroPreloadDesktop="/images/hero-desktop-1440.avif"
  heroPreloadMobile="/images/hero-mobile-bean-v3-828.avif"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Onest:wght@400;500;600&display=swap"
    />
  </Fragment>

  <div class="r-root">
    <RHeader />
    <main>
      <RHero />
      <RShifts />
      <RDay />
      <RProject />
      <RStay />
      <RMoney />
      <RGallery />
      <RVoices />
      <RTeam />
      <RFaq />
      <RCta />
    </main>
  </div>
</Base>
