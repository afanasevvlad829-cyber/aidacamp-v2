---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, CAMP_PRICE_FROM } from '../../data/contacts';
---

<Base title="[Демо] Стили hero — АйДаКемп" noindex>

<!-- Nav badge -->
<div class="fixed top-0 inset-x-0 z-[200] flex items-center justify-center gap-1 bg-zinc-900 border-b border-white/10 py-2 text-[12px] text-white/60">
  <span class="text-white/30 mr-2">→</span>
  {['#v1-linear','#v2-glass','#v3-liquid','#v4-supabase'].map((h, i) => (
    <a href={h} class="rounded-full bg-white/8 border border-white/10 px-3 py-1 hover:bg-white/15 transition-colors text-white/70 hover:text-white">
      {['Premium Dark','Glassmorphism','Liquid Glass','Supabase-style'][i]}
    </a>
  ))}
  <a href="/" class="ml-2 text-white/30 hover:text-white/60 transition-colors">← сайт</a>
</div>
<div class="h-9"></div>

<!-- ════════════════════════════════════════════
     V1 — PREMIUM DARK (Linear style)
     Сила в пространстве, типографике и чистоте
     ════════════════════════════════════════════ -->
<section id="v1-linear" class="relative min-h-screen bg-[#080808] flex flex-col overflow-hidden">

  <!-- Subtle grid texture -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <!-- Glow spot -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full opacity-20" style="background: radial-gradient(ellipse, #ec7c00 0%, transparent 70%);"></div>

  <!-- Nav -->
  <nav class="relative z-10 flex items-center justify-between px-6 py-5 max-w-[1280px] mx-auto w-full">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-orange-500 flex items-center justify-center">
        <i class="bi bi-cpu-fill text-white text-[14px]"></i>
      </div>
      <span class="text-white font-semibold text-[15px]">АйДаКемп</span>
    </div>
    <div class="hidden md:flex items-center gap-1 text-[14px]">
      {['О лагере','Смены','Команда','Отзывы'].map(l => (
        <a href="#" class="px-3 py-1.5 text-white/50 hover:text-white/90 transition-colors rounded-lg hover:bg-white/5">{l}</a>
      ))}
    </div>
    <a href="#" class="rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-[13px] text-white/80 hover:bg-white/10 transition-colors hidden md:block">
      Записаться →
    </a>
  </nav>

  <!-- Hero content -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-6 py-16 max-w-[800px] mx-auto">

    <!-- Pill -->
    <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[12px] text-white/50">
      <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
      Смены лето 2026 · от {CAMP_PRICE_FROM}
    </div>

    <h1 class="text-[52px] md:text-[72px] font-bold leading-[1.05] tracking-[-0.04em] text-white mb-6">
      Ребёнок уедет<br/>с&nbsp;AI&#8209;проектом
    </h1>

    <p class="text-[18px] md:text-[20px] text-white/45 leading-relaxed mb-10 max-w-[560px]">
      Летний лагерь в Подмосковье, 7–15 лет. Программирование, бассейн, настоящие проекты.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a href="#" class="rounded-full bg-orange-500 px-8 py-3.5 text-[15px] font-semibold text-white hover:bg-orange-400 transition-colors shadow-[0_0_40px_rgba(249,115,22,0.4)]">
        Выбрать смену
      </a>
      <a href="#" class="rounded-full border border-white/15 px-8 py-3.5 text-[15px] text-white/60 hover:text-white hover:border-white/30 transition-colors">
        Спросить бота →
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-14 flex items-center gap-8 text-center">
      {[
        { n: STAT_RATING, l: 'Яндекс Карты' },
        { n: STAT_YEARS + ' лет', l: 'работаем' },
        { n: STAT_KIDS, l: 'детей отдохнули' },
        { n: 'ТОП-4', l: 'IT-лагерей МО' },
      ].map(s => (
        <div>
          <div class="text-[22px] font-bold text-white">{'★ ' + s.n === '★ ' + STAT_RATING ? '★ ' + s.n : s.n}</div>
          <div class="text-[12px] text-white/35 mt-0.5">{s.l}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-white/20 font-mono tracking-widest uppercase">V1 — Premium Dark</div>
</section>


<!-- ════════════════════════════════════════════
     V2 — GLASSMORPHISM
     Живой градиент + стеклянные карточки
     ════════════════════════════════════════════ -->
<section id="v2-glass" class="relative min-h-screen overflow-hidden flex flex-col">

  <!-- Vibrant gradient background — без этого glass не работает -->
  <div class="absolute inset-0" style="background: linear-gradient(135deg, #0f0c29 0%, #302b63 40%, #24243e 100%);"></div>
  <div class="absolute top-[-20%] right-[-10%] w-[600px] h-[600px] rounded-full opacity-40" style="background: radial-gradient(circle, #ec7c00 0%, transparent 60%);"></div>
  <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] rounded-full opacity-30" style="background: radial-gradient(circle, #7c3aed 0%, transparent 60%);"></div>
  <div class="absolute top-[30%] left-[20%] w-[300px] h-[300px] rounded-full opacity-20" style="background: radial-gradient(circle, #06b6d4 0%, transparent 60%);"></div>

  <!-- Photo overlay -->
  <div class="absolute inset-0 opacity-25">
    <img src="/images/hero-bot-kid.jpg" class="w-full h-full object-cover" alt="" aria-hidden="true" />
  </div>

  <!-- Nav glass -->
  <nav class="relative z-10 flex items-center justify-between px-6 py-4 mx-auto w-full max-w-[1280px] mt-2">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-sm border border-white/20 flex items-center justify-center">
        <i class="bi bi-cpu-fill text-white text-[14px]"></i>
      </div>
      <span class="text-white font-semibold text-[15px]">АйДаКемп</span>
    </div>
    <!-- Glass nav bar -->
    <div class="hidden md:flex items-center gap-1 bg-white/10 backdrop-blur-md border border-white/15 rounded-full px-2 py-1.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]">
      {['О лагере','Смены','Команда','Отзывы'].map(l => (
        <a href="#" class="px-4 py-1 text-[13px] text-white/70 hover:text-white hover:bg-white/15 rounded-full transition-all">{l}</a>
      ))}
    </div>
    <a href="#" class="hidden md:block rounded-full bg-orange-500/80 backdrop-blur-sm border border-orange-400/40 px-4 py-1.5 text-[13px] font-semibold text-white hover:bg-orange-500 transition-colors">
      Записаться
    </a>
  </nav>

  <!-- Hero -->
  <div class="relative z-10 flex-1 flex items-center px-6 max-w-[1280px] mx-auto w-full py-12">
    <div class="grid md:grid-cols-2 gap-10 items-center w-full">

      <!-- Left: text -->
      <div>
        <div class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 px-4 py-1.5 text-[12px] text-white/70">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
          Лето 2026 · Подмосковье · от {CAMP_PRICE_FROM}
        </div>
        <h1 class="text-[46px] font-bold leading-[1.1] tracking-[-0.03em] text-white mb-4">
          Летний лагерь<br/>в Подмосковье,<br/><span class="text-orange-400">7–15 лет</span>
        </h1>
        <p class="text-[16px] text-white/65 leading-relaxed mb-8">
          Ребёнок уедет с AI&#8209;проектом. Программирование, бассейн, настоящие друзья.
        </p>
        <div class="flex gap-3">
          <a href="#" class="rounded-full bg-orange-500 px-6 py-3 text-[15px] font-semibold text-white shadow-[0_8px_32px_rgba(249,115,22,0.4)] hover:bg-orange-400 transition-colors">
            Выбрать смену
          </a>
          <a href="#" class="rounded-full bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 text-[15px] text-white/80 hover:bg-white/20 transition-colors shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]">
            <i class="bi bi-telegram mr-1.5"></i>Бот
          </a>
        </div>
      </div>

      <!-- Right: glass cards -->
      <div class="flex flex-col gap-3">
        <!-- Main glass card -->
        <div class="rounded-[20px] bg-white/10 backdrop-blur-xl border border-white/20 p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_20px_60px_rgba(0,0,0,0.3)]">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-orange-500/20 border border-orange-400/30 flex items-center justify-center">
              <i class="bi bi-code-slash text-orange-400 text-[18px]"></i>
            </div>
            <div>
              <div class="text-[15px] font-bold text-white">Python · AI · Minecraft</div>
              <div class="text-[12px] text-white/50">14 дней с проектом</div>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-2">
            {[{n:'★ '+STAT_RATING,l:'рейтинг'},{n:STAT_KIDS,l:'детей'},{n:STAT_YEARS+' лет',l:'опыта'}].map(s => (
              <div class="rounded-xl bg-white/8 border border-white/10 p-3 text-center">
                <div class="text-[16px] font-bold text-white">{s.n}</div>
                <div class="text-[10px] text-white/45 mt-0.5">{s.l}</div>
              </div>
            ))}
          </div>
        </div>
        <!-- Mini cards row -->
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-[16px] bg-white/8 backdrop-blur-xl border border-white/15 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]">
            <i class="bi bi-patch-check-fill text-[20px] text-blue-400 mb-2 block"></i>
            <div class="text-[13px] font-semibold text-white">Лицензия МО</div>
            <div class="text-[11px] text-white/45 mt-0.5">Медсестра 24/7</div>
          </div>
          <div class="rounded-[16px] bg-white/8 backdrop-blur-xl border border-white/15 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]">
            <i class="bi bi-geo-alt-fill text-[20px] text-green-400 mb-2 block"></i>
            <div class="text-[13px] font-semibold text-white">66 км от Москвы</div>
            <div class="text-[11px] text-white/45 mt-0.5">Трансфер включён</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-white/20 font-mono tracking-widest uppercase z-10">V2 — Glassmorphism</div>
</section>


<!-- ════════════════════════════════════════════
     V3 — LIQUID GLASS (Apple iOS 26)
     Иридесцент + морфинг + белое стекло
     ════════════════════════════════════════════ -->
<section id="v3-liquid" class="relative min-h-screen overflow-hidden flex flex-col">

  <!-- Animated iridescent background -->
  <div class="absolute inset-0" style="background: linear-gradient(160deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%);"></div>
  <!-- Iridescent orbs -->
  <div class="absolute top-[10%] left-[15%] w-[400px] h-[400px] rounded-full blur-[80px] opacity-60 animate-pulse" style="background: conic-gradient(from 0deg, #ec7c00, #ec4899, #8b5cf6, #06b6d4, #ec7c00); animation-duration: 4s;"></div>
  <div class="absolute bottom-[5%] right-[10%] w-[350px] h-[350px] rounded-full blur-[100px] opacity-40" style="background: conic-gradient(from 180deg, #06b6d4, #ec7c00, #8b5cf6, #06b6d4); animation: pulse 6s ease-in-out infinite;"></div>

  <!-- Glass Nav — floating pill -->
  <nav class="relative z-10 flex items-center justify-between mx-auto w-full max-w-[1280px] px-6 pt-6">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background: rgba(255,255,255,0.15); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.3); box-shadow: inset 0 1px 0 rgba(255,255,255,0.4), 0 4px 16px rgba(0,0,0,0.2);">
        <i class="bi bi-cpu-fill text-white text-[16px]"></i>
      </div>
      <span class="text-white font-bold text-[16px]" style="text-shadow: 0 0 20px rgba(255,255,255,0.3)">АйДаКемп</span>
    </div>

    <!-- Floating glass pill nav -->
    <div class="hidden md:flex items-center gap-0.5 px-2 py-1.5" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(30px) saturate(180%); border: 1px solid rgba(255,255,255,0.2); border-radius: 100px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 8px 32px rgba(0,0,0,0.3);">
      {['О лагере','Смены','Команда','Отзывы'].map(l => (
        <a href="#" class="px-4 py-1.5 text-[13px] font-medium text-white/70 hover:text-white transition-colors rounded-full hover:bg-white/10">{l}</a>
      ))}
    </div>

    <a href="#" class="hidden md:block px-5 py-2 text-[13px] font-semibold text-white rounded-full transition-all hover:scale-105" style="background: rgba(249,115,22,0.85); backdrop-filter: blur(20px); border: 1px solid rgba(249,115,22,0.5); box-shadow: 0 0 30px rgba(249,115,22,0.4), inset 0 1px 0 rgba(255,255,255,0.25);">
      Записаться
    </a>
  </nav>

  <!-- Hero content -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-6 py-16">

    <!-- Floating glass hero card -->
    <div class="max-w-[680px] w-full rounded-[28px] p-8 md:p-12" style="background: rgba(255,255,255,0.07); backdrop-filter: blur(40px) saturate(200%); border: 1px solid rgba(255,255,255,0.18); box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), inset 0 -1px 0 rgba(0,0,0,0.1), 0 32px 80px rgba(0,0,0,0.4);">

      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-[12px] font-medium" style="background: rgba(249,115,22,0.15); border: 1px solid rgba(249,115,22,0.3); color: rgba(255,200,150,0.9); backdrop-filter: blur(10px);">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
        Запись открыта · Лето 2026
      </div>

      <h1 class="text-[42px] md:text-[58px] font-bold leading-[1.05] tracking-[-0.04em] text-white mb-5" style="text-shadow: 0 2px 20px rgba(255,255,255,0.15)">
        Летний лагерь<br/><span style="background: linear-gradient(135deg, #ec7c00, #ec4899, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">в Подмосковье</span>
      </h1>

      <p class="text-[16px] text-white/60 leading-relaxed mb-8">
        7–15 лет · AI и программирование · Бассейн · Настоящие проекты
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
        <a href="#" class="rounded-full px-8 py-3.5 text-[15px] font-bold text-white w-full sm:w-auto text-center transition-all hover:scale-105" style="background: linear-gradient(135deg, rgba(249,115,22,0.9), rgba(236,72,153,0.7)); backdrop-filter: blur(20px); border: 1px solid rgba(249,115,22,0.4); box-shadow: 0 8px 40px rgba(249,115,22,0.35), inset 0 1px 0 rgba(255,255,255,0.2);">
          Выбрать смену
        </a>
        <a href="#" class="rounded-full px-8 py-3.5 text-[15px] font-medium w-full sm:w-auto text-center transition-all hover:bg-white/15" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.8); box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);">
          <i class="bi bi-telegram mr-1.5"></i>Спросить бота
        </a>
      </div>

      <!-- Stats inside glass card -->
      <div class="flex items-center justify-center gap-6 pt-6 border-t border-white/10">
        {[
          { n: '★ ' + STAT_RATING, l: 'Яндекс Карты' },
          { n: STAT_YEARS + ' лет', l: 'опыта' },
          { n: STAT_KIDS, l: 'детей' },
        ].map(s => (
          <div class="text-center">
            <div class="text-[18px] font-bold text-white">{s.n}</div>
            <div class="text-[11px] text-white/40 mt-0.5">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-white/20 font-mono tracking-widest uppercase z-10">V3 — Liquid Glass</div>
</section>


<!-- ════════════════════════════════════════════
     V4 — SUPABASE-STYLE (фото + тёмный + strong акцент)
     Структурно близко к текущему сайту
     ════════════════════════════════════════════ -->
<section id="v4-supabase" class="relative min-h-screen bg-[#060a12] overflow-hidden flex flex-col">

  <!-- Hero photo full-bleed -->
  <div class="absolute inset-0">
    <img src="/images/hero-bot-kid.jpg" class="w-full h-full object-cover object-[center_20%] opacity-30" alt="" aria-hidden="true" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(6,10,18,0.3) 0%, rgba(6,10,18,0.6) 50%, #060a12 100%);"></div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(6,10,18,0.8) 0%, transparent 60%);"></div>
  </div>

  <!-- Nav -->
  <nav class="relative z-10 flex items-center justify-between px-6 py-5 max-w-[1280px] mx-auto w-full">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-orange-500 flex items-center justify-center shadow-[0_0_16px_rgba(249,115,22,0.5)]">
        <i class="bi bi-cpu-fill text-white text-[14px]"></i>
      </div>
      <span class="text-white font-bold text-[16px]">АйДаКемп</span>
    </div>
    <div class="hidden md:flex items-center gap-1">
      {['О лагере','Смены','Команда','Отзывы'].map(l => (
        <a href="#" class="px-3 py-1.5 text-[14px] text-white/55 hover:text-white/90 transition-colors">{l}</a>
      ))}
    </div>
    <a href="#" class="hidden md:flex items-center gap-2 rounded-lg border border-orange-500/40 bg-orange-500/10 px-4 py-1.5 text-[13px] font-semibold text-orange-300 hover:bg-orange-500/20 transition-colors">
      <i class="bi bi-telephone-fill text-[11px]"></i>Записаться
    </a>
  </nav>

  <!-- Hero -->
  <div class="relative z-10 flex-1 flex items-center px-6 max-w-[1280px] mx-auto w-full">
    <div class="max-w-[640px] py-12">

      <!-- Pill announcement -->
      <a href="#" class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[12px] text-white/60 hover:border-white/20 hover:text-white/80 transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
        ТОП-4 IT-лагерей МО по версии vc.ru
        <i class="bi bi-chevron-right text-[9px] opacity-50"></i>
      </a>

      <h1 class="text-[48px] md:text-[64px] font-bold leading-[1.05] tracking-[-0.04em] text-white mb-6">
        Летний лагерь<br/>в Подмосковье<br/>
        <span class="text-orange-400">7–15</span> лет
      </h1>

      <p class="text-[17px] text-white/55 leading-relaxed mb-10 max-w-[500px]">
        Ребёнок уедет с готовым AI&#8209;проектом. Программирование, бассейн, настоящие друзья. Смены с 30 мая.
      </p>

      <div class="flex flex-wrap gap-3 mb-12">
        <a href="#" class="rounded-lg bg-orange-500 px-8 py-3.5 text-[15px] font-bold text-white hover:bg-orange-400 transition-colors shadow-[0_0_32px_rgba(249,115,22,0.35)]">
          Выбрать смену →
        </a>
        <a href="#" class="rounded-lg border border-white/15 px-8 py-3.5 text-[15px] text-white/65 hover:text-white hover:border-white/30 transition-colors">
          <i class="bi bi-telegram mr-2"></i>Спросить бота
        </a>
      </div>

      <!-- Stats row -->
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {[
          { n: '★ ' + STAT_RATING, l: 'Яндекс Карты' },
          { n: STAT_YEARS + ' лет', l: 'работаем' },
          { n: STAT_KIDS, l: 'детей' },
          { n: 'ТОП-4', l: 'IT-лагерей МО' },
        ].map(s => (
          <div>
            <span class="text-[18px] font-bold text-white">{s.n}</span>
            <span class="text-[13px] text-white/35 ml-2">{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-white/20 font-mono tracking-widest uppercase z-10">V4 — Dark + Photo (ближе всего к текущему)</div>
</section>

</Base>
