---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import MomStory from '../../components/MomStory.astro';
import About from '../../components/About.astro';
import Shifts from '../../components/Shifts.astro';
import Gallery from '../../components/Gallery.astro';
import Videos from '../../components/Videos.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import Team from '../../components/Team.astro';
import Mentors from '../../components/Mentors.astro';
import Stay from '../../components/Stay.astro';
import Journey from '../../components/Journey.astro';
import Economy from '../../components/Economy.astro';
import Hackathon from '../../components/Hackathon.astro';
import BookingBar from '../../components/BookingBar.astro';
import SoftStart from '../../components/SoftStart.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import ShiftModal from '../../components/ShiftModal.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import SeoTextBlock from '../../components/SeoTextBlock.astro';
import ShiftOccupancy from '../../components/ShiftOccupancy.astro';
import SummerCta from '../../components/SummerCta.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../../data/landing-pages';
---

<Base
  title="[Демо] Liquid Glass — АйДаКемп"
  description=""
  heroPreloadMobile="/images/hero-mobile.avif"
  heroPreloadDesktop="/images/hero-desktop.avif"
  noindex
>
  <Fragment slot="head">
    <SchemaOrg />
  </Fragment>

  <!-- ══ Switcher ══ -->
  <div id="liq-sw" role="group" aria-label="Тема">
    <button id="btn-cur" onclick="liqSetTheme('current')" aria-pressed="true">Текущий</button>
    <button id="btn-liq" onclick="liqSetTheme('liquid')"  aria-pressed="false">✦ Liquid Glass</button>
    <div id="liq-pill" aria-hidden="true"></div>
  </div>

  <!-- ══ Весь сайт ══ -->
  <div id="liq-wrap">
    <Header />
    <main class="pb-20 md:pb-0">
      <Hero hasVariants={true} />

      <div class="md:hidden flex px-5 py-3">
        <div class="rotate-[-10deg] relative flex h-[96px] w-[96px] items-center justify-center rounded-full border-[2.5px] border-dashed border-[#0d1a2b]/55">
          <div class="absolute inset-[7px] rounded-full border border-[#0d1a2b]/18"></div>
          <div class="flex flex-col items-center gap-0 px-2 text-center">
            <i class="bi bi-laptop text-[20px] leading-none text-[#0d1a2b]" aria-hidden="true"></i>
            <span class="mt-0.5 text-[7.5px] font-black uppercase tracking-[0.14em] text-[#0d1a2b] leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-[#0d1a2b]/30"></div>
            <span class="mt-0.5 text-[6.5px] font-semibold uppercase tracking-[0.09em] text-[#0d1a2b]/55 leading-[1.4]">у нас всё есть!</span>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
        <div class="flex flex-col gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
          <ShiftOccupancy />
          <MomStory compact />
        </div>
      </div>
      <About />
      <Journey />
      <Economy />
      <BookingBar id="after-economy" headline="Один звонок — ответим на всё и не будем беспокоить" />
      <SoftStart />
      <Shifts />
      <BookingBar id="after-shifts" headline="Выбрали смену? Забронируем за 10 минут" />
      <SummerCta />
      <Hackathon />
      <Gallery />
      <Videos />
      <Reviews />
      <FAQ />
      <Team />
      <Mentors />
      <Stay />
      <Contacts />
      <SeoTextBlock />
      <RelatedPages pages={allLandingPages} />
    </main>
    <Footer />
  </div>

  <ShiftModal />
</Base>

<style is:global>
/* ══════════════════════════════════════════════════════════════
   SWITCHER UI
   ══════════════════════════════════════════════════════════════ */
#liq-sw {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  display: flex;
  align-items: center;
  padding: 4px;
  border-radius: 100px;
  background: rgba(6, 10, 18, 0.92);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255,255,255,0.13);
  box-shadow: 0 8px 32px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.07);
}
#liq-sw button {
  position: relative; z-index: 1;
  padding: 8px 22px;
  border-radius: 100px;
  font-size: 13px; font-weight: 600;
  color: rgba(255,255,255,0.38);
  background: transparent; border: none;
  cursor: pointer; white-space: nowrap;
  transition: color 220ms ease;
}
#liq-sw button[aria-pressed="true"] { color: rgba(255,255,255,0.95); }
#liq-pill {
  position: absolute; top: 4px; left: 4px;
  height: calc(100% - 8px);
  border-radius: 100px;
  background: rgba(255,255,255,0.09);
  border: 1px solid rgba(255,255,255,0.10);
  transition: left 280ms cubic-bezier(0.34,1.26,0.64,1),
              width 280ms cubic-bezier(0.34,1.26,0.64,1),
              background 300ms ease, border-color 300ms ease;
  pointer-events: none;
}
body.liq #liq-pill {
  background: linear-gradient(135deg, rgba(236,72,153,0.38), rgba(139,92,246,0.32));
  border-color: rgba(236,72,153,0.38);
}

/* ══════════════════════════════════════════════════════════════
   LAYER 0 — ТЕЛО: светлый иридесцентный градиент (пастельный)
   Референс Apple Liquid Glass — СВЕТЛЫЙ, не тёмный.
   Пастельные цвета на почти-белой основе.
   ══════════════════════════════════════════════════════════════ */
body.liq {
  background:
    radial-gradient(ellipse 72% 62% at 12% 16%,
      rgba(236, 72, 153, 0.62) 0%, rgba(192, 132, 252, 0.34) 44%, transparent 70%),
    radial-gradient(ellipse 66% 58% at 87% 82%,
      rgba(6, 182, 212, 0.58) 0%, rgba(167, 139, 250, 0.30) 44%, transparent 70%),
    radial-gradient(ellipse 54% 48% at 82% 12%,
      rgba(139, 92, 246, 0.50) 0%, rgba(99, 102, 241, 0.26) 44%, transparent 68%),
    radial-gradient(ellipse 48% 42% at 14% 88%,
      rgba(249, 115, 22, 0.44) 0%, rgba(251, 146, 60, 0.22) 44%, transparent 68%),
    radial-gradient(ellipse 38% 32% at 50% 46%,
      rgba(6, 182, 212, 0.24) 0%, transparent 60%),
    linear-gradient(155deg, #faf8ff 0%, #fff2fb 28%, #f2f8ff 62%, #fffbf2 100%);
  background-attachment: fixed;
  animation: liq-pulse 9s ease-in-out infinite;
}
@keyframes liq-pulse {
  0%,100% { filter: saturate(1.00) brightness(1.00); }
  35%     { filter: saturate(1.22) brightness(1.04); }
  68%     { filter: saturate(0.92) brightness(0.98); }
}

/* ══════════════════════════════════════════════════════════════
   LAYER 1 — МЕМБРАНА: почти прозрачная, только тонкий specular
   ══════════════════════════════════════════════════════════════ */
body.liq #liq-wrap {
  background: rgba(255, 255, 255, 0.06);
  position: relative;
  isolation: isolate;
}

/* ══════════════════════════════════════════════════════════════
   LAYER 2 — ЯДЕРНЫЙ СБРОС
   Светлый фон → тёмный текст (WCAG 4.5:1 гарантирован).
   ══════════════════════════════════════════════════════════════ */

/* Все тексты → почти-чёрные (на светлом фоне читаемость идеальная) */
body.liq #liq-wrap * {
  color: rgba(15, 8, 32, 0.87) !important;
  text-shadow: none !important;
}

/* Все фоны → прозрачные (кроме img/video) */
body.liq #liq-wrap *:not(img):not(video):not(iframe):not(canvas):not(svg) {
  background-color: transparent !important;
}

/* Бордеры → тонкие тёмные */
body.liq #liq-wrap *:not(img):not(video) {
  border-color: rgba(0, 0, 0, 0.08) !important;
}

/* ══════════════════════════════════════════════════════════════
   LAYER 3 — ВОССТАНОВЛЕНИЕ
   ══════════════════════════════════════════════════════════════ */

/* ── Хедер: матовое белое стекло ── */
body.liq header {
  background: rgba(255, 255, 255, 0.78) !important;
  backdrop-filter: blur(40px) saturate(220%) !important;
  -webkit-backdrop-filter: blur(40px) saturate(220%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.90) !important;
  box-shadow:
    0 1px 0 rgba(0, 0, 0, 0.05),
    0 4px 24px rgba(139, 92, 246, 0.08) !important;
}

/* ── Навигация: стеклянные пилюли ── */
body.liq header nav a {
  background: rgba(0, 0, 0, 0.04) !important;
  border: 1px solid rgba(0, 0, 0, 0.08) !important;
  border-radius: 100px !important;
  backdrop-filter: blur(12px) !important;
  padding: 6px 14px !important;
  transition: all 200ms ease !important;
}
body.liq header nav a:hover {
  background: rgba(139, 92, 246, 0.10) !important;
  border-color: rgba(139, 92, 246, 0.22) !important;
  transform: translateY(-1px) !important;
}

/* ── Оранжевые CTA кнопки ── */
body.liq .bg-orange-500,
body.liq [class*="bg-\[#f97316\]"],
body.liq [class*="bg-\[#ec7c00\]"],
body.liq button[class*="orange"],
body.liq a[class*="bg-orange"] {
  background-color: #f97316 !important;
  color: #fff !important;
  box-shadow:
    0 6px 28px rgba(249, 115, 22, 0.38),
    0 2px 8px rgba(249, 115, 22, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.24) !important;
}

/* ── Зелёные / синие бейджи ── */
body.liq [class*="bg-green-"],
body.liq [class*="bg-emerald-"] {
  background-color: rgba(16, 185, 129, 0.14) !important;
  border: 1px solid rgba(16, 185, 129, 0.30) !important;
  color: #065f46 !important;
}
body.liq [class*="bg-blue-"],
body.liq [class*="bg-sky-"],
body.liq [class*="bg-\[#1e40af\]"],
body.liq [class*="bg-\[#1d4ed8\]"] {
  background-color: rgba(59, 130, 246, 0.12) !important;
  border: 1px solid rgba(59, 130, 246, 0.28) !important;
  color: #1e40af !important;
}

/* ── Glass карточки: FROSTED WHITE — основной эффект ── */
body.liq #liq-wrap [class*="rounded-xl"],
body.liq #liq-wrap [class*="rounded-2xl"],
body.liq #liq-wrap [class*="rounded-3xl"] {
  background: rgba(255, 255, 255, 0.62) !important;
  border: 1px solid rgba(255, 255, 255, 0.90) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    0 8px 40px rgba(139, 92, 246, 0.10),
    0 2px 12px rgba(0, 0, 0, 0.05),
    0 0 0 0.5px rgba(0, 0, 0, 0.04) !important;
  backdrop-filter: blur(28px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(200%) !important;
}

/* Крупные блоки с rounded-lg тоже стекло */
body.liq #faq     > * [class*="rounded-lg"],
body.liq #reviews > * [class*="rounded-lg"],
body.liq #team    > * [class*="rounded-lg"],
body.liq #contacts > * [class*="rounded-lg"],
body.liq #shifts  > * [class*="rounded-lg"] {
  background: rgba(255, 255, 255, 0.55) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
}

/* ── Иридесцентная подсветка заголовков ── */
body.liq h2 {
  background: linear-gradient(135deg, #7c3aed, #ec4899, #0891b2) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  color: transparent !important;
  filter: none !important;
}

/* ── Футер: матовое светлое стекло ── */
body.liq footer {
  background: rgba(255, 255, 255, 0.70) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.90) !important;
  backdrop-filter: blur(24px) !important;
  -webkit-backdrop-filter: blur(24px) !important;
}

/* ── Booking bar ── */
body.liq [id*="after-"] {
  background: rgba(255, 255, 255, 0.60) !important;
  backdrop-filter: blur(24px) !important;
  -webkit-backdrop-filter: blur(24px) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.88) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.88) !important;
  box-shadow: 0 2px 20px rgba(139, 92, 246, 0.07) !important;
}

/* ── Инпуты ── */
body.liq input[type="tel"],
body.liq input[type="text"],
body.liq input[type="email"] {
  background: rgba(255, 255, 255, 0.72) !important;
  border: 1px solid rgba(0, 0, 0, 0.12) !important;
  color: rgba(15, 8, 32, 0.88) !important;
}
body.liq input::placeholder { color: rgba(15, 8, 32, 0.35) !important; }

/* ── Иконки: насыщенные цвета на светлом ── */
body.liq [class*="bi-"],
body.liq [class*="bi "] {
  opacity: 0.80 !important;
  filter: none !important;
}

/* ── FAQ аккордеон ── */
body.liq details,
body.liq summary {
  background: rgba(255, 255, 255, 0.58) !important;
  border: 1px solid rgba(255, 255, 255, 0.88) !important;
  border-radius: 12px !important;
  padding: 16px 20px !important;
  backdrop-filter: blur(16px) !important;
}

/* ── Gallery & Videos — белые секции становятся стеклом ── */
body.liq #gallery > div,
body.liq #videos  > div,
body.liq [class*="bg-\[#f7f5f2\]"],
body.liq [class*="bg-white"],
body.liq [class*="bg-slate-50"],
body.liq [class*="bg-slate-100"] {
  background-color: rgba(255, 255, 255, 0.22) !important;
}

/* ── Цветные pill-бейджи (года, места, рейтинги) ── */
body.liq [class*="bg-\[#fff2e3\]"],
body.liq [class*="bg-orange-50"],
body.liq [class*="bg-amber-50"] {
  background-color: rgba(249, 115, 22, 0.10) !important;
  border: 1px solid rgba(249, 115, 22, 0.20) !important;
}

/* ── Micro-interactions ── */
body.liq a, body.liq button {
  transition: transform 160ms ease, box-shadow 160ms ease,
              background 160ms ease, border-color 160ms ease !important;
}
body.liq a:not(header a):hover,
body.liq button:not(#liq-sw button):hover {
  transform: translateY(-1px) !important;
}
</style>

<script>
  function liqMovePill(btn: HTMLButtonElement) {
    const pill = document.getElementById('liq-pill') as HTMLDivElement;
    const sw   = document.getElementById('liq-sw')   as HTMLDivElement;
    if (!pill || !sw) return;
    const sr = sw.getBoundingClientRect();
    const br = btn.getBoundingClientRect();
    pill.style.left  = (br.left - sr.left - 4) + 'px';
    pill.style.width = br.width + 'px';
  }

  function liqSetTheme(t: string) {
    const on = t === 'liquid';
    document.body.classList.toggle('liq', on);

    const bCur = document.getElementById('btn-cur') as HTMLButtonElement;
    const bLiq = document.getElementById('btn-liq') as HTMLButtonElement;
    if (!bCur || !bLiq) return;
    bCur.setAttribute('aria-pressed', String(!on));
    bLiq.setAttribute('aria-pressed', String(on));
    liqMovePill(on ? bLiq : bCur);
    try { localStorage.setItem('aidacamp-liq', t); } catch {}
  }

  function liqInit() {
    const bCur = document.getElementById('btn-cur') as HTMLButtonElement;
    if (bCur) liqMovePill(bCur);
    let saved = 'current';
    try { saved = localStorage.getItem('aidacamp-liq') || 'current'; } catch {}
    liqSetTheme(saved);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', liqInit);
  else liqInit();

  (window as any).liqSetTheme = liqSetTheme;
</script>
