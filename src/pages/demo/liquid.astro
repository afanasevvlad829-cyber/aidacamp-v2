---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import MomStory from '../../components/MomStory.astro';
import About from '../../components/About.astro';
import Shifts from '../../components/Shifts.astro';
import Gallery from '../../components/Gallery.astro';
import Videos from '../../components/Videos.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import Team from '../../components/Team.astro';
import Mentors from '../../components/Mentors.astro';
import Stay from '../../components/Stay.astro';
import Journey from '../../components/Journey.astro';
import Economy from '../../components/Economy.astro';
import Hackathon from '../../components/Hackathon.astro';
import BookingBar from '../../components/BookingBar.astro';
import SoftStart from '../../components/SoftStart.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import ShiftModal from '../../components/ShiftModal.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import SeoTextBlock from '../../components/SeoTextBlock.astro';
import ShiftOccupancy from '../../components/ShiftOccupancy.astro';
import SummerCta from '../../components/SummerCta.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../../data/landing-pages';
---

<Base
  title="[Демо] Liquid Glass — АйДаКемп"
  description=""
  heroPreloadMobile="/images/hero-mobile.avif"
  heroPreloadDesktop="/images/hero-desktop.avif"
  noindex
>
  <Fragment slot="head">
    <SchemaOrg />
  </Fragment>

  <!-- ══ Switcher ══ -->
  <div id="liq-sw" role="group" aria-label="Тема">
    <button id="btn-cur" onclick="liqSetTheme('current')" aria-pressed="true">Текущий</button>
    <button id="btn-liq" onclick="liqSetTheme('liquid')"  aria-pressed="false">✦ Liquid Glass</button>
    <div id="liq-pill" aria-hidden="true"></div>
  </div>

  <!-- ══ Весь сайт ══ -->
  <div id="liq-wrap">
    <Header />
    <main class="pb-20 md:pb-0">
      <Hero hasVariants={true} />

      <div class="md:hidden flex px-5 py-3">
        <div class="rotate-[-10deg] relative flex h-[96px] w-[96px] items-center justify-center rounded-full border-[2.5px] border-dashed border-[#0d1a2b]/55">
          <div class="absolute inset-[7px] rounded-full border border-[#0d1a2b]/18"></div>
          <div class="flex flex-col items-center gap-0 px-2 text-center">
            <i class="bi bi-laptop text-[20px] leading-none text-[#0d1a2b]" aria-hidden="true"></i>
            <span class="mt-0.5 text-[7.5px] font-black uppercase tracking-[0.14em] text-[#0d1a2b] leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-[#0d1a2b]/30"></div>
            <span class="mt-0.5 text-[6.5px] font-semibold uppercase tracking-[0.09em] text-[#0d1a2b]/55 leading-[1.4]">у нас всё есть!</span>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
        <div class="flex flex-col gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
          <ShiftOccupancy />
          <MomStory compact />
        </div>
      </div>
      <About />
      <Journey />
      <Economy />
      <BookingBar id="after-economy" headline="Один звонок — ответим на всё и не будем беспокоить" />
      <SoftStart />
      <Shifts />
      <BookingBar id="after-shifts" headline="Выбрали смену? Забронируем за 10 минут" />
      <SummerCta />
      <Hackathon />
      <Gallery />
      <Videos />
      <Reviews />
      <FAQ />
      <Team />
      <Mentors />
      <Stay />
      <Contacts />
      <SeoTextBlock />
      <RelatedPages pages={allLandingPages} />
    </main>
    <Footer />
  </div>

  <ShiftModal />
</Base>

<style is:global>
/* ══════════════════════════════════════════════════════════════
   SWITCHER UI
   ══════════════════════════════════════════════════════════════ */
#liq-sw {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  display: flex;
  align-items: center;
  padding: 4px;
  border-radius: 100px;
  background: rgba(6, 10, 18, 0.92);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255,255,255,0.13);
  box-shadow: 0 8px 32px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.07);
}
#liq-sw button {
  position: relative; z-index: 1;
  padding: 8px 22px;
  border-radius: 100px;
  font-size: 13px; font-weight: 600;
  color: rgba(255,255,255,0.38);
  background: transparent; border: none;
  cursor: pointer; white-space: nowrap;
  transition: color 220ms ease;
}
#liq-sw button[aria-pressed="true"] { color: rgba(255,255,255,0.95); }
#liq-pill {
  position: absolute; top: 4px; left: 4px;
  height: calc(100% - 8px);
  border-radius: 100px;
  background: rgba(255,255,255,0.09);
  border: 1px solid rgba(255,255,255,0.10);
  transition: left 280ms cubic-bezier(0.34,1.26,0.64,1),
              width 280ms cubic-bezier(0.34,1.26,0.64,1),
              background 300ms ease, border-color 300ms ease;
  pointer-events: none;
}
body.liq #liq-pill {
  background: linear-gradient(135deg, rgba(236,72,153,0.38), rgba(139,92,246,0.32));
  border-color: rgba(236,72,153,0.38);
}

/* ══════════════════════════════════════════════════════════════
   LAYER 0 — ТЕЛО: иридесцентный градиент (фиксированный)
   ══════════════════════════════════════════════════════════════ */
body.liq {
  background:
    radial-gradient(ellipse 72% 58% at 12% 18%,
      rgba(236,72,153,0.90) 0%, rgba(139,92,246,0.65) 42%, transparent 68%),
    radial-gradient(ellipse 66% 55% at 88% 82%,
      rgba(6,182,212,0.85)  0%, rgba(139,92,246,0.55) 44%, transparent 68%),
    radial-gradient(ellipse 50% 44% at 82% 14%,
      rgba(139,92,246,0.72) 0%, rgba(79,70,229,0.45)  46%, transparent 65%),
    radial-gradient(ellipse 46% 38% at 14% 86%,
      rgba(249,115,22,0.58) 0%, rgba(236,72,153,0.36) 46%, transparent 65%),
    radial-gradient(ellipse 38% 32% at 52% 46%,
      rgba(6,182,212,0.38)  0%, transparent 60%),
    linear-gradient(160deg, #100c22 0%, #0d1838 32%, #081e4e 58%, #120e2c 100%);
  background-attachment: fixed;
  animation: liq-pulse 7s ease-in-out infinite;
}
@keyframes liq-pulse {
  0%,100% { filter: brightness(1.00) saturate(1.00); }
  40%      { filter: brightness(1.20) saturate(1.28); }
  70%      { filter: brightness(0.92) saturate(0.90); }
}

/* ══════════════════════════════════════════════════════════════
   LAYER 1 — МЕМБРАНА: тёмное стекло поверх ВСЕГО сайта
   Перекрывает весь #liq-wrap одним слоем, не секцию за секцией.
   Градиент просвечивает через 38% прозрачность.
   ══════════════════════════════════════════════════════════════ */
body.liq #liq-wrap {
  background: rgba(6, 4, 18, 0.20);
  position: relative;
  isolation: isolate;
}

/* ══════════════════════════════════════════════════════════════
   LAYER 2 — ЯДЕРНЫЙ СБРОС: весь текст белый, все фоны прозрачные
   Одно правило убивает все конфликты — чёрный на чёрном невозможен.
   ══════════════════════════════════════════════════════════════ */

/* Все тексты → белые */
body.liq #liq-wrap * {
  color: rgba(255,255,255,0.93) !important;
}
/* Тень только на текстовых нодах — иконки и img не трогать */
body.liq #liq-wrap p,
body.liq #liq-wrap h1,
body.liq #liq-wrap h2,
body.liq #liq-wrap h3,
body.liq #liq-wrap h4,
body.liq #liq-wrap li,
body.liq #liq-wrap span:not([class*="bi"]),
body.liq #liq-wrap a:not([class*="rounded-full"]),
body.liq #liq-wrap label,
body.liq #liq-wrap td,
body.liq #liq-wrap th {
  text-shadow: 0 1px 8px rgba(0,0,0,0.65);
}

/* Все фоны → прозрачные (кроме img/video) */
body.liq #liq-wrap *:not(img):not(video):not(iframe):not(canvas):not(svg) {
  background-color: transparent !important;
}

/* Бордеры → едва видимые стеклянные */
body.liq #liq-wrap *:not(img):not(video) {
  border-color: rgba(255,255,255,0.10) !important;
}

/* ══════════════════════════════════════════════════════════════
   LAYER 3 — ВОССТАНОВЛЕНИЕ: то, что должно выглядеть иначе
   ══════════════════════════════════════════════════════════════ */

/* ── Хедер: glass panel ── */
body.liq header {
  background: rgba(6,8,20,0.68) !important;
  backdrop-filter: blur(40px) saturate(220%) brightness(115%) !important;
  -webkit-backdrop-filter: blur(40px) saturate(220%) brightness(115%) !important;
  border-bottom: 1px solid rgba(255,255,255,0.12) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.09), 0 8px 32px rgba(0,0,0,0.45) !important;
}

/* ── Навигация: стеклянные пилюли ── */
body.liq header nav a {
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.14) !important;
  border-radius: 100px !important;
  backdrop-filter: blur(12px) !important;
  padding: 6px 14px !important;
  transition: all 200ms ease !important;
}
body.liq header nav a:hover {
  background: rgba(255,255,255,0.15) !important;
  border-color: rgba(255,255,255,0.24) !important;
  transform: translateY(-1px) !important;
}

/* ── Оранжевые CTA кнопки: восстанавливаем цвет + glow ── */
body.liq .bg-orange-500,
body.liq [class*="bg-\[#f97316\]"],
body.liq [class*="bg-\[#ec7c00\]"],
body.liq button[class*="orange"],
body.liq a[class*="bg-orange"] {
  background-color: #f97316 !important;
  color: white !important;
  box-shadow:
    0 0 0 1px rgba(249,115,22,0.50),
    0 6px 32px rgba(249,115,22,0.42),
    0 0 80px rgba(236,72,153,0.18),
    inset 0 1px 0 rgba(255,255,255,0.20) !important;
}

/* ── Зелёные / синие бейджи: восстанавливаем ── */
body.liq [class*="bg-green-"],
body.liq [class*="bg-emerald-"] {
  background-color: rgba(16,185,129,0.28) !important;
  border: 1px solid rgba(52,211,153,0.45) !important;
}
body.liq [class*="bg-blue-"],
body.liq [class*="bg-sky-"],
body.liq [class*="bg-\[#1e40af\]"],
body.liq [class*="bg-\[#1d4ed8\]"] {
  background-color: rgba(29,78,216,0.32) !important;
  border: 1px solid rgba(96,165,250,0.48) !important;
}

/* ── Glass карточки: видны на ярком градиенте ── */
/* На светлом фоне rgba(255,255,255,0.12) создаёт матовый эффект */
body.liq #liq-wrap [class*="rounded-xl"],
body.liq #liq-wrap [class*="rounded-2xl"],
body.liq #liq-wrap [class*="rounded-3xl"] {
  background: rgba(255,255,255,0.10) !important;
  border: 1px solid rgba(255,255,255,0.20) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.22),
    0 4px 32px rgba(0,0,0,0.22),
    0 1px 0 rgba(255,255,255,0.08) !important;
  backdrop-filter: blur(22px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(180%) !important;
}

/* Крупные блоки с rounded-lg тоже стекло */
body.liq #faq     > * [class*="rounded-lg"],
body.liq #reviews > * [class*="rounded-lg"],
body.liq #team    > * [class*="rounded-lg"],
body.liq #contacts > * [class*="rounded-lg"],
body.liq #shifts  > * [class*="rounded-lg"] {
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.16) !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
}

/* ── Футер: тонкое стекло ── */
body.liq footer {
  background: rgba(4,4,16,0.78) !important;
  border-top: 1px solid rgba(255,255,255,0.08) !important;
}

/* ── Booking bar: glass strip ── */
body.liq [id*="after-"] {
  background: rgba(10,8,28,0.72) !important;
  backdrop-filter: blur(24px) !important;
  -webkit-backdrop-filter: blur(24px) !important;
  border-top: 1px solid rgba(255,255,255,0.09) !important;
  border-bottom: 1px solid rgba(255,255,255,0.09) !important;
}

/* ── Инпуты и чекбоксы: видимые на тёмном ── */
body.liq input[type="tel"],
body.liq input[type="text"],
body.liq input[type="email"] {
  background: rgba(255,255,255,0.10) !important;
  border: 1px solid rgba(255,255,255,0.22) !important;
  color: white !important;
}
body.liq input::placeholder { color: rgba(255,255,255,0.45) !important; }

/* ── Иконки: чуть ярче на тёмном ── */
body.liq [class*="bi-"],
body.liq [class*="bi "] {
  opacity: 1 !important;
  filter: brightness(1.3) !important;
}

/* ── FAQ аккордеон: явная граница ── */
body.liq details,
body.liq summary {
  background: rgba(255,255,255,0.06) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  border-radius: 12px !important;
  padding: 16px 20px !important;
}

/* ── Свечение заголовков ── */
body.liq h1:not([class*="hero"]),
body.liq h2 {
  text-shadow: 0 0 40px rgba(139,92,246,0.35), 0 0 80px rgba(236,72,153,0.18);
}

/* ── Gallery & Videos: явный override для bg-[#f7f5f2] и bg-white ── */
body.liq #gallery > div,
body.liq #videos  > div,
body.liq #gallery [class*="bg-\[#f7"],
body.liq #gallery [class*="bg-white"],
body.liq #videos  [class*="bg-white"],
body.liq #videos  [class*="bg-slate"],
body.liq [class*="bg-\[#f7f5f2\]"] {
  background-color: rgba(255,255,255,0.05) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
}
/* Filter badges в Videos/Gallery */
body.liq [class*="bg-slate-100"],
body.liq [class*="bg-\[#fff2e3\]"] {
  background-color: rgba(255,255,255,0.10) !important;
  color: rgba(255,255,255,0.85) !important;
}

/* ── Micro-interactions ── */
body.liq a, body.liq button {
  transition: transform 180ms ease, box-shadow 180ms ease,
              background 180ms ease, border-color 180ms ease,
              opacity 180ms ease !important;
}
body.liq a:not(header a):hover,
body.liq button:not(#liq-sw button):hover {
  transform: translateY(-1px) !important;
}
</style>

<script>
  function liqMovePill(btn: HTMLButtonElement) {
    const pill = document.getElementById('liq-pill') as HTMLDivElement;
    const sw   = document.getElementById('liq-sw')   as HTMLDivElement;
    if (!pill || !sw) return;
    const sr = sw.getBoundingClientRect();
    const br = btn.getBoundingClientRect();
    pill.style.left  = (br.left - sr.left - 4) + 'px';
    pill.style.width = br.width + 'px';
  }

  function liqSetTheme(t: string) {
    const on = t === 'liquid';
    document.body.classList.toggle('liq', on);

    const bCur = document.getElementById('btn-cur') as HTMLButtonElement;
    const bLiq = document.getElementById('btn-liq') as HTMLButtonElement;
    if (!bCur || !bLiq) return;
    bCur.setAttribute('aria-pressed', String(!on));
    bLiq.setAttribute('aria-pressed', String(on));
    liqMovePill(on ? bLiq : bCur);
    try { localStorage.setItem('aidacamp-liq', t); } catch {}
  }

  function liqInit() {
    const bCur = document.getElementById('btn-cur') as HTMLButtonElement;
    if (bCur) liqMovePill(bCur);
    let saved = 'current';
    try { saved = localStorage.getItem('aidacamp-liq') || 'current'; } catch {}
    liqSetTheme(saved);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', liqInit);
  else liqInit();

  (window as any).liqSetTheme = liqSetTheme;
</script>
