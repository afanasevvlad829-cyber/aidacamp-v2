---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import MomStory from '../../components/MomStory.astro';
import About from '../../components/About.astro';
import Shifts from '../../components/Shifts.astro';
import Gallery from '../../components/Gallery.astro';
import Videos from '../../components/Videos.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import Team from '../../components/Team.astro';
import Mentors from '../../components/Mentors.astro';
import Stay from '../../components/Stay.astro';
import Journey from '../../components/Journey.astro';
import Economy from '../../components/Economy.astro';
import Hackathon from '../../components/Hackathon.astro';
import BookingBar from '../../components/BookingBar.astro';
import SoftStart from '../../components/SoftStart.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import ShiftModal from '../../components/ShiftModal.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import SeoTextBlock from '../../components/SeoTextBlock.astro';
import ShiftOccupancy from '../../components/ShiftOccupancy.astro';
import SummerCta from '../../components/SummerCta.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../../data/landing-pages';
---

<Base
  title="[Демо] Liquid Glass — АйДаКемп"
  description=""
  heroPreloadMobile="/images/hero-mobile.avif"
  heroPreloadDesktop="/images/hero-desktop.avif"
  noindex
>
  <Fragment slot="head">
    <SchemaOrg />
  </Fragment>

  <!-- ══ Floating switcher ══ -->
  <div id="liq-switcher" role="group" aria-label="Переключатель темы">
    <button id="btn-current" onclick="setTheme('current')" aria-pressed="true">
      Текущий
    </button>
    <button id="btn-liquid" onclick="setTheme('liquid')" aria-pressed="false">
      ✦ Liquid Glass
    </button>
    <div id="liq-pill" aria-hidden="true"></div>
  </div>

  <!-- ══ Полный сайт ══ -->
  <div id="liq-site">
    <Header />
    <main class="pb-20 md:pb-0">
      <Hero hasVariants={true} />

      <div class="md:hidden flex px-5 py-3">
        <div class="rotate-[-10deg] relative flex h-[96px] w-[96px] items-center justify-center rounded-full border-[2.5px] border-dashed border-[#0d1a2b]/55">
          <div class="absolute inset-[7px] rounded-full border border-[#0d1a2b]/18"></div>
          <div class="flex flex-col items-center gap-0 px-2 text-center">
            <i class="bi bi-laptop text-[20px] leading-none text-[#0d1a2b]" aria-hidden="true"></i>
            <span class="mt-0.5 text-[7.5px] font-black uppercase tracking-[0.14em] text-[#0d1a2b] leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-[#0d1a2b]/30"></div>
            <span class="mt-0.5 text-[6.5px] font-semibold uppercase tracking-[0.09em] text-[#0d1a2b]/55 leading-[1.4]">у нас всё есть!</span>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
        <div class="flex flex-col gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
          <ShiftOccupancy />
          <MomStory compact />
        </div>
      </div>
      <About />
      <Journey />
      <Economy />
      <BookingBar id="after-economy" headline="Один звонок — ответим на всё и не будем беспокоить" />
      <SoftStart />
      <Shifts />
      <BookingBar id="after-shifts" headline="Выбрали смену? Забронируем за 10 минут" />
      <SummerCta />
      <Hackathon />
      <Gallery />
      <Videos />
      <Reviews />
      <FAQ />
      <Team />
      <Mentors />
      <Stay />
      <Contacts />
      <SeoTextBlock />
      <RelatedPages pages={allLandingPages} />
    </main>
    <Footer />
  </div>

  <ShiftModal />
</Base>

<style is:global>
/* ══════════════════════════════════════════════════════════
   SWITCHER
   ══════════════════════════════════════════════════════════ */
#liq-switcher {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 4px;
  border-radius: 100px;
  background: rgba(6, 10, 18, 0.90);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.13);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.60), inset 0 1px 0 rgba(255,255,255,0.07);
}

#liq-switcher button {
  position: relative;
  z-index: 1;
  padding: 8px 22px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.40);
  background: transparent;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color 250ms ease;
}

#liq-switcher button[aria-pressed="true"] {
  color: rgba(255, 255, 255, 0.92);
}

/* Sliding background pill */
#liq-pill {
  position: absolute;
  top: 4px;
  left: 4px;
  height: calc(100% - 8px);
  border-radius: 100px;
  background: rgba(255, 255, 255, 0.09);
  border: 1px solid rgba(255, 255, 255, 0.10);
  transition: left 280ms cubic-bezier(0.34, 1.26, 0.64, 1),
              width 280ms cubic-bezier(0.34, 1.26, 0.64, 1),
              background 300ms ease,
              border-color 300ms ease;
  pointer-events: none;
}

body.liq #liq-pill {
  background: linear-gradient(135deg, rgba(236,72,153,0.35), rgba(139,92,246,0.30));
  border-color: rgba(236, 72, 153, 0.35);
}

/* ══════════════════════════════════════════════════════════
   IRIDESCENT BODY BACKGROUND
   Gradient is set directly on body — sections composite
   their semi-transparent backgrounds directly against it.
   This is the ONLY approach that reliably works everywhere.
   ══════════════════════════════════════════════════════════ */
body.liq {
  background:
    /* pink→purple orb — top-left */
    radial-gradient(ellipse 70% 55% at 14% 20%,
      rgba(236, 72, 153, 0.85) 0%,
      rgba(139, 92, 246, 0.65) 40%,
      transparent 68%),
    /* cyan→purple orb — bottom-right */
    radial-gradient(ellipse 65% 55% at 86% 80%,
      rgba(6, 182, 212, 0.80) 0%,
      rgba(139, 92, 246, 0.55) 42%,
      transparent 68%),
    /* purple orb — top-right */
    radial-gradient(ellipse 48% 42% at 82% 14%,
      rgba(139, 92, 246, 0.70) 0%,
      rgba(79, 70, 229, 0.45) 45%,
      transparent 65%),
    /* orange accent — bottom-left */
    radial-gradient(ellipse 45% 38% at 16% 84%,
      rgba(249, 115, 22, 0.55) 0%,
      rgba(236, 72, 153, 0.35) 45%,
      transparent 65%),
    /* cyan accent — center-top */
    radial-gradient(ellipse 38% 32% at 52% 42%,
      rgba(6, 182, 212, 0.35) 0%,
      transparent 62%),
    /* base — deep navy */
    linear-gradient(160deg, #120e24 0%, #0f1a3a 30%, #0a2050 55%, #14103a 100%);
  background-attachment: fixed;
  animation: liq-breathe 6s ease-in-out infinite;
}

@keyframes liq-breathe {
  0%, 100% { filter: brightness(1.00) saturate(1.00); }
  33%       { filter: brightness(1.18) saturate(1.25); }
  66%       { filter: brightness(0.93) saturate(0.92); }
}

/* ══════════════════════════════════════════════════════════
   LIQUID GLASS THEME — FULL SITE OVERRIDES
   ══════════════════════════════════════════════════════════ */

/* ── ALL dark sections → semi-transparent so gradient shows ── */
/* 50% opacity → 50% gradient bleeds through */
body.liq .liq-dark {
  background: rgba(8, 6, 24, 0.50) !important;
}

/* ── White/light divs → near-transparent glass ── */
/* This lets the body gradient show through white cards/sections */
body.liq [class*="bg-white"],
body.liq [class*="bg-gray-50"],
body.liq [class*="bg-gray-100"],
body.liq [class*="bg-slate-50"],
body.liq [class*="bg-slate-100"],
body.liq [class*="bg-neutral-50"],
body.liq [class*="bg-neutral-100"] {
  background: rgba(255, 255, 255, 0.06) !important;
  backdrop-filter: blur(14px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(160%) !important;
  border-color: rgba(255, 255, 255, 0.14) !important;
}

/* ── Light section wrappers → dark glass ── */
/* Sections without explicit bg class (transparent → body gradient shows) */
body.liq section {
  background-color: transparent !important;
}

/* ── Text in now-dark light sections → white ── */
body.liq [class*="bg-white"] *,
body.liq [class*="bg-gray-50"] *,
body.liq [class*="bg-gray-100"] * {
  color: rgba(255, 255, 255, 0.90) !important;
}
/* Restore orange accent colors */
body.liq [class*="text-orange"],
body.liq [class*="text-primary"],
body.liq [class*="text-\[#f97"] {
  color: #fb923c !important;
}
/* Restore image alt colors */
body.liq img { filter: brightness(0.92) saturate(1.05); }

/* ── HEADER ── glass */
body.liq header {
  background: rgba(6, 8, 22, 0.72) !important;
  backdrop-filter: blur(36px) saturate(200%) brightness(112%) !important;
  -webkit-backdrop-filter: blur(36px) saturate(200%) brightness(112%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.09),
    0 8px 32px rgba(0, 0, 0, 0.50) !important;
}

/* ── NAV LINKS ── glass pills */
body.liq header nav a {
  background: rgba(255, 255, 255, 0.07) !important;
  border: 1px solid rgba(255, 255, 255, 0.14) !important;
  border-radius: 100px !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  transition: all 200ms ease !important;
}
body.liq header nav a:hover {
  background: rgba(255, 255, 255, 0.14) !important;
  border-color: rgba(255, 255, 255, 0.24) !important;
  transform: translateY(-1px) !important;
}

/* ── CARDS in dark sections ── glass effect */
body.liq .liq-dark [class*="rounded"],
body.liq [class*="bg-[#060a12]"] [class*="rounded"],
body.liq [class*="bg-[#0d1a2b]"] [class*="rounded"],
body.liq #faq      [class*="rounded"],
body.liq #reviews  [class*="rounded"],
body.liq #team     [class*="rounded"],
body.liq #contacts [class*="rounded"],
body.liq #economy  [class*="rounded"],
body.liq #journey  [class*="rounded"],
body.liq #softstart [class*="rounded"],
body.liq #hackathon [class*="rounded"],
body.liq #shifts   [class*="rounded"] {
  background: linear-gradient(
    148deg,
    rgba(255, 255, 255, 0.10) 0%,
    rgba(255, 255, 255, 0.04) 100%
  ) !important;
  border-color: rgba(255, 255, 255, 0.15) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.13),
    0 4px 24px rgba(0, 0, 0, 0.28) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
}

/* ── ORANGE CTA BUTTONS ── warm glow */
body.liq .bg-orange-500,
body.liq [class*="bg-\[#f97316\]"],
body.liq [class*="bg-\[#ec7c00\]"],
body.liq [class*="bg-primary"] {
  box-shadow:
    0 0 0 1px rgba(249, 115, 22, 0.45),
    0 6px 32px rgba(249, 115, 22, 0.40),
    0 0 60px rgba(236, 72, 153, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.18) !important;
}

/* ── WCAG: muted text → readable ── */
body.liq [class*="text-white/50"],
body.liq [class*="text-white/45"],
body.liq [class*="text-white/35"],
body.liq [class*="text-white/30"] {
  color: rgba(255, 255, 255, 0.72) !important;
}

/* ── BOOKING BAR ── glass */
body.liq [id*="after-"] {
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
}

/* ── TRUST BADGES ── iridescent blue */
body.liq a[href*="licenziya"],
body.liq a[href*="medsestra"],
body.liq a[href*="strahovka"] {
  background: rgba(79, 70, 229, 0.35) !important;
  border: 1px solid rgba(139, 92, 246, 0.55) !important;
  color: #c4b5fd !important;
}

/* ── MICRO-INTERACTIONS ── */
body.liq a,
body.liq button {
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    background 180ms ease,
    border-color 180ms ease !important;
}
body.liq a:not(header a):hover,
body.liq button:not(#liq-switcher button):hover {
  transform: translateY(-1px) !important;
}

/* ── FOOTER ── glass */
body.liq footer {
  background: rgba(4, 6, 18, 0.85) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
}
</style>

<script>
  // ── Tag dark elements for glass effect ──
  function tagDarkElements() {
    const sel = 'section, header, footer, [class*="bg-[#06"], [class*="bg-[#0d"], main > div > div';
    document.querySelectorAll(sel).forEach((el) => {
      const bg = window.getComputedStyle(el as Element).backgroundColor;
      const m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (m) {
        const lum = 0.299 * +m[1] + 0.587 * +m[2] + 0.114 * +m[3];
        if (lum < 45) (el as HTMLElement).classList.add('liq-dark');
      }
    });
  }

  function untagDarkElements() {
    document.querySelectorAll('.liq-dark').forEach((el) => el.classList.remove('liq-dark'));
  }

  // ── Sliding pill ──
  function movePill(activeBtn: HTMLButtonElement) {
    const pill     = document.getElementById('liq-pill')     as HTMLDivElement;
    const switcher = document.getElementById('liq-switcher') as HTMLDivElement;
    if (!pill || !switcher) return;
    const sr = switcher.getBoundingClientRect();
    const br = activeBtn.getBoundingClientRect();
    pill.style.left  = (br.left - sr.left - 4) + 'px';
    pill.style.width = br.width + 'px';
  }

  function setTheme(theme: string) {
    const isLiq = theme === 'liquid';

    if (isLiq) {
      tagDarkElements();
      document.body.classList.add('liq');
    } else {
      document.body.classList.remove('liq');
      setTimeout(untagDarkElements, 520);
    }

    const btnCurrent = document.getElementById('btn-current') as HTMLButtonElement;
    const btnLiquid  = document.getElementById('btn-liquid')  as HTMLButtonElement;
    if (!btnCurrent || !btnLiquid) return;
    btnCurrent.setAttribute('aria-pressed', String(!isLiq));
    btnLiquid.setAttribute('aria-pressed', String(isLiq));
    movePill(isLiq ? btnLiquid : btnCurrent);

    try { localStorage.setItem('aidacamp-demo-liquid', theme); } catch {}
  }

  function init() {
    // Position pill on "Текущий" initially
    const btnCurrent = document.getElementById('btn-current') as HTMLButtonElement;
    if (btnCurrent) movePill(btnCurrent);

    let saved = 'current';
    try { saved = localStorage.getItem('aidacamp-demo-liquid') || 'current'; } catch {}
    setTheme(saved);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  (window as any).setTheme = setTheme;
</script>
