---
// HyperUI-based Component Library — АйДаКемп Design Document
// Branch: design/glassmorphism-v1
// Purpose: Визуальный словарь компонентов сайта, основанный на паттернах HyperUI
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>АйДаКемп — Компонентная база (HyperUI)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            primary:     '#ec7c00',
            'primary-h': '#d46e00',
            'primary-l': '#f59332',
            'primary-s': '#fff1df',
            'primary-m': 'rgba(236,124,0,0.12)',
            blue:        '#1b4fd8',
            'blue-l':    '#3b82f6',
            'blue-s':    '#eff6ff',
            navy:        '#0d1a2b',
            surface:     '#f7f8fb',
            'surface-alt':'#f0f4ff',
            'surface-warm':'#f7f5f2',
            tx:          '#1e2430',
            'tx-m':      '#4b5263',
            'tx-f':      '#6b7280',
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f7f8fb; color: #1e2430; }

    /* ── Glass Utilities ── */
    .glass-surface {
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
    }
    .glass-dark {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(12px) saturate(200%);
      -webkit-backdrop-filter: blur(12px) saturate(200%);
    }
    .glass-border::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.1) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* ── Section Headers ── */
    .section { padding: 56px 0; border-bottom: 1px solid #e5e7eb; }
    .section-label {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: #6b7280;
      background: #f0f4ff; border: 1px solid #dbeafe;
      border-radius: 100px; padding: 4px 12px; margin-bottom: 16px;
    }
    .section-title { font-size: 28px; font-weight: 800; color: #1e2430; margin-bottom: 8px; }
    .section-desc { font-size: 16px; color: #4b5263; margin-bottom: 40px; max-width: 640px; }
    .component-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: #9ca3af; margin-bottom: 12px;
    }
    .component-code {
      font-size: 12px; font-family: monospace; background: #1e2430;
      color: #86efac; padding: 12px 16px; border-radius: 8px;
      margin-top: 12px; overflow-x: auto; white-space: pre;
    }
    .row { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
    .col { flex: 1; min-width: 280px; }

    /* ── Comparison Cards ── */
    .diff-bad  { border-left: 3px solid #ef4444; background: #fef2f2; border-radius: 0 8px 8px 0; padding: 12px 16px; }
    .diff-good { border-left: 3px solid #10b981; background: #f0fdf4; border-radius: 0 8px 8px 0; padding: 12px 16px; }
    .diff-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════ -->
<!-- ШАПКА                                                  -->
<!-- ══════════════════════════════════════════════════════ -->
<header style="background:#0d1a2b; padding: 32px 24px; margin-bottom: 0;">
  <div style="max-width:1200px; margin:auto;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <div style="color:#f59332; font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:8px;">
          АйДаКемп · design/glassmorphism-v1
        </div>
        <h1 style="color:white; font-size:32px; font-weight:800; margin:0 0 8px;">Компонентная база</h1>
        <p style="color:#94a3b8; font-size:16px; margin:0;">
          HyperUI паттерны → Astro компоненты сайта. Правила цветов, кнопок, карточек, форм.
        </p>
      </div>
      <div style="text-align:right; color:#64748b; font-size:13px;">
        <div>2026-04-29</div>
        <div style="margin-top:4px;">65 компонентов</div>
        <div style="margin-top:4px; color:#f59332;">Ветка: design/glassmorphism-v1</div>
      </div>
    </div>

    <!-- Component Index -->
    <div style="margin-top:32px; display:flex; flex-wrap:wrap; gap:8px;">
      {['Карта компонентов','Цвета и токены','Кнопки','Типографика','Формы','Карточки (Shifts)','Badges & Pills','Навигация','Секции','Модалки','Glass-эффекты','Do / Don\'t'].map((name, i) => (
        <a href={`#section-${i+1}`}
           style="background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15);
                  color:#94a3b8; font-size:12px; font-weight:500; padding:6px 12px;
                  border-radius:6px; text-decoration:none; transition:all 0.15s;">
          {i+1}. {name}
        </a>
      ))}
    </div>
  </div>
</header>

<main style="max-width:1200px; margin:0 auto; padding: 0 24px 80px;">

<!-- ══════════════════════════════════════════════════════ -->
<!-- 1. КАРТА КОМПОНЕНТОВ                                   -->
<!-- ══════════════════════════════════════════════════════ -->
<div class="section" id="section-1">
  <span class="section-label">01</span>
  <h2 class="section-title">Карта компонентов сайта</h2>
  <p class="section-desc">65 Astro компонентов, разбитых по зонам влияния на конверсию</p>

  <div class="row">
    <!-- Tier 1: Конверсионные -->
    <div class="col" style="min-width:340px; max-width:420px;">
      <div style="background:#fff1df; border:1.5px solid #fbbf24; border-radius:16px; padding:20px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
          <div style="width:8px;height:8px;border-radius:50%;background:#ec7c00;"></div>
          <span style="font-size:12px;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:0.08em;">Tier 1 — Конверсия (критично)</span>
        </div>
        {[
          ['hero/Mobile.astro', 'Главный экран мобиль — фото + CTA + метрики'],
          ['hero/Desktop.astro', 'Главный экран десктоп — плашка с ценой'],
          ['hero/DesktopTrust.astro', 'Trust badges под кнопкой десктоп'],
          ['shifts/ShiftCard.astro', 'Карточка смены с ценой и кнопкой «Выбрать»'],
          ['Shifts.astro', 'Контейнер с горизонтальным скроллом смен'],
          ['LeadForm.astro', 'Форма захвата лида (возраст + телефон)'],
          ['StickyCta.astro', 'Липкая кнопка снизу мобильного экрана'],
          ['SummerCta.astro', 'CTA-блок «Записаться» с формой'],
          ['HeroModals.astro', 'Попапы с деталями смен'],
        ].map(([name, desc]) => (
          <div style="display:flex; gap:10px; margin-bottom:10px; align-items:flex-start;">
            <div style="width:6px;height:6px;border-radius:50%;background:#ec7c00;margin-top:6px;flex-shrink:0;"></div>
            <div>
              <div style="font-size:13px;font-weight:600;color:#1e2430;font-family:monospace;">{name}</div>
              <div style="font-size:12px;color:#6b7280;margin-top:2px;">{desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tier 2: Доверие -->
    <div class="col" style="min-width:340px; max-width:420px;">
      <div style="background:#eff6ff; border:1.5px solid #bfdbfe; border-radius:16px; padding:20px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
          <div style="width:8px;height:8px;border-radius:50%;background:#1b4fd8;"></div>
          <span style="font-size:12px;font-weight:700;color:#1e40af;text-transform:uppercase;letter-spacing:0.08em;">Tier 2 — Доверие (важно)</span>
        </div>
        {[
          ['Reviews.astro', 'Отзывы с Яндекс.Карт 5.0'],
          ['Mentors.astro', 'Преподаватели / Команда'],
          ['Team.astro', 'Расширенная команда'],
          ['About.astro', 'О лагере — история, Дарья'],
          ['Hackathon.astro', 'Блок про хакатон и дипломы'],
          ['Stay.astro', 'Условия проживания'],
          ['Gallery.astro', 'Фотогалерея'],
          ['Videos.astro', 'Видео'],
          ['Economy.astro', 'Налоговый вычет / Экономика'],
          ['Journey.astro', 'День в лагере по часам'],
          ['MomStory.astro', 'История мамы / кейс'],
          ['Contacts.astro', 'Контакты, карта'],
        ].map(([name, desc]) => (
          <div style="display:flex; gap:10px; margin-bottom:10px; align-items:flex-start;">
            <div style="width:6px;height:6px;border-radius:50%;background:#1b4fd8;margin-top:6px;flex-shrink:0;"></div>
            <div>
              <div style="font-size:13px;font-weight:600;color:#1e2430;font-family:monospace;">{name}</div>
              <div style="font-size:12px;color:#6b7280;margin-top:2px;">{desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tier 3: SEO / Утилиты -->
    <div class="col" style="min-width:300px; max-width:380px;">
      <div style="background:#f7f8fb; border:1.5px solid #e5e7eb; border-radius:16px; padding:20px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
          <div style="width:8px;height:8px;border-radius:50%;background:#6b7280;"></div>
          <span style="font-size:12px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:0.08em;">Tier 3 — SEO & Утилиты</span>
        </div>
        {[
          ['SeoTextBlock.astro', 'SEO-текст с внутренними ссылками'],
          ['FAQ.astro', 'Аккордеон часто задаваемых вопросов'],
          ['SchemaOrg.astro', 'JSON-LD структурированные данные'],
          ['FAQSchema.astro', 'Schema.org для FAQ'],
          ['CourseSchema.astro', 'Schema.org для курсов'],
          ['Header.astro', 'Хедер с навигацией'],
          ['Footer.astro', 'Футер с ссылками'],
          ['MobileMenu.astro', 'Мобильное меню'],
          ['PhoneDropdown.astro', 'Дропдаун с номером телефона'],
          ['BrandName.astro', 'Логотип / название бренда'],
          ['BookingBar.astro', 'Полоса бронирования'],
          ['StatCallout.astro', 'Статистика-выноска'],
          ['AgeBar.astro', 'Возрастная шкала'],
          ['BlogCTA.astro', 'CTA в конце статьи блога'],
          ['RelatedArticles.astro', 'Похожие статьи'],
        ].map(([name, desc]) => (
          <div style="display:flex; gap:10px; margin-bottom:8px; align-items:flex-start;">
            <div style="width:6px;height:6px;border-radius:50%;background:#9ca3af;margin-top:5px;flex-shrink:0;"></div>
            <div>
              <div style="font-size:12px;font-weight:600;color:#374151;font-family:monospace;">{name}</div>
              <div style="font-size:11px;color:#9ca3af;margin-top:1px;">{desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════════════════════ -->
<!-- 2. ЦВЕТА И ТОКЕНЫ                                      -->
<!-- ══════════════════════════════════════════════════════ -->
<div class="section" id="section-2">
  <span class="section-label">02</span>
  <h2 class="section-title">Цвета и токены</h2>
  <p class="section-desc">Единственный источник правды — <code>src/styles/global.css → @theme {}</code>. Никаких hex в компонентах.</p>

  <div class="row" style="margin-bottom:32px;">
    <!-- BRAND ORANGE -->
    <div class="col" style="min-width:280px;">
      <div class="component-label">Brand Orange</div>
      {[
        ['#ec7c00','bg-primary','Основная кнопка CTA, акценты','100%'],
        ['#d46e00','bg-primary-hover','Hover состояние кнопок','80%'],
        ['#f59332','bg-primary-light','Иконки, подчёркивания','60%'],
        ['#fff1df','bg-primary-soft','Мягкий фон, бейджи','40%'],
        ['rgba(236,124,0,0.12)','bg-primary-muted','Ghost-элементы','20%'],
      ].map(([hex, token, use, opacity]) => (
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
          <div style={`width:48px; height:48px; border-radius:10px; background:${hex}; flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,0.1);`}></div>
          <div style="flex:1; min-width:0;">
            <div style="font-size:13px;font-weight:600;color:#1e2430;">{token}</div>
            <div style="font-size:11px;color:#6b7280;margin-top:1px;">{hex}</div>
            <div style="font-size:11px;color:#9ca3af;">{use}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- BRAND BLUE -->
    <div class="col" style="min-width:280px;">
      <div class="component-label">Brand Blue</div>
      {[
        ['#1b4fd8','text-blue','Ссылки, трастовые бейджи','100%'],
        ['#3b82f6','text-blue-l','Акценты, иконки','70%'],
        ['#eff6ff','bg-blue-s','Фон секции Shifts, FAQ','40%'],
        ['#0d1a2b','bg-navy','Hero фон, overlay','—'],
      ].map(([hex, token, use]) => (
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
          <div style={`width:48px; height:48px; border-radius:10px; background:${hex}; flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,0.1);`}></div>
          <div>
            <div style="font-size:13px;font-weight:600;color:#1e2430;">{token}</div>
            <div style="font-size:11px;color:#6b7280;">{hex}</div>
            <div style="font-size:11px;color:#9ca3af;">{use}</div>
          </div>
        </div>
      ))}

      <div class="component-label" style="margin-top:24px;">Surfaces</div>
      {[
        ['#ffffff','bg-white','Карточки'],
        ['#f7f8fb','bg-surface','Фон страницы'],
        ['#f0f4ff','bg-surface-alt','Голубой фон (FAQ, Reviews)'],
        ['#f7f5f2','bg-surface-warm','Тёплый (About, цитата Дарьи)'],
      ].map(([hex, token, use]) => (
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
          <div style={`width:48px; height:48px; border-radius:10px; background:${hex}; flex-shrink:0; border:1px solid #e5e7eb;`}></div>
          <div>
            <div style="font-size:13px;font-weight:600;color:#1e2430;">{token}</div>
            <div style="font-size:11px;color:#6b7280;">{hex} — {use}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- ПРОБЛЕМА: 7 оранжевых -->
    <div class="col" style="min-width:280px;">
      <div class="component-label" style="color:#ef4444;">Проблема: 7 вариантов оранжевого в коде</div>
      <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:16px;">
        <div style="font-size:13px; font-weight:600; color:#991b1b; margin-bottom:12px;">Найдено в компонентах сейчас:</div>
        {[
          ['bg-[#ec7c00]','✓ Правильный токен','#166534'],
          ['bg-orange-500','✗ Tailwind-orange','#991b1b'],
          ['bg-orange-600','✗ Tailwind-orange','#991b1b'],
          ['bg-[#ea580c]','✗ Другой hex','#991b1b'],
          ['bg-[#f97316]','✗ Другой hex','#991b1b'],
          ['text-orange-600','✗ Text вариант','#991b1b'],
          ['border-orange-400','✗ Border вариант','#991b1b'],
        ].map(([cls, status, color]) => (
          <div style={`display:flex; justify-content:space-between; padding:6px 8px; border-radius:6px; margin-bottom:4px; background:${color === '#166534' ? '#f0fdf4' : '#fff5f5'};`}>
            <code style="font-size:12px; color:#1e2430;">{cls}</code>
            <span style={`font-size:11px; color:${color}; font-weight:600;`}>{status}</span>
          </div>
        ))}
        <div style="margin-top:12px; font-size:12px; color:#dc2626; font-weight:600;">
          → Заменить ВСЕ на <code>bg-primary</code> / <code>text-primary</code>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════════════════════ -->
<!-- 3. КНОПКИ                                              -->
<!-- ══════════════════════════════════════════════════════ -->
<div class="section" id="section-3">
  <span class="section-label">03</span>
  <h2 class="section-title">Кнопки</h2>
  <p class="section-desc">Текущая оранжевая кнопка «тяжёлая» — слишком насыщенная, текст тёмный на ярком. Вот варианты на основе HyperUI.</p>

  <!-- Текущее состояние -->
  <div class="component-label">Текущий вариант (используется в LeadForm + StickyCta)</div>
  <div class="diff-bad" style="margin-bottom:24px;">
    <div class="diff-label" style="color:#ef4444;">Проблемы</div>
    <div style="font-size:13px; color:#7f1d1d;">
      1. Текст <code>#1e2430</code> (тёмный) на <code>#ec7c00</code> — необычно, большинство ожидают белый<br>
      2. Нет <code>text-white</code> → контраст 4.1:1 (WCAG AA не проходит для нормального текста 16px)<br>
      3. Разные радиусы: LeadForm <code>rounded-[10px]</code>, StickyCta <code>rounded-xl</code> (12px), ShiftCard <code>rounded-xl</code><br>
      4. Разные размеры: h-[48px] vs py-3 — непоследовательно
    </div>
  </div>

  <div class="row">
    <!-- CTA Primary -->
    <div class="col">
      <div class="component-label">CTA Primary — «Написать в бот» / «Выбрать смену»</div>

      <!-- Вариант A — текущий (проблемный) -->
      <div style="margin-bottom:20px;">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;">A — Текущий (темный текст)</div>
        <button style="height:48px; padding:0 24px; background:#ec7c00; color:#1e2430; border-radius:10px; font-size:16px; font-weight:600; border:none; cursor:pointer; width:100%; box-shadow:0 4px 20px rgba(236,124,0,0.38);">
          Выбрать смену
        </button>
        <div style="font-size:11px;color:#ef4444;margin-top:4px;">✗ Контраст 4.1:1 WCAG не проходит</div>
      </div>

      <!-- Вариант B — белый текст -->
      <div style="margin-bottom:20px;">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;">B — Белый текст (HyperUI pattern)</div>
        <button style="height:48px; padding:0 24px; background:#ec7c00; color:white; border-radius:12px; font-size:16px; font-weight:600; border:none; cursor:pointer; width:100%; box-shadow:0 4px 20px rgba(236,124,0,0.38);">
          Выбрать смену
        </button>
        <div style="font-size:11px;color:#10b981;margin-top:4px;">✓ Контраст 5.2:1 WCAG AA</div>
      </div>

      <!-- Вариант C — с иконкой Telegram -->
      <div style="margin-bottom:20px;">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;">C — CTA с иконкой (Mobile Hero)</div>
        <button style="height:52px; padding:0 24px; background:#ec7c00; color:white; border-radius:14px; font-size:17px; font-weight:700; border:none; cursor:pointer; width:100%; box-shadow:0 6px 24px rgba(236,124,0,0.45); display:flex; align-items:center; justify-content:center; gap:10px;">
          <i class="bi bi-telegram" style="font-size:20px;"></i>
          Написать в бот
        </button>
        <div style="font-size:11px;color:#10b981;margin-top:4px;">✓ Для Mobile Hero — главный CTA</div>
      </div>

      <!-- Вариант D — Subtle / outlined -->
      <div style="margin-bottom:20px;">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;">D — Ghost (вторичный)</div>
        <button style="height:44px; padding:0 20px; background:transparent; color:#ec7c00; border:1.5px solid #ec7c00; border-radius:12px; font-size:15px; font-weight:600; cursor:pointer; width:100%;">
          Подробнее
        </button>
      </div>
    </div>

    <!-- Secondary buttons -->
    <div class="col">
      <div class="component-label">Secondary / Utility кнопки (ShiftCard)</div>

