---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

// Demo: 5 cyberpunk/IT-themed эффектов из htmlhub.org
// Идеально под нашу IT-тему (Python/Minecraft/AI/3D)
const blocks = [
  { id: 'synthwave',   src: 'CSS',    use: 'Главная / IT-лагерь · 80s outrun grid + солнце',     src_url: 'envato-synthwave-grid' },
  { id: 'hyperspace',  src: 'CSS',    use: '3D / Blender / Try · warp-speed туннель',              src_url: 'background-2-hyperspace-corridor' },
  { id: 'fiber',       src: 'Canvas', use: 'AI / нейросети · 600 fiber optic частиц туннелем',     src_url: 'cyber-fiber-optics' },
  { id: 'circuit',     src: 'Canvas', use: 'Python / код · электроны на цифровой плате (90°)',      src_url: 'digital-circuit-tracers' },
  { id: 'hexagons',    src: 'Canvas', use: 'Roblox / Minecraft / геймдев · neon hexagonal grid',    src_url: 'neon-hexagon-patterns' },
];
---

<Base title="Hero BG · IT/Cyber эффекты (htmlhub)">
  <Header />
  <div class="bg-amber-100 text-amber-900 text-center text-[13px] py-1.5 border-b border-amber-200">
    <strong>DEMO Cyber:</strong> 5 IT/cyberpunk блоков с htmlhub.org · scoped Canvas с lazy-init
  </div>

  <main class="bg-slate-100">
    {blocks.map((b, i) => (
      <section class="cyb-section">
        <div class="cyb-header">
          <span class="cyb-num">{String(i+1).padStart(2,'0')} · {b.src}</span>
          <h2 class="cyb-name">{b.use}</h2>
          <a class="cyb-src" href={`https://htmlhub.org/library/retro--cyberpunk/${b.src_url}`} target="_blank" rel="noopener">→ оригинал htmlhub.org</a>
        </div>
        <div class={`hero-cyb hero-cyb--${b.id}`} data-cyber={b.id}>
          {b.src === 'Canvas' && <canvas class="cyb-canvas"></canvas>}
          {b.id === 'synthwave' && <>
            <div class="sw-sun"></div>
            <div class="sw-horizon"></div>
            <div class="sw-plane"></div>
            <div class="sw-scanlines"></div>
          </>}
          {b.id === 'hyperspace' && <>
            <div id="hs-stars-container" class="hs-stars"></div>
            <div class="hs-overlay"></div>
          </>}
          <div class="hero-cyb-content">
            <h3 class="hero-cyb-h">Летний IT-лагерь · 2026</h3>
            <p class="hero-cyb-sub">Каждый уезжает с готовым проектом — игрой, ботом, AI-приложением.</p>
            <a href="#" class="hero-cyb-cta">Смены 2026 →</a>
          </div>
        </div>
      </section>
    ))}
  </main>

  <style is:inline>
    .cyb-section { max-width: 1280px; margin: 28px auto; padding: 0 24px; }
    .cyb-header { padding-bottom: 10px; }
    .cyb-num { font-family: ui-monospace, monospace; font-size: 11px; color: #94a3b8; letter-spacing: 0.18em; }
    .cyb-name { margin: 4px 0 2px; font-size: 22px; font-weight: 800; color: #0d1a2b; }
    .cyb-src { font-size: 12px; color: #475569; text-decoration: underline; }
    .hero-cyb {
      position: relative; overflow: hidden; isolation: isolate;
      min-height: 520px; border-radius: 20px;
      display: flex; align-items: center; padding: 56px;
      background: #050510; color: #fff;
      box-shadow: 0 12px 40px rgba(0,0,0,0.25);
    }
    .cyb-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; display: block; }
    .hero-cyb-content { position: relative; z-index: 20; max-width: 560px; }
    .hero-cyb-h { font-size: clamp(30px, 4vw, 46px); font-weight: 800; letter-spacing: -0.025em; line-height: 1.05; margin: 0 0 14px; text-shadow: 0 2px 24px rgba(0,0,0,0.7), 0 0 60px rgba(0,0,0,0.3); }
    .hero-cyb-sub { font-size: 17px; color: rgba(255,255,255,0.9); line-height: 1.5; margin: 0 0 24px; max-width: 480px; text-shadow: 0 1px 8px rgba(0,0,0,0.7); }
    .hero-cyb-cta { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #0a0e1a; padding: 14px 28px; border-radius: 12px; font-weight: 700; font-size: 15px; text-decoration: none; box-shadow: 0 4px 24px rgba(255,255,255,0.2); }

    @media (prefers-reduced-motion: reduce) {
      .hero-cyb *, .hero-cyb::before, .hero-cyb::after { animation: none !important; }
    }

    /* ============================================================
       01 SYNTHWAVE GRID — CSS only, adapted from htmlhub
       ============================================================ */
    .hero-cyb--synthwave {
      background: linear-gradient(to bottom, #110022 0%, #050114 40%);
      perspective: 600px;
    }
    .sw-sun {
      position: absolute; top: 12%; left: 50%; transform: translateX(-50%);
      width: 240px; height: 240px;
      background: linear-gradient(to bottom, #ffea00 0%, #ff0055 60%, transparent 100%);
      border-radius: 50%;
      box-shadow: 0 0 50px #ff0055;
      z-index: 1;
      mask-image: repeating-linear-gradient(180deg,
        #000 0 12px, transparent 12px 14px,
        #000 14px 26px, transparent 26px 30px,
        #000 30px 100%);
    }
    .sw-horizon {
      position: absolute; top: 50%; left: 0; right: 0; height: 40px;
      background: #00ffff; filter: blur(20px); opacity: 0.5; z-index: 2;
    }
    .sw-plane {
      position: absolute; bottom: -50%; left: -50%;
      width: 200%; height: 200%;
      transform-origin: top center;
      transform: rotateX(78deg);
      z-index: 3;
      background-image:
        linear-gradient(to right, #f0f 2px, transparent 2px),
        linear-gradient(to bottom, #f0f 2px, transparent 2px);
      background-size: 60px 60px;
      mask-image: linear-gradient(to bottom, transparent 0%, #000 60%);
      animation: sw-grid-rush 1.6s linear infinite;
    }
    .sw-scanlines {
      position: absolute; inset: 0; z-index: 15; pointer-events: none;
      background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.18) 51%);
      background-size: 100% 4px;
    }
    @keyframes sw-grid-rush { 0% { background-position: 0 0; } 100% { background-position: 0 60px; } }

    /* ============================================================
       02 HYPERSPACE CORRIDOR — CSS only stars + warp
       ============================================================ */
    .hero-cyb--hyperspace {
      background: radial-gradient(circle, #1a082d 0%, #010008 70%);
    }
    .hs-stars { position: absolute; top: 50%; left: 50%; width: 2px; height: 2px; z-index: 1; }
    .hs-stars .hs-star-field { position: absolute; top: 0; left: 0; width: 2px; height: 2px; }
    .hs-stars .hs-star {
      position: absolute; width: 100%; height: 100%;
      background: #fff; border-radius: 50%;
      animation: hs-travel 4s ease-in infinite;
    }
    .hs-stars .hs-star::after {
      content: ''; position: absolute; top: 0; left: 50%;
      transform: translate(-50%, -100%);
      width: 120%; height: 1500%;
      background: linear-gradient(to top, rgba(255,255,255,0.5), transparent);
    }
    @keyframes hs-travel {
      0%   { transform: rotate(var(--ang)) translateY(0) scale(0); opacity: 1; }
      50%  { transform: rotate(var(--ang)) translateY(20vmin) scale(1); opacity: 1; }
      100% { transform: rotate(var(--ang)) translateY(60vmin) scale(0); opacity: 1; }
    }
    .hs-overlay {
      position: absolute; top: 50%; left: 50%;
      width: 70vmin; height: 70vmin;
      transform: translate(-50%, -50%);
      border: 2px solid rgba(0, 225, 255, 0.3);
      border-radius: 50%;
      box-shadow: inset 0 0 20px rgba(0, 225, 255, 0.2);
      animation: hs-pulse 5s ease-in-out infinite alternate;
      z-index: 2;
    }
    @keyframes hs-pulse {
      from { transform: translate(-50%, -50%) scale(0.95); opacity: 0.5; }
      to   { transform: translate(-50%, -50%) scale(1); opacity: 0.85; }
    }
  </style>

  <script is:inline>
    /* HYPERSPACE — заполняем звёздами */
    document.addEventListener('DOMContentLoaded', () => {
      const hsContainer = document.getElementById('hs-stars-container');
      if (hsContainer) {
        for (let i = 0; i < 240; i++) {
          const sf = document.createElement('div'); sf.className = 'hs-star-field';
          sf.style.setProperty('--ang', `${Math.random() * 360}deg`);
          const s = document.createElement('div'); s.className = 'hs-star';
          s.style.animationDelay = `${Math.random() * -4}s`;
          s.style.animationDuration = `${2 + Math.random() * 2}s`;
          sf.appendChild(s); hsContainer.appendChild(sf);
        }
      }

      /* Lazy init for canvas effects */
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && !e.target.dataset.fxInited) {
            e.target.dataset.fxInited = '1';
            const fx = e.target.dataset.cyber;
            const cnv = e.target.querySelector('.cyb-canvas');
            if (!cnv) return;
            if (fx === 'fiber')    initFiber(cnv);
            if (fx === 'circuit')  initCircuit(cnv);
            if (fx === 'hexagons') initHexagons(cnv);
          }
        });
      }, { rootMargin: '300px' });
      document.querySelectorAll('[data-cyber]').forEach(el => observer.observe(el));
    });

    function fitCanvas(cnv) {
      const dpr = window.devicePixelRatio || 1;
      const rect = cnv.parentElement.getBoundingClientRect();
      cnv.width = rect.width * dpr; cnv.height = rect.height * dpr;
      cnv.style.width = rect.width + 'px'; cnv.style.height = rect.height + 'px';
      const ctx = cnv.getContext('2d'); ctx.scale(dpr, dpr);
      return { ctx, w: rect.width, h: rect.height };
    }

    /* ===== CYBER FIBER OPTICS — 600 particles tunnel ===== */
    function initFiber(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      let cx = w / 2, cy = h / 2;
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); cx = w / 2; cy = h / 2; });

      const particles = [];
      function makeP() {
        const angle = Math.random() * Math.PI * 2;
        const radius = Math.random() * (w / 3);
        return {
          z: Math.random() * w,
          x: cx + Math.cos(angle) * radius,
          y: cy + Math.sin(angle) * radius,
          speed: 1 + Math.random() * 3,
          hue: 180 + Math.random() * 50
        };
      }
      for (let i = 0; i < 350; i++) particles.push(makeP());

      function loop() {
        ctx.fillStyle = 'rgba(0,0,0,0.1)'; ctx.fillRect(0, 0, w, h);
        for (const p of particles) {
          p.z -= p.speed;
          if (p.z < 1) Object.assign(p, makeP());
          const scale = w / p.z;
          const x2d = (p.x - cx) * scale + cx;
          const y2d = (p.y - cy) * scale + cy;
          const ps = w / (p.z + p.speed * 10);
          const px2 = (p.x - cx) * ps + cx;
          const py2 = (p.y - cy) * ps + cy;
          ctx.beginPath(); ctx.moveTo(px2, py2); ctx.lineTo(x2d, y2d);
          ctx.lineWidth = scale * 1.5;
          ctx.strokeStyle = `hsla(${p.hue},80%,60%,${0.1 + 0.8 * (1 - p.z/w)})`; ctx.stroke();
        }
        requestAnimationFrame(loop);
      }
      loop();
    }

    /* ===== CIRCUIT TRACERS — electrons on board ===== */
    function initCircuit(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      window.addEventListener('resize', () => { ({ ctx, w, h } = fitCanvas(cnv)); });

      class Tracer {
        constructor() { this.reset(); }
        reset() {
          this.x = Math.random() * w; this.y = Math.random() * h;
          this.speed = 1.5 + Math.random();
          this.angle = Math.floor(Math.random() * 4) * (Math.PI / 2);
          this.life = 0; this.maxLife = 100 + Math.random() * 200;
          this.hue = 200 + Math.random() * 60;
        }
        update() {
          this.x += Math.cos(this.angle) * this.speed;
          this.y += Math.sin(this.angle) * this.speed;
          this.life++;
          if (Math.random() < 0.04) this.angle += (Math.random() < 0.5 ? 1 : -1) * Math.PI / 2;
          if (this.x < 0 || this.x > w || this.y < 0 || this.y > h || this.life > this.maxLife) this.reset();
        }
        draw() {
          ctx.beginPath(); ctx.arc(this.x, this.y, 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${this.hue},90%,75%,1)`; ctx.fill();
        }
      }
      const tracers = []; for (let i = 0; i < 35; i++) tracers.push(new Tracer());
      function loop() {
        ctx.fillStyle = 'rgba(5,5,16,0.05)'; ctx.fillRect(0, 0, w, h);
        for (const t of tracers) { t.update(); t.draw(); }
        requestAnimationFrame(loop);
      }
      loop();
    }

    /* ===== NEON HEXAGONS — adapted from htmlhub ===== */
    function initHexagons(cnv) {
      let { ctx, w, h } = fitCanvas(cnv);
      const opts = {
        len: 18, count: 35, baseTime: 10, addedTime: 10,
        dieChance: 0.05, spawnChance: 1, sparkChance: 0.1,
        sparkDist: 10, sparkSize: 2,
        baseLight: 50, addedLight: 10,
        shadowToTimePropMult: 6,
        baseLightInputMultiplier: 0.01, addedLightInputMultiplier: 0.02,
        repaintAlpha: 0.05, hueChange: 0.1
      };
      let cx = w / 2, cy = h / 2;
      let dieX = w / 2 / opts.len, dieY = h / 2 / opts.len;
      window.addEventListener('resize', () => {
        ({ ctx, w, h } = fitCanvas(cnv)); cx = w/2; cy = h/2;
        dieX = w/2/opts.len; dieY = h/2/opts.len;
      });
      const baseRad = Math.PI * 2 / 6;
      const lines = [];
      let tick = 0;
      ctx.fillStyle = 'black'; ctx.fillRect(0, 0, w, h);

      class Line {
        constructor() { this.reset(); }
        reset() {
          this.x = 0; this.y = 0; this.addedX = 0; this.addedY = 0; this.rad = 0;
          this.lightInputMultiplier = opts.baseLightInputMultiplier + opts.addedLightInputMultiplier * Math.random();
          this.color = `hsl(${tick * opts.hueChange},100%,light%)`;
          this.cumulativeTime = 0;
          this.beginPhase();
        }
        beginPhase() {
          this.x += this.addedX; this.y += this.addedY;
          this.time = 0;
          this.targetTime = (opts.baseTime + opts.addedTime * Math.random()) | 0;
          this.rad += baseRad * (Math.random() < 0.5 ? 1 : -1);
          this.addedX = Math.cos(this.rad); this.addedY = Math.sin(this.rad);
          if (Math.random() < opts.dieChance || this.x > dieX || this.x < -dieX || this.y > dieY || this.y < -dieY) this.reset();
        }
        step() {
          this.time++; this.cumulativeTime++;
          if (this.time >= this.targetTime) this.beginPhase();
          const prop = this.time / this.targetTime;
          const wave = Math.sin(prop * Math.PI / 2);
          const x = this.addedX * wave, y = this.addedY * wave;
          ctx.shadowBlur = prop * opts.shadowToTimePropMult;
          const light = opts.baseLight + opts.addedLight * Math.sin(this.cumulativeTime * this.lightInputMultiplier);
          ctx.fillStyle = ctx.shadowColor = this.color.replace('light', light);
          ctx.fillRect(cx + (this.x + x) * opts.len, cy + (this.y + y) * opts.len, 2, 2);
          if (Math.random() < opts.sparkChance) {
            ctx.fillRect(
              cx + (this.x + x) * opts.len + Math.random() * opts.sparkDist * (Math.random() < 0.5 ? 1 : -1) - opts.sparkSize/2,
              cy + (this.y + y) * opts.len + Math.random() * opts.sparkDist * (Math.random() < 0.5 ? 1 : -1) - opts.sparkSize/2,
              opts.sparkSize, opts.sparkSize
            );
          }
        }
      }
      function loop() {
        requestAnimationFrame(loop); tick++;
        ctx.globalCompositeOperation = 'source-over'; ctx.shadowBlur = 0;
        ctx.fillStyle = `rgba(0,0,0,${opts.repaintAlpha})`;
        ctx.fillRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';
        if (lines.length < opts.count && Math.random() < opts.spawnChance) lines.push(new Line());
        for (const line of lines) line.step();
      }
      loop();
    }
  </script>
</Base>
