---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import fs from 'fs';
import path from 'path';
import { execSync } from 'child_process';

// Сканируем компоненты — какие используют какие токены
function scanComponents() {
  const componentsDir = path.resolve('./src/components');
  const results = [];

  function walk(dir) {
    const items = fs.readdirSync(dir);
    for (const item of items) {
      const full = path.join(dir, item);
      const stat = fs.statSync(full);
      if (stat.isDirectory()) walk(full);
      else if (item.endsWith('.astro')) {
        const text = fs.readFileSync(full, 'utf-8');
        results.push({
          name: full.replace(componentsDir + '/', '').replace('.astro', ''),
          size: text.length,
          // Подсчёт hex (старая палитра ещё есть?)
          hexCount: (text.match(/#[0-9a-fA-F]{6}/g) || []).length,
          // Token usage
          usesPrimary: text.includes('bg-primary') || text.includes('text-primary'),
          usesNavy: text.includes('bg-navy') || text.includes('text-navy') || text.includes('dark-navy'),
          usesOldOrange: text.includes('#ec9b44') || text.includes('#ff8a00') || text.includes('#ef8300'),
          // Anti-patterns
          hasEmoji: /[\u{1F300}-\u{1F9FF}]|[\u{2600}-\u{27BF}]/u.test(text),
          hasBookingBar: text.toLowerCase().includes('bookingbar') || text.toLowerCase().includes('booking-bar'),
          mentionsBot: /\bбот[а-я]?\b/i.test(text),
          // Tokens checklist
          hasGlassCard: text.includes('backdrop-blur'),
        });
      }
    }
  }
  walk(componentsDir);
  return results;
}

const components = scanComponents();

// Stats
const stats = {
  total: components.length,
  withPrimary: components.filter(c => c.usesPrimary).length,
  withOldOrange: components.filter(c => c.usesOldOrange).length,
  withEmoji: components.filter(c => c.hasEmoji).length,
  mentionBot: components.filter(c => c.mentionsBot).length,
  withBookingBar: components.filter(c => c.hasBookingBar).length,
};

// Recent commits with design impact
let recentCommits = [];
try {
  const log = execSync(`git log --pretty=format:'%h|%ad|%s' --date=short -15`, { cwd: path.resolve('.') }).toString();
  recentCommits = log.split('\n').map(line => {
    const [hash, date, ...rest] = line.split('|');
    const subject = rest.join('|');
    const isDesign = /design|hero|color|token|palette|theme|css|button|card|brand|ui|ux/i.test(subject);
    return { hash, date, subject, isDesign };
  });
} catch (e) { recentCommits = []; }
---

<Base title="Design System Progress — Dashboard" noindex>

<style is:inline>
  body { font-family: 'Inter', sans-serif; background: #f8f9fb; margin: 0; color: #1e2430; }
  .container { max-width: 1280px; margin: 0 auto; padding: 24px; }
  header { background: linear-gradient(135deg, #0d1a2b, #1c2740); color: white; padding: 28px 24px; }
  header h1 { font-size: 28px; margin: 0 0 4px; font-weight: 800; }
  header p { color: rgba(255,255,255,0.7); margin: 0; font-size: 14px; }
  header a { color: #ec9b44; text-decoration: none; font-weight: 600; }

  .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 28px; }
  .stat-card { background: white; padding: 16px 20px; border-radius: 12px; border: 1px solid #e5e7eb; }
  .stat-card .num { font-size: 32px; font-weight: 800; color: #0d1a2b; }
  .stat-card .num.bad { color: #c4515c; }
  .stat-card .num.good { color: #2fa768; }
  .stat-card .num.warn { color: #ec9b44; }
  .stat-card .lbl { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 4px; }

  .section { background: white; border-radius: 14px; border: 1px solid #e5e7eb; padding: 20px 24px; margin-bottom: 16px; }
  .section h2 { font-size: 18px; font-weight: 700; margin: 0 0 12px; color: #0d1a2b; display: flex; align-items: center; gap: 8px; }
  .section h2 i { color: #ec9b44; }

  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid #f3f6fb; }
  th { background: #f8f9fb; color: #4b5263; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  td.mono { font-family: monospace; font-size: 12px; color: #4b5263; }
  td .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .pill-ok { background: #ecfdf5; color: #047857; }
  .pill-warn { background: #fff7ed; color: #c2410c; }
  .pill-err { background: #fef2f2; color: #b91c1c; }
  .pill-info { background: #eff6ff; color: #1d4ed8; }

  .progress-bar { height: 8px; background: #e5e7eb; border-radius: 999px; overflow: hidden; }
  .progress-bar .fill { height: 100%; background: linear-gradient(90deg, #ec9b44, #d68830); transition: width 0.3s; }

  .badge-design { background: rgba(236,155,68,0.15); color: #b66d10; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .commit-row { display: flex; gap: 12px; padding: 8px 0; border-bottom: 1px solid #f3f6fb; align-items: center; }
  .commit-hash { font-family: monospace; color: #6b7280; font-size: 11px; width: 70px; }
  .commit-date { color: #6b7280; font-size: 11px; width: 80px; }
  .commit-msg { flex: 1; font-size: 13px; color: #1e2430; }
</style>

<header>
  <h1><i class="bi bi-bar-chart-line"></i> Design System Progress</h1>
  <p>Live мониторинг применения дизайн-системы к компонентам · Источник правды: <a href="/demo/design-system/">/demo/design-system/</a></p>
</header>

<div class="container">

  <!-- ── KPI cards ── -->
  <div class="grid-stats">
    <div class="stat-card">
      <div class="num">{stats.total}</div>
      <div class="lbl">Всего компонентов</div>
    </div>
    <div class="stat-card">
      <div class="num good">{stats.withPrimary}</div>
      <div class="lbl">Используют bg-primary tokens</div>
    </div>
    <div class="stat-card">
      <div class="num bad">{stats.withOldOrange}</div>
      <div class="lbl">Старый hard orange (#ec9b44)</div>
    </div>
    <div class="stat-card">
      <div class="num warn">{stats.withEmoji}</div>
      <div class="lbl">Содержат эмодзи (заменить на bi-icons)</div>
    </div>
    <div class="stat-card">
      <div class="num warn">{stats.mentionBot}</div>
      <div class="lbl">Слово «бот» в тексте (заменить)</div>
    </div>
    <div class="stat-card">
      <div class="num bad">{stats.withBookingBar}</div>
      <div class="lbl">BookingBar usages (убрать)</div>
    </div>
  </div>

  <!-- ── Phase progress ── -->
  <div class="section">
    <h2><i class="bi bi-list-check"></i> Phase Progress (Roadmap)</h2>
    <table>
      <thead><tr><th>Phase</th><th>Что</th><th>Статус</th><th>Прогресс</th></tr></thead>
      <tbody>
        <tr><td><strong>A</strong></td><td>Color palette consolidation (primary/navy 50-950)</td><td><span class="pill pill-ok">DONE</span></td><td><div class="progress-bar"><div class="fill" style="width:100%"></div></div></td></tr>
        <tr><td><strong>B</strong></td><td>Hybrid tokens (spacing, shadow, z-index)</td><td><span class="pill pill-ok">DONE</span></td><td><div class="progress-bar"><div class="fill" style="width:100%"></div></div></td></tr>
        <tr><td><strong>C</strong></td><td>Apply tokens (codemod hex → bg-primary-* etc)</td><td><span class="pill pill-warn">IN PROGRESS</span></td><td><div class="progress-bar"><div class="fill" style={`width:${Math.round(stats.withPrimary/stats.total*100)}%`}></div></div></td></tr>
        <tr><td><strong>D</strong></td><td>Update DESIGN_SYSTEM.md to match HTML</td><td><span class="pill pill-warn">PENDING</span></td><td><div class="progress-bar"><div class="fill" style="width:50%"></div></div></td></tr>
        <tr><td><strong>E</strong></td><td>Remove emoji + словa «бот» / «дети» / BookingBar</td><td><span class="pill pill-err">NOT STARTED</span></td><td><div class="progress-bar"><div class="fill" style="width:5%"></div></div></td></tr>
        <tr><td><strong>F</strong></td><td>Forms → anon Q&A bot widget везде</td><td><span class="pill pill-err">NOT STARTED</span></td><td><div class="progress-bar"><div class="fill" style="width:0%"></div></div></td></tr>
        <tr><td><strong>G</strong></td><td>Photo / Video → /foto/ /video/ страницы</td><td><span class="pill pill-err">NOT STARTED</span></td><td><div class="progress-bar"><div class="fill" style="width:0%"></div></div></td></tr>
        <tr><td><strong>H</strong></td><td>Меню переделка + поиск по сайту</td><td><span class="pill pill-err">NOT STARTED</span></td><td><div class="progress-bar"><div class="fill" style="width:0%"></div></div></td></tr>
      </tbody>
    </table>
  </div>

  <!-- ── Components inventory ── -->
  <div class="section">
    <h2><i class="bi bi-box-seam"></i> Inventory компонентов ({stats.total} total)</h2>
    <table>
      <thead>
        <tr>
          <th>Component</th>
          <th>Hex colors</th>
          <th>Primary token</th>
          <th>Navy token</th>
          <th>Old #ec9b44</th>
          <th>Emoji</th>
          <th>«Бот»</th>
          <th>Glass</th>
        </tr>
      </thead>
      <tbody>
        {components.slice(0, 50).map(c => (
          <tr>
            <td class="mono">{c.name}</td>
            <td>{c.hexCount}</td>
            <td>{c.usesPrimary ? <span class="pill pill-ok">YES</span> : <span class="pill pill-info">no</span>}</td>
            <td>{c.usesNavy ? <span class="pill pill-ok">YES</span> : <span class="pill pill-info">no</span>}</td>
            <td>{c.usesOldOrange ? <span class="pill pill-err">YES</span> : <span class="pill pill-ok">no</span>}</td>
            <td>{c.hasEmoji ? <span class="pill pill-warn">YES</span> : <span class="pill pill-ok">no</span>}</td>
            <td>{c.mentionsBot ? <span class="pill pill-warn">YES</span> : <span class="pill pill-ok">no</span>}</td>
            <td>{c.hasGlassCard ? <span class="pill pill-info">glass</span> : <span class="pill pill-ok">no</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {components.length > 50 && <p style="margin-top: 8px; color: #6b7280; font-size: 12px;">Показаны первые 50 из {components.length} компонентов</p>}
  </div>

  <!-- ── History ── -->
  <div class="section">
    <h2><i class="bi bi-clock-history"></i> Recent commits (15)</h2>
    {recentCommits.map(c => (
      <div class="commit-row">
        <span class="commit-hash">{c.hash}</span>
        <span class="commit-date">{c.date}</span>
        <span class="commit-msg">
          {c.subject}
          {c.isDesign && <span class="badge-design" style="margin-left: 8px;">design</span>}
        </span>
      </div>
    ))}
  </div>

  <!-- ── Reusable components map ── -->
  <div class="section">
    <h2><i class="bi bi-diagram-3"></i> Где переиспользуем</h2>
    <p style="color: #6b7280; font-size: 13px; margin-bottom: 12px;">Эти компоненты — building blocks, должны соответствовать дизайн-системе на 100%:</p>
    <table>
      <thead><tr><th>Компонент</th><th>Где используется</th><th>Соответствие DS</th></tr></thead>
      <tbody>
        <tr><td class="mono">Button.astro (TODO)</td><td>BookingBar, LeadForm, CTA в hero, Shifts, везде</td><td><span class="pill pill-err">не создан</span></td></tr>
        <tr><td class="mono">Card.astro (TODO)</td><td>Shifts, Reviews, About cards</td><td><span class="pill pill-err">не создан</span></td></tr>
        <tr><td class="mono">GlassCard.astro (TODO)</td><td>Hero stats, badges</td><td><span class="pill pill-err">не создан</span></td></tr>
        <tr><td class="mono">DualRatingPill.astro</td><td>Hero, Reviews</td><td><span class="pill pill-warn">частично</span></td></tr>
        <tr><td class="mono">IncampBadge.astro</td><td>Reviews, Footer</td><td><span class="pill pill-ok">DS-compliant</span></td></tr>
        <tr><td class="mono">PhoneDropdown.astro</td><td>Header, Footer</td><td><span class="pill pill-warn">проверить</span></td></tr>
        <tr><td class="mono">BrandName.astro</td><td>Header, Footer</td><td><span class="pill pill-ok">DS-compliant</span></td></tr>
        <tr><td class="mono">SchemaOrg.astro</td><td>index, все landing</td><td><span class="pill pill-ok">SEO ✓</span></td></tr>
        <tr><td class="mono">LandingHero.astro</td><td>Все /landing/ pages</td><td><span class="pill pill-warn">проверить</span></td></tr>
      </tbody>
    </table>
  </div>

</div>

</Base>
