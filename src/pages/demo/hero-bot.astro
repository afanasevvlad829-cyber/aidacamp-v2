---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import HeroModals from '../../components/HeroModals.astro';
import { STAT_YEARS, STAT_KIDS, STAT_RATING, STAT_DISTANCE, STAT_RETURN, CAMP_PRICE_FROM, CAMP_PRICE_FROM_ID, YANDEX_MAPS_URL, CAMP_SEASON } from '../../data/contacts';

// Placeholder — заменить на реальный URL бота
const BOT_URL = 'https://t.me/AidacampBot';
---

<Base title="[Демо] Герой с ботом — АйДаКемп" noindex>

  <!-- ===== DEMO BADGE ===== -->
  <div class="fixed top-0 inset-x-0 z-[200] flex items-center justify-center gap-3 bg-amber-400 py-2 text-base font-semibold text-amber-900">
    <span>ДЕМО — Герой с ботом вместо формы</span>
    <a href="/demo/hero-bot?view=mobile" class="rounded-full bg-amber-900/15 px-3 py-0.5 hover:bg-amber-900/25 transition-colors">Мобилка →</a>
    <a href="/" class="rounded-full bg-amber-900/15 px-3 py-0.5 hover:bg-amber-900/25 transition-colors">Текущая главная →</a>
  </div>
  <div class="h-9"></div>

  <main>

    <!-- ========================================================
         МОБИЛЬНЫЙ ГЕРОЙ (виден только до md)
         ======================================================== -->
    <section id="hero" class="relative w-full overflow-x-hidden bg-surface-warm md:hidden">

      <!-- ===== MOBILE HERO ===== -->
      <div class="relative w-full bg-dark-navy min-h-[95svh] flex flex-col">

        <!-- Фото -->
        <div class="relative flex-1 min-h-[52vw]">
          <picture>
            <source type="image/avif" srcset="/images/hero-mobile-600.avif 600w, /images/hero-mobile-900.avif 900w" />
            <source type="image/webp" srcset="/images/hero-mobile-600.webp 600w, /images/hero-mobile-900.webp 900w" />
            <img src="/images/hero-mobile.webp" alt="" aria-hidden="true"
              class="absolute inset-0 h-full w-full object-cover object-[center_35%]"
              loading="eager" width="390" height="441" />
          </picture>
          <div class="absolute inset-0 bg-[linear-gradient(92deg,rgba(6,10,18,0.72)_0%,rgba(6,10,18,0.46)_42%,rgba(6,10,18,0.2)_70%,rgba(6,10,18,0.06)_100%)]"></div>
          <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_0%,transparent_55%,rgba(13,26,43,0.45)_78%,#0d1a2b_100%)]"></div>
          <div class="absolute bottom-8 left-5 right-5">
            <h1 class="text-[36px] font-bold leading-[1.1] tracking-[-0.03em] text-white [text-shadow:0px_2px_10px_rgba(0,0,0,0.45)]">
              Летний лагерь в&nbsp;Подмосковье,&nbsp;<span class="whitespace-nowrap">7–15</span>
            </h1>
            <p class="mt-2.5 text-base text-white/90">Вам — 14 дней для себя.</p>
          </div>
        </div>

        <!-- Цена + программа -->
        <div class="mx-4 mt-4 flex gap-2">
          <button type="button" data-shift-link={CAMP_PRICE_FROM_ID} class="flex-1 min-h-[48px] rounded-[12px] bg-primary/20 border border-orange-400/40 px-4 py-3 text-[16px] font-semibold text-orange-300 text-center active:bg-primary/30 transition-colors">
            от {CAMP_PRICE_FROM} за 7 дней
          </button>
          <a href="#journey" class="flex-1 rounded-[12px] bg-white/10 border border-white/15 px-4 py-2 text-base text-white/85 text-center leading-[1.25] flex flex-col justify-center active:bg-white/15 transition-colors">
            <span>Программирование</span>
            <span class="text-white/65">AI · Бассейн</span>
          </a>
        </div>

        <!-- Метрики 2×2 — компактнее -->
        <div class="mx-4 mt-4 grid grid-cols-2 gap-1.5">
          <a href="#team" class="rounded-[12px] bg-white/8 px-2 py-3 text-center active:bg-white/15 transition-colors">
            <div class="text-[18px] font-bold leading-none text-white">{STAT_YEARS}</div>
            <div class="mt-1 text-[12px] leading-tight text-white/70">лет работы</div>
          </a>
          <a href="#gallery" class="rounded-[12px] bg-white/8 px-2 py-3 text-center active:bg-white/15 transition-colors">
            <div class="text-[18px] font-bold leading-none text-white">{STAT_KIDS}</div>
            <div class="mt-1 text-[12px] leading-tight text-white/70">детей отдохнули</div>
          </a>
          <a href="#reviews" class="rounded-[12px] bg-white/8 px-2 py-3 text-center active:bg-white/15 transition-colors">
            <div class="text-[18px] font-bold leading-none text-orange-300">★ {STAT_RATING}</div>
            <div class="mt-1 text-[12px] leading-tight text-white/70">Яндекс Карты</div>
          </a>
          <a href="https://vc.ru/gdekurs/1216219-top-20-detskih-letnih-it-lagerei-v-moskve-i-podmoskove" target="_blank" rel="noopener" class="rounded-[12px] bg-white/8 px-2 py-3 text-center active:bg-white/15 transition-colors">
            <div class="text-[18px] font-bold leading-none text-amber-300">ТОП-4</div>
            <div class="mt-1 text-[12px] leading-tight text-white/70">IT-лагерей МО</div>
          </a>
        </div>

        <!-- Trust-бейджи -->
        <div class="mx-4 mt-2.5 flex gap-1.5">
          <a href="/stati/dokumenty-licenziya-strahovka/#licenziya" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-base font-medium text-[#bfdbfe] active:bg-[#1e40af]/60 transition-colors">
            <i class="bi bi-patch-check-fill text-base" aria-hidden="true"></i>
            <span class="leading-tight">Лицензия</span>
          </a>
          <a href="/stati/dokumenty-licenziya-strahovka/#medsestra" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-base font-medium text-[#bfdbfe] active:bg-[#1e40af]/60 transition-colors">
            <i class="bi bi-heart-pulse-fill text-base" aria-hidden="true"></i>
            <span class="leading-tight">Медсестра 24/7</span>
          </a>
          <a href="/stati/dokumenty-licenziya-strahovka/#strahovka" class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full bg-[#1e40af]/40 border border-[#60a5fa]/50 px-2 py-2.5 min-h-[44px] text-base font-medium text-[#bfdbfe] active:bg-[#1e40af]/60 transition-colors">
            <i class="bi bi-shield-check text-base" aria-hidden="true"></i>
            <span class="leading-tight">Страховка</span>
          </a>
        </div>

        <!-- Ссылка на статью (много кликали) -->
        <a
          href="/stati/ii-zamenit-programmista/"
          class="mx-4 mt-3 flex items-center gap-2.5 rounded-[14px] bg-black/30 border border-white/12 px-4 py-3 text-base text-white/75 active:bg-black/45 transition-colors group"
        >
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-white">?</span>
          <span class="flex-1 leading-tight">«ИИ заменит программистов» — правда или реклама?</span>
          <svg class="h-3.5 w-3.5 shrink-0 text-white/40 group-active:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>

        <!-- ✦ БОЛЬШАЯ APPLE-STYLE CTA ✦ -->
        <div class="mx-4 mt-4 mb-8">
          <a
            href={BOT_URL}
            target="_blank"
            rel="noopener"
            class="flex w-full items-center justify-center gap-3 rounded-[22px] bg-primary px-6 py-5 text-[18px] font-semibold text-[#0d1a2b] shadow-[0_8px_28px_rgba(236,124,0,0.40)] active:bg-[#d67000] active:shadow-[0_4px_14px_rgba(236,124,0,0.30)] transition-all duration-150"
          >
            <i class="bi bi-telegram text-[20px]" aria-hidden="true"></i>
            Спросить бота
          </a>
          <p class="mt-3 text-center text-base text-white/65">без регистрации · без СМС · анонимно · сразу</p>
        </div>

      </div>
    </section>


    <!-- ========================================================
         ДЕСКТОПНЫЙ ГЕРОЙ (виден только от md)
         ======================================================== -->
    <section id="hero-desktop" class="relative mx-auto w-full overflow-hidden hidden md:block md:max-w-[1440px]">

      <div class="relative h-[560px] overflow-hidden bg-[#0f1c2e] w-full">
        <picture>
          <source type="image/avif" srcset="/images/hero-desktop-768.avif 768w, /images/hero-desktop-1080.avif 1080w, /images/hero-desktop-1440.avif 1440w" sizes="100vw" />
          <source type="image/webp" srcset="/images/hero-desktop-600.webp 600w, /images/hero-desktop-900.webp 900w, /images/hero-desktop.webp 1536w" />
          <img src="/images/hero-desktop.webp" alt="" aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover object-[center_20%] animate-kenburns"
            loading="eager" fetchpriority="high" width="1440" height="560" />
        </picture>

        <!-- Overlays -->
        <div class="absolute inset-0">
          <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.78)_0%,rgba(5,9,18,0.62)_26%,rgba(5,9,18,0.34)_48%,rgba(5,9,18,0.12)_66%,rgba(5,9,18,0.02)_82%,rgba(5,9,18,0)_100%)]"></div>
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,18,0)_52%,rgba(6,10,18,0.22)_74%,rgba(6,10,18,0.42)_100%)]"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent pointer-events-none"></div>
        </div>

        <!-- Текст слева -->
        <div class="absolute left-16 top-[78px] z-30">
          <div class="flex items-center gap-x-3 text-base text-white/65 whitespace-nowrap">
            <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="flex items-center gap-1 hover:text-white/85 transition-colors">
              <i class="bi bi-geo-alt text-[12px]" aria-hidden="true"></i>
              {STAT_DISTANCE} от Москвы
            </a>
            <span class="text-white/30" aria-hidden="true">·</span>
            <a href="#shifts" class="hover:text-white/85 transition-colors">смены {CAMP_SEASON}</a>
            <span class="text-white/30" aria-hidden="true">·</span>
            <button type="button" data-shift-link={CAMP_PRICE_FROM_ID} class="hover:text-white/85 transition-colors cursor-pointer">
              от {CAMP_PRICE_FROM}
            </button>
          </div>
          <h1 class="mt-2 w-[680px] text-[44px] font-bold leading-[52px] tracking-[-0.03em] text-white [text-shadow:0px_4px_12px_rgba(0,0,0,0.35)]">
            Летний лагерь в&nbsp;Подмосковье,&nbsp;<span class="whitespace-nowrap">7–15</span>
          </h1>
          <p class="mt-2 text-base text-white/90">Каждый уедет с проектом и новыми друзьями.</p>
          <p class="mt-1 text-base text-white/90">Вам — 14 дней для себя.</p>

          <!-- Badges -->
          <div class="mt-3 flex gap-2">
            <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-base text-white/85">Python</span>
            <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-base text-white/85">Minecraft</span>
            <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-base text-white/85">AI</span>
            <span class="flex h-[26px] items-center rounded-full bg-white/22 px-3 text-base text-white/85">Бассейн</span>
          </div>

          <!-- Rating -->
          <p class="mt-3 text-base text-white/65">
            <span class="mr-1 inline-flex items-center rounded-[5px] bg-[rgba(245,166,36,0.18)] px-1.5 py-0.5 text-base font-bold text-[#f5a624]">★ {STAT_RATING}</span>
            на Яндекс Картах · {STAT_YEARS} лет работы · {STAT_KIDS} детей
          </p>

          <!-- CTA -->
          <div class="mt-5 flex items-center gap-4">
            <a href="#shifts"
              class="inline-flex items-center gap-2 rounded-[14px] bg-primary hover:bg-[#d67000] px-6 py-3 text-base font-semibold text-[#0d1a2b] shadow-[0_4px_16px_rgba(236,124,0,0.35)] transition-all duration-200 hover:-translate-y-[1px]">
              Смены 2026
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>
        </div>

        <!-- ✦ БОТ-КАРТОЧКА справа (вместо LeadForm) ✦ -->
        <div class="absolute right-14 top-1/2 -translate-y-1/2 z-30 w-[300px] rounded-[20px] bg-[#0d1a2b]/85 border border-white/15 p-6 backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.45)]">
          <p class="text-[16px] font-semibold text-white leading-[1.4]">
            Мы знаем, что вы здесь не для того, чтобы оставлять телефон.
          </p>
          <p class="mt-3 text-base text-white/75 leading-[1.6]">
            Есть вопрос — напишите боту. Он отвечает как одна из наших довольных мам.
          </p>
          <a
            href={BOT_URL}
            target="_blank"
            rel="noopener"
            class="mt-5 flex w-full items-center justify-center gap-2 rounded-[14px] bg-primary px-5 py-3 text-base font-semibold text-[#0d1a2b] shadow-[0_4px_16px_rgba(236,124,0,0.35)] hover:bg-[#d67000] hover:-translate-y-[1px] transition-all duration-200"
          >
            <i class="bi bi-telegram text-[17px]" aria-hidden="true"></i>
            Написать
          </a>
          <p class="mt-3 text-center text-[12px] text-white/40">без регистрации · анонимно · отвечает сразу</p>
        </div>

        <!-- Bottom bar -->
        <div class="absolute bottom-0 inset-x-0 z-20 border-t border-white/8 bg-black/25 backdrop-blur-sm">
          <div class="mx-auto max-w-[1312px] px-6 py-2.5">
            <a href="#shifts" class="block text-base text-white/55 text-center leading-relaxed hover:text-white/75 transition-colors">
              от {CAMP_PRICE_FROM} за 7 дней · {STAT_RETURN} возвращаются снова · проживание, питание, программа включены · Трансфер — опция
            </a>
          </div>
        </div>
      </div>

    </section>

    <!-- Пустое пространство для контекста скролла -->
    <div class="bg-slate-50 py-16 text-center text-slate-400 text-base">
      ↑ Прокрути вверх — это демо. Ниже начинается остальная страница.
    </div>

  </main>

  <HeroModals />
</Base>
