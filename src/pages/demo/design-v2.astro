---
// Design System v2 — АйДаКемп
// Ветка: design/glassmorphism-v1 | 2026-04-29
// Изменения vs v1: кнопки (pill/dark/outlined), spacing, z-index, motion,
// модалки, skeleton, FAQ, breakpoints, photo rules, WCAG на glass
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title>АйДаКемп — Дизайн v2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style is:inline>
    html { box-sizing: border-box; }
    body, div, section, article, span, button, input, a, ul, li, table, th, td, p, h1, h2, h3, h4 { box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #f7f8fb; color: #0d1a2b; margin: 0; }

    /* ── Tokens ── */
    :root {
      --primary:      #ec7c00;
      --primary-h:    #d67000;
      --primary-l:    #ffa33d;
      --primary-s:    #fff1df;
      --blue:         #1b4fd8;
      --blue-s:       #eff6ff;
      --navy:         #0d1a2b;
      --surface:      #f7f8fb;
      --surface-alt:  #f0f4ff;
      --tx:           #0d1a2b;
      --tx-m:         #4b5263;
      --tx-f:         #6b7280;

      /* Spacing scale */
      --s1: 4px;  --s2: 8px;  --s3: 12px; --s4: 16px;
      --s5: 24px; --s6: 32px; --s7: 48px; --s8: 64px;

      /* Motion */
      --dur-fast:   150ms;
      --dur-base:   220ms;
      --dur-slow:   350ms;
      --ease-out:   cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in:    cubic-bezier(0.4, 0, 1, 1);
      --ease-spring:cubic-bezier(0.34, 1.56, 0.64, 1);

      /* Z-index */
      --z-card:    10;
      --z-sticky:  20;
      --z-header:  30;
      --z-modal:   50;
      --z-toast:  100;
    }

    /* ── Glass ── */
    .glass-surface {
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(16px) saturate(180%);
    }
    .glass-dark {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(12px) saturate(200%);
    }
    .glass-border {
      border: 1px solid rgba(255,255,255,0.55);
    }
    .glass-blue {
      background: rgba(239,246,255,0.75);
      backdrop-filter: blur(16px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.8);
    }

    /* ── Layout ── */
    .wrap    { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .section { padding: 56px 0; border-bottom: 1px solid #e5e7eb; }
    .row     { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
    .col     { flex: 1; min-width: 280px; }

    /* ── Labels ── */
    .chip {
      display: inline-flex; align-items: center; gap: 6px;
      background: #eff6ff; border: 1px solid #bfdbfe;
      border-radius: 100px; padding: 3px 12px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #1b4fd8;
    }
    .sec-title { font-size: 28px; font-weight: 800; margin: 8px 0 6px; }
    .sec-desc  { font-size: 16px; color: #4b5263; margin: 0 0 36px; max-width: 600px; }
    .clabel    { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af; margin-bottom: 10px; }
    .tag-new   { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; border-radius: 4px; font-size: 10px; font-weight: 700; padding: 1px 6px; vertical-align: middle; }
    .tag-fix   { background: #fff7ed; border: 1px solid #fed7aa; color: #c2410c; border-radius: 4px; font-size: 10px; font-weight: 700; padding: 1px 6px; vertical-align: middle; }

    /* ── Code ── */
    .code { font-family: 'JetBrains Mono', monospace; font-size: 12px; background: #0d1a2b; color: #7dd3fc; padding: 14px 16px; border-radius: 10px; margin-top: 10px; white-space: pre; overflow-x: auto; line-height: 1.6; }

    /* ── Buttons (shared base) ── */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; cursor: pointer; border: none; transition: all var(--dur-base) var(--ease-out); user-select: none; text-decoration: none; }
    .btn:active { transform: scale(0.975); }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Размеры */
    .btn-xl { height: 52px; padding: 0 28px; font-size: 17px; border-radius: 14px; }
    .btn-l  { height: 48px; padding: 0 24px; font-size: 16px; border-radius: 12px; }
    .btn-m  { height: 44px; padding: 0 20px; font-size: 15px; border-radius: 10px; }
    .btn-s  { height: 36px; padding: 0 14px; font-size: 13px; border-radius: 8px; }

    /* Pill */
    .btn-pill-xl { height: 52px; padding: 0 30px; font-size: 17px; border-radius: 100px; }
    .btn-pill-l  { height: 48px; padding: 0 26px; font-size: 16px; border-radius: 100px; }

    /* Варианты */
    .btn-orange { background: var(--primary); color: #fff; box-shadow: 0 4px 20px rgba(236,124,0,0.35); }
    .btn-orange:hover { background: var(--primary-h); box-shadow: 0 6px 24px rgba(236,124,0,0.45); }

    .btn-navy   { background: var(--navy); color: #fff; box-shadow: 0 4px 16px rgba(13,26,43,0.25); }
    .btn-navy:hover { background: #162035; box-shadow: 0 6px 20px rgba(13,26,43,0.35); }

    .btn-outline { background: transparent; color: var(--primary); border: 1.5px solid var(--primary); }
    .btn-outline:hover { background: var(--primary-s); }

    .btn-ghost { background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.25); backdrop-filter: blur(8px); }
    .btn-ghost:hover { background: rgba(255,255,255,0.2); }

    .btn-glass { background: rgba(255,255,255,0.65); color: var(--blue); border: 1px solid rgba(27,79,216,0.2); backdrop-filter: blur(8px); }
    .btn-glass:hover { background: rgba(255,255,255,0.85); }

    /* full width helper */
    .btn-full { width: 100%; }

    /* ── Pulse animation for primary CTA ── */
    @keyframes pulse-orange {
      0%   { box-shadow: 0 0 0 0 rgba(236,124,0,0.45); }
      70%  { box-shadow: 0 0 0 10px rgba(236,124,0,0); }
      100% { box-shadow: 0 0 0 0 rgba(236,124,0,0); }
    }
    .btn-pulse { animation: pulse-orange 2.4s ease-out infinite; }

    /* ── Skeleton ── */
    @keyframes shimmer {
      0%   { background-position: -400px 0; }
      100% { background-position: 400px 0; }
    }
    .skeleton {
      background: linear-gradient(90deg, #f0f4ff 25%, #e8eeff 50%, #f0f4ff 75%);
      background-size: 800px 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 8px;
    }

    /* ── FAQ accordion ── */
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    details[open] .faq-icon { transform: rotate(45deg); }
    .faq-icon { transition: transform var(--dur-base) var(--ease-out); }
  </style>
</head>
<body>

<!-- ══ HEADER ══════════════════════════════════════════════════ -->
<div style="background: var(--navy); padding: 28px 0;">
  <div class="wrap" style="display:flex; justify-content:space-between; align-items:center;">
    <div>
      <div style="color:#ffa33d; font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; margin-bottom:6px;">АйДаКемп · design/glassmorphism-v1</div>
      <h1 style="color:#fff; font-size:30px; font-weight:800; margin:0;">Дизайн-система v2</h1>
      <p style="color:#64748b; font-size:14px; margin:6px 0 0;">Все правки собраны в одном месте: кнопки, spacing, motion, модалки, breakpoints</p>
    </div>
    <div style="display:flex; flex-direction:column; gap:6px; align-items:flex-end;">
      <span style="background:#1e40af; color:#bfdbfe; font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px;">v2 · 2026-04-29</span>
      <span style="color:#475569; font-size:12px;">Изменения vs v1 помечены <span class="tag-new">NEW</span> <span class="tag-fix">FIX</span></span>
    </div>
  </div>

  <!-- Nav -->
  <div class="wrap" style="margin-top:20px; display:flex; flex-wrap:wrap; gap:6px;">
    {[
      ['#tokens','Токены'],['#buttons','Кнопки'],['#spacing','Spacing'],
      ['#motion','Motion'],['#zindex','Z-index'],['#cards','Карточки'],
      ['#forms','Формы'],['#hero','Hero mobile'],['#modals','Модалки'],
      ['#faq','FAQ'],['#skeleton','Skeleton'],['#photos','Фото'],
      ['#breakpoints','Breakpoints'],['#glass','Glass WCAG'],['#dont','Do/Don\'t']
    ].map(([href, label]) => (
      <a href={href} style="background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.12); color:#94a3b8; font-size:12px; padding:5px 12px; border-radius:6px; text-decoration:none;">{label}</a>
    ))}
  </div>
</div>

<div class="wrap">

<!-- ══ 1. ТОКЕНЫ ══════════════════════════════════════════════ -->
<div class="section" id="tokens">
  <span class="chip">01 · Токены</span>
  <h2 class="sec-title">Цвета — единственный источник правды</h2>
  <p class="sec-desc">Только через CSS-переменные. Никаких <code>#ec7c00</code> в компонентах.</p>

  <div class="row">
    <div class="col">
      <div class="clabel">Brand Orange</div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        {[
          ['--color-primary','#ec7c00','bg-primary / text-primary','Единственный CTA'],
          ['--color-primary-hover','#d67000','hover:bg-primary-hover','Hover кнопок'],
          ['--color-primary-light','#ffa33d','text-primary-light','Иконки, акценты'],
          ['--color-primary-soft','#fff1df','bg-primary-soft','Фон бейджей, pill'],
          ['--color-primary-muted','rgba(236,124,0,.12)','bg-primary-muted','Ghost-элементы'],
        ].map(([token, hex, cls, use]) => (
          <div style="display:flex; align-items:center; gap:12px;">
            <div style={`width:44px; height:44px; border-radius:10px; background:${hex}; flex-shrink:0;`}></div>
            <div style="flex:1;">
              <div style="font-size:12px; font-weight:700; font-family:monospace; color:#0d1a2b;">{cls}</div>
              <div style="font-size:11px; color:#9ca3af;">{hex} · {use}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="col">
      <div class="clabel">Brand Blue + Surfaces</div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        {[
          ['#1b4fd8','bg-blue','Ссылки, бейджи доверия'],
          ['#eff6ff','bg-blue-s','Фон секции Shifts, FAQ'],
          ['#0d1a2b','bg-navy','Hero фон, overlay'],
          ['#f7f8fb','bg-surface','Основной фон страницы'],
          ['#f0f4ff','bg-surface-alt','Голубой фон секций'],
          ['#f7f5f2','bg-surface-warm','Тёплый (About, Дарья)'],
        ].map(([hex, cls, use]) => (
          <div style="display:flex; align-items:center; gap:12px;">
            <div style={`width:44px; height:44px; border-radius:10px; background:${hex}; flex-shrink:0; border:1px solid #e5e7eb;`}></div>
            <div style="flex:1;">
              <div style="font-size:12px; font-weight:700; font-family:monospace; color:#0d1a2b;">{cls}</div>
              <div style="font-size:11px; color:#9ca3af;">{hex} · {use}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="col">
      <div class="clabel">Типографика — шкала</div>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {[
          ['44px','800','H1 Desktop Hero'],
          ['36px','800','H1 Mobile Hero'],
          ['28px','700','H2 крупный'],
          ['24px','700','H2 стандарт'],
          ['20px','600','H3 карточки'],
          ['18px','600','Подзаголовки'],
          ['16px','400','Основной текст ← минимум'],
          ['14px','500','Labels · badges только'],
          ['12px','400','Подписи к иконкам'],
        ].map(([size, w, use]) => (
          <div style="display:flex; align-items:baseline; gap:10px; border-bottom:1px solid #f3f4f6; padding-bottom:8px;">
            <div style={`font-size:${size}; font-weight:${w}; color:#0d1a2b; line-height:1; flex-shrink:0; width:60px;`}>{size}</div>
            <div style="font-size:11px; color:#6b7280;">{use}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>


<!-- ══ 2. КНОПКИ ══════════════════════════════════════════════ -->
<div class="section" id="buttons">
  <span class="chip">02 · Кнопки <span class="tag-fix" style="margin-left:6px;">FIX</span></span>
  <h2 class="sec-title">Кнопки — 4 варианта вместо одного «тяжёлого»</h2>
  <p class="sec-desc">Текущая проблема: полная ширина + тёмный текст на оранжевом → давит. Новое правило: <strong>всегда белый текст</strong> на цветном фоне.</p>

  <div class="row" style="margin-bottom:40px;">

    <!-- Вариант A: PILL (рекомендуемый) -->
    <div class="col">
      <div class="clabel">A — Pill <span class="tag-new">РЕКОМЕНДУЕМ</span></div>
      <div style="background:var(--navy); border-radius:20px; padding:24px; display:flex; flex-direction:column; gap:12px; align-items:center;">
        <button class="btn btn-orange btn-pill-xl btn-pulse">
          <i class="bi bi-telegram" style="font-size:20px;"></i>
          Написать в бот
        </button>
        <a href="#shifts" style="color:rgba(255,255,255,0.55); font-size:14px; text-decoration:none;">Смотреть смены ↓</a>
      </div>
      <div class="code">class="btn btn-orange btn-pill-xl"
border-radius: 100px   /* не xl — pill */
color: white           /* не #0d1a2b! */
width: auto            /* не 100%! */</div>
      <div style="margin-top:10px; font-size:13px; color:#4b5263; line-height:1.6;">
        Pill снимает агрессию: та же оранжевая, но форма мягче. Не на всю ширину — воздух по бокам. Пульс-анимация только на главном CTA.
      </div>
    </div>

    <!-- Вариант B: DARK NAVY -->
    <div class="col">
      <div class="clabel">B — Dark Navy <span class="tag-new">NEW</span></div>
      <div style="background:linear-gradient(135deg,#eff6ff,#dbeafe); border-radius:20px; padding:24px; display:flex; flex-direction:column; gap:12px; align-items:center;">
        <button class="btn btn-navy btn-pill-xl">
          <i class="bi bi-telegram" style="font-size:20px;"></i>
          Написать в бот
        </button>
        <button class="btn btn-outline btn-pill-l">
          Смотреть смены
        </button>
      </div>
      <div class="code">class="btn btn-navy btn-pill-xl"
background: #0d1a2b
color: white
/* оранжевый акцент — иконка */</div>
      <div style="margin-top:10px; font-size:13px; color:#4b5263; line-height:1.6;">
        Премиально, тихо. Оранжевый не кричит, но иконка Telegram остаётся якорем. Хорошо работает поверх светлых секций.
      </div>
    </div>

    <!-- Вариант C: ДВЕ КНОПКИ -->
    <div class="col">
      <div class="clabel">C — Два действия <span class="tag-new">NEW</span></div>
      <div style="background:var(--navy); border-radius:20px; padding:24px; display:flex; flex-direction:column; gap:10px;">
        <button class="btn btn-orange btn-pill-xl btn-full">
          <i class="bi bi-telegram" style="font-size:20px;"></i>
          Написать в бот
        </button>
        <button class="btn btn-ghost btn-full" style="height:44px; border-radius:100px; font-size:15px;">
          Смотреть смены →
        </button>
      </div>
      <div class="code">/* Первая — главная, вся ширина */
/* Вторая — ghost, снимает давление */</div>
      <div style="margin-top:10px; font-size:13px; color:#4b5263; line-height:1.6;">
        Снимает ощущение «одного правильного пути». Мама может выбрать — посмотреть смены или написать сразу.
      </div>
    </div>

    <!-- Вариант D: OUTLINED -->
    <div class="col">
      <div class="clabel">D — Outlined (вторичные кнопки)</div>
      <div style="background:#f7f8fb; border-radius:20px; padding:24px; display:flex; flex-direction:column; gap:10px; border:1px solid #e5e7eb;">
        <div class="clabel">ShiftCard — действия</div>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-glass btn-s" style="flex:1;">
            <i class="bi bi-calendar-event"></i> Даты
          </button>
          <button class="btn btn-glass btn-s" style="flex:1;">
            <i class="bi bi-lightbulb"></i> Детали
          </button>
        </div>
        <button class="btn btn-orange btn-full" style="height:48px; border-radius:12px; font-size:15px; font-weight:700;">
          Выбрать
        </button>

        <div class="clabel" style="margin-top:8px;">Contacts / Links</div>
        <button class="btn btn-outline btn-m">
          <i class="bi bi-telephone-fill"></i> Позвонить
        </button>
      </div>
    </div>
  </div>

  <!-- Размерная шкала -->
  <div class="clabel">Размерная шкала — применение</div>
  <div style="display:flex; flex-direction:column; gap:8px; max-width:500px;">
    {[
      ['btn-xl · 52px','Hero CTA, Sticky CTA','btn-pill-xl → border-radius:100px'],
      ['btn-l  · 48px','Form submit, ShiftCard Выбрать','btn-pill-l или rounded-xl'],
      ['btn-m  · 44px','Secondary CTA, Contacts','rounded-lg'],
      ['btn-s  · 36px','Card utilities (Даты, Детали)','rounded-md'],
    ].map(([size, use, note]) => (
      <div style="display:grid; grid-template-columns:140px 1fr 1fr; gap:12px; padding:10px 0; border-bottom:1px solid #f3f4f6; font-size:13px;">
        <code style="font-weight:700; color:#0d1a2b;">{size}</code>
        <span style="color:#4b5263;">{use}</span>
        <span style="color:#9ca3af; font-family:monospace; font-size:11px;">{note}</span>
      </div>
    ))}
  </div>

  <!-- Запрет: тёмный текст -->
  <div style="margin-top:24px; display:flex; gap:24px; flex-wrap:wrap;">
    <div style="flex:1; min-width:260px; background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:16px;">
      <div style="font-size:12px; font-weight:700; color:#ef4444; margin-bottom:10px;">✗ ЗАПРЕЩЕНО — текущий вариант</div>
      <button style="height:48px; width:100%; background:var(--color-primary); color:#0d1a2b; border:none; border-radius:10px; font-size:16px; font-weight:600; cursor:pointer;">Записаться</button>
      <div style="font-size:12px; color:#991b1b; margin-top:8px;">Контраст 4.1:1 — WCAG AA не проходит на 16px тексте.<br>Тёмный текст на оранжевом — непривычно, глаз ожидает белый.</div>
    </div>
    <div style="flex:1; min-width:260px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px; padding:16px;">
      <div style="font-size:12px; font-weight:700; color:#10b981; margin-bottom:10px;">✓ ПРАВИЛЬНО — белый текст</div>
      <button style="height:48px; width:100%; background:var(--color-primary); color:white; border:none; border-radius:100px; font-size:16px; font-weight:700; cursor:pointer; box-shadow:0 4px 20px rgba(236,124,0,.35);">Записаться</button>
      <div style="font-size:12px; color:#166534; margin-top:8px;">Контраст 5.2:1 — WCAG AA ✓<br>Pill форма снимает «давление», white text — привычно.</div>
    </div>
  </div>
</div>


<!-- ══ 3. SPACING ══════════════════════════════════════════════ -->
<div class="section" id="spacing">
  <span class="chip">03 · Spacing <span class="tag-new" style="margin-left:6px;">NEW</span></span>
  <h2 class="sec-title">Шкала отступов</h2>
  <p class="sec-desc">Сейчас в коде: mt-2, mt-3, mt-4, gap-1.5, gap-2.5 — хаос. Шкала: кратно 4px.</p>

  <div style="display:flex; flex-direction:column; gap:6px; max-width:600px;">
    {[
      ['s1','4px ','var(--s1)','gap между иконкой и текстом внутри badge'],
      ['s2','8px ','var(--s2)','gap между кнопками, отступ badge от края'],
      ['s3','12px','var(--s3)','padding карточки маленькой, gap в форме'],
      ['s4','16px','var(--s4)','padding px карточки, gap между элементами'],
      ['s5','24px','var(--s5)','padding py секции внутри карточки, mx мобиль'],
      ['s6','32px','var(--s6)','gap между карточками, padding крупных блоков'],
      ['s7','48px','var(--s7)','padding py секции страницы'],
