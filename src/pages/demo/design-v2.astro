          ['Reviews','1 карточка (горизонтальный скролл)','2 карточки','3 карточки'],
          ['Header','Логотип + burger меню','Логотип + burger','Полная навигация'],
          ['Footer','1 колонка, стек','2 колонки','4 колонки'],
        ].map(([comp, mobile, tablet, desktop], i) => (
          <tr style={`background:${i%2===0?'white':'#f9fafb'};`}>
            <td style="padding:12px 16px; font-weight:600; color:#0d1a2b;">{comp}</td>
            <td style="padding:12px 16px; color:#4b5263;">{mobile}</td>
            <td style="padding:12px 16px; color:#4b5263;">{tablet}</td>
            <td style="padding:12px 16px; color:#4b5263;">{desktop}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>


<!-- ══ 13. GLASS WCAG ══════════════════════════════════════════ -->
<div class="section" id="glass">
  <span class="chip">13 · Glass + WCAG <span class="tag-new" style="margin-left:6px;">NEW</span></span>
  <h2 class="sec-title">Контраст на glass-элементах</h2>
  <p class="sec-desc">Основная проблема: backdrop-filter меняет контраст в зависимости от подложки. Решение — минимальный контраст зафиксировать через цвет текста.</p>

  <div class="row">
    <div class="col">
      {[
        ['glass-dark на тёмном фото (Hero)','rgba(255,255,255,0.08)','Текст white (#fff)','18px+ → WCAG AA','Контраст >7:1 на тёмном. Для маленького текста — только 14px+ bold'],
        ['glass-surface на #eff6ff (Shifts)','rgba(255,255,255,0.72)','Текст #0d1a2b','16px+ → WCAG AA ✓','Практически белый фон. #0d1a2b даёт 14.5:1'],
        ['glass-dark метрики (Hero 2×2)','rgba(255,255,255,0.08)','Текст white, 22px+ bold','OK крупный текст','Мелкие подписи 11px: только rgba(255,255,255,0.45) — не WCAG, но допустимо как decorative'],
        ['Trust pills на тёмном','rgba(255,255,255,0.08)','Текст rgba(255,255,255,0.8)','11px → НЕ WCAG','Декоративные — не основной контент. Но лучше сделать white 100%'],
        ['Input на CTA (синий фон)','rgba(255,255,255,0.08)','Текст white, placeholder rgba(1,1,1,.5)','16px placeholder → риск','Placeholder серый на стекле — сложно. Лучше белый bg для input'],
      ].map(([ctx, bg, txt, verdict, note]) => (
        <div style={`background:white; border:1px solid ${verdict.includes('✓')||verdict.includes('OK')?'#bbf7d0':verdict.includes('риск')||verdict.includes('НЕ')?'#fecaca':'#e5e7eb'}; border-radius:12px; padding:14px 16px; margin-bottom:10px;`}>
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px; margin-bottom:8px;">
            <span style="font-size:13px; font-weight:700; color:#0d1a2b;">{ctx}</span>
            <span style={`font-size:11px; font-weight:700; white-space:nowrap; color:${verdict.includes('✓')||verdict.includes('OK')?'#166534':verdict.includes('риск')||verdict.includes('НЕ')?'#991b1b':'#374151'};`}>{verdict}</span>
          </div>
          <div style="font-size:11px; color:#6b7280; line-height:1.5;">{note}</div>
        </div>
      ))}
    </div>
  </div>
</div>


<!-- ══ 14. DO / DON'T ══════════════════════════════════════════ -->
<div class="section" id="dont">
