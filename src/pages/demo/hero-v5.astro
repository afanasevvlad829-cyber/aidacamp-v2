          class="flex w-full items-center justify-center gap-2.5 rounded-full px-6 py-4 text-[17px] font-bold text-[#0d1a2b] cursor-pointer"
          style="background:var(--color-primary);box-shadow:0 4px 20px rgba(236,124,0,0.40)">
          <i class="bi bi-telegram text-[19px]" aria-hidden="true"></i>
          Спросить бота
        </a>

        <!-- Stats inline -->
        <div class="mt-3 flex items-center justify-center gap-2 flex-wrap">
          <span class="text-[13px] font-semibold text-[#fbbf24]">★ {STAT_RATING}</span>
          <span class="text-white/25 text-[12px]">·</span>
          <span class="text-[12px] text-white/55">{STAT_YEARS} лет</span>
          <span class="text-white/25 text-[12px]">·</span>
          <span class="text-[12px] text-white/55">{STAT_KIDS} детей</span>
          <span class="text-white/25 text-[12px]">·</span>
          <span class="text-[12px] text-white/55">ТОП&#8209;4 IT&#8209;лагерей МО</span>
        </div>
        <p class="mt-1.5 text-center text-[11px] text-white/35">Наш ИИ уже заменил менеджера · Без звонка · Ответ сразу</p>

        <!-- Article link -->
        <a href="/stati/ii-zamenit-programmista"
          class="mt-4 flex items-center gap-2.5 rounded-[12px] px-4 py-3 text-[13px] text-white/60 hover:text-white/80 transition-colors"
          style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white" style="background:rgba(249,115,22,0.80)">?</span>
          <span class="flex-1 leading-tight">«ИИ заменит программистов» — правда или реклама?</span>
          <i class="bi bi-chevron-right text-[10px] text-white/25 shrink-0" aria-hidden="true"></i>
        </a>

        <!-- Trust badges (blue pills) -->
        <div class="mt-3 flex gap-1.5">
          {[
            {href:'/stati/dokumenty-licenziya-strahovka/#licenziya',icon:'patch-check-fill',label:'Лицензия'},
            {href:'/stati/dokumenty-licenziya-strahovka/#medsestra',icon:'heart-pulse-fill',label:'Медсестра 24/7'},
            {href:'/stati/dokumenty-licenziya-strahovka/#strahovka',icon:'shield-check',label:'Страховка'},
          ].map(b=>(
            <a href={b.href} class="flex-1 flex flex-col items-center justify-center gap-0.5 text-center rounded-full py-2 text-[12px] font-medium text-[#bfdbfe] leading-tight" style="background:rgba(30,64,175,0.40);border:1px solid rgba(96,165,250,0.50)">
              <i class={`bi bi-${b.icon} text-[13px]`} aria-hidden="true"></i>
              <span>{b.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

</div><!-- /v3 -->

</main>
</Base>
