---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

// Demo: все 12 предложенных тематических hero-эффектов в Apple-soft стилистике.
// Все эффекты — чистый CSS, без JS, без фото. Можно применять на любую страницу
// через data-hero-effect="..." на контейнере с position: relative + overflow-hidden.

const effects = [
  { id: 'summer-sunrise',  title: 'Лагерь на лето 2026',          sub: 'Тёплый рассвет — для всех летних страниц',                      pages: '/lager-na-leto-2026, /lager-na-iyul, /lager-na-iyun' },
  { id: 'food-warm',       title: 'Питание в лагере',             sub: 'Тёплая карамель + лёгкий пар — аппетитная подсветка',            pages: '/pitanie' },
  { id: 'python-flow',     title: 'Python-лагерь',                sub: 'Зелёный курсор + мерцающие промпты',                            pages: '/python-lager, /stati/python-dlya-detej' },
  { id: 'minecraft-blocks',title: 'Minecraft-лагерь',             sub: 'Реальные 3D-кубики с перспективой',                            pages: '/minecraft-lager' },
  { id: 'roblox-pop',      title: 'Roblox-лагерь',                sub: 'Геометрия в жёлто-розовых тонах с мягким bounce',               pages: '/roblox-lager' },
  { id: '3d-perspective',  title: '3D-моделирование',             sub: 'Сетка-каркас с перспективой и вращением',                       pages: '/3d-modelirovanie-lager' },
  { id: 'ai-neural',       title: 'AI-лагерь',                    sub: 'Нейроузлы с пульсирующими связями — фиолетово-голубой',         pages: '/ai-lager, /stati/nejroseti-dlya-detej' },
  { id: 'pool-waves',      title: 'Лагерь с бассейном',           sub: 'Голубые волны + солнечные блики на воде',                       pages: '/lager-s-basseynom' },
  { id: 'moscow-skyline',  title: 'Лагерь в Подмосковье',         sub: 'Силуэт высоток на закате',                                       pages: '/lager-v-podmoskove, /detskiy-lager-podmoskove' },
  { id: 'forest-dappled',  title: 'О лагере / территория',        sub: 'Зелёный лес + солнечные блики сквозь листву',                    pages: '/o-lagere, /stati/territoriya-detskogo-lagerya' },
  { id: 'money-tax',       title: 'Налоговый вычет 13%',          sub: 'Мягкий зелёный + ₽-флоу',                                       pages: '/nalogovyj-vychet, /ceny' },
  { id: 'no-phone',        title: 'Лагерь без телефонов',         sub: 'Перечёркнутый силуэт + успокаивающий синий «вдох-выдох»',        pages: '/lager-bez-telefonov, /stati/zavisimost-u-detej' },
];
---

<Base title="Hero Effects Demo — 12 ярких эффектов (Apple-soft)" noindex>
  <Header />
  <div class="bg-amber-100 text-amber-900 text-center text-base py-1.5 border-b border-amber-200">
    <strong>DEMO:</strong> 12 новых тематических hero-эффектов в Apple-soft стилистике · мягкие, без JS, без фото
  </div>

  <main class="bg-slate-50">
    {effects.map(e => (
      <section class={`fx fx-${e.id}`} data-hero-effect={e.id}>
        <div class="fx-content">
          <span class="fx-tag">{e.id}</span>
          <h2 class="fx-title">{e.title}</h2>
          <p class="fx-sub">{e.sub}</p>
          <p class="fx-pages">{e.pages}</p>
          <a href="#" class="fx-cta">Смены 2026 →</a>
        </div>
      </section>
    ))}
  </main>

  <style is:inline>
    /* === Базовый layout всех hero === */
    .fx {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      min-height: 380px;
      display: flex;
      align-items: center;
      padding: 48px 24px;
      border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    }
    .fx-content {
      position: relative;
      z-index: 5;
      max-width: 720px;
      margin: 0 auto;
      width: 100%;
    }
    .fx-tag {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(15, 23, 42, 0.08);
      color: rgba(15, 23, 42, 0.65);
      margin-bottom: 14px;
    }
    .fx-title {
      font-size: clamp(28px, 5vw, 42px);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: rgba(15, 23, 42, 0.94);
      margin: 0 0 10px;
    }
    .fx-sub {
      font-size: 16px;
      line-height: 1.55;
      color: rgba(15, 23, 42, 0.65);
      margin: 0 0 12px;
    }
    .fx-pages {
      font-size: 12px;
      color: rgba(15, 23, 42, 0.45);
      margin: 0 0 22px;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }
    .fx-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #0d1a2b;
      color: #fff;
      padding: 12px 22px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      transition: transform .2s ease;
    }
    .fx-cta:hover { transform: translateY(-1px); }

    /* === reduced-motion: убрать все анимации === */
    @media (prefers-reduced-motion: reduce) {
      .fx::before, .fx::after { animation: none !important; }
    }

    /* === 1. summer-sunrise — рассвет, мягкий тёплый градиент + солнце === */
    .fx-summer-sunrise {
      background:
        radial-gradient(ellipse 80% 60% at 50% 110%, #ffd6a5 0%, transparent 60%),
        linear-gradient(180deg, #fff5e1 0%, #ffe9d0 60%, #ffd9b5 100%);
    }
    .fx-summer-sunrise::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background: radial-gradient(circle 180px at 50% 92%, rgba(255, 168, 76, 0.5) 0%, rgba(255, 168, 76, 0) 70%);
      animation: sun-pulse 6s ease-in-out infinite alternate;
    }
    .fx-summer-sunrise::after {
      content: ''; position: absolute; inset: 0; z-index: 2;
      background: repeating-linear-gradient(70deg, transparent 0 80px, rgba(255, 200, 130, 0.06) 80px 81px);
    }
    @keyframes sun-pulse { 0% { opacity: 0.7; transform: translateY(0); } 100% { opacity: 1; transform: translateY(-4px); } }

    /* === 2. food-warm — тёплая карамель + пар (мягкие плывущие пятна) === */
    .fx-food-warm {
      background:
        radial-gradient(ellipse 60% 50% at 80% 100%, rgba(255, 184, 108, 0.55) 0%, transparent 65%),
        radial-gradient(ellipse 50% 50% at 20% 100%, rgba(255, 209, 130, 0.45) 0%, transparent 65%),
        linear-gradient(180deg, #fef6e8 0%, #fff1dc 100%);
    }
    .fx-food-warm::before {
      content: ''; position: absolute; left: 30%; bottom: 20%;
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, transparent 60%);
      filter: blur(20px);
      animation: steam 8s ease-in-out infinite;
      z-index: 1;
    }
    .fx-food-warm::after {
      content: ''; position: absolute; right: 25%; bottom: 30%;
      width: 160px; height: 160px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 0%, transparent 60%);
      filter: blur(18px);
      animation: steam 9s ease-in-out infinite reverse;
      z-index: 1;
    }
    @keyframes steam { 0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; } 50% { transform: translateY(-30px) scale(1.15); opacity: 0.85; } }

    /* === 3. python-flow — мерцающие >>> и зелёный курсор === */
    .fx-python-flow {
      background:
        radial-gradient(ellipse 90% 70% at 100% 0%, rgba(74, 222, 128, 0.08) 0%, transparent 60%),
        linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    }
    .fx-python-flow::before {
      content: '>>> import camp\n>>> camp.start()\n>>> _';
      position: absolute; left: 5%; top: 18%; z-index: 1;
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 13px; line-height: 1.8;
      color: rgba(34, 197, 94, 0.55);
      white-space: pre;
      letter-spacing: 0.02em;
    }
    .fx-python-flow::after {
      content: ''; position: absolute;
      right: 8%; top: 60%;
      width: 8px; height: 18px;
      background: rgba(34, 197, 94, 0.7);
      animation: cursor-blink 1s steps(2) infinite;
      z-index: 1;
    }
    @keyframes cursor-blink { 50% { opacity: 0; } }

    /* === 4. minecraft-blocks — летающие 3D-кубики === */
    .fx-minecraft-blocks {
      background: linear-gradient(180deg, #e6f0d4 0%, #d4e8c0 100%);
      perspective: 800px;
    }
    .fx-minecraft-blocks::before, .fx-minecraft-blocks::after {
      content: ''; position: absolute; width: 60px; height: 60px;
      background:
        linear-gradient(135deg, transparent 50%, rgba(0,0,0,0.12) 50%),
        repeating-linear-gradient(90deg, #6b8e3d 0 6px, #5a7d34 6px 12px),
        #6b8e3d;
      box-shadow:
        0 8px 16px rgba(0,0,0,0.15),
        inset -4px -4px 0 rgba(0,0,0,0.18),
        inset 4px 4px 0 rgba(255,255,255,0.15);
      z-index: 1;
    }
    .fx-minecraft-blocks::before { top: 18%; left: 8%; transform: rotateX(20deg) rotateY(-25deg); animation: float-block 7s ease-in-out infinite; }
    .fx-minecraft-blocks::after  { bottom: 18%; right: 10%; transform: rotateX(-15deg) rotateY(30deg); animation: float-block 9s ease-in-out infinite reverse; }
    @keyframes float-block {
      0%, 100% { transform: rotateX(20deg) rotateY(-25deg) translateY(0); }
      50% { transform: rotateX(20deg) rotateY(-25deg) translateY(-20px); }
    }

    /* === 5. roblox-pop — округлые персонажи-фигуры с bounce === */
    .fx-roblox-pop {
      background: linear-gradient(135deg, #fff4f7 0%, #fff7e8 100%);
    }
    .fx-roblox-pop::before {
      content: ''; position: absolute; left: 8%; top: 22%;
      width: 80px; height: 80px;
      background: radial-gradient(circle at 35% 30%, #ffec8b 0%, #f5c518 60%, #d49b00 100%);
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(212, 155, 0, 0.25);
      animation: bounce-pop 3s ease-in-out infinite;
      z-index: 1;
    }
    .fx-roblox-pop::after {
      content: ''; position: absolute; right: 12%; bottom: 22%;
      width: 70px; height: 70px;
      background: radial-gradient(circle at 35% 30%, #ffd5e1 0%, #f472b6 60%, #c026d3 100%);
      border-radius: 50%;
      box-shadow: 0 8px 18px rgba(192, 38, 211, 0.2);
      animation: bounce-pop 4s ease-in-out infinite reverse;
      z-index: 1;
    }
    @keyframes bounce-pop {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-14px); }
    }

    /* === 6. 3d-perspective — wireframe-сетка с перспективой === */
    .fx-3d-perspective {
      background: linear-gradient(180deg, #f0f4ff 0%, #e6edff 100%);
    }
    .fx-3d-perspective::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background:
        linear-gradient(rgba(99, 102, 241, 0.15) 1px, transparent 1px),
        linear-gradient(90deg, rgba(99, 102, 241, 0.15) 1px, transparent 1px);
      background-size: 40px 40px;
      transform: perspective(600px) rotateX(60deg) translateY(20%) scale(1.4);
      transform-origin: 50% 100%;
      mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 100%);
    }
    .fx-3d-perspective::after {
      content: ''; position: absolute; right: 8%; top: 50%;
      width: 80px; height: 80px;
      border: 2px solid rgba(99, 102, 241, 0.5);
      transform: translateY(-50%) rotateX(45deg) rotateY(45deg);
      animation: cube-rotate 12s linear infinite;
      z-index: 2;
    }
    @keyframes cube-rotate {
      0% { transform: translateY(-50%) rotateX(0) rotateY(0); }
      100% { transform: translateY(-50%) rotateX(360deg) rotateY(360deg); }
    }

    /* === 7. ai-neural — узлы с пульсом + связи === */
    .fx-ai-neural {
      background:
        radial-gradient(ellipse 80% 60% at 50% 50%, rgba(167, 139, 250, 0.12) 0%, transparent 60%),
        linear-gradient(180deg, #f5f3ff 0%, #ede9fe 100%);
    }
    .fx-ai-neural::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background:
        radial-gradient(circle 6px at 15% 30%, rgba(139, 92, 246, 0.85) 100%, transparent 100%),
        radial-gradient(circle 6px at 30% 65%, rgba(139, 92, 246, 0.85) 100%, transparent 100%),
        radial-gradient(circle 6px at 50% 25%, rgba(139, 92, 246, 0.85) 100%, transparent 100%),
        radial-gradient(circle 6px at 70% 70%, rgba(139, 92, 246, 0.85) 100%, transparent 100%),
        radial-gradient(circle 6px at 88% 35%, rgba(139, 92, 246, 0.85) 100%, transparent 100%),
        linear-gradient(35deg, transparent 49.5%, rgba(139, 92, 246, 0.2) 49.5% 50.5%, transparent 50.5%),
        linear-gradient(-15deg, transparent 49.5%, rgba(139, 92, 246, 0.15) 49.5% 50.5%, transparent 50.5%);
      animation: neural-pulse 4s ease-in-out infinite;
    }
    @keyframes neural-pulse { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }

    /* === 8. pool-waves — голубые волны + блики === */
    .fx-pool-waves {
      background: linear-gradient(180deg, #e0f2fe 0%, #bae6fd 60%, #7dd3fc 100%);
    }
    .fx-pool-waves::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background:
        repeating-radial-gradient(circle at 20% 90%, rgba(255,255,255,0.25) 0 2px, transparent 2px 24px),
        repeating-radial-gradient(circle at 80% 80%, rgba(255,255,255,0.2) 0 2px, transparent 2px 28px);
      animation: water-shimmer 5s ease-in-out infinite;
    }
    .fx-pool-waves::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 50%;
      background:
        repeating-linear-gradient(transparent 0 30px, rgba(255,255,255,0.15) 30px 32px);
      mask-image: linear-gradient(180deg, transparent 0%, #000 50%, #000 100%);
      z-index: 1;
    }
    @keyframes water-shimmer { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }

    /* === 9. moscow-skyline — силуэт зданий на закате === */
    .fx-moscow-skyline {
      background: linear-gradient(180deg, #fde8d4 0%, #fab68f 50%, #e88a72 100%);
    }
    .fx-moscow-skyline::before {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 50%;
      background:
        linear-gradient(90deg,
          transparent 0% 8%, #152a46 8% 14%, transparent 14% 18%,
          #152a46 18% 22%, transparent 22% 26%,
          #152a46 26% 36%, transparent 36% 40%,
          #152a46 40% 44%, transparent 44% 50%,
          #152a46 50% 58%, transparent 58% 62%,
          #152a46 62% 70%, transparent 70% 76%,
          #152a46 76% 82%, transparent 82% 88%,
          #152a46 88% 96%, transparent 96% 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 25%);
      z-index: 1;
    }
    .fx-moscow-skyline::after {
      content: ''; position: absolute; right: 12%; top: 22%;
      width: 80px; height: 80px;
      background: radial-gradient(circle, rgba(255, 230, 180, 0.95) 0%, rgba(255, 200, 100, 0.4) 50%, transparent 80%);
      border-radius: 50%;
      filter: blur(2px);
      z-index: 1;
    }

    /* === 10. forest-dappled — зелёный лес + блики солнца === */
    .fx-forest-dappled {
      background:
        radial-gradient(ellipse 60% 50% at 30% 20%, rgba(132, 204, 22, 0.25) 0%, transparent 60%),
        radial-gradient(ellipse 50% 40% at 70% 70%, rgba(74, 222, 128, 0.3) 0%, transparent 60%),
        linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
    }
    .fx-forest-dappled::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background:
        radial-gradient(circle 30px at 18% 25%, rgba(255, 250, 200, 0.55) 0%, transparent 70%),
        radial-gradient(circle 40px at 65% 60%, rgba(255, 250, 200, 0.45) 0%, transparent 70%),
        radial-gradient(circle 25px at 85% 30%, rgba(255, 250, 200, 0.5) 0%, transparent 70%),
        radial-gradient(circle 35px at 40% 80%, rgba(255, 250, 200, 0.4) 0%, transparent 70%);
      animation: dappled-shift 10s ease-in-out infinite alternate;
    }
    @keyframes dappled-shift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(15px, -10px); }
    }

    /* === 11. money-tax — мягкий зелёный + ₽ === */
    .fx-money-tax {
      background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    }
    .fx-money-tax::before {
      content: '₽'; position: absolute; left: 8%; top: 25%; z-index: 1;
      font-size: 100px; font-weight: 900;
      color: rgba(16, 185, 129, 0.18);
      line-height: 1;
    }
    .fx-money-tax::after {
      content: '13%'; position: absolute; right: 10%; bottom: 22%;
      font-size: 70px; font-weight: 900;
      color: rgba(16, 185, 129, 0.22);
      line-height: 1;
      letter-spacing: -0.02em;
      z-index: 1;
    }

    /* === 12. no-phone — перечёркнутый телефон + успокаивающий пульс === */
    .fx-no-phone {
      background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
    }
    .fx-no-phone::before {
      content: ''; position: absolute;
      right: 10%; top: 50%;
      width: 80px; height: 130px;
      background: rgba(14, 165, 233, 0.12);
      border: 2px solid rgba(14, 165, 233, 0.4);
      border-radius: 12px;
      transform: translateY(-50%);
      animation: phone-breathe 4s ease-in-out infinite;
      z-index: 1;
    }
    .fx-no-phone::after {
      content: ''; position: absolute;
      right: 10%; top: 50%;
      width: 110px; height: 4px;
      background: rgba(14, 165, 233, 0.7);
      transform: translateY(-50%) rotate(-25deg);
      transform-origin: 50% 50%;
      border-radius: 2px;
      z-index: 2;
    }
    @keyframes phone-breathe {
      0%, 100% { opacity: 0.6; transform: translateY(-50%) scale(1); }
      50% { opacity: 1; transform: translateY(-50%) scale(1.04); }
    }
  </style>
</Base>
