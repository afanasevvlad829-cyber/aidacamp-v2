---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Программа для 14 лет: Python Advanced + ChatGPT API + Unity/C# и AI startup pitch",
    text: "В 14 лет подросткам нужен настоящий результат — не «познакомиться с IT», а сделать проект, который можно показать на собеседовании. В АйДаКемп группа 13–15 лет работает с Python Advanced (ООП, работа с API и базами данных), ChatGPT API (интеграция нейросетей в свои приложения) и Unity/C# (первый игровой движок). Финал смены — AI startup pitch: команды защищают продукт перед другими как перед инвесторами.",
    list: [
      "Python Advanced: классы, ООП, работа с API, базами данных — не учебник, а реальный стек",
      "ChatGPT API: интеграция нейросетей в Telegram-боты и веб-приложения",
      "Unity/C# — введение: сцены, объекты, скрипты, первая 3D-механика",
      "AI startup pitch: команда защищает MVP-продукт, объясняет ценность и архитектуру",
      "Git и деплой: проект на GitHub, открывается по ссылке"
    ]
  },
  {
    h2: "Типичный проект четырнадцатилетки: что он создаст за смену",
    text: "За смену подросток 14 лет делает работающее приложение с AI «под капотом». Telegram-бот с ChatGPT — не заготовка, а собственная идея с продуманной логикой. Или Unity-игра с AI-персонажем. На финальном хакатоне команда защищает продукт как стартап: объясняет проблему, решение, архитектуру. Код на GitHub — можно добавить в резюме.",
    list: [
      "Telegram-бот с ChatGPT API: умные ответы, команды, работа с данными пользователей",
      "Или веб-приложение с деплоем: открывается по ссылке из любого браузера",
      "Unity-игра с AI-механикой: враги со своим поведением, адаптивная сложность",
      "AI startup pitch: команда выступает перед жюри, получает фидбэк и защищает решения"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про четырнадцатилеток в IT-лагере:",
    list: [
      "«Захочет ли сам подросток ехать?» — Большинство едут сами. Формат не детский: серьёзная программа, самостоятельность, среда ровесников с похожими интересами. Многие возвращаются повторно по собственному желанию.",
      "«Python Advanced — не слишком ли сложно?» — Для 13–15 лет это оптимально. Если подросток уже знает Python базово — ускоряемся. Если без опыта — начинаем с основ и за 14 дней выходим на средний уровень.",
      "«Что будет в портфолио?» — Рабочий проект на GitHub: бот с ChatGPT, веб-приложение с деплоем или Unity-игра. Плюс опыт публичной защиты проекта — это то, что спрашивают на профильных олимпиадах.",
      "«Как устроен день подростка?» — Вожатый рядом 24/7, соотношение 1:8. Две сессии по 90 минут, вечерняя работа над проектом по желанию. Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с подростками 13–15 лет. Соотношение — 1 вожатый на 8 подростков. На территории дежурит медработник 24/7. Telegram-чат отряда: родители видят фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый подросток в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для четырнадцатилеток оптимальная смена — от 10 дней. За 7 дней проект не успевает дойти до нормального результата. Смена 2 на 14 дней — максимальный результат: успевает сложиться команда, проект получается сильнее. Июль традиционно заполняется первым.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX} (полноценный AI-проект + деплой)`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Почему 14-летние подростки едут в IT-лагерь",
    text: "Не потому что родители заставили. Большинство подростков 13–15 лет едут потому что хотят попробовать что-то настоящее — не школьный урок информатики, а реальный проект. Плюс: 10 дней без родителей, новые люди, которым интересно то же самое. АйДаКемп — место, где нормально хотеть программировать.",
    list: [
      "Реальный AI-проект, не учебное задание — есть что показать",
      "Среда таких же — без насмешек за интерес к IT",
      "10 дней самостоятельности — первый серьёзный опыт без маминого контроля",
      "Результат в резюме к 9 классу: GitHub, опыт деплоя, pitch перед аудиторией"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа подбирается под уровень — посмотрите и смежные возрасты:",
    list: [
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python средний + Gemini API + Roblox/Minecraft modding",
      "<a href='/lager-15-let'>Лагерь для подростков 15 лет</a> — FastAPI, fullstack, Telegram-боты с деплоем, pitch инвесторам",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Летний лагерь 14 лет в Подмосковье 2026 | АйДаКемп"
  description={`Летний лагерь для подростков 14 лет в Подмосковье 2026. Python Advanced + ChatGPT API + Unity/C#. AI-проект в портфолио, pitch как у стартапа. От ${PRICE_MIN}.`}
  h1="Лагерь для подростков 14 лет — Python Advanced и AI | АйДаКемп"
  canonical="https://aidacamp.ru/lager-14-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа для подростков 14 лет в лагере?", a: "Python Advanced + ChatGPT API + Unity/C# и AI startup pitch. Подростки строят реальные AI-приложения: Telegram-боты с ChatGPT, веб-приложения с деплоем или Unity-игры. Финал смены — защита продукта перед жюри как у стартапа." },
    { q: "Захочет ли подросток 14 лет ехать в лагерь?", a: "Большинство едут сами. Формат не детский: серьёзная программа, самостоятельность, среда ровесников с похожими интересами. Многие возвращаются повторно — уже по собственному желанию." },
    { q: "Что будет в портфолио после смены?", a: "Рабочий проект на GitHub: Telegram-бот с ChatGPT, веб-приложение с деплоем или Unity-игра. Плюс опыт публичной защиты — AI startup pitch перед жюри. Это то, что спрашивают на профильных олимпиадах и в профильные классы." },
    { q: "Есть ли места в июле?", a: "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." },
    { q: "Сколько стоит лагерь для подростков 14 лет?", a: `Смена 2.1 (7 дней, июнь) — ${PRICE_MIN}. Смена 2 (14 дней, июнь) — ${PRICE_MAX}. Смена 3 (13 дней, август) — ${PRICE_S3}. Смена 4 (10 дней, август) — ${PRICE_S4}. В стоимость входят проживание, питание, программа, бассейн.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 14 лет в Подмосковье"
    subtitle="Python Advanced + ChatGPT API + Unity/C#. AI-проект в портфолио к 9 классу. Финал смены — pitch как у стартапа."
    breadcrumb="Лагерь для подростков 14 лет"
    keywords={["Python Advanced + ChatGPT API + Unity/C#", "AI startup pitch на финале смены", "Вожатый 1:8, медработник 24/7"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 14 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
    { title: "Детский лагерь без телефонов — как это устроено", url: "/stati/detskiy-lager-bez-telefonov", description: "Почему отдых без гаджетов работает лучше, чем кажется.", icon: "phone-x" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-[14px] text-slate-500">
    <a href="/lager-13-let/" class="text-primary underline underline-offset-2">← Лагерь для 13 лет</a> · <a href="/lager-15-let/" class="text-primary underline underline-offset-2">Лагерь для 15 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
