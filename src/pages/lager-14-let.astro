---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_S2, DAYS_S21, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import { STAT_RATING } from '../data/contacts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для подростков 13–15 лет: Python Advanced + ChatGPT API + Unity/C# и AI startup pitch",
    text: "Подросткам нужен настоящий результат — не «познакомиться с IT», а сделать проект, который можно показать на собеседовании. Группа 13–15 лет работает с Python Advanced (ООП, API, базы данных), ChatGPT API и Unity/C#. Финал смены — AI startup pitch: команды защищают продукт как перед инвесторами.",
    list: [
      "Python Advanced: классы, ООП, работа с API, базами данных — реальный стек",
      "ChatGPT API: нейросети в Telegram-ботах и веб-приложениях",
      "Git и деплой: проект на GitHub, открывается по ссылке"
    ]
  },
  {
    h2: "Типичный проект четырнадцатилетки: что он создаст за смену",
    text: "За смену подросток делает работающее приложение с AI «под капотом»: Telegram-бот с ChatGPT или Unity-игру с AI-персонажем. Код на GitHub — можно добавить в резюме.",
    list: [
      "Telegram-бот с ChatGPT API: умные ответы, команды, работа с данными",
      "Unity-игра с AI-механикой: враги со своим поведением, адаптивная сложность"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про подростков 13–15 лет в IT-лагере:",
    list: [
      "«Захочет ли сам подросток ехать?» — Большинство ребят едут сами: серьёзная программа, самостоятельность, ровесники с похожими интересами. Многие возвращаются повторно по собственному желанию.",
      "«Python Advanced — не слишком ли сложно?» — Для 13–15 лет это оптимально. Кто без опыта — начинает с основ и выходит на средний уровень.",
      "«Как устроен день подростка?» — Вожатый рядом 24/7, соотношение 1:8. Две сессии по 90 минут, Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Летние каникулы для детей 13–15 лет — время полного погружения без школьной рутины. Для каждой группы закреплён вожатый с опытом работы с подростками, медработник на территории дежурит 24/7.",
    list: [
      "Соотношение вожатых 1:8 — каждый подросток в поле зрения",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Отзывы родителей и как оформить путёвку",
    text: `Рейтинг ${STAT_RATING} на Яндекс.Картах — среди отзывов есть и родители подростков, их стоит почитать перед бронированием. Путёвка в детский лагерь оформляется официально по договору, а с образовательной части путёвки оформляется вычет 13% через nalog.ru — лагеря с лицензией Минобрнауки такой вычет дают.`
  },
  {
    h2: `Смены ${SEASON_YEAR} года: летнего сезона больше нет`,
    text: "Для подростков 13–15 лет оптимальная смена — от 10 дней: за неделю проект не успевает дойти до нормального результата.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, ${DAYS_S3} — ${PRICE_S3} (полноценный AI-проект + деплой)`,
      `Смена 4 — ${DATES_SHORT_S4}, ${DAYS_S4} — ${PRICE_S4}`,
      "В стоимость входит проживание, питание и бассейн — доплат нет"
    ]
  },
  {
    h2: "Смотрите также: детский лагерь по возрасту",
    text: "Программа подбирается под уровень — посмотрите и смежные возрасты:",
    list: [
      "<a href='/lager-12-let/'>Программа для 12 лет</a> — Python средний + Gemini API + Roblox/Minecraft modding",
      "<a href='/lager-15-let/'>Программа для детей 15 лет</a> — FastAPI, fullstack, Telegram-боты с деплоем, pitch инвесторам",
      "<a href='/lager-dlya-podrostkov/'>Лагеря в Подмосковье для подростков</a> — все смены и направления для этого возраста",
      "<a href='/lager-dlya-devochek/'>Лагерь для девочек-подростков</a> — Roblox, AI, 3D-моделирование в группе сверстниц",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`Летний лагерь для детей 14 лет в Подмосковье ${SEASON_YEAR} — Python и AI | АйДаКемп`}
  description={`Летний лагерь для детей 14 лет в Подмосковье ${SEASON_YEAR}. Python Advanced + ChatGPT API + Unity/C#. AI-проект в портфолио, pitch как у стартапа. От ${PRICE_MIN}.`}
  h1="Лагерь для детей 14 лет в Подмосковье"
  canonical="https://aidacamp.ru/lager-14-let"
  breadcrumb="Лагерь для подростков 14 лет"
>
  <LandingHero slot="hero"
    h1="Лагерь для детей 14 лет в Подмосковье"
    subtitle="Python Advanced + ChatGPT API + Unity/C#. AI-проект в портфолио к 9 классу. Финал смены — pitch как у стартапа."
    breadcrumb="Лагерь для подростков 14 лет"
    keywords={["Python Advanced + ChatGPT API + Unity/C#", "AI startup pitch на финале смены", "Вожатый 1:8, медработник 24/7"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 14 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Какая программа для подростков 14 лет в лагере?", a: "Python Advanced + ChatGPT API + Unity/C# и AI startup pitch. Подростки строят реальные AI-приложения, финал смены — защита продукта перед жюри как у стартапа." },
    { q: "Захочет ли подросток 14 лет ехать в лагерь?", a: "Большинство едут сами. Формат не детский: серьёзная программа, самостоятельность, ровесники с похожими интересами. Многие возвращаются повторно." },
    { q: "Что будет в портфолио после смены?", a: "Рабочий проект на GitHub: Telegram-бот с ChatGPT, веб-приложение с деплоем или Unity-игра, плюс опыт публичной защиты — AI startup pitch перед жюри." },
    { q: `Какие смены проходили в августе ${SEASON_YEAR} года?`, a: "Смена 3 длилась 13 дней, смена 4 — 10 дней. Обе уже прошли." },
    { q: `Сколько стоил лагерь для подростков 14 лет в ${SEASON_YEAR} году?`, a: `Последние смены сезона стоили ${PRICE_S4} за ${DAYS_S4} и ${PRICE_S3} за ${DAYS_S3}. В стоимость входили проживание, питание, программа и бассейн.` }
  ]} only={['medicine', 'safety', 'food', 'accommodation', 'documents', 'communication', 'payment']} />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
    { title: "Детский лагерь без телефонов — как это устроено", url: "/stati/detskiy-lager-bez-telefonov/", description: "Почему отдых без гаджетов работает лучше, чем кажется.", icon: "phone-x" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-13-let/" class="text-primary underline underline-offset-2">← Лагерь для 13 лет</a> · <a href="/lager-15-let/" class="text-primary underline underline-offset-2">Лагерь для 15 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
