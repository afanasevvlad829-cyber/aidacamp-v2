---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему 14-летние подростки едут в IT-лагерь",
    text: "Не потому что родители заставили. Большинство подростков 13–15 лет едут потому что хотят попробовать что-то настоящее — не школьный урок информатики, а реальный проект. Плюс: 10 дней без родителей, новые люди, которым интересно то же самое. АйДаКемп — место, где нормально хотеть программировать.",
    list: [
      "Реальный AI-проект, не учебное задание",
      "Среда таких же — без насмешек за интерес к IT",
      "10 дней самостоятельности — без маминого контроля",
      "Результат в резюме к 9 классу"
    ]
  },
  {
    h2: "Программа для 14 лет: Python Advanced, ChatGPT API и Unity/C#",
    text: "Для 13–15 лет — предпрофессиональная программа. Python Advanced — это не «привет мир», а классы, функции, работа с API и базами данных. ChatGPT API и Gemini — подростки подключаются к настоящим AI-сервисам и строят на их основе свои приложения. Дополнительный трек — Unity/C# для тех, кто хочет делать игры «по-взрослому». Финал — хакатон: командное соревнование с питчем AI-стартапа перед жюри.",
    list: [
      "Python Advanced: ООП, функции, работа с файлами и API",
      "ChatGPT API / Gemini API — интеграция AI в проект",
      "Unity/C# — трек для тех, кто хочет делать 3D-игры",
      "Хакатон — AI-стартап за 24 часа: питч перед жюри"
    ]
  },
  {
    h2: "Типичный проект: что привозит подросток 14 лет",
    text: "К концу смены у подростка есть работающее приложение — Telegram-бот с ChatGPT, AI-квиз или другой проект с AI-элементом. Это не домашняя работа «для галочки» — это код, который можно показать на собеседовании в профильный класс, на олимпиаде, в резюме.",
    list: [
      "Работающий проект с AI — не макет, не домашнее задание",
      "Публичная защита на хакатоне — опыт презентации и питча",
      "Код на GitHub — можно показать куда угодно",
      "Подтверждение участия — документ от лагеря"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про 14-летних в IT-лагере:",
    list: [
      "«Захочет ли подросток ехать сам?» — Большинство едут сами. Формат не детский: серьёзная программа, самостоятельность, среда ровесников. Многие возвращаются повторно.",
      "«Нужен ли опыт программирования?» — Да, базовый Python желателен. Если нет — определят в подгруппу Python с нуля, но темп будет выше чем у 10-летних.",
      "«Что с телефоном?» — Телефон сдаётся на хранение. Работает внутренняя экономика: экранное время зарабатывается за активность. К третьему дню большинство перестают скучать по телефону.",
      "«Вожатые рядом?» — Соотношение 1:8. Медработник 24/7. Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Для подростков 13–15 лет предусмотрено больше свободного времени и самостоятельности, но безопасность — без компромиссов.",
    list: [
      "Соотношение вожатых 1:8",
      "Медработник 24/7, страховка включена",
      "Telegram-фото из отряда ежедневно",
      "Закрытый бассейн по расписанию",
      "Вечерние активности: квесты, турниры, настолки"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для 13–15 лет оптимальная смена — от 10 дней. За 7 дней проект не успевает дойти до нормального результата. Смена 2 на 14 дней — максимальный результат: успевает сложиться команда, проект получается сильнее. Июль занят полностью.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа подбирается под уровень — посмотрите и смежные возрасты:",
    list: [
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python средний: боты, API, введение в AI",
      "<a href='/lager-15-let'>Лагерь для 15 лет</a> — предпрофессиональный трек: FastAPI, деплой, портфолио",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Летний лагерь 14 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для подростков 14 лет в Подмосковье 2026. Python Advanced + ChatGPT API + Unity/C#. Реальный AI-проект в портфолио. Без нотаций. От 48 000 ₽."
  h1="Лагерь для подростков 14 лет — Python Advanced и AI | АйДаКемп"
  canonical="https://aidacamp.ru/lager-14-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для подростков 14 лет в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python Advanced + ChatGPT API / Gemini API + Unity/C#. Подростки строят реальные AI-приложения: Telegram-боты с AI-ответами, программы с ChatGPT под капотом. Хакатон в финале — питч AI-стартапа перед жюри." }
        },
        {
          "@type": "Question",
          "name": "Захочет ли подросток 14 лет ехать в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Большинство едут сами. Формат не детский: серьёзная программа, самостоятельность, среда ровесников с похожими интересами. Многие возвращаются повторно — уже по собственному желанию." }
        },
        {
          "@type": "Question",
          "name": "Что будет с телефоном подростка в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Телефон сдаётся на хранение. Работает внутренняя экономика: экранное время зарабатывается за активность и прогресс в проекте. К третьему дню большинство подростков перестают скучать по телефону." }
        },
        {
          "@type": "Question",
          "name": "Есть ли места в июле?",
          "acceptedAnswer": { "@type": "Answer", "text": "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для подростков 14 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена 2.1 (7 дней, июнь) — 48 000 ₽. Смена 2 (14 дней, июнь) — 95 000 ₽. Смена 3 (13 дней, август) — 89 400 ₽. Смена 4 (10 дней, август) — 74 900 ₽. В стоимость входят проживание, питание, программа, бассейн." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 14 лет в Подмосковье"
    subtitle="Python Advanced + ChatGPT API + Unity/C#. Реальный AI-проект в портфолио к 9 классу. Для тех, кому скучны обычные лагеря."
    breadcrumb="Лагерь для подростков 14 лет"
    keywords={["Python Advanced + ChatGPT API + Unity/C#", "AI-стартап на хакатоне — питч перед жюри", "Реальный проект в портфолио к 9 классу"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 14 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
    { title: "Детский лагерь без телефонов — как это устроено", url: "/stati/detskiy-lager-bez-telefonov", description: "Почему отдых без гаджетов работает лучше, чем кажется.", icon: "phone-x" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
