---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Опыт программирования не нужен",
    text: "В АйДаКемп приезжают дети, которые ни разу не открывали редактор кода — и уезжают с готовым проектом. Не потому что их заставили, а потому что получилось. Преподаватели-практики строят программу так, чтобы первый результат появился уже в первые 1–2 дня: сцена, персонаж, движение. Ребёнок видит — работает, и хочет дальше.",
    list: [
      "Берём с нуля — специальная группа для новичков",
      "Первый рабочий проект — уже на второй день",
      "Преподаватель рядом, не «объяснил и ушёл»"
    ]
  },
  {
    h2: "Сам выбирает глубину",
    text: "Один ребёнок хочет сделать простую игру и радоваться результату. Другой — разобраться как работает логика, добавить уровни, прикрутить AI. Программа построена так, чтобы каждый двигался в своём темпе. Никто не ждёт отстающих и не тормозит тех, кто хочет больше. Группы делятся по возрасту и уровню с первого дня.",
    list: [
      "Группы 7–9, 10–12 и 13–15 лет с разной глубиной",
      "Хочет больше — получит сложнее задачу",
      "Хочет попроще — не будет чувствовать себя отстающим"
    ]
  },
  {
    h2: "Это про «попробовать» — не про обязательства",
    text: "Лагерь — это не курс с домашними заданиями и давлением. Никто не проверяет знания по окончании и не выставляет оценок. Главное — чтобы ребёнок попробовал, сделал что-то своё и понял: нравится мне это или нет. Именно за этим сюда едут. На финальном хакатоне каждый защищает свой проект — и это уже совсем другое ощущение, чем «прошёл курс».",
    list: [
      "Никакого давления — только интерес и результат",
      "Итог смены — готовый проект, который ребята сделали сами",
      "Хакатон в финале: защита проекта перед командой"
    ]
  },
  {
    h2: "Гарантия возврата",
    text: 'Мы уверены в программе — за шесть лет работы и 1 200+ детей большинство к концу смены не хотят уезжать. Для тех, кто сомневается: <a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">условия гарантии и возврата →</a>',
    list: [
      '<a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">Гарантия и условия возврата →</a>',
      "Договор оферты, лицензия туроператора РТО 025773",
      "Фиксация цены на 72 часа после заявки"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="IT-лагерь попробовать — без опыта, гарантия возврата | АйДаКемп"
  description="IT-лагерь для детей 7–15 лет без опыта. 66 км от МКАД, Подмосковье. Гарантия возврата — условия на сайте."
  h1="Не знает, нужен ли ему IT? Пусть попробует."
  canonical="https://aidacamp.ru/попробовать"
>
  <Fragment slot="head">
    
  </Fragment>
  <LandingHero slot="hero"
    h1="Не знает, нужен ли ему IT? Пусть попробует."
    subtitle={`IT-лагерь АйДаКемп, ${STAT_DISTANCE} от Москвы. Опыт не нужен. Каждый выбирает глубину. Гарантия возврата.`}
    breadcrumb="Попробовать IT"
    keywords={[
      "Опыт программирования не нужен — берём с нуля",
      "Каждый сам выбирает глубину и темп",
      "Гарантия возврата — условия на странице политики"
    ]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="IT-лагерь АйДаКемп — попробовать программирование"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
