---
import LanitPageLayout from '../../layouts/LanitPageLayout.astro';
---

<LanitPageLayout title="IT-лагерь для детей айтишников · ЛАНИТ" description="Партнёрская программа с ГК ЛАНИТ — специальные условия для сотрудников">
  <div class="min-h-screen bg-gradient-to-r from-white via-orange-50 to-white relative overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 right-0 w-1/2">
      <img 
        src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&h=900&fit=crop" 
        alt="Forest background" 
        class="w-full h-full object-cover opacity-60"
      />
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <!-- Header -->
      <div class="mb-16">
        <div class="flex justify-between items-start mb-12">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">
              <span class="text-gray-900">АйДа</span><span class="text-orange-500">Кемп</span>
            </h1>
          </div>
          <div class="text-right">
            <p class="text-xs text-orange-500 font-semibold uppercase tracking-wider">Партнёрская программа · ГК ЛАНИТ</p>
            <a href="tel:+74951284429" class="text-gray-700 hover:text-orange-500 transition font-semibold">
              +7 (495) 128-44-29
            </a>
          </div>
        </div>

        <!-- Orange label -->
        <div class="text-xs text-orange-500 font-semibold uppercase tracking-wider mb-8">
          Специальные условия для сотрудников ГК ЛАНИТ
        </div>
      </div>

      <!-- Main content section -->
      <div class="grid grid-cols-2 gap-12 mb-12">
        <!-- Left column -->
        <div>
          <h2 class="text-5xl font-bold text-gray-900 leading-tight mb-8">
            IT-лагерь<br/>для детей<br/><span class="text-orange-500">айтишников</span>
          </h2>

          <p class="text-gray-700 text-base leading-relaxed mb-12">
            Ваш ребёнок видит, что вы делаете? Пора показать ему настоящий стек. Python, JS, Java, ИИ-агенты — и реальный проект на выходе. Летняя инженерная школа в 66 км от Москвы. 7–15 лет.
          </p>

          <!-- Info badges -->
          <div class="space-y-4 mb-12">
            <div class="flex flex-wrap gap-3">
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">7–15 лет</span>
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">⭐ 5.0 · Яндекс.Карты</span>
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">Крытый бассейн</span>
            </div>
            <div class="flex flex-wrap gap-3">
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">66 км от Москвы</span>
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">8+ треков</span>
              <span class="inline-block px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm rounded-lg">5-разовое питание</span>
            </div>
            <div class="text-xs text-gray-500">
              Лицензия Минобра № ЛО35-01298-77/01082973
            </div>
          </div>

          <!-- CTA buttons -->
          <div class="flex gap-4">
            <a href="tel:+74951284429" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition">
              <i class="bi bi-telephone-fill text-lg"></i>
              +7 (495) 128-44-29
            </a>
            <a href="https://t.me/aidacamp" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold rounded-lg transition">
              <i class="bi bi-telegram text-lg"></i>
              Telegram
            </a>
          </div>
        </div>

        <!-- Right column - Code block -->
        <div class="flex items-center justify-end">
          <div class="bg-gray-900 rounded-xl p-6 font-mono text-sm text-gray-300 w-full max-w-sm shadow-2xl">
            <div class="space-y-2">
              <div><span class="text-orange-400">transfer</span> = <span class="text-blue-400">Tree</span> # 18+ детей</div>
              <div><span class="text-purple-400">async</span> = 5 / газ в сутки</div>
              <div><span class="text-green-400">def</span> <span class="text-yellow-400">enroll</span>(kid, child):</div>
              <div class="ml-4"><span class="text-green-400">return</span> <span class="text-orange-400">"Смена забронирована"</span></div>
              <div><span class="text-gray-500"># ...</span></div>
              <div>&nbsp;</div>
              <div><span class="text-gray-500"># Скидки: -12% + группа 6–5 детей</span></div>
              <div><span class="text-gray-500"># Трансфер от офиса ДМИТа: готово</span></div>
              <div><span class="text-gray-500"># Питание: 5 раз в сутки</span></div>
              <div><span class="text-gray-500"># Статус:</span> <span class="bg-orange-900 text-orange-200 px-2">ОТКРЫТА</span></div>
              <div><span class="text-gray-500"># "Смена забронирована для ГК ЛАНИТ"</span></div>
            </div>
            <div class="mt-4 text-xs text-orange-500 font-semibold">ЛАНИТ-УРОВЕНЬ</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</LanitPageLayout>

<style>
  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css');
</style>
