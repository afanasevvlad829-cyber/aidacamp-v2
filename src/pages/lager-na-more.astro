---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь на море vs лагерь в Подмосковье — честное сравнение",
    text: "Когда ищешь «лагерь на море», обычно имеют в виду одно из двух: отдых на природе с водой, или конкретно Черноморское побережье. Мы не на море — мы в Подмосковье, в 66 км от МКАД. Но у нас есть бассейн, лес, чистый воздух, и главное — 10–14 дней, которые ребёнок запомнит не потому что «море», а потому что сам сделал что-то настоящее."
  },
  {
    h2: "Что есть в АйДаКемп вместо моря",
    text: "Закрытый бассейн работает через день по расписанию. Территория санатория «Изумруд» — лес, чистый воздух Наро-Фоминского района вдали от городской пыли. Детям не скучно: IT-занятия, спорт, командные игры, хакатон в конце. Многие родители выбирают Подмосковье намеренно — нет рисков акклиматизации, ребёнок не теряет неделю из-за перестройки организма.",
    list: [
      "Бассейн с ионизированной водой через день — без хлора",
      "Лес и природа — 40 соток охраняемой территории",
      "Чистый воздух Наро-Фоминского района, без городской пыли",
      "66 км от МКАД — 1 час езды, не 20 часов в поезде",
      "Нет акклиматизации — приехали и сразу в программе"
    ]
  },
  {
    h2: "Почему часто выбирают Подмосковье, а не море",
    text: "Лагерь на море звучит красиво. На практике: перелёт или поезд 20+ часов, акклиматизация 3–5 дней, дорогой трансфер. Ребёнок проводит реальное время в лагере с программой — примерно 7 из 14 дней (остальное — дорога и адаптация). В Подмосковье нет этих потерь. Доехали за час, сразу начали. В последний день — снова час домой. Максимум времени в деле.",
    list: [
      "Дорога 1 час vs 20+ часов — экономия сил и нервов",
      "Нет акклиматизации — больше времени на программу",
      "Стоимость без авиабилетов — выгоднее с учётом общих расходов",
      "Можно навестить в середине смены при желании",
      "Лагерь под Москвой — это ещё и безопаснее логистически"
    ]
  },
  {
    h2: "Для кого подходит АйДаКемп вместо морского лагеря",
    text: "АйДаКемп — осознанный выбор для тех, кому важен результат смены, а не просто «отдых у воды». Здесь дети 7–15 лет создают IT-проекты, участвуют в хакатоне, учатся работать в команде. Если ваш ребёнок интересуется программированием, играми или просто хочет «сделать что-то настоящее» — это лучший летний выбор. Если цель чисто пляжный отдых — честно, мы не про это.",
    list: [
      "Проект за смену: Scratch, Python, Minecraft, AI, Telegram-бот",
      "Бассейн и спорт — активный отдых на воздухе",
      "Без телефонов: экранное время зарабатывается как валюта",
      "Хакатон в финале — ребята защищают проект перед всем лагерем",
      "Возраст 7–15 лет, группы по возрасту с отдельной программой"
    ]
  },
  {
    h2: "Смены лета 2026 — даты и цены",
    text: "Шесть смен с конца мая по август. Короткие 7-дневные смены подойдут для первого раза или если ребёнок уже едет на море отдельно. Длинные 13–14-дневные — для тех, кто хочет максимальный результат.",
    list: [
      "Смена 1: 30 мая — 8 июня, 10 дней — 74 900 ₽",
      "Смена 2: 10 — 23 июня, 14 дней — 99 000 ₽",
      "Смена 2.1: 10 — 16 июня, 7 дней — 48 000 ₽",
      "Смена 2.2: 16 — 23 июня, 8 дней — 75 000 ₽",
      "Смена 3: 3 — 15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17 — 26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь в Подмосковье — альтернатива морю"
  description="Не море, но бассейн и лес в 66 км от МКАД. IT-лагерь АйДаКемп: Python, AI, Minecraft, хакатон. Смены июнь–август 2026 от 48 000 ₽. Без акклиматизации."
  h1="Лагерь на лето 2026 в Подмосковье — бассейн, лес, IT"
  canonical="https://aidacamp.ru/lager-na-more"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Лагерь в Подмосковье лучше, чем лагерь на море?", a: "Зависит от цели. Подмосковный лагерь — без акклиматизации и перелёта. Летом в Наро-Фоминском районе +24–28°C, хвойный лес, бассейн с ионизированной водой. Экономия на транспорте 14–18 тыс. ₽ идёт в счёт смены. До Москвы — 1 час, а не 3 дня акклиматизации." },
    { q: "Есть ли бассейн в лагере вместо моря?", a: "Да. На территории санатория «Изумруд» — закрытый бассейн с ионизированной водой (без хлора, без аллергий). Купание каждый день или через день по расписанию, в безопасных условиях под присмотром вожатых." },
    { q: "Не скучно ли детям без моря в лагере?", a: "Нет. В АйДаКемп плотная программа: IT-занятия дважды в день, бассейн, спорт на площадках, командные игры, вечерняя работа над проектом, хакатон в финале. По нашим наблюдениям, дети скучают по морю первые полдня — потом забывают и занимаются делом." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на лето 2026: бассейн, лес и IT — в 66 км от МКАД"
    subtitle="Не море — но бассейн каждый день, чистый воздух и 10 дней, которые ребёнок запомнит. Без акклиматизации, 1 час от Москвы."
    breadcrumb="Лагерь в Подмосковье"
    keywords={[
      `Бассейн + IT-проект — ${STAT_DISTANCE} от Москвы, 1 час`,
      "Без акклиматизации и долгой дороги — сразу в программе",
      `От ${CAMP_PRICE_FROM} всё включено — без авиабилетов`
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь в Подмосковье — бассейн и IT"
  />
  <LandingTwoCol sections={sections} />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
