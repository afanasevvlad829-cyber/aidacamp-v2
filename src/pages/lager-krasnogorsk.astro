---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Красногорск — рядом со Сколково и технологическими компаниями",
    text: "Это административный центр Московской области, в нескольких километрах от Сколково. Здесь живут тысячи семей — родители работают в технологических компаниях инновационного центра. АйДаКемп — логичный следующий шаг: ребёнок видит, как мама или папа решают сложные IT-задачи, и хочет попробовать сам. За смену он создаст первый настоящий проект и вернётся домой с результатом."
  },
  {
    h2: "Дорога до лагеря",
    text: "АйДаКемп — это санаторий «Изумруд» в Наро-Фоминском городском округе: 66 км от МКАД по Киевскому шоссе (А-101), примерно час без пробок. На машине — через МКАД на Киевское шоссе, либо на метро до м. Солнцево и дальше на трансфере.",
    list: [
      "На машине: через МКАД на Киевское шоссе (А-101) до санатория «Изумруд» — 66 км от МКАД, около часа без пробок",
      "На метро: Красногорск → м. Волоколамская или м. Строгино → м. Солнцево, дальше трансфер",
      `Трансфер от м. Солнцево — автобус с сопровождающим, ${TRANSFER_PRICE_FMT} в один конец`
    ]
  },
  {
    h2: "Почему родители выбирают АйДаКемп",
    text: `От метро Солнцево — около 40 минут, а дальше трансфер (${TRANSFER_PRICE_FMT}) довезёт до места. Никаких самолётов и акклиматизации. Школьник проведёт смену в Подмосковье, создаст IT-проект, а родители смогут спокойно работать.`,
    list: [
      "66 км от МКАД по Киевскому шоссе — загородный IT-лагерь под Москвой",
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец, автобус с сопровождающим`,
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "IT-программа для школьников",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Отзывы родителей",
    text: "Западное Подмосковье — родители оттуда активно выбирают АйДаКемп. Вот несколько историй:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Через две недели вернулась с ноутбуком и проектом про AI. Всем рассказывала» — Наталья",
      "«Сын сначала не хотел ехать. А вернулся — сам стал писать код дома. Это лучший результат, на который я надеялась» — Юлия"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены и наличие мест`,
    text: "В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21} (налоговый вычет ~${VYCHET_S21})`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2} (налоговый вычет ~${VYCHET_S2})`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Красногорск: летний IT-лагерь рядом"
  description={`Летний IT-лагерь рядом с Красногорском, налоговый вычет до ${VYCHET_MAX}, ребятам 7–15 лет.`}
  h1="Красногорск: летний лагерь рядом"
  canonical="https://aidacamp.ru/lager-krasnogorsk"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детская IT-программа в Наро-Фоминском округе — АйДаКемп"
      description="IT-программа в Наро-Фоминском районе Подмосковья. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-krasnogorsk"
      ageMin={7}
      ageMax={15}
    />
    
  </Fragment>
  <LandingHero slot="hero"
    h1="Красногорск: летний лагерь рядом"
    subtitle={`Ближайшая загородная IT-программа в Подмосковье — санаторий «Изумруд», 66 км от МКАД по Киевскому шоссе. Трансфер от м. Солнцево ${TRANSFER_PRICE_FMT}.`}
    breadcrumb="IT-лагерь рядом"
    keywords={[`66 км от МКАД по Киевскому шоссе, трансфер от м. Солнцево ${TRANSFER_PRICE_FMT}`, "IT-программа: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Дети на IT-занятии в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как добраться из Красногорска до АйДаКемп?", a: `66 км от МКАД по Киевскому шоссе (А-101), примерно час без пробок. На машине — через МКАД на Киевское шоссе, либо до м. Солнцево и трансфером (${TRANSFER_PRICE_FMT}, автобус с сопровождающим).` },
    { q: "Сколько ехать от метро до лагеря?", a: `66 км от МКАД по Киевскому шоссе, примерно час без пробок от МКАД. На метро — до м. Солнцево (~40 мин), дальше автобус до места (${TRANSFER_PRICE_FMT}).` },
    { q: "Есть ли трансфер от метро?", a: `Да, от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец, автобус с сопровождающим до места. От м. Волоколамская или Строгино до Солнцево — около 35–40 минут на метро.` },
    { q: "Сколько стоит путёвка?", a: `От ${PRICE_MIN} за 10-дневную смену до ${PRICE_MAX} за 13-дневную. Открыты августовские смены: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит всё кроме трансфера. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в один конец.` }
  ]} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
