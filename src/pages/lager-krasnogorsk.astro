---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Красногорска до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 80 км от Красногорска. Маршрут: МКАД (через западный въезд) → Калужское шоссе, время в пути около 1.5 часов. Организованный трансфер отправляется от м. Солнцево — от Красногорска до Солнцево удобно на метро (через Волоколамскую или Строгино) за 35–45 минут."
  },
  {
    h2: "Почему родители из Красногорска выбирают АйДаКемп",
    text: "Из Красногорска до м. Солнцево — 40 минут на метро, а оттуда трансфер довезёт до лагеря. Никаких самолётов и акклиматизации. Ребёнок проведёт смену в Подмосковье, создаст IT-проект, а родители смогут спокойно работать.",
    list: [
      "~80 км от Красногорска по Калужскому шоссе",
      "Трансфер от м. Солнцево — 40 минут от Красногорска на метро",
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Красногорска",
    text: "Красногорск — западное Подмосковье, и родители оттуда активно выбирают АйДаКемп. Вот несколько историй:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Через две недели вернулась с ноутбуком и проектом про AI. Всем рассказывала» — Наталья, Красногорск",
      "«Сын сначала не хотел ехать. А вернулся — сам стал писать код дома. Это лучший результат, на который я надеялась» — Юлия, Красногорск"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Красногорск 2026 — АйДаКемп"
  description="IT-лагерь рядом с Красногорском: 1.5 часа по Калужскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Красногорском"
  canonical="https://aidacamp.ru/lager-krasnogorsk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Красногорска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Красногорска ~80 км: МКАД → Калужское шоссе, около 1.5 часов. Удобнее: метро до м. Солнцево (35–45 мин), затем трансфер АйДаКемп (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Красногорска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часов на машине по МКАД и Калужскому шоссе. На трансфере: метро до Солнцево (~40 мин) плюс поездка на автобусе." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Красногорска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер от м. Солнцево (2 500 ₽). От Красногорска до Солнцево — около 40 минут на метро." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит всё кроме трансфера." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Красногорском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Красногорска. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-krasnogorsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Красногорском"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Красногорска по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Красногорска"
    keywords={["~1.5 часа от Красногорска по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Красногорском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
