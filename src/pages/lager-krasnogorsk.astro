---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Красногорск — рядом со Сколково и технологическими компаниями",
    text: "Красногорск — административный центр Московской области, расположенный в нескольких километрах от Сколково. Здесь живут тысячи семей, где родители работают в технологических компаниях инновационного центра. АйДаКемп — логичный следующий шаг: ребёнок видит, как мама или папа решают сложные задачи в IT, и хочет попробовать сам. В лагере он создаст первый настоящий проект и вернётся домой с реальным результатом."
  },
  {
    h2: "Маршрут из Красногорска в лагерь — ~55 км, ~50 мин",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 55 км от Красногорска. Маршрут короткий и без московских пробок: через МКАД западный въезд сразу на Киевское шоссе.",
    list: [
      "На машине: Красногорск → МКАД (западный въезд) → Киевское шоссе (M-3) → Апрелевка, ~55 км, около 50 мин без пробок",
      "На метро: Красногорск → м. Волоколамская или м. Строгино → м. Солнцево, около 35–40 минут",
      "Трансфер от м. Солнцево бесплатно в день заезда и обратно в день отъезда"
    ]
  },
  {
    h2: "Почему родители из Красногорска выбирают АйДаКемп",
    text: "Из Красногорска до м. Солнцево — около 40 минут на метро, а оттуда бесплатный трансфер довезёт до лагеря. Никаких самолётов и акклиматизации. Школьник проведёт смену в Подмосковье, создаст IT-проект, а родители смогут спокойно работать.",
    list: [
      "~55 км от Красногорска по Киевскому шоссе — один из ближайших IT-лагерей",
      "Трансфер от м. Солнцево бесплатно — 35–40 минут от Красногорска на метро",
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "IT-программа для школьников из Красногорска",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Отзывы родителей из Красногорска",
    text: "Красногорск — западное Подмосковье, и родители оттуда активно выбирают АйДаКемп. Вот несколько историй:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Через две недели вернулась с ноутбуком и проектом про AI. Всем рассказывала» — Наталья, Красногорск",
      "«Сын сначала не хотел ехать. А вернулся — сам стал писать код дома. Это лучший результат, на который я надеялась» — Юлия, Красногорск"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽ (налоговый вычет ~2 800 ₽)",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (налоговый вычет до 5 434 ₽)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽ (налоговый вычет ~5 200 ₽)",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽ (налоговый вычет ~4 800 ₽)",
      "Трансфер от м. Солнцево — бесплатно"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Красногорск 2026 — АйДаКемп"
  description="IT-лагерь рядом с Красногорском: ~55 км, ~50 мин по Киевскому шоссе. Трансфер от м. Солнцево бесплатно. Python, AI, Minecraft для школьников 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Красногорском"
  canonical="https://aidacamp.ru/lager-krasnogorsk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Красногорска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Красногорска ~55 км: МКАД западный въезд → Киевское шоссе, около 50 минут. Удобнее: метро до м. Солнцево (35–40 мин через Волоколамскую или Строгино), затем бесплатный трансфер АйДаКемп." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Красногорска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 50 минут на машине по МКАД и Киевскому шоссе. На трансфере: метро до Солнцево (~40 мин) плюс поездка на автобусе до лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Красногорска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер от м. Солнцево. От Красногорска до Солнцево — около 35–40 минут на метро через м. Волоколамская или м. Строгино." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит всё кроме трансфера. Трансфер от м. Солнцево — бесплатно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Красногорском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~55 км от Красногорска. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-krasnogorsk"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Красногорском", "item": "https://aidacamp.ru/lager-krasnogorsk/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Красногорском"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~55 км от Красногорска по Киевскому шоссе, ~50 мин. Трансфер от м. Солнцево бесплатно."
    breadcrumb="Лагерь из Красногорска"
    keywords={["~55 км от Красногорска (~50 мин), трансфер от м. Солнцево бесплатно", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Красногорском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
