---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Истры до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Из Истры ехать около 1.5–2 часов: через МКАД на Киевское шоссе (M-3). Дорога несложная — основная часть по трассе. Если не хочется за руль, организованный трансфер отправляется от м. Солнцево (~30 мин от Истры), стоимость 2 000 ₽ в одну сторону."
  },
  {
    h2: "Почему родители из Истры выбирают АйДаКемп",
    text: "Истра — это дачные и коттеджные посёлки, семьи, которые переехали из Москвы за качеством жизни, и близость к Новоиерусалимскому монастырю. Западное Подмосковье — ближайший вариант с западного направления, всего ~60 км. Мамы из Истры привыкли выбирать лучшее — и в лагере не делают исключений.",
    list: [
      "Никакой акклиматизации — Подмосковье, климат привычный",
      "Одна пересадка: до м. Солнцево, дальше трансфер АйДаКемп",
      "Родительский день в середине смены — можно навестить и убедиться, что всё хорошо",
      "5-разовое питание, врач 24/7, закрытая территория — спокойно за безопасность"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "Из Истры до лагеря около часа — это значит, что в экстренной ситуации родители доберутся быстро. Но до экстренных ситуаций доходит редко: в лагере постоянно дежурит медработник, а команда вожатых прошла специальный отбор.",
    list: [
      "1 преподаватель на 6–8 участников — индивидуальная работа с каждым",
      "Медработник в лагере 24/7",
      "Ежедневные фото и видео в Telegram — всё видно в реальном времени",
      "Июль 2026 занят полностью. В июне и августе места есть — запишитесь сейчас"
    ]
  },
  {
    h2: "Что ребёнок делает в лагере",
    text: "АйДаКемп — это IT-лагерь с реальным проектом на выходе. Дети 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут с преподавателями-практиками.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортплощадки, вечерние активности",
      "Проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый ребёнок защищает свой проект перед всеми"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "В АйДаКемп едут семьи из Истры, Волоколамска, Красногорска и других городов западного Подмосковья:",
    list: [
      "«Расстояние пугало поначалу. Но дочь позвонила на третий день и сказала, что не хочет домой — вот и всё расстояние» — Татьяна, Истра",
      "«Пересели с ребёнком до Солнцево, передала в руки вожатым — и поехала спокойно работать. Никакого стресса с дорогой» — Марина, Красногорск",
      "«Сын на хакатоне показал игру, которую сам написал на Python. Я даже не верила сначала» — Ольга, Волоколамск"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. В стоимость включены проживание, питание, IT-программа, бассейн и страховка. Трансфер из Москвы — 2 000 ₽ отдельно.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Истрой 2026 | АйДаКемп"
  description="IT-лагерь из Истры: ~1.5–2 ч через МКАД по Киевскому шоссе. Python, AI, Minecraft, бассейн, питание. Трансфер от метро Солнцево."
  h1="Детский лагерь из Истры — АйДаКемп в Подмосковье"
  canonical="https://aidacamp.ru/lager-istra"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Истры до АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Истры до м. Солнцево около 30 минут, оттуда трансфер АйДаКемп (2 000 ₽). Или самостоятельно на автомобиле: через МКАД на Киевское шоссе, санаторий «Изумруд» в 66 км от МКАД, Наро-Фоминский район." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени ехать из Истры до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов. Маршрут: Истра → МКАД → Киевское шоссе → санаторий «Изумруд». Расстояние примерно 90–100 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Истры?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Истры нет, но от м. Солнцево организован автобус АйДаКемп. Доехать до Солнцево из Истры — около 30 минут на машине. Стоимость трансфера 2 000 ₽." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Популярные смены: 14 дней — 95 000 ₽, 13 дней — 89 400 ₽, 10 дней — 74 900 ₽. В стоимость включены проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Истрой — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5–2 часа от Истры. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-istra"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Истры — АйДаКемп в Подмосковье"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5–2 часа от Истры через МКАД. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Истры"
    keywords={["~1.5–2 часа от Истры через МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Истрой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
