---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MomStory from '../components/MomStory.astro';
import About from '../components/About.astro';
import Shifts from '../components/Shifts.astro';
import Gallery from '../components/Gallery.astro';
import Videos from '../components/Videos.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Team from '../components/Team.astro';
import Mentors from '../components/Mentors.astro';
import Stay from '../components/Stay.astro';
import Journey from '../components/Journey.astro';
import Economy from '../components/Economy.astro';
import Hackathon from '../components/Hackathon.astro';
import BookingBar from '../components/BookingBar.astro';
import SoftStart from '../components/SoftStart.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SeoTextBlock from '../components/SeoTextBlock.astro';
import ShiftOccupancy from '../components/ShiftOccupancy.astro';
import SummerCta from '../components/SummerCta.astro';
import ShiftModal from '../components/ShiftModal.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../data/landing-pages';
---

<Base
  title="Детский IT-лагерь в Подмосковье 2026 — Python, AI, Minecraft | АйДаКемп"
  description="Детский лагерь для детей 7–15 лет в Подмосковье. Python, AI, Minecraft, бассейн. Смены июнь–август 2026 от 48 000 ₽. Питание и проживание включены."
>
  <Fragment slot="head">
    <!-- LCP fix 2026-04-20: split mobile/desktop preload — mobile qualifies только 600w (≈35 KB вместо 1100w ≈100 KB) -->
    <link rel="preload" as="image" media="(max-width: 768px)" href="/images/hero-custom-2026-04-07-600.avif" type="image/avif" fetchpriority="high" />
    <link rel="preload" as="image" media="(min-width: 769px)" href="/images/hero-custom-2026-04-07-1100.avif" imagesrcset="/images/hero-custom-2026-04-07-900.avif 900w, /images/hero-custom-2026-04-07-950.avif 950w, /images/hero-custom-2026-04-07-1100.avif 1100w, /images/hero-custom-2026-04-07.avif 1536w" imagesizes="100vw" type="image/avif" fetchpriority="high" />
    <SchemaOrg />
  </Fragment>
  <Header />
  <main class="pb-20 md:pb-0">
    <Hero />

    <!-- Мобильная печать «Ноутбук не нужен» — inline, не absolute -->
    <div class="md:hidden flex px-5 py-3">
      <button
        type="button"
        id="equipment-stamp-mobile"
        aria-label="Ноутбук не нужен — у нас всё есть!"
        class="rotate-[-10deg] select-none cursor-pointer group hover:scale-105 transition-transform duration-200"
      >
        <div class="relative flex h-[96px] w-[96px] items-center justify-center rounded-full border-[2.5px] border-dashed border-[#0d1a2b]/55 bg-transparent group-hover:border-[#0d1a2b]/85 transition-colors">
          <div class="absolute inset-[7px] rounded-full border border-[#0d1a2b]/18 transition-colors"></div>
          <div class="flex flex-col items-center gap-0 px-2 text-center">
            <i class="bi bi-laptop text-[20px] leading-none text-[#0d1a2b]" aria-hidden="true"></i>
            <span class="mt-0.5 text-[7.5px] font-black uppercase tracking-[0.14em] text-[#0d1a2b] leading-[1.3]">Ноутбук<br/>не нужен</span>
            <div class="mt-1 h-px w-7 bg-[#0d1a2b]/30"></div>
            <span class="mt-0.5 text-[6.5px] font-semibold uppercase tracking-[0.09em] text-[#0d1a2b]/55 leading-[1.4]">у нас всё есть!</span>
          </div>
        </div>
      </button>
    </div>

    <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
      <div class="flex flex-col gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <ShiftOccupancy />
        <MomStory compact />
      </div>
    </div>
    <About />
    <Journey />
    <Economy />
    <BookingBar id="after-economy" headline="Один звонок — ответим на всё и не будем беспокоить" />
    <SoftStart />
    <Shifts />
    <BookingBar id="after-shifts" headline="Выбрали смену? Забронируем за 10 минут" />
    <SummerCta />
    <Hackathon />
    <Gallery />
    <Videos />
    <Reviews />
    <FAQ />
    <Team />
    <Mentors />
    <Stay />
    <Contacts />
    <SeoTextBlock />
    <RelatedPages pages={allLandingPages} />
  </main>
  <Footer />
  <ShiftModal />
  <StickyCta />
</Base>
