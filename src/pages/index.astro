---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MomStory from '../components/MomStory.astro';
import About from '../components/About.astro';
import Philosophy from '../components/Philosophy.astro';
import Shifts from '../components/Shifts.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
// Videos moved to /video/ page (Phase G)
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Team from '../components/Team.astro';
// Mentors merged into Team (Phase M, design system)
import Stay from '../components/Stay.astro';
import Journey from '../components/Journey.astro';
import Economy from '../components/Economy.astro';
import Hackathon from '../components/Hackathon.astro';
// BookingBar removed — booking inside shift modal only (per design system Section 18)
// SoftStart removed (дубль CTA, см. design audit 2026-05-02)
import Contacts from '../components/Contacts.astro';
import LastMinuteWidget from '../components/LastMinuteWidget.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SeoTextBlock from '../components/SeoTextBlock.astro';
// ShiftOccupancy removed (proof в hero proof-line)
// SummerCta removed (дубль sticky CTA, см. design audit 2026-05-02)
import SchemaOrg from '../components/SchemaOrg.astro';
import { landingPages as allLandingPages } from '../data/landing-pages';
---

<Base
  title="Детский лагерь в Подмосковье 2026 | АйДаКемп — от 48 000 ₽"
  description="Летний лагерь в Наро-Фоминском районе, 66 км от Москвы. Возраст 7–15 лет, группы до 12 человек. Смены 7–14 дней от 48 000 ₽. Ребёнок создаст свою игру — даже без опыта. Запись на 2026 открыта."
  heroPreloadMobile="/images/hero-mobile-bean-v3-600.avif"
  heroPreloadDesktop="/images/hero-desktop.avif"
>
  <Fragment slot="head">
    {/* P2 LCP: preloads перенесены в heroPreloadMobile/heroPreloadDesktop props Base.astro
        (рендерятся первыми после charset, ДО аналитики — было в slot="head" ПОСЛЕ скриптов) */}
    <SchemaOrg />
  </Fragment>
  <Header />
  <main class="pb-20 md:pb-0">
    <Hero hasVariants={true} />

    {/* Печать «Ноутбук не нужен» удалена — этот факт теперь в HeroFeatures (chip «Ноутбук — не нужен»). */}

    <!-- Под hero: ShiftOccupancy (CTA «Проверить свободные места») + MomStory (proof) — двухколоночно на десктопе. -->
    <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
      <!-- Только Дарья compact (ShiftOccupancy удалён — proof уже в hero proof-line) -->
      <MomStory compact />
    </div>

    <!-- Skolzkaya gorka:
         Hero → MomStory(short) → Shifts → REVIEWS (поднят с поз.7 на поз.4 — proof виден 71% вместо 27%)
         → Stay → GalleryPreview → Philosophy → Journey → Economy → About → Hackathon → Team → FAQ → Contacts -->
    <Shifts />
    <Reviews />
    <Stay />
    <GalleryPreview />
    <Philosophy />
    <Journey />
    <Economy />
    <About />
    <Hackathon />
    <Team />
    <FAQ />
    <Contacts />
    <LastMinuteWidget />
    <SeoTextBlock />
    <RelatedPages pages={allLandingPages} />
  </main>
  <Footer />
  <!-- ShiftModal mounted in Base.astro globally — НЕ дублировать здесь (вызывало 2 модала) -->
  <!-- StickyCta убран: перекрывал AgeBar (z-70 vs z-60), AgeBar — главная цель Метрики 541048270 -->
  <!-- <StickyCta /> -->
</Base>
