---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MomStory from '../components/MomStory.astro';
import About from '../components/About.astro';
import Shifts from '../components/Shifts.astro';
import TrevoznyjRoditel from '../components/TrevoznyjRoditel.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
// Videos moved to /video/ page (Phase G)
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Team from '../components/Team.astro';
// Mentors merged into Team (Phase M, design system)
import Stay from '../components/Stay.astro';
import Journey from '../components/Journey.astro';
import Economy from '../components/Economy.astro';
import Hackathon from '../components/Hackathon.astro';
// BookingBar removed — booking inside shift modal only (per design system Section 18)
// SoftStart removed (дубль CTA, см. design audit 2026-05-02)
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SeoTextBlock from '../components/SeoTextBlock.astro';
import LiveBookingFeed from '../components/LiveBookingFeed.astro';
// ShiftOccupancy removed (proof в hero proof-line)
// SummerCta removed (дубль sticky CTA, см. design audit 2026-05-02)
import SchemaOrg from '../components/SchemaOrg.astro';
// TrustBlock — только на /r/ для возвратников
import { landingPages as allLandingPages } from '../data/landing-pages';

/**
 * ПРОТОТИП: главная линкует только на хаб-страницы (тир 0+1 по реальной частотности
 * Wordstat, + IT-лагерь вне тиров — уже #3 в выдаче, must-keep). Остальные 106
 * лендингов не теряют вес — они уже связаны между собой через getRelatedPages()
 * и присутствуют в sitemap. Полный список ссылок и обоснование — в переписке 25.07.2026.
 *
 * /lager-dlya-detey/, /detskie-lagerya/, /skolko-stoit-lager-dlya-rebenka/ —
 * исключены 25.07.2026: попали в noindex 24.07.2026 (решение владельца, #1110,
 * консолидация 13 программатик-клонов) и уже вне sitemap (astro.config.mjs) —
 * линковать с главной на заноиндексированные страницы не нужно.
 */
const HOMEPAGE_HUB_URLS = [
  '/detskiy-lager/', '/lager-v-podmoskove/', '/lager-v-moskve/',
  '/ozdorovitelnyj-lager/', '/detskiy-lager-podmoskove/',
  '/putevka-v-lager/', '/lager-na-leto-2026/',
  '/detskiy-lager-oficialnyj/', '/lager-dlya-shkolnikov/',
  '/lager-nedorogo/', '/lager-dlya-podrostkov/', '/lager-dlya-devochek/', '/lager-dlya-malchikov/',
  '/zagorodnyj-lager/', '/lager-letnego-prebyvaniya/', '/lager-s-basseynom/', '/moskovskie-letnie-lagerya/',
  '/it-lager/',
];
const homepageHubPages = HOMEPAGE_HUB_URLS
  .map(url => allLandingPages.find(p => p.url === url))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);
---

<Base
  {/* Без месяца: главная берёт безсезонные головные ключи (детский лагерь,
      летний лагерь, лагерь в подмосковье), а месячные запросы — страницы
      /lager-na-iyun/, /lager-na-iyul/, /lager-na-avgust-podmoskove/.
      «июнь 2026» тут стоял литералом и в августе уводил выдачу в прошлый месяц. */}
  title={`Детский летний лагерь в Подмосковье для детей и подростков ${SEASON_YEAR}`}
  description={`Летний детский оздоровительный лагерь для детей и подростков в Подмосковье ${SEASON_YEAR} — IT-программа, спорт, нейросети, бассейн, 5-разовое питание, Путевка на лето.`}
  heroPreloadMobile="/images/hero-mobile-bean-v3-414.avif"
  heroPreloadMobileSrcset="/images/hero-mobile-bean-v3.avif 390w, /images/hero-mobile-bean-v3-414.avif 414w, /images/hero-mobile-bean-v3-828.avif 828w"
  heroPreloadDesktop="/images/hero-desktop-1440.avif"
>
  <Fragment slot="head">
    {/* P2 LCP: preloads перенесены в heroPreloadMobile/heroPreloadDesktop props Base.astro
        (рендерятся первыми после charset, ДО аналитики — было в slot="head" ПОСЛЕ скриптов) */}

  </Fragment>
  <Header />
  <main class="pb-20 md:pb-0">
    <Hero hasVariants={true} />

    {/* Печать «Ноутбук не нужен» удалена — этот факт теперь в HeroFeatures (chip «Ноутбук — не нужен»). */}

    <!-- MomStory: цитата Дарьи — всегда видна (без скрытия для возвратников) -->
    <div class="mx-auto max-w-[1312px] px-[2px] pt-0 md:px-4 lg:pt-12">
      <MomStory />
    </div>

    <!-- Порядок: Hero → MomStory → Shifts → TrevoznyjRoditel → Reviews → Stay → GalleryPreview → … -->
    <Shifts compactPastShifts />
    <TrevoznyjRoditel />
    <Reviews />
    <Stay />
    <GalleryPreview />
    <div class="returning-hide"><Journey /></div>
    <Economy />
    <div class="returning-hide"><About /></div>
    <script is:inline>
    (function() {
      var hasViewed = !!localStorage.getItem('ac:viewed_shifts');
      var hasYmUid  = /(?:^|[; ])_ym_uid=/.test(document.cookie);
      if (hasViewed || hasYmUid) {
        document.querySelectorAll('.returning-hide').forEach(function(el) {
          el.style.display = 'none';
        });
      }
    })();
    </script>
    <Hackathon />
    <Team compact />
    <FAQ
      only={['safety', 'food', 'accommodation', 'payment']}
      moreLink={{ href: '/faq/', text: 'Все вопросы и ответы' }}
      intro={{
        text: 'Частые вопросы по лагерю: возврат при болезни, застрахованная ответственность туроператора.',
        href: '/garantii/',
        linkText: 'Все гарантии →',
      }}
    />
    <Contacts />
    <SeoTextBlock />
    <RelatedPages pages={homepageHubPages} />
  </main>
  <Footer />
  <!-- ShiftModal mounted in Base.astro globally — НЕ дублировать здесь (вызывало 2 модала) -->
  <!-- StickyCta убран: перекрывал AgeBar (z-70 vs z-60), AgeBar — главная цель Метрики 541048270 -->
  <!-- <StickyCta /> -->
  <!-- JSON-LD вынесен из <head> в конец body — не блокирует критический путь; Google/Яндекс находят в любом месте документа -->
  <SchemaOrg />
  <LiveBookingFeed />
</Base>
