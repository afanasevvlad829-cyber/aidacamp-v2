---
import { PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM, STAT_RTO, STAT_LICENSE } from '../data/contacts';
import { SEASON_SHIFTS_PHRASE, SEASON_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Как выбрать детский лагерь в Московской области",
    text: `Отдых в Подмосковье раскупают быстрее всего, поэтому даты стоит бронировать заранее. Вот три критерия, которые реально важны, когда выбираешь между похожими вариантами.`,
    list: [
      `<b>Лицензия Минобрнауки</b> — не бумажка для галочки: программа проверена, педагоги аттестованы, а родители получают налоговый вычет 13%. АйДаКемп работает по лицензии (реестровый номер РТО ${STAT_RTO}), многие лагеря — нет.`,
      "<b>Размер группы</b> — разница между группой из 25 детей и группой из 8 огромная. В АйДаКемп — не более 8 человек на одного вожатого.",
      "<b>Конкретный образовательный результат</b> — в АйДаКемп каждый ребёнок к концу смены защищает свой проект: Python-программу, AI-приложение или 3D-модель.",
      "<b>Природа Московской области</b> — плюс 24–28°C без акклиматизации, хвойный лес, река Нара в 15 минутах. Для детей с аллергией — здесь комфортнее юга.",
    ]
  },
  {
    h2: "Где находится лагерь АйДаКемп",
    text: "Лагерь АйДаКемп расположен в Наро-Фоминском районе Московской области, на лесной территории санатория «Изумруд» — загородная база отдыха с бассейном и охраняемым периметром. Это классический загородный лагерь: корпуса, столовая, спортплощадки и вожатые на территории. До лагеря 66 км от МКАД по Киевскому шоссе — около часа."
  },
  {
    h2: "Условия проживания и питания",
    text: "Дети живут в корпусах санатория: светлые комнаты по 2–4 человека, раздельное проживание мальчиков и девочек. Питание 5 раз в день.",
    list: [
      "Комнаты по 2–4 человека, раздельное проживание",
      "Бассейн с ионизированной водой (без хлора)",
      "5-разовое питание, учёт аллергий",
      "Охрана территории 24/7",
      "Медработник на протяжении всей смены"
    ]
  },
  {
    h2: "Безопасность и документы",
    text: `АйДаКемп работает как лицензированный туроператор детского отдыха, в реестре — РТО ${STAT_RTO}. Родители получают договор и <a href='/stati/dokumenty-dlya-rebenka-v-lager/' class='text-orange-600 underline underline-offset-2'>полный пакет документов</a>. На смене дежурит медработник, охрана — круглосуточно. Если ребёнок приболеет — <a href='/stati/rebenok-zabolel-v-lagere/' class='text-orange-600 underline underline-offset-2'>разбираем, что происходит</a>.`
  },
  {
    h2: "Природа Подмосковья летом — почему это лучше Крыма и Сочи",
    text: "В Подмосковье летом те же +24…+28 °C что в Сочи, но без южного пекла и духоты. Дети не «горят» на солнце и не теряют дни смены на акклиматизацию после перелёта. Хвойный лес — естественный ионизатор воздуха, полезно детям с астмой и аллергией. Река Нара — в 15 минутах ходьбы от лагеря."
  },
  {
    h2: "Как добраться до детского лагеря из Москвы — 4 способа",
    text: "Выбирайте способ в зависимости от того, хотите ли проводить ребёнка сами или передать группе.",
    list: [
      "На машине — Киевское шоссе, 66 км от МКАД, 50–80 минут. Парковка для родителей в день заезда/выезда — бесплатно.",
      `Организованный трансфер — автобус от метро «Солнцево» в день заезда, ~${TRANSFER_PRICE_FMT} в один конец.`,
      "Электричка + такси — с Киевского вокзала до ст. «Бекасово-Сортировочное» (~65 минут), далее такси 10 минут. Подходит самостоятельным подросткам.",
      "Из Новой Москвы (Троицк, Коммунарка, Внуково) — 30–50 минут, не выезжая на МКАД.",
      "Из городов области (Одинцово, Подольск, Балашиха, Щёлково) — 60–110 минут на машине."
    ]
  },
  {
    h2: "Что вокруг лагеря",
    text: "Территория санатория «Изумруд» — 15 гектаров огороженного парка. В 15 минутах ходьбы — берег реки Нары. В 5 км — музей-усадьба «Архангельское-Тюриково», куда возим детей на экскурсии. В 12 км — Наро-Фоминск с магазинами и аптеками. Районная больница — 15 минут на машине, скорая едет ~20 минут."
  },
  {
    h2: "Что входит в стоимость путёвки в лагерь",
    text: "Никаких скрытых доплат. Точные суммы по каждой смене — на странице <a href=\"/ceny/\" class=\"text-orange-600 underline underline-offset-2\">лагерь на лето в Подмосковье цены</a>.",
    list: [
      "Питание 5 раз в день, с учётом аллергий",
      "Проживание в корпусах санатория «Изумруд», комнаты по 2–4 человека",
      "IT-занятия дважды в день в группах до 8 детей",
      "Бассейн с ионизированной водой (без хлора) — через день по расписанию",
      "Вечерние активности, квесты, спорт и командные игры",
      "Трансфер от м. Солнцево туда и обратно",
      "Медработник 24/7 и страхование Росгосстрах"
    ]
  },
  {
    h2: "Родительский чат и связь с ребёнком",
    text: "Первые дни в лагере — самые тревожные, поэтому связь организована так, чтобы вы были в курсе без лишнего стресса.",
    list: [
      "Telegram-группа для родителей каждой смены — с дня заезда",
      "Ежедневные фото в 21:00 — видите ребёнка живым и довольным",
      "Звонок ребёнку в назначенное время — расписание в чате",
      "В длинных сменах — визитный день для родителей",
      "При нестандартной ситуации звоним первыми"
    ]
  },
  {
    h2: "Официальные документы для записи в лагерь",
    text: "АйДаКемп — официальный лицензированный лагерь. Для записи понадобятся стандартные справки.",
    list: [
      `Лицензия на образовательную деятельность ${STAT_LICENSE} — для налогового вычета 13%`,
      "Договор-оферта: подписывается онлайн до оплаты",
      "Медицинская справка 086/у (или 079/у), прививочная карта",
      "Страховой полис Росгосстрах — оформляем сами",
      "Документы для налогового вычета (ст. 219 НК РФ) — после смены"
    ]
  },
  {
    h2: `Летние смены ${SEASON_YEAR} — даты`,
    text: `АйДаКемп работает весь летний сезон. Большой выбор: ${SEASON_SHIFTS_PHRASE} продолжительностью 7–14 дней. Принимаем детей и подростков 7–15 лет без опыта программирования.`,
    list: [
      `Смены всё лето — выбирайте удобные даты`,
      `Детский лагерь в Подмосковье летом: от ${PRICE_MIN} за смену`,
      `Трансфер от м. Солнцево включён (${TRANSFER_PRICE_FMT} отдельно)`,
      "Налоговый вычет 13% на образовательные услуги"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title={`Детские лагеря Подмосковья ${SEASON_YEAR}: цены для детей и подростков`}
  description={`Детские лагеря Подмосковья ${SEASON_YEAR}: детский IT-лагерь для детей и подростков, цены отдыха от ${PRICE_MIN}. Python, AI, бассейн, группы до 8 человек, проект за смену.`}
  h1={`Детские летние лагеря Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/detskiy-lager-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationEvent",
      "name": "Детский лагерь в Московской области — АйДаКемп 2026",
      "description": `Загородный детский лагерь в Московской области, 66 км от МКАД. IT-программирование, бассейн, 5-разовое питание, охрана. Лицензия Минобрнауки, группы до 8 чел. Смены ${SEASON_MONTHS_NOM} 2026.`,
      "startDate": "2026-05-30",
      "endDate": "2026-08-26",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": "Санаторий Изумруд, Наро-Фоминский район",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Наро-Фоминский район",
          "addressRegion": "Московская область",
          "addressCountry": "RU"
        },
        "geo": { "@type": "GeoCoordinates", "latitude": 55.265643, "longitude": 36.724185 }
      },
      "organizer": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "RUB",
        "price": "48000",
        "availability": "https://schema.org/InStock",
        "url": "https://aidacamp.ru/ceny"
      }
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детские летние лагеря Подмосковье ${SEASON_YEAR}`}
    subtitle={`${STAT_DISTANCE} от Москвы, Наро-Фоминский район. Лицензия Минобрнауки, малые группы, IT-программа — и ребёнок уезжает с собственным проектом. Смены лето ${SEASON_YEAR}, с 30 мая по 26 августа.`}
    breadcrumb="Детский лагерь Московская область"
    keywords={[`${STAT_DISTANCE} от Москвы по Киевскому шоссе, Санаторий Изумруд`, "Лицензия Минобрнауки, группы до 8 чел., медработник 24/7", "IT: Python, AI, Minecraft, 3D — свой проект к концу смены"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="Детский лагерь в Московской области АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />

  <!-- Детский лагерь по городам Подмосковья — топик-кластер -->
  <section class="mx-auto max-w-[1100px] px-5 pb-10 md:pb-12">
    <h2 class="text-[22px] font-bold text-slate-800 mb-5">Детский лагерь рядом с вашим городом Подмосковья</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <a href="/lager-naro-fominsk/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Наро-Фоминск</a>
      <a href="/lager-istra/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Истра</a>
      <a href="/lager-odintsovo/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Одинцово</a>
      <a href="/lager-podolsk/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Подольск</a>
      <a href="/lager-himki/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Химки</a>
      <a href="/lager-mytishchi/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Мытищи</a>
      <a href="/lager-klin/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Клин</a>
      <a href="/lager-troitsk/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Троицк</a>
      <a href="/lager-solnechnogorsk/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Солнечногорск</a>
      <a href="/lager-zvenigorod/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Звенигород</a>
      <a href="/lager-ruza/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Руза</a>
      <a href="/lager-serpuhov/" class="rounded-[12px] border border-slate-200 bg-white px-3 py-3 text-center text-base font-semibold text-slate-800 hover:border-primary hover:text-primary transition-colors">Серпухов</a>
    </div>
  </section>


  <FAQ extraItems={[
    { q: "Где находится и как добраться до АйДаКемп в Подмосковье?", a: `Наро-Фоминский район, 66 км от МКАД по Киевскому шоссе — 40–60 минут на машине. Организованный трансфер от м. Солнцево, ${TRANSFER_PRICE_FMT} в одну сторону.` },
    { q: "С какого возраста принимают?", a: "Принимаем детей от 7 до 17 лет: Scratch 7–9, Python и Minecraft 9–12, AI-проекты 12–17." },
    { q: "Чем IT-программа отличается от обычного отдыха в Подмосковье?", a: "Программирование дважды в день, итоговый хакатон, каждый ребёнок уходит с реальным проектом." },
    { q: `Сколько стоит детский лагерь в Подмосковье ${SEASON_YEAR}?`, a: `От ${PRICE_MIN} за 10 дней. Смены 10 и 13 дней: ${PRICE_S4}–${PRICE_MAX}. Включено: проживание, питание, IT-программа, бассейн. Налоговый вычет 13% возвращает до ${VYCHET_MAX}.` },
    { q: "Когда начинается смена в Подмосковье?", a: "С 30 мая по 26 августа. Летние смены: июнь с 10-го, июль с 1-го, август с 3-го." },
    { q: "Есть ли в детском лагере бассейн?", a: "Да, закрытый бассейн через день по расписанию." },
    { q: "Как оформить налоговый вычет?", a: `Путёвка — образовательная услуга. Возврат 13% НДФЛ, до ${VYCHET_MAX} на ребёнка.` },
    { q: "Какой рейтинг лагеря на Яндекс.Картах?", a: "5.0, более 200 отзывов от родителей — лучший рейтинг среди IT-лагерей Подмосковья." },
    { q: "Чем загородный лагерь лучше дневного городского?", a: "Полное погружение: смена среды, самостоятельность, общение с ровесниками. Дневной формат подходит дошкольникам, для подростков загородная смена даёт больше." },
    { q: "Можно ли купить путёвку онлайн?", a: "Да, бронирование через сайт. Предоплата 5 000 ₽, остаток за 14 дней до заезда." }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
