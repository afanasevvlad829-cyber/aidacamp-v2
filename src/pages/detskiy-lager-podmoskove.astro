---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Детские лагеря Московской области — как выбрать",
    text: "В Подмосковье работают сотни лагерей — от советских советских пионерских до современных тематических. Вот три критерия, которые реально важны, когда выбираешь между похожими вариантами.",
    list: [
      "<b>Лицензия Минобрнауки</b> — не бумажка для галочки. Она означает, что программа проверена, педагоги аттестованы, а родители могут получить налоговый вычет 13%. АйДаКемп работает по лицензии (реестровый номер РТО 025773), многие лагеря — нет.",
      "<b>Размер группы</b> — разница между 25 детьми в группе и 8 огромная. При 8 ребятах преподаватель знает каждого по имени и адаптирует задачу под уровень. В АйДаКемп — не более 8 человек на одного вожатого и преподавателя.",
      "<b>Конкретный образовательный результат</b> — «дети изучают IT» мало что значит. В АйДаКемп каждый ребёнок к концу смены защищает собственный проект: Python-программу, AI-приложение или 3D-модель. Это то, что остаётся после лагеря.",
      "<b>Природа Московской области</b> — плюс 24–28°C без акклиматизации, хвойный лес, река Нара в 15 минутах. Для детей с аллергией на юге — Подмосковье намного комфортнее Сочи и Крыма.",
    ]
  },
  {
    h2: "Где находится лагерь",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, на территории санатория «Изумруд». До лагеря 66 км от МКАД по Калужскому шоссе — около часа езды. Доступен трансфер из Москвы (опция)."
  },
  {
    h2: "Условия проживания и питания",
    text: "Дети живут в корпусах санатория: светлые комнаты по 2–4 человека, раздельное проживание мальчиков и девочек. Питание 5 раз в день — завтрак, второй завтрак, обед, полдник, ужин. На территории: бассейн с ионизированной водой, спортивные площадки, зоны отдыха.",
    list: [
      "Комнаты по 2–4 человека, раздельное проживание",
      "Бассейн с ионизированной водой (без хлора)",
      "5-разовое питание, учёт аллергий",
      "Охрана территории 24/7",
      "Медработник на протяжении всей смены"
    ]
  },
  {
    h2: "Безопасность и документы",
    text: "АйДаКемп работает как лицензированный туроператор детского отдыха (реестровый номер РТО 025773). Родители получают договор, страховку и полный пакет документов. На смене дежурит медработник, охрана работает круглосуточно. Связь с ребёнком — ежедневно."
  },
  {
    h2: "Как добраться из Москвы",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд». Координаты: 55.265643, 36.724185. На машине: по Калужскому шоссе, 66 км от МКАД. Трансфер: организуем из нескольких точек Москвы (платная опция)."
  },
  {
    h2: "Природа Подмосковья летом — почему это лучше Крыма и Сочи",
    text: "В Подмосковье летом те же +24…+28 °C что в Сочи, но без южного пекла, духоты и аллергенов. Дети не «горят» на солнце, не акклиматизируются 3 дня после перелёта и не теряют 2 из 10 дней смены на адаптацию. Хвойно-лиственные леса Наро-Фоминского района — естественный ионизатор воздуха, полезно детям с астмой и аллергией. Река Нара в 15 минутах ходьбы. Нет клещевого энцефалита (регион не эндемичный по СанПиН), но профилактика всё равно есть. Для сравнения: перелёт Москва-Анапа и обратно с ребёнком = 14–18 тыс. ₽ только транспорт, плюс 3 дня акклиматизации — в Подмосковье все эти деньги и время остаются в вашем кошельке и в смене."
  },
  {
    h2: "Как добраться до лагеря в Подмосковье — 4 способа",
    text: "Наш адрес удобен с любой стороны Москвы и для пригородов МО. Выбирайте способ в зависимости от того, хотите ли проводить ребёнка сами или передать группе.",
    list: [
      "На машине из Москвы — Калужское шоссе, 66 км от МКАД. Время — 50–80 минут в зависимости от трафика. Парковка для родителей в день заезда/выезда — бесплатно.",
      "Организованный трансфер — автобус от метро «Солнцево» (Москва) и «Саларьево» в день заезда. Сопровождающий едет до самого лагеря. Оплата отдельно, ~1 500 ₽ в один конец.",
      "Электричка + такси — с Киевского вокзала до ст. «Бекасово-Сортировочное» (~65 минут), далее такси 10 минут до территории. Подходит для самостоятельных подростков 12–14 лет.",
      "Из Новой Москвы (Троицк, Коммунарка, Внуково) — 30–50 минут по местным дорогам, не выезжая на МКАД. Для жителей ЮЗАО и ТиНАО удобнее всего.",
      "Из областных городов (Одинцово, Подольск, Балашиха, Щёлково) — на машине 60–110 минут. Для жителей Одинцово — вообще 40 минут."
    ]
  },
  {
    h2: "Что вокруг лагеря в Подмосковье",
    text: "Территория санатория «Изумруд» — 15 гектаров огороженного парка с соснами, липами и дубами. В 15 минутах ходьбы — пологий берег реки Нары. В 5 км — музей-усадьба «Архангельское-Тюриково», куда мы возим детей на экскурсии в рамках культурной программы. В 12 км — Наро-Фоминск с магазинами и аптеками, куда при необходимости можно оперативно выехать. Ближайшая районная больница (Наро-Фоминская ЦРБ) — 15 минут на машине, скорая едет до нас ~20 минут. Всё это делает Подмосковный лагерь предсказуемо безопасным: каждая точка инфраструктуры — на расстоянии отклика."
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title="Детский лагерь Московская область 2026 — детские лагеря Подмосковья от 48 000 ₽ | АйДаКемп"
  description="Детский лагерь в Московской области, 66 км от МКАД. Лицензия Минобрнауки, малые группы до 8 чел., IT-программа, бассейн. Смены июнь–август 2026."
  h1="Детский лагерь в Московской области — АйДаКемп"
  canonical="https://aidacamp.ru/detskiy-lager-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Где находится детский лагерь в Подмосковье АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "Наро-Фоминский район, 66 км от МКАД по Калужскому шоссе (А-101). Территория санатория «Изумруд»." } },
        { "@type": "Question", "name": "Как добраться до лагеря в Подмосковье?", "acceptedAnswer": { "@type": "Answer", "text": "На машине по А-101, 40–60 минут. Организованный трансфер от м. Солнцево, 2 500 ₽ в одну сторону." } },
        { "@type": "Question", "name": "Чем отличается IT-лагерь от обычного лагеря в Подмосковье?", "acceptedAnswer": { "@type": "Answer", "text": "Программирование 2 раза в день, итоговый хакатон, каждый уходит с реальным проектом." } },
        { "@type": "Question", "name": "Сколько стоит детский лагерь в Подмосковье 2026?", "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Включено всё: питание, IT, бассейн." } }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationEvent",
      "name": "Детский лагерь в Московской области — АйДаКемп 2026",
      "description": "Загородный детский лагерь в Московской области, 66 км от Москвы. IT-программирование, бассейн, 5-разовое питание, охрана. Лицензия Минобрнауки, группы до 8 чел. Смены июнь–август 2026.",
      "startDate": "2026-05-30",
      "endDate": "2026-08-26",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": "Санаторий Изумруд, Наро-Фоминский район",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Наро-Фоминский район",
          "addressRegion": "Московская область",
          "addressCountry": "RU"
        },
        "geo": { "@type": "GeoCoordinates", "latitude": 55.265643, "longitude": 36.724185 }
      },
      "organizer": { "@type": "Organization", "name": "АйДаКемп", "url": "https://aidacamp.ru" },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "RUB",
        "price": "48000",
        "availability": "https://schema.org/InStock",
        "url": "https://aidacamp.ru/ceny"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Детские лагеря Московской области — как выбрать лучший?", "acceptedAnswer": { "@type": "Answer", "text": "Три важных критерия: (1) Лицензия Минобрнауки — гарантирует проверенную программу и право на налоговый вычет 13%. (2) Размер группы — до 8 детей на педагога, а не 25. (3) Конкретный результат — ребёнок уезжает с собственным проектом, а не просто «побыл в лагере». АйДаКемп соответствует всем трём критериям." } },
        { "@type": "Question", "name": "Где находится детский лагерь в Московской области АйДаКемп?", "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп расположен в Наро-Фоминском районе Московской области, санаторий «Изумруд». 66 км от МКАД по Калужскому шоссе (А-101). Координаты: 55.265643, 36.724185. Трансфер из Москвы от метро «Солнцево» — 2 500 ₽." } },
        { "@type": "Question", "name": "Летние лагеря Московской области — что включено в цену?", "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп цена смены включает проживание в комнатах 2–4 чел., 5-разовое питание, полную IT-программу (Python / AI / Minecraft / 3D), бассейн, вожатых и медработника 24/7, ноутбуки. Без скрытых доплат." } },
        { "@type": "Question", "name": "Чем детский лагерь в Московской области лучше, чем лагерь на море?", "acceptedAnswer": { "@type": "Answer", "text": "Нет акклиматизации и перелёта. Летом в Подмосковье +24–28°C — комфортно без южной духоты. Хвойные леса, чистый воздух. Экономия на транспорте 14–18 тыс. ₽ идёт в счёт смены. До Москвы — 40–60 минут на машине." } },
        { "@type": "Question", "name": "Сколько стоит детский лагерь в Московской области на лето 2026?", "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп: от 48 000 ₽ за 7 дней — проживание, питание, IT-программа, бассейн. Смены 10–14 дней: 74 900–95 000 ₽. Налоговый вычет 13% возвращает до 14 300 ₽ на образовательную часть." } }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь в Московской области — АйДаКемп"
    subtitle={`${STAT_DISTANCE} от Москвы, Наро-Фоминский район. Лицензия Минобрнауки, малые группы, IT-программа — и ребёнок уезжает с собственным проектом.`}
    breadcrumb="Детский лагерь Московская область"
    keywords={[`${STAT_DISTANCE} от Москвы по Калужскому шоссе, Санаторий Изумруд`, "Лицензия Минобрнауки, группы до 8 чел., медработник 24/7", "IT: Python, AI, Minecraft, 3D — свой проект к концу смены"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="Детский лагерь в Московской области АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
