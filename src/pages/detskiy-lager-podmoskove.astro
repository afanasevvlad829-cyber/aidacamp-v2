---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE, CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Где находится лагерь",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, на территории санатория «Изумруд». До лагеря 66 км от МКАД по Калужскому шоссе — около часа езды. Доступен трансфер из Москвы (опция)."
  },
  {
    h2: "Условия проживания и питания",
    text: "Дети живут в корпусах санатория: светлые комнаты по 2–4 человека, раздельное проживание мальчиков и девочек. Питание 5 раз в день — завтрак, второй завтрак, обед, полдник, ужин. На территории: бассейн с ионизированной водой, спортивные площадки, зоны отдыха.",
    list: [
      "Комнаты по 2–4 человека, раздельное проживание",
      "Бассейн с ионизированной водой (без хлора)",
      "5-разовое питание, учёт аллергий",
      "Охрана территории 24/7",
      "Медработник на протяжении всей смены"
    ]
  },
  {
    h2: "Безопасность и документы",
    text: "АйДаКемп работает как лицензированный туроператор детского отдыха (реестровый номер РТО 025773). Родители получают договор, страховку и полный пакет документов. На смене дежурит медработник, охрана работает круглосуточно. Связь с ребёнком — ежедневно."
  },
  {
    h2: "Как добраться из Москвы",
    text: "Адрес: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд». Координаты: 55.265643, 36.724185. На машине: по Калужскому шоссе, 66 км от МКАД. Трансфер: организуем из нескольких точек Москвы (платная опция)."
  },
  {
    h2: "Природа Подмосковья летом — почему это лучше Крыма и Сочи",
    text: "В Подмосковье летом те же +24…+28 °C что в Сочи, но без южного пекла, духоты и аллергенов. Ребёнок не «горит» на солнце, не акклиматизируется 3 дня после перелёта и не теряет 2 из 10 дней смены на адаптацию. Хвойно-лиственные леса Наро-Фоминского района — естественный ионизатор воздуха, полезно детям с астмой и аллергией. Река Нара в 15 минутах ходьбы. Нет клещевого энцефалита (регион не эндемичный по СанПиН), но профилактика всё равно есть. Для сравнения: перелёт Москва-Анапа и обратно с ребёнком = 14–18 тыс. ₽ только транспорт, плюс 3 дня акклиматизации — в Подмосковье все эти деньги и время остаются в вашем кошельке и в смене."
  },
  {
    h2: "Как добраться до лагеря в Подмосковье — 4 способа",
    text: "Наш адрес удобен с любой стороны Москвы и для пригородов МО. Выбирайте способ в зависимости от того, хотите ли проводить ребёнка сами или передать группе.",
    list: [
      "На машине из Москвы — Калужское шоссе, 66 км от МКАД. Время — 50–80 минут в зависимости от трафика. Парковка для родителей в день заезда/выезда — бесплатно.",
      "Организованный трансфер — автобус от метро «Солнцево» (Москва) и «Саларьево» в день заезда. Сопровождающий едет до самого лагеря. Оплата отдельно, ~1 500 ₽ в один конец.",
      "Электричка + такси — с Киевского вокзала до ст. «Бекасово-Сортировочное» (~65 минут), далее такси 10 минут до территории. Подходит для самостоятельных подростков 12–14 лет.",
      "Из Новой Москвы (Троицк, Коммунарка, Внуково) — 30–50 минут по местным дорогам, не выезжая на МКАД. Для жителей ЮЗАО и ТиНАО удобнее всего.",
      "Из областных городов (Одинцово, Подольск, Балашиха, Щёлково) — на машине 60–110 минут. Для жителей Одинцово — вообще 40 минут."
    ]
  },
  {
    h2: "Что вокруг лагеря в Подмосковье",
    text: "Территория санатория «Изумруд» — 15 гектаров огороженного парка с соснами, липами и дубами. В 15 минутах ходьбы — пологий берег реки Нары. В 5 км — музей-усадьба «Архангельское-Тюриково», куда мы возим детей на экскурсии в рамках культурной программы. В 12 км — Наро-Фоминск с магазинами и аптеками, куда при необходимости можно оперативно выехать. Ближайшая районная больница (Наро-Фоминская ЦРБ) — 15 минут на машине, скорая едет до нас ~20 минут. Всё это делает Подмосковный лагерь предсказуемо безопасным: каждая точка инфраструктуры — на расстоянии отклика."
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title="Детский лагерь в Подмосковье 2026 с проживанием — IT-программа | АйДаКемп"
  description="Детский летний лагерь в Подмосковье, 66 км от Москвы. IT-программирование, бассейн, 5-разовое питание, охрана 24/7. Смены июнь–август 2026, от 48 000 ₽."
  h1="Детский лагерь в Подмосковье с IT-программой"
  canonical="https://aidacamp.ru/detskiy-lager-podmoskove"
>
  <LandingHero slot="hero"
    h1="Детский лагерь в Подмосковье с IT-программой"
    subtitle={`${STAT_DISTANCE} от Москвы. Бассейн, питание, охрана — и IT-проект, который ребёнок сделает сам.`}
    breadcrumb="Детский лагерь Подмосковье"
    keywords={[`${STAT_DISTANCE} от Москвы по Калужскому шоссе, Санаторий Изумруд`, "Бассейн, 5-разовое питание, комнаты 2–4 человека", "Охрана 24/7, медработник, лицензированный туроператор"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="Детский лагерь в Подмосковье АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
