---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Одинцово — рядом с МГУ, Сколтехом и Немчиновкой",
    text: "Одинцово — западный пригород Москвы, откуда рукой подать до МГУ, Сколтеха и академической Немчиновки. IT-семьи из Одинцово хорошо знают цену образованию. АйДаКемп — лагерь, который находится буквально по соседству: по тому же Киевскому шоссе, всего ~40 минут. Ребёнок едет не в дальние края, а в следующий район — и возвращается с реальным IT-проектом."
  },
  {
    h2: "Маршрут из Одинцово в АйДаКемп — 40 км, ~40 мин",
    text: "Одинцово — ближайший к АйДаКемп подмосковный город среди всех наших гео-страниц. До лагеря 40 км по Киевскому шоссе без московских пробок: из Одинцово прямо на запад.",
    list: [
      "На машине: Одинцово → Киевское шоссе → Апрелевка, ~40 км, около 40 минут без пробок",
      "По А-107 (Большая бетонка): Одинцово → Наро-Фоминск — альтернативный маршрут, ~40 мин",
      "Электричка: Белорусское направление Одинцово → Апрелевка (~20 мин), от станции такси ~15 мин",
      "Трансфер от м. Солнцево бесплатно — из Одинцово туда ~15 мин на машине"
    ]
  },
  {
    h2: "Трансфер из Одинцово в лагерь",
    text: "Бесплатный трансфер лагеря отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Одинцово до точки сбора — около 15 минут на машине. Многие семьи из Одинцово просто привозят ребёнка напрямую в лагерь — 40 км, полчаса.",
    list: [
      "Трансфер бесплатный, от м. Солнцево в день заезда и обратно в день отъезда",
      "Из Одинцово до м. Солнцево — ~15 мин на машине",
      "Альтернатива: привезти ребёнка прямо в лагерь на машине — 40 км, ~40 мин"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Одинцово",
    text: "АйДаКемп — лицензированная образовательная организация. Родители из Одинцово оформляют налоговый вычет точно так же, как и москвичи: через личный кабинет налоговой на nalog.ru.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽",
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Что ждёт школьников в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Ребята 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Почему родители из Одинцово выбирают АйДаКемп",
    text: "Семьи из Одинцово добираются до нас быстрее, чем из большинства районов Москвы. Это меняет всё:",
    list: [
      "40 мин от Одинцово — ближайший IT-лагерь с проживанием из западного Подмосковья",
      "Никакой акклиматизации — климат такой же, ребёнок сразу в ритм",
      "Можно заехать в любой день смены — проведать или привезти забытые вещи",
      "Самостоятельный заезд без трансфера — просто привезти на машине, 40 мин"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽ (налоговый вычет ~2 800 ₽)",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (налоговый вычет до 5 434 ₽)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽ (налоговый вычет ~5 200 ₽)",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽ (налоговый вычет ~4 800 ₽)",
      "Трансфер от м. Солнцево — бесплатно"
    ]
  },
  {
    h2: "Отзывы семей из Одинцово",
    text: "В АйДаКемп едут ребята из Одинцово, Голицыно, Кубинки и других городов западного Подмосковья. Вот что пишут родители:",
    list: [
      "«Из Одинцово до точки сбора на Солнцево — 15 минут, а потом автобус прямо в лагерь. Удобнее не придумать» — Елена, мама Артёма, 10 лет",
      "«Дочь вернулась с лагеря и сразу показала подругам свою игру на Python — она теперь «та самая, которая умеет программировать»» — Ирина, Одинцово",
      "«Ехать от Одинцово всего 40 минут — мы сами отвезли и забрали. Никаких пробок через Москву, всё просто» — Алексей, Голицыно"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Одинцово 2026 — АйДаКемп"
  description="IT-лагерь рядом с Одинцово: 40 км по Киевскому шоссе, ~40 минут. Трансфер от м. Солнцево бесплатно. Python, AI, Minecraft для школьников 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Одинцово"
  canonical="https://aidacamp.ru/lager-odintsovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Одинцово до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Одинцово — 40 км по Киевскому шоссе, около 40 минут на машине. Или электричка Белорусского направления Одинцово → Апрелевка (~20 мин), от Апрелевки такси ~15 мин." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Одинцово?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Одинцово нет. Но бесплатный трансфер от м. Солнцево — из Одинцово туда 15 минут на машине. Многие родители из Одинцово просто привозят ребёнка напрямую в лагерь — 40 км, полчаса." }
        },
        {
          "@type": "Question",
          "name": "Можно ли вернуть часть стоимости путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, налоговый вычет 13%. Для Одинцово это работает так же, как для москвичей: документы через nalog.ru. Возврат от ~2 800 ₽ (7-дневная смена) до 5 434 ₽ (14-дневная)." }
        },
        {
          "@type": "Question",
          "name": "Для каких ребят подходит лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для школьников 7–15 лет. Опыт программирования не нужен: группы формируются по уровню — начинающие, средний, продвинутые. Занятия в группах до 8 человек." }
        },
        {
          "@type": "Question",
          "name": "Какие IT-треки доступны в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — ребёнок выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." }
        },
        {
          "@type": "Question",
          "name": "Можно ли оплатить частями?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Оплата в два этапа: 50% при бронировании, оставшиеся 50% — за 3 недели до заезда. Стоимость смен от 48 000 ₽." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Одинцово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 40 км от Одинцово по Киевскому шоссе. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-odintsovo"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Одинцово", "item": "https://aidacamp.ru/lager-odintsovo/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Одинцово"
    subtitle="IT-лагерь в Наро-Фоминском районе — 40 км от Одинцово по Киевскому шоссе, ~40 мин. Трансфер от м. Солнцево бесплатно."
    breadcrumb="Лагерь из Одинцово"
    keywords={["40 км от Одинцово (~40 мин), трансфер от м. Солнцево бесплатно", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Одинцово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
