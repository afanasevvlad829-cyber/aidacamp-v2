---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S3, VYCHET_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { PAYMENT_SPLIT, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Летний лагерь рядом с Одинцово — IT-смена в соседнем районе",
    text: "Летний лагерь рядом с Одинцово — это АйДаКемп: ехать всего ~40 минут на запад по Киевскому шоссе, без московских пробок. Это западный пригород Москвы, откуда рукой подать до МГУ, Сколтеха и академической Немчиновки, и наш IT-лагерь находится буквально по соседству. Ребёнок едет не в дальние края, а в следующий район — и возвращается с реальным IT-проектом, который не стыдно показать в школе. Для местных семей и всего Одинцовского округа это полноценный выездной отдых, а не городской дневной или спортивный формат: путёвка по фиксированной цене на каникулы, и ребёнок занят все 10–13 дней."
  },
  {
    h2: "Как доехать из Одинцово в АйДаКемп",
    text: "Дорога занимает около 40 минут на запад по Киевскому шоссе, без московских пробок — сам лагерь в 66 км от МКАД (~1 час), но из Одинцово ближе: не нужно выезжать на МКАД. Трансфер (2 000 ₽ в один конец, с сопровождающим) идёт от м. Солнцево в день заезда и обратно в день отъезда — от точки сбора до Одинцово около 15 минут на машине. Многие семьи привозят ребёнка сразу в лагерь на своей машине — это тоже около 40 минут.",
    list: [
      "На машине: по Киевскому шоссе на запад, ~40 минут без пробок",
      "Электричка: ст. Нара (~1 ч 10 мин), далее такси ~20 мин, или ст. Башкино (~8 км до лагеря)",
      "Трансфер лагеря — 2 000 ₽ в один конец, от м. Солнцево до Одинцово ~15 минут на машине"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Одинцово",
    text: "АйДаКемп — лицензированная образовательная организация. Родители из Одинцово оформляют налоговый вычет точно так же, как и москвичи: через личный кабинет налоговой на nalog.ru.",
    list: [
      `Смена 10 дней (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 13 дней (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Что ждёт школьников в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Ребята 7–15 лет (2–9 класс) выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры и творческие мастер-классы по вечерам — живое общение в команде без телефонов",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд» в сосновом лесу — вопрос безопасности закрыт полностью",
      "Итоговый хакатон — каждый берёт ответственность за свой проект и защищает его перед всеми"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: `В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере. Забронировать место можно онлайн — рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей из Одинцово и соседних районов.`,
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день у ребёнка"
    ]
  },
  {
    h2: "Почему родители из Одинцово выбирают АйДаКемп",
    text: "Семьи из Одинцово добираются до нас быстрее, чем из большинства районов Москвы. Это меняет всё:",
    list: [
      "~40 мин от Одинцово — один из ближайших IT-лагерей с проживанием из западного Подмосковья",
      "Никакой акклиматизации — климат как дома, ребёнок сразу в ритм",
      "Можно заехать в любой день смены — проведать или привезти забытые вещи",
      "Самостоятельный заезд без трансфера — просто привезти на машине, около 40 мин"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены и наличие мест`,
    text: "Августовские смены ещё открыты — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней, ${PRICE_S21} (налоговый вычет ~${VYCHET_S21})`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2} (налоговый вычет ~${VYCHET_S2})`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      "Трансфер от м. Солнцево — 2 000 ₽",
      PAYMENT_SPLIT
    ]
  },
  {
    h2: "Отзывы семей из Одинцово",
    text: "К нам едут ребята из Голицыно, Кубинки и других городов западного Подмосковья. Вот что пишут их родители:",
    list: [
      "«Из Одинцово до точки сбора на Солнцево — 15 минут, а потом автобус прямо в лагерь, всего 2 000 ₽. Удобнее не придумать» — Елена, мама Артёма, 10 лет",
      "«Дочь вернулась с лагеря и сразу показала подругам свою игру на Python — она теперь «та самая, которая умеет программировать»» — Ирина, Одинцово",
      "«Ехать от Одинцово около 40 минут — мы сами отвезли и забрали. Никаких пробок через Москву, всё просто» — Алексей, Голицыно"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Летний детский лагерь рядом с Одинцово ${SEASON_YEAR} — IT-смены для школьников | АйДаКемп`}
  description={`~40 минут от Одинцово — детский IT-лагерь в Подмосковье. Налоговый вычет до ${VYCHET_MAX}, Python и AI для ребят 7–15 лет. Августовские смены открыты. Трансфер от м. Солнцево 2 000 ₽. Цены на ${SEASON_YEAR}.`}
  h1="Лагерь рядом с Одинцово — 40 км"
  canonical="https://aidacamp.ru/lager-odintsovo"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Одинцово до лагеря АйДаКемп?", a: "Около 40 минут на машине по Киевскому шоссе на запад, без выезда на МКАД. Сам лагерь — 66 км от МКАД (~1 час). Можно и на электричке: ст. Нара (~1 ч 10 мин), далее такси ~20 мин." },
    { q: "Есть ли трансфер из Одинцово?", a: "Прямого трансфера из Одинцово нет. Есть трансфер лагеря от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим; до метро ~15 минут на машине. Многие родители просто привозят ребёнка напрямую в лагерь — около 40 минут." },
    { q: "Можно ли заехать в лагерь в середине смены?", a: "Да. Близость лагеря (около 40 минут от Одинцово) позволяет родителям проведывать ребят или привозить забытые вещи во время смены." },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%. Оформляется так же, как для москвичей: документы через nalog.ru. Возврат от ~${VYCHET_S4} (10-дневная смена) до ${VYCHET_MAX} (13-дневная).` },
    { q: "Для каких ребят подходит лагерь?", a: "Для школьников 7–15 лет. Опыт программирования не нужен — принимаем с нуля. Занятия в группах до 8 человек." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — ребёнок выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Одинцово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, около 40 минут от Одинцово по Киевскому шоссе. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-odintsovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь рядом с Одинцово — 40 км"
    subtitle="IT-лагерь в Наро-Фоминском районе — около 40 минут от Одинцово по Киевскому шоссе. Трансфер от м. Солнцево 2 000 ₽."
    breadcrumb="Лагерь из Одинцово"
    keywords={["~40 мин от Одинцово, трансфер от м. Солнцево 2 000 ₽", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Одинцово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-base text-slate-500 mt-2">
      Смотрите также: <a href="/" class="text-primary hover:underline">IT-лагерь рядом с Одинцово</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты {SEASON_YEAR}</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Как быстро добраться из Одинцово в АйДаКемп?</h2>
  <p><strong>Время:</strong> около 40 минут на машине по Киевскому шоссе на запад из Одинцово, без выезда на МКАД и пробок.</p>
  <p><strong>От МКАД:</strong> сам лагерь — 66 км от МКАД по Киевскому шоссе (~1 час).</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, 2 000 ₽ в один конец (из Одинцово до Солнцево ~15 минут).</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
