---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Одинцово",
    text: "АйДаКемп расположен в Наро-Фоминском районе — всего 35 км от Одинцово по Киевскому шоссе, около 40 минут. Это самый короткий маршрут среди всех городов Подмосковья. Удобно и то, что ехать не через Москву: от Одинцово прямо на запад по Киевскому шоссе — и вы у нас. Организованный трансфер отправляется от м. Солнцево (15 минут от Одинцово), откуда автобус доставит прямо в лагерь."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Одинцово",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в Minecraft, Roblox или Python-разработку"
    ]
  },
  {
    h2: "Почему родители из Одинцово выбирают АйДаКемп",
    text: "Семьи из Одинцово добираются до нас быстрее, чем из большинства районов Москвы. Это меняет всё:",
    list: [
      "40 минут от Одинцово — это ближайший IT-лагерь с проживанием",
      "Никакой акклиматизации — климат такой же, ребёнок сразу в ритм",
      "Можно заехать в любой день смены — проведать или привезти забытые вещи",
      "Самостоятельный заезд без трансфера — просто привезти на машине"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Одинцово",
    text: "В АйДаКемп едут дети из Одинцово, Голицыно, Кубинки и других городов западного Подмосковья. Вот что пишут родители:",
    list: [
      "«Из Одинцово до точки сбора на Солнцево — 15 минут, а потом автобус прямо в лагерь. Удобнее не придумать» — Елена, мама Артёма, 10 лет",
      "«Дочь вернулась с лагеря и сразу показала подругам свою игру на Python — она теперь “та самая, которая умеет программировать”» — Ирина, Одинцово",
      "«Ехать от Одинцово всего 40 минут — мы сами отвезли и забрали. Никаких пробок через Москву, всё просто» — Алексей, Голицыно"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь рядом с Одинцово 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Одинцово: 35 км по Киевскому шоссе, ~40 минут. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Одинцово"
  canonical="https://aidacamp.ru/lager-odintsovo"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Одинцово до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Одинцово — 35 км по Киевскому шоссе, около 40 минут на машине. Или доехать до м. Солнцево (10–15 мин.) и пересесть на организованный трансфер АйДаКемп (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Для каких детей подходит лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 7–15 лет. Опыт программирования не нужен: группы формируются по уровню — начинающие, средний, продвинутые. Занятия в группах до 8 человек." }
        },
        {
          "@type": "Question",
          "name": "Какие IT-треки доступны в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — ребёнок выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." }
        },
        {
          "@type": "Question",
          "name": "Можно ли оплатить частями?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Оплата в два этапа: 50% при бронировании, оставшиеся 50% — за 3 недели до заезда. Стоимость смен от 48 000 ₽." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Одинцово — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 35 км от Одинцово по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-odintsovo"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Одинцово"
    subtitle="IT-лагерь в Наро-Фоминском районе — 35 км от Одинцово по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Одинцово"
    keywords={["35 км от Одинцово по Киевскому шоссе (~40 мин)", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Одинцово — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
