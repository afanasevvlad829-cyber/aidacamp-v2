---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { STAT_RTO } from '../data/contacts';

const sections = [
  {
    h2: "Как добраться",
    text: "Наш лагерь стоит на Киевском шоссе (М-3). Новая Москва растёт вдоль соседнего Калужского шоссе (А-101) — трассы соединяются рядом, без заезда в центр. Из Бутово, Щербинки, Коммунарки и Московского — 40–60 км, около 40–55 минут в пути. Ближе всего — Троицк.",
    list: [
      "Щербинка — около 40 минут по М-3",
      "Троицк и Коммунарка — 40–50 минут, почти без пробок",
      "Московский — ближе всего к выезду на трассу",
      "Довезти самому или посадить на трансфер от м. Солнцево"
    ]
  },
  {
    h2: "Лагерь и IT-программа",
    text: "АйДаКемп — IT-лагерь для школьников 7–15 лет. Ребята выбирают направление: Python, AI и нейросети, Minecraft Education, Roblox Studio или 3D-моделирование. Занятия дважды в день, группы до 8 человек, преподаватели-практики.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, активности каждый день",
      "5-разовое питание, комнаты по 2–4 человека, санузел в комнате",
      "Медработник и охрана на территории круглосуточно",
      "Итог смены — проект на хакатоне, фото- и видеоотчёт родителям",
      `Договор, лицензия туроператора РТО ${STAT_RTO}`
    ]
  },
  {
    h2: "Кто к нам приезжает",
    text: "Много семей из Бутово, Щербинки, Коммунарки и Московского — школьники 1–8 класса, которым интересны технологии. Родители нередко сами в IT и хотят «умный» отдых вместо игр в телефоне: лагерь для них — способ занять ребёнка делом, а не вывезти за город.",
    list: [
      "Без опыта программирования — начинаем с нуля, за смену доходим до проекта",
      "С опытом — продвинутые задачи и реальный результат",
      "Любят игры — учим создавать их, а не только играть"
    ]
  },
  {
    h2: "Смены и стоимость",
    text: `Летом ${SEASON_YEAR} на август открыты смены: от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). В цену входят проживание, питание, IT-программа, бассейн и все мероприятия смены.`,
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней, ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Трансфер и маршрут",
    text: "Организованный трансфер отправляется от м. Солнцево (15 минут на метро от Аннино или Улицы Скобелевской). Либо привозите сами — прямо по Киевскому шоссе, без заездов в центр.",
    list: [
      "Трансфер: м. Солнцево → к нам, 2 000 ₽ в одну сторону",
      "На метро из Бутово до Солнцево — 2–3 остановки, 10–15 минут",
      "На машине из Бутово/Коммунарки — прямо по М-3, навигатор: 55.265643, 36.724185",
      "Щербинка — ближайший старт для тех, кто едет на машине"
    ]
  },
  {
    h2: "Вожатые и команда",
    text: "На группу — один преподаватель на 6–8 ребят, конкурсный отбор перед сезоном. Медработник на территории круглосуточно, фото в Telegram-канале каждый день в 21:00 — вы видите лицо ребёнка ежедневно.",
    list: [
      "Конкурсный отбор вожатых — практикующие IT-специалисты",
      "Ежедневные фото в 21:00 — вы всегда в курсе"
    ]
  },
  {
    h2: `Записаться на лето ${SEASON_YEAR}`,
    text: `Свободные места остаются на Смену 3 (${DATES_SHORT_S3}) и Смену 4 (${DATES_SHORT_S4}) — бронируйте заранее, мест немного. Оставьте заявку — менеджер свяжется в течение 10 минут в рабочее время.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский IT-лагерь в Новой Москве"
  description={`IT-лагерь в Новой Москве, в 40–60 км от Щербинки по Киевскому шоссе. Python, AI, Minecraft, Roblox — детям 7–15 лет. Смены от ${PRICE_MIN}, бассейн, 5-разовое питание, трансфер от метро.`}
  h1="Летний детский лагерь в Новой Москве"
  canonical="https://aidacamp.ru/lager-novaya-moskva"
  breadcrumbLabel="Лагерь рядом со Щербинкой"
>
  <Fragment slot="head">
    <CourseSchema
      name="Летний IT-лагерь рядом со Щербинкой — АйДаКемп"
      description="IT-лагерь в 40–60 км от Щербинки по Киевскому шоссе (М-3). Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-novaya-moskva"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "АйДаКемп — IT-лагерь для детей",
  "url": "https://aidacamp.ru",
  "logo": "https://aidacamp.ru/logo.png",
  "description": "Детский IT-лагерь для детей 7–15 лет. Python, AI, Minecraft, Roblox, 3D-моделирование.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "RU",
    "addressRegion": "Московская область",
    "addressLocality": "Наро-Фоминск"
  },
  "educationalProgram": [
    {
      "@type": "EducationalOccupationalProgram",
      "name": "Python для детей",
      "description": "Программирование на Python с нуля до готового IT-проекта"
    },
    {
      "@type": "EducationalOccupationalProgram",
      "name": "AI и нейросети",
      "description": "Искусственный интеллект и машинное обучение для подростков"
    },
    {
      "@type": "EducationalOccupationalProgram",
      "name": "Minecraft Education & Roblox Studio",
      "description": "Создание игр и миров в Minecraft и Roblox"
    }
  ],
  "offers": {
    "@type": "Offer",
    "priceCurrency": "RUB",
    "price": PRICE_MIN.replace(/[^\d]/g, ''),
    "availability": "https://schema.org/InStock",
    "description": "Смена 4 на 10 дней включает проживание, питание, IT-программу, бассейн"
  },
  "contact": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "telephone": "+7"
  }
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний детский лагерь в Новой Москве"
    subtitle="IT-лагерь в 40–60 км от Бутово, Щербинки и Коммунарки — по Киевскому шоссе (М-3), без заезда в центр. Python, AI, Minecraft, Roblox для детей 7–15 лет."
    breadcrumb="Лагерь рядом со Щербинкой"
    keywords={["Щербинка — около 40 минут по трассе М-3", "IT-программа: Python, AI, Minecraft, Roblox", `Смены от 10 до 13 дней, от ${PRICE_MIN}`]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний детский лагерь рядом со Щербинкой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как далеко лагерь от Щербинки?", a: "Около 40–60 км прямо по Киевскому шоссе (М-3), примерно 40–55 минут в пути. Организованный трансфер от м. Солнцево — 15–20 мин. от Щербинки, Бутово и Коммунарки." },
    { q: "Нужно ли ехать через центр Москвы?", a: "Нет. Из Щербинки, Бутово и Троицка можно ехать напрямую по Киевскому шоссе, не заезжая в центр. Новая Москва граничит с Наро-Фоминским районом, где расположен лагерь." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает при регистрации. Группы до 8 человек, преподаватели — практикующие IT-специалисты." },
    { q: "Можно ли отвезти ребёнка самостоятельно?", a: "Да. Привезти самостоятельно к точке сбора у лагеря или воспользоваться трансфером от м. Солнцево (2 000 ₽). Адрес: Наро-Фоминский район, посёлок Мальчики, санаторий «Изумруд»." }
  ]} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до нас</a>
    </p>
  </div>

<section class="internal-links-section" style="background: linear-gradient(135deg, #f8f9ff 0%, #fff9f5 100%); padding: 2.5rem 1.5rem; margin: 2rem 0; border-radius: 12px; border-left: 4px solid #ff6b35;">
  <h2 style="font-size: 1.3rem; margin-bottom: 1rem; color: #1a1a1a;">Выбрать программу и смену</h2>
  <p style="margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.6; color: #333;">
    Все смены работают по одному принципу: 2 занятия в день, бассейн, спорт, хакатон в конце. Разница — в направлении (Python, AI, Minecraft, Roblox, 3D), датах и длительности.
  </p>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <a href="/stati/programma-it-lagerya/" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #ff6b35; color: #ff6b35; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → Все IT-программы и направления обучения
    </a>
    <a href="/ceny/" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #4a90e2; color: #4a90e2; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → График смен на лето {SEASON_YEAR}
    </a>
    <a href="/ceny/" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #2ecc71; color: #2ecc71; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → Стоимость смен и способы оплаты
    </a>
  </div>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
