---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Новой Москвы",
    text: "Новая Москва и АйДаКемп стоят на одном шоссе — Киевском (M-3). Из Бутово, Щербинки, Коммунарки, Московского до лагеря прямо по M-3, без пробок 40–60 минут. Никаких разворотов через МКАД и центр города. Из всех районов Москвы жители Новой Москвы добираются до нас быстрее всего.",
    list: [
      "Бутово / Щербинка — 40–50 минут по M-3 прямо",
      "Коммунарка / Московский — 45–55 минут по Киевскому шоссе",
      "Троицк — 35–45 минут, практически без пробок",
      "Можно довезти ребёнка самостоятельно или посадить на трансфер из Москвы (м. Солнцево)"
    ]
  },
  {
    h2: "Лагерь АйДаКемп — что это",
    text: "АйДаКемп — IT-лагерь для детей 7–15 лет. Дети выбирают направление: Python, AI и нейросети, Minecraft Education, Roblox Studio или 3D-моделирование. Занятия дважды в день, группы до 8 человек, преподаватели-практики.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, активности каждый день",
      "5-разовое питание, комнаты по 2–4 человека, санузел в комнате",
      "Медработник и охрана на территории круглосуточно",
      "Результат смены — готовый IT-проект, который ребята защищают на хакатоне",
      "Договор, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Кто едет из Новой Москвы в наш лагерь",
    text: "Много семей из Бутово, Щербинки, Коммунарки, Московского. Как правило, это дети после 1–8 класса — школьники, которым интересны технологии. Родители часто работают в IT или смежных областях, ценят образовательный результат и хотят «умный» отдых для ребёнка вместо бесконечных игр в телефоне.",
    list: [
      "Дети без опыта программирования — начинаем с нуля, за смену доходим до рабочего проекта",
      "Дети с опытом — получат продвинутые задачи и реальный результат",
      "Дети «в играх» — перенаправляем интерес: учимся создавать игры, а не только играть"
    ]
  },
  {
    h2: "Почему родители из Новой Москвы выбирают АйДаКемп",
    text: "Жители Новой Москвы — наши самые близкие соседи. И это даёт реальные преимущества:",
    list: [
      "Самый короткий маршрут из Москвы — 40–60 минут по одному шоссе без пробок",
      "Тот же климат и часовой пояс — ребёнок адаптируется мгновенно",
      "Приехать проведать в любой день — полчаса–час и ты рядом с ребёнком",
      "Можно отвезти самостоятельно — M-3 прямо, без навигатора"
    ]
  },
  {
    h2: "Смены и стоимость",
    text: `Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от ${PRICE_MIN}. В цену включены проживание, питание, IT-программа, бассейн, все активности.`,
    list: [
      `Смена 2.1 — ${DATES_SHORT_S21}, 7 дней, ${PRICE_MIN}`,
      `Смена 2 — ${DATES_SHORT_S2}, 14 дней, ${PRICE_MAX} (самая популярная)`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Трансфер из Новой Москвы",
    text: "Организованный трансфер отправляется из Москвы — точка сбора у м. Солнцево (15 минут на метро от Аннино или Улицы Скобелевской). Либо можно довезти ребёнка самостоятельно — прямо по Киевскому шоссе, без пробок и без заездов в центр.",
    list: [
      "Трансфер: м. Солнцево → лагерь, 2 000 ₽ в одну сторону",
      "На метро из Бутово до Солнцево — 2–3 остановки, 10–15 минут",
      "На машине из Бутово/Коммунарки — прямо по M-3, навигатор: 55.265643, 36.724185"
    ]
  },
  {
    h2: "Новая Москва — самый удобный старт до нашего лагеря",
    text: "ТиНАО непосредственно граничит с Наро-Фоминским районом, где расположен АйДаКемп. Это делает Новую Москву ближайшей точкой старта среди всех районов Москвы. Конкретные расстояния:",
    list: [
      "От Коммунарки / Ватутинок до лагеря — около 40–45 минут (55 км) по Калужскому шоссе → М-3",
      "От Щербинки / Южного Бутово — 40–50 минут по тому же маршруту",
      "От Троицка — 35–45 минут, практически без пробок через М-3",
      "На МЦД-4 до м. Солнцево, затем трансфер — удобно для тех, кто без машины",
      "Самый короткий маршрут в Подмосковный лагерь из всей Москвы — без въезда в центр и без МКАД"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "За каждой группой школьников закреплён один преподаватель на 6–8 ребят — это не массовая «смотрящая» модель, а работающий формат с реальным вниманием к каждому. Педагоги проходят конкурсный отбор и обучение перед сезоном.",
    list: [
      "1 преподаватель на 6–8 школьников — каждому хватает внимания",
      "Конкурсный отбор вожатых: практикующие IT-специалисты с опытом работы с подростками",
      "Медработник на территории круглосуточно — любая ситуация закрыта без звонка родителей",
      "Ежедневные фото в Telegram-канале в 21:00 — мама видит лицо ребёнка каждый день"
    ]
  },
  {
    h2: "Записаться на лето 2026",
    text: `Июль 2026 полностью занят. На июнь и август места ещё есть — но их становится меньше каждую неделю. Смена 2.1 (${DATES_SHORT_S21}, 7 дней) и Смена 4 (${DATES_SHORT_S4}, 10 дней) — ближайшие доступные варианты. Оставьте заявку — менеджер свяжется в течение 10 минут в рабочее время.`
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский IT-лагерь из Новой Москвы 2026 — 40–60 км, программирование для детей 7–15 лет"
  description="IT-лагерь в 40–60 км от Бутово, Щербинки, Коммунарки по Киевскому шоссе. Python, AI, Minecraft, Roblox. Трансфер от м. Солнцево. Смены от 48 000 ₽. Договор, страховка, бассейн, 5-разовое питание."
  h1="Детский IT-лагерь из Новой Москвы: ближайший путь до лучшего технологического лагеря"
  canonical="https://aidacamp.ru/lager-novaya-moskva"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как далеко лагерь от Новой Москвы?", a: "От Бутово и Коммунарки — 40–60 км прямо по Киевскому шоссе, около 40–50 минут. Организованный трансфер от м. Солнцево — 15–20 мин. от любой точки Новой Москвы." },
    { q: "Нужно ли ехать через Москву?", a: "Нет. Из Новой Москвы можно ехать напрямую по Киевскому шоссе, не въезжая в Москву. Маршрут: Киевское шоссе → M-3 → посёлок Мальчики Наро-Фоминского района." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает при регистрации. Группы до 8 человек, преподаватели — практикующие IT-специалисты." },
    { q: "Можно ли отвезти ребёнка самостоятельно?", a: "Да. Привезти самостоятельно к точке сбора у лагеря или воспользоваться трансфером от м. Солнцево (2 000 ₽). Адрес лагеря: Наро-Фоминский район, посёлок Мальчики, санаторий «Изумруд»." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь для жителей Новой Москвы — АйДаКемп"
      description="IT-лагерь в 40–60 км от Новой Москвы по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-novaya-moskva"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "АйДаКемп — IT-лагерь для детей",
  "url": "https://aidacamp.ru",
  "logo": "https://aidacamp.ru/logo.png",
  "description": "Детский IT-лагерь для детей 7–15 лет. Python, AI, Minecraft, Roblox, 3D-моделирование.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "RU",
    "addressRegion": "Московская область",
    "addressLocality": "Наро-Фоминск"
  },
  "educationalProgram": [
    {
      "@type": "EducationalOccupationalProgram",
      "name": "Python для детей",
      "description": "Программирование на Python с нуля до готового IT-проекта"
    },
    {
      "@type": "EducationalOccupationalProgram",
      "name": "AI и нейросети",
      "description": "Искусственный интеллект и машинное обучение для подростков"
    },
    {
      "@type": "EducationalOccupationalProgram",
      "name": "Minecraft Education & Roblox Studio",
      "description": "Создание игр и миров в Minecraft и Roblox"
    }
  ],
  "offers": {
    "@type": "Offer",
    "priceCurrency": "RUB",
    "price": "48000",
    "description": "Смена 2.1 на 7 дней включает проживание, питание, IT-программу, бассейн"
  },
  "contact": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "telephone": "+7"
  }
})} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для жителей Новой Москвы"
    subtitle="IT-лагерь в 40–60 км от Бутово и Коммунарки — прямо по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Новой Москвы"
    keywords={["40–60 км от Бутово/Коммунарки по Киевскому шоссе", "IT-программа: Python, AI, Minecraft, Roblox", `Смены от 10 до 14 дней, от ${PRICE_MIN}`]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь для жителей Новой Москвы — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

<section class="internal-links-section" style="background: linear-gradient(135deg, #f8f9ff 0%, #fff9f5 100%); padding: 2.5rem 1.5rem; margin: 2rem 0; border-radius: 12px; border-left: 4px solid #ff6b35;">
  <h2 style="font-size: 1.3rem; margin-bottom: 1rem; color: #1a1a1a;">Выбрать программу и смену</h2>
  <p style="margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.6; color: #333;">
    Все смены лагеря работают по единому принципу: 2 занятия в день (утро и день), бассейн, спортивные активности, хакатон в конце смены. Разница только в направлении (Python, AI, Minecraft, Roblox, 3D-моделирование), датах и продолжительности.
  </p>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <a href="/programma-smeny" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #ff6b35; color: #ff6b35; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → Все IT-программы и направления обучения
    </a>
    <a href="/ceny" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #4a90e2; color: #4a90e2; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → График смен на лето 2026
    </a>
    <a href="/ceny" style="display: inline-flex; align-items: center; padding: 1rem 1.5rem; background: white; border: 2px solid #2ecc71; color: #2ecc71; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
      → Стоимость смен и способы оплаты
    </a>
  </div>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
