---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Новой Москвы",
    text: "Новая Москва и АйДаКемп стоят на одном шоссе — Калужском (A-101). Из Бутово, Щербинки, Коммунарки, Московского до лагеря прямо по A-101, без пробок 40–60 минут. Никаких разворотов через МКАД и центр города. Из всех районов Москвы жители Новой Москвы добираются до нас быстрее всего.",
    list: [
      "Бутово / Щербинка — 40–50 минут по A-101 прямо",
      "Коммунарка / Московский — 45–55 минут по Калужскому шоссе",
      "Троицк — 35–45 минут, практически без пробок",
      "Можно довезти ребёнка самостоятельно или посадить на трансфер из Москвы (м. Солнцево)"
    ]
  },
  {
    h2: "Лагерь АйДаКемп — что это",
    text: "АйДаКемп — IT-лагерь для детей 7–15 лет. Дети выбирают направление: Python, AI и нейросети, Minecraft Education, Roblox Studio или 3D-моделирование. Занятия дважды в день, группы до 8 человек, преподаватели-практики.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, активности каждый день",
      "5-разовое питание, комнаты по 2–4 человека, санузел в комнате",
      "Медработник и охрана на территории круглосуточно",
      "Результат смены — готовый IT-проект, который ребята защищают на хакатоне",
      "Договор, страховка, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Кто едет из Новой Москвы в наш лагерь",
    text: "Много семей из Бутово, Щербинки, Коммунарки, Московского. Как правило, это дети после 1–8 класса — школьники, которым интересны технологии. Родители часто работают в IT или смежных областях, ценят образовательный результат и хотят «умный» отдых для ребёнка вместо бесконечных игр в телефоне.",
    list: [
      "Дети без опыта программирования — начинаем с нуля, за смену доходим до рабочего проекта",
      "Дети с опытом — получат продвинутые задачи и реальный результат",
      "Дети «в играх» — перенаправляем интерес: учимся создавать игры, а не только играть"
    ]
  },
  {
    h2: "Почему родители из Новой Москвы выбирают АйДаКемп",
    text: "Жители Новой Москвы — наши самые близкие соседи. И это даёт реальные преимущества:",
    list: [
      "Самый короткий маршрут из Москвы — 40–60 минут по одному шоссе без пробок",
      "Тот же климат и часовой пояс — ребёнок адаптируется мгновенно",
      "Приехать проведать в любой день — полчаса–час и ты рядом с ребёнком",
      "Можно отвезти самостоятельно — A-101 прямо, без навигатора"
    ]
  },
  {
    h2: "Смены и стоимость",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В цену включены проживание, питание, IT-программа, бассейн, все активности и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽"
    ]
  },
  {
    h2: "Трансфер из Новой Москвы",
    text: "Организованный трансфер отправляется из Москвы — точка сбора у м. Солнцево (15 минут на метро от Аннино или Улицы Скобелевской). Либо можно довезти ребёнка самостоятельно — прямо по Калужскому шоссе, без пробок и без заездов в центр.",
    list: [
      "Трансфер: м. Солнцево → лагерь, 2 500 ₽ в одну сторону",
      "На метро из Бутово до Солнцево — 2–3 остановки, 10–15 минут",
      "На машине из Бутово/Коммунарки — прямо по A-101, навигатор: 55.265643, 36.724185"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский лагерь из Новой Москвы 2026 — АйДаКемп"
  description="Детский IT-лагерь для жителей Новой Москвы: 40–60 км от Бутово, Коммунарки, Щербинки по Калужскому шоссе. Python, AI, Minecraft. Бассейн, проживание. От 48 000 ₽."
  h1="Детский лагерь для жителей Новой Москвы"
  canonical="https://aidacamp.ru/lager-novaya-moskva"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как далеко лагерь от Новой Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "От Бутово и Коммунарки — 40–60 км прямо по Калужскому шоссе, около 40–50 минут. Организованный трансфер от м. Солнцево — 15–20 мин. от любой точки Новой Москвы." }
        },
        {
          "@type": "Question",
          "name": "Нужно ли ехать через Москву?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Из Новой Москвы можно ехать напрямую по Калужскому шоссе, не въезжая в Москву. Маршрут: Калужское шоссе → A-101 → посёлок Мальчики Наро-Фоминского района." }
        },
        {
          "@type": "Question",
          "name": "Какие IT-треки доступны в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование. Ребёнок выбирает при регистрации. Группы до 8 человек, преподаватели — практикующие IT-специалисты." }
        },
        {
          "@type": "Question",
          "name": "Можно ли отвезти ребёнка самостоятельно?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Привезти самостоятельно к точке сбора у лагеря или воспользоваться трансфером от м. Солнцево (2 500 ₽). Адрес лагеря: Наро-Фоминский район, посёлок Мальчики, санаторий «Изумруд»." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь для жителей Новой Москвы — АйДаКемп"
      description="IT-лагерь в 40–60 км от Новой Москвы по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-novaya-moskva"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для жителей Новой Москвы"
    subtitle="IT-лагерь в 40–60 км от Бутово и Коммунарки — прямо по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Новой Москвы"
    keywords={["40–60 км от Бутово/Коммунарки по Калужскому шоссе", "IT-программа: Python, AI, Minecraft, Roblox", "Смены от 10 до 14 дней, от 48 000 ₽"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь для жителей Новой Москвы — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
