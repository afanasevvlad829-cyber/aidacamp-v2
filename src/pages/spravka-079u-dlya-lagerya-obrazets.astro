---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import AskCta from '../components/AskCta.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое справка 079/у",
    text: "Форма 079/у — стандартная медицинская справка, которую требуют детские лагеря санаторного и загородного типа перед заездом. В ней врач фиксирует группу здоровья, перенесённые и хронические заболевания, прививочный статус и разрешение на физическую нагрузку. Без неё лагерь не имеет права принять ребёнка — это требование СанПиН, а не внутреннее правило конкретной организации.",
  },
  {
    h2: "Где получить справку 079/у",
    text: "Справку выдаёт педиатр в поликлинике по месту прикрепления ребёнка — на основании данных диспансеризации и текущего осмотра. Если диспансеризация давняя или чего-то не хватает (анализы, заключения профильных специалистов), врач может отправить на дополнительное обследование перед тем, как подписать форму.",
    list: [
      "Обращаться к своему педиатру, не в частную клинику «с нуля» — у участкового уже есть история болезни ребёнка",
      "Лучше идти заранее: если нужны анализы или узкие специалисты, оформление может занять несколько дней",
      "Если ребёнок недавно болел — справку выдадут только после выздоровления",
    ],
  },
  {
    h2: "Что входит в справку — форма и образец",
    text: "Бланк 079/у заполняет врач, а не родитель — готового «шаблона для скачивания» не существует, это официальная медицинская форма. В неё входят: ФИО и дата рождения ребёнка, группа здоровья, физкультурная группа, перенесённые заболевания и прививки, сведения об аллергиях, заключение об отсутствии контактов с инфекционными больными, подпись врача и печать медучреждения.",
  },
  {
    h2: "Срок действия справки",
    text: "На практике справку принимают, если она оформлена незадолго до отъезда — обычно в пределах 10 дней до начала смены, но точный срок может отличаться в зависимости от лагеря и региона. Отдельно от 079/у часто требуется справка об отсутствии контакта с инфекционными больными — она короче по сроку действия (обычно 3 дня) и оформляется уже непосредственно перед отъездом.",
    list: [
      "079/у — общая медицинская справка, готовится заранее",
      "Справка об эпидокружении — оформляется в последние дни перед заездом, срок короче",
      "Точный список и сроки уточняйте при оформлении путёвки — мы присылаем памятку с документами каждому родителю",
    ],
  },
  {
    h2: "Как это устроено в АйДаКемп",
    text: `После оплаты путёвки мы высылаем родителю полный список документов к заезду, включая справку 079/у и её актуальный на момент смены срок действия. Если с оформлением возникают сложности — пишите нам, подскажем, куда обратиться. Смены на лето 2026 — от ${PRICE_MIN}.`,
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Справка 079/у для лагеря — где получить, образец, срок действия"
  description="Справка 079/у для детского лагеря: что это, где получить у педиатра, что входит в форму и сколько она действует. Разбор + список документов от АйДаКемп."
  h1="Справка 079/у для лагеря — где получить и сколько действует"
  canonical="https://aidacamp.ru/spravka-079u-dlya-lagerya-obrazets"
>
  <Fragment slot="head">
    <FAQSchema items={[
      { q: "Что такое справка 079/у для лагеря?", a: "Это стандартная медицинская справка, которую требуют детские лагеря санаторного и загородного типа перед заездом. В ней врач фиксирует группу здоровья, хронические заболевания, прививки и разрешение на физическую нагрузку." },
      { q: "Где получить справку 079/у?", a: "У педиатра в поликлинике по месту прикрепления ребёнка, на основании диспансеризации и текущего осмотра. Если не хватает анализов — врач направит на дополнительное обследование." },
      { q: "Сколько действует справка 079/у для лагеря?", a: "Обычно принимают справку, оформленную в пределах 10 дней до начала смены, но точный срок зависит от лагеря и региона — уточняйте при оформлении путёвки." },
      { q: "Есть ли образец справки 079/у для скачивания?", a: "Готового шаблона для самостоятельного заполнения нет — это официальная медицинская форма, её заполняет врач по итогам осмотра, а не родитель." },
    ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Справка 079/у для лагеря — где получить и сколько действует"
    subtitle="Разбираем по шагам: что это за документ, у какого врача получать, что в него входит и какой у него срок действия."
    breadcrumb="Справка 079/у"
    keywords={["Выдаёт педиатр по месту прикрепления", "Обычно действует ~10 дней до заезда", "Список документов присылаем после оплаты путёвки"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Справка 079/у для детского лагеря"
  />

  <LandingTwoCol sections={sections} />

  <FAQ />
  <AskCta />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
