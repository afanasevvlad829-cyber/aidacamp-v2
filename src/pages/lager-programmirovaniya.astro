---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Как устроен лагерь программирования",
    text: "АйДаКемп — загородный лагерь с IT-программой, где программирование — не факультатив, а основа каждого дня. Утром дети работают над проектом под руководством преподавателей. Днём — бассейн, спорт, командные игры. В конце смены — хакатон: каждый защищает свой проект перед всей группой."
  },
  {
    h2: "Курсы программирования в лагере",
    text: "Программа разделена по возрасту и уровню подготовки. Новички начинают со Scratch и визуального кодинга, продвинутые — работают с Python, API и нейросетями.",
    list: [
      "Scratch — визуальное программирование для 7–9 лет",
      "Python — основной язык для 10–14 лет",
      "AI и нейросети — практика с реальными инструментами",
      "Minecraft Education — программирование через игру",
      "Веб и дизайн — HTML, CSS, Figma"
    ]
  },
  {
    h2: "Преподаватели лагеря программирования",
    text: "Занятия ведут авторы учебника по Python для детей (тираж 2000 экз.). Команда преподавателей работает с детьми с 2019 года — через школу #АйДаКодить прошли более 1200 учеников. Соотношение преподавателей к детям — 1:6."
  },
  {
    h2: "Расположение и условия",
    text: "Лагерь находится в Московской области, Наро-Фоминский район, территория санатория «Изумруд» — 66 км от Москвы по Калужскому шоссе. Комнаты по 2–4 человека, 5-разовое питание, бассейн с ионизированной водой, охрана 24/7."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-programmirovaniya.avif"
  title="Лагерь программирования для детей — Python, AI | от 48 000 ₽"
  description="Летний лагерь программирования Python, AI, Minecraft. Для детей 7–15 лет в Подмосковье. Смены июнь–август 2026 от 48 000 ₽."
  h1="Лагерь программирования для детей"
  canonical="https://aidacamp.ru/lager-programmirovaniya"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое лагерь программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Загородный лагерь с проживанием, где ребёнок изучает программирование и к концу смены создаёт реальный проект — бота, игру или AI-приложение. АйДаКемп — лагерь программирования в Подмосковье для детей 7–15 лет." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Принимаем с нуля. Группы начинающих — с азов переменных и циклов. На 3-й день уже виден прогресс. К концу смены — работающий проект." }
        },
        {
          "@type": "Question",
          "name": "Какие языки программирования учат в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python (основной язык: боты, парсеры, игры), Lua в Roblox Studio, блоки Scratch (для 7–10 лет). Также AI-треки — ChatGPT API, нейросети без программирования." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста ребёнок может заниматься программированием в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Для младших (7–9 лет) — Scratch и Minecraft: визуальное программирование. С 10 лет — Python и Roblox. С 12–13 — AI-проекты и продвинутый Python." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь программирования для детей"
    subtitle="Летний лагерь в Подмосковье, где дети изучают программирование и создают собственный IT-проект за смену."
    breadcrumb="Лагерь программирования"
    keywords={["Python, AI, Scratch — от первых шагов до своего проекта", "Преподаватели — авторы книги по Python для детей", "Смены 7–15 дней с проживанием в Подмосковье"]}
    image="/images/hero/lager-programmirovaniya.avif"
    imageAlt="Лагерь программирования АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Нулевой опыт — норма. Дорожная карта по возрастам и что даёт лагерь.", icon: "braces" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej", description: "Почему Python первый язык и что создают дети за 2 недели.", icon: "code-slash" },
    { title: "Scratch для детей: первые шаги в программировании", url: "/stati/scratch-dlya-detej", description: "Старт для детей 7-11 лет — и переход к Python.", icon: "puzzle" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
