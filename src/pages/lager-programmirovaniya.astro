---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Направления программирования в лагере: выбери свой трек",
    text: "Программа разделена по возрасту, уровню и интересам. Каждый выбирает трек при записи — это не «общий лагерь», а конкретный путь к конкретному результату.",
    list: [
      "Python — основной язык: боты, парсеры, игры, работа с API. Для 10–15 лет",
      "AI / нейросети — ChatGPT API, Gemini, генерация изображений и текста. Для 12–15 лет",
      "Minecraft Education — программирование через любимую игру. Для 8–11 лет",
      "Roblox / Lua — создание своей игры в Roblox Studio. Для 9–13 лет",
      "Scratch — визуальное программирование, первые шаги. Для 7–9 лет"
    ]
  },
  {
    h2: "Как устроен учебный день в лагере программирования",
    text: "День сбалансирован: продуктивные занятия чередуются с отдыхом и спортом. Ни перегрузки, ни пустого времени.",
    list: [
      "9:00–12:00 — утренние занятия: 3 часа IT с преподавателем, работа над проектом",
      "12:00–15:30 — обед, тихий час, свободное время",
      "15:30–17:30 — бассейн, спорт, командные активности на улице",
      "18:00–20:00 — вечерние занятия: ещё 2 часа работы над проектом или командный хакатон",
      "Итого 5 часов IT в день — достаточно для реального прогресса, без переутомления"
    ]
  },
  {
    h2: "Что умеет выпускник лагеря — конкретные навыки по треку",
    text: "Через 10–14 дней каждый привозит домой работающий проект — это главное доказательство прогресса.",
    list: [
      "Python-трек: написал Telegram-бота или парсер, знает функции, циклы, работу с API",
      "AI-трек: создал приложение с ChatGPT API, умеет писать промпты и работать с нейросетями",
      "Minecraft: написал мод или мини-игру на Python через API Education Edition",
      "Roblox: создал рабочую игру в Roblox Studio на Lua с опубликованным результатом",
      "Scratch: сделал анимацию или игру — первый полный проект с нуля"
    ]
  },
  {
    h2: "Кто ведёт занятия в лагере программирования?",
    text: "Занятия ведут авторы учебника по Python для детей (тираж 2000 экз.). Команда преподавателей работает с детьми с 2021 года — через школу #АйДаКодить прошли более 1200 учеников. Соотношение преподавателей к детям — 1:6."
  },
  {
    h2: "Кто ведёт занятия в лагере программирования?",
    text: "Занятия ведут авторы учебника по Python для детей (тираж 2000 экз.). Команда преподавателей работает с детьми с 2021 года — через школу #АйДаКодить прошли более 1200 учеников. Соотношение преподавателей к детям — 1:6."
  },
  {
    h2: "Где находится лагерь программирования и что входит в стоимость?",
    text: "Лагерь находится в Московской области, Наро-Фоминский район, территория санатория «Изумруд» — 66 км от МКАД по Киевскому шоссе. В стоимость включены: проживание по 2–4 человека в комнате, 5-разовое питание, бассейн с ионизированной водой, IT-программа и охрана 24/7."
  },
  {
    h2: "Места заканчиваются — июнь почти заполнен",
    text: "По данным прошлых сезонов флагманская смена 2 (июнь, 14 дней) расходится к началу мая. В августе ещё есть места на смены 3 и 4. При раннем бронировании цена зафиксирована — после 1 мая повышение на 10–15%. Оставьте заявку сейчас, мы перезвоним за 10 минут и подберём трек под возраст и уровень."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-programmirovaniya.avif"
  title="Лагерь программирования 2026 в Подмосковье | АйДаКемп"
  description="Летний лагерь программирования Python, AI, Minecraft. Для детей 7–15 лет в Подмосковье. Смены июнь–август 2026 от 48 000 ₽."
  h1="Лагерь программирования для детей"
  canonical="https://aidacamp.ru/lager-programmirovaniya"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое лагерь программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — загородный лагерь программирования в Подмосковье для детей 7–15 лет, 66 км от Москвы. Дети учатся кодить (Python, Scratch, AI, Minecraft) и к концу смены защищают собственный проект на хакатоне. Смены 7–14 дней, от 48 000 ₽. Лицензия Минобрнауки Л035-01298-77/01082973., где ребёнок изучает программирование и к концу смены создаёт реальный проект — бота, игру или AI-приложение. АйДаКемп — лагерь программирования в Подмосковье для детей 7–15 лет." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Принимаем с нуля. Группы начинающих — с азов переменных и циклов. На 3-й день уже виден прогресс. К концу смены — работающий проект." }
        },
        {
          "@type": "Question",
          "name": "Какие языки программирования учат в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python (основной язык: боты, парсеры, игры), Lua в Roblox Studio, блоки Scratch (для 7–10 лет). Также AI-треки — ChatGPT API, нейросети без программирования." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста ребёнок может заниматься программированием в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "С 7 лет. Для младших (7–9 лет) — Scratch и Minecraft: визуальное программирование. С 10 лет — Python и Roblox. С 12–13 — AI-проекты и продвинутый Python." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь программирования для детей"
    subtitle="Летний лагерь в Подмосковье, где дети изучают программирование и создают собственный IT-проект за смену."
    breadcrumb="Лагерь программирования"
    keywords={["Python, AI, Scratch — от первых шагов до своего проекта", "Преподаватели — авторы книги по Python для детей", "Смены 7–15 дней с проживанием в Подмосковье"]}
    image="/images/hero/lager-programmirovaniya.avif"
    imageAlt="Лагерь программирования АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Нулевой опыт — норма. Дорожная карта по возрастам и что даёт лагерь.", icon: "braces" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej", description: "Почему Python первый язык и что создают дети за 2 недели.", icon: "code-slash" },
    { title: "Scratch для детей: первые шаги в программировании", url: "/stati/scratch-dlya-detej", description: "Старт для детей 7-11 лет — и переход к Python.", icon: "puzzle" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
