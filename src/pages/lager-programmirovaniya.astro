---
import { PRICE_MIN } from '../data/shifts';
import { STAT_LICENSE } from '../data/contacts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Направления программирования в лагере: выбери свой трек",
    text: "Программа разделена по возрасту, уровню и интересам. Каждый выбирает трек при записи — это не «общий лагерь», а конкретный путь к конкретному результату. Питание — пятиразовое: меню составляет технолог, учитываем аллергии; за код садятся сытыми, перекусы между занятиями.",
    list: [
      "Python — основной язык: даёт знания основ программирования и практику: боты, парсеры, игры, веб-скрипты, работа с API. Для 10–15 лет",
      "AI / нейросети — ChatGPT API, Gemini, генерация изображений и текста. Для 12–15 лет",
      "Minecraft Education — программирование прямо на платформе любимой игры; отличный способ познакомиться с кодом без стресса. Для 8–11 лет",
      "Roblox / Lua — создание и разработка своей игры в Roblox Studio. Для 9–13 лет",
      "Scratch — визуальное программирование, анимации, первые игры — знакомство с кодом для 7–9 лет"
    ]
  },
  {
    h2: "Как устроен учебный день в лагере программирования",
    text: "День сбалансирован: продуктивные занятия чередуются с отдыхом и спортом. Ни перегрузки, ни пустого времени. IT-занятия проводятся дважды в день: 3 часа утром и 2 часа вечером.",
    list: [
      "9:00–12:00 — утренние занятия: 3 часа IT с преподавателем, работа над проектом",
      "12:00–15:30 — обед, тихий час, свободное время",
      "15:30–17:30 — бассейн, спорт, командные активности на улице",
      "18:00–20:00 — вечерние занятия: ещё 2 часа работы над проектом или командный хакатон",
      "Итого 5 часов IT в день — достаточно для реального прогресса, без переутомления"
    ]
  },
  {
    h2: "Что умеет выпускник лагеря — конкретные навыки по треку",
    text: "Через 10–14 дней каждый привозит домой работающий проект с практическими навыками — это главное доказательство прогресса.",
    list: [
      "Python-трек: написал Telegram-бота или парсер, знает функции, циклы, работу с API — так формируются технические навыки для работы с данными и ботами",
      "AI-трек: создал приложение с ChatGPT API, умеет писать промпты и работать с нейросетями",
      "Minecraft: написал мод или мини-игру на Python через API Education Edition",
      "Roblox: воплотил собственные идеи — рабочая игра в Roblox Studio на Lua с опубликованным результатом",
      "Scratch: сделал анимацию или игру — первый полный проект с нуля"
    ]
  },
  {
    h2: "Кто ведёт занятия в лагере программирования?",
    text: "Занятия ведут практикующие IT-специалисты — авторы учебника по Python для детей (тираж 2000 экз.) — авторский курс разработан на основе 4 лет практики со школьниками. Команда преподавателей работает с детьми с 2021 года — через школу #АйДаКодить прошли более 1200 учеников. Соотношение преподавателей к детям — 1:6. Вожатые отвечают за быт и распорядок — отдельно от учебной программы, но на связи весь день.",
  },
  {
    h2: "Где находится лагерь программирования и что входит в стоимость?",
    text: "Лагерь проходит в формате полного погружения: Московская область, Наро-Фоминский район — отличное место для продуктивных летних каникул. Территория — санаторий «Изумруд», 66 км от МКАД по Киевскому шоссе. В стоимость включены: проживание по 2–4 человека в комнате, 5-разовое питание, бассейн с ионизированной водой, IT-программа и охрана 24/7. Трансфер от м. Солнцево — отдельной опцией при бронировании."
  },
  {
    h2: "Места заканчиваются — июнь почти заполнен",
    text: "По данным прошлых сезонов флагманская смена 2 (июнь, 14 дней) расходится к началу мая. В августе ещё есть места на смены 3 и 4. При раннем бронировании цена зафиксирована — после 1 мая повышение на 10–15%. Оставьте заявку сейчас, мы перезвоним за 10 минут и подберём трек под возраст и уровень."
  },
  {
    h2: 'Лагерь по программированию 2026 — языки и направления',
    text: 'В каждой смене несколько параллельных треков — ребёнок выбирает интересное, или помогаем подобрать по возрасту и уровню. Опыт не нужен: группы начинающих стартуют с нуля.',
    list: [
      'Python (10–15 лет) — переменные, циклы, функции, Telegram-бот, работа с API',
      'Scratch (7–10 лет) — блочное программирование, анимации, простые игры',
      'Minecraft Education (8–14 лет) — программирование модов и механик на Python',
      'Roblox Studio (10–14 лет) — создание 3D-игры на Lua от нуля до публикации',
      'AI и нейросети (12–15 лет) — ChatGPT API, промпт-инжиниринг, обучение моделей',
      '3D-моделирование (10–15 лет) — Blender, печать готовой модели на принтере'
    ]
  },
  {
    h2: 'Детский лагерь программирования — часто задаваемые вопросы',
    text: 'Что спрашивают родители перед записью в лагерь программирования.',
    list: [
      'Нужен ли ноутбук: нет, всё оборудование предоставляет лагерь — ноутбуки, мыши, наушники',
      'Возраст: от 7 до 15 лет, группы по возрасту и уровню — начинающие и продолжающие',
      'Без опыта: принимаем с нуля, за 7–10 дней ребята пишут первую программу',
      'Результат: готовый проект к концу смены — игра, бот или 3D-модель, которую можно показать',
      'Налоговый вычет 13% — образовательная лицензия Минобрнауки, вычет законный'
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-programmirovaniya.avif"
  title="Лагерь программирования для детей 2026 — АйДаКемп, Подмосковье"
  description={`Летний лагерь программирования для детей 7–15 лет в Подмосковье и Москве — технологический лагерь с Python, AI, Minecraft, Roblox. Реальный проект за смену. 2026 от ${PRICE_MIN}.`}
  h1="Лагерь программирования для детей 2026"
  canonical="https://aidacamp.ru/lager-programmirovaniya"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое лагерь программирования?", a: `АйДаКемп — загородный лагерь программирования в Подмосковье для детей 7–15 лет, 66 км от Москвы. Дети учатся кодить (Python, Scratch, AI, Minecraft) и к концу смены защищают собственный проект на хакатоне. Смены 10 и 13 дней, от ${PRICE_MIN}. Лицензия Минобрнауки ${STAT_LICENSE}., где ребёнок изучает программирование и к концу смены создаёт реальный проект — бота, игру или AI-приложение. АйДаКемп — лагерь программирования в Подмосковье для детей 7–15 лет.` },
    { q: "Нужен ли опыт программирования для лагеря?", a: "Нет. Принимаем с нуля. Группы начинающих — с азов переменных и циклов. На 3-й день уже виден прогресс. К концу смены — работающий проект." },
    { q: "Какие языки программирования учат в лагере?", a: "Python (основной язык: боты, парсеры, игры), Lua в Roblox Studio, блоки Scratch (для 7–10 лет). Также AI-треки — ChatGPT API, нейросети без программирования." },
    { q: "С какого возраста ребёнок может заниматься программированием в лагере?", a: "С 7 лет. Для младших (7–9 лет) — Scratch и Minecraft: визуальное программирование. С 10 лет — Python и Roblox. С 12–13 — AI-проекты и продвинутый Python." },
    { q: "Как проходит лагерь программирования для детей?", a: "В АйДаКемп — 2 занятия по 90 минут каждый день: Python, AI, Minecraft, Roblox или 3D-моделирование. Группы до 8 человек. В конце смены — хакатон: каждый защищает свой проект. Остальное время: бассейн, спорт, вечерние активности. Телефоны сдают при заезде." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь программирования 2026 в Подмосковье — Python, AI, Minecraft"
    subtitle={`Летний лагерь программирования в Подмосковье. Реальный проект за смену — не «прошли тему», а рабочий код. Для детей 7–15 лет, от ${PRICE_MIN}.`}
    breadcrumb="Лагерь программирования"
    keywords={["Python, AI, Scratch — от первых шагов до своего проекта", "Преподаватели — авторы книги по Python для детей", "Смены 7–15 дней с проживанием в Подмосковье"]}
    image="/images/hero/lager-programmirovaniya.avif"
    imageAlt="Лагерь программирования АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedArticles articles={[
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Нулевой опыт — норма. Дорожная карта по возрастам и что даёт лагерь.", icon: "braces" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej/", description: "Почему Python первый язык и что создают дети за 2 недели.", icon: "code-slash" },
    { title: "Scratch для детей: первые шаги в программировании", url: "/stati/scratch-dlya-detej/", description: "Старт для детей 7-11 лет — и переход к Python.", icon: "puzzle" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
