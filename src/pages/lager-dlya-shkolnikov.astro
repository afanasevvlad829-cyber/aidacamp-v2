---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';

const sections = [
  {
    h2: "Летний лагерь для школьников — чем отличается АйДаКемп",
    text: "Большинство летних лагерей для школьников — это развлечения и «занять время». В АйДаКемп иначе: каждый школьник создаёт собственный IT-проект за смену и защищает его на финальном хакатоне. Родители видят конкретный результат, а не просто «хорошо провёл время»."
  },
  {
    h2: "Программа для школьников разных классов",
    text: "Программа делится по возрасту: младшие школьники (1–4 класс, 7–10 лет) работают в Scratch и Minecraft. Средние (5–7 класс, 10–13 лет) — Python, телеграм-боты, веб. Старшие (8 класс, 13–14 лет) — Python Advanced, AI, работа с реальными данными.",
    list: [
      "1–4 класс (7–10 лет) — Scratch, Minecraft, логика",
      "5–7 класс (10–13 лет) — Python, боты, веб-разработка",
      "8 класс (13–14 лет) — Python Advanced, AI, API"
    ]
  },
  {
    h2: "Что делают школьники помимо IT",
    text: "Летний лагерь — это не только занятия. После обеда: бассейн с ионизированной водой, спорт, командные игры на улице. Каждый вечер — работа над проектом и внутренняя «валюта» лагеря, которую зарабатывают за активность. Смартфоны сданы, скуки нет."
  },
  {
    h2: "Когда и как записать школьника",
    text: "Смены проходят с конца мая по август 2026. Оставьте заявку — перезвоним в течение 10 минут и поможем выбрать подходящую смену по возрасту и расписанию. Места ограничены — не более 45 детей на смену."
  },
  {
    h2: "Чем лагерь отличается от городских каникулярных программ",
    text: "Многие школы организуют «летние площадки» с 9 до 18 — это удобно работающим родителям, но по опыту имеет одну критическую слабость. Ребёнок возвращается домой вечером, садится за компьютер и всё происходит как в обычный учебный день — только без уроков. Загородный лагерь с проживанием решает это иначе: ребёнок полностью вне привычной среды 10–14 дней. Мозг успевает перестроиться, новые привычки закрепиться, появляются новые друзья-ровесники.",
    list: [
      "Городская площадка: ребёнок днём занят, вечером — опять экран. Результат через неделю = 0",
      "Наш формат: 10–14 дней полной смены среды. Результат = новые навыки + новые друзья + перезагрузка"
    ]
  },
  {
    h2: "Что школьник берёт домой после смены",
    text: "Родители заметят изменения уже через неделю после возвращения. Вот что получает ребёнок кроме впечатлений:",
    list: [
      "Собственный IT-проект (Scratch-игра, бот, сайт) — его можно показать в школе или на дне рождения",
      "Сертификат об участии — пригодится в портфолио для школы и на будущее при поступлении",
      "Навык концентрации без телефона — через 10 дней «чистой работы» и дома проще",
      "Круг новых друзей со всей Москвы и Подмосковья — многие общаются годами после",
      "Опыт выступления на хакатоне — защита проекта перед жюри, первый питч в жизни"
    ]
  },
  {
    h2: "Как лагерь помогает после учебного года",
    text: "Май — июнь: у школьников накапливается усталость от 9-месячной рутины. Садятся за компьютер из привычки, настроение на нуле, к школьным успехам относятся нехотя. Лагерная смена — физический перезапуск. За 2 дня ребёнок забывает про школу. За 5 дней — в полном включении в программу. На 7 день — уже смеётся в столовой с новыми друзьями и строит планы на следующий год. Родители, которые привозят ребёнка в конце смены, часто удивляются: «Мы ожидали что он вернётся уставший, а он в два раза активнее чем был в начале мая»."
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Летний лагерь для школьников 2026 в Подмосковье — IT | АйДаКемп"
  description="Летний лагерь для школьников 7–14 лет в Подмосковье. IT-программирование, Python, AI, Minecraft. 66 км от Москвы, смены июнь–август 2026, от 48 000 ₽."
  h1="Летний лагерь для школьников в Подмосковье"
  canonical="https://aidacamp.ru/lager-dlya-shkolnikov"
>
  <LandingHero slot="hero"
    h1="Летний лагерь для школьников в Подмосковье"
    subtitle="Для школьников 7–14 лет. IT-проект за смену, бассейн, природа — и никаких телефонов."
    breadcrumb="Лагерь для школьников"
    keywords={["Для школьников 1–8 класса, группы по возрасту", "IT-проект за смену: Python, AI, Minecraft", `Подмосковье, ${STAT_DISTANCE} от Москвы, смены июнь–август`]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Летний лагерь для школьников в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
