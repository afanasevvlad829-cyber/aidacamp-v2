---
import { PRICE_MIN, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, STAT_LICENSE, STAT_RATING } from '../data/contacts';
import { SEASON_FROM_TO, SEASON_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: `Лагерь для ребят — чем отличается АйДаКемп`,
    text: `Отдых с пользой — главный принцип: ребёнок возвращается с проектом, а не просто с загаром. Большинство летних лагерей — развлечения и «занять время». Наш лагерь — иначе: каждый ребёнок создаёт собственный IT-проект за смену и защищает его на финальном хакатоне.`
  },
  {
    h2: `Выберите по классу — у каждого своя программа`,
    text: `Программа делится по возрасту и уровню. В лагерь можно приезжать без опыта — группы начинающих в лагере стартуют с нуля. К финалу лагеря ребята показывают программу, которую сами написали.`,
    list: [
      `1–3 класс (7–9 лет) — Scratch: анимации, простые игры, знакомство с логикой кода`,
      `4–6 класс (10–12 лет) — Python: переменные, циклы, создание телеграм-бота или простой игры`,
      `7–9 класс (12–15 лет) — AI + продвинутый Python: ChatGPT API, обучение моделей, реальные данные`
    ]
  },
  {
    h2: `Чем заняты ребята помимо IT`,
    text: `После обеда: бассейн с ионизированной водой, спорт, командные игры. Вечером — работа над проектом и внутренняя «валюта» лагеря, которую зарабатывают за активность. Лагерь без смартфонов: их сдают при заезде, скуки нет.`
  },
  {
    h2: `Когда и как записать ребёнка`,
    text: `Смены проходят ${SEASON_FROM_TO} ${SEASON_YEAR}. Оставьте заявку — перезвоним в течение 10 минут и поможем выбрать смену лагеря по возрасту. Места ограничены — не более 45 человек на смену.`
  },
  {
    h2: `Чем лагерь отличается от городских каникулярных программ`,
    text: `Многие школы организуют «летние площадки» с 9 до 18: вечером ребята дома, за компьютером, и всё как в обычный учебный день. Загородный лагерь в Подмосковье с проживанием решает это иначе: 10–14 дней вне привычной среды и новые друзья-ровесники.`,
    list: [
      `Наш формат: 10–14 дней в лагере — полная смена среды. Результат = новые навыки + новые друзья + перезагрузка`
    ]
  },
  {
    h2: `Что школьник берёт домой после смены`,
    text: `Что получают ребята кроме впечатлений:`,
    list: [
      `Цель каждой смены — собственный IT-проект (Scratch-игра, бот, сайт)`,
      `Сертификат лагеря об участии — пригодится в портфолио для школы и при поступлении`,
      `Опыт выступления на хакатоне — защита проекта перед жюри, первый питч в жизни`,
      `Друзья со всей Москвы и Подмосковья`
    ]
  },
  {
    h2: `Лагерь ${SEASON_YEAR} — частые вопросы`,
    text: `Лагерь: отвечаем на вопросы перед записью.`,
    list: [
      `Опыт программирования не нужен — группы начинающих стартуют с нуля`,
      `Трансфер от м. Солнцево в день заезда — автобус, ${TRANSFER_PRICE_FMT} в одну сторону`,
      `Первый лагерь: рекомендуем короткую смену 7–8 дней — легче адаптация`,
      `Питание: 5 раз в день, детское меню, аллергии учитываются`
    ]
  },
  {
    h2: `Лагерь ${SEASON_YEAR} для ребят — чем руководствоваться при выборе`,
    text: `Родители в Москве и области выбирают лагерь не по картинкам. Ориентируйтесь на лицензию, результат и отзывы. Лагерь АйДаКемп: лицензия Минобрнауки ${STAT_LICENSE} (даёт право на налоговый вычет 13%), защита проекта на хакатоне, рейтинг ${STAT_RATING} на Яндекс.Картах.`
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title={`Летний лагерь для школьников 7–15 лет в Москве и Подмосковье ${SEASON_YEAR} | АйДаКемп`}
  description={`Детский летний лагерь для школьников 7–15 лет в Подмосковье, лето ${SEASON_YEAR}: Python, AI, бассейн и хакатон в лагере. 66 км от Москвы, 5-разовое питание, смены от ${PRICE_MIN}.`}
  h1="Летний лагерь для школьников в Москве и Подмосковье"
  canonical="https://aidacamp.ru/lager-dlya-shkolnikov"
  breadcrumb="Лагерь для школьников"
>
  <LandingHero slot="hero"
    h1="Летний лагерь для школьников в Москве и Подмосковье"
    subtitle="Летние смены для школьников 7–15 лет. IT-проект за смену, 66 км от Москвы — и никаких телефонов в рабочее время."
    breadcrumb="Лагерь для школьников"
    keywords={["Для ребят 1–8 класса, группы по возрасту", "IT-проект за смену: Python, AI, Minecraft", `Подмосковье, ${STAT_DISTANCE} от Москвы, смены ${SEASON_MONTHS_NOM}`]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Летний лагерь для школьников в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:0', 'about2026:7', 'about2026:1', 'about2026:9']} extraItems={[
    { q: "Для каких классов подходит наш детский лагерь?", a: "АйДаКемп принимает ребят 1–8 класса (7–15 лет). Группы по возрасту: 7–9, 10–12, 13–15 лет, у каждой своя программа. Вожатые закреплены за группой на весь заезд." },
    { q: "Что делают школьники в IT-лагере?", a: "Создают IT-проект. Занятия дважды в день по 90 минут: Python, AI, Minecraft, Roblox, 3D-моделирование. В финале — хакатон, где каждый защищает свою игру или бота." },
    { q: "Нужно ли уметь программировать до лагеря?", a: "Нет. Большинство ребят приезжают без опыта. Группы начинающих стартуют с нуля, и уже на 3-й день виден результат." },
    { q: "Можно ли ребёнку первый раз ехать в лагерь без родителей?", a: "Можно. Вожатые помогают адаптироваться в первые дни в лагере. Для первого раза рекомендуем короткую смену (7–8 дней)." },
    { q: `Какой детский лагерь выбрать в Подмосковье в ${SEASON_YEAR} году?`, a: `АйДаКемп — IT-лагерь для ребят 7–15 лет в Наро-Фоминском районе. Лицензия Минобрнауки, авторская программа Python/AI/Minecraft, группы до 8 человек. Смены с 30 мая по 26 августа ${SEASON_YEAR}, от ${PRICE_MIN}. Трансфер от м. Солнцево.` }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
