---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Slideshow from '../components/Slideshow.astro';
import VideoCarouselVertical from '../components/VideoCarouselVertical.astro';
import { upcomingShifts, shift2 } from '../data/shifts';

const smena2Videos = [
  {
    file: 'smena2_maksik.mp4',
    poster: '/videos/smena2/smena2_maksik.jpg',
    num: '01',
    title: 'Максик — уроки питона',
    desc: 'Как у вас успехи? Класс! Делаю список enemy levels...',
    duration: '0:42',
  },
  {
    file: 'smena2_dialog.mp4',
    poster: '/videos/smena2/smena2_dialog.jpg',
    num: '02',
    title: 'Диалоговые окна — сам разобрался',
    desc: 'Научился делать диалоговые окна. Была ошибка — помог преподаватель. Мне вообще очень нравится здесь.',
    duration: '1:02',
  },
  {
    file: 'smena2_hakatoon.mp4',
    poster: '/videos/smena2/smena2_hakatoon.jpg',
    num: '03',
    title: 'Хакатон — старт',
    desc: 'Используйте все свои умения. Два тура сбора инвестиций — до обеда и до ужина.',
    duration: '0:41',
  },
  {
    file: 'smena2_vadim_project.mp4',
    poster: '/videos/smena2/smena2_vadim_project.jpg',
    num: '04',
    title: 'Вадим — город из черепашек',
    desc: 'Делаю город с помощью черепашек. Вадимовки очень высокие — реально как башни!',
    duration: '1:03',
  },
];

const today = new Date().toISOString().slice(0, 10);
const openShifts = upcomingShifts(today).slice(0, 3);
---

<Base
  title="Как прошла Смена 2 — АйДаКемп 10 июня — 23 июня 2026"
  description="Репортаж о второй смене IT-лагеря АйДаКемп: фотографии, видео, впечатления и проекты ребят. Смена 2, 10 июня — 23 июня 2026."
  heroPreloadDesktop="/images/hero-desktop.avif"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://aidacamp.ru/kak-proshla-smena-2" />
  </Fragment>

  <Header />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden border-b border-white/10" data-hero-bg="glass-orbs">
    <div class="relative z-10 mx-auto max-w-4xl px-4 pt-10 pb-10 md:pt-16 md:pb-14">

      <div class="inline-flex items-center gap-1.5 rounded-full bg-white/15 border border-white/20 px-3 py-1 text-[12px] font-semibold uppercase tracking-widest text-white/80 backdrop-blur-sm">
        <i class="bi bi-check-circle-fill text-emerald-400 text-[11px]" aria-hidden="true"></i>
        Смена завершена
      </div>

      <div class="mt-4 flex items-baseline gap-3">
        <span class="text-[52px] md:text-[72px] font-extrabold leading-none text-white">10</span>
        <span class="text-[24px] md:text-[32px] font-light text-white/60">июня</span>
        <span class="text-[32px] md:text-[44px] font-light text-white/40 mx-1">—</span>
        <span class="text-[52px] md:text-[72px] font-extrabold leading-none text-white">23</span>
        <span class="text-[24px] md:text-[32px] font-light text-white/60">июня</span>
      </div>

      <h1 class="mt-3 text-[22px] md:text-[28px] font-bold text-white leading-snug">
        Смена 2 — Как это было
      </h1>
      <p class="mt-2 text-base text-white/70 max-w-xl leading-relaxed">
        {shift2.description} 14 дней, больше самостоятельности — и мощный результат в финале.
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        {[
          { icon: 'calendar-check', text: '14 дней' },
          { icon: 'people-fill',    text: '38 участников' },
          { icon: 'geo-alt-fill',   text: 'Наро-Фоминск' },
          { icon: 'cpu-fill',       text: 'Python · AI · Хакатон' },
        ].map(m => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/15 px-3 py-1.5 text-base text-white/80 backdrop-blur-sm">
            <i class={`bi bi-${m.icon} text-[12px] text-primary`} aria-hidden="true"></i>
            {m.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Видео со смены ── -->
  <div id="video" class="mx-auto max-w-4xl px-4 pt-8 pb-2">
    <h2 class="text-[20px] font-bold text-slate-900 mb-1">Видео со смены</h2>
    <p class="text-base text-slate-500">Ребята рассказывают — что делали, что узнали, что показывают родителям</p>
  </div>
  <VideoCarouselVertical videos={smena2Videos} baseUrl="/videos/smena2" />

  <!-- Слайдшоу — хронология день за днём -->
  <Slideshow
    section="smena2_slideshow"
    title="Фотографии со смены"
    subtitle="14 дней хронологически"
    interval={5000}
  />

  <!-- Полная галерея -->
  <Gallery
    sections={[{ value: 'smena2', label: 'Смена 2' }]}
    title="Все фотографии"
    sectionClass="mx-auto max-w-4xl px-4 pt-6"
  />

  <main class="mx-auto max-w-4xl px-4 pb-16 space-y-10">

    <!-- ── CTA ── -->
    <section class="rounded-[24px] bg-gradient-to-br from-orange-50 to-amber-50 border-2 border-primary/20 p-6 md:p-8">
      <div class="flex items-start gap-4">
        <div class="shrink-0 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white">
          <i class="bi bi-sun-fill text-[22px]" aria-hidden="true"></i>
        </div>
        <div class="flex-1">
          <p class="text-[12px] font-bold uppercase tracking-wider text-primary mb-1">Лето ещё не закончилось</p>
          <h2 class="text-[22px] md:text-[26px] font-bold text-slate-900 leading-snug">
            Вы ещё можете успеть на лето с нами
          </h2>
          <p class="mt-2 text-base text-slate-600 leading-relaxed max-w-lg">
            Ещё два заезда в августе — места ограничены, бронирование фиксирует цену на 72 часа.
          </p>
          <a
            href="/#shifts"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary/90 transition-colors shadow-[0_4px_12px_rgba(236,124,0,0.35)]"
          >
            Выбрать смену
            <i class="bi bi-arrow-right text-base" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      {openShifts.length > 0 && (
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          {openShifts.map(s => (
            <a
              href={`/shifts/${s.id}/`}
              class="flex flex-col gap-1 rounded-[16px] bg-white border border-slate-200 px-4 py-3.5 hover:border-primary/40 hover:shadow-md transition-all no-underline group"
            >
              <span class="text-base font-bold text-slate-800 group-hover:text-primary transition-colors">{s.name} · {s.dates}</span>
              <span class="text-[12px] text-slate-500">{s.duration} · {s.price}</span>
              <span class="mt-1 text-[12px] text-primary font-semibold">Выбрать →</span>
            </a>
          ))}
        </div>
      )}
    </section>

  </main>

  <Footer />
</Base>
