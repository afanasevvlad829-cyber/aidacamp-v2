---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для 10 лет: Python, Roblox Studio и Minecraft Education",
    text: "В 10 лет школьники готовы перейти от визуальных блоков к настоящему тексту. В АйДаКемп средняя группа (9–11 лет) начинает Python — первый «взрослый» язык. Параллельно — выбор трека: Roblox Studio (Lua-скриптинг в любимой игре) или Minecraft Education (Python-автоматизация). Именно это делает 10 лет особенными: ребёнок сам выбирает, что ему интереснее, и идёт в глубину.",
    list: [
      "Python — обязательно: переменные, условия, циклы — через задачи, не учебник",
      "Roblox Studio: пишем Lua-скрипты для собственной игровой карты",
      "Minecraft Education: управляем миром через Python-команды",
      "Выбор трека в начале смены — под интересы ребёнка"
    ]
  },
  {
    h2: "Типичный проект десятилетки: что он создаст за смену",
    text: "Каждая смена в АйДаКемп заканчивается защитой проекта. Десятилетки показывают работающий код перед другими отрядами и родителями на заключительном мероприятии.",
    list: [
      "Мини-игра или quiz-бот на Python — можно запустить на любом компьютере",
      "Или собственная карта в Roblox Studio со скриптами и механиками",
      "Или автоматизированный мир в Minecraft Education через Python",
      "Публичная защита проекта — ребёнок объясняет свой код"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про десятилеток в IT-лагере:",
    list: [
      "«Нужен ли опыт программирования?» — Нет. Программа начинается с нуля. Никаких требований кроме умения читать и базовой работы с компьютером.",
      "«Не будет ли скучно, если ребёнок уже знает Scratch?» — Нет. Python — принципиально другой уровень. Те, кто знает Scratch, стартуют быстрее и делают более сложные проекты.",
      "«Какой трек выбрать — Roblox или Minecraft?» — Дайте выбрать ребёнку самому в начале смены. Педагоги помогут принять решение.",
      "«Вожатые опытные?» — Соотношение 1:8. Каждый вожатый знает своих по имени. Медработник 24/7 на базе."
    ]
  },
  {
    h2: "Почему 10 лет — идеальный возраст для IT-лагеря",
    text: "10 лет — это момент, когда школьник уже достаточно самостоятелен, чтобы работать в команде, но ещё не потерял азарт открытий. Python усваивается легче, чем в 14–15: нет страха «я не понимаю» и нет заученных «правильных» способов думать.",
    list: [
      "Мозг в 9–11 лет максимально пластичен — новые паттерны мышления закладываются легко",
      "Нет страха ошибки: экспериментируют, а не боятся неправильного ответа",
      "Достаточно концентрации для 2–3 часов работы над проектом",
      "Командная игра естественна — легко вписывается в коллектив"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Для 9–11 лет важен баланс между занятиями и активным отдыхом — именно так и устроен день.",
    list: [
      "Соотношение вожатых 1:8 — педагог видит каждого, помогает тем, кто отстаёт",
      "Медработник на территории 24/7",
      "Telegram-фото из отряда ежедневно",
      "Закрытый бассейн — купание по расписанию через день",
      "4-разовое питание: разнообразное меню, учитываем аллергии"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для 9–11 лет подходят все смены. Смена 2 (14 дней) даёт больше времени на проект — рекомендуем для тех, кто хочет сделать что-то серьёзное. Июль традиционно заполняется первым.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (максимальный результат)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа адаптируется под возраст. Что было до и что будет после:",
    list: [
      "<a href='/lager-9-let'>Лагерь для 9 лет</a> — Scratch → Python: первые шаги в настоящем коде",
      "<a href='/lager-11-let'>Лагерь для 11 лет</a> — Python и AI: Telegram-бот и нейросети",
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python средний, боты, первые API-проекты",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Летний лагерь 10 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для детей 10 лет в Подмосковье 2026. Python, Roblox Studio, Minecraft Education — дети пишут первый настоящий код и привозят работающий проект. От 48 000 ₽."
  h1="Детский лагерь для детей 10 лет — Python и игры | АйДаКемп"
  canonical="https://aidacamp.ru/lager-10-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для детей 10 лет в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для 9–11 лет в АйДаКемп — Python и выбор трека: Roblox Studio (Lua-скриптинг) или Minecraft Education (Python-автоматизация). Дети пишут первый настоящий код. Итог смены — работающий проект: мини-игра на Python или карта в Roblox/Minecraft." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь ребёнку 10 лет без опыта программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, специально для таких ребят. Программа начинается с нуля — никаких требований кроме умения читать и базовой работы с компьютером. Преподаватели объясняют через игровые задачи." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает ребёнок 10 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены каждый защищает проект: мини-игра или quiz-бот на Python, или карта в Roblox Studio со скриптами, или автоматизированный мир в Minecraft Education. Это то, что ребёнок придумал и реализовал сам." }
        },
        {
          "@type": "Question",
          "name": "Есть ли места в июле?",
          "acceptedAnswer": { "@type": "Answer", "text": "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена для детей 10 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание, занятия, активности. Доступен налоговый вычет 13% через ФНС." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 10 лет — Python, Roblox и проект за смену"
    subtitle="Переход от «нажимать» к «создавать». Школьники 9–11 лет пишут первый настоящий код и привозят домой работающий проект."
    breadcrumb="Лагерь для детей 10 лет"
    keywords={["Python + Roblox Studio / Minecraft Education", "Конкретный проект в финале смены", "10 лет — лучшее время начать"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь для детей 10 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у школьников и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
