---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для детей 10 лет: Python и Minecraft",
    text: "В 10 лет дети готовы перейти от визуальных блоков к настоящему тексту. Средняя группа (9–11 лет) в АйДаКемп начинает Python — первый «взрослый» язык программирования. Параллельно — Minecraft с программированием: дети управляют миром через код, а не только руками.",
    list: [
      "Python с нуля: переменные, условия, циклы — без заучивания, через задачи",
      "Minecraft с кодом: пишем скрипты для автоматизации в игре",
      "Проект на Python: простой бот или мини-игра в консоли",
      "Введение в алгоритмическое мышление: зачем нужны функции и как они работают",
      "Итог смены — работающий проект с кодом, который ребёнок сделал сам"
    ]
  },
  {
    h2: "Что ребёнок сделает за смену — конкретный результат",
    text: "Мы не «знакомим с IT» абстрактно. Каждая смена в АйДаКемп заканчивается защитой проекта — дети показывают, что создали, другим отрядам и родителям на заключительном мероприятии.",
    list: [
      "Мини-игра или quiz-бот на Python — можно запустить на любом компьютере",
      "Собственная Minecraft-карта с автоматизированными механизмами",
      "Навык: умеет объяснить, что такое переменная, условие, цикл — не зубрёжкой, а по смыслу",
      "Опыт командной работы: постановка задачи, разделение ролей, финальная презентация",
      "Портфолио — ссылка на GitHub или архив с проектами для школьного портфолио"
    ]
  },
  {
    h2: "Почему 10 лет — идеальный возраст для IT-лагеря",
    text: "10 лет — это момент, когда ребёнок уже достаточно самостоятелен, чтобы работать в команде, но ещё не потерял азарт открытий. В этом возрасте Python усваивается легче, чем в 14–15: нет страха «я не понимаю» и нет заученных «правильных» способов думать.",
    list: [
      "Мозг в 9–11 лет максимально пластичен — новые паттерны мышления закладываются легко",
      "Нет страха ошибки: дети этого возраста экспериментируют, а не боятся неправильного ответа",
      "Достаточно концентрации для 2–3 часов работы над проектом",
      "Командная игра естественна — легко вписывается в коллектив и находит друзей",
      "Первый серьёзный проект в 10 лет — это задел на весь подростковый возраст"
    ]
  },
  {
    h2: "Условия: бассейн, питание, проживание",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Детям 9–11 лет важен баланс между занятиями и активным отдыхом — именно так и устроен день.",
    list: [
      "Открытый бассейн — купание по расписанию каждый день в тёплую погоду",
      "4-разовое питание: разнообразное меню, учитываем аллергии",
      "Небольшие отряды — вожатый знает каждого по имени и следит за настроением",
      "Медицинский работник на территории 24/7",
      "Ежедневные фото и видео в родительском чате — мама видит ребёнка каждый день"
    ]
  },
  {
    h2: "Смены 2026 для детей 10 лет",
    text: "Для детей 9–11 лет подходят все смены. Смена 2 (14 дней) даёт больше времени на проект — рекомендуем для тех, кто уже знаком с компьютером и хочет сделать что-то серьёзное.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (максимальный результат)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Налоговый вычет 13% — возвращается через ФНС"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Детский лагерь для детей 10 лет — Python и игры | АйДаКемп"
  description="IT-лагерь для детей 10 лет в Подмосковье 2026. Python начальный, Minecraft с программированием, проект за смену. 66 км от МКАД, от 48 000 ₽."
  h1="Детский лагерь для детей 10 лет — Python и игры | АйДаКемп"
  canonical="https://aidacamp.ru/lager-10-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для детей 10 лет в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для детей 9–11 лет в АйДаКемп — Python начального уровня и Minecraft с программированием. Дети пишут первый настоящий код: переменные, условия, циклы. Итог смены — работающий проект: мини-игра или простой бот на Python, который можно запустить дома." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь ребёнку 10 лет без опыта программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, специально для таких детей. Программа начинается с нуля — никаких требований кроме умения читать и базовой работы с компьютером. Преподаватели объясняют через игровые задачи, без скучных учебников." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает ребёнок 10 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены каждый ребёнок защищает проект: мини-игра или quiz-бот на Python, или собственная карта в Minecraft с автоматизированными механизмами. Это не домашнее задание — это то, что ребёнок придумал и реализовал сам в команде." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена для детей 10 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание, занятия, активности. Доступен налоговый вычет 13% через ФНС." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 10 лет — Python и проект за смену"
    subtitle="Переход от «нажимать» к «создавать». Дети 9–11 лет пишут первый настоящий код и привозят домой работающий проект."
    breadcrumb="Лагерь для детей 10 лет"
    keywords={["Python с нуля для 9–11 лет", "Конкретный проект в финале смены", "10 лет — лучшее время начать"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь для детей 10 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
