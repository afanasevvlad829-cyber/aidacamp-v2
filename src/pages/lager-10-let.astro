---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Программа для 10 лет: Python (обязательно) + Roblox Studio или Minecraft Education",
    text: "В 10 лет — первый настоящий язык программирования. Python в группе 9–11 лет обязателен: переменные, условия, циклы, функции — через игровые задачи, без зубрёжки. Параллельно — выбор трека: Roblox Studio (скрипты на Lua, собственная игровая механика) или Minecraft Education (Python-скрипты для управления игровым миром). Оба трека ведут к одному: ребёнок видит, как его код оживляет игру в реальном времени.",
    list: [
      "Python обязательно: переменные, условия, циклы, функции — основа для всего дальнейшего",
      "Roblox Studio (трек 1): Lua-скрипты, механики игры, публикация карты",
      "Minecraft Education (трек 2): Python-скрипты управляют миром напрямую",
      "Командная работа: пары выбирают трек и делают совместный проект",
      "Итог смены — работающий проект с кодом, который ребёнок сделал сам"
    ]
  },
  {
    h2: "Типичный проект десятилетки: что он создаст за смену",
    text: "За смену школьник 10 лет делает проект на Python и проект в выбранном треке. Python-проект — мини-игра или простой бот, который запускается на любом компьютере. Roblox-проект — своя карта с механиками, доступная для игры другим. Minecraft-проект — мир с автоматизированными элементами через Python. На итоговом хакатоне каждая команда защищает проект перед всем лагерем.",
    list: [
      "Python-проект: игра с меню, уровнями и счётом или интерактивная викторина",
      "Roblox-карта: собственные механики, кнопки, события — открыта для игроков",
      "Или Minecraft-мир: Python-скрипты управляют постройками и NPC",
      "Публичная защита на хакатоне: команда объясняет что сделала и как это работает"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про десятилеток в IT-лагере:",
    list: [
      "«Не слишком ли сложно — сразу Python?» — Python в 10 лет — оптимально. Мы учим через игровые задачи: код сразу что-то делает, нет скучной теории. Если умеет читать и работает с компьютером — справится.",
      "«Roblox или Minecraft — что лучше?» — Оба трека приводят к одному результату: ребёнок пишет код, который оживляет игру. Выбор делает сам школьник в первый день. Педагог помогает определиться.",
      "«Нужен ли опыт программирования?» — Нет. Группа начинается с нуля, задачи подбираются под уровень каждого. Тех, кто уже что-то умеет, ставим на более сложные задачи.",
      "«Не заскучает ли без мамы?» — Вожатый рядом 24/7, соотношение 1:8. Telegram-фото из отряда каждый день. Большинство ребят к третьему дню заняты проектом и не скучают."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с возрастом 9–11 лет. Соотношение — 1 вожатый на 8 школьников. На территории дежурит медработник 24/7. Telegram-чат отряда: родители видят фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый ребёнок в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Как устроен день школьника 10 лет в лагере",
    text: "Расписание сделано так, чтобы ребёнок успевал и поработать, и отдохнуть. Занятия утром 2–3 часа блоками, потом бассейн, обед, тихий час. Вечером — командные игры и активности. Никакого перегруза.",
    list: [
      "Утро: Python + трек (Roblox или Minecraft) — 2–3 часа с перерывами",
      "Середина дня: бассейн, прогулка, обед",
      "Тихий час — обязательно",
      "Вечер: квесты, командные игры, подготовка к финальному хакатону",
      "Связь с родителями — звонок вечером, Telegram-фото каждый день"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для десятилеток подходит любая смена. Смена 2.1 (7 дней) идеальна для первого раза. За 10–14 дней успевает сложиться команда и получается более серьёзный проект. Июль традиционно заполняется первым.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN} (идеально для первого раза)`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX} (максимальный результат)`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа адаптируется под возраст. Что было до и что будет после:",
    list: [
      "<a href='/lager-9-let'>Лагерь для 9 лет</a> — Scratch → Python + Roblox Studio: первые шаги в настоящем коде",
      "<a href='/lager-11-let'>Лагерь для 11 лет</a> — Python + HTML/CSS + Roblox Advanced + AI intro",
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python и AI: боты, API-проекты, Gemini API",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Летний лагерь 10 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для детей 10 лет в Подмосковье 2026. Python + Roblox Studio или Minecraft Education. Реальный проект за смену. Вожатый 1:8. 66 км от МКАД от"
  h1="Детский лагерь для детей 10 лет в Подмосковье — АйДаКемп"
  canonical="https://aidacamp.ru/lager-10-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа для детей 10 лет в IT-лагере?", a: "Для детей 9–11 лет в АйДаКемп — Python обязательно (переменные, условия, циклы, функции) плюс выбор трека: Roblox Studio (Lua-скрипты) или Minecraft Education (Python-скрипты). Итог смены — работающий проект: Python-игра и карта в выбранном треке." },
    { q: "Roblox или Minecraft — что лучше выбрать?", a: "Оба трека приводят к одному результату: ребёнок пишет код, который оживляет игру. Roblox Studio — Lua-скрипты, механики, публикация карты. Minecraft Education — Python-скрипты управляют миром напрямую. Выбор делает сам ребёнок в первый день." },
    { q: "Что конкретно сделает ребёнок 10 лет за смену?", a: "Python-проект (игра с меню и уровнями или интерактивная викторина) плюс проект в выбранном треке: Roblox-карта с собственными механиками или Minecraft-мир с Python-скриптами. На хакатоне команда защищает проект перед всем лагерем." },
    { q: "Есть ли места в июле?", a: "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." },
    { q: "Сколько стоит лагерь для детей 10 лет?", a: `От ${PRICE_MIN} за смену 2.1 (7 дней, 10–16 июня 2026). Смены 10–14 дней — от ${PRICE_S4}. В стоимость входят проживание, питание, все занятия и активности. Можно оформить налоговый вычет 13%.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 10 лет в Подмосковье"
    subtitle="Python + Roblox Studio или Minecraft Education. Ребёнок сам выбирает трек и привозит проект, который работает."
    breadcrumb="Лагерь для детей 10 лет"
    keywords={["Python + Roblox Studio или Minecraft Education", "Вожатый 1:8, медработник 24/7", "Рабочий проект к концу смены"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь для детей 10 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-[14px] text-slate-500">
    <a href="/lager-9-let/" class="text-primary underline underline-offset-2">← Лагерь для 9 лет</a> · <a href="/lager-11-let/" class="text-primary underline underline-offset-2">Лагерь для 11 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
