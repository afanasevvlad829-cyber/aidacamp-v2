---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Маршрут из Мытищ в выездной лагерь",
    text: "АйДаКемп — выездной IT-лагерь с проживанием рядом с Мытищами, в санатории «Изумруд» Наро-Фоминского округа. АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час). Из Мытищ: на машине через МКАД и Киевское шоссе, либо до м. Солнцево и трансфер лагеря (2 000 ₽, ~40 мин).",
    list: [
      "На машине: Мытищи → МКАД → Киевское шоссе (А-101) — 66 км от МКАД, ~1 час без пробок",
      "МЦД-2: ст. Мытищи → Москва-Пасс. (Каланчёвская) → пересадка → м. Солнцево. Около 1 часа 10 минут. Трансфер лагеря от Солнцево — 2 000 ₽",
      "На метро: Мытищи → Ярославский вокзал → метро → м. Солнцево (~50–60 мин) → трансфер лагеря (2 000 ₽)",
      "Из Мытищинского района: Пушкино, Щёлково, Пирогово — ехать в АйДаКемп удобно через трансфер от Солнцево"
    ]
  },
  {
    h2: "Трансфер из Мытищ в лагерь",
    text: "Трансфер от м. Солнцево (2 000 ₽ в один конец) — в день заезда туда, в день отъезда обратно, с сопровождающим до лагеря. Из Мытищ до м. Солнцево — на метро около 50–60 минут.",
    list: [
      "Трансфер 2 000 ₽ в один конец, отправляется от м. Солнцево в день заезда",
      "Из Мытищ: Ярославское направление → Ярославский вокзал → метро → м. Солнцево, ~50–60 мин",
      "Обратно: трансфер привозит ребёнка на м. Солнцево в день отъезда",
      "Альтернатива: самостоятельно на машине — 66 км от МКАД по Киевскому шоссе"
    ]
  },
  {
    h2: "Налоговый вычет для семей из Мытищ",
    text: "АйДаКемп — лицензированная образовательная организация. Вычет 13% от стоимости образовательной части доступен всем налогоплательщикам РФ, в том числе жителям Мытищ. Оформление — онлайн через nalog.ru.",
    list: [
      `Смена 7 дней (${PRICE_MIN}) → возврат ~2 800 ₽`,
      `Смена 10 дней (${PRICE_S4}) → возврат ~4 800 ₽`,
      `Смена 14 дней (${PRICE_MAX}) → возврат до 5 434 ₽`,
      "Договор и чеки выдаём при заезде — больше ничего не нужно"
    ]
  },
  {
    h2: "Выездной IT-лагерь рядом с Мытищами",
    text: "Мытищи — третий по размеру город Московской области, 275 000 человек. Город с сильной производственной историей: Metrovagonmash делает вагоны метро, которыми ездят все москвичи. Ребята из таких семей умеют видеть результат труда. В АйДаКемп ваш сын или дочь сделает своё: бота, игру, AI-проект — и на финале смены покажет всему лагерю.",
    list: [
      "Трансфер от м. Солнцево (2 000 ₽) — метро из Мытищ прямо до станции",
      "66 км от МКАД по Киевскому шоссе, ~1 час без пробок",
      "Нет акклиматизации, тот же климатический пояс",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7",
      "Ежедневные фото в Telegram — видите, чем занимается ребёнок, каждый день",
      "В июне и августе ещё есть места"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет без опыта программирования. Группы формируются по уровню, занятия в группах до 8 человек — каждый ребёнок получает внимание преподавателя.",
    list: [
      "Дети без опыта — начинаем с нуля, результат виден уже на 3-й день",
      "Дети с базой — получат более сложные задачи и реальный проект на хакатоне",
      "Дети, «зависшие» в играх — направляем интерес в Minecraft, Roblox или Python",
      "Дети 7–10 лет — специальные треки на Scratch и Minecraft Education"
    ]
  },
  {
    h2: "Отзывы родителей из Мытищ",
    text: "В АйДаКемп едут ребята со всего севера и востока Подмосковья. Вот что говорят родители из Мытищ:",
    list: [
      "«Сначала сомневалась — расстояние смущало. Потом посчитала: это 50 минут метро. Меньше, чем я в пробках стою» — Наталья, Пушкино",
      "«Метро до Солнцево, трансфер — и дочь на месте. Я переживала больше неё. Вернулась с проектом на Python, показывала всем подругам в классе» — Елена, Мытищи",
      "«Думала, далеко. Но сын доехал сам на метро и трансфере. Зато провёл лето с пользой, а не за видеоиграми. Едем снова» — Анна, Мытищи",
      "«Мытищи — север, лагерь — юго-запад. Казалось бы. Но на метро до Солнцево несложно, и трансфер там. Дочь вернулась другим человеком» — Ольга, Мытищи"
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "В смене АйДаКемп работают два типа взрослых: IT-преподаватели (ведут учебные блоки, 1 педагог на 6–8 ребят) и вожатые (отвечают за жизнь в лагере, организацию досуга, безопасность). Вожатые — студенты педагогических и психологических специальностей, проходящие конкурсный отбор. IT-преподаватели — практикующие разработчики и выпускники технических вузов. Медицинский работник находится на территории в течение всей смены.",
    list: [
      "Соотношение: 1 преподаватель на 6–8 учеников в группе",
      "Вожатые — конкурсный отбор, студенты педагогических специальностей",
      "Медработник круглосуточно на территории",
      "Ежедневные фото в Telegram — родители видят, чем занимается ребёнок"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В июне и августе ещё есть места. В стоимость включены проживание, питание, полная IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ в один конец.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX}`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Выездной детский лагерь рядом с Мытищами 2026 | АйДаКемп"
  description="Выездной IT-лагерь с проживанием рядом с Мытищами: 66 км от МКАД, трансфер от м. Солнцево. Налоговый вычет до 5 434 ₽. Python, AI, Minecraft, 7–15 лет."
  h1="Лагерь для детей из Мытищ"
  canonical="https://aidacamp.ru/lager-mytishchi"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Мытищ до выездного лагеря АйДаКемп?", a: "На машине: Мытищи → МКАД → Киевское шоссе (А-101), 66 км от МКАД, ~1 час без пробок. Или: метро из Мытищ до м. Солнцево (~50–60 мин) → трансфер лагеря (2 000 ₽) в день заезда." },
    { q: "Сколько ехать из Мытищ до лагеря?", a: "66 км от МКАД по Киевскому шоссе, ~1 час без пробок на машине. На трансфере: ~50–60 минут на метро до м. Солнцево плюс поездка автобусом." },
    { q: "Есть ли трансфер из Мытищ?", a: "Трансфер от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим до лагеря. Из Мытищ до м. Солнцево — ~50–60 минут на метро (Ярославское направление → пересадка)." },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: "Да, налоговый вычет 13% от образовательной части. Возврат: от ~2 800 ₽ до 5 434 ₽ (максимум за 14-дневную смену). Документы выдаём при заезде." },
    { q: "Сколько стоит путёвка в лагерь?", a: `От ${PRICE_MIN} за смену 7 дней. 14-дневная смена — ${PRICE_MAX}. Август: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит всё кроме трансфера.` }
  ]} />
    <CourseSchema
      name="Выездной детский IT-лагерь рядом с Мытищами — АйДаКемп"
      description="Выездной IT-лагерь с проживанием в Наро-Фоминском округе, 66 км от МКАД, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-mytishchi"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для детей из Мытищ"
subtitle="Выездной IT-лагерь с проживанием рядом с Мытищами — 66 км от МКАД, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Мытищ"
keywords={["66 км от МКАД, трансфер от м. Солнцево (2 000 ₽)", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Выездной, с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Лагерь для детей из Мытищ — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>

    </p>
    <p class="mt-3 text-[14px] text-slate-500">
      Смотрите также: <a href="/smeny" class="text-primary hover:underline">смены и даты 2026</a> — <a href="/stoimost" class="text-primary hover:underline">стоимость и что входит</a> — <a href="/programmy" class="text-primary hover:underline">программы IT-треков</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
