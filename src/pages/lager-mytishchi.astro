---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Маршрут из Мытищ в АйДаКемп — ~75 км, ~1 ч 20 мин",
    text: "АйДаКемп — в Наро-Фоминском районе, в санатории «Изумруд» у Апрелевки. Из Мытищ ехать через МКАД и Калужское шоссе — дорога несложная, пробок в сторону области практически нет.",
    list: [
      "На машине: Мытищи → МКАД (объезд с севера на юг) → Калужское шоссе А-101 → Апрелевка — ~75 км, около 1 часа 20 минут без пробок",
      "На метро и трансфере: Мытищи → МКЖД или Ярославское направление → метро → м. Солнцево (~50–60 мин) → бесплатный трансфер лагеря",
      "Важно: из Мытищ до м. Солнцево — прямой маршрут метро без пересадок после Комсомольской"
    ]
  },
  {
    h2: "Трансфер из Мытищ в лагерь",
    text: "Бесплатный трансфер от м. Солнцево — в день заезда туда, в день отъезда обратно. Из Мытищ до м. Солнцево — на метро около 50–60 минут.",
    list: [
      "Трансфер бесплатный, отправляется от м. Солнцево в день заезда",
      "Из Мытищ: Ярославское направление → Ярославский вокзал → метро → м. Солнцево, ~50–60 мин",
      "Обратно: трансфер привозит ребёнка на м. Солнцево в день отъезда",
      "Альтернатива: самостоятельно на машине — ~75 км по МКАД и Калужскому шоссе"
    ]
  },
  {
    h2: "Налоговый вычет для семей из Мытищ",
    text: "АйДаКемп — лицензированная образовательная организация. Вычет 13% от стоимости образовательной части доступен всем налогоплательщикам РФ, в том числе жителям Мытищ. Оформление — онлайн через nalog.ru.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽",
      "Договор и чеки выдаём при заезде — больше ничего не нужно"
    ]
  },
  {
    h2: "Почему родители из Мытищ выбирают АйДаКемп",
    text: "Мытищи — север Подмосковья, но до АйДаКемп добираются через удобный трансфер от м. Солнцево. Никакой акклиматизации: ребёнок в том же климате, что дома, а за смену создаёт реальный IT-проект. Территория санатория закрытая, медработник круглосуточно.",
    list: [
      "Трансфер от м. Солнцево — метро из Мытищ прямо до станции",
      "~90 км от Мытищ, около 1.5–2 часов в пути",
      "Нет акклиматизации, тот же климатический пояс",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет без опыта программирования. Группы формируются по уровню, занятия в группах до 8 человек — каждый ребёнок получает внимание преподавателя.",
    list: [
      "Дети без опыта — начинаем с нуля, результат виден уже на 3-й день",
      "Дети с базой — получат более сложные задачи и реальный проект на хакатоне",
      "Дети, «зависшие» в играх — направляем интерес в Minecraft, Roblox или Python",
      "Дети 7–10 лет — специальные треки на Scratch и Minecraft Education"
    ]
  },
  {
    h2: "Отзывы родителей из Мытищ",
    text: "В АйДаКемп едут дети со всего севера и востока Подмосковья. Вот что говорят родители из Мытищ:",
    list: [
      "«Метро до Юго-Западной, трансфер — и дочь на месте. Я переживала больше неё. Вернулась с проектом на Python, показывала всем подругам в классе» — Елена, Мытищи",
      "«Думала, далеко. Но сын доехал сам на метро и трансфере. Зато провёл лето с пользой, а не за видеоиграми. Едем снова» — Анна, Мытищи",
      "«Мытищи — север, лагерь — юго-запад. Казалось бы. Но на метро до Юго-Западной несложно, и трансфер там. Дочь вернулась другим человеком» — Ольга, Мытищи",
      "«Сначала сомневалась — расстояние смущало. Потом посчитала: это 50 минут метро. Меньше, чем я в пробках стою» — Наталья, Пушкино"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — бесплатный.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагерь Мытищи для детей 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Мытищами: 1.5–2 часа по Калужскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Лагерь для детей из Мытищ"
  canonical="https://aidacamp.ru/lager-mytishchi"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Мытищ до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "На машине: Мытищи → МКАД → Калужское шоссе А-101 → Апрелевка, ~75 км, около 1 часа 20 минут. Или: метро из Мытищ до м. Солнцево (~50–60 мин) → бесплатный трансфер лагеря в день заезда." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Мытищ до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа 20 минут на машине (~75 км через МКАД и Калужское шоссе). На трансфере: ~50–60 минут на метро до м. Солнцево плюс поездка автобусом." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Мытищ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер от м. Солнцево в день заезда. Из Мытищ до м. Солнцево — ~50–60 минут на метро (Ярославское направление → пересадка)." }
        },
        {
          "@type": "Question",
          "name": "Можно ли вернуть часть стоимости путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, налоговый вычет 13% от образовательной части. Возврат: от ~2 800 ₽ до 5 434 ₽ (максимум за 14-дневную смену). Документы выдаём при заезде." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней. 14-дневная смена — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит всё кроме трансфера." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Мытищами — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5–2 часа от Мытищ. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-mytishchi"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для детей из Мытищ"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Мытищ, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Мытищ"
    keywords={["~1.5 часа от Мытищ, трансфер от м. Солнцево", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Лагерь для детей из Мытищ — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
