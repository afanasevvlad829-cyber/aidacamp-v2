---
import { PRICE_MAX, PRICE_MIN, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import FAQSchema from '../components/FAQSchema.astro';
import { SEASON_MONTHS_NOM } from '../data/evergreen';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Название лагерей в москве ${SEASON_YEAR} — IT-лагерь АйДаКемп`}
  description={`Название лагерей в москве — АйДаКемп в Подмосковье ${SEASON_YEAR}. Python, AI, Minecraft, бассейн. Смены ${SEASON_MONTHS_NOM}, от ${PRICE_MIN}. Трансфер от м. Солнцево.`}
  h1={`Название лагерей в москве ${SEASON_YEAR} — АйДаКемп`}
  canonical="https://aidacamp.ru/nazvanie-lagerey-v-moskve"
  noindex={true}
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: `Есть ли название лагерей в москве с проживанием в ${SEASON_YEAR}?`, a: `АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Москве. Смены 7–14 дней, летом ${SEASON_YEAR}, для школьников 7–15 лет.` },
    { q: "Как добраться до лагеря из Москве?", a: "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе." },
    { q: `Сколько стоит лагерь в ${SEASON_YEAR} году?`, a: `От ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до ${VYCHET_MAX}.` }
  ]} />
  </Fragment>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Название лагерей в москве {SEASON_YEAR} — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Москве — организованный трансфер от м. Солнцево (2 000 ₽).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от {PRICE_MIN}, налоговый вычет 13% — до {VYCHET_MAX}.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, 2 000 ₽</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 7–14 дней, июнь и август {SEASON_YEAR}</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-base text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Смены {SEASON_MONTHS_NOM} {SEASON_YEAR}, от {PRICE_MIN}.
        Налоговый вычет 13% — до {VYCHET_MAX}.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-base text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny/" class="text-primary hover:underline">цены и смены {SEASON_YEAR}</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
