---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Почему близость лагеря к дому действительно важна",
    text: "Когда мамы говорят «ищу лагерь рядом с домом» — они чаще всего имеют в виду не «в 5 минутах пешком», а «чтобы можно было съездить при необходимости». По нашему опыту, оптимальное расстояние — до 1.5 часов езды. Это достаточно далеко, чтобы ребёнок по-настоящему отключился от домашней рутины, и достаточно близко, чтобы родители чувствовали себя спокойно. АйДаКемп находится в Наро-Фоминском районе — 66 км от МКАД по Киевскому шоссе."
  },
  {
    h2: "Как добраться из Москвы — 3 способа",
    text: "Большинство семей добираются одним из трёх способов. Выбирайте удобный — всё организуем заранее.",
    list: [
      "На машине — 66 км по Киевскому шоссе, около 1 часа без пробок. Въезд на территорию через КПП",
      "Трансфером от лагеря — автобус от м. Солнцево, отправление в день заезда утром. Удобно для родителей без машины",
      "На электричке + такси — Киевский вокзал → Апрелевка, затем такси 15 минут. Дорого, но вариант есть"
    ]
  },
  {
    h2: "Из каких городов Подмосковья приезжают дети",
    text: "АйДаКемп — один из немногих лагерей, куда активно везут детей из ближнего Подмосковья. Чаще всего приезжают из Одинцово, Подольска, Красногорска, Балашихи, Люберец, Реутова и Химок. Из центра Москвы — тоже много детей. Для всех это примерно одинаковое расстояние — около часа езды.",
    list: [
      "Одинцово, Апрелевка — 15–20 минут от лагеря",
      "Подольск — ~45 минут через Киевское шоссе",
      "Красногорск, Химки — ~1 час по Минскому или Киевскому шоссе",
      "Балашиха, Люберцы — ~1.5 часа, удобнее с трансфером от метро"
    ]
  },
  {
    h2: "Организованный трансфер: как это работает",
    text: "Лагерный трансфер отправляется от м. Солнцево Солнцевской линии. Ребёнка можно сдать вожатому прямо у метро — дальше они доедут вместе. Обратно так же: забираете у метро в день выезда. Стоимость трансфера — 2 000 ₽ в одну сторону, оплата при бронировании.",
    list: [
      "Сбор у м. Солнцево в день заезда — время уточняется при бронировании",
      "Вожатый встречает у выхода из метро",
      "Выезд из лагеря в день отъезда — доставляем обратно к метро",
      "Стоимость — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Смены лета 2026 — выбрать и записать",
    text: "Смены проходят с июня по август. Чем раньше бронировать — тем больше выбор дат и мест. Одновременно в лагере не более 45 детей.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с домом в Подмосковье — как найти"
  description="Детский IT-лагерь рядом с Москвой. АйДаКемп — 66 км от МКАД, трансфер от м. Солнцево. Смены июнь–август 2026, от 48 000 ₽. Лицензия, медработник 24/7."
  h1="Детский лагерь рядом — АйДаКемп, 66 км от МКАД"
  canonical="https://aidacamp.ru/lager-ryadom"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как далеко находится АйДаКемп от Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп расположен в Наро-Фоминском районе Московской области, 66 км от МКАД по Киевскому шоссе. На машине — около 1 часа без пробок. Это оптимальное расстояние: достаточно близко, чтобы можно было приехать при необходимости, и достаточно далеко, чтобы ребёнок по-настоящему переключился." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер в лагерь из Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Лагерный трансфер отправляется от м. Солнцево Солнцевской линии метро. Ребёнка сдают вожатому у метро — дальше они едут вместе. Стоимость 2 000 ₽ в одну сторону, оплачивается при бронировании." }
        },
        {
          "@type": "Question",
          "name": "Из каких городов Подмосковья лучше всего добираться до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ближе всего из Одинцово и Апрелевки — 15–20 минут. Из Подольска — около 45 минут. Из Красногорска и Химок — около 1 часа. Из Балашихи и Люберец удобнее воспользоваться трансфером от м. Солнцево." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом — АйДаКемп, 66 км от МКАД"
    subtitle="IT-лагерь в Подмосковье с трансфером от метро. Python, AI, Minecraft — реальный проект за смену."
    breadcrumb="Лагерь рядом с домом"
    keywords={["66 км от МКАД по Киевскому шоссе", "Трансфер от м. Солнцево в день заезда", "Смены июнь–август, от 48 000 ₽"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Москвой в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
