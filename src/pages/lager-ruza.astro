---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MIN, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { PAYMENT_SPLIT } from '../data/contacts';

const sections = [
  {
    h2: "IT-лагерь рядом с Рузой — то же западное направление, ~1–1,5 часа",
    text: "Руза — зелёный западный край Подмосковья, и АйДаКемп стоит с той же стороны области. До санатория «Изумруд» от Рузы примерно 55 км и около 1–1,5 часа по А108, большому бетонному кольцу: вы движетесь поперёк западного Подмосковья, не заезжая в Москву. Подросток едет не за тридевять земель, а в соседний лесной район — и привозит оттуда собственный IT-проект. Загородный отдых на свежем воздухе и IT-программа — в одном месте: Наро-Фоминский район известен лесами и чистым воздухом вдали от промышленных зон."
  },
  {
    h2: "Маршрут из Рузы в АйДаКемп — около 1–1,5 часа",
    text: "Рузу и наш лагерь связывает А108 (большое бетонное кольцо), которое идёт по западу области в обход столицы. Дорога занимает примерно час-полтора в зависимости от точки старта — без выезда на МКАД и без столичных пробок. Сам лагерь — 66 км от МКАД по Киевскому шоссе. Адрес: Московская область, Наро-Фоминский городской округ, территория санатория «Изумруд» (координаты 55.265643, 36.724185).",
    list: [
      "На машине: из Рузы по А108 (большое бетонное кольцо) к Киевскому шоссе, около 1–1,5 часа",
      "Электричка: с пересадкой до ст. Нара (~1,5–2 ч), далее такси ~20 мин до лагеря",
      "Трансфер лагеря от м. Солнцево — 2 000 ₽; из Рузы до метро удобнее на машине ~1 ч"
    ]
  },
  {
    h2: "Трансфер из Рузы в лагерь",
    text: "Трансфер лагеря (2 000 ₽ в один конец, с сопровождающим) отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Рузы до точки сбора путь неблизкий, поэтому многие семьи едут сразу в лагерь по А108 — это около 1–1,5 часа и без крюка через метро.",
    list: [
      "Трансфер 2 000 ₽ в один конец, от м. Солнцево в день заезда и обратно в день отъезда",
      "Из Рузы удобнее ехать напрямую в лагерь по А108, минуя точку сбора",
      "Самостоятельный заезд — около 1–1,5 часа по своему западному направлению"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Рузы",
    text: "АйДаКемп — лицензированная образовательная организация. Семьи из Рузы оформляют налоговый вычет так же, как и москвичи: через личный кабинет налоговой на nalog.ru.",
    list: [
      `Смена 4 — 10 дней (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 — 13 дней (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Чем заняты школьники в IT-лагере",
    text: "АйДаКемп — лагерь с серьёзной технологической программой и проектом на финале. Ребята 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут, ведут практикующие IT-специалисты. По инфраструктуре АйДаКемп устроен как детский оздоровительный лагерь: санаторная территория «Изумруд», питание 5 раз в день по нормам СанПиН, медработник круглосуточно — и плюс серьёзная IT-программа.",
    list: [
      "Бассейн с ионизированной водой, спортивные площадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают преподаватели-практики и воспитатели с педагогическим образованием. Родители из Рузы всегда видят, чем занят их подросток в течение дня.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Почему семьи из Рузы выбирают АйДаКемп",
    text: "Руза и наш лагерь — на одной западной стороне Подмосковья, их связывает бетонка А108. Дорога не самая короткая, но обходит столицу стороной:",
    list: [
      "~1–1,5 часа от Рузы по А108 — без выезда на МКАД и без столичных пробок",
      "Тот же западный климат и природа — никакой акклиматизации, подросток сразу в ритм",
      "Можно приехать на родительский день в середине смены — навестить и привезти вещи",
      "Самостоятельный заезд по своему направлению — удобнее, чем добираться через Москву",
      "Безопасность: закрытая территория с КПП и охраной, медработник 24/7 — родители всегда знают, что подросток под присмотром"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — цены и наличие мест`,
    text: `Июль ${SEASON_YEAR} занят полностью. В июне и августе ещё остаются свободные места — бронируйте сейчас. Оформить путёвку можно онлайн за 10 минут: оплата 50% сейчас, официальный договор на почту, налоговый вычет 13%. В стоимость входят проживание, питание, полная IT-программа, бассейн и активности.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      "Трансфер от м. Солнцево — 2 000 ₽ отдельно",
      PAYMENT_SPLIT
    ]
  },
  {
    h2: "Отзывы семей из Рузы и западного Подмосковья",
    text: "В АйДаКемп приезжают ребята из рузского района и других мест западного Подмосковья: Тучково, Дорохово, Звенигород. Вот что рассказывают родители:",
    list: [
      "«Мы с лагерем на одной стороне области — доехали по бетонке примерно за час с небольшим, минуя Москву. Это спокойнее, чем пилить через центр» — Наталья, Руза",
      "«Дочь привезла свою игру на Python и теперь хочет учиться этому дальше. Лето прошло не зря» — Елена, Тучково",
      "«Возили сами по А108, без трансфера. Приезжали на родительский день — территория ухоженная, ребёнок довольный» — Сергей, Дорохово"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Детский IT- лагерь рядом с Рузой ${SEASON_YEAR} | АйДаКемп`}
  description={`Лагерь Рузы: летний IT, Python, AI для 7–15 лет. От ${PRICE_MIN}, вычет до ${VYCHET_MAX}.`}
  h1="Летний детский IT- лагерь рядом с Рузой"
  canonical="https://aidacamp.ru/lager-ruza"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Рузы до лагеря АйДаКемп?", a: "Из Рузы — около 1–1,5 часа на машине по А108 (большому бетонному кольцу) к Киевскому шоссе, без выезда на МКАД. Руза и лагерь на западной стороне Подмосковья, поэтому ехать можно в обход Москвы. Сам лагерь — 66 км от МКАД." },
    { q: "Есть ли трансфер из Рузы?", a: "Прямого трансфера из Рузы нет. Есть трансфер лагеря от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим. Но из Рузы удобнее ехать сразу в лагерь по А108 — это около 1–1,5 часа без крюка к метро." },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%. Для семей из Рузы это работает так же, как для москвичей: документы через nalog.ru. Возврат от ~${VYCHET_S4} (10-дневная смена) до ${VYCHET_MAX} (13-дневная).` },
    { q: "Для каких ребят подходит лагерь?", a: "Для школьников 7–15 лет. Опыт программирования не нужен — принимаем с нуля. Занятия в группах до 8 человек." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — подросток выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Рузой — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, около 1–1,5 часа от Рузы по А108. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-ruza"
      ageMin={7}
      ageMax={15}
    />

    <FAQSchema items={[
    { q: "Как быстро добраться из Рузы в АйДаКемп?", a: "Около 1–1,5 часа на машине: Руза и лагерь на западе Подмосковья, по А108 (большому бетонному кольцу) выезжаете к Киевскому шоссе в обход Москвы. Сам лагерь — 66 км от МКАД. Трансфер лагеря от м. Солнцево — 2 000 ₽." },
    { q: "Входит ли в стоимость трансфер из Рузы?", a: "Трансфер платный — 2 000 ₽ в один конец, от м. Солнцево. Из Рузы до точки сбора путь неблизкий, поэтому удобнее привезти ребёнка прямо в лагерь по А108 — около 1–1,5 часа." },
    { q: "Можно ли заехать в лагерь в середине смены из Рузы?", a: "Да. На родительский день из Рузы доехать реально — около 1–1,5 часа по западному направлению, можно навестить ребят и привезти забытые вещи." },
    { q: "Какой налоговый вычет получит родитель из Рузы?", a: `На 10-дневную смену (${PRICE_S4}) — возврат ~${VYCHET_S4}; на 13-дневную (${PRICE_S3}) — до ${VYCHET_MAX}. Оформляется через nalog.ru как у москвичей.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний детский IT- лагерь рядом с Рузой"
    subtitle="IT-лагерь в Наро-Фоминском районе — около 1–1,5 часа от Рузы по А108, оба на западе Подмосковья. Трансфер от м. Солнцево 2 000 ₽."
    breadcrumb="Лагерь из Рузы"
    keywords={["~1–1,5 часа от Рузы по А108, в обход Москвы", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь рядом с Рузой — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-[14px] text-slate-500 mt-2">
      Смотрите также: <a href="/lager-zvenigorod/" class="text-primary hover:underline">лагерь рядом со Звенигородом</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты {SEASON_YEAR}</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Как быстро добраться из Рузы в АйДаКемп?</h2>
  <p><strong>Время:</strong> около 1–1,5 часа на машине из Рузы — по А108 (большому бетонному кольцу) к Киевскому шоссе, без выезда на МКАД.</p>
  <p><strong>Направление:</strong> Руза и лагерь на западной стороне Подмосковья, поэтому ехать можно в обход Москвы.</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, 2 000 ₽ в один конец; из Рузы удобнее ехать сразу в лагерь.</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
