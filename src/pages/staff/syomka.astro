---
// Как снять круто на телефон — памятка для вожатых и преподавателей.
// Доступ: cookie staff_auth_2026 (логин на /staff). noindex.
export const prerender = true;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex,nofollow">
<title>Как снять круто на телефон · АйДаКемп</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style is:global>
  :root{
    --bg:#f1f5f9;--surface:#fff;--surface2:#f8fafc;--border:#e2e8f0;--border2:#cbd5e1;
    --orange:#f97316;--orange-d:#ea580c;--orange-bg:rgba(236,124,0,.08);--orange-border:rgba(236,124,0,.3);
    --text:#0f172a;--text2:#334155;--text3:#64748b;
    --green:#16a34a;--green-bg:rgba(22,163,74,.10);--red:#dc2626;--red-bg:rgba(220,38,38,.08);
    --blue:#2563eb;--blue-bg:rgba(37,99,235,.08);--purple:#9333ea;--radius:14px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;background:var(--bg);color:var(--text);font-size:16px;line-height:1.6;min-height:100vh}
  button,a{font-family:inherit}

  /* ── TOPBAR ── */
  .topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 16px;height:56px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(15,23,42,.06)}
  .topbar-logo{font-weight:800;font-size:15px;color:var(--orange);display:flex;align-items:center;gap:8px;white-space:nowrap}
  .topbar-title{font-size:14px;font-weight:600;color:var(--text2);border-left:1px solid var(--border);padding-left:12px}
  .back-btn{margin-left:auto;display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text2);font-size:13px;font-weight:600;text-decoration:none;transition:all .15s;white-space:nowrap}
  .back-btn:hover{border-color:var(--orange);color:var(--orange)}

  .wrap{max-width:760px;margin:0 auto;padding:22px 16px 80px}

  /* ── HERO ── */
  .hero{background:linear-gradient(135deg,#fff7ed 0%,#fdf2f8 100%);border:1px solid var(--orange-border);border-radius:20px;padding:24px 22px;margin-bottom:22px}
  .hero h1{font-size:26px;font-weight:800;line-height:1.2;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .hero h1 i{color:var(--orange)}
  .hero p{font-size:15px;color:var(--text2);line-height:1.6}
  .hero p + p{margin-top:10px}
  .hero .pin{display:inline-flex;align-items:center;gap:7px;margin-top:14px;background:var(--surface);border:1px solid var(--orange-border);border-radius:30px;padding:7px 14px;font-size:13px;font-weight:600;color:var(--orange-d)}

  /* ── SECTION ── */
  .sec-title{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text3);margin:30px 0 12px}
  .sec-title i{font-size:16px;color:var(--orange)}

  /* ── SCENARIO CARDS ── */
  .scenes{display:grid;grid-template-columns:1fr;gap:12px}
  .scene{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);overflow:hidden}
  .scene-head{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--surface2);border-bottom:1px solid var(--border)}
  .scene-ic{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;flex-shrink:0}
  .scene-ic.blue{background:var(--blue)}.scene-ic.green{background:var(--green)}.scene-ic.purple{background:var(--purple)}.scene-ic.orange{background:var(--orange)}
  .scene-name{font-size:16px;font-weight:700;color:var(--text)}
  .scene-tag{font-size:12px;color:var(--text3);margin-top:1px}
  .scene-body{padding:6px 16px 14px}
  .scene-body ol{margin:8px 0 0;padding-left:20px}
  .scene-body li{font-size:14.5px;color:var(--text2);line-height:1.55;margin-bottom:7px}
  .scene-body li b{color:var(--text)}

  /* ── RULE LIST ── */
  .rules{display:flex;flex-direction:column;gap:8px}
  .rule{display:flex;gap:13px;align-items:flex-start;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:13px 15px}
  .rule-n{flex-shrink:0;width:28px;height:28px;border-radius:8px;background:var(--orange-bg);color:var(--orange-d);font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
  .rule-t{font-size:15px;color:var(--text2);line-height:1.55}
  .rule-t b{color:var(--text)}

  /* ── DETAILS / collapsible ── */
  details.blk{background:var(--surface);border:1.5px solid var(--border);border-radius:12px;margin-bottom:10px;overflow:hidden}
  details.blk[open]{border-color:var(--orange-border)}
  details.blk > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:11px;padding:14px 16px;font-size:15.5px;font-weight:700;color:var(--text);user-select:none}
  details.blk > summary::-webkit-details-marker{display:none}
  details.blk > summary i.lead{font-size:19px;color:var(--orange);width:24px;text-align:center;flex-shrink:0}
  details.blk > summary .chev{margin-left:auto;color:var(--text3);transition:transform .2s}
  details.blk[open] > summary .chev{transform:rotate(180deg)}
  .blk-body{padding:2px 16px 16px}
  .blk-body ul{list-style:none;display:flex;flex-direction:column;gap:9px}
  .blk-body li{display:flex;gap:10px;font-size:14.5px;color:var(--text2);line-height:1.55}
  .blk-body li i{color:var(--green);font-size:15px;margin-top:3px;flex-shrink:0}
  .blk-body li b{color:var(--text)}
  .blk-body li.warn i{color:var(--red)}

  /* ── QUESTIONS ── */
  .qbox{background:var(--blue-bg);border:1.5px solid rgba(37,99,235,.25);border-radius:var(--radius);padding:18px 18px 8px}
  .qbox p.intro{font-size:14px;color:var(--text2);margin-bottom:14px;line-height:1.55}
  .q{display:flex;gap:11px;align-items:flex-start;margin-bottom:11px}
  .q i{color:var(--blue);font-size:16px;margin-top:2px;flex-shrink:0}
  .q span{font-size:15px;color:var(--text);line-height:1.5}
  .qbox .tip{font-size:13px;color:var(--text3);border-top:1px dashed rgba(37,99,235,.3);padding-top:12px;margin-top:4px;line-height:1.55}

  /* ── CHECKLIST ── */
  .chk{display:flex;flex-direction:column;gap:7px}
  .chk label{display:flex;gap:11px;align-items:flex-start;background:var(--surface);border:1.5px solid var(--border);border-radius:11px;padding:12px 14px;cursor:pointer;transition:all .15s}
  .chk label:hover{border-color:var(--orange)}
  .chk input{margin-top:2px;width:18px;height:18px;accent-color:var(--orange);flex-shrink:0;cursor:pointer}
  .chk span{font-size:15px;color:var(--text);line-height:1.5}
  .chk input:checked + span{text-decoration:line-through;color:var(--text3)}

  /* ── MISTAKES ── */
  .miss{display:flex;flex-direction:column;gap:7px}
  .miss .m{display:flex;gap:11px;align-items:flex-start;background:var(--red-bg);border:1px solid rgba(220,38,38,.2);border-radius:11px;padding:12px 14px}
  .miss .m i{color:var(--red);font-size:16px;margin-top:2px;flex-shrink:0}
  .miss .m span{font-size:14.5px;color:var(--text2);line-height:1.55}
  .miss .m span b{color:var(--text)}

  .footer-note{margin-top:32px;padding:16px;background:var(--surface);border:1px dashed var(--border2);border-radius:12px;font-size:13.5px;color:var(--text3);line-height:1.6;text-align:center}
  .footer-note b{color:var(--text2)}

  /* ── EXAMPLES (схемы кадров) ── */
  .ex-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .ex{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:14px;display:flex;flex-direction:column;gap:10px}
  .ex-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .ex-frame{position:relative;border-radius:9px;overflow:hidden;border:2px solid var(--border)}
  .ex-frame svg{display:block;width:100%;height:auto}
  .ex-frame.good{border-color:var(--green)}
  .ex-frame.bad{border-color:var(--red)}
  .ex-badge{position:absolute;top:6px;left:6px;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px}
  .ex-badge.good{background:var(--green)}.ex-badge.bad{background:var(--red)}
  .ex-cap{font-size:14px;color:var(--text2);line-height:1.5}
  .ex-cap b{color:var(--text)}
  /* лента «4 плана» */
  .plans{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:14px}
  .plan{display:flex;flex-direction:column;gap:6px;text-align:center}
  .plan .ex-frame{border-color:var(--orange-border)}
  .plan-name{font-size:12.5px;font-weight:700;color:var(--text)}
  .plan-sub{font-size:11px;color:var(--text3);line-height:1.35}

  @media (max-width:600px){
    .hero h1{font-size:22px}
    .wrap{padding:16px 13px 80px}
    .ex-grid{grid-template-columns:1fr}
    .plans{grid-template-columns:1fr 1fr}
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-logo"><i class="bi bi-camera-reels-fill"></i> АйДаКемп</div>
  <div class="topbar-title">Съёмка на телефон</div>
  <a class="back-btn" href="/staff"><i class="bi bi-arrow-left"></i> На портал</a>
</div>

<div class="wrap">

  <!-- HERO -->
  <div class="hero">
    <h1><i class="bi bi-camera-reels-fill"></i> Как снять круто на телефон</h1>
    <p>Памятка для вожатых и преподавателей. Снимать умеет каждый — нужны не дорогая техника и не оператор, а пара простых привычек. Всё работает и на iPhone, и на Android.</p>
    <p><b>Снимаем не «для отчёта», а так, чтобы мама захотела переслать этот ролик подружкам.</b> Тёплый кадр, живая эмоция, улыбка — вот цель. Не идеальная картинка, а живая.</p>
    <p style="font-size:14px;color:var(--text3)"><i class="bi bi-emoji-smile" aria-hidden="true"></i> Стесняетесь снимать? Это нормально. Начните с деталей — руки на клавиатуре, экран с проектом, мяч в полёте. Лиц можно вообще не снимать, а ролик уже живой.</p>
    <span class="pin"><i class="bi bi-stopwatch"></i> 5 минут на чтение · сохраните в закладки телефона</span>
  </div>

  <!-- БЫСТРЫЕ РЕЦЕПТЫ ПО СЦЕНАМ -->
  <div class="sec-title"><i class="bi bi-magic"></i> Быстрые рецепты по сценам</div>
  <div class="scenes">

    <div class="scene">
      <div class="scene-head">
        <div class="scene-ic blue"><i class="bi bi-laptop"></i></div>
        <div><div class="scene-name">Работа за компьютером</div><div class="scene-tag">Занятие · программирование · проект</div></div>
      </div>
      <div class="scene-body">
        <ol>
          <li><b>Свет на лицо, не в спину.</b> Посадите так, чтобы окно было перед ребёнком или сбоку, а не за ним — иначе получите тёмный силуэт.</li>
          <li><b>Снимайте процесс, не постановку.</b> Не просите «посмотри в камеру» — пусть печатает, собирает, спорит с соседом. Живое рождается в деле.</li>
          <li><b>Чередуйте 3 плана:</b> экран с кодом крупно → руки на клавиатуре → лицо с азартом → общий план группы.</li>
          <li><b>Снимите экран с результатом</b> — что у него получилось. Это понятно маме и доказывает: тут учат.</li>
          <li><b>Присядьте до уровня глаз</b> — кадр сверху «из-за спины взрослого» всегда холоднее.</li>
        </ol>
      </div>
    </div>

    <div class="scene">
      <div class="scene-head">
        <div class="scene-ic green"><i class="bi bi-trophy-fill"></i></div>
        <div><div class="scene-name">Спортивная игра</div><div class="scene-tag">Бассейн · турнир · подвижные игры</div></div>
      </div>
      <div class="scene-body">
        <ol>
          <li><b>Включите «слоумо»</b> (Slow-mo, 120/240 кадров) — прыжок, брызги, гол сразу выглядят эффектно. Только при хорошем свете.</li>
          <li><b>Начинайте запись ДО момента.</b> Жмёте «запись» когда мяч ещё не полетел — иначе вечно опаздываете.</li>
          <li><b>Снимайте длинным дублем</b> 15–30 секунд и потом вырежете лучший кусок. Не пытайтесь «поймать» одним коротким нажатием.</li>
          <li><b>Ведите камеру плавно</b> за игроком, держа его в одной части кадра. Поворачивайтесь корпусом, а не руками.</li>
          <li><b>Ловите эмоцию ПОСЛЕ.</b> Радость победителя, объятия команды — это ценнее самого момента игры.</li>
        </ol>
      </div>
    </div>

    <div class="scene">
      <div class="scene-head">
        <div class="scene-ic purple"><i class="bi bi-fire"></i></div>
        <div><div class="scene-name">Вечерняя свечка / огонёк</div><div class="scene-tag">Тёмное помещение · тёплая атмосфера</div></div>
      </div>
      <div class="scene-body">
        <ol>
          <li><b>Добавьте хоть немного света.</b> Гирлянда, телефон-фонарик у соседа, лампа сбоку — иначе будет шум и «каша». Чистой темноты камера не любит.</li>
          <li><b>Снимайте с опоры.</b> Прислоните локти к колену, поставьте телефон на стол/книгу. В темноте любое дрожание = смаз.</li>
          <li><b>Наведитесь на освещённое лицо, не на пламя.</b> Тапните пальцем по лицу — иначе люди уйдут в черноту, а свеча будет пересвечена.</li>
          <li><b>Снимайте детали и атмосферу:</b> огонёк, кружки в руках, лица в полумраке, общий круг. Из этого собирается самое душевное видео смены.</li>
          <li><b>Не лезьте в лица.</b> Снимайте со стороны, общим планом — момент личный, камера не должна его ломать.</li>
        </ol>
      </div>
    </div>

    <div class="scene">
      <div class="scene-head">
        <div class="scene-ic orange"><i class="bi bi-palette-fill"></i></div>
        <div><div class="scene-name">Мастер-класс / творчество</div><div class="scene-tag">Руки · процесс · результат</div></div>
      </div>
      <div class="scene-body">
        <ol>
          <li><b>Снимайте руки крупно</b> — как мастерят, паяют, рисуют, собирают. Руки в работе всегда смотрятся живо.</li>
          <li><b>История «было → стало».</b> Снимите заготовку в начале и готовую работу в конце — получится мини-сюжет.</li>
          <li><b>Поймайте момент «получилось!»</b> — глаза загораются, когда заработало. Это и есть главный кадр.</li>
          <li><b>Деталь крупным планом</b> — фактура, инструмент, готовое изделие в руках автора.</li>
        </ol>
      </div>
    </div>

  </div>

  <!-- ПРИМЕРЫ: ХОРОШИЙ vs ПЛОХОЙ КАДР -->
  <div class="sec-title"><i class="bi bi-image"></i> Примеры: хороший кадр vs плохой</div>
  <div class="ex-grid">

    <!-- СВЕТ -->
    <div class="ex">
      <div class="ex-pair">
        <div class="ex-frame good">
          <div class="ex-badge good"><i class="bi bi-check-lg"></i></div>
          <svg viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Свет падает на лицо">
            <rect width="160" height="110" fill="#fef3c7"/>
            <circle cx="138" cy="22" r="13" fill="#fbbf24"/>
            <g stroke="#fbbf24" stroke-width="2"><line x1="138" y1="2" x2="138" y2="9"/><line x1="120" y1="22" x2="127" y2="22"/><line x1="125" y1="9" x2="130" y2="14"/></g>
            <line x1="128" y1="30" x2="92" y2="55" stroke="#fcd34d" stroke-width="3" stroke-dasharray="4 3"/>
            <circle cx="74" cy="58" r="20" fill="#fcd9b6"/>
            <circle cx="68" cy="54" r="2.5" fill="#0f172a"/><circle cx="80" cy="54" r="2.5" fill="#0f172a"/>
            <path d="M68 66 Q74 71 80 66" stroke="#0f172a" stroke-width="2" fill="none" stroke-linecap="round"/>
            <rect x="58" y="78" width="32" height="28" rx="6" fill="#3b82f6"/>
          </svg>
        </div>
        <div class="ex-frame bad">
          <div class="ex-badge bad"><i class="bi bi-x-lg"></i></div>
          <svg viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Свет за спиной — тёмный силуэт">
            <rect width="160" height="110" fill="#dbeafe"/>
            <circle cx="74" cy="20" r="14" fill="#fbbf24"/>
            <g stroke="#fbbf24" stroke-width="2"><line x1="74" y1="0" x2="74" y2="6"/><line x1="52" y1="20" x2="58" y2="20"/><line x1="90" y1="20" x2="96" y2="20"/></g>
            <circle cx="74" cy="58" r="20" fill="#475569"/>
            <rect x="58" y="78" width="32" height="28" rx="6" fill="#334155"/>
          </svg>
        </div>
      </div>
      <div class="ex-cap"><b>Свет на лицо.</b> Источник света — позади вас. Если солнце/окно за спиной ребёнка — получите тёмный силуэт.</div>
    </div>

    <!-- ГОРИЗОНТ -->
    <div class="ex">
      <div class="ex-pair">
        <div class="ex-frame good">
          <div class="ex-badge good"><i class="bi bi-check-lg"></i></div>
          <svg viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Горизонт ровный">
            <rect width="160" height="110" fill="#bae6fd"/>
            <rect y="68" width="160" height="42" fill="#86efac"/>
            <line x1="0" y1="68" x2="160" y2="68" stroke="#16a34a" stroke-width="2.5"/>
            <circle cx="80" cy="52" r="14" fill="#fcd9b6"/>
            <rect x="68" y="66" width="24" height="24" rx="5" fill="#f97316"/>
          </svg>
        </div>
        <div class="ex-frame bad">
          <div class="ex-badge bad"><i class="bi bi-x-lg"></i></div>
          <svg viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Горизонт завален">
            <rect width="160" height="110" fill="#bae6fd"/>
            <polygon points="0,82 160,54 160,110 0,110" fill="#86efac"/>
            <line x1="0" y1="82" x2="160" y2="54" stroke="#dc2626" stroke-width="2.5"/>
            <circle cx="80" cy="50" r="14" fill="#fcd9b6"/>
            <rect x="68" y="64" width="24" height="24" rx="5" fill="#f97316"/>
          </svg>
        </div>
      </div>
      <div class="ex-cap"><b>Держите горизонт ровно.</b> Включите сетку — и линия земли/стола станет параллельна нижней грани кадра.</div>
    </div>

    <!-- ПРАВИЛО ТРЕТЕЙ -->
    <div class="ex">
      <div class="ex-pair">
        <div class="ex-frame good">
          <div class="ex-badge good"><i class="bi bi-check-lg"></i></div>
          <svg viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Герой на линии трети">
            <rect width="160" height="110" fill="#e0f2fe"/>
            <g stroke="#94a3b8" stroke-width="1" stroke-dasharray="3 3" opacity="0.8">
              <line x1="53" y1="0" x2="53" y2="110"/><line x1="107" y1="0" x2="107" y2="110"/>
              <line x1="0" y1="37" x2="160" y2="37"/><line x1="0" y1="73" x2="160" y2="73"/>
            </g>
            <circle cx="107" cy="37" r="13" fill="#fcd9b6"/>
            <circle cx="102" cy="34" r="2" fill="#0f172a"/><circle cx="112" cy="34" r="2" fill="#0f172a"/>
