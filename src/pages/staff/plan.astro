---
// Конструктор смены — внутренний инструмент /staff/plan
// Доступ: cookie staff_auth_2026 (логин на /staff). noindex.
export const prerender = true;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex,nofollow">
<title>Конструктор смены · АйДаКемп</title>
<link rel="stylesheet" href="/styles/icons.css">
<style is:global>
  :root{
    --bg:#f1f5f9;--surface:#fff;--surface2:#f8fafc;--border:#e2e8f0;--border2:#cbd5e1;
    --orange:#f97316;--orange-bg:rgba(236,124,0,.08);--orange-border:rgba(236,124,0,.3);
    --text:#0f172a;--text2:#334155;--text3:#64748b;
    --green:#16a34a;--green-bg:rgba(22,163,74,.10);--red:#dc2626;--red-bg:rgba(220,38,38,.08);
    --blue:#2563eb;--blue-bg:rgba(37,99,235,.08);--purple:#9333ea;--radius:12px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.55;min-height:100vh}
  button{font-family:inherit}

  .topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 20px;height:56px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(15,23,42,.06)}
  /* Embed-режим: страница встроена с портала, скрываем шапку и сайдбар. */
  body.embed-mode .topbar{display:none}
  body.embed-mode .sidebar{display:none}
  body.embed-mode .layout{padding-top:0}
  .topbar-logo{font-weight:800;font-size:15px;color:var(--orange);display:flex;align-items:center;gap:8px;white-space:nowrap}
  .topbar-title{font-size:14px;font-weight:600;color:var(--text2);border-left:1px solid var(--border);padding-left:12px}
  .proto-badge{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:var(--orange-bg);color:var(--orange);border:1px solid var(--orange-border);padding:3px 8px;border-radius:20px}
  .shift-select{border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:13px;font-weight:600;color:var(--text);background:var(--surface);cursor:pointer;outline:none;max-width:220px}
  .shift-select:focus{border-color:var(--orange)}
  .save-pill{font-size:11.5px;color:var(--text3);display:flex;align-items:center;gap:5px}
  .save-pill.saved{color:var(--green)}
  .topbar-right{margin-left:auto;display:flex;align-items:center;gap:12px}
  .role-switch{display:flex;align-items:center;gap:8px;background:var(--bg);border:1.5px solid var(--border);border-radius:8px;padding:5px 10px;font-size:13px;color:var(--text2)}
  .role-switch select{border:none;background:transparent;font-size:13px;font-weight:600;color:var(--orange);cursor:pointer;outline:none}

  .layout{display:flex;min-height:calc(100vh - 56px)}
  .sidebar{width:212px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);padding:16px 0;position:sticky;top:56px;height:calc(100vh - 56px);overflow-y:auto}
  .sb-section{padding:8px 16px 4px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}
  .nav-btn{display:flex;align-items:center;gap:10px;width:100%;padding:10px 16px;background:none;border:none;border-left:3px solid transparent;color:var(--text2);font-size:14px;cursor:pointer;text-align:left;transition:all .15s}
  .nav-btn:hover{background:var(--bg);color:var(--text)}
  .nav-btn.active{background:var(--orange-bg);border-left-color:var(--orange);color:var(--orange);font-weight:600}
  .nav-btn i{font-size:16px}
  .sb-divider{height:1px;background:var(--border);margin:12px 0}
  .sb-legend{padding:6px 16px;font-size:11.5px;color:var(--text3)}
  .sb-legend .lg-row{display:flex;align-items:center;gap:7px;margin-top:6px}
  .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;display:inline-block}
  .dot.green{background:var(--green)}.dot.orange{background:var(--orange)}.dot.red{background:var(--red)}
  .sb-meta{padding:8px 16px;font-size:11.5px;color:var(--text3);line-height:1.5}
  .sb-meta b{color:var(--text2)}

  .content{flex:1;padding:22px 26px;overflow:hidden;min-width:0}
  .c-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
  .c-title{font-size:20px;font-weight:700}
  .c-sub{font-size:13px;color:var(--text3);margin-top:2px;max-width:760px}

  .summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:18px}
  .sum-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:13px 15px}
  .sum-label{font-size:11.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.04em;font-weight:600}
  .sum-val{font-size:22px;font-weight:800;margin-top:4px}
  .sum-val small{font-size:13px;color:var(--text3);font-weight:600}
  .bar{height:6px;background:var(--bg);border-radius:4px;margin-top:9px;overflow:hidden}
  .bar>span{display:block;height:100%;background:var(--orange);border-radius:4px;transition:width .35s}
  .bar.green>span{background:var(--green)}

  .grid-wrap{overflow-x:auto;border:1.5px solid var(--border);border-radius:var(--radius);background:var(--surface)}
  .ov-grid{display:grid;min-width:max-content}
  .ov-cell{border-right:1px solid var(--border);border-bottom:1px solid var(--border);padding:8px;vertical-align:top}
  .ov-cell.lane-head{width:150px;position:sticky;left:0;z-index:2;background:var(--surface2);display:flex;align-items:center;gap:8px;font-weight:600;font-size:13px}
  .ov-cell.lane-head i{color:var(--orange);font-size:16px}
  .ov-cell.corner{position:sticky;left:0;z-index:3;background:var(--surface2)}
  .ov-cell.day-head{background:var(--surface2)}
  .ov-day-n{font-size:13px;font-weight:700}
  .ov-day-date{font-size:11.5px;color:var(--text3)}
  .ov-day-type{font-size:11px;color:var(--text3);margin-top:2px}
  .ov-cell.editable{background:rgba(236,124,0,.035);cursor:pointer}
  .ov-cell.editable:hover{background:var(--orange-bg)}
  .ov-cell.mand-lane{background:var(--surface2)}
  .mini{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--border2);border-radius:7px;padding:6px 8px;margin-bottom:6px}
  .mini:last-child{margin-bottom:0}
  .mini.t-mandatory{border-left-color:var(--blue)}
  .mini.t-extra{border-left-color:var(--green)}
  .mini.locked{border-left-color:var(--text3);background:var(--surface2)}
  .mini-time{font-size:11px;font-weight:700;color:var(--text2)}
  .mini-title{font-size:12px;margin-top:1px;line-height:1.3}
  .mini-foot{display:flex;align-items:center;gap:6px;margin-top:5px;flex-wrap:wrap}
  .ov-empty{font-size:12px;color:var(--text3);font-style:italic;padding:6px 2px}
  .grp-tag{font-size:9.5px;font-weight:700;color:var(--purple);background:rgba(147,51,234,.08);border-radius:4px;padding:1px 5px}

  .avatar{width:20px;height:20px;border-radius:50%;color:#fff;font-size:9px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
  .avatar.lg{width:38px;height:38px;font-size:13px}
  .chk-badge{font-size:10.5px;color:var(--text3);display:inline-flex;align-items:center;gap:3px}
  .chk-badge.done{color:var(--green)}

  .day-chips{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
  .chip{background:var(--surface);border:1.5px solid var(--border);border-radius:9px;padding:7px 12px;cursor:pointer;font-size:13px;color:var(--text2);transition:all .15s;min-width:62px;text-align:center}
  .chip:hover{border-color:var(--border2)}
  .chip.active{background:var(--orange);border-color:var(--orange);color:#fff}
  .chip .chip-n{font-weight:700}
  .chip .chip-d{font-size:11px;opacity:.85;display:block}
  .chip-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-left:4px}

  .ed-bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}
  .ed-lane{font-size:13.5px;color:var(--text2)}
  .ed-lane b{color:var(--orange)}
  .seg{display:inline-flex;border:1.5px solid var(--border);border-radius:8px;overflow:hidden}
  .seg button{background:var(--surface);border:none;padding:6px 12px;font-size:12.5px;color:var(--text2);cursor:pointer;border-right:1px solid var(--border)}
  .seg button:last-child{border-right:none}
  .seg button.active{background:var(--orange-bg);color:var(--orange);font-weight:600}
  .btn-add{margin-left:auto;background:var(--orange);color:#fff;border:none;border-radius:9px;padding:8px 14px;font-size:13.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:7px}
  .btn-add:hover{background:#ea6a08}

  .timeline{position:relative}
  .drag-handle{cursor:grab;color:var(--border2);padding:0 4px 0 0;font-size:15px;flex-shrink:0;touch-action:none}
  .drag-handle:hover{color:var(--orange)}
  .drag-handle:active{cursor:grabbing}
  .drop-zone{height:6px;margin:-6px 0 0;border-radius:5px;transition:all .12s;margin-left:78px}
  .drop-zone.over{height:30px;background:var(--orange-bg);border:1.5px dashed var(--orange);margin-bottom:8px}
  .tl-card.dragging{opacity:.45}
  .tl-item{display:flex;gap:14px;align-items:flex-start;padding-bottom:14px}
  .tl-time{width:64px;flex-shrink:0;text-align:right;font-size:12px;font-weight:700;color:var(--text2);padding-top:13px}
  .tl-time small{display:block;font-weight:500;color:var(--text3)}
  .tl-line{width:2px;flex-shrink:0;background:var(--border);position:relative;align-self:stretch}
  .tl-line::before{content:'';position:absolute;top:15px;left:50%;transform:translateX(-50%);width:11px;height:11px;border-radius:50%;background:var(--surface);border:2.5px solid var(--border2)}
  .tl-item.t-mandatory .tl-line::before{border-color:var(--blue)}
  .tl-item.t-extra .tl-line::before{border-color:var(--green)}
  .tl-item.anchor .tl-line::before{border-color:var(--text3);background:var(--text3)}
  .tl-card{flex:1;min-width:0;background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius)}
  .tl-card.anchor{background:var(--surface2);border-style:dashed}
  .card-top{display:flex;align-items:center;gap:10px;padding:11px 14px;cursor:pointer}
  .card-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:2px 7px;border-radius:5px;flex-shrink:0}
  .tag-mandatory{background:var(--blue-bg);color:var(--blue)}
  .tag-extra{background:var(--green-bg);color:var(--green)}
  .tag-locked{background:var(--bg);color:var(--text3)}
  .card-name{font-size:14px;font-weight:600;flex:1;min-width:0}
  .card-meta{font-size:11.5px;color:var(--text3);display:flex;gap:10px;flex-wrap:wrap;margin-top:2px}
  .card-meta span{display:inline-flex;align-items:center;gap:4px}
  .resp-chip{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text2);background:var(--bg);border:1px solid var(--border);border-radius:20px;padding:3px 9px 3px 4px;flex-shrink:0}
  .resp-chip.unassigned{color:var(--red);border-color:rgba(220,38,38,.3);background:var(--red-bg);padding:4px 10px}
  .card-chev{color:var(--text3);transition:transform .2s;flex-shrink:0}
  .tl-card.open .card-chev{transform:rotate(180deg)}
  .card-body{display:none;padding:0 14px 14px;border-top:1px solid var(--border)}
  .tl-card.open .card-body{display:block}
  .cb-section{margin-top:13px}
  .cb-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text3);margin-bottom:7px}
  .cb-desc{font-size:13px;color:var(--text2);background:var(--surface2);border-radius:8px;padding:9px 11px}
  .chk-row{display:flex;align-items:flex-start;gap:9px;padding:7px 9px;border:1px solid var(--border);border-radius:8px;margin-bottom:5px;cursor:pointer;font-size:13.5px}
  .chk-row:hover{border-color:var(--orange)}
  .chk-row input{margin-top:3px;accent-color:var(--orange);width:16px;height:16px;flex-shrink:0;cursor:pointer}
  .chk-row.done span{text-decoration:line-through;color:var(--text3)}
  .chk-add{display:flex;gap:7px;margin-top:7px}
  .chk-add input{flex:1;border:1.5px solid var(--border);border-radius:7px;padding:7px 10px;font-size:13px;outline:none}
  .chk-add input:focus{border-color:var(--orange)}
  .chk-add button{background:var(--bg);border:1.5px solid var(--border);border-radius:7px;padding:0 12px;cursor:pointer;color:var(--text2)}
  .result-area{width:100%;border:1.5px solid var(--border);border-radius:8px;padding:9px 11px;font-size:13.5px;font-family:inherit;resize:vertical;min-height:54px;outline:none}
  .result-area:focus{border-color:var(--orange)}
  .row2{display:flex;gap:12px;flex-wrap:wrap}
  .row2 .cb-section{flex:1;min-width:160px}
  .status-seg{display:inline-flex;border:1.5px solid var(--border);border-radius:8px;overflow:hidden}
  .status-seg button{background:var(--surface);border:none;border-right:1px solid var(--border);padding:6px 11px;font-size:12.5px;cursor:pointer;color:var(--text2);display:flex;align-items:center;gap:5px}
  .status-seg button:last-child{border-right:none}
  .status-seg button.active.s-planned{background:var(--bg);color:var(--text2);font-weight:600}
  .status-seg button.active.s-progress{background:var(--orange-bg);color:var(--orange);font-weight:600}
  .status-seg button.active.s-done{background:var(--green-bg);color:var(--green);font-weight:600}
  .card-actions{display:flex;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border)}
  .link-btn{background:none;border:none;color:var(--text3);font-size:13px;cursor:pointer;display:flex;align-items:center;gap:5px;padding:4px 6px}
  .link-btn:hover{color:var(--red)}
  .fld{width:100%;border:1.5px solid var(--border);border-radius:7px;padding:7px 9px;font-size:13.5px;outline:none;font-family:inherit;background:var(--surface)}
  .fld:focus{border-color:var(--orange)}

  .team-group{margin-bottom:22px}
  .team-group h3{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text3);margin-bottom:10px;display:flex;align-items:center;gap:8px}
  .team-group h3 i{color:var(--orange)}
  .team-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(265px,1fr));gap:10px}
  .person-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:11px 13px;display:flex;align-items:center;gap:11px}
  .person-card input.pname{border:none;font-size:14px;font-weight:600;outline:none;width:100%;background:transparent;color:var(--text)}
  .person-card input.pname:focus{border-bottom:1.5px solid var(--orange)}
  .person-load{font-size:12px;color:var(--text3)}
  .add-person{display:flex;gap:8px;flex-wrap:wrap;align-items:center;background:var(--surface);border:1.5px dashed var(--border2);border-radius:var(--radius);padding:14px;margin-top:6px}
  .add-person input,.add-person select{border:1.5px solid var(--border);border-radius:8px;padding:8px 11px;font-size:13.5px;outline:none;font-family:inherit}
  .add-person input{flex:1;min-width:160px}

  .ck-cols{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  @media(max-width:900px){.ck-cols{grid-template-columns:1fr}}
  .ck-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:15px 17px}
  .ck-card h4{font-size:14px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px}
  .ck-card .ck-sub{font-size:12px;color:var(--text3);margin-bottom:12px}
  .ck-prog{font-size:12px;color:var(--text3);margin-left:auto;font-weight:600}

  .overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:100;display:none;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto}
  .overlay.open{display:flex}
  .modal{background:var(--surface);border-radius:16px;width:100%;max-width:560px;box-shadow:0 20px 60px rgba(15,23,42,.3)}
  .modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border)}
  .modal-head h2{font-size:17px;font-weight:700}
  .modal-close{background:none;border:none;font-size:20px;color:var(--text3);cursor:pointer;line-height:1}
  .modal-body{padding:20px 22px}
  .field{margin-bottom:15px}
  .field label{display:block;font-size:12.5px;font-weight:600;color:var(--text2);margin-bottom:6px}
  .field input,.field select,.field textarea{width:100%;border:1.5px solid var(--border);border-radius:9px;padding:9px 12px;font-size:14px;outline:none;font-family:inherit}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--orange)}
  .field-row{display:flex;gap:12px}.field-row .field{flex:1}
  .type-radio{display:flex;gap:10px}
  .type-radio label{flex:1;border:1.5px solid var(--border);border-radius:9px;padding:10px;text-align:center;cursor:pointer;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:7px}
  .type-radio input{display:none}
  .type-radio label:has(input:checked){border-color:var(--orange);background:var(--orange-bg);color:var(--orange)}
  .mini-chk-list .mc-row{display:flex;gap:7px;align-items:center;margin-bottom:6px}
  .mini-chk-list .mc-row input{flex:1}
  .mini-chk-list .mc-del{background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px}
  .modal-foot{display:flex;justify-content:flex-end;gap:10px;padding:16px 22px;border-top:1px solid var(--border)}
  .btn-secondary{background:var(--surface);border:1.5px solid var(--border);border-radius:9px;padding:9px 16px;font-size:14px;font-weight:600;color:var(--text2);cursor:pointer}
  .btn-primary{background:var(--orange);border:none;border-radius:9px;padding:9px 18px;font-size:14px;font-weight:600;color:#fff;cursor:pointer}
  .btn-primary:hover{background:#ea6a08}

  /* ── классическое расписание (день-таблица) ── */
  .sched-wrap{overflow:auto;max-height:calc(100vh - 240px);border:1.5px solid var(--border);border-radius:var(--radius);background:var(--surface)}
  .sched-table thead th{position:sticky;top:0;z-index:5;box-shadow:inset 0 -1px 0 var(--border)}
  .sched-table{width:100%;border-collapse:collapse;min-width:760px}
  .sched-table th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text3);font-weight:700;padding:11px 14px;background:var(--surface2);border-bottom:1px solid var(--border);white-space:nowrap}
  .sched-table td{padding:9px 14px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle}
  .sched-table tbody tr:last-child td{border-bottom:none}
  .sched-table td.t{font-weight:700;color:var(--text2);white-space:nowrap;font-size:12.5px;width:78px}
  .sched-table tr.t-mandatory td.t{border-left:3px solid var(--blue)}
  .sched-table tr.t-extra td.t{border-left:3px solid var(--green)}
  .sched-table tr.row-anchor td{background:var(--surface2);color:var(--text3)}
  .sched-table tr.row-anchor td.t{border-left:3px solid var(--text3)}
  .sched-table tr:hover td{background:var(--surface2)}
  .sched-table tr.row-anchor:hover td{background:var(--surface2)}
  .sched-name{color:var(--text);cursor:pointer;font-weight:600}
  .sched-name:hover{color:var(--orange);text-decoration:underline}
  .sched-meta{color:var(--text3);font-size:11.5px}
  .role-ic{color:var(--text3);font-size:12px;margin-right:4px}
  .p-sel{border:1.5px solid var(--border);border-radius:7px;padding:5px 7px;font-size:12.5px;outline:none;background:var(--surface);cursor:pointer;max-width:160px}
  .p-sel:focus{border-color:var(--orange)}
  .p-sel.unset{color:var(--red);border-color:rgba(220,38,38,.3)}
  .st-sel{border:1.5px solid var(--border);border-radius:7px;padding:5px 7px;font-size:12.5px;outline:none;cursor:pointer;background:var(--surface)}
  .st-sel.st-progress{color:var(--orange);font-weight:600;background:var(--orange-bg);border-color:var(--orange-border)}
  .st-sel.st-done{color:var(--green);font-weight:600;background:var(--green-bg)}
  .sched-table tr.sched-section td{background:var(--bg);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text3);padding:7px 14px}
  .flag{font-size:13px;margin-right:5px;cursor:help}
  .flag.warn{color:var(--orange)} .flag.err{color:var(--red)}
  .type-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:middle}
  .load-strip{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px;align-items:center}
  .load-strip .ls-label{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text3);font-weight:700;margin-right:2px}
  .load-chip{display:inline-flex;align-items:center;gap:6px;background:var(--surface);border:1.5px solid var(--border);border-radius:20px;padding:3px 10px 3px 3px;font-size:12px;color:var(--text2)}
  .load-chip.over{border-color:rgba(220,38,38,.4);background:var(--red-bg);color:var(--red)}
  .load-chip .ld{color:var(--text3);font-size:11px}
  .load-chip.over .ld{color:var(--red)}
  .ov-cell.load-cell{text-align:center;font-size:14px}
  .ov-cell.load-cell b{font-size:15px}
  .ov-cell.load-cell .lc-h{display:block;font-size:10.5px;color:var(--text3);font-weight:500}
  .ov-cell.load-cell .lc-empty{color:var(--border2)}
  .ov-cell.load-total{text-align:center;font-size:13px;background:var(--surface2)}
  /* ── сетка дня (люди × время) ── */
  .rg-scroll{overflow:auto;max-height:calc(100vh - 240px);border:1.5px solid var(--border);border-radius:var(--radius);background:var(--surface)}
  .rg-grid{display:flex;min-width:max-content}
  .rg-col{display:flex;flex-direction:column;border-right:1px solid var(--border);min-width:150px;flex:1}
  .rg-col:last-child{border-right:none}
  .rg-timecol{min-width:60px;width:60px;flex:none;position:sticky;left:0;z-index:3;background:var(--surface)}
  .rg-head{height:42px;display:flex;align-items:center;gap:6px;padding:0 9px;font-size:12.5px;font-weight:600;border-bottom:1px solid var(--border);background:var(--surface2);position:sticky;top:0;z-index:2;white-space:nowrap;overflow:hidden}
  .rg-timecol .rg-head{z-index:4}
  .rg-track{position:relative}
  .rg-pcol .rg-track{background:repeating-linear-gradient(to bottom,transparent 0,transparent 53px,var(--border) 53px,var(--border) 54px)}
  .rg-hour{position:absolute;left:0;font-size:10.5px;color:var(--text2);font-weight:600;transform:translateY(-50%);padding-left:7px}
  .rg-amark{position:absolute;left:0;width:100%;font-size:9px;color:var(--text3);padding-left:7px;transform:translateY(-50%);white-space:nowrap;overflow:hidden}
  .rg-block{position:absolute;border-radius:6px;padding:3px 5px;font-size:11px;line-height:1.25;overflow:hidden;cursor:pointer;border-left:3px solid var(--blue);background:var(--blue-bg);color:var(--text)}
  .rg-block.t-extra{border-left-color:var(--green);background:var(--green-bg)}
  .rg-block.rg-conf{border:1.5px solid var(--red);border-left:3px solid var(--red);background:var(--red-bg)}
  .rg-block b{font-weight:700}
  /* ── расселение ── */
  .rooms-layout{display:flex;gap:16px;align-items:flex-start}
  .rooms-grid{flex:1;display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:12px;min-width:0}
  .rooms-pool{width:252px;flex:none;position:sticky;top:14px;background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:12px;max-height:calc(100vh - 90px);display:flex;flex-direction:column}
  .rooms-pool.over{border-color:var(--orange);background:var(--orange-bg)}
  .pool-head{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--text3);margin-bottom:8px}
  .pool-list{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px;min-height:50px}
  .pool-empty{color:var(--text3);font-size:13px;text-align:center;padding:18px 0}
  .pool-actions{margin-top:10px;padding-top:10px;border-top:1px solid var(--border)}
  .kid{display:flex;align-items:center;gap:7px;background:var(--surface);border:1.5px solid var(--border);border-left:3px solid var(--border2);border-radius:8px;padding:5px 8px;font-size:12.5px;cursor:grab}
  .kid:active{cursor:grabbing}
  .kid.m{border-left-color:#2563eb}.kid.f{border-left-color:#db2777}
  .kid-g{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;background:var(--text3);flex-shrink:0;cursor:pointer}
  .kid.m .kid-g{background:#2563eb}.kid.f .kid-g{background:#db2777}
  .kid-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .kid-age{color:var(--text3);font-size:11px;flex-shrink:0}
  .room-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:11px;display:flex;flex-direction:column}
  .room-head{display:flex;align-items:center;gap:7px;margin-bottom:9px}
  .room-name{flex:1;min-width:0;border:none;font-weight:700;font-size:13.5px;outline:none;background:transparent;color:var(--text)}
  .room-name:focus{border-bottom:1.5px solid var(--orange)}
  .room-occ{font-size:12px;font-weight:700;color:var(--text3)}.room-occ.over{color:var(--red)}
  .rtag{font-size:10px;font-weight:700;padding:1px 6px;border-radius:5px}
  .rtag.m{background:var(--blue-bg);color:#2563eb}.rtag.f{background:rgba(219,39,119,.1);color:#db2777}.rtag.mix{background:var(--red-bg);color:var(--red)}
  .beds{display:flex;flex-direction:column;gap:6px}
  .bed{min-height:34px;border:1.5px dashed var(--border);border-radius:8px;display:flex;align-items:center;padding:3px;transition:all .12s}
  .bed.over{border-color:var(--orange);background:var(--orange-bg)}
  .bed.filled{border-style:solid}
  .bed .kid{flex:1}
  .bed-empty{color:var(--text3);font-size:11.5px;padding-left:8px}
  .room-foot{margin-top:8px;display:flex;gap:4px}
  .add-room{border:1.5px dashed var(--border2);border-radius:var(--radius);background:var(--surface2);color:var(--text2);padding:14px;cursor:pointer;font-size:13.5px;display:flex;align-items:center;justify-content:center;gap:7px;min-height:90px}
  .add-room:hover{border-color:var(--orange);color:var(--orange)}
  .room-cns{display:flex;align-items:center;gap:7px;margin-bottom:9px}
  .rtag.age{background:var(--bg);color:var(--text3)}.rtag.age.bad{background:var(--red-bg);color:var(--red)}
  .kid-wish{color:#db2777;font-size:11px;flex-shrink:0}
  .valid-panel{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:12px 14px;margin-bottom:14px;font-size:13px}
  .valid-panel.ok{display:flex;align-items:center;gap:8px;color:var(--green);border-color:rgba(22,163,74,.3);background:var(--green-bg)}
  .vp-head{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--text3);margin-bottom:8px;display:flex;align-items:center;gap:6px}
  .vp-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:4px 14px}
  .vp-item{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--text2)}
  .km-gender{display:flex;gap:8px}
  .km-g{flex:1;border:1.5px solid var(--border);border-radius:9px;padding:9px;font-size:14px;font-weight:700;cursor:pointer;background:var(--surface);color:var(--text2)}
  .km-g.on{border-color:#2563eb;background:var(--blue-bg);color:#2563eb}
  .km-g.f.on{border-color:#db2777;background:rgba(219,39,119,.1);color:#db2777}
  .km-wish-list{display:flex;flex-direction:column;gap:2px;max-height:240px;overflow-y:auto;border:1px solid var(--border);border-radius:9px;padding:8px}
  .km-wish-item{display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer;padding:3px 0}
  .km-wish-item input{accent-color:var(--orange);width:16px;height:16px}
  .who-btn{background:var(--orange-bg);border:1px solid var(--orange-border);color:var(--orange);font-weight:600;font-size:12.5px;border-radius:7px;padding:3px 9px;cursor:pointer;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .id-role{display:flex;gap:8px;flex-wrap:wrap}
  .id-r{flex:1;min-width:90px;border:1.5px solid var(--border);border-radius:9px;padding:9px;font-size:13px;font-weight:600;cursor:pointer;background:var(--surface);color:var(--text2)}
  .id-r.on{border-color:var(--orange);background:var(--orange-bg);color:var(--orange)}
  .log-list{display:flex;flex-direction:column;border:1.5px solid var(--border);border-radius:var(--radius);overflow:hidden;background:var(--surface)}
  .log-row{display:flex;gap:12px;align-items:baseline;padding:9px 14px;border-bottom:1px solid var(--border);font-size:13.5px}
  .log-row:last-child{border-bottom:none}
  .log-time{color:var(--text3);font-size:12px;white-space:nowrap;width:96px;flex-shrink:0}
  .log-user{font-weight:600;width:150px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .log-text{color:var(--text2);flex:1;min-width:0}
  @media(max-width:760px){.log-row{flex-wrap:wrap;gap:2px 10px}.log-user{width:auto}.log-text{flex-basis:100%}}
  @media(max-width:760px){.rooms-layout{flex-direction:column-reverse}.rooms-pool{width:100%;position:static;max-height:none}.vp-list{grid-template-columns:1fr}}

  @media(max-width:760px){
    .sidebar{display:none}.content{padding:14px}
    .topbar{flex-wrap:wrap;height:auto;min-height:56px;padding:8px 12px;gap:8px}
    .topbar-title{display:none}
    .shift-select{max-width:150px}
    .day-chips{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px}
    .chip{flex:none}
    /* расписание → агенда-карточки */
    .sched-wrap{max-height:none;overflow:visible;border:none;background:transparent;border-radius:0}
    .sched-table{min-width:0;width:100%}
    .sched-table thead{display:none}
    .sched-table tbody tr{display:block;background:var(--surface);border:1.5px solid var(--border);border-radius:11px;margin-bottom:9px;padding:7px 3px;border-left-width:3px}
    .sched-table tbody tr.sched-section{display:block;background:transparent;border:none;padding:0;margin:12px 0 5px}
    .sched-table tbody tr.row-anchor{background:var(--surface2)}
    .sched-table td{display:flex;border:none!important;padding:5px 13px;font-size:13.5px;align-items:center;gap:10px}
    .sched-table td.t{font-size:15px;font-weight:700}
    .sched-table td[data-label]::before{content:attr(data-label);font-size:10.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.03em;min-width:92px;flex-shrink:0;font-weight:700}
    .sched-table tr.row-anchor .muted-cell{display:none}
    .p-sel,.st-sel{flex:1;max-width:none}
  }

  /* ── печать / PDF ── */
  #printArea{display:none}
  @media print{
    .topbar,.layout,#overlay{display:none!important}
    #printArea{display:block!important}
    body{background:#fff;color:#000}
    #printArea h1{font-size:18px;margin:0 0 2px}
    #printArea .p-sub{font-size:12px;color:#444;margin-bottom:14px}
    #printArea h2{font-size:13px;margin:14px 0 5px;page-break-after:avoid}
    #printArea table{width:100%;border-collapse:collapse;margin-bottom:6px}
    #printArea th,#printArea td{border:1px solid #bbb;padding:4px 7px;font-size:10.5px;text-align:left;vertical-align:top}
    #printArea th{background:#eee}
    #printArea tr{page-break-inside:avoid}
    #printArea .p-anchor td{color:#777;background:#f7f7f7}
    @page{margin:14mm}
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-logo"><i class="bi bi-house-heart-fill"></i> АйДаКемп</div>
  <div class="topbar-title">Конструктор смены</div>
  <span class="proto-badge" id="modeBadge">превью</span>
  <select class="shift-select" id="shiftSelect" onchange="switchShift(this.value)" title="Выбрать смену"></select>
  <span class="save-pill" id="savePill"></span>
  <div class="topbar-right">
    <div class="role-switch">
      <i class="bi bi-person-badge" style="color:var(--text3)"></i><span>Вы:</span>
      <button class="who-btn" id="whoBtn" onclick="openIdentity()" title="Кто вы (для журнала)">—</button>
      <select id="roleSelect" onchange="setRole(this.value)">
        <option value="counselor">Вожатый</option>
        <option value="teacher">Преподаватель</option>
        <option value="manager">Руководитель</option>
      </select>
    </div>
  </div>
</div>

<div class="layout">
  <aside class="sidebar">
    <div class="sb-section">Конструктор</div>
    <button class="nav-btn" data-view="schedule" onclick="setView('schedule')"><i class="bi bi-calendar3"></i> Расписание</button>
    <button class="nav-btn" data-view="overview" onclick="setView('overview')"><i class="bi bi-grid-3x3-gap-fill"></i> Вся смена (по ролям)</button>
    <button class="nav-btn" data-view="load" onclick="setView('load')"><i class="bi bi-bar-chart-steps"></i> Загрузка</button>
    <button class="nav-btn" data-view="dgrid" onclick="setView('dgrid')"><i class="bi bi-calendar-range"></i> Сетка дня</button>
    <button class="nav-btn" data-view="rooms" onclick="setView('rooms')"><i class="bi bi-house-door-fill"></i> Расселение</button>
    <button class="nav-btn" data-view="editor" onclick="setView('editor')"><i class="bi bi-calendar2-week"></i> Моё расписание</button>
    <button class="nav-btn" data-view="groups" onclick="setView('groups')"><i class="bi bi-mortarboard-fill"></i> По группам</button>
    <button class="nav-btn" data-view="reports" onclick="setView('reports')"><i class="bi bi-megaphone-fill"></i> Отчёт родителям</button>
    <button class="nav-btn" data-view="checklists" onclick="setView('checklists')"><i class="bi bi-check2-square"></i> Чек-листы роли</button>
    <button class="nav-btn" data-view="team" onclick="setView('team')"><i class="bi bi-people-fill"></i> Команда смены</button>
    <button class="nav-btn" data-view="settings" onclick="setView('settings')"><i class="bi bi-sliders"></i> Параметры смены</button>
    <button class="nav-btn" data-view="log" onclick="setView('log')"><i class="bi bi-clock-history"></i> Журнал</button>
    <div class="sb-divider"></div>
    <div class="sb-section">Смена</div>
    <div class="sb-meta" id="shiftMeta"></div>
    <div class="sb-divider"></div>
    <div class="sb-section">Статус дня</div>
    <div class="sb-legend">
      <div class="lg-row"><span class="dot green"></span> Всё заполнено</div>
      <div class="lg-row"><span class="dot orange"></span> Есть пустые слоты</div>
      <div class="lg-row"><span class="dot red"></span> Нет ответственного</div>
    </div>
  </aside>
  <main class="content" id="content"></main>
</div>
<div id="printArea"></div>

<div class="overlay" id="kidOverlay" onclick="if(event.target===this)closeKidModal()">
  <div class="modal" style="max-width:420px">
    <div class="modal-head"><h2 id="km-title">Ребёнок</h2><button class="modal-close" onclick="closeKidModal()">&times;</button></div>
    <div class="modal-body">
      <div class="field"><label>Пол <small style="font-weight:400;color:var(--text3)">(в AlfaCRM бывает неточным)</small></label><div id="km-gender" class="km-gender"></div></div>
      <div class="field"><label>Хочет жить с (пожелания по соседям)</label><div id="km-wish" class="km-wish-list"></div></div>
    </div>
    <div class="modal-foot"><button class="btn-primary" onclick="closeKidModal()">Готово</button></div>
  </div>
</div>

<div class="overlay" id="idOverlay" onclick="if(event.target===this)closeIdentity()">
  <div class="modal" style="max-width:400px">
    <div class="modal-head"><h2>Кто вы?</h2></div>
    <div class="modal-body">
      <div class="field"><label>Имя и фамилия <small style="font-weight:400;color:var(--text3)">(подписывает ваши правки в журнале)</small></label><input type="text" id="id-name" placeholder="Напр. Дарья Афанасьева" onkeydown="if(event.key==='Enter')saveIdentity()"></div>
      <div class="field"><label>Ваша роль</label><div id="id-role" class="id-role"><button class="id-r" data-r="counselor" onclick="idPickRole('counselor')">Вожатый</button><button class="id-r" data-r="teacher" onclick="idPickRole('teacher')">Преподаватель</button><button class="id-r" data-r="manager" onclick="idPickRole('manager')">Руководитель</button></div></div>
    </div>
    <div class="modal-foot"><button class="btn-primary" onclick="saveIdentity()">Войти</button></div>
  </div>
</div>

<div class="overlay" id="overlay" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="modal-head"><h2 id="modalTitle">Новая активность</h2><button class="modal-close" onclick="closeModal()">&times;</button></div>
    <div class="modal-body">
      <div class="field"><label>Название активности</label><input type="text" id="f-title" placeholder="Напр. Урок: Введение в ИИ"></div>
      <div class="field-row">
        <div class="field"><label>Начало</label><input type="time" id="f-start" value="14:00"></div>
        <div class="field"><label>Конец</label><input type="time" id="f-end" value="15:00"></div>
      </div>
      <div class="field-row">
        <div class="field"><label>Место</label><input type="text" id="f-place" placeholder="Класс A / Поляна / Корпуса"></div>
        <div class="field"><label>Группа</label><select id="f-group"></select></div>
      </div>
      <div class="field-row">
        <div class="field"><label>Ответственный</label><select id="f-resp"></select></div>
        <div class="field"><label>Исполнитель</label><select id="f-exec"></select></div>
      </div>
      <div class="field"><label>Тип</label>
        <div class="type-radio">
          <label><input type="radio" name="f-type" value="mandatory" checked><i class="bi bi-pin-angle-fill"></i> Обязательная</label>
          <label><input type="radio" name="f-type" value="extra"><i class="bi bi-stars"></i> Доп. активность</label>
        </div>
      </div>
      <div class="field"><label>Описание / содержание <small style="font-weight:400;color:var(--text3)">(необязательно)</small></label><textarea id="f-desc" rows="2" placeholder="Что делаем, цель, материалы..."></textarea></div>
      <div class="field"><label>Чек-лист подготовки</label><div class="mini-chk-list" id="f-checklist"></div>
        <button class="btn-secondary" style="padding:7px 12px;font-size:13px;margin-top:4px" onclick="addModalChk()"><i class="bi bi-plus"></i> Пункт</button>
      </div>
    </div>
    <div class="modal-foot"><button class="btn-secondary" onclick="closeModal()">Отмена</button><button class="btn-primary" onclick="saveActivity()">Сохранить</button></div>
  </div>
</div>

<script is:inline>
  (function(){
    // Cookie теперь хранит сам пароль (не литерал '1') — сервер /api/shift-plan
    // сверяет его отдельно; здесь достаточно проверить, что она вообще есть.
    var ok = document.cookie.split('; ').reduce(function(r,v){var p=v.split('=');return p[0]==='staff_auth_2026'?decodeURIComponent(p.slice(1).join('=')):r;}, null);
    if (!ok) { location.replace('/staff'); }
  })();
  window.PERSIST = {
    mode: 'live',
    load: async function(){ try { var r = await fetch('/api/shift-plan', {cache:'no-store'}); var j = await r.json(); return j && j.plan; } catch(e){ return null; } },
    save: async function(p){ try { await fetch('/api/shift-plan', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(p, function(k,v){ return k.charAt(0)==='_' ? undefined : v; })}); return true; } catch(e){ return false; } },
  };
</script>
<script>import '../../scripts/pages/staff-plan'</script>
</body>
</html>
