---
import { DATES_S1, DATES_SHORT_S2 } from '../../data/shifts';
// Staff Portal — внутренняя вики АйДаКемп
// Доступ: пароль "2026", cookie на 30 дней
// noindex — не для поисковиков
export const prerender = true;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Портал сотрудников — АйДаКемп</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #f1f5f9;
      --surface:  #ffffff;
      --surface2: #f8fafc;
      --border:   #e2e8f0;
      --border2:  #cbd5e1;
      --orange:   #f97316;
      --orange-bg: rgba(236,124,0,0.08);
      --orange-border: rgba(236,124,0,0.3);
      --text:     #0f172a;
      --text2:    #334155;
      --text3:    #64748b;
      --green:    #16a34a;
      --green-bg: rgba(22,163,74,0.08);
      --red:      #dc2626;
      --red-bg:   rgba(220,38,38,0.08);
      --blue:     #2563eb;
      --radius:   12px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      font-size: 15px;
      line-height: 1.6;
    }

    /* ── LOGIN ── */
    #login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 16px;
      background: linear-gradient(135deg, #eff6ff 0%, #fdf2f8 100%);
    }
    .login-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 44px 36px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(15,23,42,0.08);
    }
    .login-logo {
      width: 60px; height: 60px;
      background: var(--orange);
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 28px;
      color: white;
    }
    .login-card h1 { font-size: 22px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
    .login-card p  { color: var(--text3); font-size: 14px; margin-bottom: 28px; }
    .login-input {
      width: 100%;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 16px;
      padding: 12px 14px;
      outline: none;
      margin-bottom: 12px;
      transition: border-color 0.2s;
      text-align: center;
      letter-spacing: 4px;
    }
    .login-input:focus { border-color: var(--orange); }
    .login-input::placeholder { letter-spacing: 0; color: var(--text3); }
    .login-btn {
      width: 100%;
      background: var(--orange);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      padding: 13px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }
    .login-btn:hover { opacity: 0.9; }
    .login-btn:active { transform: scale(0.99); }
    .login-remember {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
      color: var(--text3);
      font-size: 13px;
      cursor: pointer;
    }
    .login-remember input { accent-color: var(--orange); cursor: pointer; }
    .login-error { color: var(--red); font-size: 13px; margin-top: 10px; display: none; }

    /* ── PORTAL ── */
    #portal { display: none; }

    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 1px 4px rgba(15,23,42,0.06);
    }
    .topbar-logo {
      font-weight: 800;
      font-size: 15px;
      color: var(--orange);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .topbar-search {
      flex: 1;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 14px;
      padding: 7px 12px;
      outline: none;
      transition: border-color 0.2s;
      max-width: 340px;
    }
    .topbar-search:focus { border-color: var(--orange); }
    .topbar-search::placeholder { color: var(--text3); }
    .topbar-right { margin-left: auto; }
    .logout-btn {
      background: transparent;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      color: var(--text3);
      font-size: 13px;
      padding: 6px 12px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .logout-btn:hover { border-color: var(--red); color: var(--red); }

    .main-layout {
      display: flex;
      min-height: calc(100vh - 56px);
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 200px;
      flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 16px 0;
      position: sticky;
      top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
    }
    .sidebar-section {
      padding: 8px 16px 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text3);
    }
    .role-btn {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      padding: 9px 16px;
      background: transparent;
      border: none;
      color: var(--text2);
      font-size: 14px;
      cursor: pointer;
      text-align: left;
      transition: all 0.15s;
      border-left: 3px solid transparent;
    }
    .role-btn:hover { background: var(--bg); color: var(--text); }
    .role-btn.active {
      background: var(--orange-bg);
      border-left-color: var(--orange);
      color: var(--orange);
      font-weight: 600;
    }
    .role-icon { font-size: 16px; color: inherit; }

    .sidebar-divider { height: 1px; background: var(--border); margin: 12px 0; }

    .doc-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      color: var(--text3);
      font-size: 12px;
      text-decoration: none;
      transition: color 0.15s;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .doc-link:hover { color: var(--blue); }
    .doc-link i { flex-shrink: 0; }

    /* ── CONTENT ── */
    .content {
      flex: 1;
      padding: 24px 28px;
      overflow: hidden;
    }
    .content-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .content-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--text);
    }
    .content-subtitle {
      font-size: 13px;
      color: var(--text3);
      margin-top: 2px;
    }
    .search-count {
      font-size: 12px;
      color: var(--text3);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 10px;
    }

    /* ── DAY CARDS ── */
    .days-grid { display: flex; flex-direction: column; gap: 8px; }

    .day-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .day-card:hover { border-color: var(--border2); box-shadow: 0 2px 8px rgba(15,23,42,0.06); }
    .day-card.highlight { border-color: var(--orange); box-shadow: 0 2px 8px var(--orange-border); }
    .day-card.hidden { display: none; }

    .day-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s;
    }
    .day-header:hover { background: var(--surface2); }
    .day-header.open { background: var(--surface2); }

    .day-num {
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      width: 36px; height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text3);
      flex-shrink: 0;
    }
    .day-num.warning { background: var(--red-bg); border-color: rgba(220,38,38,0.3); color: var(--red); }
    .day-num.today   { background: var(--orange-bg); border-color: var(--orange-border); color: var(--orange); }

    .day-meta { flex: 1; min-width: 0; }
    .day-title    { font-size: 14px; font-weight: 600; color: var(--text); }
    .day-date     { font-size: 12px; color: var(--text3); margin-top: 1px; }
    .day-tasks-count {
      font-size: 12px;
      color: var(--text3);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 2px 8px;
      flex-shrink: 0;
    }
    .day-chevron {
      color: var(--text3);
      font-size: 14px;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .day-header.open .day-chevron { transform: rotate(180deg); }

    .day-body {
      display: none;
      padding: 0 18px 18px;
      border-top: 1px solid var(--border);
    }
    .day-body.open { display: block; }

    .tasks-list { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }
    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--surface2);
      border: 1.5px solid transparent;
      transition: border-color 0.15s;
    }
    .task-item:hover { border-color: var(--border); }
    .task-item.match { border-color: var(--orange); background: var(--orange-bg); }
    .task-check {
      width: 18px; height: 18px;
      border-radius: 50%;
      border: 2px solid var(--border2);
      flex-shrink: 0;
      margin-top: 2px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .task-check:hover { border-color: var(--orange); }
    .task-check.done {
      background: var(--green);
      border-color: var(--green);
    }
    .task-check.done::after {
      content: '';
      display: block;
      width: 5px;
      height: 9px;
      border: 2px solid white;
      border-top: none;
      border-left: none;
      transform: rotate(45deg) translate(-1px, -1px);
    }
    .task-item.warning { background: var(--red-bg); border-color: rgba(220,38,38,0.25); }
    .task-item.warning .task-text { color: var(--red); font-weight: 600; }
    .task-text { font-size: 14px; color: var(--text2); flex: 1; line-height: 1.5; }

    /* ── SEARCH RESULTS ── */
    #search-results { display: none; flex-direction: column; gap: 6px; }
    .search-result-item {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .search-result-item:hover { border-color: var(--orange); }
    .search-result-meta {
      font-size: 11px;
      color: var(--text3);
      margin-bottom: 6px;
      display: flex;
      gap: 8px;
    }
    .search-badge {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 1px 6px;
    }
    .search-result-text { font-size: 14px; color: var(--text); }
    mark {
      background: rgba(236,124,0,0.2);
      color: #c2410c;
      border-radius: 3px;
      padding: 0 2px;
    }

    /* ── DOCS PAGE ── */
    #docs-view { display: none; }
    .docs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 12px;
      margin-top: 8px;
    }
    .doc-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .doc-card:hover { border-color: var(--blue); box-shadow: 0 2px 8px rgba(37,99,235,0.1); }
    .doc-card-icon { font-size: 26px; color: var(--blue); }
    .doc-card-title { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.4; }
    .doc-card-hint  { font-size: 12px; color: var(--text3); }
    .doc-card-dl    { margin-top: 4px; font-size: 12px; color: var(--blue); font-weight: 600; display: flex; align-items: center; gap: 5px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .content { padding: 16px; padding-bottom: 80px; }
      .topbar-search { max-width: none; }
    }

    /* ── MOBILE BOTTOM NAV ── */
    .mobile-nav {
      display: none;
      position: fixed; bottom: 0; left: 0; right: 0;
      background: var(--surface); border-top: 1px solid var(--border);
      padding: 8px 0 max(8px, env(safe-area-inset-bottom));
      z-index: 200;
    }
    .mobile-nav-inner {
      display: flex; align-items: stretch; justify-content: space-around;
    }
    .mobile-nav-btn {
      flex: 1; display: flex; flex-direction: column; align-items: center;
      gap: 3px; padding: 4px 2px; background: none; border: none; cursor: pointer;
      color: var(--text3); font-size: 10px; font-weight: 600;
      transition: color .15s;
    }
    .mobile-nav-btn i { font-size: 20px; }
    .mobile-nav-btn.active { color: var(--orange); }
    .mobile-nav-btn:hover { color: var(--orange); }
    @media (max-width: 768px) {
      .mobile-nav { display: block; }
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text3);
    }
    .empty-state-icon { font-size: 36px; margin-bottom: 12px; color: var(--text3); }
    .empty-state-title { font-size: 16px; font-weight: 600; color: var(--text2); }

    /* ── ONBOARDING ──────────────────────────────────────────────── */
    #onboarding-screen { display: none; min-height: 100vh; background: var(--bg); padding: 20px; }
    .ob-card { max-width: 520px; margin: 40px auto; background: var(--surface); border-radius: 20px; padding: 28px 28px 24px; box-shadow: var(--shadow); }
    .ob-step-indicator { display: flex; gap: 6px; margin-bottom: 20px; }
    .ob-dot { flex: 1; height: 4px; border-radius: 2px; background: var(--border); }
    .ob-dot.done { background: var(--orange); }
    .ob-dot.active { background: var(--orange); opacity: .6; }
    .ob-role-title { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .8px; color: var(--orange); margin-bottom: 8px; }
    .ob-question { font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.4; margin-bottom: 18px; }
    .ob-answers { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }
    .ob-answer { padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 14px; color: var(--text); cursor: pointer; transition: .15s; background: var(--bg); }
    .ob-answer:hover { border-color: var(--orange); background: #fff8f0; }
    .ob-answer.correct { border-color: #16a34a; background: #dcfce7; color: #166534; }
    .ob-answer.wrong   { border-color: #dc2626; background: #fee2e2; color: #991b1b; }
    .ob-feedback { font-size: 13px; line-height: 1.5; padding: 10px 14px; border-radius: 10px; margin-bottom: 14px; display: none; }
    .ob-feedback.ok  { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .ob-feedback.bad { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .ob-next-btn { width: 100%; padding: 13px; background: var(--orange); color: white; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; display: none; }
    .ob-next-btn:hover { background: var(--orange-d); }
    .ob-rules-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .ob-rule-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; background: var(--bg); border-radius: 10px; border: 1.5px solid var(--border); cursor: pointer; transition: .15s; }
    .ob-rule-item.checked { border-color: var(--orange); background: #fff8f0; }
    .ob-rule-icon { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--border); flex-shrink: 0; margin-top: 1px; display: flex; align-items: center; justify-content: center; }
    .ob-rule-item.checked .ob-rule-icon { background: var(--orange); border-color: var(--orange); }
    .ob-rule-text { font-size: 13px; line-height: 1.55; color: var(--text2); }
    .ob-role-select { display: flex; flex-direction: column; gap: 10px; }
    .ob-role-btn { padding: 14px 18px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 15px; font-weight: 600; color: var(--text); background: var(--bg); cursor: pointer; text-align: left; display: flex; align-items: center; gap: 12px; transition: .15s; }
    .ob-role-btn:hover { border-color: var(--orange); background: #fff8f0; }
    .ob-role-btn i { font-size: 22px; color: var(--orange); width: 28px; flex-shrink: 0; }

/* ── SCHEDULE / ШАХМАТКА ── */
.sched-tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
.sched-tab {
  padding:8px 16px; border-radius:8px; border:1px solid var(--border);
  background:var(--surface); color:var(--text2); font-size:13px; font-weight:600;
  cursor:pointer; transition:all .15s;
}
.sched-tab.active { background:var(--orange); color:#fff; border-color:var(--orange); }

.sched-grid-wrap { overflow-x:auto; padding-bottom:8px; }
.sched-grid {
  display:grid;
  gap:8px;
  min-width:max-content;
}
.sched-day-card {
  background:var(--surface); border:1px solid var(--border); border-radius:12px;
  padding:12px 14px; cursor:pointer; min-width:160px; max-width:200px;
  transition:box-shadow .15s, border-color .15s;
}
.sched-day-card:hover { border-color:var(--orange); box-shadow:0 2px 12px rgba(249,115,22,.12); }
.sched-day-card.today { border-color:var(--orange); background:var(--orange-bg); }
.sched-day-card.done { border-color:#16a34a; }
.sched-day-num { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text3); margin-bottom:4px; }
.sched-day-date { font-size:12px; color:var(--text3); margin-bottom:6px; }
.sched-day-title { font-size:13px; font-weight:700; color:var(--text); margin-bottom:6px; line-height:1.3; }
.sched-day-events { display:flex; flex-direction:column; gap:2px; }
.sched-day-event { font-size:11px; color:var(--text3); line-height:1.35; }
.sched-day-event.highlight { color:var(--orange); font-weight:600; }
.sched-progress { height:3px; border-radius:2px; background:var(--border); margin-top:8px; overflow:hidden; }
.sched-progress-fill { height:100%; background:var(--orange); border-radius:2px; transition:width .3s; }
.sched-day-card.today .sched-day-num::after { content:' — СЕГОДНЯ'; color:var(--orange); }

.sched-detail-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap; }
.sched-back-btn {
  display:inline-flex; align-items:center; gap:6px; padding:8px 14px;
  border:1px solid var(--border); border-radius:8px; background:var(--surface);
  color:var(--text2); font-size:13px; font-weight:600; cursor:pointer; transition:all .15s;
}
.sched-back-btn:hover { border-color:var(--orange); color:var(--orange); }
.sched-detail-title { font-size:18px; font-weight:700; color:var(--text); }

/* Day schedule events block */
.day-events-list { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
.day-event-item { display:flex; align-items:baseline; gap:8px; font-size:14px; color:var(--text2); line-height:1.45; }
.day-event-item.evening { color:var(--text); font-weight:600; }

/* Role checklist sections */
.role-checklists-wrap { display:flex; flex-direction:column; gap:0; }
.role-cl-section { border:1px solid var(--border); border-radius:14px; padding:14px 16px; margin-bottom:10px; background:var(--surface); }
.role-cl-section .checklist-section-title { margin:0 0 10px; color:var(--text); }

.checklist-section-title {
  display:flex; align-items:center; gap:8px;
  font-size:14px; font-weight:700; color:var(--text); margin:16px 0 10px;
}
.checklist-badge {
  margin-left:auto; background:var(--orange-bg); color:var(--orange);
  border:1px solid var(--orange-border); border-radius:20px;
  padding:2px 10px; font-size:12px; font-weight:700;
}
.checklist-hint { font-size:13px; color:var(--text3); margin-bottom:12px; line-height:1.5; }

.checklist-item {
  display:flex; align-items:flex-start; gap:10px;
  padding:10px 12px; background:var(--surface); border:1px solid var(--border);
  border-radius:10px; margin-bottom:6px; cursor:pointer; transition:all .15s;
}
.checklist-item:hover { border-color:var(--orange); }
.checklist-item.checked { background:var(--green-bg); border-color:#16a34a; }
.checklist-item input[type=checkbox] { margin-top:2px; accent-color:var(--orange); width:16px; height:16px; flex-shrink:0; }
.checklist-item-label { font-size:14px; color:var(--text); line-height:1.5; }
.checklist-item.checked .checklist-item-label { text-decoration:line-through; color:var(--text3); }

/* Room inspection toggle */
.room-inspection-toggle {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 16px; background:var(--surface); border:1px solid var(--border);
  border-radius:12px; cursor:pointer; font-size:14px; font-weight:600;
  transition:border-color .15s;
}
.room-inspection-toggle:hover { border-color:var(--orange); }

/* Room inspection */
.room-block { background:var(--surface2); border:1px solid var(--border); border-radius:12px; margin-bottom:12px; overflow:hidden; }
.room-block-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:10px 14px; font-size:13px; font-weight:700; cursor:pointer;
  background:var(--surface);
}
.room-block-header .room-num { color:var(--orange); margin-right:6px; }
.room-block-body { padding:4px 14px 10px; }
.room-block-progress { font-size:12px; color:var(--text3); }

.defects-block { margin-top:16px; }
.defects-label { display:block; font-size:13px; font-weight:600; color:var(--text2); margin-bottom:6px; }
#defects-text {
  width:100%; border:1px solid var(--border); border-radius:8px; padding:10px 12px;
  font-size:13px; color:var(--text); background:var(--surface); resize:vertical; font-family:inherit;
}
.copy-defects-btn {
  margin-top:8px; display:inline-flex; align-items:center; gap:6px;
  padding:8px 14px; border:1px solid var(--border); border-radius:8px;
  background:var(--surface); color:var(--text2); font-size:13px; font-weight:600;
  cursor:pointer; transition:all .15s;
}
.copy-defects-btn:hover { border-color:var(--orange); color:var(--orange); }

/* Photo tasks */
.photo-item {
  display:flex; align-items:flex-start; gap:10px;
  padding:10px 12px; background:var(--surface); border:1px solid var(--border);
  border-radius:10px; margin-bottom:6px; cursor:pointer; transition:all .15s;
}
.photo-item:hover { border-color:#2563eb; }
.photo-item.checked { background:rgba(37,99,235,0.06); border-color:#2563eb; }
.photo-item input[type=checkbox] { margin-top:2px; accent-color:#2563eb; width:16px; height:16px; flex-shrink:0; }
.photo-item-label { font-size:14px; color:var(--text); line-height:1.5; }
.photo-item.checked .photo-item-label { text-decoration:line-through; color:var(--text3); }

  </style>
</head>
<body>

<!-- ═══ LOGIN ═══ -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-logo">
      <i class="bi bi-houses-fill" style="font-size:26px"></i>
    </div>
    <h1>Портал сотрудников</h1>
    <p>АйДаКемп · Смена 1 ({DATES_S1})</p>
    <input
      type="password"
      id="pwd-input"
      class="login-input"
      placeholder="Введите пароль"
      autocomplete="current-password"
    />
    <button class="login-btn" id="login-btn">Войти</button>
    <label class="login-remember">
      <input type="checkbox" id="remember-me" checked />
      Запомнить меня (30 дней)
    </label>
    <div class="login-error" id="login-error">Неверный пароль</div>
  </div>
</div>


<!-- ═══ ONBOARDING ═══ -->
<div id="onboarding-screen">
  <div class="ob-card" id="ob-card">
    <!-- Динамически рендерится JS -->
  </div>
</div>

<!-- ═══ PORTAL ═══ -->
<div id="portal">
  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-logo">
      <i class="bi bi-houses-fill"></i>
      АйДаКемп
    </div>
    <input
      type="search"
      id="search-input"
      class="topbar-search"
      placeholder="Поиск по задачам..."
      autocomplete="off"
    />
    <div class="topbar-right">
      <button class="logout-btn" id="logout-btn">
        <i class="bi bi-box-arrow-right" style="margin-right:5px"></i>Выйти
      </button>
    </div>
  </div>

  <div class="main-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-section">Роль</div>

      <button class="role-btn active" data-role="counselor">
        <i class="bi bi-person-arms-up role-icon"></i> Вожатый
      </button>
      <button class="role-btn" data-role="teacher">
        <i class="bi bi-laptop role-icon"></i> Преподаватель
      </button>
      <button class="role-btn" data-role="director">
        <i class="bi bi-clipboard-check role-icon"></i> Руководитель
      </button>

      <div class="sidebar-divider"></div>
      <div class="sidebar-section">Разделы</div>

      <button class="role-btn" data-role="docs">
        <i class="bi bi-file-earmark-text role-icon"></i> Документы
      </button>
      <button class="role-btn" data-role="intro">
        <i class="bi bi-info-circle role-icon"></i> Интро
      </button>
      <button class="role-btn" data-role="quiz">
        <i class="bi bi-patch-question role-icon"></i> Тест
      </button>
      <button class="role-btn" data-role="schedule">
        <i class="bi bi-calendar3 role-icon"></i> Расписание
      </button>

      <div class="sidebar-divider"></div>
      <div class="sidebar-section">Скачать</div>

      <div>
        <a class="doc-link" href="/staff/docs/01-rukovoditel-smeny.docx" download>
          <i class="bi bi-download"></i> Рук. смены
        </a>
        <a class="doc-link" href="/staff/docs/02-prepodavatel.docx" download>
          <i class="bi bi-download"></i> Преподаватель
        </a>
        <a class="doc-link" href="/staff/docs/03-vozhatiy.docx" download>
          <i class="bi bi-download"></i> Вожатый
        </a>
        <a class="doc-link" href="/staff/docs/04-vozhatiy-rasshirennaya.docx" download>
          <i class="bi bi-download"></i> Вожатый (расш.)
        </a>
        <a class="doc-link" href="/staff/docs/05-instruktsiya-chs.docx" download>
          <i class="bi bi-download"></i> Инструкция ЧС
        </a>
        <a class="doc-link" href="/staff/docs/06-cheklistpriemki.docx" download>
          <i class="bi bi-download"></i> Чеклист приёмки
        </a>
        <a class="doc-link" href="/staff/docs/07-igrovaya-mehanika.docx" download>
          <i class="bi bi-download"></i> Игровая механика
        </a>
      </div>
    </aside>

    <!-- Content -->
    <main class="content">
      <!-- Days view -->
      <div id="days-view">
        <div class="content-header">
          <div>
            <div class="content-title" id="content-title">Вожатый</div>
            <div class="content-subtitle">Смена 1 · {DATES_S1} · 10 дней</div>
          </div>
          <div class="search-count" id="search-count" style="display:none"></div>
        </div>
        <div class="days-grid" id="days-list"></div>
        <div id="search-results"></div>
        <div class="empty-state" id="empty-state" style="display:none">
          <div class="empty-state-icon"><i class="bi bi-search"></i></div>
          <div class="empty-state-title">Ничего не найдено</div>
          <div style="margin-top:6px;font-size:13px;color:var(--text3)">Попробуйте другой запрос</div>
        </div>
      </div>

      <!-- Intro view -->
      <div id="intro-view" style="display:none">
        <div class="content-header">
          <div>
            <div class="content-title" id="intro-title">Интро</div>
            <div class="content-subtitle">Основные моменты — для роли <span id="intro-role-label">вожатый</span></div>
          </div>
        </div>
        <div id="intro-list" style="display:flex;flex-direction:column;gap:10px;max-width:720px"></div>
      </div>

      <!-- Quiz view -->
      <div id="quiz-view" style="display:none">
        <div class="content-header">
          <div>
            <div class="content-title" id="quiz-title">Тест</div>
            <div class="content-subtitle">Самопроверка — для роли <span id="quiz-role-label">вожатый</span></div>
          </div>
        </div>
        <div class="ob-card" id="quiz-card" style="margin:0;max-width:720px"></div>
      </div>

      <!-- Docs view -->
      <div id="docs-view">
        <div class="content-header">
          <div>
            <div class="content-title">Документы</div>
            <div class="content-subtitle">Должностные инструкции и чеклисты</div>
          </div>
        </div>
        <div class="docs-grid">
          <a class="doc-card" href="/staff/docs/01-rukovoditel-smeny.docx" download>
            <i class="bi bi-person-check doc-card-icon"></i>
            <div class="doc-card-title">Должностная инструкция<br/>Руководитель смены</div>
            <div class="doc-card-hint">Права, обязанности, ежедневные задачи</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/02-prepodavatel.docx" download>
            <i class="bi bi-laptop doc-card-icon"></i>
            <div class="doc-card-title">Должностная инструкция<br/>Преподаватель</div>
            <div class="doc-card-hint">Программа обучения, расписание, требования</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/03-vozhatiy.docx" download>
            <i class="bi bi-person-arms-up doc-card-icon"></i>
            <div class="doc-card-title">Должностная инструкция<br/>Вожатый (базовая)</div>
            <div class="doc-card-hint">Базовые обязанности и правила</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/04-vozhatiy-rasshirennaya.docx" download>
            <i class="bi bi-book doc-card-icon"></i>
            <div class="doc-card-title">Должностная инструкция<br/>Вожатый (расширенная)</div>
            <div class="doc-card-hint">Полный список с условиями и штрафами</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/05-instruktsiya-chs.docx" download>
            <i class="bi bi-exclamation-triangle-fill doc-card-icon" style="color:var(--red)"></i>
            <div class="doc-card-title">Инструкция по ЧС</div>
            <div class="doc-card-hint">Что делать при нештатной ситуации</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/06-cheklistpriemki.docx" download>
            <i class="bi bi-clipboard-check doc-card-icon" style="color:var(--green)"></i>
            <div class="doc-card-title">Чеклист приёмки помещений</div>
            <div class="doc-card-hint">Что проверить при заезде и выезде</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/07-igrovaya-mehanika.docx" download>
            <i class="bi bi-controller doc-card-icon"></i>
            <div class="doc-card-title">Система игровой механики</div>
            <div class="doc-card-hint">Правила экономики, рубли (игровая валюта), штрафы/награды</div>
            <div class="doc-card-dl"><i class="bi bi-download"></i> Скачать .docx</div>
          </a>
        </div>
      </div>

      <!-- Schedule view -->
      <div id="schedule-view" style="display:none">
        <div class="content-header">
          <div>
            <div class="content-title">Расписание смены</div>
            <div class="content-subtitle">Шахматка · чеклисты · приёмка помещений</div>
          </div>
        </div>

        <!-- Tab switcher -->
        <div class="sched-tabs">
          <button class="sched-tab active" data-shift="1">Смена 1 · {DATES_S1} (10 дн.)</button>
          <button class="sched-tab" data-shift="2">Смена 2 · {DATES_SHORT_S2} (14 дн.)</button>
        </div>

        <!-- Шахматка — горизонтальный скролл -->
        <div class="sched-grid-wrap">
          <div class="sched-grid" id="sched-grid"></div>
        </div>

        <!-- Чеклист дня + приёмка (показывается при клике на день) -->
        <div class="sched-detail" id="sched-detail" style="display:none">
          <div class="sched-detail-header">
            <button class="sched-back-btn" id="sched-back">
              <i class="bi bi-arrow-left"></i> Назад к шахматке
            </button>
            <div class="sched-detail-title" id="sched-detail-title"></div>
          </div>

          <!-- Расписание дня -->
          <div id="day-sched-section" style="display:none; margin-bottom:20px"></div>

          <!-- Чеклисты по ролям -->
          <div id="role-checklists-wrap">
            <div class="role-cl-section">
              <div class="checklist-section-title">
                <i class="bi bi-person-fill" aria-hidden="true"></i> Вожатый
                <span class="checklist-badge" id="cl-badge-counselor">0/0</span>
              </div>
              <div id="cl-body-counselor"></div>
            </div>
            <div class="role-cl-section">
              <div class="checklist-section-title">
                <i class="bi bi-laptop" aria-hidden="true"></i> Преподаватель
                <span class="checklist-badge" id="cl-badge-teacher">0/0</span>
              </div>
              <div id="cl-body-teacher"></div>
            </div>
            <div class="role-cl-section">
              <div class="checklist-section-title">
                <i class="bi bi-clipboard-check" aria-hidden="true"></i> Руководитель смены
                <span class="checklist-badge" id="cl-badge-director">0/0</span>
              </div>
              <div id="cl-body-director"></div>
            </div>
          </div>

          <!-- Итоги дня для родителей -->
          <div class="checklist-section-title" style="margin-top:24px">
            <i class="bi bi-camera-video-fill" aria-hidden="true"></i> Итоги для родителей
            <span class="checklist-badge" id="photo-badge">0/0</span>
          </div>
          <p class="checklist-hint">Фото и видео — в родительский чат; отчёт — краткий текст о дне.</p>
          <div id="photo-checklist"></div>

          <!-- День 1: приёмка помещений (показывается только для дня 1, свёрнута по умолчанию) -->
          <div id="room-inspection" style="display:none; margin-top:24px">
            <div class="room-inspection-toggle" id="room-inspection-toggle" onclick="toggleRoomInspection()">
              <div style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-camera-fill" style="color:var(--orange)"></i>
                <span>Приёмка помещений — День 1</span>
                <span class="checklist-badge" id="room-badge">0/0</span>
              </div>
              <i class="bi bi-chevron-down" id="room-insp-chevron" style="color:var(--text3);transition:transform .2s"></i>
            </div>
            <div id="room-inspection-body" style="display:none">
              <p class="checklist-hint" style="margin:8px 0 10px">После каждой комнаты — фото в рабочий чат. Неисправности — записать ниже.</p>
              <div id="room-checklist"></div>
              <div class="defects-block">
                <label class="defects-label">Недостатки / замечания (для чата)</label>
                <textarea id="defects-text" placeholder="Комната 101: не работает лампа в туалете. Комната 203: сломан карниз занавески..." rows="4"></textarea>
                <button class="copy-defects-btn" id="copy-defects">
                  <i class="bi bi-clipboard"></i> Скопировать для чата
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Мобильная навигация (показывается только на мобилках) -->
  <nav class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-inner">
      <button class="mobile-nav-btn active" id="mnav-schedule" onclick="mobileNav('schedule')">
        <i class="bi bi-calendar3"></i>Расписание
      </button>
      <button class="mobile-nav-btn" id="mnav-counselor" onclick="mobileNav('counselor')">
        <i class="bi bi-person-arms-up"></i>Вожатый
      </button>
      <button class="mobile-nav-btn" id="mnav-teacher" onclick="mobileNav('teacher')">
        <i class="bi bi-laptop"></i>Преподаватель
      </button>
      <button class="mobile-nav-btn" id="mnav-director" onclick="mobileNav('director')">
        <i class="bi bi-clipboard-check"></i>Рук.смены
      </button>
      <button class="mobile-nav-btn" id="mnav-docs" onclick="mobileNav('docs')">
        <i class="bi bi-file-earmark-text"></i>Документы
      </button>
    </div>
  </nav>
</div>

<script>import '../../scripts/pages/staff-index'</script>
</html>
