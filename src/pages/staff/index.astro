  // ── AUTH ──────────────────────────────────────────────────────────────────

  const COOKIE_NAME = 'staff_auth_2026';
  const PASSWORD = '2026';

  function getCookie(name) {
    return document.cookie.split('; ').reduce((r, v) => {
      const [k, ...val] = v.split('=');
      return k === name ? decodeURIComponent(val.join('=')) : r;
    }, null);
  }

  function setCookie(name, value, days) {
    const d = new Date();
    d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${encodeURIComponent(value)};expires=${d.toUTCString()};path=/;SameSite=Lax`;
  }

  function removeCookie(name) {
    document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/`;
  }

  function showPortal() {
    document.getElementById('login-screen').style.display = 'none';
    document.getElementById('portal').style.display = 'block';
    renderDays('counselor');
  }

  function handleLogin() {
    const pwd = document.getElementById('pwd-input').value.trim();
    const remember = document.getElementById('remember-me').checked;
    const errEl = document.getElementById('login-error');

    if (pwd === PASSWORD) {
      if (remember) setCookie(COOKIE_NAME, 'ok', 30);
      errEl.style.display = 'none';
      showPortal();
    } else {
      errEl.style.display = 'block';
      document.getElementById('pwd-input').select();
    }
  }

  // ── STATE ─────────────────────────────────────────────────────────────────

  let currentRole = 'counselor';
  let openDays = new Set();
  let checkedTasks = JSON.parse(localStorage.getItem('staff_checked') || '{}');
  let currentView = 'days'; // 'days' | 'docs'

  function saveChecked() {
    localStorage.setItem('staff_checked', JSON.stringify(checkedTasks));
  }

  // ── RENDER ────────────────────────────────────────────────────────────────

  function renderDays(role) {
    currentRole = role;
    currentView = 'days';

    document.getElementById('docs-view').style.display = 'none';
    document.getElementById('days-view').style.display = 'block';
    document.getElementById('empty-state').style.display = 'none';
    document.getElementById('search-count').style.display = 'none';

    const roleData = ROLES[role];
    document.getElementById('content-title').textContent = `${roleData.label} — 14 дней смены`;

    const list = document.getElementById('days-list');
    list.innerHTML = '';
    list.style.display = 'flex';
    document.getElementById('search-results').style.display = 'none';

    Object.entries(roleData.days).forEach(([dayNum, day]) => {
      const n = parseInt(dayNum);
      const isWarning = day.tasks.some(t => t.startsWith('⚠️'));
      const card = document.createElement('div');
      card.className = 'day-card';
      card.dataset.day = n;

      const isOpen = openDays.has(`${role}-${n}`);

      card.innerHTML = `
        <div class="day-header ${isOpen ? 'open' : ''}" onclick="toggleDay('${role}',${n},this)">
          <div class="day-num ${isWarning ? 'warning' : ''}">${n}</div>
          <div class="day-meta">
            <div class="day-title">День ${n} — ${day.title}</div>
            <div class="day-subtitle">${day.tasks.length} задач${day.tasks.length >= 5 ? '' : 'и'}</div>
          </div>
          <div class="day-tasks-count">${day.tasks.length}</div>
          <div class="day-chevron">▼</div>
        </div>
        <div class="day-body ${isOpen ? 'open' : ''}">
          <div class="tasks-list">${renderTasks(role, n, day.tasks)}</div>
        </div>
      `;
      list.appendChild(card);
    });
  }

  function renderTasks(role, dayNum, tasks, highlight = '') {
    return tasks.map((task, idx) => {
      const key = `${role}-${dayNum}-${idx}`;
      const isDone = checkedTasks[key];
      const isWarn = task.startsWith('⚠️') || task.startsWith('📋');
      let text = task;
      if (highlight && task.toLowerCase().includes(highlight.toLowerCase())) {
        text = task.replace(new RegExp(`(${escapeRe(highlight)})`, 'gi'), '<mark>$1</mark>');
      }
      return `
        <div class="task-item ${isWarn ? 'task-warning' : ''}">
          <div class="task-check ${isDone ? 'done' : ''}"
               onclick="toggleTask('${key}',this)" title="Отметить выполненным"></div>
          <div class="task-text">${text}</div>
        </div>
      `;
    }).join('');
  }

  function toggleDay(role, n, headerEl) {
    const key = `${role}-${n}`;
    const body = headerEl.nextElementSibling;
    if (openDays.has(key)) {
      openDays.delete(key);
      headerEl.classList.remove('open');
      body.classList.remove('open');
    } else {
      openDays.add(key);
      headerEl.classList.add('open');
      body.classList.add('open');
    }
  }

  function toggleTask(key, el) {
    checkedTasks[key] = !checkedTasks[key];
    el.classList.toggle('done', checkedTasks[key]);
    saveChecked();
  }

  function showDocs() {
    currentView = 'docs';
    document.getElementById('days-view').style.display = 'none';
    document.getElementById('docs-view').style.display = 'block';
  }

  // ── SEARCH ────────────────────────────────────────────────────────────────

  function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

  function handleSearch(q) {
    const query = q.trim();
    const list = document.getElementById('days-list');
    const resultsEl = document.getElementById('search-results');
    const countEl = document.getElementById('search-count');
    const emptyEl = document.getElementById('empty-state');

    if (!query) {
      list.style.display = 'flex';
      resultsEl.style.display = 'none';
      countEl.style.display = 'none';
      emptyEl.style.display = 'none';
      return;
    }

    // Search across all roles
    const matches = [];
    const ql = query.toLowerCase();

    Object.entries(ROLES).forEach(([role, roleData]) => {
      Object.entries(roleData.days).forEach(([dayNum, day]) => {
        const n = parseInt(dayNum);
        const dayMatch = day.title.toLowerCase().includes(ql);
        const taskMatches = day.tasks.filter(t => t.toLowerCase().includes(ql));

        if (dayMatch || taskMatches.length > 0) {
          const itemTasks = dayMatch ? day.tasks : taskMatches;
          matches.push({ role, roleLabel: roleData.label, dayNum: n, dayTitle: day.title, tasks: itemTasks });
        }
      });
    });

    list.style.display = 'none';
    resultsEl.innerHTML = '';

    if (matches.length === 0) {
      resultsEl.style.display = 'none';
      countEl.style.display = 'none';
      emptyEl.style.display = 'block';
      return;
    }

    emptyEl.style.display = 'none';
    countEl.style.display = 'block';
    countEl.textContent = `Найдено: ${matches.length} результатов`;

    resultsEl.style.display = 'flex';
    matches.forEach(m => {
      const el = document.createElement('div');
      el.className = 'search-result-item';
      el.onclick = () => {
        document.getElementById('search-input').value = '';
        handleSearch('');
        // Switch to role and open day
        switchRole(m.role);
        setTimeout(() => {
          const card = document.querySelector(`.day-card[data-day="${m.dayNum}"]`);
          if (card) {
            const header = card.querySelector('.day-header');
            if (!openDays.has(`${m.role}-${m.dayNum}`)) toggleDay(m.role, m.dayNum, header);
            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 50);
      };
      const tasksHtml = m.tasks.slice(0, 3).map(t => {
        return '<div class="search-result-text">' +
          t.replace(new RegExp(`(${escapeRe(query)})`, 'gi'), '<mark>$1</mark>') +
          '</div>';
      }).join('');
      const moreCount = m.tasks.length > 3 ? `<span style="color:var(--text3);font-size:12px">+${m.tasks.length-3} задач</span>` : '';

      el.innerHTML = `
        <div class="search-result-meta">
          <span class="search-badge">${m.roleLabel}</span>
          <span>День ${m.dayNum} — ${m.dayTitle}</span>
        </div>
        ${tasksHtml}
        ${moreCount}
      `;
      resultsEl.appendChild(el);
    });
  }

  // ── SIDEBAR ROLE SWITCH ───────────────────────────────────────────────────

  function switchRole(role) {
    document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`.role-btn[data-role="${role}"]`);
    if (btn) btn.classList.add('active');

    if (role === 'docs') {
      showDocs();
    } else {
      renderDays(role);
    }
  }

  // ── INIT ──────────────────────────────────────────────────────────────────

  document.addEventListener('DOMContentLoaded', () => {
    // Check cookie
    if (getCookie(COOKIE_NAME) === 'ok') {
      showPortal();
    }

    // Login
    document.getElementById('login-btn').addEventListener('click', handleLogin);
    document.getElementById('pwd-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') handleLogin();
    });

    // Logout
    document.getElementById('logout-btn').addEventListener('click', () => {
      removeCookie(COOKIE_NAME);
      document.getElementById('login-screen').style.display = 'flex';
      document.getElementById('portal').style.display = 'none';
      document.getElementById('pwd-input').value = '';
    });

    // Search
    let searchTimer;
    document.getElementById('search-input').addEventListener('input', e => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => handleSearch(e.target.value), 180);
    });

    // Sidebar role buttons
    document.querySelectorAll('.role-btn[data-role]').forEach(btn => {
      btn.addEventListener('click', () => switchRole(btn.dataset.role));
    });
  });
</script>
</body>
</html>
