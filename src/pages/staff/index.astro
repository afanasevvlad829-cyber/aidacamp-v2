---
// Staff Portal — внутренняя вики АйДаКемп
// Доступ: пароль "2026", запоминается в cookie на 30 дней
// noindex — не для поисковиков
export const prerender = true;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Портал вожатых — АйДаКемп</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface2: #263348;
      --border: #334155;
      --orange: #f97316;
      --orange-dim: rgba(249,115,22,0.12);
      --text: #f1f5f9;
      --text2: #94a3b8;
      --text3: #64748b;
      --green: #22c55e;
      --red: #ef4444;
      --blue: #3b82f6;
      --radius: 12px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      font-size: 15px;
      line-height: 1.6;
    }

    /* ── LOGIN ── */
    #login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 16px;
    }
    .login-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 40px 36px;
      width: 100%;
      max-width: 380px;
      text-align: center;
    }
    .login-logo {
      width: 56px; height: 56px;
      background: var(--orange);
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 20px;
    }
    .login-card h1 { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
    .login-card p { color: var(--text2); font-size: 14px; margin-bottom: 28px; }
    .login-input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 16px;
      padding: 12px 14px;
      outline: none;
      margin-bottom: 12px;
      transition: border-color 0.2s;
      text-align: center;
      letter-spacing: 4px;
    }
    .login-input:focus { border-color: var(--orange); }
    .login-input::placeholder { letter-spacing: 0; }
    .login-btn {
      width: 100%;
      background: var(--orange);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      padding: 13px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .login-btn:hover { opacity: 0.9; }
    .login-remember {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
      color: var(--text3);
      font-size: 13px;
      cursor: pointer;
    }
    .login-remember input { accent-color: var(--orange); cursor: pointer; }
    .login-error {
      color: var(--red);
      font-size: 13px;
      margin-top: 10px;
      display: none;
    }

    /* ── PORTAL ── */
    #portal { display: none; }

    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-logo {
      font-weight: 800;
      font-size: 15px;
      color: var(--orange);
      white-space: nowrap;
    }
    .topbar-search {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 14px;
      padding: 7px 12px;
      outline: none;
      transition: border-color 0.2s;
      max-width: 360px;
    }
    .topbar-search:focus { border-color: var(--orange); }
    .topbar-search::placeholder { color: var(--text3); }
    .topbar-right { margin-left: auto; }
    .logout-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text2);
      font-size: 13px;
      padding: 6px 12px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .logout-btn:hover { border-color: var(--red); color: var(--red); }

    .main-layout {
      display: flex;
      min-height: calc(100vh - 56px);
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 200px;
      flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 16px 0;
      position: sticky;
      top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
    }
    .sidebar-section {
      padding: 8px 16px 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text3);
    }
    .role-btn {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      padding: 9px 16px;
      background: transparent;
      border: none;
      color: var(--text2);
      font-size: 14px;
      cursor: pointer;
      text-align: left;
      transition: all 0.15s;
      border-left: 3px solid transparent;
    }
    .role-btn:hover { background: var(--surface2); color: var(--text); }
    .role-btn.active {
      background: var(--orange-dim);
      border-left-color: var(--orange);
      color: var(--orange);
      font-weight: 600;
    }
    .role-icon { font-size: 16px; }

    .sidebar-divider { height: 1px; background: var(--border); margin: 12px 0; }

    .sidebar-docs { padding: 4px 0; }
    .doc-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      color: var(--text3);
      font-size: 12px;
      text-decoration: none;
      transition: color 0.15s;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .doc-link:hover { color: var(--blue); }

    /* ── CONTENT ── */
    .content {
      flex: 1;
      padding: 24px 28px;
      overflow: hidden;
    }
    .content-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .content-title {
      font-size: 20px;
      font-weight: 700;
    }
    .search-count {
      font-size: 12px;
      color: var(--text3);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 10px;
    }

    /* ── DAY CARDS ── */
    .days-grid { display: flex; flex-direction: column; gap: 8px; }

    .day-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .day-card:hover { border-color: var(--border); }
    .day-card.highlight { border-color: var(--orange); }
    .day-card.hidden { display: none; }

    .day-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s;
    }
    .day-header:hover { background: var(--surface2); }
    .day-header.open { background: var(--surface2); }

    .day-num {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text2);
      flex-shrink: 0;
    }
    .day-num.warning { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.4); color: var(--red); }
    .day-num.today { background: var(--orange-dim); border-color: var(--orange); color: var(--orange); }

    .day-meta { flex: 1; min-width: 0; }
    .day-title { font-size: 14px; font-weight: 600; color: var(--text); }
    .day-subtitle { font-size: 12px; color: var(--text3); margin-top: 2px; }
    .day-tasks-count {
      font-size: 12px;
      color: var(--text3);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 2px 8px;
      flex-shrink: 0;
    }
    .day-chevron {
      color: var(--text3);
      font-size: 12px;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .day-header.open .day-chevron { transform: rotate(180deg); }

    .day-body {
      display: none;
      padding: 0 18px 18px;
      border-top: 1px solid var(--border);
    }
    .day-body.open { display: block; }

    .tasks-list { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }
    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--bg);
      border: 1px solid transparent;
      transition: border-color 0.15s;
    }
    .task-item:hover { border-color: var(--border); }
    .task-item.match { border-color: var(--orange); background: var(--orange-dim); }
    .task-check {
      width: 18px; height: 18px;
      border-radius: 50%;
      border: 2px solid var(--border);
      flex-shrink: 0;
      margin-top: 2px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .task-check:hover { border-color: var(--orange); }
    .task-check.done {
      background: var(--green);
      border-color: var(--green);
    }
    .task-check.done::after {
      content: '✓';
      display: block;
      text-align: center;
      color: white;
      font-size: 11px;
      line-height: 14px;
    }
    .task-warning { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.3); }
    .task-warning .task-text { color: var(--red); font-weight: 600; }
    .task-text { font-size: 14px; color: var(--text2); flex: 1; line-height: 1.5; }

    /* ── SEARCH RESULTS ── */
    #search-results {
      display: none;
      flex-direction: column;
      gap: 6px;
    }
    .search-result-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .search-result-item:hover { border-color: var(--orange); }
    .search-result-meta {
      font-size: 11px;
      color: var(--text3);
      margin-bottom: 6px;
      display: flex;
      gap: 8px;
    }
    .search-badge {
      background: var(--surface2);
      border-radius: 4px;
      padding: 1px 6px;
    }
    .search-result-text { font-size: 14px; color: var(--text); }
    mark {
      background: rgba(249,115,22,0.35);
      color: var(--orange);
      border-radius: 3px;
      padding: 0 2px;
    }

    /* ── DOCS PAGE ── */
    #docs-view {
      display: none;
    }
    .docs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 12px;
      margin-top: 8px;
    }
    .doc-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border-color 0.2s;
    }
    .doc-card:hover { border-color: var(--blue); }
    .doc-card-icon { font-size: 28px; }
    .doc-card-title { font-size: 14px; font-weight: 600; color: var(--text); }
    .doc-card-hint { font-size: 12px; color: var(--text3); }
    .doc-card-dl {
      margin-top: 4px;
      font-size: 12px;
      color: var(--blue);
      font-weight: 600;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .content { padding: 16px; }
      .topbar-search { max-width: none; }
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text3);
    }
    .empty-state-icon { font-size: 40px; margin-bottom: 12px; }
    .empty-state-title { font-size: 16px; font-weight: 600; color: var(--text2); }
  </style>
</head>
<body>

<!-- ═══ LOGIN ═══ -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-logo">⛺</div>
    <h1>Портал вожатых</h1>
    <p>АйДаКемп — внутренняя вики</p>
    <input
      type="password"
      id="pwd-input"
      class="login-input"
      placeholder="Введите пароль"
      autocomplete="current-password"
    />
    <button class="login-btn" id="login-btn">Войти</button>
    <label class="login-remember">
      <input type="checkbox" id="remember-me" checked />
      Запомнить меня (30 дней)
    </label>
    <div class="login-error" id="login-error">Неверный пароль</div>
  </div>
</div>

<!-- ═══ PORTAL ═══ -->
<div id="portal">
  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-logo">⛺ АйДаКемп</div>
    <input
      type="search"
      id="search-input"
      class="topbar-search"
      placeholder="Поиск по задачам, дням..."
      autocomplete="off"
    />
    <div class="topbar-right">
      <button class="logout-btn" id="logout-btn">Выйти</button>
    </div>
  </div>

  <div class="main-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-section">Роли</div>

      <button class="role-btn active" data-role="counselor">
        <span class="role-icon">🏕️</span> Вожатый
      </button>
      <button class="role-btn" data-role="teacher">
        <span class="role-icon">💻</span> Преподаватель
      </button>
      <button class="role-btn" data-role="director">
        <span class="role-icon">📋</span> Руководитель
      </button>

      <div class="sidebar-divider"></div>
      <div class="sidebar-section">Разделы</div>

      <button class="role-btn" data-role="docs">
        <span class="role-icon">📄</span> Документы
      </button>

      <div class="sidebar-divider"></div>
      <div class="sidebar-section">Инструкции</div>

      <div class="sidebar-docs">
        <a class="doc-link" href="/staff/docs/01-rukovoditel-smeny.docx" download>📥 Рук. смены</a>
        <a class="doc-link" href="/staff/docs/02-prepodavatel.docx" download>📥 Преподаватель</a>
        <a class="doc-link" href="/staff/docs/03-vozhatiy.docx" download>📥 Вожатый</a>
        <a class="doc-link" href="/staff/docs/04-vozhatiy-rasshirennaya.docx" download>📥 Вожатый (расш.)</a>
        <a class="doc-link" href="/staff/docs/05-instruktsiya-chs.docx" download>📥 Инструкция ЧС</a>
        <a class="doc-link" href="/staff/docs/06-cheklistpriemki.docx" download>📥 Чеклист приёмки</a>
        <a class="doc-link" href="/staff/docs/07-igrovaya-mehanika.docx" download>📥 Игровая механика</a>
      </div>
    </aside>

    <!-- Content -->
    <main class="content">
      <!-- Days view -->
      <div id="days-view">
        <div class="content-header">
          <div class="content-title" id="content-title">Вожатый — 14 дней смены</div>
          <div class="search-count" id="search-count" style="display:none"></div>
        </div>
        <div class="days-grid" id="days-list"></div>
        <div id="search-results"></div>
        <div class="empty-state" id="empty-state" style="display:none">
          <div class="empty-state-icon">🔍</div>
          <div class="empty-state-title">Ничего не найдено</div>
          <div style="margin-top:6px;font-size:13px">Попробуйте другой запрос</div>
        </div>
      </div>

      <!-- Docs view -->
      <div id="docs-view">
        <div class="content-header">
          <div class="content-title">Документы для скачивания</div>
        </div>
        <div class="docs-grid">
          <a class="doc-card" href="/staff/docs/01-rukovoditel-smeny.docx" download>
            <div class="doc-card-icon">📋</div>
            <div class="doc-card-title">Должностная инструкция<br/>Руководитель смены</div>
            <div class="doc-card-hint">Права, обязанности, ежедневные задачи</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/02-prepodavatel.docx" download>
            <div class="doc-card-icon">💻</div>
            <div class="doc-card-title">Должностная инструкция<br/>Преподаватель</div>
            <div class="doc-card-hint">Программа обучения, расписание, требования</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/03-vozhatiy.docx" download>
            <div class="doc-card-icon">🏕️</div>
            <div class="doc-card-title">Должностная инструкция<br/>Вожатый (базовая)</div>
            <div class="doc-card-hint">Базовые обязанности и правила</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/04-vozhatiy-rasshirennaya.docx" download>
            <div class="doc-card-icon">📖</div>
            <div class="doc-card-title">Должностная инструкция<br/>Вожатый (расширенная)</div>
            <div class="doc-card-hint">Полный список с условиями и штрафами</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/05-instruktsiya-chs.docx" download>
            <div class="doc-card-icon">🚨</div>
            <div class="doc-card-title">Инструкция по ЧС</div>
            <div class="doc-card-hint">Что делать при нештатной ситуации</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/06-cheklistpriemki.docx" download>
            <div class="doc-card-icon">✅</div>
            <div class="doc-card-title">Чеклист приёмки помещений</div>
            <div class="doc-card-hint">Что проверить при заезде и выезде</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
          <a class="doc-card" href="/staff/docs/07-igrovaya-mehanika.docx" download>
            <div class="doc-card-icon">🎮</div>
            <div class="doc-card-title">Система игровой механики</div>
            <div class="doc-card-hint">Правила экономики, единицы, штрафы/награды</div>
            <div class="doc-card-dl">↓ Скачать .docx</div>
          </a>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  // ── DATA ──────────────────────────────────────────────────────────────────

  const ROLES = {
    counselor: {
      label: 'Вожатый',
      days: {
        1:  { title: 'Заезд и адаптация', tasks: ['Встреча детей и родителей на входе', 'Помощь с размещением, расселение по комнатам', 'Сбор телефонов (в конце дня)', 'Первый инструктаж по режиму и правилам', 'Зарядка и первое знакомство с лагерем', 'Ужин и отбой (ранее — дети устают)', 'Общее фото для родителей'] },
        2:  { title: 'Организация и первые мероприятия', tasks: ['Контроль подъёма (встать за 20 мин до детей)', 'Зарядка и завтрак', 'Объяснение игровой механики (деньги, награды)', 'Первые занятия преподавателей', 'Досуг и организация игр', 'Бассейн (сбор желающих)', 'Полдник и свободное время', 'Ужин и отбой', 'Фото дня: занятия и бассейн'] },
        3:  { title: 'Налаживание быта', tasks: ['Полный контроль режима (подъём → зарядка)', 'Выдача первых игровых денег за поведение', 'Занятия и контроль дисциплины', 'Организация досуга (настолки, спорт)', 'Контроль гигиены и уборки в корпусе', 'Бассейн', 'Заполнение первого дневника отряда', 'Ужин и отбой с проверкой', 'Видео интервью с детьми для родителей'] },
