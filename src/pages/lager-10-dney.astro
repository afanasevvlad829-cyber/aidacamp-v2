---
import { DATES_SHORT_S4, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Почему именно эта длина — мамин расчёт",
    text: "Неделя — мелькнёт и нет. Две недели — звучит как «ты меня отдаёшь надолго». А десять суток — золотая середина: ребёнок успевает раскрыться, а мама — выдохнуть.\n\nДарья, основатель АйДаКемп, отправила дочь в лагерь именно на такой срок — сама не была готова на две недели, и дочь это чувствовала. Дочка вернулась с игрой в Roblox и одним желанием: «В следующий раз хочу на две недели».\n\nЕдинственная длина, при которой ребёнок успевает адаптироваться (первые 3–4 суток), войти в рабочий ритм и довести проект до хакатона — не обрывается на полуслове, как неделя.",
  },
  {
    h2: "Что успевает школьник в лагере: от идеи до хакатона",
    text: "Маршрут в лагере конкретный: знакомство, выбор трека, работа над проектом до хакатона. Домой школьник везёт телеграм-бот на нейросети, 3D-модель для печати или мини-игру.",
  },
  {
    h2: "Расписание короткой смены в лагере",
    text: "Два занятия по 90 минут, между ними — бассейн, спорт, свободное время, активности вечером.",
    list: [
      "08:30 — подъём, зарядка, завтрак в столовой санатория «Изумруд»",
      "10:00–11:30 — первое занятие: погружение в трек, группы до 8 человек",
    ]
  },
  {
    h2: "Цена и налоговый вычет для короткой смены",
    text: `Стоимость смены в лагере — ${PRICE_S4}, всё включено: проживание в санатории «Изумруд», питание 5 раз в сутки, IT-программа, ноутбуки, бассейн, медработник, итоговый хакатон. Доплат нет.\n\nЧерез налоговый вычет 13% вернёте ~${VYCHET_S4} Подробный калькулятор — на странице налогового вычета.`,
    list: [
      '<a href="/politika-vozvrata/" class="text-orange-600 underline underline-offset-2 hover:text-orange-700">Гарантия и условия возврата →</a>',
      "Документы для вычета выдаём автоматически: справка об оплате + лицензия Минобрнауки"
    ]
  },
  {
    h2: "Как записаться и что взять в лагерь",
    text: `Летний сезон ${SEASON_YEAR} завершён. Порядок записи: выбрать смену на странице цен, оставить заявку — менеджер перезвонит в течение часа.`,
    list: [
      "Средства гигиены, лекарства если есть назначения — передать медику при заезде",
    ]
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Детский лагерь на 10 дней в Подмосковье ${SEASON_YEAR} — IT-смена | АйДаКемп`}
  description={`Лагерь на ${DAYS_S4} в Подмосковье — IT-смена АйДаКемп: Python, Minecraft, AI для школьников 7–17 лет. ${PRICE_S4}, вычет ~${VYCHET_S4}. Бассейн, хакатон, трансфер от метро Солнцево.`}
  h1="Лагерь на 10 суток в Подмосковье"
  canonical="https://aidacamp.ru/lager-10-dney"
  breadcrumb="Короткая смена"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь — короткая смена — АйДаКемп"
      description="IT-лагерь в Подмосковье. Python, AI, Minecraft, Roblox для школьников 7–17 лет. Короткая смена, санаторий Изумруд, Наро-Фоминский округ."
      url="https://aidacamp.ru/lager-10-dney"
      ageMin={7}
      ageMax={17}
    />
  </Fragment>

  <LandingHero slot="hero"
    h1="Лагерь на 10 дней в Подмосковье"
    subtitle="Первый раз отпустить не так страшно: 10 суток — школьник успевает раскрыться, а вы — выдохнуть. Обычный формат для новичков в лагере. Свежие фото в Telegram."
    breadcrumb="Короткая смена"
    keywords={["Полный цикл от идеи до хакатона за одну смену", "Python, AI, Minecraft, Roblox для ребят 7–17 лет", "Бассейн, 5-разовое питание, медик 24/7 прямо в лагере, трансфер от м. Солнцево"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь в Подмосковье — хакатон в АйДаКемп"
  />

  <LandingTwoCol sections={sections} />

  <Gallery />
  <Shifts slim />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
      { q: "Есть ли у АйДаКемп такая короткая смена?", a: `Да, в нашем лагере есть смены на 10 суток (Смена 1 и Смена 4 — ${DATES_SHORT_S4} ${SEASON_YEAR}). Стоимость ${PRICE_S4}, всё включено, вычет 13% — ~${VYCHET_S4}.` },
      { q: "Подходит ли она для первого раза в лагере?", a: "Да, оптимально для первого самостоятельного отъезда: хватает и на адаптацию, и на проект с хакатоном. В лагере первый раз проходит мягко." },
      { q: "Что ребёнок успеет сделать за это время в IT-лагере?", a: "Полный цикл: от выбора трека до готового проекта и хакатона — Python, Minecraft, Roblox, 3D или AI-творчество." },
      { q: "Сколько стоит эта смена и какой налоговый вычет?", a: `${PRICE_S4}, всё включено. Налоговый вычет 13% — ~${VYCHET_S4}. Лагерь входит в реестр туроператоров, вычет оформляется официально.` },
      { q: "Чем она отличается от более длинных смен?", a: "Эта длина уже достаточна для полного цикла от идеи до хакатона. В лагере этого времени хватает с запасом." },
      { q: "Можно ли в любое время звонить в лагерь?", a: "Да, телефон разрешён в любое время без расписания — ограничений на звонки в лагерь нет. Фото — в закрытом Telegram-чате родителей." }
    ]} items={['documents:0', 'documents:1', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />

  <section class="internal-links-block" style="background: #f8f9fa; padding: 24px; border-radius: 8px; margin: 32px auto; max-width: 720px; border-left: 4px solid #ec9b44;">
    <h3 style="margin-top: 0; font-size: 18px; color: #1a1a1a;">Полезные страницы по теме</h3>
    <ul style="list-style: none; padding: 0; margin: 0;">
      <li style="margin-bottom: 8px;">
        <a href="/ceny/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Завершённые смены и цены {SEASON_YEAR}</a>
      </li>
      <li style="margin-bottom: 8px;">
        <a href="/stati/lager-na-2-nedeli/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Смена на 2 недели — чем отличается от короткой</a>
      </li>
      <li style="margin-bottom: 8px;">
        <a href="/lager-na-leto/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Длинная смена 20 суток — максимальное погружение</a>
      </li>
      <li style="margin-bottom: 8px;">
        <a href="/stati/pervyj-raz-bez-roditeley/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Первый раз без родителей — как подготовить и не переживать</a>
      </li>
      <li style="margin-bottom: 8px;">
        <a href="/stati/chto-vzyat-v-lager/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Что взять в лагерь — чек-лист по категориям</a>
      </li>
      <li style="margin-bottom: 0;">
        <a href="/nalogovyj-vychet/" style="color: var(--color-primary); text-decoration: none; font-weight: 500;">→ Налоговый вычет — как вернуть ~4 800 ₽ за короткую смену</a>
      </li>
    </ul>
  </section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
