---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Железнодорожного до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 85 км от Железнодорожного. Маршрут: МКАД (через восточный въезд, затем на юг до Калужского) → Калужское шоссе, время в пути около 1.5 часов. Организованный трансфер отправляется от м. Солнцево — добраться из Железнодорожного на метро (через Новокосино или Реутов) займёт около 45–55 минут."
  },
  {
    h2: "Почему родители из Железнодорожного выбирают АйДаКемп",
    text: "Из Железнодорожного до АйДаКемп — 1.5 часа по МКАД и Калужскому шоссе. Никаких перелётов, никакой акклиматизации. Ребёнок за смену создаёт реальный IT-проект, а родители спокойно знают, что он в безопасном месте с медработником и охраной.",
    list: [
      "~85 км от Железнодорожного, 1.5 часа без лишних пробок",
      "Трансфер от м. Солнцево — метро из Железнодорожного прямо",
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Железнодорожного",
    text: "В АйДаКемп едут дети со всего востока Подмосковья. Вот что рассказывают родители:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Вернулась с проектом на Python, рассказывала про хакатон с горящими глазами» — Светлана, Железнодорожный",
      "«Думала, 1.5 часа — это долго. Но сын едет с удовольствием. Говорит, что лагерь лучше, чем то, что он ожидал» — Ирина, Железнодорожный"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 69 600 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Железнодорожный 2026 — АйДаКемп"
  description="IT-лагерь рядом с Железнодорожным: 1.5 часа по МКАД и Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет. Санаторий Изумруд. От 48 000 ₽."
  h1="Детский лагерь рядом с Железнодорожным"
  canonical="https://aidacamp.ru/lager-jeleznodarozhnyj"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Железнодорожного до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Железнодорожного ~85 км: МКАД → Калужское шоссе, около 1.5 часов. Удобнее: метро до м. Солнцево (45–55 мин), затем трансфер АйДаКемп (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Железнодорожного до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часов. На машине: МКАД → Калужское шоссе, ~85 км. На трансфере: метро до Солнцево плюс автобус." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Железнодорожного?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Организованный трансфер от м. Солнцево (2 500 ₽). Из Железнодорожного до Солнцево удобно на метро — около 45–55 минут." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 69 600 ₽. В стоимость входит всё кроме трансфера." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Железнодорожным — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Железнодорожного. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-jeleznodarozhnyj"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Железнодорожным"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Железнодорожного по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Железнодорожного"
    keywords={["~1.5 часа от Железнодорожного по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Железнодорожным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
