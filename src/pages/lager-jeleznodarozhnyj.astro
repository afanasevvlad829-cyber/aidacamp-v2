---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { OPEN_MONTHS_ADJ } from '../data/evergreen';

const sections = [
  {
    h2: "Как доехать до АйДаКемп",
    text: "Из Железнодорожного (округ Балашиха) до лагеря АйДаКемп в санатории «Изумруд», Наро-Фоминский район — около 120 км, ~1 ч 20 мин.",
    list: [
      `Метро: ст. Новокосино → м. Солнцево (~40–45 мин) → трансфер за ${TRANSFER_PRICE_FMT}`,
      "На машине: МКАД → Киевское шоссе (M-3), ~120 км, около 1,5 часа"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Переживать о ребёнке не придётся:",
    list: [
      "1 преподаватель на 6–8 человек — личное внимание каждому",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram — родители в курсе",
      `Лицензия Минобрнауки, налоговый вычет до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Чем заняты ребята день за днём",
    text: "Летний день устроен просто: дважды занятия по IT-треку с практикующими специалистами, между ними — игры на свежем воздухе и общий обед. В конце смены — хакатон с защитой своего проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education, Roblox Studio, 3D-моделирование в Blender",
      "AI и нейросети — свой AI-помощник на ChatGPT API"
    ]
  },
  {
    h2: "Открытые смены и стоимость",
    text: `Сейчас открыты ${OPEN_MONTHS_ADJ} летние смены, места ещё есть. В стоимость путёвки входят проживание, питание и программа — отдельно только трансфер.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      `Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону`
    ]
  },
  {
    h2: "Дорога глазами тех, кто уже ездил",
    text: "Железнодорожный кажется дальним только на карте — маршрут через Новокосино семьи нашли давно:",
    list: [
      "Железнодорожный, Купавна, Никольско-Архангельский — маршрут у всех один: Новокосино → Солнцево → трансфер",
      "1,5 часа пугают до первой поездки: по факту это метро и один автобус с сопровождающим",
      "Летний заезд обычно бронируют весной — августовские смены разбирают быстрее остальных",
      "Домой ребята возвращаются с проектом на Python и рассказами про хакатон"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Летний детский лагерь рядом с Железнодорожным ${SEASON_YEAR} — АйДаКемп`}
  description={`Летний IT-лагерь для детей 7–15 лет рядом с Железнодорожным, 1,5 часа пути. Python, AI, Minecraft. Цена от ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Железнодорожным"
  canonical="https://aidacamp.ru/lager-jeleznodarozhnyj"
>
  <Fragment slot="head">
    <CourseSchema
      name="Детский IT-лагерь рядом с Железнодорожным — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Железнодорожного. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-jeleznodarozhnyj"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Железнодорожным"
    subtitle="Летняя IT-смена в Наро-Фоминском районе — метро от Новокосино до Солнцево + трансфер. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Из Железнодорожного"
    keywords={["Метро Новокосино → Солнцево → трансфер АйДаКемп", "Python, AI, Minecraft — с 7 до 15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Железнодорожным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Как добраться из Железнодорожного до лагеря АйДаКемп?", a: `Оттуда (из Балашихи) ~120 км, около 1,5 часов: МКАД → Киевское шоссе. Удобнее: метро от ст. Новокосино до м. Солнцево (~40 мин), затем трансфер АйДаКемп (${TRANSFER_PRICE_FMT}).` },
    { q: "Есть ли трансфер из Железнодорожного?", a: `Да — трансфер от м. Солнцево, ${TRANSFER_PRICE_FMT}. Город ближе к метро, чем кажется: 40–45 минут на Некрасовской линии — и вы в Солнцево.` },
    { q: "Сколько стоит путёвка?", a: `От ${PRICE_MIN} за 10-дневную смену до ${PRICE_MAX} за 13-дневную. Открыты августовские смены: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит всё кроме трансфера.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">АйДаКемп в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages title="Похожие направления рядом" pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
