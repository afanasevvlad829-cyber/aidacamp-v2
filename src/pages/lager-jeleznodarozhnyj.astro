---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Железнодорожного (Балашихи) до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 120 км от Железнодорожного, ~1 ч 20 мин. Маршрут на метро + трансфере: метро от ст. Новокосино (Некрасовская линия) до м. Солнцево → организованный трансфер АйДаКемп (2 000 ₽). На машине: МКАД → Киевское шоссе (M-3) → посёлок Атепцево."
  },
  {
    h2: "Метро от Новокосино — маршрут проще, чем кажется",
    text: "Железнодорожный (Балашиха) выглядит далеко от Юго-Запада, но метро меняет картину. От ст. Новокосино Некрасовской линии до м. Солнцево — примерно 40–45 минут без пересадок. Дальше — организованный трансфер АйДаКемп. Итого: ~1 ч 20 мин от дома до ворот лагеря.",
    list: [
      "Метро ст. Новокосино → м. Солнцево → трансфер АйДаКемп",
      "~40–45 мин на метро + автобус — без пробок и пересадок",
      "На машине: МКАД → Киевское шоссе, ~120 км, ~1.5 ч",
      "Нет акклиматизации — Подмосковье, привычный климат"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, каждый в поле зрения. Медработник дежурит круглосуточно. Родители получают фото из лагеря в Telegram-чат отряда каждый день.",
    list: [
      "1 преподаватель на 6–8 ребят — личное внимание каждому",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram — не нужно волноваться",
      `Лицензия Минобрнауки, налоговый вычет до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Школьники 7–15 лет выбирают IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены расходятся быстро. Из Железнодорожного запись часто идёт через сарафанное радио — один родитель рассказал другому, что метро до Солнцево выручает. Июнь и август ещё открыты.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX}`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Отзывы родителей из Железнодорожного",
    text: "Вот что рассказывают семьи, которые уже нашли маршрут через Новокосино:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Вернулась с проектом на Python, рассказывала про хакатон с горящими глазами» — Светлана, Железнодорожный",
      "«Думала, 1.5 часа — это долго. Но ребёнок едет с удовольствием. Говорит, что лагерь лучше, чем ожидал» — Ирина, Железнодорожный"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Железнодорожный 2026 — АйДаКемп"
  description={`IT-лагерь рядом с Железнодорожным: 1.5 часа по МКАД и Киевскому шоссе или метро от Новокосино. Python, AI, Minecraft для ребят 7–15 лет. От ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Железнодорожным"
  canonical="https://aidacamp.ru/lager-jeleznodarozhnyj"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Железнодорожного до лагеря АйДаКемп?", a: "Из Железнодорожного (Балашихи) ~120 км: МКАД → Киевское шоссе, около 1.5 часов. Удобнее: метро от ст. Новокосино до м. Солнцево (~40 мин), затем трансфер АйДаКемп (2 000 ₽)." },
    { q: "Сколько ехать из Железнодорожного до лагеря?", a: "Около 1 ч 20 мин. На машине: МКАД → Киевское шоссе, ~120 км. На метро + трансфере: ст. Новокосино → м. Солнцево (~40 мин) + автобус до лагеря." },
    { q: "Есть ли трансфер из Железнодорожного?", a: "Да. Организованный трансфер от м. Солнцево (2 000 ₽). Из Железнодорожного удобно добраться до Солнцево на метро от ст. Новокосино (Некрасовская линия) — около 40–45 минут." },
    { q: "Сколько стоит путёвка?", a: `От ${PRICE_MIN} за 7-дневную смену. 14-дневная — ${PRICE_MAX}. Август: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит всё кроме трансфера.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Железнодорожным — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Железнодорожного. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-jeleznodarozhnyj"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Железнодорожным"
    subtitle="IT-лагерь в Наро-Фоминском районе — метро от Новокосино до Солнцево + трансфер. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Железнодорожного"
    keywords={["Метро Новокосино → Солнцево → трансфер АйДаКемп", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Железнодорожным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
