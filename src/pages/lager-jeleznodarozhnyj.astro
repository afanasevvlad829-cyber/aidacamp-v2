---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { OPEN_MONTHS_ADJ } from '../data/evergreen';

const sections = [
  {
    h2: "Как доехать из Железнодорожного до АйДаКемп",
    text: "АйДаКемп стоит в санатории «Изумруд» в Наро-Фоминском районе — около 120 км от города, это ~1 ч 20 мин в пути. Удобный вариант: метро от ст. Новокосино (Некрасовская линия) до м. Солнцево (~40–45 мин), дальше — организованный трансфер (2 000 ₽). На машине: МКАД → Киевское шоссе (M-3) → посёлок Атепцево, около 1,5 часа. Акклиматизация не нужна — то же Подмосковье, привычный климат.",
    list: [
      "Метро: ст. Новокосино → м. Солнцево → трансфер",
      "~40–45 мин на метро + автобус, без пересадок",
      "На машине: МКАД → Киевское шоссе, ~120 км",
      "Подмосковье — климат тот же, привыкать не нужно"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, каждый на виду. Медработник дежурит круглосуточно. Родители получают фото каждый день в Telegram-чат отряда.",
    list: [
      "1 преподаватель на 6–8 ребят — личное внимание каждому",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram — не нужно волноваться",
      `Лицензия Минобрнауки, налоговый вычет до ${VYCHET_MAX}`
    ]
  },
  {
    h2: "Чем заняты ребята день за днём",
    text: "Детский лагерь строится вокруг простого дня: дважды — занятия по IT-треку с практикующими специалистами, а между ними — игры на свежем воздухе, новые друзья и общий обед. В конце смены — хакатон с защитой своего проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education, Roblox Studio, 3D-моделирование в Blender",
      "AI и нейросети — свой AI-помощник на ChatGPT API"
    ]
  },
  {
    h2: "Открытые смены и стоимость",
    text: `Сейчас открыты ${OPEN_MONTHS_ADJ} смены, места ещё есть. В стоимость путёвки входят проживание, питание и вся программа — отдельно только трансфер.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Что говорят мамы из Балашихи",
    text: "Вот что рассказывают семьи, которые уже нашли маршрут через Новокосино:",
    list: [
      "«Метро до Солнцево, автобус — и дочь на месте. Вернулась с проектом на Python, рассказывала про хакатон с горящими глазами» — Светлана",
      "«Думала, 1,5 часа — это долго. Но ребёнок едет с удовольствием, говорит — тут лучше, чем ожидала» — Ирина"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский лагерь Железнодорожный ${SEASON_YEAR} — АйДаКемп`}
  description={`Детский IT-лагерь Железнодорожный — 1,5 часа в пути. Python, AI и Minecraft для ребят 7–15 лет. Цена от ${PRICE_MIN}.`}
  h1="Детский IT-лагерь в Железнодорожном"
  canonical="https://aidacamp.ru/lager-jeleznodarozhnyj"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Железнодорожного до лагеря АйДаКемп?", a: "Из Железнодорожного (Балашихи) ~120 км: МКАД → Киевское шоссе, около 1.5 часов. Удобнее: метро от ст. Новокосино до м. Солнцево (~40 мин), затем трансфер АйДаКемп (2 000 ₽)." },
    { q: "Сколько ехать из Железнодорожного до лагеря?", a: "Около 1 ч 20 мин. На машине: МКАД → Киевское шоссе, ~120 км. На метро + трансфере: ст. Новокосино → м. Солнцево (~40 мин) + автобус до лагеря." },
    { q: "Есть ли трансфер из Железнодорожного?", a: "Да. Организованный трансфер от м. Солнцево (2 000 ₽). Из Железнодорожного удобно добраться до Солнцево на метро от ст. Новокосино (Некрасовская линия) — около 40–45 минут." },
    { q: "Сколько стоит путёвка?", a: `От ${PRICE_MIN} за 10-дневную смену до ${PRICE_MAX} за 13-дневную. Открыты августовские смены: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит всё кроме трансфера.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Железнодорожным — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Железнодорожного. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-jeleznodarozhnyj"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский IT-лагерь в Железнодорожном"
    subtitle="IT-лагерь в Наро-Фоминском районе — метро от Новокосино до Солнцево + трансфер. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Железнодорожного"
    keywords={["Метро Новокосино → Солнцево → трансфер АйДаКемп", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Железнодорожным — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
