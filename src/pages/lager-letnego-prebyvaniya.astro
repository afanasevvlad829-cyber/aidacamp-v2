---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { getRelatedPages } from '../data/landing-pages';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое лагерь летнего пребывания",
    text: "«Лагерь летнего пребывания» — официальный термин из российского законодательства. Так называют загородные лагеря с круглосуточным проживанием детей на период каникул. АйДаКемп — именно такой лагерь: дети живут на территории санатория «Изумруд» в Наро-Фоминском районе с первого до последнего дня смены, под постоянным присмотром педагогов и вожатых.",
    list: [
      "Круглосуточное проживание на весь период смены — 7, 10, 13 или 14 дней",
      "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД",
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973",
      "Туроператор РТО 025773 — официальная регистрация в реестре",
      "Медработник 24/7, охрана, закрытая территория"
    ]
  },
  {
    h2: "Чем АйДаКемп отличается от обычного лагеря летнего пребывания",
    text: "Большинство лагерей летнего пребывания — спортивные или художественные. АйДаКемп специализируется на IT: каждый ребёнок создаёт реальный проект (игру, бота, AI-приложение) и защищает его на хакатоне в последний день смены. Это не «кружок за забором», а полноценная образовательная программа в загородном формате.",
    list: [
      "IT-занятия дважды в день — Python, Scratch, Minecraft, Roblox, AI",
      "Хакатон в финале — каждый защищает проект перед всем отрядом",
      "Группы до 8 человек — преподаватель работает с каждым лично",
      "Без телефонов — дети общаются и учатся, а не листают ленту",
      "Бассейн, спорт, командные активности каждый день"
    ]
  },
  {
    h2: "Условия проживания в лагере летнего пребывания",
    text: "Дети живут в корпусах санатория по 2–4 человека с раздельным санузлом. Питание 5 раз в день с учётом аллергий. Закрытый бассейн с ионизированной водой (без хлора). Медработник на территории круглосуточно. Связь с родителями — ежедневные фото в Telegram-канале и звонки по расписанию.",
    list: [
      "Комнаты по 2–4 человека с санузлом — не казарменный формат",
      "5-разовое питание: завтрак, обед, полдник, ужин, вечерний перекус",
      "Закрытый бассейн с ионизированной водой — через день",
      "Медицинский работник 24/7 на территории",
      "Ежедневные фото в Telegram-канале для родителей"
    ]
  },
  {
    h2: "Документы лагеря летнего пребывания АйДаКемп",
    text: `Лицензированный лагерь летнего пребывания обязан иметь образовательную лицензию и разрешение Роспотребнадзора. У АйДаКемп всё это есть — плюс туроператорская лицензия. Оплата смены квалифицируется как образовательная услуга: родители получают налоговый вычет 13% (до ${VYCHET_MAX}).`,
    list: [
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973",
      "Туроператор РТО 025773 — реестр Ростуризма",
      "Разрешение Роспотребнадзора на каждую смену",
      
      `Налоговый вычет 13% — возврат до ${VYCHET_MAX} через nalog.ru`
    ]
  },
  {
    h2: "Программа IT-лагеря летнего пребывания по возрастам",
    text: "Программа подбирается индивидуально: по возрасту и уровню подготовки. Дети не попадают в группу «не по возрасту» — первичное тестирование определяет, куда именно идёт ребёнок.",
    list: [
      "7–10 лет: Scratch, Minecraft Education — логика, алгоритмы, анимации",
      "10–12 лет: Python, Telegram-боты, работа с данными",
      "13–15 лет: Python Advanced, ChatGPT API, AI-проекты",
      "Дополнительно: 3D-моделирование в Blender, Roblox Studio",
      "Тестирование уровня при регистрации — попадёт в правильную группу"
    ]
  },
  {
    h2: "Смены лагеря летнего пребывания 2026",
    text: "Шесть смен с конца мая по август. Для первого раза подходят короткие смены 7–8 дней: проще адаптироваться, меньше риск «не понравится». Флагман — смена 14 дней с расширенной программой и двухдневным хакатоном.",
    list: [
      `Смена 1 — 30 мая–8 июня, 10 дней, ${PRICE_S4}`,
      `Смена 2 — 10–23 июня, 14 дней, ${PRICE_MAX} (флагман)`,
      `Смена 2.1 — 10–16 июня, 7 дней, ${PRICE_MIN} (первый раз)`,
      `Смена 2.2 — 16–23 июня, 8 дней, ${PRICE_S22}`,
      `Смена 3 — 3–15 августа, 13 дней, ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Как выбрать лагерь летнего пребывания — чек-лист",
    text: "Перед бронированием проверьте три вещи: лицензия Минобрнауки (даёт право на налоговый вычет), туроператорский реестр (защита прав потребителей) и реальные отзывы на Яндекс.Картах. АйДаКемп по всем трём пунктам: лицензия ✓, РТО ✓, рейтинг 5.0 при 40+ отзывах ✓.",
    list: [
      "Лицензия Минобрнауки — обязательна для налогового вычета",
      "Туроператор в реестре РТО — защита в случае форс-мажора",
      "Реальные отзывы на Яндекс.Картах, а не только на сайте",
      "Программа с конкретным результатом: проект, хакатон, сертификат",
      "Малые группы — не более 8–10 человек на преподавателя"
    ]
  },
  {
    h2: "Форматы летнего пребывания в АйДаКемп",
    text: "Выберите длину смены под ваши планы — все форматы включают полную программу, питание и проживание.",
    list: [
      `Смена 2.1 — 7 дней, ${PRICE_MIN} (первый раз в лагере — идеальный формат)`,
      `Смена 2.2 — 8 дней, ${PRICE_S22} (чуть больше времени на проект)`,
      `Смены 1/4 — 10 дней, ${PRICE_S4} (оптимальный баланс программы и отдыха)`,
      `Смена 3 — 13 дней, ${PRICE_S3} (расширенная программа, сложные треки)`,
      `Смена 2 — 14 дней, ${PRICE_MAX} (флагман: двухдневный хакатон, максимальная программа)`,
      "Все форматы — всё включено: питание, IT, бассейн, медработник, трансфер"
    ]
  },
  {
    h2: "Что остаётся у ребёнка после смены",
    text: "Главный вопрос любого родителя: а что он привезёт домой, кроме загара? В АйДаКемп ответ конкретный.",
    list: [
      "Готовый IT-проект: Telegram-бот, игра на Python или AI-приложение — работающий код",
      "Портфолио на GitHub или в Scratch-community — можно показать учителю информатики",
      "Навыки Python / AI / 3D-моделирования — не просто «знакомство», а рабочий уровень",
      "Знакомства с ровесниками-технарями из разных школ Москвы и Подмосковья",
      "Сертификат участника АйДаКемп — для раздела «дополнительное образование»"
    ]
  },
  {
    h2: "Вожатые и команда",
    text: "За каждой сменой стоит команда, которая реально любит свою работу. Это не студенты на подработке — это люди, которые возвращаются из сезона в сезон.",
    list: [
      "1 преподаватель на 6–8 школьников — внимание к каждому, а не к толпе",
      "Конкурсный отбор вожатых: портфолио, проверка, обучение перед сменой",
      "Опытная вожатская команда — большинство работают с АйДаКемп 2+ лет",
      "Медработник на территории 24/7 — живёт в лагере весь сезон",
      "Дарья Афанасьева (основатель) — присутствует на каждой смене лично"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Лагерь летнего пребывания для детей 2026 | АйДаКемп"
  description={`Лагерь летнего пребывания АйДаКемп: IT + проживание в Подмосковье. Лицензия Минобрнауки, туроператор РТО 025773. Смены от ${PRICE_MIN}.`}
  h1="Лагерь летнего пребывания в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-letnego-prebyvaniya"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое лагерь летнего пребывания?", a: "Лагерь летнего пребывания — официальный термин российского законодательства для загородного лагеря с круглосуточным проживанием детей на период каникул. АйДаКемп — лагерь летнего пребывания в Подмосковье (66 км от МКАД) с IT-программой: Python, Scratch, Minecraft, AI. Лицензия Минобрнауки, туроператор РТО 025773." },
    { q: "Какие документы должен иметь лагерь летнего пребывания?", a: "Образовательная лицензия Минобрнауки, туроператорская регистрация (реестр РТО), разрешение Роспотребнадзора на каждую смену. У АйДаКемп: лицензия Л035-01298-77/01082973, РТО 025773, застрахована ответственность туроператора (Росгосстрах)." },
    { q: "Сколько стоит лагерь летнего пребывания в Подмосковье?", a: `АйДаКемп: от ${PRICE_MIN} за 7 дней (смена 2.1) до ${PRICE_MAX} за 14 дней (смена 2). В стоимость включены проживание, 5-разовое питание, IT-программа, бассейн, медработник. Налоговый вычет 13% — возврат до ${VYCHET_MAX}.` },
    { q: "Как выбрать лагерь летнего пребывания?", a: "Проверьте: образовательная лицензия Минобрнауки (нужна для налогового вычета), туроператорский реестр РТО (защита прав), реальные отзывы на Яндекс.Картах (не только на сайте), программа с конкретным результатом, малые группы. АйДаКемп: ★ 5.0, 40+ отзывов, лицензия + РТО." },
    { q: "Можно ли вернуть деньги за лагерь летнего пребывания?", a: `Да. Налоговый вычет 13% от стоимости образовательной части — до ${VYCHET_MAX}. Для этого нужна образовательная лицензия лагеря. АйДаКемп выдаёт договор + акт + копию лицензии автоматически после оплаты.` }
  ]} />
    <CourseSchema
      name="Лагерь летнего пребывания АйДаКемп — IT-программа с проживанием"
      description="Лагерь летнего пребывания для детей 7–15 лет с IT-программой. Python, AI, Minecraft. Санаторий Изумруд, 66 км от МКАД. Лицензия Минобрнауки. Смены"
      url="https://aidacamp.ru/lager-letnego-prebyvaniya"
      level="Beginner"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь летнего пребывания в Подмосковье 2026"
    subtitle={`Загородный лагерь с проживанием для детей 7–15 лет. IT-программа + бассейн + медработник. Лицензия Минобрнауки. 66 км от МКАД, от ${PRICE_MIN}.`}
    breadcrumb="Лагерь летнего пребывания"
    keywords={[
      "Лицензия Минобрнауки + РТО 025773 — всё официально",
      "Проживание 7–14 дней, 5-разовое питание, медработник 24/7",
      "IT-проект за смену — ребёнок уезжает с результатом"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Лагерь летнего пребывания АйДаКемп — дети на занятии программированием"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
