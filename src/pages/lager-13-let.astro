---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "13 лет — не ребёнок, ещё не взрослый: программа под этот возраст",
    text: "В 13 лет подростку уже мало «сделай по инструкции». Он хочет сам придумать — и чтобы результат был настоящим. В АйДаКемп группа 11–14 лет работает над реальными проектами: Python продвинутого уровня, нейросети, первые элементы стартап-мышления. Не урок — а работа в команде над задачей, которую сам выбрал.",
    list: [
      "Python продвинутый: классы, ООП, работа с базами данных",
      "AI-проекты: Gemini API, ChatGPT API — собственный ИИ-ассистент",
      "Хакатон как финал: командная разработка за 48 часов",
      "Первые элементы стартап-мышления: проблема → решение → питч",
      "Малые группы до 8 человек — индивидуальный темп без потери в общей динамике"
    ]
  },
  {
    h2: "Типичный проект тринадцатилетки: что он создаст за смену 2026",
    text: "Подросток 13 лет за смену в АйДаКемп делает полноценный IT-продукт — не заготовку и не учебный пример. Это может быть Telegram-бот с AI-функциями, веб-сервис с простым бэкендом или прототип мобильного приложения. На финальном хакатоне команда защищает проект перед всеми отрядами.",
    list: [
      "Telegram-бот с ChatGPT/Gemini API: отвечает умно, помнит контекст",
      "Простой веб-сервис: Python Flask + база данных + работающий деплой",
      "Прототип приложения: идея → интерфейс → рабочее MVP за 10 дней",
      "Питч проекта на хакатоне: объясняет задачу, решение и почему это работает"
    ]
  },
  {
    h2: "Почему 13 лет — поворотный момент для IT-карьеры",
    text: "В 13 лет подросток впервые начинает думать про будущее серьёзно. Именно сейчас важно дать ему опыт успеха в сложном деле — не «молодец, попробовал», а «я сам сделал рабочую штуку». Этот опыт меняет отношение к учёбе и к себе.",
    list: [
      "Первый серьёзный проект в 13 — это фундамент уверенности на годы вперёд",
      "Самостоятельность: сам выбирает тему, сам ищет решение, сам защищает",
      "Соцнавыки через командную работу: как договариваться, распределять роли",
      "Подростки в 11–14 лет способны работать над задачей по несколько часов — если интересно"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждым отрядом закреплён вожатый с опытом работы с подростками 11–14 лет. Соотношение — 1 вожатый на 8 подростков. Медработник на территории круглосуточно. Родители получают фото из Telegram-чата отряда каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый подросток в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим 24/7"
    ]
  },
  {
    h2: "Маршрут и трансфер: от м. Солнцево до Наро-Фоминского района",
    text: "Лагерь находится в Наро-Фоминском районе Подмосковья — 66 км от МКАД по Киевскому шоссе. Трансфер отправляется от станции метро Солнцево. Дорога занимает около 1,5 часов. Точное расписание трансфера и точку посадки сообщаем после бронирования.",
    list: [
      "Отправление: м. Солнцево — сбор группой, выезд по расписанию",
      "Время в дороге: ~1,5 часа по Киевскому шоссе",
      "Трансфер организован лагерем — отдельно договариваться не нужно",
      "Заезд и выезд: по расписанию смены, родители сдают и забирают лично"
    ]
  },
  {
    h2: "Смены 2026: цены, даты, как выбрать",
    text: "Для тринадцатилеток лучше всего подходят смены от 10 дней — за это время подросток успевает «раскачаться», найти тему проекта и довести его до рабочего состояния. Самый полный результат — смена 14 дней.",
    list: [
      `Смена 2.1 — ${DATES_SHORT_S21}, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — ${DATES_SHORT_S2}, 14 дней — ${PRICE_MAX} (максимальный результат)`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Июль занят полностью. В июне и августе места ещё есть"
    ]
  },
  {
    h2: "Смотрите также: программы для подростков",
    text: "Программа АйДаКемп строится по возрасту — каждый год сложнее. Что рядом с 13 летами:",
    list: [
      "<a href='/lager-12-let/'>Лагерь для 12 лет</a> — Python средний, Gemini API, Roblox/Minecraft modding",
      "<a href='/lager-14-let/'>Лагерь для подростков 14 лет</a> — Python Advanced и ChatGPT API",
      "<a href='/hakaton-dlya-shkolnikov/'>Хакатон для школьников</a> — 48 часов кода и командной работы",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Лагерь для детей 13 лет — IT в Подмосковье | АйДаКемп"
  description={`Детский лагерь для 13-летних в Подмосковье 2026. Python Advanced + AI + хакатон. Группы 11–14 лет, до 8 чел. Трансфер от м. Солнцево. От ${PRICE_MIN}.`}
  h1="Детский лагерь для 13-летних — IT, хакатон, первый стартап"
  canonical="https://aidacamp.ru/lager-13-let"
>
  <Fragment slot="head">
    
    <FAQSchema items={[
    { q: "Какая программа для подростков 13 лет в IT-лагере?", a: "Для подростков 11–14 лет в АйДаКемп — Python продвинутого уровня, AI-проекты через Gemini API и ChatGPT API, командный хакатон и основы стартап-мышления. Малые группы до 8 человек. Финал смены — защита собственного проекта." },
    { q: "Подойдёт ли лагерь подростку 13 лет без опыта программирования?", a: "Да. В первый день проводим диагностику и разбиваем на треки: начинающие стартуют с Python базы, те кто уже знает — сразу к продвинутым темам. Педагог адаптирует задачи под каждого." },
    { q: "Что конкретно сделает подросток 13 лет за смену?", a: "К концу смены — рабочий IT-проект: Telegram-бот с AI, простой веб-сервис или прототип приложения. На хакатоне команда защищает его перед всеми отрядами. Код остаётся у подростка." },
    { q: "Как добраться до лагеря из Москвы?", a: "Трансфер от м. Солнцево. Лагерь находится в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Дорога около 1,5 часов. Расписание трансфера сообщаем после бронирования." },
    { q: "Сколько стоит смена для подростка 13 лет в 2026 году?", a: `От ${PRICE_MIN} за 7-дневную смену (${DATES_SHORT_S21} 2026). Смены 10–14 дней — от ${PRICE_S4} до ${PRICE_MAX}. В стоимость входит проживание, питание, все занятия. Доступен налоговый вычет 13%.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для 13-летних — IT, хакатон, первый стартап"
    subtitle="Python Advanced + AI-проекты + хакатон. За смену — рабочий продукт и опыт командной разработки."
    breadcrumb="Лагерь для детей 13 лет"
    keywords={["Группы до 8 человек, 11–14 лет", "Python + AI + хакатон", "Трансфер от м. Солнцево"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для детей 13 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-12-let/" class="text-primary underline underline-offset-2">← Лагерь для 12 лет</a> · <a href="/lager-14-let/" class="text-primary underline underline-offset-2">Лагерь для 14 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
