---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "От игрока — к создателю игр",
    text: "Большинство IT-треков в АйДаКемп — то, что ребята уже любят: Minecraft, Roblox, игры, автоматизация. Разница в том, что здесь мы не просто играем — мы создаём. Из «хочу поиграть в Minecraft» вырастает «хочу написать свой мод». Из «обожаю Roblox» — «хочу собрать свою 3D-игру». Программирование — это новый футбол: соревновательно, командно, с понятным результатом.",
    list: [
      "Треки под интересы: Minecraft, Roblox, Python, AI — выбирает сам",
      "Из «просто играть» в «создавать игры» — смена образа мышления за 10 дней",
      "Хакатон в конце смены — каждый представляет свой проект"
    ]
  },
  {
    h2: "Реальные проекты за смену",
    text: "Каждый выбирает трек по интересу. Занятия — дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон: каждый защищает проект перед командой.",
    list: [
      "Игра в Roblox Studio — собственный уровень с персонажами и физикой на Lua",
      "Бот в Telegram на Python — присылает новости, погоду или подсказки по выбранной теме",
      "AI-помощник — обученный ассистент, который отвечает на вопросы по заданной теме",
      "Minecraft-мод — кастомные предметы, блоки или механика в любимой игре"
    ]
  },
  {
    h2: "Что делают в лагере помимо кода",
    text: "Ребята хорошо заходят на соревновательный формат — и мы это используем. Командные задания, хакатон как настоящий турнир, вечерние квесты и спортивные активности. Группы до 8 человек — никто не теряется в толпе.",
    list: [
      "Командные задачи — учатся работать вместе, распределять роли",
      "Хакатон — турнирная атмосфера, презентация проекта перед всем лагерем",
      "Вечерние квесты, спорт, бассейн — не только код",
      "Группы до 8 человек, внимание каждому"
    ]
  },
  {
    h2: "Смены 2026 — успейте занять место",
    text: `АйДаКемп работает с конца мая по август 2026. Открыты августовские смены 10–13 дней, стоимость от ${PRICE_MIN} за 10 дней. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности. Группы до 8 человек — мест мало.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (самая популярная, места есть)`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (места есть)`,
      `Смена 1 (завершена) — ${DATES_S1}, 10 дней, ${PRICE_S1}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2}`,
      `Короткие смены от 7 дней (завершены) — от ${PRICE_S21}`
    ]
  },
  {
    h2: "Отзывы пап и мам",
    text: "Родители делятся впечатлениями о том, как лагерь изменил отношение их сыновей к технологиям:",
    list: [
      "«Сын — убеждённый геймер, думал будет скучать без консоли. Вернулся и сразу сел писать бота на Python. Сам, без подсказок. Это магия» — Дмитрий, папа Артёма, 13 лет",
      "«Ожидала уговаривать поехать снова. А он сам спросил: когда следующая смена? Для меня это лучший отзыв» — Наталья, мама Миши, 11 лет",
      "«Я сам программист и был скептически настроен. Но уровень преподавания приятно удивил — реальные задачи, не игрушечные» — Андрей, папа Егора, 14 лет"
    ]
  },
  {
    h2: "Что мальчики делают в лагере — реальная программа дня",
    text: "Два IT-занятия по 90 минут — утром и вечером. Между ними: бассейн, волейбол, футбол, квест-активности. Гаджеты сданы в именной бокс — вместо них внутренняя игровая валюта лагеря (далее под рублями имеется в виду игровая валюта лагеря), которую зарабатывают за проекты и командные активности. К концу смены у каждого — работающая программа или игра.",
    list: [
      "Python или Roblox — мальчики чаще выбирают именно эти треки",
      "Командные игры: хакатон, командные квесты, соревнования",
      "Спорт: бассейн, волейбол, футбол, бадминтон — каждый день",
      "Финал: хакатон с защитой проекта, сертификат участника"
    ]
  },
  {
    h2: "Почему мальчики возвращаются в АйДаКемп",
    text: "По данным сезона 2025: 64% ребят, побывавших в АйДаКемп, возвращаются на следующую смену или следующий год. Среди причин — атмосфера без насмешек за интерес к компьютерам, настоящие друзья по интересам, ощущение результата.",
    list: [
      "Среда единомышленников: все любят технологии — никто не «ботан»",
      "Реальный проект, который можно показать друзьям дома",
      "Соревновательность без токсичности — внутренняя экономика лагеря балансирует",
      "Вожатые-мужчины в части отрядов — для подростков 10–15 лет"
    ]
  },
  {
    h2: "Лагерь для мальчиков 2026 — частые вопросы",
    text: "Отвечаем на то, что спрашивают чаще всего перед записью мальчика.",
    list: [
      "Возраст: 7–15 лет, группы строго по возрасту — 7–9, 10–12, 13–15 лет",
      "Minecraft и Roblox доступны с первого дня — не нужно ждать «продвинутой» группы",
      "Гаджеты: смартфон сдаётся при заезде, экранное время зарабатывается активностью",
      "Первый лагерь без родителей: рекомендуем смену 4 (10 дней) — адаптация легче",
      "Трансфер: автобус от м. Солнцево в день заезда, 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Детские лагеря для мальчиков Подмосковья 2026 — на что обращать внимание",
    text: "Мальчики в 7–15 лет особенно чувствительны к скуке — если программа не захватывает, начинаются просьбы забрать домой. Наш опыт: геймерская аудитория вовлекается через создание, а не потребление. Конкретно: вместо «поиграй в Minecraft» — «напиши мод для Minecraft». Вместо «погляди как работает AI» — «подключи ChatGPT API к своему боту». Интерес держится 14 дней — это статистика по нашим сменам.",
    list: [
      "Вовлечение через создание: не игра, а программирование игры — разница огромная",
      "Хакатон в финале — мальчики соревновательны, защита проекта на публике работает",
      "Без телефонов в рабочее время — и не скучают: некогда",
      "Медработник 24/7, закрытая территория, охрана — родители спят спокойно",
      "Лицензия Минобрнауки — программа официально признана образовательной",
      `Налоговый вычет 13% — от ${VYCHET_S4} до ${VYCHET_MAX} возврат из бюджета`
    ]
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний лагерь для мальчиков 7–15 лет 2026 в Подмосковье — АйДаКемп"
  description={`Детский IT-лагерь для мальчиков 7–15 лет: Python, Minecraft, Roblox, AI и бассейн. Из геймера — в создателя игр: реальный проект за смену. Подмосковье, 10 и 13 дней, от ${PRICE_MIN}.`}
  h1="Летний лагерь для мальчиков 7–15 лет в Подмосковье"
  canonical="https://aidacamp.ru/lager-dlya-malchikov"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Подходит ли IT-лагерь для мальчиков-геймеров?", a: "Идеально. Minecraft, Roblox, Python — то, что мальчики уже любят. Разница в том, что здесь они не просто играют, а создают: пишут моды, собирают игры, делают ботов. Интерес из пассивного становится активным." },
    { q: "С какого возраста мальчики едут в IT-лагерь?", a: "С 7 лет. Принимаем мальчиков 7–15 лет. Группы по возрасту и уровню: 7–9 лет (начинающие), 10–12 лет (средний), 13–15 лет (продвинутые). Опыт не нужен." },
    { q: "Чем отличается лагерь для мальчиков от обычного?", a: "Программа учитывает интересы: Minecraft, Roblox, Python, AI. Соревновательная атмосфера хакатона, командные задания, спортивные активности. Мальчики погружаются быстро — потому что это про то, что им уже интересно." },
    { q: "Что происходит в лагере помимо IT-занятий?", a: "Бассейн, спортивные площадки, вечерние квесты и игры. Занятия IT — дважды в день по 90 минут. Остальное время — активности, общение, командные события." },
    { q: "Какой летний лагерь выбрать для мальчика в 2026 году?", a: `АйДаКемп — IT-лагерь для мальчиков 7–15 лет в Подмосковье. Minecraft, Roblox, Python, AI. Мальчики создают игры и ботов — не просто играют. Смены с 30 мая по 26 августа 2026, от ${PRICE_MIN}. Лицензия Минобрнауки, налоговый вычет 13%.` },
    { q: "С какого возраста принимают мальчиков и как формируются группы?", a: "Возраст 7–15 лет, группы строго по возрасту: 7–9, 10–12, 13–15 лет." },
    { q: "Нужно ли ждать «продвинутую» группу для Minecraft и Roblox?", a: "Нет, Minecraft и Roblox доступны с первого дня смены." },
    { q: "Как быть с гаджетами мальчика в лагере?", a: "Смартфон сдаётся при заезде, экранное время зарабатывается активностью." },
    { q: "Какую смену выбрать для мальчика, который первый раз едет без родителей?", a: "Рекомендуем смену 4 (10 дней) — адаптация проходит легче, чем на длинной смене." },
    { q: "Есть ли трансфер до лагеря для мальчиков из Москвы?", a: "Да, автобус от метро Солнцево в день заезда, 2 000 ₽ в одну сторону." },
  ]} />
    <CourseSchema
      name="IT-лагерь для мальчиков — АйДаКемп"
      description="IT-лагерь для мальчиков в Подмосковье: Python, Minecraft, Roblox, AI. Из геймера в создателя игр."
      url="https://aidacamp.ru/lager-dlya-malchikov"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для мальчиков 7–15 лет"
    subtitle={`IT-лагерь в Подмосковье — Minecraft, Roblox, Python, AI. Мальчики 7–15 лет — из «я играю» в «я создаю игры». От ${PRICE_MIN}.`}
    breadcrumb="Лагерь для мальчиков"
    keywords={["Minecraft, Roblox, Python, AI-проекты — по выбору", "Хакатон: каждый защищает свою игру или бота", "Команды, квесты, бассейн — не только код"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний лагерь для мальчиков — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
