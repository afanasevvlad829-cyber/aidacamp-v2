---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Почему IT-лагерь подходит мальчикам",
    text: "Большинство IT-треков в АйДаКемп — то, что мальчики уже любят: Minecraft, Roblox, игры, автоматизация. Разница в том, что здесь мы не просто играем — мы создаём. Из «хочу поиграть в Minecraft» вырастает «хочу написать свой мод». Из «обожаю Roblox» — «хочу собрать свою 3D-игру». Программирование — это новый футбол: соревновательно, командно, с понятным результатом.",
    list: [
      "Треки под интересы: Minecraft, Roblox, Python, AI — выбирает сам",
      "Из «просто играть» в «создавать игры» — смена образа мышления за 10 дней",
      "Хакатон в конце смены — каждый представляет свой проект"
    ]
  },
  {
    h2: "Что делают мальчики в IT-лагере",
    text: "Каждый ребёнок выбирает трек по интересу. Занятия — дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон: каждый защищает проект перед командой.",
    list: [
      "Python — боты, автоматизация, скрипты, работа с данными",
      "Minecraft — написание модов, редстоун-механика, кастомные механики",
      "Roblox — создание 3D-игр на Lua в Roblox Studio",
      "AI — генерация, обучение моделей, практические AI-проекты"
    ]
  },
  {
    h2: "Социальная среда: команды и соревнования",
    text: "Мальчики хорошо заходят на соревновательный формат — и мы это используем. Командные задания, хакатон как настоящий турнир, вечерние квесты и спортивные активности. Группы до 8 человек — никто не теряется в толпе.",
    list: [
      "Командные задачи — учатся работать вместе, распределять роли",
      "Хакатон — турнирная атмосфера, презентация проекта перед всем лагерем",
      "Вечерние квесты, спорт, бассейн — не только код",
      "Группы до 8 человек, внимание каждому"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "АйДаКемп работает с конца мая по август 2026. Смены 7–14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Отзывы пап и мам про мальчишеские смены",
    text: "Родители делятся впечатлениями о том, как лагерь изменил отношение их сыновей к технологиям:",
    list: [
      "«Сын — убеждённый геймер, думал будет скучать без консоли. Вернулся и сразу сел писать бота на Python. Сам, без подсказок. Это магия» — Дмитрий, папа Артёма, 13 лет",
      "«Ожидала уговаривать поехать снова. А он сам спросил: когда следующая смена? Для меня это лучший отзыв» — Наталья, мама Миши, 11 лет",
      "«Я сам программист и был скептически настроен. Но уровень преподавания приятно удивил — реальные задачи, не игрушечные» — Андрей, папа Егора, 14 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний лагерь для мальчиков 2026 — IT-лагерь АйДаКемп"
  description="Детский IT-лагерь для мальчиков: Python, Minecraft, Roblox, AI. Из геймера — в создателя игр. Подмосковье, 7–14 дней, от 48 000 ₽."
  h1="Летний лагерь для мальчиков"
  canonical="https://aidacamp.ru/lager-dlya-malchikov"
>
  <CourseSchema slot="head"
    name="IT-лагерь для мальчиков — АйДаКемп"
    description="IT-лагерь для мальчиков в Подмосковье: Python, Minecraft, Roblox, AI. Из геймера в создателя игр."
    url="https://aidacamp.ru/lager-dlya-malchikov"
    ageMin={7}
    ageMax={15}
  />
  <LandingHero slot="hero"
    h1="Летний лагерь для мальчиков"
    subtitle="IT-лагерь в Подмосковье — Minecraft, Roblox, Python, AI. Из «я играю» в «я создаю игры». Для мальчиков 7–15 лет."
    breadcrumb="Лагерь для мальчиков"
    keywords={["Minecraft, Roblox, Python, AI-проекты — по выбору", "Хакатон: каждый защищает свою игру или бота", "Команды, квесты, бассейн — не только код"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Летний лагерь для мальчиков — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
