---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import FAQSchema from '../components/FAQSchema.astro';
---

<LandingLayout
  title="Основатели АйДаКемп — Владимир и Дарья Афанасьевы"
  description="Основатели IT-лагеря АйДаКемп — Владимир и Дарья Афанасьевы. Сделали лагерь для своих детей и детей друзей. История, опыт, команда."
  h1="Основатели АйДаКемп"
  canonical="https://aidacamp.ru/founders"
  heroImage="/images/hero/lager-v-podmoskove.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Основатели АйДаКемп",
      "description": "Владимир и Дарья Афанасьевы — основатели IT-лагеря АйДаКемп. Сделали лагерь для своих детей.",
      "url": "https://aidacamp.ru/founders",
      "mainEntity": [
        {
          "@type": "Person",
          "name": "Владимир Афанасьев",
          "jobTitle": "Серийный предприниматель, со-основатель АйДаКемп",
          "url": "https://vlad-a.ru"
        },
        {
          "@type": "Person",
          "name": "Дарья Афанасьева",
          "jobTitle": "Основатель и руководитель АйДаКемп",
          "image": "https://aidacamp.ru/images/team/team-daria-main-01.avif"
        }
      ]
    })} />
    <FAQSchema items={[
    { q: "Кто основал АйДаКемп?", a: "АйДаКемп основали Владимир и Дарья Афанасьевы. Владимир — серийный предприниматель и основатель школы программирования #АйДаКодить. Дарья возглавила лагерь и руководит им ежедневно." },
    { q: "Почему они открыли лагерь?", a: "Сделали для своих детей и детей друзей — с максимальным вниманием и так, чтобы всем было интересно. Дочь уже ездит в АйДаКемп." },
    { q: "Как связаться с основателями?", a: "Владимир: vlad-a.ru. По вопросам лагеря — через сайт aidacamp.ru или телефон +7 (495) 128-44-29." }
  ]} />
  </Fragment>

  <!-- INTRO -->
  <section class="relative overflow-hidden text-white pt-24 pb-16 px-4" style="background-color:#0d1a2b;">
    <!-- animated orbs -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="hero-orb-1" style="position:absolute;width:640px;height:640px;left:-10%;top:-30%;border-radius:50%;background:radial-gradient(circle,rgba(249,115,22,0.28) 0%,transparent 70%);"></div>
      <div class="hero-orb-2" style="position:absolute;width:500px;height:500px;right:-8%;top:10%;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,0.18) 0%,transparent 70%);"></div>
      <div class="hero-orb-1" style="position:absolute;width:360px;height:360px;left:30%;bottom:-20%;border-radius:50%;background:radial-gradient(circle,rgba(249,115,22,0.15) 0%,transparent 70%);animation-duration:15s;animation-direction:alternate-reverse;"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-orange-300">
        <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
        Основатели с 2019 года
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-5">Основатели #АйДаКемп</h1>
      <p class="text-xl text-white/75 max-w-2xl mx-auto leading-relaxed">
        Мы сделали #АйДаКемп для своих детей и детей наших друзей.<br class="hidden md:block" />
        С максимальным вниманием — и так, чтобы всем было в кайф.
      </p>
    </div>
  </section>

  <!-- FOUNDERS -->
  <section class="py-16 px-4 bg-white">
    <div class="mx-auto max-w-5xl">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Vladimir -->
        <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100">
          <div class="mb-6 flex flex-col items-center text-center">
            <img
              src="/images/team/team-vlad-main-01.avif"
              alt="Владимир Афанасьев — основатель АйДаКемп"
              width="128"
              height="128"
              loading="eager"
              decoding="async"
              class="w-32 h-32 rounded-full object-cover object-top shadow-md mb-4"
            />
            <h2 class="text-xl font-bold text-slate-900">Владимир Афанасьев</h2>
            <p class="text-sm text-orange-600 font-medium mt-1">Серийный предприниматель, бизнес-трекер</p>
          </div>
          <div class="space-y-3 text-base text-slate-600 leading-relaxed">
            <p>
              Основатель школы программирования для детей <strong>#АйДаКодить</strong>
              (<a href="https://codims.ru" class="text-orange-600 hover:underline" target="_blank" rel="noopener">codims.ru</a>)
              и системного интегратора ICE Partners
              (<a href="https://icepartners.ru" class="text-orange-600 hover:underline" target="_blank" rel="noopener">icepartners.ru</a>).
            </p>
            <p>
              Эксперт ФРИИ и трекер MTS Startup Hub. Консультант по развитию бизнеса, управлению изменениями и анализу бизнес-процессов. Среди клиентов — СБЕР, ВТБ, Ростелеком, Х5.
            </p>
            <p class="text-slate-500 text-sm">
              Частный пилот и IRONMAN.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-3">
            <a
              href="https://vlad-a.ru"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-orange-600 transition-colors"
            >
              <i class="bi bi-globe2 text-base" aria-hidden="true"></i>
              vlad-a.ru
            </a>
          </div>
        </div>

        <!-- Darya -->
        <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100">
          <div class="mb-6 flex flex-col items-center text-center">
            <img
              src="/images/team/team-daria-founders-01.avif"
              alt="Дарья Афанасьева — основатель IT-лагеря АйДаКемп"
              width="128"
              height="128"
              loading="eager"
              decoding="async"
              class="w-32 h-32 rounded-full object-cover object-top shadow-md mb-4"
            />
            <h2 class="text-xl font-bold text-slate-900">Дарья Афанасьева</h2>
            <p class="text-sm text-orange-600 font-medium mt-1">Руководитель и вдохновитель АйДаКемп</p>
          </div>
          <div class="space-y-3 text-base text-slate-600 leading-relaxed">
            <p>
              15 лет проработала в корпоративных финансах на топовых позициях в добывающих компаниях.
            </p>
            <p>
              В 2022 году оставила корпоративную карьеру и возглавила школу #АйДаКодить. Самый активный создатель ИТ-лагеря #АйДаКемп — строит его таким, каким выбрала бы сама для своей дочери.
            </p>
            <p>
              Дочь уже ездит в лагерь — и сама просит забронировать следующий сезон.
            </p>
          </div>
          <div class="mt-6">
            <div class="flex items-center gap-2 text-sm text-slate-500">
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <span class="ml-1">Рейтинг 5.0 на Яндекс.Картах</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Stats -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { num: '2019', label: 'Год основания' },
          { num: '1200+', label: 'Выпускников' },
          { num: '60%', label: 'Возвращаются снова' },
          { num: '5.0', label: 'На Яндекс.Картах' },
        ].map(s => (
          <div class="text-center p-5 bg-slate-50 rounded-2xl border border-slate-100">
            <div class="text-2xl font-bold text-slate-900">{s.num}</div>
            <div class="text-sm text-slate-500 mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="py-14 px-4 bg-slate-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Команда лагеря</h2>
      <p class="text-slate-500 mb-8">Небольшой коллектив, которому можно доверять — знаешь каждого по имени.</p>
      <div class="space-y-4">
        {[
          {
            name: 'Варвара Мухортова',
            role: 'Руководитель смены',
            photo: '/images/team/team-varvara-main-01.avif',
            detail: 'Главный человек смены: выстраивает диалог с родителями и администрацией, держит ритм лагеря и следит за тем, чтобы каждый день был насыщенным и спокойным.',
          },
          {
            name: 'Никита Брагин',
            role: 'Ведущий преподаватель — Python, Minecraft, Scratch',
            photo: '/images/team/team-nikita-main-01.avif',
            detail: 'Соавтор учебника по разработке игр (тираж 2 000 экз.). Специализируется на геймдеве, помогает ребятам создавать собственные игровые миры.',
          },
          {
            name: 'Александр Ташкин',
            role: 'Ведущий преподаватель — Python, Minecraft, Scratch',
            photo: '/images/team/team-alex-main-01.avif',
            detail: 'Соавтор учебника по разработке игр. Умеет зажигать интерес к программированию через практику и командные проекты.',
          },
          {
            name: 'Омар Алхамви',
            role: 'Преподаватель Python и нейросетей',
            photo: '/images/team/team-omar-main-01.avif',
            detail: 'Работает со старшими группами, часть занятий ведёт на английском. Показывает как использовать AI в реальных задачах.',
          },
        ].map(m => (
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-slate-100 shadow-sm">
            <img
              src={m.photo}
              alt={m.name}
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
              class="w-14 h-14 rounded-xl object-cover object-top shrink-0"
            />
            <div>
              <div class="font-semibold text-slate-900">{m.name}</div>
              <div class="text-sm text-orange-600 font-medium mb-1">{m.role}</div>
              <p class="text-sm text-slate-500 leading-relaxed">{m.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOCUMENTS -->
  <section class="py-14 px-4 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Документы и лицензии</h2>
      <p class="text-slate-500 mb-7 text-[16px]">
        Лагерь оформлен как образовательная организация — это лицензия Минобрнауки, <a href="/nalogovyj-vychet/" class="text-orange-600 hover:underline">налоговый вычет 13%</a> и прозрачный договор.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { icon: 'bi-file-earmark-check-fill', text: 'Лицензия Минобрнауки: Л035-01298-77/01082973' },
          { icon: 'bi-globe2', text: 'Туроператор РТО 025773 — реестр Ростуризма' },
          { icon: 'bi-shield-fill-check', text: 'Страховка ВСК — включена в стоимость смены' },
          { icon: 'bi-building', text: 'Разрешение Роспотребнадзора на работу ДОЛ' },
          { icon: 'bi-receipt', text: 'Договор оферты, чек, справка для вычета' },
          { icon: 'bi-camera-video-fill', text: 'Видеонаблюдение и охрана 24/7' },
        ].map(item => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 text-base text-slate-700">
            <i class={`${item.icon} text-green-600 text-[16px] shrink-0`} aria-hidden="true"></i>
            {item.text}
          </div>
        ))}
      </div>
    </div>
  </section>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages('/founders')} />
</LandingLayout>
