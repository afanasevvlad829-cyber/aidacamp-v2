---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
---

<LandingLayout
  title="Основатель АйДаКемп — Дарья Афанасьева. Как и зачем появился лагерь"
  description="Дарья Афанасьева — основатель IT-лагеря АйДаКемп. Мама подростка, которая открыла лагерь потому что не могла найти достойного места для дочери. История, команда, цифры."
  h1="Основатель АйДаКемп"
  canonical="https://aidacamp.ru/founders"
  heroImage="/images/hero/lager-v-podmoskove.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Дарья Афанасьева",
      "jobTitle": "Основатель АйДаКемп",
      "description": "Предприниматель в сфере детского IT-образования. Основала IT-лагерь АйДаКемп в 2019 году.",
      "url": "https://aidacamp.ru/founders",
      "image": "https://aidacamp.ru/images/team/team-daria-main-01.avif",
      "worksFor": {
        "@type": "Organization",
        "name": "АйДаКемп",
        "url": "https://aidacamp.ru"
      },
      "knowsAbout": ["детский IT-лагерь", "программирование для детей", "детское образование"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Кто основал АйДаКемп?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "АйДаКемп основала Дарья Афанасьева в 2019 году. Она мама дочери-подростка — открыла лагерь потому что не могла найти место, которое устроило бы её саму."
          }
        },
        {
          "@type": "Question",
          "name": "Почему Дарья открыла лагерь?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дарья искала лагерь для дочери и везде что-то не подходило: или скучно, или страшно отпускать, или программа была формальной. Решила сделать такой, какой хотела бы сама — с реальным проектом на выходе, живой атмосферой и людьми, которым можно доверять."
          }
        },
        {
          "@type": "Question",
          "name": "Что особенного в подходе основателя?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дарья сама отправляет дочь в АйДаКемп каждое лето. Это не бизнес на детях — это место, которому она доверяет собственного ребёнка. Именно поэтому стандарты такие, какие есть: медработник 24/7, закрытая охраняемая территория, отбор вожатых, рейтинг 5.0 на Яндексе."
          }
        }
      ]
    })} />
  </Fragment>

  <!-- HERO section -->
  <section class="bg-dark-navy text-white pt-24 pb-16 px-4">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col md:flex-row gap-10 items-start md:items-center">
        <div class="shrink-0">
          <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-2xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
            <img
              src="/images/team/team-daria-main-01.avif"
              alt="Дарья Афанасьева — основатель IT-лагеря АйДаКемп"
              width="256"
              height="256"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>
        <div>
          <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-orange-300">
            <i class="bi bi-patch-check-fill text-[12px]" aria-hidden="true"></i>
            Основатель с 2019 года
          </div>
          <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-3">
            Дарья Афанасьева
          </h1>
          <p class="text-lg text-white/75 mb-4 max-w-xl">
            Мама дочери-подростка. Открыла АйДаКемп потому что не нашла лагерь, который устроил бы её саму — и сделала такой, какой выбрала бы сейчас.
          </p>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-2 text-sm text-white/60">
              <i class="bi bi-calendar3 text-[14px] text-orange-400" aria-hidden="true"></i>
              6 лет в деле
            </div>
            <div class="flex items-center gap-2 text-sm text-white/60">
              <i class="bi bi-people-fill text-[14px] text-orange-400" aria-hidden="true"></i>
              1200+ выпускников
            </div>
            <div class="flex items-center gap-2 text-sm text-white/60">
              <i class="bi bi-star-fill text-[14px] text-orange-400" aria-hidden="true"></i>
              5.0 на Яндексе
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN STORY -->
  <section class="py-14 px-4 bg-white">
    <div class="mx-auto max-w-3xl">

      <h2 class="text-2xl font-bold text-slate-900 mb-6">Как появился АйДаКемп</h2>
      <div class="prose prose-slate max-w-none space-y-5 text-[17px] leading-relaxed text-slate-700">
        <p>
          В 2019 году Дарья стала искать летний лагерь для дочери. Обходила несколько вариантов — везде одно и то же: либо формальная программа без реального результата, либо тревога за безопасность, либо атмосфера «вы нам заплатили, мы поместили ребёнка».
        </p>
        <p>
          Дарья решила не ждать, пока кто-то сделает правильно. Открыла АйДаКемп сама.
        </p>
        <p>
          Основной принцип с первого дня: лагерь должен быть таким, чтобы Дарья без колебаний отпустила туда собственную дочь. Она так и делает — каждое лето.
        </p>
        <blockquote class="border-l-4 border-orange-400 pl-5 py-1 text-slate-600 not-italic bg-orange-50 rounded-r-lg">
          «Я строю лагерь таким, каким хотела бы видеть место для своей дочери. Это единственный стандарт, которому я доверяю.»
          <footer class="mt-2 text-sm font-semibold text-slate-500">— Дарья Афанасьева</footer>
        </blockquote>
        <p>
          За шесть лет через лагерь прошло больше 1200 ребят. Шестьдесят процентов из них возвращаются снова — не потому что родители настаивают, а потому что сами просят забронировать.
        </p>
      </div>

      <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-6">Что стоит за цифрами</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { icon: 'bi-award-fill', num: '2019', label: 'Год основания — 6 лет непрерывно' },
          { icon: 'bi-people-fill', num: '1200+', label: 'Выпускников за всё время' },
          { icon: 'bi-arrow-repeat', num: '60%', label: 'Возвращаются в следующий сезон' },
          { icon: 'bi-star-fill', num: '5.0', label: 'Рейтинг на Яндекс.Картах (40+ отзывов)' },
          { icon: 'bi-shield-check', num: '8', label: 'Детей максимум в группе' },
          { icon: 'bi-geo-alt-fill', num: '66 км', label: 'От МКАД по Киевскому шоссе' },
        ].map(item => (
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center shrink-0">
              <i class={`${item.icon} text-orange-600 text-[18px]`} aria-hidden="true"></i>
            </div>
            <div>
              <div class="text-2xl font-bold text-slate-900">{item.num}</div>
              <div class="text-sm text-slate-500 leading-snug">{item.label}</div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-6">Команда</h2>
      <p class="text-slate-600 mb-6 text-[17px]">
        АйДаКемп — небольшая команда, которую знаешь по именам. Не поток, не франшиза, не «педагоги под ключ».
      </p>
      <div class="space-y-4">
        {[
          {
            name: 'Дарья Афанасьева',
            role: 'Основатель и руководитель',
            photo: '/images/team/team-daria-main-01.avif',
            detail: 'Предприниматель, мама дочери-подростка. Лично участвует в каждом сезоне — от найма вожатых до обратной связи с родителями.',
          },
          {
            name: 'Варвара Мухортова',
            role: 'Руководитель смены',
            photo: '/images/team/team-varvara-main-01.avif',
            detail: 'Главный человек смены. Выстраивает диалог с родителями, держит ритм лагеря, следит за атмосферой.',
          },
          {
            name: 'Никита Брагин',
            role: 'Ведущий преподаватель',
            photo: '/images/team/team-nikita-main-01.avif',
            detail: 'Практикующий IT-специалист, соавтор учебника по Python для детей (тираж 2 000 экз.). Ведёт Python, Minecraft, Scratch.',
          },
          {
            name: 'Александр Ташкин',
            role: 'Ведущий преподаватель',
            photo: '/images/team/team-alex-main-01.avif',
            detail: 'Соавтор учебника по разработке игр. Умеет зажигать интерес к коду через практику и командные проекты.',
          },
          {
            name: 'Омар Алхамви',
            role: 'Преподаватель Python и AI',
            photo: '/images/team/team-omar-main-01.avif',
            detail: 'Работает со старшими группами, часть занятий ведёт на английском. Показывает как использовать нейросети в реальных задачах.',
          },
        ].map(m => (
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-slate-100 shadow-sm">
            <img
              src={m.photo}
              alt={m.name}
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              class="w-14 h-14 rounded-xl object-cover object-top shrink-0"
            />
            <div>
              <div class="font-semibold text-slate-900">{m.name}</div>
              <div class="text-sm text-orange-600 font-medium mb-1">{m.role}</div>
              <p class="text-sm text-slate-500 leading-relaxed">{m.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-6">Лицензии и документы</h2>
      <p class="text-slate-600 mb-5 text-[17px]">
        Лагерь оформлен как образовательная организация. Это значит лицензию Минобрнауки, налоговый вычет 13% и прозрачный договор.
      </p>
      <div class="space-y-3">
        {[
          { icon: 'bi-file-earmark-check-fill', text: 'Лицензия Минобрнауки: Л035-01298-77/01082973' },
          { icon: 'bi-globe2', text: 'Туроператор РТО 025773 — реестр Ростуризма' },
          { icon: 'bi-shield-fill-check', text: 'Страховка ВСК — включена в стоимость каждой смены' },
          { icon: 'bi-building', text: 'Разрешение Роспотребнадзора на работу ДОЛ' },
          { icon: 'bi-receipt', text: 'Договор оферты, чек, справка для налогового вычета' },
        ].map(item => (
          <div class="flex items-center gap-3 text-slate-700 text-[15px]">
            <i class={`${item.icon} text-green-600 text-[16px] shrink-0`} aria-hidden="true"></i>
            {item.text}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS QUOTES -->
  <section class="py-14 px-4 bg-slate-50">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Что говорят родители</h2>
      <div class="space-y-4">
        {[
          { text: 'Дочка вернулась совсем другой — спокойнее с телефоном, сама каждый день садится программировать.', source: 'Яндекс.Карты' },
          { text: 'Единственный лагерь куда ребёнок сам просит вернуться — обычно мы уговариваем.', source: 'Яндекс.Карты' },
          { text: 'Боялась отпускать первый раз. Получала фото каждый день. По глазам видно — ей там хорошо.', source: 'Telegram-отзыв' },
          { text: 'Сын приехал и сразу показал бота которого написал. Не ожидала что за 10 дней можно такому научить.', source: 'Яндекс.Карты' },
        ].map(r => (
          <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm">
            <p class="text-slate-700 text-[16px] leading-relaxed mb-3">«{r.text}»</p>
            <div class="flex items-center gap-2 text-sm text-slate-400">
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <i class="bi bi-star-fill text-yellow-400 text-[12px]" aria-hidden="true"></i>
              <span class="ml-1">{r.source}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href="/otzyvy" class="inline-flex items-center gap-2 text-orange-600 font-semibold hover:text-orange-700 transition-colors">
          Все отзывы родителей
          <i class="bi bi-arrow-right text-[14px]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages('/founders')} />
</LandingLayout>
