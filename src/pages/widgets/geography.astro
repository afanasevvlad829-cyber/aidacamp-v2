---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import StudentGeography from '../../components/StudentGeography.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="География — AIDACAMP"
  description="Откуда приезжают участники AIDACAMP: Москва, Подмосковье и другие регионы России."
  noindex
  preloadFonts={false}
  heroPreloadMobile="/optimized-media/hero-mobile-optimized-414.avif"
  heroPreloadMobileSrcset="/optimized-media/hero-mobile-optimized-390.avif 390w, /optimized-media/hero-mobile-optimized-414.avif 414w, /optimized-media/hero-mobile-optimized-600.avif 600w, /optimized-media/hero-mobile-optimized-744.avif 744w, /optimized-media/hero-mobile-optimized-828.avif 828w"
  heroPreloadDesktop="/images/hero-desktop-1440.avif"
>
  <Header />
  <main id="main-content" class="pb-20 md:pb-0">
    <Hero />
    <StudentGeography />
  </main>
  <Footer />
</Base>
