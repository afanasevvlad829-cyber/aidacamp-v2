---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import {
  PHONE_MAIN, PHONE_MAIN_HREF, PHONE_MOBILE, PHONE_MOBILE_HREF,
  EMAIL, EMAIL_HREF, WHATSAPP_URL, TELEGRAM_URL,
  YANDEX_MAPS_URL, YANDEX_MAPS_ROUTE_URL, VK_URL, INSTAGRAM_URL,
} from '../data/contacts';

const relatedPages = getRelatedPages('/kontakty');
---

<Base
  title="Контакты и схема проезда — АйДаКемп"
  description="Как добраться до детского лагеря АйДаКемп: адрес, карта, маршрут от Москвы. Телефоны, WhatsApp, Telegram, соцсети."
>
  <Header />
  <main>
    <section class="mx-auto max-w-[900px] px-4 pt-10 pb-16 md:pt-14">
      <nav class="text-base text-slate-400 mb-4">
        <a href="/" class="hover:text-orange-600 transition-colors">Главная</a>
        <span class="mx-2">&rarr;</span>
        <span class="text-slate-600">Контакты и проезд</span>
      </nav>

      <h1 class="text-[28px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">Контакты и схема проезда</h1>
      <p class="mt-2 text-[16px] leading-[1.6] text-slate-500 max-w-[560px]">
        АйДаКемп находится в 66 км от МКАД, Наро-Фоминский городской округ, территория «Санаторий Изумруд».
      </p>

      <div class="mt-6 overflow-hidden rounded-[18px] border border-slate-200">
        <iframe
          src="https://yandex.ru/map-widget/v1/?ll=37.160000%2C55.500000&z=8&pt=36.724185,55.265643,pm2rdm"
          width="100%"
          height="360"
          class="block w-full"
          frameborder="0"
          loading="lazy"
          title="Расположение АйДаКемп на карте"
        ></iframe>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a href={YANDEX_MAPS_ROUTE_URL} target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-orange-400 px-5 py-2.5 text-base font-semibold text-white transition-colors">
          <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
          Построить маршрут
        </a>
        <a href={YANDEX_MAPS_URL} target="_blank" rel="noopener" class="text-base text-primary hover:underline">
          Открыть в Яндекс.Картах
        </a>
      </div>

      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="text-[18px] font-semibold text-slate-900 mb-3">Как добраться</h2>
          <ul class="space-y-2 text-base leading-[1.6] text-slate-600">
            <li><strong class="text-slate-900">На машине:</strong> по Киевскому шоссе, 66 км от МКАД — около часа от центра Москвы.</li>
            <li><strong class="text-slate-900">Из Одинцово:</strong> около 40 минут.</li>
            <li><strong class="text-slate-900">Из Химок и Серпухова:</strong> около часа.</li>
            <li><strong class="text-slate-900">Трансфер:</strong> организуем от метро в дни заезда/отъезда — уточните у менеджера.</li>
          </ul>
        </div>

        <div>
          <h2 class="text-[18px] font-semibold text-slate-900 mb-3">Телефоны и почта</h2>
          <div class="space-y-2">
            <a href={PHONE_MOBILE_HREF} class="flex items-center gap-2 text-base font-medium text-slate-700 hover:text-orange-500 transition-colors">
              <i class="bi bi-phone text-slate-400"></i>{PHONE_MOBILE}
            </a>
            <a href={PHONE_MAIN_HREF} class="flex items-center gap-2 text-base font-medium text-slate-700 hover:text-orange-500 transition-colors">
              <i class="bi bi-telephone text-slate-400"></i>{PHONE_MAIN}
            </a>
            <a href={EMAIL_HREF} class="flex items-center gap-2 text-base text-slate-500 hover:text-orange-500 transition-colors">
              <i class="bi bi-envelope text-slate-400"></i>{EMAIL}
            </a>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-[18px] font-semibold text-slate-900 mb-3">Мессенджеры и соцсети</h2>
        <div class="flex flex-wrap gap-2">
          <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-4 py-2 text-base font-medium text-slate-700 hover:bg-orange-50 hover:text-orange-700 transition-colors">
            <i class="bi bi-telegram"></i>Telegram
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-4 py-2 text-base font-medium text-slate-700 hover:bg-orange-50 hover:text-orange-700 transition-colors">
            <i class="bi bi-whatsapp"></i>WhatsApp
          </a>
          <a href={VK_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-4 py-2 text-base font-medium text-slate-700 hover:bg-orange-50 hover:text-orange-700 transition-colors">
            ВКонтакте
          </a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-4 py-2 text-base font-medium text-slate-700 hover:bg-orange-50 hover:text-orange-700 transition-colors">
            Instagram
          </a>
        </div>
      </div>
    </section>
  </main>

  <RelatedPages title="Полезные страницы" pages={relatedPages} />
  <Footer />
</Base>
