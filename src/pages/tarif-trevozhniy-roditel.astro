---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TELEGRAM_URL } from '../data/contacts';

const TG_TEXT = encodeURIComponent('Хочу тариф «Тревожный родитель» 😅');
const tgLink = `${TELEGRAM_URL}?text=${TG_TEXT}`;

const schedule = [
  { time: '06:00', text: 'Подъём. Сам. Потому что не спится с 5:30' },
  { time: '06:15', text: 'Лежишь. Смотришь в потолок. Думаешь про ребёнка' },
  { time: '08:00', text: 'Завтрак. Запиваешь всё чистой фильтрованной водой. Думаешь: «Интересно, что сейчас ест он»' },
  { time: '08:30', text: 'Первая проверка телефона. Ничего нет — это нормально' },
  { time: '09:00', text: 'Свободное время: прогулка / чтение / тревога на выбор' },
  { time: '10:00', text: 'Фото из лагеря. Пересматриваешь три раза. Ищешь ребёнка на заднем плане' },
  { time: '12:00', text: 'Обед. Запиваешь фильтрованной водой. Снова думаешь про ребёнка' },
  { time: '13:00', text: 'Тихий час. Переписка в родительском чате: «А вашему тоже написали?»' },
  { time: '14:30', text: 'Шикарный вид на летний подмосковный лес. Сидишь на подоконнике с телефоном — как пушкинская Татьяна' },
  { time: '15:00', text: 'Смотришь украдкой из-за занавески как ребёнок играет с остальными. Волнуешься, что бегает без шапки при +25.' },
  { time: '16:00', text: 'Практика «Я отпустил(а)» · 50 минут · по желанию' },
  { time: '19:00', text: 'Ужин. Снова вода. Снова думаешь' },
  { time: '20:00', text: 'Видеозвонок с ребёнком' },
  { time: '20:05', text: 'Анализ звонка: «Он сказал "нормально" — что это значит?»' },
  { time: '22:00', text: 'Скроллинг родительского чата. Подготовка ко сну' },
  { time: '23:00', text: 'Сон (условно)' },
];

const arc = [
  { day: '1',    title: 'Отпускание',              desc: 'Самый тяжёлый день. Машешь вслед автобусу. Стоишь на парковке ещё 20 минут после того, как он уехал.' },
  { day: '2–3',  title: 'Первый звонок',            desc: '«У меня всё хорошо» — говорит ребёнок. Не веришь. Просишь позвать кого-то из взрослых для подтверждения.' },
  { day: '4–5',  title: 'Акклиматизация',           desc: 'Проверяешь телефон уже только раз в 15 минут. Это прогресс. Фотографируешь лес для истории.' },
  { day: '6–7',  title: 'Привыкание',               desc: 'Впервые спишь до 7:00. Читаешь книгу целых 40 минут подряд, не думая о ребёнке.' },
  { day: '8–9',  title: 'Ты уже почти человек',     desc: 'Замечаешь, что сегодня думала о чём-то своём. Потом вспоминаешь о ребёнке и чувствуешь вину. Всё нормально.' },
  { day: '10',   title: 'Финал',                    desc: 'Хакатон. Показ проектов. Ты приезжаешь и видишь, как ребёнок рассказывает про свой AI-проект незнакомым людям. Плачешь.' },
];

const reviews = [
  {
    name: 'Наталья О.',
    stars: 5,
    badge: 'Была на программе',
    text: 'Съездил(а). Продержался(ась) три дня. Чуть не сошёл(шла) с ума. Вид на лес — шикарный, врать не буду. Фильтрованная вода помогла. Сертификат «Я отпустил(а)» — лучший сувенир лета.',
  },
  {
    name: 'Алексей М.',
    stars: 5,
    badge: 'Не был, но оценивает',
    text: 'Не был, но ставлю 5. Сначала хотел тревожиться. Потом глянул ценник на этот тариф. Тревога сразу прошла — переключился на другое.',
  },
  {
    name: 'Светлана Д.',
    stars: 5,
    badge: 'Была · 2-й год подряд',
    text: 'Второй год. В первый раз забрала ребёнка на третий день. В этом — дотерпела до восьмого. Личный рекорд. Сертификат висит на холодильнике рядом с магнитиками.',
  },
  {
    name: 'Марина К.',
    stars: 4,
    badge: 'Была на программе',
    text: 'Фильтрованная вода — в наличии. Лес — в наличии. Отсутствие алкоголя — соблюдено, хотя к концу третьего дня становится сложновато. Минус звезда: ребёнок вернулся счастливым. Пришлось признать, что зря волновалась.',
  },
];
const upsells = [
  { icon: 'chat-dots-fill',        text: 'Отругать вожатого',                                                  price: '9 000 ₽',    note: null },
  { icon: 'cup-hot-fill',          text: 'Отругать кухню за неправильно сваренную гречку',                    price: '20 000 ₽',   note: null },
  { icon: 'mortarboard',           text: 'Отругать преподавателя за неправильное преподавание',               price: '30 000 ₽',   note: null },
  { icon: 'person-badge',          text: 'Отчитать руководителя смены',                                       price: '50 000 ₽',   note: null },
  { icon: 'star-fill',             text: 'Отчитать основателя лагеря',                                        price: '100 000 ₽',  note: 'Включён написанный нами для вас негативный отзыв' },
  { icon: 'people-fill',           text: 'Построить весь персонал и прочитать лекцию о том, как надо работать', price: '500 000 ₽',  note: null },
  { icon: 'chat-square-dots-fill', text: 'Получить обратную связь за своё поведение',                          price: 'по запросу', note: null },
];
---

<Base
  title="Программа «Тревожный родитель» — расписание на 10 дней · АйДаКемп"
  description="Подробное расписание тарифа «Тревожный родитель» в IT-лагере АйДаКемп. 10 дней, фильтрованная вода, шикарный вид на лес, сертификат «Я отпустил(а)»."
>
  <Fragment slot="head">
  </Fragment>

  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/10" data-hero-bg="glass-orbs">
    <div class="relative z-10 mx-auto max-w-4xl px-4 pt-10 pb-10 md:pt-16 md:pb-14">

      <div class="inline-flex items-center gap-1.5 rounded-full bg-pink-500/20 border border-pink-400/30 px-3 py-1 text-base font-bold uppercase tracking-widest text-pink-200 backdrop-blur-sm mb-4">
        <i class="bi bi-heart-fill text-base" aria-hidden="true"></i>
        Эксклюзивный тариф
      </div>

      <h1 class="text-[28px] md:text-[40px] font-extrabold text-white leading-tight">
        Программа «Тревожный родитель»
      </h1>
      <p class="mt-2 text-[16px] text-white/70 max-w-xl leading-relaxed">
        10 дней · 150 000 ₽ · Подробное расписание
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        {[
          { icon: 'droplet-fill',      text: 'Фильтрованная вода' },
          { icon: 'tree-fill',         text: 'Вид на подмосковный лес' },
          { icon: 'shield-fill-check', text: 'Без алкоголя' },
          { icon: 'award-fill',        text: 'Сертификат «Я отпустил(а)»' },
        ].map(m => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/15 px-3 py-1.5 text-base text-white/80 backdrop-blur-sm">
            <i class={`bi bi-${m.icon} text-base text-pink-300`} aria-hidden="true"></i>
            {m.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-4xl px-4 py-8 pb-16 space-y-12">

    <!-- Расписание дня -->
    <section>
      <h2 class="text-[22px] font-bold text-slate-900 mb-1">Расписание типичного дня</h2>
      <p class="text-base text-slate-500 mb-6">Приблизительное. Точность зависит от вашего внутреннего состояния.</p>

      <div class="relative">
        <!-- Вертикальная линия -->
        <div class="absolute left-[52px] top-0 bottom-0 w-px bg-pink-100" aria-hidden="true"></div>

        <div class="space-y-1">
          {schedule.map((item, i) => (
            <div class="flex items-start gap-4">
              <span class="w-[44px] shrink-0 text-right text-base font-mono font-semibold text-pink-500 pt-2.5">{item.time}</span>
              <div class="relative flex items-start gap-3 flex-1 rounded-[12px] px-4 py-2.5 hover:bg-pink-50 transition-colors group">
                <div class="absolute left-[-5px] top-[14px] h-2.5 w-2.5 rounded-full bg-pink-200 group-hover:bg-pink-400 transition-colors border-2 border-white" aria-hidden="true"></div>
                <p class="text-base leading-[1.55] text-slate-700">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 10-дневная дуга -->
    <section>
      <h2 class="text-[22px] font-bold text-slate-900 mb-1">Путь за 10 дней</h2>
      <p class="text-base text-slate-500 mb-6">Эмоциональная дуга участника программы.</p>

      <div class="grid gap-3 sm:grid-cols-2">
        {arc.map((d, i) => (
          <div class={`rounded-[16px] border p-4 ${i === 5 ? 'bg-gradient-to-br from-orange-50 to-amber-50 border-primary/30' : 'bg-white border-slate-200'}`}>
            <div class="flex items-center gap-2.5 mb-2">
              <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-base font-black ${i === 5 ? 'bg-primary text-white' : 'bg-pink-100 text-pink-600'}`}>
                {d.day}
              </span>
              <span class={`text-base font-bold ${i === 5 ? 'text-slate-900' : 'text-slate-800'}`}>{d.title}</span>
            </div>
            <p class="text-base leading-[1.6] text-slate-600">{d.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Условия программы -->
    <section class="rounded-[20px] border border-slate-200 bg-white p-6">
      <h2 class="text-[20px] font-bold text-slate-900 mb-4">Условия программы</h2>
      <ul class="space-y-3">
        {[
          { icon: 'droplet-fill',      text: 'Неограниченный доступ к фильтрованной воде — запивать всё вышеперечисленное' },
          { icon: 'x-circle-fill',     text: 'Полное отсутствие алкоголя' },
          { icon: 'cloud-sun',         text: 'Отсутствие внешних факторов стресса — только ваши внутренние мысли' },
          { icon: 'tree-fill',         text: 'Шикарный вид на летний подмосковный лес — чтобы грустить в тишине' },
          { icon: 'phone-vibrate',     text: 'Телефон при вас всегда — ребёнок на связи, WhatsApp работает' },
          { icon: 'camera-fill',       text: 'Ежедневные фото из лагеря — пересматривать по несколько раз' },
          { icon: 'chat-dots-fill',    text: 'Доступ в родительский чат 24/7 — найдите единомышленников' },
          { icon: 'heart-pulse-fill',  text: '10 000 шагов в день — гарантированная активность' },
          { icon: 'patch-check-fill',  text: 'Питание проверено Роспотребнадзором' },
          { icon: 'fire',              text: 'Две тренировки по пожарной безопасности и эвакуации' },
          { icon: 'award-fill',        text: 'Сертификат «Я отпустил(а)» по итогам 10 дней' },
        ].map(item => (
          <li class="flex items-start gap-3">
            <i class={`bi bi-${item.icon} text-[16px] text-pink-400 mt-0.5 shrink-0`} aria-hidden="true"></i>
            <span class="text-base leading-[1.6] text-slate-700">{item.text}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-base text-slate-400 italic">
        Налоговый вычет — только на ребёнка. Прости.
      </p>
    </section>

    <!-- Отзывы -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-[22px] font-bold text-slate-900">Отзывы</h2>
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-base font-semibold text-amber-700">
          <i class="bi bi-star-fill text-base" aria-hidden="true"></i>
          4.8 · Яндекс
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {reviews.map(r => (
          <div class="rounded-[16px] bg-white border border-slate-200 p-4 shadow-[0_2px_8px_rgba(15,23,42,0.04)]">
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex items-center gap-2.5">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-pink-200 to-fuchsia-200 text-base font-bold text-pink-700">
                  {r.name[0]}
                </div>
                <div>
                  <p class="text-base font-semibold text-slate-800 leading-none">{r.name}</p>
                  <p class="text-base text-slate-400 mt-0.5">{r.badge}</p>
                </div>
              </div>
              <div class="flex gap-0.5 shrink-0">
                {Array.from({ length: 5 }).map((_, i) => (
                  <i class={`bi bi-star-fill text-base ${i < r.stars ? 'text-amber-400' : 'text-slate-200'}`} aria-hidden="true"></i>
                ))}
              </div>
            </div>
            <p class="text-base leading-[1.65] text-slate-600">{r.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Дополнительные опции -->
    <section>
      <h2 class="text-[22px] font-bold text-slate-900 mb-1">Дополнительные опции</h2>
      <p class="text-base text-slate-500 mb-6">Не входят в базовую стоимость. Оплачиваются по настроению.</p>

      <div class="space-y-2">
        {upsells.map((u, i) => (
          <div class={`flex items-start justify-between gap-4 rounded-[14px] border px-4 py-3.5 ${i === upsells.length - 1 ? 'bg-gradient-to-r from-slate-900 to-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
            <div class="flex items-start gap-3 flex-1 min-w-0">
              <i class={`bi bi-${u.icon} text-[18px] shrink-0 mt-0.5 ${i === upsells.length - 1 ? 'text-pink-400' : 'text-pink-400'}`} aria-hidden="true"></i>
              <div class="min-w-0">
                <p class={`text-base leading-[1.5] font-medium ${i === upsells.length - 1 ? 'text-white' : 'text-slate-800'}`}>{u.text}</p>
                {u.note && <p class="text-base text-amber-500 mt-0.5">{u.note}</p>}
              </div>
            </div>
            <span class={`shrink-0 text-base font-black tabular-nums whitespace-nowrap ${i === upsells.length - 1 ? 'text-pink-400' : i >= 3 ? 'text-slate-700' : 'text-slate-500'}`}>{u.price}</span>
          </div>
        ))}
      </div>
      <p class="mt-3 text-base text-slate-400 italic">* Мы не несём ответственности за ваши отношения с персоналом после оказания данных услуг.</p>
    </section>

    <!-- Сертификат «Я отпустил(а)» -->
    <section class="rounded-[24px] border border-amber-200 bg-amber-50/40 p-6 md:p-8 text-center">
      <p class="text-base font-bold uppercase tracking-widest text-amber-600 mb-3">Каждый участник тарифа получает</p>
      <h2 class="text-[20px] font-bold text-slate-900 mb-5">Именной сертификат</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        <div>
          <button
            type="button"
            data-lb-src="/images/sertifikat-ya-otpustila.png"
            data-lb-alt="Сертификат «Я отпустила» — АйДаКемп"
            class="block w-full cursor-zoom-in group"
            aria-label="Увеличить сертификат для мам"
          >
            <img
              src="/images/sertifikat-ya-otpustila-900.webp"
              alt="Сертификат «Я отпустила» — АйДаКемп"
              class="w-full rounded-[16px] shadow-[0_8px_32px_rgba(0,0,0,0.12)] group-hover:shadow-[0_12px_40px_rgba(0,0,0,0.20)] transition-shadow"
              loading="lazy"
              width="900"
              height="1200"
            />
          </button>
          <p class="mt-2 text-base text-slate-400">для мам <span class="text-slate-300">· нажмите для увеличения</span></p>
        </div>
        <div>
          <button
            type="button"
            data-lb-src="/images/sertifikat-ya-otpustil.png"
            data-lb-alt="Сертификат «Я отпустил» — АйДаКемп"
            class="block w-full cursor-zoom-in group"
            aria-label="Увеличить сертификат для пап"
          >
            <img
              src="/images/sertifikat-ya-otpustil-900.webp"
              alt="Сертификат «Я отпустил» — АйДаКемп"
              class="w-full rounded-[16px] shadow-[0_8px_32px_rgba(0,0,0,0.12)] group-hover:shadow-[0_12px_40px_rgba(0,0,0,0.20)] transition-shadow"
              loading="lazy"
              width="900"
              height="1200"
            />
          </button>
          <p class="mt-2 text-base text-slate-400">для пап <span class="text-slate-300">· нажмите для увеличения</span></p>
        </div>
      </div>
      <p class="mt-4 text-base text-slate-500 max-w-sm mx-auto leading-relaxed">
        Официальное подтверждение того, что вы это сделали.<br>Можно повесить на холодильник.
      </p>
    </section>

    <!-- Lightbox overlay -->
    <div
      id="lb-overlay"
      class="fixed inset-0 z-[9999] bg-black/85 flex items-center justify-center p-4 hidden cursor-zoom-out"
      role="dialog"
      aria-modal="true"
      aria-label="Просмотр сертификата"
    >
      <button
        type="button"
        id="lb-close"
        class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors text-[20px] leading-none"
        aria-label="Закрыть"
      >✕</button>
      <img id="lb-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-[16px] shadow-2xl" />
    </div>

    <script>
      const overlay = document.getElementById('lb-overlay');
      const lbImg = document.getElementById('lb-img');
      const lbClose = document.getElementById('lb-close');

      document.querySelectorAll('[data-lb-src]').forEach(btn => {
        btn.addEventListener('click', () => {
          lbImg.src = btn.dataset.lbSrc;
          lbImg.alt = btn.dataset.lbAlt || '';
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLb() {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }

      overlay.addEventListener('click', (e) => { if (e.target === overlay) closeLb(); });
      lbClose.addEventListener('click', closeLb);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });
    </script>

    <!-- CTA -->
    <section class="rounded-[24px] bg-gradient-to-br from-pink-50 to-fuchsia-50 border-2 border-pink-200 p-6 md:p-8 text-center">
      <i class="bi bi-heart-fill text-[28px] text-pink-400 mb-3 block" aria-hidden="true"></i>
      <h2 class="text-[22px] font-bold text-slate-900 mb-2"><a href={tgLink} target="_blank" rel="noopener" class="hover:text-pink-600 transition-colors">Готова отпустить?</a></h2>
      <p class="text-base text-slate-600 max-w-md mx-auto mb-6 leading-relaxed">
        Запишитесь в тариф — Дарья лично свяжется, расскажет подробности и приедет за вами на трансфер.
      </p>
      <a
        href={tgLink}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-pink-500 px-7 py-3 text-base font-bold text-white hover:bg-pink-600 transition-colors shadow-[0_4px_16px_rgba(236,72,153,0.30)]"
      >
        <i class="bi bi-telegram text-base" aria-hidden="true"></i>
        Записаться в Telegram
      </a>
      <p class="mt-3 text-base text-slate-400">или вернитесь к <a href="/#shifts" class="underline underline-offset-2 hover:text-slate-600">сменам для детей</a></p>
    </section>

  </main>

  <Footer />
</Base>
