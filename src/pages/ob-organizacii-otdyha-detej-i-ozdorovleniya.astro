                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Стоимость</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Возврат ~</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['Смена 2.1', '7 дней', `${PRICE_MIN}`, '~2 800 ₽'],
