                },
              ].map(item => (
                <div class="rounded-[12px] border border-gray-200 px-5 py-4">
                  <div class="flex items-center gap-2 mb-2">
                    <i class={`bi bi-${item.icon} text-[18px] text-[#0b1623]`} aria-hidden="true"></i>
                    <p class="text-[14px] font-semibold text-gray-900">{item.title}</p>
