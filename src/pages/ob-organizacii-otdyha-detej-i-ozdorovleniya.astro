                      <td class="py-2.5 px-3 font-medium text-gray-900">{smena}</td>
                      <td class="py-2.5 px-3 text-gray-600">{days}</td>
                      <td class="py-2.5 px-3 text-gray-700">{price}</td>
                      <td class="py-2.5 px-3 font-semibold text-green-700">{ret}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="text-[13px] font-semibold text-gray-800 mb-2">Что нужно для подачи:</p>
