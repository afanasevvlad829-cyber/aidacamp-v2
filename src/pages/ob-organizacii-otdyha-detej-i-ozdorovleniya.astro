---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Об организации отдыха детей и оздоровления — АйДаКемп';
const description = 'Сведения об организации отдыха детей и оздоровления детского ИТ-лагеря «АйДаКемп» в соответствии с Приказом Минпросвещения РФ от 14.03.2025 № 201.';

const sections = [
  { id: 'osnovnye-svedeniya', label: 'Основные сведения' },
  { id: 'dokumenty', label: 'Документы' },
  { id: 'rukovodstvo', label: 'Руководство' },
  { id: 'pedagogicheskiy-sostav', label: 'Педагогический состав' },
  { id: 'deyatelnost', label: 'Деятельность' },
  { id: 'mto', label: 'Материально-техническое обеспечение' },
  { id: 'uslugi', label: 'Услуги и стоимость' },
  { id: 'dostupnaya-sreda', label: 'Доступная среда' },
  { id: 'ofitsialnyy-lager', label: 'Официальная организация отдыха' },
  { id: 'organizovannyy-otdykh', label: 'Организованный vs самостоятельный' },
  { id: 'nalogovyy-vychet', label: 'Налоговый вычет' },
  { id: 'faq', label: 'Вопросы и ответы' },
];

const faqItems = [
  {
    q: 'Есть ли у лагеря лицензия на образовательную деятельность?',
    a: 'Да. АйДаКемп работает на основании образовательной лицензии Рособрнадзора № Л035-01298-77/01082973. Документ опубликован в разделе «Документы» выше и доступен для скачивания в формате PDF.',
  },
  {
    q: 'Как подать на налоговый вычет за лагерь?',
    a: 'После смены мы выдаём договор об оказании услуг, кассовый чек и справку об оказанных образовательных услугах. Эти три документа подаются в налоговую через личный кабинет на nalog.ru (декларация 3-НДФЛ) или через работодателя. Возврат составит 13% от стоимости образовательной части путёвки.',
  },
  {
    q: 'Что входит в путёвку — какие услуги включены?',
    a: 'Путёвка включает: проживание в корпусе (комнаты на 3–4 человека), питание 4 раза в день по согласованному меню, учебную IT-программу (ноутбук предоставляется), работу вожатых круглосуточно, медицинское сопровождение 24/7. Трансфер (автобус от м. Солнцево) — дополнительная платная опция.',
  },
  {
    q: 'Нужна ли справка от педиатра?',
    a: 'Да, по требованиям СанПиН необходима справка по форме 079/у (справка в лагерь) от педиатра, выданная не ранее чем за 3 дня до отъезда. Также потребуется справка об отсутствии контакта с инфекционными больными. Полный перечень документов — в разделе «Документы» выше.',
  },
  {
    q: 'Есть ли в лагере медицинский работник?',
    a: 'Да. Медицинская сестра находится на территории лагеря круглосуточно — не приходящий специалист, а штатный сотрудник смены. Хранение и выдача лекарственных препаратов осуществляются через медицинский кабинет.',
  },
];
---

<Base title={title} description={description}>
  <Header />
  <div class="min-h-screen bg-white">

    <!-- Page header -->
    <div class="relative overflow-hidden bg-[#0b1623] py-10 px-5" data-hero-bg="glass-orbs">
      <div class="mx-auto max-w-[1024px]">
        <p class="text-[13px] text-white/60 mb-2">aidacamp.ru</p>
        <h1 class="text-[24px] md:text-[32px] font-bold text-white leading-[1.2]">
          Об организации отдыха детей<br class="hidden md:block" /> и оздоровления
        </h1>
        <p class="mt-3 text-[14px] text-white/55 max-w-[640px]">
          Сведения размещены в соответствии с требованиями Приказа Минпросвещения РФ от 14.03.2025 № 201
        </p>
      </div>
    </div>

    <!-- Main content -->
    <div class="mx-auto max-w-[1024px] px-5 py-10 md:py-14">
      <div class="flex gap-10 items-start">

        <!-- Sticky sidebar nav -->
        <nav class="hidden md:block w-[220px] shrink-0 sticky top-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-gray-400 mb-3">Разделы</p>
          <ul class="space-y-1">
            {sections.map(s => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="block text-[13px] text-gray-500 hover:text-primary py-1 border-l-2 border-gray-100 hover:border-primary pl-3 transition-colors duration-150"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Content -->
        <div class="flex-1 min-w-0">

          <!-- 1. Основные сведения -->
          <section id="osnovnye-svedeniya" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              1. Основные сведения
            </h2>
            <div class="overflow-x-auto">
            <table class="w-full text-[14px] border-collapse min-w-[480px]">
              <tbody>
                {[
                  ['Полное наименование организации', 'Общество с ограниченной ответственностью «ВОИП КОННЕКТ» / Детский ИТ-лагерь «АйДаКемп»'],
                  ['Организационно-правовая форма', 'ООО'],
                  ['ИНН', '7729713637'],
                  ['Реестровый номер туроператора', 'РТО 025773'],
                  ['Тип организации', 'Детский оздоровительный лагерь профильный (IT)'],
                  ['Адрес юридического лица', '109542, г. Москва, Рязанский проспект, д. 86/1, стр. 3, комн. 13А'],
                  ['Адрес площадки проведения смен', 'Московская область, Наро-Фоминский городской округ, ЛОК «Изумруд» (66 км от МКАД)'],
                  ['Режим работы', 'Сезонный: 30 мая — 31 августа'],
                  ['Телефон', '<a href="tel:+74951284429" class="text-orange-600 hover:underline">+7 (495) 128-44-29</a>, <a href="tel:+79688086455" class="text-orange-600 hover:underline">+7 (968) 808-64-55</a>'],
                  ['Электронная почта', '<a href="mailto:hello@codims.ru" class="text-orange-600 hover:underline">hello@codims.ru</a>'],
                  ['Сайт', 'aidacamp.ru'],
                  ['Руководитель', 'Афанасьев Владимир Владимирович, директор'],
                ].map(([label, value]) => (
                  <tr class="border-b border-gray-100">
                    <td class="py-2.5 pr-6 text-gray-500 w-[40%] align-top">{label}</td>
                    <td class="py-2.5 text-gray-900 font-medium" set:html={value}></td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </section>

          <!-- 2. Документы -->
          <section id="dokumenty" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              2. Документы
            </h2>
            <ul class="space-y-3">
              {[
                {
                  title: 'Программа воспитательной работы на 2026 год',
                  href: '/docs/programma-vospitaniya-2026.pdf',
                  note: 'PDF',
                },
                {
                  title: 'Правила пребывания на территории лагеря',
                  href: '/docs/pravila-prebyvaniya-2026.pdf',
                  note: 'PDF',
                },
                {
                  title: 'Перечень документов для зачисления ребёнка',
                  href: '/docs/perechen-dokumentov-2026.pdf',
                  note: 'PDF',
                },
                {
                  title: 'Образовательная лицензия',
                  href: '/docs/licenziya-rosobrnadzor.pdf',
                  note: 'Л035-01298-77/01082973',
                  external: false,
                },
                {
                  title: 'Устав ООО «ВОИП КОННЕКТ»',
                  href: '/docs/ustav-voip-konnekt.pdf',
                  note: 'PDF · 124 стр.',
                },
                {
                  title: 'Свидетельство о постановке на учёт (ИНН)',
                  href: '/docs/svidetelstvo-inn.pdf',
                  note: 'PDF',
                },
              ].map(doc => (
                <li class="flex items-start gap-3 rounded-[12px] border border-gray-200 px-4 py-3 hover:border-gray-300 transition-colors">
                  <i class="bi bi-file-earmark-pdf-fill text-[20px] text-red-500 mt-0.5 shrink-0" aria-hidden="true"></i>
                  <div class="flex-1 min-w-0">
                    {doc.href ? (
                      <a
                        href={doc.href}
                        target={doc.external ? '_blank' : '_self'}
                        rel={doc.external ? 'noopener noreferrer' : ''}
                        class="text-[14px] font-medium text-[#1a56db] hover:underline"
                      >
                        {doc.title}
                        {doc.external && <i class="bi bi-box-arrow-up-right text-[11px] ml-1" aria-hidden="true"></i>}
                      </a>
                    ) : (
                      <span class="text-[14px] font-medium text-gray-400">{doc.title}</span>
                    )}
                    <p class="text-[12px] text-gray-400 mt-0.5">{doc.note}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <!-- 3. Руководство -->
          <section id="rukovodstvo" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              3. Руководство
            </h2>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-[12px] border border-gray-200 px-5 py-4">
                <p class="text-[13px] text-gray-400 mb-1">Директор</p>
                <p class="text-[15px] font-semibold text-gray-900">Афанасьев Владимир Владимирович</p>
                <p class="text-[13px] text-gray-500 mt-1">ООО «ВОИП КОННЕКТ»</p>
              </div>
              <div class="rounded-[12px] border border-gray-200 px-5 py-4">
                <p class="text-[13px] text-gray-400 mb-1">Основатель лагеря, руководитель программы</p>
                <p class="text-[15px] font-semibold text-gray-900">Афанасьева Дарья Александровна</p>
                <p class="text-[13px] text-gray-500 mt-1">Руководитель воспитательной работы</p>
              </div>
            </div>
          </section>

          <!-- 4. Педагогический состав -->
          <section id="pedagogicheskiy-sostav" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              4. Педагогический состав
            </h2>
            <div class="rounded-[12px] border border-dashed border-gray-300 px-6 py-6 text-center text-gray-400">
              <i class="bi bi-people text-[28px] mb-2 block" aria-hidden="true"></i>
              <p class="text-[14px]">Состав педагогического коллектива формируется.</p>
              <p class="text-[13px] mt-1">Актуальный список размещается до начала каждой смены.</p>
            </div>
          </section>

          <!-- 5. Деятельность -->
          <section id="deyatelnost" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              5. Деятельность
            </h2>
            <div class="overflow-x-auto mb-8">
            <table class="w-full text-[14px] border-collapse min-w-[480px]">
              <tbody>
                {[
                  ['Возрастная категория', '7–14 лет'],
                  ['Тип отдыха', 'Детский оздоровительный лагерь с проживанием, IT-профиль'],
                  ['Наполняемость смены', 'До 60 детей'],
                  ['Дополнительные программы', 'Python, разработка игр, AI, Minecraft: Education Edition'],
                ].map(([label, value]) => (
                  <tr class="border-b border-gray-100">
                    <td class="py-2.5 pr-6 text-gray-500 w-[40%] align-top">{label}</td>
                    <td class="py-2.5 text-gray-900 font-medium">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>

            <h3 class="text-[16px] font-semibold text-gray-900 mb-4">Смены 2026</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-[13px] border-collapse">
                <thead>
                  <tr class="bg-gray-50">
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Смена</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Даты</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Дней</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Возраст</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['Смена 1', '30 мая – 8 июня 2026', '10', '7–14 лет'],
                    ['Смена 2', '10 июня – 23 июня 2026', '14', '7–14 лет'],
                    ['Смена 2.1', '10 июня – 16 июня 2026', '7', '7–14 лет'],
                    ['Смена 2.2', '16 июня – 23 июня 2026', '8', '7–14 лет'],
                    ['Смена 3', '3 августа – 15 августа 2026', '13', '7–14 лет'],
                    ['Смена 4', '17 августа – 26 августа 2026', '10', '7–14 лет'],
                  ].map(([smena, dates, days, age]) => (
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                      <td class="py-2.5 px-3 font-medium text-gray-900">{smena}</td>
                      <td class="py-2.5 px-3 text-gray-700">{dates}</td>
                      <td class="py-2.5 px-3 text-gray-700">{days}</td>
                      <td class="py-2.5 px-3 text-gray-700">{age}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- 6. МТО -->
          <section id="mto" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              6. Материально-техническое обеспечение
            </h2>
            <div class="overflow-x-auto">
            <table class="w-full text-[14px] border-collapse min-w-[480px]">
              <tbody>
                {[
                  ['Площадка', 'ЛОК «Изумруд», Наро-Фоминский городской округ, Московская область'],
                  ['Год начала работы', '2022'],
                  ['Условия проживания', 'Корпуса, комнаты на 3–4 человека, санузел в корпусе'],
                  ['Условия питания', '5-разовое питание в столовой по утверждённому меню'],
                  ['Учебные кабинеты', 'Оборудованный компьютерный класс (1 ноутбук на каждого участника)'],
                  ['Спортивные объекты', 'Бассейн, волейбольная площадка, футбольное поле'],
                  ['Медицинский кабинет', 'Да — медицинский работник (медсестра) 24/7'],
                ].map(([label, value]) => (
                  <tr class="border-b border-gray-100">
                    <td class="py-2.5 pr-6 text-gray-500 w-[40%] align-top">{label}</td>
                    <td class="py-2.5 text-gray-900 font-medium">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </section>

          <!-- 7. Услуги и стоимость -->
          <section id="uslugi" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              7. Услуги и стоимость
            </h2>
            <div class="overflow-x-auto mb-4">
              <table class="w-full text-[13px] border-collapse">
                <thead>
                  <tr class="bg-gray-50">
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Длительность</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Стоимость путёвки</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">1 день</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-medium border-b border-gray-200">Включено</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['7–8 дней', `от ${PRICE_MIN}`, 'от 6 000 ₽', 'Проживание, питание 5-разовое, программа, оборудование'],
                    ['10 дней', `от ${PRICE_S4}`, 'от 7 490 ₽', 'Проживание, питание 5-разовое, программа, оборудование'],
                    ['13–14 дней', `от ${PRICE_MAX}`, 'от 7 071 ₽', 'Проживание, питание 5-разовое, программа, оборудование'],
                  ].map(([days, price, perday, includes]) => (
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                      <td class="py-2.5 px-3 font-medium text-gray-900">{days}</td>
                      <td class="py-2.5 px-3 font-semibold text-gray-900">{price}</td>
                      <td class="py-2.5 px-3 text-gray-700">{perday}</td>
                      <td class="py-2.5 px-3 text-gray-600">{includes}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-[13px] text-gray-500">
              Трансфер (автобус от м. Солнцево) — дополнительная опция. Возможна компенсация стоимости путёвки в соответствии с законодательством Московской области.
            </p>
          </section>

          <!-- 8. Доступная среда -->
          <section id="dostupnaya-sreda" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              8. Доступная среда
            </h2>
            <div class="text-[14px] text-gray-700 space-y-3 leading-[1.65]">
              <p>Организация осуществляет приём детей с ограниченными возможностями здоровья в индивидуальном порядке.</p>
              <p>Условия хранения лекарственных препаратов обеспечиваются медицинским персоналом, дежурящим круглосуточно.</p>
              <p>Специально оборудованных объектов для маломобильных граждан на территории ЛОК «Изумруд» нет.</p>
              <p>Наличие ассистента (помощника) предоставляется по предварительному согласованию для детей, которым требуется постоянное сопровождение.</p>
              <p>
                По вопросам доступности:
                <a href="tel:+74951284429" class="text-[#1a56db] hover:underline">+7 (495) 128-44-29</a>,
                <a href="mailto:hello@codims.ru" class="text-[#1a56db] hover:underline">hello@codims.ru</a>
              </p>
            </div>
          </section>

          <!-- 9. Официальная организация отдыха -->
          <section id="ofitsialnyy-lager" class="mb-14 scroll-mt-6">
            <h2 class="text-[20px] font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
              9. Официальная организация отдыха — что это значит юридически
            </h2>
            <p class="text-[14px] text-gray-600 mb-5 leading-[1.65]">
              Организованный детский отдых — это не просто лагерь с программой. Это юридически оформленная деятельность
              со строгими требованиями к безопасности, документам и персоналу. Вот что стоит за этим статусом:
            </p>
            <ul class="space-y-4">
              {[
                {
                  icon: 'patch-check-fill',
                  color: 'text-blue-600',
                  title: 'Лицензия Рособрнадзора на дополнительное образование',
                  text: 'Номер лицензии: Л035-01298-77/01082973. Без неё проведение образовательных программ незаконно. Документ проверяется надзорными органами перед каждым сезоном.',
                },
                {
                  icon: 'file-earmark-text',
                  color: 'text-green-600',
                  title: 'Справка 079/у от педиатра — требование СанПиН',
                  text: 'При заезде каждый участник предъявляет справку установленного образца. Это обязательное требование санитарного законодательства, а не наша прихоть.',
                },
                {
                  icon: 'receipt',
                  color: 'text-purple-600',
                  title: 'Договор с родителями — права и ответственность',
                  text: 'Каждый родитель подписывает договор об оказании услуг. В нём зафиксированы ответственность лагеря, права ребёнка, порядок возврата путёвки и правила пребывания.',
                },
                {
                  icon: 'heart-pulse-fill',
                  color: 'text-red-500',
                  title: 'Медработник на территории 24/7',
                  text: 'Медицинская сестра живёт и дежурит на территории лагеря всю смену — это не приходящий специалист. Хранение и выдача препаратов — через медкабинет.',
                },
                {
                  icon: 'shield-fill-check',
                  color: 'text-orange-500',
                  title: 'Застрахована ответственность туроператора',
                  text: 'Застрахована ответственность туроператора (Росгосстрах). Личную страховку ребёнка от несчастных случаев родитель оформляет самостоятельно — по закону выгодоприобретателем должен быть сам родитель.',
                },
              ].map(item => (
