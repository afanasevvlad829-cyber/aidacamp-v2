/* ── BLOCK RENDERERS ── */
function icon(name){return `<i class="bi bi-${name}" aria-hidden="true"></i>`}

function mkEl(tag, css, html){
  const e=document.createElement(tag);
  if(css) e.style.cssText=css;
  if(html!=null) e.innerHTML=html;
  return e;
}

function blockSmeny(){
  // wrapper
  const wrap=mkEl('div','width:100%;animation:up .3s cubic-bezier(.16,1,.3,1)');

  // outer card
  const card=mkEl('div','background:#fff;border:1px solid rgba(13,27,42,.09);border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(13,27,42,.07)');

  // header
  const head=mkEl('div','padding:13px 18px;border-bottom:1px solid rgba(13,27,42,.07);display:flex;align-items:center;justify-content:space-between');
  head.innerHTML='<span style="font-size:13px;font-weight:600;color:rgba(13,27,42,.55);display:flex;align-items:center;gap:8px"><i class="bi bi-calendar-event" aria-hidden="true"></i>Смены лета 2026</span>'
    +'<span style="font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px;background:rgba(236,124,0,.12);color:#c45f00">Запись открыта</span>';
  card.appendChild(head);

  // shift list
  const list=mkEl('div','display:flex;flex-direction:column;gap:8px;padding:10px 12px 4px');

  SMENY.forEach((s,idx)=>{
    const free=s.total-s.occupied;
    const pct=Math.round(s.occupied/s.total*100);

    // card per shift
    const sc=mkEl('div',
      'border-radius:14px;border:1px solid '+(s.popular?'rgba(236,124,0,.3)':'rgba(13,27,42,.09)')
      +';background:'+(s.popular?'rgba(236,124,0,.04)':'#f8fafb')
      +';overflow:hidden;transition:.18s;'+(s.available?'cursor:pointer':'opacity:.45;cursor:default')
      +';animation:smena-in .3s cubic-bezier(.16,1,.3,1) '+(idx*.06)+'s both'
    );
    if(s.available) sc.onclick=openPopup;

    // popular badge
    if(s.popular){
      const pop=mkEl('div','display:inline-flex;align-items:center;gap:5px;background:#ec7c00;color:#fff;font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;margin:10px 14px -2px;width:fit-content');
      pop.innerHTML='<i class="bi bi-fire" aria-hidden="true"></i> Популярная';
      sc.appendChild(pop);
    }

    // top row: name+dates | price
    const top=mkEl('div','padding:10px 14px 8px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px');

    const left=mkEl('div','flex:1');
    left.appendChild(mkEl('div','font-size:16px;font-weight:800;color:#0d1b2a;line-height:1.2',s.n));
    left.appendChild(mkEl('div','font-size:14px;color:#4e6072;margin-top:3px',s.dates));
    left.appendChild(mkEl('div','font-size:12px;color:#7e9094;margin-top:1px',s.days));

    const right=mkEl('div','text-align:right;flex-shrink:0');
    if(s.available){
      right.appendChild(mkEl('div','font-size:20px;font-weight:800;color:#ec7c00;white-space:nowrap;letter-spacing:-.02em',s.price));
      right.appendChild(mkEl('div','font-size:12px;color:#7e9094;margin-top:2px','всё включено'));
    } else {
      right.appendChild(mkEl('div','font-size:12px;color:#dc2626;font-weight:600;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.2);padding:4px 10px;border-radius:20px','мест нет'));
    }

    top.appendChild(left);
    top.appendChild(right);
    sc.appendChild(top);

    // occupancy bar (only if available)
    if(s.available){
      const occ=mkEl('div','padding:0 14px 12px');

      const barWrap=mkEl('div','height:6px;border-radius:3px;background:rgba(13,27,42,.08);overflow:hidden;margin-bottom:5px;display:flex');
      const barTaken=mkEl('div','height:100%;background:rgba(13,27,42,.15);border-radius:3px 0 0 3px;width:0;transition:width 1s cubic-bezier(.16,1,.3,1)');
      const barFree=mkEl('div','height:100%;background:linear-gradient(90deg,#22c55e,#16a34a);border-radius:0 3px 3px 0;width:0;transition:width 1s cubic-bezier(.16,1,.3,1)');
      barWrap.appendChild(barTaken);
      barWrap.appendChild(barFree);

      const occRow=mkEl('div','display:flex;justify-content:space-between;font-size:13px');
      occRow.appendChild(mkEl('span','color:#7e9094','занято '+s.occupied));
      occRow.appendChild(mkEl('span','color:#15803d;font-weight:700','свободно '+free));

      occ.appendChild(barWrap);
      occ.appendChild(occRow);
      sc.appendChild(occ);

      // animate bar after paint
      setTimeout(()=>{
        barTaken.style.width=pct+'%';
        barFree.style.width=(100-pct)+'%';
      },120+idx*60);
    }

    list.appendChild(sc);
  });

  card.appendChild(list);

  // CTA button
  const btn=mkEl('button','margin:4px 12px 12px;padding:14px;background:linear-gradient(135deg,#c45f00,#a34e00);border:none;border-radius:12px;font-family:inherit;font-size:16px;font-weight:700;color:#fff;cursor:pointer;width:calc(100% - 24px);display:block;box-shadow:0 4px 14px rgba(236,124,0,.35);letter-spacing:.01em','Выбрать смену и забронировать →');
  btn.onclick=openPopup;
  card.appendChild(btn);

  const foot=mkEl('div','padding:4px 14px 12px;font-size:11px;color:rgba(13,27,42,.35);text-align:center','Налоговый вычет 13% · Место фиксируется на 48ч');
  card.appendChild(foot);

  wrap.appendChild(card);
  return wrap;
}

// Цвета подобраны для WCAG AA на белом фоне (мин. 4.5:1)
const COURSE_PALETTE=[
  {color:'#1d6fe0',bg:'rgba(29,111,224,.07)',border:'rgba(29,111,224,.18)',shadow:'rgba(29,111,224,.1)',glow:'linear-gradient(135deg,rgba(29,111,224,.05),transparent)'},   // Python — blue 5.2:1
  {color:'#16a34a',bg:'rgba(22,163,74,.07)',border:'rgba(22,163,74,.18)',shadow:'rgba(22,163,74,.1)',glow:'linear-gradient(135deg,rgba(22,163,74,.05),transparent)'},       // Minecraft — green 4.5:1
  {color:'#be185d',bg:'rgba(190,24,93,.07)',border:'rgba(190,24,93,.18)',shadow:'rgba(190,24,93,.1)',glow:'linear-gradient(135deg,rgba(190,24,93,.05),transparent)'},       // Scratch — pink 5.3:1
  {color:'#6d28d9',bg:'rgba(109,40,217,.07)',border:'rgba(109,40,217,.18)',shadow:'rgba(109,40,217,.1)',glow:'linear-gradient(135deg,rgba(109,40,217,.05),transparent)'},   // Unity — purple 6.8:1
  {color:'#b91c1c',bg:'rgba(185,28,28,.07)',border:'rgba(185,28,28,.18)',shadow:'rgba(185,28,28,.1)',glow:'linear-gradient(135deg,rgba(185,28,28,.05),transparent)'},       // Cyber — red 5.2:1
  {color:'#b45309',bg:'rgba(180,83,9,.07)', border:'rgba(180,83,9,.18)', shadow:'rgba(180,83,9,.1)', glow:'linear-gradient(135deg,rgba(180,83,9,.05),transparent)'},        // AI — amber 5.1:1
];

function blockCourses(blockData){
  const age=blockData&&blockData.age?parseInt(blockData.age):null;
  const allWithIdx=COURSES.map((c,i)=>({...c,_pi:i}));
  const filtered=age?allWithIdx.filter(c=>age>=c.minAge&&age<=c.maxAge):allWithIdx;
  const label=filtered.length<COURSES.length
    ?(filtered.length+' подходит по возрасту')
    :(COURSES.length+' направлений');

  const wrap=mkEl('div','width:100%;animation:up .3s cubic-bezier(.16,1,.3,1)');
  const card=mkEl('div','background:#fff;border:1px solid rgba(13,27,42,.09);border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(13,27,42,.07)');

  // header
  const head=mkEl('div','padding:13px 18px;border-bottom:1px solid rgba(13,27,42,.07);display:flex;align-items:center;justify-content:space-between');
  head.innerHTML='<span style="font-size:13px;font-weight:600;color:rgba(13,27,42,.55);display:flex;align-items:center;gap:8px"><i class="bi bi-laptop" aria-hidden="true"></i>IT-направления в лагере</span>'
    +'<span style="font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px;background:rgba(236,124,0,.12);color:#c45f00">'+label+'</span>';
  card.appendChild(head);

  // grid
  const isSingle=filtered.length===1;
  const grid=mkEl('div','display:grid;grid-template-columns:'+(isSingle?'1fr':'1fr 1fr')+';gap:8px;padding:12px');

  filtered.forEach((c,idx)=>{
    const p=COURSE_PALETTE[c._pi]||COURSE_PALETTE[0];
    const tile=mkEl('div',
      'position:relative;border-radius:14px;padding:16px 14px 14px;cursor:pointer;'
      +'border:1px solid '+p.border+';background:'+p.bg+';'
      +'display:flex;flex-direction:column;gap:10px;overflow:hidden;'
      +'animation:tile-in .3s cubic-bezier(.16,1,.3,1) '+(0.04+idx*0.05)+'s both;'
      +'transition:transform .2s,box-shadow .2s'
    );
    tile.onmouseenter=()=>{tile.style.transform='translateY(-3px)';tile.style.boxShadow='0 10px 28px '+p.shadow;};
    tile.onmouseleave=()=>{tile.style.transform='';tile.style.boxShadow='';};
    tile.onclick=()=>go('Расскажи подробнее про '+c.name);

    // icon box
    const iconBox=mkEl('div',
      'width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;'
      +'background:'+p.bg+';border:1px solid '+p.border+';flex-shrink:0'
    );
    iconBox.innerHTML='<i class="bi bi-'+c.icon+'" aria-hidden="true" style="font-size:22px;color:'+p.color+'"></i>';
    tile.appendChild(iconBox);

    // name + age
    const nameWrap=mkEl('div','');
    nameWrap.appendChild(mkEl('div','font-size:16px;font-weight:800;color:#0d1b2a;line-height:1.2',c.name));
    const ageBadge=mkEl('div',
      'display:inline-block;margin-top:5px;font-size:12px;font-weight:700;'
      +'color:'+p.color+';background:'+p.bg+';padding:3px 10px;border-radius:20px',
      c.age
    );
    nameWrap.appendChild(ageBadge);
    tile.appendChild(nameWrap);

    // hook
    tile.appendChild(mkEl('div','font-size:14px;color:#4e6072;line-height:1.65;flex:1',c.campHook));

    // result badge
    const res=mkEl('div',
      'display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;'
      +'color:'+p.color+';background:'+p.bg+';border:1px solid '+p.border+';'
      +'padding:5px 11px;border-radius:20px;width:fit-content;margin-top:4px'
    );
    res.innerHTML='<i class="bi bi-check-lg" aria-hidden="true" style="font-size:11px"></i>'+c.result;
    tile.appendChild(res);

    grid.appendChild(tile);
  });

  card.appendChild(grid);

  // "all courses" link
  if(filtered.length<COURSES.length){
    const more=mkEl('div',
      'padding:10px 18px 12px;font-size:12px;color:#7e9094;'
      +'text-align:center;cursor:pointer;border-top:1px solid rgba(13,27,42,.06);'
