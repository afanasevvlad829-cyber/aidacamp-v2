    .pback a{color:rgba(13,27,42,.35);text-decoration:none}
    .pback a:hover{color:#0d1b2a}

    @media(max-width:600px){
      .topbar{padding:12px 14px}
      .back span{display:none}
      .layout{padding:0 10px}
