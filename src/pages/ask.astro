    .psel{width:100%;padding:12px 14px;border:1px solid rgba(13,27,42,.12);border-radius:9px;background:#f8fafc;font-family:var(--sans);font-size:14px;color:#0d1b2a;outline:none;appearance:none;cursor:pointer;margin-bottom:12px}
