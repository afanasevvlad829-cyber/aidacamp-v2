---
export const prerender = true;
import iconsCSS from '../styles/icons.css?raw';
const title = 'Спросить про лагерь — АйДаКемп';
const description = 'AI-ассистент IT-лагеря АйДаКемп. Задайте любой вопрос про смены, программу, цены и безопасность — отвечу честно и без скриптов продаж.';
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="https://aidacamp.ru/ask/">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <style set:html={iconsCSS}></style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{
      --or:#ec7c00;--ord:#c45f00;--orl:rgba(236,124,0,.12);
      --nv:#060e1a;--nv2:#0a1628;--nv3:#0f2040;
      --wh:#fff;--hi:rgba(255,255,255,.5);--lo:rgba(255,255,255,.18);
      --bd:rgba(255,255,255,.08);--bd2:rgba(255,255,255,.05);
      --sans:'Manrope',sans-serif;--mono:'JetBrains Mono',monospace;
    }
    html,body{height:100%;overflow:hidden;background:var(--nv)}
    body{font-family:var(--sans);color:var(--wh);-webkit-font-smoothing:antialiased;display:flex;flex-direction:column}

    #stars{position:fixed;inset:0;z-index:0;pointer-events:none}
    .glow{position:fixed;bottom:-100px;left:50%;transform:translateX(-50%);width:500px;height:220px;background:radial-gradient(ellipse,rgba(236,124,0,.14) 0%,transparent 70%);z-index:0;pointer-events:none;animation:glow 5s ease-in-out infinite}
    @keyframes glow{0%,100%{opacity:1}50%{opacity:.7}}

    .topbar{position:relative;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:16px 24px;background:linear-gradient(to bottom,rgba(6,14,26,.95),transparent);flex-shrink:0}
    .logo{display:flex;align-items:center;gap:10px;text-decoration:none}
    .logo-box{width:34px;height:34px;border-radius:9px;overflow:hidden;flex-shrink:0;box-shadow:0 0 16px rgba(236,124,0,.3)}
    #logoCanvas{display:block}
    .logo-name{font-size:15px;font-weight:700;color:#fff}
    .logo-name span{color:var(--or)}
    .back{font-size:13px;color:var(--lo);text-decoration:none;transition:.2s;display:flex;align-items:center;gap:5px}
    .back:hover{color:var(--hi)}
    .back .bi{font-size:14px}

    .layout{position:relative;z-index:10;flex:1;display:flex;flex-direction:column;max-width:680px;margin:0 auto;width:100%;padding:0 16px;overflow:hidden}

    .intro{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px 0 16px;transition:all .3s}
    .intro.gone{opacity:0;pointer-events:none;max-height:0;padding:0;overflow:hidden}
    .intro-icon{width:60px;height:60px;border-radius:16px;overflow:hidden;margin:0 auto 18px;box-shadow:0 0 30px rgba(236,124,0,.3)}
    .intro-h{font-size:clamp(22px,4vw,36px);font-weight:800;line-height:1.15;letter-spacing:-.02em;margin-bottom:10px}
    .intro-s{font-size:15px;color:var(--hi);margin-bottom:32px;line-height:1.6}
    .hint{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:9px 18px;font-size:14px;color:var(--hi);margin-bottom:22px;backdrop-filter:blur(8px)}
    .hint-dot{width:6px;height:6px;border-radius:50%;background:var(--or);box-shadow:0 0 6px var(--or);animation:blink 2s infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .age-btns{display:flex;gap:10px;justify-content:center;margin-bottom:24px}
    .age-btn{padding:14px 24px;border:1px solid rgba(255,255,255,.13);border-radius:36px;background:rgba(255,255,255,.04);font-family:var(--sans);font-size:15px;font-weight:600;color:rgba(255,255,255,.7);cursor:pointer;transition:.2s;backdrop-filter:blur(6px)}
    .age-btn:hover{border-color:rgba(236,124,0,.5);color:#fff;background:rgba(236,124,0,.08);transform:translateY(-2px)}
    .age-btn .n{display:block;font-size:22px;font-weight:800;color:#fff;line-height:1}
    .age-btn .l{display:block;font-size:12px;color:var(--hi);margin-top:2px}

    .messages{flex:1;overflow-y:auto;padding:8px 0 12px;display:none;flex-direction:column;gap:12px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.06) transparent}
    .messages.show{display:flex}
    .messages::-webkit-scrollbar{width:3px}
    .messages::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:3px}

    .msg-user{align-self:flex-end;max-width:80%;background:var(--or);border-radius:18px 4px 18px 18px;padding:12px 16px;font-size:15px;color:#fff;line-height:1.55;animation:up .25s cubic-bezier(.16,1,.3,1)}
    .msg-text{align-self:flex-start;max-width:85%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:4px 18px 18px 18px;padding:12px 16px;font-size:15px;color:#fff;line-height:1.6;animation:up .25s cubic-bezier(.16,1,.3,1)}
    .msg-text strong{color:var(--or)}
    .msg-text a{color:#ff9520;text-decoration:none}
    @keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

    .typing{align-self:flex-start;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);border-radius:4px 18px 18px 18px;padding:14px 18px;display:none;gap:5px;align-items:center}
    .typing.show{display:flex}
    .td{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.3);animation:td .9s infinite}
    .td:nth-child(2){animation-delay:.18s}.td:nth-child(3){animation-delay:.36s}
    @keyframes td{0%,60%,100%{transform:translateY(0);opacity:.3}30%{transform:translateY(-5px);opacity:1}}

    .chips{align-self:flex-start;display:flex;gap:7px;flex-wrap:wrap;animation:up .3s .1s cubic-bezier(.16,1,.3,1) both}
    .chip{padding:8px 15px;border:1px solid rgba(255,255,255,.12);border-radius:22px;background:rgba(255,255,255,.04);font-family:var(--sans);font-size:13px;color:rgba(255,255,255,.7);cursor:pointer;transition:.15s;backdrop-filter:blur(4px)}
    .chip:hover{border-color:rgba(236,124,0,.4);color:#fff;background:rgba(236,124,0,.08)}
    .chip.cta{background:var(--or);border-color:var(--or);color:#fff;font-weight:600;box-shadow:0 4px 14px rgba(236,124,0,.3)}
    .chip.cta:hover{background:var(--ord)}

    /* VISUAL BLOCKS */
    .vblock{align-self:flex-start;width:100%;max-width:480px;animation:up .3s cubic-bezier(.16,1,.3,1)}
    .block{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;overflow:hidden;backdrop-filter:blur(8px)}
    .block-head{padding:13px 18px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:space-between}
    .block-title{font-size:13px;font-weight:600;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:8px}
    .block-title .bi{opacity:.6;font-size:14px;color:rgba(255,255,255,.7)}
    .block-badge{font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px}
    .badge-green{background:rgba(34,197,94,.15);color:#4ade80}
    .badge-red{background:rgba(239,68,68,.15);color:#f87171}
    .badge-or{background:rgba(236,124,0,.2);color:#ffa040}

    .smeny-list{padding:6px 0}
    .smena-row{padding:11px 18px;display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;border-bottom:1px solid rgba(255,255,255,.05);cursor:pointer;transition:.15s}
    .smena-row:last-child{border-bottom:none}
    .smena-row:hover{background:rgba(255,255,255,.04)}
    .smena-row.sold{opacity:.4;cursor:default}
    .smena-name{font-size:14px;font-weight:600;color:#fff}
    .smena-dates{font-size:12px;color:var(--hi);margin-top:2px}
    .smena-days{font-size:11px;color:rgba(255,255,255,.3);margin-top:1px}
    .smena-price{text-align:right}
    .smena-rub{font-size:15px;font-weight:700;color:#fff;white-space:nowrap}
    .smena-hint{font-size:11px;color:rgba(255,255,255,.3);margin-top:1px}
    .smena-sold-label{font-size:11px;color:#f87171}
    .block-cta{margin:12px 18px;padding:12px;background:var(--or);border:none;border-radius:10px;font-family:var(--sans);font-size:14px;font-weight:700;color:#fff;cursor:pointer;width:calc(100% - 36px);transition:.15s;display:block}
    .block-cta:hover{background:var(--ord)}
    .block-foot{padding:8px 18px 12px;font-size:11px;color:rgba(255,255,255,.25);text-align:center}

    .courses-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.06)}
    .course-cell{background:rgba(10,22,40,.8);padding:14px 16px;cursor:pointer;transition:.15s}
    .course-cell:hover{background:rgba(236,124,0,.08)}
    .course-icon{font-size:20px;margin-bottom:8px;display:block;color:var(--or)}
    .course-name{font-size:13px;font-weight:700;color:#fff;margin-bottom:3px}
    .course-age{font-size:11px;color:var(--or);font-weight:600}
    .course-desc{font-size:11px;color:rgba(255,255,255,.4);margin-top:4px;line-height:1.45}
    .courses-more{padding:12px 18px;font-size:13px;color:var(--hi);text-align:center;cursor:pointer;transition:.15s;border-top:1px solid rgba(255,255,255,.06)}
    .courses-more:hover{color:#fff}

    .day-list{padding:8px 0}
    .day-row{padding:9px 18px;display:flex;gap:14px;align-items:flex-start;border-bottom:1px solid rgba(255,255,255,.05)}
    .day-row:last-child{border-bottom:none}
    .day-time{font-family:var(--mono);font-size:12px;color:var(--or);min-width:46px;margin-top:2px;flex-shrink:0}
    .day-text{font-size:13px;color:rgba(255,255,255,.75);line-height:1.5}
    .day-text strong{color:#fff}

    .cond-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.06)}
    .cond-cell{background:rgba(10,22,40,.8);padding:14px 16px;display:flex;gap:10px;align-items:flex-start}
    .cond-icon{font-size:20px;flex-shrink:0;color:var(--or)}
    .cond-title{font-size:13px;font-weight:600;color:#fff;margin-bottom:3px}
    .cond-desc{font-size:11px;color:rgba(255,255,255,.4);line-height:1.45}

    .loc-body{padding:16px 18px;display:flex;flex-direction:column;gap:10px}
    .loc-row{display:flex;gap:12px;align-items:flex-start}
    .loc-icon{font-size:16px;flex-shrink:0;margin-top:1px;color:var(--or)}
    .loc-label{font-size:12px;color:var(--hi)}
    .loc-val{font-size:14px;font-weight:600;color:#fff}
    .loc-map{background:rgba(255,255,255,.04);border-radius:10px;height:100px;display:flex;align-items:center;justify-content:center;font-size:12px;color:rgba(255,255,255,.3);cursor:pointer;transition:.15s;border:1px solid rgba(255,255,255,.06);margin:0 18px 14px}
    .loc-map:hover{background:rgba(255,255,255,.07);color:var(--hi)}

    .price-tabs{display:flex;gap:1px;background:rgba(255,255,255,.06)}
    .price-tab{flex:1;padding:10px;text-align:center;font-size:12px;font-weight:600;color:rgba(255,255,255,.4);cursor:pointer;transition:.15s;background:rgba(10,22,40,.8)}
    .price-tab.on{background:rgba(236,124,0,.12);color:var(--or)}
    .price-body{padding:14px 18px;display:none}
    .price-body.show{display:block}
    .price-num{font-size:28px;font-weight:800;color:#fff;margin-bottom:4px}
    .price-per{font-size:13px;color:rgba(255,255,255,.4)}
    .price-items{margin-top:12px;display:flex;flex-direction:column;gap:6px}
    .price-item{font-size:12px;color:rgba(255,255,255,.5);display:flex;gap:8px}
    .price-item::before{content:"✓";color:var(--or);flex-shrink:0}
    .price-cashback{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);border-radius:8px;padding:9px 12px;font-size:12px;color:#4ade80;margin-top:12px;line-height:1.5}

    .input-area{padding:8px 0 20px;flex-shrink:0;position:relative;z-index:10}
    .input-box{display:flex;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;overflow:hidden;transition:.2s;backdrop-filter:blur(12px)}
    .input-box:focus-within{border-color:rgba(236,124,0,.4);background:rgba(255,255,255,.08);box-shadow:0 0 0 3px rgba(236,124,0,.07)}
    .inp{flex:1;padding:15px 18px;background:transparent;border:none;outline:none;font-family:var(--sans);font-size:15px;color:#fff}
    .inp::placeholder{color:rgba(255,255,255,.22)}
    .send{width:50px;background:var(--or);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;flex-shrink:0}
    .send:hover{background:var(--ord)}
    .send:disabled{background:rgba(255,255,255,.07);cursor:default}
    .send .bi{font-size:16px;color:#fff}
    .mic{width:44px;background:transparent;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;flex-shrink:0;color:rgba(255,255,255,.3)}
    .mic:hover{color:rgba(255,255,255,.7)}
    .mic.recording{color:#f87171;animation:pulse-mic .8s infinite}
    @keyframes pulse-mic{0%,100%{opacity:1}50%{opacity:.4}}

    .overlay{display:none;position:fixed;inset:0;background:rgba(3,8,18,.85);backdrop-filter:blur(6px);z-index:100;align-items:center;justify-content:center;padding:20px}
    .overlay.open{display:flex}
    .popup{background:#0b1729;border:1px solid rgba(255,255,255,.1);border-radius:22px;width:100%;max-width:390px;overflow:hidden;animation:pop .22s cubic-bezier(.16,1,.3,1)}
    @keyframes pop{from{opacity:0;transform:scale(.94) translateY(10px)}to{opacity:1;transform:none}}
    .ph{padding:20px 24px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;align-items:center}
    .ph-title{font-size:17px;font-weight:800}
    .px{width:32px;height:32px;background:rgba(255,255,255,.07);border:none;border-radius:8px;cursor:pointer;color:rgba(255,255,255,.5);font-size:18px;display:flex;align-items:center;justify-content:center;transition:.15s}
    .px:hover{background:rgba(255,255,255,.14);color:#fff}
    .px .bi{font-size:16px}
    .pb{padding:22px 24px}
    .pfree{display:inline-block;background:rgba(13,40,24,.8);color:#86efac;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;border:1px solid rgba(134,239,172,.18);margin-bottom:18px}
    .plbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:rgba(255,255,255,.3);margin-bottom:8px;display:block}
    .par{display:flex;gap:6px;margin-bottom:14px}
    .pab{flex:1;padding:10px 4px;border:1px solid rgba(255,255,255,.1);border-radius:9px;background:transparent;font-family:var(--sans);font-size:12px;font-weight:600;color:rgba(255,255,255,.4);cursor:pointer;transition:.15s;text-align:center}
    .pab:hover,.pab.on{border-color:var(--or);background:rgba(236,124,0,.12);color:#ffa040}
    .psel{width:100%;padding:12px 14px;border:1px solid rgba(255,255,255,.1);border-radius:9px;background:rgba(255,255,255,.04);font-family:var(--sans);font-size:14px;color:#fff;outline:none;appearance:none;cursor:pointer;margin-bottom:12px}
    .psel option{background:#0b1729}
    .pin{width:100%;padding:13px 16px;border:1px solid rgba(255,255,255,.1);border-radius:9px;background:rgba(255,255,255,.04);font-family:var(--sans);font-size:15px;color:#fff;outline:none;margin-bottom:13px;transition:.2s}
    .pin:focus{border-color:rgba(236,124,0,.5)}
    .pin::placeholder{color:rgba(255,255,255,.2)}
    .psub{width:100%;padding:14px;background:var(--or);color:#fff;border:none;border-radius:9px;font-family:var(--sans);font-size:15px;font-weight:700;cursor:pointer;transition:.15s;margin-bottom:9px;box-shadow:0 4px 18px rgba(236,124,0,.3)}
    .psub:hover{background:var(--ord)}
    .ptr{font-size:11px;color:rgba(255,255,255,.25);text-align:center;line-height:1.6}
    .pback{font-size:12px;color:rgba(255,255,255,.2);text-align:center;padding:8px 24px 18px}
    .pback a{color:rgba(255,255,255,.25);text-decoration:none}
    .pback a:hover{color:rgba(255,255,255,.5)}

    @media(max-width:600px){
      .topbar{padding:12px 14px}
      .back span{display:none}
      .layout{padding:0 12px}
      .age-btns{gap:7px}
      .age-btn{padding:12px 18px}
      .age-btn .n{font-size:18px}
      .msg-user,.msg-text{max-width:92%}
      .vblock{max-width:100%}
      .cond-grid{grid-template-columns:1fr}
      .inp{padding:12px 14px}
      .popup{margin:12px;border-radius:18px}
    }
  </style>
</head>
<body>

<canvas id="stars"></canvas>
<div class="glow"></div>

<div class="topbar">
  <a href="/" class="logo">
    <div class="logo-box"><canvas id="logoCanvas" width="34" height="34"></canvas></div>
    <span class="logo-name">#АйДа<span>Кемп</span></span>
  </a>
  <a href="/" class="back">
    <i class="bi bi-arrow-right" aria-hidden="true" style="transform:rotate(180deg);display:inline-block"></i>
    <span>На сайт лагеря</span>
  </a>
</div>

<div class="layout">
  <div class="intro" id="intro">
    <div class="intro-icon"><canvas id="heroCanvas" width="60" height="60"></canvas></div>
    <h1 class="intro-h">Спросите всё про лагерь</h1>
    <p class="intro-s">Отвечу честно — программа, цены, безопасность,<br>смены 2026. Без скриптов и давления.</p>
    <div class="hint"><span class="hint-dot"></span>Обычно начинают с возраста ребёнка</div>
    <div class="age-btns">
      <button class="age-btn" onclick="go('Ребёнку 7–9 лет')">
        <span class="n">7–9</span><span class="l">лет</span>
      </button>
      <button class="age-btn" onclick="go('Ребёнку 10–12 лет')">
        <span class="n">10–12</span><span class="l">лет</span>
      </button>
      <button class="age-btn" onclick="go('Ребёнку 13–16 лет')">
        <span class="n">13–16</span><span class="l">лет</span>
      </button>
    </div>
  </div>

  <div class="messages" id="msgs"></div>
  <div class="typing" id="typing"><span class="td"></span><span class="td"></span><span class="td"></span></div>

  <div class="input-area">
    <div class="input-box">
      <input class="inp" id="inp" placeholder="Спросите про лагерь..." onkeydown="if(event.key==='Enter'&&!event.shiftKey)send()">
      <button class="mic" id="micBtn" onclick="toggleMic()" aria-label="Голосовой ввод" title="Голосовой ввод">
        <i class="bi bi-mic" id="micIcon" aria-hidden="true"></i>
      </button>
      <button class="send" id="sendBtn" onclick="send()" aria-label="Отправить">
        <i class="bi bi-send" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<div class="overlay" id="overlay" onclick="if(event.target===this)closePopup()">
  <div class="popup">
    <div class="ph">
      <div class="ph-title">Забронировать смену</div>
      <button class="px" onclick="closePopup()" aria-label="Закрыть">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <div class="pb">
      <span class="pfree">Место фиксируется на 48 часов</span>
      <label class="plbl">Возраст</label>
      <div class="par">
        <button class="pab" onclick="pa(this)">7–9 лет</button>
        <button class="pab on" onclick="pa(this)">10–12 лет</button>
        <button class="pab" onclick="pa(this)">13–16 лет</button>
      </div>
      <label class="plbl">Смена</label>
      <select class="psel" id="popShift">
        <option>Смена 1 — 30 мая–8 июня · 74 900 ₽</option>
        <option>Смена 2 — 10–23 июня · 95 000 ₽</option>
        <option>Смена 2.1 — 10–16 июня · 48 000 ₽</option>
        <option>Смена 3 — 3–15 августа · 89 400 ₽</option>
      </select>
      <label class="plbl">Телефон</label>
      <input class="pin" type="tel" id="popPhone" placeholder="+7 (___) ___-__-__">
      <button class="psub" id="popSubmit" onclick="submitBooking()">Забронировать →</button>
      <div class="ptr">Ответим за 10 мин · Лицензия Минобра<br>Кешбэк 15% через Госуслуги</div>
    </div>
    <div class="pback"><a href="#" onclick="closePopup();return false">← Вернуться к чату</a></div>
  </div>
</div>

<script is:inline>
/* ── STARS ── */
(()=>{
  const c=document.getElementById('stars'),ctx=c.getContext('2d');
  let S=[];
  const resize=()=>{
    c.width=innerWidth;c.height=innerHeight;
    S=Array.from({length:170},()=>({
      x:Math.random()*c.width,
      y:Math.random()*c.height*.75,
      r:Math.random()*1.1+.2,
      o:Math.random()*.5+.1,
      sp:Math.random()*.4+.1,
      ph:Math.random()*Math.PI*2
    }));
  };
  const draw=t=>{
    ctx.clearRect(0,0,c.width,c.height);
    S.forEach(s=>{
      const tw=s.o+Math.sin(t*.001*s.sp+s.ph)*.25;
      ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle=`rgba(255,255,255,${Math.max(0,Math.min(1,tw))})`;ctx.fill();
    });
    requestAnimationFrame(draw);
  };
  resize();addEventListener('resize',resize);requestAnimationFrame(draw);
})();

