---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import FAQ from '../components/FAQ.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { WHATSAPP_URL, TELEGRAM_URL, PHONE_MOBILE, PHONE_MOBILE_HREF } from '../data/contacts';

const title = 'Работа в летнем лагере — вожатые, IT-преподаватели, видеограф | АйДаКемп 2026';
const description = 'Вакансии в детский IT-лагерь АйДаКемп — Подмосковье, лето 2026. Ищем вожатых, преподавателей по программированию и видеографа. Проживание, питание, трансфер включены.';
const h1 = 'Работа в детском лагере летом 2026';

const positions = [
  {
    id: 'vozhaty',
    title: 'Вожатый',
    icon: 'heart-fill',
    color: '#E85D75',
    tagline: 'Самая живая работа этого лета',
    description: 'Вы — главный человек для ребят 7–15 лет. Утром — общий сбор, вечером — конкурсы, ночью — тишина (мы надеемся). Каждый день — другой.',
    requirements: [
      'Возраст от 18 лет',
      'Курсы вожатских кадров (КВС) или опыт работы с детьми',
      'Медицинская книжка (поможем оформить)',
      'Ответственность, энергия, умение держать внимание аудитории',
      'Опыт в спорте, музыке, творчестве — большой плюс',
    ],
    plus: 'Опыт в театре, стендапе, аниматорстве — приветствуется. Нам нужны люди, которые умеют зажечь зал.',
  },
  {
    id: 'it',
    title: 'Преподаватель IT',
    icon: 'laptop',
    color: '#4361EE',
    tagline: 'Учишь детей — они делают реальный продукт',
    description: 'Вы ведёте занятия по Python, Scratch, веб-разработке или AI. Группы до 8 человек, возраст 7–15 лет. Продукт смены — рабочий проект, который ребёнок показывает родителям на защите.',
    requirements: [
      'Уверенное знание Python / Scratch / веб (HTML+CSS+JS) или смежных технологий',
      'Умение объяснять сложное простыми словами',
      'Возраст от 18 лет',
      'Опыт преподавания или работы с детьми — плюс, но не обязателен',
      'Знание нейросетей (ChatGPT, Stable Diffusion, Copilot) — будет преимуществом',
    ],
    plus: 'Студенты IT-специальностей — welcome. Главное: реальный опыт в коде и желание передавать его детям.',
  },
  {
    id: 'video',
    title: 'Оператор-видеограф',
    icon: 'camera-video-fill',
    color: '#0CAA5E',
    tagline: 'Снимаешь всю смену — делаешь итоговое видео',
    description: 'Вы на смене с первого до последнего дня. Снимаете жизнь лагеря, хакатон, конкурсы, мастер-классы. На выходе — итоговый ролик смены, рилсы для соцсетей и фотоконтент для сайта.',
    requirements: [
      'Опыт видеосъёмки: репортаж, события, повседневная жизнь',
      'Монтаж: Premiere Pro, DaVinci Resolve или CapCut (любой из)',
      'Понимание формата Reels / Shorts — умение снимать вертикалку',
      'Своя техника (камера или хорошее зеркало/беззеркалка) — большой плюс',
      'Готовность работать в ритме лагеря: ранние подъёмы, поздние вечера',
    ],
    plus: 'Если есть дрон с лицензией — это вообще идеально. Пишите.',
  },
];

const conditions = [
  { icon: 'house-door-fill', text: 'Проживание на территории лагеря' },
  { icon: 'bag-check-fill', text: '5-разовое питание, как у ребят' },
  { icon: 'truck', text: 'Трансфер Москва — лагерь — Москва' },
  { icon: 'award-fill', text: 'Оплата обсуждается на собеседовании' },
  { icon: 'heart-pulse-fill', text: 'Медработник и страховка на смену' },
  { icon: 'moon-stars', text: 'Атмосфера, которую запомнишь навсегда' },
];

const faqItems = [
  {
    q: 'Когда начинаются смены?',
    a: 'Смены идут в течение лета. Набираем команду на каждую смену отдельно — актуальные даты и наличие мест уточняйте при отклике. Можно работать на одной или нескольких сменах подряд.'
  },
  {
    q: 'Нужен ли опыт для работы вожатым?',
    a: 'Желателен, но не обязателен. Берём студентов педагогических, психологических и физкультурных специальностей от 18 лет. Курсы вожатских кадров (КВС) — большой плюс. Проводим собственный инструктаж перед каждой сменой.'
  },
  {
    q: 'Можно ли работать на нескольких сменах?',
    a: 'Да, и это приветствуется. Многие сотрудники работают по 2–4 смены за лето. Оплата за каждую смену отдельно.'
  },
  {
    q: 'Как подать заявку?',
    a: `Напишите в <a href="${WHATSAPP_URL}" target="_blank" rel="noopener">WhatsApp</a> или <a href="${TELEGRAM_URL}" target="_blank" rel="noopener">Telegram</a> — расскажите о себе и на какую позицию претендуете. Ответим и назначим короткое знакомство по видео.`
  },
  {
    q: 'Сколько детей на одного вожатого?',
    a: 'Не более 10 ребят. Вожатые работают в парах, поэтому реально — 1 вожатый на 5 детей. Это комфортное соотношение.'
  },
  {
    q: 'Нужна ли медицинская книжка?',
    a: 'Да, для всех сотрудников. Если ещё не оформляли — подскажем, где сделать быстро и без очередей.'
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "JobPosting",
      "title": "Вожатый в детский IT-лагерь",
      "description": "Ищем вожатых в летний IT-лагерь АйДаКемп (Подмосковье). Проживание, питание, трансфер включены.",
      "datePosted": "2026-04-01",
      "validThrough": "2026-08-01",
      "employmentType": "TEMPORARY",
      "hiringOrganization": {
        "@type": "Organization",
        "name": "АйДаКемп",
        "sameAs": "https://aidacamp.ru"
      },
      "jobLocation": {
        "@type": "Place",
        "name": "Детский лагерь АйДаКемп",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Наро-Фоминский округ",
          "addressRegion": "Московская область",
          "addressCountry": "RU"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "АйДаКемп", "item": "https://aidacamp.ru" },
        { "@type": "ListItem", "position": 2, "name": "Вакансии", "item": "https://aidacamp.ru/vakansii" }
      ]
    }
  ]
};
---

<LandingLayout title={title} description={description} h1={h1}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero — тёмный блок с пульсирующими орбами (как на страницах статей) -->
  <section class="relative overflow-hidden bg-[#0d1a2b] min-h-[440px] md:min-h-[480px] flex">
    <div
      class="hero-orb hero-orb-1 absolute inset-0 z-0"
      style="background: radial-gradient(ellipse 90% 120% at 0% 50%, rgba(250,100,15,1.0) 0%, rgba(220,60,0,0.60) 35%, rgba(150,30,0,0.15) 60%, transparent 78%)"
    ></div>
    <div
      class="hero-orb hero-orb-2 absolute inset-0 z-0"
      style="background: radial-gradient(ellipse 70% 90% at 15% 95%, rgba(240,80,0,0.85) 0%, rgba(180,40,0,0.30) 50%, transparent 75%)"
    ></div>

    <div class="relative z-10 mx-auto max-w-[1200px] w-full px-5 pt-24 pb-10 md:px-10 md:pt-24 md:pb-12 flex flex-col justify-center">
      <div class="grid gap-6 md:grid-cols-[1.1fr_360px] md:gap-10 md:items-center">

        <!-- LEFT -->
        <div>
          <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur-sm px-3 py-1.5">
            <i class="bi bi-people-fill text-[14px] text-primary" aria-hidden="true"></i>
            <span class="text-[13px] font-bold uppercase tracking-[0.12em] text-white/90">Работа в команде · Лето 2026</span>
          </div>

          <nav class="text-[14px] text-white/70 mb-3">
            <a href="/" class="hover:text-white/90 transition-colors">Главная</a>
            <span class="mx-1.5">&rarr;</span>
            <span class="text-white/75">Вакансии</span>
          </nav>

          <h1 class="text-[30px] md:text-[44px] font-bold leading-[1.08] tracking-[-0.03em] text-white [text-shadow:0_2px_14px_rgba(0,0,0,0.5)]">
            {h1}
          </h1>

          <p class="mt-4 text-[16px] md:text-[18px] text-white/85 leading-[1.55] max-w-[600px] [text-shadow:0_1px_8px_rgba(0,0,0,0.4)]">
            Лагерь — это место, где перезагружаются не только дети. Каждое лето мы собираем
            команду, которая превращает смену в лучшее лето для ребят. Ищем вожатых,
            IT-преподавателей и видеографа.
          </p>

          <div class="mt-5 flex flex-wrap gap-3">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-[15px] font-bold text-slate-900 shadow-md transition hover:brightness-105 active:scale-[0.98]">
              <i class="bi bi-whatsapp"></i> Написать в WhatsApp
            </a>
            <a href={TELEGRAM_URL} target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-5 py-3 text-[15px] font-semibold text-white transition hover:bg-white/10">
              <i class="bi bi-telegram"></i> Telegram
            </a>
          </div>

          <p class="mt-4 text-[14px] text-white/60">
            3 открытые позиции · проживание, питание и трансфер включены
          </p>
        </div>

        <!-- RIGHT: карточка Дарьи (десктоп) -->
        <aside class="hidden md:block rounded-[18px] bg-white/95 shadow-[0_4px_20px_rgba(0,0,0,0.10)] p-5 md:p-6">
          <div class="flex items-start gap-4">
            <img
              src="/images/team/sm/team-daria-main-01.avif"
              alt="Дарья Афанасьева"
              class="h-16 w-16 shrink-0 rounded-full object-cover object-top ring-2 ring-orange-100"
              width="64"
              height="64"
              loading="lazy"
            />
            <div class="min-w-0">
              <span class="inline-block text-[28px] leading-none text-orange-400 font-serif">&laquo;</span>
              <p class="mt-[-4px] text-[14px] md:text-[14.5px] leading-[1.55] text-body-muted italic">
                Хорошая смена начинается с хорошей команды. Поэтому я знакомлюсь с каждым —
                смотрю не резюме, а человека.
              </p>
              <p class="mt-3 text-[15px] font-semibold text-body">— Дарья Афанасьева</p>
              <p class="text-[14px] text-body-faint">основатель АйДаКемп, мама подростка</p>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- Positions -->
  <section class="vak-positions section-padding">
    <div class="container">
      <h2 class="section-title text-center mb-5">Открытые вакансии</h2>
      <div class="vak-grid">
        {positions.map(pos => (
          <article class="vak-card" id={pos.id}>
            <div class="vak-card__header" style={`--pos-color: ${pos.color}`}>
              <i class={`bi bi-${pos.icon} vak-card__icon`}></i>
              <div>
                <h3 class="vak-card__title">{pos.title}</h3>
                <p class="vak-card__tagline">{pos.tagline}</p>
              </div>
            </div>
            <div class="vak-card__body">
              <p class="vak-card__desc">{pos.description}</p>
              <h4 class="vak-card__req-title">Что нам важно:</h4>
              <ul class="vak-card__req-list">
                {pos.requirements.map(r => (
                  <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
              {pos.plus && (
                <p class="vak-card__plus">
                  <i class="bi bi-stars"></i> {pos.plus}
                </p>
              )}
              <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="vak-card__apply">
                Откликнуться →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Conditions -->
  <section class="vak-conditions section-padding bg-light-subtle">
    <div class="container">
      <h2 class="section-title text-center mb-4">Что мы даём</h2>
      <p class="text-center text-muted mb-5" style="max-width:560px;margin-inline:auto">
        Одинаково для всех сотрудников — вожатых, преподавателей, видеографа.
      </p>
      <div class="vak-conditions__grid">
        {conditions.map(c => (
          <div class="vak-condition">
            <i class={`bi bi-${c.icon} vak-condition__icon`}></i>
            <span>{c.text}</span>
          </div>
        ))}
      </div>
      <div class="vak-conditions__note">
        <strong>Оплата:</strong> сумма обсуждается индивидуально на собеседовании.
        Зависит от опыта, роли и количества смен. Не стесняйтесь называть свои ожидания —
        мы за честный разговор.
      </div>
    </div>
  </section>

  <!-- Salary -->
  <section class="vak-salary section-padding">
    <div class="container">
      <h2 class="section-title text-center mb-2">Сколько зарабатывает вожатый</h2>
      <p class="text-center text-muted mb-5" style="max-width:580px;margin-inline:auto;font-size:0.95rem">
        Ниже — средние рыночные ставки по Подмосковью (по данным hh.ru и профильных чатов вожатых, 2025–2026).
        Мы стараемся платить выше рынка — но и требуем соответственно.
      </p>

      <div class="salary-grid">
        <div class="salary-card">
          <div class="salary-role">Вожатый</div>
          <div class="salary-market">
            <span class="salary-label">Рынок</span>
            <span class="salary-range">25 000 — 45 000 руб. / смена</span>
            <span class="salary-day">≈ 1 800 — 3 200 руб./сутки</span>
          </div>
          <div class="salary-us">
            <i class="bi bi-arrow-up-circle-fill"></i>
            Мы — выше рынка. Конкретная сумма зависит от опыта и обсуждается на собеседовании.
          </div>
        </div>

        <div class="salary-card">
          <div class="salary-role">Преподаватель IT</div>
          <div class="salary-market">
            <span class="salary-label">Рынок</span>
            <span class="salary-range">45 000 — 80 000 руб. / смена</span>
            <span class="salary-day">≈ 3 200 — 5 700 руб./сутки</span>
          </div>
          <div class="salary-us">
            <i class="bi bi-arrow-up-circle-fill"></i>
            Мы — выше рынка. Зависит от стека, уровня и количества смен.
          </div>
        </div>

        <div class="salary-card">
          <div class="salary-role">Видеограф</div>
          <div class="salary-market">
            <span class="salary-label">Рынок</span>
            <span class="salary-range">35 000 — 60 000 руб. / смена</span>
            <span class="salary-day">≈ 2 500 — 4 300 руб./сутки</span>
          </div>
          <div class="salary-us">
            <i class="bi bi-arrow-up-circle-fill"></i>
            Мы — выше рынка. Итоговый ролик + рилсы = реальное портфолио на выходе.
          </div>
        </div>
      </div>

      <div class="salary-note">
        <strong>Почему выше рынка?</strong> Потому что мы требуем больше.
        Маленькие группы (до 8 ребят) — вожатый знает каждого по имени, характеру и проекту.
        Преподаватель не читает скрипт — он адаптирует программу под конкретных детей.
        Видеограф снимает с 7 утра до позднего вечера. Это настоящая работа, а не «весёлое лето».
        Мы платим честно — называйте свои ожидания, и мы ответим честно.
      </div>
    </div>
  </section>

  <!-- How to apply -->
  <section class="vak-apply section-padding">
    <div class="container">
      <div class="vak-apply__inner">
        <h2 class="section-title">Как откликнуться</h2>
        <ol class="vak-apply__steps">
          <li>
            <span class="vak-apply__num">1</span>
            <div>
              <strong>Напишите нам</strong> — в WhatsApp или Telegram. Скажите, на какую
              позицию претендуете и немного о себе.
            </div>
          </li>
          <li>
            <span class="vak-apply__num">2</span>
            <div>
              <strong>Короткое знакомство</strong> — видеозвонок на 15–20 минут.
              Хотим увидеть человека, а не читать резюме.
            </div>
          </li>
          <li>
            <span class="vak-apply__num">3</span>
            <div>
              <strong>Подтверждение и оформление</strong> — договор, медкнижка, инструктаж
              перед сменой. Всё по закону.
            </div>
          </li>
        </ol>
        <div class="vak-apply__contacts">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            <i class="bi bi-whatsapp"></i> WhatsApp
          </a>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-telegram"></i> Telegram
          </a>
          <a href={`tel:${PHONE_MOBILE.replace(/[^+\d]/g, '')}`} class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-telephone"></i> {PHONE_MOBILE}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container">
      <h2 class="section-title text-center mb-5">Частые вопросы</h2>
      <div style="max-width:720px;margin-inline:auto">
        {faqItems.map((item, i) => (
          <details class="vak-faq-item" open={i === 0}>
            <summary class="vak-faq-q">{item.q}</summary>
            <div class="vak-faq-a" set:html={item.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <FAQSchema items={faqItems} />
</LandingLayout>

<style>
  /* ── Positions grid ── */
  .vak-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }
  .vak-card {
    border: 1px solid #e8eaf0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .vak-card__header {
    padding: 24px 24px 20px;
    background: color-mix(in srgb, var(--pos-color) 8%, white);
    border-bottom: 3px solid var(--pos-color);
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .vak-card__icon {
    font-size: 2rem;
    color: var(--pos-color);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .vak-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 4px;
  }
  .vak-card__tagline {
    font-size: 0.85rem;
    color: #666;
    margin: 0;
  }
  .vak-card__body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .vak-card__desc {
    font-size: 0.95rem;
    color: #444;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .vak-card__req-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
    margin-bottom: 12px;
  }
  .vak-card__req-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vak-card__req-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    color: #333;
    line-height: 1.5;
  }
  .vak-card__req-list li .bi {
    color: #0CAA5E;
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .vak-card__plus {
    background: #f8f9ff;
    border-left: 3px solid #4361EE;
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
