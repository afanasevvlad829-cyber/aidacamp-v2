---
import { PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import { getRelatedPages } from '../data/landing-pages';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: `Детский лагерь летом ${SEASON_YEAR} — что это значит на практике`,
    text: `Летний <a href='/lager-dlya-detey/' class='text-primary underline underline-offset-2'>лагерь для детей</a> — это 7–14 дней, в которые умещается то, на что в городском ритме уходит полгода. Новые друзья и дружба, которая завязывается в маленьких группах по 8 человек, работающий проект, опыт жизни без родителей — и ощущение, что лето прожито не впустую. Летние каникулы ${SEASON_YEAR} — всего три месяца; АйДаКемп даёт ребёнку результат, которым можно похвастаться в сентябре. АйДаКемп работает с конца мая по август в Подмосковье, 66 км от Москвы.`,
    list: [
      `6 смен с 30 мая по 26 августа ${SEASON_YEAR} года`,
      "Дети 7–15 лет, группы по возрасту (7–10, 10–12, 13–15 лет)",
      "Территория санатория «Изумруд», Наро-Фоминский район",
      "Трансфер из Москвы от м. Солнцево в день заезда"
    ]
  },
  {
    h2: "Что дети делают в лагере летом — конкретно",
    text: "Утром и вечером — IT-занятия по 90 минут. Между ними бассейн с ионизированной водой, волейбол, футбол, квесты и вечерние командные игры — скучать некогда. Гаджеты сданы в именной бокс — вместо них внутренняя игровая валюта лагеря (рубли, по аналогии с Монополией), которую зарабатывают за участие и прогресс. В последний день смены — хакатон: каждый защищает проект перед другими командами.",
    list: [
      "Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование — на выбор",
      "Группы до 8 человек — преподаватель знает каждого по имени",
      "Бассейн через день, спорт каждый день",
      "Хакатон в финале: питч проекта, сертификат участника"
    ]
  },
  {
    h2: "Летний лагерь с проживанием — чем отличается от дневного",
    text: "Дневной лагерь: утром приехал, вечером дома, с гаджетами и без погружения. Выездной: 24 часа в среде — другая интенсивность, другая глубина знакомств. Первый опыт жизни без родителей в безопасных условиях — ценность сама по себе.",
    list: [
      "Проживание: корпуса санатория, комнаты 2–4 человека с санузлом",
      "5-разовое питание по СанПиН, учёт аллергий",
      "Охрана 24/7, медработник на территории весь сезон",
      "Фото каждый вечер в Telegram-канале родителей"
    ]
  },
  {
    h2: "Какое лето лучше — IT-лагерь, языковой или спортивный",
    text: "Зависит от цели. IT-лагерь — если нужен навык с результатом и интерес к технологиям хоть немного есть. Языковой — если цель разговорный язык. Спортивный — если форма и командный спорт. АйДаКемп совмещает IT с активным летом: бассейн, спорт, природа — это не лагерь-кружок, а лагерь-лагерь с IT-акцентом.",
    list: [
      "IT-результат: работающий проект к концу смены, не просто «прошли тему»",
      "Природа и активности: за компьютером только занятия, остальное время на улице",
      "Социализация: маленькие группы, интенсивная совместная работа",
      "Возврат 13% через <a href='/nalogovyj-vychet/' class='text-orange-600 underline underline-offset-2'>налоговый вычет</a> — только с образовательной лицензией"
    ]
  },
  {
    h2: `Сколько стоит детский лагерь летом ${SEASON_YEAR}`,
    text: `Стоимость зависит от длины смены. Всё включено: проживание, питание, программа, бассейн, медработник. Никаких доплат за оборудование или материалы. Оплата: 50% при бронировании, 50% за 3 недели до заезда. <a href='/nalogovyj-vychet/' class='text-orange-600 underline underline-offset-2'>Налоговый вычет 13%</a> доступен на образовательную часть путёвки — до ${VYCHET_MAX} возврата.`,
    list: [
      `10 дней — ${PRICE_S4} (Смена 4, август)`,
      `13 дней — ${PRICE_MAX} (Смена 3, август) — максимальный результат`
    ]
  },
  {
    h2: `Как забронировать место в лагере на лето ${SEASON_YEAR}`,
    text: "Оставьте заявку — менеджер перезвонит в течение 10 минут (пн–пт, 11–20 МСК). Обсудим смену, возраст ребёнка и трек, поможем выбрать под уровень.",
    list: [
      "Место бронируется на 72 часа без предоплаты",
      "Рассрочка 50/50: сейчас и за 3 недели до заезда",
      "Ближайшие заезды открыты, места ограничены — уточняйте при бронировании"
    ]
  },
  {
    h2: "Выберите месяц смены",
    text: `<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-2">
    <a href="/lager-na-iyun/" class="flex flex-col rounded-[14px] border border-slate-200 bg-white p-4 hover:border-primary transition-colors">
      <span class="text-base font-semibold uppercase tracking-wide text-slate-400 mb-1">Июнь</span>
      <span class="text-[16px] font-bold text-slate-900">Летний старт</span>
      <span class="text-base text-slate-500 mt-1">Смены 1 и 2 — с 7 лет</span>
    </a>
    <a href="/lager-na-iyul/" class="flex flex-col rounded-[14px] border border-slate-200 bg-white p-4 hover:border-primary transition-colors">
      <span class="text-base font-semibold uppercase tracking-wide text-slate-400 mb-1">Июль</span>
      <span class="text-[16px] font-bold text-slate-900">Пик сезона</span>
      <span class="text-base text-slate-500 mt-1">Все форматы — самые большие смены</span>
    </a>
    <a href="/lager-na-avgust-podmoskove/" class="flex flex-col rounded-[14px] border border-slate-200 bg-white p-4 hover:border-primary transition-colors">
      <span class="text-base font-semibold uppercase tracking-wide text-slate-400 mb-1">Август</span>
      <span class="text-[16px] font-bold text-slate-900">Финальный хакатон</span>
      <span class="text-base text-slate-500 mt-1">Смены 3 и 4 — с питчем проектов</span>
    </a>
  </div>`,
    icon: "calendar-event"
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Детский лагерь летом ${SEASON_YEAR} для ребёнка — IT, Подмосковье, от ${PRICE_MIN}`}
  description="Лагерь летом для детей 7–15 лет: 6 смен июнь–август, 66 км от Москвы. Python, AI, Minecraft. Проживание, бассейн, питание. Место за 72 часа без предоплаты."
  h1={`Детский лагерь летом ${SEASON_YEAR} в Подмосковье`}
  canonical="https://aidacamp.ru/lager-letom"
>
  <Fragment slot="head">
    <CourseSchema
      name={`Детский IT-лагерь летом ${SEASON_YEAR} — АйДаКемп`}
      description="Летний IT-лагерь с проживанием для детей 7–15 лет. Python, AI, Minecraft, Roblox. Бассейн, питание, медработник."
      url="https://aidacamp.ru/lager-letom"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детский лагерь летом ${SEASON_YEAR} в Подмосковье`}
    subtitle="6 смен с мая по август, 66 км от Москвы. Python, AI, Minecraft для детей 7–15 лет. Место бронируется за 72 часа без предоплаты."
    breadcrumb="Лагерь летом"
    keywords={["IT-программа + бассейн + природа — не просто кружок", "Места ограничены — бронируйте заранее", "Ребёнок уедет с готовым проектом"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt={`Детский IT-лагерь летом ${SEASON_YEAR} в Подмосковье — АйДаКемп`}
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ only={['medicine', 'safety', 'food', 'documents', 'communication', 'payment']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
