---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';

const sections = [
  {
    h2: "Что значит «официальный детский лагерь» — 3 документа",
    text: "Родители часто пишут в поиске «детский лагерь официальный сайт» — и правильно делают. «Официальный» лагерь — это не просто красивое слово. Это юридический статус, который подтверждается тремя конкретными документами.",
    list: [
      "Лицензия Минобрнауки — разрешает вести образовательную деятельность с детьми. Без неё лагерь не может официально «учить», а значит — нет налогового вычета 13%",
      "Реестр туроператоров (РТО) — регистрация в федеральном реестре туроператоров tourism.gov.ru. Даёт право продавать путёвки и обязывает иметь финансовую гарантию",
      "Разрешение Роспотребнадзора — санитарно-эпидемиологическое заключение на организацию детского отдыха. Проверяет питание, медика, бытовые условия"
    ]
  },
  {
    h2: "Документы АйДаКемп — всё можно проверить",
    text: "АйДаКемп работает полностью официально с 2021 года. Все три документа есть, все публичны и проверяемы. Не верьте сайту — проверяйте реестры.",
    list: [
      `Образовательная лицензия Минобрнауки ${STAT_LICENSE} — подтверждает право на образовательную деятельность. Можно проверить на сайте Минобрнауки`,
      `Реестровый туроператор РТО ${STAT_RTO} — включён в Единый федеральный реестр туроператоров. Проверить: tourism.gov.ru → поиск по номеру ${STAT_RTO}`,
      "Страховка ВСК — договор страхования ответственности туроператора и несчастных случаев для каждого ребёнка",
      "Договор с родителем — письменный договор оказания услуг на ребёнка, перечень включённых услуг. Высылается при бронировании"
    ]
  },
  {
    h2: "Почему это важно для родителей",
    text: "Официальный статус лагеря — это не формальность. Для семьи это три практических преимущества.",
    list: [
      `Налоговый вычет 13% — только с договора лицензированного образовательного учреждения. Со стоимости смены ${PRICE_S3} возвращается до ${VYCHET_MAX}. Оформляется через налоговую по договору и справке`,
      "Юридическая защита — официальный договор защищает права родителей при любых спорных ситуациях. Есть пункт о возврате средств при отмене",
      "Безопасность ребёнка — Роспотребнадзор проверяет не только бумаги, но и реальные условия: кухню, медкабинет, воду в бассейне, бытовые условия",
      "Финансовая гарантия — туроператор РТО обязан иметь финансовое обеспечение. Если лагерь вдруг закроется — путёвки застрахованы"
    ]
  },
  {
    h2: "Как проверить лагерь самостоятельно — инструкция",
    text: "Не нужно никому верить на слово. Проверьте официальные реестры сами — это занимает 5 минут.",
    list: [
      "Лицензия Минобрнауки: <a href='/docs/licenziya-rosobrnadzor.pdf' target='_blank' rel='noopener' class='text-primary underline'>скачайте документ</a> или проверьте реестр Минобрнауки по ИНН организации",
      "Реестр туроператоров РТО: сайт tourism.gov.ru → раздел «Реестр туроператоров» → поиск по имени или реестровому номеру",
      "Роспотребнадзор: проверьте наличие «Заключения о соответствии» в документах лагеря. Легитимный лагерь не скроет этот документ",
      "Яндекс.Карты, 2ГИС — отзывы родителей за несколько лет. Если нет 20+ отзывов с фото и развёрнутыми комментариями — насторожитесь",
      "Позвоните и попросите выслать договор до оплаты. Официальный лагерь высылает договор сразу"
    ]
  },
  {
    h2: "Смены 2026 — даты и цены",
    text: "АйДаКемп работает в Подмосковье с июня по август 2026. Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. В стоимость включены проживание, питание, IT-программа, бассейн.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Налоговый вычет 13% снижает стоимость смены"
    ]
  },
  {
    h2: "Лицензия и документы АйДаКемп",
    text: "АйДаКемп — официальный лицензированный лагерь с полным пакетом документации. Всё можно проверить в открытых реестрах.",
    list: [
      "Лицензия на образовательную деятельность Минобрнауки МО №077 — основание для налогового вычета 13% по ст. 219 НК РФ",
      `Туроператор РТО ${STAT_RTO} — зарегистрирован в федеральном реестре Ростуризма`,
      "Договор на оказание услуг — выдаётся до оплаты, все условия прозрачны",
      "Медицинская справка: форма 086/у или КЭК для первичного заезда",
      "Страховой полис ВСК — оформляем на каждого ребёнка при бронировании"
    ]
  },
  {
    h2: "Налоговый вычет: лагерь с официальной лицензией",
    text: "Именно наличие лицензии на образовательную деятельность позволяет родителям вернуть 13% НДФЛ по статье 219 Налогового кодекса РФ. Без лицензии — вычета нет.",
    list: [
      `Смена 4 (10 дн., ${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 (13 дн., ${PRICE_S3}) → возврат ~${VYCHET_S3} — максимум`,
      `Смена 2.1 (завершена, 7 дн., ${PRICE_S21}) → возврат ~${VYCHET_S21}`,
      `Смена 2.2 (завершена, 8 дн., ${PRICE_S22}) → возврат ~${VYCHET_S22}`,
      `Смена 2 (завершена, 14 дн., ${PRICE_S2}) → возврат ~${VYCHET_S2}`,
      "Документы для декларации (договор + акт + копия лицензии) выдаём после смены"
    ]
  },
  {
    h2: "Безопасность: что проверить при выборе лагеря",
    text: "Официальный статус — это не только про документы. За ним стоят реальные требования к безопасности, которые лагерь обязан соблюдать.",
    list: [
      "Охрана периметра: закрытый КПП санатория «Изумруд», въезд только по пропускам",
      "Медицинский работник 24/7 — живёт на территории весь сезон",
      "Видеонаблюдение на ключевых точках территории",
      "Режим посещений: гости — только по предварительному уведомлению",
      "Страховой полис ВСК — покрывает несчастные случаи, включён в стоимость"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Официальный детский лагерь 2026 — лицензия | АйДаКемп"
  description={`АйДаКемп — официальный детский лагерь в Подмосковье. Лицензия Минобрнауки, туроператор РТО ${STAT_RTO}. С 2021 года.`}
  h1="Официальный детский лагерь в Подмосковье — как проверить и зачем это важно"
  canonical="https://aidacamp.ru/detskiy-lager-oficialnyj"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что значит «официальный детский лагерь»?", a: "Официальный детский лагерь — это организация с тремя обязательными документами: образовательная лицензия Минобрнауки, регистрация в реестре туроператоров (РТО), разрешение Роспотребнадзора. Без этих документов лагерь работает неофициально, родители не защищены юридически и не могут оформить налоговый вычет." },
    { q: "Какие документы должны быть у официального лагеря?", a: `У официального лагеря должны быть: лицензия Минобрнауки на образовательную деятельность, реестровый номер туроператора (РТО или РТА), заключение Роспотребнадзора, договор с родителями на каждого ребёнка. У АйДаКемп все документы есть: лицензия ${STAT_LICENSE}, РТО ${STAT_RTO} ВСК.` },
    { q: "Как проверить детский лагерь на официальность?", a: "Проверьте лицензию (скачайте документ на нашем сайте), реестровый номер туроператора на tourism.gov.ru, отзывы на Яндекс.Картах и 2ГИС. Попросите выслать договор до оплаты — официальный лагерь сделает это без колебаний." },
    { q: "Можно ли получить налоговый вычет за лагерь?", a: `Да, если лагерь имеет образовательную лицензию Минобрнауки. Вычет 13% оформляется через налоговую по договору оказания образовательных услуг и справке. Например, со смены за ${PRICE_S3} можно вернуть до ${VYCHET_MAX}. АйДаКемп выдаёт все необходимые документы для вычета.` },
    { q: "Как записать ребёнка в АйДаКемп?", a: `Оставьте заявку на сайте или позвоните нам. Мы вышлем договор, стоимость смен от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Оплата частями: 50% при бронировании, 50% за 3 недели до смены. Смены август 2026, Наро-Фоминский район Подмосковья.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Официальный детский лагерь в Подмосковье — как проверить и зачем это важно"
    subtitle={`АйДаКемп — лицензия Минобрнауки, РТО ${STAT_RTO} ВСК. Работаем официально с 2021 года. Смены август 2026 — открыта бронь.`}
    breadcrumb="Официальный лагерь"
    keywords={[`Лицензия Минобрнауки ${STAT_LICENSE} — образовательная деятельность`, `Реестр туроператоров РТО ${STAT_RTO} — проверьте на tourism.gov.ru`, `Налоговый вычет 13% — возврат до ${VYCHET_MAX} с путёвки`]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Официальный детский лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
