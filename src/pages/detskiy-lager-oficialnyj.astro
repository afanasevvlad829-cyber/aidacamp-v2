---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Что значит «официальный детский лагерь» — 3 документа",
    text: "Родители часто пишут в поиске «детский лагерь официальный сайт» — и правильно делают. «Официальный» лагерь — это не просто красивое слово. Это юридический статус, который подтверждается тремя конкретными документами.",
    list: [
      "Лицензия Минобрнауки — разрешает вести образовательную деятельность с детьми. Без неё лагерь не может официально «учить», а значит — нет налогового вычета 13%",
      "Реестр туроператоров (РТО) — регистрация в федеральном реестре туроператоров tourism.gov.ru. Даёт право продавать путёвки и обязывает иметь финансовую гарантию",
      "Разрешение Роспотребнадзора — санитарно-эпидемиологическое заключение на организацию детского отдыха. Проверяет питание, медика, бытовые условия"
    ]
  },
  {
    h2: "Документы АйДаКемп — всё можно проверить",
    text: "АйДаКемп работает полностью официально с 2021 года. Все три документа есть, все публичны и проверяемы. Не верьте сайту — проверяйте реестры.",
    list: [
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973 — подтверждает право на образовательную деятельность. Можно проверить на сайте Минобрнауки",
      "Реестровый туроператор РТО 025773 — включён в Единый федеральный реестр туроператоров. Проверить: tourism.gov.ru → поиск по номеру 025773",
      "Страховка ВСК — договор страхования ответственности туроператора и несчастных случаев для каждого ребёнка",
      "Договор с родителем — письменный договор оказания услуг, страховка на ребёнка, перечень включённых услуг. Высылается при бронировании"
    ]
  },
  {
    h2: "Почему это важно для родителей",
    text: "Официальный статус лагеря — это не формальность. Для семьи это три практических преимущества.",
    list: [
      "Налоговый вычет 13% — только с договора лицензированного образовательного учреждения. Со стоимости смены 89 400 ₽ возвращается до 5 434 ₽. Оформляется через налоговую по договору и справке",
      "Юридическая защита — официальный договор защищает права родителей при любых спорных ситуациях. Есть пункт о возврате средств при отмене",
      "Безопасность ребёнка — Роспотребнадзор проверяет не только бумаги, но и реальные условия: кухню, медкабинет, воду в бассейне, бытовые условия",
      "Финансовая гарантия — туроператор РТО обязан иметь финансовое обеспечение. Если лагерь вдруг закроется — путёвки застрахованы"
    ]
  },
  {
    h2: "Как проверить лагерь самостоятельно — инструкция",
    text: "Не нужно никому верить на слово. Проверьте официальные реестры сами — это занимает 5 минут.",
    list: [
      "Лицензия Минобрнауки: <a href='/docs/licenziya-rosobrnadzor.pdf' target='_blank' rel='noopener' class='text-primary underline'>скачайте документ</a> или проверьте реестр Минобрнауки по ИНН организации",
      "Реестр туроператоров РТО: сайт tourism.gov.ru → раздел «Реестр туроператоров» → поиск по имени или реестровому номеру",
      "Роспотребнадзор: проверьте наличие «Заключения о соответствии» в документах лагеря. Легитимный лагерь не скроет этот документ",
      "Яндекс.Карты, 2ГИС — отзывы родителей за несколько лет. Если нет 20+ отзывов с фото и развёрнутыми комментариями — насторожитесь",
      "Позвоните и попросите выслать договор до оплаты. Официальный лагерь высылает договор сразу"
    ]
  },
  {
    h2: "Смены 2026 — даты и цены",
    text: "АйДаКемп работает в Подмосковье с июня по август 2026. Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. В стоимость включены проживание, питание, IT-программа, бассейн и страховка.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Налоговый вычет 13% снижает стоимость смены"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Официальный детский лагерь 2026 — лицензия | АйДаКемп"
  description="АйДаКемп — официальный детский лагерь в Подмосковье. Лицензия Минобрнауки, туроператор РТО 025773, страховка. С 2021 года."
  h1="Официальный детский лагерь в Подмосковье — как проверить и зачем это важно"
  canonical="https://aidacamp.ru/detskiy-lager-oficialnyj"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что значит «официальный детский лагерь»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Официальный детский лагерь — это организация с тремя обязательными документами: образовательная лицензия Минобрнауки, регистрация в реестре туроператоров (РТО), разрешение Роспотребнадзора. Без этих документов лагерь работает неофициально, родители не защищены юридически и не могут оформить налоговый вычет."
          }
        },
        {
          "@type": "Question",
          "name": "Какие документы должны быть у официального лагеря?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "У официального лагеря должны быть: лицензия Минобрнауки на образовательную деятельность, реестровый номер туроператора (РТО или РТА), заключение Роспотребнадзора, договор с родителями и страховка на каждого ребёнка. У АйДаКемп все документы есть: лицензия Л035-01298-77/01082973, РТО 025773, страховка ВСК."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить детский лагерь на официальность?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверьте лицензию (скачайте документ на нашем сайте), реестровый номер туроператора на tourism.gov.ru, отзывы на Яндекс.Картах и 2ГИС. Попросите выслать договор до оплаты — официальный лагерь сделает это без колебаний."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли получить налоговый вычет за лагерь?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если лагерь имеет образовательную лицензию Минобрнауки. Вычет 13% оформляется через налоговую по договору оказания образовательных услуг и справке. Например, со смены за 89 400 ₽ можно вернуть до 5 434 ₽. АйДаКемп выдаёт все необходимые документы для вычета."
          }
        },
        {
          "@type": "Question",
          "name": "Как записать ребёнка в АйДаКемп?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оставьте заявку на сайте или позвоните нам. Мы вышлем договор, стоимость смен от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Оплата частями: 50% при бронировании, 50% за 3 недели до смены. Смены июнь–август 2026, Наро-Фоминский район Подмосковья."
          }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Официальный детский лагерь в Подмосковье — как проверить и зачем это важно"
    subtitle="АйДаКемп — лицензия Минобрнауки, РТО 025773, страховка ВСК. Работаем официально с 2021 года. Смены июнь–август 2026."
    breadcrumb="Официальный лагерь"
    keywords={["Лицензия Минобрнауки Л035-01298-77/01082973 — образовательная деятельность", "Реестр туроператоров РТО 025773 — проверьте на tourism.gov.ru", "Налоговый вычет 13% — возврат до 5 434 ₽ с путёвки"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Официальный детский лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
