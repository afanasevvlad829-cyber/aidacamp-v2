---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';
import { SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "Что значит «официальный детский лагерь» — 3 документа",
    text: "«Официальный» — это не красивое слово, а юридический статус. У АйДаКемп все три документа есть, все публичны и проверяемы — не верьте сайту, проверяйте реестры.",
    list: [
      `Лицензия Минобрнауки ${STAT_LICENSE} — образовательная деятельность, без неё нет налогового вычета 13%. Проверить на сайте Минобрнауки`,
      `Реестр туроператоров РТО ${STAT_RTO} — регистрация на tourism.gov.ru, обязывает иметь финансовую гарантию. Проверить по номеру ${STAT_RTO}`,
      "Заключение Роспотребнадзора — санитарная проверка питания, медблока и бытовых условий",
      "Страховой полис Росгосстрах — договор ответственности туроператора и от несчастных случаев на каждого ребёнка",
      "Медицинская справка формы 086/у (или КЭК) — обязательна для первого заезда"
    ]
  },
  {
    h2: "Почему это важно для родителей",
    text: "Официальный статус — не формальность, а три практических плюса для семьи.",
    list: [
      `Налоговый вычет 13% — со смены за ${PRICE_S3} возвращается до ${VYCHET_MAX} через налоговую по договору и справке`,
      "Юридическая защита — договор с пунктом о возврате средств при отмене",
      "Реальная безопасность — Роспотребнадзор проверяет кухню, медкабинет и воду в бассейне, а не только бумаги",
      "Финансовая гарантия — РТО обязывает иметь страховое обеспечение на случай закрытия лагеря"
    ]
  },
  {
    h2: "Как проверить лагерь самостоятельно",
    text: "Не верьте на слово — проверка занимает 5 минут.",
    list: [
      "Лицензия: <a href='/docs/licenziya-rosobrnadzor.pdf' target='_blank' rel='noopener' class='text-primary underline'>скачайте документ</a> или проверьте по ИНН на сайте Минобрнауки",
      "РТО: tourism.gov.ru → «Реестр туроператоров» → поиск по номеру",
      "Отзывы на Яндекс.Картах и 2ГИС — если нет 20+ с фото и подробностями, насторожитесь",
      "Попросите договор до оплаты — официальный лагерь высылает его сразу"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — даты и цены`,
    text: `АйДаКемп работает в Подмосковье ${SEASON_FROM_TO} ${SEASON_YEAR}. Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. В стоимость включены проживание, питание, IT-программа, бассейн.`,
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Налоговый вычет 13% снижает стоимость смены"
    ]
  },
  {
    h2: "Налоговый вычет: лагерь с официальной лицензией",
    text: "Именно наличие лицензии на образовательную деятельность позволяет родителям вернуть 13% НДФЛ по статье 219 Налогового кодекса РФ. Без лицензии — вычета нет.",
    list: [
      `Смена 4 (10 дн., ${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 (13 дн., ${PRICE_S3}) → возврат ~${VYCHET_S3} — максимум`,
      `Смена 2.1 (завершена, 7 дн., ${PRICE_S21}) → возврат ~${VYCHET_S21}`,
      `Смена 2.2 (завершена, 8 дн., ${PRICE_S22}) → возврат ~${VYCHET_S22}`,
      `Смена 2 (завершена, 14 дн., ${PRICE_S2}) → возврат ~${VYCHET_S2}`,
      "Документы для декларации (договор + акт + копия лицензии) выдаём после смены"
    ]
  },
  {
    h2: "Безопасность: что проверить при выборе лагеря",
    text: "Официальный статус — это не только про документы. За ним стоят реальные требования к безопасности, которые лагерь обязан соблюдать.",
    list: [
      "Охрана периметра: закрытый КПП санатория «Изумруд», въезд только по пропускам",
      "Медицинский работник 24/7 — живёт на территории весь сезон",
      "Видеонаблюдение на ключевых точках территории",
      "Режим посещений: гости — только по предварительному уведомлению",
      "Страховой полис Росгосстрах — покрывает несчастные случаи, включён в стоимость"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Официальный детский лагерь ${SEASON_YEAR} в Подмосковье — лицензия, РТО, страховка | АйДаКемп`}
  description={`АйДаКемп — официальный детский лагерь в Подмосковье с 2021 года. Лицензия Минобрнауки, туроператор РТО ${STAT_RTO}, страховка Росгосстрах. Налоговый вычет 13% с путёвки.`}
  h1="Официальный детский лагерь в Подмосковье"
  canonical="https://aidacamp.ru/detskiy-lager-oficialnyj"
  breadcrumbLabel="Официальный лагерь"
>
  <LandingHero slot="hero"
    h1="Официальный детский лагерь в Подмосковье"
    subtitle={`АйДаКемп — лицензия Минобрнауки, РТО ${STAT_RTO}, страхование Росгосстрах. Работаем официально с 2021 года. Смены август ${SEASON_YEAR} — открыта бронь.`}
    breadcrumb="Официальный лагерь"
    keywords={[`Лицензия Минобрнауки ${STAT_LICENSE} — образовательная деятельность`, `Реестр туроператоров РТО ${STAT_RTO} — проверьте на tourism.gov.ru`, `Налоговый вычет 13% — возврат до ${VYCHET_MAX} с путёвки`]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Официальный детский лагерь АйДаКемп в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что значит «официальный детский лагерь»?", a: "Официальный детский лагерь — это организация с тремя обязательными документами: образовательная лицензия Минобрнауки, регистрация в реестре туроператоров (РТО), разрешение Роспотребнадзора. Без этих документов лагерь работает неофициально, родители не защищены юридически и не могут оформить налоговый вычет." },
    { q: "Какие документы должны быть у официального лагеря?", a: `У официального лагеря должны быть: лицензия Минобрнауки на образовательную деятельность, реестровый номер туроператора (РТО или РТА), заключение Роспотребнадзора, договор с родителями на каждого ребёнка. У АйДаКемп все документы есть: лицензия ${STAT_LICENSE}, РТО ${STAT_RTO}, страхование Росгосстрах.` },
    { q: "Как проверить детский лагерь на официальность?", a: "Проверьте лицензию (скачайте документ на нашем сайте), реестровый номер туроператора на tourism.gov.ru, отзывы на Яндекс.Картах и 2ГИС. Попросите выслать договор до оплаты — официальный лагерь сделает это без колебаний." },
    { q: "Можно ли получить налоговый вычет за лагерь?", a: `Да, если лагерь имеет образовательную лицензию Минобрнауки. Вычет 13% оформляется через налоговую по договору оказания образовательных услуг и справке. Например, со смены за ${PRICE_S3} можно вернуть до ${VYCHET_MAX}. АйДаКемп выдаёт все необходимые документы для вычета.` },
    { q: "Как записать ребёнка в АйДаКемп?", a: `Оставьте заявку на сайте или позвоните нам. Мы вышлем договор, стоимость смен от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). Оплата частями: 50% при бронировании, 50% за 3 недели до смены. Смены август ${SEASON_YEAR}, Наро-Фоминский район Подмосковья.` }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
