---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Чехова до лагеря АйДаКемп",
    text: "АйДаКемп находится в санатории «Изумруд» в Наро-Фоминском районе — около 45 км от Чехова. Маршрут: по Симферопольскому шоссе (М-2) на север → МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Это примерно 50 минут езды — один из самых коротких маршрутов среди подмосковных городов. Трансфер отправляется от м. Солнцево."
  },
  {
    h2: "Почему родители из Чехова выбирают АйДаКемп",
    text: "Чехов — город полиграфии и химии: здесь работали крупные производства, и технические семьи в городе не редкость. IT — следующий шаг для технических семей, которые понимают: программирование сегодня так же базово, как математика. АйДаКемп даёт именно это — реальный навык, а не сертификат.",
    list: [
      "50 минут от Чехова — один из ближайших IT-лагерей для города",
      "Без акклиматизации — Подмосковье, привычный климат",
      "Налоговый вычет 13% — документы выдаёт лагерь",
      "Трансфер от м. Солнцево, 2 000 ₽ — удобно для семей без машины"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "50 минут от Чехова означает, что в любой момент можно приехать на родительский день и убедиться — всё хорошо. Но обычно достаточно ежедневных фото: родители видят занятия, прогулки и хакатон в прямом эфире.",
    list: [
      "1 преподаватель на 6–8 участников — внимание каждому",
      "Медработник в лагере круглосуточно",
      "Telegram с фото и видео каждый день — лагерь как на ладони",
      "Июль 2026 занят полностью. В июне и августе места есть — запишитесь сейчас"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Чехова",
    text: "Дети 7–15 лет выбирают трек по интересу. Занятия дважды в день по 90 минут, группы до 8 человек. В финале смены — хакатон, где каждый ребёнок защищает свой проект перед родителями.",
    list: [
      "Python — переменные, функции, телеграм-бот за 14 дней",
      "Scratch — первое программирование для детей 7–10 лет",
      "Minecraft Education — создание модов и игровых механик",
      "AI и нейросети — ChatGPT API, обучение моделей",
      "3D-моделирование — Blender, финальная распечатка модели"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Чехова, Серпухова и юга Подмосковья ценят, что лагерь недалеко:",
    list: [
      "«Едем из Чехова второй год. 50 минут по Симферопольскому — и вот лагерь. Дочь привезла проект на Python, теперь хочет поступать на программиста» — Наталья, Чехов",
      "«Нас порадовало, что ребёнок в Подмосковье, рядом. Никакой акклиматизации, а программа на уровне столичных IT-школ» — Светлана, Чехов"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности.",
    list: [
      `Смена 2.1: 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2: 10–23 июня, 14 дней — ${PRICE_MAX} (самая популярная)`,
      `Смена 3: 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4: 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Чеховым 2026 | АйДаКемп"
  description={`Детский лагерь из Чехова: ~50 мин по Симферопольскому шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Чеховом"
  canonical="https://aidacamp.ru/lager-chehov"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Чехова до лагеря АйДаКемп?", a: "Из Чехова около 45 км и ~50 минут: по Симферопольскому шоссе (М-2) на север → МКАД → Киевское шоссе → посёлок Атепцево. Или доехать до м. Солнцево и воспользоваться трансфером лагеря (2 000 ₽)." },
    { q: "Сколько ехать из Чехова до лагеря?", a: "Около 50 минут на автомобиле (45 км через Симферопольское шоссе → МКАД → Киевское). Это один из ближайших маршрутов среди городов Подмосковья." },
    { q: "Есть ли трансфер из Чехова?", a: "Прямого трансфера из Чехова нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Чехова можно добраться до Солнцево на электричке или автобусе до метро." },
    { q: "Сколько стоит путёвка в лагерь из Чехова?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Чеховом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~50 мин от Чехова. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-chehov"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Чеховом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~50 мин из Чехова по Симферопольскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Чехова"
    keywords={["~50 мин от Чехова по Симферопольскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Чеховом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
