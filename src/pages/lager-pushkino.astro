---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Пушкино до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Калужскому шоссе. Из Пушкино ехать около 1.5–2 часов: по Ярославскому шоссе или МКАД на Калужское шоссе (A-101). Расстояние — примерно 85–95 км. Организованный трансфер отправляется от м. Солнцево (~30 мин от Пушкино), стоимость 2 500 ₽ в одну сторону."
  },
  {
    h2: "Почему родители из Пушкино выбирают АйДаКемп",
    text: "Для семей с востока Подмосковья это удобный вариант: ребёнок в одном регионе, нет перелётов и акклиматизации, а при желании — родительский день в середине смены.",
    list: [
      "Никакой акклиматизации — Подмосковье, привычный климат",
      "1 пересадка: до м. Солнцево, дальше автобус АйДаКемп",
      "Родительский день в середине смены — можно заехать и всё посмотреть своими глазами",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»"
    ]
  },
  {
    h2: "Что ребёнок делает в лагере",
    text: "АйДаКемп — это IT-лагерь, где дети не просто «учатся», а делают настоящий проект. Дети 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут с преподавателями-практиками.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортплощадки, вечерние активности",
      "Проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый ребёнок защищает свой проект перед всеми"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "В АйДаКемп приезжают дети из Пушкино, Королёва, Мытищ и других городов восточного Подмосковья:",
    list: [
      "«Сын вернулся с хакатона с дипломом и готовой игрой. Я показала всем в чате — никто не верил, что это он сам написал» — Светлана, Пушкино",
      "«Доехали до Солнцево, пересадили на автобус — и всё. Обратно он уже сам рассказывал как ехал» — Ирина, Королёв",
      "«Лагерь близко, но ощущение как будто ребёнок уехал далеко — полное погружение, телефон почти не берёт» — Людмила, Мытищи"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. В стоимость включены проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ отдельно.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Пушкино 2026 — IT-лагерь | АйДаКемп"
  description="IT-лагерь из Пушкино: ~1.5–2 ч через МКАД по Калужскому шоссе. Python, AI, Minecraft, бассейн, питание. Трансфер от метро Солнцево."
  h1="Детский лагерь из Пушкино — АйДаКемп в Наро-Фоминске"
  canonical="https://aidacamp.ru/lager-pushkino"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Пушкино до АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Пушкино до м. Солнцево около 30 минут, оттуда трансфер АйДаКемп (2 500 ₽). Или самостоятельно: Ярославское шоссе → МКАД → Калужское шоссе, санаторий «Изумруд» в 66 км от МКАД, Наро-Фоминский район." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени ехать из Пушкино до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов. Маршрут: Пушкино → МКАД → Калужское шоссе → санаторий «Изумруд». Расстояние примерно 85–95 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Пушкино?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Пушкино нет, но от м. Солнцево организован автобус АйДаКемп. Доехать до Солнцево из Пушкино — около 30 минут на машине. Стоимость трансфера 2 500 ₽." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Популярные смены: 14 дней — 95 000 ₽, 13 дней — 89 400 ₽, 10 дней — 74 900 ₽. В стоимость включены проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Пушкино — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5–2 часа от Пушкино. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-pushkino"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Пушкино — АйДаКемп в Наро-Фоминске"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5–2 часа от Пушкино через МКАД. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Пушкино"
    keywords={["~1.5–2 часа от Пушкино через МКАД по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Пушкино — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
