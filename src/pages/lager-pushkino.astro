---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Первое IT-лето для пушкинского дачника",
    text: "Пушкино — город дачной культуры: за год здесь успевают прожить несколько жизней — школу, секции, лето на даче. АйДаКемп стал для многих семей логичным продолжением этой традиции: ребёнок уезжает на смену в лагерь, возвращается с готовым IT-проектом — и сезон прожит ярко. Лицензия Минобрнауки, рейтинг 5.0 на Яндекс.Картах."
  },
  {
    h2: "Как добраться из Пушкино до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе. Из Пушкино до лагеря около 110 км, примерно 1 ч 15 мин. Маршрут: электричка Ярославского направления до Москвы (~35 мин) → метро до м. Солнцево → трансфер АйДаКемп 2 000 ₽. На машине: Ярославское шоссе → МКАД → Киевское шоссе (M-3) → санаторий «Изумруд».",
    list: [
      "Электричка Пушкино — Ярославский вокзал: ~35 мин",
      "Метро от Комсомольской до м. Солнцево: ~35 мин",
      "Трансфер от м. Солнцево до лагеря: 2 000 ₽, ~40 мин",
      "На машине без пробок: ~1 ч 15 мин, ~110 км"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Родители из Пушкино особенно ценят, что за каждым ребёнком — живые люди, а не система на автопилоте.",
    list: [
      "1 преподаватель на 6–8 ребят — успевает поработать с каждым лично",
      "Вожатые — конкурсный отбор, проходят обучение до смены",
      "Медработник круглосуточно на территории лагеря",
      "Ежедневные фото в Telegram в 21:00 — видно, чем занимался ваш ребёнок сегодня"
    ]
  },
  {
    h2: "Что делает ребёнок в лагере",
    text: "АйДаКемп — IT-лагерь, где ребята не просто «учатся», а делают настоящий проект. Школьники 7–15 лет выбирают трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия дважды в день по 90 минут с преподавателями-практиками.",
    list: [
      "IT-программа по выбору: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Бассейн с ионизированной водой, спортплощадки, вечерние активности",
      "Проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание",
      "Итоговый хакатон — каждый защищает свой проект перед всеми"
    ]
  },
  {
    h2: "Отзывы родителей из Пушкино и Подмосковья",
    text: "В АйДаКемп приезжают ребята из Пушкино, Королёва, Мытищ и других городов восточного Подмосковья:",
    list: [
      "«Сын вернулся с хакатона с дипломом и готовой игрой. Я показала всем в чате — никто не верил, что это он сам написал» — Светлана, Пушкино",
      "«Доехали до Солнцево, пересадили на автобус — и всё. Обратно он уже сам рассказывал как ехал» — Ирина, Королёв",
      "«Лагерь близко, но ощущение как будто уехал далеко — полное погружение, телефон почти не берёт» — Людмила, Мытищи"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Июль 2026 занят полностью. В июне и августе места есть — бронируйте сейчас. В стоимость включены проживание, питание, IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "В АйДаКемп едут из Пушкино и всего северо-востока Подмосковья:",
    list: [
      "<a href='/lager-shchelkovo'>Щёлково</a> — ~110 км, ~1 ч 20 мин через МКАД",
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-nogink'>Ногинск</a> — ~100 км, ~1 ч 40 мин через Горьковское шоссе",
      "<a href='/lager-reutov'>Реутов</a> — ~100 км, ~1 ч 10 мин по МКАД"
    ]
  },
  {
    h2: "Почему ребята из Пушкино возвращаются",
    text: "По данным сезона 2025: 64% детей, побывавших в АйДаКемп, возвращаются на следующую смену или следующий год. Среди причин — атмосфера без насмешек за интерес к компьютерам, настоящие друзья по интересам, ощущение результата. Мамы, которые видят фото в Telegram каждый вечер — обычно тоже хотят, чтобы поехали снова.",
    list: [
      "Среда единомышленников: все любят технологии — никто не «ботан»",
      "Реальный проект, который можно показать дома и в школе",
      "Хакатон как первая публичная защита в жизни",
      "64% возвращаются на следующий год (данные сезона 2025)"
    ]
  },
  {
    h2: "Первые шаги: как записаться из Пушкино",
    text: "Оставьте заявку на сайте — менеджер перезвонит в течение 10 минут. Обсудим возраст ребёнка, уровень, интересы, подберём подходящую смену и трек. Место бронируется на 72 часа без предоплаты. Для детей из Пушкино удобен трансфер от м. Солнцево — договариваемся при оформлении.",
    list: [
      "Заявка на сайте → звонок за 10 минут (пн–пт 11–20 МСК)",
      "72 часа без предоплаты для принятия решения",
      "Рассрочка 50/50: при бронировании и за 3 недели до заезда",
      "Трансфер от м. Солнцево — 2 000 ₽, сопровождающий"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Пушкино 2026 | АйДаКемп"
  description="IT-лагерь из Пушкино: ~1.5–2 ч через МКАД по Киевскому шоссе. Python, AI, Minecraft, бассейн, питание. Трансфер от метро Солнцево."
  h1="Детский лагерь из Пушкино — АйДаКемп в Наро-Фоминске"
  canonical="https://aidacamp.ru/lager-pushkino"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Пушкино до АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Пушкино до м. Солнцево около 30 минут, оттуда трансфер АйДаКемп (2 000 ₽). Или самостоятельно: Ярославское шоссе → МКАД → Киевское шоссе, санаторий «Изумруд» в 66 км от МКАД, Наро-Фоминский район." }
        },
        {
          "@type": "Question",
          "name": "Сколько времени ехать из Пушкино до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов. Маршрут: Пушкино → МКАД → Киевское шоссе → санаторий «Изумруд». Расстояние примерно 85–95 км." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Пушкино?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Пушкино нет, но от м. Солнцево организован автобус АйДаКемп. Доехать до Солнцево из Пушкино — около 30 минут на машине. Стоимость трансфера 2 000 ₽." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Популярные смены: 14 дней — 95 000 ₽, 13 дней — 89 400 ₽, 10 дней — 74 900 ₽. В стоимость включены проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Пушкино — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5–2 часа от Пушкино. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-pushkino"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь из Пушкино — АйДаКемп в Наро-Фоминске"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5–2 часа от Пушкино через МКАД. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Пушкино"
    keywords={["~1.5–2 часа от Пушкино через МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Трансфер от м. Солнцево, загородный с бассейном"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Пушкино — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
