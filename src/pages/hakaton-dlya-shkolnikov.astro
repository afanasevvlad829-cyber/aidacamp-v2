---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Что такое хакатон — простыми словами",
    text: "Хакатон — это когда несколько команд берут одну задачу и за фиксированное время (обычно 48 часов) делают рабочее решение. Никаких лекций, никаких домашних заданий. Только: придумали → закодили → показали. В конце — питч перед жюри: 3–5 минут, объясни что сделал и почему это работает.",
    list: [
      "48 часов на создание рабочего продукта с нуля",
      "Команды 4–5 человек: разные роли, общая цель",
      "Ментор рядом — помогает, не решает за команду",
      "Финал: питч перед жюри из педагогов и других команд",
      "Не конкурс красоты — оценивают идею, реализацию и умение объяснять"
    ]
  },
  {
    h2: "Как проходит хакатон в АйДаКемп в 2026 году",
    text: "Хакатон — финал каждой смены. К этому моменту подростки уже неделю работали над своими проектами и теперь объединяются в команды для общего спринта. За 48 часов команда проходит весь путь от идеи до демонстрации.",
    list: [
      "День 1 утро: брифинг — тема хакатона, правила, формирование команд",
      "День 1 день: мозговой штурм и выбор идеи, технический план",
      "День 1 вечер — день 2 утро: разработка, ментор доступен в любое время",
      "День 2 день: финальные правки, подготовка питча",
      "День 2 вечер: презентации команд, вопросы жюри, объявление результатов"
    ]
  },
  {
    h2: "Что нужно знать заранее — ничего особенного",
    text: "На хакатон АйДаКемп не нужен предыдущий опыт. Школьники приезжают в лагерь, неделю учатся у педагогов, и только потом — хакатон. К этому моменту у каждого есть нужный минимум навыков. Ментор помогает команде двигаться, а не решает за них.",
    list: [
      "Опыт программирования до лагеря — необязателен",
      "Подростки осваивают базу за первые дни смены",
      "Хакатон идёт в конце — когда уже есть нужные инструменты",
      "Ментор помогает с техническими блокерами, но идею и код — команда",
      "Самое главное — умение договариваться с командой. Этому учатся в процессе"
    ]
  },
  {
    h2: "Что получает подросток после хакатона",
    text: "Хакатон — это не просто соревнование. Это первый опыт работы в реальных условиях: дедлайн, команда, публичная защита. Такой опыт школьникам дают редко — обычно только в университете или на первой работе.",
    list: [
      "Рабочий проект в портфолио — не учебный пример, а команда сделала сама",
      "Опыт командной разработки: как делится работа, что делать при конфликте",
      "Уверенность после публичной защиты — объяснил сложное жюри, справился",
      "Понимание своей роли: кто в команде архитектор, кто менеджер, кто делает интерфейс"
    ]
  },
  {
    h2: "Призы и достижения участников",
    text: "Лучшие проекты хакатонов АйДаКемп показываем родителям на итоговой презентации смены. Каждый участник получает сертификат. Победители — дополнительное поощрение внутри лагеря. Но главный приз — это проект, который можно запустить и показать.",
    list: [
      "Сертификат участника хакатона для каждого школьника",
      "Лучшие проекты — на итоговой презентации для родителей",
      "Победители отмечаются на общем ужине отрядом",
      "Код проекта остаётся у каждого участника, можно выложить на GitHub"
    ]
  },
  {
    h2: "Хакатон — часть каждой смены 2026. Записывайтесь",
    text: "Хакатон входит в программу всех смен АйДаКемп без доплаты. Это финал смены — подросток не уедет без того, чтобы его команда не защитила проект. Смены 2026 стартуют с июня, июль традиционно занят первым.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — от 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — от 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — от 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — от 74 900 ₽",
      "Хакатон входит в стоимость любой смены — без доплаты"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Хакатон для школьников в АйДаКемп | Подмосковье"
  description="Хакатон для школьников в АйДаКемп 2026: 48 часов кода, команды 4–5 чел., ментор, питч жюри. Финал каждой смены в Подмосковье. От 48 000 ₽."
  h1="Хакатон для школьников — 48 часов кода, идеи и командной работы"
  canonical="https://aidacamp.ru/hakaton-dlya-shkolnikov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "АйДаКемп", "item": "https://aidacamp.ru" },
        { "@type": "ListItem", "position": 2, "name": "IT-лагерь для школьников", "item": "https://aidacamp.ru/it-camp" },
        { "@type": "ListItem", "position": 3, "name": "Хакатон для школьников", "item": "https://aidacamp.ru/hakaton-dlya-shkolnikov" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое хакатон для школьников?",
          "acceptedAnswer": { "@type": "Answer", "text": "Хакатон — соревнование команд, которые за 48 часов создают рабочий IT-проект: придумывают идею, программируют и защищают перед жюри. В АйДаКемп хакатон входит в программу каждой смены." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для участия в хакатоне?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Подростки приезжают в лагерь, неделю учатся, и только потом — хакатон. К этому моменту у каждого есть нужный базовый уровень. Ментор помогает команде двигаться вперёд." }
        },
        {
          "@type": "Question",
          "name": "Сколько человек в команде на хакатоне?",
          "acceptedAnswer": { "@type": "Answer", "text": "Команды по 4–5 человек. Каждая команда получает ментора — педагога, который помогает с техническими вопросами, но идею и код создаёт сама команда." }
        },
        {
          "@type": "Question",
          "name": "Что получит ребёнок после хакатона?",
          "acceptedAnswer": { "@type": "Answer", "text": "Рабочий проект в портфолио, сертификат участника, опыт командной разработки и публичной защиты. Лучшие проекты показываем родителям на итоговой презентации смены." }
        },
        {
          "@type": "Question",
          "name": "Входит ли хакатон в стоимость смены?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, хакатон включён в программу всех смен 2026 без доплаты. Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней)." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Хакатон для школьников — 48 часов кода, идеи и командной работы"
    subtitle="Команды 4–5 человек, ментор, питч жюри. Входит в программу каждой смены АйДаКемп без доплаты."
    breadcrumb="Хакатон для школьников"
    keywords={["48 часов — от идеи до рабочего продукта", "Команды 4–5 чел., ментор рядом", "Финал каждой смены 2026"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Хакатон для школьников в АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "ИИ заменит программистов?", url: "/stati/ii-zamenit-programmista", description: "Разбираем реальные данные — что умеет ИИ и что останется за людьми.", icon: "cpu" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
