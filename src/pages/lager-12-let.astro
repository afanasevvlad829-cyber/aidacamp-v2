---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, DAYS_S2, DAYS_S21, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, daysNum } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import SchoolContinue from '../components/SchoolContinue.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_RATING } from '../data/contacts';
import { PAST_SHIFTS_SENTENCE, OPEN_MONTHS_RANGE_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Программа для 12 лет: Python + API + Gemini API + Roblox/Minecraft modding",
    text: "Двенадцатилетки готовы к настоящим проектам, а не к учебным заданиям — и детский лагерь с IT-программой попадает ровно в этот возраст. В АйДаКемп группа 11–13 лет работает с Python среднего уровня: функции, библиотеки, внешние API. Подключаются к Gemini API (Google AI) — создают собственные AI-приложения. Параллельно — продвинутый Roblox-моддинг или Minecraft-модинг на Python: не готовые механики, а свои собственные.",
  },
  {
    h2: "Типичный проект двенадцатилетки: что он создаст за смену",
    text: "За смену подросток 12 лет делает Telegram-бота с AI-элементом (через Gemini API) плюс продвинутый Roblox/Minecraft-мод. На хакатоне защищает проект перед лагерем — обычный лагерь для детей такого не даёт. С детьми работают практикующие разработчики, а не аниматоры.",
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с подростками. Соотношение — 1 вожатый на 8 подростков, группы до 8 ребят ведут опытные IT-педагоги. В лагере дежурит медработник 24/7, а в Telegram-чате отряда родители каждый день видят фото.",
  },
  {
    h2: `Смены ${SEASON_YEAR}: летний сезон завершён`,
    text: `Для двенадцатилеток особенно подходят длинные смены — за ${daysNum(DAYS_S4)}–${DAYS_S3} успевает сложиться команда и получается настоящий AI-проект. Смена 3 (13 дней) даёт максимальный результат. Путёвку можно забронировать онлайн — рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей.`,
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Что было до и что будет после:",
    list: [
      "<a href='/lager-11-let/'>Лагерь для 11 лет</a>",
      "<a href='/lager-14-let/'>Лагерь для подростков 14 лет</a>",
      "<a href='/lager-15-let/'>Лагерь для подростков 15 лет</a>",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];
const SCHOOL_CONTINUE_LINKS = [
  { href: 'https://codims.ru/courses/python/?utm_source=aidacamp&utm_medium=crosslink&utm_campaign=lager-12-let', label: 'Python для школьников' },
];

---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`Летний детский лагерь для детей 12 лет в Подмосковье ${SEASON_YEAR} — Python, AI, проект | АйДаКемп`}
  description={`Детский летний лагерь для детей и подростков 12 лет в Подмосковье ${SEASON_YEAR}. Python + Gemini API + Roblox/Minecraft — реальные AI-проекты. Вожатый 1:8. 66 км от МКАД`}
  h1="Лагерь для детей 12 лет — Python, AI и реальный проект"
  canonical="https://aidacamp.ru/lager-12-let"
  breadcrumb="Лагерь для подростков 12 лет"
>
  <LandingHero slot="hero"
    h1="Лагерь для детей 12 лет — Python, AI и реальный проект"
    subtitle="Python + Gemini API + Roblox/Minecraft modding. Привезут Telegram-бот с AI-ответами и продвинутую игровую механику."
    breadcrumb="Лагерь для подростков 12 лет"
    keywords={["Python + Gemini API + Roblox/Minecraft modding", "Вожатый 1:8, медработник 24/7", "Telegram-бот с AI за смену"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 12 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts slim />
  <SchoolContinue links={SCHOOL_CONTINUE_LINKS} />
  <FAQ items={['about2026:1', 'documents:0', 'medicine:0', 'safety:0', 'payment:1', 'communication:0']} extraItems={[
    { q: "Какая программа для подростков 12 лет в IT-лагере?", a: "Для подростков 11–13 лет в АйДаКемп — Python среднего уровня, Telegram-боты, Gemini API (Google AI) и продвинутый Roblox/Minecraft-моддинг. Финал смены — защита проекта на хакатоне." },
    { q: "Подойдёт ли лагерь подростку 12 лет без опыта?", a: "Да. Есть два трека: начинающие (стартуем с Python базы) и те, кто уже знаком с Python базово. На старте смены диагностика, программа адаптируется." },
    { q: "Что конкретно сделает подросток 12 лет за смену?", a: "К концу смены подросток защищает проект: Telegram-бот с Gemini API (AI-ответы) или AI-квиз. Родители видят прогресс детей в общем чате." },
    { q: `Завершился ли летний сезон ${SEASON_YEAR} года?`, a: `${PAST_SHIFTS_SENTENCE} — к записи открыты смены ${OPEN_MONTHS_RANGE_NOM}.` },
    { q: "Подойдёт ли лагерь для 12 лет девочке?", a: "Да, программа одна для мальчика и девочки 12 лет: Python, Gemini API, Roblox/Minecraft-моддинг — по интересу ребёнка, а не по полу. Ребёнку скучно не будет." },
    { q: `Сколько стоила смена для подростка 12 лет в ${SEASON_YEAR} году?`, a: `Летние смены на ${daysNum(DAYS_S4)}–${DAYS_S3} стоили от ${PRICE_S4} до ${PRICE_MAX}. Доступен налоговый вычет 13%.` }
  ]} />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-11-let/" class="text-primary underline underline-offset-2">← Лагерь для 11 лет</a> · <a href="/lager-13-let/" class="text-primary underline underline-offset-2">Лагерь для 13 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
