---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_RATING } from '../data/contacts';
import { PAST_SHIFTS_SENTENCE } from '../data/evergreen';

const sections = [
  {
    h2: "Программа для 12 лет: Python + API + Gemini API + Roblox/Minecraft modding",
    text: "В 12 лет школьники готовы к настоящим проектам, а не к учебным заданиям — и детский лагерь с IT-программой попадает ровно в этот возраст. В АйДаКемп группа 11–13 лет работает с Python среднего уровня: функции, библиотеки, работа с внешними API. Подключаются к Gemini API (Google AI) — создают собственные AI-приложения. Параллельно — продвинутый Roblox-моддинг или Minecraft-модинг на Python: не готовые механики, а свои собственные. Обучение строится на практике: каждый пункт программы даёт конкретный навык, который сразу применяется в проекте.",
    list: [
      "Python средний: функции, работа с данными, библиотеки (requests, json)",
      "Telegram-бот с нуля: регистрация, команды, ответы — и публикация рабочего бота",
      "Gemini API (Google AI): подключение к нейросети, собственный AI-ассистент",
      "API-запросы: подключение к внешним сервисам (погода, курсы, данные)",
      "Roblox-моддинг или Minecraft-modding: сложные механики через свой код"
    ]
  },
  {
    h2: "Типичный проект двенадцатилетки: что он создаст за смену",
    text: "За смену подросток 12 лет делает Telegram-бота с AI-элементом (через Gemini API) плюс продвинутый Roblox/Minecraft-мод. Бот не шаблонный: своя идея, своя логика. На хакатоне защищает проект перед лагерем и объясняет архитектуру другим командам — обычный детский лагерь такого не даёт.",
    list: [
      "Telegram-бот с Gemini API: отвечает на вопросы с помощью Google AI",
      "Или AI-квиз: генерирует вопросы через нейросеть, ведёт счёт",
      "Roblox-мод или Minecraft-плагин: собственная игровая механика со своим кодом",
      "Публичная защита на хакатоне: объясняет архитектуру и показывает демо"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про двенадцатилеток в IT-лагере:",
    list: [
      "«Gemini API — это не слишком сложно?» — Мы используем готовые библиотеки Python: написал 5 строк — бот уже отвечает через AI. Сложность — в задумке проекта, не в технической части. Педагог помогает с архитектурой.",
      "«Подойдёт ли без опыта программирования?» — Есть два трека: начинающие (стартуем с Python базы) и те, кто уже знает Python (сразу к API и AI). Диагностика в первый день, педагог адаптирует задачи.",
      "«Не будет ли скучать без телефона?» — Вожатый рядом 24/7, соотношение 1:8. Внутренняя экономика лагеря: зарабатывается экранное время за прогресс в проекте. Большинство подростков к третьему дню заняты своим проектом.",
      "«Что конкретно будет в портфолио?» — Рабочий Telegram-бот и Roblox/Minecraft-мод. Код остаётся у подростка, можно показать одноклассникам и загрузить на GitHub.",
      "«Подойдёт ли лагерь для 12 лет девочке?» — Да, программа одна и та же для мальчика и девочки 12 лет. Группы смешанные, Gemini API и Roblox-моддинг одинаково увлекают подростков независимо от пола."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с подростками 11–13 лет. Соотношение — 1 вожатый на 8 подростков. Опытные IT-педагоги ведут группы до 8 ребят — каждый подросток получает обратную связь по своему проекту каждый день. На территории дежурит медработник 24/7. Telegram-чат отряда: родители видят фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый подросток в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR}: июньские прошли, на август есть места`,
    text: `Для двенадцатилеток особенно подходят длинные смены — за 10–13 дней успевает сложиться команда и получается настоящий AI-проект. Смена 3 (13 дней) даёт максимальный результат. АйДаКемп — это не только IT: детский отдых с бассейном, спортом и вожатыми 1:8 входит в стоимость каждой смены. Путёвку можно забронировать онлайн — рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей.`,
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3} (рекомендуем для максимального результата)`,
      "Июньские смены прошли. На август места есть"
    ]
  },
  {
    h2: "Почему 12 лет — поворотный возраст для IT",
    text: "В 11–13 лет мозг подростка проходит через активную перестройку. Именно сейчас закладываются устойчивые интересы. Подростки в этом возрасте способны работать над сложными задачами несколько часов подряд — и делать это с удовольствием, если тема захватила.",
    list: [
      "Аналитическое мышление развивается быстрее всего именно в 11–13 лет",
      "Подростку важно чувствовать себя способным — первый AI-проект это даёт",
      "Окружение сверстников с теми же интересами меняет самовосприятие",
      "Общение с ровесниками, которым тоже интересен Python и AI, — одно из главных открытий смены для многих двенадцатилеток",
      "Первый Telegram-бот в 12 лет — это история, которую рассказывают в институте"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа становится сложнее с каждым годом. Что было до и что будет после:",
    list: [
      "<a href='/lager-11-let/'>Лагерь для 11 лет</a> — Python + HTML/CSS + Roblox Advanced + AI intro",
      "<a href='/lager-14-let/'>Лагерь для подростков 14 лет</a> — Python Advanced и ChatGPT API",
      "<a href='/lager-15-let/'>Лагерь для подростков 15 лет</a> — предпрофессиональный трек с деплоем",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`Летний детский лагерь для детей 12 лет в Подмосковье ${SEASON_YEAR} — Python, AI, проект | АйДаКемп`}
  description={`Детский летний лагерь для детей и подростков 12 лет в Подмосковье ${SEASON_YEAR}. Python + Gemini API + Roblox/Minecraft — реальные AI-проекты. Вожатый 1:8. 66 км от МКАД`}
  h1="Лагерь для детей 12 лет — Python, AI и реальный проект"
  canonical="https://aidacamp.ru/lager-12-let"
>
  <LandingHero slot="hero"
    h1="Лагерь для детей 12 лет — Python, AI и реальный проект"
    subtitle="Python + Gemini API + Roblox/Minecraft modding. Привезут Telegram-бот с AI-ответами и продвинутую игровую механику."
    breadcrumb="Лагерь для подростков 12 лет"
    keywords={["Python + Gemini API + Roblox/Minecraft modding", "Вожатый 1:8, медработник 24/7", "Telegram-бот с AI за смену"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 12 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['medicine:0', 'safety:0', 'food:0', 'communication:0', 'about2026:2', 'about2026:3', 'about2026:6', 'about2026:9']} extraItems={[
    { q: "Какая программа для подростков 12 лет в IT-лагере?", a: "Для подростков 11–13 лет в АйДаКемп — Python среднего уровня, Telegram-боты, Gemini API (Google AI) и продвинутый Roblox/Minecraft-моддинг. Подростки пишут функции, работают с API, создают рабочего Telegram-бота с AI-ответами. Финал смены — защита проекта на хакатоне." },
    { q: "Подойдёт ли лагерь подростку 12 лет без опыта?", a: "Да. Есть два трека: начинающие (стартуем с Python базы) и те, кто уже знаком с Python базово. На старте смены диагностика, программа адаптируется. Скучно не будет ни тем, кто только начинает, ни тем, кто уже что-то умеет." },
    { q: "Что конкретно сделает подросток 12 лет за смену?", a: "К концу смены подросток защищает проект: Telegram-бот с Gemini API (AI-ответы) или AI-квиз. Плюс продвинутый Roblox-мод или Minecraft-плагин. Бот можно запустить и показать друзьям прямо со смартфона." },
    { q: `Есть ли ещё места в ${SEASON_YEAR} году?`, a: `${PAST_SHIFTS_SENTENCE}. В августе (смены 3 и 4) места есть. Бронируйте заранее.` },
    { q: "Подойдёт ли лагерь для 12 лет девочке?", a: "Да, программа одна для мальчика и девочки 12 лет: Python, Gemini API, Roblox/Minecraft-моддинг — по интересу ребёнка, а не по полу. Группы смешанные, соотношение вожатых 1:8 одинаковое." },
    { q: "Сколько стоит смена для подростка 12 лет?", a: `От ${PRICE_MIN} за смену 4 (10 дней, ${DATES_SHORT_S4} ${SEASON_YEAR}). Открытые смены 10–13 дней — от ${PRICE_S4} до ${PRICE_MAX}. В стоимость входит всё: проживание в санатории, питание, все занятия и вечерние активности. Доступен налоговый вычет 13%.` }
  ]} />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya/", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka/", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov/", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-11-let/" class="text-primary underline underline-offset-2">← Лагерь для 11 лет</a> · <a href="/lager-13-let/" class="text-primary underline underline-offset-2">Лагерь для 13 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
