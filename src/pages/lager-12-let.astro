---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему 12 лет — поворотный возраст для IT",
    text: "В 11–13 лет мозг подростка проходит через активную перестройку. Именно сейчас закладываются устойчивые интересы — то, чем человек занимается в 20, 30, 40 лет. Подростки в этом возрасте способны работать над сложными задачами, спорить, искать решения — и делать это с удовольствием, если тема захватила.",
    list: [
      "Аналитическое мышление развивается быстрее всего именно в 11–13 лет",
      "Подростку важно чувствовать себя способным — первый реальный проект это даёт",
      "Окружение сверстников с теми же интересами меняет самовосприятие",
      "В 12 лет легче начать IT, чем в 16 — меньше «уже поздно» и больше любопытства",
      "Первый Telegram-бот в 12 лет — это история, которую рассказывают в институте"
    ]
  },
  {
    h2: "Программа для подростков 12 лет: Python и AI",
    text: "Старшая группа (11–13 лет) в АйДаКемп работает с Python среднего уровня. Дети уже умеют или быстро учатся базе, поэтому мы переходим к интересному: боты, API, введение в AI.",
    list: [
      "Python средний: функции, работа с данными, библиотеки",
      "Telegram-бот с нуля: регистрация, команды, ответы — и публикация рабочего бота",
      "Введение в AI: что такое нейросети, как работает ChatGPT, простой AI-проект",
      "API-запросы: подключение к внешним сервисам (погода, курсы, данные)",
      "Финал: защита проекта перед всем лагерем — презентация и демонстрация"
    ]
  },
  {
    h2: "Что делают подростки без телефонов",
    text: "Телефоны в АйДаКемп не запрещены категорично — они убраны на время занятий и заменены внутренней механикой. Вместо Instagram — реальное общение. Вместо TikTok — создание собственного проекта. Большинство подростков через 2–3 дня сами признают: «так интереснее».",
    list: [
      "Внутренняя валюта лагеря — зарабатывается за активность и прогресс в проекте",
      "Вечерние активности: настольные игры, дискуссии, спортивные турниры",
      "Командная работа над проектом занимает то время, которое раньше уходило в телефон",
      "Хакатон — соревнование команд, азарт который не хуже игры",
      "Круг друзей-сверстников с теми же интересами — это то, чего многим не хватает дома"
    ]
  },
  {
    h2: "Что привозит домой подросток 12 лет",
    text: "За 10–14 дней происходят изменения, которые родители замечают уже через неделю после возвращения.",
    list: [
      "Рабочий Telegram-бот или AI-проект — можно показать одноклассникам и учителям",
      "Навык концентрации: умение 2–3 часа работать над одной задачей без отвлечений",
      "Новые друзья из разных городов — общение продолжается онлайн после лагеря",
      "Уверенность в себе: «я сделал это сам» меняет самовосприятие подростка",
      "Понимание своей роли в команде: лидер, разработчик, дизайнер или организатор"
    ]
  },
  {
    h2: "Смены 2026 для подростков 12 лет",
    text: "Для подростков 11–13 лет особенно подходят длинные смены — за 10–14 дней успевает сложиться команда и получается настоящий проект. Смена 2 (14 дней) даёт максимальный результат.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (рекомендуем для первого раза)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 69 600 ₽",
      "Налоговый вычет 13% — возвращается через ФНС"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Лагерь для подростков 12 лет — Python и AI | АйДаКемп"
  description="IT-лагерь для подростков 12 лет в Подмосковье 2026. Python средний, Telegram-боты, введение в AI. 66 км от МКАД, бассейн, от 48 000 ₽."
  h1="Лагерь для подростков 12 лет — Python и AI | АйДаКемп"
  canonical="https://aidacamp.ru/lager-12-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для подростков 12 лет в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для подростков 11–13 лет в АйДаКемп — Python среднего уровня, Telegram-боты и введение в AI. Дети пишут функции, работают с библиотеками, подключают API, создают рабочего Telegram-бота. Финал смены — защита проекта перед всем лагерем." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь подростку 12 лет без опыта?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Для группы 11–13 лет есть два трека: начинающие и те, кто уже знаком с Python базово. На старте смены все проходят вводную диагностику, и программа адаптируется. Скучно не будет ни тем, кто только начинает, ни тем, кто уже что-то умеет." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает подросток 12 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены подросток защищает проект: рабочий Telegram-бот с командами и ответами, или AI-проект с использованием нейросетей. Бот можно запустить и показать друзьям прямо со смартфона." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена для подростка 12 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Смены 10–14 дней — от 69 600 ₽. В стоимость входит всё: проживание в санатории, 4-разовое питание, все занятия и вечерние активности. Доступен налоговый вычет 13%." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 12 лет — Python, боты и AI"
    subtitle="Подростковый возраст — лучшее время начать. Здесь они делают реальные проекты и находят тех, кому интересно то же самое."
    breadcrumb="Лагерь для подростков 12 лет"
    keywords={["Python, Telegram-боты, AI для 11–13 лет", "Рабочий проект к концу смены", "Окружение сверстников с интересами"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 12 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
