---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для 12 лет: Python + API и Gemini AI",
    text: "В 11–13 лет мозг подростка проходит через активную перестройку. Именно сейчас закладываются устойчивые интересы. Старшая группа (11–13 лет) в АйДаКемп работает с Python среднего уровня и переходит к интересному: боты, API, первый реальный AI-проект. Ключевое новое: Gemini API от Google — подростки подключают настоящие нейросети к своим программам. Плюс моддинг в Roblox или Minecraft: создают не карты, а целые игровые механики с кодом.",
    list: [
      "Python средний: функции, работа с данными, библиотеки",
      "Telegram-бот с нуля: регистрация, команды, публикация рабочего бота",
      "Gemini API (Google AI): подключаем нейросеть к собственной программе",
      "Roblox моддинг или Minecraft моддинг: создаём игровые механики через код",
      "API-запросы: подключение к внешним сервисам (погода, курсы, данные)"
    ]
  },
  {
    h2: "Типичный проект двенадцатилетки: что он создаст за смену",
    text: "К концу смены каждый подросток защищает проект перед всем лагерем. Формат — демо и короткая презентация. Педагог выступает как ментор, а не учитель.",
    list: [
      "Рабочий Telegram-бот: отвечает на вопросы с помощью Gemini AI",
      "Или Python-программа с API: берёт данные из интернета и что-то делает с ними",
      "Или мод для Roblox/Minecraft: кастомная механика, которую можно скачать и поставить",
      "Финал: защита проекта перед всем лагерем — презентация и демонстрация"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про двенадцатилеток в IT-лагере:",
    list: [
      "«Подойдёт ли без опыта программирования?» — Да. Для группы 11–13 лет есть два трека: начинающие и те, кто знает Python базово. На старте смены все проходят диагностику, программа адаптируется.",
      "«Нужен ли опыт с Roblox?» — Нет. Для моддинга и скриптинга в Roblox/Minecraft опыт игры достаточен — код объясняется с нуля.",
      "«Что такое Gemini API — это сложно?» — Нет. Педагог объясняет через готовые примеры. Через 2–3 дня подростки сами подключают API к своим программам.",
      "«Вожатые рядом?» — Соотношение 1:8. Медработник 24/7. Telegram-фото из отряда каждый день."
    ]
  },
  {
    h2: "Почему 12 лет — поворотный возраст для IT",
    text: "В 11–13 лет подростки способны работать над сложными задачами, спорить, искать решения — и делать это с удовольствием, если тема захватила. Именно сейчас закладываются устойчивые интересы.",
    list: [
      "Аналитическое мышление развивается быстрее всего именно в 11–13 лет",
      "Подростку важно чувствовать себя способным — первый реальный проект это даёт",
      "В 12 лет легче начать IT, чем в 16 — меньше «уже поздно» и больше любопытства",
      "Первый Telegram-бот в 12 лет — это история, которую рассказывают в институте"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД. Для подростков 11–13 лет предусмотрено больше самостоятельности, но безопасность — без компромиссов.",
    list: [
      "Соотношение вожатых 1:8 — педагог знает каждого",
      "Медик на территории 24/7, страховка включена",
      "Telegram-фото из отряда ежедневно",
      "Закрытый бассейн по расписанию",
      "Вечерние активности: настолки, дискуссии, спортивные турниры"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для подростков 11–13 лет особенно подходят длинные смены — за 10–14 дней успевает сложиться команда и получается настоящий проект. Июль занят полностью.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (рекомендуем для первого раза)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа становится сложнее с каждым годом. Что было до и что будет после:",
    list: [
      "<a href='/lager-11-let'>Лагерь для 11 лет</a> — Python и первые боты: переходный этап",
      "<a href='/lager-14-let'>Лагерь для 14 лет</a> — Python Advanced и ChatGPT API",
      "<a href='/lager-15-let'>Лагерь для 15 лет</a> — предпрофессиональный трек с деплоем",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title="Летний лагерь 12 лет в Подмосковье 2026 | АйДаКемп"
  description="Летний лагерь для подростков 12 лет в Подмосковье 2026. Python, Gemini AI, Telegram-боты — реальные IT-проекты. Малые группы, без нотаций. 66 км от МКАД от 48 000 ₽."
  h1="Лагерь для подростков 12 лет — Python, AI и боты | АйДаКемп"
  canonical="https://aidacamp.ru/lager-12-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для подростков 12 лет в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для 11–13 лет в АйДаКемп — Python среднего уровня, Telegram-боты и Gemini API (Google AI). Подростки пишут функции, работают с библиотеками, подключают API, создают рабочего Telegram-бота с AI. Финал смены — защита проекта перед всем лагерем." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь подростку 12 лет без опыта?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Для группы 11–13 лет есть два трека: начинающие и те, кто уже знаком с Python базово. На старте смены все проходят вводную диагностику, программа адаптируется." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает подросток 12 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены подросток защищает проект: рабочий Telegram-бот с Gemini AI, Python-программа с API или мод для Roblox/Minecraft. Бот можно запустить и показать друзьям прямо со смартфона." }
        },
        {
          "@type": "Question",
          "name": "Есть ли места в июле?",
          "acceptedAnswer": { "@type": "Answer", "text": "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена для подростка 12 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 2.1 (7 дней, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание в санатории, питание, все занятия и вечерние активности. Доступен налоговый вычет 13%." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для подростков 12 лет — Python, Gemini AI и боты"
    subtitle="Подростковый возраст — лучшее время начать. Здесь делают реальные проекты с AI и находят тех, кому интересно то же самое."
    breadcrumb="Лагерь для подростков 12 лет"
    keywords={["Python + Gemini AI + Telegram-боты", "Рабочий AI-бот к концу смены", "Вожатый 1:8, медработник 24/7"]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="Лагерь для подростков 12 лет"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у подростков и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему подростки теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
