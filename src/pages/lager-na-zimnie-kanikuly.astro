---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import SeasonPreRegister from '../components/SeasonPreRegister.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const sections = [
  {
    h2: "Зимние каникулы — 10+ дней без школы",
    text: "Зимние каникулы — самые длинные в году после летних. Почти две недели, когда школьники полностью свободны. Только вот дома это время чаще всего означает одно: ребёнок лежит с планшетом, смотрит ролики и к концу каникул чувствует себя опустошённым. Не потому что плохой ребёнок — просто нечем заняться. IT-лагерь на зимние каникулы меняет эту картину. Десять дней с живыми людьми, реальной задачей и ощущением «я это сделал». Возвращается — с проектом в портфолио и энергией на новый семестр."
  },
  {
    h2: "Программа на зимние каникулы",
    text: "За 7–10 дней зимней смены ребята проходят полноценный интенсив — плотнее, чем летом, потому что времени меньше. Программа подбирается по возрасту: Scratch и Minecraft для 7–10 лет, Python и AI для 10–15 лет. Roblox Studio — для тех, кто хочет создавать игры, а не только в них играть. Каждый трек заканчивается хакатоном в финале: команды презентуют проекты, как на настоящей конференции.",
    list: [
      "Scratch — визуальное программирование для детей 7–10 лет, первые игры и анимации",
      "Minecraft Education — создание миров и редстоун-механика для 8–12 лет",
      "Python с нуля — переменные, функции, боты. Для 10–15 лет без опыта",
      "AI и нейросети — ChatGPT API, генерация изображений, AI-помощники для 12–15 лет",
      "Roblox Studio + Lua — разработка 3D-игр для 10–14 лет",
      "Хакатон в финале: командный проект, питч, внутренняя «валюта» лагеря"
    ]
  },
  {
    h2: "Даты и стоимость",
    text: `Зимние каникулы 2026–2027 — ориентировочно с 28–30 декабря по 8–10 января. Даты смен пока предварительные: школы опубликуют расписание каникул в сентябре, и мы сразу скорректируем даты под него. АйДаКемп проводит зимние смены 7–10 дней на базе санатория «Изумруд» в Подмосковье. Стоимость — от ${PRICE_MIN}, в цену включены проживание, пятиразовое питание, IT-программа и все активности.`,
    list: [
      `7 дней — от ${PRICE_MIN}, интенсивный формат, идеально для первого раза`,
      "10 дней — полноценная смена с хакатоном и дополнительными модулями",
      "Даты предварительные — уточним в сентябре по расписанию школьных каникул",
      "В стоимость включено: проживание, 5-разовое питание, IT-программа, все активности",
      "Образовательная лицензия — можно оформить налоговый вычет 13%",
      "Бронирование: 50% предоплата фиксирует место, остаток за 3 недели до заезда",
      "Предварительная запись без оплаты — форма ниже, напишем первыми при подтверждении дат"
    ]
  },
  {
    h2: "Почему лагерь, а не дома?",
    text: "Честный ответ: дома на зимних каникулах дети маются. Первый день — отдых, второй — игры, третий — уже скучно. Дальше начинается бесконечный сериал и зависание в соцсетях. К школе ребёнок возвращается разбитым, а не отдохнувшим. В лагере всё иначе. Живые друзья, общий проект, ощущение что ты часть команды. Дети сами не замечают, как проходит время — они заняты. А вы знаете, что ваш ребёнок в безопасности, тепле и делает что-то настоящее.",
    list: [
      "Новые друзья — ребята из разных городов с похожими интересами",
      "Живое общение вместо чата: командная работа, споры, совместные решения",
      "Реальный проект в портфолио — не просто «прошёл курс», а сделал что-то своё",
      "Отапливаемые корпуса санатория — зима комфортна, не страшна",
      "Возвращается с энергией и планами, а не опустошённым от гаджетов"
    ]
  }
];

const schemaJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь на зимние каникулы", "item": "https://aidacamp.ru/lager-na-zimnie-kanikuly" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Когда зимние каникулы 2026–2027?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ориентировочно с 28–30 декабря по 8–10 января. Школы опубликуют расписание каникул в сентябре — тогда мы скорректируем даты смен. Оставьте предварительную заявку без оплаты, и мы напишем первыми." }
        },
        {
          "@type": "Question",
          "name": "Холодно ли в лагере зимой?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп проходит в отапливаемых корпусах санатория «Изумруд». Занятия — в тёплых учебных классах. На улице — по желанию: прогулки, снежные активности. Тёплая одежда рекомендуется." }
        },
        {
          "@type": "Question",
          "name": "За сколько дней бронировать?",
          "acceptedAnswer": { "@type": "Answer", "text": "Зимние смены — самые популярные после лета. Рекомендуем бронировать за 2–3 месяца, то есть уже в сентябре-октябре. 50% предоплата фиксирует место." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли ребёнку без опыта программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, без проблем. Группы разбиваем по уровню: новички, средний, продвинутый. Начинаем с нуля — за 7–10 дней освоят базовый Python или Scratch и сделают первый проект." }
        }
      ]
    }
  ]
});
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="IT-лагерь на зимние каникулы 2026–2027 в Подмосковье | АйДаКемп"
  description={`Детский IT-лагерь на зимние каникулы 2026–2027. Программирование, AI, командные проекты в Подмосковье. 7–10 дней. Предварительная запись открыта. От ${PRICE_MIN}.`}
  h1="IT-лагерь на зимние каникулы 2026–2027"
  canonical="https://aidacamp.ru/lager-na-zimnie-kanikuly"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schemaJsonLd} />
  </Fragment>

  <LandingHero slot="hero"
    h1="IT-лагерь на зимние каникулы 2026–2027"
    subtitle="Пока другие дети скучают за экраном — ваш программирует. И сам не замечает что отдыхает."
    breadcrumb="Лагерь на зимние каникулы"
    keywords={[
      "Тёплые корпуса санатория — занятия без морозов на улице",
      "Новые друзья на новый год — без родителей",
      "Программирование за 7–10 дней: первый настоящий проект"
    ]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="IT-лагерь на зимние каникулы АйДаКемп"
  />

  <LandingTwoCol sections={sections} />
  <SeasonPreRegister seasonAcc="зимнюю смену 2026–2027" slug="zima-2026-27" />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
