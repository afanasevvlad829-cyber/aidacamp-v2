---
export const prerender = false;
import Base from '../layouts/Base.astro';
---

<Base title="Оплата не прошла — АйДаКемп" description="Не удалось провести оплату">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-b from-red-50 to-white px-4 py-16">
    <div class="w-full max-w-md text-center">

      <div class="mb-6 flex justify-center">
        <div class="w-20 h-20 rounded-full bg-red-100 flex items-center justify-center">
          <i class="bi bi-x-circle-fill text-red-400 text-[44px]" aria-hidden="true"></i>
        </div>
      </div>

      <h1 class="text-[28px] font-extrabold text-gray-900 mb-2">Оплата не прошла</h1>
      <p class="text-gray-500 text-base mb-8">
        Что-то пошло не так. Карта не списана. Можете попробовать ещё раз — место пока за вами.
      </p>

      <div class="space-y-3">
        <a href="/"
           class="flex items-center justify-center gap-2 rounded-xl bg-orange-500 hover:bg-orange-600 py-3 font-bold text-white text-base transition-colors no-underline">
          <i class="bi bi-arrow-repeat text-[16px]" aria-hidden="true"></i>
          Попробовать снова
        </a>
        <a href="https://t.me/AidaCampDarya"
           class="flex items-center justify-center gap-2 rounded-xl border border-gray-200 py-3 font-semibold text-gray-600 text-base hover:bg-gray-50 transition-colors no-underline">
          <i class="bi bi-telegram text-base" aria-hidden="true"></i>
          Написать нам
        </a>
      </div>

    </div>
  </main>
</Base>
