---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему лагерь с проживанием — это другой результат, чем кружок",
    text: "Детский лагерь с проживанием — это другой результат по сравнению с любым кружком или дневным форматом. Кружок по программированию — два часа в неделю, а тут — 10–14 дней полного погружения: с утра до вечера занятия, вечером — командная работа над проектом, ночью — обсуждение идей с соседями по комнате. Такой формат невозможно воспроизвести кружком. Профессиональная IT-программа от практикующих разработчиков — не школьный учебник, а реальные задачи с результатом в руках к концу смены.",
    list: [
      "Иммерсия: 8–10 часов в день вокруг IT-тематики против 2 часов в неделю",
      "Командная динамика формируется к 3-му дню — в кружке её нет никогда",
      "Проект делается до конца: нет причины бросить на полпути",
      "Подросток сам строит режим, учится самостоятельности без родителей рядом",
      "Окружение: рядом 50–80 сверстников с теми же интересами"
    ]
  },
  {
    h2: "Что входит в стоимость: проживание, питание, безопасность",
    text: "Детский отдых — без скрытых доплат. В цену смены в нашем лагере входит всё необходимое, родителям не нужно доплачивать за дополнительные активности или оборудование. Такой подход одинаково подходит и детям помладше, и подросткам постарше — подросток приезжает с вещами и больше ни о чём не думает.",
    list: [
      "Проживание в комнатах 2–4 человека — уютные, не казарменные",
      "В каждом номере — полноценный санузел с душевой кабиной и ежедневная уборка: это санаторий, а не палаточный лагерь",
      "Жить в АйДаКемп комфортно: санаторный корпус, нормальные кровати, горячая вода всегда",
      "5-разовое питание: завтрак, обед, полдник, ужин, вечерний перекус",
      "Закрытый бассейн — вечерние заплывы после учёбы",
      "Страховка от несчастных случаев на весь период смены",
      "Все учебные материалы, доступ к ноутбукам — своё устройство необязательно",
      "Занятия проходят дважды в день по 90 минут в группах до 8 человек",
      "Вечерние активности: игры, кино, настолки — без гаджетов"
    ]
  },
  {
    h2: "Где находится лагерь: Наро-Фоминский район, 66 км от МКАД",
    text: "АйДаКемп расположен в Наро-Фоминском районе, в Подмосковье — санаторий «Изумруд». IT-лагерь в Подмосковье с проживанием — выбор для тех, кому важно и качество программы, и загородная природа рядом с Москвой. Находится в Московской области, Наро-Фоминский округ, в 66 км от МКАД по Киевскому шоссе. Природа, лес, чистый воздух — и при этом нормальный интернет для работы с AI-API. Трансфер — от м. Солнцево.",
    list: [
      "Наро-Фоминский район — 66 км по Киевскому шоссе",
      "Трансфер от м. Солнцево, время в дороге ~1,5 часа",
      "Закрытая территория в лесу: бассейн, спортплощадки, зоны отдыха",
      "Активный отдых между занятиями — бассейн, спорт, прогулки в лесу — помогает школьнику не выгорать за 13 дней",
      "Спортивные площадки используются каждый день: волейбол, футбол — в дополнение к бассейну по вечерам",
      "Стабильный интернет для работы с внешними API и AI-сервисами",
      "Экологически чистый район, лес рядом с корпусами"
    ]
  },
  {
    h2: "Безопасность при проживании: что нужно знать родителям",
    text: "Безопасность детей — на первом месте. Закрытая территория, вожатые рядом 24/7, медработник на базе — всё как положено детям в этом возрасте. Родители видят фото из лагеря каждый день. Если у подростка что-то случается в лагере — звонят сразу.",
    list: [
      "Медпункт на территории, медработник круглосуточно",
      "Вожатые 1:8 — каждый подросток в зоне внимания всё время",
      "Закрытый периметр: чужие не заходят, свои не выходят самостоятельно",
      "Лицензия образовательной организации — Минобрнауки — позволяет оформить налоговый вычет 13% на стоимость смены",
      "Telegram-чат отряда: фото каждый день, родители видят как идёт смена",
      "Ночной дежурный — вожатый всегда доступен"
    ]
  },
  {
    h2: "Дневной формат или загородный: в чём разница",
    text: "Оба формата имеют право на жизнь, но результаты разные. Дневной формат подходит младшим (7–9 лет) или при повышенной тревожности — загородный формат рекомендуем для 10–15 лет: именно тут происходит настоящий рост.",
    list: [
      "Дневной лагерь: ребёнок возвращается домой → нет вечернего погружения, нет командной динамики ночью",
      "В загородном формате: подросток живёт в среде 24/7 → проект строится не только на занятиях",
      "Дневной: родители на связи каждый день → подросток не учится самостоятельности",
      "В загородном формате: первая «взрослая» ответственность — режим, вещи, конфликты в команде"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} с проживанием: даты, цены, как выбрать`,
    text: "Все смены АйДаКемп — с проживанием. Это базовый формат лагеря. Смена 4 (10 дней) подходит для первого раза — чтобы попробовать и убедиться. Смена 3 (13 дней) даёт максимальный результат в проекте.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Июньские смены прошли. На август места есть — бронируйте заранее"
    ]
  },
  {
    h2: "Детский лагерь: как выбрать между несколькими",
    text: "Детский лагерь — это в первую очередь выбор, а не просто бронь. У родителей обычно на примете сразу несколько лагерей, и разница между ними видна не в рекламе, а в деталях: сколько детей приходится на одного вожатого, что входит в стоимость, как быстро отвечают на вопросы. Такие детали важны не только родителям, но и самим детям — они быстро чувствуют разницу между форматами. Хороший детский лагерь честно рассказывает о себе — без глянцевых обещаний. Мы советуем сравнивать: позвоните в разные лагеря, задайте одинаковые вопросы, посмотрите, как быстро и подробно отвечают. В одних лагерях группы по 15–20 детей, в других — по 6–8, как у нас: разница в том, сколько внимания достанется именно вашему ребёнку. У детей, которые уже бывали в других детских лагерях, обычно есть с чем сравнить. Выбор лагеря — решение на всё лето, а не на один день, поэтому лучше потратить лишний час на сравнение, чем потом жалеть о поездке."
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`IT-лагерь с проживанием в Подмосковье на лето ${SEASON_YEAR} | АйДаКемп`}
  description={`IT-лагерь с проживанием в Подмосковье ${SEASON_YEAR}. 5-разовое питание, бассейн, медработник 24/7, вожатый 1:8. Наро-Фоминский район, 66 км от МКАД. От ${PRICE_MIN}.`}
  h1={`Лагерь с проживанием в Подмосковье`}
  canonical="https://aidacamp.ru/it-lager-s-prozhivaniem"
>
  <LandingHero slot="hero"
    h1={`Лагерь с проживанием в Подмосковье`}
    subtitle="Санаторный корпус, бассейн, медработник 24/7 — за летнюю смену успевают отдохнуть и создать проект. Наро-Фоминский район, 66 км от МКАД. Трансфер от м. Солнцево."
    breadcrumb="Загородный формат"
    keywords={["Проживание 2–4 чел., всё включено", "Медработник 24/7, вожатый 1:8", `От ${PRICE_MIN} за смену ${SEASON_YEAR}`]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="IT-лагерь для подростков в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что входит в стоимость IT-лагеря с проживанием?", a: "В стоимость входит проживание в комнатах 2–4 человека, 5-разовое питание, закрытый бассейн, все учебные материалы и доступ к ноутбукам. Доплачивать за дополнительные активности не нужно." },
    { q: "Где находится лагерь АйДаКемп?", a: "АйДаКемп расположен в Наро-Фоминском районе, в Подмосковье, 66 км от МКАД по Киевскому шоссе. Трансфер от м. Солнцево, время в дороге около 1,5 часов." },
    { q: "Насколько безопасно проживание в IT-лагере?", a: "Безопасность детей и подростков обеспечена по всем правилам: закрытая территория, вожатые 1:8 круглосуточно, медработник на базе 24/7, Telegram-фото из отряда каждый день. Родители видят как идёт смена и всегда могут связаться с вожатым." },
    { q: "В чём разница между дневным IT-лагерем и загородным?", a: "Полное погружение: подросток 10–14 дней живёт в IT-среде 24/7. Командная динамика, самостоятельность, проект до конца — это невозможно воспроизвести в дневном формате. Дневной подходит для младших или для первого знакомства." },
    { q: `Сколько стоит лагерь АйДаКемп в ${SEASON_YEAR} году?`, a: `От ${PRICE_MIN} за 10-дневную смену (${DATES_SHORT_S4} ${SEASON_YEAR}). Смены 10–13 дней — от ${PRICE_S4} до ${PRICE_MAX}. Доступен налоговый вычет 13%.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedArticles articles={[
    { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", description: "Как подготовить подростка и не переживать самой.", icon: "file-earmark-text" },
    { title: "Ребёнок заболел в лагере", url: "/stati/rebenok-zabolel-v-lagere/", description: "Что делать, медпункт, как связаться с вожатым.", icon: "heart-pulse-fill" },
    { title: "Документы для ребёнка в лагерь", url: "/stati/dokumenty-dlya-rebenka-v-lager/", description: `Полный чек-лист документов ${SEASON_YEAR}.`, icon: "file-earmark-text" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
