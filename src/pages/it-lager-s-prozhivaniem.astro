---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Почему лагерь с проживанием — это другой результат, чем кружок",
    text: "Детский лагерь с проживанием — это другой результат по сравнению с любым кружком или дневным форматом. Кружок по программированию — два часа в неделю. Лагерь с проживанием — это 10–14 дней полного погружения: с утра до вечера занятия, вечером — командная работа над проектом, ночью — обсуждение идей с соседями по комнате. Такой формат невозможно воспроизвести кружком. Профессиональная IT-программа от практикующих разработчиков — не школьный учебник, а реальные задачи с результатом в руках к концу смены.",
    list: [
      "Иммерсия: 8–10 часов в день вокруг IT-тематики против 2 часов в неделю",
      "Командная динамика формируется к 3-му дню — в кружке её нет никогда",
      "Проект делается до конца: нет причины бросить на полпути",
      "Подросток сам строит режим, учится самостоятельности без родителей рядом",
      "Окружение: рядом 50–80 сверстников с теми же интересами"
    ]
  },
  {
    h2: "Что входит в стоимость: проживание, питание, безопасность",
    text: "В цену смены АйДаКемп входит всё необходимое — родителям не нужно доплачивать за дополнительные активности или оборудование. Подросток приезжает с вещами — и больше ни о чём не думает.",
    list: [
      "Проживание в комнатах 2–4 человека — уютные, не казарменные",
      "В каждом номере — полноценный санузел с душевой кабиной и ежедневная уборка: это санаторий, а не палаточный лагерь",
      "Жить в АйДаКемп комфортно: санаторный корпус, нормальные кровати, горячая вода всегда",
      "5-разовое питание: завтрак, обед, полдник, ужин, вечерний перекус",
      "Закрытый бассейн — вечерние заплывы после учёбы",
      "Страховка от несчастных случаев на весь период смены",
      "Все учебные материалы, доступ к ноутбукам — своё устройство необязательно",
      "Занятия проходят дважды в день по 90 минут в группах до 8 человек",
      "Вечерние активности: игры, кино, настолки — без гаджетов"
    ]
  },
  {
    h2: "Где находится лагерь: Наро-Фоминский район, 66 км от МКАД",
    text: "АйДаКемп расположен в Наро-Фоминском районе Подмосковья — санаторий «Изумруд». IT-лагерь в Подмосковье с проживанием — выбор для тех, кому важно и качество программы, и загородная природа рядом с Москвой. Лагерь работает в Московской области — Наро-Фоминский округ, в 66 км от МКАД по Киевскому шоссе. Природа, лес, чистый воздух — и при этом нормальный интернет для работы с AI-API. Трансфер организует лагерь: отправление от м. Солнцево.",
    list: [
      "Наро-Фоминский район — 66 км по Киевскому шоссе",
      "Трансфер от м. Солнцево, время в дороге ~1,5 часа",
      "Закрытая территория в лесу: бассейн, спортплощадки, зоны отдыха",
      "Активный отдых между занятиями — бассейн, спорт, прогулки в лесу — помогает школьнику не выгорать за 13 дней",
      "Спортивные площадки используются каждый день: волейбол, футбол — в дополнение к бассейну по вечерам",
      "Стабильный интернет для работы с внешними API и AI-сервисами",
      "Экологически чистый район, лес рядом с корпусами"
    ]
  },
  {
    h2: "Безопасность при проживании: что нужно знать родителям",
    text: "Закрытая территория, вожатые рядом 24/7, медработник на базе — всё как положено. Родители видят фото из лагеря каждый день. Если у подростка что-то случается — звонят сразу.",
    list: [
      "Медпункт на территории, медработник круглосуточно",
      "Вожатые 1:8 — каждый подросток в зоне внимания всё время",
      "Закрытый периметр: чужие не заходят, свои не выходят самостоятельно",
      "Лицензия образовательной организации — Минобрнауки — позволяет оформить налоговый вычет 13% на стоимость смены",
      "Telegram-чат отряда: фото каждый день, родители видят как идёт смена",
      "Ночной дежурный — вожатый всегда доступен"
    ]
  },
  {
    h2: "Дневной лагерь или с проживанием: в чём разница",
    text: "Оба формата имеют право на жизнь. Но результаты — разные. Вот честное сравнение:",
    list: [
      "Дневной лагерь: ребёнок возвращается домой → нет вечернего погружения, нет командной динамики ночью",
      "С проживанием: подросток живёт в среде 24/7 → проект строится не только на занятиях",
      "Дневной: родители на связи каждый день → подросток не учится самостоятельности",
      "С проживанием: первая «взрослая» ответственность — режим, вещи, конфликты в команде",
      "Дневной: подходит для младших (7–9 лет) или при повышенной тревожности",
      "С проживанием: рекомендуем для 10–15 лет — именно здесь происходит настоящий рост"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} с проживанием: даты, цены, как выбрать`,
    text: "Все смены АйДаКемп — с проживанием. Это базовый формат лагеря. Смена 4 (10 дней) подходит для первого раза — чтобы попробовать и убедиться. Смена 3 (13 дней) даёт максимальный результат в проекте.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней с проживанием — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней с проживанием — ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней с проживанием — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней с проживанием — ${PRICE_S4}`,
      "Июньские смены прошли. На август места есть — бронируйте заранее"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-podrostkov.avif"
  title={`IT-лагерь с проживанием в Подмосковье ${SEASON_YEAR} | АйДаКемп`}
  description={`IT-лагерь с проживанием в Подмосковье ${SEASON_YEAR}. 5-разовое питание, бассейн, медработник 24/7, вожатый 1:8. Наро-Фоминский район, 66 км от МКАД. От ${PRICE_MIN}.`}
  h1={`IT-лагерь с проживанием в Подмосковье ${SEASON_YEAR} — полное погружение`}
  canonical="https://aidacamp.ru/it-lager-s-prozhivaniem"
>
  <Fragment slot="head">
    
    <FAQSchema items={[
    { q: "Что входит в стоимость IT-лагеря с проживанием?", a: "В стоимость входит проживание в комнатах 2–4 человека, 5-разовое питание, закрытый бассейн, все учебные материалы и доступ к ноутбукам. Доплачивать за дополнительные активности не нужно." },
    { q: "Где находится IT-лагерь с проживанием?", a: "АйДаКемп расположен в Наро-Фоминском районе Подмосковья, 66 км от МКАД по Киевскому шоссе. Трансфер от м. Солнцево, время в дороге около 1,5 часов." },
    { q: "Насколько безопасно проживание в IT-лагере?", a: "Закрытая территория, вожатые 1:8 круглосуточно, медработник на базе 24/7, Telegram-фото из отряда каждый день. Родители видят как идёт смена и всегда могут связаться с вожатым." },
    { q: "В чём разница между дневным IT-лагерем и с проживанием?", a: "Лагерь с проживанием даёт полное погружение: подросток 10–14 дней живёт в IT-среде 24/7. Командная динамика, самостоятельность, проект до конца — это невозможно воспроизвести в дневном формате. Дневной подходит для младших или для первого знакомства." },
    { q: `Сколько стоит IT-лагерь с проживанием в ${SEASON_YEAR} году?`, a: `От ${PRICE_MIN} за 10-дневную смену (${DATES_SHORT_S4} ${SEASON_YEAR}). Смены 10–13 дней — от ${PRICE_S4} до ${PRICE_MAX}. Все смены — с проживанием. Доступен налоговый вычет 13%.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`IT-лагерь с проживанием в Подмосковье ${SEASON_YEAR} — полное погружение`}
    subtitle="5-разовое питание, бассейн, медработник 24/7 — за летнюю смену успевают отдохнуть и создать проект. Наро-Фоминский район, 66 км от МКАД. Трансфер от м. Солнцево."
    breadcrumb="IT-лагерь с проживанием"
    keywords={["Проживание 2–4 чел. в комнате, питание включено", "Медработник 24/7, вожатый 1:8", `От ${PRICE_MIN} за смену ${SEASON_YEAR}`]}
    image="/images/hero/lager-dlya-podrostkov.avif"
    imageAlt="IT-лагерь с проживанием в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedArticles articles={[
    { title: "Ребёнок первый раз в лагере", url: "/stati/pervyj-raz-v-lagere/", description: "Как подготовить подростка и не переживать самой.", icon: "file-earmark-text" },
    { title: "Ребёнок заболел в лагере", url: "/stati/rebenok-zabolel-v-lagere/", description: "Что делать, медпункт, как связаться с вожатым.", icon: "heart-pulse-fill" },
    { title: "Документы для ребёнка в лагерь", url: "/stati/dokumenty-dlya-rebenka-v-lager/", description: `Полный чек-лист документов ${SEASON_YEAR}.`, icon: "file-earmark-text" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet/", description: "Апатия у подростка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
