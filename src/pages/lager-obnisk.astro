---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { OPEN_MONTHS_ADJ } from '../data/evergreen';

const sections = [
  {
    h2: "Обнинск — совсем рядом",
    text: "АйДаКемп стоит в санатории «Изумруд» в Наро-Фоминском районе — около 100 км по прямой. Маршрут простой: Киевское шоссе на север, около часа без пробок. Трансфер идёт от м. Солнцево (2 000 ₽), но большинство родителей привозят ребят сами — дорога понятная, ехать недолго."
  },
  {
    h2: "Первый наукоград России — здесь ценят IT",
    text: "Обнинск — первый в стране город со статусом наукограда. Ядерная физика, НИФХИ, ИАТЭ — здесь работают люди, которые умеют думать точно и строго. Родители, как правило, хорошо понимают, чем реальное обучение отличается от модного маркетинга. У нас — учебник по программированию (авторы — наши преподаватели), занятия дважды в день и проект на хакатоне, который можно показать на портфолио.",
    list: [
      "Практикующие IT-специалисты, авторы учебника по программированию",
      "Группы до 8 человек — индивидуальный подход каждому",
      "Итоговый хакатон — защита реального проекта, не демонстрация слайдов",
      `Лицензия Минобрнауки, вычет 13% — до ${VYCHET_MAX} за смену`
    ]
  },
  {
    h2: "Прямая дорога — одно шоссе без пересадок",
    text: "До санатория «Изумруд» — один прямой маршрут по Киевскому шоссе. Никаких пересадок и кружных путей. ~100 км, ~1 час — и ребёнок на месте. На хакатон в финале смены можно приехать и вернуться домой в тот же день.",
    list: [
      "Прямо по Киевскому шоссе — одна дорога без развязок",
      "~100 км, около часа езды",
      "Многие семьи привозят самостоятельно — трансфер необязателен",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников в лагере — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Ежедневные фото в Telegram-чат отряда — родители всегда знают, что происходит.",
    list: [
      "1 преподаватель на 6–8 ребят",
      "Медработник 24/7, охрана, закрытая территория санатория",
      "Ежедневные фото в Telegram-чат отряда",
      "Страховка включена в стоимость"
    ]
  },
  {
    h2: "Открыты августовские смены — места ещё есть",
    text: "Летние смены расходятся быстро. Многие узнают, что ехать всего час по прямой, — и записываются сразу. Сейчас открыты ${OPEN_MONTHS_ADJ} смены.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ (многие привозят сами)"
    ]
  },
  {
    h2: "Программы и направления IT-обучения",
    text: `В АйДаКемп каждый год новые программы и направления — с учётом детских интересов и уровня подготовки. Уточнить актуальное расписание ${SEASON_YEAR} года, выбрать уровень сложности и узнать, какие языки преподаются в конкретные сроки, можно в <a href="/stati/programma-it-lagerya/">разделе программ</a>. Обычно в лагере преподают:`,
    list: [
      "<strong>Python</strong> — самый популярный язык, с которого начинают новички",
      "<strong>AI и машинное обучение</strong> — для тех, кто хочет работать с нейросетями",
      "<strong>Minecraft-программирование</strong> — логика и творчество в игровой форме",
      "<strong>Веб-разработка</strong> — создание сайтов и интернет-приложений",
      "<strong>Мобильная разработка</strong> — приложения для смартфонов"
    ]
  },
  {
    h2: "Стоимость путёвки и налоговый вычет",
    text: `Открытые к брони августовские смены — от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. АйДаКемп работает по лицензии Минобрнауки, поэтому 13% стоимости путёвки можно вернуть через налоговый вычет — до ${VYCHET_MAX} за смену. Полная информация о <a href="/ceny/">ценах и вариантах оплаты</a> — на отдельной странице.`
  },
  {
    h2: "Что говорят родители",
    text: "Обнинск — научный город, родители ценят качественное IT-образование:",
    list: [
      "«Час по Киевскому — и дочь на месте. Это как кружок с ночёвкой, а не поездка «куда-то далеко». За две недели написала своего бота» — Татьяна, Обнинск",
      "«В Обнинске всегда ценили образование. АйДаКемп — наш выбор: сын вернулся с реальным проектом, а не просто загаром» — Дмитрий, Обнинск"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Обнинск: летний лагерь программирования для детей рядом | АйДаКемп"
  description={`Обнинск: летний IT-лагерь в часе езды. Python, AI, Minecraft для детей 7–15 лет, малые группы и итоговый хакатон. От ${PRICE_MIN}.`}
  h1="Обнинск: летний детский лагерь рядом"
  canonical="https://aidacamp.ru/lager-obnisk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Обнинска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Обнинска до лагеря ~100 км прямо по Киевскому шоссе на север — около 1 часа. Один прямой маршрут без пересадок. Организованный трансфер от м. Солнцево (2 000 ₽), но из Обнинска удобнее привезти самостоятельно." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Обнинска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа по Киевскому шоссе. Расстояние ~100 км. Прямой маршрут без развязок и пересадок — Обнинск стоит прямо на Киевском шоссе." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Обнинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Обнинска многие родители привозят самостоятельно — около 1 часа по прямой трассе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": `Открыты к брони августовские смены: от ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. В стоимость входит проживание, питание, IT-программа, бассейн и страховка.` }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Обнинском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1 час от Обнинска по Киевскому шоссе. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-obnisk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Обнинск: летний детский лагерь рядом"
    subtitle="IT-лагерь в Наро-Фоминском районе — час езды по Киевскому шоссе. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Обнинска"
    keywords={["Час езды по Киевскому шоссе напрямую", "Python, AI, Minecraft для ребят 7–15 лет", "Первый наукоград России выбирает нас"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Обнинском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
