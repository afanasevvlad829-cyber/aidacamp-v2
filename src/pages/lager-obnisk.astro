---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Обнинска до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — всего около 30 км от Обнинска. Маршрут: прямо по Калужскому шоссе на север, около 30 минут. Это один из самых близких городов к лагерю — ближе, чем от многих районов Москвы. Трансфер отправляется от м. Солнцево (2 500 ₽), но многие семьи из Обнинска привозят детей сами."
  },
  {
    h2: "Почему родители из Обнинска выбирают АйДаКемп",
    text: "Обнинск — ближайший крупный город к АйДаКемп. 30 минут по Калужскому шоссе, никакого перелёта и акклиматизации. Ребёнок в том же климате, дома — через 30 минут. При этом — загородная территория санатория, бассейн и настоящая IT-программа.",
    list: [
      "Всего 30 км по Калужскому шоссе — ближайший крупный город",
      "30 минут в пути — родители могут приехать в любой день",
      "Нет акклиматизации, привычный климат Подмосковья",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню подготовки. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Обнинска",
    text: "Обнинск — научный город, родители ценят качественное IT-образование. Вот что говорят семьи, которые уже побывали в АйДаКемп:",
    list: [
      "«30 минут — и мы дома. Это даже не лагерь «далеко», это как кружок с ночёвкой. Зато дочь за две недели написала своего бота» — Татьяна, Обнинск",
      "«В Обнинске всегда ценили образование. АйДаКемп — это наш выбор: сын вернулся с реальным проектом, а не просто загаром» — Дмитрий, Обнинск"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону (из Обнинска многие привозят сами).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Обнинск 2026 — АйДаКемп"
  description="IT-лагерь рядом с Обнинском: всего 30 минут по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет. Санаторий Изумруд. От 48 000 ₽."
  h1="Детский лагерь рядом с Обнинском"
  canonical="https://aidacamp.ru/lager-obnisk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Обнинска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Обнинска до лагеря всего ~30 км по Калужскому шоссе на север — около 30 минут. Это один из ближайших городов к АйДаКемп. Организованный трансфер от м. Солнцево (2 500 ₽), но из Обнинска удобнее привезти самостоятельно." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Обнинска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 30 минут по Калужскому шоссе. Расстояние ~30 км. Обнинск — один из ближайших городов к лагерю." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Обнинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 500 ₽). Из Обнинска многие родители привозят детей самостоятельно — всего 30 минут езды." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней. 14-дневная смена — 95 000 ₽. Август: 89 400 ₽ (13 дней) и 74 900 ₽ (10 дней). В стоимость входит проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Обнинском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 30 минут от Обнинска. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-obnisk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Обнинском"
    subtitle="IT-лагерь в Наро-Фоминском районе — всего 30 минут от Обнинска по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Обнинска"
    keywords={["30 минут от Обнинска по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Обнинском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
