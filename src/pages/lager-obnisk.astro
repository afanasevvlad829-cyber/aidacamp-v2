---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Как добраться из Обнинска до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — всего около 100 км от Обнинска. Маршрут прямой: Киевское шоссе на север, около 1 часа без пробок. Это один из самых близких крупных городов к лагерю. Организованный трансфер отправляется от м. Солнцево (2 000 ₽), но семьи из Обнинска чаще привозят ребят самостоятельно."
  },
  {
    h2: "Первый наукоград России — здесь ценят IT",
    text: "Обнинск — первый в стране город со статусом наукограда. Ядерная физика, НИФХИ, ИАТЭ — здесь работают люди, которые умеют думать точно и строго. Родители из Обнинска, как правило, хорошо понимают, чем реальное обучение отличается от модного маркетинга. АйДаКемп — это учебник по программированию (авторы — наши преподаватели), занятия дважды в день и проект на хакатоне, который можно показать на портфолио.",
    list: [
      "Практикующие IT-специалисты, авторы учебника по программированию",
      "Группы до 8 человек — индивидуальный подход каждому",
      "Итоговый хакатон — защита реального проекта, не демонстрация слайдов",
      `Лицензия Минобрнауки, вычет 13% — до ${VYCHET_MAX} за смену`
    ]
  },
  {
    h2: "Прямая дорога — Киевское шоссе до лагеря",
    text: "Из Обнинска до санатория «Изумруд» — один прямой маршрут по Киевскому шоссе. Никаких пересадок и кружных путей. ~100 км, ~1 час — и ребёнок на месте. Родители из Обнинска могут приехать на хакатон в финале смены и вернуться домой в тот же день.",
    list: [
      "Прямо по Киевскому шоссе — одна дорога без развязок",
      "~100 км, около часа езды",
      "Многие семьи привозят самостоятельно — трансфер необязателен",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Ежедневные фото в Telegram-чат отряда — родители всегда знают, что происходит.",
    list: [
      "1 преподаватель на 6–8 ребят",
      "Медработник 24/7, охрана, закрытая территория санатория",
      "Ежедневные фото в Telegram-чат отряда",
      "Застрахована ответственность туроператора (Росгосстрах)"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены расходятся первыми. Для Обнинска особенно актуально: кто узнаёт, что лагерь в 1 часе езды по прямой — записывается сразу. Июнь и август ещё открыты.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX}`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ (из Обнинска многие привозят сами)"
    ]
  },
  {
    h2: "Отзывы родителей из Обнинска",
    text: "Обнинск — научный город, родители ценят качественное IT-образование:",
    list: [
      "«Час по Киевскому — и дочь на месте. Это даже не лагерь «далеко», это как кружок с ночёвкой. За две недели написала своего бота» — Татьяна, Обнинск",
      "«В Обнинске всегда ценили образование. АйДаКемп — наш выбор: сын вернулся с реальным проектом, а не просто загаром» — Дмитрий, Обнинск"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Обнинск 2026 | АйДаКемп — 1 час по Киевскому, IT"
  description={`IT-лагерь рядом с Обнинском: 1 час по Киевскому шоссе напрямую. Python, AI, Minecraft для ребят 7–15 лет. Санаторий Изумруд. От ${PRICE_MIN}.`}
  h1="Детский лагерь Обнинск 2026 — АйДаКемп, 1 час по Киевскому"
  canonical="https://aidacamp.ru/lager-obnisk"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Обнинска до лагеря АйДаКемп?", a: "Из Обнинска до лагеря ~100 км прямо по Киевскому шоссе на север — около 1 часа. Один прямой маршрут без пересадок. Организованный трансфер от м. Солнцево (2 000 ₽), но из Обнинска удобнее привезти самостоятельно." },
    { q: "Сколько ехать из Обнинска до лагеря?", a: "Около 1 часа по Киевскому шоссе. Расстояние ~100 км. Прямой маршрут без развязок и пересадок — Обнинск стоит прямо на Киевском шоссе." },
    { q: "Есть ли трансфер из Обнинска?", a: "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Обнинска многие родители привозят самостоятельно — около 1 часа по прямой трассе." },
    { q: "Сколько стоит путёвка в лагерь?", a: `От ${PRICE_MIN} за смену 7 дней. 14-дневная смена — ${PRICE_MAX}. Август: ${PRICE_S3} (13 дней) и ${PRICE_S4} (10 дней). В стоимость входит проживание, питание, IT-программа, бассейн.` },
    { q: "Есть ли детские лагеря рядом с Обнинском на лето 2026?", a: "АйДаКемп — IT-лагерь в 100 км от Обнинска по Киевскому шоссе (Наро-Фоминский район), работает летом 2026. Смены 7–14 дней, Python, AI, Minecraft для школьников 7–15 лет. Многие родители из Обнинска привозят самостоятельно — около 1 часа езды." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Обнинском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1 час от Обнинска по Киевскому шоссе. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-obnisk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь Обнинск 2026 — АйДаКемп, 1 час по Киевскому"
    subtitle="IT-лагерь в Наро-Фоминском районе — 1 час от Обнинска прямо по Киевскому шоссе. Python, AI, Minecraft для ребят 7–15 лет. Смены лето 2026."
    breadcrumb="Лагерь из Обнинска"
    keywords={["1 час от Обнинска по Киевскому шоссе напрямую", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Первый наукоград России — выбирает IT-лагерь"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Обнинском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
