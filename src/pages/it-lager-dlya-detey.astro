---
import { PRICE_MIN, PRICE_MAX, VYCHET_MAX, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Gallery from '../components/Gallery.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import FAQSchema from '../components/FAQSchema.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний IT-лагерь для детей: программирование в Подмосковье"
  description={`Компьютерный IT-лагерь АйДаКемп с программированием: Python, AI, Minecraft, Roblox для школьников 7–15 лет в Подмосковье. Группы до 8 человек, летние смены 10–13 дней с проживанием и бассейном, цена от ${PRICE_MIN}.`}
  h1={`Летний IT-лагерь для детей в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/it-lager-dlya-detey"
>
  <Fragment slot="head">
    <FAQSchema items={[
      {
        q: "Что такое IT лагерь для детей?",
        a: "IT лагерь для детей — загородный лагерь с проживанием, где школьник 7–15 лет совмещает отдых с реальной работой над IT-проектом. В отличие от кружка (1–2 часа в неделю), здесь полное погружение: занятия дважды в день в группах до 8 человек. В финале — хакатон: каждый защищает собственный проект перед жюри и уходит домой с готовой игрой или ботом."
      },
      {
        q: "С какого возраста можно в IT лагерь?",
        a: "АйДаКемп принимает школьников от 7 лет. Программа подбирается по возрасту: 7–9 лет — Minecraft и Scratch, 10–12 лет — Python и Roblox, 13–15 лет — AI и боты. Каждая группа до 8 человек, поэтому уровень и темп у всех свой."
      },
      {
        q: "Нужен ли опыт программирования для IT лагеря?",
        a: "Нет. Большинство ребят приезжают с нулевым опытом — это норма. На старте смены преподаватель проводит быструю диагностику и подбирает задачи по уровню. Те, кто никогда не видел код, начинают со Scratch или Minecraft. Уже за первые дни смены — первая работающая игра."
      }
    ]} />
  </Fragment>

  <LandingHero slot="hero"
    h1={`Летний IT-лагерь для детей в Подмосковье ${SEASON_YEAR}`}
    subtitle="Ваш ребёнок обожает компьютер? За одну смену он не просто поиграет — а сам создаст игру. Школьники 7–15 лет, программы Python, AI, Minecraft, Roblox. Подмосковье, группы до 8 чел."
    breadcrumb="IT лагерь для детей"
    keywords={[
      "Программы по возрасту: Scratch 7–9 лет, Python 10–12, AI 13–15",
      "Группы до 8 чел. — преподаватель знает каждого по имени",
      "В конце смены — хакатон: ребёнок защищает свой проект перед жюри"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="IT лагерь для детей АйДаКемп Подмосковье"
  />

  <!-- Featured snippet -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-blue-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="chto-takoe-it-lager-dlya-detey">Что такое IT лагерь для детей?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>IT лагерь для детей</strong> — загородный лагерь с проживанием, где школьник совмещает отдых с реальной работой над IT-проектом.
      В отличие от городского кружка (1–2 часа в неделю), здесь полное погружение: 10 или 13 дней, занятия дважды в день,
      группы до 8 человек. Программы подбираются по возрасту — от Scratch и Minecraft для младших до Python и AI для старших.
      В финале — хакатон: каждый защищает свой проект и уходит домой с готовым результатом.
      Провести летние каникулы с реальным результатом — это и есть суть летнего IT-лагеря.
    </p>
  </section>

  <!-- Цитата Дарьи -->
  <div class="max-w-3xl mx-auto px-4 mb-8">
    <div class="flex items-start gap-4 p-6 bg-orange-50 rounded-[20px] border border-orange-100">
      <div class="shrink-0 w-12 h-12 rounded-full bg-primary flex items-center justify-center">
        <i class="bi bi-person-fill text-white text-[20px]" aria-hidden="true"></i>
      </div>
      <div>
        <p class="text-base font-semibold text-slate-900 mb-1">Дарья Афанасьева, основатель АйДаКемп</p>
        <p class="text-[16px] leading-[1.65] text-slate-700">
          «Моя дочь открывала Roblox сразу после завтрака. Я пробовала ограничивать — помогало на день-два.
          Тогда я нашла другой способ: место, где её любовь к игре превращается в умение эти игры создавать.
          Через неделю она звонила и объясняла, как написала собственный уровень на Lua.
          Если ваш ребёнок тоже "живёт" в компьютере — я точно знаю, что с этим делать.»
        </p>
      </div>
    </div>
  </div>

  <LandingTwoCol
    priceFrom={PRICE_MIN}
    priceNote="за 10-дневную смену, всё включено"
    highlights={[
      "Группы до 8 школьников — не поток",
      "Программа по возрасту: 7–9 / 10–12 / 13–15 лет",
      "Хакатон в финале — каждый защищает свой проект",
      `Налоговый вычет до ${VYCHET_MAX}`,
      "Лицензия Минобрнауки, медработник на смене"
    ]}
    sections={[
      {
        h2: "IT лагерь для детей — чем отличается от кружка",
        text: "В кружке ребёнок получает знания — 1–2 часа в неделю, между которыми всё забывается. Формат IT-лагеря — полное погружение: 10 или 13 дней, занятия дважды в день в небольшой группе, один конкретный проект от первого дня до финального хакатона. Домой уходит не «я немного учился программировать», а «вот мой бот, смотри как он работает». Плюс — бассейн, спортивные площадки, вечерние активности и новые друзья. И всё это без гаджета в руках, потому что за компьютером интереснее создавать, чем листать.",
        list: [
          "Кружок: 1–2 часа в неделю → IT лагерь: дважды в день, 10–13 дней подряд",
          "Кружок: учебная задача → IT лагерь: собственный проект от А до Я",
          "Кружок: знания (теория) → IT лагерь: готовый результат + диплом + хакатон",
          "Кружок: 10–20 человек → IT лагерь: до 8 школьников, преподаватель знает каждого"
        ]
      },
      {
        h2: "Программы по возрастам — каждый найдёт своё",
        text: "Не бывает одной программы «для всех детей». Направления обучения охватывают ключевые области IT-технологий: от визуального программирования до работы с нейросетями и AI. В АйДаКемпе треки подбираются по возрасту и интересам при записи — так, чтобы ребёнку было интересно с первого дня. Каждый трек строится так, чтобы развивать интерес к IT через конкретный результат — не через абстрактные задания, а через собственный проект.",
        list: [
          "<strong>7–9 лет:</strong> Minecraft Education и Scratch — первые шаги в коде в игровом формате, без «взрослого» синтаксиса. За смену — своя карта или анимированная история.",
          "<strong>10–12 лет:</strong> Python и Roblox Studio — настоящий код, 3D-игра на Lua. Подходит тем, кто уже поиграл достаточно и хочет понять, как это сделано.",
          "<strong>13–15 лет:</strong> AI и нейросети, Telegram-боты на Python — работа с ChatGPT API, Gemini, генерация. За смену — рабочий бот или AI-инструмент, который можно показать друзьям.",
          "Нулевой опыт — нормально: на старте смены преподаватель проводит диагностику и ставит задачи по уровню"
        ]
      },
      {
        h2: "Что ребёнок сделает за смену — конкретно",
        text: "Это не «познакомится с программированием». За каждую смену есть конкретный результат, который можно запустить, показать и оставить себе.",
        list: [
          "7–9 лет: анимированная история на Scratch или своя карта в Minecraft с механиками",
          "10–12 лет: 3D-игра в Roblox Studio на Lua или первые скрипты на Python",
          "13–15 лет: рабочий Telegram-бот с AI или собственный инструмент на базе ChatGPT API",
          "Создание игр, ботов и AI-инструментов — не учебная задача, а личный проект, который остаётся у школьника после смены.",
          "В последний день — хакатон: ребёнок объясняет проект перед жюри и получает диплом",
          "После хакатона школьник уходит с реальными техническими навыками — не просто теорией, а работающим проектом.",
          "После смены проект остаётся в облаке — можно продолжать дома"
        ]
      },
      {
        h2: "Безопасность и официальность — всё по документам",
        text: "АйДаКемп — официальный образовательный лагерь с лицензией Минобрнауки. Мы работаем в санатории «Изумруд» в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе. Большинство участников — московские и подмосковные школьники: трансфер от м. Солнцево занимает около часа.",
        list: [
          "Закрытая территория: КПП, охрана 24/7 — посторонние не заходят",
          "Медицинский работник на территории всю смену, медпункт на месте",
          "Размещение по 2–4 человека, комнаты раздельные по полу",
          "Питание 5 раз в день — завтрак, обед, полдник, ужин, вечерний перекус",
          "Бассейн с ионизированной водой, спортплощадки, сосновый лес",
          "Фото в родительский Telegram-чат каждый день — видите, чем занимается ребёнок",
          "Лицензия Минобрнауки: документы для налогового вычета выдаём автоматически"
        ]
      },
      {
        h2: "Стоимость и налоговый вычет",
        text: `Стоимость путёвки — от ${PRICE_MIN} (10 дней) до ${PRICE_MAX} (13 дней). В цену включены: проживание, питание 5 раз в день, полная IT-программа, оборудование, бассейн. Ноутбук везти не нужно — всё есть на месте.<br><br>
        <strong>Налоговый вычет 13%</strong> — официальный лагерь с лицензией, документы выдаём сами. Возврат — до <strong>~${VYCHET_MAX}</strong> (максимум). Подробный расчёт — <a href="/nalogovyj-vychet/">на странице налоговый вычет</a>.<br><br>
        По отзывам родителей на Яндекс.Картах — оценка 5.0, ТОП-4 IT-лагерей Московской области.`,
        list: [
          `Смена 10 дней (Scratch / Minecraft / Roblox) — от ${PRICE_MIN}`,
          `Смена 13 дней (Python / AI / нейросети) — до ${PRICE_MAX}`,
          "Трансфер от м. Солнцево — опция при бронировании (2 000 ₽)",
          `Налоговый вычет: до ~${VYCHET_MAX} — зависит от длины смены`
        ]
      }
    ]}
  />

  <TaxCalculator variant="compact" />

  <Gallery />

  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />

</LandingLayout>
