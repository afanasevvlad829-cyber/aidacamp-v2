---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getInfoEffect } from '../lib/heroVariant';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';
const heroEffect = getInfoEffect('legal');
---

<Base
  title="Правовая информация и реквизиты детского лагеря АйДаКемп"
  description="Правовая информация АйДаКемп: реквизиты ООО «ВОИП КОННЕКТ», лицензия, данные туроператора, политика обработки персональных данных и документы детского IT-лагеря."
>
  <Header />
  <section class="relative overflow-hidden border-b border-white/10" data-hero-bg="glass-orbs" data-hero-effect={heroEffect}>
    <div class="relative z-10 mx-auto max-w-[980px] px-4 py-10">
      <nav class="mb-5 text-base text-white/65">
        <a href="/" class="hover:text-orange-300">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-white/85">Правовая информация</span>
      </nav>
      <h1 class="text-[24px] font-bold text-white md:text-[32px]">Правовая информация и реквизиты</h1>
      <p class="mt-2 text-base text-white/75">ООО «ВОИП КОННЕКТ» · Детский ИТ-лагерь #АйДаКемп</p>
    </div>
  </section>
  <main class="mx-auto max-w-[980px] px-4 py-8">

    <div class="mt-6 grid gap-4">
      <!-- Реквизиты / Реестр туроператоров -->
      <span id="touroperator" class="sr-only"></span>
      <section id="requisites" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Реквизиты</h2>
        <ul class="mt-3 space-y-1.5 text-base leading-[1.6] text-slate-600">
          <li>Организация: ООО «ВОИП КОННЕКТ»</li>
          <li>ИНН: 7729713637 · Реестровый номер туроператора: РТО {STAT_RTO}</li>
          <li>Контакты для документов и запросов: <a href="mailto:hello@codims.ru" class="text-primary underline">hello@codims.ru</a></li>
        </ul>
      </section>

      <!-- Сведения об организации -->
      <section id="org-info" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Сведения об организации</h2>
        <ul class="mt-3 space-y-1.5 text-base leading-[1.6] text-slate-600">
          <li>Полное наименование: ООО «ВОИП КОННЕКТ» / Детский ИТ-лагерь #АйДаКемп.</li>
          <li>Руководитель: Афанасьев Владимир Владимирович.</li>
          <li>Юридический адрес: 109542, г. Москва, Рязанский пр-кт, д. 86/1, стр. 3, комн. 13А.</li>
          <li>Офис продаж: г. Москва, ул. Лукинская, 8.</li>
          <li>Площадка проведения: Московская область, Наро-Фоминский городской округ, территория «Санаторий Изумруд», земельный участок 1.</li>
        </ul>
      </section>

      <!-- Сведения об отдыхе детей -->
      <section id="children-rest" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Сведения об организации отдыха детей и их оздоровления</h2>
        <ul class="mt-3 space-y-1.5 text-base leading-[1.6] text-slate-600">
          <li>Режим работы: сезонный, с 30 мая по 31 августа.</li>
          <li>Возрастная категория: дети 8–16 лет.</li>
          <li>Проживание: ЛОК «Изумруд», размещение в корпусах, бытовая инфраструктура лагеря.</li>
          <li>Питание: 5-разовое питание в столовой.</li>
          <li>Контакты: телефон <a href="tel:+74951284429" class="text-primary underline">+7 (495) 128-44-29</a>, email <a href="mailto:hello@codims.ru" class="text-primary underline">hello@codims.ru</a>.</li>
        </ul>
        <a href="https://aidacamp.ru/ob-organizacii-otdyha-detej-i-ozdarovleniya" target="_blank" rel="noopener" class="mt-3 inline-block text-base text-primary underline">Подробнее</a>
      </section>

      <!-- Условия для партнёров -->
      <section id="partners" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Условия для партнёров</h2>
        <p class="mt-3 text-base leading-[1.6] text-slate-600">Для турагентств и учреждений дополнительного образования действует партнёрский формат сотрудничества по агентскому договору.</p>
        <ul class="mt-2 space-y-1.5 text-base leading-[1.6] text-slate-600">
          <li>Партнёрская комиссия: 10% (по агентскому договору).</li>
          <li>Запрос коммерческих условий: <a href="mailto:hello@codims.ru" class="text-primary underline">hello@codims.ru</a></li>
        </ul>
        <a href="https://aidacamp.ru/partners" target="_blank" rel="noopener" class="mt-3 inline-block text-base text-primary underline">Подробнее</a>
      </section>

      <!-- Сотрудничество с блогерами -->
      <section id="bloggers" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Сотрудничество с блогерами и инфлюенсерами</h2>
        <p class="mt-3 text-base leading-[1.6] text-slate-600">Наша целевая аудитория — женщины 35–45 лет. Готовы рассмотреть покупку рекламы или бартер.</p>
        <p class="mt-2 text-base leading-[1.6] text-slate-600">По вопросам сотрудничества: <a href="mailto:hello@codims.ru" class="text-primary underline">hello@codims.ru</a></p>
      </section>

      <!-- Пользовательское соглашение (якорь для старых ссылок) -->
      <span id="terms" class="sr-only"></span>
      <span id="offer" class="sr-only"></span>

      <!-- Политика персональных данных (якорь для старых ссылок) -->
      <span id="privacy" class="sr-only"></span>
      <section class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Политика персональных данных</h2>
        <p class="mt-3 text-base leading-[1.6] text-slate-600">Документ опубликован на отдельной странице.</p>
        <a href="/privacy-policy/" class="mt-3 inline-block text-base text-primary underline">Открыть политику персональных данных →</a>
      </section>

      <!-- Образовательная лицензия -->
      <section id="license" class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h2 class="text-[18px] font-semibold text-slate-900">Образовательная лицензия</h2>
        <ul class="mt-3 space-y-1.5 text-base leading-[1.6] text-slate-600">
          <li>Регистрационный номер: {STAT_LICENSE}.</li>
          <li>Статус: действующая, бессрочная.</li>
          <li>Лицензирующий орган: Департамент образования и науки города Москвы.</li>
        </ul>
        <a href="/docs/licenziya-rosobrnadzor.pdf" target="_blank" rel="noopener" class="mt-3 inline-block text-base text-primary underline">Скачать лицензию (PDF)</a>
      </section>
    </div>
  </main>
  <Footer />
</Base>
