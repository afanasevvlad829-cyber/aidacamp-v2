---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Из Химок в АйДаКемп — прямое метро, 45 минут",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, в сосновом лесу рядом с Апрелевкой. Из Химок — прямая ветка метро без пересадок до м. Солнцево. Ребёнка достаточно посадить на Речном Вокзале.",
    list: [
      "На метро: м. Речной Вокзал → м. Солнцево — прямо, без пересадок, 45–50 минут",
      "Бесплатный трансфер лагеря от м. Солнцево в день заезда",
      "На машине: Химки → МКАД (южный объезд) → Киевское шоссе М-3 → Апрелевка — ~70 км, около 1 часа 15 минут без пробок",
      "Плюс маршрута из Химок: не через центр Москвы — по МКАД на юг, минуя пробки"
    ]
  },
  {
    h2: "Для семей из Химок — IT-столицы северо-запада",
    text: "Химки — ближайший к Москве крупный город с высокой концентрацией IT-специалистов и семей из технических профессий. Сколково в 15 минутах, технопарки, стартапы. Ребята из таких семей уже слышали слова Python и GitHub дома. В АйДаКемп они впервые напишут код сами — или прокачают то, что уже начали.",
    list: [
      "Группы по уровню: начинающие, средний, продвинутые — никто не скучает",
      "Финальный хакатон: ребёнок представляет свой проект жюри из практикующих разработчиков",
      "Июль занят полностью. В июне и августе ещё есть места"
    ]
  },
  {
    h2: "Трансфер из Химок в лагерь",
    text: "Бесплатный трансфер АйДаКемп отправляется от м. Солнцево в день заезда, и обратно — в день отъезда. Из Химок до м. Солнцево — прямая ветка метро без пересадок, около 45–50 минут. Ни одна пересадка не нужна.",
    list: [
      "Трансфер бесплатный — отправляется от м. Солнцево в день заезда",
      "Из Химок до м. Солнцево: м. Речной Вокзал → прямо до м. Солнцево, ~45–50 мин без пересадок",
      "Обратно: трансфер привозит ребёнка на м. Солнцево в день отъезда",
      "Многие семьи из Химок предпочитают отвезти ребёнка на машине — через МКАД около 1:15"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Химок",
    text: "АйДаКемп — лицензированная образовательная организация. Налоговый вычет доступен для всех российских налогоплательщиков, включая жителей Химок. Оформляется через nalog.ru, никуда ехать не нужно.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽",
      "Подробнее о документах: раздел «Налоговый вычет» на сайте"
    ]
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Химками",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Химок выбирают АйДаКемп",
    text: "Родители из Химок часто говорят: «1.5 часа — это же далеко». Но потом звонят снова записать ребёнка. Вот почему:",
    list: [
      "Подмосковье — не море, акклиматизации нет, ребёнок с первого дня в форме",
      "Можно приехать в любой день смены — проведать, привезти забытые вещи",
      "Трансфер от м. Солнцево — 45 минут прямым метро из Химок, садишь в автобус и всё",
      "Если что-то пойдёт не так — через 1.5 часа уже рядом с ребёнком",
      "Ежедневные фото в Telegram — видите, чем занимается ваш ребёнок, каждый день"
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "В смене АйДаКемп работают два типа взрослых: IT-преподаватели (ведут учебные блоки, 1 педагог на 6–8 ребят) и вожатые (отвечают за жизнь в лагере, организацию досуга, безопасность). Вожатые — студенты педагогических и психологических специальностей, проходящие конкурсный отбор. IT-преподаватели — практикующие разработчики и выпускники технических вузов. Медицинский работник находится на территории в течение всей смены.",
    list: [
      "Соотношение: 1 преподаватель на 6–8 учеников в группе",
      "Вожатые — конкурсный отбор, студенты педагогических специальностей",
      "Медработник круглосуточно на территории",
      "Ежедневные фото в Telegram — родители видят, чем занимается ребёнок"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Июль занят полностью. В июне и августе ещё есть места. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 000 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей с севера Подмосковья",
    text: "В АйДаКемп едут дети из Химок, Долгопрудного, Мытищ и других городов севера Подмосковья. Вот что пишут родители:",
    list: [
      "«Доехали до м. Солнцево за полчаса, пересели на автобус — и всё, дочь уехала. Никакого стресса ни для неё, ни для меня» — Светлана, Химки",
      "«Сын после лагеря сам нашёл в интернете курс по Python и попросил купить — раньше вообще книг не открывал» — Ирина, Долгопрудный",
      "«1.5 часа дороги? Я сначала сомневалась, а потом увидела его проект на хакатоне и забыла про расстояние» — Наталья, Мытищи"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Химками 2026 — АйДаКемп"
  description="IT-лагерь из Химок: прямое метро без пересадок 45 минут + трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. Июль занят. От 48 000 ₽."
  h1="Детский лагерь рядом с Химками"
  canonical="https://aidacamp.ru/lager-himki"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Химок до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Химок до лагеря ~70 км: МКАД → Киевское шоссе М-3 → Апрелевка, около 1 часа 15 минут. Или: метро м. Речной Вокзал → м. Солнцево (~45 мин) → бесплатный трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Химок?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Химок нет, но из Химок до м. Солнцево — прямая ветка метро, около 45–50 минут. От м. Солнцево отправляется бесплатный трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Сколько длится смена в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 7 до 14 дней. Основные смены: 10 и 14 дней (95 000 ₽ и 74 900 ₽). Короткие смены: 7–8 дней от 48 000 ₽. Лагерь работает с конца мая по август 2026." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для поступления в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку. На 3-й день уже виден результат." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание (комнаты 2–4 чел. с санузлом), 5-разовое питание, полная IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности и страховка. Трансфер из Москвы — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Химками — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Химок. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-himki"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Химками", "item": "https://aidacamp.ru/lager-himki/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Химками"
    subtitle="Из Химок в АйДаКемп — 45 минут прямой веткой метро без пересадок: Речной Вокзал → Солнцево. Трансфер от метро бесплатный."
    breadcrumb="Лагерь из Химок"
    keywords={["45 минут прямым метро без пересадок из Химок", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Химками — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
