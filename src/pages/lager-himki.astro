---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Химок",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области — примерно в 66 км от МКАД. Из Химок ехать около 1.5 часа: через МКАД и Одинцово по Киевскому шоссе на A-101. Дорога прямая, пробок в сторону области минимум. Организованный трансфер отправляется с точки сбора у м. Солнцево — это 30 минут от Химок. Многие семьи доезжают до метро сами и пересаживаются на автобус."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Химками",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети, «зависшие» в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Химок выбирают АйДаКемп",
    text: "Родители из Химок часто говорят: «1.5 часа — это же далеко». Но потом звонят снова записать ребёнка. Вот почему:",
    list: [
      "Подмосковье — не море, акклиматизации нет, ребёнок с первого дня в форме",
      "Можно приехать в любой день смены — проведать, привезти забытые вещи",
      "Трансфер от м. Солнцево — 30 минут от Химок, садишь в автобус и всё",
      "Если что-то пойдёт не так — через 1.5 часа уже рядом с ребёнком"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей с севера Подмосковья",
    text: "В АйДаКемп едут дети из Химок, Долгопрудного, Мытищ и других городов севера Подмосковья. Вот что пишут родители:",
    list: [
      "«Доехали до Солнцево за полчаса, пересели на автобус — и всё, дочь уехала. Никакого стресса ни для неё, ни для меня» — Светлана, Химки",
      "«Сын после лагеря сам нашёл в интернете курс по Python и попросил купить — раньше вообще книг не открывал» — Ирина, Долгопрудный",
      "«1.5 часа дороги? Я сначала сомневалась, а потом увидела его проект на хакатоне и забыла про расстояние» — Наталья, Мытищи"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Химками 2026 — АйДаКемп"
  description="Детский лагерь недалеко от Химок: 1.5 часа по Киевскому шоссе через Одинцово, IT-программа, бассейн. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Химками"
  canonical="https://aidacamp.ru/lager-himki"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Химок до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Химок до м. Солнцево — около 30 минут. Оттуда отправляется организованный трансфер АйДаКемп (2 500 ₽). Или самостоятельно на автомобиле: через МКАД и Одинцово по Киевскому шоссе, 66 км от МКАД, около 1.5 часа." }
        },
        {
          "@type": "Question",
          "name": "Сколько длится смена в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 7 до 14 дней. Основные смены: 10 и 14 дней (95 000 ₽ и 74 900 ₽). Короткие смены: 7–8 дней от 48 000 ₽. Лагерь работает с конца мая по август 2026." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования для поступления в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку. На 3-й день уже виден результат." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание (комнаты 2–4 чел. с санузлом), 5-разовое питание, полная IT-программа (2 занятия по 90 мин. в день), бассейн, вечерние активности и страховка. Трансфер из Москвы — 2 500 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Химками — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Химок. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-himki"
      ageMin={7}
      ageMax={15}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Лагерь рядом с Химками", "item": "https://aidacamp.ru/lager-himki/" }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Химками"
    subtitle="IT-лагерь в Наро-Фоминском районе — 1.5 часа из Химок по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Химок"
    keywords={["1.5 часа из Химок через Одинцово", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Химками — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-[#ec7c00] hover:underline">детский IT-лагерь в Подмосковье</a>
    </p>
  </div>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
