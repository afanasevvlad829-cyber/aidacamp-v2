---
export const prerender = false;
import '../../styles/global.css';
import { signLid, verifyLid } from '../../lib/leadLink';
import { getCustomerGroupIds } from '../../lib/alfaCrm';
import { pickPamyatkaShift, type PamyatkaShift } from '../../data/pamyatkaShifts';

const { lid: lidParam } = Astro.params;
const t = Astro.url.searchParams.get('t') || '';

const isPreview = lidParam === 'test' || lidParam === 'preview';
const lidNum = isPreview ? 0 : Number(lidParam);
const valid = isPreview || (Number.isInteger(lidNum) && lidNum > 0 && lidNum < 9999999 && verifyLid(lidNum, t));

if (!valid) {
  return new Response('Ссылка недействительна', { status: 404 });
}

// SSR: подтянуть смену клиента из CRM. В preview всегда показываем пример смены 1.
let shift: PamyatkaShift | null = null;
if (isPreview) {
  shift = pickPamyatkaShift([660]);
} else {
  try {
    const groupIds = await getCustomerGroupIds(lidNum);
    shift = pickPamyatkaShift(groupIds);
  } catch {
    shift = null;
  }
}

const sectionTone: Record<string, string> = {
  doc: '#dc2626',
  hyg: '#0ea5e9',
  cloth: '#16a34a',
  swim: '#06b6d4',
  cozy: '#a855f7',
  med: '#e2493a',
  no: '#64748b',
  before: '#ec9b44',
};

const sections = [
  {
    id: 'doc',
    icon: 'shield-fill-check',
    title: 'Документы — без них не заселят',
    note: 'Кладём первыми. Заверни в файлик — не помнётся.',
    items: [
      {
        id: 'doc-1', text: 'Медсправка форма 079/у', hint: 'Срок — 6 месяцев. Берётся в поликлинике.',
        info: {
          title: 'Медицинская справка форма 079/у',
          image: '/images/pamyatka/doc-079u.png',
          body: 'Берётся в детской поликлинике у участкового педиатра. Оформляется бесплатно по полису ОМС, занимает 1–3 дня. Срок действия — 6 месяцев со дня выдачи. Без неё ребёнка не примут в лагерь — это требование Роспотребнадзора, не наше.<br/><br/><a href="https://docs.cntd.ru/document/420295344" target="_blank" rel="noopener">Посмотреть приказ Минздрава №834н</a>',
        },
      },
      {
        id: 'doc-2', text: 'Полис ОМС', hint: 'Оригинал или копия',
        info: {
          title: 'Полис обязательного медицинского страхования',
          image: '/images/pamyatka/doc-oms.svg',
          body: 'Подойдёт оригинал, копия или цифровой полис из госуслуг (распечатать). Если полиса нет — оформить бесплатно в страховой компании или МФЦ по месту жительства.',
        },
      },
      {
        id: 'doc-3', text: 'Свидетельство о рождении / паспорт', hint: 'У кого что есть',
        info: {
          title: 'Документ удостоверяющий личность',
          body: 'Дети до 14 лет — свидетельство о рождении (оригинал или копия). От 14 лет — паспорт. Без этого документа Роспотребнадзор не разрешает заселять.',
        },
      },
      {
        id: 'doc-4', text: 'Согласие на медицинское вмешательство', hint: 'Бланк пришлём в Telegram-канале',
        info: {
          title: 'Информированное согласие',
          image: '/images/pamyatka/doc-soglasie.png',
          body: 'Стандартный бланк. Подписывают оба родителя (или один — с пометкой «второй родитель отсутствует/в командировке»). Бланк пришлём в TG-канале родителей за 7 дней до смены — распечатываете и привозите подписанным. Без него медсестра лагеря не имеет права оказывать помощь даже от насморка.',
        },
      },
    ],
  },
  {
    id: 'hyg',
    icon: 'droplet-fill',
    title: 'Гигиена',
    note: 'Всё в одну косметичку — так не теряется.',
    items: [
      { id: 'hyg-1', text: 'Зубная щётка + паста' },
      { id: 'hyg-2', text: 'Мыло, шампунь, гель для душа' },
      { id: 'hyg-3', text: 'Расчёска, резинки (для девочек)' },
      { id: 'hyg-4', text: 'Полотенце для душа + для лица', hint: '2 штуки минимум' },
      { id: 'hyg-5', text: 'Влажные салфетки (упаковка)' },
    ],
  },
  {
    id: 'cloth',
    icon: 'bag-fill',
    title: 'Одежда',
    note: 'На 10-дневную смену: 5–6 комплектов. Стирка в лагере есть.',
    items: [
      { id: 'cl-1', text: 'Футболки — 5–6 шт' },
      { id: 'cl-2', text: 'Шорты / лёгкие штаны — 3–4 шт' },
      { id: 'cl-3', text: 'Толстовка / худи — 2 шт' },
      { id: 'cl-warm', text: 'Одна тёплая вещь обязательно — свитшот или флиска', hint: 'Вы сами знаете, какая у нас летом бывает погода — переменчивая' },
      { id: 'cl-socks', text: 'Тёплые носки — 2 пары', hint: 'Чтобы вечером в номере было уютно' },
      { id: 'cl-4', text: 'Носки и нижнее бельё — на каждый день +2' },
      { id: 'cl-5', text: 'Кроссовки + сандалии + кроксы', hint: 'Кроксы желательно с закрытым носом — пальцы скажут вам спасибо' },
      { id: 'cl-rain', text: 'Дождевик', hint: 'На всякий случай — летом дожди приходят внезапно' },
      { id: 'cl-6', text: 'Лёгкая шапка / кепка от солнца' },
    ],
  },
  {
    id: 'swim',
    icon: 'water',
    title: 'Бассейн и спорт',
    note: 'У нас крытый бассейн — занятия каждый день.',
    items: [
      { id: 'sw-1', text: 'Купальник / плавки — 2 комплекта' },
      { id: 'sw-2', text: 'Резиновая шапочка для бассейна' },
      { id: 'sw-3', text: 'Полотенце для бассейна (отдельное)' },
      { id: 'sw-fun', text: 'Можно взять водное оружие или плавающие игрушки', hint: 'Не обязательно — но детям нравится' },
    ],
  },
  {
    id: 'cozy',
    icon: 'heart-fill',
    title: 'Любимое из дома',
    note: 'Особенно если ребёнок едет в лагерь впервые. Снимает тревогу первой ночи.',
    items: [
      { id: 'cz-1', text: 'Маленькая мягкая игрушка', hint: 'У половины отряда что-то такое есть — никто не засмеёт' },
      { id: 'cz-2', text: 'Семейная фотография' },
      { id: 'cz-3', text: 'Скетчбук / раскраска / книга — что любит' },
    ],
  },
  {
    id: 'med',
    icon: 'capsule',
    title: 'Личная аптечка',
    note: 'Передаётся вожатому при заселении — он выдаёт по графику.',
    items: [
      { id: 'md-1', text: 'Регулярные лекарства', hint: 'Запиши на упаковке: время приёма, дозировка' },
      { id: 'md-2', text: 'Крем от солнца SPF 30+' },
      { id: 'md-3', text: 'Спрей от комаров' },
    ],
  },
  {
    id: 'no',
    icon: 'x-octagon-fill',
    title: 'Что НЕ брать',
    note: 'Лагерь предоставляет, либо запрещено, либо просто не доедет.',
    items: [
      { id: 'no-laptop', text: 'Ноутбук — у нас своё оборудование' },
      { id: 'no-electro', text: 'Дорогую электронику и украшения' },
      { id: 'no-bed', text: 'Постельное бельё, подушки' },
      { id: 'no-cash', text: 'Большие суммы наличных' },
      { id: 'no-energy', text: 'Энергетики, газировку' },
      { id: 'no-perish', text: 'Скоропортящиеся продукты', hint: 'До конца смены не доедут' },
      { id: 'no-melt', text: 'Шоколад и всё, что плавится', hint: 'Превратится в лужу в чемодане' },
      { id: 'no-cookies', text: 'Печеньки и сладости «для своего»', hint: 'Если хотите — берите так, чтобы хватило на весь отряд. Иначе обидно' },
    ],
  },
  {
    id: 'before',
    icon: 'check2-circle',
    title: 'За день до выезда',
    note: 'Финальный чек, чтобы спать спокойно.',
    items: [
      { id: 'bf-mark', text: 'Промаркировать все вещи', hint: 'Перманентным маркером, термонаклейками или малярным скотчем с надписью — иначе вещи теряются' },
      { id: 'bf-doc', text: 'Положить документы сверху в файлике' },
      { id: 'bf-charge', text: 'Зарядить телефон + взять зарядку и пауэрбанк' },
    ],
  },
];

const totalItems = sections.reduce((s, sec) => s + sec.items.length, 0);
const t_safe = signLid(lidNum);
