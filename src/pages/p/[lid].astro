---
export const prerender = false;
import '../../styles/global.css';
import { signLid, verifyLid } from '../../lib/leadLink';

const { lid: lidParam } = Astro.params;
const t = Astro.url.searchParams.get('t') || '';

const lidNum = Number(lidParam);
const valid = Number.isInteger(lidNum) && lidNum > 0 && lidNum < 9999999 && verifyLid(lidNum, t);

if (!valid) {
  return new Response('Ссылка недействительна', { status: 404 });
}

const sectionTone: Record<string, string> = {
  doc: '#dc2626',
  hyg: '#0ea5e9',
  cloth: '#16a34a',
  swim: '#06b6d4',
  cozy: '#a855f7',
  med: '#e2493a',
  no: '#64748b',
  before: '#ec9b44',
};

const sections = [
  {
    id: 'doc',
    icon: 'shield-fill-check',
    title: 'Документы — без них не заселят',
    note: 'Кладём первыми. Заверни в файлик — не помнётся.',
    items: [
      { id: 'doc-1', text: 'Медсправка форма 079/у', hint: 'Срок — 6 месяцев. Берётся в поликлинике.' },
      { id: 'doc-2', text: 'Полис ОМС', hint: 'Оригинал или копия' },
      { id: 'doc-3', text: 'Свидетельство о рождении / паспорт', hint: 'У кого что есть' },
      { id: 'doc-4', text: 'Согласие на медицинское вмешательство', hint: 'Бланк пришлём в Telegram-канале' },
    ],
  },
  {
    id: 'hyg',
    icon: 'droplet-fill',
    title: 'Гигиена',
    note: 'Всё в одну косметичку — так не теряется.',
    items: [
      { id: 'hyg-1', text: 'Зубная щётка + паста' },
      { id: 'hyg-2', text: 'Мыло, шампунь, гель для душа' },
      { id: 'hyg-3', text: 'Расчёска, резинки (для девочек)' },
      { id: 'hyg-4', text: 'Полотенце для душа + для лица', hint: '2 штуки минимум' },
      { id: 'hyg-5', text: 'Влажные салфетки (упаковка)' },
    ],
  },
  {
    id: 'cloth',
    icon: 'tshirt',
    title: 'Одежда',
    note: 'На 10-дневную смену: 5–6 комплектов. Стирка в лагере есть.',
    items: [
      { id: 'cl-1', text: 'Футболки — 5–6 шт' },
      { id: 'cl-2', text: 'Шорты / лёгкие штаны — 3–4 шт' },
      { id: 'cl-3', text: 'Толстовка / худи — 2 шт', hint: 'Вечером бывает прохладно' },
      { id: 'cl-4', text: 'Носки и нижнее бельё — на каждый день +2' },
      { id: 'cl-5', text: 'Кроссовки + сандалии + сланцы' },
      { id: 'cl-6', text: 'Лёгкая шапка / кепка от солнца' },
    ],
  },
  {
    id: 'swim',
    icon: 'water',
    title: 'Бассейн и спорт',
    note: 'У нас крытый бассейн — занятия каждый день.',
    items: [
      { id: 'sw-1', text: 'Купальник / плавки — 2 комплекта' },
      { id: 'sw-2', text: 'Резиновая шапочка для бассейна' },
      { id: 'sw-3', text: 'Полотенце для бассейна (отдельное)' },
    ],
  },
  {
    id: 'cozy',
    icon: 'heart-fill',
    title: 'Любимое из дома',
    note: 'Особенно если ребёнок едет в лагерь впервые. Снимает тревогу первой ночи.',
    items: [
      { id: 'cz-1', text: 'Маленькая мягкая игрушка', hint: 'У половины отряда что-то такое есть — никто не засмеёт' },
      { id: 'cz-2', text: 'Семейная фотография' },
      { id: 'cz-3', text: 'Скетчбук / раскраска / книга — что любит' },
    ],
  },
  {
    id: 'med',
    icon: 'capsule',
    title: 'Личная аптечка',
    note: 'Передаётся вожатому при заселении — он выдаёт по графику.',
    items: [
      { id: 'md-1', text: 'Регулярные лекарства', hint: 'Запиши на упаковке: время приёма, дозировка' },
      { id: 'md-2', text: 'Крем от солнца SPF 30+' },
      { id: 'md-3', text: 'Спрей от комаров' },
    ],
  },
  {
    id: 'no',
    icon: 'x-octagon-fill',
    title: 'Что НЕ брать',
    note: 'Лагерь предоставляет, либо запрещено правилами безопасности.',
    items: [
      { id: 'no-1', text: 'Ноутбук — у нас своё оборудование' },
      { id: 'no-2', text: 'Дорогую электронику и украшения' },
      { id: 'no-3', text: 'Постельное бельё, подушки' },
      { id: 'no-4', text: 'Большие суммы наличных' },
      { id: 'no-5', text: 'Энергетики, газировку про запас' },
    ],
  },
  {
    id: 'before',
    icon: 'check2-circle',
    title: 'За день до выезда',
    note: 'Финальный чек, чтобы спать спокойно.',
    items: [
      { id: 'bf-1', text: 'Подписать вещи маркером / термонаклейками' },
      { id: 'bf-2', text: 'Положить документы сверху в файлике' },
      { id: 'bf-3', text: 'Зарядить телефон + взять зарядку' },
    ],
  },
];

const totalItems = sections.reduce((s, sec) => s + sec.items.length, 0);
const t_safe = signLid(lidNum);
