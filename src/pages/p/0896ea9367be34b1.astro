  .facts{width:100%;border-collapse:collapse;margin:14px 0 6px;font-size:16px}
  .facts td{padding:12px 0;border-bottom:1px solid var(--line);vertical-align:top}
  .facts td:first-child{color:var(--ink-3);width:38%;padding-right:16px}
  .facts td:last-child{color:var(--ink);font-weight:600}

