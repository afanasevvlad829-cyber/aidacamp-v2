  .btn.p{background:var(--accent);color:var(--navy)}
  .btn.s{border:1.5px solid var(--line);color:var(--ink)}
  .btn.s:hover{border-color:var(--accent)}
  .sig{margin-top:26px;font-size:15px;color:var(--ink-3);line-height:1.5}
  .sig b{color:var(--ink);font-weight:700}

  .short{display:grid;grid-template-columns:200px 1fr;gap:22px;align-items:center;margin:6px 0 22px;padding:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px}
  .short iframe{width:200px;height:356px;border:0;border-radius:12px;background:#000}
  .short p{margin:0 0 10px}
  .short a{color:var(--accent-ink);font-weight:600}
