  .program{display:grid;gap:18px;margin-top:22px}
  .item{display:grid;grid-template-columns:28px 1fr;gap:14px;align-items:start}
  .item .ic{width:28px;height:28px;border-radius:8px;background:var(--accent);color:var(--navy);display:grid;place-items:center;font-weight:800;font-size:14px}
  .item h3{font-size:17px;font-weight:700;margin-bottom:4px}
  .item p{margin:0;font-size:16px}
  .item a{color:var(--accent-ink);font-weight:600;text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:3px}
  .item a:hover{text-decoration-color:var(--accent)}

  .links{display:grid;gap:10px;margin-top:18px}
  .lnk{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 18px;background:var(--paper);border:1px solid var(--line);border-radius:14px;text-decoration:none;transition:border-color .15s}
  .lnk:hover{border-color:var(--accent)}
  .lnk b{display:block;font-weight:700;font-size:16px}
  .lnk span{display:block;font-size:14px;color:var(--ink-3);margin-top:2px}
  .lnk .arr{flex:0 0 auto;color:var(--accent-ink);font-weight:700;font-size:20px}
  .links.two{grid-template-columns:1fr 1fr}
