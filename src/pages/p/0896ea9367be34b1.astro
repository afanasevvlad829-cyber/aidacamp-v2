    <div class="short">
      <iframe src="https://www.youtube.com/embed/nKqNpt3ZsDk" title="Мы живём в самом прекрасном IT-лагере на свете" allow="accelerometer; encrypted-media; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
