---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "IT как продолжение инженерных традиций Реутова",
    text: "Летний детский лагерь рядом с Реутовом — это АйДаКемп в санатории «Изумруд». Реутов — город Корпорации «Тактическое ракетное вооружение» и инженерных династий. Родители здесь понимают: технический склад ума нужно развивать с детства, а не ждать вуза. АйДаКемп — место, где школьник из инженерной семьи делает настоящий проект на Python или AI и на хакатоне показывает результат. Лицензия Минобрнауки, рейтинг 5.0 на Яндекс.Картах."
  },
  {
    h2: "Как добраться из Реутова до лагеря АйДаКемп",
    text: "АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час). Реутов стоит у восточного края МКАД: удобнее всего доехать до м. Солнцево, а оттуда сесть на трансфер лагеря (2 000 ₽, ~40 мин). На машине — через МКАД на Киевское шоссе (А-101) до санатория «Изумруд».",
    list: [
      "Метро от м. Новокосино до м. Солнцево: ~40 мин",
      "Трансфер от м. Солнцево до лагеря: 2 000 ₽, ~40 мин",
      "На машине: МКАД → Киевское шоссе (А-101) → санаторий «Изумруд». 66 км от МКАД, ~1 час без пробок",
      "Родительский день — удобно заехать в середине смены"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Для инженерных семей из Реутова важно, что в лагере всё организовано системно, а не на энтузиазме.",
    list: [
      "1 преподаватель на 6–8 ребят — индивидуальный подход к каждому",
      "Вожатые — конкурсный отбор, проходят обучение до смены",
      "Медработник круглосуточно на территории лагеря",
      "Ежедневные фото в Telegram в 21:00 — видно, чем занимался ваш ребёнок сегодня"
    ]
  },
  {
    h2: "Программа IT-лагеря для ребят из Реутова",
    text: "Школьники 7–15 лет выбирают IT-трек по интересу и уровню подготовки. Занятия дважды в день по 90 минут, группы до 8 человек — преподаватель успевает поработать с каждым. Финал смены — хакатон с защитой проектов.",
    list: [
      "Python — от переменных до телеграм-бота за смену",
      "Scratch — первое программирование для ребят 7–10 лет",
      "Minecraft Education — создание модов, механики игры",
      "AI и нейросети — ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Реутова",
    text: "Семьи из Реутова и ближнего Подмосковья легко добираются до лагеря:",
    list: [
      "«Из Реутова до Солнцево — 40 минут на метро, потом автобус лагеря. Сын уехал в июне, вернулся с Python-проектом и новыми друзьями со всей Москвы» — Ольга, Реутов",
      "«Живём на границе с Москвой, поэтому АйДаКемп оказался совсем близко. Дочь была на двух сменах — каждый раз привозит что-то новое» — Анна, Реутов"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: `Бронируйте смену заранее — места уходят быстро. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности. Налоговый вычет — до ${VYCHET_MAX} (максимум, 14-дневная смена).`,
    list: [
      `Смена 2.1: 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2: 10–23 июня, 14 дней — ${PRICE_MAX} (самая популярная)`,
      `Смена 3: 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4: 17–26 августа, 10 дней — ${PRICE_S4}`,
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "В АйДаКемп едут не только из Реутова, но и из ближайших городов Подмосковья:",
    list: [
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-lubertsy'>Люберцы</a> — ~80 км, ~1 ч 20 мин",
      "<a href='/lager-shchelkovo'>Щёлково</a> — ~110 км, ~1 ч 20 мин",
      "<a href='/lager-zhukovskiy'>Жуковский</a> — ~85 км, ~1 ч 20 мин"
    ]
  },
  {
    h2: "Как выглядит типичный день в IT-лагере",
    text: "8:00 — подъём, зарядка, завтрак. 9:30–11:00 — IT-занятие (программирование по треку). 11:15 — второй завтрак. 11:30–13:00 — командные активности или работа над проектом. 13:30 — обед. 14:00–16:00 — тихий час и свободное время. 16:00 — бассейн или спорт. 18:00 — ужин. 19:00–20:30 — вечернее IT-занятие или хакатон. 21:00 — фото в Telegram родителям.",
    list: [
      "2 IT-блока в день по 90 минут — утро и вечер",
      "Бассейн через день, спортивные площадки ежедневно",
      "Фото родителям каждый вечер в Telegram-канале отряда",
      "Отбой в 22:00 — режим соблюдается, вожатый следит"
    ]
  },
  {
    h2: "Что ребёнок получит после смены",
    text: "Самостоятельность: первый раз спать без родителей, самому управлять расписанием, следить за вещами. Друзья: за 10 дней в маленькой группе возникают настоящие дружбы. Уверенность: защитил проект на хакатоне — это не «мамин отзыв», а оценка незнакомых людей. Родители замечают изменения в поведении через 2 недели после возвращения.",
    list: [
      "Первый опыт ночёвок вне дома — в безопасной среде",
      "Друзья из других городов — часто переписка продолжается годами",
      "Хакатон как первая «публичная презентация» в жизни",
      "Интерес к IT сохраняется — большинство продолжают дома"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь рядом с Реутовом 2026 — IT-смена | АйДаКемп"
  description={`Из Реутова до IT-лагеря через м. Солнцево + трансфер, налоговый вычет до ${VYCHET_MAX}. Python, AI, Minecraft для 7–15 лет. От ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Реутовом"
  canonical="https://aidacamp.ru/lager-reutov"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Реутова до лагеря АйДаКемп?", a: "АйДаКемп — 66 км от МКАД по Киевскому шоссе (~1 час). Из Реутова: на машине через МКАД на Киевское шоссе, либо до м. Солнцево (~40 мин на метро) и трансфер лагеря (2 000 ₽, ~40 мин)." },
    { q: "Сколько ехать из Реутова до лагеря?", a: "Лагерь в 66 км от МКАД по Киевскому шоссе, ~1 час без пробок. До м. Солнцево из Реутова — около 40 минут на метро, затем трансфер лагеря (2 000 ₽)." },
    { q: "Есть ли трансфер из Реутова?", a: "Прямого трансфера из Реутова нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Реутова удобно доехать до Солнцево — около 40 минут на метро." },
    { q: "Сколько стоит путёвка в лагерь из Реутова?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). Включены проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Реутовом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-reutov"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Реутовом"
    subtitle="IT-лагерь в Наро-Фоминском районе — 66 км от МКАД по Киевскому шоссе. Из Реутова: до м. Солнцево + трансфер лагеря. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Реутова"
    keywords={["66 км от МКАД по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Реутовом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Полезные разделы: <a href="/smeny" class="text-primary hover:underline">смены и даты 2026</a> · <a href="/stoimost" class="text-primary hover:underline">стоимость и что входит</a> · <a href="/programmy" class="text-primary hover:underline">IT-программы лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
