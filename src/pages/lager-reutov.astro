---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Реутова до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 80 км от Реутова, примерно 1.5 часа езды. Маршрут: МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Реутов — на восточной границе Москвы, МКАД рядом. Организованный трансфер отправляется от м. Солнцево — из Реутова до Солнцево около 40 минут на метро."
  },
  {
    h2: "Почему родители из Реутова выбирают АйДаКемп",
    text: "Реутов — один из ближайших к Москве городов Подмосковья. Добираться до лагеря удобно: МКАД рядом, метро доступно. АйДаКемп — это лагерь с лицензией Минобрнауки, реальными проектами на Python и AI, рейтингом 5.0. Ребёнок в Подмосковье — без акклиматизации.",
    list: [
      "Удобная логистика — МКАД рядом, метро в шаговой доступности",
      "Без акклиматизации — Подмосковье, привычный климат",
      "Лицензия Минобрнауки, документы для налогового вычета 13%",
      "Рейтинг 5.0 на Яндекс.Картах — 40+ реальных отзывов"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Реутова",
    text: "Дети 7–15 лет выбирают IT-трек по интересу и уровню подготовки. Занятия дважды в день по 90 минут, группы до 8 человек — преподаватель успевает поработать с каждым. Финал смены — хакатон с защитой проектов.",
    list: [
      "Python — от переменных до телеграм-бота за смену",
      "Scratch — первое программирование для детей 7–10 лет",
      "Minecraft Education — создание модов, механики игры",
      "AI и нейросети — ChatGPT API, обучение моделей",
      "3D-моделирование — Blender и финальная 3D-печать"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Реутова и ближнего Подмосковья легко добираются до лагеря:",
    list: [
      "«Из Реутова до Солнцево — 40 минут на метро, потом автобус лагеря. Сын уехал в июне, вернулся с Python-проектом и новыми друзьями со всей Москвы» — Ольга, Реутов",
      "«Живём на границе с Москвой, поэтому АйДаКемп оказался совсем близко. Дочь была на двух сменах — каждый раз привозит что-то новое» — Анна, Реутов"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Маршрут из Реутова: на машине и на метро",
    text: "Реутов — ближайший к МКАД город Подмосковья. Это значит, что и до лагеря удобно добраться двумя способами.",
    list: [
      "На машине: из Реутова по МКАД до Киевского шоссе (M-3), затем ~66 км до санатория «Изумруд». Итого ~80 км, ~1 ч 20 мин без пробок",
      "На метро + трансфер: из Реутова до м. Солнцево (синяя/жёлтая ветка) ~40 мин, оттуда трансфер АйДаКемп 2 000 ₽ — и через час ребёнок в лагере",
      "Что взять в дорогу: перекус, документы, список вещей от лагеря"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "В АйДаКемп едут дети не только из Реутова, но и из ближайших городов Подмосковья:",
    list: [
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-lubertsy'>Люберцы</a> — ~80 км, ~1 ч 20 мин",
      "<a href='/lager-shchelkovo'>Щёлково</a> — ~90 км, ~1 ч 30 мин",
      "<a href='/lager-zhukovskiy'>Жуковский</a> — ~85 км, ~1 ч 20 мин"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Реутов 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Реутова: ~1.5 ч по МКАД → Киевское шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Реутовом"
  canonical="https://aidacamp.ru/lager-reutov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Реутова до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Реутова около 80 км и ~1.5 часа: по МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или до м. Солнцево (~40 мин на метро) и трансфер лагеря (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Реутова до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часа на автомобиле (80 км через МКАД → Киевское шоссе). До м. Солнцево из Реутова — около 40 минут на метро, затем трансфер лагеря." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Реутова?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Реутова нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Реутова удобно доехать до Солнцево — около 40 минут на метро." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Реутова?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Реутовом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Реутова. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-reutov"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Реутовом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Реутова через МКАД → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Реутова"
    keywords={["~1.5 ч от Реутова через МКАД", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Реутовом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
