---
import Base from '../layouts/Base.astro';
import { SEASON_YEAR } from '../data/shifts';
---

<Base
  title="Как работает AI-платформа АйДаКемп"
  description="Онбординг: единый кабинет ученика и преподавателя"
  noindex={true}
>
  <Fragment slot="head">
    <style>
      body { background: #0d1a2b; }
    </style>
  </Fragment>

  <div class="min-h-screen bg-[#0d1a2b] flex flex-col">

    <!-- Лого -->
    <header class="px-6 py-5 md:px-10">
      <a href="/" class="inline-flex items-center gap-2 no-underline group">
        <i class="bi bi-arrow-left text-[12px] text-white/35 group-hover:text-white/60 transition" aria-hidden="true"></i>
        <img src="/assets/icons/aida-logo-ai.gif" alt="АйДаКемп" class="h-6 w-6 rounded-full bg-white object-contain p-[2px] opacity-80 group-hover:opacity-100 transition" />
        <span class="text-base font-medium text-white/50 group-hover:text-white/80 transition">АйДаКемп</span>
      </a>
    </header>

    <!-- Hero -->
    <main class="flex-1 mx-auto w-full max-w-[1100px] px-5 md:px-10 pb-16">

      <div class="pt-10 pb-8 md:pt-14 md:pb-10">
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary mb-3">Только для участников лагеря</p>
        <h1 class="text-[28px] md:text-[42px] font-extrabold text-white leading-[1.1] tracking-[-0.02em] mb-4">
          Единая AI-платформа.<br class="hidden md:block" />
          <span class="text-transparent" style="-webkit-text-stroke: 1.5px rgba(255,255,255,0.5);">Пока никто не повторил.</span>
        </h1>

        <!-- Описание — раскрывается по клику -->
        <div>
          <button
            id="ob-toggle"
            class="inline-flex items-center gap-2 text-base font-semibold text-primary hover:text-primary/80 transition cursor-pointer bg-transparent border-0 p-0"
          >
            <i class="bi bi-info-circle text-base" aria-hidden="true"></i>
            <span id="ob-toggle-label">Что это за платформа?</span>
            <i id="ob-toggle-icon" class="bi bi-chevron-down text-[11px] transition-transform duration-200" aria-hidden="true"></i>
          </button>

          <div id="ob-desc" class="hidden mt-4 max-w-[620px] rounded-2xl bg-white/6 border border-white/10 p-5">
            <ul class="flex flex-col gap-3 text-base text-white/80 leading-relaxed">
              <li class="flex items-start gap-3">
                <i class="bi bi-check-circle-fill text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>Все AI-модели одновременно — GPT-4o, Claude, Gemini и другие. Без доплат и отдельных подписок.</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="bi bi-check-circle-fill text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>Единый кабинет ученика: история, задания, прогресс — всё в одном месте.</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="bi bi-check-circle-fill text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>Единый кабинет преподавателя: видит всех учеников, их работу и активность в реальном времени.</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="bi bi-check-circle-fill text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>Не нужно ничего устанавливать и настраивать. Открыл браузер — готово к работе.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Видео -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Ученик -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary/15">
              <i class="bi bi-person-fill text-base text-primary" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-bold text-white leading-tight">Кабинет ученика</p>
              <p class="text-[12px] text-white/45">Как начать работу с AI</p>
            </div>
          </div>
          <div
            class="ob-card relative rounded-2xl overflow-hidden bg-white/5 aspect-video cursor-pointer group"
            data-src="https://ai.aidacamp.ru/docs/onboarding-student.html"
            data-title="Кабинет ученика"
          >
            <iframe
              src="https://ai.aidacamp.ru/docs/onboarding-student.html"
              class="w-full h-full pointer-events-none"
              frameborder="0"
              title="Онбординг ученика"
            ></iframe>
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <div class="flex items-center gap-2 bg-white/15 backdrop-blur-sm rounded-full px-5 py-2.5 text-base font-bold text-white">
                <i class="bi bi-fullscreen text-base" aria-hidden="true"></i>
                Развернуть
              </div>
            </div>
          </div>
        </div>

        <!-- Преподаватель -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary/15">
              <i class="bi bi-mortarboard text-base text-primary" aria-hidden="true"></i>
            </div>
            <div>
              <p class="text-base font-bold text-white leading-tight">Кабинет преподавателя</p>
              <p class="text-[12px] text-white/45">Управление группой и заданиями</p>
            </div>
          </div>
          <div
            class="ob-card relative rounded-2xl overflow-hidden bg-white/5 aspect-video cursor-pointer group"
            data-src="https://ai.aidacamp.ru/docs/onboarding-teacher.html"
            data-title="Кабинет преподавателя"
          >
            <iframe
              src="https://ai.aidacamp.ru/docs/onboarding-teacher.html"
              class="w-full h-full pointer-events-none"
              frameborder="0"
              title="Онбординг преподавателя"
            ></iframe>
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <div class="flex items-center gap-2 bg-white/15 backdrop-blur-sm rounded-full px-5 py-2.5 text-base font-bold text-white">
                <i class="bi bi-fullscreen text-base" aria-hidden="true"></i>
                Развернуть
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Fullscreen modal -->
      <div id="ob-modal" class="fixed inset-0 z-50 hidden flex-col bg-black">
        <div class="flex items-center justify-between px-5 py-3 shrink-0">
          <span id="ob-modal-title" class="text-base font-bold text-white/80"></span>
          <button id="ob-modal-close" class="flex items-center gap-1.5 text-base text-white/60 hover:text-white transition bg-transparent border-0 cursor-pointer">
            <i class="bi bi-x-lg text-base" aria-hidden="true"></i>
            ESC
          </button>
        </div>
        <div class="flex-1 min-h-0">
          <iframe
            id="ob-modal-iframe"
            src=""
            class="w-full h-full border-0"
            allowfullscreen
            allow="fullscreen"
            title=""
          ></iframe>
        </div>
      </div>

      <!-- Подпись -->
      <p class="mt-8 text-center text-[12px] text-white/25">
        Доступно только участникам лагеря АйДаКемп · {SEASON_YEAR}
      </p>

    </main>
  </div>

  <script>
    // Toggle описания
    const btn = document.getElementById('ob-toggle');
    const desc = document.getElementById('ob-desc');
    const label = document.getElementById('ob-toggle-label');
    const icon = document.getElementById('ob-toggle-icon');
    btn?.addEventListener('click', () => {
      const open = !desc.classList.contains('hidden');
      desc.classList.toggle('hidden', open);
      label.textContent = open ? 'Что это за платформа?' : 'Скрыть';
      icon.style.transform = open ? '' : 'rotate(180deg)';
    });

    // Fullscreen modal
    const modal = document.getElementById('ob-modal');
    const modalIframe = document.getElementById('ob-modal-iframe');
    const modalTitle = document.getElementById('ob-modal-title');
    const modalClose = document.getElementById('ob-modal-close');

    function openModal(src, title) {
      modalIframe.src = src;
      modalTitle.textContent = title;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modalIframe.src = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.ob-card').forEach(card => {
      card.addEventListener('click', () => openModal(card.dataset.src, card.dataset.title));
    });

    modalClose?.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  </script>
</Base>
