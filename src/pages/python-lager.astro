---
import { PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_LICENSE, STAT_RTO } from '../data/contacts';
import { SEASON_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Лагерь Python — с первой строки кода до работающего бота",
    text: "В АйДаКемп Python — основной язык для детей 10–14 лет. Не синтаксис ради синтаксиса, а реальные проекты: Telegram-бот, парсер сайтов, мини-игра, помощник с AI. За 10–14 дней ребята с нуля пишут код, который работает и который можно показать маме и одноклассникам. АйДаКемп — <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT-лагерь</a> с полным погружением: не кружок, а 7 или 14 дней программирования, бассейна и живого общения. Python — одна из программ нашего <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a>."
  },
  {
    h2: "Программа Python в лагере",
    text: "Занятия адаптированы под уровень. Новички начинают с переменных и условий, продвинутые — сразу с классов и API. Группы не больше 8 человек, преподаватели — практикующие разработчики с опытом 6+ лет.",
    list: [
      "Python базовый (10–12 лет) — синтаксис, переменные, условия, циклы, функции",
      "Python продвинутый (12–14 лет) — ООП, работа с файлами, библиотеки",
      "Telegram-боты — от «эхо-бота» до помощника с базой данных",
      "AI-интеграции — подключение Gemini/Claude API из Python-скрипта",
      "Парсинг и автоматизация — BeautifulSoup, requests, selenium (для старших)"
    ]
  },
  {
    h2: "Программа Python по дням — что осваивают",
    text: "За каждую смену ребята проходят чёткую прогрессию от «привет, мир» до готового проекта. Вот как это выглядит на практике:",
    list: [
      "Дни 1–2: знакомство с Python — переменные, типы данных, ввод-вывод. Первая программа «Калькулятор». Английская раскладка, IDE, базовый debugging",
      "Дни 3–5: условия if/elif/else, циклы for и while, функции. Пишем «Угадай число», «Крестики-нолики» в консоли. Понятие алгоритма",
      "Дни 6–8: списки, словари, работа с файлами. Начало финального проекта — каждый выбирает направление (бот / парсер / игра / AI)",
      "Дни 9–10 (или 9–14 в длинной смене): разработка финального проекта. Telegram-бот с командами, парсер погоды или новостей, мини-RPG, либо AI-помощник через API",
      "Финал: хакатон — защита проекта, демонстрация родителям, сертификаты"
    ]
  },
  {
    h2: "Для какого возраста подходит Python-лагерь",
    text: "Python-трек в АйДаКемп рассчитан на школьников 8–15 лет — с разбивкой по уровням внутри трека.",
    list: [
      "8–9 лет (группа «черепашки»): визуальный старт через turtle/tkinter — рисуем геометрию кодом, создаём простые окошки. Синтаксис Python без давления «это сложно»",
      "10–12 лет (базовый Python): переменные, циклы, функции, работа с файлами. Финальный проект — Flask-приложение или бот для класса",
      "13–15 лет (продвинутый): FastAPI, Telegram-боты с базой данных, подключение внешних API. Часть ребят уходит с проектом, который развивают дома",
      "9 лет (исключение): если школьник уже хорошо знает Scratch и быстро печатает — берём. Попадает в группу 8–9 лет"
    ]
  },
  {
    h2: "Библиотеки Python которые изучаем в лагере",
    text: "Никаких игрушечных проектов — только инструменты которые используют настоящие разработчики:",
    list: [
      "requests — отправляем HTTP-запросы к любому API, получаем данные о погоде, курсах валют, играх",
      "BeautifulSoup — парсинг сайтов: забираем данные с любой страницы без лишних усилий",
      "Pygame — двумерные игры с графикой и звуком, полный контроль над происходящим на экране",
      "Gemini API / OpenAI API — подключение нейросетей из Python-скрипта, генерация текста и изображений",
      "python-telegram-bot — создание ботов с командами, кнопками, базой данных и расписанием"
    ]
  },
  {
    h2: "Почему Python, а не Scratch для школьников 10+ лет",
    text: "Scratch отличный старт для 7–9-летних. Но ребята в 10+ лет часто чувствуют, что Scratch «стал тесным» — хочется большего. Вот почему Python — правильный шаг:",
    list: [
      "Scratch — конструктор. Python — настоящий инструмент. Те же концепции (циклы, условия, функции), но в виде текстового кода который используется в реальных компаниях",
      "На Python можно сделать бота, сайт, скрипт-автоматизатор — вещи которые реально пригодятся. На Scratch — только игру в браузере",
      "Переход с Python на любой другой язык (JavaScript, Go, C#) занимает 2–4 недели — понятия те же. Это «язык-трамплин»",
      "Отдача ощущается быстро: Telegram-бот написанный своими руками и запущенный на живом аккаунте — это мотиватор сильнее любой оценки"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену Python",
    text: "Финальный проект — не учебное задание, а реально работающая программа. Вот примеры проектов последних смен:",
    list: [
      "Telegram-бот «Помощник дежурного» — хранит расписание, присылает напоминания о домашних заданиях одноклассникам",
      "Парсер цен на Wildberries — скрипт, который мониторит нужный товар и пишет в чат когда цена упала",
      "Мини-RPG в консоли — текстовая игра с инвентарём, боями и несколькими концовками",
      "AI-генератор аватарок — Python + Gemini API, создаёт описание и стилизованный портрет по имени"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для изучения Python",
    text: "Выбирая Python-лагерь для ребёнка, родители сравнивают несколько вариантов. Вот что отличает АйДаКемп:",
    list: [
      "Реальный проект в финале — не «прошли тему», а готовая программа которую ребёнок может запустить дома и показать друзьям",
      "Преподаватели — практикующие разработчики, а не методисты из учебника. Знают индустрию изнутри, отвечают на вопросы «а как это работает в настоящих компаниях»",
      "Группы до 8 человек — преподаватель знает каждого ребёнка по имени и видит где тот застрял",
      "Погружение — Python изучается не 2 часа в неделю, а 4–6 часов в день, с живым общением в команде. За 10 дней — то, что в кружке занимает полгода",
      `Путёвка оформляется официально: образовательная лицензия ${STAT_LICENSE}, реестровый туроператор РТО ${STAT_RTO}`
    ]
  },
  {
    h2: "Чем лагерь Python отличается от онлайн-курса",
    text: "Онлайн-школа выдаёт учебный контент и ждёт что ребёнок сам сядет. В лагере Python изучается в окружении: утром код, днём бассейн и спорт, вечером работа над проектом в команде. Без телефона в кармане — внимание не рассеивается. Результат — готовый проект за 10–14 дней, а не «теоретическая база без практики»."
  },
  {
    h2: "Нужно ли что-то знать до лагеря Python",
    text: "Нет — мы принимаем и абсолютных новичков. У нас 3 группы по уровню, и каждый попадает в ту что соответствует его навыкам. Что всё-таки помогает на старте:",
    list: [
      "Знакомство со Scratch (даже поверхностное) — ускоряет понимание логики циклов и условий",
      "Умение быстро печатать на клавиатуре — часть смены уходит на набор кода, медленная печать мешает",
      "Знание английской раскладки — Python-ключевые слова: for, if, def, while",
      "Желание — это важнее всего остального. Мы не берём «из-под палки» — результат будет не тот"
    ]
  },
  {
    h2: "Места на Python-трек разбирают первыми",
    text: "Python — одна из самых популярных программ, поэтому группы заполняются заранее. Проверьте доступные смены и бронируйте место, как только определитесь с датами."
  },
  {
    h2: "Куда идти после лагеря Python",
    text: "За 10-14 дней у ребят появляется база Python. Что делать дальше чтобы не потерять навык? Несколько путей которые мы рекомендуем нашим выпускникам:",
    list: [
      "Продолжить в онлайн-школе (Алгоритмика, CodeFromHome) — по 2-3 урока в неделю",
      "Участвовать в хакатонах (Технокубок, Всероссийская олимпиада по информатике)",
      "Самостоятельно делать проекты — Telegram-боты для родителей, скрипты для школы",
      "Прийти в АйДаКемп ещё раз на другую тему (AI / Minecraft / Roblox) — багаж знаний расширится",
      "В 14+ лет — подписаться на курс «Python для работы» и начать работать на заказ"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/python-lager.avif"
  title={`Лагерь Python для детей 10–15 лет в Подмосковье ${SEASON_YEAR} — программирование | АйДаКемп`}
  description={`Летний лагерь Python для детей 10–15 лет в Подмосковье. Боты, скрипты, API. Смены ${SEASON_MONTHS_NOM} ${SEASON_YEAR}. Проект за смену. От ${PRICE_MIN}.`}
  h1="Лагерь Python для детей 10–15 лет в Подмосковье"
  canonical="https://aidacamp.ru/python-lager"
>
  <Fragment slot="head">
    <CourseSchema
      slot="head"
      name="Лагерь программирования Python для детей"
      description="Летний интенсив Python для детей 10–14 лет: с нуля до работающего проекта (Telegram-бот, игра, парсер) за 7 или 14 дней."
      url="https://aidacamp.ru/python-lager"
      level="Beginner"
      ageMin={10}
      ageMax={14}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь Python для детей 10–15 лет в Подмосковье"
    subtitle="За 10–14 дней ребёнок с нуля пишет работающий Python-проект: бот, игру или парсер. Без телефона в кармане, в живой команде."
    breadcrumb="Лагерь Python"
    keywords={["Python с нуля за 10 дней — для детей 10–14 лет", "Реальный проект в финале: бот, игра или AI-помощник", "Преподаватели-практики с опытом 6+ лет"]}
    image="/images/hero/python-lager.avif"
    imageAlt="Лагерь Python для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "С какого возраста дети учат Python в лагере?", a: "С 10 лет. Python-трек рассчитан на детей 10–14 лет. Для детей 7–9 лет есть трек Scratch — визуальное программирование без синтаксиса. Переход на Python обычно в 10–11 лет." },
    { q: "Что создают дети на Python за смену?", a: "За 10–14 дней — готовый проект: Telegram-бот, парсер данных, мини-игра или AI-ассистент. Начинающие доходят до рабочего бота, продвинутые — до более сложных проектов с API." },
    { q: "Нужен ли ноутбук для лагеря Python?", a: "Нет, ноутбук не нужен. Лагерь обеспечивает оборудованием: у каждого ребёнка — ноутбук с установленным Python и всеми нужными инструментами." },
    { q: "Нужен ли опыт программирования для Python-трека?", a: "Нет. Принимаем с нуля. Есть группы начинающих (первый раз пишут код), среднего уровня (есть базовые знания) и продвинутых (уверенный Python). Группы до 8 человек." },
    { q: "Есть ли в Python-лагере отдых или только учёба?", a: "Лагерь — это не школа. Половина дня — программирование (4–6 часов с перерывами), другая половина — бассейн, спорт, досуг с вожатыми. Дети работают над проектом в комфортном темпе." },
    { q: "Что такое хакатон в финале смены?", a: "В последний день каждый ребёнок защищает свой проект перед всей группой и родителями. Это не экзамен, а демонстрация — ребята показывают что сделали, отвечают на вопросы. Получают сертификат." },
    { q: "Можно ли приехать на Python-трек если ребёнок уже знает Python?", a: "Да. Уровень проверяется при записи — продвинутые дети попадают в группу с более сложными задачами: ООП, работа с API, базы данных. Скучно не будет." }
  ]} />

  <RelatedArticles articles={[
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej/", description: "Почему Python первый язык, с какого возраста и что создают дети за 2 недели.", icon: "code-slash" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Нулевой опыт — норма. Дорожная карта по возрастам и как работает интенсив.", icon: "braces" },
    { title: "Нейросети для детей — с чего начать и зачем", url: "/stati/nejroseti-dlya-detej/", description: "С какого возраста учить, что делают дети с ChatGPT, безопасность.", icon: "cpu" },
  ]} />
    <div class="mx-auto max-w-[720px] px-4 py-4 text-center text-base text-slate-500">
    Полезная статья: <a href="/stati/python-dlya-detej/" class="text-primary hover:underline">Python для детей: с какого возраста</a>
  </div>
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", description: "IT-программы и проекты для школьников 7–15 лет.", url: "/it-camp/", icon: "laptop" },
    { title: "Компьютерный лагерь", description: "Программирование, игры и цифровые проекты за смену.", url: "/kompyuternyy-lager/", icon: "pc-display" },
    { title: "Python для детей — статья", description: "С какого возраста начинать и что можно создать на Python.", url: "/stati/python-dlya-detej/", icon: "code-slash" },
    { title: "Цены и смены", description: "Даты, длительность и актуальная стоимость смен.", url: "/ceny/", icon: "currency-exchange" },
  ]} />
</LandingLayout>
