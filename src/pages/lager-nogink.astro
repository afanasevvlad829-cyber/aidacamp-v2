---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Ногинска до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 130 км от Ногинска, ~1 ч 40 мин. Маршрут на электричке + трансфере: электричка Горьковского направления → Курский вокзал → метро до м. Солнцево → организованный трансфер АйДаКемп (2 000 ₽). На машине: Горьковское шоссе → МКАД → Киевское шоссе (M-3) → посёлок Атепцево."
  },
  {
    h2: "Восток Подмосковья — IT идёт сюда",
    text: "Ногинск — один из самых восточных городов нашей аудитории. Семьи сюда едут целенаправленно: ищут не просто лагерь, а содержательное лето. Электричка Горьковского направления до Курского вокзала, потом метро и трансфер — маршрут понятный, ребята из Ногинска проезжают его самостоятельно уже с 11–12 лет.",
    list: [
      "Горьковское направление → Курский вокзал → метро → м. Солнцево → трансфер",
      "~1 ч 40 мин в дороге — сопоставимо с поездкой на курорт внутри страны",
      "Лицензия Минобрнауки, налоговый вычет до 5 434 ₽ — документы выдаются автоматически",
      "Рейтинг 5.0 на Яндекс.Картах — 40+ отзывов реальных семей"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — в маленьких группах никто не теряется. Медработник дежурит на территории круглосуточно. Родители получают фото из лагеря в Telegram-чат отряда каждый день.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый в фокусе",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram — родители всегда знают, что происходит",
      "Страховка включена в стоимость путёвки"
    ]
  },
  {
    h2: "Программа IT-лагеря для ребят из Ногинска",
    text: "Школьники 7–15 лет выбирают трек по интересу и уровню. Опыт программирования не нужен. Занятия дважды в день по 90 минут, в финале — хакатон, где каждый участник защищает собственный проект.",
    list: [
      "Python — от нуля до телеграм-бота за смену",
      "Scratch — визуальные игры для младших ребят 7–10 лет",
      "Minecraft Education — создание модов, игровые механики",
      "AI и нейросети — работа с ChatGPT API, обучение модели",
      "3D-моделирование — Blender и 3D-печать итогового проекта"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июльские смены раскупают первыми — популярный сезон. Если хотите определённую дату, лучше бронировать сейчас: июнь и август ещё открыты.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 99 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Ногинска и востока Подмосковья выбирают АйДаКемп за программу:",
    list: [
      "«Из Ногинска доехали на электричке до Москвы, потом трансфер лагеря — и всё, вопрос решён. Дочь вернулась с Python-проектом и кучей новых друзей» — Елена, Ногинск",
      "«Долго выбирала между морем и Подмосковьем. Выбрала АйДаКемп — ближе, без акклиматизации, а результат оказался лучше любого отпуска» — Ксения, Ногинск"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "Из Ногинска и востока Подмосковья в АйДаКемп едут семьи из нескольких городов:",
    list: [
      "<a href='/lager-shchelkovo'>Щёлково</a> — ~90 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин",
      "<a href='/lager-reutov'>Реутов</a> — ~75 км, ~1 ч 20 мин по МКАД",
      "<a href='/lager-pushkino'>Пушкино</a> — ~85 км, ~1 ч 30 мин через Ярославское шоссе"
    ]
  },
  {
    h2: "IT-лагерь с проживанием — чем отличается от лагеря «просто отдохнуть»",
    text: "В стандартном лагере программа — спорт и творчество. Ребёнок отдыхает, но к сентябрю забывает всё, что было. В АйДаКемп программа строится вокруг продукта: каждый создаёт что-то, что работает. Python-бот, Roblox-игра, AI-генератор, Minecraft-мир. Хакатон в финале — не «показ мам», а настоящая защита с вопросами и фидбеком.",
    list: [
      "Выбор трека: Python, AI, Minecraft, Roblox, 3D-моделирование",
      "Группы до 8 человек — не поток, а команда",
      "Бассейн, спорт, вечерние активности — без скуки",
      "Хакатон в последний день: проект → питч → сертификат"
    ]
  },
  {
    h2: "Что ребёнок привезёт из лагеря домой",
    text: "Не просто загар и воспоминания. После АйДаКемп дети привозят: работающий проект (бот, игру или приложение — зависит от трека), сертификат участника хакатона, и, как правило, несколько новых друзей из других городов. По данным опроса выпускников 2025: 78% продолжают программировать после смены, 41% показывают проект в школе на уроке информатики.",
    list: [
      "Работающий код: бот, игра, приложение — зависит от выбранного трека",
      "Сертификат участника хакатона АйДаКемп",
      "78% продолжают программировать после лагеря (опрос 2025)",
      "Новые друзья из других городов — переписываются потом годами"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Ногинск 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Ногинска: ~1.5–2 ч по МКАД → Киевское шоссе. IT-программа, Python, AI, Minecraft для ребят 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Ногинском"
  canonical="https://aidacamp.ru/lager-nogink"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Ногинска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Ногинска около 130 км и ~1.5–2 часа: электричка Горьковского направления до Курского вокзала, затем метро до м. Солнцево и трансфер АйДаКемп (2 000 ₽). На машине: по МКАД → Киевское шоссе (M-3) → посёлок Атепцево." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Ногинска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часа. На автомобиле 130 км через МКАД → Киевское шоссе. На общественном транспорте: электричка Горьковского направления до Москвы + трансфер от м. Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Ногинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Ногинска нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Ногинска удобно доехать на электричке Горьковского направления до Москвы, затем метро до Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Ногинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 99 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Ногинском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Ногинска. Python, AI, Minecraft для ребят 7–15 лет."
      url="https://aidacamp.ru/lager-nogink"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Ногинском"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Ногинска через МКАД → Киевское шоссе. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь из Ногинска"
    keywords={["~1.5 ч от Ногинска через МКАД", "IT-лагерь: Python, AI, Minecraft для ребят 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Ногинском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
