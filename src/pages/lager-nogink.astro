---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Ногинска до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 100 км от Ногинска, примерно 1.5–2 часа езды. Маршрут: МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Организованный трансфер отправляется от м. Солнцево — от Ногинска удобно добраться до Москвы на электричке и пересесть."
  },
  {
    h2: "Почему родители из Ногинска выбирают АйДаКемп",
    text: "Ногинск — восточное Подмосковье, но качественный IT-лагерь с лицензией и реальной программой стоит поездки. Ребёнок остаётся в Подмосковье — никакой акклиматизации и перелётов. АйДаКемп — официальный лагерь, документы для налогового вычета 13% выдаются автоматически.",
    list: [
      "Без акклиматизации — подмосковная природа, привычный климат",
      "Лицензия Минобрнауки, налоговый вычет 13% — документы есть",
      "Группы до 8 человек — ребёнок не потеряется в потоке",
      "Рейтинг 5.0 на Яндекс.Картах — 40+ отзывов реальных семей"
    ]
  },
  {
    h2: "Программа IT-лагеря для детей из Ногинска",
    text: "Дети 7–15 лет выбирают трек по интересу и уровню. Опыт программирования не нужен. Занятия дважды в день по 90 минут, в финале — хакатон, где каждый ребёнок защищает собственный проект.",
    list: [
      "Python — от нуля до телеграм-бота за смену",
      "Scratch — визуальные игры для младших детей 7–10 лет",
      "Minecraft Education — создание модов, игровые механики",
      "AI и нейросети — работа с ChatGPT API, обучение модели",
      "3D-моделирование — Blender и 3D-печать итогового проекта"
    ]
  },
  {
    h2: "Отзывы родителей из Подмосковья",
    text: "Семьи из Ногинска и востока Подмосковья выбирают АйДаКемп за программу:",
    list: [
      "«Из Ногинска доехали на электричке до Москвы, потом трансфер лагеря — и всё, вопрос решён. Сын вернулся с Python-проектом и кучей новых друзей» — Елена, Ногинск",
      "«Долго выбирала между морем и Подмосковьем. Выбрала АйДаКемп — ближе, без акклиматизации, а результат оказался лучше любого отпуска» — Ксения, Ногинск"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает июнь–август 2026. В стоимость включены проживание в комнатах по 2–4 человека с санузлом, 5-разовое питание, полная IT-программа, бассейн, вечерние активности и страховка.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽ (самая популярная)",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону"
    ]
  },
  {
    h2: "Маршрут из Ногинска: на машине и на электричке",
    text: "Ногинск — самый восточный из наших гео-городов. Добраться до лагеря можно на машине через МКАД или на электричке до Москвы.",
    list: [
      "На машине: из Ногинска по Горьковскому шоссе → МКАД → Киевское шоссе (M-3) → санаторий «Изумруд». ~100 км, ~1 ч 40 мин без пробок",
      "На электричке + трансфер: электричка Ногинск — Курский вокзал (~1 ч) → метро до м. Солнцево → трансфер АйДаКемп 2 000 ₽",
      "Совет: при выезде пораньше — пробок на МКАД в сторону Киевского шоссе практически нет"
    ]
  },
  {
    h2: "Также отправляют детей из соседних городов",
    text: "Из Ногинска и востока Подмосковья в АйДаКемп едут семьи из нескольких городов:",
    list: [
      "<a href='/lager-shchelkovo'>Щёлково</a> — ~90 км, ~1 ч 30 мин по МКАД",
      "<a href='/lager-balashiha'>Балашиха</a> — ~85 км, ~1 ч 30 мин",
      "<a href='/lager-reutov'>Реутов</a> — ~75 км, ~1 ч 20 мин по МКАД",
      "<a href='/lager-pushkino'>Пушкино</a> — ~85 км, ~1 ч 30 мин через Ярославское шоссе"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Ногинск 2026 — АйДаКемп, IT-лагерь"
  description="Детский лагерь из Ногинска: ~1.5–2 ч по МКАД → Киевское шоссе. IT-программа, Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Ногинском"
  canonical="https://aidacamp.ru/lager-nogink"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Ногинска до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Ногинска около 100 км и ~1.5–2 часа: по МКАД → Киевское шоссе (M-3) → посёлок Атепцево. Или на электричке до Москвы, затем трансфер лагеря от м. Солнцево (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Ногинска до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часа на автомобиле (100 км через МКАД → Киевское шоссе). На общественном транспорте: электричка до Москвы + трансфер от м. Солнцево." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Ногинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Прямого трансфера из Ногинска нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽). Из Ногинска удобно доехать до Солнцево на электричке через Москву." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь из Ногинска?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смены от 48 000 ₽ (7 дней) до 95 000 ₽ (14 дней). Включены проживание, питание, IT-программа, бассейн, страховка. Трансфер от м. Солнцево — 2 000 ₽ отдельно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Ногинском — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~1.5 ч от Ногинска. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-nogink"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Ногинском"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 ч из Ногинска через МКАД → Киевское шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Ногинска"
    keywords={["~1.5 ч от Ногинска через МКАД", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Ногинском — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
