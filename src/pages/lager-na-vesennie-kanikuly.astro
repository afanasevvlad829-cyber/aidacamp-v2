---
import { PRICE_MIN, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import SeasonPreRegister from '../components/SeasonPreRegister.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';

const sections = [
  {
    h2: "Весенние каникулы — неделя перезагрузки перед последней четвертью",
    text: "К концу марта школьники выжаты: третья четверть — самая длинная в году. Неделя каникул дома обычно уходит на телефон и «ничего не хочу». Выездная смена работает иначе: смена обстановки, живые ребята вокруг, проект, который хочется доделать. Ребёнок возвращается к последней четверти не измотанным, а заряженным — и с работающим мини-проектом."
  },
  {
    h2: "Программа весенней смены",
    text: "Полноценный IT-интенсив, адаптированный под короткий формат недели. Треки по возрасту и уровню: Scratch и Minecraft для 7–10 лет, Python и AI для 10–15 лет, Roblox Studio для тех, кто хочет делать игры. Занятия, практика и командный проект каждый день. В финале — защита мини-проекта. Вся техника в лагере — ноутбук привозить не нужно.",
    list: [
      "Scratch — анимации и первые игры для 7–10 лет",
      "Minecraft Education — редстоун, моды, командная стройка",
      "Python — переменные, функции, мини-бот за неделю",
      "AI и нейросети — работа с ChatGPT API, генерация кода",
      "Roblox Studio — 3D-сцены и Lua-скрипты"
    ]
  },
  {
    h2: "Даты и стоимость весенней смены",
    text: `Весенние каникулы 2027 — ориентировочно последняя неделя марта. Даты смены предварительные: школы опубликуют расписание каникул 2026/27 учебного года в сентябре, и мы сразу скорректируем даты под него. Формат — 7 дней на базе санатория «Изумруд» в Подмосковье. Ориентир по стоимости — от ${PRICE_MIN}: финальную цену объявим вместе с датами.`,
    list: [
      "Смена 7 дней — ориентировочно конец марта 2027",
      "Даты предварительные — уточним в сентябре по расписанию школьных каникул",
      "В стоимость включено: проживание, 5-разовое питание, IT-программа, бассейн",
      "Предварительная запись без оплаты — напишем первыми при подтверждении дат",
      `Налоговый вычет 13% — до ${VYCHET_MAX} (максимум по летним сменам, для весенней рассчитаем при объявлении цены)`
    ]
  },
  {
    h2: "Что ребёнок успеет за неделю",
    text: "Семь дней — это больше, чем кажется, когда день структурирован и окружение заряжает. За короткую смену ребёнок осваивает базовый трек своего возраста, делает работающий мини-проект и публично его защищает. И находит друзей, которым интересно то же самое.",
    list: [
      "День 1–2: знакомство со средой, первые упражнения, команда",
      "День 3–5: основной трек — код, логика, первый прототип",
      "День 6–7: доработка проекта, тест и защита",
      "Итог: рабочий проект + новые друзья + энергия на последнюю четверть"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="IT-лагерь на весенние каникулы 2027 в Подмосковье | АйДаКемп"
  description={`Детский IT-лагерь на весенние каникулы 2027 в Подмосковье — программирование, AI, командный проект за неделю. Предварительная запись открыта. Ориентир — от ${PRICE_MIN}.`}
  h1="IT-лагерь на весенние каникулы 2027"
  canonical="https://aidacamp.ru/lager-na-vesennie-kanikuly"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru" },
            { "@type": "ListItem", "position": 2, "name": "Лагерь на весенние каникулы", "item": "https://aidacamp.ru/lager-na-vesennie-kanikuly" }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Когда весенние каникулы 2027?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ориентировочно последняя неделя марта 2027. Точное расписание школы опубликуют в сентябре — тогда мы скорректируем даты смены. Оставьте предварительную заявку, и мы напишем первыми."
              }
            },
            {
              "@type": "Question",
              "name": "Как работает предварительная запись?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Оставляете контакт без оплаты. Когда школы подтвердят даты каникул, мы напишем первыми, предложим точные даты смены и зафиксируем раннюю цену. Предзапись ни к чему не обязывает."
              }
            },
            {
              "@type": "Question",
              "name": "Подойдёт ли ребёнку без опыта программирования?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Да. Группы разбиваем по уровню: новички, средний, продвинутый. За неделю ребёнок с нуля осваивает базовый Scratch или Python и делает первый проект."
              }
            },
            {
              "@type": "Question",
              "name": "Нужно ли специальное оборудование?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Нет. Ноутбук не нужен — у нас собственный парк техники. Из одежды: удобная повседневная, спортивная форма и куртка по погоде — конец марта в Подмосковье прохладный."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <LandingHero slot="hero"
    h1="IT-лагерь на весенние каникулы 2027"
    subtitle="Неделя перезагрузки перед последней четвертью: проект, друзья и энергия вместо телефона."
    breadcrumb="Лагерь на весенние каникулы"
    keywords={[
      "Программирование, AI, командный проект — за 7 дней",
      "Ноутбук не нужен — своя техника в лагере",
      "Подмосковье, 66 км от МКАД — трансфер от м. Солнцево"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="IT-лагерь на весенние каникулы АйДаКемп"
  />

  <LandingTwoCol sections={sections} />
  <SeasonPreRegister seasonAcc="весеннюю смену 2027" slug="vesna-2027" />
  <Shifts />
  <FAQ />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
