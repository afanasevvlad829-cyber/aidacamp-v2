---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import { STAT_RATING } from '../data/contacts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';

const sections = [
  {
    h2: "Что такое тематический лагерь",
    text: "Тематическая смена — это когда у неё есть одна сквозная идея на все дни, а не набор случайных активностей: «День без гаджетов», хакатон и командные соревнования — тоже часть темы. В лагере АйДаКемп темы связаны с IT: одна смена — про нейросети, другая — про Minecraft, третья — про Python. Ребёнок не просто «отдохнул» — он сделал вещь, которую можно показать друзьям."
  },
  {
    h2: `Темы смен ${SEASON_YEAR} — что выбрать`,
    text: `Путёвку можно оформить онлайн — от ${PRICE_S4}. Рейтинг ${STAT_RATING} на Яндекс.Картах — по отзывам родителей прошлых смен.`,
    list: [
      `Смена 1 (завершена, ${DATES_S1}) «Стартап с нуля» — <a href='/it-camp/' class='text-primary hover:underline'>IT-проект</a> от идеи до питча: мини-предприятие и защита перед жюри`,
      `Смена 2 (завершена, ${DATES_SHORT_S2}) «AI-эксперимент» — проекты с AI-инструментами: Gemini, ChatGPT, генерация изображений`,
      "Смена 2.1/2.2 (завершена, июнь, 7–8 дней) «Первый код» — знакомство с программированием с нуля: Scratch и базовый Python",
      `Смена 3 (${DATES_SHORT_S3}) «Геймдев-смена» — 3D-игра в Roblox Studio или Minecraft, командная работа`,
      `Смена 4 (${DATES_SHORT_S4}) «Медиа и контент» — свой канал, видео, графика и дизайн`
    ]
  },
  {
    h2: "Как работает тематический формат на практике",
    text: "Обычная смена — набор несвязанных активностей: сегодня купаемся, завтра лепим из глины. Здесь иначе: у смены есть сюжет, который связывает всё и ведёт к финалу — IT-проект. Утром занятия по теме, днём практика и командный вызов, вечером работа над проектом.",
    list: [
      "Утро — занятия по теме смены (Python / AI / Minecraft / 3D)",
      "День — практика и командный вызов",
      "Вечер — работа над личным проектом"
    ]
  },
  {
    h2: "Какие IT-программы есть в лагере АйДаКемп",
    text: "Каждая смена в лагере — отдельный IT-трек со своей методикой и результатом. Три направления:",
    list: [
      "IT и программирование — Python, Scratch, боты и скрипты. С 7 лет, от новичка до продвинутого уровня",
      "Хакатоны и проектная работа — командная разработка продукта от идеи до защиты. Особенно ценно детям 12–15 лет",
      "AI и нейросети — практика с ChatGPT, Gemini, генерацией изображений. Самое популярное направление среди детей 10+ лет"
    ]
  },
  {
    h2: "Как выбрать тему по возрасту",
    text: "Не все тематические направления одинаково подходят для разных возрастов. Короткая шпаргалка:",
    list: [
      "7–9 лет — «Первый код»: Scratch, простые игры и анимации без стресса от синтаксиса",
      "10–12 лет — Python или Minecraft: первые проекты на реальном языке",
      "11–13 лет — Геймдев: Unity или Roblox, командная разработка игры за две недели",
      "12–15 лет — AI и нейросети: ChatGPT API, генераторы, актуальные инструменты"
    ]
  },
  {
    h2: "Что ребёнок сделает за смену",
    text: "Не «познакомится с основами», а создаст конкретный продукт. Вот что забирают домой:",
    list: [
      "AI-смена: чат-бот на ChatGPT API, генератор изображений, голосовой ассистент",
      "Python-смена: телеграм-бот, игра на pygame, скрипт автоматизации",
      "Геймдев-смена: своя карта в Roblox, персонаж с анимацией в Unity, уровень с механиками",
      "Стартап-смена: питч-deck, прототип сайта или приложения, защита перед жюри"
    ]
  },
  {
    h2: "Чем такой формат отличается от обычного лагеря?",
    text: "Обычный лагерь — это отряд, кружки по расписанию и дискотека вечером. Формат тематического лагеря строит всю смену вокруг одной большой идеи: наш лагерь делает это через IT-проект. Ребята точно так же плавают в бассейне и гоняют в футбол — но каждый день продвигает проект к финалу. Такой лагерь запоминается не списком развлечений, а результатом: игрой, ботом или нейросетью, которую ребёнок сделал сам и показал родителям на защите. Такой лагерь подходит и новичкам, и тем, кто уже бывал в обычном лагере: программа рассчитана на любой уровень. Хороший лагерь — это баланс отдыха и результата, и наш лагерь держит его весь заезд."
  }
];

---

<LandingLayout
  heroImage="/images/hero/tematicheskiy-lager.avif"
  title={`Тематический IT-лагерь ${SEASON_YEAR} — AI, Python, Gamedev | АйДаКемп`}
  description={`Тематический IT-лагерь: каждая смена посвящена одному направлению — AI, Python или Gamedev. Квесты, соревнования и разные активности каждый день. Дети 7-15 лет, Подмосковье, от ${PRICE_MIN}.`}
  h1="Тематический IT-лагерь для детей"
  canonical="https://aidacamp.ru/tematicheskiy-lager"
>
  <LandingHero slot="hero"
    h1="Тематический IT-лагерь для детей"
    subtitle="Каждая смена в лагере АйДаКемп — отдельная тема: AI, Python, Gamedev или Медиа. Ребёнок выбирает направление и уходит с готовым проектом."
    breadcrumb="О смене"
    keywords={["Каждая смена — своя тема и направление", "Особые дни и итоговый хакатон", "IT-тематика: AI, Python, Minecraft, дизайн"]}
    image="/images/hero/tematicheskiy-lager.avif"
    imageAlt="Летний IT-лагерь для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что такое тематический лагерь для детей?", a: "Это когда вся программа смены посвящена одной теме. В лагере каждый ребёнок выбирает IT-трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Тема проходит через все занятия и итоговый хакатон." },
    { q: "Сколько длится тематическая программа?", a: "Такая смена идёт полный срок — 10–14 дней, как и обычный лагерь. За это время в тематическом лагере ребёнок проходит весь путь: от идеи до готового проекта. Отправить его в такую смену можно с 7 лет — программа разбита по возрастам." },
    { q: "Чем такой формат отличается от обычного лагеря?", a: "В обычном лагере — разрозненные активности. Здесь — всё связано единой нитью. В лагере АйДаКемп эта нить — IT-проект: каждая смена строится вокруг своей темы (AI, Minecraft, геймдев), и ребёнок создаёт конкретный продукт к финалу." },
    { q: "Как выбрать тему смены?", a: "В лагере темы привязаны к сменам и определены заранее. На смену 1 — стартап и бизнес-проект, на 2-ю — AI-эксперименты, на 3-ю — геймдев (Roblox/Minecraft), на 4-ю — медиа и контент. Выбирайте по интересам ребёнка." },
    { q: "Подойдёт ли наш формат новичку?", a: "Да. В каждой смене есть группы для начинающих: базовые техники преподаются с нуля в рамках темы смены. Опыт программирования не нужен — нужно только любопытство." },
    { q: "Сколько стоит тематическая смена?", a: `Открытые августовские смены — от ${PRICE_MIN} за 10 дней (смена 4) до ${PRICE_MAX} за 13 дней (смена 3). В стоимость включены проживание, питание, IT-программа по теме смены, бассейн и активности.` }
  ]} only={['medicine', 'safety', 'food', 'accommodation', 'documents', 'communication', 'payment']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
