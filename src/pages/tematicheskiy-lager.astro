---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Что такое тематический лагерь",
    text: "Тематический лагерь — это когда у каждой смены есть своя сквозная идея. В АйДаКемп темы связаны с IT: одна смена сфокусирована на AI и нейросетях, другая — на Minecraft и разработке игр, третья — на питоне и командных проектах. Внутри смены — тематические дни, эвенты и итоговый хакатон."
  },
  {
    h2: "Тематические смены 2026",
    text: "",
    list: [
      "Смена 1 — старт: первый проект, основы IT",
      "Смена 2 — полный цикл: от идеи до защиты проекта",
      "Смена 3 — командная работа и совместный результат",
      "Смена 4 — финал лета: сильный проект за 10 дней"
    ]
  },
  {
    h2: "Тематические дни и активности",
    text: "Кроме IT-занятий в каждой смене — тематические дни: «День без гаджетов», «Хакатон», «День профессий в IT», квесты и командные соревнования. Это не «развлекаловка», а часть образовательной программы — дети учатся работать в команде и справляться с давлением дедлайнов."
  },
  {
    h2: "Как работает тематический формат на практике",
    text: "Обычный лагерь — набор несвязанных активностей: сегодня купаемся, завтра играем в вышибалы, послезавтра лепим из глины. Тематический лагерь строится иначе: все активности связаны общей нитью, ведущей к финальному результату. В АйДаКемп эта нить — IT-проект, который ребёнок развивает всю смену.",
    list: [
      "Утро — занятия по теме смены (Python / AI / Minecraft / 3D)",
      "День — практика, в формате игры или командного вызова",
      "Вечер — работа над индивидуальным проектом",
      "Еженедельная промежуточная защита — не только финальная",
      "Каждая активность (даже спорт и бассейн) с элементами соревнования по теме"
    ]
  },
  {
    h2: "Темы смен 2026 подробно",
    text: "Мы не просто называем смены «1, 2, 3, 4» — у каждой есть своя подтема, которая раскрывается через 10-14 дней. Вот что запланировано на лето 2026:",
    list: [
      "Смена 1 (30 мая–8 июня): «Стартап с нуля» — дети создают собственное мини-предприятие, работают над идеей, монетизацией, питчем",
      "Смена 2 (10–23 июня): «AI-эксперимент» — все проекты с использованием AI-инструментов (Gemini, ChatGPT)",
      "Смена 2.1/2.2 (короткие 7-8 дней): «Первый код» — для новичков, знакомство с программированием",
      "Смена 3 (3–15 августа): «Геймдев-смена» — разработка 3D-игры в Roblox Studio или Minecraft",
      "Смена 4 (17–26 августа): «Медиа и контент» — создание канала, видеопроизводство, графика"
    ]
  },
  {
    h2: "Чем тематический лагерь отличается по результату",
    text: "Обычный лагерь — «отдохнули, получили эмоции». Тематический — «отдохнули, получили эмоции ПЛЮС конкретный результат по теме». Ребёнок уходит не только с новыми фотками и друзьями, но и с: готовым стартап-питчем (смена 1), AI-экспериментом (смена 2), своей 3D-игрой (смена 3), собственным медиа-каналом (смена 4). Это то, что сразу можно показать и объяснить: «мы не просто тусили, я сделал конкретную вещь». Для родителя — подтверждение что инвестиция в смену оправдалась."
  }
];

const relatedPages = [
  { title: "Лагерь Майнкрафт", description: "Создание миров и модов", url: "/minecraft-lager", emoji: "⛏️" },
  { title: "Лагерь программирования", description: "От первого кода до своего проекта", url: "/lager-programmirovaniya", emoji: "⌨️" },
  { title: "Детский лагерь Подмосковье", description: "66 км от Москвы, бассейн, питание", url: "/detskiy-lager-podmoskove", emoji: "🌲" },
];
---

<LandingLayout
  heroImage="/images/hero/tematicheskiy-lager.avif"
  title="Тематический лагерь для детей в Подмосковье 2026 — IT-тематика | АйДаКемп"
  description="Тематический детский лагерь в Подмосковье с IT-направленностью. Каждая смена — своя тема: AI, Minecraft, Python. Лето 2026, от 48 000 ₽."
  h1="Тематический лагерь для детей в Подмосковье"
  canonical="https://aidacamp.ru/tematicheskiy-lager"
>
  <LandingHero slot="hero"
    h1="Тематический лагерь для детей в Подмосковье"
    subtitle="Каждая смена АйДаКемп — это отдельная тема: от AI-проектов до Minecraft-разработки."
    breadcrumb="Тематический лагерь"
    keywords={["Каждая смена — своя тема и направление", "Тематические дни и итоговый хакатон", "IT-тематика: AI, Python, Minecraft, дизайн"]}
    image="/images/hero/tematicheskiy-lager.avif"
    imageAlt="Тематический лагерь для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={relatedPages} />
</LandingLayout>
