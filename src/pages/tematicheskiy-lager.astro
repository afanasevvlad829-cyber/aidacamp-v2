---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое тематический лагерь",
    text: "Тематический лагерь — это когда у каждой смены есть своя сквозная идея. В АйДаКемп темы связаны с IT: одна смена сфокусирована на AI и нейросетях, другая — на Minecraft и разработке игр, третья — на Python и командных проектах. Внутри смены — тематические дни, эвенты и итоговый хакатон. Ребёнок не просто «побывал в лагере» — он сделал конкретную вещь, которую можно показать."
  },
  {
    h2: "Темы смен 2026 — что выбрать",
    text: "",
    list: [
      `Смена 1 (завершена, ${DATES_S1}) «Стартап с нуля» — <a href='/it-camp/' class='text-primary hover:underline'>IT-проект</a> от идеи до питча: мини-предприятие, монетизация, презентация перед жюри`,
      `Смена 2 (завершена, ${DATES_SHORT_S2}) «AI-эксперимент» — все проекты с использованием AI-инструментов: Gemini, ChatGPT, генераторы изображений`,
      "Смена 2.1/2.2 (завершена, июнь, 7–8 дней) «Первый код» — для новичков: знакомство с программированием с нуля, Scratch и базовый Python",
      `Смена 3 (${DATES_SHORT_S3}) «Геймдев-смена» — разработка 3D-игры в Roblox Studio или Minecraft, командная работа`,
      `Смена 4 (${DATES_SHORT_S4}) «Медиа и контент» — создание канала, видеопроизводство, графика и дизайн`
    ]
  },
  {
    h2: "Тематические дни и активности",
    text: "Кроме IT-занятий в каждой смене — тематические дни: «День без гаджетов», «Хакатон», «День профессий в IT», квесты и командные соревнования. Это не «развлекаловка», а часть образовательной программы — дети учатся работать в команде и справляться с давлением дедлайнов."
  },
  {
    h2: "Как работает тематический формат на практике",
    text: "Обычный лагерь — набор несвязанных активностей: сегодня купаемся, завтра играем в вышибалы, послезавтра лепим из глины. Тематический лагерь строится иначе: все активности связаны общей нитью, ведущей к финальному результату. В АйДаКемп эта нить — IT-проект, который ребята развивают всю смену.",
    list: [
      "Утро — занятия по теме смены (Python / AI / Minecraft / 3D)",
      "День — практика, в формате игры или командного вызова",
      "Вечер — работа над индивидуальным проектом",
      "Еженедельная промежуточная защита — не только финальная",
      "Каждая активность (даже спорт и бассейн) с элементами соревнования по теме"
    ]
  },
  {
    h2: "Темы смен 2026 подробно",
    text: "Мы не просто называем смены «1, 2, 3, 4» — у каждой есть своя подтема, которая раскрывается через 10-14 дней. Вот что запланировано на лето 2026:",
    list: [
      `Смена 1 (завершена, ${DATES_S1}): «Стартап с нуля» — ребята создают собственное мини-предприятие, работают над идеей, монетизацией, питчем`,
      `Смена 2 (завершена, ${DATES_SHORT_S2}): «AI-эксперимент» — все проекты с использованием AI-инструментов (Gemini, ChatGPT)`,
      "Смена 2.1/2.2 (завершена, короткие 7-8 дней): «Первый код» — для новичков, знакомство с программированием",
      `Смена 3 (${DATES_SHORT_S3}): «Геймдев-смена» — разработка 3D-игры в Roblox Studio или Minecraft`,
      `Смена 4 (${DATES_SHORT_S4}): «Медиа и контент» — создание канала, видеопроизводство, графика`
    ]
  },
  {
    h2: "Чем тематический лагерь отличается по результату",
    text: "Обычный лагерь — «отдохнули, получили эмоции». Тематический — «отдохнули, получили эмоции ПЛЮС конкретный результат по теме». Ребёнок уходит не только с новыми фотками и друзьями, но и с: готовым стартап-питчем (смена 1), AI-экспериментом (смена 2), своей 3D-игрой (смена 3), собственным медиа-каналом (смена 4). Это то, что сразу можно показать и объяснить: «мы не просто тусили, я сделал конкретную вещь». Для родителя — подтверждение что инвестиция в смену оправдалась."
  },
  {
    h2: "Какие тематические IT-программы есть в АйДаКемп",
    text: "Каждая смена в АйДаКемп — это отдельный IT-трек с собственной методикой и конечным продуктом. Три главных направления:",
    list: [
      "IT и программирование — Python, Scratch, создание ботов и скриптов. Подходит детям с 7 лет, есть уровни от новичка до продвинутого",
      "Хакатоны и проектная работа — командная разработка продукта от идеи до защиты. Особенно ценно для детей 12–15 лет: учит работать в команде, брать ответственность, презентовать результат",
      "AI и нейросети — практика с ChatGPT, Gemini, генерацией изображений и базовыми алгоритмами машинного обучения. Самое популярное направление среди детей 10+ лет"
    ]
  },
  {
    h2: "Как выглядит день тематической смены: пример расписания",
    text: "День в тематической смене АйДаКемп выстроен так, чтобы всё подчинялось единой идее смены:",
    list: [
      "8:00 — подъём, зарядка, завтрак",
      "9:30–11:00 — первый блок IT-занятий по теме смены (теория + практика)",
      "11:15–13:00 — второй блок: работа над тематическим проектом в команде",
      "13:00–15:00 — обед, тихий час / свободное время",
      "15:00–17:00 — тематическая активность (квест по теме смены, соревнование)",
      "17:00–18:30 — бассейн, спорт на воздухе",
      "19:00 — ужин, вечерняя программа",
      "20:30 — индивидуальная работа над проектом, общение, подготовка к следующему дню"
    ]
  },
  {
    h2: "Как выбрать тему по возрасту",
    text: "Не все темы одинаково подходят для разных возрастов. Вот короткая шпаргалка:",
    list: [
      "7–9 лет — смена «Первый код»: Scratch, создание анимаций и простых игр, без стресса от синтаксиса",
      "10–12 лет — Python или Minecraft: первые проекты на реальном языке, понятные задачи с видимым результатом",
      "11–13 лет — Геймдев: Unity или Roblox, командная разработка игры с нуля за две недели",
      "12–15 лет — AI и нейросети: ChatGPT API, генераторы, реальные инструменты — то, что актуально прямо сейчас"
    ]
  },
  {
    h2: "Что ребёнок сделает на каждой тематической смене",
    text: "Не «познакомится с основами», а создаст конкретный продукт. Вот что забирают домой с каждой темы:",
    list: [
      "AI-смена: чат-бот на ChatGPT API, генератор изображений по запросу, голосовой ассистент для простых задач",
      "Python-смена: телеграм-бот с командами, игра на pygame, скрипт автоматизации файлов",
      "Геймдев-смена: собственная игровая карта в Roblox, персонаж с анимацией в Unity, уровень с механиками и врагами",
      "Стартап-смена: питч-deck на 5 слайдов, прототип сайта или приложения, защита перед жюри"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/tematicheskiy-lager.avif"
  title="Тематический IT-лагерь 2026 — AI, Python, Gamedev | АйДаКемп"
  description={`Тематический IT-лагерь: каждая смена посвящена одному направлению — AI, Python или Gamedev. Квесты, соревнования и тематические активности каждый день. Дети 7-15 лет, Подмосковье, от ${PRICE_MIN}.`}
  h1="Тематический IT-лагерь для детей"
  canonical="https://aidacamp.ru/tematicheskiy-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое тематический лагерь для детей?", a: "Тематический лагерь — это когда вся программа смены посвящена одной теме. В АйДаКемп каждый ребёнок выбирает IT-трек: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Тема проходит через все занятия и итоговый хакатон." },
    { q: "Чем тематический лагерь отличается от обычного?", a: "В обычном лагере — разрозненные активности. В тематическом — всё связано единой нитью. В АйДаКемп эта нить — IT-проект: каждая смена строится вокруг своей темы (AI, Minecraft, геймдев), и ребёнок создаёт конкретный продукт к финалу." },
    { q: "Как выбрать тему тематического лагеря?", a: "В АйДаКемп темы привязаны к сменам и определены заранее. На смену 1 — стартап и бизнес-проект, смена 2 — AI-эксперименты, смена 3 — геймдев (Roblox/Minecraft), смена 4 — медиа и контент. Выбирайте по интересам ребёнка." },
    { q: "Подойдёт ли тематический лагерь новичку?", a: "Да. В каждой смене есть группы для начинающих: базовые техники преподаются с нуля в рамках темы смены. Опыт программирования не нужен — нужно только любопытство." },
    { q: "Сколько стоит тематическая смена?", a: `Открытые августовские смены — от ${PRICE_MIN} за 10 дней (смена 4) до ${PRICE_MAX} за 13 дней (смена 3). В стоимость включены проживание, питание, IT-программа по теме смены, бассейн и активности.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Тематический IT-лагерь для детей"
    subtitle="Каждая смена АйДаКемп — отдельная тема: AI, Python, Gamedev или Медиа. Ребёнок выбирает направление и уходит с готовым проектом."
    breadcrumb="Тематический лагерь"
    keywords={["Каждая смена — своя тема и направление", "Тематические дни и итоговый хакатон", "IT-тематика: AI, Python, Minecraft, дизайн"]}
    image="/images/hero/tematicheskiy-lager.avif"
    imageAlt="Тематический лагерь для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={[
    { title: 'IT-лагерь', description: 'Программирование, AI, Minecraft — полное погружение', url: '/it-camp/', icon: 'bi-laptop' },
    { title: 'Лагерь на лето 2026', description: 'Все смены и даты летнего сезона', url: '/lager-na-leto-2026/', icon: 'bi-sun' },
    { title: 'Цены и смены', description: 'Стоимость и даты всех смен 2026', url: '/ceny/', icon: 'bi-receipt' },
    { title: 'Детский лагерь', description: 'Загородный лагерь для детей 7–15 лет', url: '/detskiy-lager/', icon: 'bi-house-heart' },
  ]} />
</LandingLayout>
