---
import { DATES_S1, DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S22, PRICE_MAX, PRICE_MIN, PRICE_S22, PRICE_S4, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Июньские смены — когда ехать и что выбрать",
    text: "В <a href='/detskiy-lager'>АйДаКемп</a> в июне работают три смены на любой семейный сценарий. С 30 мая по 8 июня — 10-дневная смена, хорошо ложится на те семьи, где старших ещё не отпустили с уроков, а младшим уже нечего делать дома. С 10 по 23 июня — 14-дневная, самая популярная смена лета: ребята успевают вжиться, сдружиться и сделать настоящий проект. Июнь хорош ещё и тем, что нет экзаменов у начальной и средней школы — никакого стресса, едут спокойно. До июльских отпусков и поездок к бабушке ещё далеко, можно спланировать всё чётко.",
    list: [
      `Смена 1: ${DATES_S1}, 10 дней, ${PRICE_S4}`,
      `Смена 2: ${DATES_SHORT_S2}, 14 дней, ${PRICE_MAX} — самая популярная`,
      `Смена 2.1: ${DATES_SHORT_S21}, 7 дней, ${PRICE_MIN} — короткая, для первого раза`,
      `Смена 2.2: ${DATES_SHORT_S22}, 8 дней, ${PRICE_S22} — вторая неделя отдельно`
    ]
  },
  {
    h2: "Что успевает ребёнок за 10–14 дней в июне",
    text: "За июньскую смену — реальный проект, который можно показать друзьям и повесить в портфолио. Не «я прошёл курс», а «я написал бота» или «я сделал игру». Занятия каждый день по 3–4 часа, группы не больше 8 человек — преподаватель знает каждого по имени. Смотри все направления: <a href='/python-lager'>Python-лагерь</a>, <a href='/minecraft-lager'>Minecraft</a>, <a href='/scratch-lager'>Scratch</a>.",
    list: [
      "Python (10–14 лет) — от переменных до Telegram-бота с базой данных",
      "Scratch (7–10 лет) — первая игра, анимация, интерактивная история",
      "Minecraft Education — строим, программируем, создаём собственный мод",
      "AI-треки (12–15 лет) — подключение нейросети, генерация текста и картинок из кода",
      "Вечером — командные проекты, хакатон в финале смены"
    ]
  },
  {
    h2: "Urgency: почему июнь нужно бронировать сейчас",
    text: `Июнь — самый ходовой месяц. Смена 2 (${DATES_SHORT_S2}) обычно заполняется раньше остальных: семьи, которые уже были с нами, берут места в феврале-марте. В мае остаются буквально считанные места. Смены 2.1 и 2.2 немного свободнее, но тоже не вечно.`,
    list: [
      "Самые ранние бронирования — январь-февраль, к апрелю картина резко меняется",
      `Смена 2 (14 дней, ${DATES_SHORT_S2}) заполняется быстрее всех — берут повторно`,
      `Смена 1 (${DATES_S1}) — часть мест уходит к тем, у кого отпуск в начале июня`,
      "50% предоплата фиксирует место и цену — цена не изменится до дня заезда",
      "Перенос между сменами возможен, если планы изменились"
    ]
  },
  {
    h2: "Короткие смены в июне — для тех, кто не может надолго",
    text: `Бывает, что на две недели не получается: секции, родственники, поездки. Для этого есть две короткие смены — каждая по неделе, каждая самостоятельная. Смена 2.1 (${DATES_SHORT_S21}, 7 дней, ${PRICE_MIN}) — хорошо для первого раза, когда ребёнок ещё не знает, понравится ли вообще. Смена 2.2 (${DATES_SHORT_S22}, 8 дней, ${PRICE_S22}) — для тех, кто в первую неделю занят. Некоторые берут обе подряд — получается полноценные две недели с теми же ребятами.`,
    list: [
      `Смена 2.1: ${DATES_SHORT_S21}, 7 дней, ${PRICE_MIN}`,
      `Смена 2.2: ${DATES_SHORT_S22}, 8 дней, ${PRICE_S22}`,
      "Обе смены можно взять подряд — ребята остаются в том же отряде",
      "Программа полноценная даже в 7-дневном формате"
    ]
  },
  {
    h2: "Как подготовить ребёнка к июньской смене",
    text: "Никакой специальной подготовки не нужно — <a href='/detskiy-lager'>принимаем с нуля</a>. Всё что реально нужно знать до заезда, мы пришлём списком на почту. Из практичного:",
    list: [
      "Одежда на случай дождя — Подмосковье в июне бывает капризным",
      "Кеды для спортплощадки и шлёпки для бассейна — без них не обойтись",
      "Банная карточка — выдают при заезде, пополнять не нужно",
      "Телефон берём — но в учебное время он в шкафчике, это не ограничение, это правило для всех",
      "Если ребёнок едет впервые — позвоните нам, расскажем что реально взять, а что лишнее"
    ]
  },
  {
    h2: "Мамы спрашивают: зачем июнь, а не июль или август",
    text: "Частый вопрос: у нас в июле отпуск, может лучше август? Можно и август — в <a href='/lager-na-avgust-podmoskove'>августе тоже отличные смены</a>. Но июнь у многих уходит впустую: ребёнок дома, мама на работе, бабушка уже устала. Июнь в <a href='/lager-v-podmoskove'>лагере в Подмосковье</a> — это каникулы с пользой, пока родители ещё не в отпуске. Плюс в июне ребёнок привозит проект домой — и всё лето у него есть чем заняться: развивает бота, делает следующий уровень игры, показывает друзьям.",
    list: [
      "Июнь — первые каникулы, самые длинные и самые «бесструктурные»",
      "Пока мама на работе — ребёнок не дома один, а в лагере с проектом",
      "После лагеря остаются навыки на всё лето, не только воспоминания",
      "Июль и август тоже доступны — можно взять две смены подряд"
    ]
  }  ,
  {
    h2: "Почему июнь — лучший месяц для первой смены",
    text: "Июнь — это особенное время: дети только вышли из школы, полны сил и готовы к новому. Нет усталости от длинного лета, нет тревоги «скоро осень». Погода мягкая — не изнуряющая жара июля, но уже тепло для бассейна и спорта на улице. Длинные световые дни позволяют устраивать вечерние активности на улице до темноты — командные игры, хакатон на закате, посиделки у костра. Именно поэтому многие семьи выбирают июнь для первой поездки: атмосфера вводная, не давящая, и ребёнок привыкает к лагерному ритму легче.",
    list: [
      "Ребёнок полон сил — только вышел из школы, нет летней усталости",
      "Мягкая погода: +20–25°C днём, прохладные вечера — комфортно для всех занятий",
      "Длинный световой день — больше времени на уличные активности",
      "Отсутствие тревоги «скоро учёба» — ребёнок расслаблен и открыт новому",
      "Идеально для первого раза: атмосфера лёгкая, темп вводный"
    ]
  },
  {
    h2: "Особенности июньской программы: бассейн, улица, вечера",
    text: "В июне тепло — и программа это учитывает. Бассейн открывается с первых дней смены: вода успевает прогреться к началу июня. Спортивные активности на улице идут каждый день — волейбол, пейнтбол, командные игры. Вечером, пока светло, проводим активности на свежем воздухе: квесты на территории, командные испытания, финальный хакатон под открытым небом. Утренние занятия по IT — в помещении, днём и вечером — на улице. Такой ритм не даёт засидеться и балансирует экран со свежим воздухом.",
    list: [
      "Бассейн каждый день с первых дней смены — вода прогрета",
      "Спорт на улице: волейбол, пейнтбол, полоса препятствий",
      "Вечерние активности до темноты — квесты, командные игры под открытым небом",
      "IT-занятия утром, физическая активность днём и вечером — баланс гарантирован",
      "Финальный хакатон — командная защита проектов на улице в последний день смены"
    ]
  },
  {
    h2: "Все летние смены",
    text: `<p class="text-[15px] text-slate-700 mb-3">Июнь — одна из шести смен сезона. Посмотрите весь календарь:</p>
<a href="/lager-letom/" class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"><i class="bi bi-arrow-left" aria-hidden="true"></i> Все летние смены АйДаКемп</a>`,
    icon: "calendar-event"
  },
  {
    h2: "Лагерь на июнь 2026 — что важно знать перед бронированием",
    text: "Июнь — первый месяц лета и самый популярный для записи в лагерь. Дети только вышли из школы — полны сил, легко входят в ритм. Июньские смены АйДаКемп традиционно бронируются первыми, часто ещё в марте–апреле. Если рассматриваете июнь — не откладывайте.",
    list: [
      `Смена 1: ${DATES_S1}, 10 дней — самый ранний старт лета`,
      `Смена 2: ${DATES_SHORT_S2}, 14 дней — самая длинная и популярная смена`,
      `Смена 2.1: ${DATES_SHORT_S21}, 7 дней — минимальная смена, хорошо для первого раза`,
      `Смена 2.2: ${DATES_SHORT_S22}, 8 дней — вторая неделя июня, если первая занята`,
      "Все смены в одном месте — пропустить июнь значит ждать до августа"
    ]
  },
  {
    h2: "Детский лагерь в июне — частые вопросы",
    text: "Что спрашивают перед записью на июньскую смену.",
    list: [
      "Погода в июне: +20–24°C, бассейн прогрет, длинный световой день — идеально для лагеря",
      "Опыт программирования: не нужен, группы начинающих стартуют с нуля",
      "Первый лагерь: июнь подходит лучше августа — ребёнок ещё в учебном ритме, адаптация легче",
      "Трансфер от м. Солнцево в первый день смены — 2 000 ₽, бронируется при записи",
      `Налоговый вычет 13% — до ${VYCHET_MAX} возврат, справка для ФНС по запросу`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-iyun.avif"
  title="Детский лагерь на июнь 2026 в Подмосковье — АйДаКемп"
  description={`Детский IT-лагерь в июне 2026: смены с 30 мая и с 10 июня в Подмосковье. Python, AI, Minecraft. 7–14 дней от ${PRICE_MIN}.`}
  h1="Детский лагерь на июнь 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-iyun"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Когда начинаются смены в IT-лагере в июне 2026?", a: "Первая смена стартует 30 мая, вторая (самая популярная) — 10 июня, заканчивается 23 июня. Также есть короткие смены 7–8 дней в начале июня." },
    { q: "Почему июньская смена самая популярная?", a: "Погода ещё комфортная, ребёнок только вышел из школы и полон энергии. Самая длинная смена — 14 дней с 10 по 23 июня. Большинство семей бронируют именно её." },
    { q: "Сколько стоит лагерь в июне?", a: `Смена с 30 мая (10 дней) — ${PRICE_S4}. Смена с 10 июня (14 дней) — ${PRICE_MAX}. Короткие смены 7–8 дней — от ${PRICE_MIN}. Оплата частями: 50% сейчас + 50% за 3 недели до заезда.` },
    { q: "Когда нужно бронировать место на июньскую смену?", a: "Чем раньше — тем лучше. Июньские смены наиболее популярны, места заканчиваются первыми. Место фиксируется после оплаты 50% суммы." },
    { q: "Какие смены есть в детском лагере в июне 2026?", a: `АйДаКемп в июне 2026: Смена 1 (${DATES_S1}, ${PRICE_S4}), Смена 2.1 (${DATES_SHORT_S21}, ${PRICE_MIN}), Смена 2.2 (${DATES_SHORT_S22}, ${PRICE_S22}), Смена 2 (${DATES_SHORT_S2}, ${PRICE_MAX}). IT-программа, бассейн, проживание — всё включено. Трансфер от м. Солнцево.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь на июнь 2026"
    subtitle="Смены с 30 мая и с 10 июня. IT-программа, бассейн, 5-разовое питание. Места в июне заполняются быстро — бронируйте сейчас."
    breadcrumb="Лагерь на июнь"
    keywords={[`Смена 1: ${DATES_S1} | Смена 2: ${DATES_SHORT_S2} | Смены 2.1 и 2.2: с 10 июня`, `Python, Minecraft, AI — от ${PRICE_MIN} за 7 дней`, "Июньские смены заполняются первыми — бронируйте заранее"]}
    image="/images/hero/lager-na-iyun.avif"
    imageAlt="Детский IT-лагерь на июнь в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
