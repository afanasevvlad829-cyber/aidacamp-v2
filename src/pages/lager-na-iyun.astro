---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Июньские смены — когда ехать и что выбрать",
    text: "В <a href='/detskiy-lager'>АйДаКемп</a> в июне работают три смены на любой семейный сценарий. С 30 мая по 8 июня — 10-дневная смена, хорошо ложится на те семьи, где старших ещё не отпустили с уроков, а младшим уже нечего делать дома. С 10 по 23 июня — 14-дневная, самая популярная смена лета: ребята успевают вжиться, сдружиться и сделать настоящий проект. Июнь хорош ещё и тем, что нет экзаменов у начальной и средней школы — никакого стресса, едут спокойно. До июльских отпусков и поездок к бабушке ещё далеко, можно спланировать всё чётко.",
    list: [
      "Смена 1: 30 мая — 8 июня, 10 дней, 74 900 ₽",
      "Смена 2: 10 — 23 июня, 14 дней, 95 000 ₽ — самая популярная",
      "Смена 2.1: 10 — 16 июня, 7 дней, 48 000 ₽ — короткая, для первого раза",
      "Смена 2.2: 16 — 23 июня, 8 дней, 65 000 ₽ — вторая неделя отдельно"
    ]
  },
  {
    h2: "Что успевает ребёнок за 10–14 дней в июне",
    text: "За июньскую смену — реальный проект, который можно показать друзьям и повесить в портфолио. Не «я прошёл курс», а «я написал бота» или «я сделал игру». Занятия каждый день по 3–4 часа, группы не больше 8 человек — преподаватель знает каждого по имени. Смотри все направления: <a href='/python-lager'>Python-лагерь</a>, <a href='/minecraft-lager'>Minecraft</a>, <a href='/scratch-lager'>Scratch</a>.",
    list: [
      "Python (10–14 лет) — от переменных до Telegram-бота с базой данных",
      "Scratch (7–10 лет) — первая игра, анимация, интерактивная история",
      "Minecraft Education — строим, программируем, создаём собственный мод",
      "AI-треки (12–15 лет) — подключение нейросети, генерация текста и картинок из кода",
      "Вечером — командные проекты, хакатон в финале смены"
    ]
  },
  {
    h2: "Почему июнь бронируют первым",
    text: "Июнь — самый ходовой месяц. Смена 2 (10–23 июня) обычно заполняется раньше остальных: родители, которые уже были с нами, берут места в феврале-марте. В мае мест уже почти нет. Если думаете «поглядим ближе к лету» — скорее всего придётся брать август или ждать следующего года. Бронь фиксирует место и цену — если смена вырастет в цене, вы платите по старому прайсу.",
    list: [
      "Самые ранние бронирования — январь-февраль, к маю всё плотнее",
      "Смена 2 (14 дней) заполняется быстрее остальных — берут на «повторный» заезд",
      "Предоплата 10 000 ₽ фиксирует место и цену",
      "Перенос между сменами возможен, если планы изменились"
    ]
  },
  {
    h2: "Короткие смены в июне — для тех, кто не может надолго",
    text: "Бывает, что на две недели не получается: секции, родственники, поездки. Для этого есть две короткие смены — каждая по неделе, каждая самостоятельная. Смена 2.1 (10–16 июня, 7 дней, 48 000 ₽) — хорошо для первого раза, когда ребёнок ещё не знает, понравится ли вообще. Смена 2.2 (16–23 июня, 8 дней, 65 000 ₽) — для тех, кто в первую неделю занят. Некоторые берут обе подряд — получается полноценные две недели с теми же ребятами.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2.2: 16–23 июня, 8 дней, 65 000 ₽",
      "Обе смены можно взять подряд — ребята остаются в том же отряде",
      "Программа полноценная даже в 7-дневном формате"
    ]
  },
  {
    h2: "Как подготовить ребёнка к июньской смене",
    text: "Никакой специальной подготовки не нужно — <a href='/detskiy-lager'>принимаем с нуля</a>. Всё что реально нужно знать до заезда, мы пришлём списком на почту. Из практичного:",
    list: [
      "Одежда на случай дождя — Подмосковье в июне бывает капризным",
      "Кеды для спортплощадки и шлёпки для бассейна — без них не обойтись",
      "Банная карточка — выдают при заезде, пополнять не нужно",
      "Телефон берём — но в учебное время он в шкафчике, это не ограничение, это правило для всех",
      "Если ребёнок едет впервые — позвоните нам, расскажем что реально взять, а что лишнее"
    ]
  },
  {
    h2: "Мамы спрашивают: зачем июнь, а не июль или август",
    text: "Частый вопрос: у нас в июле отпуск, может лучше август? Можно и август — в <a href='/lager-na-avgust-podmoskove'>августе тоже отличные смены</a>. Но июнь у многих уходит впустую: ребёнок дома, мама на работе, бабушка уже устала. Июнь в <a href='/lager-v-podmoskove'>лагере в Подмосковье</a> — это каникулы с пользой, пока родители ещё не в отпуске. Плюс в июне ребёнок привозит проект домой — и всё лето у него есть чем заняться: развивает бота, делает следующий уровень игры, показывает друзьям.",
    list: [
      "Июнь — первые каникулы, самые длинные и самые «бесструктурные»",
      "Пока мама на работе — ребёнок не дома один, а в лагере с проектом",
      "После лагеря остаются навыки на всё лето, не только воспоминания",
      "Июль и август тоже доступны — можно взять две смены подряд"
    ]
  },
  {
    h2: "Почему июнь — лучший месяц для первой смены",
    text: "Школа закончилась — дети свежие, мотивированные, голова не забита ни домашкой, ни усталостью от учёбы. Июнь в Подмосковье ещё не жаркий: 25–28°C — идеально для улицы и бассейна, не хочется лежать в тени, хочется двигаться и делать. Смена 1 (30 мая–8 июня) и Смена 2 (10–23 июня) — самые ранние в сезоне, места расходятся первыми. Пока все ещё думают и выбирают — у нас уже комплект.",
    list: [
      "Дети после школы в тонусе — занятия идут продуктивнее, чем в середине лета",
      "Температура 25–28°C — комфортно и для занятий, и для бассейна",
      "Смена 1 и Смена 2 — самые ранние, закрываются быстрее всего",
      "Кто не успел в июне — ждёт августа или следующего лета"
    ]
  },
  {
    h2: "Июнь в АйДаКемп: расписание типичного дня",
    text: "День спланирован так, чтобы было и занятие, и отдых, и вечерняя движуха — ничего лишнего, никакой казармы. Два блока IT-занятий в день, между ними обед и тихий час. Вечером — не скучные линейки, а квесты и конкурсы.",
    list: [
      "8:00 — подъём, завтрак",
      "10:00–12:30 — IT-занятие, блок 1",
      "13:00 — обед",
      "14:00–14:30 — тихий час",
      "15:00–17:30 — IT-занятие, блок 2",
      "18:00 — ужин",
      "19:00–21:00 — вечерняя активность (квест, спортивный конкурс, хакатон)",
      "21:30 — свободное время",
      "22:30 — отбой"
    ]
  },
  {
    h2: "Смена 1 или Смена 2 — как выбрать",
    text: "Смена 1 (30 мая–8 июня, 10 дней, 74 900 ₽) — ранняя, ещё прохладно, ребёнок попадает первым в сезон. Хорошо, если хотите уложить лагерь до семейного отпуска в июле. Смена 2 (10–23 июня, 14 дней, 95 000 ₽) — флагманская: двойной хакатон, самая насыщенная программа, самая тёплая атмосфера — за 14 дней отряд становится почти семьёй. Но расходится быстрее всего. Если хочется попробовать и не уверены — Смена 2.1 (7 дней) или Смена 2.2 (8 дней) — короткий вариант с той же программой.",
    list: [
      "Смена 1 (30 мая–8 июня, 10 дн.) — хорошо для тех, кто планирует июльский отпуск",
      "Смена 2 (10–23 июня, 14 дн.) — максимум программы, расходится первой",
      "Смена 2.1 (10–16 июня, 7 дн.) — попробовать без обязательств на две недели",
      "Смена 2.2 (16–23 июня, 8 дн.) — если занят в первую неделю июня"
    ]
  },
  {
    h2: "Что нужно сделать до заезда в июне",
    text: "Никаких сложностей — весь список поместится в один экран телефона. Самое важное — справка и трансфер, остальное по желанию.",
    list: [
      "Оформить справку 079/у в поликлинике — занимает 1–2 дня, лучше не откладывать на последний момент",
      "Упаковать чемодан по чек-листу — пришлём на почту после бронирования",
      "Подтвердить трансфер за 5 дней до заезда",
      "Сообщить об аллергиях и особых потребностях — чем раньше, тем лучше",
      "Технику не везти — ноутбук, планшет, приставка не нужны, всё есть в лагере"
    ]
  },
  {
    h2: "Погода в Подмосковье в июне",
    text: "В начале июня +18–22°C, к концу месяца прогревается до +27°C. Бассейн открыт с первого дня смены — вода нагревается до 25–26°C за 2–3 дня после открытия сезона. Иногда бывают кратковременные дожди — на этот случай у детей есть крытые площадки, компьютерный зал и актовый зал для командных игр. Дождь не отменяет программу, только переносит её под крышу.",
    list: [
      "Начало июня: +18–22°C, комфортно для занятий на улице",
      "Конец июня: до +27°C, бассейн в самый раз",
      "Вода в бассейне 25–26°C — нагревается быстро после открытия",
      "Дожди бывают, но программа не срывается — есть крытые пространства"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-iyun.avif"
  title="Лагерь на июнь 2026 для детей в Подмосковье — АйДаКемп"
  description="Детский IT-лагерь в июне 2026 в Подмосковье. Смены с 30 мая и с 10 июня. Программирование, AI, Minecraft за 7–14 дней. От 48 000 ₽."
  h1="Лагерь на июнь 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-iyun"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Когда начинаются смены в IT-лагере в июне 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Первая смена стартует 30 мая, вторая (самая популярная) — 10 июня, заканчивается 23 июня. Также есть короткие смены 7–8 дней в начале июня." }
        },
        {
          "@type": "Question",
          "name": "Почему июньская смена самая популярная?",
          "acceptedAnswer": { "@type": "Answer", "text": "Погода ещё комфортная, ребёнок только вышел из школы и полон энергии. Самая длинная смена — 14 дней с 10 по 23 июня. Большинство семей бронируют именно её." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь в июне?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена с 30 мая (10 дней) — 74 900 ₽. Смена с 10 июня (14 дней) — 95 000 ₽. Короткие смены 7–8 дней — от 48 000 ₽. Оплата частями: 50% сейчас + 50% за 3 недели до заезда." }
        },
        {
          "@type": "Question",
          "name": "Когда нужно бронировать место на июньскую смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "Чем раньше — тем лучше. Июньские смены наиболее популярны, места заканчиваются первыми. Место фиксируется после оплаты 50% суммы." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на июнь 2026 в Подмосковье"
    subtitle="Смены с 30 мая и с 10 июня. Программирование, AI и Minecraft — за 7–14 дней ребёнок делает проект, которым гордится. 66 км от МКАД."
    breadcrumb="Лагерь на июнь"
    keywords={["Смены с 30 мая и с 10 июня 2026", "Python, Minecraft, AI — от 48 000 ₽ за 7 дней", "Место фиксируется при бронировании"]}
    image="/images/hero/lager-na-iyun.avif"
    imageAlt="Детский IT-лагерь на июнь в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
