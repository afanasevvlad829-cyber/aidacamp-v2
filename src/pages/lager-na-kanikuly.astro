---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь на летние каникулы 2026 — как выбрать",
    text: "Детский лагерь на летние каникулы — это не просто «куда деть ребёнка». Это выбор, который влияет на всё лето. Главные критерии: чем ребёнок будет заниматься, есть ли конкретный результат, насколько безопасно. АйДаКемп — IT-лагерь с проживанием в Подмосковье, 66 км от МКАД. За смену — реальный проект (игра, бот, 3D-модель), а не просто «было весело».",
    list: [
      "Каникулы с результатом: конкретный проект к концу смены, а не просто «отдохнул»",
      "Безопасность: закрытая территория, медработник 24/7, охрана, ионизированный бассейн",
      "Лицензия Минобрнауки — образовательная деятельность официальная, вычет 13% законный",
      "От 7 до 14 дней — короткая смена для первого раза или длинная для глубокого погружения",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону, бронируется вместе с путёвкой"
    ]
  },
  {
    h2: "Как провести каникулы в лагере с пользой",
    text: "Лето 2026 — три месяца каникул. Вариант первый: дома за экраном. Вариант второй: лагерь с IT-программой, откуда ребёнок возвращается с реальным проектом, новыми друзьями и навыком, который останется надолго. Конкретика: за 10 дней — рабочий бот на Python, собственная игра в Roblox или 3D-модель с печатью. Не теория, а проект в руках.",
    list: [
      "За 10 дней — рабочий бот, игра или 3D-модель",
      "Новые друзья, командные задачи, хакатон",
      "Ребёнок возвращается с результатом, а не просто «отдохнул»"
    ]
  },
  {
    h2: "Смены на каждый месяц лета 2026",
    text: "Выбирайте одну смену или несколько. Короткая смена 7 дней — попробовать. Длинная 14 дней — погрузиться по-настоящему. Несколько смен подряд — вырасти до продвинутого уровня. Важно: июль 2026 занят, июньские смены заполняются быстро.",
    list: [
      "Смена 1: 30 мая–8 июня, 10 дней, 85 900 ₽ — старт лета, свежие силы",
      "Смена 2: 10–23 июня, 14 дней, 99 000 ₽ — самая популярная, бронируйте заранее",
      "Смена 2.1: 10–16 июня, 7 дней, 48 000 ₽ — самый доступный вариант",
      "Смена 2.2: 16–23 июня, 8 дней, 75 000 ₽ — вторая неделя июня отдельно",
      "Смена 3: 3–15 августа, 13 дней, 89 400 ₽ — большой проект до школы",
      "Смена 4: 17–26 августа, 10 дней, 74 900 ₽ — финальный аккорд каникул",
      "Июль 2026 занят — запишитесь в лист ожидания"
    ]
  },
  {
    h2: "Что можно успеть за летние каникулы",
    text: "За одну смену — готовый проект. За две смены подряд — заметный рост в выбранном направлении. Конкретно по программам:",
    list: [
      "7 дней (Смена 2.1): первая программа на Python или первая игра в Scratch — с нуля до работающего кода",
      "10 дней (Смены 1/4): Telegram-бот с командами и ответами, или игровой мод для Minecraft",
      "14 дней (Смена 2): полноценный проект с базой данных, API или AI-функцией — защита на хакатоне",
      "Две смены (июнь + август): один проект доводится до уровня «можно показать в школе» — портфолио",
      "Программа не повторяется — на второй смене идём дальше по той же теме"
    ]
  },
  {
    h2: "Что делает ребёнок на каникулах в IT-лагере",
    text: "Два занятия по 90 минут в день — этого достаточно для результата. Остальное время: бассейн, спорт, вечерние мероприятия. Ребёнок не сидит весь день за компьютером.",
    list: [
      "2 занятия × 90 мин — Python, AI, Minecraft, Roblox или 3D-моделирование",
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "Вечерние активности: квесты, кино, творческие мастерские",
      "5-разовое питание, медработник 24/7, закрытая территория"
    ]
  },
  {
    h2: "Цены и бронирование на лето 2026",
    text: "Стоимость смен зависит от длительности. Налоговый вычет 13% позволяет вернуть часть стоимости. Смены заполняются заранее — лучше бронировать сейчас.",
    list: [
      "7 дней — от 48 000 ₽",
      "10 дней — 74 900 ₽",
      "14 дней — 99 000 ₽",
      "Налоговый вычет 13% — возврат до 5 434 ₽ с путёвки",
      "Трансфер из Москвы — 2 000 ₽ в одну сторону (опционально)"
    ]
  },
  {
    h2: "Отзывы о летних каникулах в лагере",
    text: "Мамы, которые выбрали АйДаКемп на лето:",
    list: [
      "«Отправила на все три смены — дома была бы с телефоном. Вернулась другим человеком, и я не преувеличиваю» — Светлана, мама Даши, 12 лет",
      "«Взяла первую неделю просто попробовать. Сын сам попросил продлить. Записала на ещё две смены» — Ирина, мама Коли, 10 лет",
      "«Ребёнок сказал: это лучшие каникулы в моей жизни. Для меня всё сказано» — Анастасия, мама Алёши, 11 лет"
    ]
  },
  {
    h2: "Летние каникулы с пользой — как не потерять время",
    text: "Среднестатистические летние каникулы: первые 2 недели эйфория, потом YouTube и игры до сентября. К первому сентября — ничего нового, навыки чтения и счёта просели. Альтернатива — не «убить» каникулы учёбой, а сделать их насыщенными без ощущения учёбы. IT-лагерь работает именно так: дети создают что-то крутое и даже не замечают, что учатся.",
    list: [
      "14 дней погружения = полгода занятий в кружке по объёму материала",
      "Ребёнок не скучает — программа насыщена активностями",
      "Результат в руках: готовый проект к сентябрю, не просто «отдохнул»",
      "Математическое мышление и логика через программирование"
    ]
  },
  {
    h2: "Как выбрать смену на каникулы — июнь или август",
    text: "В АйДаКемп в 2026 году нет смен в июле. Июнь и август — наши сезоны. Июнь хорош тем, что ребёнок ещё в рабочем ритме после школы, адаптация проходит легче. Август — хорош тем, что есть время переварить опыт перед новым учебным годом. Обе смены одинаковы по программе, разница только в наполненности: июньские разбираются быстрее.",
    list: [
      "Июнь (смена 2, 14 дней): 10–23 июня — самая длинная и насыщенная",
      "Июнь короткие (смена 2.1 и 2.2): 7–8 дней — для первого раза",
      "Август (смена 3, 13 дней): 3–15 августа — последний шанс на лето",
      "Август (смена 4, 10 дней): 17–26 августа — перед самым сентябрём"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лагерь на каникулы 2026 — детский IT-лагерь в Подмосковье | АйДаКемп"
  description="Детский лагерь на каникулы 2026 в Подмосковье — каникулы в лагере с IT-программой. Python, AI, Minecraft. Смены 7–14 дней, от 48 000 ₽. Налоговый вычет 13%."
  h1="Детский лагерь на летние каникулы 2026"
  canonical="https://aidacamp.ru/lager-na-kanikuly"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Когда лучше отправить ребёнка в лагерь на каникулы?", a: "Самая популярная смена — июньская (10–23 июня). Многие берут именно первую смену: погода ещё не жаркая, мест больше. Августовские смены хороши для тех, кто хочет закончить каникулы активно — перед школой." },
    { q: "Можно ли поехать в лагерь на одну неделю?", a: "Да, есть короткие смены от 7 дней — от 48 000 ₽. Это хороший вариант для первого раза или для занятых родителей. Основные смены — 10–14 дней." },
    { q: "Сколько стоит лагерь на каникулы 2026?", a: "От 48 000 ₽ за 7-дневную смену. Основные смены: 74 900 ₽ (10 дней), 99 000 ₽ (14 дней). В стоимость включены проживание, питание, IT-программа, бассейн." },
    { q: "Что ребёнок получит от летних каникул в IT-лагере?", a: "Реальный проект — игру, бота, 3D-модель — который можно показать дома. Новых друзей из разных городов. Навык работать в команде и презентовать результат. И ответ на вопрос «чем хочу заниматься»." },
    { q: "Какой лагерь выбрать ребёнку на летние каникулы?", a: "АйДаКемп — IT-лагерь на летние каникулы в Подмосковье. Июнь (с 30 мая) и август (с 3 августа), смены 7–14 дней, для детей 7–15 лет. Python, AI, Minecraft, Roblox. Реальный проект к концу каникул. Лицензия Минобрнауки, налоговый вычет 13%. От 48 000 ₽." }
  ]} />
    <CourseSchema
      name="IT-лагерь на летние каникулы — АйДаКемп"
      description="IT-лагерь на летние каникулы в Подмосковье: июнь, июль, август. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-na-kanikuly"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на летние каникулы 2026 — IT"
    subtitle="IT-лагерь в Подмосковье на летние каникулы. Июнь и август, смены 7–14 дней. Ребёнок уезжает с проектом — игрой, ботом или 3D-моделью. От 48 000 ₽."
    breadcrumb="Лагерь на каникулы"
    keywords={["Смены в июне и августе — июль занят", "7, 10 или 14 дней — от 48 000 ₽", "Возврат до 5 434 ₽ по налоговому вычету"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь на летние каникулы 2026 — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
