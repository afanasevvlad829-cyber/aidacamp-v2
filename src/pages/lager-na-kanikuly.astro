---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как провести летние каникулы с пользой",
    text: "Лето 2026 — три месяца каникул. Вариант первый: дома за экраном. Вариант второй: лагерь с IT-программой, откуда ребёнок возвращается с реальным проектом, новыми друзьями и навыком, который останется надолго. Конкретика: за 10 дней — рабочий бот на Python, собственная игра в Roblox или 3D-модель с печатью. Не теория, а проект в руках.",
    list: [
      "За 10 дней — рабочий бот, игра или 3D-модель",
      "Новые друзья, командные задачи, хакатон",
      "Ребёнок возвращается с результатом, а не просто «отдохнул»"
    ]
  },
  {
    h2: "Смены на каждый месяц лета 2026",
    text: "Выбирайте одну смену или несколько. Короткая смена 7 дней — попробовать. Длинная 14 дней — погрузиться по-настоящему. Три смены подряд — вырасти до продвинутого уровня.",
    list: [
      "Май–июнь: смена 1 — 30 мая–8 июня, 10 дней",
      "Июнь: смена 2 — 10–23 июня, 14 дней (самая популярная)",
      "Август: смена 3 — 3–15 августа, 13 дней",
      "Август: смена 4 — 17–26 августа, 10 дней",
      "Можно записаться на несколько смен — цена не меняется"
    ]
  },
  {
    h2: "Что делает ребёнок на каникулах в IT-лагере",
    text: "Два занятия по 90 минут в день — этого достаточно для результата. Остальное время: бассейн, спорт, вечерние мероприятия. Ребёнок не сидит весь день за компьютером.",
    list: [
      "2 занятия × 90 мин — Python, AI, Minecraft, Roblox или 3D-моделирование",
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "Вечерние активности: квесты, кино, творческие мастерские",
      "5-разовое питание, медработник 24/7, закрытая территория"
    ]
  },
  {
    h2: "Цены и бронирование на лето 2026",
    text: "Стоимость смен зависит от длительности. Налоговый вычет 13% позволяет вернуть часть стоимости. Смены заполняются заранее — лучше бронировать сейчас.",
    list: [
      "7 дней — от 48 000 ₽",
      "10 дней — 74 900 ₽",
      "14 дней — 95 000 ₽",
      "Налоговый вычет 13% — возврат до 5 200 ₽ с путёвки",
      "Трансфер из Москвы — 2 500 ₽ в одну сторону (опционально)"
    ]
  },
  {
    h2: "Отзывы о летних каникулах в лагере",
    text: "Мамы, которые выбрали АйДаКемп на лето:",
    list: [
      "«Отправила на все три смены — дома была бы с телефоном. Вернулась другим человеком, и я не преувеличиваю» — Светлана, мама Даши, 12 лет",
      "«Взяла первую неделю просто попробовать. Сын сам попросил продлить. Записала на ещё две смены» — Ирина, мама Коли, 10 лет",
      "«Ребёнок сказал: это лучшие каникулы в моей жизни. Для меня всё сказано» — Анастасия, мама Алёши, 11 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Детский лагерь на летние каникулы 2026 — АйДаКемп"
  description="IT-лагерь на летние каникулы 2026: июнь, июль, август. Python, AI, Minecraft для детей 7–15 лет. Смены 7–14 дней, от 48 000 ₽. Подмосковье."
  h1="Детский лагерь на летние каникулы 2026"
  canonical="https://aidacamp.ru/lager-na-kanikuly"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Когда лучше отправить ребёнка в лагерь на каникулы?",
          "acceptedAnswer": { "@type": "Answer", "text": "Самая популярная смена — июньская (10–23 июня). Многие берут именно первую смену: погода ещё не жаркая, мест больше. Августовские смены хороши для тех, кто хочет закончить каникулы активно — перед школой." }
        },
        {
          "@type": "Question",
          "name": "Можно ли поехать в лагерь на одну неделю?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, есть короткие смены от 7 дней — от 48 000 ₽. Это хороший вариант для первого раза или для занятых родителей. Основные смены — 10–14 дней." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь на каникулы 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. Основные смены: 74 900 ₽ (10 дней), 95 000 ₽ (14 дней). В стоимость включены проживание, питание, IT-программа, бассейн, страховка." }
        },
        {
          "@type": "Question",
          "name": "Что ребёнок получит от летних каникул в IT-лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Реальный проект — игру, бота, 3D-модель — который можно показать дома. Новых друзей из разных городов. Навык работать в команде и презентовать результат. И ответ на вопрос «чем хочу заниматься»." }
        }
      ]
    })} />
    <CourseSchema
      name="IT-лагерь на летние каникулы — АйДаКемп"
      description="IT-лагерь на летние каникулы в Подмосковье: июнь, июль, август. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-na-kanikuly"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь на летние каникулы 2026"
    subtitle="IT-лагерь в Подмосковье на июнь, июль, август. Ребёнок возвращается с реальным проектом — игрой, ботом или 3D-моделью."
    breadcrumb="Лагерь на каникулы"
    keywords={["Смены в июне, июле, августе — выбирайте любую", "7, 10 или 14 дней — от 48 000 ₽", "Возврат 13% по налоговому вычету"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь на летние каникулы 2026 — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
