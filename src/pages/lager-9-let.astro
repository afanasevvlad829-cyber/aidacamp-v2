---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Программа для 9 лет: Scratch → Python и Roblox Studio",
    text: "9 лет — переходный возраст: Scratch уже хорошо освоен, Python ещё кажется сложным. В АйДаКемп этот переход делают плавным. Начинаем с финала Scratch — закрепляем циклы, условия, переменные. Потом плавно переходим к первым строчкам Python через игровые задачи. Параллельно — Roblox Studio: девятилетние видят, как их код оживляет мир в игре. Это тот самый «вау-момент», после которого ребёнок уже не хочет останавливаться.",
    list: [
      "Scratch Advanced: циклы, условия, переменные — финальное закрепление",
      "Python — первые шаги: синтаксис через игровые задачи, не учебник",
      "Roblox Studio: первые скрипты на Lua, управление объектами в игре",
      "Совместный проект в паре: первый опыт разделения задач"
    ]
  },
  {
    h2: "Типичный проект девятилетки: что он создаст за смену",
    text: "За смену школьник 9 лет делает в Python игру с меню, уровнями и счётом — или интерактивную программу-викторину. Не шаблон из учебника — собственная идея, собственные правила. В Roblox Studio — мини-карта с простым скриптом: нажал кнопку — что-то произошло. На итоговой презентации объясняет одноклассникам как работает его код.",
    list: [
      "Игра на Python: меню, уровни, счёт — запускается на любом компьютере",
      "Или мини-приложение: викторина, угадайка, генератор имён",
      "Roblox-карта с первым скриптом: кнопки, события, простая механика",
      "Публичная защита: ребёнок объясняет другим что он написал"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про девятилеток в IT-лагере:",
    list: [
      "«Не рано ли в 9 лет учить Python?» — 9 лет — идеальный возраст. В 8–10 лет активно развивается абстрактное мышление. Мы учим через игровые задачи, где код сразу что-то делает. Большинство ребят к третьему дню пишут первые программы.",
      "«Нужен ли опыт Scratch?» — Никакой предварительной подготовки не нужно. Группа начинается с нуля для тех, кто без опыта, и с закрепления для тех, кто уже пробовал. Педагог адаптирует задачи под уровень каждого.",
      "«Не заскучает ли без мамы?» — Вожатый рядом 24/7, соотношение 1:8. Telegram-фото из отряда приходят каждый день. К третьему дню 95% ребят уже заняты проектом и не вспоминают о доме. Весело — точно: когда код что-то делает на экране, это захватывает сильнее любой игры. Плюс новые друзья-ровесники с такими же интересами.",
      "«Что если не успеет сделать проект?» — Темп подбирается под группу. Финал смены — защита того, что успел. Код остаётся у ребёнка, можно продолжить дома.",
      "«Подойдёт ли и мальчику, и девочке 9 лет?» — Да, программа одна и та же для всех. Группы смешанные, Roblox Studio и Python одинаково увлекают и мальчиков, и девочек в этом возрасте."
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждой группой закреплён вожатый с опытом работы с возрастом 8–10 лет. Соотношение — 1 вожатый на 8 школьников. На территории дежурит медработник 24/7. Telegram-чат отряда: мама видит фото каждый день.",
    list: [
      "Соотношение вожатых 1:8 — каждый ребёнок в поле зрения",
      "Медработник на базе круглосуточно",
      "Telegram-фото из отряда — ежедневно",
      "Закрытая территория, пропускной режим"
    ]
  },
  {
    h2: "Как устроен день школьника 9 лет в лагере",
    text: "Расписание сделано так, чтобы ребёнок успевал и поработать, и отдохнуть. Занятия утром 2–3 часа блоками, потом бассейн, обед, тихий час. Вечером — командные игры и активности. Никакого перегруза.",
    list: [
      "Утро: занятие на Python или Roblox — 2–3 часа с перерывами",
      "Середина дня: бассейн, прогулка, обед в столовой",
      "Тихий час — обязательно",
      "Вечер: квесты, командные игры, творческие активности",
      "Связь с родителями — звонок вечером, Telegram-фото каждый день"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR}: открыты августовские смены`,
    text: "Для девятилеток подходит любая смена. Смена 4 (10 дней) хорошо подходит для первого раза — достаточно коротко, чтобы не было страха, и достаточно долго, чтобы получить результат. Июньские смены уже прошли.",
    list: [
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней — ${PRICE_S21}`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней — ${PRICE_S2}`,
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней — ${PRICE_S3}`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней — ${PRICE_S4} (хорошо для первого раза)`,
      "Августовские смены ещё открыты — места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа меняется вместе с ребёнком. Что было до и что будет после:",
    list: [
      "<a href='/lager-8-let/'>Лагерь для 8 лет</a> — Scratch и Tinkercad 3D: первый код и первая 3D-модель",
      "<a href='/lager-10-let/'>Лагерь для 10 лет</a> — Python обязательно + Roblox Studio и Minecraft Education",
      "<a href='/lager-11-let/'>Лагерь для 11 лет</a> — Python + HTML/CSS + AI: первые боты и нейросети",
      "Все программы — наш <a href='/it-camp/'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title={`Летний лагерь для ребёнка 9 лет в Подмосковье ${SEASON_YEAR} | АйДаКемп`}
  description={`Летний лагерь для детей 9 лет в Подмосковье ${SEASON_YEAR}. Scratch → Python + Roblox Studio: самое время начать настоящий код. Вожатый 1:8, бассейн. 66 км от МКАД`}
  h1="Летний лагерь для ребёнка 9 лет — Scratch, Python, Roblox"
  canonical="https://aidacamp.ru/lager-9-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Какая программа для детей 9 лет в IT-лагере?", a: "Для детей 8–10 лет — переходная программа Scratch → Python + Roblox Studio. Начинаем с финала Scratch (циклы, условия, переменные), потом плавно переходим к первым строчкам Python через игровые задачи. В Roblox Studio — первые скрипты на Lua." },
    { q: "Не рано ли ребёнку 9 лет учить Python?", a: "9 лет — идеальный возраст. В 8–10 лет активно развивается абстрактное мышление. Мы учим через игровые задачи, где код сразу что-то делает. Большинство ребят к третьему дню пишут первые работающие программы." },
    { q: "Что сделает ребёнок 9 лет за смену?", a: "Напишет игру или интерактивную программу на Python с меню и уровнями. Плюс первый скрипт в Roblox Studio. На итоговой презентации объясняет другим как работает его код. Всё остаётся у ребёнка — можно показать в школе." },
    { q: "Какие смены ещё открыты?", a: "Июньские смены (2.1 и 2) уже прошли. Открыты августовские: смена 3 (13 дней) и смена 4 (10 дней). Бронируйте заранее." },
    { q: "Подойдёт ли лагерь и мальчику, и девочке 9 лет?", a: "Да, программа одна для всех: Scratch → Python + Roblox Studio по интересу ребёнка, а не по полу. Группы смешанные, соотношение вожатых 1:8 одинаковое." },
    { q: "Сколько стоит лагерь для детей 9 лет?", a: `Открыты августовские смены: от ${PRICE_S4} за 10 дней (смена 4) до ${PRICE_S3} за 13 дней (смена 3). В стоимость входят проживание, питание, все занятия и активности. Можно оформить налоговый вычет 13%.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь для ребёнка 9 лет — Scratch, Python, Roblox"
    subtitle="Scratch → Python и Roblox Studio — самое время начать настоящий код. 7–10 дней полного погружения дают больше, чем месяц кружка два раза в неделю: навык формируется в среде, а не за партой. Ребёнок привезёт игру на Python и первый Roblox-скрипт."
    breadcrumb="Лагерь для детей 9 лет"
    keywords={["Scratch → Python + Roblox Studio за смену", "Вожатый 1:8, медработник 24/7", "Смена 4 (10 дней) для первого раза"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь для детей 9 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedArticles articles={[
    { title: "Как выбрать лагерь для ребёнка", url: "/stati/kak-vybrat-lager/", description: "На что смотреть при выборе: лицензия, безопасность, программа.", icon: "patch-check-fill" },
    { title: "Куда деть ребёнка летом — варианты для занятых родителей", url: "/stati/kuda-det-rebenka-letom/", description: "Разбираем форматы летнего отдыха: что подходит для разного возраста.", icon: "sun" },
    { title: "Хакатон в детском лагере: что это и зачем", url: "/stati/hakaton-v-detskom-lagere/", description: "Почему соревновательный формат — лучшее завершение смены.", icon: "trophy" },
    { title: "Что взять в лагерь — чеклист для мамы", url: "/stati/chto-vzyat-v-lager/", description: "Полный список вещей, которые нужны ребёнку в летнем лагере.", icon: "clipboard-check" },
  ]} />
    <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-8-let/" class="text-primary underline underline-offset-2">← Лагерь для 8 лет</a> · <a href="/lager-10-let/" class="text-primary underline underline-offset-2">Лагерь для 10 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
