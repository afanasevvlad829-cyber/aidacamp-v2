---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Почему 9 лет — идеальный возраст для первого знакомства с Python",
    text: "В 8–10 лет у детей активно развивается абстрактное мышление — именно то, что нужно для программирования. Scratch уже немного «детский», а Python ещё кажется сложным. АйДаКемп решает это мягким переходом: начинаем с финала Scratch, потом плавно переходим к первым строчкам Python. Никакого стресса, только «вау-момент» — когда ребёнок понимает, что он написал настоящий код."
  },
  {
    h2: "Программа: от Scratch к Python — что изучат",
    text: "Группа 8–10 лет работает по специальной переходной программе. Первые дни — закрепление логики на Scratch, потом — знакомство с Python через игровые задачи. Никаких скучных учебников: ребята пишут код, который сразу что-то делает — двигает персонажа, считает очки, отвечает на вопросы.",
    list: [
      "Scratch — закрепление: циклы, условия, переменные",
      "Python — первые шаги: синтаксис через игровые задачи",
      "Turtle и PyGame — рисование и простые игры на Python",
      "Совместный проект — работа в паре или команде"
    ]
  },
  {
    h2: "Что ребёнок сделает за смену — конкретный проект",
    text: "Не «изучит тему», а сделает реальный проект — маленькую игру или интерактивную программу на Python. На итоговой презентации в последний день смены ребята показывают свои работы — родителям, другим детям, преподавателям. Это момент, ради которого стоит всё. Ваш ребёнок объясняет свой код другим. Сам.",
    list: [
      "Игра на Python с меню, уровнями и счётом",
      "Или интерактивная программа-викторина",
      "Публичная защита на итоговом хакатоне",
      "Код остаётся у ребёнка — можно показать в школе"
    ]
  },
  {
    h2: "Условия: бассейн, питание, медработник",
    text: "Лагерь находится в 66 км от МКАД, на территории санатория Изумруд в Наро-Фоминском районе. Открытый бассейн, лес, спортивные площадки. Питание четырёхразовое, меню утверждает технолог с учётом аллергий. Медработник живёт на базе.",
    list: [
      "Открытый бассейн — ежедневно в хорошую погоду",
      "Лес, спорт, вечерние активности",
      "Питание 4 раза в день, аллергии учитываются",
      "Медработник 24/7 на территории"
    ]
  },
  {
    h2: "Смены 2026 для детей 9 лет",
    text: "Для 8–10 лет подходят любые смены. Оптимальная длина — от 10 дней: за это время успевает сложиться команда и получается полноценный проект. Первый раз? Берите смену 2.1 на 7 дней — убедитесь что формат подходит.",
    list: [
      "Смена 2.1: 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2: 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Летний детский лагерь для детей 9 лет в Подмосковье 2026 — IT | АйДаКемп"
  description="Летний лагерь для детей 9 лет в Подмосковье 2026. Scratch → Python: самое время начать настоящий код. Малые группы, бассейн, лес. 66 км от МКАД от 48 000 ₽."
  h1="Детский лагерь для детей 9 лет — Scratch и Python | АйДаКемп"
  canonical="https://aidacamp.ru/lager-9-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа для детей 9 лет в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Для 8–10 лет — переходная программа Scratch → Python. Начинаем с финала Scratch (циклы, условия, переменные), потом плавно переходим к первым строчкам Python через игровые задачи." }
        },
        {
          "@type": "Question",
          "name": "Не рано ли ребёнку 9 лет учить Python?",
          "acceptedAnswer": { "@type": "Answer", "text": "9 лет — идеальный возраст. В 8–10 лет активно развивается абстрактное мышление. Мы не даём сложную теорию — учим через игровые задачи, где код сразу что-то делает. Многие дети в 9 лет уже пишут первую игру." }
        },
        {
          "@type": "Question",
          "name": "Что сделает ребёнок 9 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "Напишет маленькую игру или интерактивную программу на Python. На итоговом хакатоне презентует её перед другими детьми и родителями. Код остаётся у ребёнка — можно показать в школе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для детей 9 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена 2.1 (7 дней, июнь) — 48 000 ₽. Смена 2 (14 дней, июнь) — 95 000 ₽. Смена 3 (13 дней, август) — 89 400 ₽. Смена 4 (10 дней, август) — 74 900 ₽. В стоимость входят проживание, питание, программа, бассейн." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 9 лет в Подмосковье"
    subtitle="Scratch → Python: самое время начать. В 9 лет дети уже готовы к настоящему коду — и делают это с удовольствием."
    breadcrumb="Лагерь для детей 9 лет"
    keywords={["Переходная программа Scratch → Python", "Реальный проект на Python за смену", "9 лет — идеальный возраст для первого кода"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь для детей 9 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Как выбрать лагерь для ребёнка", url: "/stati/kak-vybrat-lager", description: "На что смотреть при выборе: лицензия, безопасность, программа.", icon: "patch-check-fill" },
    { title: "Куда деть ребёнка летом — варианты для занятых родителей", url: "/stati/kuda-det-rebenka-letom", description: "Разбираем форматы летнего отдыха: что подходит для разного возраста.", icon: "sun" },
    { title: "Хакатон в детском лагере: что это и зачем", url: "/stati/hakaton-v-detskom-lagere", description: "Почему соревновательный формат — лучшее завершение смены.", icon: "trophy" },
    { title: "Что взять в лагерь — чеклист для мамы", url: "/stati/chto-vzyat-v-lager", description: "Полный список вещей, которые нужны ребёнку в летнем лагере.", icon: "clipboard-check" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
