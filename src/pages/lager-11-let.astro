---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для детей 11 лет: Python и первые AI-проекты",
    text: "В 11 лет дети находятся на границе между «средней» и «старшей» группой. В АйДаКемп дети 10–12 лет работают с Python на среднем уровне — уже не с нуля, но ещё через игровые задачи. Главное отличие от 9-летних: дети 11 лет могут удерживать внимание на задаче 2–3 часа и доводить проект до конца.",
    list: [
      "Python: функции, списки, словари — через реальные задачи, не учебник",
      "Введение в AI: как работают нейросети, простые эксперименты с ChatGPT API",
      "Telegram-бот — классический первый проект, который работает после смены",
      "Minecraft с кодом: автоматизация мира через Python-скрипты",
      "Финальная защита проекта — перед всеми отрядами и на закрытии"
    ]
  },
  {
    h2: "Почему 11 лет — переломный момент для IT",
    text: "11 лет — возраст, когда абстрактное мышление начинает работать в полную силу. Дети уже могут понять, что такое функция или условие, не просто повторяя за педагогом, но осознанно. При этом они ещё не потеряли детский азарт и не боятся пробовать.",
    list: [
      "Переход от «кликать» к «создавать» происходит именно сейчас",
      "11-летние легко входят в командную работу и соревнование",
      "Страх ошибки ещё не сформировался — можно пробовать смело",
      "Первый бот в 11 лет — это не хобби, это задел на профессию",
      "Окружение сверстников с похожими интересами меняет самооценку"
    ]
  },
  {
    h2: "Что ребёнок привезёт домой",
    text: "Каждый ребёнок в АйДаКемп защищает конкретный проект на финале смены. Это не презентация — это живой код, который работает. Для 11-летних характерные проекты:",
    list: [
      "Telegram-бот: отвечает на вопросы, присылает картинки или ведёт счёт игры",
      "Мини-игра на Python: платформер или викторина с несколькими уровнями",
      "Minecraft-карта с автоматизированными механизмами через Python-скрипты",
      "Навык: объясняет что такое переменная, функция, условие — не зубрёжкой",
      "Ссылка на GitHub или архив с кодом — для школьного портфолио"
    ]
  },
  {
    h2: "Условия и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД по Киевскому шоссе. Для детей 10–12 лет важен баланс: половина дня — IT-занятия в малых группах, половина — активный отдых.",
    list: [
      "Закрытый бассейн — купание ежедневно по расписанию",
      "Питание 5 раз в день — завтрак, обед, полдник, ужин, второй ужин",
      "Медик на территории 24/7, страховка включена",
      "Малые группы до 8 человек — педагог знает каждого",
      "Ежедневные фото и видео в родительском чате"
    ]
  },
  {
    h2: "Смены 2026 для детей 11 лет",
    text: "Для детей 10–12 лет подходят все смены. Если ребёнок хочет сделать серьёзный проект — рекомендуем смену на 13–14 дней: за две недели успеваем пройти от основ до защиты полноценного продукта.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (максимальный результат)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Налоговый вычет 13% — возвращается через ФНС, до 4 800 ₽ в зависимости от смены"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Летний лагерь для детей 11 лет в Подмосковье 2026 — IT | АйДаКемп"
  description="Лагерь для детей 11 лет в Подмосковье 2026. Python, Telegram-бот, AI — реальный проект за смену. 66 км от МКАД, малые группы, от 48 000 ₽."
  h1="Лагерь для детей 11 лет — Python и первый IT-проект"
  canonical="https://aidacamp.ru/lager-11-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа в IT-лагере для детей 11 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Дети 10–12 лет в АйДаКемп работают с Python на среднем уровне: функции, списки, работа с данными. Плюс введение в AI и Telegram-боты. Итог смены — защита проекта: бот, мини-игра или скрипт для Minecraft, который ребёнок написал сам." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь ребёнку 11 лет без опыта программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Педагоги начинают с уровня группы и никто не отстаёт. Если ребёнок без опыта — его определят в начальную подгруппу, где начинают с самых основ Python. Уже через 3–4 дня дети пишут первые работающие программы." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает ребёнок 11 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены каждый ребёнок защищает проект. Для 11-летних это чаще всего Telegram-бот или мини-игра на Python. Проект реально работает — его можно запустить дома и показать друзьям." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для детей 11 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (смена 2.1, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание 5 раз, IT-занятия, бассейн. Доступен налоговый вычет 13%." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для детей 11 лет — Python, боты и реальный проект"
    subtitle="11 лет — лучшее время перейти от «нажимать» к «создавать». Дети пишут работающий код и привозят проект, который можно показать друзьям."
    breadcrumb="Лагерь для детей 11 лет"
    keywords={["Python и AI с нуля", "Telegram-бот за смену", "Малые группы до 8 человек"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Лагерь для детей 11 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
