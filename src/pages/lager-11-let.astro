---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Программа для 11 лет: Python + веб и AI-введение",
    text: "В 11 лет школьники находятся на границе между средней и старшей группой. В АйДаКемп ребята 10–12 лет работают с Python на среднем уровне — уже не с нуля, но ещё через игровые задачи. Новое в этом треке: HTML/CSS-вёрстка (первые страницы), Roblox Studio продвинутый (мультиплеер-механики) и введение в AI — как работают нейросети, простые эксперименты. Это возраст, когда можно замахнуться сразу на несколько инструментов и увидеть, как они связаны.",
    list: [
      "Python средний: функции, списки, словари — через реальные задачи",
      "HTML/CSS — первые веб-страницы: что показывает браузер и почему",
      "Roblox Studio продвинутый: мультиплеер-механики, серверные скрипты",
      "Введение в AI: как работают нейросети, простые эксперименты с API"
    ]
  },
  {
    h2: "Типичный проект одиннадцатилетки: что он создаст за смену",
    text: "Каждый в АйДаКемп защищает конкретный проект на финале смены. Это не презентация — это живой код, который работает. Для 11-летних характерные проекты:",
    list: [
      "Telegram-бот: отвечает на вопросы, присылает картинки или ведёт счёт игры",
      "Простой сайт-визитка или интерактивная страница на HTML/CSS",
      "Продвинутая карта в Roblox Studio с мультиплеером",
      "Навык: объясняет что такое переменная, функция, условие — не зубрёжкой",
      "Ссылка на GitHub или архив с кодом — для школьного портфолио"
    ]
  },
  {
    h2: "Часто спрашивают родители",
    text: "Самые важные вопросы про одиннадцатилеток в IT-лагере:",
    list: [
      "«Подойдёт ли без опыта программирования?» — Да. Педагоги начинают с уровня группы. Если без опыта — попадёт в подгруппу, где начинают с основ Python. Уже через 3–4 дня пишут первые работающие программы.",
      "«Не слишком ли много треков — не запутается?» — Нет. Каждый выбирает глубину: кто-то идёт в Python, кто-то в веб, кто-то в Roblox. Педагог помогает выбрать основной трек.",
      "«Вожатые рядом?» — Соотношение 1:8. Медработник 24/7. Telegram-фото из отряда каждый день.",
      "«Не скучно ли без телефона?» — Вечерние активности, хакатон, живое общение со сверстниками — телефон забывается к третьему дню."
    ]
  },
  {
    h2: "Почему 11 лет — переломный момент для IT",
    text: "11 лет — возраст, когда абстрактное мышление начинает работать в полную силу. Школьники уже могут понять, что такое функция или условие, не просто повторяя за педагогом, но осознанно. При этом ещё не потеряли детский азарт и не боятся пробовать.",
    list: [
      "Переход от «кликать» к «создавать» происходит именно сейчас",
      "11-летние легко входят в командную работу и соревнование",
      "Страх ошибки ещё не сформировался — можно пробовать смело",
      "Первый бот в 11 лет — это задел на профессию"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Санаторий «Изумруд», Наро-Фоминский район, 66 км от МКАД по Киевскому шоссе. Для 10–12 лет важен баланс: половина дня — IT-занятия в малых группах, половина — активный отдых.",
    list: [
      "Соотношение вожатых 1:8 — педагог знает каждого",
      "Медик на территории 24/7, страховка включена",
      "Telegram-фото из отряда ежедневно",
      "Закрытый бассейн — купание ежедневно по расписанию",
      "Питание 5 раз в день"
    ]
  },
  {
    h2: "Смены 2026: июль занят, июнь и август — есть места",
    text: "Для 10–12 лет подходят все смены. Если хочется сделать серьёзный проект — рекомендуем смену на 13–14 дней: за две недели успеваем пройти от основ до защиты полноценного продукта. Июль занят полностью.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽ (максимальный результат)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽",
      "Июль занят полностью. В июне и августе места есть"
    ]
  },
  {
    h2: "Смотрите также: лагерь по возрасту",
    text: "Программа растёт вместе с ребёнком. Что было до и что будет после:",
    list: [
      "<a href='/lager-10-let'>Лагерь для 10 лет</a> — Python с нуля: переменные, условия, первый проект",
      "<a href='/lager-12-let'>Лагерь для 12 лет</a> — Python и AI: боты, ChatGPT API, реальные API-проекты",
      "<a href='/lager-14-let'>Лагерь для 14 лет</a> — Python Advanced и ChatGPT: AI-проект в портфолио",
      "Все программы — наш <a href='/it-camp'>IT-лагерь для школьников</a>"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Летний лагерь 11 лет в Подмосковье 2026 | АйДаКемп"
  description="Лагерь для детей 11 лет в Подмосковье 2026. Python, веб, Roblox, AI — реальный проект за смену. 66 км от МКАД, малые группы, от 48 000 ₽."
  h1="Лагерь для детей 11 лет — Python, веб и первый AI-проект"
  canonical="https://aidacamp.ru/lager-11-let"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая программа в IT-лагере для детей 11 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Дети 10–12 лет в АйДаКемп работают с Python на среднем уровне: функции, списки, работа с данными. Плюс HTML/CSS-вёрстка, Roblox Studio продвинутый и введение в AI. Итог смены — Telegram-бот, сайт или Roblox-карта с мультиплеером." }
        },
        {
          "@type": "Question",
          "name": "Подойдёт ли лагерь ребёнку 11 лет без опыта программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Педагоги начинают с уровня группы и никто не отстаёт. Если без опыта — определят в начальную подгруппу. Уже через 3–4 дня пишут первые работающие программы." }
        },
        {
          "@type": "Question",
          "name": "Что конкретно сделает ребёнок 11 лет за смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "К концу смены каждый защищает проект. Для 11-летних это чаще всего Telegram-бот, простой сайт на HTML/CSS или продвинутая карта в Roblox Studio. Проект реально работает — его можно запустить дома и показать друзьям." }
        },
        {
          "@type": "Question",
          "name": "Есть ли места в июле?",
          "acceptedAnswer": { "@type": "Answer", "text": "Июль занят полностью. В июне (смены 2.1 и 2) и августе (смены 3 и 4) места есть. Бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь для детей 11 лет?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (смена 2.1, 10–16 июня 2026). Смены 10–14 дней — от 74 900 ₽. В стоимость входит всё: проживание, питание 5 раз, IT-занятия, бассейн. Доступен налоговый вычет 13%." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для детей 11 лет — Python, веб, Roblox и реальный проект"
    subtitle="11 лет — лучшее время перейти от «нажимать» к «создавать». Школьники пишут работающий код и привозят проект, который можно показать друзьям."
    breadcrumb="Лагерь для детей 11 лет"
    keywords={["Python + веб (HTML/CSS) + Roblox продвинутый", "Telegram-бот или сайт за смену", "Вожатый 1:8, медработник 24/7"]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Лагерь для детей 11 лет в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Подросток не хочет учиться — что делать без нотаций", url: "/stati/podrostok-ne-hochet-uchitsya", description: "Что реально возвращает интерес к учёбе и новым знаниям.", icon: "book" },
    { title: "«Я неудачник» — что делать когда ребёнок говорит это", url: "/stati/nizkaya-samootsenka-u-rebenka", description: "Причины низкой самооценки у детей и конкретные шаги.", icon: "emoji-smile" },
    { title: "Подросток один и без друзей — что мама может сделать", url: "/stati/problemy-v-obschenii-podrostkov", description: "Почему дети теряют друзей и как помочь найти своих.", icon: "people" },
    { title: "Подростку ничего не надо — что за этим стоит", url: "/stati/kak-pomoch-podrostku-kotoryj-nichego-ne-hochet", description: "Апатия у ребёнка — не лень. Что происходит на самом деле.", icon: "chat-dots" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
