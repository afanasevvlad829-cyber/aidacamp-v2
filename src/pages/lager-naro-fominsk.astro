---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Где именно находится лагерь",
    text: "АйДаКемп работает на территории санатория «Изумруд» в Наро-Фоминском городском округе Московской области. До лагеря 66 км от МКАД по Калужскому шоссе (A-101). Координаты: 55.265643, 36.724185. До Наро-Фоминска — 12 км, до Апрелевки — 15 км. Закрытая охраняемая территория с корпусами, бассейном и спортплощадками."
  },
  {
    h2: "IT-программа в Наро-Фоминском лагере",
    text: "Дети выбирают трек по интересу: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование (Blender). Занятия проходят дважды в день по 90 минут. Группы до 8 человек — каждый получает внимание преподавателя.",
    list: [
      "Python — от переменных и циклов до телеграм-бота или игры",
      "AI — ChatGPT API, генерация изображений, нейросетевые проекты",
      "Minecraft Education — программирование в знакомой среде",
      "Roblox Studio + Lua — создание игр на популярной платформе",
      "3D-моделирование — Blender + 3D-печать итогового объекта",
      "Итоговый хакатон — каждый защищает свой проект на последний день смены"
    ]
  },
  {
    h2: "Инфраструктура лагеря",
    text: "Санаторий «Изумруд» — ухоженная закрытая территория с разнообразной инфраструктурой. Дети живут в комфортных корпусах и питаются 5 раз в день.",
    list: [
      "Корпуса с комнатами по 2–4 человека, санузел в каждой комнате",
      "Бассейн с ионизированной водой — через день",
      "Спортивные площадки: волейбол, футбол, бадминтон",
      "Медработник на территории круглосуточно",
      "Охрана и видеонаблюдение 24/7",
      "Договор, страховка, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Почему родители из Наро-Фоминска выбирают АйДаКемп",
    text: "Лагерь буквально рядом — 15–20 минут от Наро-Фоминска. Это совсем другой уровень спокойствия:",
    list: [
      "Ближайший IT-лагерь с проживанием — свой район, своя природа",
      "Никакой акклиматизации, никакого стресса от переезда — ребёнок дома по сути",
      "Заехать в любой день за 15 минут — посмотреть хакатон, привезти что забыл",
      "Самостоятельный заезд без трансфера — просто довезти по дороге"
    ]
  },
  {
    h2: "Смены лета 2026 и цены",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. Всё включено: проживание, питание, IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 500 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 69 600 ₽"
    ]
  },
  {
    h2: "Часто задаваемые вопросы жителей Наро-Фоминска",
    text: "Отвечаем на вопросы, которые чаще всего задают родители из Наро-Фоминска и ближайших городов.",
    list: [
      "Как добраться без машины? — Трансфер отправляется из Москвы (м. Солнцево). До точки сбора из Наро-Фоминска удобно на электричке (направление Киевского вокзала, ~40 минут), затем автобус до лагеря.",
      "Есть ли трансфер из самого Наро-Фоминска? — Нет, трансфер только из Москвы. Но многие семьи привозят детей самостоятельно — 12 км от Наро-Фоминска по прямой.",
      "Что взять с собой? — Полный список вещей высылаем за 3 дня до заезда. Основное: удобная одежда, купальник, средства гигиены, лекарства если нужны."
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title="Детский лагерь в Наро-Фоминском районе 2026 — АйДаКемп"
  description="IT-лагерь АйДаКемп в Наро-Фоминском районе Московской области. Python, AI, Minecraft. 66 км от МКАД, трансфер от метро Солнцево."
  h1="Детский лагерь в Наро-Фоминском районе"
  canonical="https://aidacamp.ru/lager-naro-fominsk"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Где находится лагерь в Наро-Фоминском районе?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп расположен в посёлке Мальчики Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. Территория санатория «Изумруд» в сосновом лесу." }
        },
        {
          "@type": "Question",
          "name": "Как добраться до лагеря из Москвы?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер от м. Солнцево — 2 500 ₽ в одну сторону. Или самостоятельно: по Киевскому шоссе (~66 км), около 1 часа без пробок." }
        },
        {
          "@type": "Question",
          "name": "Что включает IT-программа?",
          "acceptedAnswer": { "@type": "Answer", "text": "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — ребёнок выбирает один трек. Занятия дважды в день по 90 минут. В конце смены — хакатон с защитой проекта." }
        },
        {
          "@type": "Question",
          "name": "Безопасно ли в лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. Страховка включена в стоимость путёвки. Реестровый туроператор РТО 025773." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь в Наро-Фоминском районе — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе Московской области. Python, AI, Minecraft для детей 7–15 лет. Бассейн, закрытая территория."
      url="https://aidacamp.ru/lager-naro-fominsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь в Наро-Фоминском районе"
    subtitle="АйДаКемп расположен в Наро-Фоминском районе — 66 км от МКАД по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь Наро-Фоминск"
    keywords={["АйДаКемп — IT-лагерь в Наро-Фоминском районе", "Санаторий «Изумруд», закрытая охраняемая территория", "Python, AI, Minecraft: готовый проект за 10–14 дней"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="Детский лагерь в Наро-Фоминском районе — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
