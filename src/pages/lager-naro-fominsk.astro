---
import { DATES_SHORT_S2, DATES_SHORT_S21, DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MAX, PRICE_MIN, PRICE_S2, PRICE_S21, PRICE_S3, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { STAT_INSURED, STAT_RTO, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Считай, уже приехали",
    text: `Мы стоим на территории санатория «Изумруд» в Наро-Фоминском округе — 15 минут от города. Это не дневная группа с почасовым посещением, а смена с проживанием: корпус, 5-разовое питание, присмотр 24/7. Из Новой Москвы удобнее ехать по Калужскому шоссе с выездом на Киевское, в объезд МКАД. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону, с сопровождающим.`,
    list: [
      "15 минут от города, а не через полстраны",
      "Проживание, а не занятия на пару часов",
      "Заехать на хакатон в финальный день — легко"
    ]
  },
  {
    h2: "Чем занимаются на смене",
    text: "Ребята 7–15 лет выбирают трек по интересу — не общий кружок для всех: занятия дважды в день по 90 минут, группы до 8 человек.",
    list: [
      "Python — от переменных и циклов до телеграм-бота или игры",
      "AI — ChatGPT API, генерация изображений, нейросетевые проекты",
      "Minecraft Education — программирование в знакомой среде",
      "Roblox Studio + Lua — свои игры на популярной платформе",
      "3D-моделирование — Blender и печать готового объекта",
      "Хакатон в финале — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые, врач и что видно родителям",
    text: "Один преподаватель на 6–8 участников — личное внимание вместо общего потока. Врач дежурит круглосуточно, территория закрытая и охраняемая. Ежедневные фото — в Telegram-чат отряда.",
    list: [
      "1 преподаватель на 6–8 ребят",
      "Медработник и охрана 24/7",
      "Фото каждый день в чат отряда",
      "Лицензия Минобрнауки включена в стоимость"
    ]
  },
  {
    h2: "Территория санатория «Изумруд»",
    text: "Комнаты на 2–4 человека с санузлом, бассейн с ионизированной водой через день, спортзал и площадки — волейбол, футбол. Лес округа, прогулки каждый день. Меню — 5 приёмов пищи по нормам СанПиН, аллергии учитываем при заезде.",
    list: [
      "Корпуса, санузел в каждой комнате",
      "Бассейн без хлора — через день",
      "Спортзал и спортивные площадки на территории",
      `Договор, лицензия туроператора РТО ${STAT_RTO}, ${STAT_INSURED.toLowerCase()}`
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} — что открыто`,
    text: `Открыты августовские Смена 3 и Смена 4 — даты разбирают быстро. Стоимость включает всё по договору с юрлицом, доплат на месте нет. Рейтинг — ${STAT_RATING} на Яндекс.Картах.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (открыта)`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (открыта)`,
      `Смена 2 (завершена) — ${DATES_SHORT_S2}, 14 дней, ${PRICE_S2} (была самой популярной)`,
      `Смена 2.1 (завершена) — ${DATES_SHORT_S21}, 7 дней, ${PRICE_S21}`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title={`IT-лагерь в Наро-Фоминске — 15 минут от центра ${SEASON_YEAR}`}
  description={`Детский IT-лагерь в 15 минутах от Наро-Фоминска: Python, AI, Minecraft для детей 7–15 лет. Бассейн, налоговый вычет до ${VYCHET_MAX}, лицензия Минобрнауки.`}
  h1="Лагерь у Наро-Фоминска"
  canonical="https://aidacamp.ru/lager-naro-fominsk"
>
  <Fragment slot="head">
    <CourseSchema
      name="IT-лагерь в Наро-Фоминске — 15 минут от центра, АйДаКемп"
      description="Программа для ребят 7–15 лет в Наро-Фоминском городском округе Московской области: Python, AI, Minecraft. Бассейн, закрытая территория лагеря."
      url="https://aidacamp.ru/lager-naro-fominsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь у Наро-Фоминска"
    subtitle="АйДаКемп расположен прямо здесь — 15 минут от города. Детские IT-смены: Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Наро-Фоминск"
    keywords={["15 минут от центра округа — рядом, а не через полстраны", "IT-смены в санатории «Изумруд», закрытая охраняемая территория", "Python, AI, Minecraft: готовый проект за 10–14 дней"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="АйДаКемп — территория в Наро-Фоминском округе"
  />
  <LandingTwoCol sections={sections} />
  <section class="mx-auto max-w-[960px] px-4 py-8">
    <h2 class="text-[22px] font-semibold text-slate-800 mb-4">Наро-Фоминск на карте</h2>
    <p class="text-base text-slate-600 mb-4">Санаторий «Изумруд» в Наро-Фоминском округе, координаты 55.265643, 36.724185. От центра — 15 минут на машине.</p>
    <div class="rounded-2xl overflow-hidden border border-slate-200">
      <iframe
        src="https://yandex.ru/map-widget/v1/?ll=36.724185%2C55.265643&z=13&pt=36.724185%2C55.265643%2Cpm2rdm"
        width="100%"
        height="360"
        frameborder="0"
        loading="lazy"
        title="АйДаКемп на карте — рядом с Наро-Фоминском"
      ></iframe>
    </div>
  </section>
  <Gallery />
  <Shifts />
  <section class="mx-auto max-w-[720px] px-4 py-8">
    <h2 class="text-[22px] font-semibold text-slate-800 mb-4">Что говорят семьи</h2>
    <blockquote class="rounded-2xl bg-slate-50 border border-slate-200 p-5">
      <p class="text-base text-slate-700 italic mb-2">«Дочка просилась к нам, а я боялась отпускать далеко. Оказалось — рядом с Наро-Фоминском, 15 минут от нас. Привезли утром, вечером я уже видела фото в чате. Через неделю забрали — она показала своего телеграм-бота, которого сама написала. Спокойно и по-домашнему.»</p>
      <footer class="text-base text-slate-500">— мама, смена 2.1</footer>
    </blockquote>
  </section>
  <FAQ extraItems={[
    { q: "Где находится АйДаКемп?", a: "АйДаКемп — загородная смена с проживанием на территории санатория «Изумруд», у Наро-Фоминска, а не городская дневная группа. 66 км от МКАД по Киевскому шоссе, ~1 час без пробок, от центра — 15 минут." },
    { q: "Безопасна ли территория лагеря?", a: `Да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. ${STAT_INSURED}. Реестровый туроператор РТО ${STAT_RTO}.` }
  ]} items={['documents:6', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/ozdorovitelnyj-lager/" class="text-primary hover:underline">оздоровительный лагерь</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
