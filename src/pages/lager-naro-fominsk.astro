      url="https://aidacamp.ru/lager-naro-fominsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="IT-лагерь в Наро-Фоминске"
    subtitle="АйДаКемп расположен прямо здесь — 15 минут от Наро-Фоминска. Детские IT-смены: Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Наро-Фоминск"
    keywords={["15 минут от центра округа — рядом, а не через полстраны", "Детские IT-смены в санатории «Изумруд», закрытая охраняемая территория", "Python, AI, Minecraft: готовый проект за 10–14 дней"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="АйДаКемп — территория в Наро-Фоминском округе"
  />
  <LandingTwoCol sections={sections} />
  <section class="mx-auto max-w-[960px] px-4 py-8">
    <h2 class="text-[22px] font-semibold text-slate-800 mb-4">Наро-Фоминск на карте</h2>
    <p class="text-base text-slate-600 mb-4">Санаторий «Изумруд», Наро-Фоминский городской округ. Координаты: 55.265643, 36.724185. От центра города — 15 минут на машине.</p>
    <div class="rounded-2xl overflow-hidden border border-slate-200">
      <iframe
        src="https://yandex.ru/map-widget/v1/?ll=36.724185%2C55.265643&z=13&pt=36.724185%2C55.265643%2Cpm2rdm"
        width="100%"
        height="360"
        frameborder="0"
        loading="lazy"
        title="АйДаКемп на карте — рядом с Наро-Фоминском"
      ></iframe>
    </div>
  </section>
  <Gallery />
  <Shifts />
  <section class="mx-auto max-w-[720px] px-4 py-8">
    <h2 class="text-[22px] font-semibold text-slate-800 mb-4">Что говорят семьи из Наро-Фоминска</h2>
    <blockquote class="rounded-2xl bg-slate-50 border border-slate-200 p-5 mb-4">
      <p class="text-base text-slate-700 italic mb-2">«Дочка просилась в лагерь, а я боялась отпускать далеко. А тут оказалось — 15 минут от нас. Привезли утром, вечером я уже видела фото в чате. Через неделю забрали — она показала своего телеграм-бота, которого сама написала. Спокойно и по-домашнему.»</p>
      <footer class="text-base text-slate-500">— Мама из Наро-Фоминска, смена 2.1</footer>
    </blockquote>
    <blockquote class="rounded-2xl bg-slate-50 border border-slate-200 p-5">
      <p class="text-base text-slate-700 italic mb-2">«Удобно, что рядом: заехали на хакатон в последний день, посмотрели, как ребята защищают проекты. Дочь весь август про это рассказывала подругам.»</p>
      <footer class="text-base text-slate-500">— Мама из Наро-Фоминского округа</footer>
    </blockquote>
  </section>
  <FAQ extraItems={[
    { q: "Где находится АйДаКемп рядом с Наро-Фоминском?", a: "АйДаКемп — загородный лагерь с проживанием на территории санатория «Изумруд» в Наро-Фоминском городском округе (это не городская дневная группа). 66 км от МКАД по Киевскому шоссе, ~1 час без пробок. От центра Наро-Фоминска — 15 минут." },
    { q: "Как добраться до лагеря из Москвы?", a: `Организованный трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону, с сопровождающим до лагеря. Или самостоятельно: по Киевскому шоссе (~66 км от МКАД), около 1 часа без пробок. От города до лагеря — 15 минут. Из Новой Москвы и южного направления удобнее ехать по Калужскому шоссе с выездом на Киевское — маршрут в объезд Москвы, без потери времени на кольцевой.` },
    { q: "Что включает IT-программа?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — участник выбирает один трек. Занятия дважды в день по 90 минут. В конце смены — хакатон с защитой проекта." },
    { q: "Безопасно ли в лагере?", a: `Да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. ${STAT_INSURED}. Реестровый туроператор РТО ${STAT_RTO}.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/ozdorovitelnyj-lager/" class="text-primary hover:underline">оздоровительный лагерь</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
