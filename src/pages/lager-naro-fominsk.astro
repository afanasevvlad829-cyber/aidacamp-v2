---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Вы уже рядом — лагерь прямо здесь",
    text: "АйДаКемп работает на территории санатория «Изумруд» в Наро-Фоминском городском округе. До ворот лагеря от центра Наро-Фоминска — 15 минут. Координаты: 55.265643, 36.724185. Это самый короткий маршрут из всех наших городов: просто привезти и уехать домой."
  },
  {
    h2: "Почему для Наро-Фоминска это совсем другой уровень спокойствия",
    text: "Когда лагерь в 15 минутах от дома — это не просто удобно. Это значит: можно приехать на хакатон в последний день и увидеть проект вживую. Можно забрать вещи, которые забыли. Можно просто проехать мимо и убедиться, что всё хорошо. Для семей из Наро-Фоминска АйДаКемп — это почти домашний лагерь с загородной территорией.",
    list: [
      "15 минут от Наро-Фоминска — ближайший IT-лагерь с проживанием",
      "Самостоятельный заезд без трансфера — просто довезти по дороге",
      "Приехать на хакатон в финале смены — реально и удобно",
      "Никакой акклиматизации — своя природа, привычный воздух"
    ]
  },
  {
    h2: "IT-программа прямо у вас под боком",
    text: "Школьники 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование (Blender). Занятия проходят дважды в день по 90 минут. Группы до 8 человек — каждый получает внимание преподавателя.",
    list: [
      "Python — от переменных и циклов до телеграм-бота или игры",
      "AI — ChatGPT API, генерация изображений, нейросетевые проекты",
      "Minecraft Education — программирование в знакомой среде",
      "Roblox Studio + Lua — создание игр на популярной платформе",
      "3D-моделирование — Blender + 3D-печать итогового объекта",
      "Итоговый хакатон — каждый защищает свой проект на последний день смены"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "Один преподаватель на 6–8 участников — маленькие группы, личное внимание. Медработник дежурит круглосуточно. Ежедневные фото из лагеря в Telegram-чат отряда — родители видят, что происходит.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый в фокусе",
      "Медработник 24/7, охрана, закрытая территория санатория",
      "Ежедневные фото в Telegram-чат отряда",
      "Лицензия Минобрнауки включена в стоимость"
    ]
  },
  {
    h2: "Инфраструктура лагеря",
    text: "Санаторий «Изумруд» — ухоженная закрытая территория. Участники живут в комфортных корпусах и питаются 5 раз в день.",
    list: [
      "Корпуса с комнатами по 2–4 человека, санузел в каждой комнате",
      "Бассейн с ионизированной водой — через день",
      "Спортивные площадки: волейбол, футбол, бадминтон",
      "Договор, лицензия туроператора РТО 025773"
    ]
  },
  {
    h2: "Июль занят. В июне и августе места ещё есть",
    text: "Июль — самый популярный месяц, смены расходятся первыми. Для жителей Наро-Фоминска это особенно актуально: многие записываются, когда узнают, что лагерь буквально рядом. Июнь и август ещё открыты.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней, ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней, ${PRICE_MAX} (самая популярная)`,
      `Смена 3 — 3–15 августа, 13 дней, ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней, ${PRICE_S4}`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/detskiy-lager-podmoskove.avif"
  title="Детский лагерь в Наро-Фоминском районе 2026 — АйДаКемп"
  description="IT-лагерь АйДаКемп в Наро-Фоминском районе — 15 минут от Наро-Фоминска. Python, AI, Minecraft. 66 км от МКАД, трансфер от метро Солнцево."
  h1="Детский лагерь в Наро-Фоминском районе"
  canonical="https://aidacamp.ru/lager-naro-fominsk"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Где находится лагерь в Наро-Фоминском районе?", a: "АйДаКемп расположен в посёлке Мальчики Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. До ворот лагеря от центра Наро-Фоминска — 15 минут. Территория санатория «Изумруд» в сосновом лесу." },
    { q: "Как добраться до лагеря из Москвы?", a: "Организованный трансфер от м. Солнцево — 2 000 ₽ в одну сторону. Или самостоятельно: по Киевскому шоссе (~66 км), около 1 часа без пробок. Из Наро-Фоминска — 15 минут по прямой." },
    { q: "Что включает IT-программа?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — участник выбирает один трек. Занятия дважды в день по 90 минут. В конце смены — хакатон с защитой проекта." },
    { q: "Безопасно ли в лагере?", a: "Да. Охрана 24/7, медработник на территории, видеонаблюдение, закрытая территория. Застрахована ответственность туроператора (Росгосстрах). Реестровый туроператор РТО 025773." }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь в Наро-Фоминском районе — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе Московской области. Python, AI, Minecraft для ребят 7–15 лет. Бассейн, закрытая территория."
      url="https://aidacamp.ru/lager-naro-fominsk"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь в Наро-Фоминском районе"
    subtitle="АйДаКемп расположен прямо здесь — 15 минут от Наро-Фоминска. Python, AI, Minecraft для ребят 7–15 лет."
    breadcrumb="Лагерь Наро-Фоминск"
    keywords={["15 минут от Наро-Фоминска — лагерь прямо рядом", "Санаторий «Изумруд», закрытая охраняемая территория", "Python, AI, Minecraft: готовый проект за 10–14 дней"]}
    image="/images/hero/detskiy-lager-podmoskove.avif"
    imageAlt="Детский лагерь в Наро-Фоминском районе — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
