import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import { STAT_INSURED, STAT_RTO, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Наро-Фоминск — считай, уже приехали",
    text: `АйДаКемп стоит на территории санатория «Изумруд» в Наро-Фоминском городском округе — 15 минут от центра, координаты 55.265643, 36.724185. Это — самый короткий маршрут из всех наших направлений: привезти и забрать в тот же день, если нужно. Программа лагеря не меняется от расстояния — тот же Python и тот же хакатон. Из Новой Москвы и южного направления удобнее по Калужскому шоссе с выездом на Киевское, в объезд МКАД. Трансфер от м. Солнцево — ${TRANSFER_PRICE_FMT} в одну сторону, с сопровождающим.`,
    list: [
      "15 минут от города — рядом, а не через полстраны",
      "Территория видна прямо с дороги",
      "Заехать на хакатон в финальный день — легко",
      "Своя природа и воздух — без акклиматизации"
    ]
  },
  {
    h2: "Не дневная группа — смена с проживанием",
    text: "Когда ищут «городской лагерь в Наро-Фоминске», обычно имеют в виду дневную группу: привёл утром, забрал вечером. У АйДаКемп иначе — загородная смена с проживанием на территории санатория «Изумруд». Ребёнок живёт в корпусе, ест 5 раз в день, под присмотром 24/7 — это полноценный загородный оздоровительный формат, а не занятия на пару часов. Распорядок одинаковый для всех смен: подъём, занятия, вечерние активности, хакатон в финале. А до дома, если что, — 15 минут."
  },
  {
    h2: "Чем занимаются на смене",
    text: "Ребята 7–15 лет выбирают трек по интересу. Формат лагеря — трек, а не общий кружок для всех: занятия дважды в день по 90 минут, группы до 8 человек. Всё нужное для проекта — уже здесь.",
    list: [
      "Python — от переменных и циклов до телеграм-бота или игры",
      "AI — ChatGPT API, генерация изображений, нейросетевые проекты",
      "Minecraft Education — программирование в знакомой среде",
      "Roblox Studio + Lua — свои игры на популярной платформе",
      "3D-моделирование — Blender и печать готового объекта",
      "Хакатон в финале смены — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые, врач и что видно родителям",
    text: "В отличие от многих мест — один преподаватель на 6–8 участников, маленькие группы, личное внимание. Врач лагеря дежурит круглосуточно, территория закрытая и охраняемая. Вожатые и медик всегда на связи. Ежедневные фото — в Telegram-чат отряда.",
    list: [
      "1 преподаватель на 6–8 ребят",
      "Медработник и охрана 24/7",
      "Фото каждый день в чат отряда",
      "Лицензия Минобрнауки включена в стоимость"
    ]
  },
  {
    h2: "Территория санатория «Изумруд» — с оздоровительной частью",
    text: "Комнаты на 2–4 человека с санузлом, бассейн с ионизированной водой через день, спортивный зал и спортивные площадки — волейбол, футбол. Хвойный лес округа, прогулки каждый день. Меню — 5 приёмов пищи по нормам СанПиН, аллергии учитываем при заезде. Санаторий «Изумруд» — по сути ещё и оздоровительная база: оздоровительным для ребёнка становится сам режим — сон, воздух, движение, а не только IT-проект.",
    list: [
      "Корпуса, санузел в каждой комнате",
      "Бассейн без хлора — через день",
