---
import { PRICE_MIN } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Лагерь Scratch — первый язык программирования для детей 7–10 лет",
    text: "Scratch — идеальный вход в программирование для младших школьников. Вместо букв и скобок — цветные блоки, которые собираются как конструктор. Ребёнок не печатает код, а «складывает» программу. За смену дети создают 2–3 собственные игры или анимации, которые работают сразу и которые можно показать родителям и друзьям. АйДаКемп — <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT-лагерь</a> для детей от 7 лет. Scratch — стартовая программа нашего <a href='/kompyuternyy-lager/' class='text-[#ec7c00] hover:underline'>компьютерного лагеря</a> для самых маленьких."
  },
  {
    h2: "Программа Scratch в лагере",
    text: "Программа построена от простого к сложному. Никаких лекций — только практика через свои проекты. Группы до 8 человек, преподаватель-практик рядом.",
    list: [
      "Первый проект «Здравствуй, мир» — знакомство с интерфейсом",
      "Создание персонажа и анимация движения",
      "Игровая логика — условия «если-то», переменные, счёт очков",
      "Собственная игра — платформер, раннер или викторина",
      "Презентация проекта родителям — защита работы на хакатоне"
    ]
  },
  {
    h2: "Программа Scratch по дням — что осваивают",
    text: "Каждый день смены — новый уровень умений. Вот как строится прогрессия в Scratch-треке:",
    list: [
      "День 1–2: знакомство с интерфейсом Scratch, создание первого спрайта и сцены. Анимация движения — персонаж ходит, прыгает, реагирует на клавиши",
      "День 3–5: условные блоки if/then, переменные для счёта очков, циклы repeat. Первая мини-игра: «лови падающие предметы» или «прыгай через препятствия»",
      "День 6–8: работа с несколькими спрайтами, трансляция сообщений между персонажами, добавление звуков и фонов. Начало финального проекта",
      "Дни 9–10: финальная доработка игры или анимации. Добавление заставки, экрана «игра окончена», сохранение результатов",
      "Финал: хакатон — каждый показывает свою игру, родители играют, вручаем сертификаты"
    ]
  },
  {
    h2: "Для какого возраста подходит Scratch-лагерь",
    text: "Scratch-трек в АйДаКемп рассчитан на детей 7–11 лет. Нюансы по возрастам:",
    list: [
      "7–8 лет: отличный старт. Дети этого возраста ещё не читают код, но блоки Scratch — как детали LEGO: всё понятно визуально. За смену создают 1–2 простые игры и анимацию",
      "9–10 лет: золотой возраст для Scratch. Уже читают достаточно быстро, понимают логику «если-то», могут самостоятельно придумать и реализовать игровую идею",
      "11 лет: Scratch подходит как стартовый трек если не было опыта программирования. После смены легко переходить на Python — концепции те же, просто другая форма записи",
      "12+ лет без опыта: рассматриваем индивидуально. Скорее всего порекомендуем сразу Python-базовый — Scratch для этого возраста может показаться слишком простым"
    ]
  },
  {
    h2: "Что ребёнок создаст за смену Scratch",
    text: "Через 10 дней в лагере у ребёнка на руках не «пройденная тема», а конкретные проекты которые работают:",
    list: [
      "Платформер — персонаж бежит, прыгает, собирает монеты, проигрывает если падает в яму",
      "Раннер с препятствиями — бесконечная дорожка, нарастающая скорость, таблица рекордов",
      "Интерактивная история — несколько сцен, диалоги персонажей, разные концовки",
      "Мультфильм-анимация — короткий мультик с персонажами и озвучкой",
      "Викторина для класса — вопросы, варианты ответов, итоговый счёт, можно отправить друзьям",
      "Арт-генератор — программа которая рисует узоры и геометрические фигуры с каждым запуском по-разному"
    ]
  },
  {
    h2: "Почему именно АйДаКемп для первого знакомства со Scratch",
    text: "Scratch-кружки есть во многих школах и онлайн. В чём разница лагерного формата:",
    list: [
      "Полное погружение — 4–5 часов в день вместо 45 минут в неделю. За 10 дней лагеря — то, что в кружке занимает год",
      "Живое общение — участники показывают друг другу игры, помогают, соревнуются. Это сильнее любого урока",
      "Реальный продукт в финале — не «прошли тему переменных», а игра которую можно запустить и поиграть",
      "Группы до 8 человек — преподаватель видит каждого ребёнка, объясняет там где непонятно, даёт задачи на вырост тем кто продвигается быстро"
    ]
  },
  {
    h2: "Почему Scratch — первый язык",
    text: "MIT (создатели Scratch) целенаправленно делали его как «математический конструктор логики» для детей. В нём нет синтаксиса, который пугает. Нет ошибок из-за опечаток. Зато есть все фундаментальные концепции программирования — циклы, условия, переменные, функции. Ребёнок, который освоил Scratch, легко пересаживается на Python через 1–2 года — концепции одинаковые, меняется только внешний вид кода."
  },
  {
    h2: "Что уносят ребята из лагеря Scratch",
    text: "Через 10 дней в лагере ребята 7–10 лет не просто «поиграли в программирование» — у них на руках конкретный набор результатов. Это и есть отличие лагеря от обычного кружка: за короткое время — видимый результат.",
    list: [
      "2–3 собственные игры в Scratch — можно показать друзьям и бабушке",
      "Аккаунт в Scratch community — можно делиться проектами",
      "Сертификат об участии — пригодится для портфолио в школу",
      "Фото с хакатона — момент, где ребята презентуют свою работу",
      "Уверенность — «я могу сделать игру сам, а не только играть в чужие»"
    ]
  },
  {
    h2: "Мифы про Scratch которые сразу разрушим",
    text: "Родители первый раз сталкиваются со Scratch часто с предубеждениями. Разбираем типичные.",
    list: [
      "«Scratch — это игрушка, не программирование» — ошибка. На нём MIT делает свои академические курсы, принципы точно те же что в Python/JS",
      "«Ребёнок будет просто играть» — нет, программа выстроена с прогрессией, каждый день новые концепции",
      "«В Scratch нет настоящего кода» — формально нет, но логика программирования и принципы алгоритмов — те же",
      "«Scratch для совсем малышей» — он хорош и для 12-13 лет как первое знакомство перед Python"
    ]
  },
  {
    h2: "После Scratch — что дальше в 10–11 лет",
    text: "Scratch — отличный старт, но он специально создан для 7–10-летних. В 10–11 лет наступает момент «перерасти» его. Вот что происходит дальше:",
    list: [
      "Переход на Python: те же концепции — циклы, условия, переменные, функции — только записанные текстом. Занимает 2–4 недели чтобы почувствовать себя уверенно",
      "Первый Python-проект обычно — Telegram-бот. Дочь или сын создают бота для мамы которая напоминает о домашних заданиях — это реальное применение, мотивирует сильнее любого урока",
      "Альтернативный путь: Minecraft-лагерь в 10–12 лет — там схожая визуальность, но добавляется 3D и первый знакомство с Java/Python через MakeCode",
      "Трек в АйДаКемп: Scratch (7–9 лет) → Minecraft или Roblox (10–11 лет) → Python базовый (11–12 лет) → Python продвинутый (13–15 лет)"
    ]
  },
  {
    h2: "Записывайтесь сейчас — июль разбирают первым",
    text: "Scratch-трек для младших школьников — традиционно самый быстро заполняемый. Родители бронируют места ещё весной, пока не начался сезон поступления. На июнь и август ещё есть места — на июль лучше проверить прямо сейчас."
  },
  {
    h2: "Путь развития: Scratch → Minecraft → Python",
    text: "Scratch — это первая ступенька. За ним логично идут Minecraft Education (тот же визуальный стиль плюс 3D-мир) и потом Python (уже текстовый код, но с понятными ребёнку концепциями). Именно так мы строим программу для детей, которые несколько раз приходят в АйДаКемп:",
    list: [
      "Первая смена в 8 лет — лагерь Scratch, первые игры",
      "Вторая смена в 9-10 лет — Minecraft-лагерь, работа с редстоуном и первые скрипты",
      "Третья смена в 11-12 лет — переход на Python, делает Telegram-бота",
      "Четвёртая смена в 13-15 лет — Python Advanced, AI-проект на Gemini API",
      "К 14 годам — у ребёнка реальное портфолио на GitHub из 4-5 проектов"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/scratch-lager.avif"
  title="Лагерь Scratch для детей в Подмосковье 2026 | АйДаКемп"
  description={`Scratch-лагерь для детей 7–10 лет в Подмосковье: за смену — собственная игра или мультфильм, без текстового кода. Группы до 8 человек, вожатый 1:8, бассейн. От ${PRICE_MIN}.`}
  h1="Лагерь Scratch для детей в Подмосковье"
  canonical="https://aidacamp.ru/scratch-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое Scratch и зачем он детям?", a: "Scratch — визуальный язык программирования от MIT, где блоки кода перетаскиваются мышкой, без синтаксиса и ошибок из-за опечаток. Идеален как первый язык для детей 7–10 лет. После Scratch легко переходить на Python." },
    { q: "С какого возраста дети занимаются Scratch?", a: "С 7 лет. Scratch-трек рассчитан на детей 7–10 лет. С 10–11 лет рекомендуем переходить на Python — это логичное продолжение." },
    { q: "Что создают дети на Scratch за смену?", a: "2–3 собственные игры или анимации. Типичные проекты: платформер, гонки, интерактивная история. В финале смены — хакатон, где каждый показывает свою игру." },
    { q: "Поможет ли Scratch в будущем при изучении Python?", a: "Да. Scratch учит ключевым понятиям: переменные, циклы, условия, события. Когда ребёнок переходит на Python, эти концепции уже понятны — он просто учится записывать их текстом." },
    { q: "Что такое Scratch и чем он отличается от настоящего программирования?", a: "Scratch — это визуальное программирование: вместо написания кода вы перетаскиваете блоки-команды. Все принципы реального программирования — циклы, условия, переменные, функции — в Scratch есть. Разница только в форме: вместо текста — цветные блоки. После Scratch переход на Python или JavaScript занимает 1–2 месяца." },
    { q: "Мой ребёнок уже делал что-то в Scratch — подойдёт ли ему уровень новичка?", a: "При записи мы уточняем уровень. Дети с опытом в Scratch попадают в группу где начинают сразу с более сложных задач: многоуровневые игры, работа с несколькими спрайтами, продвинутые механики. Скучать не придётся." },
    { q: "Нужен ли ноутбук для Scratch-лагеря?", a: "Нет. Все компьютеры предоставляет лагерь. Scratch работает в браузере — ноутбук с собой везти не нужно." }
  ]} />
    <CourseSchema
      slot="head"
      name="Лагерь Scratch для детей — визуальное программирование"
      description="Летний лагерь Scratch для детей 7–10 лет: первые игры и анимации через блочное программирование без синтаксиса, за 7 или 14 дней."
      url="https://aidacamp.ru/scratch-lager"
      level="Beginner"
      ageMin={7}
      ageMax={10}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь Scratch для детей в Подмосковье"
    subtitle="Первый язык программирования для младших школьников. За 10 дней ребёнок создаёт 2–3 собственные игры, которые работают и которые можно показать."
    breadcrumb="Лагерь Scratch"
    keywords={["Scratch — визуальный язык без букв, для детей 7–10 лет", "2–3 собственные игры в финале смены", "От MIT, бесплатный, остаётся с ребёнком после лагеря"]}
    image="/images/hero/scratch-lager.avif"
    imageAlt="Лагерь Scratch для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedArticles articles={[
    { title: "Scratch для детей: первые шаги в программировании", url: "/stati/scratch-dlya-detej/", description: "Что такое Scratch, почему с него начинают в 7-11 лет и как перейти к Python.", icon: "puzzle" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya/", description: "Нулевой опыт — норма. Дорожная карта по возрастам.", icon: "braces" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej/", description: "Следующий шаг после Scratch — почему Python и с какого возраста.", icon: "code-slash" },
  ]} />
  <RelatedPages pages={[
    { title: "IT-лагерь АйДаКемп", url: "/it-camp/", icon: "laptop" },
    { title: "Компьютерный лагерь", url: "/kompyuternyy-lager/", icon: "pc-display" },
    { title: "Scratch для детей — статья", url: "/stati/scratch-dlya-detej/", icon: "puzzle" },
    { title: "Цены и смены", url: "/ceny/", icon: "currency-exchange" },
  ]} />
</LandingLayout>
