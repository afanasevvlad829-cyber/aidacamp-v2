---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Лагерь Scratch — первый язык программирования для детей 7–10 лет",
    text: "Scratch — идеальный вход в программирование для младших школьников. Вместо букв и скобок — цветные блоки, которые собираются как конструктор. Ребёнок не печатает код, а «складывает» программу. За смену дети создают 2–3 собственные игры или анимации, которые работают сразу и которые можно показать родителям и друзьям."
  },
  {
    h2: "Программа Scratch в лагере",
    text: "Программа построена от простого к сложному. Никаких лекций — только практика через свои проекты. Группы до 8 человек, преподаватель-практик рядом.",
    list: [
      "Первый проект «Здравствуй, мир» — знакомство с интерфейсом",
      "Создание персонажа и анимация движения",
      "Игровая логика — условия «если-то», переменные, счёт очков",
      "Собственная игра — платформер, раннер или викторина",
      "Презентация проекта родителям — защита работы на хакатоне"
    ]
  },
  {
    h2: "Почему Scratch — первый язык",
    text: "MIT (создатели Scratch) целенаправленно делали его как «математический конструктор логики» для детей. В нём нет синтаксиса, который пугает. Нет ошибок из-за опечаток. Зато есть все фундаментальные концепции программирования — циклы, условия, переменные, функции. Ребёнок, который освоил Scratch, легко пересаживается на Python через 1–2 года — концепции одинаковые, меняется только внешний вид кода."
  },
  {
    h2: "Что уносят дети из лагеря Scratch",
    text: "Через 10 дней в лагере ребёнок 7–10 лет не просто «поиграл в программирование» — у него на руках конкретный набор результатов. Это и есть отличие лагеря от обычного кружка: за короткое время — видимый результат.",
    list: [
      "2–3 собственные игры в Scratch — можно показать друзьям и бабушке",
      "Аккаунт в Scratch community — ребёнок может делиться проектами",
      "Сертификат об участии — пригодится для портфолио в школу",
      "Фото с хакатона — момент, где ребёнок презентует свою работу",
      "Уверенность — «я могу сделать игру сам, а не только играть в чужие»"
    ]
  },
  {
    h2: "Мифы про Scratch которые сразу разрушим",
    text: "Родители первый раз сталкиваются со Scratch часто с предубеждениями. Разбираем типичные.",
    list: [
      "«Scratch — это игрушка, не программирование» — ошибка. На нём MIT делает свои академические курсы, принципы точно те же что в Python/JS",
      "«Ребёнок будет просто играть» — нет, программа выстроена с прогрессией, каждый день новые концепции",
      "«В Scratch нет настоящего кода» — формально нет, но логика программирования и принципы алгоритмов — те же",
      "«Scratch для совсем малышей» — он хорош и для 12-13 лет как первое знакомство перед Python"
    ]
  },
  {
    h2: "Как родителю поддержать интерес после Scratch",
    text: "Ребёнок вернулся из лагеря с горящими глазами и двумя играми. Что делать дальше? Типичная ошибка родителя — «купить крутой компьютер и подписку на платный курс». Лучше работает другое:",
    list: [
      "Создать аккаунт на scratch.mit.edu — бесплатно. Ребёнок продолжает делать проекты дома",
      "Поставить Scratch Desktop (offline-версия) — работает даже без интернета",
      "Подписаться на канал «ScratchTeam» или «Mr. Programmer Kids» — вдохновение",
      "Устроить «премьеру» его игры перед бабушкой/дедушкой — социальная поддержка мощно мотивирует ребёнка продолжать"
    ]
  },
  {
    h2: "Путь развития: Scratch → Minecraft → Python",
    text: "Scratch — это первая ступенька. За ним логично идут Minecraft Education (тот же визуальный стиль плюс 3D-мир) и потом Python (уже текстовый код, но с понятными ребёнку концепциями). Именно так мы строим программу для детей, которые несколько раз приходят в АйДаКемп:",
    list: [
      "Первая смена в 8 лет — лагерь Scratch, первые игры",
      "Вторая смена в 9-10 лет — Minecraft-лагерь, работа с редстоуном и первые скрипты",
      "Третья смена в 11-12 лет — переход на Python, делает Telegram-бота",
      "Четвёртая смена в 13-15 лет — Python Advanced, AI-проект на Gemini API",
      "К 14 годам — у ребёнка реальное портфолио на GitHub из 4-5 проектов"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/scratch-lager.avif"
  title="Лагерь Scratch для детей 2026 в Подмосковье — АйДаКемп"
  description="Летний лагерь Scratch для детей 7–10 лет в Подмосковье. Первые игры без синтаксиса — блочное программирование. 66 км от Москвы, от 48 000 ₽."
  h1="Лагерь Scratch для детей в Подмосковье"
  canonical="https://aidacamp.ru/scratch-lager"
>
  <CourseSchema
    slot="head"
    name="Лагерь Scratch для детей — визуальное программирование"
    description="Летний лагерь Scratch для детей 7–10 лет: первые игры и анимации через блочное программирование без синтаксиса, за 7 или 14 дней."
    url="https://aidacamp.ru/scratch-lager"
    level="Beginner"
    ageMin={7}
    ageMax={10}
  />
  <LandingHero slot="hero"
    h1="Лагерь Scratch для детей в Подмосковье"
    subtitle="Первый язык программирования для младших школьников. За 10 дней ребёнок создаёт 2–3 собственные игры, которые работают и которые можно показать."
    breadcrumb="Лагерь Scratch"
    keywords={["Scratch — визуальный язык без букв, для детей 7–10 лет", "2–3 собственные игры в финале смены", "От MIT, бесплатный, остаётся с ребёнком после лагеря"]}
    image="/images/hero/scratch-lager.avif"
    imageAlt="Лагерь Scratch для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Scratch для детей: первые шаги в программировании", url: "/stati/scratch-dlya-detej", description: "Что такое Scratch, почему с него начинают в 7-11 лет и как перейти к Python.", icon: "puzzle" },
    { title: "Программирование с нуля — путь до первого проекта", url: "/stati/programmirovanie-dlya-detej-s-nulya", description: "Нулевой опыт — норма. Дорожная карта по возрастам.", icon: "braces" },
    { title: "Python для детей — с нуля до первого проекта", url: "/stati/python-dlya-detej", description: "Следующий шаг после Scratch — почему Python и с какого возраста.", icon: "code-slash" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
