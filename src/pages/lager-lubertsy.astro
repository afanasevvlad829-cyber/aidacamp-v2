---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Люберец до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 80 км от Люберец. Маршрут: МКАД (через южный въезд) → Калужское шоссе, время в пути около 1.5 часов. Организованный трансфер отправляется от м. Солнцево — добраться из Люберец до метро можно на машине или на электричке за 40–50 минут."
  },
  {
    h2: "Почему родители из Люберец выбирают АйДаКемп",
    text: "Из Люберец до лагеря — 1.5 часа прямой дороги через Калужское шоссе. Никакой акклиматизации, ребёнок живёт в том же климатическом поясе, а домой приезжает с готовым IT-проектом. В лагере работает медработник круглосуточно, территория санатория закрытая и охраняемая.",
    list: [
      "80 км от Люберец — дорога без пробок в сторону области",
      "Трансфер от м. Солнцево — 40 минут от Люберец до точки сбора",
      "Тот же часовой пояс, нет акклиматизации, комфортный климат",
      "Бассейн с ионизированной водой, 5-разовое питание, охраняемая территория"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню подготовки. Занятия проходят дважды в день по 90 минут с практикующими IT-преподавателями. В конце смены — хакатон, где каждый защищает свой проект.",
    list: [
      "Python — от переменных до боta за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Люберец",
    text: "Каждое лето в АйДаКемп едут дети из Люберец и соседних городов юго-востока Подмосковья:",
    list: [
      "«Доехали до Солнцево, пересели на автобус — и всё. Дочь вернулась через две недели с презентацией своего AI-проекта. Это стоило каждого километра» — Марина, Люберцы",
      "«Сначала боялась, что далеко. Но 1.5 часа — это же соседний район, не Турция. Зато ребёнок вернулся другим: сам стал искать задачи по Python» — Ольга, Люберцы"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний лагерь Люберцы 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Люберцами: 1.5 часа по Калужскому шоссе, санаторий Изумруд. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Летний лагерь рядом с Люберцами"
  canonical="https://aidacamp.ru/lager-lubertsy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Люберец до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Люберец до лагеря около 80 км. Маршрут: МКАД → Калужское шоссе, время в пути ~1.5 часа. Организованный трансфер отправляется от м. Солнцево (2 500 ₽), добраться до метро из Люберец можно за 40–50 минут." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Люберец до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5 часов на машине по МКАД и Калужскому шоссе. Расстояние ~80 км. На трансфере от м. Солнцево — плюс время до метро." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Люберец?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, организованный трансфер отправляется от м. Солнцево. Стоимость 2 500 ₽ в одну сторону. Из Люберец до Солнцево можно доехать на машине или электричке за 40–50 минут." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (10–16 июня). Смена 14 дней — 95 000 ₽. Август: 89 400 ₽ (13 дней) и 74 900 ₽ (10 дней). В стоимость входит проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Люберцами — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5 часа от Люберец. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-lubertsy"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь рядом с Люберцами"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа из Люберец по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Люберец"
    keywords={["~1.5 часа из Люберец по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Летний лагерь рядом с Люберцами — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
