---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Люберцы — активная молодёжь восточного Подмосковья",
    text: "Люберцы — ближайший к Москве восточный пригород с активной молодёжной жизнью. Школьники отсюда амбициозны и привыкли двигаться быстро. АйДаКемп — для тех, кто хочет не просто отдохнуть летом, а вернуться с реальным навыком. Программирование, AI, собственный проект на хакатоне — и вот ребёнок уже тот, кто умеет создавать, а не просто пользоваться."
  },
  {
    h2: "Маршрут из Люберец в лагерь — ~110 км, ~1 ч 15 мин",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 110 км от Люберец. Маршрут через МКАД на Киевское шоссе: трафик идёт в противоположном от Москвы направлении, поэтому пробок значительно меньше.",
    list: [
      "На машине: из Люберец по МКАД (южный или западный съезд) → Киевское шоссе (M-3) → Апрелевка, ~110 км, ~1 ч 15 мин без пробок",
      "На электричке + трансфер: электричка из Люберец до Курского вокзала, затем метро до м. Солнцево (~40 мин), бесплатный трансфер АйДаКемп",
      "Трансфер от м. Солнцево бесплатно в день заезда и обратно в день отъезда"
    ]
  },
  {
    h2: "Почему родители из Люберец выбирают АйДаКемп",
    text: "Из Люберец до лагеря — 1 ч 15 мин прямой дороги через Киевское шоссе. Никакой акклиматизации, школьник живёт в том же климатическом поясе, а домой приезжает с готовым IT-проектом.",
    list: [
      "~110 км от Люберец — дорога без пробок в сторону области",
      "Трансфер от м. Солнцево бесплатно — около 40 мин от Люберец до точки сбора",
      "Тот же часовой пояс, нет акклиматизации, комфортный климат",
      "Бассейн с ионизированной водой, 5-разовое питание, охраняемая территория"
    ]
  },
  {
    h2: "IT-программа для ребят из Люберец",
    text: "Каждый выбирает IT-трек по интересу и уровню подготовки. Занятия проходят дважды в день по 90 минут с практикующими IT-преподавателями. В конце смены — хакатон, где каждый защищает свой проект.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для ребят 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают профессионалы: преподаватели-практики и воспитатели с педагогическим образованием. Родители всегда знают, что происходит в лагере.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Отзывы родителей из Люберец",
    text: "Каждое лето в АйДаКемп едут ребята из Люберец и соседних городов юго-востока Подмосковья:",
    list: [
      "«Доехали до Солнцево, пересели на автобус — и всё. Дочь вернулась через две недели с презентацией своего AI-проекта. Это стоило каждого километра» — Марина, Люберцы",
      "«Сначала боялась, что далеко. Но час с небольшим — это же соседний район, не Турция. Зато ребёнок вернулся другим: сам стал искать задачи по Python» — Ольга, Люберцы"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть места — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽ (налоговый вычет ~2 800 ₽)",
      "Смена 2 — 10–23 июня, 14 дней — 99 000 ₽ (налоговый вычет до 5 434 ₽)",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽ (налоговый вычет ~5 200 ₽)",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽ (налоговый вычет ~4 800 ₽)",
      "Трансфер от м. Солнцево — бесплатно"
    ]
  },
  {
    h2: "Также отправляют ребят из соседних городов",
    text: "В АйДаКемп едут ребята из Люберец и всего юго-востока Подмосковья:",
    list: [
      "<a href='/lager-reutov'>Реутов</a> — ~75 км, ~1 ч 20 мин по МКАД",
      "<a href='/lager-zhukovskiy'>Жуковский</a> — ~85 км, ~1 ч 20 мин",
      "<a href='/lager-vidnoe'>Видное</a> — ~55 км, ~1 ч по Киевскому шоссе",
      "<a href='/lager-podolsk'>Подольск</a> — ~45 км, ~50 мин прямо по Киевскому"
    ]
  },
  {
    h2: "Инфраструктура лагеря: что входит в стоимость",
    text: "Никаких скрытых доплат. Стоимость путёвки включает всё: проживание в корпусах санатория (комнаты 2–4 человека с санузлом), 5-разовое питание по нормам СанПиН, IT-программу с преподавателем, расходные материалы, бассейн через день, все вечерние активности, медработника. Дополнительно оплачивается только трансфер.",
    list: [
      "Проживание: корпуса санатория «Изумруд», комнаты 2–4 человека",
      "Питание: 5 раз в день, учёт аллергий и пищевых ограничений",
      "IT-программа, оборудование, материалы — включено",
      "Бассейн с ионизированной водой через день — включено"
    ]
  },
  {
    h2: "Как выглядит типичный день в лагере",
    text: "8:00 — подъём, завтрак. 9:30–11:00 — IT-занятие. 11:30–13:00 — командные активности. 13:30 — обед, тихий час. 16:00 — бассейн или спорт. 18:00 — ужин. 19:00–20:30 — вечернее IT-занятие или командная игра. 21:00 — фото в Telegram. 22:00 — отбой. Каждый день насыщен, времени скучать нет.",
    list: [
      "2 IT-занятия в день по 90 минут — утро и вечер",
      "Бассейн через день, спорт и активности ежедневно",
      "Вечерние события: квесты, настолки, командные игры",
      "Фото в Telegram каждый вечер — родители видят день ребёнка"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Люберцы 2026 — АйДаКемп"
  description="IT-лагерь рядом с Люберцами: ~110 км, ~1 ч 15 мин по Киевскому шоссе. Трансфер от м. Солнцево бесплатно. Python, AI, Minecraft для школьников 7–15 лет. От"
  h1="Летний лагерь рядом с Люберцами"
  canonical="https://aidacamp.ru/lager-lubertsy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Люберец до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Люберец до лагеря около 110 км. Маршрут: МКАД → Киевское шоссе, время в пути ~1 ч 15 мин. Бесплатный трансфер от м. Солнцево — добраться до метро из Люберец можно за 40 минут на электричке через Курский вокзал." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Люберец до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа 15 минут на машине по МКАД и Киевскому шоссе. Расстояние ~110 км. На трансфере от м. Солнцево — плюс время до метро (около 40 мин от Люберец)." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Люберец?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер отправляется от м. Солнцево. Из Люберец до Солнцево можно доехать на электричке через Курский вокзал за около 40 минут." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка в лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за смену 7 дней (10–16 июня). Смена 14 дней — 99 000 ₽. Август: 89 400 ₽ (13 дней) и 74 900 ₽ (10 дней). В стоимость входит проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — бесплатно." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Люберцами — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~110 км от Люберец. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-lubertsy"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь рядом с Люберцами"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~110 км из Люберец по Киевскому шоссе, ~1 ч 15 мин. Трансфер от м. Солнцево бесплатно."
    breadcrumb="Лагерь из Люберец"
    keywords={["~1 ч 15 мин из Люберец, трансфер от м. Солнцево бесплатно", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Летний лагерь рядом с Люберцами — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
