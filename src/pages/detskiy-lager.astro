---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_DISTANCE } from '../data/contacts';

const sections = [
  {
    h2: "Какой это детский лагерь",
    text: "АйДаКемп — загородный детский лагерь с IT-направлением в Подмосковье. Дети 7–15 лет живут в корпусах санатория «Изумруд», занимаются программированием, купаются в бассейне, играют в командные игры и в конце каждой смены защищают собственный проект на хакатоне. Это не просто «отдых» и не просто «учёба» — это место, где ребёнок взрослеет за 7–15 дней."
  },
  {
    h2: "Для детей какого возраста",
    text: "Лагерь принимает детей от 7 до 15 лет. Группы формируются по возрасту: 7–10, 10–12 и 13–15 лет. У каждой группы своя программа и свои преподаватели.",
    list: [
      "7–10 лет — Scratch, Minecraft, основы логики и алгоритмов",
      "10–12 лет — Python, создание игр и ботов",
      "13–15 лет — Python Advanced, AI, работа с API"
    ]
  },
  {
    h2: "Чем занимаются дети в лагере",
    text: "День в АйДаКемп устроен так: утром IT-занятия по программе, после обеда — бассейн, спорт, командные активности, вечером — работа над проектом. Смартфоны сданы на хранение: вместо них внутренняя валюта лагеря, которую зарабатывают за участие и помощь. Экранное время становится наградой, а не фоном.",
    list: [
      "Утро: IT-занятия в малых группах (до 8 человек)",
      "День: бассейн, спорт, активности на воздухе",
      "Вечер: проект, внутренняя экономика, свободное время",
      "Финал смены: хакатон — защита проекта перед всеми"
    ]
  },
  {
    h2: "Условия в детском лагере",
    text: "Лагерь работает на базе санатория «Изумруд» в Наро-Фоминском районе Московской области. Комнаты по 2–4 человека с санузлом, 5-разовое питание, бассейн с ионизированной водой, охраняемая территория. Медработник на смене круглосуточно. Работаем как лицензированный туроператор (РТО 025773)."
  },
  {
    h2: "Как выбирать детский лагерь — 7 критериев",
    text: "Первый детский лагерь — это всегда переживания «мой ли это случай». Чтобы не ошибиться, мы собрали чек-лист, которым сами пользовались как родители. Пройдитесь по нему: чем больше пунктов совпадает, тем спокойнее будет за ребёнка.",
    list: [
      "Лицензия туроператора — гарант того что не разовая «артельная» затея (у нас РТО 025773)",
      "Медик 24/7 на территории, а не в ближайшей деревне за 20 минут",
      "Охрана + закрытая территория + система пропусков на въезде",
      "Малые группы на занятиях (до 8 человек) — ребёнка видят и слышат, а не «растворяется в потоке»",
      "Результат, который можно «потрогать» — проект, сертификат, фотоотчёт, а не «дети отдыхали»",
      "Отзывы на Яндекс.Картах от других родителей (не с сайта лагеря, а независимые)",
      "Возврат средств в договоре на случай форс-мажора — минимум 50% за 3 дня до заезда"
    ]
  },
  {
    h2: "Чем детский лагерь отличается от оздоровительного санатория",
    text: "Родители часто путают эти форматы — оба «про отдых на природе», оба с питанием и проживанием. Но результат на выходе разный. Санаторий — это процедуры, рекомендации врача и расписание «подъём, завтрак, процедура, тихий час». Детский лагерь работает с другим: социализация, новые впечатления, навыки, дружба на всю жизнь. В АйДаКемп ребёнок за 10 дней проходит путь от незнакомца до члена команды: учится договариваться, брать на себя ответственность, доводить проект до защиты. Это невозможно оформить как «медицинскую услугу» — это опыт, который меняет человека."
  },
  {
    h2: "Как подготовить ребёнка к первому детскому лагерю",
    text: "За 2 недели до заезда начните разговоры о лагере в позитивном ключе: покажите фотоотчёты прошлых смен, обсудите что он возьмёт с собой, что будет делать в свободное время. Не обещайте «тебе там точно понравится» — ребёнок проверит это сам, а обещание создаст ожидания. Лучше говорить «там будут новые друзья, классные занятия и, наверное, что-то станет не по себе — это нормально».",
    list: [
      "Собрать вещи вместе с ребёнком по нашему списку — почувствует ответственность",
      "Пройти инструктаж по гаджетам: в АйДаКемп телефон сдаётся, но можно звонить в установленные окна",
      "Договориться о «секретном слове» — если по телефону произнесёт его, значит срочно нужна помощь",
      "Не проверять самочувствие ежедневными звонками — ребёнку сложнее отвлечься",
      "Написать короткое письмо «напоминание»: конверт в чемодан, откроет в первый вечер тоски"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/detskiy-lager.avif"
  title="Детский лагерь 2026 с IT-программой в Подмосковье — АйДаКемп"
  description="Детский летний лагерь в Подмосковье для детей 7–15 лет. IT-программирование, Python, AI, Minecraft. 66 км от Москвы, смены июнь–август 2026, от 48 000 ₽."
  h1="Детский лагерь для детей 7–15 лет"
  canonical="https://aidacamp.ru/detskiy-lager"
>
  <LandingHero slot="hero"
    h1="Детский лагерь для детей 7–15 лет"
    subtitle="Загородный лагерь в Подмосковье, где дети создают IT-проекты и учатся жить по правилам — без телефонов и без скуки."
    breadcrumb="Детский лагерь"
    keywords={["Для детей 7–15 лет, группы по возрасту", "IT-проект за каждую смену — не курс, а результат", `Подмосковье, ${STAT_DISTANCE} от Москвы, смены июнь–август`]}
    image="/images/hero/detskiy-lager.avif"
    imageAlt="Детский лагерь АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "Куда отправить ребёнка летом: разбор всех вариантов", url: "/stati/kuda-det-rebenka-letom", description: "Бабушка, лагерь, кружки — плюсы и минусы каждого варианта.", icon: "sun" },
    { title: "Детский лагерь без телефонов — что это и зачем", url: "/stati/detskiy-lager-bez-telefonov", description: "Как работает формат с экранным временем как внутренней валютой.", icon: "phone-vibrate" },
    { title: "Внутренняя экономика в лагере — зачем детям лагерные деньги", url: "/stati/vnutrennyaya-ekonomika-v-lagere", description: "Игровая экономика учит принимать решения и ценить время.", icon: "coin" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
