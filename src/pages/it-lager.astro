---
import { PRICE_MIN, PRICE_MAX, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import FAQSchema from '../components/FAQSchema.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`IT-лагерь для детей 7–15 лет в Подмосковье ${SEASON_YEAR} | АйДаКемп`}
  description={`Летний IT-лагерь (айти-лагерь) в Подмосковье и Москве для детей 7–15 лет. Любит компьютер? Превратим в проект — Python, Roblox, AI, Minecraft. Группы до 8 чел. От ${PRICE_MIN}.`}
  h1={`Летний IT-лагерь в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/it-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
      { q: "Нужен ли опыт программирования для IT-лагеря?", a: "Нет. Большинство ребят приезжают с нулевым опытом — это норма: кто никогда не писал код, попадает в группу для начинающих, кто уже пишет на Python — получает задачи сложнее. Те, кто никогда не видел код, начинают со Scratch или Roblox." },
      { q: "Можно ли ребёнку взять телефон в IT-лагерь?", a: "Смартфоны сдаются на хранение в первый день — вместо них игровая валюта лагеря, которую зарабатывают за участие и помощь другим. Накопленное можно потратить на экранное время. Работает удивительно хорошо: пролистывать чужие игры скучнее, когда пишешь свою." },
      { q: "Что если не понравится направление?", a: "Направление выбирается при записи. Если сомневаетесь, какой трек подойдёт по возрасту и уровню — напишите нам, разберёмся вместе ещё до заезда." },
      { q: `Сколько стоит IT-лагерь в Подмосковье ${SEASON_YEAR}?`, a: `От ${PRICE_MIN} за 10 дней до ${PRICE_MAX} за 13 дней. В цену включены проживание, питание (5 раз в день), IT-программа, оборудование, бассейн. Ноутбук не нужен. Налоговый вычет 13% — до ~${VYCHET_MAX} (максимум).` }
    ]} />
  </Fragment>

  <LandingHero slot="hero"
    h1={`Летний IT-лагерь в Подмосковье ${SEASON_YEAR}`}
    subtitle="Пусть играет — но в свою игру. Школьники 7–15 лет создают проекты: Roblox, Python, AI, Minecraft. 7 или 14 дней, Подмосковье, группы до 8 чел."
    breadcrumb="IT-лагерь"
    keywords={[
      "Группы до 8 школьников — преподаватель знает каждого",
      "Финальный хакатон: каждый защищает свой проект перед жюри",
      "66 км от МКАД, бассейн с ионизированной водой, питание 5 раз в день"
    ]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="IT-лагерь для детей АйДаКемп Подмосковье"
  />

  <!-- Featured snippet -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-blue-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="chto-takoe-it-lager">Что такое IT-лагерь?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>IT-лагерь</strong> — загородный лагерь с проживанием, где школьник совмещает отдых с реальной работой над IT-проектом.
      В отличие от кружка (1–2 часа в неделю), здесь полное погружение: 7 или 14 дней, занятия дважды в день,
      группы до 8 человек. В финале — хакатон: каждый защищает свой проект перед жюри.
    </p>
  </section>

  <div class="max-w-[1312px] mx-auto px-4">

    <!-- 1. Вступление от Дарьи -->
    <section class="max-w-3xl mx-auto py-10 md:py-14">
      <div class="flex items-start gap-4 p-6 bg-orange-50 rounded-[20px] border border-orange-100">
        <div class="shrink-0 w-12 h-12 rounded-full bg-primary flex items-center justify-center">
          <i class="bi bi-person-fill text-white text-[20px]" aria-hidden="true"></i>
        </div>
        <div>
          <p class="text-base font-semibold text-slate-900 mb-1">Дарья Афанасьева, основатель АйДаКемп</p>
          <p class="text-[16px] leading-[1.65] text-slate-700">
            «Моя дочь открывала Roblox сразу после завтрака. Я пробовала ограничивать — помогало на день-два, потом всё возвращалось.
            Тогда я нашла другой способ: место, где её любовь к игре превращается в умение эти игры создавать.
            Через неделю она звонила и объясняла, как написала собственный уровень на Lua.
            Не у всех детей такая история. Но если ваш тоже "живёт" в компьютере — я точно знаю, что с этим делать.»
          </p>
        </div>
      </div>
    </section>

    <!-- 2. Сравнительная таблица -->
    <section class="max-w-3xl mx-auto py-8">
      <h2 class="text-[26px] md:text-[36px] font-bold text-slate-900 leading-[1.15] tracking-[-0.02em] mb-2">
        Чем наш лагерь отличается от кружка
      </h2>
      <p class="text-[16px] text-slate-600 mb-6">
        Подробный разбор — в статье
        <a href="/stati/it-lager-vs-kruzhok/" class="text-primary underline underline-offset-2 hover:text-primary-700">«Чем IT-лагерь отличается от кружка»</a>.
        Коротко — таблица:
      </p>
      <div class="overflow-x-auto rounded-[14px] border border-slate-200">
        <table class="w-full text-base border-collapse">
          <thead>
            <tr class="bg-[#0d1a2b] text-white">
              <th class="text-left p-3 font-semibold">Параметр</th>
              <th class="text-left p-3 font-semibold">Кружок</th>
              <th class="text-left p-3 font-semibold">Обычный лагерь</th>
              <th class="text-left p-3 font-semibold text-[#ec9b44]">АйДаКемп</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white border-b border-slate-100">
              <td class="p-3 font-medium text-slate-900">Формат</td>
              <td class="p-3 text-slate-600">1–2 ч. в неделю</td>
              <td class="p-3 text-slate-600">2–4 недели, без IT</td>
              <td class="p-3 text-slate-800 font-medium">7–14 дней, IT + отдых</td>
            </tr>
            <tr class="bg-slate-50 border-b border-slate-100">
              <td class="p-3 font-medium text-slate-900">Группа</td>
              <td class="p-3 text-slate-600">10–20 человек</td>
              <td class="p-3 text-slate-600">20–40 человек</td>
              <td class="p-3 text-slate-800 font-medium">до 8 школьников</td>
            </tr>
            <tr class="bg-white border-b border-slate-100">
              <td class="p-3 font-medium text-slate-900">Что уносит домой</td>
              <td class="p-3 text-slate-600">Знания (теория)</td>
              <td class="p-3 text-slate-600">Воспоминания</td>
              <td class="p-3 text-slate-800 font-medium">Готовый проект + диплом</td>
            </tr>
            <tr class="bg-slate-50 border-b border-slate-100">
              <td class="p-3 font-medium text-slate-900">Публичная защита</td>
              <td class="p-3 text-slate-600">Редко</td>
              <td class="p-3 text-slate-600">Нет</td>
              <td class="p-3 text-slate-800 font-medium">Хакатон в финале смены</td>
            </tr>
            <tr class="bg-white">
              <td class="p-3 font-medium text-slate-900">Бассейн / отдых</td>
              <td class="p-3 text-slate-600">Нет</td>
              <td class="p-3 text-slate-600">Есть, без IT</td>
              <td class="p-3 text-slate-800 font-medium">Каждый день</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Направления (карточки) -->
    <section class="py-10 md:py-14">
      <h2 class="text-[26px] md:text-[36px] font-bold text-slate-900 leading-[1.15] tracking-[-0.02em] mb-2 max-w-3xl mx-auto">
        Направления смены
      </h2>
      <p class="text-[16px] text-slate-600 mb-8 max-w-3xl mx-auto">
        Шесть тематических треков — выбирается при записи по возрасту и интересам.
        Подробнее про программирование — <a href="/it-camp/" class="text-primary underline underline-offset-2 hover:text-primary-700">смена по программированию</a>.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">

        <a href="/python-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-code-slash text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">Python</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">Боты, игры, работа с API. 10–15 лет. За 14 дней — рабочий Telegram-бот с AI.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

        <a href="/minecraft-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-controller text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">Minecraft</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">Моды, Python-скрипты, своя карта. 8–12 лет. Идеально для тех, кто уже играет.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

        <a href="/roblox-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-controller text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">Roblox</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">Roblox Studio + Lua, 3D-игра с нуля. 9–13 лет. Для тех, кто сидит в Roblox часами.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

        <a href="/scratch-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-blocks text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">Scratch</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">Первая игра без кода. 7–10 лет. За 7 дней — своя анимированная история.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

        <a href="/3d-modelirovanie-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-box text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">3D-моделирование</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">Blender, 3D-печать. 10–14 лет. Уходит домой с физическим сувениром.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

        <a href="/ai-lager/" class="card-shadow rounded-[14px] border border-slate-100 bg-white p-5 hover:border-primary/30 transition-colors group">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-[10px] bg-orange-50 flex items-center justify-center shrink-0">
              <i class="bi bi-cpu text-primary text-[20px]" aria-hidden="true"></i>
            </span>
            <h3 class="text-[18px] font-bold text-slate-900">AI и нейросети</h3>
          </div>
          <p class="text-base text-slate-600 leading-[1.5]">ChatGPT API, Gemini, генерация. 11–15 лет. Для тех, кто уже слышал про AI и хочет его использовать.</p>
          <span class="mt-3 inline-flex items-center gap-1 text-base text-primary font-medium group-hover:gap-2 transition-all">
            Подробнее <i class="bi bi-arrow-right text-[12px]" aria-hidden="true"></i>
          </span>
        </a>

      </div>
    </section>

    <!-- 4. Один день в IT-лагере -->
    <section class="max-w-3xl mx-auto py-10 md:py-12">
      <h2 class="text-[26px] md:text-[36px] font-bold text-slate-900 leading-[1.15] tracking-[-0.02em] mb-2">
        Один день в лагере
      </h2>
      <p class="text-[16px] text-slate-600 mb-6">
        Мамы часто спрашивают: «А они там весь день за компьютером?» Нет — занятия по программированию занимают утро и вечер.
        Середина дня — бассейн, спорт, прогулки.
      </p>
      <div class="space-y-3">
        <div class="flex items-start gap-3 p-4 bg-white rounded-[14px] border border-slate-100 card-shadow">
          <span class="shrink-0 text-[12px] font-bold text-primary bg-orange-50 rounded-[8px] px-2 py-1 mt-0.5 min-w-[56px] text-center">09:00</span>
          <div>
            <p class="text-[16px] font-semibold text-slate-900">Первый блок — 90 минут</p>
            <p class="text-base text-slate-600 mt-0.5">Пишем, а не слушаем лекции. У каждого свой проект, преподаватель рядом — подсказывает, не диктует.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-[14px] border border-slate-100 card-shadow">
          <span class="shrink-0 text-[12px] font-bold text-primary bg-orange-50 rounded-[8px] px-2 py-1 mt-0.5 min-w-[56px] text-center">11:00</span>
          <div>
            <p class="text-[16px] font-semibold text-slate-900">Второй блок — 90 минут</p>
            <p class="text-base text-slate-600 mt-0.5">Продолжение проекта. Между блоками — перекус и прогулка на улице.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-[14px] border border-slate-100 card-shadow">
          <span class="shrink-0 text-[12px] font-bold text-slate-500 bg-slate-50 rounded-[8px] px-2 py-1 mt-0.5 min-w-[56px] text-center">14:00</span>
          <div>
            <p class="text-[16px] font-semibold text-slate-900">Бассейн, спорт, командные игры</p>
            <p class="text-base text-slate-600 mt-0.5">3 часа активностей: бассейн с ионизированной водой, спортплощадка, квесты, командные игры.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-[14px] border border-slate-100 card-shadow">
          <span class="shrink-0 text-[12px] font-bold text-primary bg-orange-50 rounded-[8px] px-2 py-1 mt-0.5 min-w-[56px] text-center">18:00</span>
          <div>
            <p class="text-[16px] font-semibold text-slate-900">Работа над финальным проектом</p>
            <p class="text-base text-slate-600 mt-0.5">В группе доделываем, тестируем, готовим питч. Это самое важное: проект становится «своим».</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-[14px] border border-slate-100 card-shadow">
          <span class="shrink-0 text-[12px] font-bold text-slate-500 bg-slate-50 rounded-[8px] px-2 py-1 mt-0.5 min-w-[56px] text-center">20:00</span>
          <div>
            <p class="text-[16px] font-semibold text-slate-900">Вечерняя программа</p>
            <p class="text-base text-slate-600 mt-0.5">Квесты, кино, настолки, костёр. Отбой — 22:00.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Для кого подходит -->
    <section class="py-10 md:py-12">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="rounded-[20px] bg-green-50 border border-green-100 p-6">
          <h2 class="text-[22px] font-bold text-slate-900 mb-4 flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-green-600 text-[20px]" aria-hidden="true"></i>
            Для кого лагерь подходит
          </h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-check-lg text-green-600 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Возраст 7–15 лет — программа подбирается под каждую возрастную группу</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-check-lg text-green-600 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>С нуля — ОК. Кто никогда не писал код, попадёт в группу для начинающих</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-check-lg text-green-600 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Уже пишет на Python? Получит задачи сложнее — скучать не придётся</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-check-lg text-green-600 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Любит Minecraft, Roblox, игры — именно для таких придуманы эти треки</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-check-lg text-green-600 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Первый раз без родителей — небольшой лагерь, все знают всех по имени</span>
            </li>
          </ul>
        </div>
        <div class="rounded-[20px] bg-slate-50 border border-slate-200 p-6">
          <h2 class="text-[22px] font-bold text-slate-900 mb-4 flex items-center gap-2">
            <i class="bi bi-dash-circle text-slate-500 text-[20px]" aria-hidden="true"></i>
            Когда стоит подождать
          </h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-dash-lg text-slate-400 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>До 7 лет — маленьким будет сложно без мамы на 7+ дней</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-dash-lg text-slate-400 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Если ждёте результат за 1–2 дня — за 7 дней реалистичен первый проект, не профессия</span>
            </li>
            <li class="flex items-start gap-2 text-[16px] text-slate-700">
              <i class="bi bi-dash-lg text-slate-400 mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>Если хочет только играть, а не создавать — у нас работа над проектом каждый день</span>
            </li>
          </ul>
          <p class="mt-4 text-base text-slate-500">Не знаете, подходит ли возраст или уровень? Напишите — разберёмся вместе.</p>
        </div>
      </div>
    </section>

    <!-- 6. Безопасность, питание, территория -->
