---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import LeadForm from '../components/LeadForm.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { CAMP_PRICE_FROM } from '../data/contacts';

const sections = [
  {
    h2: "Как купить путёвку в детский лагерь АйДаКемп",
    text: "Процесс простой: оставьте заявку на сайте, менеджер свяжется в течение 10 минут (в рабочее время 11–20 МСК) и ответит на все вопросы. После выбора смены подписываем договор — оферта публична, никаких устных обещаний. Оплата по договору, квитанция и путёвка — официальные документы. Трансфер из Москвы — платная опция, уточняйте при бронировании.",
    list: [
      "Оставьте заявку — ответим за 10 минут",
      "Выберите смену и возраст ребёнка",
      "Подпишем договор и выставим счёт",
      "Получите путёвку и документы"
    ]
  },
  {
    h2: "Стоимость путёвок в лагерь на лето 2026",
    text: "Стоимость путёвки зависит от продолжительности смены. В цену включены проживание в санатории «Изумруд» (Наро-Фоминский район), 5-разовое питание, полная IT-программа (Python, AI, Minecraft), спортивные активности и бассейн. Трансфер — отдельно.",
    list: [
      "Смена 2.1 — 7 дней, 10–16 июня — от 48 000 ₽",
      "Смена 1 — 10 дней, 30 мая–8 июня — 74 900 ₽",
      "Смена 2.2 — 8 дней, 16–23 июня — 65 000 ₽",
      "Смена 3 — 13 дней, 3–15 августа — 89 400 ₽",
      "Смена 4 — 10 дней, 17–26 августа — 69 600 ₽",
      "Смена 2 — 14 дней, 10–23 июня — 95 000 ₽ (самая популярная)"
    ]
  },
  {
    h2: "Что входит в путёвку",
    text: "Путёвка в АйДаКемп — это не просто место в лагере. Ребёнок уедет с готовым IT-проектом, который он создал сам и защитил на итоговом хакатоне. Программу ведут преподаватели-практики, авторы книги по Python для детей (тираж 2 000 экз.).",
    list: [
      "Проживание 2–4 человека в комнате с санузлом",
      "5-разовое питание, учёт аллергий",
      "Полная IT-программа: Python, AI, Minecraft, веб-дизайн",
      "Бассейн с ионизированной водой, спортплощадки",
      "Охрана 24/7, медработник на территории",
      "Ежедневные фото и новости в родительском канале",
      "Итоговый хакатон и готовый проект"
    ]
  },
  {
    h2: "Гарантии при покупке путёвки",
    text: "АйДаКемп — лицензированный туроператор (РТО 025773), ООО «ВОИП КОННЕКТ», ИНН 7729713637. Работаем официально с 2019 года, более 1 200 детей прошли через наш лагерь. Если ребёнку не понравится в первые 3 дня — вернём 50% стоимости путёвки без вопросов.",
    list: [
      "Договор оферты — публичный, никаких устных условий",
      "Образовательная лицензия Л035-01298-77/01082973",
      "Реестр туроператоров РТО 025773",
      "Страхование детей включено",
      "Возврат 50% за первые 3 дня — гарантия качества",
      "Фиксация цены на 72 часа после заявки"
    ]
  },
  {
    h2: "Способы оплаты путёвки в лагерь",
    text: "Мы работаем как официальное ООО, и все платежи — прозрачные. Никаких наличных переводов на личную карту, никаких «договор мы подпишем потом». Что мы принимаем:",
    list: [
      "Банковская карта онлайн — через платёжный шлюз Т-Бизнес или Сбербанк Эквайринг",
      "Перевод по реквизитам — счёт на юрлицо или ИП, если оплачивает работодатель",
      "Рассрочка 3-6 месяцев — без переплат, через банк-партнёр (оформление 10 минут)",
      "Оплата с материнского капитала — путёвка квалифицируется как образовательная услуга",
      "Оплата частями — первый взнос 30% при бронировании, остаток за 14 дней до заезда",
      "Корпоративная оплата от работодателя — мы выставляем счёт-фактуру + акт"
    ]
  },
  {
    h2: "Как получить налоговый вычет 13% за путёвку",
    text: "Путёвка в АйДаКемп квалифицируется как «оплата обучения ребёнка» — значит её можно частично вернуть через налоговый вычет. Максимум 14 300 ₽ за одного ребёнка в год (13% от лимита 110 000 ₽).",
    list: [
      "Мы выдаём пакет документов после оплаты: договор + платёжка + образовательная лицензия + акт",
      "Заполните декларацию 3-НДФЛ через личный кабинет на nalog.ru — 15-20 минут",
      "Приложите отсканированные документы в декларацию",
      "Проверка ФНС до 3 месяцев, деньги приходят в течение месяца после одобрения",
      "Или проще: попросите работодателя оформить вычет у себя — возврат пойдёт через зарплату с ближайшего месяца"
    ]
  },
  {
    h2: "Что делать если вы хотите подарить путёвку",
    text: "Путёвка в АйДаКемп — хороший подарок для ребёнка знакомых или родственников на день рождения, Новый год, 1 сентября. Мы это оформляем красиво:",
    list: [
      "Персонализированный сертификат на имя ребёнка, с датой смены",
      "Подарочная упаковка — коробка с сувенирами (блокнот, футболка, стикерпак АйДаКемп)",
      "Видеообращение от Дарьи (основателя лагеря) — «с нетерпением ждём тебя в смене»",
      "Возможность оплатить в 2 этапа: 30% при оформлении, 70% в течение 30 дней",
      "Гибкий трансфер — если дата смены не подошла, меняем на другую без доплат"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/kupit-putevku-v-lager.avif"
  title="Купить путёвку в детский лагерь 2026 — от 48 000 ₽ | АйДаКемп"
  description="Купить путёвку в IT-лагерь для детей 7–14 лет. Подмосковье, 66 км от Москвы. Смены лето 2026 от 48 000 ₽. Договор, лицензия туроператора, возврат 50% за 3 дня."
  h1="Купить путёвку в детский лагерь 2026"
  canonical="https://aidacamp.ru/kupit-putevku-v-lager"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/"},
        {"@type": "ListItem", "position": 2, "name": "Купить путёвку в лагерь"}
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Купить путёвку в детский лагерь 2026"
    subtitle={`IT-лагерь АйДаКемп, Подмосковье. Путёвки для детей 7–14 лет на лето 2026. От ${CAMP_PRICE_FROM} за 7 дней. Договор, страховка, лицензия туроператора РТО 025773.`}
    breadcrumb="Купить путёвку"
    keywords={["Официальный договор и лицензированный туроператор РТО 025773", "Возврат 50% стоимости путёвки если не понравится в первые 3 дня", "Фиксация цены на 72 часа после заявки — без скрытых доплат"]}
    image="/images/hero/kupit-putevku-v-lager.avif"
    imageAlt="Купить путёвку в детский лагерь 2026"
  />
  <LandingTwoCol sections={sections} />
  <TaxCalculator variant="compact" title="Рассчитайте свой налоговый вычет 13%" />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <LeadForm variant="mobile" />
  </section>
</LandingLayout>
