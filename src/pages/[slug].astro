---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { allLandings } from '../data/landings/index';
import type { LandingData } from '../data/landings/types';

export function getStaticPaths() {
  return allLandings.map((l) => ({
    params: { slug: l.slug },
    props: l,
  }));
}

const landing = Astro.props as LandingData;
---

<LandingLayout
  heroImage={landing.heroImage}
  title={landing.title}
  description={landing.description}
  h1={landing.h1}
  canonical={landing.canonical}
>
  <Fragment slot="head">
    <FAQSchema items={landing.faqItems} />
    <CourseSchema
      name={landing.courseSchema.name}
      description={landing.courseSchema.description}
      url={landing.canonical}
      ageMin={7}
      ageMax={15}
    />
    {landing.educationEvent && (
      <script type="application/ld+json" set:html={JSON.stringify(landing.educationEvent)} />
    )}
  </Fragment>
  <LandingHero slot="hero"
    h1={landing.h1}
    subtitle={landing.hero.subtitle}
    breadcrumb={landing.hero.breadcrumb}
    keywords={landing.hero.keywords}
    image={landing.heroImage}
    imageAlt={landing.hero.imageAlt}
  />
  <LandingTwoCol sections={landing.sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-base text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>{landing.relatedCities && landing.relatedCities.length > 0 && (<><br />Соседние города:{' '}{landing.relatedCities.map((l, i) => <>{i > 0 && ' — '}<a href={l.href} class="text-primary hover:underline">{l.text}</a></>)}</>)}
    </p>
    {landing.seeAlso && !landing.seeAlso.asBlock && (
      <p class="mt-3 text-base text-slate-500">
        {landing.seeAlso.label}:{' '}{landing.seeAlso.links.map((l, i) => <>{i > 0 && (landing.seeAlso!.separator ?? ' — ')}<a href={l.href} class="text-primary hover:underline">{l.text}</a></>)}
      </p>
    )}
  </div>
  {landing.seeAlso?.asBlock && (
    <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
      <p class="text-base text-slate-500">
        {landing.seeAlso.label}:{' '}{landing.seeAlso.links.map((l, i) => <>{i > 0 && (landing.seeAlso!.separator ?? ' — ')}<a href={l.href} class="text-primary hover:underline">{l.text}</a></>)}
      </p>
    </div>
  )}
  {landing.internalLinksSection && (
    <section class="internal-links-block" style="background: #f8f9fa; padding: 24px; border-radius: 8px; margin: 32px 0; border-left: 4px solid #0066cc;">
      <h3 style="margin-top: 0; font-size: 18px; color: #1a1a1a;">{landing.internalLinksSection.title}</h3>
      <p style="color: #555; line-height: 1.6; margin: 12px 0 16px;">{landing.internalLinksSection.intro}</p>
      <ul style="list-style: none; padding: 0; margin: 0;">
        {landing.internalLinksSection.links.map((link, i) => (
          <li style={i < landing.internalLinksSection!.links.length - 1 ? 'margin-bottom: 8px;' : 'margin-bottom: 0;'}>
            <a href={link.href} style="color: #0066cc; text-decoration: none; font-weight: 500;">{link.label}</a> — {link.description}
          </li>
        ))}
      </ul>
    </section>
  )}
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
