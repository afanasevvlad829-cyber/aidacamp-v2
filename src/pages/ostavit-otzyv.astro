---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Оставить отзыв об АйДаКемп — Яндекс.Карты, Google, 2GIS"
  description="Поделитесь впечатлениями о детском IT-лагере АйДаКемп. Ссылки на Яндекс.Карты, Google Maps, 2GIS — 1 минута."
>
  <Header />
  <main class="pb-16 md:pb-0">
    <section class="mx-auto max-w-[720px] px-4 pt-10 pb-16">

      <!-- Хлебные крошки -->
      <nav class="mb-6 text-[13px] text-slate-400">
        <a href="/" class="hover:text-orange-600">Главная</a>
        <span class="mx-1.5">/</span>
        <span class="text-slate-600">Оставить отзыв</span>
      </nav>

      <h1 class="text-[28px] md:text-[36px] font-bold leading-[1.15] tracking-[-0.02em] text-slate-900">
        Поделитесь впечатлениями
      </h1>
      <p class="mt-3 text-[16px] text-slate-500 leading-[1.6]">
        Если ваш ребёнок побывал в АйДаКемп — ваш отзыв помогает другим родителям принять решение.
        Это 2–3 минуты и огромная помощь для нас.
      </p>

      <!-- Основная площадка -->
      <div class="mt-8 rounded-[20px] border-2 border-orange-200 bg-orange-50 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[14px] bg-orange-500 text-white">
            <i class="bi bi-star-fill text-[22px]" aria-hidden="true"></i>
          </div>
          <div class="flex-1">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-orange-600">Главная площадка</p>
            <h2 class="mt-0.5 text-[20px] font-bold text-slate-900">Яндекс.Карты</h2>
            <p class="mt-1 text-[14px] text-slate-500">5.0 ★ · более 40 отзывов · влияет на позицию в Яндексе</p>
            <a href="https://yandex.ru/maps/org/aydakemp/35558479035/reviews/?add-review=true"
              target="_blank" rel="noopener"
              class="mt-4 inline-flex items-center gap-2 rounded-full bg-orange-500 hover:bg-orange-600 px-5 py-2.5 text-[15px] font-semibold text-white transition-colors"
              onclick="window.trackGoal?.('review_yandex_maps_click')">
              <i class="bi bi-pencil-fill text-[13px]" aria-hidden="true"></i>
              Написать отзыв
            </a>
          </div>
        </div>
      </div>

      <!-- Другие площадки -->
      <div class="mt-4 grid gap-3 sm:grid-cols-2">

        <a href="https://2gis.ru/moscow/firm/70000001072416487/tab/reviews"
          target="_blank" rel="noopener"
          class="group flex items-center gap-4 rounded-[16px] border border-slate-200 bg-white p-4 hover:border-orange-200 hover:bg-orange-50/50 transition-colors"
          onclick="window.trackGoal?.('review_2gis_click')">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-green-100 text-green-700">
            <i class="bi bi-geo-alt-fill text-[18px]" aria-hidden="true"></i>
          </div>
          <div>
            <p class="text-[15px] font-semibold text-slate-900 group-hover:text-orange-700">2GIS</p>
            <p class="text-[13px] text-slate-500">Популярен в МО и регионах</p>
          </div>
          <i class="bi bi-arrow-right ml-auto text-slate-300 group-hover:text-orange-400 transition-colors" aria-hidden="true"></i>
        </a>

        <a href="https://maps.google.com/?cid=35558479035"
          target="_blank" rel="noopener"
          class="group flex items-center gap-4 rounded-[16px] border border-slate-200 bg-white p-4 hover:border-orange-200 hover:bg-orange-50/50 transition-colors"
          onclick="window.trackGoal?.('review_google_click')">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-blue-100 text-blue-700">
            <i class="bi bi-globe text-[18px]" aria-hidden="true"></i>
          </div>
          <div>
            <p class="text-[15px] font-semibold text-slate-900 group-hover:text-orange-700">Google Maps</p>
            <p class="text-[13px] text-slate-500">Для Google-органики</p>
          </div>
          <i class="bi bi-arrow-right ml-auto text-slate-300 group-hover:text-orange-400 transition-colors" aria-hidden="true"></i>
        </a>

        <a href="https://otzovik.com/reviews/it-lager_aydakemp/"
          target="_blank" rel="noopener"
          class="group flex items-center gap-4 rounded-[16px] border border-slate-200 bg-white p-4 hover:border-orange-200 hover:bg-orange-50/50 transition-colors"
          onclick="window.trackGoal?.('review_otzovik_click')">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-purple-100 text-purple-700">
            <i class="bi bi-chat-quote-fill text-[18px]" aria-hidden="true"></i>
          </div>
          <div>
            <p class="text-[15px] font-semibold text-slate-900 group-hover:text-orange-700">Otzovik</p>
            <p class="text-[13px] text-slate-500">Индексируется в поиске</p>
          </div>
          <i class="bi bi-arrow-right ml-auto text-slate-300 group-hover:text-orange-400 transition-colors" aria-hidden="true"></i>
        </a>

        <a href="https://zoon.ru/moscow/clubs/aydakemp/"
          target="_blank" rel="noopener"
          class="group flex items-center gap-4 rounded-[16px] border border-slate-200 bg-white p-4 hover:border-orange-200 hover:bg-orange-50/50 transition-colors"
          onclick="window.trackGoal?.('review_zoon_click')">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-yellow-100 text-yellow-700">
            <i class="bi bi-award-fill text-[18px]" aria-hidden="true"></i>
          </div>
          <div>
            <p class="text-[15px] font-semibold text-slate-900 group-hover:text-orange-700">Zoon</p>
            <p class="text-[13px] text-slate-500">Дополнительное доверие</p>
          </div>
          <i class="bi bi-arrow-right ml-auto text-slate-300 group-hover:text-orange-400 transition-colors" aria-hidden="true"></i>
        </a>

      </div>

      <!-- Подсказки для написания -->
      <div class="mt-8 rounded-[16px] bg-slate-50 border border-slate-200 p-5">
        <h3 class="text-[15px] font-semibold text-slate-900">
          <i class="bi bi-lightbulb-fill text-orange-500 mr-1.5" aria-hidden="true"></i>
          О чём написать?
        </h3>
        <ul class="mt-3 space-y-2 text-[14px] text-slate-600">
          <li class="flex gap-2"><i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>Возраст ребёнка и смена (месяц)</li>
          <li class="flex gap-2"><i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>Что понравилось больше всего</li>
          <li class="flex gap-2"><i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>Что сделал ребёнок за смену (проект, программа)</li>
          <li class="flex gap-2"><i class="bi bi-check-lg text-orange-500 shrink-0 mt-0.5" aria-hidden="true"></i>Поедет ли снова?</li>
        </ul>
      </div>

      <!-- Благодарность -->
      <div class="mt-6 text-center">
        <p class="text-[14px] text-slate-400">
          Спасибо! За каждый отзыв мы благодарны лично. Если есть вопросы — пишите в
          <a href="https://wa.me/74951284429" class="text-orange-600 hover:underline">WhatsApp</a>.
        </p>
      </div>

    </section>
  </main>
  <Footer />
</Base>
