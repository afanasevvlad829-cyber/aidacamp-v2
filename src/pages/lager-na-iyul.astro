---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "IT-лагерь в июле — тот же формат, новые проекты",
    text: "В июле в <a href='/detskiy-lager'>АйДаКемп</a> — та же атмосфера, что и в июне: занятия каждое утро, бассейн, лес, вечерние командные игры. Программирование не останавливается на каникулах. Для тех, кто был в <a href='/lager-na-iyun'>июне</a> и хочет приехать второй раз — программа идёт дальше: меняется тема, меняется задача, добавляется сложность. Ребёнок не повторяет пройденное, он строит на фундаменте.",
    list: [
      "Python-проекты следующего уровня — работа с API, базы данных, интерфейс",
      "Minecraft Education — новые механики, командная постройка, финальная защита",
      "AI-треки — нейросеть в браузере, генерация и анализ данных",
      "Scratch (7–10 лет) — анимация, квест, интерактивная история",
      "Второй заезд возможен — программа не повторяется"
    ]
  },
  {
    h2: "Направления которые ждут летом",
    text: "В каждой смене несколько параллельных треков — ребёнок сам выбирает что ему интереснее, или мы помогаем подобрать на старте по уровню и возрасту. Подробнее о программах: <a href='/python-lager'>Python</a>, <a href='/scratch-lager'>Scratch</a>, <a href='/minecraft-lager'>Minecraft</a>, <a href='/roblox-lager'>Roblox</a>, <a href='/3d-modelirovanie-lager'>3D-моделирование</a>.",
    list: [
      "Python (10–15 лет) — от новичка до уверенного разработчика",
      "Scratch и визуальное программирование (7–10 лет)",
      "Minecraft Education — моды, карты, логика",
      "3D-моделирование — Blender, печать модели",
      "AI и нейросети (12–15 лет) — работа с API, обучение моделей",
      "Roblox Studio — создание 3D-игры на Lua"
    ]
  },
  {
    h2: "Почему некоторые семьи выбирают именно июль",
    text: "У каждой семьи свой сценарий. Одни берут июль потому что в июне у папы работа, а отпуск — только в июле, и хочется отвезти лично. Другие — потому что старший едет в языковой лагерь в июне, а младший тогда же к бабушке, а для июльских уже свободен. Третьи берут лагерь как финальный аккорд лета перед школой — ребёнок возвращается заряженным, а не убитым телефоном. Все варианты рабочие.",
    list: [
      "Отпуск родителей совпадает с июлем — привезти и забрать лично",
      "Две смены лета — июнь и потом август, июль — тихий семейный месяц",
      "Хочется финала лета с проектом, а не с ощущением «всё прошло мимо»",
      "В июне ребёнок занят другим — лагерем, секцией, поездкой",
      "Июль как «второй шанс» для тех, кто не успел забронировать июнь"
    ]
  },
  {
    h2: "Июль или август — в чём разница для ребёнка",
    text: "Честно: по программе разницы почти нет. Преподаватели те же, формат тот же, проекты такие же настоящие. Разница — в ощущениях. В июле лето ещё впереди, ребёнок едет без груза «скоро школа». В августе — другое настроение, более сосредоточенное, кто-то воспринимает как последний шанс успеть что-то сделать перед учёбой. Обе смены хороши по-своему. <a href='/lager-na-avgust-podmoskove'>Августовские смены</a> — уже открыты для записи.",
    list: [
      "Смена 3: 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней, 69 600 ₽",
      "В августе дети чуть собраннее — чувствуется «конец лета», работают серьёзнее",
      "В июле атмосфера легче и расслабленнее — хорошо для тех, кто едет впервые"
    ]
  },
  {
    h2: "Как узнать точные даты июльских смен",
    text: "Сейчас в расписании — смены в конце мая, июне и августе. Июльские смены анонсируем дополнительно: расписание обновляется, и если июль принципиален — лучший способ не пропустить открытие записи — оставить заявку прямо сейчас. Позвоним, как только появятся даты. Ничего не теряете: заявка без обязательств, без предоплаты.",
    list: [
      "Оставьте заявку — перезвоним при появлении июльских дат",
      "Или рассмотрите смены конца июня (10–23 июня) и начала августа (3–15 августа)",
      "Смена в конце июня частично захватывает июль — хорошая альтернатива",
      "При бронировании цена фиксируется — не нужно ждать до последнего"
    ]
  },
  {
    h2: "Что говорят мамы, которые отправляли детей летом",
    text: "Виктория отправляла дочку несколько раз: «Первый раз всю смену ждала жалоб — на еду, на соседей по комнате. Жалоб не было. Зато было голосовое в час ночи: мам, мы в мафию играли, я победила. Программирование там подают как-то так, что не скучно — дочка вернулась с проектом и реально гордилась. Едем уже третий раз, я даже не уточняю подробности — просто бронирую.» Надежда отправила сына в 9 лет: «Звоню в середине смены — всё хорошо, мам, не мешай, мы тут делаем кое-что. Приехал — первым делом тащит ноутбук, показывает игру которую почти сам написал. Объяснял минут сорок без остановки, с горящими глазами.» Мария отправляла двоих — 10 и 14 лет: «Страшно было отправлять сразу двоих. Не угадала — старший сам следил как у сестры дела, познакомил со своими из отряда. Такого поворота точно не планировала.»"
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-iyul.avif"
  title="Лагерь на июль 2026 для детей в Подмосковье — АйДаКемп"
  description="Детский IT-лагерь в июле 2026 в Подмосковье. Python, AI, Minecraft. 66 км от Москвы, от 48 000 ₽. Оставь заявку — места ограничены."
  h1="Лагерь на июль 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-iyul"
>
  <LandingHero slot="hero"
    h1="Лагерь на июль 2026 в Подмосковье"
    subtitle="IT-лагерь с программированием, AI и Minecraft. Июльские смены объявим скоро — оставьте заявку и узнаете первыми. 66 км от Москвы."
    breadcrumb="Лагерь на июль"
    keywords={["Python, Minecraft, AI — проект за смену", "Есть смены конца июня и начала августа", "Оставьте заявку — сообщим о датах"]}
    image="/images/hero/lager-na-iyul.avif"
    imageAlt="Детский IT-лагерь на июль в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
