---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Смены в июле 2026 — конкретные даты",
    text: "В <a href='/detskiy-lager'>АйДаКемп</a> в июле 2026 работают две смены. Смена 2 (1–14 июля, 14 дней, 95 000 ₽) — флагман сезона: самая длинная, самая популярная, места разбирают первыми ещё в марте-апреле. Смена 3 (20 июля – 1 августа, 13 дней, 89 400 ₽) — для тех, кто только вышел из отпуска или хочет «закрыть лето» с результатом перед школой. Обе смены — полноценные, с реальным IT-проектом в финале.",
    list: [
      "Смена 2: 1–14 июля 2026, 14 дней, 95 000 ₽ — максимальный налоговый вычет 5 434 ₽",
      "Смена 3: 20 июля – 1 августа 2026, 13 дней, 89 400 ₽ — вычет ~5 200 ₽",
      "Предоплата 10 000 ₽ фиксирует место и цену",
      "Июльские смены разбирают первыми — рекомендуем бронировать до конца мая"
    ]
  },
  {
    h2: "Почему июль — пик сезона",
    text: "Июль — самый жаркий и самый насыщенный месяц. Дети уже выспались после школы, нет зажатости первых дней каникул. Родители в отпуске — удобно отвезти и забрать лично. Июльская 14-дневная смена даёт максимум по всем параметрам: дети успевают полностью погрузиться в проект, сдружиться в отряде, пройти весь путь от идеи до финальной защиты. Именно поэтому смена 2 (1–14 июля) — флагман лета: её бронируют первой и с самого начала года.",
    list: [
      "Самый жаркий месяц — бассейн каждый день, комфортная температура для улицы",
      "Дети выспались после школы — максимальная включённость и энергия",
      "Родители в отпуске — удобно отвезти/забрать, навестить в середине смены",
      "14 дней — достаточно, чтобы пройти весь путь от идеи до реального проекта",
      "Самая популярная смена года — места заканчиваются первыми"
    ]
  },
  {
    h2: "Особенности июльской программы",
    text: "В июле программа идёт на полную: бассейн каждый день, вечерние мероприятия на улице, творческие мастерские, спорт. IT-занятия утром по 3–4 часа в группах до 8 человек — после обеда ребята переключаются на активности. Для тех, кто приехал во второй раз — программа продолжается с того места, где закончилась в июне: новый уровень, новая задача, новые ребята. Повторного материала нет.",
    list: [
      "Бассейн ежедневно — вода прогрета до комфортной температуры",
      "Вечерние квесты, командные игры, хакатон на улице",
      "IT-занятия утром: Python, AI, Minecraft, Scratch, 3D, Roblox",
      "Творческие мастерские во второй половине дня",
      "Второй заезд — программа не повторяется, идёт вперёд"
    ]
  },
  {
    h2: "Налоговый вычет за июльскую смену — максимум 5 434 ₽",
    text: "Июльская 14-дневная смена (1–14 июля, 95 000 ₽) даёт максимальный налоговый вычет среди всех наших смен — 5 434 ₽. Это 13% от образовательной части путёвки. Вычет оформляется через налоговую декларацию или работодателя — <a href='/nalogovyj-vychet'>читай инструкцию и считай свою сумму на калькуляторе</a>. Смена 3 (13 дней, 89 400 ₽) даёт ~5 200 ₽. Документы для вычета выдаём при оплате.",
    list: [
      "Смена 2 (14 дней) → вычет 5 434 ₽ — максимум из всех смен 2026",
      "Смена 3 (13 дней) → вычет ~5 200 ₽",
      "Документы для вычета выдаём при оплате путёвки",
      "Оформить через декларацию или через работодателя — оба способа работают",
      "Подробно: <a href='/nalogovyj-vychet'>налоговый вычет за лагерь — пошаговая инструкция</a>"
    ]
  },
  {
    h2: "Можно ли взять две смены подряд — июнь и июль",
    text: "Да, и это популярная история. Например: смена 2.1 (10–16 июня) + смена 2 (1–14 июля) — с перерывом ~2 недели дома. Или смена 2 (июнь) + смена 2 (июль) — в июльской программа идёт дальше, не повторяется. Некоторые семьи берут три смены за лето — это не «три раза одно и то же», а три шага вперёд по одному направлению. Ребёнок уже знает людей, знает место, и сразу погружается в работу без адаптации.",
    list: [
      "Июнь + июль — популярная комбинация, программа не повторяется",
      "Между сменами — 1–2 недели дома: отдохнуть, показать родным проект",
      "При повторном заезде — ребёнок адаптируется в первый же день, без раскачки",
      "Три смены за лето: каждая — следующий уровень сложности",
      "Скидки за несколько смен — уточняйте при бронировании"
    ]
  },
  {
    h2: "IT-программы в июльских сменах",
    text: "Выбор направления — при записи. Помогаем подобрать по возрасту и уровню, если не знаете с чего начать. Подробнее о каждом направлении: <a href='/python-lager'>Python</a>, <a href='/scratch-lager'>Scratch</a>, <a href='/minecraft-lager'>Minecraft</a>, <a href='/roblox-lager'>Roblox</a>, <a href='/3d-modelirovanie-lager'>3D-моделирование</a>.",
    list: [
      "Python (10–15 лет) — Telegram-боты, игры, работа с API, базы данных",
      "Scratch и визуальное программирование (7–10 лет) — первая игра или интерактивная история",
      "Minecraft Education — моды, карты, логика и программирование внутри игры",
      "AI и нейросети (12–15 лет) — подключение API нейросети, генерация, анализ данных",
      "Roblox Studio — создание 3D-игры на Lua с нуля",
      "3D-моделирование — Blender, модель на печать, анимация"
    ]
  },
  {
    h2: "Когда бронировать июльскую смену",
    text: "Июль расходится первым. Смена 2 (1–14 июля) — флагман, и обычно к маю свободных мест почти не остаётся. Смена 3 (20 июля – 1 августа) держится чуть дольше, но тоже не ждёт. Рекомендуем бронировать до конца мая, а лучше в апреле. Предоплата 10 000 ₽ фиксирует место и цену — если путёвка подорожает, вы платите по старому прайсу. Перенос между сменами возможен, если планы изменились.",
    list: [
      "Смена 2 (1–14 июля) — флагман, места заканчиваются первыми",
      "Рекомендуем бронировать до конца мая — июль обычно разобран к этому времени",
      "Предоплата 10 000 ₽ фиксирует место и цену",
      "Перенос между сменами возможен при изменении планов",
      "Оплата частями: 50% сейчас + 50% за 3 недели до заезда"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-iyul.avif"
  title="Лагерь на июль 2026 для детей в Подмосковье — АйДаКемп"
  description="Детский IT-лагерь в июле 2026 в Подмосковье. Смена 2: 1–14 июля, Смена 3: 20 июля–1 августа. Python, AI, Minecraft. От 89 400 ₽. Налоговый вычет до 5 434 ₽."
  h1="Лагерь на июль 2026 в Подмосковье"
  canonical="https://aidacamp.ru/lager-na-iyul"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Это самая популярная смена?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, июльская 14-дневная смена (1–14 июля) — флагман сезона. Места разбирают первыми, часто ещё в апреле-мае. Рекомендуем бронировать заранее." }
        },
        {
          "@type": "Question",
          "name": "Можно ли отдать ребёнка на две смены подряд?",
          "acceptedAnswer": { "@type": "Answer", "text": "Можно — например июньскую смену 2.1 (10–16 июня) плюс июльскую смену 2 (1–14 июля), с перерывом 1–2 недели дома. Программа не повторяется: каждая смена идёт дальше по уровню." }
        },
        {
          "@type": "Question",
          "name": "Когда нужно бронировать июльскую смену?",
          "acceptedAnswer": { "@type": "Answer", "text": "Рекомендуем до конца мая — июль обычно распродаётся первым. Предоплата 10 000 ₽ фиксирует место и цену. Перенос возможен при изменении планов." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на июль 2026 в Подмосковье"
    subtitle="Смена 2: 1–14 июля (14 дней). Смена 3: 20 июля–1 августа (13 дней). Программирование, AI и Minecraft — реальный проект за смену. 66 км от МКАД."
    breadcrumb="Лагерь на июль"
    keywords={["Смена 2: 1–14 июля, 95 000 ₽", "Смена 3: 20 июля–1 августа, 89 400 ₽", "Налоговый вычет до 5 434 ₽"]}
    image="/images/hero/lager-na-iyul.avif"
    imageAlt="Детский IT-лагерь на июль в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
