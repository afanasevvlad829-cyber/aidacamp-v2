  <style>
    @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css');

    :root {
      --bg: #ffffff;
      --bg2: #f5f5f5;
      --bg3: #ebebeb;
      --txt: #1a1a1a;
      --txt2: #666666;
      --or: #ff8c42;
      --or2: #ffb380;
      --fs-xs: clamp(12px, 1vw, 14px);
      --fs-sm: clamp(14px, 1.2vw, 16px);
      --fs-base: clamp(16px, 1.5vw, 18px);
      --fs-lg: clamp(18px, 2vw, 24px);
      --fs-xl: clamp(24px, 2.5vw, 32px);
      --fs-2xl: clamp(32px, 3.5vw, 48px);
      --fs-3xl: clamp(48px, 5vw, 68px);
      --gap-xs: clamp(8px, 1vw, 12px);
      --gap-sm: clamp(12px, 1.5vw, 16px);
      --gap-md: clamp(16px, 2vw, 24px);
      --gap-lg: clamp(24px, 3vw, 32px);
      --gap-xl: clamp(32px, 4vw, 48px);
      --gap-2xl: clamp(48px, 5vw, 72px);
      --r-xs: 4px;
      --r-sm: 8px;
      --r-md: 12px;
      --r-lg: 16px;
      --r-full: 9999px;
      --shadow: 0 2px 8px rgba(0,0,0,0.1);
      --surface: #ffffff;
      --ck: #d2a8ff;
      --cf: #79c0ff;
      --cs: #a5d6ff;
      --cn: #ffa657;
      --cc: #6e7681;
    }

    [data-theme="light"] {
      --bg: #ffffff;
      --bg2: #f5f5f5;
      --bg3: #ebebeb;
      --txt: #1a1a1a;
      --txt2: #666666;
    }

    [data-theme="dark"] {
      --bg: #0d1117;
      --bg2: #161b22;
      --bg3: #21262d;
      --txt: #c9d1d9;
      --txt2: #8b949e;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      background: var(--bg);
      color: var(--txt);
      font: var(--fs-base) -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      line-height: 1.6;
      transition: background 0.3s, color 0.3s;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Unbounded', sans-serif;
      font-weight: 900;
      line-height: 1.2;
    }

    h2 {
      font-size: var(--fs-2xl);
    }

    em {
      font-style: normal;
      color: var(--or);
    }

    a {
      color: var(--or);
      text-decoration: none;
      transition: color 0.2s;
    }

    a:hover {
      color: var(--or2);
    }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--bg3);
    }

    [data-theme="dark"] .nav {
      background: rgba(13, 17, 23, 0.7);
    }

    .nav-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: var(--gap-md);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-size: var(--fs-xl);
      font-family: 'Unbounded', sans-serif;
      font-weight: 900;
    }

    .nav-right {
      display: flex;
      gap: var(--gap-md);
      align-items: center;
    }

    .nav-phone {
      font-size: var(--fs-sm);
      font-weight: 600;
    }

    .theme-toggle {
      background: none;
      border: none;
      cursor: pointer;
      width: 24px;
      height: 24px;
      color: var(--txt);
      transition: color 0.2s;
    }

    .theme-toggle:hover {
      color: var(--or);
    }

    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: var(--gap-2xl) var(--gap-lg);
      overflow: hidden;
      margin-top: 60px;
    }

    #hero-canvas {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0.22;
    }

    [data-theme="dark"] #hero-canvas {
      opacity: 0.07;
    }

    .hero-content {
      position: relative;
      z-index: 10;
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 500px;
      gap: var(--gap-2xl);
      align-items: center;
    }

    .h-hero {
      font-size: var(--fs-3xl);
      margin-bottom: var(--gap-xl);
      line-height: 1.1;
    }

    .lead {
      font-size: var(--fs-lg);
      color: var(--txt2);
      max-width: 600px;
      margin-bottom: var(--gap-xl);
    }

    .hero-features {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gap-sm);
      margin-bottom: var(--gap-lg);
    }

    .badge {
      display: inline-block;
      padding: var(--gap-sm) var(--gap-md);
      background: var(--surface);
      border: 1px solid var(--bg3);
      border-radius: var(--r-md);
      font-size: var(--fs-sm);
      color: var(--txt);
    }

    .license-text {
      font-size: var(--fs-xs);
      color: var(--txt2);
      margin-bottom: var(--gap-lg);
    }

    .hero-buttons {
      display: flex;
      gap: var(--gap-md);
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--gap-sm);
      padding: var(--gap-sm) var(--gap-md);
      border: none;
      border-radius: var(--r-lg);
      font-weight: 600;
      cursor: pointer;
      font-size: var(--fs-sm);
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--or);
      color: white;
    }

    .btn-primary:hover {
      background: var(--or2);
    }

    .btn-secondary {
      background: var(--surface);
      border: 1px solid var(--bg3);
      color: var(--txt);
    }

    .btn-secondary:hover {
      background: var(--bg2);
    }

    .hero-code {
      background: var(--bg3);
      border-radius: var(--r-lg);
      padding: var(--gap-lg);
      font-family: 'Monaco', 'Courier New', monospace;
      font-size: var(--fs-sm);
      line-height: 1.8;
      overflow-x: auto;
      box-shadow: var(--shadow);
    }

    code {
      color: var(--txt2);
    }

    .ck { color: var(--ck); }
    .cf { color: var(--cf); }
    .cs { color: var(--cs); }
    .cn { color: var(--cn); }
    .cc { color: var(--cc); }

    .status {
      background: rgba(255, 140, 66, 0.2);
      padding: 2px 6px;
      border-radius: var(--r-xs);
      color: var(--or);
    }

    .section {
      padding: var(--gap-2xl) var(--gap-lg);
      border-top: 1px solid var(--bg3);
      max-width: 1280px;
      margin: 0 auto;
    }

    .s-kicker {
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--or);
      font-weight: 600;
      margin-bottom: var(--gap-md);
    }

    .s-lead {
      font-size: var(--fs-lg);
      color: var(--txt2);
      max-width: 600px;
      margin: var(--gap-lg) 0;
    }

    .terminal-container {
      margin-top: var(--gap-xl);
      border-radius: var(--r-lg);
      overflow: hidden;
