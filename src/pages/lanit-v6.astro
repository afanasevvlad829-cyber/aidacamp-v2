---
import CorpLayout    from '../layouts/CorpLayout.astro';
import CorpNav       from '../components/corp/CorpNav.astro';
import CorpHero      from '../components/corp/CorpHero.astro';
import CorpWhy       from '../components/corp/CorpWhy.astro';
import CorpTracks    from '../components/corp/CorpTracks.astro';
import CorpHackathon from '../components/corp/CorpHackathon.astro';
import CorpPool      from '../components/corp/CorpPool.astro';
import CorpPricing   from '../components/corp/CorpPricing.astro';
import CorpTax       from '../components/corp/CorpTax.astro';
import CorpVideo     from '../components/corp/CorpVideo.astro';
import CorpGallery   from '../components/corp/CorpGallery.astro';
import CorpReviews   from '../components/corp/CorpReviews.astro';
import CorpTeam      from '../components/corp/CorpTeam.astro';
import CorpRefund    from '../components/corp/CorpRefund.astro';
import CorpShifts    from '../components/corp/CorpShifts.astro';
import CorpMap       from '../components/corp/CorpMap.astro';
import CorpFAQ       from '../components/corp/CorpFAQ.astro';
import CorpBot       from '../components/corp/CorpBot.astro';
import CorpContacts  from '../components/corp/CorpContacts.astro';
import CorpFooter    from '../components/corp/CorpFooter.astro';
import { lanit }     from '../data/corp/lanit';
---

<CorpLayout client={lanit}>
  <CorpNav       client={lanit} />
  <CorpHero      client={lanit} />
  <CorpWhy />
  <CorpTracks />
  <CorpHackathon />
  <CorpPool />
  <CorpPricing   client={lanit} />
  <CorpTax       client={lanit} />
  <CorpVideo />
  <CorpGallery />
  <CorpReviews />
  <CorpTeam />
  <CorpRefund />
  <CorpShifts    client={lanit} />
  <CorpMap       client={lanit} />
  <CorpFAQ />
  <CorpBot       client={lanit} />
  <CorpContacts  client={lanit} />
  <CorpFooter    client={lanit} />
</CorpLayout>
