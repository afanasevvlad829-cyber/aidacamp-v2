  <script is:inline>
    if (typeof document !== 'undefined' && typeof window !== 'undefined') {
      // Theme Toggle
      const themeToggle = document.getElementById('theme-toggle');
      const icoMoon = document.getElementById('ico-moon');
      const icoSun = document.getElementById('ico-sun');

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('lanit-theme', theme);
      if (theme === 'dark') {
        icoMoon.style.display = 'none';
        icoSun.style.display = 'block';
      } else {
        icoMoon.style.display = 'block';
        icoSun.style.display = 'none';
      }
    }

    const savedTheme = localStorage.getItem('lanit-theme') || 'light';
    applyTheme(savedTheme);

    themeToggle.addEventListener('click', () => {
      const currentTheme = localStorage.getItem('lanit-theme') || 'light';
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';
      applyTheme(newTheme);
    });

    // Canvas Animation
    const canvas = document.getElementById('hero-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const cols = Math.floor(canvas.width / 50);
    const drops = Array(cols).fill(0);
    const pyKeywords = ['python', 'def', 'class', 'import', 'return', 'for', 'if', 'else', 'while', 'try', 'except', 'async', 'await', 'yield'];
    const pyColors = ['#FF7B72', '#D2A8FF', '#A5D6FF', '#FFA657', '#6E7681', '#79C0FF'];

    function drawCodeRain() {
      ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#fff';
      ctx.font = '16px monospace';

      for (let i = 0; i < cols; i++) {
        const text = pyKeywords[Math.floor(Math.random() * pyKeywords.length)];
        const color = pyColors[Math.floor(Math.random() * pyColors.length)];
        ctx.fillStyle = color;
        ctx.globalAlpha = 0.6;
        ctx.fillText(text, i * 50, drops[i] * 20);
        drops[i]++;

        if (drops[i] * 20 > canvas.height) {
          drops[i] = 0;
        }
      }
      ctx.globalAlpha = 1;
    }

    setInterval(drawCodeRain, 100);

    // Terminal System
    const MODES = {
      python: {
        file: 'main.py',
        tag: 'python',
        ok: 'ok',
        boot: [
          { html: '$ python main.py', d: 100 },
          { html: 'Compiling...', d: 500 },
        ],
        code: [
          { html: '<span class="cf">def</span> <span class="cn">hello</span>():', d: 200 },
          { html: '    <span class="cs">return</span> <span class="cs">"Hello, World!"</span>', d: 200 },
          { html: '', d: 100 },
          { html: '<span class="cn">hello</span>()', d: 200 },
          { html: '<span class="cs">"Hello, World!"</span>', d: 200 },
        ],
        output: []
      },
      csharp: {
        file: 'Program.cs',
        tag: 'csharp',
        ok: 'ok',
        boot: [
          { html: '$ dotnet run', d: 100 },
          { html: 'Build started...', d: 500 },
        ],
        code: [
          { html: '<span class="cf">class</span> Program {', d: 200 },
          { html: '    <span class="cf">static</span> <span class="cf">void</span> <span class="cn">Main</span>() {', d: 200 },
          { html: '        System.Console.WriteLine(<span class="cs">"C# works!"</span>);', d: 200 },
          { html: '    }', d: 100 },
          { html: '}', d: 100 },
        ],
        output: []
      },
      bash: {
        file: 'script.sh',
        tag: 'bash',
        ok: 'ok',
        boot: [
          { html: '$ bash script.sh', d: 100 },
          { html: 'Executing...', d: 300 },
        ],
        code: [
          { html: '<span class="cf">#!/bin/bash</span>', d: 100 },
          { html: '<span class="cn">echo</span> <span class="cs">"Bash shell running"</span>', d: 200 },
          { html: '<span class="cn">ls</span> -la', d: 200 },
          { html: '<span class="cn">pwd</span>', d: 200 },
        ],
        output: []
      }
    };

    let currentMode = 'python';
    let terminalCrashed = false;

    async function runMode(mode) {
      currentMode = mode;
      const termContent = document.getElementById('term-content');
      const config = MODES[mode];
      const tabs = document.querySelectorAll('.term-tab');

      tabs.forEach(t => t.classList.remove('active'));
      document.querySelector(`[data-mode="${mode}"]`).classList.add('active');

      termContent.innerHTML = '';
      document.getElementById('term-bsod').style.display = 'none';
      document.getElementById('term-cscrash').style.display = 'none';
      document.getElementById('term-kpanic').style.display = 'none';
      terminalCrashed = false;

      for (const line of config.boot) {
        await new Promise(r => setTimeout(r, line.d));
        termContent.innerHTML += line.html + '<br/>';
      }

      await new Promise(r => setTimeout(r, 500));

      if (mode === 'csharp') {
        // C# crash
        document.getElementById('term-cscrash').style.display = 'flex';
        terminalCrashed = true;
        return;
      }

      for (const line of config.code) {
        await new Promise(r => setTimeout(r, line.d));
        termContent.innerHTML += line.html + '<br/>';
      }

      if (mode === 'python') {
        // Python - random crash
        if (Math.random() > 0.7) {
          await new Promise(r => setTimeout(r, 1000));
          document.getElementById('term-bsod').style.display = 'flex';
          terminalCrashed = true;
          return;
        }
      }

      if (mode === 'bash') {
        // Bash - random kernel panic
        if (Math.random() > 0.6) {
          await new Promise(r => setTimeout(r, 1000));
          document.getElementById('term-kpanic').style.display = 'flex';
          terminalCrashed = true;
          return;
        }
      }
    }

    // Terminal tabs
    document.querySelectorAll('.term-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const mode = tab.dataset.mode;
        runMode(mode);
      });
    });

    // Crash screen buttons
    document.getElementById('cscrash-btn')?.addEventListener('click', () => runMode('csharp'));
    document.getElementById('kpanic-btn')?.addEventListener('click', () => runMode('bash'));

    // Start terminal
    runMode('python');

    // Snake Game (embedded in terminal)
    const PACKAGES = ['npm', 'pip', 'git', 'ssh', 'api', 'go', 'py', 'db', 'tsx', 'sql', 'aws', 'jwt', 'css', 'env', 'cli', 'rpm', 'deb', 'brew', 'curl', 'yarn'];
    const LEVELS = [
      { score: 0, title: 'Junior Dev' },
      { score: 10, title: 'Middle Dev' },
      { score: 20, title: 'Senior Dev' },
      { score: 40, title: 'Architect' },
      { score: 80, title: 'Linus Torvalds' }
    ];

    // Pricing Calculator
    const TIERS = [
      { min: 1, max: 2, discount: 0.05 },
      { min: 3, max: 5, discount: 0.08 },
      { min: 6, max: 9, discount: 0.12 },
      { min: 10, max: 30, discount: 0.12 }
    ];

    const smenas = [
      { id: 0, label: 'Смена 1', tag: 'Май-июнь', dates: '10–24 июня', days: 14, basePrice: 74900, description: 'Начало лета, самая популярная смена' },
      { id: 1, label: 'Смена 2.1', tag: 'Июнь', dates: '24 июня – 1 июля', days: 7, basePrice: 48000, description: 'Короткая смена в начале лета' },
      { id: 2, label: 'Смена 2.2', tag: 'Июль', dates: '1–9 августа', days: 8, basePrice: 65000, description: 'Середина лета, хорошая погода' },
      { id: 3, label: 'Смена 4', tag: 'Август', dates: '20 августа – 3 сентября', days: 14, basePrice: 95000, description: 'Конец лета, самая продвинутая смена' }
    ];

    function fmt(n) {
      return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽';
    }

    function calcPrice() {
      const kids = parseInt(document.getElementById('kids-slider').value);
      const smena = smenas.find(s => s.id === parseInt(document.querySelector('.stab.active')?.dataset.index || '0'));
      if (!smena) return;

      let lanPrice = smena.basePrice;
      let discount = 0;

      TIERS.forEach(tier => {
        if (kids >= tier.min && kids <= tier.max) {
          discount = tier.discount;
        }
      });

      lanPrice = Math.round(lanPrice * (1 - discount));
      const taxBase = Math.max(0, lanPrice - 3800 * smena.days);
      const taxReturn = Math.round(taxBase * 0.13);

      document.getElementById('price-per-kid').textContent = fmt(lanPrice);
      document.getElementById('lanit-discount').textContent = `-${Math.round(discount * 100)}%`;
      document.getElementById('tax-return').textContent = '~' + fmt(taxReturn);

      if (kids >= 6) {
        document.getElementById('group-result-box').style.display = 'flex';
      } else {
        document.getElementById('group-result-box').style.display = 'none';
      }
    }

    function selectSmena(idx, btn) {
      document.querySelectorAll('.stab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      btn.dataset.index = idx;

      const s = smenas[idx];
      document.querySelector('.smena-label').textContent = s.label;
      document.querySelector('.smena-tag').textContent = s.tag;
      document.querySelector('.smena-dates').textContent = s.dates;
      document.querySelector('.smena-desc').textContent = s.description;

      calcPrice();
    }

    document.getElementById('kids-slider')?.addEventListener('input', () => {
      document.getElementById('kids-count').textContent = document.getElementById('kids-slider').value;
      calcPrice();
    });

    selectSmena(0, document.querySelector('.stab'));

    // Video Carousel
