---
import CorpLayout from '../layouts/CorpLayout.astro';
import CorpNav     from '../components/corp/CorpNav.astro';
import CorpHero    from '../components/corp/CorpHero.astro';
import CorpWhy     from '../components/corp/CorpWhy.astro';
import CorpTracks  from '../components/corp/CorpTracks.astro';
import CorpShifts  from '../components/corp/CorpShifts.astro';
import CorpReviews from '../components/corp/CorpReviews.astro';
import CorpRefund  from '../components/corp/CorpRefund.astro';
import CorpFAQ     from '../components/corp/CorpFAQ.astro';
import CorpFooter  from '../components/corp/CorpFooter.astro';
import { lanit }   from '../data/corp/lanit';
---

<CorpLayout client={lanit}>
  <CorpNav     client={lanit} />
  <CorpHero    client={lanit} />
  <CorpWhy />
  <CorpTracks />
  <CorpShifts  client={lanit} />
  <CorpReviews />
  <CorpRefund />
  <CorpFAQ />
  <CorpFooter  client={lanit} />
</CorpLayout>
