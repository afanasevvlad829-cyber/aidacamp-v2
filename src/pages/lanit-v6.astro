---
import LanitPageLayout from '../layouts/LanitPageLayout.astro';
---

<LanitPageLayout title="IT-лагерь для детей айтишников · ЛАНИТ" description="Партнёрская программа с ГК ЛАНИТ — специальные условия для сотрудников">
  <!-- Navigation Bar -->
  <nav class="nav">
    <div class="nav-inner">
      <h1 class="brand">АйДа<em>Кемп</em></h1>
      <div class="nav-right">
        <a href="tel:+74951284429" class="nav-phone">+7 (495) 128-44-29</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
          <svg id="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg id="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <div>
        <h2 class="h-hero">
          IT-лагерь<br/>для детей<br/><em>айтишников</em>
        </h2>
        <p class="lead">
          Ваш ребёнок видит, что вы делаете? Пора показать ему настоящий стек. Python, JS, Java, ИИ-агенты — и реальный проект на выходе. Летняя инженерная школа в 66 км от Москвы. 7–15 лет.
        </p>
        <div class="hero-features">
          <span class="badge">7–15 лет</span>
          <span class="badge">⭐ 5.0 · Яндекс.Карты</span>
          <span class="badge">Крытый бассейн</span>
          <span class="badge">66 км от Москвы</span>
          <span class="badge">8+ треков</span>
          <span class="badge">5-разовое питание</span>
        </div>
        <p class="license-text">Лицензия Минобра № ЛО35-01298-77/01082973</p>
        <div class="hero-buttons">
          <a href="tel:+74951284429" class="btn btn-primary">
            <i class="bi bi-telephone-fill"></i> +7 (495) 128-44-29
          </a>
          <a href="https://t.me/aidacamp" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <i class="bi bi-telegram"></i> Telegram
          </a>
        </div>
      </div>
      <div class="hero-code">
        <code>
          <span class="ck">transfer</span> = <span class="cf">Tree</span> <span class="cc"># 18+ детей</span><br/>
          <span class="ck">async</span> = 5 / газ в сутки<br/>
          <span class="cf">def</span> <span class="cn">enroll</span>(kid, child):<br/>
          &nbsp;&nbsp;<span class="cf">return</span> <span class="cs">"Смена забронирована"</span><br/>
          <span class="cc"># ...</span><br/>
          <br/>
          <span class="cc"># Скидки: -12% + группа 6–5 детей</span><br/>
          <span class="cc"># Трансфер от офиса ДМИТа: готово</span><br/>
          <span class="cc"># Питание: 5 раз в сутки</span><br/>
          <span class="cc"># Статус:</span> <span class="status">ОТКРЫТА</span><br/>
          <span class="cc"># "Смена забронирована для ГК ЛАНИТ"</span>
        </code>
      </div>
    </div>
  </section>

  <!-- Terminal Section -->
  <section id="terminal-section" class="section">
    <div class="s-kicker">Интерактив</div>
    <h2>Давайте попробуем<br/><em>код</em></h2>
    <div class="terminal-container">
      <div class="term-bar">
        <div class="traffic-lights">
          <span class="light red"></span>
          <span class="light yellow"></span>
          <span class="light green"></span>
        </div>
        <div class="term-tabs">
          <button class="term-tab active" data-mode="python">
            <span class="term-tag">python</span>
            <span class="term-ok">ok</span>
          </button>
          <button class="term-tab" data-mode="csharp">
            <span class="term-tag">csharp</span>
            <span class="term-ok">ok</span>
          </button>
          <button class="term-tab" data-mode="bash">
            <span class="term-tag">bash</span>
            <span class="term-ok">ok</span>
          </button>
        </div>
      </div>
      <div class="terminal">
        <code id="term-content"></code>
        <span id="term-cursor" class="cursor">_</span>
      </div>
      <div id="term-bsod" style="display: none;" class="term-screen bsod">
        <div>
          <p style="color: white;">MEMORY.BIN</p>
          <p>A fatal exception 0E has occurred at 0028:C0EF12F4 in VXD VMM(01) + 00010D95. The current application will be terminated.</p>
          <p style="margin-top: 20px;">Press any key to continue _</p>
        </div>
      </div>
      <div id="term-cscrash" style="display: none;" class="term-screen cscrash">
        <div>
          <p style="color: #d32f2f; font-weight: bold;">System.StackOverflowException: The stack overflowed as a result of a recursive call in the compiled code.</p>
          <p style="font-size: 12px; margin-top: 10px;">   at Program.&lt;Module&gt;() in Program.cs:1</p>
          <p style="margin-top: 15px; color: #757575; font-size: 12px;">The program '[1234] dotnet' has exited with code 1 (0x1).</p>
          <p style="margin-top: 20px;"><button id="cscrash-btn" style="padding: 5px 10px; cursor: pointer;">Restart</button></p>
        </div>
      </div>
      <div id="term-kpanic" style="display: none;" class="term-screen kpanic">
        <div>
          <p style="color: #ffeb3b;">Kernel panic - not syncing: Fatal exception in interrupt</p>
          <p style="color: #ffeb3b;">CPU: 0 PID: 1234 Comm: systemd Tainted: G      D</p>
          <p style="color: #ffeb3b;">Call Trace:</p>
          <p style="color: #ffeb3b;">dump_stack+0x6d/0x8b</p>
          <p style="color: #ffeb3b;">panic+0x101/0x2e3</p>
          <p style="margin-top: 20px;"><button id="kpanic-btn" style="padding: 5px 10px; cursor: pointer; background: #333; color: #ffeb3b; border: 1px solid #ffeb3b;">Reboot</button></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Section -->
  <section id="why-section" class="section">
    <div class="s-kicker">Лагерь как он есть</div>
    <h2>Почему дети<br/>сюда <em>возвращаются</em></h2>
    <div class="why-tabs">
      <button class="why-age-tab active" data-age="all">Все возрасты</button>
      <button class="why-age-tab" data-age="7-9">7–9 лет</button>
      <button class="why-age-tab" data-age="10-12">10–12 лет</button>
      <button class="why-age-tab" data-age="13-15">13–15 лет</button>
    </div>
    <div id="why-grid" class="why-grid">
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <h3>Нет скучных лекций</h3>
        <p>Всё работает через игры, боевые миссии и реальные проекты. За 5 минут — скучно, за час — захватывает.</p>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <h3>Друзья на всю жизнь</h3>
        <p>Спортивные сражения, квесты, ночные костры. Вместе едят, спят, кодят — связи крепче, чем в городе.</p>
      </div>
      <div class="why-card" data-age="10-12,13-15">
        <div class="why-marker"></div>
        <h3>Первый реальный проект</h3>
        <p>Игра, приложение, веб-сервис — всё запускается на внешнем сервере и работает по-настоящему.</p>
      </div>
      <div class="why-card" data-age="all">
        <div class="why-marker"></div>
        <h3>Бассейн и спорт</h3>
        <p>Крытый бассейн, футбол, волейбол, бадминтон. Все тело задействовано, а не только пальцы.</p>
      </div>
    </div>
  </section>

  <!-- Tracks Section -->
  <section id="tracks-section" class="section">
    <div class="s-kicker">Направления</div>
    <h2>8 треков на<br/><em>любой возраст</em></h2>
    <div id="tracks-grid" class="tracks-grid">
      <div class="track-card">
        <h3>Scratch + ИИ</h3>
        <p class="track-age">7–9 лет</p>
        <p>Визуальное программирование + первые нейросети. Рисуют, делают игры, говорят с ИИ на английском.</p>
      </div>
      <div class="track-card">
        <h3>Minecraft</h3>
        <p class="track-age">7–9 лет</p>
        <p>Строим, модифицируем, программируем. Логика в реальном времени, результат видно сразу.</p>
      </div>
      <div class="track-card">
        <h3>Drone</h3>
        <p class="track-age">10–12 лет</p>
        <p>Кодируем полёты беспилотников. Синхронизируем 4 дрона в небе одновременно.</p>
      </div>
      <div class="track-card">
        <h3>Python + Pygame</h3>
        <p class="track-age">10–12 лет</p>
        <p>Пишут игры на Python. К концу смены готова игра в Steam с рейтингом.</p>
      </div>
      <div class="track-card">
        <h3>JavaScript</h3>
        <p class="track-age">10–15 лет</p>
        <p>Веб-интерфейсы, приложения, игры. Их код крутится на реальных серверах.</p>
      </div>
      <div class="track-card">
        <h3>Python Advanced</h3>
        <p class="track-age">13–15 лет</p>
        <p>Парсеры, боты, аналитика. Качают данные, чистят, визуализируют.</p>
      </div>
      <div class="track-card">
        <h3>Python Senior</h3>
        <p class="track-age">13–15 лет</p>
        <p>Django, базы данных, API. Пишут настоящие backend-сервисы.</p>
      </div>
      <div class="track-card">
        <h3>Java / OOP</h3>
        <p class="track-age">13–15 лет</p>
        <p>Объектно-ориентированный дизайн, паттерны. Готовятся к чемпионатам программирования.</p>
      </div>
    </div>
  </section>

  <!-- Hackathon Section -->
  <section id="hackathon-section" class="section">
    <div class="s-kicker">Проектный день</div>
    <h2><em>Хакатон</em> по ролям</h2>
    <div class="hack-roles">
      <button class="role-badge" data-desc="Пишет код, тестирует, разбирает баги">Dev 👨‍💻</button>
      <button class="role-badge" data-desc="Рисует интерфейсы, иконки, макеты">Designer 🎨</button>
      <button class="role-badge" data-desc="Пишет посты, снимает видео, выкладывает">Marketer 📱</button>
      <button class="role-badge" data-desc="Считает бюджет, объясняет value">Finance Dir 💰</button>
      <button class="role-badge" data-desc="Придумывает идею, координирует команду">Strategist 🎯</button>
      <button class="role-badge" data-desc="QA, тестирует на краях, ловит баги">Tester 🐛</button>
    </div>
    <div class="hack-steps">
      <div class="hack-step">
        <span class="hack-num">1</span>
        <h3>Идея</h3>
        <p>Strategist и Team выбирают проект: игра, сервис, приложение.</p>
      </div>
      <div class="hack-step">
        <span class="hack-num">2</span>
        <h3>Дизайн</h3>
        <p>Designer за 30 мин рисует макет, остальные утверждают.</p>
      </div>
      <div class="hack-step">
        <span class="hack-num">3</span>
        <h3>Код</h3>
        <p>Dev и Tester 4 часа кодят, тестируют, чинят.</p>
      </div>
      <div class="hack-step">
        <span class="hack-num">4</span>
        <h3>Презентация</h3>
        <p>Показывают готовый проект, Marketer записывает на видео.</p>
      </div>
    </div>
  </section>

  <!-- Pool Section -->
  <section id="pool-section" class="section">
    <div class="pool-left">
      <div class="s-kicker">Инфраструктура</div>
      <h2><em>Крытый</em> бассейн<br/>и спорт</h2>
      <p class="s-lead">Плавание, волейбол, футбол, бадминтон — всё включено в смену. Спорт расслабляет, помогает переходить с трека на трек без выгорания.</p>
      <ul class="pool-features">
        <li><i class="bi bi-check-circle"></i> Крытый олимпийский бассейн</li>
        <li><i class="bi bi-check-circle"></i> Спортзал с тренажёрами</li>
        <li><i class="bi bi-check-circle"></i> Футбольное поле</li>
        <li><i class="bi bi-check-circle"></i> Волейбольная площадка</li>
        <li><i class="bi bi-check-circle"></i> Бадминтон</li>
        <li><i class="bi bi-check-circle"></i> Турниры между отрядами</li>
      </ul>
    </div>
    <div class="pool-grid">
      <img src="https://images.unsplash.com/photo-1576610616656-d3aa5d1f4534?w=400&h=300&fit=crop" alt="Бассейн" class="pool-img pool-img-big" onclick="openLightbox(0, poolPhotos)">
      <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=200&h=150&fit=crop" alt="Спорт" class="pool-img" onclick="openLightbox(1, poolPhotos)">
      <img src="https://images.unsplash.com/photo-1552674605-5defe6aa593b?w=200&h=150&fit=crop" alt="Команда" class="pool-img" onclick="openLightbox(2, poolPhotos)">
      <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?w=200&h=150&fit=crop" alt="Волейбол" class="pool-img" onclick="openLightbox(3, poolPhotos)">
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing-section" class="section">
    <div class="s-kicker">Стоимость</div>
    <h2><em>Смены</em> и цены</h2>
    <div class="pricing-container">
      <div class="smena-tabs">
        <button class="stab active" onclick="selectSmena(0, this)">Смена 1</button>
        <button class="stab" onclick="selectSmena(1, this)">Смена 2.1</button>
        <button class="stab" onclick="selectSmena(2, this)">Смена 2.2</button>
        <button class="stab" onclick="selectSmena(3, this)">Смена 4</button>
      </div>
      <div class="smena-meta">
        <div class="smena-label"></div>
        <div class="smena-tag"></div>
        <div class="smena-dates"></div>
        <div class="smena-desc"></div>
      </div>
      <div class="calc-slider">
        <label>Кол-во детей в группе: <span id="kids-count">1</span></label>
        <input type="range" id="kids-slider" min="1" max="30" value="1" oninput="updateCalc()">
      </div>
      <div class="calc-results">
        <div class="calc-result">
          <span>Цена за ребёнка</span>
          <span id="price-per-kid">48 000 ₽</span>
        </div>
        <div class="calc-result">
          <span>Скидка для ГК ЛАНИТ</span>
          <span id="lanit-discount">-12%</span>
        </div>
        <div class="calc-result">
          <span>Налоговый вычет 13%</span>
          <span id="tax-return">~2 800 ₽</span>
        </div>
        <div class="calc-result group-result" id="group-result-box" style="display: none;">
          <span>Групповая скидка (6+ детей)</span>
          <span id="group-discount">-12%</span>
        </div>
      </div>
      <p class="transfer-note"><i class="bi bi-info-circle"></i> Трансфер от офиса ГК ЛАНИТ при группе 10+ детей</p>
    </div>
  </section>

  <!-- Tax Section -->
  <section id="tax-section" class="section">
    <div class="tax-left">
      <div class="s-kicker">Налоговый вычет</div>
      <h2>Вернут<br/><em>13%</em> стоимости</h2>
      <p class="s-lead">Лагерь — образовательный сервис, входит в налоговый вычет на образование.</p>
      <ol class="tax-steps">
        <li>Подаёте документы в налоговую до 30 апреля</li>
        <li>Налоговая проверяет 2–3 месяца</li>
        <li>Деньги приходят на счёт в сентябре</li>
      </ol>
    </div>
    <div class="tax-calc">
      <div class="tax-calc-box">
        <div class="tax-row">
          <span>Стоимость смены</span>
          <span id="tax-base">48 000 ₽</span>
        </div>
        <div class="tax-row">
          <span>−  Лимит на день (3 800 ₽ × дни)</span>
          <span id="tax-limit">-38 000 ₽</span>
        </div>
        <div class="tax-row" style="border-top: 1px solid var(--txt2);">
          <span>= Налоговая база</span>
          <span id="tax-taxable">10 000 ₽</span>
        </div>
        <div class="tax-row" style="font-weight: bold; color: var(--or);">
          <span>13% вычет</span>
          <span id="tax-final">~1 300 ₽</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section id="video-section" class="section">
    <div class="s-kicker">Видео</div>
    <h2>Как это<br/><em>выглядит</em></h2>
    <div class="vid-tabs">
      <button class="vtab active" onclick="switchVidTab('camp')">Лагерь</button>
      <button class="vtab" onclick="switchVidTab('projects')">Проекты</button>
    </div>
    <div id="vid-carousel-camp" class="vid-carousel">
      <button class="vid-arrow vid-prev">❮</button>
      <div class="vid-track">
        <div class="vid-card" data-vopen="670244793"><img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=300&h=200&fit=crop" alt="Видео 1"><i class="bi bi-play-circle"></i><h3>День в лагере</h3></div>
        <div class="vid-card" data-vopen="670244794"><img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=300&h=200&fit=crop" alt="Видео 2"><i class="bi bi-play-circle"></i><h3>Спорт</h3></div>
        <div class="vid-card" data-vopen="670244795"><img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=300&h=200&fit=crop" alt="Видео 3"><i class="bi bi-play-circle"></i><h3>Бассейн</h3></div>
        <div class="vid-card" data-vopen="670244796"><img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=300&h=200&fit=crop" alt="Видео 4"><i class="bi bi-play-circle"></i><h3>Ночной костёр</h3></div>
        <div class="vid-card" data-vopen="670244797"><img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=300&h=200&fit=crop" alt="Видео 5"><i class="bi bi-play-circle"></i><h3>Хакатон</h3></div>
      </div>
      <button class="vid-arrow vid-next">❯</button>
    </div>
    <dialog id="videoModal">
      <button onclick="this.parentElement.close()" class="modal-close">✕</button>
      <iframe id="videoFrame" src="" allow="autoplay" style="width: 100%; height: 100%; border: none;"></iframe>
    </dialog>
  </section>

  <!-- Gallery Section -->
  <section id="gallery-section" class="section">
    <div class="s-kicker">Фотоальбом</div>
    <h2>Впечатления<br/>за 14 дней</h2>
    <div id="gal-tabs" class="gal-tabs">
      <button class="gtab active" onclick="switchGalCat('camp')">Атмосфера</button>
      <button class="gtab" onclick="switchGalCat('pool')">Бассейн</button>
      <button class="gtab" onclick="switchGalCat('sport')">Спорт</button>
      <button class="gtab" onclick="switchGalCat('study')">Учёба</button>
      <button class="gtab" onclick="switchGalCat('food')">Питание</button>
      <button class="gtab" onclick="switchGalCat('territory')">Территория</button>
    </div>
    <div id="gal-desktop" class="gal-layout"></div>
    <div id="gal-mobile" class="gal-layout" style="display: none;"></div>
  </section>

  <!-- Reviews Section -->
  <section id="reviews-section" class="section">
    <div class="s-kicker">Отзывы</div>
    <h2>Родители ставят<br/><em>5.0</em> на Яндекс.Картах</h2>
    <div class="rv-rating">⭐ 5.0 · 120+ отзывов на Яндекс.Картах</div>
    <div class="rv-carousel" id="rv-carousel">
      <div class="rv-card">
        <div class="rv-header">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=50&h=50&fit=crop" alt="Фото" class="rv-photo">
          <div class="rv-meta">
            <h4>Анна Смирнова</h4>
