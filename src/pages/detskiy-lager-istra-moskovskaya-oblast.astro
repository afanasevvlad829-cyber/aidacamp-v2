---
import { PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR, TRANSFER_PRICE_FMT, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title={`Детский лагерь истра московская область ${SEASON_YEAR} — IT-лагерь АйДаКемп`}
  description={`Детский лагерь истра московская область — АйДаКемп в Подмосковье ${SEASON_YEAR}. Python, AI, Minecraft, бассейн. Открыты августовские смены, от ${PRICE_MIN}. Трансфер от м. Солнцево.`}
  h1={`Детский лагерь истра московская область ${SEASON_YEAR} — АйДаКемп`}
  canonical="https://aidacamp.ru/lager-istra/"
  noindex={true}
>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Детский лагерь истра московская область {SEASON_YEAR} — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Истра московская — организованный трансфер от м. Солнцево ({TRANSFER_PRICE_FMT}).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от {PRICE_MIN}, налоговый вычет 13% — до {VYCHET_MAX}.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, {TRANSFER_PRICE_FMT}</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 10 и 13 дней, август {SEASON_YEAR}</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-base text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Открыты августовские смены {SEASON_YEAR}, от {PRICE_MIN}.
        Налоговый вычет 13% — до {VYCHET_MAX}.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ extraItems={[
    { q: `Есть ли детский лагерь истра московская область с проживанием в ${SEASON_YEAR}?`, a: `АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Истра московская. Открыты августовские смены 10 и 13 дней ${SEASON_YEAR}, для школьников 7–15 лет.` },
    { q: "Как добраться до лагеря из Истра московская?", a: `Организованный трансфер отправляется от м. Солнцево (${TRANSFER_PRICE_FMT}). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе.` },
    { q: `Сколько стоит лагерь в ${SEASON_YEAR} году?`, a: `От ${PRICE_S4} за 10 дней до ${PRICE_MAX} за 13 дней. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до ${VYCHET_MAX}.` }
  ]} />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-base text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny/" class="text-primary hover:underline">цены и смены {SEASON_YEAR}</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />


  

  <!-- strengthened-v2 -->
  <section class="mx-auto max-w-[720px] px-4 py-8 prose prose-lg max-w-none text-body-muted leading-relaxed">
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4">Где находится и сколько стоит</h2>
    <p>АйДаКемп работает в Московской области — в санатории «Изумруд» Наро-Фоминского района, 66 км от МКАД по Киевскому шоссе. Это загородная закрытая территория с бассейном, 5-разовым питанием и медработником круглосуточно.</p>
    <p>Цена путёвки зависит от длины смены: от {PRICE_MIN} за 10 дней до {PRICE_MAX} за 13. В стоимость уже входят проживание, IT-программа, питание, бассейн. Налоговый вычет 13% возвращает до {VYCHET_MAX} за 13-дневную смену.</p>
    <p>На смене ребёнок 7–15 лет собирает свой проект — игру, бота или 3D-сцену — и защищает его на хакатоне. Группы до 8 человек, фото из отряда приходят в Telegram каждый день. Открыты августовские смены {SEASON_YEAR}.</p>
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4 mt-8">Коротко</h2>
    <ul class="space-y-2">
      <li>Московская область, Наро-Фоминский район, 66 км от МКАД</li>
      <li>Смена от {PRICE_MIN} (10 дней) до {PRICE_MAX} (13 дней)</li>
      <li>В цене: проживание, программа, питание, бассейн</li>
      <li>Группы до 8, медработник 24/7</li>
      <li>Налоговый вычет 13% — до {VYCHET_MAX} за 13-дневную смену</li>
    </ul>
  </section>
</LandingLayout>
