---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь истра московская область 2026 — IT-лагерь АйДаКемп"
  description="Детский лагерь истра московская область — АйДаКемп в Подмосковье 2026. Python, AI, Minecraft, бассейн. Смены июнь–август, от 48 000 ₽. Трансфер от м. Солнцево."
  h1="Детский лагерь истра московская область 2026 — АйДаКемп"
  canonical="https://aidacamp.ru/detskiy-lager-istra-moskovskaya-oblast"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли детский лагерь истра московская область с проживанием в 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Истра московская. Смены 7–14 дней, летом 2026, для школьников 7–15 лет." }
        },
        {
          "@type": "Question",
          "name": "Как добраться до лагеря из Истра московская?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь в 2026 году?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Смены 10, 13 и 14 дней — 74 900–99 000 ₽. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до 5 434 ₽." }
        }
      ]
    })} />
  </Fragment>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Детский лагерь истра московская область 2026 — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Истра московская — организованный трансфер от м. Солнцево (2 000 ₽).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от 48 000 ₽, налоговый вычет 13% — до 5 434 ₽.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, 2 000 ₽</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 7–14 дней, июнь и август 2026</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-[15px] text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Смены июнь–август 2026, от 48 000 ₽.
        Налоговый вычет 13% — до 5 434 ₽.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny" class="text-primary hover:underline">цены и смены 2026</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />


  <!-- strengthened-v2 -->
  <section class="mx-auto max-w-[720px] px-4 py-8 prose prose-lg max-w-none text-body-muted leading-relaxed">
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4">Цены на отдых в АйДаКемп</h2>
    <p>Для родителей, которые ищут подходящий детский лагерь, важно понимать, сколько стоит путёвка. В АйДаКемп, который расположен в санатории «Изумруд», стоимость путёвки варьируется от 48 000 ₽ за 7 дней до 99 000 ₽ за 14 дней. Это включает проживание, 5-разовое питание и доступ к различным активностям, что делает отдых не только интересным, но и комфортным.</p>
    <p>Многие родители интересуются не только ценами, но и тем, что входит в стоимость. В АйДаКемп предусмотрены занятия по программированию, 3D-моделированию и другим современным направлениям. Также стоит отметить, что на каждую группу из 6–8 школьников выделяется преподаватель, что обеспечивает индивидуальный подход к каждому ребёнку.</p>
    <p>Кроме того, родителям будет приятно узнать, что существует возможность налогового вычета в размере 13%. Это значит, что за 14-дневную смену можно вернуть до 5 434 ₽. В конце смены ребята защищают свои проекты на хакатоне и получают дипломы, что станет отличным дополнением к портфолио.</p>
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4 mt-8">Что включает стоимость путёвки</h2>
    <ul class="space-y-2">
      <li>проживание в комфортных условиях</li>
      <li>5-разовое питание</li>
      <li>доступ к бассейну</li>
      <li>ежедневные фотоотчёты в Telegram-чат</li>
      <li>медицинское сопровождение 24/7</li>
    </ul>
  </section>
</LandingLayout>
