---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Какой вычет и почему он возможен",
    text: "По статье 219 НК РФ родители имеют право на социальный налоговый вычет 13% от расходов на обучение ребёнка. В АйДаКемп часть путёвки — это образовательная услуга: IT-программа, занятия с преподавателями, материалы, диагностика. Эту часть можно заявить к вычету. Бытовая часть (проживание и питание) — не образовательная услуга и вычету не подлежит.",
    list: [
      "Вычет на обучение одного ребёнка — максимум 110 000 ₽/год (база), т.е. до 14 300 ₽ возврата",
      "На двух детей — два независимых лимита, до 28 600 ₽ суммарно",
      "Вычет доступен только тому родителю, который официально работает и платит НДФЛ 13%",
      "У АйДаКемп есть образовательная лицензия — обязательное условие для вычета"
    ]
  },
  {
    h2: "Что считается образовательной частью путёвки",
    text: "Мы разделяем стоимость путёвки на две части: бытовая (проживание + питание) и образовательная (всё остальное — программа, преподаватели, оборудование, материалы). Расчёт основан на нашей внутренней смете затрат.",
    list: [
      "Бытовая часть — 3 800 ₽ в день (комната, 5-разовое питание, охрана территории)",
      "Образовательная — оставшаяся сумма (преподаватели, ноутбуки, ПО, 3D-принтеры, учебные материалы, диагностика, сертификаты)",
      "Например, для смены 14 дней по 95 000 ₽: 14 × 3 800 = 53 200 ₽ бытовая, 41 800 ₽ образовательная",
      "Образовательную часть мы выделяем в договоре отдельной строкой по запросу — это и есть база для вычета"
    ]
  },
  {
    h2: "Как получить вычет — 2 способа",
    text: "Способ 1 (проще): через работодателя в год оплаты. Получаете уведомление от ФНС (подаётся через nalog.ru), передаёте в бухгалтерию — и с вас перестают удерживать НДФЛ пока вся сумма не вернётся. Способ 2 (классика): декларация 3-НДФЛ в следующем году за годом оплаты. Подаётся через Личный кабинет ФНС на nalog.ru, возврат приходит в течение 1-2 месяцев после одобрения.",
    list: [
      "Способ 1 — через работодателя: уведомление ФНС → бухгалтерия → зарплата без НДФЛ",
      "Способ 2 — декларация 3-НДФЛ: через nalog.ru в 2027 году за смену 2026",
      "Срок давности — 3 года (за смену 2026 можно подать вплоть до 2029 включительно)",
      "Если пропустили — не страшно, возврат доступен до истечения срока"
    ]
  },
  {
    h2: "Какие документы нужны",
    text: "Все необходимые документы для вычета мы оформляем и выдаём по запросу после оплаты путёвки. Достаточно написать нам в WhatsApp или на hello@codims.ru и указать «документы для вычета».",
    list: [
      "Договор об оказании образовательных услуг — с выделенной образовательной частью",
      "Акт выполненных работ",
      "Копия образовательной лицензии Л035-01298-77/01082973",
      "Копия платёжного поручения или чека банка",
      "Копия свидетельства о рождении ребёнка (от вас, просто скан)",
      "Справка 2-НДФЛ с вашей работы — заказываете у работодателя"
    ]
  },
  {
    h2: "Сколько получится вернуть — разбор по сменам",
    text: "Ниже ориентировочные суммы возврата для каждой смены АйДаКемп 2026. Расчёт по формуле: (стоимость путёвки − 3 800 × кол-во дней) × 13%, с учётом лимита 110 000 ₽ на ребёнка в год.",
    list: [
      "Смена 1 (10 дней, 74 900 ₽) → бытовая 38 000 ₽, образов. 36 900 ₽ → возврат ~4 800 ₽",
      "Смена 2 (14 дней, 95 000 ₽) → бытовая 53 200 ₽, образов. 41 800 ₽ → возврат ~5 400 ₽",
      "Смена 2.1 (7 дней, 48 000 ₽) → бытовая 26 600 ₽, образов. 21 400 ₽ → возврат ~2 800 ₽",
      "Смена 2.2 (8 дней, 65 000 ₽) → бытовая 30 400 ₽, образов. 34 600 ₽ → возврат ~4 500 ₽",
      "Смена 3 (13 дней, 89 400 ₽) → бытовая 49 400 ₽, образов. 40 000 ₽ → возврат ~5 200 ₽",
      "Смена 4 (10 дней, 69 600 ₽) → бытовая 38 000 ₽, образов. 31 600 ₽ → возврат ~4 100 ₽"
    ]
  },
  {
    h2: "Особые случаи",
    text: "Несколько нюансов, которые встречаются на практике. Если что-то похоже на ваш случай — напишите нам, поможем разобраться индивидуально.",
    list: [
      "Двое детей в одной смене — два вычета (по 14 300 ₽ максимум на каждого)",
      "Ребёнок едет в несколько смен за год — суммируются в пределах лимита 110 000 ₽/год",
      "Оплата с работодателя как соцпакет — вычет оформляет сотрудник (если в договоре указано его имя)",
      "Оплата из материнского капитала — вычет НЕ применяется (материнский капитал уже не облагался НДФЛ)",
      "Второй родитель безработный — оформляет работающий родитель, от чьего имени платёжка"
    ]
  }
];

const relatedPages = [
  { title: "Купить путёвку в лагерь", url: "/kupit-putevku-v-lager", emoji: "💳", description: "Способы оплаты и документы" },
  { title: "Лагерь недорого", url: "/lager-nedorogo", emoji: "💰", description: "Цены всех смен 2026" },
  { title: "Для компаний", url: "/dlya-kompaniy", emoji: "🏢", description: "Корпоративные путёвки" },
  { title: "Лагерь на лето 2026", url: "/lager-na-leto-2026", emoji: "📅", description: "Календарь смен" },
];
---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title="Налоговый вычет за путёвку в лагерь — как вернуть 13% | АйДаКемп"
  description="Верните 13% стоимости путёвки в детский лагерь через налоговый вычет. Интерактивный калькулятор, разбор документов и пошаговая инструкция — как оформить в 2026-2027 году."
  h1="Налоговый вычет за путёвку в детский лагерь"
  canonical="https://aidacamp.ru/nalogovyj-vychet"
>
  <LandingHero slot="hero"
    h1="Налоговый вычет за путёвку в детский лагерь"
    subtitle="Путёвка в АйДаКемп квалифицируется как оплата обучения ребёнка — значит вы можете вернуть 13%. Калькулятор ниже покажет сколько."
    breadcrumb="Налоговый вычет"
    keywords={["13% возврата от образовательной части путёвки", "Лимит 110 000 ₽/год на одного ребёнка — до 14 300 ₽ возврата", "Документы оформляем и выдаём по запросу"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Налоговый вычет за путёвку в АйДаКемп"
  />

  <TaxCalculator variant="full" title="Калькулятор налогового вычета" />

  <LandingTwoCol sections={sections} />

  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={relatedPages} />
</LandingLayout>
