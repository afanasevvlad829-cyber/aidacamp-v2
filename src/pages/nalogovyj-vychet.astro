---
import { PRICE_MAX, PRICE_MIN, PRICE_S1, PRICE_S2, PRICE_S21, PRICE_S22, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_MAX, VYCHET_S1, VYCHET_S2, VYCHET_S21, VYCHET_S22, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import { STAT_LICENSE } from '../data/contacts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import AskCta from '../components/AskCta.astro';

const sections = [
  {
    h2: "Правовая основа: статья 219 НК РФ",
    text: `Вычет действует по статье 219 Налогового кодекса РФ, пункт 2 — социальный вычет на обучение. Он даёт родителям право вернуть 13% от расходов на образовательные услуги для ребёнка. АйДаКемп работает по лицензии Минобрнауки ${STAT_LICENSE} — обязательное условие для возврата. Оформить вычет может официально работающий родитель: образовательная часть путёвки в детском оздоровительном лагере (ДОЛ) даёт такое право по норме НК РФ. По сути — это компенсация уже потраченного, а не скидка при оплате.`,
  },
  {
    h2: `Что изменилось в вычете`,
    text: `С 2024 года лимит социального вычета по ст. 219 НК РФ вырос до 110 000 ₽ в год на одного школьника (было 50 000 ₽). Возврат считается не от всего лимита, а от фактически потраченной образовательной части — нужен договор с выделенной строкой. Для открытых августовских смен эта часть — от 36 900 ₽ (10 дней) до 40 000 ₽ (13 дней). Итого: от ~${VYCHET_S4} до ~${VYCHET_MAX}. Срок давности — 3 года.`,
    list: [
      "Если двое детей — лимиты независимые на каждого",
      "Срок давности — 3 года: за 2023, 2024, 2025 ещё можно подать"
    ]
  },
  {
    h2: "Что входит в образовательную часть",
    text: "Стоимость смены делится на две части: бытовую (проживание и питание) и образовательную (программа, преподаватели, оборудование, материалы) — расчёт по нашей внутренней смете.",
    list: [
      "Бытовая часть — 3 800 ₽ в день (комната, 5-разовое питание, охрана территории)",
      "Образовательная — оставшаяся сумма (преподаватели, ноутбуки, ПО, 3D-принтеры, учебные материалы, диагностика, сертификаты)",
      `Например, для открытой смены 13 дней по ${PRICE_MAX}: 13 × 3 800 = 49 400 ₽ бытовая, 40 000 ₽ образовательная`,
      "Образовательную часть выделяем в договоре отдельной строкой по запросу — это база для вычета"
    ]
  },
  {
    h2: "Оба родителя могут получить вычет",
    text: `<div class="rounded-xl bg-blue-50 border border-blue-200 p-5 my-2">
  <p class="font-semibold text-slate-800">Вычет доступен обоим родителям независимо</p>
  <p class="text-slate-600 text-sm mt-1">Каждый — со своего НДФЛ, на одни и те же расходы. По открытой 13-дневной смене каждый родитель вернёт до ~${VYCHET_MAX}, то есть семья удваивает возврат. Главное — чтобы у каждого был подтверждающий документ (чек или платёжка на своё имя).</p>
</div>`,
  },
  {
    h2: "2 способа получить вычет",
    text: "Способ 1 (проще): через работодателя — получаете уведомление от ФНС (через <a href=\"https://nalog.gov.ru\" target=\"_blank\" rel=\"noopener\" class=\"text-orange-600 underline\">nalog.gov.ru</a>) и передаёте в бухгалтерию, с вас перестают удерживать НДФЛ, пока сумма не вернётся. Способ 2 (классика): декларация 3-НДФЛ в следующем году через Личный кабинет на <a href=\"https://nalog.gov.ru\" target=\"_blank\" rel=\"noopener\" class=\"text-orange-600 underline\">nalog.gov.ru</a> — после камеральной проверки возврат приходит за 1-2 месяца.",
    list: [
      "Способ 1 — через работодателя: уведомление ФНС → бухгалтерия → зарплата без НДФЛ",
      "Способ 2 — декларация 3-НДФЛ: подать в 2027 году за смену этого года",
      "Срок давности — 3 года: подать можно вплоть до 2029 года включительно"
    ]
  },
  {
    h2: "Какие документы нужны",
    text: 'Полный список документов оформляем и выдаём по запросу после оплаты путёвки. Достаточно написать нам в <a href="https://wa.me/79688086455" target="_blank" rel="noopener" class="text-orange-600 underline">WhatsApp</a> или на <a href="mailto:hello@codims.ru" class="text-orange-600 underline">hello@codims.ru</a> и укажите «документы для вычета». О рассрочке 50/50 — в статье <a href="/stati/oplata-detskogo-lagerya/" class="text-orange-600 underline underline-offset-2">«Оплата и рассрочка за лагерь»</a>.',
    list: [
      "Договор об оказании образовательных услуг — с выделенной образовательной частью",
      "Акт выполненных работ",
      `Копия образовательной лицензии ${STAT_LICENSE}`,
      "Копия платёжного поручения или чека банка",
      "Копия свидетельства о рождении ребёнка (от вас, просто скан)",
      "Справка 2-НДФЛ с вашей работы — заказываете у работодателя"
    ]
  },
  {
    h2: "Сколько получится вернуть — разбор по сменам",
    text: `Ориентировочные суммы возврата по каждой оздоровительной смене АйДаКемп. Формула: (стоимость путёвки − 3 800 × количество дней) × 13%, с учётом лимита 110 000 ₽ в год на одного ребёнка. Открыты к записи две августовские смены (3 и 4); июньские оставлены для истории.`,
    list: [
      `Смена 3 (13 дней, ${PRICE_S3}) → бытовая 49 400 ₽, образов. 40 000 ₽ → возврат ~${VYCHET_S3} (места есть)`,
      `Смена 4 (10 дней, ${PRICE_S4}) → бытовая 38 000 ₽, образов. 36 900 ₽ → возврат ~${VYCHET_S4} (места есть)`,
      `Смена 1 (завершена, 10 дней, ${PRICE_S1}) → бытовая 38 000 ₽, образов. 47 900 ₽ → возврат ~${VYCHET_S1}`,
      `Смена 2 (завершена, 14 дней, ${PRICE_S2}) → бытовая 53 200 ₽, образов. 45 800 ₽ → возврат ~${VYCHET_S2}`,
      `Смена 2.1 (завершена, 7 дней, ${PRICE_S21}) → бытовая 26 600 ₽, образов. 21 400 ₽ → возврат ~${VYCHET_S21}`,
      `Смена 2.2 (завершена, 8 дней, ${PRICE_S22}) → бытовая 30 400 ₽, образов. 44 600 ₽ → возврат ~${VYCHET_S22}`
    ]
  },
  {
    h2: "Особые случаи",
    text: "Несколько нюансов из практики — если что-то похоже на ваш случай, напишите нам.",
    list: [
      `Двое детей в одной смене — два вычета (по ${VYCHET_S3} максимум на каждого)`,
      "Несколько смен за год — суммируются в пределах лимита 110 000 ₽/год",
      "Оплата от работодателя в виде соцпакета — вычет оформляет сотрудник (если в договоре указано его имя)",
      "Оплата из материнского капитала — вычет НЕ применяется (материнский капитал уже не облагался НДФЛ)",
      "Второй родитель безработный — оформляет работающий родитель, от чьего имени платёжка"
    ]
  },
  {
    h2: "Вычет за прошлые годы — ещё не поздно",
    text: `Да. Срок давности — 3 года: в ${SEASON_YEAR} году можно подать декларации за 2023, 2024 и 2025. Если уже отправляли сюда сына или дочь и ещё не оформляли вычет — сделайте это сейчас, деньги не пропали. Нужны документы за прошлые смены — напишите нам.`,
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title={`Налоговый вычет за путёвку в детский лагерь: как получить`}
  description={`Как получить налоговый вычет за путёвку в детский лагерь ${SEASON_YEAR} и вернуть деньги на карту — до ${VYCHET_MAX}. Калькулятор + документы. АйДаКемп: лицензия Минобрнауки, всё включено.`}
  h1={`Как получить налоговый вычет за путёвку в детский лагерь ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/nalogovyj-vychet"
>
  <LandingHero slot="hero"
    h1={`Как получить налоговый вычет за путёвку в детский лагерь ${SEASON_YEAR}`}
    subtitle={`Смена в АйДаКемп — официально образовательная услуга по ст. 219 НК РФ. Возвращаем до ${VYCHET_MAX} на ребёнка. Калькулятор и документы ниже.`}
    breadcrumb="Вычет"
    keywords={["13% возврата от образовательной части смены", `Лимит 110 000 ₽/год на одного школьника — до ${VYCHET_MAX} возврата`, `Лицензия Минобрнауки ${STAT_LICENSE} — обязательное условие для возврата`]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Возврат НДФЛ за смену в АйДаКемп"
  />

  <!-- Featured Snippet: вычет за лагерь -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-orange-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="nalogovyy-vychet-za-lager">Как получить налоговый вычет за детский лагерь?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>Вычет за детский лагерь</strong> оформляется через ФНС в виде возврата НДФЛ за обучение —
      если лагерь имеет образовательную лицензию. АйДаКемп даёт договор и справку для ФНС.
      Подайте декларацию 3-НДФЛ с чеком и справкой — получите до {VYCHET_MAX} на открытую 13-дневную смену.
    </p>
  </section>

  <TaxCalculator variant="full" title="Калькулятор возврата" />

  <LandingTwoCol sections={sections} />

  <FAQ extraItems={[
    { q: "Можно ли получить налоговый вычет за путёвку в летний лагерь?", a: `Да, если лагерь имеет образовательную лицензию. АйДаКемп работает по лицензии Минобрнауки (${STAT_LICENSE}). Родитель возвращает 13% от образовательной части путёвки по ст. 219 НК РФ — до ${VYCHET_MAX} на ребёнка в год.` },
    { q: "Сколько можно вернуть за путёвку в АйДаКемп?", a: `Зависит от смены: смена 4 (10 дней, ${PRICE_S4}) — возврат ~${VYCHET_S4}; смена 3 (13 дней, ${PRICE_S3}) — возврат ~${VYCHET_MAX}. Точный расчёт — в калькуляторе на странице.` },
    { q: "Какие документы нужны для налогового вычета за лагерь?", a: "Договор с выделенной образовательной частью, акт, копия лицензии Минобрнауки, чек или платёжка, свидетельство о рождении ребёнка. Все документы выдаём после оплаты автоматически." },
    { q: "Как подать декларацию для вычета?", a: "Способ 1: через работодателя — уведомление ФНС через nalog.ru и передача в бухгалтерию. Способ 2: декларация 3-НДФЛ через Личный кабинет ФНС в следующем году. Срок давности — 3 года." },
    { q: "Можно ли получить вычет если у ребёнка оба родителя?", a: `Да, оба родителя получают вычет независимо — каждый со своего НДФЛ. По 13-дневной смене каждый вернёт до ~${VYCHET_MAX}, семья удваивает возврат. Нужен платёжный документ на своё имя у каждого.` },
    { q: "Можно ли вернуть деньги за путёвку в лагерь за прошлые годы?", a: `Да, срок давности — 3 года: в ${SEASON_YEAR} году можно подать декларации за 2023–2025. Уже отправляли ребёнка и не оформляли вычет — напишите нам, поможем с документами.` },
    { q: `Повысился ли налоговый вычет за лагерь в 2024–${SEASON_YEAR} году?`, a: `Да. С 2024 года лимит базы вырос с 50 000 до 110 000 ₽ в год на ребёнка. Для открытых августовских смен АйДаКемп возврат — от ${VYCHET_S4} до ${VYCHET_MAX} в зависимости от длительности.` },
    { q: "Можно ли вернуть деньги за путёвку в лагерь через госуслуги?", a: "Да. Через Госуслуги подаётся заявление в ФНС на уведомление для работодателя, либо декларация 3-НДФЛ — всё онлайн через nalog.ru, без визита в налоговую." },
    { q: "Возможен ли налоговый вычет если лагерь оплатил работодатель как соцпакет?", a: "Да, если в договоре указан сотрудник как плательщик. Если оплата шла напрямую из корпоративных средств без оформления на сотрудника — вычет не применяется." },
    { q: "Можно ли получить налоговый вычет за путёвку в детский оздоровительный лагерь?", a: `Да. ДОЛ — официальный термин, вычет по ст. 219 НК РФ распространяется на образовательную часть путёвки при лицензии Минобрнауки. АйДаКемп — такой лагерь: лицензия ${STAT_LICENSE}, возврат от ${VYCHET_S21} до ${VYCHET_MAX}.` }
  ]} />

  <!-- CTA → /ask для возвратных пользователей -->
  <AskCta />

  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
