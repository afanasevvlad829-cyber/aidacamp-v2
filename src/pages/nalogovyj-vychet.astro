---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Налоговый вычет 2026: что изменилось",
    text: "С 2024 года действует повышенный лимит социального налогового вычета по ст. 219 НК РФ — до 110 000 ₽/год на одного ребёнка (до 2024 года было 50 000 ₽). Важно понимать: возврат считается не от всего лимита, а от фактически потраченной образовательной части. Для нашего лагеря образовательная часть — от 21 400 ₽ (7 дней) до 41 800 ₽ (14 дней), и это укладывается в лимит с запасом. Итого возврат: от ~2 800 до ~5 434 ₽ в зависимости от смены. Срок давности — 3 года.",
    list: [
      "До 2024: лимит базы 50 000 ₽/год → наши смены укладывались, возврат зависел от образовательной части",
      "С 2024: лимит 110 000 ₽ — вдвое больше, актуально если ребёнок учится на нескольких курсах",
      "Если двое детей — лимиты независимые на каждого",
      "Срок давности — 3 года: за 2023, 2024, 2025 ещё можно подать"
    ]
  },
  {
    h2: "Какой вычет и почему он возможен",
    text: "По статье 219 НК РФ родители имеют право на социальный налоговый вычет 13% от расходов на обучение ребёнка. В АйДаКемп часть путёвки — это образовательная услуга: IT-программа, занятия с преподавателями, материалы, диагностика. Эту часть можно заявить к вычету. Бытовая часть (проживание и питание) — не образовательная услуга и вычету не подлежит.",
    list: [
      "Вычет на обучение одного ребёнка — лимит базы 110 000 ₽/год; возврат = 13% × фактическая образовательная часть",
      "На двух детей — два независимых лимита",
      "Вычет доступен только тому родителю, который официально работает и платит НДФЛ 13%",
      "У АйДаКемп есть образовательная лицензия — обязательное условие для вычета"
    ]
  },
  {
    h2: "Что считается образовательной частью путёвки",
    text: "Мы разделяем стоимость путёвки на две части: бытовая (проживание + питание) и образовательная (всё остальное — программа, преподаватели, оборудование, материалы). Расчёт основан на нашей внутренней смете затрат.",
    list: [
      "Бытовая часть — 3 800 ₽ в день (комната, 5-разовое питание, охрана территории)",
      "Образовательная — оставшаяся сумма (преподаватели, ноутбуки, ПО, 3D-принтеры, учебные материалы, диагностика, сертификаты)",
      "Например, для смены 14 дней по 95 000 ₽: 14 × 3 800 = 53 200 ₽ бытовая, 41 800 ₽ образовательная",
      "Образовательную часть мы выделяем в договоре отдельной строкой по запросу — это и есть база для вычета"
    ]
  },
  {
    h2: "Как получить вычет — 2 способа",
    text: "Способ 1 (проще): через работодателя в год оплаты. Получаете уведомление от ФНС (подаётся через nalog.ru), передаёте в бухгалтерию — и с вас перестают удерживать НДФЛ пока вся сумма не вернётся. Способ 2 (классика): декларация 3-НДФЛ в следующем году за годом оплаты. Подаётся через Личный кабинет ФНС на nalog.ru, возврат приходит в течение 1-2 месяцев после одобрения.",
    list: [
      "Способ 1 — через работодателя: уведомление ФНС → бухгалтерия → зарплата без НДФЛ",
      "Способ 2 — декларация 3-НДФЛ: через nalog.ru в 2027 году за смену 2026",
      "Срок давности — 3 года (за смену 2026 можно подать вплоть до 2029 включительно)",
      "Если пропустили — не страшно, возврат доступен до истечения срока"
    ]
  },
  {
    h2: "Какие документы нужны",
    text: 'Все необходимые документы для вычета мы оформляем и выдаём по запросу после оплаты путёвки. Достаточно написать нам в <a href="https://wa.me/79688086455" target="_blank" rel="noopener" class="text-orange-600 underline">WhatsApp</a> или на <a href="mailto:hello@codims.ru" class="text-orange-600 underline">hello@codims.ru</a> и указать «документы для вычета».',
    list: [
      "Договор об оказании образовательных услуг — с выделенной образовательной частью",
      "Акт выполненных работ",
      "Копия образовательной лицензии Л035-01298-77/01082973",
      "Копия платёжного поручения или чека банка",
      "Копия свидетельства о рождении ребёнка (от вас, просто скан)",
      "Справка 2-НДФЛ с вашей работы — заказываете у работодателя"
    ]
  },
  {
    h2: "Сколько получится вернуть — разбор по сменам",
    text: "Ниже ориентировочные суммы возврата для каждой смены АйДаКемп 2026. Расчёт по формуле: (стоимость путёвки − 3 800 × кол-во дней) × 13%, с учётом лимита 110 000 ₽ на ребёнка в год.",
    list: [
      "Смена 1 (10 дней, 74 900 ₽) → бытовая 38 000 ₽, образов. 36 900 ₽ → возврат ~4 800 ₽",
      "Смена 2 (14 дней, 95 000 ₽) → бытовая 53 200 ₽, образов. 41 800 ₽ → возврат ~5 400 ₽",
      "Смена 2.1 (7 дней, 48 000 ₽) → бытовая 26 600 ₽, образов. 21 400 ₽ → возврат ~2 800 ₽",
      "Смена 2.2 (8 дней, 65 000 ₽) → бытовая 30 400 ₽, образов. 34 600 ₽ → возврат ~4 500 ₽",
      "Смена 3 (13 дней, 89 400 ₽) → бытовая 49 400 ₽, образов. 40 000 ₽ → возврат ~5 200 ₽",
      "Смена 4 (10 дней, 74 900 ₽) → бытовая 38 000 ₽, образов. 31 600 ₽ → возврат ~4 100 ₽"
    ]
  },
  {
    h2: "Особые случаи",
    text: "Несколько нюансов, которые встречаются на практике. Если что-то похоже на ваш случай — напишите нам, поможем разобраться индивидуально.",
    list: [
      "Двое детей в одной смене — два вычета (по 5 200 ₽ максимум на каждого)",
      "Ребёнок едет в несколько смен за год — суммируются в пределах лимита 110 000 ₽/год",
      "Оплата с работодателя как соцпакет — вычет оформляет сотрудник (если в договоре указано его имя)",
      "Оплата из материнского капитала — вычет НЕ применяется (материнский капитал уже не облагался НДФЛ)",
      "Второй родитель безработный — оформляет работающий родитель, от чьего имени платёжка"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-nedorogo.avif"
  title="Налоговый вычет за детский лагерь 2026 — до 5 434 ₽"
  description="Верните 13% от стоимости смены — до 5 434 ₽ за 14-дневную смену. Пошаговая инструкция по оформлению, документы, сроки. АйДаКемп — Подмосковье."
  h1="Налоговый вычет за путёвку в детский лагерь 2026"
  canonical="https://aidacamp.ru/nalogovyj-vychet"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли получить налоговый вычет за путёвку в летний лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, если лагерь имеет образовательную лицензию. АйДаКемп работает по лицензии Минобрнауки (Л035-01298-77/01082973). Родитель может вернуть 13% от образовательной части путёвки по ст. 219 НК РФ — до 5 434 ₽ на одного ребёнка в год." }
        },
        {
          "@type": "Question",
          "name": "Сколько можно вернуть за путёвку в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Зависит от смены. Смена 2.1 (7 дней, 48 000 ₽) — образовательная часть 21 400 ₽, возврат ~2 800 ₽; смена 2 (14 дней, 95 000 ₽) — образовательная 41 800 ₽, возврат ~5 434 ₽. Точный расчёт — в калькуляторе на странице." }
        },
        {
          "@type": "Question",
          "name": "Какие документы нужны для налогового вычета за лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Договор на оказание образовательных услуг с выделенной образовательной частью, акт, копия лицензии Минобрнауки, чек/платёжка, свидетельство о рождении ребёнка. Все документы выдаём после оплаты автоматически." }
        },
        {
          "@type": "Question",
          "name": "Как подать декларацию для вычета?",
          "acceptedAnswer": { "@type": "Answer", "text": "Способ 1: через работодателя в год оплаты — уведомление от ФНС через nalog.ru и передача в бухгалтерию. Способ 2: декларация 3-НДФЛ через Личный кабинет ФНС в следующем году. Срок давности — 3 года." }
        },
        {
          "@type": "Question",
          "name": "Можно ли получить вычет если у ребёнка оба родителя?",
          "acceptedAnswer": { "@type": "Answer", "text": "Вычет получает тот родитель, который оплатил путёвку и чьи данные в договоре. Если платил один — он и получает. Лимит 110 000 ₽/год на ребёнка, не на родителя." }
        },
        {
          "@type": "Question",
          "name": "Повысился ли налоговый вычет за лагерь в 2024–2026 году?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. С 2024 года лимит базы для вычета повышен с 50 000 до 110 000 ₽ в год на ребёнка. Фактический возврат считается как 13% от образовательной части путёвки — для смен АйДаКемп это от 2 470 до 5 434 ₽ в зависимости от длительности." }
        },
        {
          "@type": "Question",
          "name": "Можно ли вернуть деньги за путёвку в лагерь через госуслуги?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Через Госуслуги можно подать заявление в ФНС на получение уведомления для работодателя, либо подать декларацию 3-НДФЛ. Личный кабинет ФНС (nalog.ru) позволяет всё сделать онлайн без визита в налоговую." }
        },
        {
          "@type": "Question",
          "name": "Возможен ли налоговый вычет если лагерь оплатил работодатель как соцпакет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, если в договоре указан сотрудник как плательщик и путёвка оформлена как образовательная услуга. Если оплата шла напрямую из корпоративных средств без оформления на сотрудника — вычет не применяется." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Налоговый вычет за путёвку в детский лагерь 2026"
    subtitle="Путёвка в АйДаКемп — это официально образовательная услуга по ст. 219 НК РФ. Возвращаем до 5 434 ₽ на ребёнка. Калькулятор и документы ниже."
    breadcrumb="Налоговый вычет"
    keywords={["13% возврата от образовательной части путёвки", "Лимит 110 000 ₽/год на одного ребёнка — до 5 434 ₽ возврата", "Лицензия Минобрнауки Л035-01298-77/01082973 — обязательное условие для вычета"]}
    image="/images/hero/lager-nedorogo.avif"
    imageAlt="Налоговый вычет за путёвку в АйДаКемп"
  />

  <!-- Featured Snippet: налоговый вычет за лагерь -->
  <section class="max-w-3xl mx-auto px-4 py-6 bg-orange-50 rounded-2xl my-6">
    <h2 class="text-xl font-bold mb-3" id="nalogovyy-vychet-za-lager">Как получить налоговый вычет за детский лагерь?</h2>
    <p class="text-gray-800 leading-relaxed">
      <strong>Налоговый вычет за детский лагерь</strong> оформляется через ФНС как вычет за обучение —
      если лагерь имеет образовательную лицензию. АйДаКемп даёт договор и справку для ФНС.
      Подайте декларацию 3-НДФЛ с чеком и справкой — получите до 5 434 ₽ на 14-дневную смену.
    </p>
  </section>

  <TaxCalculator variant="full" title="Калькулятор налогового вычета" />

  <LandingTwoCol sections={sections} />

  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
