---
import { PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое летняя компьютерная школа с проживанием?",
    text: "АйДаКемп — это летняя компьютерная школа в загородном формате обучения. В отличие от онлайн-курсов или городских кружков, ребята живут в лагере 7–14 дней и занимаются программированием каждый день. Python, AI-инструменты, Minecraft и 3D-моделирование — реальный проект к финалу смены. Санаторий «Изумруд», 66 км от МКАД, Киевское шоссе."
  },
  {
    h2: "Чем летняя IT-школа отличается от онлайн-курсов?",
    text: "Онлайн-курс даёт теорию. Кружок — 1–2 часа в неделю. Летняя IT-школа — это 7–15 дней полного погружения: занятия каждый день, преподаватель рядом, живое общение с такими же детьми. За это время ребята проходят путь от первого кода до готового проекта. Это невозможно в онлайне."
  },
  {
    h2: "Какая программа в летней IT-школе?",
    text: "Программа разбита по направлениям (Python, AI, Minecraft, 3D-моделирование) и строится по принципу «от простого к сложному» внутри каждой смены.",
    list: [
      "День 1–2: знакомство, базовые концепции, первые шаги",
      "День 3–5: основной учебный блок, работа над проектом",
      "День 6–8: углубление, доработка, помощь преподавателя",
      "Финал: хакатон — защита проекта перед всеми"
    ]
  },
  {
    h2: "Кто преподаёт в летней IT-школе?",
    text: "Команда АйДаКемп работает с детьми с 2021 года. Через офлайн-школу #АйДаКодить прошли более 1200 учеников. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей (тираж 2000 экз., продаётся в магазинах)."
  },
  {
    h2: "Кто учится в летней IT-школе?",
    text: "За 5 лет работы АйДаКемп мы принимали детей самых разных предпочтений. Общий портрет — ребёнок 7-15 лет, который проявлял интерес к компьютерам, играм или технологиям. Но есть и неожиданные истории: приходили дети-отличники, которые «должны знать это современно»; приходили дети, который родители называли «ничем не интересуется» — и впервые зажглись именно здесь. Наш формат подходит:",
    list: [
      "Любопытным — тем, кто задаёт «как это работает» про всё, что видит",
      "Тихим и интровертным — IT-школа даёт мягкое вхождение в коллектив через общий проект",
      "Зависимым от игр — здесь они переходят от потребителя к создателю",
      "Будущим школьным олимпиадникам — усиление перед осенними турами",
      "Детям программистов — первое знакомство с профессией родителей"
    ]
  },
  {
    h2: "Чем IT-школа в лагере лучше онлайн-курса программирования?",
    text: "Онлайн-школа — это 2 урока в неделю, домашка, выпал — догоняй сам. Летняя IT-школа — это 10-14 дней концентрированной работы. В практических терминах — одна смена у нас даёт тот же учебный объём, что 3-4 месяца онлайн-курса. Формат полного погружения помогает пройти за 10–14 дней то, что онлайн-курс даёт за 3–4 месяца. Почему? Потому что:",
    list: [
      "В лагере нет «отвлечения» — телефон сдан, интернета в классе нет, внимание 100% на задаче",
      "Ошибки в коде разбирает преподаватель рядом через 30 секунд, а не через 3 дня в переписке",
      "Ежедневная работа над проектом = ежедневный прогресс, а не «вспоминание прошлого урока»",
      "Круг сверстников — мотивация подтягиваться, чтобы не отстать от друзей",
      "Финальная защита — реальный дедлайн, учатся доводить до результата"
    ]
  },
  {
    h2: "Что ребёнок получает после летней IT-школы?",
    text: "Через 3 месяца после смены мы опрашиваем родителей — что поменялось. Стандартный ответ — «ребёнок сам сел за компьютер учиться дальше». Это не совпадение: за смену ребята впервые испытали «потоковое состояние» от работы над кодом. Каждый нашёл занятие, которое нравится и в котором успешен. После такого опыта «неинтересно» — уже не вернётся. Можно считать это главным результатом летней IT-школы: не конкретный проект, а открытие новой страсти, которая останется на годы."
  },
  {
    h2: "Программа летней IT-школы АйДаКемп",
    text: "Программа разделена по возрасту и уровню подготовки — каждый занимается в своём темпе и своим треком:",
    list: [
      "Python (10–15 лет) — от синтаксиса и переменных до написания бота или игры. Самый популярный трек: практичный язык с мгновенным результатом",
      "Scratch (7–10 лет) — визуальное программирование, анимации, простые игры. Идеально для первого знакомства с логикой кода",
      "3D-моделирование и печать (10–14 лет) — Blender, создание объектов, прототипирование на 3D-принтере",
      "AI и нейросети (11–15 лет) — работа с ChatGPT API, Gemini, Stable Diffusion. Создание собственного AI-ассистента или генератора"
    ]
  },
  {
    h2: "В чём разница: IT-школа vs IT-лагерь",
    text: "Родители часто спрашивают: «а это лагерь или школа?». Честный ответ — АйДаКемп совмещает оба формата. У нас полноценные IT-занятия как в школе плюс загородный отдых как в лагере.",
    list: [
      "Обычный IT-лагерь — отдых с элементами кода, 1–2 часа в день «для галочки»",
      "Обычная IT-школа — городской кружок, домашние задания, нет загородной атмосферы",
      "АйДаКемп — 3–5 часов практики ежедневно с живым преподавателем + бассейн, природа, команда сверстников",
      "Результат: один реальный проект от первого дня до финальной защиты на хакатоне"
    ]
  },
  {
    h2: "Расписание учебного дня",
    text: "IT-занятия встроены в день так, чтобы сохранить энергию на вечерние активности. Никакой зубрёжки — только практика.",
    list: [
      "9:00 — завтрак",
      "10:00–11:30 — первый IT-блок: новая тема или работа над проектом",
      "13:00 — обед",
      "14:30–16:00 — второй IT-блок: доработка проекта, помощь преподавателя",
      "16:00–20:00 — свободное время: бассейн, спорт, прогулки",
      "После ужина — вечерние активности или самостоятельная работа над проектом"
    ]
  },
  {
    h2: "IT-школа или лагерь: 3 ключевых отличия АйДаКемп",
    text: "Три главных отличия от стандартного лагерного формата:",
    list: [
      "Интенсивность — 3–5 часов практики ежедневно, преподаватель рядом, конкретная задача на каждый день",
      "Формат — не отдельные уроки по темам, а единый проект от первого дня до финальной защиты",
      "Сертификат — по итогам смены выдаётся сертификат АйДаКемп. Годится в портфолио при поступлении в профильные классы"
    ]
  },
  {
    h2: "Для кого подходит летняя IT-школа — и как быстро занять место",
    text: "АйДаКемп принимает школьников 7–15 лет. Опыт в программировании не нужен — есть группы для абсолютных новичков. Есть и продвинутые группы для тех, кто уже знаком с основами. Группы до 8 человек — мест мало, особенно в июне.",
    list: [
      "Новички 7–10 лет — Scratch, первые алгоритмы, маленькие игры и мультфильмы",
      "Начинающие 10–12 лет — Python с нуля, создание простого бота или игры за смену",
      "Продолжающие 12–15 лет — Python Advanced, AI, работа с API, сложные проекты",
      "Цели разные: один хочет просто попробовать, другой — подготовиться к олимпиаде, третий — понять «это вообще моё?». Для каждого есть подходящий трек"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/letnyaya-it-shkola.avif"
  title={`Летняя IT-школа в Подмосковье ${SEASON_YEAR} — ребёнок уедет с проектом`}
  description={`Летняя IT-школа с проживанием в Подмосковье: смены 10 и 13 дней, Python-проект у каждого, группы до 8 человек, бассейн. Для школьников 7–15 лет. От ${PRICE_MIN}.`}
  h1={`Летняя IT-школа для детей в Подмосковье ${SEASON_YEAR}`}
  canonical="https://aidacamp.ru/letnyaya-it-shkola"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Чем летняя IT-школа отличается от обычного лагеря?", a: "В обычном лагере ребёнок отдыхает, в IT-школе — создаёт. АйДаКемп совмещает: загородный формат с проживанием, бассейном и активностями + серьёзная IT-программа дважды в день. Результат — реальный проект в финале." },
    { q: "Чем летняя IT-школа отличается от онлайн-курса?", a: "Полное погружение без экрана дома. 10–14 дней в живой команде, без соцсетей и игр — только код и общение. Команда, хакатон, новые друзья. Онлайн-курс это не даёт." },
    { q: "Для каких детей подходит летняя IT-школа?", a: "Для детей 7–15 лет. Опыт программирования не нужен. Есть группы для начинающих, среднего и продвинутого уровня — до 8 человек в группе." },
    { q: "Как долго длится смена в летней IT-школе?", a: `Сейчас открыты основные смены — 10 и 13 дней (${PRICE_S4} и ${PRICE_MAX}), август ${SEASON_YEAR}. Короткие летние смены 7–8 дней уже завершены.` },
    { q: "Нужен ли опыт программирования для поступления в летнюю IT-школу?", a: "Нет. В АйДаКемп есть группы для полных новичков: начинаем с основ логики и визуального программирования. Главное — желание попробовать. Диагностика на входе позволяет определить подходящий уровень для каждого ребёнка." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летняя IT-школа для детей в Подмосковье"
    subtitle="Не обычный лагерь и не онлайн-курс — загородная IT-школа с проживанием, где ребёнок создаёт реальный проект."
    breadcrumb="Летняя IT-школа"
    keywords={["Авторская программа по Python, AI, Minecraft", "Преподаватели-практики с 6-летним опытом", "Загородный формат с проживанием и бассейном"]}
    image="/images/hero/letnyaya-it-shkola.avif"
    imageAlt="Летняя IT-школа АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <RelatedPages pages={[
    { title: 'IT-лагерь', description: 'Программирование, AI, Minecraft — полное погружение', url: '/it-camp/', icon: 'bi-laptop' },
    { title: 'Компьютерный лагерь', description: 'Кодим, создаём проекты, общаемся', url: '/kompyuternyy-lager/', icon: 'bi-display' },
    { title: 'Цены и смены', description: `Стоимость и даты всех смен ${SEASON_YEAR}`, url: '/ceny/', icon: 'bi-receipt' },
    { title: 'Лагерь Python', description: 'Python с нуля до бота за 10 дней', url: '/python-lager/', icon: 'bi-code-slash' },
  ]} />
</LandingLayout>
