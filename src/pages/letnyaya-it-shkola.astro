---
import { PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import { OPEN_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Что такое летняя компьютерная школа с проживанием?",
    text: "АйДаКемп — загородная школа программирования с проживанием в лагере. В отличие от онлайн-курсов и городских кружков, ребята занимаются каждый день 7–14 дней подряд. Python, AI-инструменты, Minecraft и 3D-моделирование — реальный проект к финалу смены. Санаторий «Изумруд», 66 км от МКАД, Киевское шоссе."
  },
  {
    h2: "Чем это отличается от онлайн-курсов?",
    text: "Онлайн-курс даёт теорию. У нас — 7–15 дней полного погружения: занятия каждый день, преподаватель рядом, живое общение со сверстниками. За это время ребята проходят путь от первого кода до готового проекта."
  },
  {
    h2: "Какая программа обучения",
    text: "Обучение программированию разбито по направлениям (Python, AI, Minecraft, 3D-моделирование) и строится по принципу «от простого к сложному» внутри каждого трека.",
    list: [
      "День 1–2: знакомство, базовые концепции, первые шаги",
      "День 3–5: основной учебный блок, работа над проектом",
      "День 6–8: углубление, доработка, помощь преподавателя",
      "Финал: хакатон — защита проекта перед всеми"
    ]
  },
  {
    h2: "Кто преподаёт программирование?",
    text: "Команда АйДаКемп работает с детьми с 2021 года. Через офлайн-школу #АйДаКодить прошли более 1200 учеников. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей (тираж 2000 экз., продаётся в магазинах)."
  },
  {
    h2: "Кому подходит программа",
    text: "Мы принимали ребят с самыми разными интересами — даже тех, кого родители называли «ничем не увлекается». Формат подходит:",
    list: [
      "Любопытным — тем, кто спрашивает «как это работает» про всё, что видит",
      "Тихим и интровертным — мягкое вхождение в коллектив через общий проект",
      "Зависимым от игр — здесь они становятся создателями, а не только потребителями",
      "Будущим олимпиадникам — усиление перед осенними турами"
    ]
  },
  {
    h2: "Чем лагерь лучше онлайн-курса",
    text: "Обычные курсы — это 1–2 урока в неделю, домашка, выпал — догоняешь сам. У нас 10–14 дней концентрированной работы, и по учебному объёму это равно 3–4 месяцам онлайн-курса. Почему это работает:",
    list: [
      "В лагере нет отвлечений — телефон сдан, интернета в классе нет, внимание на задаче",
      "Ошибки в коде преподаватель разбирает рядом за 30 секунд, а не через 3 дня в переписке",
      "Ежедневная работа над проектом — это ежедневный прогресс",
      "Круг сверстников — мотивация не отставать от друзей",
      "Финальная защита — реальный дедлайн, учит доводить дело до результата"
    ]
  },
  {
    h2: "Что ребёнок получает после смены?",
    text: "Через 3 месяца после смены мы опрашиваем родителей — что поменялось. Стандартный ответ — «ребёнок сам сел за компьютер учиться дальше». Это не совпадение: за смену ребята впервые испытали «потоковое состояние» от работы над кодом. Можно считать это главным результатом: не конкретный проект, а открытие новой страсти, которая останется на годы. Короткие курсы такого не дают."
  },
  {
    h2: "Программа АйДаКемп по трекам",
    text: "Программа разделена по возрасту и уровню подготовки — каждый занимается в своём темпе:",
    list: [
      "Python (10–15 лет) — от синтаксиса и переменных до написания бота или игры. Самый популярный трек",
      "Scratch (7–10 лет) — визуальное программирование, анимации, простые игры. Для первого знакомства с логикой кода",
      "3D-моделирование и печать (10–14 лет) — Blender, создание объектов, прототипирование на 3D-принтере",
      "AI и нейросети (11–15 лет) — работа с ChatGPT API, Gemini, Stable Diffusion. Свой AI-ассистент или генератор"
    ]
  },
  {
    h2: "Расписание учебного дня",
    text: "Занятия встроены в день так, чтобы сохранить энергию на вечерние активности. Никакой зубрёжки — только практика.",
    list: [
      "9:00 — завтрак",
      "10:00–11:30 — первый блок: новая тема или работа над проектом",
      "13:00 — обед",
      "14:30–16:00 — второй блок: доработка проекта, помощь преподавателя",
      "16:00–20:00 — свободное время: бассейн, спорт, прогулки",
      "После ужина — вечерние активности или самостоятельная работа над проектом"
    ]
  },
  {
    h2: "Для кого подходит наша программа — и как быстро занять место",
    text: "АйДаКемп принимает школьников 7–15 лет. Опыт в программировании не нужен: есть группы для абсолютных новичков. Есть и продвинутые группы для тех, кто уже знаком с основами. Летние смены заполняются рано, группы до 8 человек — мест мало, особенно в июне.",
    list: [
      "Новички 7–10 лет — Scratch, первые алгоритмы, маленькие игры и мультфильмы",
      "Начинающие 10–12 лет — Python с нуля, свой бот или игра за смену",
      "Продолжающие 12–15 лет — Python Advanced, AI, работа с API, сложные проекты",
      "Цели разные: попробовать, подготовиться к олимпиаде или понять «моё это или нет» — для каждого свой трек"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/letnyaya-it-shkola.avif"
  title="Летняя IT-школа для детей — лагерь АйДаКодить, Подмосковье"
  description={`Летняя IT-школа программирования АйДаКодить — лагерь для детей 7–15 лет из Москвы и Подмосковья. Python, AI, Minecraft, смены 10 и 13 дней.`}
  h1="Летняя IT-школа программирования для детей — лагерь АйДаКодить"
  canonical="https://aidacamp.ru/letnyaya-it-shkola"
>
  <LandingHero slot="hero"
    h1="Летняя IT-школа программирования для детей — лагерь АйДаКодить"
    subtitle="Не обычный лагерь и не онлайн-курс — загородная IT-школа с проживанием, где ребёнок создаёт реальный проект."
    breadcrumb="Летняя IT-школа"
    keywords={["Авторская программа по Python, AI, Minecraft", "Преподаватели-практики с 6-летним опытом", "Загородный формат с проживанием и бассейном"]}
    image="/images/hero/letnyaya-it-shkola.avif"
    imageAlt="Занятия программированием в лагере АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Чем наша программа отличается от обычного лагеря?", a: "В обычном лагере ребёнок отдыхает, в IT-школе — создаёт. АйДаКемп совмещает: загородный формат с проживанием, бассейном и активностями + серьёзная IT-программа дважды в день. Результат — реальный проект в финале." },
    { q: "Чем наша программа отличается от онлайн-курса?", a: "10–14 дней в живой команде, без соцсетей и игр — только код и общение. Онлайн-курс это не даёт." },
    { q: "Для каких детей подходит наша программа?", a: "Для детей 7–15 лет. Опыт программирования не нужен. Есть группы для начинающих, среднего и продвинутого уровня — до 8 человек в группе." },
    { q: "Как долго длится смена?", a: `Сейчас открыты основные смены — 10 и 13 дней (${PRICE_S4} и ${PRICE_MAX}), ${OPEN_MONTHS_NOM} ${SEASON_YEAR}. Короткие летние смены 7–8 дней уже завершены.` },
    { q: "Нужен ли опыт программирования для поступления?", a: "Нет. В АйДаКемп есть группы для полных новичков: начинаем с основ логики и визуального программирования. Главное — желание попробовать. Диагностика на входе позволяет определить подходящий уровень для каждого ребёнка." }
  ]} only={['medicine', 'safety', 'food', 'accommodation']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
