---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';

const sections = [
  {
    h2: "Чем летняя IT-школа отличается от курсов",
    text: "Онлайн-курс даёт теорию. Кружок — 1–2 часа в неделю. Летняя IT-школа — это 7–14 дней полного погружения: занятия каждый день, преподаватель рядом, живое общение с такими же детьми. За это время ребёнок проходит путь от первого кода до готового проекта. Это невозможно в онлайне."
  },
  {
    h2: "Программа летней IT-школы",
    text: "Программа построена по принципу «от простого к сложному» внутри каждой смены.",
    list: [
      "День 1–2: знакомство, базовые концепции, первые шаги",
      "День 3–5: основной учебный блок, работа над проектом",
      "День 6–8: углубление, доработка, помощь преподавателя",
      "Финал: хакатон — защита проекта перед всеми"
    ]
  },
  {
    h2: "Преподаватели IT-школы",
    text: "Команда АйДаКемп работает с детьми с 2019 года. Через офлайн-школу #АйДаКодить прошли более 1200 учеников. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей (тираж 2000 экз., продаётся в магазинах)."
  },
  {
    h2: "Кто учится в летней IT-школе",
    text: "За 5 лет работы АйДаКемп мы принимали детей самых разных предпочтений. Общий портрет — ребёнок 7-14 лет, который проявлял интерес к компьютерам, играм или технологиям. Но есть и неожиданные истории: приходили дети-отличники, которые «должны знать это современно»; приходили дети, который родители называли «ничем не интересуется» — и впервые зажглись именно здесь. Наш формат подходит:",
    list: [
      "Любопытным — тем, кто задаёт «как это работает» про всё, что видит",
      "Тихим и интровертным — IT-школа даёт мягкое вхождение в коллектив через общий проект",
      "Зависимым от игр — здесь они переходят от потребителя к создателю",
      "Будущим школьным олимпиадникам — усиление перед осенними турами",
      "Детям программистов — первое знакомство с профессией родителей"
    ]
  },
  {
    h2: "IT-школа в лагере vs онлайн-школа программирования",
    text: "Онлайн-школа — это 2 урока в неделю, домашка, выпал — догоняй сам. Летняя IT-школа — это 10-14 дней концентрированной работы. В практических терминах — одна смена у нас даёт тот же учебный объём, что 3-4 месяца онлайн-курса. Почему? Потому что:",
    list: [
      "В лагере нет «отвлечения» — телефон сдан, интернета в классе нет, внимание 100% на задаче",
      "Ошибки в коде разбирает преподаватель рядом через 30 секунд, а не через 3 дня в переписке",
      "Ежедневная работа над проектом = ежедневный прогресс, а не «вспоминание прошлого урока»",
      "Круг сверстников — мотивация подтягиваться, чтобы не отстать от друзей",
      "Финальная защита — реальный дедлайн, ребёнок учится доводить до результата"
    ]
  },
  {
    h2: "Что остаётся с ребёнком после IT-школы",
    text: "Через 3 месяца после смены мы опрашиваем родителей — что поменялось. Стандартный ответ — «ребёнок сам сел за компьютер учиться дальше». Это не совпадение: за смену ребёнок впервые испытал «потоковое состояние» от работы над кодом. Он нашёл занятие, которое нравится и в котором он успешен. После такого опыта «неинтересно» — уже не вернётся. Можно считать это главным результатом летней IT-школы: не конкретный проект, а открытие новой страсти, которая останется на годы."
  }
];

---

<LandingLayout
  heroImage="/images/hero/letnyaya-it-shkola.avif"
  title="Летняя IT-школа для детей 2026 в Подмосковье — АйДаКемп"
  description="Летняя IT-школа с проживанием в Подмосковье. Программирование, AI, Minecraft для детей 7–14 лет. Авторская программа, преподаватели с опытом 6 лет. От 48 000 ₽."
  h1="Летняя IT-школа для детей в Подмосковье"
  canonical="https://aidacamp.ru/letnyaya-it-shkola"
>
  <LandingHero slot="hero"
    h1="Летняя IT-школа для детей в Подмосковье"
    subtitle="Не обычный лагерь и не онлайн-курс — загородная IT-школа с проживанием, где ребёнок создаёт реальный проект."
    breadcrumb="Летняя IT-школа"
    keywords={["Авторская программа по Python, AI, Minecraft", "Преподаватели-практики с 6-летним опытом", "Загородный формат с проживанием и бассейном"]}
    image="/images/hero/letnyaya-it-shkola.avif"
    imageAlt="Летняя IT-школа АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
