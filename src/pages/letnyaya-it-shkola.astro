---
import { DAYS_S21, DAYS_S22, DAYS_S3, DAYS_S4, PRICE_MAX, PRICE_MIN, PRICE_S4, SEASON_YEAR, daysNum } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import { OPEN_MONTHS_NOM } from '../data/evergreen';

const sections = [
  {
    h2: "Что такое летняя компьютерная школа с проживанием?",
    text: "АйДаКемп — загородная школа программирования с проживанием в лагере: ребята занимаются каждый день 7–14 дней подряд (обычные офлайн-школы — вечерние занятия пару раз в неделю). Python, AI-инструменты, Minecraft и 3D-моделирование — реальный проект к финалу смены. Школа расположена на базе санатория «Изумруд», 66 км от МКАД, Киевское шоссе."
  },
  {
    h2: "Чем это отличается от онлайн-курсов?",
    text: "Онлайн-курс даёт теорию. У нас — 7–15 дней полного погружения: занятия каждый день, преподаватель рядом, путь от первого кода до готового проекта. Это отличает нашу летнюю программу от школы у дома, где между уроками проходит неделя. Подробнее — чем загородный <a href='/obrazovatelnyy-lager/'>образовательный лагерь</a> отличается от разовых курсов."
  },
  {
    h2: "Какая программа обучения",
    text: "Наша школа делит обучение программированию на направления — Python, AI, Minecraft, 3D-моделирование — и строит его по принципу «от простого к сложному» внутри каждого трека.",
    list: [
      "День 1–2: знакомство, базовые концепции, первые шаги",
      "День 3–5: основной учебный блок, работа над проектом",
      "День 6–8: углубление, доработка",
      "Финал: хакатон — защита проекта перед всеми"
    ]
  },
  {
    h2: "Кто преподаёт программирование?",
    text: "АйДаКемп — школа, которая работает с ребятами с 2021 года. Через офлайн-школу #АйДаКодить прошли более 1200 учеников — этот опыт формирует программу нашей летней школы. Никита Брагин и Александр Ташкин — авторы учебника по Python для детей (тираж 2000 экз.)."
  },
  {
    h2: "Кому подходит программа",
    text: "В нашей школе бывали ребята с самыми разными интересами. Формат подходит:",
    list: [
      "Любопытным — кто спрашивает «как это работает»",
      "Тихим и интровертным — мягкое вхождение в коллектив через общий проект",
      "Зависимым от игр — здесь они становятся создателями",
      "Будущим олимпиадникам — усиление перед осенними турами"
    ]
  },
  {
    h2: "Программа АйДаКемп по трекам и возрасту",
    text: "Занятия распределены по возрасту и уровню — каждый в своём темпе:",
    list: [
      "Scratch (7–10 лет) — визуальное программирование, первые алгоритмы, анимации и простые игры",
      "Python (10–15 лет) — от синтаксиса и переменных до своего бота или игры. Самый популярный трек",
      "3D-моделирование и печать (10–14 лет) — Blender, создание объектов, прототипирование на 3D-принтере",
      "AI и нейросети (11–15 лет) — работа с ChatGPT API, Gemini, Stable Diffusion, свой AI-ассистент"
    ]
  },
  {
    h2: "Расписание учебного дня",
    text: "Обычная школа держит на зубрёжке, у нас — только практика.",
    list: [
      "9:00 — завтрак",
      "10:00–11:30 — первый блок: новая тема или работа над проектом",
      "13:00 — обед",
      "14:30–16:00 — второй блок: доработка проекта, помощь преподавателя",
      "16:00–20:00 — свободное время: бассейн, спорт, прогулки",
      "После ужина — вечерние активности или самостоятельная работа над проектом"
    ]
  },
  {
    h2: "Для кого подходит наша программа — и как быстро занять место",
    text: "Наша школа принимает школьников 7–15 лет из Москвы и Подмосковья. Опыт не нужен: в нашей школе есть группы для новичков и продвинутых, смену легко совмещать с обычной школой. Летние смены заполняются рано, группы до 8 человек.",
    list: [
      "Попробовать программирование впервые",
      "Подготовиться к олимпиаде",
      "Понять «моё это или нет» — для каждого свой трек"
    ]
  }
];

---

<LandingLayout
  heroImage="/images/hero/letnyaya-it-shkola.avif"
  title="Летняя IT-школа для детей — лагерь АйДаКодить, Подмосковье"
  description={`Летняя IT-школа программирования — лагерь для детей 7–15 лет из Москвы и Подмосковья. Python, AI, Minecraft, смены ${daysNum(DAYS_S4)} и ${DAYS_S3}.`}
  h1="Летняя IT-школа программирования для детей — лагерь АйДаКодить"
  canonical="https://aidacamp.ru/letnyaya-it-shkola"
  breadcrumb="Летняя IT-школа"
>
  <LandingHero slot="hero"
    h1="Летняя IT-школа программирования для детей — лагерь АйДаКодить"
    subtitle="Не обычный лагерь и не онлайн-курс — загородная IT-школа с проживанием, где ребёнок создаёт реальный проект."
    breadcrumb="Летняя IT-школа"
    keywords={["Авторская программа по Python, AI, Minecraft", "Преподаватели-практики с 6-летним опытом", "Загородный формат с проживанием и бассейном"]}
    image="/images/hero/letnyaya-it-shkola.avif"
    imageAlt="Занятия программированием в лагере АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Чем наша программа отличается от обычного лагеря?", a: "В обычном лагере ребёнок отдыхает, в IT-школе — создаёт. АйДаКемп совмещает: загородный формат с бассейном и серьёзная IT-программа дважды в день. Результат — реальный проект." },
    { q: "Чем наша программа отличается от онлайн-курса?", a: "10–14 дней в живой команде, без соцсетей — только код и общение." },
    { q: "Для каких детей подходит наша программа?", a: "Для детей 7–15 лет. Опыт программирования не нужен. Есть группы для начинающих, среднего и продвинутого уровня — до 8 человек в группе." },
    { q: `Как долго длились летние смены ${SEASON_YEAR} года?`, a: `Основные смены длились ${daysNum(DAYS_S4)} и ${DAYS_S3} (${PRICE_S4} и ${PRICE_MAX}). Короткие летние смены длились ${daysNum(DAYS_S21)}–${DAYS_S22}. Все они завершены.` },
    { q: "Нужен ли опыт программирования для поступления?", a: "Нет. Есть группы для полных новичков: начинаем с основ логики и визуального кода. Диагностика на входе определяет уровень." }
  ]} only={['medicine', 'safety', 'food', 'accommodation']} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
