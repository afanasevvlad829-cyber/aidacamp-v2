---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Откуда ехать из Серпухова",
    text: "АйДаКемп расположен в Наро-Фоминском районе Московской области, примерно в 70 км от Серпухова. Ближайший маршрут — по Симферопольскому шоссе на север до развязки с М-3, далее на Наро-Фоминск. В среднем около 1–1.5 часа езды. Организованный трансфер отправляется из Москвы (точка сбора — м. Солнцево), до которой из Серпухова около 45 минут. Многие семьи из Серпухова, Чехова и Ступино добираются самостоятельно до точки сбора, а дальше едут на автобусе лагеря."
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Дети 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты, авторы учебника по программированию для детей.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню: начинающие, средний уровень, продвинутые. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Дети без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "Дети с опытом — получат более сложные задачи и реальный проект",
      "Дети-геймеры — перенаправляем интерес в игры в продуктивное русло"
    ]
  },
  {
    h2: "Почему родители из Серпухова выбирают АйДаКемп",
    text: "Серпухов — город физиков и химиков: здесь расположен ИФВЭ (Институт физики высоких энергий), и академических семей немало. Родители из таких семей умеют отличить настоящую программу от декорации. АйДаКемп — реальный IT, а не кружок «как пользоваться компьютером».",
    list: [
      "Никакой акклиматизации — ребёнок едет в свой климат и часовой пояс",
      "Можно приехать проведать — ~100 км по Симферопольскому шоссе в любой день",
      "Трансфер от м. Солнцево — ~45 минут от Серпухова на машине до точки сбора",
      "Если что-то случится — рядом, не за тысячи километров"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "Команда АйДаКемп — это не студенты на летней подработке. Преподаватели — практикующие IT-специалисты, вожатые прошли отбор и обучение.",
    list: [
      "1 преподаватель на 6–8 участников — каждый получает внимание",
      "Медработник в лагере 24/7 — безопасность под контролем",
      "Telegram-канал с фото и видео каждый день — родители всегда в курсе",
      "Июль 2026 занят полностью. В июне и августе места есть — запишитесь сейчас"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Лагерь работает с июня по август 2026. Смены от 7 до 14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — платная опция (2 000 ₽ в одну сторону).",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней, 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 99 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽"
    ]
  },
  {
    h2: "Отзывы семей из Серпухова и юга Подмосковья",
    text: "В АйДаКемп едут семьи из Серпухова, Чехова, Ступино и всего юга Подмосковья. Вот что говорят родители:",
    list: [
      "«Доехали из Серпухова до Солнцево за 40 минут — дальше автобус лагеря забрал. Денис вернулся с готовым Python-проектом и кучей новых друзей» — Наталья, Серпухов",
      "«Дочка из Чехова сначала боялась ехать так далеко, но потом сама просилась на вторую смену. Говорит, в лагере всё понятно объясняют и не заставляют» — Ирина, Чехов",
      "«Мы из Ступино — добрались на машине до Солнцево за 50 минут. Зато 10 дней дочь провела с пользой: выучила основы программирования и похудела от купания в бассейне» — Светлана, Ступино"
    ]
  },
  {
    h2: "Маршрут из Серпухова до АйДаКемп",
    text: "Серпухов — юг Московской области, примерно 100 км от МКАД по Симферопольскому шоссе. До АйДаКемп: на машине по трассе М-2 → объезд Москвы по А-107 → Наро-Фоминск → санаторий «Изумруд», итого ~70 км от Серпухова, около 1 часа. Один из самых коротких маршрутов среди городов области — за счёт кольцевой трассы.",
    list: [
      "На машине: М-2 → А-107 (Малое кольцо) → Наро-Фоминск, ~70 км",
      "Время в пути: около 1 часа без пробок",
      "Трансфер: от м. Солнцево, 2 000 ₽ — удобен если без машины",
      "Координаты: 55.265643, 36.724185"
    ]
  },
  {
    h2: "Что ребёнок получит после смены",
    text: "Работающий проект в портфолио. Навык, который не устаревает — умение создавать программы остаётся с человеком. Первый опыт публичного питча — хакатон в конце смены. Новые друзья из других городов и школ. По данным 2025 года: 78% детей после смены продолжают заниматься программированием самостоятельно.",
    list: [
      "Готовый проект: бот, игра, сайт, AI-ассистент — зависит от трека",
      "Сертификат участника хакатона АйДаКемп",
      "Навык программирования: уровень, которого нет у большинства сверстников",
      "78% продолжают программировать дома после смены (опрос 2025)"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Летний детский лагерь рядом с Серпуховом 2026 — АйДаКемп"
  description="Детский IT-лагерь рядом с Серпуховом: ~70 км по Симферопольскому шоссе. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Серпуховом"
  canonical="https://aidacamp.ru/lager-serpuhov"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Серпухова до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Серпухова — ~70 км по Симферопольскому шоссе через Подольск на Наро-Фоминск, около 1.5 часа. Многие семьи из Серпухова добираются самостоятельно или доезжают до точки сбора в Москве (м. Солнцево)." }
        },
        {
          "@type": "Question",
          "name": "Нужен ли опыт программирования?",
          "acceptedAnswer": { "@type": "Answer", "text": "Нет. Принимаем детей 7–15 лет с любым уровнем подготовки. Группы: начинающие — с нуля, средний — есть базовые знания, продвинутые — уверенный уровень. Занятия в группах до 8 человек." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проживание (комнаты 2–4 чел. с санузлом), 5-разовое питание, IT-программа, бассейн, вечерние активности, страховка. Трансфер из Москвы — 2 000 ₽ отдельно." }
        },
        {
          "@type": "Question",
          "name": "Когда проходят смены в 2026 году?",
          "acceptedAnswer": { "@type": "Answer", "text": "Четыре основные смены: 30 мая–8 июня (10 дней), 10–23 июня (14 дней), 3–15 августа (13 дней), 17–26 августа (10 дней). Короткие смены 7–8 дней в июне и августе." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Серпуховом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, ~70 км от Серпухова. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-serpuhov"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Серпуховом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~70 км от Серпухова по Симферопольскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Серпухова"
    keywords={["~70 км от Серпухова (~1–1.5 часа)", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский лагерь рядом с Серпуховом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
