---
export const prerender = false;

interface ABTest {
  id: number;
  test_date: string;
  baseline_ctr: number;
  test_value_ctr: number;
  ctr_change_pct: number;
  baseline_conversions: number;
  test_value_conversions: number;
  conversions_change_pct: number;
  alert_level: string;
  summary_message: string;
}

interface Alert {
  id: number;
  metric: string;
  old_value: number;
  new_value: number;
  change_pct: number;
  alert_level: string;
  message: string;
  action_taken?: string;
  telegram_sent: boolean;
  created_at: string;
}

interface DashboardData {
  timestamp: string;
  ab_tests: ABTest[];
  alerts: Alert[];
  summary: {
    total_tests: number;
    critical_alerts: number;
    reverts_executed: number;
    last_test_date?: string;
    last_alert_date?: string;
  };
}

let data: DashboardData = {
  timestamp: new Date().toISOString(),
  ab_tests: [],
  alerts: [],
  summary: {
    total_tests: 0,
    critical_alerts: 0,
    reverts_executed: 0,
  },
};

try {
  const response = await fetch('http://localhost:4181/api/ab-monitor-data?limit=30');
  if (response.ok) {
    data = await response.json();
  }
} catch (error) {
  console.error('Failed to fetch dashboard data:', error);
}
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SERP CTR A/B Monitor — AidaCamp</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
    }

    header {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 30px;
    }

    h1 {
      color: #1a202c;
      margin-bottom: 10px;
      font-size: 28px;
    }

    .subtitle {
      color: #718096;
      font-size: 14px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .summary-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
    }

    .summary-card h3 {
      font-size: 12px;
      opacity: 0.8;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .summary-card .value {
      font-size: 32px;
      font-weight: bold;
    }

    .summary-card.critical {
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .summary-card.success {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .content {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
      margin-bottom: 30px;
    }

    @media (max-width: 1024px) {
      .content {
        grid-template-columns: 1fr;
      }
    }

    .section {
      background: white;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .section h2 {
      font-size: 18px;
      color: #1a202c;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #e2e8f0;
    }

    .test-item {
      padding: 15px;
      margin-bottom: 15px;
      border-left: 4px solid #667eea;
      background: #f8f9fa;
      border-radius: 4px;
    }

    .test-item.critical {
      border-left-color: #f5576c;
      background: #fff5f7;
    }

    .test-item.warning {
      border-left-color: #ffa502;
      background: #fffbf5;
    }

    .test-date {
      font-weight: bold;
      color: #1a202c;
      margin-bottom: 8px;
    }

    .test-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 10px;
      font-size: 13px;
    }

    .metric {
      display: flex;
      flex-direction: column;
    }

    .metric-label {
      color: #718096;
      font-size: 11px;
      margin-bottom: 3px;
    }

    .metric-value {
      color: #1a202c;
      font-weight: 600;
    }

    .change {
      margin-top: 8px;
      padding: 8px;
      background: white;
      border-radius: 3px;
      font-size: 13px;
      color: #718096;
    }

    .change.positive {
      color: #22863a;
      background: #f0f9f1;
    }

    .change.negative {
      color: #cb2431;
      background: #ffeef0;
    }

    .alert-item {
      padding: 12px;
      margin-bottom: 10px;
      border-left: 4px solid #667eea;
      background: #f0f4ff;
      border-radius: 4px;
      font-size: 13px;
    }

    .alert-item.critical {
      border-left-color: #f5576c;
      background: #fff5f7;
    }

    .alert-item.warning {
      border-left-color: #ffa502;
      background: #fffbf5;
    }

    .alert-metric {
      font-weight: 600;
      color: #1a202c;
      margin-bottom: 4px;
    }

    .alert-message {
      color: #718096;
      font-size: 12px;
      margin-top: 4px;
    }

    .alert-status {
      margin-top: 6px;
      font-size: 11px;
      padding: 4px 6px;
      background: rgba(0, 0, 0, 0.05);
      border-radius: 2px;
      color: #718096;
    }

    .no-data {
      color: #718096;
      text-align: center;
      padding: 40px;
      font-size: 14px;
    }

    .timestamp {
      color: #a0aec0;
      font-size: 12px;
      margin-top: 20px;
      text-align: right;
    }

    .status-badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 600;
      margin-left: 8px;
    }

    .status-badge.critical {
      background: #f5576c;
      color: white;
    }

    .status-badge.warning {
      background: #ffa502;
      color: white;
    }

    .status-badge.ok {
      background: #00f2fe;
      color: white;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1>📊 SERP CTR A/B Monitor</h1>
        <p class="subtitle">Automated monitoring & statistical analysis for SERP optimization (PR #209)</p>
      </div>

      <div class="summary-grid">
        <div class="summary-card">
          <h3>Total Tests</h3>
          <div class="value">{data.summary.total_tests}</div>
        </div>

        <div class="summary-card critical">
          <h3>Critical Alerts</h3>
          <div class="value">{data.summary.critical_alerts}</div>
        </div>

        <div class="summary-card success">
          <h3>Auto-Reverts</h3>
          <div class="value">{data.summary.reverts_executed}</div>
        </div>

        <div class="summary-card">
          <h3>Last Test</h3>
          <div class="value" style="font-size: 14px;">
            {data.summary.last_test_date
              ? new Date(data.summary.last_test_date).toLocaleDateString('ru-RU')
              : 'N/A'}
          </div>
        </div>
      </div>
    </header>

    <div class="content">
      <section class="section">
        <h2>📈 A/B Test Results</h2>

        {data.ab_tests.length > 0 ? (
          <div>
            {data.ab_tests.map((test) => (
              <div class={`test-item ${test.alert_level === 'critical' ? 'critical' : test.alert_level === 'warning' ? 'warning' : ''}`}>
                <div class="test-date">
                  {new Date(test.test_date).toLocaleDateString('ru-RU')}
                  <span class={`status-badge ${test.alert_level}`}>
                    {test.alert_level === 'critical' ? '🚨' : test.alert_level === 'warning' ? '⚠️' : '✅'} {test.alert_level.toUpperCase()}
                  </span>
                </div>

                <div class="test-metrics">
                  <div class="metric">
                    <span class="metric-label">CTR Before</span>
                    <span class="metric-value">{test.baseline_ctr.toFixed(2)}%</span>
                  </div>
                  <div class="metric">
                    <span class="metric-label">CTR After</span>
                    <span class="metric-value">{test.test_value_ctr.toFixed(2)}%</span>
                  </div>
                  <div class="metric">
                    <span class="metric-label">CTR Change</span>
                    <span class={`metric-value ${test.ctr_change_pct >= 0 ? 'positive' : 'negative'}`}>
                      {test.ctr_change_pct > 0 ? '+' : ''}{test.ctr_change_pct.toFixed(1)}%
                    </span>
                  </div>
                </div>

                <div class="change" class:positive={test.ctr_change_pct >= 0} class:negative={test.ctr_change_pct < 0}>
                  <strong>Summary:</strong> {test.summary_message}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="no-data">No test results yet. Waiting for first monitoring cycle...</div>
        )}

        <div class="timestamp">Updated: {new Date(data.timestamp).toLocaleString('ru-RU')}</div>
      </section>

      <section class="section">
        <h2>🚨 Recent Alerts</h2>

        {data.alerts.length > 0 ? (
          <div>
            {data.alerts.slice(0, 10).map((alert) => (
              <div class={`alert-item ${alert.alert_level}`}>
                <div class="alert-metric">
                  {alert.metric.toUpperCase()} {alert.alert_level === 'critical' ? '🔴' : '🟡'}
                </div>
                <div class="alert-message">{alert.message}</div>
                <div class="alert-status">
                  {alert.old_value.toFixed(1)} → {alert.new_value.toFixed(1)} ({alert.change_pct > 0 ? '+' : ''}{alert.change_pct.toFixed(1)}%)
                  {alert.action_taken && ` • Action: ${alert.action_taken}`}
                  {alert.telegram_sent && ' • ✅ Notified'}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="no-data">No alerts. Everything is looking good! ✨</div>
        )}
      </section>
    </div>

    <section class="section">
      <h2>📋 System Status</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; font-size: 14px;">
        <div>
          <strong>Scripts Status:</strong>
          <ul style="margin-top: 10px; color: #718096;">
            <li>✅ serp-analyze-ab.sh — Analysis engine (daily 10:30 MSK)</li>
            <li>✅ serp-telegram-notifier.sh — Alert bot (every 15 min)</li>
            <li>✅ serp-auto-revert.sh — Auto-rollback (every 30 min)</li>
          </ul>
        </div>

        <div>
          <strong>Monitoring Thresholds:</strong>
          <ul style="margin-top: 10px; color: #718096;">
            <li>🚨 CTR drop > 15% — Auto-revert</li>
            <li>🚨 Conversions drop > 30% — Auto-revert</li>
            <li>🟡 CTR drop 5–15% — Warning</li>
            <li>📊 p-value < 0.05 — Significant</li>
          </ul>
        </div>

        <div>
          <strong>Baseline Period:</strong>
          <ul style="margin-top: 10px; color: #718096;">
            <li>📅 Last 7 days before optimization</li>
            <li>📍 Optimization date: 2026-05-04</li>
            <li>🔄 Tested against: yesterday's metrics</li>
            <li>📞 Telegram: @aida_traf_bot</li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
