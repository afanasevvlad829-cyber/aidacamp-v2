---
export const prerender = false;
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

async function readConfig() {
  for (const p of ['/var/www/aidacamp-dev/gbp-config.json', join(process.cwd(), 'gbp-config.json')]) {
    try { return JSON.parse(await readFile(p, 'utf8')); } catch { /* skip */ }
  }
  return {};
}
const cfg = await readConfig();
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GBP Setup — АйДаКемп</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0d1a2b; color: #e2e8f0; min-height: 100vh; padding: 32px 16px; }
    .wrap { max-width: 640px; margin: 0 auto; }
    h1 { font-size: 22px; font-weight: 700; color: #f1f5f9; margin-bottom: 8px; }
    .sub { font-size: 14px; color: #94a3b8; margin-bottom: 28px; }
    .card { background: #152a46; border: 1px solid #334155; border-radius: 14px; padding: 20px 24px; margin-bottom: 20px; }
    .card h2 { font-size: 15px; font-weight: 600; color: #f1f5f9; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .step-num { background: #ec7c00; color: #fff; width: 22px; height: 22px; border-radius: 50%; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    label { display: block; font-size: 13px; color: #94a3b8; margin-bottom: 5px; }
    input { width: 100%; background: #0d1a2b; border: 1px solid #334155; border-radius: 8px; padding: 9px 12px; font-size: 14px; color: #f1f5f9; outline: none; font-family: inherit; }
    input:focus { border-color: #ec7c00; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .field { margin-bottom: 12px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; background: #ec7c00; color: #fff; border: none; border-radius: 10px; padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background .15s; }
    .btn:hover { background: #ea6c0a; }
    .btn-sec { background: #334155; color: #e2e8f0; }
    .btn-sec:hover { background: #3f5168; }
    .status { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 14px; display: none; }
    .status.ok  { background: #052e16; color: #86efac; border: 1px solid #15803d; display: block; }
    .status.err { background: #1c0a0a; color: #fca5a5; border: 1px solid #991b1b; display: block; }
    .status.info { background: #0c1a2e; color: #93c5fd; border: 1px solid #1d4ed8; display: block; }
    .badge { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
    .badge.ok  { background: #052e16; color: #86efac; }
    .badge.err { background: #1c0a0a; color: #fca5a5; }
    .check-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #152a46; font-size: 14px; color: #94a3b8; }
    .check-row:last-child { border-bottom: none; }
    a { color: #ec7c00; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .code { font-family: monospace; background: #0d1a2b; padding: 2px 6px; border-radius: 4px; font-size: 13px; color: #e2e8f0; }
    .hint { font-size: 12px; color: #64748b; margin-top: 4px; }
    .accounts-list { margin-top: 10px; }
    .acc-item { padding: 8px 10px; background: #0d1a2b; border-radius: 8px; margin-bottom: 6px; cursor: pointer; border: 1px solid transparent; font-size: 13px; }
    .acc-item:hover { border-color: #ec7c00; }
    .acc-item .name { font-weight: 600; color: #f1f5f9; }
    .acc-item .id { color: #64748b; font-size: 12px; font-family: monospace; }
    .tabs { display: flex; gap: 0; margin-bottom: 20px; }
    .tab { padding: 8px 18px; font-size: 14px; font-weight: 500; cursor: pointer; border: 1px solid #334155; color: #94a3b8; background: transparent; transition: all .15s; }
    .tab:first-child { border-radius: 8px 0 0 8px; }
    .tab:last-child { border-radius: 0 8px 8px 0; }
    .tab.active { background: #ec7c00; border-color: #ec7c00; color: #fff; }
  </style>
</head>
<body>
<div class="wrap">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px">
    <a href="/admin/gbp-posts/" style="color:#64748b;font-size:13px">← к постам</a>
  </div>

  <h1>Подключение Google Business Profile</h1>
  <p class="sub">Настройте один раз — потом публикуйте посты прямо с сайта.</p>

  <!-- Статус конфигурации -->
  <div class="card" id="statusCard">
    <h2>Текущий статус</h2>
    <div id="statusContent" style="color:#64748b;font-size:14px">Проверяю...</div>
  </div>

  <!-- Шаг 1: Создать OAuth приложение -->
  <div class="card">
    <h2><span class="step-num">1</span> Создать OAuth-приложение в Google Cloud</h2>
    <ol style="font-size:13px;color:#94a3b8;line-height:1.8;padding-left:18px;margin-bottom:14px">
      <li>Открой <a href="https://console.cloud.google.com/apis/credentials" target="_blank">console.cloud.google.com → APIs & Credentials</a></li>
      <li>Создай проект (или выбери существующий)</li>
      <li>Включи API: <strong>My Business API</strong> + <strong>Business Profile Performance API</strong></li>
      <li>Создай <strong>OAuth 2.0 Client ID</strong> (тип: Web application)</li>
      <li>В Authorized redirect URIs добавь:<br>
        <span class="code" id="callbackUri"></span>
      </li>
      <li>Скопируй Client ID и Client Secret ниже</li>
    </ol>
    <div class="row">
      <div class="field">
        <label>Client ID</label>
        <input id="clientId" type="text" placeholder="xxx.apps.googleusercontent.com" value={cfg.clientId ?? ''} />
      </div>
      <div class="field">
        <label>Client Secret</label>
        <input id="clientSecret" type="password" placeholder="GOCSPX-..." value={cfg.clientSecret ?? ''} />
      </div>
    </div>
    <button class="btn btn-sec" onclick="saveCreds()">Сохранить credentials</button>
    <div id="credsStatus" class="status"></div>
  </div>

  <!-- Шаг 2: Авторизация -->
  <div class="card">
    <h2><span class="step-num">2</span> Авторизовать Google аккаунт</h2>
    <p style="font-size:13px;color:#94a3b8;margin-bottom:14px">
      Нажми кнопку — откроется Google. Войди в аккаунт, у которого есть доступ к Business Profile. Страница автоматически вернётся сюда.
    </p>
    <button class="btn" onclick="startOAuth()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Войти через Google
    </button>
    <div id="oauthStatus" class="status"></div>
  </div>

  <!-- Шаг 3: Выбрать локацию -->
  <div class="card">
    <h2><span class="step-num">3</span> Выбрать локацию бизнеса</h2>
    <p style="font-size:13px;color:#94a3b8;margin-bottom:14px">
      После авторизации выбери аккаунт и локацию АйДаКемп из списка, либо введи вручную.
    </p>
    <div id="accountsList" style="display:none"></div>
    <div class="row">
      <div class="field">
        <label>Account ID</label>
        <input id="accountId" type="text" placeholder="accounts/123456789" />
        <p class="hint">Формат: accounts/ЧИСЛО</p>
      </div>
      <div class="field">
        <label>Location ID</label>
        <input id="locationId" type="text" placeholder="locations/987654321" />
        <p class="hint">Из GBP → Бизнес-профиль → Настройки → ID</p>
      </div>
    </div>
    <button class="btn" onclick="saveLocation()">Сохранить локацию</button>
    <button class="btn btn-sec" style="margin-left:10px" onclick="loadAccounts()">Загрузить аккаунты</button>
    <div id="locationStatus" class="status"></div>
  </div>

</div>

<script is:inline>
  const callbackUri = window.location.origin + '/admin/gbp-callback';
  document.getElementById('callbackUri').textContent = callbackUri;

  // Проверить статус
  async function checkStatus() {
    const r = await fetch('/api/gbp-auth');
    const d = await r.json();
    const el = document.getElementById('statusContent');
    const rows = [
      { label: 'OAuth credentials', ok: !!d.hasRefreshToken },
      { label: 'Refresh token', ok: !!d.hasRefreshToken },
      { label: 'Location настроен', ok: !!d.hasLocation },
      { label: 'Полностью готов', ok: !!d.configured },
    ];
    el.innerHTML = rows.map(r => `
      <div class="check-row">
        <span>${r.label}</span>
        <span class="badge ${r.ok ? 'ok' : 'err'}">${r.ok ? '✓' : '✗'}</span>
      </div>
    `).join('');
    if (d.configured) {
      document.getElementById('statusCard').style.border = '1px solid #15803d';
    }
    if (d.accountId) document.getElementById('accountId').value = d.accountId;
    if (d.locationId) document.getElementById('locationId').value = d.locationId;
  }
  checkStatus();

  // Проверить OAuth callback
  const params = new URLSearchParams(window.location.search);
  if (params.get('done') === '1') {
    const s = document.getElementById('oauthStatus');
    s.textContent = '✓ Авторизация успешна! Refresh token сохранён.';
    s.className = 'status ok';
    checkStatus();
  }

  async function saveCreds() {
    const clientId = document.getElementById('clientId').value.trim();
    const clientSecret = document.getElementById('clientSecret').value.trim();
    const el = document.getElementById('credsStatus');
    if (!clientId || !clientSecret) { el.textContent = 'Заполни оба поля'; el.className = 'status err'; return; }
    const r = await fetch('/api/gbp-auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clientId, clientSecret, redirectUri: callbackUri }) });
    const d = await r.json();
    if (d.ok) { el.textContent = '✓ Сохранено'; el.className = 'status ok'; }
    else { el.textContent = d.error; el.className = 'status err'; }
  }

  async function startOAuth() {
    const r = await fetch('/api/gbp-auth?action=url');
    const d = await r.json();
    const el = document.getElementById('oauthStatus');
    if (!d.ok) { el.textContent = d.error; el.className = 'status err'; return; }
    window.location.href = d.url;
  }

  async function loadAccounts() {
    const r = await fetch('/api/gbp-auth?action=accounts');
    const d = await r.json();
    const el = document.getElementById('accountsList');
    if (!d.ok || !d.accounts?.length) { el.style.display = 'block'; el.innerHTML = '<p style="font-size:13px;color:#64748b">Нет аккаунтов или не авторизован</p>'; return; }
    el.style.display = 'block';
    el.innerHTML = '<p style="font-size:12px;color:#64748b;margin-bottom:8px">Кликни на аккаунт чтобы выбрать:</p>' + d.accounts.map(a => `
      <div class="acc-item" onclick="selectAccount('${a.name}')">
        <div class="name">${a.accountName}</div>
        <div class="id">${a.name}</div>
      </div>`).join('');
  }

  function selectAccount(name) {
    document.getElementById('accountId').value = name;
  }

  async function saveLocation() {
    const accountId = document.getElementById('accountId').value.trim();
    const locationId = document.getElementById('locationId').value.trim();
    const el = document.getElementById('locationStatus');
    if (!accountId || !locationId) { el.textContent = 'Заполни оба поля'; el.className = 'status err'; return; }
    const r = await fetch('/api/gbp-auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accountId, locationId }) });
    const d = await r.json();
    if (d.ok) { el.textContent = '✓ Сохранено! Можно публиковать посты.'; el.className = 'status ok'; checkStatus(); }
    else { el.textContent = d.error; el.className = 'status err'; }
  }
</script>
</body>
</html>
