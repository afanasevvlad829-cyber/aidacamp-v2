---
import Layout from '@/layouts/Base.astro'
---

<Layout title="Portal Audit — Visual Monitoring">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 p-4">
    <!-- Header -->
    <header class="mb-6">
      <h1 class="text-4xl font-bold text-white mb-2">🔍 Full Portal Audit — Live Monitoring</h1>
      <p class="text-slate-400">5 agents with visible browsers + DevTools + Real-time status</p>
    </header>

    <!-- Control Panel -->
    <div class="bg-slate-800 rounded-lg p-6 mb-6 border border-slate-700">
      <div class="flex gap-4 mb-6">
        <button id="startBtn" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg">
          <i class="bi bi-play-circle"></i> START FULL AUDIT
        </button>
        <button id="stopBtn" disabled class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg">
          <i class="bi bi-stop-circle"></i> STOP
        </button>
        <button id="screenshotBtn" disabled class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg">
          <i class="bi bi-camera"></i> SCREENSHOT ALL
        </button>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="bg-slate-900 p-3 rounded">
          <span class="text-slate-400">Status:</span>
          <span id="auditStatus" class="text-yellow-400 font-bold ml-2">READY</span>
        </div>
        <div class="bg-slate-900 p-3 rounded">
          <span class="text-slate-400">Elapsed:</span>
          <span id="elapsedTime" class="text-blue-400 font-bold ml-2">00:00</span>
        </div>
        <div class="bg-slate-900 p-3 rounded">
          <span class="text-slate-400">Agents Active:</span>
          <span id="activeAgents" class="text-green-400 font-bold ml-2">0/5</span>
        </div>
        <div class="bg-slate-900 p-3 rounded">
          <span class="text-slate-400">Issues Found:</span>
          <span id="issuesFound" class="text-red-400 font-bold ml-2">0</span>
        </div>
      </div>
    </div>

    <!-- 5x2 Grid for Agent Windows -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
      <!-- Agent 1: Code Security -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-white">📋 Code Security Audit</h3>
            <p class="text-xs text-slate-400">OAuth, Race conditions, Input validation</p>
          </div>
          <span class="agent-status text-slate-400 font-mono text-sm">pending</span>
        </div>
        <iframe class="agent-iframe flex-1 border-0" data-agent="1"></iframe>
        <div class="agent-log bg-black p-2 border-t border-slate-700 h-24 overflow-y-auto font-mono text-xs text-green-400"></div>
      </div>

      <!-- Agent 2: OAuth Testing -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-white">🔐 OAuth Provider Testing</h3>
            <p class="text-xs text-slate-400">Telegram, Google, GitHub flows</p>
          </div>
          <span class="agent-status text-slate-400 font-mono text-sm">pending</span>
        </div>
        <iframe class="agent-iframe flex-1 border-0" data-agent="2"></iframe>
        <div class="agent-log bg-black p-2 border-t border-slate-700 h-24 overflow-y-auto font-mono text-xs text-green-400"></div>
      </div>

      <!-- Agent 3: Performance & DOS -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-white">⚡ Performance & DOS Audit</h3>
            <p class="text-xs text-slate-400">Rate limiting, Lighthouse, Load testing</p>
          </div>
          <span class="agent-status text-slate-400 font-mono text-sm">pending</span>
        </div>
        <iframe class="agent-iframe flex-1 border-0" data-agent="3"></iframe>
        <div class="agent-log bg-black p-2 border-t border-slate-700 h-24 overflow-y-auto font-mono text-xs text-green-400"></div>
      </div>

      <!-- Agent 4: Input Validation -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-white">🛡️ Input Validation & XSS/SQLi</h3>
            <p class="text-xs text-slate-400">Payload testing, CSRF tokens</p>
          </div>
          <span class="agent-status text-slate-400 font-mono text-sm">pending</span>
        </div>
        <iframe class="agent-iframe flex-1 border-0" data-agent="4"></iframe>
        <div class="agent-log bg-black p-2 border-t border-slate-700 h-24 overflow-y-auto font-mono text-xs text-green-400"></div>
      </div>

      <!-- Agent 5: Database Security -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-white">🗄️ Database Security</h3>
            <p class="text-xs text-slate-400">Constraints, Uniqueness, Audit logging</p>
          </div>
          <span class="agent-status text-slate-400 font-mono text-sm">pending</span>
        </div>
        <iframe class="agent-iframe flex-1 border-0" data-agent="5"></iframe>
        <div class="agent-log bg-black p-2 border-t border-slate-700 h-24 overflow-y-auto font-mono text-xs text-green-400"></div>
      </div>

      <!-- DevTools Console (shared) -->
      <div class="agent-window bg-slate-800 rounded-lg border border-slate-700 overflow-hidden flex flex-col h-[600px]">
        <div class="bg-slate-900 p-3 border-b border-slate-700">
          <h3 class="font-bold text-white">🖥️ DevTools Console</h3>
          <p class="text-xs text-slate-400">Network errors, console messages, warnings</p>
        </div>
        <div class="flex-1 bg-black p-3 overflow-y-auto font-mono text-xs">
          <div id="devtoolsConsole" class="space-y-1">
            <span class="text-gray-500">[Ready to start audit...]</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Summary Statistics -->
    <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
      <h2 class="text-xl font-bold text-white mb-4">📊 Audit Summary</h2>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <div class="bg-red-900 bg-opacity-30 p-3 rounded border border-red-600">
          <div class="text-red-200 text-sm">CRITICAL</div>
          <div id="count-critical" class="text-3xl font-bold text-red-400">0</div>
        </div>
        <div class="bg-orange-900 bg-opacity-30 p-3 rounded border border-orange-600">
          <div class="text-orange-200 text-sm">HIGH</div>
          <div id="count-high" class="text-3xl font-bold text-orange-400">0</div>
        </div>
        <div class="bg-yellow-900 bg-opacity-30 p-3 rounded border border-yellow-600">
          <div class="text-yellow-200 text-sm">MEDIUM</div>
          <div id="count-medium" class="text-3xl font-bold text-yellow-400">0</div>
        </div>
        <div class="bg-blue-900 bg-opacity-30 p-3 rounded border border-blue-600">
          <div class="text-blue-200 text-sm">LOW</div>
          <div id="count-low" class="text-3xl font-bold text-blue-400">0</div>
        </div>
        <div class="bg-green-900 bg-opacity-30 p-3 rounded border border-green-600">
          <div class="text-green-200 text-sm">PASSED</div>
          <div id="count-passed" class="text-3xl font-bold text-green-400">0</div>
        </div>
      </div>

      <div id="findingsList" class="mt-6 space-y-2 max-h-96 overflow-y-auto">
        <!-- Findings will appear here -->
      </div>
    </div>
  </div>

  <script>
    let auditRunId: string | null = null
    let startTime: number | null = null
    let timerInterval: NodeJS.Timeout | null = null

    const startBtn = document.getElementById('startBtn')!
    const stopBtn = document.getElementById('stopBtn')!
    const screenshotBtn = document.getElementById('screenshotBtn')!
    const auditStatus = document.getElementById('auditStatus')!
    const elapsedTime = document.getElementById('elapsedTime')!
    const activeAgents = document.getElementById('activeAgents')!
    const devtoolsConsole = document.getElementById('devtoolsConsole')!

    startBtn.addEventListener('click', async () => {
      startBtn.disabled = true
      stopBtn.disabled = false
      screenshotBtn.disabled = false
      auditStatus.textContent = 'STARTING'
      auditStatus.className = 'text-yellow-400 font-bold ml-2'

      startTime = Date.now()
      timerInterval = setInterval(updateTimer, 1000)

      // Launch browsers for each agent
      await launchAgentBrowsers()

      auditStatus.textContent = 'RUNNING'
      auditStatus.className = 'text-green-400 font-bold ml-2'

      // Start polling for updates
      pollAuditProgress()
    })

    stopBtn.addEventListener('click', () => {
      if (timerInterval) clearInterval(timerInterval)
      auditStatus.textContent = 'STOPPED'
      auditStatus.className = 'text-red-400 font-bold ml-2'
      stopBtn.disabled = true
    })

    screenshotBtn.addEventListener('click', async () => {
      const timestamp = new Date().toLocaleTimeString()
      addDevtoolsLog(`📷 Capturing screenshots (${timestamp})...`)
      // In real implementation, capture from each iframe
    })

    function updateTimer() {
      if (!startTime) return
      const elapsed = Math.floor((Date.now() - startTime) / 1000)
      const minutes = Math.floor(elapsed / 60)
      const seconds = elapsed % 60
      elapsedTime.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
    }

    async function launchAgentBrowsers() {
      const agents = [
        { id: 1, name: 'Code Security', port: 3001 },
        { id: 2, name: 'OAuth Testing', port: 3002 },
        { id: 3, name: 'Performance', port: 3003 },
        { id: 4, name: 'Input Validation', port: 3004 },
        { id: 5, name: 'Database Security', port: 3005 },
      ]

      for (const agent of agents) {
        const iframe = document.querySelector(`iframe[data-agent="${agent.id}"]`) as HTMLIFrameElement | null
        if (iframe) {
          // In production, launch actual browser via tmux/Xvfb
          iframe.src = `http://localhost:${agent.port}`

          // Update status
          const window = document.querySelector(`.agent-window:nth-child(${agent.id})`)
          if (window) {
            const status = window.querySelector('.agent-status')!
            status.textContent = 'running'
            status.className = 'agent-status text-green-400 font-mono text-sm'
          }

          addDevtoolsLog(`✅ Agent ${agent.id} (${agent.name}) launched on port ${agent.port}`)
        }
      }

      // Update active agents count
      updateActiveAgents()
    }

    function updateActiveAgents() {
      const running = document.querySelectorAll('.agent-status').length
      activeAgents.textContent = `${running}/5`
    }

    function pollAuditProgress() {
      // Poll for updates every 2 seconds
      const pollInterval = setInterval(async () => {
        try {
          // Fetch current audit progress
          const response = await fetch('/api/admin/portal-audit-progress')
          const data = await response.json()

          if (data.success && data.data) {
            // Update agent statuses
            data.data.agents?.forEach((agent: any) => {
              const window = document.querySelector(`.agent-window:nth-child(${agent.id})`)
              if (window) {
                const status = window.querySelector('.agent-status')!
                status.textContent = agent.status
                status.className = agent.status === 'completed' ? 'agent-status text-green-400 font-mono text-sm' : agent.status === 'running' ? 'agent-status text-yellow-400 font-mono text-sm' : 'agent-status text-slate-400 font-mono text-sm'
              }
            })

            // Update issue counts
            updateIssueCounts(data.data.issues)

            // Update DevTools console
            data.data.logs?.forEach((log: string) => {
              addDevtoolsLog(log)
            })

            // Check if complete
            if (data.data.status === 'completed') {
              clearInterval(pollInterval)
              auditStatus.textContent = 'COMPLETED'
              auditStatus.className = 'text-green-400 font-bold ml-2'
              stopBtn.disabled = true
            }
          }
        } catch (err) {
          console.error('Poll error:', err)
        }
      }, 2000)
    }

    function updateIssueCounts(issues: Record<string, number>) {
      document.getElementById('count-critical')!.textContent = String(issues.CRITICAL || 0)
      document.getElementById('count-high')!.textContent = String(issues.HIGH || 0)
      document.getElementById('count-medium')!.textContent = String(issues.MEDIUM || 0)
      document.getElementById('count-low')!.textContent = String(issues.LOW || 0)
      document.getElementById('count-passed')!.textContent = String(issues.PASSED || 0)
    }

    function addDevtoolsLog(message: string) {
      const line = document.createElement('div')
      const timestamp = new Date().toLocaleTimeString()
      line.textContent = `[${timestamp}] ${message}`

      // Color code by message type
      if (message.includes('ERROR') || message.includes('❌')) {
        line.className = 'text-red-400'
      } else if (message.includes('WARN') || message.includes('⚠️')) {
        line.className = 'text-yellow-400'
      } else if (message.includes('✅')) {
        line.className = 'text-green-400'
      } else if (message.includes('ℹ️') || message.includes('INFO')) {
        line.className = 'text-blue-400'
      } else {
        line.className = 'text-gray-400'
      }

      devtoolsConsole.appendChild(line)
      devtoolsConsole.scrollTop = devtoolsConsole.scrollHeight

      // Keep only last 100 lines
      while (devtoolsConsole.children.length > 100) {
        devtoolsConsole.removeChild(devtoolsConsole.children[0])
      }
    }

    // Initial log
    addDevtoolsLog('🟢 Dashboard ready. Click START FULL AUDIT to begin.')
  </script>
</Layout>
