---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import VideoGallery from '../components/VideoGallery.astro';
import ArticleBottomCta from '../components/ArticleBottomCta.astro';

const videos = [
  {
    id: 'v1',
    file: '01_sovremennye_lageri.mp4',
    poster: '/videos/darya/01_sovremennye_lageri.jpg',
    num: '01',
    title: 'Современные лагеря',
    question: 'Изменились ли детские лагеря и остались ли пионерские?',
    duration: '3:27',
  },
  {
    id: 'v2',
    file: '02_valyuta_i_telefony.mp4',
    poster: '/videos/darya/02_valyuta_i_telefony.jpg',
    num: '02',
    title: 'Телефоны и внутренняя валюта',
    question: 'Как IT-лагерь совмещает детокс от телефонов с технологиями?',
    duration: '2:46',
  },
  {
    id: 'v3',
    file: '03_chemu_nauchitsya.mp4',
    poster: '/videos/darya/03_chemu_nauchitsya.jpg',
    num: '03',
    title: 'Чему можно научиться за смену',
    question: 'Реально ли освоить IT за одну лагерную смену?',
    duration: '2:40',
  },
  {
    id: 'v4',
    file: '04_hrustalny_kolpak.mp4',
    poster: '/videos/darya/04_hrustalny_kolpak.jpg',
    num: '04',
    title: 'Дети под хрустальным колпаком',
    question: 'Лишены ли современные дети самостоятельности?',
    duration: '2:14',
  },
  {
    id: 'v5',
    file: '05_budushchee_lagerei.mp4',
    poster: '/videos/darya/05_budushchee_lagerei.jpg',
    num: '05',
    title: 'Будущее за профильными лагерями',
    question: 'Станут ли профильные лагеря основным форматом отдыха?',
    duration: '2:04',
  },
];

const BASE = '/videos/darya';
---

<Base
  title="Дарья Афанасьева на федеральном ТВ — АйДаКемп"
  description="Директор IT-лагеря АйДаКемп Дарья Афанасьева в программе «Родительское собрание» на канале ОТР — о современных лагерях, телефонах и детях."
>

  <Header />

  <!-- Hero -->
  <section class="tv-hero" id="tvHero">
    <div class="tv-hero__inner">
      <p class="tv-hero__label">Канал ОТР · Программа «Родительское собрание»</p>
      <h1 class="tv-hero__title">Дарья Афанасьева<br>на федеральном телевидении</h1>
      <p class="tv-hero__sub">5 отрывков из интервью о детских лагерях, IT-образовании и современных детях</p>
      <a href="https://otr-online.ru/programmy/roditelskoe-sobranie/provodim-leto-s-polzoi-101575.html" target="_blank" rel="noopener" class="tv-hero__full-link">
        Полное видео тут
        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <!-- ── Ссылка на передачу ── -->
  <section class="tv-show-link">
    <div class="tv-show-link__inner">
      <i class="bi bi-display tv-show-link__icon" aria-hidden="true"></i>
      <div>
        <p class="tv-show-link__label">Полный выпуск программы «Родительское собрание»</p>
        <p class="tv-show-link__sub">Канал ОТР — передача целиком, посвящённая детским лагерям</p>
      </div>
      <a href="https://otr-online.ru/programmy/roditelskoe-sobranie/provodim-leto-s-polzoi-101575.html" target="_blank" rel="noopener" class="tv-show-link__btn">
        Смотреть на ОТР
        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <VideoGallery videos={videos} baseUrl={BASE} />

  <div class="py-10">
    <ArticleBottomCta
      bookingTitle="Запишите ребёнка на ближайшую смену"
      bookingSubtitle="Ответим за 10 минут. Покажем программу и расскажем про свободные места."
    />
  </div>

</Base>

<script>
(function() {
  const hero = document.getElementById('tvHero');
  if (!hero) return;
  const syms = ['</>','{}','01','&&','[ ]','!=','++','//','( )','0x','>>','?:'];
  syms.forEach(function(s, i) {
    var el = document.createElement('span');
    el.className = 'tv-hero__sym';
    el.textContent = s;
    var x = 4 + Math.floor(i * 8.3) % 92;
    var y = 8 + Math.floor(i * 13.7) % 80;
    var dur = 5 + (i % 4);
    var sz = 13 + (i % 3) * 4;
    var op = 0.25 + (i % 4) * 0.08;
    var rotFrom = -3 - (i % 4);
    var rotTo = 3 + (i % 4);
    el.style.cssText =
      'left:' + x + '%;top:' + y + '%;' +
      'font-size:' + sz + 'px;' +
      '--dur:' + dur + 's;--delay:' + (i * 0.4) + 's;' +
      '--op:' + op + ';--rot-from:' + rotFrom + 'deg;--rot-to:' + rotTo + 'deg;';
    hero.appendChild(el);
  });
})();
</script>

<style>
/* ── Hero ──────────────────────────────────────────── */
.tv-hero {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(to bottom,
      rgba(6,15,30,0.18) 0%,
      rgba(6,15,30,0.4)  40%,
      rgba(6,15,30,0.78) 68%,
      rgba(6,15,30,0.90) 100%),
    url('/images/tv-hero-bg.jpg') center/cover no-repeat;
  padding: 100px 20px 64px;
  text-align: center;
  isolation: isolate;
}
@media (min-width: 768px) {
  .tv-hero { padding-top: 120px; }
}

/* мелкие звёзды */
.tv-hero::before {
  content: '';
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(circle, rgba(255,255,255,0.28) 1px, transparent 0) 0 0 / 30px 30px,
    radial-gradient(circle, rgba(255,255,255,0.12) 1px, transparent 0) 15px 15px / 30px 30px;
  animation: starsA 22s linear infinite;
  pointer-events: none;
}

/* крупные звёзды + оранжевые акценты */
.tv-hero::after {
  content: '';
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(circle, rgba(236,155,68,0.18) 1.5px, transparent 0) 0 0 / 74px 74px,
    radial-gradient(circle, rgba(255,255,255,0.1) 1.5px, transparent 0) 37px 37px / 74px 74px;
  animation: starsB 40s linear infinite reverse;
  pointer-events: none;
}

@keyframes starsA {
  to { transform: translate(30px, 30px); }
}
@keyframes starsB {
  to { transform: translate(74px, 74px); }
}

/* плавающие символы кода */
.tv-hero__sym {
  position: absolute;
  font-family: 'Courier New', monospace;
  font-weight: 700;
  color: #ffffff;
  pointer-events: none;
  user-select: none;
  z-index: 2;
  animation: symFloat var(--dur, 6s) ease-in-out infinite alternate;
  animation-delay: var(--delay, 0s);
}

@keyframes symFloat {
  from { transform: translateY(0) rotate(var(--rot-from, -4deg)); opacity: var(--op, 0.25); }
  to   { transform: translateY(-18px) rotate(var(--rot-to, 4deg)); opacity: calc(var(--op, 0.25) * 1.5); }
}

.tv-hero__inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
.tv-hero__label {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ec9b44;
  margin: 0 0 16px;
}
.tv-hero__title {
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 16px;
}
.tv-hero__sub {
  font-size: clamp(15px, 2vw, 18px);
  color: rgba(255,255,255,0.6);
  margin: 0 0 20px;
  line-height: 1.5;
}
.tv-hero__full-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #ec9b44;
  font-size: 15px;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.15s;
}
.tv-hero__full-link:hover { color: #f5b060; }
.tv-hero__full-link .bi { font-size: 12px; }

/* ── Ссылка на передачу ────────────────────────────── */
.tv-show-link {
  background: #fff7ed;
  border-top: 1px solid #fde8c8;
  border-bottom: 1px solid #fde8c8;
  padding: 20px;
}
.tv-show-link__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.tv-show-link__icon {
  font-size: 28px;
  color: #ec9b44;
  flex-shrink: 0;
}
.tv-show-link__label {
  font-size: 15px;
  font-weight: 700;
  color: #1a2a3a;
  margin: 0 0 2px;
}
.tv-show-link__sub {
  font-size: 13px;
  color: #6e788a;
  margin: 0;
}
.tv-show-link__btn {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 18px;
  background: #ec9b44;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s;
}
.tv-show-link__btn:hover { background: #d4882f; }
.tv-show-link__btn .bi { font-size: 12px; }

</style>
