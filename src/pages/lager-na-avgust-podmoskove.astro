---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';

const sections = [
  {
    h2: "Августовские смены АйДаКемп 2026",
    text: "В августе 2026 проходят две смены АйДаКемп в Подмосковье. Смена 3 — с 3 по 15 августа, 13 дней, стоимость 89 400 ₽. Смена 4 — с 17 по 26 августа, 10 дней, стоимость 74 900 ₽. В обеих сменах — полная IT-программа, бассейн, 5-разовое питание и проживание."
  },
  {
    h2: "Почему стоит выбрать августовскую смену",
    text: "Август — особое время. Дети ещё в летнем настроении, но уже готовы к учёбе. Августовская смена помогает плавно войти в новый учебный год: ребята заряжаются, создают проект и возвращаются домой с уверенностью в себе. Многие дети, побывавшие в июне, просятся ещё раз именно в августе.",
    list: [
      "Смена 3: 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4: 17–26 августа, 10 дней — 74 900 ₽",
      "В цену включено: проживание, питание, программа, активности",
      "Трансфер из Москвы — платная опция"
    ]
  },
  {
    h2: "Программа в августе",
    text: "Программа августовских смен не отличается от летних — полный IT-курс по возрасту. Дети 7–10 лет работают со Scratch и Minecraft. Дети 10–12 лет изучают Python и основы AI. Подростки 13–15 лет — Python Advanced, боты, работа с API и нейросетями. Финал — хакатон: каждый защищает свой проект."
  },
  {
    h2: "Расположение: Подмосковье, 66 км от МКАД",
    text: "Лагерь находится в Наро-Фоминском районе Московской области, на территории санатория «Изумруд». 66 км от МКАД по Киевскому шоссе. Охраняемая территория, бассейн с ионизированной водой, комнаты по 2–4 человека."
  },
  {
    h2: "Чем август отличается от июня и июля — практические нюансы",
    text: "Август кажется обычным «летним месяцем», но на практике имеет несколько важных особенностей именно для детского лагеря. Мы учли их в программе и организации:",
    list: [
      "Температура в Подмосковье в августе — +19…+25°C днём. Комфортнее чем июльская жара, детям легче играть на улице весь день",
      "Школьная форма уже куплена, настроение на учёбу начинает просыпаться — легче включиться в структурированные занятия",
      "Меньше конкуренции — июньские смены забронированы за месяц, а в августе ещё есть места и можно попасть в любую группу",
      "Природа в полном расцвете — берёзы, липы, первые золотые листья. Фото на память получаются атмосферные",
      "К 20-м числам августа комарья почти нет — в отличие от влажного июня и начала июля"
    ]
  },
  {
    h2: "Какая августовская смена кому подходит",
    text: "Выбор между Сменой 3 (3–15 августа, 13 дней) и Сменой 4 (17–26 августа, 10 дней) — стоит делать по двум факторам: возраст и опыт ребёнка в лагере.",
    list: [
      "Смена 3 — для детей 10–14 лет, кто уже имеет лагерный опыт или хочет более глубокое погружение в IT-проект. За 13 дней успевает получиться серьёзный проект (бот, игра, сайт)",
      "Смена 4 — идеальная для малышей 7–9 лет впервые в лагере. 10 дней — оптимум: не слишком коротко (успевает влиться в коллектив), не слишком долго (не устаёт)",
      "Также Смена 4 подходит подросткам, у которых 25–26 августа = репетиторы или возвращение в школу в другом городе"
    ]
  },
  {
    h2: "Подготовка к сентябрю в лагере",
    text: "Наш частый приём — для смены 4 (17–26 августа) мы в последний день проводим «планирование учебного года». Старшеклассники обсуждают как выделить время на новые хобби, младшие — делают вместе блокнот целей на сентябрь-октябрь. Это мягкая точка перехода от лагеря к школе — ребята не шокированы первым сентября, уже ментально готовы. Родители часто отмечают: «После августовской смены переход в школу прошёл удивительно гладко, не было обычных стрессов первой недели»."
  },
  {
    h2: "Почему август — отличное время для IT-лагеря",
    text: "Август незаслуженно считается «неудобным» месяцем для лагеря — это заблуждение. На практике он выигрывает у июня и июля по нескольким параметрам:",
    list: [
      "Нет давки июня и июля — запись идёт спокойнее, можно выбрать группу и программу без гонки",
      "Погода комфортнее — +19…+25°C вместо июльского пекла, школьники весь день на улице без перегрева",
      "Подготовка к школе через IT-навыки — структурированные занятия в августе настраивают на учебный режим лучше, чем любые репетиторы",
      "Цены не выше — смена 3 (13 дней) и смена 4 (10 дней) стоят как аналогичные июньские смены",
      "Комаров меньше — к 20-м числам августа их практически нет в отличие от июня"
    ]
  },
  {
    h2: "Что успеет сделать школьник за августовскую смену",
    text: "Результат конкретный, не «получил опыт общения». Зависит от длины смены и возраста:",
    list: [
      "За 10 дней (Смена 4, 17–26 августа) — завершённый Python-проект или полноценная Roblox-игра с механиками и скриптами",
      "За 13 дней (Смена 3, 3–15 августа) — AI-ассистент на ChatGPT API, Telegram-бот с базой данных или 3D-персонаж в Blender",
      "В любом случае — аккаунт GitHub с кодом проекта как первые строки портфолио"
    ]
  },
  {
    h2: "Запись на август 2026",
    text: "В отличие от июля — который полностью занят — на август места ещё есть. Смена 3 (3–15 августа, 13 дней, 89 400 ₽) и Смена 4 (17–26 августа, 10 дней, 74 900 ₽). Нажмите «Записаться» и выберите нужную смену — менеджер перезвонит за 10 минут. Место бронируется на 72 часа без предоплаты."
  },
  {
    h2: "Все летние смены",
    text: `<p class="text-[15px] text-slate-700 mb-3">Август — финал сезона. Посмотрите весь календарь смен:</p>
<a href="/lager-letom/" class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"><i class="bi bi-arrow-left" aria-hidden="true"></i> Все летние смены АйДаКемп</a>`,
    icon: "calendar-event"
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-avgust-podmoskove.avif"
  title="Лагерь на август в Подмосковье 2026 — 2 смены, IT-программа"
  description="Две смены в августе: 3–15 и 17–26 августа. IT-лагерь с проживанием, 66 км от Москвы. Ребёнок уедет с Python-проектом. От 74 900 ₽ — есть места."
  h1="Лагерь на август в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-na-avgust-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Когда начинаются августовские смены в АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Две смены в августе 2026: 3–15 августа (13 дней, 89 400 ₽) и 17–26 августа (10 дней, 74 900 ₽). Бронирование открыто." }
        },
        {
          "@type": "Question",
          "name": "Чем хороша августовская смена перед учебным годом?",
          "acceptedAnswer": { "@type": "Answer", "text": "Август — лучшее время для перезагрузки перед школой. Ребёнок уезжает с новым проектом, новыми друзьями и мотивацией. Переключение с летней расслабленности на режим дня происходит плавно." }
        },
        {
          "@type": "Question",
          "name": "Есть ли скидки на август?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена 17–26 августа (10 дней) стоит 74 900 ₽ — это дешевле июньских смен. Оплата частями: 50% при бронировании, остаток за 3 недели до заезда." }
        },
        {
          "@type": "Question",
          "name": "Можно ли поехать в лагерь в конце августа?",
          "acceptedAnswer": { "@type": "Answer", "text": "Последняя смена заканчивается 26 августа — до 1 сентября ещё несколько дней. Это оптимально: ребёнок возвращается домой с запасом времени перед школой." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь на август в Подмосковье"
    subtitle="Две смены в августе 2026 — 3–15 и 17–26 августа. IT-проект за смену, бассейн, Подмосковье."
    breadcrumb="Лагерь на август"
    keywords={["Смены: 3–15 августа (13 дней) и 17–26 августа (10 дней)", "IT-программа: Python, AI, Minecraft — свой проект на выходе", `${STAT_DISTANCE} от Москвы, бассейн, питание, охрана 24/7`]}
    image="/images/hero/lager-na-avgust-podmoskove.avif"
    imageAlt="Лагерь на август в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
