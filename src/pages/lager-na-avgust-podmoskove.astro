---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_S3, PRICE_S4, SEASON_YEAR, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import { STAT_DISTANCE, STAT_RATING } from '../data/contacts';

const sections = [
  {
    h2: "Коротко: какие смены ещё открыты",
    text: `Нам часто пишут: «А места ещё есть?» Да — на обе смены, это последний заезд сезона. Мы восьмой год держим детский лагерь в Подмосковье: ближе к школе желающих больше. Цена фиксированная, бронь и оплата — онлайн, по лицензии Минобрнауки. Рейтинг ${STAT_RATING} на Яндекс.Картах собрали родители, чьи дети уже ездили в наш лагерь.`,
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3}. Для ребят 10–14, кто уже бывал в лагере или хочет серьёзный проект`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4}. Первый в жизни лагерь и вариант для тех, кто спешит домой к репетитору`,
      "В цену входит всё: проживание (комнаты на 2–4), 5-разовое горячее питание, программа, ноутбуки, бассейн, медик 24/7",
      `Налоговый вычет — до ${VYCHET_S3} за смену 3 и до ${VYCHET_S4} за смену 4 (13% от стоимости минус 3 800 ₽/день, лицензия Минобрнауки)`,
      "Трансфер из Москвы — по желанию, отдельная опция",
      "Мест немного: группы по 8 человек, «осталось 3 места» — это буквально три; актуальную цифру показывает блок смен ниже"
    ]
  },
  {
    h2: "Почему детский лагерь в конце лета заходит легче, чем в июне",
    text: `Я Дарья, основатель АйДаКемп, мама дочери-подростка. Каждый год вижу одно и то же: в июне ребята ещё «в инерции» после школы, в июле — жара. Ближе к школе они соскучились по делу и отдохнули. Такие «горящие» включаются с первого дня. Поэтому детский лагерь на август ${SEASON_YEAR} мы собираем как разгон перед учебным годом, а не как «догулять остаток каникул».`
  },
  {
    h2: "Что мы замечаем каждый год",
    text: "Не маркетинг, а то, что слышим от мам в чате выпускников:",
    list: [
      "Погода: июнь дождливый, июль — жара под +30, сейчас комфортные +19…+25",
      "Свободные места: июнь и июль разбирают заранее, сейчас места есть на обе смены",
      "Комары: в июне и июле их много, сейчас — почти нет"
    ]
  },
  {
    h2: "Смена 3 или смена 4 — какая кому",
    text: `Смена 3 (13 дней, ${PRICE_S3}) — для тех, кто хочет проект «по-серьёзному»: Telegram-бот с базой данных, AI-ассистент на ChatGPT API или игра на pygame. Подходит школьникам 10–14, которые уже были в IT-лагере или сами сидят в Scratch, Minecraft, Roblox Studio. Для подростков — отдельный AI-трек: pandas и анализ данных.`,
    list: [
      `Смена 4 (10 дней, ${PRICE_S4}) — для дебюта и для тех, кто едет «впритык к школе»`,
      "Малыши 7–9 лет возвращаются на эмоциональном пике, а не когда уже соскучились по дому",
      "Старшеклассники с репетитором в последние дни лета успевают домой заранее",
      "В смене 4 — мягкий вход: Minecraft → Scratch → Python, свой проект за 10 дней"
    ]
  },
  {
    h2: "Финал смены 4: мягкий переход к школе",
    text: "В последний день мы проводим «планирование учебного года» — в формате «на что хочется выделить время». Мамы потом пишут: «первая учебная неделя прошла без слёз, я в шоке»."
  },
  {
    h2: "Что входит в стоимость летнего лагеря",
    text: "Открытым текстом, без мелкого шрифта:",
    list: [
      "Проживание в корпусе санатория «Изумруд» (Наро-Фоминский округ, 66 км от МКАД)",
      "5 приёмов пищи в день, своя столовая, учитываем аллергии",
      "IT-программа по возрасту: Scratch + Minecraft (7–10 лет), Python + основы AI (10–12 лет), Python Advanced + боты + API (13–15 лет)",
      "Ноутбук на каждого — свой, без потери времени урока",
      "Бассейн с ионизированной водой, спортивные площадки и лес",
      "Вожатые в парах, медик 24/7, охрана, КПП",
      "Финальный хакатон и проект, который остаётся у ребёнка на GitHub"
    ]
  },
  {
    h2: "Где находится лагерь и как добраться",
    text: "Санаторий «Изумруд» — наш детский лагерь в Наро-Фоминском округе; место выбирали придирчиво, с учётом безопасности и медицины. Важно: у конкурентов встречается похожее название — это не мы, адрес и схема проезда на странице контактов. На машине — 66 км по Киевскому шоссе, час-полтора без пробок. Есть трансфер от метро, собираем группу в день заезда."
  },
  {
    h2: "Что получит ребёнок за смену",
    text: "Не «навыки коммуникации» — это пишут все и обо всём. Конкретно:",
    list: [
      "За 10 дней (смена 4): завершённый Python-проект или Roblox-игра с механиками",
      "За 13 дней (смена 3): Telegram-бот с базой данных или AI-ассистент на ChatGPT API",
      "3D-проект в Blender для тех, кто выбрал визуальное направление",
      "Аккаунт на GitHub с кодом — первая строчка портфолио",
      "Пять новых друзей из других школ — переписка в Telegram до зимы",
      "Загар, нагулянный аппетит, нормальный сон — это тоже важно"
    ]
  },
  {
    h2: "Все летние смены",
    text: `<p class="text-base text-slate-700 mb-3">Это финал сезона ${SEASON_YEAR}. Весь календарь смен — здесь:</p>
<a href="/lager-letom/" class="inline-flex items-center gap-2 text-base font-semibold text-primary hover:underline"><i class="bi bi-arrow-left" aria-hidden="true"></i> Все летние смены АйДаКемп</a>`,
    icon: "calendar-event"
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-avgust-podmoskove.avif"
  title={`Летний лагерь на август ${SEASON_YEAR} в Подмосковье — открытые заезды | АйДаКемп`}
  description={`Летний лагерь на август ${SEASON_YEAR} в Подмосковье — места есть: заезды ${DATES_SHORT_S3} и ${DATES_SHORT_S4}. IT-программа, бассейн, 5-разовое питание, ${STAT_DISTANCE} от Москвы.`}
  h1={`Летний лагерь на август ${SEASON_YEAR} в Подмосковье`}
  canonical="https://aidacamp.ru/lager-na-avgust-podmoskove"
>
  <LandingHero slot="hero"
    h1={`Летний лагерь на август ${SEASON_YEAR} в Подмосковье`}
    subtitle={`Смены 3 и 4 — места ещё есть, это финал летнего сезона. IT-проект за смену, бассейн, Подмосковье. Июнь и июль уже закрыты.`}
    breadcrumb="Последние смены лета"
    keywords={[`Смена 3: 13 дней, ${PRICE_S3} и Смена 4: 10 дней, ${PRICE_S4}`, "IT-программа: Python, AI, Minecraft — свой проект на выходе", `${STAT_DISTANCE} от Москвы, бассейн, 5-разовое питание, медик 24/7`]}
    image="/images/hero/lager-na-avgust-podmoskove.avif"
    imageAlt="Летний лагерь в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Не поздно ли ребёнку ехать в лагерь перед самой школой?", a: "Наоборот — самое то. Дней за пять до 1 сентября ребята успевают разгрузиться дома, купить рюкзак и форму, выспаться. Детский лагерь в конце лета работает мягче июньского: структура дня (подъём, занятия, отбой) возвращает в учебный режим. После двух месяцев свободного графика 1 сентября — это шок. После смены — спокойный переход." },
    { q: "Ребёнок ни разу не был в лагере. Не страшно отправлять его сейчас?", a: "Смена 4 (10 дней) — специально такой длины для первого раза: хватает, чтобы появился самостоятельный опыт, и не так долго, чтобы заскучать. Вожатый звонит вам в первый и третий день сам, без вашего запроса." },
    { q: "А если ребёнок вообще не интересуется программированием?", a: "Половина школьников приезжают без интереса, уезжают — с проектом и горящими глазами. Секрет в среде: когда рядом 8 ровесников делают игру и у соседа по комнате уже получается — остаться в стороне невозможно. Minecraft и Roblox — знакомая база, от неё мы переходим к коду." },
    { q: "Сколько школьников в группе и сколько взрослых?", a: "Не больше 8 школьников на группу. На каждую группу — преподаватель IT и пара вожатых. Плюс медик и администрация всегда на территории. Это не «1 вожатый на 30 детей», как в массовых лагерях." },
    { q: "Можно ли оплатить эту смену материнским капиталом?", a: "Да. У нас лицензия Минобрнауки, образовательная часть смены принимается к оплате маткапиталом. Документы готовим сами. Это вопрос на 1–2 недели — бронируйте заранее." },
    { q: "Что с документами и справкой 079/у?", a: "Справку 079/у берут в детской поликлинике у педиатра — без анализов это один визит, за 1–2 недели до заезда. Наш менеджер ведёт каждую семью по чек-листу, никто не остаётся один на один с бумажками." }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
