---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import AskCta from '../components/AskCta.astro';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import { STAT_DISTANCE } from '../data/contacts';

const sections = [
  {
    h2: "Коротко — что есть на август",
    text: "В июле звонят и спрашивают: «А в августе ещё есть места?» Есть. На обе смены. И если честно — мы любим август больше, чем июнь.",
    list: [
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽. Для ребят 10–14, кто уже бывал в лагере или хочет глубоко уйти в проект",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽. Идеально для тех, кто едет в лагерь впервые, и для подростков, у которых 28-го уже репетитор",
      "В цену входит всё: проживание (комнаты на 2–4), 5-разовое горячее, программа, ноутбуки, бассейн, медик 24/7",
      "Налоговый вычет — до 5 200 ₽ за смену 3 и до 4 800 ₽ за смену 4 (13% от стоимости минус 3 800 ₽/день, лицензия Минобрнауки)",
      "Трансфер из Москвы — по желанию, отдельная опция"
    ]
  },
  {
    h2: "Почему детский лагерь на август — это часто удачнее, чем июнь",
    text: "Я Дарья, основатель АйДаКемп. У меня дочь-подросток, и три лета подряд я наблюдала одну и ту же штуку: июнь — это инерция «школа только-только закончилась, дайте отдохнуть». Июль — пик жары и пик «куда деть ребёнка, я на работе». А вот август — это уже совсем другое настроение. Школьники сами немного скучают по дисциплине. Они отдохнули, накатались на велосипедах, насмотрелись YouTube. И когда в августе попадают в группу из восьми таких же — у которых тоже глаза горят на «а как ты это сделал в Minecraft» — они включаются с первого дня."
  },
  {
    h2: "Что отличает август конкретно у нас",
    text: "Сравнение по ключевым параметрам — не маркетинг, а то, что мы слышим от мам в чате выпускников каждый год:",
    list: [
      "Погода: июнь — прохладно и дожди, июль — пекло +28…+32, август — +19…+25, комфорт весь день",
      "Свободные места: июнь разбирают в марте, июль забронирован полностью, август — есть на обе смены",
      "Настрой: в июне «я устал от школы», в июле «мне жарко», в августе — готов учиться",
      "Комары: в июне их много, в июле ещё есть, к 20-м числам августа практически нет"
    ]
  },
  {
    h2: "Две августовские смены — какая кому",
    text: "Смена 3 (3–15 августа, 13 дней, 89 400 ₽) — для тех, кто хочет проект «по-серьёзному». 13 дней — это много. Хватает не только на «попробовать» Python, но и довести до результата: бот в Telegram с базой данных, AI-ассистент на ChatGPT API, игра на pygame с сохранениями. Берите, если школьнику 10–14 и он либо уже был в IT-лагере, либо дома сам ковыряется в Scratch, Minecraft или Roblox Studio.",
    list: [
      "Смена 4 (17–26 августа, 10 дней, 74 900 ₽) — для дебюта и для тех, кто едет «впритык к школе»",
      "10 дней — золотой стандарт первого лагерного опыта: достаточно, чтобы влиться, не настолько долго, чтобы устать",
      "Малыши 7–9 лет — первый раз без родителей: возвращаются именно тогда, когда ещё на эмоциональном пике",
      "Старшеклассники, у которых 27–28 августа репетитор или возвращение в другой город: 26-го вечером уже дома"
    ]
  },
  {
    h2: "Мягкий переход к школе в финале смены 4",
    text: "В последний день смены 4 (17–26 августа) мы проводим «планирование учебного года». Не как педагог в очках, а в формате «давайте подумаем, на что в сентябре хочется выделить время, кроме школы». Девочки рисуют блокноты целей, мальчишки чаще обсуждают, как затащить родителей на новый кружок. Мамы потом пишут: «первая школьная неделя в этом году прошла без слёз, я в шоке»."
  },
  {
    h2: "Что входит в стоимость летнего лагеря на август",
    text: "Открытым текстом, без мелкого шрифта. В стоимость включено:",
    list: [
      "Проживание в корпусе санатория «Изумруд» (Наро-Фоминский округ, 66 км от МКАД)",
      "5 приёмов пищи в день, своя столовая, учитываем аллергии",
      "IT-программа по возрасту: Scratch + Minecraft (7–10 лет), Python + основы AI (10–12 лет), Python Advanced + боты + API (13–15 лет)",
      "Ноутбук на каждого ребёнка — наш, единый парк, без потери времени урока на технические проблемы",
      "Бассейн с ионизированной водой, спортплощадки, лес",
      "Вожатые в парах + медик 24/7 + охрана + КПП",
      "Финальный хакатон и проект, который остаётся у ребёнка на GitHub"
    ]
  },
  {
    h2: "Где находится лагерь и как добраться",
    text: "Санаторий «Изумруд», Наро-Фоминский округ Московской области. Важно: есть похожий по названию лагерь «Изумруд» у других организаторов — это не мы. У нас точный адрес и схема проезда на странице контактов. На машине — 66 км по Киевскому шоссе, дорога час-полтора без пробок. На трансфере от метро — собираем группу в Москве в день заезда, везём автобусом до ворот. Из Одинцово — минут 40. Из Химок или Серпухова — около часа."
  },
  {
    h2: "Что в итоге получит ребёнок за августовскую смену",
    text: "Не «опыт общения» и «навыки коммуникации» — это пишут все и обо всём. Конкретно:",
    list: [
      "За 10 дней (смена 4): завершённый Python-проект или Roblox-игра с механиками и скриптами",
      "За 13 дней (смена 3): Telegram-бот с базой данных или AI-ассистент на ChatGPT API",
      "3D-проект в Blender для тех, кто пошёл в визуальное направление",
      "Аккаунт на GitHub с кодом — первая строчка портфолио",
      "Штук пять новых друзей из других школ Москвы и Подмосковья, с которыми переписываются в Telegram до зимы",
      "Загар, нагулянный аппетит, нормальный сон — это тоже важно"
    ]
  },
  {
    h2: "Сколько мест осталось на август",
    text: "На момент обновления страницы (середина мая): смена 3 — заполнена примерно наполовину, смена 4 — около 60% мест свободно. Это не «маркетинговое FOMO», а реальная цифра. Группы небольшие — по 8 школьников максимум, поэтому «осталось 3 места» — это буквально три места, а не «спешите, осталось 99». Бронируем без предоплаты на 72 часа — этого хватает, чтобы спокойно собрать справки, посоветоваться с мужем, посмотреть отзывы."
  },
  {
    h2: "Все летние смены",
    text: `<p class="text-[15px] text-slate-700 mb-3">Август — финал сезона. Посмотрите весь календарь смен:</p>
<a href="/lager-letom/" class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"><i class="bi bi-arrow-left" aria-hidden="true"></i> Все летние смены АйДаКемп</a>`,
    icon: "calendar-event"
  }
];

---

<LandingLayout
  heroImage="/images/hero/lager-na-avgust-podmoskove.avif"
  title="Летний лагерь август Подмосковье — смены 3-4 АйДаКемп"
  description="Летний лагерь в августе под Москвой для детей 7-14 лет. Две смены: 3-15 и 17-26 августа. Программирование, проживание, питание. Забронируйте место в лагере на август."
  h1="Летний лагерь на август в Подмосковье 2026"
  canonical="https://aidacamp.ru/lager-na-avgust-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Не поздно ли ребёнку ехать в лагерь в августе перед школой?",
          "acceptedAnswer": { "@type": "Answer", "text": "Наоборот — самое то. К 26–27 августа большинство ребят успевают пару дней дома разгрузиться, купить рюкзак и форму, выспаться. А лагерная структура (подъём, занятия, отбой) мягко возвращает в учебный режим. После двух месяцев свободного графика 1 сентября — это шок. После августовской смены — спокойный переход." }
        },
        {
          "@type": "Question",
          "name": "Ребёнок ни разу не был в лагере. Не страшно отправлять в августе?",
          "acceptedAnswer": { "@type": "Answer", "text": "Смена 4 (10 дней, 17–26 августа) — это сознательный выбор длительности для дебюта. Достаточно, чтобы появился самостоятельный опыт. Не настолько долго, чтобы успеть всерьёз заскучать. Вожатый звонит вам в первый и третий день сам, без вашего запроса." }
        },
        {
          "@type": "Question",
          "name": "А если ребёнок вообще не интересуется программированием?",
          "acceptedAnswer": { "@type": "Answer", "text": "Половина школьников приезжают без интереса. Уезжают — с проектом и горящими глазами. Секрет не в нашей гениальности, а в среде: когда вокруг 8 ровесников делают игру и у соседа по комнате уже получается двигать персонажа — невозможно остаться в стороне. Minecraft и Roblox — это знакомая база, а от неё мы аккуратно переходим к коду." }
        },
        {
          "@type": "Question",
          "name": "Сколько школьников в группе и сколько взрослых?",
          "acceptedAnswer": { "@type": "Answer", "text": "Не больше 8 школьников на группу. На каждую группу — преподаватель IT и пара вожатых. Плюс медик и администрация всегда на территории. Это не «1 вожатый на 30 детей», как в массовых лагерях." }
        },
        {
          "@type": "Question",
          "name": "Можно ли оплатить августовскую смену материнским капиталом?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. У нас лицензия Минобрнауки, образовательная часть смены принимается к оплате маткапиталом. Документы готовим сами. Это вопрос на 1–2 недели — поэтому если думаете об этой опции, бронируйте заранее." }
        },
        {
          "@type": "Question",
          "name": "Что с документами и справкой 079/у?",
          "acceptedAnswer": { "@type": "Answer", "text": "Справку 079/у берут в детской поликлинике у педиатра, без анализов это один визит. Делать за 1–2 недели до заезда. Если что-то непонятно — наш менеджер ведёт каждую семью по чек-листу, никто не остаётся один на один с бумажками." }
        }
      ]
    })} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний лагерь на август в Подмосковье"
    subtitle="Две смены в августе 2026 — 3–15 и 17–26 августа. IT-проект за смену, бассейн, Подмосковье. Июль уже закрыт — августовские места есть."
    breadcrumb="Лагерь на август"
    keywords={["Смена 3: 3–15 августа (13 дней, 89 400 ₽) и Смена 4: 17–26 августа (10 дней, 74 900 ₽)", "IT-программа: Python, AI, Minecraft — свой проект на выходе", `${STAT_DISTANCE} от Москвы, бассейн, 5-разовое питание, медик 24/7`]}
    image="/images/hero/lager-na-avgust-podmoskove.avif"
    imageAlt="Лагерь на август в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
  <section id="lead-form" class="mx-auto max-w-[1312px] px-4 py-10">
    <AskCta />
  </section>
</LandingLayout>
