---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Маршрут из Королёва в АйДаКемп — ~80 км, ~1 ч 30 мин",
    text: "АйДаКемп — в Наро-Фоминском районе, в санатории «Изумруд» рядом с Апрелевкой. Из Королёва ехать дольше, чем из Москвы — около 80 км, — но дорога несложная: МКАД и прямо по Киевскому шоссе.",
    list: [
      "На машине: Королёв → МКАД (съезд на юго-запад, Киевское шоссе) → М-3 → Апрелевка — ~80 км, около 1 часа 30 минут без пробок",
      "На метро и трансфере: Королёв → Комсомольская → м. Солнцево (~50–60 мин) → бесплатный трансфер лагеря",
      "Плюс из Королёва: нет акклиматизации — лагерь в том же климатическом поясе, ребёнок адаптируется с первого дня"
    ]
  },
  {
    h2: "Трансфер из Королёва в лагерь",
    text: "Бесплатный трансфер отправляется от м. Солнцево в день заезда, обратно — в день отъезда. Из Королёва до м. Солнцево — на метро около 50–60 минут: Комсомольская или Курская → переход → Солнцево.",
    list: [
      "Трансфер бесплатный, от м. Солнцево в день заезда",
      "Из Королёва: Ярославское направление → Комсомольская → метро → Солнцево, ~50–60 мин",
      "Обратно: трансфер привозит ребёнка на м. Солнцево в день отъезда",
      "Альтернатива: привезти ребёнка на машине — ~80 км по Киевскому шоссе, около 1:30"
    ]
  },
  {
    h2: "Налоговый вычет для семей из Королёва",
    text: "АйДаКемп — лицензированная образовательная организация. Налоговый вычет работает для всех российских налогоплательщиков. Жители Королёва оформляют его так же, как все: через nalog.ru, не выходя из дома.",
    list: [
      "Смена 7 дней (48 000 ₽) → возврат ~2 800 ₽",
      "Смена 10 дней (74 900 ₽) → возврат ~4 800 ₽",
      "Смена 14 дней (95 000 ₽) → возврат до 5 434 ₽",
      "Документы для вычета выдаём при заезде — договор и кассовый чек"
    ]
  },
  {
    h2: "Почему родители из Королёва выбирают АйДаКемп",
    text: "Королёв — город учёных и инженеров, родители здесь ценят качественное IT-образование. АйДаКемп — это не просто лагерь, а место, где дети создают реальные проекты. 1.5 часа дороги — и ребёнок на загородной территории санатория с бассейном и IT-треком.",
    list: [
      "~90 км от Королёва, около 1.5–2 часов по Киевскому шоссе",
      "Трансфер от м. Солнцево — метро из Королёва прямо",
      "Нет акклиматизации, тот же климатический пояс",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню. Занятия в группах до 8 человек, чтобы преподаватель мог уделить время каждому.",
    list: [
      "Дети без опыта — начинаем с нуля, уже на 3-й день виден первый результат",
      "Дети с опытом — получат более сложные задачи и реальный рабочий проект",
      "Дети-геймеры — направляем интерес в Minecraft, Roblox или Python-разработку",
      "Королёвские технари — здесь особенно чувствуют себя «своими», когда видят, как работает AI"
    ]
  },
  {
    h2: "Отзывы родителей из Королёва",
    text: "Королёв — космическая столица России, и дети отсюда любят технологии. Вот что рассказывают родители об АйДаКемп:",
    list: [
      "«У нас в Королёве многие папы работают в инженерии. Дочь теперь говорит, что тоже хочет программировать. Спасибо АйДаКемп за это» — Светлана, Королёв",
      "«Дочь вернулась с проектом на AI и с новыми подругами из Москвы. 1.5 часа дороги — это ерунда по сравнению с тем, что она там получила» — Надежда, Королёв",
      "«Метро до Юго-Западной, посадила в автобус — и он уехал. 10 дней тишины и потом звонит сам, потому что хочет рассказать про проект» — Татьяна, Королёв",
      "«Раньше думала: далеко, непонятно. Теперь думаю только: как записать ещё на следующее лето» — Ирина, Пушкино"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — бесплатный.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Королёв 2026 — АйДаКемп"
  description="IT-лагерь рядом с Королёвом: 1.5–2 часа по Киевскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Королёвом"
  canonical="https://aidacamp.ru/lager-korolev"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Королёва до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "На машине: Королёв → МКАД → Киевское шоссе М-3 → Апрелевка, ~80 км, около 1 часа 30 минут. На трансфере: метро до м. Солнцево (~50–60 мин через Комсомольскую), бесплатный трансфер в день заезда." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Королёва до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1 часа 30 минут на машине (~80 км через МКАД и Киевское шоссе). На трансфере: 50–60 минут на метро до м. Солнцево плюс поездка автобусом." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Королёва?",
          "acceptedAnswer": { "@type": "Answer", "text": "Бесплатный трансфер от м. Солнцево. Из Королёва удобно добраться до Юго-Западной на метро через Комсомольскую — около 50–60 минут." }
        },
        {
          "@type": "Question",
          "name": "Можно ли получить налоговый вычет?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да, 13% от стоимости образовательной части. Возврат: от ~2 800 ₽ (7 дней) до 5 434 ₽ (14 дней). Документы выдаём при заезде." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Королёвом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5–2 часа от Королёва. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-korolev"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Королёвом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Королёва по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Королёва"
    keywords={["~1.5 часа от Королёва по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Королёвом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
