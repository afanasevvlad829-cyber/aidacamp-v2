---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Маршрут из Королёва в АйДаКемп",
    text: "АйДаКемп — в Наро-Фоминском районе, в санатории «Изумруд» рядом с Апрелевкой. 66 км напрямую по Киевскому шоссе, ~90 км через Москву — зависит от маршрута. Дорога несложная: МКАД и прямо по Киевскому шоссе.",
    list: [
      "На машине: Королёв → МКАД (съезд на юго-запад, Киевское шоссе) → А-130 → Апрелевка — 66 км напрямую или ~90 км через Москву, около 1 часа 30 минут без пробок",
      "На метро и трансфере: Королёв → Комсомольская → м. Солнцево (~50–60 мин) → бесплатный трансфер лагеря",
      "Плюс из Королёва: нет акклиматизации — лагерь в том же климатическом поясе, ребёнок адаптируется с первого дня"
    ]
  },
  {
    h2: "Трансфер из Королёва в лагерь",
    text: "Бесплатный трансфер отправляется от м. Солнцево в день заезда, обратно — в день отъезда. Из Королёва до м. Солнцево — на метро около 50–60 минут: Комсомольская или Курская → переход → Солнцево.",
    list: [
      "Трансфер бесплатный, от м. Солнцево в день заезда",
      "Из Королёва: Ярославское направление → Комсомольская → метро → Солнцево, ~50–60 мин",
      "Обратно: трансфер привозит ребёнка на м. Солнцево в день отъезда",
      "Альтернатива: привезти ребёнка на машине — 66 км напрямую по Киевскому шоссе, около 1:30"
    ]
  },
  {
    h2: "Для семей из наукограда Королёв",
    text: "Королёв — город, который запустил в космос первый спутник и первого человека. Неудивительно, что здесь особенно много семей, где родители работают в инженерии и IT. АйДаКемп — логичный следующий шаг: ребёнок из семьи инженера учится программировать так же системно, как в РКК Энергия проектируют ракеты. Результат смены — не «поиграли в компьютер», а готовый проект с защитой перед жюри из IT-специалистов.",
    list: [
      "Группы по 8 человек — каждый получает внимание преподавателя, а не просто сидит рядом с экраном",
      "Финальный хакатон: ребёнок представляет свой проект жюри из практикующих разработчиков",
      "Июль занят полностью. В июне и августе ещё есть места — не тяните до последнего"
    ]
  },
  {
    h2: "Налоговый вычет для семей из Королёва",
    text: "АйДаКемп — лицензированная образовательная организация. Налоговый вычет работает для всех российских налогоплательщиков. Жители Королёва оформляют его так же, как все: через nalog.ru, не выходя из дома.",
    list: [
      `Смена 7 дней (${PRICE_MIN}) → возврат ~2 800 ₽`,
      `Смена 10 дней (${PRICE_S4}) → возврат ~4 800 ₽`,
      `Смена 14 дней (${PRICE_MAX}) → возврат до 5 434 ₽`,
      "Документы для вычета выдаём при заезде — договор и кассовый чек"
    ]
  },
  {
    h2: "Почему родители из Королёва выбирают АйДаКемп",
    text: "Королёв — город учёных и инженеров, родители здесь ценят качественное IT-образование. АйДаКемп — это не просто лагерь, а место, где ребята создают реальные проекты. 1.5 часа дороги — и ваш сын или дочь на загородной территории санатория с бассейном и IT-треком.",
    list: [
      "66 км напрямую по Киевскому шоссе, ~90 км через Москву — около 1.5–2 часов",
      "Трансфер от м. Солнцево — метро из Королёва прямо",
      "Нет акклиматизации, тот же климатический пояс",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7",
      "Ежедневные фото в Telegram — видите, чем занимается ребёнок, каждый день"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Для кого подходит лагерь",
    text: "Лагерь принимает детей от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню. Занятия в группах до 8 человек, чтобы преподаватель мог уделить время каждому.",
    list: [
      "Дети без опыта — начинаем с нуля, уже на 3-й день виден первый результат",
      "Дети с опытом — получат более сложные задачи и реальный рабочий проект",
      "Дети-геймеры — направляем интерес в Minecraft, Roblox или Python-разработку",
      "Королёвские технари — здесь особенно чувствуют себя «своими», когда видят, как работает AI"
    ]
  },
  {
    h2: "Отзывы родителей из Королёва",
    text: "Королёв — космическая столица России, и дети отсюда любят технологии. Вот что рассказывают родители об АйДаКемп:",
    list: [
      "«У нас в Королёве многие папы работают в инженерии. Дочь теперь говорит, что тоже хочет программировать. Спасибо АйДаКемп за это» — Светлана, Королёв",
      "«Дочь вернулась с проектом на AI и с новыми подругами из Москвы. 1.5 часа дороги — это ерунда по сравнению с тем, что она там получила» — Надежда, Королёв",
      "«Метро до Юго-Западной, посадила в автобус — и он уехал. 10 дней тишины и потом звонит сам, потому что хочет рассказать про проект» — Татьяна, Королёв",
      "«Раньше думала: далеко, непонятно. Теперь думаю только: как записать ещё на следующее лето» — Ирина, Пушкино"
    ]
  },
  {
    h2: "Вожатые и команда смены",
    text: "В смене АйДаКемп работают два типа взрослых: IT-преподаватели (ведут учебные блоки, 1 педагог на 6–8 ребят) и вожатые (отвечают за жизнь в лагере, организацию досуга, безопасность). Вожатые — студенты педагогических и психологических специальностей, проходящие конкурсный отбор. IT-преподаватели — практикующие разработчики и выпускники технических вузов. Медицинский работник находится на территории в течение всей смены.",
    list: [
      "Соотношение: 1 преподаватель на 6–8 учеников в группе",
      "Вожатые — конкурсный отбор, студенты педагогических специальностей",
      "Медработник круглосуточно на территории",
      "Ежедневные фото в Telegram — родители видят, чем занимается ребёнок"
    ]
  },
  {
    h2: "Чем АйДаКемп отличается от Кванториума?",
    text: "Кванториум — дневные занятия в городе, 2–3 часа в неделю. АйДаКемп — 7 или 14 дней полного погружения с проживанием, питанием, командным проектом и хакатоном. Это не конкуренты — это разные форматы для разных задач.",
    list: [
      "Кванториум: регулярные занятия в учебном году, короткие сессии",
      "АйДаКемп: летнее погружение — от утренней зарядки до ночного хакатона",
      "Многие родители из Королёва водят детей и туда, и сюда — форматы дополняют друг друга"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. Июль занят полностью. В июне и августе ещё есть места. В стоимость включены проживание, питание, полная IT-программа, бассейн. Трансфер от м. Солнцево — бесплатный.",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней — ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней — ${PRICE_MAX}`,
      `Смена 3 — 3–15 августа, 13 дней — ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней — ${PRICE_S4}`
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний детский лагерь Королёв 2026 — АйДаКемп"
  description={`IT-лагерь рядом с Королёвом: 66 км по Киевскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. Июль занят. От ${PRICE_MIN}.`}
  h1="Детский лагерь рядом с Королёвом"
  canonical="https://aidacamp.ru/lager-korolev"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Королёва до лагеря АйДаКемп?", a: "На машине: Королёв → МКАД → Киевское шоссе А-101 → Апрелевка, ~80 км, около 1 часа 30 минут. На трансфере: метро до м. Солнцево (~50–60 мин через Комсомольскую), бесплатный трансфер в день заезда." },
    { q: "Сколько ехать из Королёва до лагеря?", a: "Около 1 часа 30 минут на машине (~80 км через МКАД и Киевское шоссе). На трансфере: 50–60 минут на метро до м. Солнцево плюс поездка автобусом." },
    { q: "Есть ли трансфер из Королёва?", a: "Бесплатный трансфер от м. Солнцево. Из Королёва удобно добраться до Юго-Западной на метро через Комсомольскую — около 50–60 минут." },
    { q: "Можно ли получить налоговый вычет?", a: "Да, 13% от стоимости образовательной части. Возврат: от ~2 800 ₽ (7 дней) до 5 434 ₽ (14 дней). Документы выдаём при заезде." },
    { q: "Сколько стоит путёвка?", a: `От ${PRICE_MIN} за 7-дневную смену. 14-дневная — ${PRICE_MAX}. Август: ${PRICE_S3} и ${PRICE_S4}. В стоимость входит проживание, питание, IT-программа, бассейн.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Королёвом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5–2 часа от Королёва. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-korolev"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Королёвом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Королёва по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Королёва"
    keywords={["~1.5 часа от Королёва по Киевскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Королёвом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
