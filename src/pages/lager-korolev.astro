---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Как добраться из Королёва до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском районе — около 90 км от Королёва. Маршрут: МКАД (через северный въезд, затем на юг до Калужского) → Калужское шоссе, время в пути 1.5–2 часа. Организованный трансфер отправляется от м. Солнцево — добраться из Королёва на метро займёт около 50–60 минут."
  },
  {
    h2: "Почему родители из Королёва выбирают АйДаКемп",
    text: "Королёв — город учёных и инженеров, родители здесь ценят качественное IT-образование. АйДаКемп — это не просто лагерь, а место, где дети создают реальные проекты. 1.5 часа дороги — и ребёнок на загородной территории санатория с бассейном и IT-треком.",
    list: [
      "~90 км от Королёва, около 1.5–2 часов по Калужскому шоссе",
      "Трансфер от м. Солнцево — метро из Королёва прямо",
      "Нет акклиматизации, тот же климатический пояс",
      "Бассейн с ионизированной водой, 5-разовое питание, охрана 24/7"
    ]
  },
  {
    h2: "Программа IT-лагеря",
    text: "Каждый ребёнок выбирает IT-трек по интересу и уровню. Занятия дважды в день по 90 минут с практикующими IT-специалистами. В конце смены — хакатон с защитой проекта.",
    list: [
      "Python — от переменных до бота за 10 дней",
      "Scratch — первый код для детей 7–10 лет",
      "Minecraft Education — программирование в любимой игре",
      "AI и нейросети — ChatGPT API, собственный AI-помощник",
      "Roblox Studio — создание 3D-игр на Lua",
      "3D-моделирование — Blender и печать своей модели"
    ]
  },
  {
    h2: "Отзывы родителей из Королёва",
    text: "Королёв — космическая столица России, и дети отсюда любят технологии. Вот что рассказывают родители об АйДаКемп:",
    list: [
      "«У нас в Королёве многие папы работают в инженерии. Сын теперь говорит, что тоже хочет программировать. Спасибо АйДаКемп за это» — Светлана, Королёв",
      "«Дочь вернулась с проектом на AI и с новыми подругами из Москвы. 1.5 часа дороги — это ерунда по сравнению с тем, что она там получила» — Надежда, Королёв"
    ]
  },
  {
    h2: "Смены 2026 — цены",
    text: "Лагерь работает летом 2026. В стоимость включены проживание, питание, полная IT-программа, бассейн и страховка. Трансфер от м. Солнцево — 2 500 ₽ в одну сторону.",
    list: [
      "Смена 2.1 — 10–16 июня, 7 дней — 48 000 ₽",
      "Смена 2 — 10–23 июня, 14 дней — 95 000 ₽",
      "Смена 3 — 3–15 августа, 13 дней — 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней — 74 900 ₽"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский лагерь Королёв 2026 — АйДаКемп"
  description="IT-лагерь рядом с Королёвом: 1.5–2 часа по Калужскому шоссе, трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет. От 48 000 ₽."
  h1="Детский лагерь рядом с Королёвом"
  canonical="https://aidacamp.ru/lager-korolev"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добраться из Королёва до лагеря АйДаКемп?",
          "acceptedAnswer": { "@type": "Answer", "text": "Из Королёва ~90 км: МКАД → Калужское шоссе, около 1.5–2 часов. Удобнее: метро до м. Солнцево (50–60 мин), затем трансфер АйДаКемп (2 500 ₽)." }
        },
        {
          "@type": "Question",
          "name": "Сколько ехать из Королёва до лагеря?",
          "acceptedAnswer": { "@type": "Answer", "text": "Около 1.5–2 часов. На машине: МКАД → Калужское шоссе, ~90 км. На трансфере: метро до Солнцево плюс автобус." }
        },
        {
          "@type": "Question",
          "name": "Есть ли трансфер из Королёва?",
          "acceptedAnswer": { "@type": "Answer", "text": "Да. Организованный трансфер от м. Солнцево (2 500 ₽). Из Королёва до Солнцево — около 50–60 минут на метро." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит путёвка?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7-дневную смену. 14-дневная — 95 000 ₽. Август: 89 400 ₽ и 74 900 ₽. В стоимость входит проживание, питание, IT-программа, бассейн и страховка." }
        }
      ]
    })} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Королёвом — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, 1.5–2 часа от Королёва. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-korolev"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Королёвом"
    subtitle="IT-лагерь в Наро-Фоминском районе — ~1.5 часа от Королёва по Калужскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Королёва"
    keywords={["~1.5 часа от Королёва по Калужскому шоссе", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Королёвом — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
