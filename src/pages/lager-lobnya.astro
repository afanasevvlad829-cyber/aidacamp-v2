---
import { PRICE_MAX, PRICE_MIN, PRICE_S3, PRICE_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Семьи рядом с аэропортом привыкли к мобильности",
    text: "Лобня стоит в минутах от Шереметьево — и родители здесь не боятся маршрутов. АйДаКемп для таких семей — следующий шаг: отправить ребёнка на смену в IT-лагерь так же спокойно, как в поездку. Тем более что аэроэкспресс до Белорусского идёт быстро, а дальше — метро до м. Солнцево и трансфер лагеря. Лицензия Минобрнауки, рейтинг 5.0 на Яндекс.Картах."
  },
  {
    h2: "Как добраться из Лобни до лагеря АйДаКемп",
    text: "АйДаКемп расположен в санатории «Изумруд» в Наро-Фоминском городском округе Московской области — 66 км от МКАД по Киевскому шоссе (А-101), около часа без пробок. Из Лобни удобнее всего добраться до м. Солнцево (Солнцевская линия) и сесть на организованный трансфер АйДаКемп.",
    list: [
      "Аэроэкспресс Лобня — Белорусский вокзал: ~30 мин",
      "Метро от Белорусской до м. Солнцево: ~35 мин",
      "Трансфер от м. Солнцево до лагеря: 2 000 ₽, ~40 мин",
      "На машине: Дмитровское шоссе → МКАД → Киевское шоссе (А-101) → санаторий «Изумруд» (66 км от МКАД, ~1 час без пробок)"
    ]
  },
  {
    h2: "Вожатые и безопасность",
    text: "За каждым ребёнком в лагере — команда, которую набирают на конкурс, а не случайных помощников.",
    list: [
      "1 преподаватель на 6–8 ребят — индивидуальный подход к каждому",
      "Вожатые — конкурсный отбор, проходят обучение до смены",
      "Медработник круглосуточно на территории лагеря",
      "Ежедневные фото в Telegram в 21:00 — видно, чем занимался ваш ребёнок сегодня"
    ]
  },
  {
    h2: "Что ждёт ребёнка в лагере",
    text: "АйДаКемп — IT-лагерь с полным погружением. Школьники 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут. Преподаватели — практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Для кого подходит лагерь рядом с Лобней",
    text: "Лагерь принимает ребят от 7 до 15 лет. Опыт программирования не нужен — группы формируются по уровню. Занятия в группах до 8 человек позволяют уделить внимание каждому.",
    list: [
      "Без опыта кодинга — стартуем с нуля, результат виден уже на 3-й день",
      "С опытом — получат более сложные задачи и реальный проект",
      "Те, кто зависает в играх — перенаправляем интерес в продуктивное русло"
    ]
  },
  {
    h2: "Смены и цены 2026",
    text: "Места на лето 2026 есть — бронируйте сейчас. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности. Трансфер от м. Солнцево — платная опция (2 000 ₽ в одну сторону). Часть стоимости можно вернуть налоговым вычетом — до 5 434 ₽ (максимум, 14-дневная смена).",
    list: [
      `Смена 2.1 — 10–16 июня, 7 дней, ${PRICE_MIN}`,
      `Смена 2 — 10–23 июня, 14 дней, ${PRICE_MAX} (самая популярная)`,
      `Смена 3 — 3–15 августа, 13 дней, ${PRICE_S3}`,
      `Смена 4 — 17–26 августа, 10 дней, ${PRICE_S4}`
    ]
  },
  {
    h2: "Отзывы семей из Лобни и севера Подмосковья",
    text: "В АйДаКемп едут из Лобни, Долгопрудного, Химок и других городов севера Подмосковья:",
    list: [
      "«Аэроэкспресс из Лобни до Белорусского, потом метро до Солнцево — и автобус лагеря. Дочь вернулась с готовым ботом на Python и была звездой класса» — Марина, Лобня",
      "«Сначала думала: далеко. А потом увидела её проект на хакатоне. Следующим летом уже записались снова» — Анна, Лобня"
    ]
  }
,
  {
    h2: "Откуда едут на смену рядом с Лобней",
    text: "Наша страница — про один загородный IT-лагерь, но добираются до него семьи со всего севера Подмосковья. Чаще всего на смену рядом с Лобней приезжают ребята из Лобни, Долгопрудного и Химок — путь у всех один: до м. Солнцево, дальше трансфер лагеря.",
    list: [
      "Лобня — аэроэкспресс до Белорусского, метро до м. Солнцево, трансфер лагеря",
      "Долгопрудный и Химки — до м. Солнцево на машине или метро, дальше трансфер",
      "Трансфер от м. Солнцево — 2 000 ₽ в одну сторону, с сопровождающим до лагеря"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Летний IT-лагерь рядом с Лобней 2026 для детей | АйДаКемп"
  description={`IT-лагерь рядом с Лобней: 66 км от МКАД по Киевскому шоссе или трансфер от м. Солнцево (2 000 ₽). Python, AI, Minecraft, 7–15 лет. От ${PRICE_MIN}, налоговый вычет до 5 434 ₽.`}
  h1="Детский лагерь рядом с Лобней"
  canonical="https://aidacamp.ru/lager-lobnya"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Лобни до лагеря АйДаКемп?", a: "АйДаКемп — 66 км от МКАД по Киевскому шоссе (А-101), около часа без пробок. Из Лобни: на машине по Дмитровскому шоссе → МКАД → Киевское шоссе, либо до м. Солнцево (аэроэкспресс + метро) и трансфер лагеря (2 000 ₽, ~40 мин)." },
    { q: "Есть ли трансфер из Лобни?", a: "Прямого трансфера из Лобни нет. Организованный трансфер отправляется от м. Солнцево (2 000 ₽ в одну сторону). Из Лобни удобно добраться аэроэкспрессом до Белорусского вокзала, затем на метро до Солнцево." },
    { q: "Нужен ли опыт программирования для поступления в лагерь?", a: "Нет, опыт не нужен. Группы формируются по уровню: начинающие, средний, продвинутые. Занятия в группах до 8 человек, преподаватели помогают каждому ребёнку." },
    { q: "Сколько стоит путёвка в лагерь из Лобни?", a: `Смены от ${PRICE_MIN} (7 дней) до ${PRICE_MAX} (14 дней). В стоимость входят проживание, питание, IT-программа, бассейн. Трансфер от м. Солнцево — 2 000 ₽ отдельно.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Лобней — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском округе, 66 км от МКАД по Киевскому шоссе. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/lager-lobnya"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский лагерь рядом с Лобней"
    subtitle="IT-лагерь в Наро-Фоминском округе — 66 км от МКАД по Киевскому шоссе или трансфер от м. Солнцево. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лагерь из Лобни"
    keywords={["66 км от МКАД по Киевскому шоссе или трансфер от Солнцево", "IT-лагерь: Python, AI, Minecraft для детей 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-v-podmoskove.avif"
    imageAlt="Детский лагерь рядом с Лобней — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
