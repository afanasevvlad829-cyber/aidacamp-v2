---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { allShiftsIncludingArchived } from '../../data/shifts';

const { shiftId } = Astro.params;
const shift = allShiftsIncludingArchived.find((s) => s.id === shiftId);

// Атрибуция визита к CRM-лиду — только если ссылка пришла с подписанными lid+t.
// Подпись проверяет сам /api/bind-lead (verifyLid) при отправке, здесь пробрасываем как строки.
const lid = Astro.url.searchParams.get('lid');
const t = Astro.url.searchParams.get('t');
const hasAttribution = !!(lid && t);
---

<Base
  title={shift ? `Фото — ${shift.name}` : 'Фото смены'}
  description="Фото со смены АйДаКемп"
  noindex={true}
  hideMarketingWidgets={true}
>
  <style is:global>
    /* Тёмная премиальная тема — фон навигационный navy-950 */
    body {
      background: #0d1a2b !important;
      overflow-x: hidden;
    }

    #foto-root {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 16px 96px;
      color: #fff;
    }

    #foto-root h1 {
      color: #fff;
      font-size: 24px;
      line-height: 1.2;
      font-weight: 800;
      margin: 0 0 6px;
    }

    #foto-status {
      color: rgba(255, 255, 255, 0.7);
      font-size: 14px;
      min-height: 20px;
    }

    /* Лента аватарок-лиц (горизонтальный скролл) */
    #foto-avatars {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding: 6px 0 12px;
      margin: 14px 0 4px;
      scrollbar-width: none;
    }
    #foto-avatars::-webkit-scrollbar { display: none; }

    .foto-ava {
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: 64px;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .foto-ava-circle {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border: 2px solid transparent;
      box-sizing: border-box;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .foto-ava-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* «Все фото» — плашка (14px), не круг, с акцентной иконкой */
    .foto-ava-all-circle {
      border-radius: 14px;
      background: rgba(236, 155, 68, 0.14);
      color: #ec9b44;
      font-size: 24px;
    }
    /* Активный элемент — кольцо мягким оранжевым #ec9b44 */
    .foto-ava.active .foto-ava-circle {
      border-color: #ec9b44;
      box-shadow: 0 0 0 2px #ec9b44;
    }
    .foto-ava-name {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.7);
      max-width: 64px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: center;
    }
    .foto-ava.active .foto-ava-name { color: #fff; }

    /* Кнопка «Скачать всё» над сеткой */
    #foto-download-all {
      display: none;
      align-items: center;
      gap: 8px;
      margin: 6px 0 14px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 12px;
      padding: 10px 16px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    #foto-download-all.show { display: inline-flex; }
    #foto-download-all i { color: #ec9b44; font-size: 16px; }
    #foto-download-all:disabled { opacity: 0.6; cursor: default; }

    /* Masonry-сетка (CSS multi-column) */
    #foto-grid {
      columns: 2;
      column-gap: 8px;
      margin-top: 4px;
    }
    @media (min-width: 640px) { #foto-grid { columns: 3; } }
    @media (min-width: 1024px) { #foto-grid { columns: 4; } }

    .foto-cell {
      position: relative;
      break-inside: avoid;
      margin-bottom: 8px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    .foto-cell img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
    }

    /* Видео-бейдж поверх превью (акцент #ec9b44) */
    .foto-video-badge {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: rgba(13, 26, 43, 0.75);
      color: #ec9b44;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      pointer-events: none;
    }

    /* Режим выбора — галочка-оверлей */
    .foto-select-mark {
      position: absolute;
      top: 8px;
      left: 8px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: none;
      align-items: center;
      justify-content: center;
      color: #ec9b44;
      font-size: 24px;
      background: rgba(13, 26, 43, 0.35);
      border: 2px solid rgba(255, 255, 255, 0.85);
      box-sizing: border-box;
    }
    .foto-select-mark i { display: none; line-height: 1; }
    #foto-grid.selecting .foto-select-mark { display: flex; }
    #foto-grid.selecting .foto-cell.selected .foto-select-mark {
      background: transparent;
      border-color: transparent;
    }
    #foto-grid.selecting .foto-cell.selected .foto-select-mark i { display: block; }
    #foto-grid.selecting .foto-cell:not(.selected) img { opacity: 0.78; }
    .foto-cell.selected img { outline: 3px solid #ec9b44; outline-offset: -3px; }

    /* Плавающая панель массовых действий (glass, как .pm-progress-wrap в /p/[lid]) */
    #foto-selbar {
      position: fixed;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%) translateY(160%);
      z-index: 80;
      background: rgba(13, 26, 43, 0.94);
      color: #fff;
      backdrop-filter: saturate(160%) blur(14px);
      padding: 12px 16px;
      border-radius: 18px;
      box-shadow: 0 12px 36px rgba(13, 26, 43, 0.4), 0 2px 8px rgba(13, 26, 43, 0.2);
      display: flex;
      align-items: center;
      gap: 12px;
      max-width: calc(100vw - 24px);
      transition: transform 0.25s ease;
    }
    #foto-selbar.open { transform: translateX(-50%) translateY(0); }
    .foto-selbar-count { font-size: 13px; font-weight: 700; white-space: nowrap; }
    .foto-selbar-count b { font-variant-numeric: tabular-nums; }
    .foto-selbar-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: none;
      border-radius: 12px;
      padding: 9px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }
    .foto-selbar-btn.primary { background: #ec9b44; color: #0d1a2b; }
    .foto-selbar-btn.ghost { background: rgba(255, 255, 255, 0.1); color: #fff; }
    .foto-selbar-btn:disabled { opacity: 0.5; cursor: default; }

    /* Toast */
    #foto-toast {
      position: fixed;
      left: 50%;
      bottom: 92px;
      transform: translateX(-50%) translateY(20px);
      background: #0d1a2b;
      color: #fff;
      padding: 12px 18px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 12px 32px rgba(13, 26, 43, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      z-index: 100;
    }
    #foto-toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Lightbox */
    #foto-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(13, 26, 43, 0.96);
      align-items: center;
      justify-content: center;
      touch-action: none;
    }
    #foto-lightbox.open { display: flex; }
    #foto-lightbox-img {
      max-width: 90vw;
      max-height: 90vh;
      max-height: 90dvh;
      object-fit: contain;
      border-radius: 8px;
      display: block;
    }
    #foto-lightbox-vid {
      display: none;
      max-width: 90vw;
      max-height: 90vh;
      max-height: 90dvh;
      border-radius: 8px;
    }

    /* Экшн-кнопки в лайтбоксе (скачать/поделиться) — акцент #ec9b44, верхний левый угол */
    #foto-lb-actions {
      position: absolute;
      top: 16px;
      left: 16px;
      display: flex;
      gap: 10px;
      z-index: 10001;
    }
    #foto-lb-actions button {
      background: rgba(255, 255, 255, 0.15);
      border: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #ec9b44;
      font-size: 20px;
      transition: background 0.15s;
    }
    #foto-lb-actions button:hover { background: rgba(255, 255, 255, 0.3); }

    .foto-lb-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 24px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
      z-index: 10000;
    }
    .foto-lb-nav:hover { background: rgba(255, 255, 255, 0.3); }
    .foto-lb-nav:disabled { opacity: 0.2; cursor: default; }
    #foto-lb-prev { left: 16px; }
    #foto-lb-next { right: 16px; }

    #foto-lb-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 18px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    #foto-lb-close:hover { background: rgba(255, 255, 255, 0.3); }

    @media (max-width: 640px) {
      .foto-lb-nav {
        width: 44px;
        height: 44px;
        font-size: 20px;
      }
      #foto-lb-prev { left: 8px; }
      #foto-lb-next { right: 8px; }
      /* Сужаем медиа, чтобы боковые кнопки его не перекрывали */
      #foto-lightbox-img,
      #foto-lightbox-vid {
        max-width: calc(100vw - 100px);
        max-height: 85dvh;
      }
    }
  </style>

  <main
    id="foto-root"
    data-shift-id={shiftId}
    data-lid={hasAttribution ? lid : undefined}
    data-t={hasAttribution ? t : undefined}
  >
    {!shift && <p>Смена не найдена.</p>}
    {shift && (
      <>
        <h1>{shift.name} — фото</h1>
        <div id="foto-avatars"></div>
        <div id="foto-status"></div>
        <button id="foto-download-all" type="button">
          <i class="bi bi-download"></i> <span id="foto-download-all-label">Скачать всё</span>
        </button>
        <div id="foto-grid"></div>
      </>
    )}
  </main>

  <div id="foto-lightbox" role="dialog" aria-modal="true" aria-label="Просмотр фото">
    <div id="foto-lb-actions">
      <button id="foto-lb-download" type="button" aria-label="Скачать"><i class="bi bi-download"></i></button>
      <button id="foto-lb-share" type="button" aria-label="Поделиться"><i class="bi bi-share"></i></button>
    </div>
    <button id="foto-lb-close" type="button" aria-label="Закрыть"><i class="bi bi-x-lg"></i></button>
    <button id="foto-lb-prev" class="foto-lb-nav" type="button" aria-label="Предыдущее"><i class="bi bi-chevron-left"></i></button>
    <img id="foto-lightbox-img" src="" alt="Фото" />
    <video id="foto-lightbox-vid" controls></video>
    <button id="foto-lb-next" class="foto-lb-nav" type="button" aria-label="Следующее"><i class="bi bi-chevron-right"></i></button>
  </div>

  <div id="foto-selbar">
    <span class="foto-selbar-count">Выбрано: <b id="foto-sel-count">0</b></span>
    <button id="foto-sel-zip" class="foto-selbar-btn primary" type="button"><i class="bi bi-download"></i> Скачать ZIP</button>
    <button id="foto-sel-share" class="foto-selbar-btn primary" type="button" style="display:none"><i class="bi bi-share"></i> Поделиться</button>
    <button id="foto-sel-cancel" class="foto-selbar-btn ghost" type="button">Отмена</button>
  </div>

  <div id="foto-toast"></div>

  <script>
    const root = document.getElementById('foto-root');
    // `!` только сужает тип: во вложенных функциях (buildAvatars, обработчики)
    // TS теряет narrowing из if-ниже. Реальный null-guard — проверка `if` строкой
    // ниже, она остаётся: при отсутствии элементов блок просто не выполнится.
    const grid = document.getElementById('foto-grid')!;
    const avatars = document.getElementById('foto-avatars')!;

    if (root && grid && avatars) {
      const shiftId = root.dataset.shiftId!;
      const status = document.getElementById('foto-status')!;
      const downloadAllBtn = document.getElementById('foto-download-all') as HTMLButtonElement;

      const lightbox = document.getElementById('foto-lightbox')!;
      const lbImg = document.getElementById('foto-lightbox-img') as HTMLImageElement;
      const lbVid = document.getElementById('foto-lightbox-vid') as HTMLVideoElement;
      const lbPrev = document.getElementById('foto-lb-prev') as HTMLButtonElement;
      const lbNext = document.getElementById('foto-lb-next') as HTMLButtonElement;
      const lbClose = document.getElementById('foto-lb-close') as HTMLButtonElement;
      const lbDownload = document.getElementById('foto-lb-download') as HTMLButtonElement;
      const lbShare = document.getElementById('foto-lb-share') as HTMLButtonElement;

      const selbar = document.getElementById('foto-selbar')!;
      const selCount = document.getElementById('foto-sel-count')!;
      const selZipBtn = document.getElementById('foto-sel-zip') as HTMLButtonElement;
      const selShareBtn = document.getElementById('foto-sel-share') as HTMLButtonElement;
      const selCancelBtn = document.getElementById('foto-sel-cancel') as HTMLButtonElement;

      const toastEl = document.getElementById('foto-toast')!;

      type LbAsset = { id: string; type: 'IMAGE' | 'VIDEO' };
      type Person = { id: string; name: string; count: number };

      let currentAssets: LbAsset[] = [];
      let selectionMode = false;
      const selectedIds = new Set<string>();
      let longPressActivated = false;

      // Поддержка шеринга нескольких файлов (для кнопки «Поделиться» в панели выбора)
      let canShareFiles = false;
      try {
        const probe = new File(['x'], 'x.txt', { type: 'text/plain' });
        canShareFiles = !!(navigator.canShare && navigator.canShare({ files: [probe] }));
      } catch {
        canShareFiles = false;
      }

      function setStatus(text: string) { status.textContent = text; }
      function haptic() { try { navigator.vibrate && navigator.vibrate(8); } catch { /* noop */ } }

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function toast(msg: string) {
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2200);
      }

      // ====== Лайтбокс ======
      let lbAssets: LbAsset[] = [];
      let lbIndex = 0;

      function openLightbox(assets: LbAsset[], index: number) {
        lbAssets = assets;
        lbIndex = index;
        updateLightboxPhoto();
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        lbImg.src = '';
        lbVid.pause();
        lbVid.src = '';
      }
      function updateLightboxPhoto() {
        const asset = lbAssets[lbIndex];
        if (asset.type === 'VIDEO') {
          lbImg.style.display = 'none';
          lbVid.style.display = 'block';
          lbVid.src = `/api/foto/image/${asset.id}?kind=original`;
        } else {
          lbVid.style.display = 'none';
          lbImg.style.display = 'block';
          lbImg.src = `/api/foto/image/${asset.id}?kind=original`;
        }
        lbPrev.disabled = lbIndex === 0;
        lbNext.disabled = lbIndex === lbAssets.length - 1;
      }
      function navLightbox(delta: number) {
        const next = lbIndex + delta;
        if (next < 0 || next >= lbAssets.length) return;
        lbIndex = next;
        updateLightboxPhoto();
      }

      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => navLightbox(-1));
      lbNext.addEventListener('click', () => navLightbox(1));
      lbDownload.addEventListener('click', () => downloadAsset(lbAssets[lbIndex]));
      lbShare.addEventListener('click', () => shareAsset(lbAssets[lbIndex]));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navLightbox(-1);
        if (e.key === 'ArrowRight') navLightbox(1);
      });

      let touchStartX = 0;
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) navLightbox(dx < 0 ? 1 : -1);
      }, { passive: true });

      // ====== Скачивание / шеринг одного файла ======
      function downloadAsset(asset: LbAsset) {
        if (!asset) return;
        const a = document.createElement('a');
        a.href = `/api/foto/image/${asset.id}?kind=original&download=1`;
        document.body.appendChild(a);
        a.click();
        a.remove();
      }

      async function shareAsset(asset: LbAsset) {
        if (!asset) return;
        try {
          const res = await fetch(`/api/foto/image/${asset.id}?kind=original`);
          const blob = await res.blob();
          const ext = asset.type === 'VIDEO' ? 'mp4' : 'jpg';
          const type = blob.type || (asset.type === 'VIDEO' ? 'video/mp4' : 'image/jpeg');
          const file = new File([blob], `foto-${asset.id}.${ext}`, { type });
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file] });
            return;
          }
          if (navigator.share) {
            await navigator.share({ url: location.href });
            return;
          }
          await navigator.clipboard.writeText(location.href);
          toast('Ссылка скопирована');
        } catch {
          // отмена шеринга пользователем или недоступность — тихо игнорируем
        }
      }

      // ====== ZIP (массовое скачивание / шеринг) ======
      async function fetchZipBlob(ids: string[]): Promise<Blob> {
        const res = await fetch(`/api/foto/${shiftId}/zip`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids }),
        });
        if (!res.ok) throw new Error('zip failed');
        return await res.blob();
      }
      function downloadBlob(blob: Blob, filename: string) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      async function runZip(ids: string[], btn: HTMLButtonElement, shareMode: boolean) {
        if (!ids.length) return;
        const old = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = 'Готовлю…';
        try {
          const blob = await fetchZipBlob(ids);
          if (shareMode) {
            const file = new File([blob], 'foto.zip', { type: 'application/zip' });
            if (navigator.canShare && navigator.canShare({ files: [file] })) {
              await navigator.share({ files: [file] });
            }
          } else {
            downloadBlob(blob, 'foto.zip');
          }
        } catch (e) {
          if (!(e && (e as Error).name === 'AbortError')) toast('Не удалось подготовить архив');
        } finally {
          btn.disabled = false;
          btn.innerHTML = old;
        }
      }

      downloadAllBtn.addEventListener('click', () => {
        runZip(currentAssets.map((a) => a.id), downloadAllBtn, false);
      });
      selZipBtn.addEventListener('click', () => runZip([...selectedIds], selZipBtn, false));
      selShareBtn.addEventListener('click', () => runZip([...selectedIds], selShareBtn, true));
      selCancelBtn.addEventListener('click', exitSelectionMode);

      // ====== Режим выбора ======
      function updateDownloadAll() {
        const show = !selectionMode && currentAssets.length > 0;
        downloadAllBtn.classList.toggle('show', show);
        const label = document.getElementById('foto-download-all-label');
        if (label) label.textContent = `Скачать всё (${currentAssets.length} фото)`;
      }
      function updateSelbar() {
        selbar.classList.toggle('open', selectionMode);
        selCount.textContent = String(selectedIds.size);
        selShareBtn.style.display = canShareFiles ? 'inline-flex' : 'none';
        selZipBtn.disabled = selectedIds.size === 0;
        selShareBtn.disabled = selectedIds.size === 0;
      }
      function enterSelectionMode() {
        if (selectionMode) return;
        selectionMode = true;
        grid.classList.add('selecting');
        updateSelbar();
        updateDownloadAll();
      }
      function exitSelectionMode() {
        selectionMode = false;
        selectedIds.clear();
        grid.classList.remove('selecting');
        grid.querySelectorAll('.foto-cell.selected').forEach((el) => el.classList.remove('selected'));
        updateSelbar();
        updateDownloadAll();
      }
      function toggleSelect(id: string, cell: HTMLElement) {
        if (selectedIds.has(id)) {
          selectedIds.delete(id);
          cell.classList.remove('selected');
        } else {
          selectedIds.add(id);
          cell.classList.add('selected');
        }
        updateSelbar();
      }

      // ====== Сетка ======
      function clearGrid() { grid.innerHTML = ''; }

      function renderPhotoGrid(assets: LbAsset[]) {
        exitSelectionMode();
        clearGrid();
        assets.forEach((asset, idx) => {
          const cell = document.createElement('div');
          cell.className = 'foto-cell';
          cell.dataset.id = asset.id;

          const img = document.createElement('img');
          img.src = `/api/foto/image/${asset.id}?kind=thumb`;
          img.loading = 'lazy';
          img.alt = '';
          cell.appendChild(img);

          if (asset.type === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'foto-video-badge';
            badge.innerHTML = '<i class="bi bi-play-fill"></i>';
            cell.appendChild(badge);
          }

          const mark = document.createElement('span');
          mark.className = 'foto-select-mark';
          mark.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
          cell.appendChild(mark);

          // Долгий тап (500мс) включает режим выбора
          let pressTimer: ReturnType<typeof setTimeout> | null = null;
          let startX = 0;
          let startY = 0;
          const clearPress = () => {
            if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
          };
          cell.addEventListener('pointerdown', (e) => {
            if (selectionMode) return;
            longPressActivated = false;
            startX = e.clientX;
            startY = e.clientY;
            clearPress();
            pressTimer = setTimeout(() => {
              pressTimer = null;
              enterSelectionMode();
              toggleSelect(asset.id, cell);
              longPressActivated = true;
              haptic();
            }, 500);
          });
          cell.addEventListener('pointermove', (e) => {
            if (pressTimer && (Math.abs(e.clientX - startX) > 10 || Math.abs(e.clientY - startY) > 10)) {
              clearPress();
            }
          });
          cell.addEventListener('pointerup', clearPress);
          cell.addEventListener('pointerleave', clearPress);
          cell.addEventListener('pointercancel', clearPress);

          cell.addEventListener('click', () => {
            if (longPressActivated) { longPressActivated = false; return; }
            if (selectionMode) { toggleSelect(asset.id, cell); return; }
            openLightbox(currentAssets, idx);
          });

          grid.appendChild(cell);
        });
        updateDownloadAll();
      }

      // ====== Загрузка данных ======
      async function loadPeopleData(): Promise<Person[]> {
        const res = await fetch(`/api/foto/${shiftId}/people`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return []; }
        return data.people as Person[];
      }

      function setActiveAvatar(personId: string) {
        avatars.querySelectorAll('.foto-ava').forEach((el) => {
          (el as HTMLElement).classList.toggle('active', (el as HTMLElement).dataset.person === personId);
        });
      }

      function buildAvatars(people: Person[]) {
        avatars.innerHTML = '';

        // «Все фото» — фиксированная плашка
        const allEl = document.createElement('button');
        allEl.type = 'button';
        allEl.className = 'foto-ava';
        allEl.dataset.person = '';
        const allCircle = document.createElement('span');
        allCircle.className = 'foto-ava-circle foto-ava-all-circle';
        allCircle.innerHTML = '<i class="bi bi-collection"></i>';
        const allName = document.createElement('span');
        allName.className = 'foto-ava-name';
        allName.textContent = 'Все фото';
        allEl.append(allCircle, allName);
        allEl.addEventListener('click', selectAll);
        avatars.appendChild(allEl);

        for (const p of people) {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'foto-ava';
          el.dataset.person = p.id;
          const circle = document.createElement('span');
          circle.className = 'foto-ava-circle';
          const img = document.createElement('img');
          img.src = `/api/foto/${shiftId}/avatar/${p.id}`;
          img.loading = 'lazy';
          img.alt = '';
          circle.appendChild(img);
          const name = document.createElement('span');
          name.className = 'foto-ava-name';
          name.textContent = p.name;
          el.append(circle, name);
          el.addEventListener('click', () => selectPerson(p.id));
          avatars.appendChild(el);
        }
      }

      // ====== Cookie-память выбора ======
      function setPersonCookie(personId: string) {
        document.cookie = 'foto_person_' + shiftId + '=' + personId +
          '; path=/foto/' + shiftId + '; max-age=15552000; SameSite=Lax';
      }
      function clearPersonCookie() {
        document.cookie = 'foto_person_' + shiftId + '=; path=/foto/' + shiftId + '; max-age=0';
      }
      function readPersonCookie(): string | null {
        const prefix = 'foto_person_' + shiftId + '=';
        for (const part of document.cookie.split(';')) {
          const s = part.trim();
          if (s.indexOf(prefix) === 0) return s.slice(prefix.length);
        }
        return null;
      }

      async function selectAll() {
        exitSelectionMode();
        setActiveAvatar('');
        clearPersonCookie();
        setStatus('Загружаю фото смены…');
        const res = await fetch(`/api/foto/${shiftId}/all`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); currentAssets = []; clearGrid(); updateDownloadAll(); return; }
        currentAssets = data.assets as LbAsset[];
        setStatus(`Все фото смены: ${currentAssets.length}`);
        renderPhotoGrid(currentAssets);
      }

      async function selectPerson(personId: string) {
        exitSelectionMode();
        setActiveAvatar(personId);
        setPersonCookie(personId);
        setStatus('Загружаю фото…');
        const res = await fetch(`/api/foto/${shiftId}/people?personId=${encodeURIComponent(personId)}`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); currentAssets = []; clearGrid(); updateDownloadAll(); return; }
        currentAssets = (data.assetIds as { id: string; type: 'IMAGE' | 'VIDEO' }[]).map((a) => ({ id: a.id, type: a.type }));
        setStatus(`${data.name}: ${currentAssets.length} фото`);
        renderPhotoGrid(currentAssets);
      }

      async function init() {
        setStatus('Загружаю…');
        const people = await loadPeopleData();
        buildAvatars(people);
        const saved = readPersonCookie();
        if (saved && people.some((p) => p.id === saved)) {
          selectPerson(saved);
        } else {
          selectAll();
        }
      }

      init();
    }
  </script>

  <script>
    import { scheduleBind } from '../../lib/attribution/collectAndBind';

    const rootEl = document.getElementById('foto-root');
    const lid = rootEl?.dataset.lid;
    const t = rootEl?.dataset.t;
    const shiftId = rootEl?.dataset.shiftId;

    // Атрибуция запускается только при подписанной ссылке (lid+t). Без них —
    // страница работает как для органических визитов, scheduleBind не вызывается.
    if (lid && t && shiftId) {
      const isManagerBrowser = (() => {
        try {
          return localStorage.getItem('aidacamp_is_manager') === '1';
        } catch {
          return false;
        }
      })();
      scheduleBind(
        { lid: Number(lid), t, isPreview: false, isManagerBrowser, storageKey: 'foto_bound_' + shiftId + '_' + lid },
        96499295,
      );
    }
  </script>
</Base>
