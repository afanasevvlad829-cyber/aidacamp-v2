---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { allShiftsIncludingArchived } from '../../data/shifts';

const { shiftId } = Astro.params;
const shift = allShiftsIncludingArchived.find((s) => s.id === shiftId);
---

<Base
  title={shift ? `Фото — ${shift.name}` : 'Фото смены'}
  description="Фото со смены АйДаКемп"
  noindex={true}
  hideMarketingWidgets={true}
>
  <style>
    body {
      overflow-x: hidden;
    }

    #foto-root {
      max-width: 960px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .foto-controls {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin: 16px 0;
    }

    #foto-person-select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      min-height: 44px;
    }

    #foto-tab-unsorted {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      cursor: pointer;
      min-height: 44px;
    }

    @media (max-width: 640px) {
      .foto-controls {
        flex-direction: column;
        align-items: stretch;
      }

      #foto-person-select,
      #foto-tab-unsorted {
        width: 100%;
        box-sizing: border-box;
      }
    }

    @media (max-width: 400px) {
      #foto-grid {
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important;
      }
    }

    /* Lightbox */
    #foto-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.92);
      align-items: center;
      justify-content: center;
      touch-action: none;
    }

    #foto-lightbox.open {
      display: flex;
    }

    #foto-lightbox-img,
    #foto-lightbox-video {
      max-width: 90vw;
      max-height: 90vh;
      max-height: 90dvh;
      object-fit: contain;
      border-radius: 4px;
      display: block;
    }

    #foto-lightbox-video {
      display: none;
    }

    .foto-lb-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 28px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
      z-index: 10000;
    }

    .foto-lb-nav:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .foto-lb-nav:disabled {
      opacity: 0.2;
      cursor: default;
    }

    #foto-lb-prev { left: 16px; }
    #foto-lb-next { right: 16px; }

    #foto-lb-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      line-height: 1;
    }

    #foto-lb-close:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .foto-video-badge {
      position: absolute;
      bottom: 6px;
      right: 6px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border-radius: 4px;
      padding: 2px 5px;
      font-size: 12px;
      pointer-events: none;
      line-height: 1.4;
    }

    @media (max-width: 640px) {
      .foto-lb-nav {
        width: 44px;
        height: 44px;
        font-size: 22px;
      }

      #foto-lb-prev { left: 8px; }
      #foto-lb-next { right: 8px; }

      /* Сужаем фото чтобы кнопки по бокам не перекрывали */
      #foto-lightbox-img,
      #foto-lightbox-video {
        max-width: calc(100vw - 100px);
        max-height: 85dvh;
      }
    }
  </style>

  <main id="foto-root" data-shift-id={shiftId}>
    {!shift && <p>Смена не найдена.</p>}
    {shift && (
      <>
        <h1>{shift.name} — фото</h1>
        <div class="foto-controls">
          <select id="foto-person-select">
            <option value="">Выбери ребёнка…</option>
          </select>
          <button id="foto-tab-unsorted" type="button">
            Неразобранные
          </button>
        </div>
        <div id="foto-status" style="color:#64748b;font-size:14px;min-height:20px;"></div>
        <div id="foto-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;margin-top:16px;"></div>
      </>
    )}
  </main>

  <div id="foto-lightbox" role="dialog" aria-modal="true" aria-label="Просмотр фото">
    <button id="foto-lb-close" aria-label="Закрыть">&#10005;</button>
    <button id="foto-lb-prev" class="foto-lb-nav" aria-label="Предыдущее">&#8249;</button>
    <img id="foto-lightbox-img" src="" alt="Фото" />
    <video id="foto-lightbox-video" controls></video>
    <button id="foto-lb-next" class="foto-lb-nav" aria-label="Следующее">&#8250;</button>
  </div>

  <script>
    const root = document.getElementById('foto-root');
    if (root) {
      const shiftId = root.dataset.shiftId;
      const select = document.getElementById('foto-person-select') as HTMLSelectElement;
      const tabUnsorted = document.getElementById('foto-tab-unsorted') as HTMLButtonElement;
      const status = document.getElementById('foto-status')!;
      const grid = document.getElementById('foto-grid')!;

      const lightbox = document.getElementById('foto-lightbox')!;
      const lbImg = document.getElementById('foto-lightbox-img') as HTMLImageElement;
      const lbVideo = document.getElementById('foto-lightbox-video') as HTMLVideoElement;
      const lbPrev = document.getElementById('foto-lb-prev') as HTMLButtonElement;
      const lbNext = document.getElementById('foto-lb-next') as HTMLButtonElement;
      const lbClose = document.getElementById('foto-lb-close') as HTMLButtonElement;

      type AssetRef = { id: string; type: 'IMAGE' | 'VIDEO' };

      let lbAssets: AssetRef[] = [];
      let lbIndex = 0;

      function openLightbox(assets: AssetRef[], index: number) {
        lbAssets = assets;
        lbIndex = index;
        updateLightboxPhoto();
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        lbImg.src = '';
        lbVideo.pause();
        lbVideo.src = '';
        lbImg.style.display = 'block';
        lbVideo.style.display = 'none';
      }

      function updateLightboxPhoto() {
        const asset = lbAssets[lbIndex];
        const src = `/api/foto/image/${asset.id}?kind=original`;
        if (asset.type === 'VIDEO') {
          lbImg.style.display = 'none';
          lbVideo.style.display = 'block';
          lbVideo.src = src;
        } else {
          lbVideo.style.display = 'none';
          lbVideo.src = '';
          lbImg.style.display = 'block';
          lbImg.src = src;
        }
        lbPrev.disabled = lbIndex === 0;
        lbNext.disabled = lbIndex === lbAssets.length - 1;
      }

      function navLightbox(delta: number) {
        const next = lbIndex + delta;
        if (next < 0 || next >= lbAssets.length) return;
        lbIndex = next;
        updateLightboxPhoto();
      }

      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => navLightbox(-1));
      lbNext.addEventListener('click', () => navLightbox(1));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navLightbox(-1);
        if (e.key === 'ArrowRight') navLightbox(1);
      });

      let touchStartX = 0;
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) navLightbox(dx < 0 ? 1 : -1);
      }, { passive: true });

      function setStatus(text: string) {
        status.textContent = text;
      }
      function clearGrid() {
        grid.innerHTML = '';
      }

      function renderPhotoGrid(assets: AssetRef[]) {
        clearGrid();
        assets.forEach((asset, idx) => {
          const wrap = document.createElement('div');
          wrap.style.cssText = 'position:relative;';
          const img = document.createElement('img');
          img.src = `/api/foto/image/${asset.id}?kind=thumb`;
          img.loading = 'lazy';
          img.style.cssText = 'width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;cursor:pointer;display:block;';
          img.addEventListener('click', () => openLightbox(assets, idx));
          wrap.appendChild(img);
          if (asset.type === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'foto-video-badge';
            badge.textContent = '▶';
            wrap.appendChild(badge);
          }
          grid.appendChild(wrap);
        });
      }

      async function loadPeople() {
        setStatus('Загружаю список детей…');
        const res = await fetch(`/api/foto/${shiftId}/people`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        select.innerHTML = '<option value="">Выбери ребёнка…</option>';
        for (const p of data.people as { id: string; name: string; count: number }[]) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = `${p.name} (${p.count})`;
          select.appendChild(opt);
        }
        setStatus(data.people.length ? '' : 'Пока никто не подписан — загляни в «Неразобранные».');
      }

      async function loadPersonPhotos(personId: string) {
        setStatus('Загружаю фото…');
        const res = await fetch(`/api/foto/${shiftId}/people?personId=${encodeURIComponent(personId)}`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        setStatus(`${data.name}: ${(data.assetIds as AssetRef[]).length} фото`);
        renderPhotoGrid(data.assetIds as AssetRef[]);
      }

      type FaceBox = { x1: number; y1: number; x2: number; y2: number; width: number; height: number };
      type UnsortedFaceData = { assetId: string; faceId: string; assetType: 'IMAGE' | 'VIDEO'; box: FaceBox };

      async function loadUnsorted() {
        setStatus('Загружаю неразобранные фото…');
        const res = await fetch(`/api/foto/${shiftId}/unsorted`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        clearGrid();
        setStatus(`Неразобранных лиц: ${data.faces.length}`);
        const people = data.people as { id: string; name: string }[];
        for (const face of data.faces as UnsortedFaceData[]) {
          const card = document.createElement('div');

          const cropWrap = document.createElement('div');
          cropWrap.style.cssText = 'position:relative;overflow:hidden;aspect-ratio:1;border-radius:8px;';

          const img = document.createElement('img');
          img.src = `/api/foto/image/${face.assetId}?kind=thumb`;
          img.loading = 'lazy';
          // fallback until naturalWidth is known
          img.style.cssText = 'width:100%;height:100%;object-fit:cover;';

          img.addEventListener('load', () => {
            const { naturalWidth } = img;
            if (!naturalWidth || !face.box.width) return;
            const containerSize = cropWrap.clientWidth || 140;
            const half = containerSize / 2;
            const scale = naturalWidth / face.box.width;
            const cx = ((face.box.x1 + face.box.x2) / 2) * scale;
            const cy = ((face.box.y1 + face.box.y2) / 2) * scale;
            const fw = (face.box.x2 - face.box.x1) * scale;
            const fh = (face.box.y2 - face.box.y1) * scale;
            const zoom = containerSize / (Math.max(fw, fh) * 1.6);
            const tx = half - cx * zoom;
            const ty = half - cy * zoom;
            img.style.cssText = `width:${img.naturalWidth}px;height:${img.naturalHeight}px;object-fit:none;transform-origin:0 0;transform:translate(${tx}px,${ty}px) scale(${zoom});`;
          });

          cropWrap.appendChild(img);

          if (face.assetType === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'foto-video-badge';
            badge.textContent = '▶';
            cropWrap.appendChild(badge);
          }

          card.appendChild(cropWrap);

          const sel = document.createElement('select');
          sel.style.cssText = 'width:100%;margin-top:4px;';
          sel.innerHTML =
            '<option value="">Кто это?</option>' +
            people.map((p) => `<option value="${p.id}">${p.name}</option>`).join('');
          sel.addEventListener('change', async () => {
            if (!sel.value) return;
            sel.disabled = true;
            const r = await fetch(`/api/foto/${shiftId}/unsorted`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ faceId: face.faceId, personId: sel.value }),
            });
            const rd = await r.json();
            if (rd.ok) { card.remove(); } else { sel.disabled = false; alert(rd.error); }
          });
          card.appendChild(sel);
          grid.appendChild(card);
        }
      }

      select.addEventListener('change', () => {
        if (select.value) loadPersonPhotos(select.value);
      });
      tabUnsorted.addEventListener('click', loadUnsorted);

      loadPeople();
    }
  </script>
</Base>
