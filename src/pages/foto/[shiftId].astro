---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { allShiftsIncludingArchived } from '../../data/shifts';

const { shiftId } = Astro.params;
const shift = allShiftsIncludingArchived.find((s) => s.id === shiftId);
---

<Base
  title={shift ? `Фото — ${shift.name}` : 'Фото смены'}
  description="Фото со смены АйДаКемп"
  noindex={true}
  hideMarketingWidgets={true}
>
  <style>
    body {
      overflow-x: hidden;
    }

    #foto-root {
      max-width: 960px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .foto-controls {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin: 16px 0;
    }

    #foto-person-select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      min-height: 44px;
    }

    #foto-tab-unsorted {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      cursor: pointer;
      min-height: 44px;
    }

    @media (max-width: 640px) {
      .foto-controls {
        flex-direction: column;
        align-items: stretch;
      }

      #foto-person-select,
      #foto-tab-unsorted {
        width: 100%;
        box-sizing: border-box;
      }
    }

    @media (max-width: 400px) {
      #foto-grid {
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important;
      }
    }

    /* Lightbox */
    #foto-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.92);
      align-items: center;
      justify-content: center;
      touch-action: none;
    }

    #foto-lightbox.open {
      display: flex;
    }

    #foto-lightbox-img {
      max-width: 90vw;
      max-height: 90vh;
      max-height: 90dvh;
      object-fit: contain;
      border-radius: 4px;
      display: block;
    }

    .foto-lb-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 28px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
      z-index: 10000;
    }

    .foto-lb-nav:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .foto-lb-nav:disabled {
      opacity: 0.2;
      cursor: default;
    }

    #foto-lb-prev { left: 16px; }
    #foto-lb-next { right: 16px; }

    #foto-lb-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      font-size: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      line-height: 1;
    }

    #foto-lb-close:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    @media (max-width: 640px) {
      .foto-lb-nav {
        width: 44px;
        height: 44px;
        font-size: 22px;
      }

      #foto-lb-prev { left: 8px; }
      #foto-lb-next { right: 8px; }

      /* Сужаем фото чтобы кнопки по бокам не перекрывали */
      #foto-lightbox-img,
      #foto-lightbox-vid {
        max-width: calc(100vw - 100px);
        max-height: 85dvh;
      }
    }

    #foto-lightbox-vid {
      display: none;
      max-width: 90vw;
      max-height: 90vh;
      max-height: 90dvh;
      border-radius: 4px;
    }

  </style>

  <style is:global>
    /* Видеобейдж поверх превью (JS-created) */
    .foto-video-badge {
      position: absolute;
      bottom: 6px;
      right: 6px;
      background: rgba(0,0,0,0.6);
      color: #fff;
      border-radius: 50%;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      pointer-events: none;
    }

    /* Неразобранные — карточка на одно фото (JS-created) */
    .foto-unsorted-group {
      background: #f8fafc;
      border-radius: 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .foto-unsorted-thumb-wrap {
      position: relative;
      display: block;
      cursor: pointer;
    }

    .foto-unsorted-thumb {
      width: 100%;
      max-height: 360px;
      object-fit: contain;
      border-radius: 8px;
      display: block;
    }

    .foto-recognized-names {
      font-size: 13px;
      color: #475569;
    }

    /* Нумерованная метка лица поверх фото (JS-created) */
    .foto-face-marker {
      position: absolute;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      border: 2px solid #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      pointer-events: none;
      line-height: 1;
    }

    /* Список выборов под фото (JS-created) */
    .foto-face-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .foto-face-list-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
    }

    .foto-face-list-item select {
      padding: 4px 8px;
      border-radius: 6px;
      border: 1px solid #cbd5e1;
      font-size: 13px;
    }
  </style>

  <main id="foto-root" data-shift-id={shiftId}>
    {!shift && <p>Смена не найдена.</p>}
    {shift && (
      <>
        <h1>{shift.name} — фото</h1>
        <div class="foto-controls">
          <select id="foto-person-select">
            <option value="">Выбери ребёнка…</option>
          </select>
          <button id="foto-tab-unsorted" type="button">
            Неразобранные
          </button>
        </div>
        <div id="foto-status" style="color:#64748b;font-size:14px;min-height:20px;"></div>
        <div id="foto-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;margin-top:16px;"></div>
      </>
    )}
  </main>

  <div id="foto-lightbox" role="dialog" aria-modal="true" aria-label="Просмотр фото">
    <button id="foto-lb-close" aria-label="Закрыть">&#10005;</button>
    <button id="foto-lb-prev" class="foto-lb-nav" aria-label="Предыдущее">&#8249;</button>
    <img id="foto-lightbox-img" src="" alt="Фото" />
    <video id="foto-lightbox-vid" controls></video>
    <button id="foto-lb-next" class="foto-lb-nav" aria-label="Следующее">&#8250;</button>
  </div>

  <script>
    const root = document.getElementById('foto-root');
    if (root) {
      const shiftId = root.dataset.shiftId;
      const select = document.getElementById('foto-person-select') as HTMLSelectElement;
      const tabUnsorted = document.getElementById('foto-tab-unsorted') as HTMLButtonElement;
      const status = document.getElementById('foto-status')!;
      const grid = document.getElementById('foto-grid')!;

      const lightbox = document.getElementById('foto-lightbox')!;
      const lbImg = document.getElementById('foto-lightbox-img') as HTMLImageElement;
      const lbVid = document.getElementById('foto-lightbox-vid') as HTMLVideoElement;
      const lbPrev = document.getElementById('foto-lb-prev') as HTMLButtonElement;
      const lbNext = document.getElementById('foto-lb-next') as HTMLButtonElement;
      const lbClose = document.getElementById('foto-lb-close') as HTMLButtonElement;

      type LbAsset = { id: string; type: 'IMAGE' | 'VIDEO' };
      let lbAssets: LbAsset[] = [];
      let lbIndex = 0;

      function openLightbox(assets: LbAsset[], index: number) {
        lbAssets = assets;
        lbIndex = index;
        updateLightboxPhoto();
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        lbImg.src = '';
        lbVid.pause();
        lbVid.src = '';
      }

      function updateLightboxPhoto() {
        const asset = lbAssets[lbIndex];
        if (asset.type === 'VIDEO') {
          lbImg.style.display = 'none';
          lbVid.style.display = 'block';
          lbVid.src = `/api/foto/image/${asset.id}?kind=original`;
        } else {
          lbVid.style.display = 'none';
          lbImg.style.display = 'block';
          lbImg.src = `/api/foto/image/${asset.id}?kind=original`;
        }
        lbPrev.disabled = lbIndex === 0;
        lbNext.disabled = lbIndex === lbAssets.length - 1;
      }

      function navLightbox(delta: number) {
        const next = lbIndex + delta;
        if (next < 0 || next >= lbAssets.length) return;
        lbIndex = next;
        updateLightboxPhoto();
      }

      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => navLightbox(-1));
      lbNext.addEventListener('click', () => navLightbox(1));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navLightbox(-1);
        if (e.key === 'ArrowRight') navLightbox(1);
      });

      let touchStartX = 0;
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) navLightbox(dx < 0 ? 1 : -1);
      }, { passive: true });

      function setStatus(text: string) {
        status.textContent = text;
      }
      function clearGrid() {
        grid.innerHTML = '';
      }

      function renderPhotoGrid(assets: LbAsset[]) {
        clearGrid();
        grid.style.gridTemplateColumns = 'repeat(auto-fill,minmax(140px,1fr))';
        assets.forEach((asset, idx) => {
          const wrap = document.createElement('div');
          wrap.style.cssText = 'position:relative;cursor:pointer;';
          const img = document.createElement('img');
          img.src = `/api/foto/image/${asset.id}?kind=thumb`;
          img.loading = 'lazy';
          img.style.cssText = 'width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;display:block;';
          wrap.appendChild(img);
          if (asset.type === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'foto-video-badge';
            badge.textContent = '▶';
            wrap.appendChild(badge);
          }
          wrap.addEventListener('click', () => openLightbox(assets, idx));
          grid.appendChild(wrap);
        });
      }

      async function loadPeople() {
        setStatus('Загружаю список детей…');
        const res = await fetch(`/api/foto/${shiftId}/people`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        select.innerHTML = '<option value="">Выбери ребёнка…</option>';
        for (const p of data.people as { id: string; name: string; count: number }[]) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = `${p.name} (${p.count})`;
          select.appendChild(opt);
        }
        setStatus(data.people.length ? '' : 'Пока никто не подписан — загляни в «Неразобранные».');
      }

      async function loadPersonPhotos(personId: string) {
        setStatus('Загружаю фото…');
        const res = await fetch(`/api/foto/${shiftId}/people?personId=${encodeURIComponent(personId)}`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        setStatus(`${data.name}: ${data.assetIds.length} фото`);
        renderPhotoGrid(data.assetIds as LbAsset[]);
      }

      type FaceBox = { x1: number; y1: number; x2: number; y2: number; width: number; height: number };
      type UnsortedGroup = {
        assetId: string;
        assetType: 'IMAGE' | 'VIDEO';
        recognizedNames: string[];
        faces: { faceId: string; box: FaceBox }[];
      };

      async function loadUnsorted() {
        setStatus('Загружаю неразобранные фото…');
        const res = await fetch(`/api/foto/${shiftId}/unsorted`);
        const data = await res.json();
        if (!data.ok) { setStatus(data.error); return; }
        clearGrid();
        grid.style.gridTemplateColumns = '1fr';
        const groups = data.groups as UnsortedGroup[];
        const people = data.people as { id: string; name: string }[];
        const totalFaces = groups.reduce((n, g) => n + g.faces.length, 0);
        setStatus(`Неразобранных лиц: ${totalFaces} на ${groups.length} фото`);

        const peopleOptions = '<option value="">Кто это?</option>' +
          people.map((p) => `<option value="${p.id}">${p.name}</option>`).join('');

        for (const group of groups) {
          const card = document.createElement('div');
          card.className = 'foto-unsorted-group';

          // Превью фото с нумерованными метками лиц
          const thumbWrap = document.createElement('div');
          thumbWrap.className = 'foto-unsorted-thumb-wrap';
          const thumbImg = document.createElement('img');
          thumbImg.src = `/api/foto/image/${group.assetId}?kind=thumb`;
          thumbImg.className = 'foto-unsorted-thumb';
          thumbImg.alt = '';
          thumbWrap.appendChild(thumbImg);

          if (group.assetType === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'foto-video-badge';
            badge.textContent = '▶';
            thumbWrap.appendChild(badge);
          }

          thumbWrap.addEventListener('click', () => openLightbox([{ id: group.assetId, type: group.assetType }], 0));
          card.appendChild(thumbWrap);

          // Уже опознаны
          if (group.recognizedNames.length > 0) {
            const names = document.createElement('div');
            names.className = 'foto-recognized-names';
            names.textContent = `Уже опознаны: ${group.recognizedNames.join(', ')}`;
            card.appendChild(names);
          }

          // Список выборов под фото
          const faceList = document.createElement('div');
          faceList.className = 'foto-face-list';
          card.appendChild(faceList);

          // Метки на фото и строки выборов для каждого лица
          const markers: HTMLElement[] = [];

          for (let i = 0; i < group.faces.length; i++) {
            const face = group.faces[i];

            // Кружок-метка поверх фото (скрыт до позиционирования)
            const marker = document.createElement('div');
            marker.className = 'foto-face-marker';
            marker.textContent = String(i + 1);
            marker.style.visibility = 'hidden';
            thumbWrap.appendChild(marker);
            markers.push(marker);

            // Строка выбора под фото
            const listItem = document.createElement('div');
            listItem.className = 'foto-face-list-item';

            const label = document.createElement('span');
            label.textContent = `${i + 1})`;
            listItem.appendChild(label);

            const sel = document.createElement('select');
            sel.innerHTML = peopleOptions;
            sel.addEventListener('change', async () => {
              if (!sel.value) return;
              sel.disabled = true;
              const r = await fetch(`/api/foto/${shiftId}/unsorted`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ faceId: face.faceId, personId: sel.value }),
              });
              const rd = await r.json();
              if (rd.ok) {
                marker.remove();
                listItem.remove();
                if (faceList.childElementCount === 0) card.remove();
              } else {
                sel.disabled = false;
                alert(rd.error);
              }
            });
            listItem.appendChild(sel);
            faceList.appendChild(listItem);
          }

          // Позиционирование кружков по координатам box с учётом object-fit:contain
          function positionMarkers() {
            if (!thumbImg.naturalWidth) return;
            const containerW = thumbWrap.clientWidth;
            const containerH = thumbWrap.clientHeight;
            if (!containerW || !containerH) return;
            const imgAspect = thumbImg.naturalWidth / thumbImg.naturalHeight;
            const containerAspect = containerW / containerH;
            let renderedW, renderedH, offsetX, offsetY;
            if (imgAspect > containerAspect) {
              renderedW = containerW; renderedH = containerW / imgAspect;
              offsetX = 0; offsetY = (containerH - renderedH) / 2;
            } else {
              renderedH = containerH; renderedW = containerH * imgAspect;
              offsetY = 0; offsetX = (containerW - renderedW) / 2;
            }
            for (let j = 0; j < group.faces.length; j++) {
              const m = markers[j];
              if (!m.parentNode) continue;
              const box = group.faces[j].box;
              const scale = renderedW / box.width;
              const markerX = offsetX + ((box.x1 + box.x2) / 2) * scale;
              // Метка не на самом лице (закрывала его), а чуть выше — над верхней границей box.
              const markerTopY = offsetY + box.y1 * scale;
              // Зажимаем в границы реально отображаемого фото (с учётом letterbox-отступов
              // offsetX/offsetY) — иначе метка для лица у самого края кадра уезжает за фото.
              const left = Math.min(Math.max(markerX - 12, offsetX), offsetX + renderedW - 24);
              const top = Math.min(Math.max(markerTopY - 12 - 6, offsetY), offsetY + renderedH - 24);
              m.style.left = `${left}px`;
              m.style.top = `${top}px`;
              m.style.visibility = '';
            }
          }

          thumbImg.addEventListener('load', positionMarkers);
          if (thumbImg.complete && thumbImg.naturalWidth) positionMarkers();

          let resizeTimer: ReturnType<typeof setTimeout> | undefined;
          window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(positionMarkers, 150);
          });

          grid.appendChild(card);
        }
      }

      select.addEventListener('change', () => {
        if (select.value) loadPersonPhotos(select.value);
      });
      tabUnsorted.addEventListener('click', loadUnsorted);

      loadPeople();
    }
  </script>
</Base>
