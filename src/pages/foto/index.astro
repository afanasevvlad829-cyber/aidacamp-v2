---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';
---

<Base
  title="Фото из лагеря АйДаКемп — занятия, бассейн, природа"
  description="Фото с летних смен IT-лагеря АйДаКемп: дети на занятиях, бассейн, хакатон, природа Подмосковья."
>
  <Header />
  <main class="min-h-[60vh]">
    <!-- Hero block: реальное фото лагеря + затемняющие градиенты для читаемости текста -->
    <section class="relative overflow-hidden bg-dark-navy text-white">
      <!-- Background photo -->
      <img src="/images/hero-desktop.avif" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-55" loading="eager" />
      <!-- Dark gradient overlay (left → right) — контраст текста -->
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,9,18,0.85)_0%,rgba(5,9,18,0.6)_35%,rgba(5,9,18,0.3)_65%,rgba(5,9,18,0.1)_100%)]" aria-hidden="true"></div>
      <!-- Top gradient — гарантирует контраст header navigation -->
      <div class="absolute top-0 left-0 right-0 h-[100px] bg-[linear-gradient(180deg,rgba(0,0,0,0.45)_0%,rgba(0,0,0,0.18)_60%,rgba(0,0,0,0)_100%)] pointer-events-none" aria-hidden="true"></div>
      <!-- Brand orange ambient -->
      <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_70%_30%,rgba(236,155,68,0.12)_0%,transparent_60%)] mix-blend-soft-light" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[1312px] px-4 pt-20 pb-14 md:pt-28 md:pb-20">
        <nav class="mb-4 flex items-center gap-2 text-[13px] text-white/60" aria-label="Хлебные крошки">
          <a href="/" class="hover:text-white">Главная</a>
          <i class="bi bi-chevron-right text-[10px]" aria-hidden="true"></i>
          <span class="text-white/85">Фото</span>
        </nav>
        <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-primary">Фотогалерея</p>
        <h1 class="mt-3 text-[34px] md:text-[54px] font-extrabold leading-[1.05] tracking-[-0.03em] text-white">
          Как выглядит лагерь<br />и наши смены
        </h1>
        <p class="mt-4 max-w-[640px] text-[17px] md:text-[18px] leading-[1.55] text-white/80">
          Реальные фото с летних смен 2024-2025: занятия, бассейн, хакатон, корпуса, природа Подмосковья.
        </p>
      </div>
    </section>

    <Gallery />

    <!-- Back to home -->
    <div class="mx-auto max-w-[1312px] px-4 py-12 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-[15px] font-medium text-primary hover:text-[#d68830]">
        <i class="bi bi-arrow-left text-[14px]" aria-hidden="true"></i>
        На главную
      </a>
    </div>
  </main>
  <Footer />
</Base>
