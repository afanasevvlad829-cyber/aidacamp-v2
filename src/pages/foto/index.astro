---
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';
---

<Base
  title="Фото из лагеря АйДаКемп — занятия, бассейн, природа"
  description="Фото с летних смен IT-лагеря АйДаКемп: дети на занятиях, бассейн, хакатон, природа Подмосковья."
>
  <Header />
  <main class="min-h-[60vh]">
    <div class="mx-auto max-w-[1312px] px-4 pt-8 pb-2 md:pt-12">
      <p class="text-[14px] font-semibold uppercase tracking-wider text-[#ec9b44]">Фотогалерея</p>
      <h1 class="mt-2 text-[32px] md:text-[44px] font-extrabold leading-[1.1] tracking-[-0.03em] text-slate-900">
        Как выглядит лагерь<br>и наши смены
      </h1>
      <p class="mt-3 max-w-[640px] text-[16px] leading-[1.6] text-slate-600">
        Реальные фото с летних смен 2024-2025: занятия, бассейн, хакатон, корпуса, природа.
      </p>
    </div>

    <Gallery />

    <!-- Back to home -->
    <div class="mx-auto max-w-[1312px] px-4 py-12 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-[15px] font-medium text-[#ec9b44] hover:text-[#d68830]">
        <i class="bi bi-arrow-left text-[14px]" aria-hidden="true"></i>
        На главную
      </a>
    </div>
  </main>
  <Footer />
</Base>
