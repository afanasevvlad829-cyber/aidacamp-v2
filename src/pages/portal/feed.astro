---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getActiveShift } from '../../lib/portalShift';
import { listPenalties } from '../../lib/portalPenalty';
import { query } from '../../lib/db';
import dayjs from 'dayjs';
import 'dayjs/locale/ru';
dayjs.locale('ru');

const role = Astro.locals.portalRole;
const sub  = Astro.locals.portalSub;
if (!role) return Astro.redirect('/portal/login');

const shift = await getActiveShift();
const todayISO = new Date().toISOString().slice(0, 10);

// Найти свой staff_id через общий пул
async function staffIdByTg(tg: number): Promise<number | null> {
  const rows = await query<{ id: number }>('SELECT id FROM portal_staff WHERE telegram_id=$1', [tg]);
  return rows?.[0] ? Number(rows[0].id) : null;
}
const myStaffId = sub != null ? await staffIdByTg(sub) : null;

// Все независимые запросы — параллельно через Promise.all
const [myEvents, openPenalties, wakeup] = await Promise.all([
  // События сегодня, где я ответственный и не закрыты
  (shift && myStaffId)
    ? query<any>(
        `SELECT e.id, e.title, e.start_time::text AS start_time, e.end_time::text AS end_time, e.event_type::text,
                EXISTS(SELECT 1 FROM event_content_task t WHERE t.event_id=e.id AND t.status='pending') AS need_photo,
                EXISTS(
                  SELECT 1 FROM event_checklist ec
                   WHERE ec.event_id=e.id
                     AND NOT EXISTS(SELECT 1 FROM checklist_done cd WHERE cd.event_id=e.id AND cd.checklist_id=ec.checklist_id)
                ) AS need_checklist
           FROM shift_event e
          WHERE e.shift_id=$1 AND e.date=$2 AND e.responsible_staff_id=$3
          ORDER BY e.start_time NULLS LAST, e.sort`,
        [shift.id, todayISO, myStaffId],
      ).then(r => r ?? [])
    : Promise.resolve([]),

  // Открытые штрафы
  myStaffId
    ? listPenalties({ staff_id: myStaffId, status: 'open', shift_id: shift?.id })
    : Promise.resolve([]),

  // Подъём сегодня — отметился ли
  (shift && myStaffId)
    ? query<any>(
        `SELECT e.id, e.start_time::text AS start_time,
                EXISTS(SELECT 1 FROM event_self_check esc WHERE esc.event_id=e.id AND esc.staff_id=$3) AS checked
           FROM shift_event e
          WHERE e.shift_id=$1 AND e.date=$2 AND e.event_type='wakeup'
          LIMIT 1`,
        [shift.id, todayISO, myStaffId],
      ).then(r => r?.[0] ?? null)
    : Promise.resolve(null),
]);

const fmtTime = (s: string | null) => s ? s.slice(0, 5) : '';
const sumOpen = openPenalties.reduce((acc, p) => acc + p.amount_rub, 0);
---
<PortalLayout title="Моя лента — АйДаКемп">
  <div class="mb-6">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">Моя лента</h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Что нужно закрыть сегодня. Дата: {dayjs().format('D MMM')}.
    </p>
  </div>

  {!myStaffId && (
    <div class="mb-4 rounded-[12px] border border-amber-200 bg-amber-50 p-3 text-base text-amber-900">
      <i class="bi bi-info-circle" aria-hidden="true"></i>
      Сессия без telegram_id — переоткрой портал через TG-бота, чтобы видеть свою ленту.
    </div>
  )}

  {/* Подъём */}
  {wakeup && (
    <a href="/portal/smena" class="mb-4 flex items-center gap-3 rounded-[14px] border bg-white p-4 card-shadow transition hover:border-primary"
       class:list={[wakeup.checked ? 'border-emerald-200' : 'border-amber-300']}>
      <span class:list={[
        'flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px]',
        wakeup.checked ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-800',
      ]}>
        <i class="bi bi-sun text-[20px]" aria-hidden="true"></i>
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-[16px] font-semibold text-navy-950">Подъём {fmtTime(wakeup.start_time)}</span>
        <span class="mt-0.5 block text-base" class:list={[wakeup.checked ? 'text-emerald-700' : 'text-amber-800']}>
          {wakeup.checked ? '✓ ты отметился' : 'ещё не отметился — кликни чтобы перейти в сетку'}
        </span>
      </span>
    </a>
  )}

  {/* Открытые штрафы */}
  {openPenalties.length > 0 && (
    <a href="/portal/discipline" class="mb-4 flex items-center gap-3 rounded-[14px] border border-red-200 bg-red-50 p-4 card-shadow transition hover:bg-red-100">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-red-100 text-red-800">
        <i class="bi bi-exclamation-triangle-fill text-[20px]" aria-hidden="true"></i>
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-[16px] font-semibold text-red-900">Открытых штрафов: {openPenalties.length} на {sumOpen} ₽</span>
        <span class="mt-0.5 block text-base text-red-800">Кликни — посмотри, какие подтверждены</span>
      </span>
    </a>
  )}

  {/* События где я отвечаю */}
  <h2 class="mb-3 mt-6 text-[18px] font-semibold text-navy-950">События, где я главный ответственный</h2>
  {myEvents.length === 0 ? (
    <div class="rounded-[12px] border border-dashed border-border bg-page p-6 text-center text-body-muted">
      На сегодня тебе не назначено событий. Если думаешь, что это неверно — пиши руководителю.
    </div>
  ) : (
    <ul class="space-y-2">
      {myEvents.map((e: any) => (
        <li class="rounded-[12px] border border-border bg-white p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div class="text-[16px] font-semibold text-navy-950">{e.title}</div>
            <div class="text-base text-body-muted">
              {e.start_time ? `${fmtTime(e.start_time)}${e.end_time ? '–' + fmtTime(e.end_time) : ''}` : ''}
            </div>
          </div>
          <div class="mt-2 flex flex-wrap gap-2">
            {e.need_photo && <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[12px] text-amber-800"><i class="bi bi-camera" aria-hidden="true"></i> нужно фото</span>}
            {e.need_checklist && <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[12px] text-amber-800"><i class="bi bi-check2-square" aria-hidden="true"></i> чек-лист не закрыт</span>}
            {!e.need_photo && !e.need_checklist && <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[12px] text-emerald-700"><i class="bi bi-check2-all" aria-hidden="true"></i> всё закрыто</span>}
          </div>
        </li>
      ))}
    </ul>
  )}

  <div class="mt-6 flex gap-2">
    <a href="/portal/smena" class="inline-flex items-center gap-2 rounded-[10px] border border-primary bg-primary px-4 py-2 text-base font-semibold text-white hover:opacity-90">
      <i class="bi bi-calendar2-week" aria-hidden="true"></i>
      Сетка смены
    </a>
    <a href="/portal/discipline" class="inline-flex items-center gap-2 rounded-[10px] border border-border bg-white px-4 py-2 text-base font-medium text-body-muted hover:border-primary">
      <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
      Дисциплина
    </a>
  </div>
</PortalLayout>
