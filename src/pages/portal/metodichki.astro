---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { activitiesByAuthor } from '../../lib/portalActivities';

const role = Astro.locals.portalRole!;
if (!['admin', 'teacher', 'vozhaty', 'rukovoditel'].includes(role)) {
  return Astro.redirect('/portal/');
}

const groups = activitiesByAuthor();
const BASE = '/metodichki';
---
<PortalLayout title="Методические материалы — АйДаКемп">
  <div class="mb-8">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Методические материалы
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">Преподавательские активности — по авторам. Единый формат: цель / что делаем / результат / материалы / требования.</p>
  </div>

  {/* Презентация игры — общая для смены */}
  <a
    href={`${BASE}/prezentaciya-igry.pptx`}
    class="mb-6 flex items-center gap-3 rounded-[16px] border border-primary bg-primary-soft p-5 transition hover:opacity-90"
  >
    <i class="bi bi-play-circle text-[28px] text-primary" aria-hidden="true"></i>
    <span>
      <span class="block text-[18px] font-semibold text-navy-950">Презентация игры (общая)</span>
      <span class="mt-0.5 block text-[15px] text-body-muted">Показать в начале — рассказать об игре и настроить ребят (.pptx)</span>
    </span>
  </a>

  {groups.map((g) => (
    <section class="mb-10">
      <h2 class="mb-4 flex items-center gap-2 text-[22px] font-bold tracking-[-0.01em] text-navy-950">
        <i class="bi bi-person-badge text-[22px] text-primary" aria-hidden="true"></i>
        {g.author}
        <span class="text-[15px] font-normal text-body-muted">· {g.items.length}</span>
      </h2>

      <div class="space-y-5">
        {g.items.map((a) => (
          <article class="overflow-hidden rounded-[16px] border border-border bg-white card-shadow">
            {/* шапка */}
            <header class="flex flex-col gap-4 border-b border-border bg-page p-5 sm:flex-row">
              {a.hasPreview && (
                <a href={`${BASE}/${a.slug}/preview.png`} target="_blank" rel="noopener" class="shrink-0">
                  <img
                    src={`${BASE}/${a.slug}/preview-thumb.webp`}
                    alt={`Превью «${a.title}»`}
                    width="220" height="140" loading="lazy"
                    class="h-[140px] w-full rounded-[12px] border border-border object-cover sm:w-[220px]"
                  />
                </a>
              )}
              <div class="min-w-0 flex-1">
                <h3 class="text-[20px] font-bold text-navy-950">{a.title}</h3>
                <p class="mt-1 text-[15px] text-body-muted">{a.desc}</p>
                {(a.duration || a.ages) && (
                  <div class="mt-2 flex flex-wrap gap-2">
                    {a.duration && (
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-soft px-2.5 py-0.5 text-[13px] font-medium text-primary">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        {a.duration}
                      </span>
                    )}
                    {a.ages && (
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-soft px-2.5 py-0.5 text-[13px] font-medium text-primary">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        {a.ages} лет
                      </span>
                    )}
                  </div>
                )}
              </div>
            </header>

            {/* содержимое — структура */}
            <div class="space-y-5 p-5">
              {a.goal && (
                <div>
                  <div class="mb-1 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-bullseye" aria-hidden="true"></i>
                    Цель
                  </div>
                  <p class="text-[15px] text-navy-950">{a.goal}</p>
                </div>
              )}

              {a.doing && a.doing.length > 0 && (
                <div>
                  <div class="mb-1 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-list-check" aria-hidden="true"></i>
                    Что делаем
                  </div>
                  <ol class="ml-5 list-decimal space-y-1 text-[15px] text-navy-950">
                    {a.doing.map((d) => <li>{d}</li>)}
                  </ol>
                </div>
              )}

              {a.result && (
                <div>
                  <div class="mb-1 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-trophy" aria-hidden="true"></i>
                    Какой результат
                  </div>
                  <p class="text-[15px] text-navy-950">{a.result}</p>
                </div>
              )}

              {a.materials && a.materials.length > 0 && (
                <div>
                  <div class="mb-1 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    Приборы и материалы
                  </div>
                  <ul class="ml-5 list-disc space-y-1 text-[15px] text-navy-950">
                    {a.materials.map((m) => <li>{m}</li>)}
                  </ul>
                </div>
              )}

              {a.requirements && a.requirements.length > 0 && (
                <div>
                  <div class="mb-1 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-check2-square" aria-hidden="true"></i>
                    Что требуется
                  </div>
                  <ul class="ml-5 list-disc space-y-1 text-[15px] text-navy-950">
                    {a.requirements.map((r) => <li>{r}</li>)}
                  </ul>
                </div>
              )}

              {a.stages && a.stages.length > 0 && (
                <div>
                  <div class="mb-2 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-signpost-split" aria-hidden="true"></i>
                    Этапы
                  </div>
                  <div class="space-y-2">
                    {a.stages.map((s) => (
                      <div class="rounded-[10px] border border-border bg-page p-3">
                        <div class="text-[15px] font-semibold text-navy-950">{s.title}</div>
                        <div class="mt-0.5 text-[14px] text-body-muted">{s.text}</div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Файлы */}
              {a.files && a.files.length > 0 && (
                <div>
                  <div class="mb-2 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                    Файлы
                  </div>
                  <div class="grid gap-2 sm:grid-cols-2">
                    {a.files.map((f) => (
                      <a href={f.href} target="_blank" rel="noopener"
                         class="flex items-start gap-3 rounded-[10px] border border-border bg-page p-3 transition hover:border-primary">
                        <i class={`bi bi-${f.icon ?? 'file-earmark'} text-[22px] text-primary`} aria-hidden="true"></i>
                        <span class="min-w-0">
                          <span class="block text-[15px] font-semibold text-navy-950">{f.name}</span>
                          {f.desc && <span class="mt-0.5 block text-[13px] text-body-muted">{f.desc}</span>}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Внешние ссылки / академии */}
              {a.links && a.links.length > 0 && (
                <div>
                  <div class="mb-2 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    Учебные модули и ссылки
                  </div>
                  <div class="grid gap-2 sm:grid-cols-2">
                    {a.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener"
                         class="flex items-start gap-3 rounded-[10px] border border-border bg-page p-3 transition hover:border-primary">
                        <i class={`bi bi-${l.icon ?? 'link-45deg'} text-[22px] text-primary`} aria-hidden="true"></i>
                        <span class="min-w-0">
                          <span class="block text-[15px] font-semibold text-navy-950">{l.name}</span>
                          {l.desc && <span class="mt-0.5 block text-[13px] text-body-muted">{l.desc}</span>}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Архив картинок старого формата */}
              {a.hasImagesZip && (
                <div class="flex flex-wrap gap-3">
                  <a
                    href={`${BASE}/${a.slug}/images.zip`}
                    class="inline-flex items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[15px] font-medium text-navy-950 transition hover:border-primary hover:text-primary"
                  >
                    <i class="bi bi-file-earmark-zip" aria-hidden="true"></i>
                    Скачать картинки (архив)
                  </a>
                  {a.hasPreview && (
                    <a
                      href={`${BASE}/${a.slug}/preview.png`}
                      target="_blank" rel="noopener"
                      class="inline-flex items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[15px] font-medium text-navy-950 transition hover:border-primary hover:text-primary"
                    >
                      <i class="bi bi-image" aria-hidden="true"></i>
                      Открыть превью
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</PortalLayout>
