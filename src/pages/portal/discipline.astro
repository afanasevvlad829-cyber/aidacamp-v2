---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { listPenalties, getReasons } from '../../lib/portalPenalty';
import { listStaff } from '../../lib/portalStaff';
import { getActiveShift } from '../../lib/portalShift';
import dayjs from 'dayjs';
import 'dayjs/locale/ru';
dayjs.locale('ru');

const role = Astro.locals.portalRole!;
const sub  = Astro.locals.portalSub;
if (!role) return Astro.redirect('/portal/login');

const isManager = role === 'admin' || role === 'rukovoditel';
// Отменять штрафы — только Владимир Афанасьев (telegram_id=244314247)
const canCancel = String(sub) === '244314247';

const url = new URL(Astro.request.url);
// Если sub нет в сессии (старый токен) — менеджер по умолчанию идёт во вкладку «Все»,
// обычный сотрудник видит «Мои» пустыми + подсказку «перелогинься, чтобы увидеть свои штрафы».
const requestedScope = url.searchParams.get('scope');
const scope = isManager
  ? (requestedScope === 'mine' ? 'mine' : 'all')
  : 'mine';
const filterStatus = url.searchParams.get('status') ?? 'open';

// Найти свой staff_id (если в сессии есть telegram_id)
async function staffIdByTg(tg: number): Promise<number | null> {
  const conn = process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN || '';
  if (!conn) return null;
  const { default: pg } = await import('pg');
  const c = new pg.Client({ connectionString: conn });
  await c.connect();
  try {
    const r = await c.query('SELECT id FROM portal_staff WHERE telegram_id=$1 LIMIT 1', [tg]);
    return (r.rows[0]?.id as number) ?? null;
  } finally { await c.end(); }
}
// mySid и activeShift независимы — запрашиваем параллельно
const [mySid, shift] = await Promise.all([
  sub != null ? staffIdByTg(sub) : Promise.resolve(null),
  getActiveShift(),
]);
const noSubWarning = sub == null;

const allowedStatuses = ['open','proposed','confirmed','paid','cancelled'] as const;
const statusForLib = (allowedStatuses as readonly string[]).includes(filterStatus) ? (filterStatus as (typeof allowedStatuses)[number]) : 'open';

// штрафы + справочники менеджера — всё параллельно
const [penalties, reasons, staff] = await Promise.all([
  listPenalties({
    staff_id: scope === 'mine' && mySid ? mySid : undefined,
    shift_id: shift?.id,
    status: statusForLib,
  }),
  isManager ? getReasons() : Promise.resolve([] as Awaited<ReturnType<typeof getReasons>>),
  isManager ? listStaff()  : Promise.resolve([] as Awaited<ReturnType<typeof listStaff>>),
]);

// Сводка по «моим» — сумма по статусам
const sum = { proposed: 0, confirmed: 0, paid: 0, cancelled: 0 };
for (const p of penalties) {
  if (p.status === 'proposed')  sum.proposed  += p.amount_rub;
  if (p.status === 'confirmed') sum.confirmed += p.amount_rub;
  if (p.status === 'paid')      sum.paid      += p.amount_rub;
  if (p.status === 'cancelled') sum.cancelled += p.amount_rub;
}

function fmtDateTime(s: string | null): string {
  if (!s) return '';
  try {
    const d = dayjs(s);
    if (!d.isValid()) return '';
    return d.format('D MMM HH:mm');
  } catch { return ''; }
}
const STATUS_LABEL: Record<string, string> = {
  proposed:  'Предложен',
  confirmed: 'Подтверждён',
  contested: 'Оспорен',
  cancelled: 'Отменён',
  paid:      'Списано',
};
const STATUS_COLOR: Record<string, string> = {
  proposed:  'bg-amber-50 text-amber-800 border-amber-200',
  confirmed: 'bg-red-50 text-red-800 border-red-200',
  contested: 'bg-blue-50 text-blue-800 border-blue-200',
  cancelled: 'bg-slate-50 text-slate-600 border-slate-200',
  paid:      'bg-slate-100 text-slate-700 border-slate-200',
};
---
<PortalLayout title="Дисциплина — Портал АйДаКемп">
  <div class="mb-6">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">Дисциплина</h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Штрафы — в реальных рублях, отдельно от детской игровой экономики.
      Автодетектор ставит «предложен» через 30 минут после конца события без закрытого чек-листа/фото.
      Руководитель подтверждает или отменяет.
    </p>
  </div>

  {noSubWarning && (
    <div class="mb-4 rounded-[12px] border border-amber-200 bg-amber-50 p-3 text-[14px] text-amber-900">
      <i class="bi bi-info-circle" aria-hidden="true"></i>
      Твоя сессия старая (без telegram_id). Чтобы видеть «Мои штрафы» — выйди и зайди заново.
    </div>
  )}

  {/* Табы scope */}
  {isManager && (
    <div class="mb-4 flex flex-wrap gap-2">
      <a href={`?scope=mine&status=${filterStatus}`} class:list={[
        'rounded-[10px] border px-3 py-1.5 text-[14px] font-medium transition',
        scope === 'mine' ? 'border-primary bg-primary text-white' : 'border-border bg-white hover:border-primary',
      ]}>Мои</a>
      <a href={`?scope=all&status=${filterStatus}`} class:list={[
        'rounded-[10px] border px-3 py-1.5 text-[14px] font-medium transition',
        scope === 'all' ? 'border-primary bg-primary text-white' : 'border-border bg-white hover:border-primary',
      ]}>Все</a>
    </div>
  )}

  {/* Сводка */}
  {scope === 'mine' && (
    <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
      <div class="rounded-[12px] border border-amber-200 bg-amber-50 p-4">
        <div class="text-[12px] uppercase tracking-wider text-amber-700">Предложено</div>
        <div class="mt-1 text-[22px] font-bold text-amber-900">{sum.proposed} ₽</div>
      </div>
      <div class="rounded-[12px] border border-red-200 bg-red-50 p-4">
        <div class="text-[12px] uppercase tracking-wider text-red-700">Подтверждено</div>
        <div class="mt-1 text-[22px] font-bold text-red-900">{sum.confirmed} ₽</div>
      </div>
      <div class="rounded-[12px] border border-border bg-white p-4">
        <div class="text-[12px] uppercase tracking-wider text-body-muted">Списано</div>
        <div class="mt-1 text-[22px] font-bold text-navy-950">{sum.paid} ₽</div>
      </div>
      <div class="rounded-[12px] border border-border bg-white p-4">
        <div class="text-[12px] uppercase tracking-wider text-body-muted">Отменено</div>
        <div class="mt-1 text-[22px] font-bold text-slate-500">{sum.cancelled} ₽</div>
      </div>
    </div>
  )}

  {/* Фильтр статуса */}
  <div class="mb-4 flex flex-wrap gap-2 text-[13px]">
    {[
      { v: 'open',      label: 'Открытые' },
      { v: 'proposed',  label: 'Предложенные' },
      { v: 'confirmed', label: 'Подтверждённые' },
      { v: 'paid',      label: 'Списанные' },
      { v: 'cancelled', label: 'Отменённые' },
    ].map((it) => (
      <a href={`?scope=${scope}&status=${it.v}`} class:list={[
        'rounded-full border px-3 py-1 transition',
        filterStatus === it.v ? 'border-primary bg-primary-soft text-primary' : 'border-border bg-white text-body-muted hover:border-primary',
      ]}>{it.label}</a>
    ))}
  </div>

  {/* Кнопка «Новый штраф» для менеджеров */}
  {isManager && (
    <button type="button" id="btn-new-penalty"
            class="mb-4 inline-flex items-center gap-2 rounded-[10px] border border-primary bg-primary px-4 py-2 text-[14px] font-semibold text-white hover:bg-primary-700">
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      Выписать штраф
    </button>
  )}

  {/* Список */}
  {penalties.length === 0 ? (
    <div class="rounded-[12px] border border-dashed border-border bg-page p-8 text-center text-body-muted">
      Пусто. {scope === 'mine' ? 'У тебя нет открытых штрафов — молодец.' : 'Нет штрафов по выбранному фильтру.'}
    </div>
  ) : (
    <div class="space-y-2">
      {penalties.map((p) => (
        <article class="rounded-[12px] border border-border bg-white p-4 card-shadow">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={[
                  'inline-flex items-center rounded-full border px-2 py-0.5 text-[12px] font-medium',
                  STATUS_COLOR[p.status] ?? 'border-border bg-white text-body-muted',
                ]}>{STATUS_LABEL[p.status] ?? p.status}</span>
                {p.source === 'auto' && (
                  <span class="inline-flex items-center gap-1 rounded-full border border-blue-200 bg-blue-50 px-2 py-0.5 text-[12px] text-blue-700">
                    <i class="bi bi-robot" aria-hidden="true"></i>авто
                  </span>
                )}
                <h3 class="text-[16px] font-semibold text-navy-950">{p.reason_title}</h3>
              </div>
              {p.reason_text && <p class="mt-1 text-[14px] text-body-muted">{p.reason_text}</p>}
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-[13px] text-body-muted">
                {scope === 'all' && p.staff_name && <span><i class="bi bi-person mr-1" aria-hidden="true"></i>{p.staff_name}</span>}
                {p.event_title && <span><i class="bi bi-calendar-event mr-1" aria-hidden="true"></i>{p.event_title} · {p.event_date ?? ''}</span>}
                <span><i class="bi bi-clock mr-1" aria-hidden="true"></i>{fmtDateTime(p.created_at)}</span>
              </div>
            </div>
            <div class="text-right">
              <div class="text-[20px] font-bold text-navy-950">{p.amount_rub} ₽</div>
              {isManager && p.status === 'proposed' && (
                <div class="mt-2 flex gap-1.5">
                  <button type="button" data-action="confirm" data-id={p.id}
                          class="rounded-[8px] border border-red-200 bg-red-50 px-3 py-1 text-[12px] font-medium text-red-800 hover:bg-red-100">
                    Подтвердить
                  </button>
                  {canCancel && (
                    <button type="button" data-action="cancel" data-id={p.id}
                            class="rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-slate-400">
                      Отменить
                    </button>
                  )}
                </div>
              )}
              {isManager && p.status === 'confirmed' && (
                <button type="button" data-action="paid" data-id={p.id}
                        class="mt-2 rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-slate-400">
                  Отметить как списано
                </button>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}

  {/* Модалка «Новый штраф» */}
  {isManager && (
    <dialog id="modal-new" class="aida-modal-center rounded-[16px] bg-white p-0 shadow-xl backdrop:bg-black/40">
      <div class="aida-modal-form">
      <h2 class="mb-4 text-[20px] font-bold text-navy-950">Выписать штраф</h2>
      <div class="space-y-3 text-[14px]">
        <label class="block">
          <span class="mb-1 block text-body-muted">Сотрудник</span>
          <select id="np-staff" class="w-full rounded-[8px] border border-border px-3 py-2">
            <option value="">— выбрать —</option>
            {staff.filter((s) => s.active).map((s) => (
              <option value={s.id}>{s.full_name ?? `id=${s.id}`} · {s.role ?? ''}</option>
            ))}
          </select>
        </label>
        <label class="block">
          <span class="mb-1 block text-body-muted">Причина</span>
          <select id="np-reason" class="w-full rounded-[8px] border border-border px-3 py-2">
            <option value="">— выбрать —</option>
            {reasons.map((r) => (
              <option value={r.code} data-default={r.default_rub}>
                {r.title} · {r.default_rub} ₽
              </option>
            ))}
          </select>
        </label>
        <label class="block">
          <span class="mb-1 block text-body-muted">Комментарий</span>
          <textarea id="np-text" rows="2" data-voice class="w-full rounded-[8px] border border-border px-3 py-2"
                    placeholder="За что и почему именно сейчас"></textarea>
        </label>
        <label class="block">
          <span class="mb-1 block text-body-muted">Сумма ₽</span>
          <input id="np-amount" type="number" min="0" step="100"
                 class="w-full rounded-[8px] border border-border px-3 py-2" />
        </label>
      </div>
      <div class="mt-5 flex justify-end gap-2">
        <button type="button" id="np-cancel" class="rounded-[8px] border border-border bg-white px-4 py-2 text-[14px]">
          Отмена
        </button>
        <button type="button" id="np-save" class="rounded-[8px] border border-primary bg-primary px-4 py-2 text-[14px] font-semibold text-white">
          Выписать
        </button>
      </div>
      </div>
    </dialog>
  )}

  <script>
    async function postJson(body: unknown) {
      const r = await fetch('/api/portal/penalty', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || 'error');
      return j;
    }

    document.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.dataset.action!;
        const id = Number(btn.dataset.id);
        btn.disabled = true;
        try {
          if (action === 'cancel') {
            const note = prompt('Причина отмены штрафа:');
            if (!note) { btn.disabled = false; return; }
            await postJson({ action: 'cancel', id, note });
          } else {
            await postJson({ action, id });
          }
          location.reload();
        } catch (e) {
          alert('Ошибка: ' + (e as Error).message);
          btn.disabled = false;
        }
      });
    });

    const modal = document.getElementById('modal-new') as HTMLDialogElement | null;
    const openBtn = document.getElementById('btn-new-penalty');
    const cancelBtn = document.getElementById('np-cancel');
    const saveBtn = document.getElementById('np-save');
    const reasonSel = document.getElementById('np-reason') as HTMLSelectElement | null;
    const amountInp = document.getElementById('np-amount') as HTMLInputElement | null;

    if (openBtn && modal) openBtn.addEventListener('click', () => modal.showModal());
    if (cancelBtn && modal) cancelBtn.addEventListener('click', () => modal.close());
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });
    }

    if (reasonSel && amountInp) {
      reasonSel.addEventListener('change', () => {
        const opt = reasonSel.selectedOptions[0];
        const d = opt?.dataset.default;
        if (d && !amountInp.value) amountInp.value = d;
      });
    }

    if (saveBtn && modal) {
      saveBtn.addEventListener('click', async () => {
        const staff = (document.getElementById('np-staff') as HTMLSelectElement).value;
        const reason = (document.getElementById('np-reason') as HTMLSelectElement).value;
        const text = (document.getElementById('np-text') as HTMLTextAreaElement).value.trim();
        const amount = (document.getElementById('np-amount') as HTMLInputElement).value;
        if (!staff || !reason) { alert('Выбери сотрудника и причину'); return; }
        saveBtn.disabled = true;
        try {
          await postJson({
            action: 'create',
            staff_id: Number(staff),
            reason_code: reason,
            reason_text: text || null,
            amount_rub: amount ? Number(amount) : undefined,
          });
          location.reload();
        } catch (e) {
          alert('Ошибка: ' + (e as Error).message);
          saveBtn.disabled = false;
        }
      });
    }
  </script>
</PortalLayout>
