---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { verifySessionPayload } from '../../lib/portalSession';
import {
  getActiveShift, getEvents, getEventDates, getDone, listShifts,
  listContentTaskTemplates, getChecklists, type ShiftEvent, type ContentTaskTemplate,
} from '../../lib/portalShift';
import { listStaff } from '../../lib/portalStaff';
import { listPhotosByDay } from '../../lib/portalPhoto';
import DenCard from '../../components/portal/den/DenCard.astro';
import DaySummary from '../../components/portal/den/DaySummary.astro';
import ChecklistModal from '../../components/portal/den/ChecklistModal.astro';

// Доступ гейтит middleware: /portal/* доступен только сотрудникам (не ученикам).
const role = Astro.locals.portalRole!;
const sub = verifySessionPayload(
  Astro.cookies.get('portal_session')?.value,
  process.env.PORTAL_SESSION_SECRET ?? '',
)?.sub;

const allShifts = (await listShifts()) ?? [];
const reqShiftId = Number(Astro.url.searchParams.get('shift') || 0);
const shift = reqShiftId
  ? (allShifts.find((s) => s.id === reqShiftId) ?? (await getActiveShift()))
  : await getActiveShift();

let events: ShiftEvent[] = [];
let dates: string[] = [];
let doneSet: string[] = [];
let staff: { id: number; name: string }[] = [];
let library: ContentTaskTemplate[] = [];
let checklistLib: { id: number; title: string; items: { id: string; text: string }[] }[] = [];

if (shift) {
  events = await getEvents(shift.id);
  dates = await getEventDates(shift.id);
  doneSet = sub ? [...(await getDone(sub, shift.id))] : [];
  const st = (await listStaff()) ?? [];
  staff = st.filter((s) => s.active && s.full_name).map((s) => ({ id: s.id, name: s.full_name! }));
  library = await listContentTaskTemplates();
  checklistLib = (await getChecklists()) ?? [];
}

const selectedDate = Astro.url.searchParams.get('date') || dates[0] || '';

// Итоговый блок «Материалы дня» — служебное событие-контейнер для общих фото/видео дня.
const DAY_SUMMARY_TITLE = '📦 Материалы дня';
let dayPhotos: Awaited<ReturnType<typeof listPhotosByDay>> = [];
let summaryEvent: ShiftEvent | undefined;
if (shift && selectedDate) {
  summaryEvent = events.find((e) => e.date === selectedDate && e.title === DAY_SUMMARY_TITLE);
  dayPhotos = await listPhotosByDay(shift.id, selectedDate);
}
const dayEvents = events
  .filter((e) => e.date === selectedDate && e.title !== DAY_SUMMARY_TITLE)
  .sort((a, b) => (a.start_time || '').localeCompare(b.start_time || '') || a.sort - b.sort);

// Группировка по времени — параллельные блоки (одинаковое start_time) рядом.
const groups: { time: string; items: ShiftEvent[] }[] = [];
for (const e of dayEvents) {
  const t = (e.start_time || '').slice(0, 5);
  const g = groups.find((x) => x.time === t);
  if (g) g.items.push(e);
  else groups.push({ time: t, items: [e] });
}

---

<PortalLayout title="Конструктор дня · АйДаКемп">
  <div class="den" data-shift={shift?.id ?? ''} data-date={selectedDate} data-summary-title={DAY_SUMMARY_TITLE}>
    <header class="den-head">
      <div>
        <h1 class="den-title">Конструктор дня</h1>
        <p class="den-sub">{shift ? shift.name : 'Нет активной смены'}</p>
      </div>
      {allShifts.length > 1 && (
        <form method="get" class="den-controls">
          <select name="shift" class="den-input" onchange="this.form.submit()">
            {allShifts.map((s) => (
              <option value={s.id} selected={s.id === shift?.id}>{s.name}</option>
            ))}
          </select>
        </form>
      )}
    </header>

    {shift && dates.length > 0 && (
      <nav class="den-days">
        {dates.map((d, i) => (
          <a href={`/portal/den?shift=${shift.id}&date=${d}`}
             class={`den-day${d === selectedDate ? ' active' : ''}`}>
            <span class="den-day-n">День {i + 1}</span>
            <span class="den-day-d">{d.slice(8, 10)}.{d.slice(5, 7)}</span>
          </a>
        ))}
      </nav>
    )}

    {!shift && <div class="den-empty">Создайте смену в конструкторе, чтобы собрать день.</div>}

    {shift && (
      <div class="den-timeline">
        {groups.length === 0 && <div class="den-empty">На этот день пока нет блоков. Добавьте первый ниже.</div>}

        {groups.map((g) => (
          <div class="den-row">
            <div class="den-time">{g.time || '—'}</div>
            <div class="den-cards">
              {g.items.map((e) => (
                <DenCard event={e} staff={staff} library={library} checklistLib={checklistLib} doneSet={doneSet} />
              ))}
            </div>
          </div>
        ))}

        <div class="den-add">
          <h3>Добавить блок</h3>
          <div class="den-add-row">
            <input type="time" id="add-time" class="den-input">
            <input type="text" id="add-title" class="den-input" placeholder="Название блока">
            <button type="button" id="add-btn" class="den-save">+ Добавить</button>
          </div>
          <button type="button" id="copy-day" class="den-copy">📋 Скопировать этот день на другую дату</button>
        </div>

        <DaySummary summaryEventId={summaryEvent?.id ?? ''} photos={dayPhotos} />
      </div>
    )}
  </div>

  <ChecklistModal />

  <style is:global>
    /* Конструктор дня — фирменный стиль АйДаКемп (DESIGN_SYSTEM.md):
       soft-orange #ec9b44, navy #0d1a2b, радиусы 14px, мягкие тени. */
    .den{--orange:#ec9b44;--orange-600:#d68830;--orange-50:#fdf6ec;--orange-100:#faead0;--orange-200:#f5d4a4;
         --navy:#0d1a2b;--navy-700:#285085;--ink:#1e2430;--muted:#6b7280;--border:#e5e7eb;--surface:#f8f9fb;--green:#2fa768;
         max-width:880px;margin:0 auto;padding:20px 16px}
    .den-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:20px}
    .den-title{font-size:26px;font-weight:800;letter-spacing:-0.02em;color:var(--navy);margin:0}
    .den-sub{color:var(--muted);font-size:14px;margin:3px 0 0}
    .den-controls{display:flex;gap:8px}
    .den-input{border:1.5px solid var(--border);border-radius:12px;padding:8px 11px;font-size:14px;background:#fff;color:var(--ink)}
    .den-input:focus{outline:none;border-color:var(--orange)}
    .den-empty{color:var(--muted);background:var(--surface);border:1px dashed #cbd5e1;border-radius:14px;padding:22px;text-align:center}
    .den-days{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}
    .den-day{display:flex;flex-direction:column;align-items:center;min-width:62px;padding:9px 12px;border:1.5px solid var(--border);border-radius:14px;background:#fff;text-decoration:none;color:var(--ink);transition:all .15s}
    .den-day:hover{border-color:var(--orange);box-shadow:0 2px 8px rgba(15,23,42,.04)}
    .den-day.active{background:var(--orange);border-color:var(--orange);color:var(--navy);box-shadow:0 4px 16px rgba(236,155,68,.35)}
    .den-day-n{font-size:13px;font-weight:700}
    .den-day-d{font-size:11px;opacity:.85;margin-top:1px}
    .den-timeline{position:relative}
    .den-row{display:flex;gap:14px;margin-bottom:12px}
    .den-time{flex:none;width:54px;font-weight:700;color:var(--navy-700);padding-top:14px;font-size:14px;font-variant-numeric:tabular-nums}
    .den-cards{flex:1;display:flex;flex-direction:column;gap:10px;min-width:0}
    .den-card{background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 4px 16px rgba(15,23,42,.06);overflow:hidden;transition:box-shadow .15s,border-color .15s}
    .den-card:hover{border-color:var(--orange-200)}
    .den-card-main{padding:14px 16px;cursor:pointer;display:flex;flex-direction:column;gap:7px}
    .den-card-title{font-weight:700;font-size:15px;color:var(--navy)}
    .den-card-meta{display:flex;flex-wrap:wrap;gap:6px}
    .den-badge{font-size:12px;padding:3px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;font-weight:500}
    .den-badge.tk{background:var(--orange-50);color:#b66d10}
    .den-badge.resp{background:#eef4fb;color:var(--navy-700)}
    .den-badge.chk{background:#eafaf1;color:#1f8a52}
    .den-card-body{padding:4px 16px 16px;border-top:1px solid #f1f5f9;background:var(--surface)}
    .den-field{display:block;margin-top:10px;font-size:12.5px;color:var(--muted)}
    .den-field>span{display:block;font-weight:600;margin-bottom:3px}
    .den-field input,.den-field select,.den-field textarea{width:100%;border:1.5px solid var(--border);border-radius:12px;padding:8px 11px;font-size:14px;font-family:inherit;background:#fff;color:var(--ink)}
    .den-field input:focus,.den-field select:focus,.den-field textarea:focus{outline:none;border-color:var(--orange)}
    .den-row-fields{display:flex;gap:10px;align-items:flex-end}
    .den-field-time{flex:0 0 100px}
    .den-field-grow{flex:1 1 auto;min-width:0}
    .den-field textarea{min-height:40px;resize:vertical}
    .den-suggest{margin-top:6px;background:var(--orange-50);border:1px solid var(--orange-200);border-radius:10px;padding:6px 11px;font-size:12px;color:#b66d10;cursor:pointer;font-weight:500}
    .den-suggest:hover{background:var(--orange-100)}
    .den-checklists{margin-top:14px;display:flex;flex-direction:column;gap:10px}
    .den-cl{background:#fff;border:1px solid var(--border);border-radius:12px;padding:10px 12px}
    .den-cl-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
    .den-cl-title{font-weight:700;font-size:13px;color:var(--navy)}
    .den-cl-tools{display:flex;gap:4px;flex:none}
    .den-cl-btn{background:var(--surface);border:1px solid var(--border);border-radius:8px;width:28px;height:28px;font-size:13px;cursor:pointer;color:var(--muted);line-height:1}
    .den-cl-btn:hover{border-color:var(--orange);color:#b66d10}
    .den-cl-btn.del{background:#fdeeee;border-color:#f6cccc;color:#c4515c}
    .den-cl-item{display:flex;align-items:center;gap:9px;padding:4px 0;font-size:14px;cursor:pointer;color:var(--ink)}
    .den-cl-item input{width:17px;height:17px;accent-color:var(--orange)}
    .den-cl-manage{margin-top:14px;padding-top:12px;border-top:1px dashed var(--border)}
    .den-field-label{display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
    .den-cl-add{display:flex;gap:6px;margin-bottom:6px}
    .den-cl-add select{flex:1;border:1.5px solid var(--border);border-radius:12px;padding:7px 9px;font-size:13px}
    .den-mini{background:#eef4fb;color:var(--navy-700);border:none;border-radius:10px;padding:7px 13px;font-size:13px;cursor:pointer;white-space:nowrap;font-weight:500}
    .den-mini.ghost{background:#fff;color:var(--ink);border:1px solid var(--border)}
    .den-mini:hover{filter:brightness(.97)}
    .den-actions{display:flex;align-items:center;gap:8px;margin-top:16px;flex-wrap:wrap}
    .den-save{background:var(--orange);color:var(--navy);border:none;border-radius:12px;padding:9px 18px;font-size:14px;font-weight:700;cursor:pointer;transition:all .15s}
    .den-save:hover{background:var(--orange-600);box-shadow:0 4px 16px rgba(236,155,68,.35)}
    .den-dup{background:#fff;color:var(--navy-700);border:1.5px solid #cdddf0;border-radius:12px;padding:9px 14px;font-size:13px;cursor:pointer;font-weight:500}
    .den-del{background:#fff;color:#c4515c;border:1.5px solid #f6cccc;border-radius:12px;padding:9px 14px;font-size:13px;cursor:pointer}
    .den-status{font-size:12px;color:var(--green)}
    .den-add{margin-top:22px;background:var(--orange-50);border:1px solid var(--orange-200);border-radius:16px;padding:16px}
    .den-add h3{margin:0 0 12px;font-size:15px;font-weight:700;color:var(--navy)}
    .den-add-row{display:flex;gap:8px;flex-wrap:wrap}
    .den-add-row #add-title{flex:1;min-width:160px}
    .den-copy{margin-top:12px;background:none;border:none;color:var(--navy-700);font-size:13px;cursor:pointer;padding:0;font-weight:500}
    .den-copy:hover{color:var(--orange-600)}
    .den-summary{margin-top:24px;background:var(--orange-50);border:1px solid var(--orange-200);border-radius:16px;padding:18px}
    .den-summary h3{margin:0 0 4px;font-size:16px;font-weight:700;color:var(--navy)}
    .den-summary-hint{font-size:13px;color:#9a6b3f;margin:0 0 12px}
    .den-summary-empty{font-size:13px;color:#b08968;margin:0 0 12px}
    .den-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px;margin-bottom:12px}
    .den-thumb{display:block;aspect-ratio:1;border-radius:12px;overflow:hidden;background:var(--orange-100);border:1px solid var(--orange-200)}
    .den-thumb img{width:100%;height:100%;object-fit:cover}
    .den-thumb-vid{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:28px;color:#b66d10}
    .den-summary-actions{display:flex;align-items:center;gap:10px}
    .cl-modal{position:fixed;inset:0;background:rgba(13,26,43,.5);display:flex;align-items:center;justify-content:center;z-index:100;padding:16px}
    .cl-modal-box{background:#fff;border-radius:20px;padding:22px;width:100%;max-width:460px;max-height:85vh;overflow-y:auto;box-shadow:0 8px 24px rgba(15,23,42,.12)}
    .cl-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .cl-modal-head h3{margin:0;font-size:18px;font-weight:700;color:#0d1a2b}
    .cl-modal-x{background:none;border:none;font-size:18px;cursor:pointer;color:#6b7280}
    .cl-items-label{font-size:12.5px;font-weight:600;color:#6b7280;margin:14px 0 6px}
    .cl-item-row{display:flex;gap:6px;margin-bottom:6px}
    .cl-item-row input{flex:1;border:1.5px solid #e5e7eb;border-radius:12px;padding:8px 11px;font-size:14px}
    .cl-item-del{background:#fdeeee;color:#c4515c;border:none;border-radius:8px;padding:0 12px;font-size:15px;cursor:pointer}
    .cl-modal-foot{display:flex;align-items:center;gap:10px;margin-top:18px}
  </style>

  <script src="../../scripts/portal/den.ts"></script>
</PortalLayout>
