---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { verifySessionPayload } from '../../lib/portalSession';
import {
  getActiveShift, getEvents, getEventDates, getDone, listShifts,
  listContentTaskTemplates, getChecklists, type ShiftEvent, type ContentTaskTemplate,
} from '../../lib/portalShift';
import { listStaff } from '../../lib/portalStaff';
import { listPhotosByDay } from '../../lib/portalPhoto';
import DenCard from '../../components/portal/den/DenCard.astro';
import DaySummary from '../../components/portal/den/DaySummary.astro';
import ChecklistModal from '../../components/portal/den/ChecklistModal.astro';

// Доступ гейтит middleware: /portal/* доступен только сотрудникам (не ученикам).
const role = Astro.locals.portalRole!;
const sub = verifySessionPayload(
  Astro.cookies.get('portal_session')?.value,
  process.env.PORTAL_SESSION_SECRET ?? '',
)?.sub;

const allShifts = (await listShifts()) ?? [];
const reqShiftId = Number(Astro.url.searchParams.get('shift') || 0);
const shift = reqShiftId
  ? (allShifts.find((s) => s.id === reqShiftId) ?? (await getActiveShift()))
  : await getActiveShift();

let events: ShiftEvent[] = [];
let dates: string[] = [];
let doneSet: string[] = [];
let staff: { id: number; name: string }[] = [];
let library: ContentTaskTemplate[] = [];
let checklistLib: { id: number; title: string; items: { id: string; text: string }[] }[] = [];

if (shift) {
  events = await getEvents(shift.id);
  dates = await getEventDates(shift.id);
  doneSet = sub ? [...(await getDone(sub, shift.id))] : [];
  const st = (await listStaff()) ?? [];
  staff = st.filter((s) => s.active && s.full_name).map((s) => ({ id: s.id, name: s.full_name! }));
  library = await listContentTaskTemplates();
  checklistLib = (await getChecklists()) ?? [];
}

const selectedDate = Astro.url.searchParams.get('date') || dates[0] || '';

// Итоговый блок «Материалы дня» — служебное событие-контейнер для общих фото/видео дня.
const DAY_SUMMARY_TITLE = '📦 Материалы дня';
let dayPhotos: Awaited<ReturnType<typeof listPhotosByDay>> = [];
let summaryEvent: ShiftEvent | undefined;
if (shift && selectedDate) {
  summaryEvent = events.find((e) => e.date === selectedDate && e.title === DAY_SUMMARY_TITLE);
  dayPhotos = await listPhotosByDay(shift.id, selectedDate);
}
const dayEvents = events
  .filter((e) => e.date === selectedDate && e.title !== DAY_SUMMARY_TITLE)
  .sort((a, b) => (a.start_time || '').localeCompare(b.start_time || '') || a.sort - b.sort);

// Группировка по времени — параллельные блоки (одинаковое start_time) рядом.
const groups: { time: string; items: ShiftEvent[] }[] = [];
for (const e of dayEvents) {
  const t = (e.start_time || '').slice(0, 5);
  const g = groups.find((x) => x.time === t);
  if (g) g.items.push(e);
  else groups.push({ time: t, items: [e] });
}

---

<PortalLayout title="Конструктор дня · АйДаКемп">
  <div class="den" data-shift={shift?.id ?? ''} data-date={selectedDate} data-summary-title={DAY_SUMMARY_TITLE}>
    <header class="den-head">
      <div>
        <h1 class="den-title">Конструктор дня</h1>
        <p class="den-sub">{shift ? shift.name : 'Нет активной смены'}</p>
      </div>
      {allShifts.length > 1 && (
        <form method="get" class="den-controls">
          <select name="shift" class="den-input" onchange="this.form.submit()">
            {allShifts.map((s) => (
              <option value={s.id} selected={s.id === shift?.id}>{s.name}</option>
            ))}
          </select>
        </form>
      )}
    </header>

    {shift && dates.length > 0 && (
      <nav class="den-days">
        {dates.map((d, i) => (
          <a href={`/portal/den?shift=${shift.id}&date=${d}`}
             class={`den-day${d === selectedDate ? ' active' : ''}`}>
            <span class="den-day-n">День {i + 1}</span>
            <span class="den-day-d">{d.slice(8, 10)}.{d.slice(5, 7)}</span>
          </a>
        ))}
      </nav>
    )}

    {!shift && <div class="den-empty">Создайте смену в конструкторе, чтобы собрать день.</div>}

    {shift && (
      <div class="den-timeline">
        {groups.length === 0 && <div class="den-empty">На этот день пока нет блоков. Добавьте первый ниже.</div>}

        {groups.map((g) => (
          <div class="den-row">
            <div class="den-time">{g.time || '—'}</div>
            <div class="den-cards">
              {g.items.map((e) => (
                <DenCard event={e} staff={staff} library={library} checklistLib={checklistLib} doneSet={doneSet} />
              ))}
            </div>
          </div>
        ))}

        <div class="den-add">
          <h3>Добавить блок</h3>
          <div class="den-add-row">
            <input type="time" id="add-time" class="den-input">
            <input type="text" id="add-title" class="den-input" placeholder="Название блока">
            <button type="button" id="add-btn" class="den-save">+ Добавить</button>
          </div>
          <button type="button" id="copy-day" class="den-copy">📋 Скопировать этот день на другую дату</button>
        </div>

        <DaySummary summaryEventId={summaryEvent?.id ?? ''} photos={dayPhotos} />
      </div>
    )}
  </div>

  <ChecklistModal />

  <style>
    .den{max-width:860px;margin:0 auto;padding:16px}
    .den-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:18px}
    .den-title{font-size:22px;font-weight:800;margin:0}
    .den-sub{color:#64748b;font-size:14px;margin:2px 0 0}
    .den-controls{display:flex;gap:8px}
    .den-input{border:1.5px solid #e2e8f0;border-radius:8px;padding:7px 10px;font-size:14px;background:#fff}
    .den-empty{color:#64748b;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:12px;padding:20px;text-align:center}
    .den-row{display:flex;gap:12px;margin-bottom:10px}
    .den-time{flex:none;width:54px;font-weight:700;color:#2563eb;padding-top:14px;font-size:14px}
    .den-cards{flex:1;display:flex;flex-direction:column;gap:8px}
    .den-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden}
    .den-card-main{padding:12px 14px;cursor:pointer}
    .den-card-title{font-weight:600;font-size:15px}
    .den-card-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
    .den-badge{font-size:12px;padding:2px 8px;border-radius:999px;display:inline-flex;align-items:center;gap:4px}
    .den-badge.tk{background:#fff1ec;color:#c2410c}
    .den-badge.resp{background:#eef2ff;color:#4338ca}
    .den-badge.chk{background:#ecfdf3;color:#15803d}
    .den-card-body{padding:0 14px 12px;border-top:1px solid #f1f5f9}
    .den-field{display:block;margin-top:8px;font-size:12.5px;color:#475569}
    .den-field>span{display:block;font-weight:600;margin-bottom:2px}
    .den-field input,.den-field select,.den-field textarea{width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:6px 9px;font-size:14px;font-family:inherit}
    .den-row-fields{display:flex;gap:8px;align-items:flex-end}
    .den-field-time{flex:0 0 96px}
    .den-field-grow{flex:1 1 auto;min-width:0}
    .den-field textarea{min-height:38px}
    .den-suggest{margin-top:6px;background:#f1f5f9;border:none;border-radius:7px;padding:5px 10px;font-size:12px;color:#334155;cursor:pointer}
    .den-checklists{margin-top:12px}
    .den-cl{margin-top:8px}
    .den-cl-title{font-weight:600;font-size:13px;color:#334155;margin-bottom:4px}
    .den-cl-item{display:flex;align-items:center;gap:8px;padding:3px 0;font-size:14px;cursor:pointer}
    .den-actions{display:flex;align-items:center;gap:10px;margin-top:14px}
    .den-save{background:#f97316;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:14px;font-weight:600;cursor:pointer}
    .den-del{background:#fff;color:#dc2626;border:1.5px solid #fecaca;border-radius:8px;padding:8px 14px;font-size:13px;cursor:pointer}
    .den-status{font-size:12px;color:#16a34a}
    .den-add{margin-top:20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px}
    .den-add h3{margin:0 0 10px;font-size:15px}
    .den-add-row{display:flex;gap:8px;flex-wrap:wrap}
    .den-add-row #add-title{flex:1;min-width:160px}
    .den-copy{margin-top:12px;background:none;border:none;color:#2563eb;font-size:13px;cursor:pointer;padding:0}
    .den-days{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
    .den-day{display:flex;flex-direction:column;align-items:center;min-width:60px;padding:8px 10px;border:1.5px solid #e2e8f0;border-radius:10px;background:#fff;text-decoration:none;color:#334155;transition:all .12s}
    .den-day:hover{border-color:#f97316}
    .den-day.active{background:#f97316;border-color:#f97316;color:#fff}
    .den-day-n{font-size:13px;font-weight:700}
    .den-day-d{font-size:11px;opacity:.8;margin-top:1px}
    .den-cl-manage{margin-top:14px;padding-top:10px;border-top:1px dashed #e2e8f0}
    .den-field-label{display:block;font-size:13px;font-weight:600;color:#475569;margin-bottom:6px}
    .den-cl-add{display:flex;gap:6px;margin-bottom:6px}
    .den-cl-add select{flex:1;border:1.5px solid #e2e8f0;border-radius:8px;padding:6px 8px;font-size:13px}
    .den-mini{background:#eef2ff;color:#4338ca;border:none;border-radius:7px;padding:6px 12px;font-size:13px;cursor:pointer;white-space:nowrap}
    .den-mini.ghost{background:#f8fafc;color:#475569;border:1px solid #e2e8f0}
    .den-dup{background:#fff;color:#2563eb;border:1.5px solid #bfdbfe;border-radius:8px;padding:8px 14px;font-size:13px;cursor:pointer}
    .den-summary{margin-top:22px;background:#fff7ed;border:1px solid #ffe1c2;border-radius:14px;padding:16px}
    .den-summary h3{margin:0 0 4px;font-size:16px}
    .den-summary-hint{font-size:13px;color:#9a6b3f;margin:0 0 12px}
    .den-summary-empty{font-size:13px;color:#b08968;margin:0 0 12px}
    .den-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:8px;margin-bottom:12px}
    .den-thumb{display:block;aspect-ratio:1;border-radius:10px;overflow:hidden;background:#fde9d8;border:1px solid #ffe1c2}
    .den-thumb img{width:100%;height:100%;object-fit:cover}
    .den-thumb-vid{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:28px;color:#c2410c}
    .den-summary-actions{display:flex;align-items:center;gap:10px}
    .den-cl-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}
    .den-cl-tools{display:flex;gap:4px;flex:none}
    .den-cl-btn{background:#f1f5f9;border:none;border-radius:6px;width:26px;height:26px;font-size:13px;cursor:pointer;color:#475569;line-height:1}
    .den-cl-btn.del{background:#fef2f2;color:#dc2626}
    .cl-modal{position:fixed;inset:0;background:rgba(15,23,42,.5);display:flex;align-items:center;justify-content:center;z-index:100;padding:16px}
    .cl-modal-box{background:#fff;border-radius:16px;padding:20px;width:100%;max-width:440px;max-height:85vh;overflow-y:auto}
    .cl-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
    .cl-modal-head h3{margin:0;font-size:18px}
    .cl-modal-x{background:none;border:none;font-size:18px;cursor:pointer;color:#64748b}
    .cl-items-label{font-size:13px;font-weight:600;color:#475569;margin:12px 0 6px}
    .cl-item-row{display:flex;gap:6px;margin-bottom:6px}
    .cl-item-row input{flex:1;border:1.5px solid #e2e8f0;border-radius:8px;padding:7px 10px;font-size:14px}
    .cl-item-del{background:#fef2f2;color:#dc2626;border:none;border-radius:7px;padding:0 11px;font-size:15px;cursor:pointer}
    .cl-modal-foot{display:flex;align-items:center;gap:10px;margin-top:16px}
  </style>

  <script src="../../scripts/portal/den.ts"></script>
</PortalLayout>
