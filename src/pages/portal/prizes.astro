---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { PRIZES } from '../../lib/portalPrizes';
import { listPrizeStates, listActivities } from '../../lib/portalEconomy';

const role = Astro.locals.portalRole!;
if (!['admin', 'rukovoditel'].includes(role)) {
  return Astro.redirect('/portal/');
}

const [prizeStates, activities] = await Promise.all([listPrizeStates(), listActivities()]);
const stateById = new Map(prizeStates.map((s) => [s.prize_id, s]));

const totalAll = PRIZES.reduce((s, p) => s + p.price * p.qty, 0);
const fmtRub = (n: number) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';

// Группировка по заказам
const byOrder = PRIZES.reduce<Record<string, typeof PRIZES>>((acc, p) => {
  const k = p.order ?? '—';
  (acc[k] ??= []).push(p);
  return acc;
}, {});

const CAT_LABELS: Record<string, string> = {
  phone: 'Телефон',
  fun: 'Развлечения',
  food: 'Еда',
  prize: 'Физ. приз',
  privilege: 'Привилегии',
  comfort: 'Комфорт',
  service: 'Услуги',
  other: 'Прочее',
};
---
<PortalLayout title="Экономика смены — АйДаКемп">
  <div class="mb-4">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Экономика смены
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Внутренняя экономика «выкупа внимания» — игровые рубли. Ребёнок сам решает: телефон, кино, костёр или физический приз.
    </p>
  </div>

  {/* Философия — короткая шпаргалка для админа */}
  <div class="mb-4 rounded-[14px] border border-amber-200 bg-amber-50/60 p-4 text-[14px] text-navy-950">
    <div class="mb-1 flex items-center gap-2 font-semibold text-amber-800">
      <i class="bi bi-info-circle" aria-hidden="true"></i> Как устроена экономика
    </div>
    <ul class="ml-5 list-disc space-y-1">
      <li><b>Валюта</b> — игровой рубль (₽). Якорь: 1 минута телефона = 10 ₽. Инфляции нет.</li>
      <li><b>Доход:</b> ребёнок получает <b>600 ₽/день</b> просто за участие — это ровно час телефона. Без условий.</li>
      <li><b>Расход — выбор:</b> минуты телефона (×10 ₽) ↔ копить на коллективный лот (кино 3 000, костёр 5 000, отбой позже 4 000, отмена урока 5 000, <b>телефон на ночь — 8 000</b>) ↔ физический приз (1 500–2 000).</li>
      <li>Коллективные лоты — это <b>учить договариваться:</b> «не ныть, а договариваться. Не просить, а организовывать». Покупки одному не потянуть — нужен консилиум.</li>
      <li>Эффект из канона: <b>«На третий день телефон почти никто не покупает — жизнь выигрывает конкуренцию у экрана».</b></li>
    </ul>
  </div>

  {/* Шапка-настройки — общий калькулятор */}
  <div class="mb-6 rounded-[16px] border border-border bg-white p-5 card-shadow">
    <div class="mb-3 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
      <i class="bi bi-sliders" aria-hidden="true"></i>
      Параметры смены
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Детей на смене</span>
        <input id="set-kids" type="number" min="1" max="200" value="35"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Дней в смене</span>
        <input id="set-days" type="number" min="1" max="30" value="10"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">1 минута телефона, ₽ <span class="text-amber-700">(якорь)</span></span>
        <input id="set-phone-min" type="number" min="1" step="1" value="10"
               class="mt-1 w-full rounded-[10px] border border-amber-300 bg-amber-50/40 px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Наценка × для призов из Ozon</span>
        <input id="set-markup" type="number" min="1" step="0.1" value="3"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Выдача в день, ₽ <span class="text-amber-700">(= час телефона)</span></span>
        <input id="set-daily" type="number" min="0" step="50" value="600"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
        <span class="mt-1 block text-[12px] text-body-muted">600 ₽ — это ровно 60 минут телефона. Получают все, без условий.</span>
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Округление до</span>
        <select id="set-round"
                class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 font-mono tabular-nums focus:border-primary focus:outline-none">
          <option value="10">10 ₽</option>
          <option value="50" selected>50 ₽</option>
          <option value="100">100 ₽</option>
        </select>
      </label>
    </div>

    <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Потенциал ребёнка / день</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-potential">—</span>
        </div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">За всю смену с ребёнка</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-per-kid">—</span>
        </div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Эквивалент <i class="bi bi-telephone-fill text-[12px] text-primary" aria-hidden="true"></i> минут / день</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-phone-equiv">—</span>
        </div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Всего в обороте за смену</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-total">—</span>
        </div>
      </div>
    </div>
  </div>

  {/* Tabs */}
  <div class="mb-4 flex flex-wrap gap-2 border-b border-border">
    <button data-tab="prizes" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-border bg-white px-4 py-2 text-[15px] font-medium">
      <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы
    </button>
    <button data-tab="activities" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-star-fill" aria-hidden="true"></i> Активности
    </button>
    <button data-tab="summary" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Сводка
    </button>
  </div>

  {/* ── Tab: Prizes ───────────────────────────────────────────────────────── */}
  <section data-tab-pane="prizes">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div class="text-[14px] text-body-muted">
        Активных: <b id="cnt-active">—</b> · Сумма в игровых ₽: <b id="sum-bongere">—</b>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="btn-apply-markup" type="button"
          class="rounded-[10px] border border-primary bg-primary text-white px-3 py-1.5 text-[14px] hover:opacity-90">
          <i class="bi bi-magic" aria-hidden="true"></i>
          Применить наценку ко всем
        </button>
        <button id="btn-import-local" type="button"
          class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] text-navy-950 hover:border-primary hover:text-primary"
          title="Берёт удалённые позиции и цены из localStorage этого браузера и сохраняет на сервер">
          <i class="bi bi-cloud-upload" aria-hidden="true"></i>
          Загрузить локальные правки на сервер
        </button>
        <button id="btn-show-hidden" type="button"
          class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] text-navy-950 hover:border-primary hover:text-primary">
          <i class="bi bi-eye" aria-hidden="true"></i>
          Показать скрытые
        </button>
      </div>
    </div>

    {Object.entries(byOrder).map(([order, items]) => (
      <div class="mb-6">
        <h2 class="mb-2 flex items-center gap-2 text-[16px] font-semibold text-navy-950">
          <i class="bi bi-receipt text-primary" aria-hidden="true"></i>
          Счёт Ozon № {order}
          <span class="text-[13px] font-normal text-body-muted">· {items.length} поз. · {fmtRub(items.reduce((s, p) => s + p.price * p.qty, 0))}</span>
        </h2>

        <div class="overflow-x-auto rounded-[14px] border border-border bg-white card-shadow">
          <table class="w-full text-[14px]">
            <thead class="bg-page text-left text-[12px] uppercase tracking-wide text-body-muted">
              <tr>
                <th class="w-[60px] p-2"></th>
                <th class="p-2">Наименование</th>
                <th class="w-[80px] p-2 text-right">Цена&nbsp;Ozon</th>
                <th class="w-[50px] p-2 text-right">Кол-во</th>
                <th class="w-[90px] p-2 text-right">Сумма</th>
                <th class="w-[100px] p-2 text-right">Рекоменд.</th>
                <th class="w-[130px] p-2 text-right">Цена,&nbsp;игр.&nbsp;₽</th>
                <th class="w-[90px] p-2 text-right" title="Сколько дней ребёнку нужно копить, если откажется от телефона">Копить</th>
                <th class="w-[40px] p-2"></th>
              </tr>
            </thead>
            <tbody>
              {items.map((p) => {
                const st = stateById.get(p.id);
                return (
                  <tr data-prize-row data-id={p.id} data-price={p.price} data-qty={p.qty}
                      data-default-img={p.img ?? ''}
                      data-hidden={st?.hidden ? '1' : '0'}
                      data-bongere={st?.bongere_price ?? ''}
                      class="border-t border-border align-middle">
                    <td class="p-2">
                      <div class="flex h-[48px] w-[48px] items-center justify-center overflow-hidden rounded-[6px] border border-border bg-white">
                        {(st?.custom_photo || p.img) ? (
                          <img src={st?.custom_photo || p.img} alt="" loading="lazy" referrerpolicy="no-referrer"
                               style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                        ) : (
                          <i class="bi bi-image text-body-muted" aria-hidden="true"></i>
                        )}
                      </div>
                    </td>
                    <td class="p-2">
                      <div class="font-medium text-navy-950">{p.name}</div>
                      <div class="mt-0.5 flex flex-wrap items-center gap-2 text-[12px] text-body-muted">
                        {p.category && <span class="rounded-full bg-primary-soft px-2 py-0.5 text-primary">{p.category}</span>}
                        {p.url ? (
                          <a href={p.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Карточка Ozon
                          </a>
                        ) : (
                          <a href={`https://www.ozon.ru/search/?text=${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                            <i class="bi bi-search" aria-hidden="true"></i> Найти на Ozon
                          </a>
                        )}
                      </div>
                    </td>
                    <td class="p-2 text-right font-mono tabular-nums">{fmtRub(p.price)}</td>
                    <td class="p-2 text-right font-mono tabular-nums">{p.qty}</td>
                    <td class="p-2 text-right font-mono tabular-nums font-semibold">{fmtRub(p.price * p.qty)}</td>
                    <td class="p-2 text-right font-mono tabular-nums text-primary" data-recommended></td>
                    <td class="p-2 text-right">
                      <div class="flex items-center justify-end gap-1">
                        <input type="number" min="0" step="50" data-bongere-input
                               class="w-[90px] rounded-[8px] border border-border bg-white px-2 py-1 text-right font-mono tabular-nums focus:border-primary focus:outline-none"
                               placeholder="—" value={st?.bongere_price ?? ''} />
                        <span class="text-body-muted">₽</span>
                      </div>
                    </td>
                    <td class="p-2 text-right font-mono tabular-nums" data-save-days></td>
                    <td class="p-2 text-right">
                      <button type="button" data-toggle-hidden
                              class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] text-body-muted transition hover:bg-red-50 hover:text-red-600"
                              title={st?.hidden ? 'Показать (вернуть в список)' : 'Скрыть'}>
                        <i class={`bi ${st?.hidden ? 'bi-eye-slash' : 'bi-x-lg'}`} aria-hidden="true"></i>
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>

  {/* ── Tab: Activities ──────────────────────────────────────────────────── */}
  <section data-tab-pane="activities" hidden>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div class="text-[14px] text-body-muted">
        Каталог нестандартных «подарков»-привилегий, которые ребята могут выкупить за игровые рубли.
        Цена считается из <b>себестоимости × наценку</b> или прицеливается на <b>~30 человек скидываются</b>.
      </div>
      <button id="btn-add-activity" type="button"
        class="rounded-[10px] border border-primary bg-primary text-white px-3 py-1.5 text-[14px] hover:opacity-90">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        Добавить активность
      </button>
    </div>

    <div class="overflow-x-auto rounded-[14px] border border-border bg-white card-shadow">
      <table class="w-full text-[14px]">
        <thead class="bg-page text-left text-[12px] uppercase tracking-wide text-body-muted">
          <tr>
            <th class="p-2">Название</th>
            <th class="w-[110px] p-2">Категория</th>
            <th class="w-[110px] p-2 text-right">Цена,&nbsp;игр.&nbsp;₽</th>
            <th class="w-[90px] p-2 text-right">Скидыв.&nbsp;чел.</th>
            <th class="w-[110px] p-2 text-right">С человека</th>
            <th class="w-[110px] p-2 text-right" title="Сколько дней копить одному ребёнку (при максимальном потенциале)">Копить</th>
            <th class="w-[80px] p-2"></th>
          </tr>
        </thead>
        <tbody id="activities-tbody">
          {activities.map((a) => (
            <tr data-activity-row data-id={a.id}
                data-bongere={a.base_price ?? 0}
                data-participants={a.participants_hint ?? ''}
                class="border-t border-border align-middle">
              <td class="p-2">
                <div class="font-medium text-navy-950">{a.name}</div>
                {a.description && <div class="mt-0.5 text-[12px] text-body-muted">{a.description}</div>}
              </td>
              <td class="p-2"><span class="rounded-full bg-primary-soft px-2 py-0.5 text-[12px] text-primary">{CAT_LABELS[a.category ?? 'other'] ?? a.category ?? '—'}</span></td>
              <td class="p-2 text-right font-mono tabular-nums font-semibold">{a.base_price != null ? fmtRub(a.base_price) : '—'}</td>
              <td class="p-2 text-right font-mono tabular-nums">{a.participants_hint ?? '—'}</td>
              <td class="p-2 text-right font-mono tabular-nums text-primary" data-per-person>—</td>
              <td class="p-2 text-right font-mono tabular-nums" data-save-days>—</td>
              <td class="p-2 text-right">
                <button type="button" data-edit-activity data-id={a.id}
                        class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] text-body-muted hover:bg-primary-soft hover:text-primary"
                        title="Редактировать">
                  <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
                <button type="button" data-delete-activity data-id={a.id}
                        class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] text-body-muted hover:bg-red-50 hover:text-red-600"
                        title="Удалить">
                  <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Модалка добавления / редактирования */}
    <dialog id="activity-dialog" class="rounded-[16px] border border-border p-0 backdrop:bg-black/30">
      <form method="dialog" class="w-[min(560px,95vw)] p-5">
        <h3 class="text-[18px] font-semibold text-navy-950">Активность</h3>
        <input type="hidden" id="act-id" />
        <div class="mt-4 grid gap-3">
          <label class="block">
            <span class="block text-[13px] font-medium text-body-muted">Название</span>
            <input id="act-name" type="text" required
                   class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none" />
          </label>
          <label class="block">
            <span class="block text-[13px] font-medium text-body-muted">Описание</span>
            <textarea id="act-desc" rows="2" data-voice data-voice-append
                      class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none"></textarea>
          </label>
          <div class="grid gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="block text-[13px] font-medium text-body-muted">Категория</span>
              <select id="act-cat" class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none">
                <option value="phone">Телефон</option>
                <option value="fun">Развлечения</option>
                <option value="food">Еда</option>
                <option value="prize">Физ. приз</option>
                <option value="privilege">Привилегии</option>
                <option value="comfort">Комфорт</option>
                <option value="service">Услуги</option>
                <option value="other">Прочее</option>
              </select>
            </label>
            <label class="block">
              <span class="block text-[13px] font-medium text-body-muted">Цена в игровых рублях</span>
              <input id="act-price" type="number" min="0" step="100"
                     class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
            </label>
            <label class="block">
              <span class="block text-[13px] font-medium text-body-muted">Скидываются чел.</span>
              <input id="act-participants" type="number" min="1"
                     class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono focus:border-primary focus:outline-none" />
            </label>
          </div>
        </div>
        <div class="mt-5 flex justify-end gap-2">
          <button type="button" id="act-cancel"
                  class="rounded-[10px] border border-border bg-white px-4 py-2 text-[14px] text-navy-950 hover:border-primary">Отмена</button>
          <button type="button" id="act-save"
                  class="rounded-[10px] border border-primary bg-primary px-4 py-2 text-[14px] text-white hover:opacity-90">Сохранить</button>
        </div>
      </form>
    </dialog>
  </section>

  {/* ── Tab: Summary ─────────────────────────────────────────────────────── */}
  <section data-tab-pane="summary" hidden>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-[14px] border border-border bg-white p-5 card-shadow">
        <div class="mb-3 text-[14px] font-semibold uppercase tracking-wide text-primary">
          <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы — общая экономика
        </div>
        <div class="space-y-2 text-[15px]">
          <div class="flex justify-between"><span class="text-body-muted">Закуплено (Ozon)</span><b class="font-mono tabular-nums">{fmtRub(totalAll)}</b></div>
          <div class="flex justify-between"><span class="text-body-muted">В игровых ₽ (рекоменд.)</span><b class="font-mono tabular-nums" id="sum-recommended">—</b></div>
          <div class="flex justify-between"><span class="text-body-muted">В игровых ₽ (заданные)</span><b class="font-mono tabular-nums" id="sum-bongere-2">—</b></div>
          <div class="flex justify-between text-[14px] text-body-muted"><span>Средняя наценка</span><span id="sum-markup-avg">—</span></div>
        </div>
      </div>
      <div class="rounded-[14px] border border-border bg-white p-5 card-shadow">
        <div class="mb-3 text-[14px] font-semibold uppercase tracking-wide text-primary">
          <i class="bi bi-coin" aria-hidden="true"></i> Денежный поток
        </div>
        <div class="space-y-2 text-[15px]">
          <div class="flex justify-between"><span class="text-body-muted">Всего в обороте</span><b class="font-mono tabular-nums" id="sum-total-money">—</b></div>
          <div class="flex justify-between"><span class="text-body-muted">Если потратить на призы</span><b class="font-mono tabular-nums" id="sum-balance-prizes">—</b></div>
          <div class="flex justify-between"><span class="text-body-muted">Остаток на активности</span><b class="font-mono tabular-nums" id="sum-balance-acts">—</b></div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const LS_KEY = 'aidacamp.portal.prizes.v1';        // старое хранение
      const LS_SETTINGS = 'aidacamp.portal.economy.settings.v1';
      const fmt = (n) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';

      // Settings
      function loadSettings() {
        try { return JSON.parse(localStorage.getItem(LS_SETTINGS) || '{}') || {}; } catch { return {}; }
      }
      function saveSettings(s) {
        try { localStorage.setItem(LS_SETTINGS, JSON.stringify(s)); } catch {}
      }
      const set = Object.assign({
        kids: 35, days: 10, phoneMin: 10, markup: 3, round: 50, daily: 600,
      }, loadSettings());
      const idMap = {
        'set-kids':'kids','set-days':'days','set-phone-min':'phoneMin','set-markup':'markup','set-round':'round','set-daily':'daily',
      };
      for (const id of Object.keys(idMap)) {
        const el = document.getElementById(id);
        if (el) el.value = String(set[idMap[id]] ?? '');
      }

      function readSettings() {
        const num = (id, min) => Math.max(min, Number(document.getElementById(id).value) || min);
        return {
          kids: num('set-kids', 1),
          days: num('set-days', 1),
          phoneMin: num('set-phone-min', 1),
          markup: num('set-markup', 1),
          round: num('set-round', 1),
          daily: Math.max(0, Number(document.getElementById('set-daily').value) || 0),
        };
      }
      function dailyPotential(s) { return s.daily; }
      function saveDays(price, potential) {
        if (!price || price <= 0 || potential <= 0) return 0;
        return Math.ceil(price / potential);
      }
      function roundTo(n, step) { return Math.round(n / step) * step; }

      // Tabs
      document.querySelectorAll('[data-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          document.querySelectorAll('[data-tab]').forEach((b) => {
            const active = b.dataset.tab === tab;
            b.classList.toggle('bg-white', active);
            b.classList.toggle('border-border', active);
            b.classList.toggle('bg-page', !active);
            b.classList.toggle('border-transparent', !active);
            b.classList.toggle('text-body-muted', !active);
          });
          document.querySelectorAll('[data-tab-pane]').forEach((p) => {
            p.hidden = p.dataset.tabPane !== tab;
          });
        });
      });

      // ── Prizes ────────────────────────────────────────
      const prizeRows = Array.from(document.querySelectorAll('[data-prize-row]'));
      let showHidden = false;

      function recalcPrizes() {
        const s = readSettings();
        const dp = dailyPotential(s);
        let active = 0, sumBongere = 0, sumRec = 0, sumOzonVisible = 0;
        prizeRows.forEach((r) => {
          const isHidden = r.dataset.hidden === '1';
          if (isHidden && !showHidden) { r.style.display = 'none'; return; }
          if (isHidden && showHidden)  { r.style.display = ''; r.style.opacity = '0.45'; }
          else { r.style.display = ''; r.style.opacity = ''; }
          if (!isHidden) active++;
          const price = Number(r.dataset.price || 0);
          const qty = Number(r.dataset.qty || 0);
          if (!isHidden) sumOzonVisible += price * qty;
          const rec = roundTo(price * s.markup, s.round);
          r.querySelector('[data-recommended]').textContent = fmt(rec) + ' / шт';
          const inp = r.querySelector('[data-bongere-input]');
          const v = inp.value === '' ? null : Number(inp.value);
          if (!isHidden && v != null && !isNaN(v)) sumBongere += v * qty;
          if (!isHidden) sumRec += rec * qty;
          // Копить N дней — берём установленную цену, иначе рекомендованную
          const targetPrice = (v != null && !isNaN(v)) ? v : rec;
          const days = saveDays(targetPrice, dp);
          const cell = r.querySelector('[data-save-days]');
          if (cell) {
            if (days <= 0) { cell.textContent = '—'; }
            else if (days > s.days) {
              cell.innerHTML = '<span class="text-red-600">' + days + ' дн</span><div class="text-[11px] text-body-muted">> смены</div>';
            } else {
              cell.innerHTML = days + ' <span class="text-[11px] text-body-muted">дн</span>';
            }
          }
        });
        document.getElementById('cnt-active').textContent = String(active);
        document.getElementById('sum-bongere').textContent = fmt(sumBongere);
        // KPI шапки
        const total = s.kids * dp * s.days;
        document.getElementById('kpi-potential').textContent = fmt(dp);
        document.getElementById('kpi-per-kid').textContent = fmt(dp * s.days);
        document.getElementById('kpi-phone-equiv').textContent = (s.phoneMin > 0 ? Math.floor(dp / s.phoneMin) : 0) + ' мин';
        document.getElementById('kpi-total').textContent = fmt(total);
        // Сводка
        const sumRecEl = document.getElementById('sum-recommended'); if (sumRecEl) sumRecEl.textContent = fmt(sumRec);
        const sumBon2 = document.getElementById('sum-bongere-2'); if (sumBon2) sumBon2.textContent = fmt(sumBongere);
        const sumTot = document.getElementById('sum-total-money'); if (sumTot) sumTot.textContent = fmt(total);
        const usedForPrizes = sumBongere || sumRec;
        const balPr = document.getElementById('sum-balance-prizes'); if (balPr) balPr.textContent = fmt(total - usedForPrizes);
        const balAc = document.getElementById('sum-balance-acts'); if (balAc) balAc.textContent = fmt(total - usedForPrizes);
        const avg = sumOzonVisible > 0 && sumBongere > 0 ? (sumBongere / sumOzonVisible) : null;
        const ma = document.getElementById('sum-markup-avg');
        if (ma) ma.textContent = avg != null ? '×' + avg.toFixed(2) : '×' + s.markup.toFixed(1);
        // Активности
        recalcActivities();
      }

      ['set-kids','set-days','set-phone-min','set-markup','set-round','set-daily'].forEach((id) => {
        const el = document.getElementById(id);
        el.addEventListener('input', () => {
          const s = readSettings();
          saveSettings(s);
          recalcPrizes();
        });
      });

      document.getElementById('btn-show-hidden').addEventListener('click', (ev) => {
        showHidden = !showHidden;
        ev.currentTarget.innerHTML = showHidden
          ? '<i class="bi bi-eye-slash"></i> Скрыть скрытые'
          : '<i class="bi bi-eye"></i> Показать скрытые';
        recalcPrizes();
      });

      // Save prize state to server
      async function savePrizeState(id, patch) {
        try {
          const r = await fetch('/api/portal/economy', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'set_prize', prize_id: id, ...patch }),
          });
          if (!r.ok) throw new Error('HTTP ' + r.status);
        } catch (e) { console.error('save prize state failed', e); }
      }

      // Bongere input — debounced save
      prizeRows.forEach((r) => {
        const id = r.dataset.id;
        const inp = r.querySelector('[data-bongere-input]');
        let t;
        inp.addEventListener('input', () => {
          clearTimeout(t);
          t = setTimeout(() => {
            const v = inp.value === '' ? null : Number(inp.value);
            r.dataset.bongere = v == null ? '' : String(v);
            savePrizeState(id, { bongere_price: v });
            recalcPrizes();
          }, 350);
        });
        // Hide / show
        r.querySelector('[data-toggle-hidden]').addEventListener('click', async () => {
          const wasHidden = r.dataset.hidden === '1';
          if (!wasHidden && !confirm('Скрыть эту позицию? Она пропадёт из активного списка, можно вернуть кнопкой «Показать скрытые».')) return;
          r.dataset.hidden = wasHidden ? '0' : '1';
          await savePrizeState(id, { hidden: !wasHidden });
          // Refresh icon
          r.querySelector('[data-toggle-hidden] i').className = wasHidden ? 'bi bi-x-lg' : 'bi bi-eye-slash';
          recalcPrizes();
        });
      });

      // Apply markup to all visible
      document.getElementById('btn-apply-markup').addEventListener('click', async () => {
        const s = readSettings();
        if (!confirm('Записать «Цена × ' + s.markup + ', округление до ' + s.round + ' ₽» в поле «Цена, игр. ₽» для всех видимых позиций?')) return;
        for (const r of prizeRows) {
          if (r.dataset.hidden === '1') continue;
          const price = Number(r.dataset.price || 0);
          const rec = roundTo(price * s.markup, s.round);
          r.querySelector('[data-bongere-input]').value = rec;
          r.dataset.bongere = String(rec);
          await savePrizeState(r.dataset.id, { bongere_price: rec });
        }
        recalcPrizes();
      });

      // Import from localStorage
      document.getElementById('btn-import-local').addEventListener('click', async () => {
        let local;
        try { local = JSON.parse(localStorage.getItem(LS_KEY) || '{}') || {}; } catch { local = {}; }
        const deleted = Array.isArray(local.deleted) ? local.deleted : [];
        const bongere = local.bongere && typeof local.bongere === 'object' ? local.bongere : {};
        const photos  = local.photos  && typeof local.photos  === 'object' ? local.photos  : {};
        const cnt = deleted.length + Object.keys(bongere).length + Object.keys(photos).length;
        if (cnt === 0) { alert('В localStorage этого браузера ничего нет.'); return; }
        if (!confirm('Загрузить на сервер: ' + deleted.length + ' скрытых, ' + Object.keys(bongere).length + ' цен, ' + Object.keys(photos).length + ' фото?')) return;
        const r = await fetch('/api/portal/economy', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'import_localstorage', deleted, bongere, photos }),
        });
        const jr = await r.json().catch(() => ({}));
        if (jr.ok) {
          alert('Загружено: ' + jr.imported + ' записей. Перезагрузи страницу — увидишь актуальное состояние.');
        } else {
          alert('Ошибка: ' + (jr.error || 'unknown'));
        }
      });

      // ── Activities ────────────────────────────────────
      const actRows = Array.from(document.querySelectorAll('[data-activity-row]'));
      function recalcActivities() {
        const s = readSettings();
        const dp = dailyPotential(s);
        actRows.forEach((r) => {
          const total = Number(r.dataset.bongere || 0);
          const partRaw = r.dataset.participants;
          const part = partRaw === '' ? null : Number(partRaw);
          const perPerson = part && part > 0 ? roundTo(total / part, s.round) : total;
          const ppCell = r.querySelector('[data-per-person]');
          if (ppCell) ppCell.textContent = part && part > 1 ? fmt(perPerson) + ' × ' + part : fmt(perPerson);
          const days = saveDays(perPerson, dp);
          const cell = r.querySelector('[data-save-days]');
          if (cell) {
            if (days <= 0) cell.textContent = '—';
            else if (days > s.days) cell.innerHTML = '<span class="text-red-600">' + days + ' дн</span>';
            else cell.innerHTML = days + ' <span class="text-[11px] text-body-muted">дн</span>';
          }
        });
      }

      // Activity dialog
      const dlg = document.getElementById('activity-dialog');
      function openDialog(act) {
        document.getElementById('act-id').value = act?.id || '';
        document.getElementById('act-name').value = act?.name || '';
        document.getElementById('act-desc').value = act?.description || '';
        document.getElementById('act-cat').value = act?.category || 'fun';
        document.getElementById('act-price').value = act?.base_price ?? '';
        document.getElementById('act-participants').value = act?.participants_hint ?? '';
        dlg.showModal();
      }
      document.getElementById('btn-add-activity').addEventListener('click', () => openDialog(null));
      document.getElementById('act-cancel').addEventListener('click', () => dlg.close());

      document.getElementById('act-save').addEventListener('click', async () => {
        const id = document.getElementById('act-id').value;
        const body = {
          action: 'upsert_activity',
          id: id ? Number(id) : undefined,
          name: document.getElementById('act-name').value.trim(),
          description: document.getElementById('act-desc').value.trim() || null,
          category: document.getElementById('act-cat').value,
          base_price: document.getElementById('act-price').value || null,
          participants_hint: document.getElementById('act-participants').value || null,
        };
        if (!body.name) { alert('Введите название'); return; }
        const r = await fetch('/api/portal/economy', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const jr = await r.json().catch(() => ({}));
        if (jr.ok) { dlg.close(); location.reload(); }
        else alert('Ошибка: ' + (jr.error || 'unknown'));
      });

      document.querySelectorAll('[data-edit-activity]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const r = btn.closest('[data-activity-row]');
          openDialog({
            id: r.dataset.id,
            name: r.querySelector('td .font-medium').textContent,
            description: r.querySelector('td .text-body-muted')?.textContent || '',
            category: '', // не критично, переустановится из формы
            base_price: Number(r.dataset.bongere || 0),
            participants_hint: r.dataset.participants === '' ? null : Number(r.dataset.participants),
          });
        });
      });
      document.querySelectorAll('[data-delete-activity]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Удалить эту активность?')) return;
          const id = btn.dataset.id;
          const r = await fetch('/api/portal/economy', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete_activity', id: Number(id) }),
          });
          const jr = await r.json().catch(() => ({}));
          if (jr.ok) location.reload(); else alert('Ошибка: ' + (jr.error || 'unknown'));
        });
      });

      // First render
      recalcPrizes();
    })();
  </script>
</PortalLayout>
