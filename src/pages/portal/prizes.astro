---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { isStaff } from '../../lib/portalPerms';
import { listPrizeStates, listActivities } from '../../lib/portalEconomy';
import { listCustomPrizes, countIssuancesByPrize } from '../../lib/portalPrizeOps';
import { listKids } from '../../lib/portalKid';
import { listAllBalances } from '../../lib/portalKidLedger';
import EconomySettings from '../../components/portal/economy/EconomySettings.astro';
import PrizesTable from '../../components/portal/economy/PrizesTable.astro';
import GivePrizeDialog from '../../components/portal/economy/GivePrizeDialog.astro';
import CustomPrizeDialog from '../../components/portal/economy/CustomPrizeDialog.astro';
import ActivitiesTable from '../../components/portal/economy/ActivitiesTable.astro';
import ActivityDialog from '../../components/portal/economy/ActivityDialog.astro';
import SummaryTab from '../../components/portal/economy/SummaryTab.astro';
import KidLedgerTab from '../../components/portal/economy/KidLedgerTab.astro';
import KidLedgerDialog from '../../components/portal/economy/KidLedgerDialog.astro';

const role = Astro.locals.portalRole!;
if (!isStaff(role)) {
  return Astro.redirect('/portal/');
}

const [prizeStates, activities, customPrizes, issuanceCounts, kids, kidBalances] = await Promise.all([
  listPrizeStates(),
  listActivities(),
  listCustomPrizes(),
  countIssuancesByPrize(),
  listKids(false),
  listAllBalances(),
]);
const stateById = new Map(prizeStates.map((s) => [s.prize_id, s]));

// Объединяем hardcoded + кастомные призы в одном списке.
// Все призы теперь из БД (portal_prize_custom). Базовые помечены is_base,
// добавленные штабом — isCustom. Хардкод PRIZES перенесён в БД сид-миграцией.
const ALL_PRIZES = customPrizes.map((c) => ({
  id: c.slug,
  name: c.name,
  price: c.ozon_price ?? 0,
  qty: c.qty,
  category: c.category ?? 'Кастом',
  img: c.img_url ?? undefined,
  url: c.url ?? undefined,
  sources: undefined as string[] | undefined,
  isCustom: !c.is_base,
  customId: c.id,
}));

const totalAll = ALL_PRIZES.reduce((s, p) => s + p.price * p.qty, 0);
const fmtRub = (n: number) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';

const CAT_LABELS: Record<string, string> = {
  phone: 'Телефон',
  fun: 'Развлечения',
  food: 'Еда',
  prize: 'Физ. приз',
  privilege: 'Привилегии',
  comfort: 'Комфорт',
  service: 'Услуги',
  other: 'Прочее',
};
---
<PortalLayout title="Экономика смены — АйДаКемп">
  <div class="mb-4">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Экономика смены
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Внутренняя экономика «выкупа внимания» — игровые рубли. Ребёнок сам решает: телефон, кино, костёр или физический приз.
    </p>
  </div>

  {/* Философия — короткая шпаргалка для админа */}
  <div class="mb-4 rounded-[14px] border border-amber-200 bg-amber-50/60 p-4 text-base text-navy-950">
    <div class="mb-1 flex items-center gap-2 font-semibold text-amber-800">
      <i class="bi bi-info-circle" aria-hidden="true"></i> Как устроена экономика
    </div>
    <ul class="ml-5 list-disc space-y-1">
      <li><b>Валюта</b> — игровой рубль. Якорь: 1 минута телефона = 10 ₽. Выдача — 600 ₽/день (= час телефона). Без условий.</li>
      <li><b>Цель цен:</b> изъять <b>70-80%</b> игровой валюты из оборота через призы и активности.</li>
      <li><b>Формула активности</b> = <code>группа × выдача × дней копления × доля дохода (30-50%)</code>. Для смены 35×600 — активность ≈ 20 000 ₽ за 2-3 дня скидывания.</li>
      <li><b>Индивидуальный приз</b> — 3-8 дней сбережений = 1 800–4 800 ₽.</li>
      <li><b>Повторная покупка</b> той же активности дорожает <b>×1.5</b> (вторая «Ночь с телефонами» уже не 20 000, а 30 000).</li>
      <li>Эффект из канона: <b>«На третий день телефон почти никто не покупает — жизнь выигрывает конкуренцию у экрана».</b></li>
    </ul>
  </div>

  <details class="econ-collapse mb-6">
    <summary class="econ-summary">
      <i class="bi bi-sliders" aria-hidden="true"></i>
      <span>Параметры и калькулятор экономики</span>
      <i class="bi bi-chevron-down econ-chevron" aria-hidden="true"></i>
    </summary>
    <div class="econ-collapse-body">
      <EconomySettings />
    </div>
  </details>

  {/* Tabs */}
  <div class="mb-4 flex flex-wrap gap-2 border-b border-border">
    <button data-tab="prizes" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-border bg-white px-4 py-2 text-base font-medium">
      <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы
    </button>
    <button data-tab="activities" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-base font-medium text-body-muted">
      <i class="bi bi-star-fill" aria-hidden="true"></i> Активности
    </button>
    <button data-tab="summary" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-base font-medium text-body-muted">
      <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Сводка
    </button>
    <button data-tab="kids" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-base font-medium text-body-muted">
      <i class="bi bi-wallet2" aria-hidden="true"></i> Личный счёт
    </button>
  </div>

  {/* ── Tab: Prizes ───────────────────────────────────────────────────────── */}
  <section data-tab-pane="prizes">
    <PrizesTable prizes={ALL_PRIZES} {stateById} {issuanceCounts} {role} {fmtRub} />
    <GivePrizeDialog {kids} />
    <CustomPrizeDialog />

    {/* ── Modal: Журнал выдач по призу ────────────────────────────── */}
    <div id="issuances-sheet" class="portal-sheet" hidden>
      <div class="portal-sheet__backdrop" data-iss-backdrop></div>
      <div class="portal-sheet__panel">
        <div class="portal-sheet__body">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-[18px] font-semibold text-navy-950">
            <i class="bi bi-gift-fill text-primary mr-1" aria-hidden="true"></i>
            Выдачи: <span id="iss-prize-name" class="text-primary"></span>
          </h3>
          <button type="button" id="iss-close"
                  class="flex h-8 w-8 items-center justify-center rounded-full text-body-muted hover:bg-red-50 hover:text-red-600">
            <i class="bi bi-x-lg text-[16px]" aria-hidden="true"></i>
          </button>
        </div>

        <div id="iss-loading" class="mt-4 text-base text-body-muted">Загрузка…</div>
        <div id="iss-empty" hidden class="mt-4 text-base text-body-muted">Выдач пока нет.</div>
        <div id="iss-list" hidden class="mt-3 space-y-2"></div>

        <div id="iss-error" hidden class="mt-3 rounded-[10px] bg-red-50 px-3 py-2 text-base text-red-700"></div>

        <div class="mt-4 flex items-center justify-between gap-2">
          <span class="text-[12px] text-body-muted">🗑 Один клик — красный, второй — удалить</span>
          <button type="button" id="iss-close2"
                  class="rounded-[10px] border border-border bg-white px-4 py-2 text-base text-navy-950 hover:border-primary">
            Закрыть
          </button>
        </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Tab: Activities ──────────────────────────────────────────────────── */}
  <section data-tab-pane="activities" hidden>
    <ActivitiesTable {activities} catLabels={CAT_LABELS} />
    <ActivityDialog />
  </section>

  {/* ── Tab: Summary ─────────────────────────────────────────────────────── */}
  <section data-tab-pane="summary" hidden>
    <SummaryTab {fmtRub} {totalAll} />
  </section>

  {/* ── Tab: Kids — личный счёт ───────────────────────────────────────────── */}
  <section data-tab-pane="kids" hidden>
    <KidLedgerTab balances={kidBalances} {fmtRub} />
    <KidLedgerDialog {kids} />
  </section>

  <style is:global>
    .econ-collapse{border:1px solid var(--border,#e5e7eb);border-radius:14px;background:#fff;overflow:hidden}
    .econ-summary{display:flex;align-items:center;gap:8px;cursor:pointer;padding:14px 16px;font-size:14px;font-weight:600;color:#285085;list-style:none;user-select:none}
    .econ-summary::-webkit-details-marker{display:none}
    .econ-summary:hover{background:#f8f9fb}
    .econ-chevron{margin-left:auto;transition:transform .2s;color:#9aa3b0}
    .econ-collapse[open] .econ-chevron{transform:rotate(180deg)}
    .econ-collapse-body{padding:0 4px 4px}
    /* убрать двойную рамку у вложенного EconomySettings */
    .econ-collapse-body > div{margin-bottom:0 !important;border:none !important;box-shadow:none !important}
    /* Панель выдач использует общий .portal-sheet из portal.css (дубль удалён). */
    /* Печать — только активная вкладка */
    @media print {
      header, nav, [data-tab], .tab-btn, [id^="btn-"], [data-give], [data-toggle-hidden],
      [data-reset-price], [data-archive-custom], [data-edit-activity], [data-delete-activity],
      [data-reset-custom-price], [data-save-flag], [data-act-save-flag],
      dialog, .card-shadow { box-shadow: none !important; }
      .tab-btn, dialog { display: none !important; }
      [data-tab-pane][hidden] { display: none !important; }
      body.printing-prizes [data-tab-pane="activities"], body.printing-prizes [data-tab-pane="summary"],
      body.printing-activities [data-tab-pane="prizes"], body.printing-activities [data-tab-pane="summary"] { display: none !important; }
      body.printing-prizes #btn-add-custom, body.printing-prizes #btn-print-prizes,
      body.printing-prizes [data-give], body.printing-prizes [data-toggle-hidden],
      body.printing-prizes [data-bongere-input], body.printing-prizes [data-archive-custom],
      body.printing-activities [data-custom-price-input], body.printing-activities [data-reset-custom-price],
      body.printing-activities [data-edit-activity], body.printing-activities [data-delete-activity],
      body.printing-activities #btn-add-activity, body.printing-activities #btn-print-activities { display: none !important; }
      input[data-bongere-input], input[data-custom-price-input] { border: none !important; padding: 0 !important; background: transparent !important; }
      table { font-size: 12px; }
      .bg-page, .bg-amber-50, .bg-amber-50\/60 { background: transparent !important; }
      .card-shadow { border: 1px solid #ccc !important; }
    }
  </style>
  <script src="../../scripts/portal/prizes.ts"></script>
  <script src="../../scripts/portal/kid-ledger.ts"></script>
</PortalLayout>
