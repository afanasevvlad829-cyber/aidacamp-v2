---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { PRIZES } from '../../lib/portalPrizes';
import { listPrizeStates, listActivities } from '../../lib/portalEconomy';
import { listCustomPrizes, countIssuancesByPrize } from '../../lib/portalPrizeOps';
import { listKids } from '../../lib/portalKid';
import EconomySettings from '../../components/portal/economy/EconomySettings.astro';
import PrizesTable from '../../components/portal/economy/PrizesTable.astro';
import GivePrizeDialog from '../../components/portal/economy/GivePrizeDialog.astro';
import CustomPrizeDialog from '../../components/portal/economy/CustomPrizeDialog.astro';
import ActivitiesTable from '../../components/portal/economy/ActivitiesTable.astro';
import ActivityDialog from '../../components/portal/economy/ActivityDialog.astro';
import SummaryTab from '../../components/portal/economy/SummaryTab.astro';

const role = Astro.locals.portalRole!;
if (!['admin', 'rukovoditel'].includes(role)) {
  return Astro.redirect('/portal/');
}

const [prizeStates, activities, customPrizes, issuanceCounts, kids] = await Promise.all([
  listPrizeStates(),
  listActivities(),
  listCustomPrizes(),
  countIssuancesByPrize(),
  listKids(false),
]);
const stateById = new Map(prizeStates.map((s) => [s.prize_id, s]));

// Объединяем hardcoded + кастомные призы в одном списке.
const ALL_PRIZES = [
  ...PRIZES,
  ...customPrizes.map((c) => ({
    id: c.slug,
    name: c.name,
    price: c.ozon_price ?? 0,
    qty: c.qty,
    category: c.category ?? 'Кастом',
    img: c.img_url ?? undefined,
    url: undefined as string | undefined,
    sources: undefined as string[] | undefined,
    isCustom: true,
    customId: c.id,
  })),
];

const totalAll = ALL_PRIZES.reduce((s, p) => s + p.price * p.qty, 0);
const fmtRub = (n: number) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';

const CAT_LABELS: Record<string, string> = {
  phone: 'Телефон',
  fun: 'Развлечения',
  food: 'Еда',
  prize: 'Физ. приз',
  privilege: 'Привилегии',
  comfort: 'Комфорт',
  service: 'Услуги',
  other: 'Прочее',
};
---
<PortalLayout title="Экономика смены — АйДаКемп">
  <div class="mb-4">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Экономика смены
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Внутренняя экономика «выкупа внимания» — игровые рубли. Ребёнок сам решает: телефон, кино, костёр или физический приз.
    </p>
  </div>

  {/* Философия — короткая шпаргалка для админа */}
  <div class="mb-4 rounded-[14px] border border-amber-200 bg-amber-50/60 p-4 text-[14px] text-navy-950">
    <div class="mb-1 flex items-center gap-2 font-semibold text-amber-800">
      <i class="bi bi-info-circle" aria-hidden="true"></i> Как устроена экономика
    </div>
    <ul class="ml-5 list-disc space-y-1">
      <li><b>Валюта</b> — игровой рубль. Якорь: 1 минута телефона = 10 ₽. Выдача — 600 ₽/день (= час телефона). Без условий.</li>
      <li><b>Цель цен:</b> изъять <b>70-80%</b> игровой валюты из оборота через призы и активности.</li>
      <li><b>Формула активности</b> = <code>группа × выдача × дней копления × доля дохода (30-50%)</code>. Для смены 35×600 — активность ≈ 20 000 ₽ за 2-3 дня скидывания.</li>
      <li><b>Индивидуальный приз</b> — 3-8 дней сбережений = 1 800–4 800 ₽.</li>
      <li><b>Повторная покупка</b> той же активности дорожает <b>×1.5</b> (вторая «Ночь с телефонами» уже не 20 000, а 30 000).</li>
      <li>Эффект из канона: <b>«На третий день телефон почти никто не покупает — жизнь выигрывает конкуренцию у экрана».</b></li>
    </ul>
  </div>

  <EconomySettings />

  {/* Tabs */}
  <div class="mb-4 flex flex-wrap gap-2 border-b border-border">
    <button data-tab="prizes" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-border bg-white px-4 py-2 text-[15px] font-medium">
      <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы
    </button>
    <button data-tab="activities" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-star-fill" aria-hidden="true"></i> Активности
    </button>
    <button data-tab="summary" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Сводка
    </button>
  </div>

  {/* ── Tab: Prizes ───────────────────────────────────────────────────────── */}
  <section data-tab-pane="prizes">
    <PrizesTable prizes={ALL_PRIZES} {stateById} {issuanceCounts} {role} {fmtRub} />
    <GivePrizeDialog {kids} />
    <CustomPrizeDialog />
  </section>

  {/* ── Tab: Activities ──────────────────────────────────────────────────── */}
  <section data-tab-pane="activities" hidden>
    <ActivitiesTable {activities} catLabels={CAT_LABELS} />
    <ActivityDialog />
  </section>

  {/* ── Tab: Summary ─────────────────────────────────────────────────────── */}
  <section data-tab-pane="summary" hidden>
    <SummaryTab {fmtRub} {totalAll} />
  </section>

  <style is:global>
    /* Печать — показываем только текущую активную вкладку (Призы или Активности) */
    @media print {
      header, nav, [data-tab], .tab-btn,
      [id^="btn-"], [data-give], [data-toggle-hidden], [data-reset-price],
      [data-archive-custom], [data-edit-activity], [data-delete-activity],
      [data-reset-custom-price], [data-save-flag], [data-act-save-flag],
      dialog, .card-shadow { box-shadow: none !important; }
      .tab-btn, dialog { display: none !important; }
      [data-tab-pane][hidden] { display: none !important; }
      body.printing-prizes [data-tab-pane="activities"],
      body.printing-prizes [data-tab-pane="summary"],
      body.printing-activities [data-tab-pane="prizes"],
      body.printing-activities [data-tab-pane="summary"] { display: none !important; }
      body.printing-prizes #btn-add-custom,
      body.printing-prizes #btn-print-prizes,
      body.printing-prizes [data-give],
      body.printing-prizes [data-toggle-hidden],
      body.printing-prizes [data-bongere-input],
      body.printing-prizes [data-archive-custom],
      body.printing-activities [data-custom-price-input],
      body.printing-activities [data-reset-custom-price],
      body.printing-activities [data-edit-activity],
      body.printing-activities [data-delete-activity],
      body.printing-activities #btn-add-activity,
      body.printing-activities #btn-print-activities { display: none !important; }
      /* В печатной версии input-ы заменяем на их значение */
      input[data-bongere-input], input[data-custom-price-input] {
        border: none !important; padding: 0 !important; background: transparent !important;
      }
      table { font-size: 12px; }
      .bg-page, .bg-amber-50, .bg-amber-50\/60 { background: transparent !important; }
      /* Скрываем шапку настроек на печати — оставляем только таблицу */
      .card-shadow { border: 1px solid #ccc !important; }
    }
    /* Универсальное центрирование модальных <dialog> и адаптив под мобилу. */
    dialog.aida-modal-center {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      max-width: min(560px, 95vw);
      max-height: 92vh;
      overflow: hidden; /* скролл будет внутри form */
    }
    dialog.aida-modal-center .aida-modal-form {
      width: 100%;
      max-height: 92vh;
      overflow-y: auto;
      padding: 20px;
      -webkit-overflow-scrolling: touch;
    }
    @media (max-width: 480px) {
      dialog.aida-modal-center {
        max-width: 100vw;
        max-height: 100vh;
        width: 100vw;
        height: auto;
        top: auto;
        bottom: 0;
        left: 0;
        transform: none;
        border-radius: 16px 16px 0 0;
      }
      dialog.aida-modal-center .aida-modal-form {
        max-height: 88vh;
      }
    }
  </style>
  <script src="../../scripts/portal/prizes.ts"></script>
</PortalLayout>
