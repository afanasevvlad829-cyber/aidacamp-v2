---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { PRIZES } from '../../lib/portalPrizes';
import { listPrizeStates, listActivities } from '../../lib/portalEconomy';
import { listCustomPrizes, countIssuancesByPrize } from '../../lib/portalPrizeOps';
import { listKids } from '../../lib/portalKid';

const role = Astro.locals.portalRole!;
if (!['admin', 'rukovoditel'].includes(role)) {
  return Astro.redirect('/portal/');
}

const [prizeStates, activities, customPrizes, issuanceCounts, kids] = await Promise.all([
  listPrizeStates(),
  listActivities(),
  listCustomPrizes(),
  countIssuancesByPrize(),
  listKids(false),
]);
const stateById = new Map(prizeStates.map((s) => [s.prize_id, s]));

// Объединяем hardcoded + кастомные призы в одном списке.
const ALL_PRIZES = [
  ...PRIZES,
  ...customPrizes.map((c) => ({
    id: c.slug,
    name: c.name,
    price: c.ozon_price ?? 0,
    qty: c.qty,
    category: c.category ?? 'Кастом',
    img: c.img_url ?? undefined,
    url: undefined as string | undefined,
    sources: undefined as string[] | undefined,
    isCustom: true,
    customId: c.id,
  })),
];

const totalAll = ALL_PRIZES.reduce((s, p) => s + p.price * p.qty, 0);
const fmtRub = (n: number) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';

const CAT_LABELS: Record<string, string> = {
  phone: 'Телефон',
  fun: 'Развлечения',
  food: 'Еда',
  prize: 'Физ. приз',
  privilege: 'Привилегии',
  comfort: 'Комфорт',
  service: 'Услуги',
  other: 'Прочее',
};
---
<PortalLayout title="Экономика смены — АйДаКемп">
  <div class="mb-4">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Экономика смены
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      Внутренняя экономика «выкупа внимания» — игровые рубли. Ребёнок сам решает: телефон, кино, костёр или физический приз.
    </p>
  </div>

  {/* Философия — короткая шпаргалка для админа */}
  <div class="mb-4 rounded-[14px] border border-amber-200 bg-amber-50/60 p-4 text-[14px] text-navy-950">
    <div class="mb-1 flex items-center gap-2 font-semibold text-amber-800">
      <i class="bi bi-info-circle" aria-hidden="true"></i> Как устроена экономика
    </div>
    <ul class="ml-5 list-disc space-y-1">
      <li><b>Валюта</b> — игровой рубль. Якорь: 1 минута телефона = 10 ₽. Выдача — 600 ₽/день (= час телефона). Без условий.</li>
      <li><b>Цель цен:</b> изъять <b>70-80%</b> игровой валюты из оборота через призы и активности.</li>
      <li><b>Формула активности</b> = <code>группа × выдача × дней копления × доля дохода (30-50%)</code>. Для смены 35×600 — активность ≈ 20 000 ₽ за 2-3 дня скидывания.</li>
      <li><b>Индивидуальный приз</b> — 3-8 дней сбережений = 1 800–4 800 ₽.</li>
      <li><b>Повторная покупка</b> той же активности дорожает <b>×1.5</b> (вторая «Ночь с телефонами» уже не 20 000, а 30 000).</li>
      <li>Эффект из канона: <b>«На третий день телефон почти никто не покупает — жизнь выигрывает конкуренцию у экрана».</b></li>
    </ul>
  </div>

  {/* Шапка-настройки — общий калькулятор */}
  <div class="mb-6 rounded-[16px] border border-border bg-white p-5 card-shadow">
    <div class="mb-3 flex items-center gap-2 text-[14px] font-semibold uppercase tracking-wide text-primary">
      <i class="bi bi-sliders" aria-hidden="true"></i>
      Параметры смены
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Детей на смене</span>
        <input id="set-kids" type="number" min="1" max="200" value="35"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Дней в смене</span>
        <input id="set-days" type="number" min="1" max="30" value="10"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">1 минута телефона, ₽ <span class="text-amber-700">(якорь)</span></span>
        <input id="set-phone-min" type="number" min="1" step="1" value="10"
               class="mt-1 w-full rounded-[10px] border border-amber-300 bg-amber-50/40 px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Цель изъятия, %</span>
        <input id="set-target-extract" type="number" min="50" max="100" step="5" value="75"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
        <span class="mt-1 block text-[12px] text-body-muted">сколько денег вытащить через призы и активности</span>
      </label>
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Наценка для физических призов, ×</span>
        <input id="set-markup" type="number" min="1" step="0.1" value="3"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
        <span class="mt-1 block text-[12px] text-body-muted">Рекомендованная цена = Ozon × наценка, за 1 шт.</span>
      </label>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Выдача в день, ₽ <span class="text-amber-700">(= час телефона)</span></span>
        <input id="set-daily" type="number" min="0" step="50" value="600"
               class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-right font-mono tabular-nums focus:border-primary focus:outline-none" />
        <span class="mt-1 block text-[12px] text-body-muted">600 ₽ — это ровно 60 минут телефона. Получают все, без условий.</span>
      </label>
      <label class="block">
        <span class="block text-[13px] font-medium text-body-muted">Округление до</span>
        <select id="set-round"
                class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 font-mono tabular-nums focus:border-primary focus:outline-none">
          <option value="10">10 ₽</option>
          <option value="50" selected>50 ₽</option>
          <option value="100">100 ₽</option>
        </select>
      </label>
    </div>

    <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Выдача / ребёнок / день</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-potential">—</span>
        </div>
        <div class="text-[12px] text-body-muted">= <span id="kpi-phone-equiv">—</span> мин</div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Дневной фонд лагеря</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-daily-fund">—</span>
        </div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">Полный фонд смены</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-total">—</span>
        </div>
      </div>
      <div class="rounded-[10px] border border-primary bg-primary-soft p-3">
        <div class="text-[13px] font-medium text-primary">Цель изъятия</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-primary">
          <span id="kpi-target-extract">—</span>
        </div>
        <div class="text-[12px] text-primary/80">через призы + активности</div>
      </div>
      <div class="rounded-[10px] border border-border bg-page p-3">
        <div class="text-[13px] text-body-muted">За всю смену с ребёнка</div>
        <div class="mt-0.5 font-mono tabular-nums text-[18px] font-semibold text-navy-950">
          <span id="kpi-per-kid">—</span>
        </div>
      </div>
    </div>
  </div>

  {/* Tabs */}
  <div class="mb-4 flex flex-wrap gap-2 border-b border-border">
    <button data-tab="prizes" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-border bg-white px-4 py-2 text-[15px] font-medium">
      <i class="bi bi-gift-fill" aria-hidden="true"></i> Призы
    </button>
    <button data-tab="activities" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-star-fill" aria-hidden="true"></i> Активности
    </button>
    <button data-tab="summary" class="tab-btn -mb-px rounded-t-[10px] border border-b-0 border-transparent bg-page px-4 py-2 text-[15px] font-medium text-body-muted">
      <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Сводка
    </button>
  </div>

  {/* ── Tab: Prizes ───────────────────────────────────────────────────────── */}
  <section data-tab-pane="prizes">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div class="text-[14px] text-body-muted">
        Активных: <b id="cnt-active">—</b> · Сумма в игровых ₽: <b id="sum-bongere">—</b>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="btn-apply-markup" type="button"
          class="rounded-[10px] border border-primary bg-primary text-white px-3 py-1.5 text-[14px] hover:opacity-90">
          <i class="bi bi-magic" aria-hidden="true"></i>
          Применить наценку ко всем
        </button>
        <button id="btn-import-local" type="button"
          class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] text-navy-950 hover:border-primary hover:text-primary"
          title="Берёт удалённые позиции и цены из localStorage этого браузера и сохраняет на сервер">
          <i class="bi bi-cloud-upload" aria-hidden="true"></i>
          Загрузить локальные правки на сервер
        </button>
        <button id="btn-show-hidden" type="button"
          class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] text-navy-950 hover:border-primary hover:text-primary">
          <i class="bi bi-eye" aria-hidden="true"></i>
          Показать скрытые
        </button>
      </div>
    </div>

    <div class="mb-6">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 class="flex items-center gap-2 text-[16px] font-semibold text-navy-950">
          <i class="bi bi-receipt text-primary" aria-hidden="true"></i>
          Каталог призов
          <span class="text-[13px] font-normal text-body-muted">· {ALL_PRIZES.length} позиций · {ALL_PRIZES.reduce((s, p) => s + p.qty, 0)} шт · {fmtRub(totalAll)}</span>
        </h2>
        <div class="flex gap-2">
          <button id="btn-print-prizes" type="button"
            class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] hover:border-primary hover:text-primary">
            <i class="bi bi-printer" aria-hidden="true"></i>
            Распечатать призы
          </button>
          <button id="btn-add-custom" type="button"
            class="rounded-[10px] border border-primary bg-primary text-white px-3 py-1.5 text-[14px] hover:opacity-90">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Добавить свой приз
          </button>
        </div>
      </div>

      <div class="overflow-x-auto rounded-[14px] border border-border bg-white card-shadow">
          <table class="w-full text-[14px]">
            <thead class="bg-page text-left text-[12px] uppercase tracking-wide text-body-muted">
              <tr>
                <th class="w-[60px] p-2"></th>
                <th class="p-2">Наименование</th>
                <th class="w-[80px] p-2 text-right">Цена&nbsp;Ozon</th>
                <th class="w-[70px] p-2 text-right" title="Остаток / закуплено">Кол-во</th>
                <th class="w-[90px] p-2 text-right">Сумма</th>
                <th class="w-[100px] p-2 text-right">Рекоменд.</th>
                <th class="w-[150px] p-2 text-right">Цена,&nbsp;игр.&nbsp;₽<div class="text-[10px] font-normal text-body-muted">(заданная или рекоменд.)</div></th>
                <th class="w-[80px] p-2 text-right" title="Сколько дней ребёнку нужно копить, если откажется от телефона">Копить</th>
                <th class="w-[80px] p-2 text-center" title="Сколько раз приз уже выдан">Выдано</th>
                <th class="w-[90px] p-2"></th>
              </tr>
            </thead>
            <tbody>
              {ALL_PRIZES.map((p) => {
                const st = stateById.get(p.id);
                return (
                  <tr data-prize-row data-id={p.id} data-price={p.price} data-qty={p.qty}
                      data-remaining={st?.remaining_qty ?? p.qty}
                      data-default-img={p.img ?? ''}
                      data-hidden={st?.hidden ? '1' : '0'}
                      data-bongere={st?.bongere_price ?? ''}
                      class="border-t border-border align-middle">
                    <td class="p-2">
                      <div class="flex h-[48px] w-[48px] items-center justify-center overflow-hidden rounded-[6px] border border-border bg-white">
                        {(st?.custom_photo || p.img) ? (
                          <img src={st?.custom_photo || p.img} alt="" loading="lazy" referrerpolicy="no-referrer"
                               style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                        ) : (
                          <i class="bi bi-image text-body-muted" aria-hidden="true"></i>
                        )}
                      </div>
                    </td>
                    <td class="p-2">
                      <div class="font-medium text-navy-950">{p.name}</div>
                      <div class="mt-0.5 flex flex-wrap items-center gap-2 text-[12px] text-body-muted">
                        {p.category && <span class="rounded-full bg-primary-soft px-2 py-0.5 text-primary">{p.category}</span>}
                        {p.url ? (
                          <a href={p.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Карточка Ozon
                          </a>
                        ) : (
                          <a href={`https://www.ozon.ru/search/?text=${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                            <i class="bi bi-search" aria-hidden="true"></i> Найти на Ozon
                          </a>
                        )}
                      </div>
                    </td>
                    <td class="p-2 text-right font-mono tabular-nums">{fmtRub(p.price)}</td>
                    <td class="p-2 text-right font-mono tabular-nums" data-qty-cell>
                      <span data-remaining-text class={(st?.remaining_qty ?? p.qty) === 0 ? 'text-red-600 font-bold' : ''}>{st?.remaining_qty ?? p.qty}</span>
                      <span class="text-body-muted">/{p.qty}</span>
                    </td>
                    <td class="p-2 text-right font-mono tabular-nums font-semibold">{fmtRub(p.price * p.qty)}</td>
                    <td class="p-2 text-right font-mono tabular-nums text-primary" data-recommended></td>
                    <td class="p-2 text-right">
                      <div class="flex items-center justify-end gap-1">
                        <input type="number" min="0" step="50" data-bongere-input
                               class="w-[80px] rounded-[8px] border border-border bg-white px-2 py-1 text-right font-mono tabular-nums focus:border-primary focus:outline-none"
                               placeholder="—" value={st?.bongere_price ?? ''} />
                        <span class="text-body-muted">₽</span>
                        <span data-save-flag class="inline-flex h-5 w-5 items-center justify-center text-emerald-600 opacity-0 transition-opacity" title="Сохранено">
                          <i class="bi bi-check-circle-fill text-[14px]" aria-hidden="true"></i>
                        </span>
                        <button type="button" data-reset-price
                                class="ml-0.5 inline-flex h-6 w-6 items-center justify-center rounded-[6px] text-body-muted hover:bg-primary-soft hover:text-primary"
                                title="Сбросить к рекомендованной">
                          <i class="bi bi-arrow-counterclockwise text-[12px]" aria-hidden="true"></i>
                        </button>
                      </div>
                    </td>
                    <td class="p-2 text-right font-mono tabular-nums font-semibold text-navy-950" data-sum-game></td>
                    <td class="p-2 text-right font-mono tabular-nums" data-save-days></td>
                    <td class="p-2 text-center">
                      {issuanceCounts[p.id] > 0 ? (
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[12px] font-semibold text-emerald-800">
                          <i class="bi bi-check-circle-fill" aria-hidden="true"></i>{issuanceCounts[p.id]}
                        </span>
                      ) : (
                        <span class="text-[12px] text-body-muted">—</span>
                      )}
                    </td>
                    <td class="p-2 text-right">
                      {(st?.remaining_qty ?? p.qty) > 0 ? (
                        <button type="button" data-give
                                data-prize-id={p.id}
                                data-prize-name={p.name}
                                class="mr-1 inline-flex items-center gap-1 rounded-[8px] border border-primary bg-primary text-white px-2 py-1 text-[12px] hover:opacity-90"
                                title="Выдать ребёнку">
                          <i class="bi bi-gift-fill" aria-hidden="true"></i> выдать
                        </button>
                      ) : (
                        <span class="mr-1 inline-flex items-center gap-1 rounded-[8px] border border-border bg-page px-2 py-1 text-[12px] text-body-muted"
                              title="Призов больше нет на складе">
                          <i class="bi bi-x-circle" aria-hidden="true"></i> закончились
                        </span>
                      )}
                      {(p as any).isCustom && (
                        <button type="button" data-archive-custom data-custom-id={(p as any).customId}
                                class="inline-flex h-7 w-7 items-center justify-center rounded-[8px] text-body-muted hover:bg-red-50 hover:text-red-600"
                                title="Удалить кастомный приз">
                          <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                      )}
                      <button type="button" data-toggle-hidden
                              class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] text-body-muted transition hover:bg-red-50 hover:text-red-600"
                              title={st?.hidden ? 'Показать (вернуть в список)' : 'Скрыть'}>
                        <i class={`bi ${st?.hidden ? 'bi-eye-slash' : 'bi-x-lg'}`} aria-hidden="true"></i>
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    {/* ── Modal: Выдать приз ребёнку ─────────────────────────────────── */}
    <dialog id="give-dialog"
            class="aida-modal-center rounded-[16px] border border-border p-0 backdrop:bg-black/50">
      <form method="dialog" enctype="multipart/form-data" class="aida-modal-form">
        <h3 class="text-[18px] font-semibold text-navy-950">
          Выдать приз: <span id="give-prize-name" class="text-primary"></span>
        </h3>
        <input type="hidden" id="give-prize-id" />
        <input type="hidden" id="give-prize-name-hidden" />

        {/* Памятка с вопросами для видео — для вожатого/руководителя */}
        <div class="mt-3 rounded-[10px] border border-amber-300 bg-amber-50 p-3 text-[13px]">
          <div class="mb-1 flex items-center gap-1.5 font-semibold text-amber-900">
            <i class="bi bi-camera-video-fill" aria-hidden="true"></i> Спроси на видео:
          </div>
          <ol class="ml-5 list-decimal space-y-0.5 text-amber-900">
            <li>Почему ты копил именно на этот приз?</li>
            <li>Что для тебя значит этот приз?</li>
            <li>Как будешь использовать / с кем поделишься?</li>
            <li>Сколько дней копил, от чего отказался?</li>
            <li>Что посоветуешь другим ребятам?</li>
          </ol>
        </div>

        <div class="mt-4 space-y-3">
          <label class="block">
            <span class="block text-[13px] font-medium text-body-muted">Кому выдаём</span>
            <select id="give-kid" required
                    class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none">
              <option value="">— выбери ребёнка —</option>
              {kids.map((k) => (
                <option value={k.id} data-name={k.name}>{k.name}{k.room_number ? ` · к.${k.room_number}` : ''}{k.age ? ` · ${k.age} лет` : ''}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="block text-[13px] font-medium text-body-muted">Цена в игровых ₽ (сколько отдал ребёнок)</span>
            <input id="give-price" type="number" min="0" step="50"
