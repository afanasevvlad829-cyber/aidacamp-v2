---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';

// Гайд для персонала. Ученикам не показываем.
const role = Astro.locals.portalRole!;
if (role === 'student') return Astro.redirect('/portal/');
---
<PortalLayout title="Как снять круто на телефон — Портал АйДаКемп">
  <!-- Bootstrap Icons с CDN: на этой странице используются иконки вне локального манифеста icons.css -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <style>
    .sg-root{--bg:#f1f5f9;--surface:#fff;--surface2:#f8fafc;--border:#e2e8f0;--border2:#cbd5e1;
      --orange:#f97316;--orange-d:#ea580c;--orange-bg:rgba(236,124,0,.08);--orange-border:rgba(236,124,0,.3);
      --text:#0f172a;--text2:#334155;--text3:#64748b;
      --green:#16a34a;--green-bg:rgba(22,163,74,.10);--red:#dc2626;--red-bg:rgba(220,38,38,.08);
      --blue:#2563eb;--blue-bg:rgba(37,99,235,.08);--purple:#9333ea;--radius:14px;
      max-width:760px;margin:0 auto;color:var(--text);font-size:16px;line-height:1.6;
      -webkit-font-smoothing:antialiased}
    .sg-root *{box-sizing:border-box}
    .sg-root b{font-weight:700}

    .sg-root .hero{background:linear-gradient(135deg,#fff7ed 0%,#fdf2f8 100%);border:1px solid var(--orange-border);border-radius:20px;padding:24px 22px;margin-bottom:22px}
    .sg-root .hero h1{font-size:26px;font-weight:800;line-height:1.2;margin:0 0 10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .sg-root .hero h1 i{color:var(--orange)}
    .sg-root .hero p{font-size:15px;color:var(--text2);line-height:1.6;margin:0}
    .sg-root .hero p + p{margin-top:10px}
    .sg-root .hero .pin{display:inline-flex;align-items:center;gap:7px;margin-top:14px;background:var(--surface);border:1px solid var(--orange-border);border-radius:30px;padding:7px 14px;font-size:13px;font-weight:600;color:var(--orange-d)}

    .sg-root .sec-title{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text3);margin:30px 0 12px}
    .sg-root .sec-title i{font-size:16px;color:var(--orange)}

    .sg-root .scenes{display:grid;grid-template-columns:1fr;gap:12px}
    .sg-root .scene{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);overflow:hidden}
    .sg-root .scene-head{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--surface2);border-bottom:1px solid var(--border)}
    .sg-root .scene-ic{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;flex-shrink:0}
    .sg-root .scene-ic.blue{background:var(--blue)}.sg-root .scene-ic.green{background:var(--green)}.sg-root .scene-ic.purple{background:var(--purple)}.sg-root .scene-ic.orange{background:var(--orange)}
    .sg-root .scene-name{font-size:16px;font-weight:700;color:var(--text)}
    .sg-root .scene-tag{font-size:12px;color:var(--text3);margin-top:1px}
    .sg-root .scene-body{padding:6px 16px 14px}
    .sg-root .scene-body ol{margin:8px 0 0;padding-left:20px}
    .sg-root .scene-body li{font-size:14.5px;color:var(--text2);line-height:1.55;margin-bottom:7px}
    .sg-root .scene-body li b{color:var(--text)}

    .sg-root .rules{display:flex;flex-direction:column;gap:8px}
    .sg-root .rule{display:flex;gap:13px;align-items:flex-start;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:13px 15px}
    .sg-root .rule-n{flex-shrink:0;width:28px;height:28px;border-radius:8px;background:var(--orange-bg);color:var(--orange-d);font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
    .sg-root .rule-t{font-size:15px;color:var(--text2);line-height:1.55}
    .sg-root .rule-t b{color:var(--text)}

    .sg-root details.blk{background:var(--surface);border:1.5px solid var(--border);border-radius:12px;margin-bottom:10px;overflow:hidden}
    .sg-root details.blk[open]{border-color:var(--orange-border)}
    .sg-root details.blk > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:11px;padding:14px 16px;font-size:15.5px;font-weight:700;color:var(--text);user-select:none}
    .sg-root details.blk > summary::-webkit-details-marker{display:none}
    .sg-root details.blk > summary i.lead{font-size:19px;color:var(--orange);width:24px;text-align:center;flex-shrink:0}
    .sg-root details.blk > summary .chev{margin-left:auto;color:var(--text3);transition:transform .2s}
    .sg-root details.blk[open] > summary .chev{transform:rotate(180deg)}
    .sg-root .blk-body{padding:2px 16px 16px}
    .sg-root .blk-body ul{list-style:none;display:flex;flex-direction:column;gap:9px;margin:0;padding:0}
    .sg-root .blk-body li{display:flex;gap:10px;font-size:14.5px;color:var(--text2);line-height:1.55}
    .sg-root .blk-body li i{color:var(--green);font-size:15px;margin-top:3px;flex-shrink:0}
    .sg-root .blk-body li b{color:var(--text)}
    .sg-root .blk-body li.warn i{color:var(--red)}

    .sg-root .qbox{background:var(--blue-bg);border:1.5px solid rgba(37,99,235,.25);border-radius:var(--radius);padding:18px 18px 8px}
    .sg-root .qbox p.intro{font-size:14px;color:var(--text2);margin:0 0 14px;line-height:1.55}
    .sg-root .q{display:flex;gap:11px;align-items:flex-start;margin-bottom:11px}
    .sg-root .q i{color:var(--blue);font-size:16px;margin-top:2px;flex-shrink:0}
    .sg-root .q span{font-size:15px;color:var(--text);line-height:1.5}
    .sg-root .qbox .tip{font-size:13px;color:var(--text3);border-top:1px dashed rgba(37,99,235,.3);padding-top:12px;margin-top:4px;line-height:1.55}

    .sg-root .chk{display:flex;flex-direction:column;gap:7px}
    .sg-root .chk label{display:flex;gap:11px;align-items:flex-start;background:var(--surface);border:1.5px solid var(--border);border-radius:11px;padding:12px 14px;cursor:pointer;transition:all .15s}
    .sg-root .chk label:hover{border-color:var(--orange)}
    .sg-root .chk input{margin-top:2px;width:18px;height:18px;accent-color:var(--orange);flex-shrink:0;cursor:pointer}
    .sg-root .chk span{font-size:15px;color:var(--text);line-height:1.5}
    .sg-root .chk input:checked + span{text-decoration:line-through;color:var(--text3)}

    .sg-root .miss{display:flex;flex-direction:column;gap:7px}
    .sg-root .miss .m{display:flex;gap:11px;align-items:flex-start;background:var(--red-bg);border:1px solid rgba(220,38,38,.2);border-radius:11px;padding:12px 14px}
    .sg-root .miss .m i{color:var(--red);font-size:16px;margin-top:2px;flex-shrink:0}
    .sg-root .miss .m span{font-size:14.5px;color:var(--text2);line-height:1.55}
    .sg-root .miss .m span b{color:var(--text)}

    .sg-root .footer-note{margin-top:32px;padding:16px;background:var(--surface);border:1px dashed var(--border2);border-radius:12px;font-size:13.5px;color:var(--text3);line-height:1.6;text-align:center}
    .sg-root .footer-note b{color:var(--text2)}

    .sg-root .ex-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .sg-root .ex{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:14px;display:flex;flex-direction:column;gap:10px}
    .sg-root .ex-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .sg-root .ex-frame{position:relative;border-radius:9px;overflow:hidden;border:2px solid var(--border)}
    .sg-root .ex-frame svg{display:block;width:100%;height:auto}
    .sg-root .ex-frame.good{border-color:var(--green)}
    .sg-root .ex-frame.bad{border-color:var(--red)}
    .sg-root .ex-badge{position:absolute;top:6px;left:6px;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px}
    .sg-root .ex-badge.good{background:var(--green)}.sg-root .ex-badge.bad{background:var(--red)}
    .sg-root .ex-cap{font-size:14px;color:var(--text2);line-height:1.5}
    .sg-root .ex-cap b{color:var(--text)}
    .sg-root .plans{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:14px}
    .sg-root .plan{display:flex;flex-direction:column;gap:6px;text-align:center}
    .sg-root .plan .ex-frame{border-color:var(--orange-border)}
    .sg-root .plan-name{font-size:12.5px;font-weight:700;color:var(--text)}
    .sg-root .plan-sub{font-size:11px;color:var(--text3);line-height:1.35}

    /* ── ANIMATED DEMOS (приёмы в движении) ── */
    .sg-root .demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .sg-root .demo{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);padding:12px;display:flex;flex-direction:column;gap:9px}
    .sg-root .demo-stage{position:relative;border-radius:10px;overflow:hidden;background:#0f172a;aspect-ratio:16/10;display:flex;align-items:center;justify-content:center}
    .sg-root .demo-tag{display:inline-flex;align-items:center;gap:6px;align-self:flex-start;background:var(--orange-bg);color:var(--orange-d);border:1px solid var(--orange-border);border-radius:20px;padding:3px 10px;font-size:11.5px;font-weight:700}
    .sg-root .demo-cap{font-size:13.5px;color:var(--text2);line-height:1.5}
    .sg-root .demo-cap b{color:var(--text)}

    /* A — переверни телефон */
    .sg-root .d-phone{width:46px;height:84px;border-radius:11px;background:#1e293b;border:2.5px solid #64748b;position:relative;animation:dflip 4s ease-in-out infinite}
    .sg-root .d-phone::before{content:'';position:absolute;top:7px;left:50%;transform:translateX(-50%);width:16px;height:3px;border-radius:2px;background:#475569}
    .sg-root .d-phone::after{content:'';position:absolute;inset:9px 5px 14px;border-radius:3px;background:linear-gradient(135deg,#f97316,#fdba74)}
    @keyframes dflip{0%,30%{transform:rotate(0deg)}55%,80%{transform:rotate(-90deg)}100%{transform:rotate(0deg)}}

    /* B — тап → фокус (AE/AF Lock) */
    .sg-root .d-focus{position:relative;width:100%;height:100%}
    .sg-root .d-focus svg{position:absolute;inset:0;width:100%;height:100%}
    .sg-root .d-finger{position:absolute;left:52%;top:46%;width:18px;height:18px;border-radius:50%;background:rgba(255,255,255,.85);box-shadow:0 0 0 0 rgba(255,255,255,.5);animation:dtap 3.2s ease-in-out infinite}
    @keyframes dtap{0%,18%{transform:scale(.5);opacity:0}24%{transform:scale(1);opacity:1;box-shadow:0 0 0 10px rgba(255,255,255,0)}30%{opacity:1}40%,100%{opacity:0}}
    .sg-root .d-sq{position:absolute;left:38%;top:30%;width:24%;height:40%;border:2px solid #fbbf24;border-radius:4px;opacity:0;animation:dsq 3.2s ease-in-out infinite}
    @keyframes dsq{0%,22%{opacity:0;transform:scale(1.6)}32%{opacity:1;transform:scale(1.15)}45%{opacity:1;transform:scale(1)}90%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1)}}
    .sg-root .d-lock{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);background:#fbbf24;color:#1e293b;font-size:9px;font-weight:800;letter-spacing:.04em;padding:2px 7px;border-radius:4px;opacity:0;animation:dlock 3.2s ease-in-out infinite}
    @keyframes dlock{0%,45%{opacity:0}55%,90%{opacity:1}100%{opacity:0}}

    /* C — не зумь, подойди */
    .sg-root .d-zoom{width:100%;height:100%;position:relative}
    .sg-root .d-zoom svg{width:100%;height:100%;display:block;transform-origin:50% 45%;animation:dzoom 4s ease-in-out infinite}
    @keyframes dzoom{0%,20%{transform:scale(1);filter:none}55%,75%{transform:scale(2.4);filter:blur(2.2px) contrast(.85)}100%{transform:scale(1);filter:none}}
    .sg-root .d-zlabel{position:absolute;left:8px;top:7px;font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:4px;white-space:nowrap;background:var(--red);color:#fff}

    /* D — держи ровно (тряска vs опора) */
    .sg-root .d-steady{display:grid;grid-template-columns:1fr 1fr;gap:6px;width:100%;height:100%;padding:8px}
    .sg-root .d-cell{border-radius:7px;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
    .sg-root .d-cell.bad{background:#3f1d1d}.sg-root .d-cell.good{background:#14321f}
    .sg-root .d-cell svg{width:62%;height:auto}
    .sg-root .d-cell.bad svg{animation:dshake .35s linear infinite}
    @keyframes dshake{0%{transform:translate(0,0) rotate(0)}25%{transform:translate(-2px,1.5px) rotate(-1.5deg)}50%{transform:translate(2px,-1.5px) rotate(1.5deg)}75%{transform:translate(-1.5px,-1px) rotate(-1deg)}100%{transform:translate(0,0) rotate(0)}}
    .sg-root .d-mark{position:absolute;top:4px;left:4px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;color:#fff}
    .sg-root .d-mark.bad{background:var(--red)}.sg-root .d-mark.good{background:var(--green)}

    @media (prefers-reduced-motion: reduce){
      .sg-root .d-phone,.sg-root .d-finger,.sg-root .d-sq,.sg-root .d-lock,.sg-root .d-zoom svg,.sg-root .d-cell.bad svg{animation:none!important}
      .sg-root .d-phone{transform:rotate(-90deg)}
      .sg-root .d-sq,.sg-root .d-lock{opacity:1}
    }

    @media (max-width:600px){
      .sg-root .hero h1{font-size:22px}
      .sg-root .ex-grid{grid-template-columns:1fr}
      .sg-root .plans{grid-template-columns:1fr 1fr}
    }
  </style>

  <div class="sg-root">

    <!-- HERO -->
    <div class="hero">
      <h1><i class="bi bi-camera-reels-fill"></i> Как снять круто на телефон</h1>
      <p>Памятка для вожатых и преподавателей. Снимать умеет каждый — нужны не дорогая техника и не оператор, а пара простых привычек. Всё работает и на iPhone, и на Android.</p>
      <p><b>Снимаем не «для отчёта», а так, чтобы мама захотела переслать этот ролик подружкам.</b> Тёплый кадр, живая эмоция, улыбка — вот цель. Не идеальная картинка, а живая.</p>
      <p style="font-size:14px;color:var(--text3)"><i class="bi bi-emoji-smile" aria-hidden="true"></i> Стесняетесь снимать? Это нормально. Начните с деталей — руки на клавиатуре, экран с проектом, мяч в полёте. Лиц можно вообще не снимать, а ролик уже живой.</p>
      <span class="pin"><i class="bi bi-stopwatch"></i> 5 минут на чтение · сохраните в закладки телефона</span>
    </div>

    <!-- ПРИЁМЫ В ДВИЖЕНИИ -->
    <div class="sec-title"><i class="bi bi-play-circle"></i> Приёмы в движении — 4 главных жеста</div>
    <div class="demo-grid">

      <!-- A — переверни телефон -->
      <div class="demo">
        <div class="demo-stage" aria-label="Анимация: телефон поворачивается из вертикального в горизонтальный">
          <div class="d-phone"></div>
        </div>
        <span class="demo-tag"><i class="bi bi-phone-flip"></i> Жест 1</span>
        <div class="demo-cap"><b>Переверни телефон горизонтально.</b> Для роликов на сайт и большой экран снимай «лёжа». Вертикально — только для Stories/Reels.</div>
      </div>

      <!-- B — тап → фокус -->
      <div class="demo">
        <div class="demo-stage" aria-label="Анимация: палец тапает по лицу, появляется рамка фокуса и блокировка AE/AF">
          <div class="d-focus">
            <svg viewBox="0 0 160 100" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
              <rect width="160" height="100" fill="#1e293b"/>
              <circle cx="80" cy="46" r="20" fill="#fcd9b6"/>
              <circle cx="74" cy="42" r="2.4" fill="#0f172a"/><circle cx="86" cy="42" r="2.4" fill="#0f172a"/>
              <path d="M74 54 Q80 59 86 54" stroke="#0f172a" stroke-width="2" fill="none" stroke-linecap="round"/>
              <rect x="64" y="66" width="32" height="34" rx="7" fill="#f97316"/>
            </svg>
            <div class="d-sq"></div>
            <div class="d-finger"></div>
            <div class="d-lock">AE/AF LOCK</div>
          </div>
        </div>
        <span class="demo-tag"><i class="bi bi-hand-index-thumb"></i> Жест 2</span>
        <div class="demo-cap"><b>Тапни пальцем по лицу — зажми.</b> Появится «AE/AF Lock»: фокус и яркость зафиксированы, камера перестаёт «дышать» и перенаводиться.</div>
      </div>

      <!-- C — не зумь -->
      <div class="demo">
        <div class="demo-stage" aria-label="Анимация: цифровой зум превращает картинку в размытую кашу">
          <div class="d-zoom">
            <span class="d-zlabel">цифровой зум = каша</span>
            <svg viewBox="0 0 160 100" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
              <rect width="160" height="100" fill="#1e293b"/>
              <circle cx="80" cy="45" r="18" fill="#fcd9b6"/>
              <circle cx="74" cy="41" r="2.2" fill="#0f172a"/><circle cx="86" cy="41" r="2.2" fill="#0f172a"/>
              <path d="M74 52 Q80 57 86 52" stroke="#0f172a" stroke-width="2" fill="none" stroke-linecap="round"/>
              <rect x="64" y="64" width="32" height="36" rx="7" fill="#38bdf8"/>
            </svg>
          </div>
        </div>
        <span class="demo-tag"><i class="bi bi-zoom-in"></i> Жест 3</span>
        <div class="demo-cap"><b>Не зумь — подойди ногами.</b> Цифровой зум растягивает пиксели в кашу. Ноги — лучший зум: подошёл ближе → картинка осталась резкой.</div>
      </div>

      <!-- D — держи ровно -->
      <div class="demo">
        <div class="demo-stage" aria-label="Анимация: трясущийся кадр против устойчивого">
          <div class="d-steady">
            <div class="d-cell bad">
              <div class="d-mark bad"><i class="bi bi-x"></i></div>
              <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                <circle cx="30" cy="24" r="11" fill="#fcd9b6"/><rect x="20" y="34" width="20" height="24" rx="5" fill="#f87171"/>
              </svg>
            </div>
            <div class="d-cell good">
              <div class="d-mark good"><i class="bi bi-check-lg"></i></div>
              <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                <circle cx="30" cy="24" r="11" fill="#fcd9b6"/><rect x="20" y="34" width="20" height="24" rx="5" fill="#4ade80"/>
              </svg>
            </div>
          </div>
        </div>
        <span class="demo-tag"><i class="bi bi-grip-vertical"></i> Жест 4</span>
        <div class="demo-cap"><b>Держи двумя руками с опорой.</b> Локти к корпусу, плечо к стене — тряска (слева) уходит, кадр становится устойчивым (справа).</div>
      </div>

    </div>

    <!-- БЫСТРЫЕ РЕЦЕПТЫ ПО СЦЕНАМ -->
    <div class="sec-title"><i class="bi bi-magic"></i> Быстрые рецепты по сценам</div>
    <div class="scenes">

      <div class="scene">
        <div class="scene-head">
          <div class="scene-ic blue"><i class="bi bi-laptop"></i></div>
          <div><div class="scene-name">Работа за компьютером</div><div class="scene-tag">Занятие · программирование · проект</div></div>
        </div>
        <div class="scene-body">
          <ol>
            <li><b>Свет на лицо, не в спину.</b> Посадите так, чтобы окно было перед ребёнком или сбоку, а не за ним — иначе получите тёмный силуэт.</li>
            <li><b>Снимайте процесс, не постановку.</b> Не просите «посмотри в камеру» — пусть печатает, собирает, спорит с соседом. Живое рождается в деле.</li>
            <li><b>Чередуйте 3 плана:</b> экран с кодом крупно → руки на клавиатуре → лицо с азартом → общий план группы.</li>
            <li><b>Снимите экран с результатом</b> — что у него получилось. Это понятно маме и доказывает: тут учат.</li>
            <li><b>Присядьте до уровня глаз</b> — кадр сверху «из-за спины взрослого» всегда холоднее.</li>
          </ol>
        </div>
      </div>

      <div class="scene">
        <div class="scene-head">
          <div class="scene-ic green"><i class="bi bi-trophy-fill"></i></div>
          <div><div class="scene-name">Спортивная игра</div><div class="scene-tag">Бассейн · турнир · подвижные игры</div></div>
        </div>
        <div class="scene-body">
          <ol>
            <li><b>Включите «слоумо»</b> (Slow-mo, 120/240 кадров) — прыжок, брызги, гол сразу выглядят эффектно. Только при хорошем свете.</li>
            <li><b>Начинайте запись ДО момента.</b> Жмёте «запись» когда мяч ещё не полетел — иначе вечно опаздываете.</li>
            <li><b>Снимайте длинным дублем</b> 15–30 секунд и потом вырежете лучший кусок. Не пытайтесь «поймать» одним коротким нажатием.</li>
            <li><b>Ведите камеру плавно</b> за игроком, держа его в одной части кадра. Поворачивайтесь корпусом, а не руками.</li>
            <li><b>Ловите эмоцию ПОСЛЕ.</b> Радость победителя, объятия команды — это ценнее самого момента игры.</li>
          </ol>
        </div>
      </div>

      <div class="scene">
        <div class="scene-head">
          <div class="scene-ic purple"><i class="bi bi-fire"></i></div>
          <div><div class="scene-name">Вечерняя свечка / огонёк</div><div class="scene-tag">Тёмное помещение · тёплая атмосфера</div></div>
        </div>
        <div class="scene-body">
          <ol>
            <li><b>Добавьте хоть немного света.</b> Гирлянда, телефон-фонарик у соседа, лампа сбоку — иначе будет шум и «каша». Чистой темноты камера не любит.</li>
            <li><b>Снимайте с опоры.</b> Прислоните локти к колену, поставьте телефон на стол/книгу. В темноте любое дрожание = смаз.</li>
            <li><b>Наведитесь на освещённое лицо, не на пламя.</b> Тапните пальцем по лицу — иначе люди уйдут в черноту, а свеча будет пересвечена.</li>
            <li><b>Снимайте детали и атмосферу:</b> огонёк, кружки в руках, лица в полумраке, общий круг. Из этого собирается самое душевное видео смены.</li>
            <li><b>Не лезьте в лица.</b> Снимайте со стороны, общим планом — момент личный, камера не должна его ломать.</li>
          </ol>
        </div>
      </div>

      <div class="scene">
        <div class="scene-head">
          <div class="scene-ic orange"><i class="bi bi-palette-fill"></i></div>
          <div><div class="scene-name">Мастер-класс / творчество</div><div class="scene-tag">Руки · процесс · результат</div></div>
        </div>
        <div class="scene-body">
          <ol>
            <li><b>Снимайте руки крупно</b> — как мастерят, паяют, рисуют, собирают. Руки в работе всегда смотрятся живо.</li>
            <li><b>История «было → стало».</b> Снимите заготовку в начале и готовую работу в конце — получится мини-сюжет.</li>
            <li><b>Поймайте момент «получилось!»</b> — глаза загораются, когда заработало. Это и есть главный кадр.</li>
            <li><b>Деталь крупным планом</b> — фактура, инструмент, готовое изделие в руках автора.</li>
          </ol>
        </div>
      </div>

    </div>

