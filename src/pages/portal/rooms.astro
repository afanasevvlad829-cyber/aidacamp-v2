---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { ROOMS } from '../../lib/portalRooms';
import { getActiveShift, getLatestShift } from '../../lib/portalShift';
import { listInventoryByShift } from '../../lib/portalRoomInventory';
import { listAssignments } from '../../lib/portalRasselenie';
import RoomsTabs from '../../components/portal/rooms/RoomsTabs.astro';
import InventoryStats from '../../components/portal/rooms/InventoryStats.astro';
import InventoryFloorPlan from '../../components/portal/rooms/InventoryFloorPlan.astro';
import InventoryModal from '../../components/portal/rooms/InventoryModal.astro';
import RasseleniePlan from '../../components/portal/rooms/RasseleniePlan.astro';
import RasselenieList from '../../components/portal/rooms/RasselenieList.astro';
import RasseleniKidPool from '../../components/portal/rooms/RasseleniKidPool.astro';
import AddKidModal from '../../components/portal/rooms/AddKidModal.astro';

// id события «Приёмка номеров» (день -1) — к нему привязываем видео обхода через photo API.
let roomCheckEventId = 0;
async function lookupRoomCheckEventId(): Promise<number> {
  if (!process.env.AIDAPLUS_PG_DSN && !process.env.PG_DSN) return 0;
  const { default: pg } = await import('pg');
  const client = new pg.Client({ connectionString: process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN });
  await client.connect();
  try {
    const r = await client.query("SELECT id FROM shift_event WHERE external_id='ev-dm1-room-check' LIMIT 1");
    return (r.rows[0]?.id as number) ?? 0;
  } finally { await client.end(); }
}

const role = Astro.locals.portalRole;
const tab = (Astro.url.searchParams.get('tab') || 'rasselenie') as 'inventory' | 'rasselenie';
if (!role || role === 'student') return Astro.redirect('/portal/');

const shift = await getActiveShift() ?? await getLatestShift();
// inventory, assignments и roomCheckEventId не зависят друг от друга — параллельно
const [inventory, assignments, roomCheckEventId_] = await Promise.all([
  shift ? listInventoryByShift(shift.id) : Promise.resolve([] as Awaited<ReturnType<typeof listInventoryByShift>>),
  shift && tab === 'rasselenie' ? listAssignments(shift.id) : Promise.resolve([] as Awaited<ReturnType<typeof listAssignments>>),
  shift ? lookupRoomCheckEventId().catch(() => 0) : Promise.resolve(0),
]);
roomCheckEventId = roomCheckEventId_;
const assignedByBed = new Map<string, typeof assignments[number]>();
const unassignedKids: typeof assignments = [];
for (const a of assignments) {
  if (a.room_number != null && a.bed_index != null) {
    assignedByBed.set(`${a.room_number}:${a.bed_index}`, a);
  } else {
    unassignedKids.push(a);
  }
}
const statusByRoom = new Map<number, string>();
for (const r of inventory) statusByRoom.set(r.room_number, r.status);

const counts = {
  pending: ROOMS.filter((r) => r.type !== 'staff' && (statusByRoom.get(r.number) ?? 'pending') === 'pending').length,
  ok:      inventory.filter((r) => r.status === 'ok').length,
  defects: inventory.filter((r) => r.status === 'defects').length,
};
---
<PortalLayout title="Комнаты — АйДаКемп">
  {/* Передаём shiftId в JS через meta-тег */}
  <meta name="rooms-shift-id" content={String(shift?.id ?? 0)} />

  <div class="mb-6">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Комнаты · 3 корпус
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      20 жилых комнат на 46 мест (+ 1 нежилая — горничная №22). Расселение детей и инвентаризация.
    </p>
  </div>

  <RoomsTabs tab={tab} />

  {tab === 'rasselenie' ? (
    <div class="mb-6">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h2 class="text-[22px] font-bold text-navy-950">Расселение</h2>
          <p class="mt-1 text-base text-body-muted">
            Перетащите ребёнка в койку. Расселено: {assignedByBed.size} / {assignments.length}.
            Не расселены: {unassignedKids.length}.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="load-crm-btn" type="button" class="rounded-[12px] border border-border bg-white px-4 py-2 text-base font-medium text-navy-950 transition hover:border-primary hover:text-primary">
            <i class="bi bi-cloud-download mr-1" aria-hidden="true"></i> Загрузить из AlfaCRM
          </button>
          <button id="auto-assign-btn" type="button" class="rounded-[12px] border border-emerald-300 bg-emerald-50 px-4 py-2 text-base font-medium text-emerald-800 transition hover:bg-emerald-100">
            <i class="bi bi-magic mr-1" aria-hidden="true"></i> Авто-расстановка
          </button>
          <button id="add-kid-btn" type="button" class="rounded-[12px] bg-primary px-4 py-2 text-base font-semibold text-white transition hover:opacity-90">
            <i class="bi bi-person-plus mr-1" aria-hidden="true"></i> Добавить вручную
          </button>
          <button id="reset-btn" type="button" class="rounded-[12px] border border-red-300 bg-white px-4 py-2 text-base font-medium text-red-700 transition hover:bg-red-50">
            <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i> Сбросить
          </button>
        </div>
      </div>

      <div class="mb-4 flex flex-wrap gap-2 no-print">
        <button id="view-plan-btn" type="button" class="rounded-[10px] border-2 border-primary bg-primary px-4 py-2 text-base font-semibold text-white transition">
          <i class="bi bi-grid-3x3-gap mr-1" aria-hidden="true"></i> План (перетаскивание)
        </button>
        <button id="view-list-btn" type="button" class="rounded-[10px] border-2 border-border bg-white px-4 py-2 text-base font-medium text-navy-950 transition hover:border-primary">
          <i class="bi bi-list-task mr-1" aria-hidden="true"></i> Список
        </button>
        <button id="print-rasselenie-btn" type="button" class="rounded-[10px] border-2 border-border bg-white px-4 py-2 text-base font-medium text-navy-950 transition hover:border-primary">
          <i class="bi bi-printer mr-1" aria-hidden="true"></i> Печать
        </button>
      </div>

      <div id="rasselenie-plan-view" class="flex gap-4 items-start">
        <div class="flex-1 min-w-0 space-y-4">
          <RasseleniePlan assignedByBed={assignedByBed} />
        </div>
        <RasseleniKidPool unassignedKids={unassignedKids} />
      </div>

      <RasselenieList assignedByBed={assignedByBed} unassignedKids={unassignedKids} />

      <AddKidModal shiftId={shift?.id ?? 0} />

      {/* Диалог выбора групп AlfaCRM для загрузки детей */}
      <dialog id="crm-groups-dialog" style="border:none;border-radius:16px;padding:28px 24px;max-width:440px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,.18)">
        <h3 style="margin:0 0 6px;font-size:18px;font-weight:700">Загрузить из AlfaCRM</h3>
        <p style="margin:0 0 16px;font-size:14px;color:#6b7280">Выберите одну или несколько групп. Дубли по alfaId игнорируются.</p>
        <div id="crm-groups-list" style="display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;margin-bottom:16px">
          <div style="color:#6b7280;font-size:14px">Загрузка групп…</div>
        </div>
        <div id="crm-groups-error" style="display:none;margin-bottom:12px;padding:10px 12px;background:#fee2e2;border-radius:8px;color:#b91c1c;font-size:14px"></div>
        <div style="display:flex;gap:10px">
          <button type="button" id="crm-groups-submit" class="den-save" style="flex:1" disabled>Загрузить</button>
          <button type="button" id="crm-groups-cancel" class="den-copy">Отмена</button>
        </div>
      </dialog>

      {shift && (
        <>
        <script>
          import Sortable from 'sortablejs';
          window.Sortable = Sortable;
          window.dispatchEvent(new Event('sortable-ready'));
        </script>
        </>
      )}
    </div>
  ) : (
    <div class="mb-6">
      <h2 class="text-[22px] font-bold text-navy-950">Инвентаризация</h2>
      <p class="mt-1 text-base text-body-muted">Клик по комнате — чек-лист + видео обхода.</p>
    </div>
  )}

  {tab === 'inventory' && (<>
    <InventoryStats counts={counts} />
    <InventoryFloorPlan statusByRoom={statusByRoom} />
    <InventoryModal roomCheckEventId={roomCheckEventId} />
  </>)}

  <script src="../../scripts/portal/rooms.ts"></script>

  <style is:global>
    @media print {
      /* Печать расселения — горизонтально, по схеме комнат, с полными ФИО. */
      @page { size: A4 landscape; margin: 8mm; }
      body * { visibility: hidden !important; }
      #rasselenie-plan-view, #rasselenie-plan-view * { visibility: visible !important; }
      #rasselenie-plan-view {
        display: block !important;
        position: absolute !important;
        left: 0; top: 0; width: 100%;
        padding: 0; margin: 0;
      }
      /* схема комнат: убрать горизонтальный скролл, дать сетке ужаться по ширине листа */
      #rasselenie-plan-view .overflow-x-auto { overflow: visible !important; }
      #rasselenie-plan-view .grid { min-width: 0 !important; }
      /* полные ФИО — снять обрезку, разрешить перенос */
      #rasselenie-plan-view .truncate {
        overflow: visible !important;
        text-overflow: clip !important;
        white-space: normal !important;
        max-width: none !important;
      }
      /* убрать интерактив с печати */
      #rasselenie-plan-view .kid-remove,
      #rasselenie-plan-view .aida-tooltip { display: none !important; }
      #rasselenie-plan-view .card-shadow { box-shadow: none !important; }
      #rasselenie-plan-view .kid-card { cursor: default !important; }
      .no-print { display: none !important; }
    }
  </style>
</PortalLayout>
