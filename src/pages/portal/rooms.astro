---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { ROOMS, INVENTORY_CHECKLIST, roomsByFloor, type RoomDef } from '../../lib/portalRooms';
import { getActiveShift } from '../../lib/portalShift';
import { listInventoryByShift } from '../../lib/portalRoomInventory';
import { listAssignments } from '../../lib/portalRasselenie';
import PortalUploader from '../../components/portal/UppyUploader.astro';
import MediaManager from '../../components/portal/MediaManager.astro';

// id события «Приёмка номеров» (день -1) — к нему привязываем видео обхода через photo API.
let roomCheckEventId = 0;
async function lookupRoomCheckEventId(): Promise<number> {
  if (!process.env.AIDAPLUS_PG_DSN && !process.env.PG_DSN) return 0;
  const { default: pg } = await import('pg');
  const client = new pg.Client({ connectionString: process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN });
  await client.connect();
  try {
    const r = await client.query("SELECT id FROM shift_event WHERE external_id='ev-dm1-room-check' LIMIT 1");
    return (r.rows[0]?.id as number) ?? 0;
  } finally { await client.end(); }
}

const role = Astro.locals.portalRole;
const tab = (Astro.url.searchParams.get('tab') || 'inventory') as 'inventory' | 'rasselenie';
if (!role || role === 'student') return Astro.redirect('/portal/');

const shift = await getActiveShift();
const inventory = shift ? await listInventoryByShift(shift.id) : [];
const assignments = shift && tab === 'rasselenie' ? await listAssignments(shift.id) : [];
const assignedByBed = new Map<string, typeof assignments[number]>();
const unassignedKids: typeof assignments = [];
for (const a of assignments) {
  if (a.room_number != null && a.bed_index != null) {
    assignedByBed.set(`${a.room_number}:${a.bed_index}`, a);
  } else {
    unassignedKids.push(a);
  }
}
roomCheckEventId = shift ? await lookupRoomCheckEventId().catch(() => 0) : 0;
const statusByRoom = new Map<number, string>();
for (const r of inventory) statusByRoom.set(r.room_number, r.status);

const counts = {
  pending: ROOMS.filter((r) => r.type !== 'staff' && (statusByRoom.get(r.number) ?? 'pending') === 'pending').length,
  ok:      inventory.filter((r) => r.status === 'ok').length,
  defects: inventory.filter((r) => r.status === 'defects').length,
};
const floor1 = roomsByFloor(1);
const floor2 = roomsByFloor(2);
function statusOf(n: number): 'pending' | 'ok' | 'defects' {
  return (statusByRoom.get(n) ?? 'pending') as any;
}
function colorCls(s: string, type: string): string {
  if (type === 'staff') return 'bg-slate-100 text-slate-400 border-slate-200';
  if (s === 'ok')      return 'bg-emerald-50 border-emerald-300 text-emerald-900';
  if (s === 'defects') return 'bg-amber-50 border-amber-300 text-amber-900';
  return 'bg-white border-border text-navy-950';
}
function typeBadge(type: string): string {
  return type === 'lux' ? 'ЛЮКС' : type === 'standard_2_3' ? '2-3-х' : type === 'staff' ? '' : '2-х';
}
---
<PortalLayout title="Комнаты — АйДаКемп">
  <div class="mb-6">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Комнаты · 3 корпус
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">
      20 жилых комнат на 46 мест (+ 1 нежилая — горничная №22). Расселение детей и инвентаризация.
    </p>
  </div>

  {/* Табы */}
  <nav class="mb-6 flex flex-wrap gap-2" aria-label="Разделы комнат">
    <a href="/portal/rooms"
       class={`inline-flex items-center gap-2 rounded-[12px] border px-4 py-2 text-[15px] font-medium transition ${
         tab === 'inventory'
           ? 'border-primary bg-primary text-white'
           : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary'
       }`}>
      <i class="bi bi-clipboard-check text-[16px]" aria-hidden="true"></i>
      Инвентаризация
    </a>
    <a href="/portal/rooms?tab=rasselenie"
       class={`inline-flex items-center gap-2 rounded-[12px] border px-4 py-2 text-[15px] font-medium transition ${
         tab === 'rasselenie'
           ? 'border-primary bg-primary text-white'
           : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary'
       }`}>
      <i class="bi bi-house-door-fill text-[16px]" aria-hidden="true"></i>
      Расселение
    </a>
  </nav>

  {tab === 'rasselenie' ? (
    <div class="mb-6">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h2 class="text-[22px] font-bold text-navy-950">Расселение</h2>
          <p class="mt-1 text-[15px] text-body-muted">
            Перетащите ребёнка в койку. Расселено: {assignedByBed.size} / {assignments.length}.
            Не расселены: {unassignedKids.length}.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="load-crm-btn" type="button" class="rounded-[12px] border border-border bg-white px-4 py-2 text-[15px] font-medium text-navy-950 transition hover:border-primary hover:text-primary">
            <i class="bi bi-cloud-download mr-1" aria-hidden="true"></i> Загрузить из AlfaCRM
          </button>
          <button id="auto-assign-btn" type="button" class="rounded-[12px] border border-emerald-300 bg-emerald-50 px-4 py-2 text-[15px] font-medium text-emerald-800 transition hover:bg-emerald-100">
            <i class="bi bi-magic mr-1" aria-hidden="true"></i> Авто-расстановка
          </button>
          <button id="add-kid-btn" type="button" class="rounded-[12px] bg-primary px-4 py-2 text-[15px] font-semibold text-white transition hover:opacity-90">
            <i class="bi bi-person-plus mr-1" aria-hidden="true"></i> Добавить вручную
          </button>
          <button id="reset-btn" type="button" class="rounded-[12px] border border-red-300 bg-white px-4 py-2 text-[15px] font-medium text-red-700 transition hover:bg-red-50">
            <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i> Сбросить
          </button>
        </div>
      </div>

      {/* Лента «Не расселены» — поверх плана, видна когда есть кого расселять */}
      {unassignedKids.length > 0 && (
        <div class="rasselenie-pool mb-4 rounded-[14px] border border-amber-200 bg-amber-50/60 p-3 card-shadow">
          <div class="mb-2 flex items-center justify-between">
            <div class="flex items-center gap-2 text-[14px] font-semibold text-navy-950">
              <i class="bi bi-people-fill text-amber-600" aria-hidden="true"></i>
              Не расселены ({unassignedKids.length}) — перетащите в койку
            </div>
            <button id="toggle-pool-btn" type="button"
              class="rounded-[8px] border border-border bg-white px-2 py-1 text-[12px] text-body-muted hover:border-primary hover:text-primary">
              Свернуть
            </button>
          </div>
          <div id="pool-list" class="flex flex-nowrap gap-2 overflow-x-auto pb-1">
            {unassignedKids.map((kid) => (
              <div class="kid-card flex shrink-0 cursor-grab items-center gap-1.5 rounded-[10px] border border-border bg-white px-2.5 py-1.5 text-[13px] active:cursor-grabbing"
                   draggable="true"
                   data-kid-id={kid.kid_id}
                   data-kid-name={kid.kid_name}
                   title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
                <span class={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${
                  kid.kid_gender === 'F' ? 'bg-pink-500' : kid.kid_gender === 'M' ? 'bg-sky-500' : 'bg-slate-400'
                }`}>{kid.kid_gender === 'F' ? 'Ж' : kid.kid_gender === 'M' ? 'М' : '?'}</span>
                <span class="whitespace-nowrap text-navy-950">{kid.kid_name}{kid.kid_age ? ` · ${kid.kid_age}` : ''}</span>
                <button type="button" class="kid-remove text-[11px] text-red-600 hover:underline" data-kid-id={kid.kid_id} title="Удалить из списка">×</button>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="space-y-4">
        {/* Комнаты по плану корпуса — на всю ширину */}
        <div class="space-y-4">
          {(() => {
            // Координаты из portalRooms.ts соответствуют плану корпуса
            function roomCard(roomNum: number) {
              const r = ROOMS.find((x) => x.number === roomNum);
              if (!r) return null;
              const occ = Array.from({ length: r.capacity }).map((_, i) => assignedByBed.get(`${r.number}:${i}`)).filter(Boolean).length;
              return (
                <div class="rasselenie-room flex flex-col rounded-[12px] border border-border bg-page p-3"
                     data-room-number={r.number}
                     style={`grid-column: ${r.col}; grid-row: ${r.row};`}>
                  <div class="mb-2 flex items-center justify-between">
                    <div class="font-bold text-[15px] text-navy-950">№{r.number}</div>
                    <div class="text-[12px] text-body-muted">{occ}/{r.capacity}</div>
                  </div>
                  <div class="flex-1 space-y-1.5">
                    {Array.from({ length: r.capacity }).map((_, i) => {
                      const kid = assignedByBed.get(`${r.number}:${i}`);
                      return (
                        <div
                          class={`bed flex min-h-[38px] items-center gap-2 rounded-[8px] border-2 border-dashed border-border px-2 py-1 text-[13px] ${kid ? 'border-solid bg-white' : 'bg-page'}`}
                          data-room-number={r.number}
                          data-bed-index={i}
                          data-kid-id={kid?.kid_id ?? ''}
                        >
                          {kid ? (
                            <div class="kid-card group/kid relative flex min-w-0 flex-1 cursor-grab items-center gap-1.5 active:cursor-grabbing"
                                 draggable="true"
                                 data-kid-id={kid.kid_id}
                                 data-kid-name={kid.kid_name}
                                 title={`${kid.kid_name}${kid.kid_age ? ' · ' + kid.kid_age + ' лет' : ''}${kid.kid_gender === 'F' ? ' · девочка' : kid.kid_gender === 'M' ? ' · мальчик' : ''}`}>
                              <span class={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${
                                kid.kid_gender === 'F' ? 'bg-pink-500' : kid.kid_gender === 'M' ? 'bg-sky-500' : 'bg-slate-400'
                              }`}>{kid.kid_gender === 'F' ? 'Ж' : kid.kid_gender === 'M' ? 'М' : '?'}</span>
                              <span class="min-w-0 flex-1 truncate text-navy-950">{kid.kid_name}{kid.kid_age ? ` · ${kid.kid_age}` : ''}</span>
                              <button type="button" class="kid-remove shrink-0 text-[11px] text-red-600 hover:underline" data-kid-id={kid.kid_id} title="Снять с койки">×</button>
                              {/* Pretty hover-tooltip — поверх всего, без обрезки */}
                              <span class="aida-tooltip pointer-events-none invisible absolute left-1/2 z-50 -translate-x-1/2 whitespace-nowrap rounded-[6px] bg-navy-950 px-2.5 py-1.5 text-[12px] font-medium text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover/kid:visible group-hover/kid:opacity-100" style="bottom: calc(100% + 6px);">
                                {kid.kid_name}{kid.kid_age ? ` · ${kid.kid_age} лет` : ''}
                                <span class="absolute left-1/2 top-full -translate-x-1/2 border-x-[5px] border-t-[5px] border-x-transparent border-t-navy-950"></span>
                              </span>
                            </div>
                          ) : (
                            <span class="text-body-muted">койка {i + 1}</span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            }
            // Этаж 1: 9 колонок (4 левых + коридор col 5 + 4 правых)
            const floor1 = ROOMS.filter((r) => r.floor === 1 && r.type !== 'staff');
            // Этаж 2: 8 колонок (3 левых + коридор col 4 + 4 правых)
            const floor2 = ROOMS.filter((r) => r.floor === 2);
            return (
              <>
                <div class="rounded-[14px] border border-border bg-white p-4 card-shadow">
                  <h3 class="mb-3 text-[16px] font-bold text-navy-950">Этаж 1 · 22 места</h3>
                  <div class="overflow-x-auto">
                    <div class="grid gap-2"
                         style="grid-template-columns: repeat(4, minmax(118px, 1fr)) 18px repeat(4, minmax(118px, 1fr)); grid-auto-rows: minmax(132px, auto); min-width: 1080px;">
                      {floor1.map((r) => roomCard(r.number))}
                      <div class="pointer-events-none border-x border-dashed border-slate-300"
                           style="grid-column: 5; grid-row: 1 / span 2;"></div>
                    </div>
                  </div>
                </div>
                <div class="rounded-[14px] border border-border bg-white p-4 card-shadow">
                  <h3 class="mb-3 text-[16px] font-bold text-navy-950">Этаж 2 · 24 места</h3>
                  <div class="overflow-x-auto">
                    <div class="grid gap-2"
                         style="grid-template-columns: repeat(3, minmax(118px, 1fr)) 18px repeat(4, minmax(118px, 1fr)); grid-auto-rows: minmax(170px, auto); min-width: 960px;">
                      {floor2.map((r) => roomCard(r.number))}
                      <div class="pointer-events-none border-x border-dashed border-slate-300"
                           style="grid-column: 4; grid-row: 1 / span 2;"></div>
                    </div>
                  </div>
                </div>
              </>
            );
          })()}
        </div>

      </div>

      {/* Модалка добавления ребёнка */}
      <div id="add-kid-modal" class="fixed inset-0 z-50 hidden bg-black/50">
        <div class="absolute inset-0 flex items-start justify-center overflow-y-auto p-4">
          <div class="mt-20 w-full max-w-md rounded-[16px] bg-white p-6 shadow-xl">
            <h2 class="mb-4 text-[20px] font-bold text-navy-950">Добавить ребёнка</h2>
            <form id="add-kid-form" class="space-y-3">
              <input type="hidden" name="shift_id" value={shift?.id ?? 0} />
              <div>
                <label class="block text-[13px] font-medium text-body-muted">Имя и фамилия</label>
                <input name="kid_name" required class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" placeholder="Иван Иванов" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[13px] font-medium text-body-muted">Пол</label>
                  <select name="kid_gender" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary">
                    <option value="">—</option>
                    <option value="M">Мальчик</option>
                    <option value="F">Девочка</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[13px] font-medium text-body-muted">Возраст</label>
                  <input name="kid_age" type="number" min="6" max="18" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" />
                </div>
              </div>
              <div>
                <label class="block text-[13px] font-medium text-body-muted">Заметки</label>
                <textarea name="notes" rows="2" data-voice data-voice-append class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[14px] outline-none focus:border-primary" placeholder="Пожелания по соседям, особенности"></textarea>
              </div>
              <div class="flex gap-2">
                <button type="submit" class="rounded-[10px] bg-primary px-4 py-2 text-[15px] font-semibold text-white hover:opacity-90">Добавить</button>
                <button type="button" id="add-kid-cancel" class="rounded-[10px] border border-border bg-white px-4 py-2 text-[15px] font-medium text-body-muted hover:border-primary">Отмена</button>
                <span id="add-kid-status" class="ml-auto self-center text-[13px] text-body-muted"></span>
              </div>
            </form>
          </div>
        </div>
      </div>

      {shift && (
        <>
        <script>
          // Sortable.js — модульный импорт через Astro/Vite bundling.
          // Экспортируем в window, чтобы inline-скрипт ниже (которому нужен define:vars shiftId)
          // мог использовать его. Шлём событие, если inline уже отработал.
          import Sortable from 'sortablejs';
          window.Sortable = Sortable;
          window.dispatchEvent(new Event('sortable-ready'));
        </script>
        <script is:inline define:vars={{ shiftId: shift.id }}>
          (() => {
            // ── CRM-загрузка ──
            const crmBtn = document.getElementById('load-crm-btn');
            crmBtn?.addEventListener('click', async () => {
              if (!confirm('Загрузить детей из AlfaCRM (группа 660 = смена 1)? Существующие записи останутся, дубли по alfaId игнорируются.')) return;
              crmBtn.disabled = true;
              const old = crmBtn.innerHTML;
              crmBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Загружаю…';
              try {
                const r = await fetch('/api/shift-roster?shift=1', { credentials: 'include' });
                const d = await r.json();
                if (!d.ok || !Array.isArray(d.kids)) {
                  alert('Ошибка AlfaCRM: ' + (d.error || r.status));
                  return;
                }
                let added = 0;
                for (const k of d.kids) {
                  const gender = k.gender === 1 ? 'M' : (k.gender === 0 ? 'F' : null);
                  await fetch('/api/portal/rasselenie', {
                    method: 'POST',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({
                      shift_id: shiftId,
                      kid_id: 'alfa-' + k.alfaId,
                      kid_name: k.name,
                      kid_gender: gender,
                      kid_age: k.age || null,
                    }),
                    credentials: 'include',
                  });
                  added++;
                }
                alert('Загружено: ' + added + ' детей');
                window.location.reload();
              } catch (e) {
                alert('Сетевая ошибка: ' + (e && e.message ? e.message : e));
              } finally {
                crmBtn.disabled = false;
                crmBtn.innerHTML = old;
              }
            });

            // ── Авто-расстановка ──
            const autoBtn = document.getElementById('auto-assign-btn');
            autoBtn?.addEventListener('click', async () => {
              if (!confirm('Авто-расстановка заполнит свободные койки с учётом пола (без смешанных) и близкого возраста (разброс ≤3 лет). Уже расселённых не трогаем. Продолжить?')) return;
              autoBtn.disabled = true;
              const old = autoBtn.innerHTML;
              autoBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Расставляю…';
              try {
                const r = await fetch('/api/portal/rasselenie', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ action: 'auto_assign', shift_id: shiftId }),
                  credentials: 'include',
                });
                const d = await r.json();
                if (d.ok) {
                  alert('Расселено: ' + d.assigned + '. Не удалось разместить: ' + d.skipped + ' (возможно — нет подходящих коек или пол/возраст не сходятся).');
                  window.location.reload();
                } else {
                  alert('Ошибка: ' + (d.error || ''));
                  autoBtn.disabled = false;
                  autoBtn.innerHTML = old;
                }
              } catch (e) {
                alert('Сетевая ошибка');
                autoBtn.disabled = false;
                autoBtn.innerHTML = old;
              }
            });

            // ── Сброс расселения ──
            const resetBtn = document.getElementById('reset-btn');
            resetBtn?.addEventListener('click', async () => {
              const choice = prompt('Выбери режим сброса:\n  1 — снять всех с коек (список детей сохранится)\n  2 — удалить ВСЕХ детей полностью\n\nВведи 1 или 2 (или Cancel):', '1');
              if (choice !== '1' && choice !== '2') return;
              const action = choice === '2' ? 'wipe_all' : 'reset_all';
              if (action === 'wipe_all' && !confirm('Точно удалить ВСЕХ детей из списка? Это необратимо.')) return;
              try {
                const r = await fetch('/api/portal/rasselenie', {
                  method: 'DELETE',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ shift_id: shiftId, action }),
                  credentials: 'include',
                });
                const d = await r.json();
                if (d.ok) window.location.reload();
                else alert('Ошибка: ' + (d.error || ''));
              } catch (e) {
                alert('Сетевая ошибка');
              }
            });

            // ── Add-kid modal ──
            const modal = document.getElementById('add-kid-modal');
            const openBtn = document.getElementById('add-kid-btn');
            const cancelBtn = document.getElementById('add-kid-cancel');
            const form = document.getElementById('add-kid-form');
            const status = document.getElementById('add-kid-status');
            openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
            cancelBtn.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', (e) => { if (e.target === modal.firstElementChild) modal.classList.add('hidden'); });
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const fd = new FormData(form);
              const body = {
                shift_id: shiftId,
                kid_id: 'kid-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6),
                kid_name: fd.get('kid_name'),
                kid_gender: fd.get('kid_gender') || null,
                kid_age: fd.get('kid_age') || null,
                notes: fd.get('notes') || null,
              };
              status.textContent = 'Добавляю…';
              try {
                const r = await fetch('/api/portal/rasselenie', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify(body),
                  credentials: 'include',
                });
                const d = await r.json();
                if (d.ok) { window.location.reload(); }
                else status.textContent = 'Ошибка: ' + (d.error || '');
              } catch { status.textContent = 'Сетевая ошибка'; }
            });

            // ── Drag-n-drop через Sortable.js ──
            // Каждая койка (.bed) и пул (#pool-list) — Sortable-контейнер с group="kids".
            // При onEnd → POST /api/portal/rasselenie с {kid_id, room_number, bed_index}.
            const poolEl = document.getElementById('pool-list');

            function initSortable() {
              const S = window.Sortable;
              if (!S) return;

              // Снимаем нативный draggable, чтобы не конфликтовал с Sortable.
              document.querySelectorAll('.kid-card[draggable="true"]').forEach((c) => c.removeAttribute('draggable'));

              const commonOpts = {
                group: { name: 'kids', pull: true, put: true },
                animation: 150,
                ghostClass: 'opacity-50',
                draggable: '.kid-card',
                forceFallback: false,
              };

              if (poolEl) {
                S.create(poolEl, {
                  ...commonOpts,
                  onAdd: async (evt) => {
                    const item = evt.item;
                    const kidId = item.dataset.kidId;
                    const kidName = item.dataset.kidName;
                    if (!kidId) return;
                    await moveKid(kidId, kidName, null, null);
                  },
                });
              }

              document.querySelectorAll('.bed').forEach((bed) => {
                S.create(bed, {
                  ...commonOpts,
                  // Запрет класть второго ребёнка на занятую койку (capacity=1):
                  // если уже есть .kid-card — не принимаем новый.
                  onAdd: async (evt) => {
                    const item = evt.item;
                    const kidId = item.dataset.kidId;
                    const kidName = item.dataset.kidName;
                    if (!kidId) return;
                    const roomNumber = Number(bed.dataset.roomNumber);
                    const bedIndex = Number(bed.dataset.bedIndex);
                    await moveKid(kidId, kidName, roomNumber, bedIndex);
                  },
                });
              });
            }

            if (window.Sortable) initSortable();
            else window.addEventListener('sortable-ready', initSortable, { once: true });

            async function moveKid(kidId, kidName, roomNumber, bedIndex) {
              try {
                const r = await fetch('/api/portal/rasselenie', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({
                    shift_id: shiftId, kid_id: kidId, kid_name: kidName,
                    room_number: roomNumber, bed_index: bedIndex,
                  }),
                  credentials: 'include',
                });
                const d = await r.json();
                if (d.ok) window.location.reload();
                else alert('Ошибка: ' + (d.error || ''));
              } catch (err) { alert('Сетевая ошибка'); }
            }

            // Pool toggle
            const toggleBtn = document.getElementById('toggle-pool-btn');
            const poolList = document.getElementById('pool-list');
            if (toggleBtn && poolList) {
              toggleBtn.addEventListener('click', () => {
                const collapsed = poolList.style.display === 'none';
                poolList.style.display = collapsed ? '' : 'none';
                toggleBtn.textContent = collapsed ? 'Свернуть' : 'Развернуть';
              });
            }

            // Remove kid
            document.querySelectorAll('.kid-remove').forEach((btn) => {
              btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const kidId = btn.dataset.kidId;
                if (!confirm('Снять с койки и удалить из списка?')) return;
                const r = await fetch('/api/portal/rasselenie', {
                  method: 'DELETE',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ shift_id: shiftId, kid_id: kidId }),
                  credentials: 'include',
                });
                if (r.ok) window.location.reload();
              });
            });
          })();
        </script>
        </>
      )}
    </div>
  ) : (
    <div class="mb-6">
      <h2 class="text-[22px] font-bold text-navy-950">Инвентаризация</h2>
      <p class="mt-1 text-[15px] text-body-muted">Клик по комнате — чек-лист + видео обхода.</p>
    </div>
  )}

  {tab === 'inventory' && (<>
  {/* Сводка статусов */}
  <div class="mb-6 grid grid-cols-3 gap-3">
    <div class="rounded-[12px] border border-border bg-white p-4 card-shadow">
      <p class="text-[12px] font-medium uppercase tracking-wide text-body-muted">Не принято</p>
      <p class="mt-1 text-[24px] font-bold text-navy-950">{counts.pending}</p>
    </div>
    <div class="rounded-[12px] border border-emerald-200 bg-emerald-50 p-4">
      <p class="text-[12px] font-medium uppercase tracking-wide text-emerald-700">Принято без замечаний</p>
      <p class="mt-1 text-[24px] font-bold text-emerald-900">{counts.ok}</p>
    </div>
    <div class="rounded-[12px] border border-amber-200 bg-amber-50 p-4">
      <p class="text-[12px] font-medium uppercase tracking-wide text-amber-700">С замечаниями</p>
      <p class="mt-1 text-[24px] font-bold text-amber-900">{counts.defects}</p>
    </div>
  </div>

  {/* Helper: разбиваем комнаты этажа по крыльям/рядам как на оригинальной схеме */}
  {(() => {
    // Жёсткая раскладка крыльев по номерам (соответствует исходному плану)
    const layout = {
      floor1: {
        row1: { left: [20, 19, 18, 17], right: [11, 12, 13, 14] },
        row2: { left: [21, 22], right: [16, 15] },
      },
      floor2: {
        row1: { left: [30, 31], right: [23, 24] },
        row2: { left: [29, 28, 27], right: [26, 25] },
      },
    };
    function tile(num: number, heightCls: string) {
      const r = ROOMS.find((x) => x.number === num)!;
      const s = statusOf(num);
      const isStaff = r.type === 'staff';
      return (
        <button type="button"
          class={`room-tile flex-1 rounded-[12px] border-2 bg-white p-3 text-left shadow-sm transition ${heightCls} ${colorCls(s, r.type)} ${isStaff ? 'cursor-not-allowed opacity-60' : 'hover:shadow-md'}`}
          data-room={num}
          disabled={isStaff}
        >
          <div class="text-[16px] font-bold">№{num}</div>
          <div class="mt-0.5 text-[11px] text-body-muted">{r.label}</div>
          {!isStaff && (
            <div class="mt-1 text-[11px] font-semibold">
              {s === 'ok' && '✓ принято'}
              {s === 'defects' && '⚠ замечания'}
              {s === 'pending' && '○ не принято'}
            </div>
          )}
        </button>
      );
    }
    function rowEl(leftNums: number[], rightNums: number[], heightCls: string) {
      return (
        <div class="flex items-stretch gap-3">
          <div class="flex flex-1 gap-3">
            {leftNums.map((n) => tile(n, heightCls))}
          </div>
          <div class="w-10 shrink-0"></div>
          <div class="flex flex-1 gap-3">
            {rightNums.map((n) => tile(n, heightCls))}
          </div>
        </div>
      );
    }
    return (
      <>
        {/* Этаж 1 */}
        <section class="mb-8">
          <h2 class="mb-3 text-[20px] font-bold text-navy-950">Этаж 1 · 22 места</h2>
          <div class="rounded-[16px] border-2 border-slate-300 bg-slate-100 p-5">
            <div class="flex flex-col gap-3">
              {rowEl(layout.floor1.row1.left, layout.floor1.row1.right, 'h-[100px]')}
              {rowEl(layout.floor1.row2.left, layout.floor1.row2.right, 'h-[140px]')}
            </div>
          </div>
        </section>

        {/* Этаж 2 */}
        <section class="mb-8">
          <h2 class="mb-3 text-[20px] font-bold text-navy-950">Этаж 2 · 24 места</h2>
          <div class="rounded-[16px] border-2 border-slate-300 bg-slate-100 p-5">
            <div class="flex flex-col gap-3">
              {rowEl(layout.floor2.row1.left, layout.floor2.row1.right, 'h-[150px]')}
              {rowEl(layout.floor2.row2.left, layout.floor2.row2.right, 'h-[110px]')}
            </div>
          </div>
        </section>
      </>
    );
  })()}

  {/* Модалка инвентаризации */}
  <dialog id="room-modal" class="w-full max-w-2xl rounded-[16px] bg-white p-0 shadow-xl backdrop:bg-black/50">
    <div class="p-6">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-[22px] font-bold text-navy-950">
          Комната №<span id="room-modal-num">—</span>
        </h2>
        <button type="button" id="room-modal-close" class="rounded-[8px] border border-border p-2 hover:border-primary hover:text-primary">
          <i class="bi bi-x-lg text-[16px]" aria-hidden="true"></i>
        </button>
      </div>

        <div class="mb-4">
          <p class="mb-2 text-[14px] font-semibold text-navy-950">Видео обхода комнаты (обязательно)</p>
          {/* Универсальный MediaManager: Uppy Dashboard + список загруженных + удаление */}
          <MediaManager entityType="event"
                        entityId={roomCheckEventId}
                        accept="video/*,image/*"
                        title=""
                        note="Снять с камеры или выбрать из медиатеки" />
          <p id="room-walkthrough-status" class="mt-1 text-[13px] text-body-muted">Видео ещё не загружено.</p>
        </div>

        <div class="mb-4">
          <p class="mb-2 text-[14px] font-semibold text-navy-950">Чек-лист (6 пунктов)</p>
          <ul class="space-y-3" id="room-checklist">
            {INVENTORY_CHECKLIST.map((it) => (
              <li class="rounded-[10px] border border-border p-3">
                <label class="flex cursor-pointer items-start gap-3">
                  <input type="checkbox" class="room-check mt-0.5 h-5 w-5 rounded border-border text-primary focus:ring-primary" data-item={it.id} />
                  <span class="flex-1">
                    <span class="text-[15px] text-body">{it.text}</span>
                    <textarea class="room-comment mt-2 hidden w-full rounded-[6px] border border-border px-2 py-1 text-[13px]" rows="2" data-voice data-voice-append placeholder="Комментарий (если что-то не так)" data-item={it.id}></textarea>
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" id="room-mark-ok" class="rounded-[10px] bg-emerald-600 px-4 py-2 text-[14px] font-semibold text-white hover:bg-emerald-700">
            ✓ Принять без замечаний
          </button>
          <button type="button" id="room-mark-defects" class="rounded-[10px] bg-amber-600 px-4 py-2 text-[14px] font-semibold text-white hover:bg-amber-700">
            ⚠ Принять с замечаниями
          </button>
          <button type="button" id="room-mark-reset" class="rounded-[10px] border border-border bg-white px-4 py-2 text-[14px] font-medium text-body-muted hover:border-primary hover:text-primary">
            ↺ Сбросить статус
          </button>
          <span id="room-modal-status" class="ml-auto self-center text-[13px] text-body-muted"></span>
        </div>
      </div>
  </dialog>

  {shift && (
    <script is:inline define:vars={{ shiftId: shift.id, checklist: INVENTORY_CHECKLIST }}>
      (() => {
        const modal = document.getElementById('room-modal');
        const numEl = document.getElementById('room-modal-num');
        const closeBtn = document.getElementById('room-modal-close');
        const wtStatus = document.getElementById('room-walkthrough-status');
        const wtBlock = document.getElementById('room-walkthrough-uploader');
        const status = document.getElementById('room-modal-status');
        const okBtn = document.getElementById('room-mark-ok');
        const defBtn = document.getElementById('room-mark-defects');
        let currentRoom = null;

        function open(room) {
          currentRoom = room;
          numEl.textContent = String(room);
          if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
          // reset checks/comments
          modal.querySelectorAll('.room-check').forEach((c) => { c.checked = false; });
          modal.querySelectorAll('.room-comment').forEach((t) => { t.value = ''; t.classList.add('hidden'); });
          wtStatus.textContent = 'Загружаю состояние…';
          status.textContent = '';
          fetch('/api/portal/room-inventory?shift_id=' + shiftId + '&room=' + room, { credentials: 'include' })
            .then((r) => r.json()).then((d) => {
              if (!d.ok) { wtStatus.textContent = 'Ошибка: ' + (d.error || ''); return; }
              const row = d.row;
              const checks = d.checks || [];
              checks.forEach((c) => {
                const cb = modal.querySelector('.room-check[data-item="' + c.item_id + '"]');
                const ta = modal.querySelector('.room-comment[data-item="' + c.item_id + '"]');
                if (cb) cb.checked = !!c.done;
                if (ta && c.comment) { ta.value = c.comment; ta.classList.remove('hidden'); }
              });
              wtStatus.textContent = row && row.walkthrough_photo_id
                ? '✓ Видео обхода загружено (id ' + row.walkthrough_photo_id + ')'
                : 'Видео ещё не загружено.';
            }).catch(() => { wtStatus.textContent = 'Не удалось загрузить.'; });
        }
        function close() {
          if (typeof modal.close === 'function') modal.close(); else modal.removeAttribute('open');
          currentRoom = null;
        }

        document.querySelectorAll('.room-tile').forEach((b) => {
          if (b.disabled) return;
          b.addEventListener('click', () => open(Number(b.dataset.room)));
        });
        closeBtn.addEventListener('click', close);
        // Click on backdrop (outside the modal box) — closes
        modal.addEventListener('click', (e) => {
          if (e.target === modal) close();
        });
        // Esc key — native <dialog> cancel
        modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

        // Toggle textarea on check change
        modal.querySelectorAll('.room-check').forEach((cb) => {
          cb.addEventListener('change', () => {
            const item = cb.dataset.item;
            const ta = modal.querySelector('.room-comment[data-item="' + item + '"]');
            if (cb.checked) ta.classList.add('hidden'); else ta.classList.remove('hidden');
            saveCheck(item, cb.checked, ta.value || null);
          });
        });
        modal.querySelectorAll('.room-comment').forEach((ta) => {
          let t;
          ta.addEventListener('input', () => {
            clearTimeout(t);
            t = setTimeout(() => {
              const item = ta.dataset.item;
              const cb = modal.querySelector('.room-check[data-item="' + item + '"]');
              saveCheck(item, cb.checked, ta.value || null);
            }, 600);
          });
        });

        async function saveCheck(item, done, comment) {
          if (!currentRoom) return;
          status.textContent = 'Сохраняю…';
          try {
            const r = await fetch('/api/portal/room-inventory', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ shift_id: shiftId, room: currentRoom, item_id: item, done, comment }),
              credentials: 'include',
            });
            const d = await r.json();
            if (d.ok) status.textContent = '✓'; else status.textContent = 'Ошибка';
          } catch { status.textContent = 'Сетевая ошибка'; }
        }

        async function setStatus(st) {
          if (!currentRoom) return;
          status.textContent = 'Сохраняю…';
          try {
            const r = await fetch('/api/portal/room-inventory', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ shift_id: shiftId, room: currentRoom, status: st }),
              credentials: 'include',
            });
            const d = await r.json();
            if (d.ok) { status.textContent = '✓ Сохранено'; setTimeout(() => window.location.reload(), 500); }
            else status.textContent = 'Ошибка: ' + (d.error || '');
          } catch { status.textContent = 'Сетевая ошибка'; }
        }
        okBtn.addEventListener('click', () => setStatus('ok'));
        defBtn.addEventListener('click', () => setStatus('defects'));
        const resetBtn = document.getElementById('room-mark-reset');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            if (confirm('Сбросить статус комнаты в «не принято»? Чек-листы и видео сохранятся.')) {
              setStatus('pending');
            }
          });
        }

        // После загрузки видео обхода — привязать к комнате.
        document.addEventListener('portal-media:uploaded', (ev) => {
          const d = ev.detail || {};
          if (d.uploaderId !== 'room-walkthrough-uploader' || !currentRoom || !d.photoId) return;
          fetch('/api/portal/room-inventory', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ shift_id: shiftId, room: currentRoom, walkthrough_photo_id: d.photoId }),
            credentials: 'include',
          }).then((r) => r.json()).then((res) => {
            if (res.ok) {
              wtStatus.textContent = '✓ Видео обхода привязано (id ' + d.photoId + ')';
              // Автогалочка пункта «Видео обхода…»
              const cb = modal.querySelector('.room-check[data-item="video"]');
              if (cb && !cb.checked) { cb.checked = true; saveCheck('video', true, null); }
            } else {
              wtStatus.textContent = 'Ошибка привязки видео: ' + (res.error || '');
            }
          }).catch(() => { wtStatus.textContent = 'Сетевая ошибка при привязке видео'; });
        });
      })();
    </script>
  )}
  </>)}
</PortalLayout>
