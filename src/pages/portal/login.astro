---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';

const params = Astro.url.searchParams;
const error = params.get('error');
const next = params.get('next') ?? '/portal/';
---

<PortalLayout title="Вход в портал — АйДаКэмп" showHeader={false}>
  <div class="flex min-h-[70vh] items-center justify-center">
    <div class="w-full max-w-[420px]">
      <div class="mb-8 text-center">
        <div class="text-[26px] font-extrabold tracking-[-0.02em] text-navy-950">
          АйДаКэмп
        </div>
        <p class="mt-2 text-[16px] text-body-muted">Вход в портал</p>
      </div>

      <div class="rounded-[20px] border border-border bg-white p-6 card-shadow md:p-8">
        {error && (
          <div
            class="mb-5 flex items-start gap-2 rounded-[12px] border border-red-200 bg-red-50 px-4 py-3 text-[16px] text-red-700"
            role="alert"
          >
            <i
              class="bi bi-exclamation-triangle-fill mt-[2px] text-[18px]"
              aria-hidden="true"
            ></i>
            <span>Неверный пароль. Попробуйте ещё раз.</span>
          </div>
        )}

        <form method="POST" action="/api/portal/login" class="space-y-4">
          <input type="hidden" name="next" value={next} />
          <div>
            <label
              for="password"
              class="mb-2 block text-[16px] font-medium text-body"
            >
              Пароль
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autofocus
              autocomplete="current-password"
              class="w-full rounded-[12px] border border-border bg-white px-4 py-3 text-[16px] text-body outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <button
            type="submit"
            class="w-full rounded-[14px] bg-primary px-5 py-3 text-[16px] font-semibold text-white transition hover:bg-primary-hover"
          >
            Войти
          </button>
        </form>
      </div>
    </div>
  </div>
</PortalLayout>
