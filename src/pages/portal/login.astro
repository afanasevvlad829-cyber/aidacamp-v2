---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';

const params = Astro.url.searchParams;
const error = params.get('error');
const tg = params.get('tg');
const next = params.get('next') ?? '/portal/';
const inviteToken = (params.get('invite') ?? '').replace(/[^a-zA-Z0-9]/g, '').slice(0, 32);
const botUser =
  import.meta.env.PORTAL_BOT_USERNAME || process.env.PORTAL_BOT_USERNAME || '';

const tgMsg =
  tg === 'pending'
    ? 'Заявка отправлена — ждите подтверждения администратором.'
    : tg === 'revoked'
      ? 'Доступ отозван. Обратитесь к администратору.'
      : tg === 'invalid'
        ? 'Не удалось проверить вход через Telegram. Попробуйте ещё раз.'
        : '';
---

<PortalLayout title="Вход в портал — АйДаКемп" showHeader={false}>
  {/*
    Редирект на tg-app если страница открыта внутри Telegram-браузера.
    Telegram Login Widget открывает попап через window.open() — в in-app браузерах
    Telegram (Android/Desktop) это даёт about:blank. tg-app.astro работает без попапов.
  */}
  <script is:inline>
    (function () {
      // 1. Telegram Mini App: initData уже загружен SDK
      var tgWA = window.Telegram && window.Telegram.WebApp;
      if (tgWA && tgWA.initData) {
        window.location.replace('/portal/tg-app' + window.location.hash);
        return;
      }
      // 2. Fallback: initData передан через URL-хэш (#tgWebAppData=...)
      if (window.location.hash.indexOf('tgWebAppData') !== -1) {
        window.location.replace('/portal/tg-app' + window.location.hash);
        return;
      }
      // 3. Telegram Desktop / Android in-app browser: window.Telegram есть, но WebApp ещё не готов —
      //    ждём загрузки скрипта SDK (он грузится async на tg-app.astro, здесь его нет).
      //    Детектируем по UA: Telegram Desktop добавляет "TelegramDesktop" или "Telegram".
      var ua = navigator.userAgent || '';
      if (/TelegramDesktop|Telegram\/\d/i.test(ua)) {
        window.location.replace('/portal/tg-app' + window.location.hash);
        return;
      }
    })();
  </script>
  <div class="flex min-h-[70vh] items-center justify-center">
    <div class="w-full max-w-[420px]">
      <div class="mb-8 text-center">
        <div class="text-[26px] font-extrabold tracking-[-0.02em] text-navy-950">
          <span class="text-primary">Aida</span><span class="text-navy-950">Camp</span>
        </div>
        <p class="mt-2 text-[16px] text-body-muted">Вход в портал</p>
      </div>

      <div class="rounded-[20px] border border-border bg-white p-6 card-shadow md:p-8">
        {tgMsg && (
          <div
            class="mb-5 flex items-start gap-2 rounded-[12px] border border-amber-200 bg-amber-50 px-4 py-3 text-[16px] text-amber-800"
            role="status"
          >
            <i
              class="bi bi-info-circle-fill mt-[2px] text-[18px]"
              aria-hidden="true"
            ></i>
            <span>{tgMsg}</span>
          </div>
        )}

        {/* Сотрудники — вход через Telegram */}
        <p class="mb-3 text-[16px] font-medium text-body">
          Сотрудники — войдите через Telegram:
        </p>
        {botUser ? (
          <div class="flex flex-col items-center gap-3">
            <script
              async
              src="https://telegram.org/js/telegram-widget.js?22"
              data-telegram-login={botUser}
              data-size="large"
              data-userpic="false"
              data-onauth="onTelegramAuth(user)"
              data-request-access="write"
            ></script>
            <p id="tg-status" class="hidden text-base text-body-muted" aria-live="polite"></p>
            <script is:inline>
              window.onTelegramAuth = function (user) {
                const status = document.getElementById('tg-status');
                if (status) { status.textContent = 'Вход…'; status.classList.remove('hidden'); }
                const body = new URLSearchParams();
                Object.keys(user).forEach((k) => body.append(k, String(user[k])));
                // Прокидываем invite токен если есть в query — auto-approve на стороне сервера
                var qsInv = new URLSearchParams(location.search).get('invite');
                if (qsInv) body.append('invite', qsInv);
                fetch('/api/portal/tg', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: body.toString(),
                  credentials: 'include',
                  redirect: 'manual',
                }).then((r) => {
                  // Сервер делает 303 redirect — браузер не следует ему в fetch с redirect:manual.
                  // Считаем: если статус opaqueredirect / 0 / 303 / 200 — успех.
                  if (r.type === 'opaqueredirect' || r.status === 0 || r.status === 303 || (r.status >= 200 && r.status < 400)) {
                    window.location.href = '/portal/';
                  } else {
                    if (status) status.textContent = 'Не удалось войти (HTTP ' + r.status + ').';
                  }
                }).catch((e) => {
                  if (status) status.textContent = 'Сетевая ошибка: ' + (e && e.message ? e.message : e);
                });
              };
            </script>
          </div>
        ) : (
          <div
            class="flex items-start gap-2 rounded-[12px] border border-red-200 bg-red-50 px-4 py-3 text-[16px] text-red-700"
            role="alert"
          >
            <i
              class="bi bi-exclamation-triangle-fill mt-[2px] text-[18px]"
              aria-hidden="true"
            ></i>
            <span>Бот не настроен (PORTAL_BOT_USERNAME).</span>
          </div>
        )}

        {/* Вход по коду — ученик, сотрудник (личный код) или admin */}
        <details class="mt-8 border-t border-border pt-6" open={error}>
          <summary class="cursor-pointer text-[16px] font-medium text-primary">
            Войти по коду <span class="text-body-muted">(ученик или сотрудник)</span>
          </summary>
          <p class="mt-2 text-base text-body-muted">
            Ученики — школьный код от преподавателя. Сотрудники — личный код из админки
            (если Telegram недоступен; код выдаёт администратор).
          </p>

          {error && (
            <div
              class="mt-4 flex items-start gap-2 rounded-[12px] border border-red-200 bg-red-50 px-4 py-3 text-[16px] text-red-700"
              role="alert"
            >
              <i
                class="bi bi-exclamation-triangle-fill mt-[2px] text-[18px]"
                aria-hidden="true"
              ></i>
              <span>Неверный код. Попробуйте ещё раз.</span>
            </div>
          )}

          <form method="POST" action="/api/portal/login" class="mt-4 space-y-4">
            <input type="hidden" name="next" value={next} />
            <div>
              <label
                for="password"
                class="mb-2 block text-[16px] font-medium text-body"
              >
                Код
              </label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                class="w-full rounded-[12px] border border-border bg-white px-4 py-3 text-[16px] text-body outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
              />
            </div>
            <button
              type="submit"
              class="w-full rounded-[14px] bg-primary px-5 py-3 text-[16px] font-semibold text-white transition hover:bg-primary-hover"
            >
              Войти
            </button>
          </form>
        </details>
      </div>
    </div>
  </div>
</PortalLayout>
