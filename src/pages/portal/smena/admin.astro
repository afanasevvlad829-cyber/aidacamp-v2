---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getActiveShift, getEvents, listShifts, getChecklists, type ShiftEvent } from '../../../lib/portalShift';
import { listStaff } from '../../../lib/portalStaff';

const role = Astro.locals.portalRole;
// Все сотрудники видят страницу управления сеткой; правка ограничена ниже по ролям.
if (!role || role === 'student') return Astro.redirect('/portal/');
const canEdit = role === 'admin' || role === 'rukovoditel';

const shifts = await listShifts();
const activeShift = await getActiveShift();
const events: ShiftEvent[] = activeShift ? await getEvents(activeShift.id) : [];
const checklists = await getChecklists();
const allStaff = await listStaff();
const activeStaff = allStaff.filter((s) => s.active);

const ROLE_OPTIONS = [
  { value: 'teacher', label: 'Учитель' },
  { value: 'vozhaty', label: 'Вожатый' },
  { value: 'rukovoditel', label: 'Руководитель' },
  { value: 'student', label: 'Ученик' },
];

function fmtTime(t: string | null): string { return t ? t.slice(0, 5) : ''; }

const inputCls = 'w-full rounded-[10px] border border-border px-3 py-2 text-[16px] text-body outline-none focus:border-primary';
const labelCls = 'mb-1 form-label';
const btnCls = 'inline-flex items-center gap-2 rounded-[12px] bg-primary px-5 py-2.5 text-[16px] font-semibold text-white transition hover:bg-primary-hover';
const cardCls = 'rounded-[16px] border border-border bg-white p-5 card-shadow';
---

<PortalLayout title="Управление сеткой — АйДаКемп">
  {!canEdit && (
    <div class="mb-6 rounded-[12px] border border-amber-200 bg-amber-50 px-4 py-3 text-base text-amber-900">
      <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
      Просмотр сетки. Правка событий — у руководителя смены и админа. Скоро добавим частичный edit для своих событий.
    </div>
  )}
  <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Управление сеткой
    </h1>
    <a
      href="/portal/smena"
      class="inline-flex items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[16px] font-medium text-body-muted transition hover:border-primary hover:text-primary"
    >
      <i class="bi bi-arrow-left text-[18px]" aria-hidden="true"></i>
      К расписанию
    </a>
  </div>

  <div class="space-y-10">
    {/* ===== СМЕНЫ ===== */}
    <section>
      <h2 class="mb-4 text-[20px] font-bold text-navy-950 md:text-[24px]">Смены</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <form method="POST" action="/api/portal/shift/admin" class={cardCls}>
          <input type="hidden" name="action" value="createShift" />
          <h3 class="mb-3 text-[16px] font-semibold text-navy-950">Создать смену</h3>
          <div class="space-y-3">
            <div>
              <label class={labelCls} for="cs-name">Название</label>
              <input id="cs-name" class={inputCls} name="name" required placeholder="Смена 1" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class={labelCls} for="cs-start">Начало</label>
                <input id="cs-start" class={inputCls} type="date" name="start" required />
              </div>
              <div>
                <label class={labelCls} for="cs-end">Конец</label>
                <input id="cs-end" class={inputCls} type="date" name="end" required />
              </div>
            </div>
            <button class={btnCls}><i class="bi bi-plus-lg text-[18px]" aria-hidden="true"></i>Создать</button>
          </div>
        </form>

        <div class={cardCls}>
          <h3 class="mb-3 text-[16px] font-semibold text-navy-950">Все смены ({shifts.length})</h3>
          {shifts.length === 0 ? (
            <p class="text-[16px] text-body-muted">Смен пока нет.</p>
          ) : (
            <ul class="space-y-2">
              {shifts.map((s) => (
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-[10px] border border-border px-3 py-2">
                  <span class="text-[16px] text-navy-950">
                    {s.name} <span class="text-body-muted">{s.start_date}—{s.end_date}</span>
                    {s.status === 'active'
                      ? <span class="ml-1 rounded-[6px] bg-primary-soft px-1.5 py-0.5 text-base font-medium text-primary">активна</span>
                      : <span class="ml-1 rounded-[6px] bg-page px-1.5 py-0.5 text-base text-body-muted">архив</span>}
                  </span>
                  {s.status === 'active' && (
                    <form method="POST" action="/api/portal/shift/admin">
                      <input type="hidden" name="action" value="archiveShift" />
                      <input type="hidden" name="id" value={s.id} />
                      <button class="inline-flex items-center gap-1 rounded-[10px] border border-border px-3 py-1.5 text-base font-medium text-body-muted transition hover:border-primary hover:text-primary">
                        <i class="bi bi-archive text-base" aria-hidden="true"></i>В архив
                      </button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>

    {/* ===== СОБЫТИЯ ===== */}
    <section>
      <h2 class="mb-4 text-[20px] font-bold text-navy-950 md:text-[24px]">События</h2>
      {!activeShift ? (
        <p class={cardCls + ' text-[16px] text-body-muted'}>Создайте и активируйте смену, чтобы добавлять события.</p>
      ) : (
        <div class="grid gap-4 lg:grid-cols-2">
          <form id="event-form" method="POST" action="/api/portal/shift/admin" class={cardCls}>
            <input type="hidden" name="action" value="upsertEvent" />
            <input type="hidden" name="shiftId" value={activeShift.id} />
            <input type="hidden" name="id" id="ev-id" value="" />
            <div class="mb-3 flex items-center justify-between">
              <h3 id="ev-form-title" class="text-[16px] font-semibold text-navy-950">Добавить событие в «{activeShift.name}»</h3>
              <button type="button" id="ev-reset" class="hidden text-base text-body-muted hover:text-primary">
                <i class="bi bi-x-lg text-[12px]" aria-hidden="true"></i> Отмена правки
              </button>
            </div>
            <div class="space-y-3">
              <div>
                <label class={labelCls} for="ev-title">Название</label>
                <input id="ev-title" class={inputCls} name="title" required placeholder="Заезд" />
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class={labelCls} for="ev-date">Дата</label>
                  <input id="ev-date" class={inputCls} type="date" name="date" required value={activeShift.start_date} />
                </div>
                <div>
                  <label class={labelCls} for="ev-start">С</label>
                  <input id="ev-start" class={inputCls} type="time" name="start_time" />
                </div>
                <div>
                  <label class={labelCls} for="ev-end">До</label>
                  <input id="ev-end" class={inputCls} type="time" name="end_time" />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class={labelCls} for="ev-type">Тип активности</label>
                  <input id="ev-type" class={inputCls} name="activity_type" placeholder="meal / lesson / pool / …" />
                </div>
                <div>
                  <label class={labelCls} for="ev-sort">Порядок</label>
                  <input id="ev-sort" class={inputCls} type="number" name="sort" value="0" />
                </div>
              </div>
              <div>
                <span class={labelCls}>Роли</span>
                <div class="flex flex-wrap gap-3" id="ev-roles-wrap">
                  {ROLE_OPTIONS.map((r) => (
                    <label class="flex items-center gap-2 text-[16px] text-body">
                      <input type="checkbox" name="roles" value={r.value} class="h-5 w-5 rounded border-border text-primary focus:ring-primary" />
                      {r.label}
                    </label>
                  ))}
                </div>
              </div>
              <div>
                <label class={labelCls} for="ev-responsible">Главный ответственный (один сотрудник)</label>
                <select id="ev-responsible" name="responsible_staff_id" class={inputCls}>
                  <option value="">— не назначен (события будут штрафовать руководителя смены) —</option>
                  {activeStaff.map((s) => (
                    <option value={s.id}>
                      {s.full_name ?? `id=${s.id}`}{s.role ? ` · ${s.role}` : ''}
                    </option>
                  ))}
                </select>
                <p class="mt-1 text-base text-body-muted">
                  Автодетектор штрафов поставит штраф этому человеку, если событие закончилось и нет фото/закрытого чек-листа.
                </p>
              </div>
              <div>
                <label class={labelCls} for="ev-notes">Заметки и материалы</label>
                <textarea id="ev-notes" data-voice data-voice-append class={inputCls + ' min-h-[60px]'} name="notes" placeholder="Доп. инфа, ссылки на материалы…"></textarea>
              </div>
              <button id="ev-submit" class={btnCls}><i class="bi bi-plus-lg text-[18px]" aria-hidden="true"></i>Сохранить событие</button>
            </div>
          </form>

          <div class={cardCls}>
            <h3 class="mb-3 text-[16px] font-semibold text-navy-950">События смены ({events.length})</h3>
            {events.length === 0 ? (
              <p class="text-[16px] text-body-muted">Событий пока нет.</p>
            ) : (
              <ul class="space-y-2 max-h-[520px] overflow-auto">
                {events.map((e) => (
                  <li class="flex flex-wrap items-center gap-2 rounded-[10px] border border-border px-3 py-2">
                    <div class="min-w-0 flex-1">
                      <div class="text-base text-navy-950">
                        <span class="text-body-muted">{e.date.slice(5)} {fmtTime(e.start_time)}</span> {e.title}
                      </div>
                      <div class="text-[12px] text-body-muted">
                        #{e.id}{e.activity_type ? ` · ${e.activity_type}` : ''}
                        {e.roles.length > 0 && <span class="ml-1 text-primary">· {e.roles.join(', ')}</span>}
                        {e.responsible_name
                          ? <span class="ml-1 text-emerald-700">· отв: {e.responsible_name}</span>
                          : <span class="ml-1 text-amber-700">· отв: не назначен</span>}
                      </div>
                    </div>
                    <button type="button"
                            class="ev-edit rounded-[8px] border border-border px-2.5 py-1 text-[12px] font-medium text-body-muted transition hover:border-primary hover:text-primary"
                            data-id={e.id}
                            data-title={e.title}
                            data-date={e.date}
                            data-start={e.start_time ?? ''}
                            data-end={e.end_time ?? ''}
                            data-actype={e.activity_type ?? ''}
                            data-sort={e.sort}
                            data-roles={e.roles.join(',')}
                            data-notes={e.notes ?? ''}
                            data-resp-id={(e as any).responsible_staff_id ?? ''}>
                      <i class="bi bi-pencil text-[12px]" aria-hidden="true"></i> Править
                    </button>
                    <form method="POST" action="/api/portal/shift/admin" onsubmit={`return confirm('Удалить событие «${e.title}» (${e.date})? Также удалятся все привязки чек-листов и галочки.')`}>
                      <input type="hidden" name="action" value="deleteEvent" />
                      <input type="hidden" name="id" value={e.id} />
                      <button type="submit" class="rounded-[8px] border border-red-300 px-2.5 py-1 text-[12px] font-medium text-red-700 transition hover:bg-red-50">
                        <i class="bi bi-trash3 text-[12px]" aria-hidden="true"></i>
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <script is:inline>
            (() => {
              const form = document.getElementById('event-form');
              const idF = document.getElementById('ev-id');
              const titleF = document.getElementById('ev-title');
              const dateF = document.getElementById('ev-date');
              const startF = document.getElementById('ev-start');
              const endF = document.getElementById('ev-end');
              const typeF = document.getElementById('ev-type');
              const sortF = document.getElementById('ev-sort');
              const notesF = document.getElementById('ev-notes');
              const rolesWrap = document.getElementById('ev-roles-wrap');
              const respF = document.getElementById('ev-responsible');
              const formTitle = document.getElementById('ev-form-title');
              const submit = document.getElementById('ev-submit');
              const reset = document.getElementById('ev-reset');
              function resetForm() {
                idF.value = '';
                titleF.value = '';
                startF.value = ''; endF.value = '';
                typeF.value = ''; sortF.value = '0';
                if (notesF) notesF.value = '';
                rolesWrap?.querySelectorAll('input[name=roles]').forEach((cb) => { cb.checked = false; });
                if (respF) respF.value = '';
                formTitle.textContent = 'Добавить событие';
                submit.innerHTML = '<i class="bi bi-plus-lg text-[18px]" aria-hidden="true"></i>Сохранить событие';
                reset.classList.add('hidden');
              }
              reset?.addEventListener('click', resetForm);
              document.querySelectorAll('.ev-edit').forEach((b) => {
                b.addEventListener('click', () => {
                  idF.value = b.dataset.id || '';
                  titleF.value = b.dataset.title || '';
                  dateF.value = b.dataset.date || '';
                  startF.value = (b.dataset.start || '').slice(0, 5);
                  endF.value = (b.dataset.end || '').slice(0, 5);
                  typeF.value = b.dataset.actype || '';
                  sortF.value = b.dataset.sort || '0';
                  if (notesF) notesF.value = b.dataset.notes || '';
                  const roles = (b.dataset.roles || '').split(',').filter(Boolean);
                  rolesWrap?.querySelectorAll('input[name=roles]').forEach((cb) => { cb.checked = roles.includes(cb.value); });
                  if (respF) respF.value = b.dataset.respId || '';
                  formTitle.textContent = 'Править событие #' + b.dataset.id;
                  submit.innerHTML = '<i class="bi bi-check-lg text-[18px]" aria-hidden="true"></i>Обновить событие';
                  reset.classList.remove('hidden');
                  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  titleF.focus();
                });
              });
            })();
          </script>
        </div>
      )}
    </section>

    {/* ===== ЧЕК-ЛИСТЫ ===== */}
    <section>
      <h2 class="mb-4 text-[20px] font-bold text-navy-950 md:text-[24px]">Чек-листы</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <form id="checklist-form" method="POST" action="/api/portal/shift/admin" class={cardCls}>
          <input type="hidden" name="action" value="upsertChecklist" />
          <input type="hidden" name="id" id="cl-id" value="" />
          <div class="mb-3 flex items-center justify-between">
            <h3 id="cl-form-title" class="text-[16px] font-semibold text-navy-950">Создать шаблон чек-листа</h3>
            <button type="button" id="cl-reset" class="hidden text-base text-body-muted hover:text-primary">
              <i class="bi bi-x-lg text-[12px]" aria-hidden="true"></i> Отмена правки
            </button>
          </div>
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class={labelCls} for="cl-key">Ключ</label>
                <input id="cl-key" class={inputCls} name="key" placeholder="zaezd" />
              </div>
              <div>
                <label class={labelCls} for="cl-title">Название</label>
                <input id="cl-title" class={inputCls} name="title" required placeholder="Приёмка детей" />
              </div>
            </div>
            <div>
              <label class={labelCls} for="cl-items">Пункты (по одному в строке)</label>
              <textarea id="cl-items" class={inputCls + ' min-h-[140px]'} name="items" placeholder="Встретить группу
Проверить документы
Заселить"></textarea>
            </div>
            <button id="cl-submit" class={btnCls}><i class="bi bi-plus-lg text-[18px]" aria-hidden="true"></i>Сохранить шаблон</button>
          </div>
        </form>

        <div class={cardCls}>
          <h3 class="mb-3 text-[16px] font-semibold text-navy-950">Шаблоны ({checklists.length})</h3>
          {checklists.length === 0 ? (
            <p class="text-[16px] text-body-muted">Шаблонов пока нет.</p>
          ) : (
            <ul class="space-y-2 max-h-[480px] overflow-auto">
              {checklists.map((cl) => (
                <li class="flex flex-wrap items-center gap-2 rounded-[10px] border border-border px-3 py-2">
                  <div class="min-w-0 flex-1">
                    <div class="text-base text-navy-950">{cl.title}</div>
                    <div class="text-[12px] text-body-muted">#{cl.id}{cl.key ? ` · ${cl.key}` : ''} · {cl.items.length} пунктов</div>
                  </div>
                  <button type="button"
                          class="cl-edit rounded-[8px] border border-border px-2.5 py-1 text-[12px] font-medium text-body-muted transition hover:border-primary hover:text-primary"
                          data-id={cl.id}
                          data-key={cl.key ?? ''}
                          data-title={cl.title}
                          data-items={cl.items.map((i) => i.text).join('\n')}>
                    <i class="bi bi-pencil text-[12px]" aria-hidden="true"></i> Править
                  </button>
                  <form method="POST" action="/api/portal/shift/admin" onsubmit={`return confirm('Удалить шаблон «${cl.title}»? Это удалит все привязки и отметки.')`}>
                    <input type="hidden" name="action" value="deleteChecklist" />
                    <input type="hidden" name="id" value={cl.id} />
                    <button type="submit" class="rounded-[8px] border border-red-300 px-2.5 py-1 text-[12px] font-medium text-red-700 transition hover:bg-red-50">
                      <i class="bi bi-trash3 text-[12px]" aria-hidden="true"></i>
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </div>
        <script is:inline>
          (() => {
            const form = document.getElementById('checklist-form');
            const idF = document.getElementById('cl-id');
            const keyF = document.getElementById('cl-key');
            const titleF = document.getElementById('cl-title');
            const itemsF = document.getElementById('cl-items');
            const reset = document.getElementById('cl-reset');
            const formTitle = document.getElementById('cl-form-title');
            const submit = document.getElementById('cl-submit');
            function resetForm() {
              idF.value = '';
              keyF.value = '';
              titleF.value = '';
              itemsF.value = '';
              formTitle.textContent = 'Создать шаблон чек-листа';
              submit.innerHTML = '<i class="bi bi-plus-lg text-[18px]" aria-hidden="true"></i>Сохранить шаблон';
              reset.classList.add('hidden');
            }
            reset.addEventListener('click', resetForm);
            document.querySelectorAll('.cl-edit').forEach((b) => {
              b.addEventListener('click', () => {
                idF.value = b.dataset.id || '';
                keyF.value = b.dataset.key || '';
                titleF.value = b.dataset.title || '';
                itemsF.value = b.dataset.items || '';
                formTitle.textContent = 'Править шаблон #' + b.dataset.id;
                submit.innerHTML = '<i class="bi bi-check-lg text-[18px]" aria-hidden="true"></i>Обновить шаблон';
                reset.classList.remove('hidden');
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                titleF.focus();
              });
            });
          })();
        </script>
      </div>
    </section>

    {/* ===== ПРИВЯЗКА ЧЕК-ЛИСТА К СОБЫТИЮ ===== */}
    <section>
      <h2 class="mb-4 text-[20px] font-bold text-navy-950 md:text-[24px]">Привязать чек-лист к событию</h2>
      {(!activeShift || events.length === 0 || checklists.length === 0) ? (
        <p class={cardCls + ' text-[16px] text-body-muted'}>Нужны как минимум одно событие и один шаблон чек-листа.</p>
      ) : (
        <form method="POST" action="/api/portal/shift/admin" class={cardCls}>
          <input type="hidden" name="action" value="attachChecklist" />
          <div class="grid gap-3 lg:grid-cols-2">
            <div>
              <label class={labelCls} for="at-event">Событие</label>
              <select id="at-event" class={inputCls} name="event_id" required>
                {events.map((e) => (
                  <option value={e.id}>{e.date.slice(5)} {fmtTime(e.start_time)} — {e.title} (#{e.id})</option>
                ))}
              </select>
            </div>
            <div>
              <label class={labelCls} for="at-checklist">Чек-лист</label>
              <select id="at-checklist" class={inputCls} name="checklist_id" required>
                {checklists.map((cl) => (
                  <option value={cl.id}>{cl.title} (#{cl.id})</option>
                ))}
              </select>
            </div>
          </div>
          <div class="mt-3">
            <span class={labelCls}>Кому виден чек-лист (роли)</span>
            <div class="flex flex-wrap gap-3">
              {ROLE_OPTIONS.map((r) => (
                <label class="flex items-center gap-2 text-[16px] text-body">
                  <input type="checkbox" name="roles" value={r.value} class="h-5 w-5 rounded border-border text-primary focus:ring-primary" />
                  {r.label}
                </label>
              ))}
            </div>
          </div>
          <button class={btnCls + ' mt-4'}><i class="bi bi-list-task text-[18px]" aria-hidden="true"></i>Привязать</button>
        </form>
      )}
    </section>
  </div>
</PortalLayout>
