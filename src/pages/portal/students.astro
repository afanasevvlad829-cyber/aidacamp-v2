---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { listKids } from '../../lib/portalKid';

const role = Astro.locals.portalRole!;
if (!['admin', 'rukovoditel'].includes(role)) {
  return Astro.redirect('/portal/');
}

const kids = await listKids(true);
const total = kids.length;
const active = kids.filter((k) => k.active).length;
const loggedIn = kids.filter((k) => k.last_login_at).length;

function genderEmoji(g: string | null): string {
  return g === 'M' ? 'М' : g === 'F' ? 'Ж' : '?';
}
function fmtDate(s: string | null): string {
  if (!s) return '—';
  try { return new Date(s).toLocaleString('ru-RU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); }
  catch { return s; }
}
---
<PortalLayout title="Ученики — АйДаКемп">
  <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">Ученики</h1>
      <p class="mt-2 text-[16px] text-body-muted">
        Персональные коды для входа в портал и <a href="https://ai.aidacamp.ru/" class="text-primary hover:underline">ai.aidacamp.ru</a>.
        Ребёнок вводит код на <code class="rounded bg-page px-1.5 py-0.5">/portal/login</code> → попадает в AI-студию автоматически.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 text-[14px]">
      <span class="rounded-[10px] border border-border bg-white px-3 py-1.5">Всего: <b>{total}</b></span>
      <span class="rounded-[10px] border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-emerald-800">Активны: <b>{active}</b></span>
      <span class="rounded-[10px] border border-border bg-white px-3 py-1.5">Заходили: <b>{loggedIn}</b></span>
    </div>
  </div>

  <div class="mb-3 flex flex-wrap gap-2">
    <button id="btn-print" type="button"
      class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] hover:border-primary hover:text-primary">
      <i class="bi bi-printer" aria-hidden="true"></i> Распечатать коды
    </button>
    <button id="btn-copy-all" type="button"
      class="rounded-[10px] border border-border bg-white px-3 py-1.5 text-[14px] hover:border-primary hover:text-primary">
      <i class="bi bi-clipboard" aria-hidden="true"></i> Скопировать всё (TSV)
    </button>
  </div>

  <div class="overflow-x-auto rounded-[14px] border border-border bg-white card-shadow">
    <table class="w-full text-[14px]">
      <thead class="bg-page text-left text-[12px] uppercase tracking-wide text-body-muted">
        <tr>
          <th class="w-[40px] p-2">#</th>
          <th class="p-2">Имя</th>
          <th class="w-[60px] p-2 text-center">Пол</th>
          <th class="w-[60px] p-2 text-right">Возраст</th>
          <th class="w-[80px] p-2 text-right">Комната</th>
          <th class="w-[120px] p-2 text-center">Код</th>
          <th class="w-[150px] p-2">Последний вход</th>
          <th class="w-[180px] p-2"></th>
        </tr>
      </thead>
      <tbody id="kids-tbody">
        {kids.map((k, i) => (
          <tr data-kid-row data-id={k.id} class="border-t border-border align-middle">
            <td class="p-2 text-body-muted">{i + 1}</td>
            <td class="p-2">
              <div class={`font-medium ${k.active ? 'text-navy-950' : 'text-body-muted line-through'}`}>{k.name}</div>
              {k.alfa_id && <div class="text-[12px] text-body-muted">AlfaCRM #{k.alfa_id}</div>}
            </td>
            <td class="p-2 text-center">
              <span class={`inline-flex h-6 w-6 items-center justify-center rounded-full text-[12px] font-bold text-white ${
                k.gender === 'F' ? 'bg-pink-500' : k.gender === 'M' ? 'bg-sky-500' : 'bg-slate-400'
              }`}>{genderEmoji(k.gender)}</span>
            </td>
            <td class="p-2 text-right font-mono tabular-nums">{k.age ?? '—'}</td>
            <td class="p-2 text-right font-mono tabular-nums">{k.room_number ?? '—'}</td>
            <td class="p-2 text-center">
              <code data-code class="rounded-[6px] bg-amber-50 px-2 py-1 font-mono text-[15px] font-bold tracking-wider text-amber-900 select-all">{k.code}</code>
            </td>
            <td class="p-2 text-[13px] text-body-muted">{fmtDate(k.last_login_at)}</td>
            <td class="p-2 text-right">
              <button type="button" data-regen
                class="inline-flex items-center gap-1 rounded-[8px] border border-border bg-white px-2 py-1 text-[12px] hover:border-primary hover:text-primary"
                title="Сгенерировать новый код">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> новый
              </button>
              {k.active ? (
                <button type="button" data-deactivate
                  class="inline-flex items-center gap-1 rounded-[8px] border border-transparent px-2 py-1 text-[12px] text-body-muted hover:bg-red-50 hover:text-red-600"
                  title="Отключить вход">
                  <i class="bi bi-pause-circle" aria-hidden="true"></i>
                </button>
              ) : (
                <button type="button" data-activate
                  class="inline-flex items-center gap-1 rounded-[8px] border border-transparent px-2 py-1 text-[12px] text-body-muted hover:bg-emerald-50 hover:text-emerald-700"
                  title="Включить вход">
                  <i class="bi bi-play-circle" aria-hidden="true"></i>
                </button>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script is:inline>
    async function call(action, id) {
      const r = await fetch('/api/portal/kids', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, id }), credentials: 'include',
      });
      return r.json();
    }

    document.querySelectorAll('[data-regen]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('[data-kid-row]');
        const id = Number(row.dataset.id);
        const name = row.querySelector('td:nth-child(2) .font-medium').textContent;
        if (!confirm('Сгенерировать новый код для «' + name + '»? Старый перестанет работать.')) return;
        const j = await call('regenerate_code', id);
        if (j.ok && j.code) {
          row.querySelector('[data-code]').textContent = j.code;
        } else alert('Ошибка: ' + (j.error || 'unknown'));
      });
    });
    document.querySelectorAll('[data-deactivate]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.closest('[data-kid-row]').dataset.id);
        if (!confirm('Отключить вход?')) return;
        const j = await call('deactivate', id);
        if (j.ok) location.reload(); else alert('Ошибка: ' + (j.error || ''));
      });
    });
    document.querySelectorAll('[data-activate]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.closest('[data-kid-row]').dataset.id);
        const j = await call('activate', id);
        if (j.ok) location.reload(); else alert('Ошибка: ' + (j.error || ''));
      });
    });

    document.getElementById('btn-print').addEventListener('click', () => window.print());
    document.getElementById('btn-copy-all').addEventListener('click', () => {
      const rows = Array.from(document.querySelectorAll('[data-kid-row]'));
      const tsv = ['Имя\tКомната\tКод', ...rows.map((r) => {
        const name = r.querySelector('td:nth-child(2) .font-medium').textContent;
        const room = r.querySelector('td:nth-child(5)').textContent.trim();
        const code = r.querySelector('[data-code]').textContent;
        return name + '\t' + room + '\t' + code;
      })].join('\n');
      navigator.clipboard?.writeText(tsv).then(() => alert('Скопировано: ' + rows.length + ' строк'));
    });
  </script>
</PortalLayout>
