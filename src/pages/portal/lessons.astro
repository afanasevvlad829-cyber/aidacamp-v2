---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { listLessons, type Lesson } from '../../lib/portalLesson';
import { listStaff } from '../../lib/portalStaff';
import { getActiveShift, getEventDates } from '../../lib/portalShift';
import dayjs from 'dayjs';
import 'dayjs/locale/ru';
dayjs.locale('ru');

const role = Astro.locals.portalRole;
if (!role || role === 'student') return Astro.redirect('/portal/');
const isManager = role === 'admin' || role === 'rukovoditel';
const canCreate = isManager || role === 'teacher';

const [shift, rawTeachers] = await Promise.all([getActiveShift(), listStaff()]);
const teachers = rawTeachers.filter((s) => s.active && (s.role === 'teacher' || s.role === 'admin'));

// Находим staff.id текущего пользователя (для преподавателей — автовыбор себя).
// portalSid — staff.id напрямую (вход по коду). portalSub — telegram_id (TG-вход),
// telegram_id в БД BIGINT → pg возвращает строку, сравниваем через Number().
const mySid: number | null = Astro.locals.portalSid ? Number(Astro.locals.portalSid) : null;
const myTgId = Astro.locals.portalSub ?? null;
let myStaffId: number | null = mySid;
let myStaff = mySid ? (rawTeachers.find((s) => s.id === mySid) ?? null) : null;
if (!myStaffId && myTgId != null) {
  myStaff = rawTeachers.find((s) => Number(s.telegram_id) === Number(myTgId)) ?? null;
  myStaffId = myStaff?.id ?? null;
}

const allLessons = await (shift ? listLessons({ shift_id: shift.id }) : Promise.resolve([] as Lesson[]));
// Преподаватели видят только свои уроки; менеджеры — все
const lessons = isManager ? allLessons : allLessons.filter((l) => Number(l.teacher_staff_id) === myStaffId);
const dates = await (shift ? getEventDates(shift.id) : Promise.resolve([] as string[]));

// Группируем уроки по дате для отображения
const byDate = new Map<string, Lesson[]>();
for (const l of lessons) {
  const arr = byDate.get(l.date) ?? [];
  arr.push(l);
  byDate.set(l.date, arr);
}

const STATUS_LABEL: Record<string, string> = {
  planned: 'Запланирован',
  in_progress: 'Идёт',
  done: 'Проведён',
  skipped: 'Пропущен',
  cancelled: 'Отменён',
};
const STATUS_COLOR: Record<string, string> = {
  planned: 'bg-blue-50 text-blue-700 border-blue-200',
  in_progress: 'bg-amber-50 text-amber-800 border-amber-200',
  done: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  skipped: 'bg-slate-50 text-slate-600 border-slate-200',
  cancelled: 'bg-red-50 text-red-700 border-red-200',
};

function fmtTime(t: string | null): string {
  return t ? t.slice(0, 5) : '';
}
---
<PortalLayout title="Уроки — АйДаКемп">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">Уроки</h1>
      <p class="mt-2 text-[16px] text-body-muted">
        Расписание уроков преподавателей. Тема, методичка, ожидаемый результат, прогресс детей.
      </p>
    </div>
    {canCreate && shift && (
      <button type="button" id="btn-new-lesson"
              class="inline-flex items-center gap-2 rounded-[10px] border border-primary bg-primary px-4 py-2 text-base font-semibold text-white hover:opacity-90">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        Добавить урок
      </button>
    )}
  </div>

  {!shift && (
    <div class="rounded-[12px] border border-amber-200 bg-amber-50 p-4 text-amber-900">
      Нет активной смены. Создай смену в <a href="/portal/smena/admin/" class="underline">админке сетки</a>.
    </div>
  )}

  {shift && lessons.length === 0 && (
    <div class="rounded-[12px] border border-dashed border-border bg-page p-8 text-center text-body-muted">
      Уроков пока нет. Добавь первый — нажми кнопку выше.
    </div>
  )}

  {shift && lessons.length > 0 && (
    <div class="space-y-6">
      {Array.from(byDate.entries()).map(([date, items]) => (
        <section>
          <h2 class="mb-2 text-[18px] font-semibold text-navy-950">{dayjs(date).format('D MMM, dddd')}</h2>
          <ul class="space-y-2">
            {items.map((l) => (
              <li class="rounded-[12px] border border-border bg-white p-4 card-shadow">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class:list={[
                        'inline-flex items-center rounded-full border px-2 py-0.5 text-[12px] font-medium',
                        STATUS_COLOR[l.status] ?? 'border-border bg-white',
                      ]}>{STATUS_LABEL[l.status] ?? l.status}</span>
                      {l.start_time && (
                        <span class="text-base text-body-muted">
                          <i class="bi bi-clock" aria-hidden="true"></i>
                          {fmtTime(l.start_time)}{l.end_time ? `–${fmtTime(l.end_time)}` : ''}
                        </span>
                      )}
                      {l.group_color_name && (
                        <span class="rounded-full bg-primary-soft px-2 py-0.5 text-[12px] text-primary">
                          {l.group_color_name}
                        </span>
                      )}
                    </div>
                    <h3 class="mt-1 text-[17px] font-semibold text-navy-950">{l.topic}</h3>
                    <div class="mt-1 flex flex-wrap gap-x-3 text-base text-body-muted">
                      {l.teacher_name && <span><i class="bi bi-person-badge" aria-hidden="true"></i> {l.teacher_name}</span>}
                      {l.activity_slug && <a class="text-primary hover:underline" href={`/metodichki/${l.activity_slug}/`}>методичка</a>}
                    </div>
                    {l.expected_outcome && (
                      <p class="mt-2 text-base text-navy-900"><b>Что унесут:</b> {l.expected_outcome}</p>
                    )}
                  </div>
                  <div class="flex shrink-0 flex-col gap-1">
                    <a href={`/portal/lessons/${l.id}`}
                       class="rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-primary">
                      Прогресс
                    </a>
                    {(isManager || role === 'teacher') && (
                      <button type="button" data-edit-lesson={l.id}
                              class="rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-primary">
                        Править
                      </button>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

  {/* Модалка создания/правки */}
  {canCreate && shift && (
    <dialog id="lesson-dlg" class="aida-modal-center rounded-[16px] bg-white p-0 backdrop:bg-black/40">
      <div class="aida-modal-form">
        <h2 id="lesson-dlg-title" class="mb-4 text-[20px] font-bold text-navy-950">Новый урок</h2>
        <div class="space-y-3 text-base">
          <input type="hidden" id="ln-id" />
          <label class="block">
            <span class="text-body-muted">Тема</span>
            <input id="ln-topic" type="text" required
                   class="mt-1 w-full rounded-[8px] border border-border px-3 py-2"
                   placeholder="Например: «Введение в Python — переменные и циклы»" />
          </label>
          <div class="grid grid-cols-3 gap-2">
            <label class="block">
              <span class="text-body-muted">Дата</span>
              <select id="ln-date" class="mt-1 w-full rounded-[8px] border border-border px-2 py-2">
                {dates.map((d) => (
                  <option value={d}>{dayjs(d).format('D MMM')}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="text-body-muted">Начало</span>
              <input id="ln-start" type="time" class="mt-1 w-full rounded-[8px] border border-border px-2 py-2" />
            </label>
            <label class="block">
              <span class="text-body-muted">Конец</span>
              <input id="ln-end" type="time" class="mt-1 w-full rounded-[8px] border border-border px-2 py-2" />
            </label>
          </div>
          <label class="block">
            <span class="text-body-muted">Преподаватель</span>
            {isManager ? (
              <select id="ln-teacher" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2">
                <option value="">— выбрать —</option>
                {teachers.map((t) => (
                  <option value={t.id}>{t.full_name ?? `id=${t.id}`}</option>
                ))}
              </select>
            ) : (
              <div class="mt-1">
                <input id="ln-teacher" type="hidden" value={myStaffId ?? ''} />
                <p class="rounded-[8px] border border-border bg-gray-50 px-3 py-2 text-base text-navy-950">
                  {myStaff?.full_name ?? '—'}
                </p>
              </div>
            )}
          </label>
          <label class="block">
            <span class="text-body-muted">Методичка (slug)</span>
            <input id="ln-slug" type="text" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2"
                   placeholder="например: tashkin-ai-phone" />
          </label>
          <label class="block">
            <span class="text-body-muted">Что унесут дети по итогу</span>
            <textarea id="ln-outcome" rows="2" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2"
                      placeholder="Понимают разницу между переменной и константой, написали свой калькулятор..."></textarea>
          </label>
          <label class="block">
            <span class="text-body-muted">Что нужно (инструменты / модели AI)</span>
            <input id="ln-materials" type="text" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2"
                   placeholder="Laptop, Claude Sonnet, web-IDE..." />
          </label>
          <label class="block">
            <span class="text-body-muted">Статус</span>
            <select id="ln-status" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2">
              <option value="planned">Запланирован</option>
              <option value="in_progress">Идёт</option>
              <option value="done">Проведён</option>
              <option value="skipped">Пропущен</option>
              <option value="cancelled">Отменён</option>
            </select>
          </label>
        </div>
        <div id="ln-error" style="display:none" class="mt-3 rounded-[8px] border border-red-200 bg-red-50 px-3 py-2 text-base text-red-700">
          <span id="ln-error-text"></span>
          <button type="button" id="ln-report-btn"
                  class="ml-2 underline text-red-600 hover:text-red-800" style="display:none">
            Сообщить администратору
          </button>
          <span id="ln-report-sent" class="ml-2 text-emerald-600" style="display:none">✓ Отправлено</span>
        </div>
        <div class="mt-4 flex justify-end gap-2">
          <button type="button" id="ln-cancel" class="rounded-[8px] border border-border bg-white px-4 py-2 text-base">Отмена</button>
          <button type="button" id="ln-save" class="rounded-[8px] border border-primary bg-primary px-4 py-2 text-base font-semibold text-white">
            Сохранить
          </button>
        </div>
      </div>
    </dialog>
  )}

  <script define:vars={{ shiftId: shift?.id ?? 0, isManager, myStaffId }}>
    const dlg = document.getElementById('lesson-dlg');
    const openBtn = document.getElementById('btn-new-lesson');
    const cancelBtn = document.getElementById('ln-cancel');
    const saveBtn = document.getElementById('ln-save');
    const ttl = document.getElementById('lesson-dlg-title');
    const errBox     = document.getElementById('ln-error');
    const errText    = document.getElementById('ln-error-text');
    const reportBtn  = document.getElementById('ln-report-btn');
    const reportSent = document.getElementById('ln-report-sent');
    let lastError = '';

    function showErr(msg) {
      lastError = msg;
      if (errText) errText.textContent = msg;
      if (errBox) errBox.style.display = 'block';
      if (reportBtn) reportBtn.style.display = 'inline';
      if (reportSent) reportSent.style.display = 'none';
    }
    function clearErr() {
      lastError = '';
      if (errBox) errBox.style.display = 'none';
      if (errText) errText.textContent = '';
      if (reportBtn) reportBtn.style.display = 'none';
      if (reportSent) reportSent.style.display = 'none';
    }

    if (reportBtn) {
      reportBtn.addEventListener('click', async () => {
        reportBtn.textContent = 'Отправляю…';
        reportBtn.disabled = true;
        try {
          await fetch('/api/portal/error-report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              error: lastError,
              context: `myStaffId=${myStaffId ?? '?'} isManager=${isManager}`,
              url: window.location.href,
            }),
          });
          reportBtn.style.display = 'none';
          if (reportSent) reportSent.style.display = 'inline';
        } catch {
          reportBtn.textContent = 'Сообщить администратору';
          reportBtn.disabled = false;
        }
      });
    }
    const fields = {
      id: 'ln-id', topic: 'ln-topic', date: 'ln-date', start: 'ln-start', end: 'ln-end',
      teacher: 'ln-teacher', slug: 'ln-slug', outcome: 'ln-outcome',
      materials: 'ln-materials', status: 'ln-status',
    };
    function val(k) { return document.getElementById(fields[k]).value; }
    function set(k, v) { document.getElementById(fields[k]).value = v ?? ''; }
    function reset() {
      clearErr();
      set('id', ''); set('topic', ''); set('start', ''); set('end', '');
      // Для преподавателя всегда подставляем его id; для менеджера — сбрасываем
      set('teacher', isManager ? '' : (myStaffId ?? ''));
      set('slug', ''); set('outcome', ''); set('materials', '');
      set('status', 'planned');
      if (ttl) ttl.textContent = 'Новый урок';
    }
    if (openBtn) openBtn.addEventListener('click', () => { reset(); dlg?.showModal(); });
    if (cancelBtn) cancelBtn.addEventListener('click', () => dlg?.close());
    if (saveBtn) saveBtn.addEventListener('click', async () => {
      const body = {
        action: 'upsert',
        id: val('id') || undefined,
        shift_id: shiftId,
        date: val('date'),
        start_time: val('start') || null,
        end_time: val('end') || null,
        teacher_staff_id: Number(val('teacher')),
        activity_slug: val('slug') || null,
        topic: val('topic').trim(),
        expected_outcome: val('outcome') || null,
        materials_needed: val('materials') || null,
        status: val('status'),
      };
      if (!body.topic || !body.teacher_staff_id || !body.date) {
        showErr('Заполни тему, преподавателя и дату');
        return;
      }
      clearErr();
      saveBtn.disabled = true;
      try {
        const r = await fetch('/api/portal/lesson', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'Ошибка сервера');
        location.reload();
      } catch (e) {
        showErr(e.message || String(e));
        saveBtn.disabled = false;
      }
    });

    document.querySelectorAll('[data-edit-lesson]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.editLesson;
        const r = await fetch('/api/portal/lesson?shift_id=' + shiftId);
        const j = await r.json();
        const l = (j.lessons || []).find((x) => String(x.id) === String(id));
        if (!l) return;
        set('id', l.id); set('topic', l.topic); set('date', l.date);
        set('start', (l.start_time || '').slice(0, 5));
        set('end', (l.end_time || '').slice(0, 5));
        set('teacher', l.teacher_staff_id);
        set('slug', l.activity_slug || '');
        set('outcome', l.expected_outcome || '');
        set('materials', l.materials_needed || '');
        set('status', l.status);
        if (ttl) ttl.textContent = 'Править урок #' + l.id;
        dlg?.showModal();
      });
    });
  </script>
</PortalLayout>
