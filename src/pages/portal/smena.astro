                    </span>
                  )}
                </div>
                {(e.event_type || e.activity_type) && (
                  <span class={`mt-1 inline-block rounded-[8px] border px-2 py-0.5 text-[14px] font-medium ${eventColorClass(e.event_type ?? e.activity_type)}`}>
                    {EVENT_TYPE_LABELS[(e.event_type ?? e.activity_type) as string] ?? (e.event_type ?? e.activity_type)}
                  </span>
                )}

                {/* Главный ответственный — бейдж в заголовке. Если не назначен, покажем подсказку */}
                {!e.responsible_staff_id && (
                  <div class="mt-1.5 text-[13px] text-amber-700">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i> Ответственный не назначен
                  </div>
                )}

                {/* Self-check для подъёма */}
                {e.event_type === 'wakeup' && (
                  <div class="mt-3 portal-wakeup rounded-[12px] border border-dashed border-amber-200 bg-amber-50/50 p-3"
                       data-event-id={e.id}>
                    <div class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wide text-amber-800">
                      <i class="bi bi-sun" aria-hidden="true"></i>
                      Кто встал — каждый отмечает себя
                    </div>
                    <ul class="portal-wakeup__list mt-2 space-y-1 text-[15px]"></ul>
                    <p class="portal-wakeup__loading text-[13px] text-body-muted">загружаю…</p>
                  </div>
                )}

                {/* Заметки и материалы — с авто-ссылками */}
                {e.notes && (
                  <div class="mt-3 rounded-[10px] border border-amber-200 bg-amber-50 px-3 py-2 text-[14px] text-amber-900">
                    <i class="bi bi-sticky text-[13px]" aria-hidden="true"></i>
                    <span class="ml-1 whitespace-pre-wrap" set:html={linkifyNotes(e.notes)}></span>
                  </div>
                )}

                {/* Блок «Методичка» — показываем только если реально привязана */}
                {e.event_type === 'lesson' && e.activity_slug && getActivity(e.activity_slug) && (
                  <div class="mt-3">
                    <a
                      href={`/portal/metodichki/${e.activity_slug}/`}
                      class="inline-flex items-center gap-2 rounded-[10px] border border-primary bg-primary-soft px-3 py-2 text-[15px] font-medium text-primary transition hover:opacity-90"
                    >
                      <i class="bi bi-book-half" aria-hidden="true"></i>
                      Методичка: {getActivity(e.activity_slug)!.title}
                    </a>
                  </div>
                )}

                {/* Блок «Контент-задание» (если есть — показываем подсказку «что снимать») */}
                {e.content_task && (
                  <div class="mt-3 rounded-[12px] border border-dashed border-border bg-amber-50/40 p-3">
                    <div class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wide text-amber-700">
                      <i class="bi bi-camera" aria-hidden="true"></i>
                      Контент-задание{e.content_task.content_type ? ` · ${CONTENT_TYPE_LABELS[e.content_task.content_type] ?? e.content_task.content_type}` : ''}
                    </div>
                    {e.content_task.brief && (
                      <div class="mt-1 text-[16px] text-navy-950">{e.content_task.brief}</div>
