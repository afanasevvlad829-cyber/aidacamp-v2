---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { verifySessionPayload } from '../../lib/portalSession';
import {
  getActiveShift, getEvents, getEventDates, getDone, listShifts,
  listContentTaskTemplates, getChecklists, upsertEvent, type ShiftEvent, type ContentTaskTemplate,
} from '../../lib/portalShift';
import { listStaff } from '../../lib/portalStaff';
import { listLessons, type Lesson } from '../../lib/portalLesson';
import { listPhotosByDay } from '../../lib/portalPhoto';
import DenCard from '../../components/portal/den/DenCard.astro';
import DaySummary from '../../components/portal/den/DaySummary.astro';
import ChecklistModal from '../../components/portal/den/ChecklistModal.astro';
import '../../styles/portal-den.css';

// Доступ гейтит middleware: /portal/* доступен только сотрудникам (не ученикам).
const role = Astro.locals.portalRole!;
const sub = verifySessionPayload(
  Astro.cookies.get('portal_session')?.value,
  process.env.PORTAL_SESSION_SECRET ?? '',
)?.sub;

const allShifts = (await listShifts()) ?? [];
const reqShiftId = Number(Astro.url.searchParams.get('shift') || 0);
const shift = reqShiftId
  ? (allShifts.find((s) => s.id === reqShiftId) ?? (await getActiveShift()))
  : await getActiveShift();

let events: ShiftEvent[] = [];
let dates: string[] = [];
let doneSet: string[] = [];
let staff: { id: number; name: string }[] = [];
let library: ContentTaskTemplate[] = [];
let checklistLib: { id: number; title: string; items: { id: string; text: string }[] }[] = [];

if (shift) {
  events = await getEvents(shift.id);
  dates = await getEventDates(shift.id);
  doneSet = sub ? [...(await getDone(sub, shift.id))] : [];
  const st = (await listStaff()) ?? [];
  staff = st.filter((s) => s.active && s.full_name).map((s) => ({ id: s.id, name: s.full_name! }));
  library = await listContentTaskTemplates();
  checklistLib = (await getChecklists()) ?? [];
}

// День по умолчанию: сегодня (если входит в смену), иначе ближайший будущий, иначе первый.
function pickDefaultDate(all: string[]): string {
  if (all.length === 0) return '';
  const today = new Date().toISOString().slice(0, 10);
  if (all.includes(today)) return today;
  const future = all.find((d) => d >= today);
  return future || all[0];
}
const selectedDate = Astro.url.searchParams.get('date') || pickDefaultDate(dates);

// Итоговый блок «Материалы дня» — служебное событие-контейнер для общих фото/видео дня.
const DAY_SUMMARY_TITLE = '📦 Материалы дня';
let dayPhotos: Awaited<ReturnType<typeof listPhotosByDay>> = [];
let summaryEvent: ShiftEvent | undefined;
let summaryEventId: number | null = null;
if (shift && selectedDate) {
  summaryEvent = events.find((e) => e.date === selectedDate && e.title === DAY_SUMMARY_TITLE);
  if (summaryEvent) {
    summaryEventId = summaryEvent.id;
  } else {
    // Создаём служебный блок-контейнер для общих материалов дня (скрыт из таймлайна).
    summaryEventId = await upsertEvent({
      shiftId: shift.id, date: selectedDate, start_time: '23:59', end_time: null,
      title: DAY_SUMMARY_TITLE, activity_type: null, roles: [], sort: 9999,
    });
  }
  dayPhotos = await listPhotosByDay(shift.id, selectedDate);
}
const dayEvents = events
  .filter((e) => e.date === selectedDate && e.title !== DAY_SUMMARY_TITLE)
  .sort((a, b) => (a.start_time || '').localeCompare(b.start_time || '') || a.sort - b.sort);

// Уроки текущего дня
const dayLessons: Lesson[] = shift && selectedDate
  ? await listLessons({ shift_id: shift.id, date: selectedDate })
  : [];

// Объединённая раскладка по времени: события + уроки в одну временну́ю шкалу
const timeMap = new Map<string, { events: ShiftEvent[]; lessons: Lesson[] }>();
const getSlot = (t: string) => {
  if (!timeMap.has(t)) timeMap.set(t, { events: [], lessons: [] });
  return timeMap.get(t)!;
};
for (const e of dayEvents) getSlot((e.start_time || '').slice(0, 5)).events.push(e);
for (const l of dayLessons) getSlot((l.start_time || '').slice(0, 5)).lessons.push(l);
const timeline = [...timeMap.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([time, slot]) => ({ time, ...slot }));

---

<PortalLayout title="Конструктор дня · АйДаКемп">
  <div class="den" data-shift={shift?.id ?? ''} data-date={selectedDate} data-summary-title={DAY_SUMMARY_TITLE}>
    <header class="den-head">
      <div>
        <h1 class="den-title">Конструктор дня</h1>
        <p class="den-sub">{shift ? shift.name : 'Нет активной смены'}</p>
      </div>
      {allShifts.length > 1 && (
        <form method="get" class="den-controls">
          <select name="shift" class="den-input" onchange="this.form.submit()">
            {allShifts.map((s) => (
              <option value={s.id} selected={s.id === shift?.id}>{s.name}</option>
            ))}
          </select>
        </form>
      )}
      {role === 'admin' && shift && (
        <button type="button" id="copy-shift-btn" class="den-copy" style="margin-left:auto">
          📋 Создать смену на основе этой
        </button>
      )}
    </header>

    {/* Диалог копирования смены — показывается только админу */}
    {role === 'admin' && shift && (
      <dialog id="copy-shift-dialog" style="border:none;border-radius:16px;padding:28px 24px;max-width:380px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,.18)">
        <form method="dialog" id="copy-shift-form">
          <h3 style="margin:0 0 16px;font-size:18px;font-weight:700">Создать смену на основе «{shift.name}»</h3>
          <div style="display:flex;flex-direction:column;gap:12px">
            <label style="font-size:14px;font-weight:600">
              Название новой смены
              <input type="text" id="cs-name" class="den-input" required placeholder="Смена №2 — лето 2026" style="margin-top:4px;width:100%;box-sizing:border-box" />
            </label>
            <label style="font-size:14px;font-weight:600">
              Дата начала
              <input type="date" id="cs-start" class="den-input" required style="margin-top:4px;width:100%;box-sizing:border-box" />
            </label>
            <label style="font-size:14px;font-weight:600">
              Дата окончания
              <input type="date" id="cs-end" class="den-input" required style="margin-top:4px;width:100%;box-sizing:border-box" />
            </label>
          </div>
          <div id="cs-error" style="display:none;margin-top:12px;padding:10px 12px;background:#fee2e2;border-radius:8px;color:#b91c1c;font-size:14px"></div>
          <div style="display:flex;gap:10px;margin-top:20px">
            <button type="submit" id="cs-submit" class="den-save" style="flex:1">Создать</button>
            <button type="button" id="cs-cancel" class="den-copy" style="flex:0 0 auto">Отмена</button>
          </div>
        </form>
      </dialog>
    )}

    {shift && dates.length > 0 && (
      <nav class="den-days">
        {dates.map((d, i) => (
          <a href={`/portal/den?shift=${shift.id}&date=${d}`}
             class={`den-day${d === selectedDate ? ' active' : ''}`}>
            <span class="den-day-n">День {i + 1}</span>
            <span class="den-day-d">{d.slice(8, 10)}.{d.slice(5, 7)}</span>
          </a>
        ))}
      </nav>
    )}

    {!shift && <div class="den-empty">Создайте смену в конструкторе, чтобы собрать день.</div>}

    {shift && (
      <div class="den-timeline">
        {timeline.length === 0 && <div class="den-empty">На этот день пока нет блоков. Добавьте первый ниже.</div>}

        {timeline.map(({ time, events: tevents, lessons: tlessons }) => (
          <div class="den-row">
            <div class="den-time">{time || '—'}</div>
            <div class="den-cards">
              {tevents.map((e) => (
                <DenCard event={e} staff={staff} library={library} checklistLib={checklistLib} doneSet={doneSet} />
              ))}
              {tlessons.map((l) => (
                <article class="den-card den-card--lesson">
                  <div class="den-card-main" style="cursor:default">
                    <div class="den-card-title">{l.topic}</div>
                    <div class="den-card-meta">
                      <span class="den-badge den-badge--lesson-lbl"><i class="bi bi-book" aria-hidden="true"></i> Урок</span>
                      {l.teacher_name && <span class="den-badge resp"><i class="bi bi-person-badge" aria-hidden="true"></i> {l.teacher_name}</span>}
                      {l.group_color_name && <span class="den-badge tk">{l.group_color_name}</span>}
                      {l.end_time && <span class="den-badge" style="background:#f1f5f9;color:#64748b">{(l.start_time||'').slice(0,5)}–{l.end_time.slice(0,5)}</span>}
                    </div>
                    {l.expected_outcome && <div class="den-card-note">{l.expected_outcome}</div>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        <div class="den-add">
          <h3>Добавить блок</h3>
          <div class="den-add-row">
            <input type="time" id="add-time" class="den-input">
            <input type="text" id="add-title" class="den-input" placeholder="Название блока">
            <button type="button" id="add-btn" class="den-save">+ Добавить</button>
          </div>
          <button type="button" id="copy-day" class="den-copy">📋 Скопировать этот день на другую дату</button>
        </div>

        <DaySummary summaryEventId={summaryEventId ?? ''} photos={dayPhotos} />
      </div>
    )}
  </div>

  <ChecklistModal />

  <script src="../../scripts/portal/den.ts"></script>

  {role === 'admin' && shift && (
    <script is:inline define:vars={{ shiftId: shift.id }}>
      (function () {
        var btn = document.getElementById('copy-shift-btn');
        var dlg = document.getElementById('copy-shift-dialog');
        var form = document.getElementById('copy-shift-form');
        var errBox = document.getElementById('cs-error');
        var submitBtn = document.getElementById('cs-submit');
        var cancelBtn = document.getElementById('cs-cancel');
        if (!btn || !dlg || !form) return;

        btn.addEventListener('click', function () {
          errBox.style.display = 'none';
          dlg.showModal();
        });
        cancelBtn.addEventListener('click', function () { dlg.close(); });
        dlg.addEventListener('click', function (e) {
          if (e.target === dlg) dlg.close();
        });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var name = document.getElementById('cs-name').value.trim();
          var start = document.getElementById('cs-start').value;
          var end = document.getElementById('cs-end').value;
          if (!name || !start || !end) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Создаю…';
          errBox.style.display = 'none';

          fetch('/api/portal/shift/copy-shift', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ source_shift_id: shiftId, name: name, start_date: start, end_date: end }),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.ok) {
                window.location.href = '/portal/smena?shift=' + data.shift_id;
              } else {
                errBox.textContent = data.error || 'Ошибка сервера';
                errBox.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Создать';
              }
            })
            .catch(function (err) {
              errBox.textContent = 'Сетевая ошибка: ' + (err && err.message ? err.message : err);
              errBox.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = 'Создать';
            });
        });
      })();
    </script>
  )}
</PortalLayout>
