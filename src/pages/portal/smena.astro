                </div>

                {canEditEvent(role, e.roles) && !['routine', 'bedtime'].includes(e.event_type ?? '') && (
                  <div class="mt-3 portal-edit" data-event-id={e.id}>
                    <button type="button" class="portal-edit__toggle hidden">
                      <i class="bi bi-pencil text-[14px]" aria-hidden="true"></i>
                      Править
                    </button>
                    <form class="portal-edit__form mt-3 hidden space-y-3 rounded-[12px] border border-border bg-white p-4">
                      <div>
                        <label class="block text-[13px] font-medium text-body-muted">Название</label>
                        <input type="text" name="title" value={e.title} class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" />
                      </div>
                      <div class="flex gap-3">
                        <div class="flex-1">
                          <label class="block text-[13px] font-medium text-body-muted">Начало</label>
                          <input type="time" name="start_time" value={e.start_time?.slice(0, 5) ?? ''} class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" />
                        </div>
                        <div class="flex-1">
                          <label class="block text-[13px] font-medium text-body-muted">Конец</label>
                          <input type="time" name="end_time" value={e.end_time?.slice(0, 5) ?? ''} class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" />
                        </div>
                      </div>
                      {isManager && (
                        <div>
                          <label class="block text-[13px] font-medium text-body-muted">Главный ответственный</label>
                          <select name="responsible_staff_id" class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary">
                            <option value="">— не назначен (штрафы пойдут руководителю смены) —</option>
                            {responsibleOptions.map((s) => (
                              <option value={s.id} selected={e.responsible_staff_id === s.id}>
                                {s.full_name ?? `id=${s.id}`}{s.role ? ` · ${s.role}` : ''}
                              </option>
                            ))}
                          </select>
                          <p class="mt-1 text-[12px] text-body-muted">
                            На этого человека пойдут автоштрафы за невыполненные чек-листы и пропущенные фото.
                          </p>
                        </div>
                      )}
                      <div>
                        <label class="block text-[13px] font-medium text-body-muted">Заметки и материалы</label>
                        <p class="mt-0.5 text-[12px] text-body-muted">Можно вставлять ссылки — они автоматически станут кликабельными.</p>
                        <textarea name="notes" rows="3" data-voice data-voice-append class="mt-1 w-full rounded-[8px] border border-border px-3 py-2 text-[15px] outline-none focus:border-primary" placeholder="План занятия, ссылки на материалы, пометки для смены…">{e.notes ?? ''}</textarea>
                      </div>
                      <div class="flex gap-2">
                        <button type="submit" class="rounded-[10px] bg-primary px-4 py-2 text-[14px] font-semibold text-white transition hover:opacity-90">Сохранить</button>
                        <button type="button" class="portal-edit__cancel rounded-[10px] border border-border bg-white px-4 py-2 text-[14px] font-medium text-body-muted transition hover:border-primary hover:text-primary">Отмена</button>
                        <span class="portal-edit__status ml-auto self-center text-[13px] text-body-muted hidden"></span>
                      </div>
                    </form>
                  </div>
                )}

                {myChecklists.length === 0 ? (
                  <p class="mt-3 text-[16px] text-body-muted">Чек-листов для вашей роли нет.</p>
                ) : (
                  <div class="mt-4 space-y-4">
                    {myChecklists.map((cl) => (
                      <div>
                        <h3 class="mb-2 flex items-center gap-2 text-[16px] font-semibold text-navy-950">
                          <i class="bi bi-list-task text-[18px] text-primary" aria-hidden="true"></i>
                          {cl.title}
                        </h3>
                        <ul class="space-y-2">
                          {cl.items.map((it) => {
                            const key = `${e.id}:${cl.checklist_id}:${it.id}`;
                            const checked = done.has(key);
                            return (
                              <li>
                                <label class="flex cursor-pointer items-start gap-3 text-[16px] text-body">
                                  <input
                                    type="checkbox"
                                    class="smena-check mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-border text-primary focus:ring-primary"
                                    checked={checked}
                                    data-event={e.id}
                                    data-checklist={cl.checklist_id}
                                    data-item={it.id}
                                  />
                                  <span>{it.text}</span>
                                </label>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
              </article>
            );
          })();
          })}
        </section>
      )}

      {/* ===== ACTIVITY VIEW ===== */}
      {view === 'activity' && (
        <section class="space-y-8">
          {activityGroups.length === 0 && (
            <p class="rounded-[16px] border border-border bg-white p-6 text-[16px] text-body-muted card-shadow">
              Событий пока нет.
            </p>
          )}
          {activityGroups.map((g) => (
            <div>
              <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950">{g.label}</h2>
              <div class="space-y-2">
                {g.events.map((e) => (
                  <article class="flex flex-wrap items-baseline justify-between gap-2 rounded-[14px] border border-border bg-white p-4 card-shadow">
                    <span class="text-[16px] font-semibold text-navy-950">{e.title}</span>
                    <span class="text-[16px] text-body-muted">
                      {fmtDate(e.date)}{timeRange(e) ? ` · ${timeRange(e)}` : ''}
                    </span>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>
      )}

      {/* ===== MATRIX VIEW ===== */}
      {view === 'matrix' && (
        <section class="overflow-auto rounded-[16px] border border-border bg-white card-shadow">
          {dates.length === 0 ? (
            <p class="p-6 text-[16px] text-body-muted">Событий пока нет.</p>
          ) : (
            <table class="w-full min-w-[640px] border-collapse text-[16px]">
              <thead>
                <tr>
                  <th class="border-b border-border bg-page px-4 py-3 text-left font-semibold text-navy-950">
                    День
                  </th>
                  {MATRIX_ROLES.map((r) => (
                    <th class="border-b border-l border-border bg-page px-4 py-3 text-left font-semibold text-navy-950">
                      {roleLabel(r)}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {dates.map((d) => (
                  <tr>
                    <td class="border-b border-border px-4 py-3 align-top font-medium text-navy-950 whitespace-nowrap">
                      {fmtDate(d)}
                    </td>
                    {MATRIX_ROLES.map((r) => {
                      const cells = cellEvents(d, r);
                      return (
                        <td class="border-b border-l border-border px-3 py-2 align-top text-body">
                          {cells.length === 0 ? (
                            <span class="text-body-muted">—</span>
                          ) : (
                            <ul class="space-y-1">
                              {cells.map((e) => {
                                const actor = eventActor(e);
                                return (
                                  <li>
                                    <a
                                      href={`/portal/smena?view=role&date=${e.date}`}
                                      class={`inline-flex max-w-full items-center gap-1.5 rounded-[6px] border px-2 py-0.5 text-[13px] leading-snug ${eventColorClass(e.event_type ?? e.activity_type)}`}
                                      title={actor ? `${e.title} · ${actor}` : e.title}
                                    >
                                      <span class="font-mono text-[11px] opacity-70">{fmtTime(e.start_time)}</span>
                                      <span class="truncate">{e.title}</span>
                                      {actor && <span class="text-[11px] font-semibold opacity-70">· {actor}</span>}
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      )}
    </>
  )}

  <script is:inline>
    (() => {
      const boxes = document.querySelectorAll('.smena-check');
      boxes.forEach((box) => {
        box.addEventListener('change', async () => {
          const eventId = Number(box.dataset.event);
          const checklistId = Number(box.dataset.checklist);
          const itemId = box.dataset.item;
          const intended = box.checked;
          box.disabled = true;
          try {
            const res = await fetch('/api/portal/shift/check', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ eventId, checklistId, itemId }),
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              box.checked = !intended;
              alert('Не удалось сохранить отметку. Попробуйте ещё раз.');
            } else {
              box.checked = data.done;
            }
          } catch {
            box.checked = !intended;
            alert('Нет связи с сервером. Отметка не сохранена.');
          } finally {
            box.disabled = false;
          }
        });
      });
    })();
  </script>

  {/* Self-check для подъёма — клиентский рендер списка staff и кнопки «я встал». */}
  <script is:inline src="https://cdn.jsdelivr.net/npm/dayjs@1.11.10/dayjs.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/dayjs@1.11.10/locale/ru.js"></script>
  <script is:inline>
    (() => {
      if (window.dayjs && window.dayjs.locale) window.dayjs.locale('ru');
      function fmtTime(iso) {
        try {
          const d = window.dayjs ? window.dayjs(iso) : null;
          if (d && d.isValid()) return d.format('HH:mm');
          return typeof iso === 'string' ? iso : '';
        } catch { return typeof iso === 'string' ? iso : ''; }
      }
      const wraps = document.querySelectorAll('.portal-wakeup');
      wraps.forEach(async (wrap) => {
        const eventId = wrap.dataset.eventId;
        if (!eventId) return;
        const list = wrap.querySelector('.portal-wakeup__list');
        const loading = wrap.querySelector('.portal-wakeup__loading');
        try {
          const r = await fetch('/api/portal/self-check?event_id=' + encodeURIComponent(eventId), { credentials: 'include' });
          const j = await r.json();
          loading && (loading.style.display = 'none');
          if (!j.ok) { list.innerHTML = '<li class="text-body-muted">не удалось загрузить</li>'; return; }
          const me = j.me_staff_id;
          const rows = (j.rows || []);
          if (rows.length === 0) {
            list.innerHTML = '<li class="text-body-muted">нет активных сотрудников</li>';
            return;
          }
          list.innerHTML = rows.map((r) => {
            const isMe = me != null && Number(r.staff_id) === Number(me);
            const checked = !!r.checked_at;
            const name = (r.full_name || ('id=' + r.staff_id));
            const role = r.role ? (' · ' + r.role) : '';
            const status = checked
              ? '<span class="text-emerald-700"><i class="bi bi-check-circle-fill"></i> встал в ' + fmtTime(r.checked_at) + '</span>'
              : '<span class="text-amber-700"><i class="bi bi-hourglass"></i> ещё нет</span>';
            const myBtn = isMe && !checked
              ? '<button type="button" data-mark="' + eventId + '" class="ml-2 rounded-[8px] bg-primary px-3 py-1 text-[13px] font-medium text-white hover:opacity-90">Я встал</button>'
              : (isMe && checked
                ? '<button type="button" data-unmark="' + eventId + '" class="ml-2 rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-primary">Снять</button>'
                : '');
            return '<li class="flex flex-wrap items-center justify-between gap-2 rounded-[8px] border border-border bg-white px-3 py-1.5">'
              + '<span><b>' + name + '</b>' + role + '</span>'
              + '<span class="flex items-center gap-1.5">' + status + myBtn + '</span>'
              + '</li>';
          }).join('');
        } catch (e) {
          loading && (loading.textContent = 'ошибка: ' + (e && e.message ? e.message : e));
        }
      });

      document.addEventListener('click', async (ev) => {
        const target = ev.target;
        const btn = target && target.closest && target.closest('button[data-mark],button[data-unmark]');
        if (!btn) return;
        const eventId = btn.dataset.mark || btn.dataset.unmark;
        const action = btn.dataset.mark ? 'mark' : 'unmark';
        btn.disabled = true;
        try {
          const r = await fetch('/api/portal/self-check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ action, event_id: Number(eventId) }),
          });
          const j = await r.json();
          if (!j.ok) throw new Error(j.error || 'error');
          // Перерисуем список этой карточки
          const wrap = document.querySelector('.portal-wakeup[data-event-id="' + eventId + '"]');
          if (wrap) wrap.querySelector('.portal-wakeup__list').innerHTML = '';
          // Простейший способ — повторно дернуть GET вручную
          const gr = await fetch('/api/portal/self-check?event_id=' + encodeURIComponent(eventId), { credentials: 'include' });
          const gj = await gr.json();
          if (gj.ok && wrap) {
            // Рендер инлайн без выноса в функцию, чтобы не плодить код
            const me = gj.me_staff_id;
            const list = wrap.querySelector('.portal-wakeup__list');
            list.innerHTML = (gj.rows || []).map((r) => {
              const isMe = me != null && Number(r.staff_id) === Number(me);
              const checked = !!r.checked_at;
              const name = (r.full_name || ('id=' + r.staff_id));
              const role = r.role ? (' · ' + r.role) : '';
              const status = checked
                ? '<span class="text-emerald-700"><i class="bi bi-check-circle-fill"></i> встал в ' + ((window.dayjs && window.dayjs(r.checked_at).isValid()) ? window.dayjs(r.checked_at).format('HH:mm') : (r.checked_at || '')) + '</span>'
                : '<span class="text-amber-700"><i class="bi bi-hourglass"></i> ещё нет</span>';
              const myBtn = isMe && !checked
                ? '<button type="button" data-mark="' + eventId + '" class="ml-2 rounded-[8px] bg-primary px-3 py-1 text-[13px] font-medium text-white hover:opacity-90">Я встал</button>'
                : (isMe && checked
                  ? '<button type="button" data-unmark="' + eventId + '" class="ml-2 rounded-[8px] border border-border bg-white px-3 py-1 text-[12px] font-medium text-body-muted hover:border-primary">Снять</button>'
                  : '');
              return '<li class="flex flex-wrap items-center justify-between gap-2 rounded-[8px] border border-border bg-white px-3 py-1.5">'
                + '<span><b>' + name + '</b>' + role + '</span>'
                + '<span class="flex items-center gap-1.5">' + status + myBtn + '</span>'
                + '</li>';
            }).join('');
          }
        } catch (e) {
          alert('Ошибка: ' + (e && e.message ? e.message : e));
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
</PortalLayout>
