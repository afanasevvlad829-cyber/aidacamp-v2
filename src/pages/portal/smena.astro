                          </summary>
                          <div class="px-2 pb-2">
                            <MediaManager entityType="event" entityId={e.id} accept="image/*,video/*" note="Снять или выбрать" />
                          </div>
                        </details>
                        {myChecklists.length > 0 && (
                          <ul class="mt-2 space-y-1">
                            {myChecklists.flatMap((cl) =>
                              (cl.items as any[]).map((it) => {
                                const key = `${e.id}:${cl.checklist_id}:${it.id}`;
                                const done = doneSet.has(key);
                                return (
                                  <li class="flex items-start gap-2 rounded-[8px] border border-border bg-white px-2 py-1.5 text-[13px]">
                                    <input type="checkbox"
                                           class="smena-check mt-0.5 h-4 w-4"
                                           data-event={e.id}
                                           data-checklist={cl.checklist_id}
                                           data-item={it.id}
                                           checked={done} />
                                    <span class={done ? 'line-through text-body-muted' : ''}>{it.text}</span>
                                  </li>
                                );
