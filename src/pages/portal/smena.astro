---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { verifySessionPayload } from '../../lib/portalSession';
import { roleAllowed } from '../../lib/portalShiftRoles';
import { getActiveShift, getEvents, getEventDates, getDone, listShifts, EVENT_TYPE_LABELS, eventColorClass, type ShiftEvent } from '../../lib/portalShift';
import { listStaff } from '../../lib/portalStaff';
import { getActivity } from '../../lib/portalActivities';
import { canEditEvent } from '../../lib/portalShiftPerms';
import NoShift from '../../components/portal/smena/NoShift.astro';
import ShiftHeader from '../../components/portal/smena/ShiftHeader.astro';
import DayView from '../../components/portal/smena/DayView.astro';
import ActivityView from '../../components/portal/smena/ActivityView.astro';
import MatrixView from '../../components/portal/smena/MatrixView.astro';
import DupEventDialog from '../../components/portal/smena/DupEventDialog.astro';

const role = Astro.locals.portalRole!;
const sub = verifySessionPayload(
  Astro.cookies.get('portal_session')?.value,
  process.env.PORTAL_SESSION_SECRET ?? '',
)?.sub;

const allShifts = (await listShifts()) ?? [];
const reqShiftId = Number(Astro.url.searchParams.get('shift') || 0);
const shift =
  allShifts.find((sh) => sh.id === reqShiftId) ?? (await getActiveShift()) ?? allShifts[0] ?? null;

// Виды и подписи табов.
type View = 'day' | 'activity' | 'matrix';
const VIEWS: { key: View; label: string; icon: string }[] = [
  { key: 'day', label: 'Все события дня', icon: 'calendar-week' },
  { key: 'activity', label: 'По активностям', icon: 'tag' },
  { key: 'matrix', label: 'Шахматка', icon: 'kanban' },
];
const rawView = Astro.url.searchParams.get('view');
const isManagerView = role === 'admin' || role === 'rukovoditel';
const view: View = (VIEWS.some((v) => v.key === rawView) ? rawView : 'day') as View;

// Выбор даты
function isoToday(): string {
  return new Date().toISOString().slice(0, 10);
}
const today = isoToday();
let selectedDate = Astro.url.searchParams.get('date') ?? '';
if (shift) {
  const inShift = today >= shift.start_date && today <= shift.end_date;
  if (!selectedDate || !/^\d{4}-\d{2}-\d{2}$/.test(selectedDate)) {
    selectedDate = inShift ? today : shift.start_date;
  }
}

const dates = shift ? await getEventDates(shift.id) : [];

const fullShiftView = view === 'activity' || view === 'matrix';
const events: ShiftEvent[] = shift
  ? await getEvents(shift.id, fullShiftView ? undefined : selectedDate)
  : [];
const doneSet = shift && sub ? await getDone(sub, shift.id) : new Set<string>();

const staffList = view === 'matrix' ? await listStaff() : [];
const isManager = role === 'admin' || role === 'rukovoditel';
const responsibleOptions = isManager ? (await listStaff()).filter((s) => s.active) : [];
const staffNameByKey = new Map<string, string>();
for (const s of staffList) {
  if (s.staff_key && s.full_name) {
    staffNameByKey.set(s.staff_key, s.full_name.split(/\s+/)[0]);
  }
}

function byTime(a: ShiftEvent, b: ShiftEvent): number {
  return (a.start_time ?? '99').localeCompare(b.start_time ?? '99') || a.sort - b.sort;
}

const allDayEvents = events.filter((e) => e.date === selectedDate).sort(byTime);

// Медиа-счётчики
async function loadMediaCounts(eventIds: number[]): Promise<Map<number, number>> {
  if (eventIds.length === 0) return new Map();
  const conn = process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN || '';
  if (!conn) return new Map();
  const { default: pg } = await import('pg');
  const c = new pg.Client({ connectionString: conn });
  await c.connect();
  try {
    const r = await c.query(
      `SELECT COALESCE(entity_id, event_id) AS eid, COUNT(*)::int AS n
         FROM archive_photo
        WHERE (entity_type='event' AND entity_id = ANY($1::bigint[]))
           OR (entity_type IS NULL AND event_id = ANY($1::bigint[]))
        GROUP BY 1`,
      [eventIds],
    );
    const m = new Map<number, number>();
    for (const row of r.rows) m.set(Number(row.eid), Number(row.n));
    return m;
  } finally { await c.end(); }
}
const mediaCounts = await loadMediaCounts(allDayEvents.map((e) => Number(e.id)));

// Ответственные
const ownerMap = new Map<number, string>();
for (const e of allDayEvents) {
  if (e.responsible_staff_id && e.responsible_name) {
    ownerMap.set(e.responsible_staff_id, e.responsible_name);
  }
}

async function staffIdByTg(tg: number | null | undefined): Promise<number | null> {
  if (tg == null) return null;
  const conn = process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN || '';
  if (!conn) return null;
  const { default: pg } = await import('pg');
  const c = new pg.Client({ connectionString: conn });
  await c.connect();
  try {
    const r = await c.query('SELECT id FROM portal_staff WHERE telegram_id=$1', [tg]);
    return r.rows[0] ? Number(r.rows[0].id) : null;
  } finally { await c.end(); }
}
const mySid = await staffIdByTg((Astro.locals as any).portalSub);

const rawOwner = Astro.url.searchParams.get('owner');
let activeOwner: number | 'all' = 'all';
if (rawOwner === 'all') activeOwner = 'all';
else if (rawOwner) activeOwner = Number(rawOwner) || 'all';
else if (!isManagerView && mySid && ownerMap.has(mySid)) activeOwner = mySid;

const roleEvents = activeOwner === 'all'
  ? allDayEvents
  : allDayEvents.filter((e) => e.responsible_staff_id === activeOwner);

function slotKey(e: any): string { return `${e.start_time ?? ''}|${e.end_time ?? ''}`; }
const slots: Array<{ key: string; events: any[] }> = (() => {
  const m = new Map<string, any[]>();
  for (const e of roleEvents) {
    const k = slotKey(e);
    const arr = m.get(k) ?? [];
    arr.push(e);
    m.set(k, arr);
  }
  return Array.from(m.entries()).map(([key, events]) => ({ key, events }));
})();

function ownerHref(o: number | 'all'): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (o === 'all') params.delete('owner');
  else params.set('owner', String(o));
  return Astro.url.pathname + '?' + params.toString();
}

// Activity view
const activityGroups = (() => {
  const map = new Map<string, ShiftEvent[]>();
  for (const e of events) {
    const k = (e.event_type ?? e.activity_type ?? 'other') as string;
    const arr = map.get(k) ?? [];
    arr.push(e);
    map.set(k, arr);
  }
  return [...map.entries()]
    .sort((a, b) => (EVENT_TYPE_LABELS[a[0]] ?? a[0]).localeCompare(EVENT_TYPE_LABELS[b[0]] ?? b[0]))
    .map(([type, evs]) => ({
      type,
      label: EVENT_TYPE_LABELS[type] ?? type,
      events: [...evs].sort((a, b) => a.date.localeCompare(b.date) || byTime(a, b)),
    }));
})();

const showDateNav = view === 'day';
const isAdminLike = role === 'admin' || role === 'rukovoditel';

const CONTENT_TYPE_LABELS: Record<string, string> = {
  photo: 'Фото',
  video: 'Видео',
  interview: 'Интервью',
  group_photo: 'Групповое',
  timelapse: 'Таймлапс',
};
---

<PortalLayout title="Сетка смены — АйДаКемп">
  {!shift ? (
    <NoShift isAdminLike={isAdminLike} />
  ) : (
    <>
      <ShiftHeader
        shift={shift}
        allShifts={allShifts}
        view={view}
        selectedDate={selectedDate}
        dates={dates}
        showDateNav={showDateNav}
      />

      {view === 'day' && (
        <DayView
          role={role}
          isManagerView={isManagerView}
          isManager={isManager}
          isAdminLike={isAdminLike}
          activeOwner={activeOwner}
          ownerMap={ownerMap}
          ownerHref={ownerHref}
          roleEvents={roleEvents}
          slots={slots}
          doneSet={doneSet}
          mediaCounts={mediaCounts}
          responsibleOptions={responsibleOptions}
          CONTENT_TYPE_LABELS={CONTENT_TYPE_LABELS}
        />
      )}

      {view === 'activity' && (
        <ActivityView activityGroups={activityGroups} />
      )}

      {view === 'matrix' && (
        <MatrixView
          dates={dates}
          events={events}
          staffNameByKey={staffNameByKey}
        />
      )}

      {isAdminLike && responsibleOptions.length > 0 && (
        <DupEventDialog responsibleOptions={responsibleOptions} />
      )}
    </>
  )}

  <script is:inline src="https://cdn.jsdelivr.net/npm/dayjs@1.11.10/dayjs.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/dayjs@1.11.10/locale/ru.js"></script>
  <script is:inline>if (window.dayjs && window.dayjs.locale) window.dayjs.locale('ru');</script>
  <script src="../../scripts/portal/smena.ts"></script>
</PortalLayout>
