                            )}
                          </ul>
                        )}
                      </article>
                    </div>
                  );
                })}
              </div>
            ) : (() => {
            const e = slot.events[0];
            // Админ/руководитель видит ВСЕ чек-листы события, остальные — только свои по роли.
            const myChecklists = isManagerView ? e.checklists : e.checklists.filter((cl) => roleAllowed(role, cl.roles));
            return (
              <article class="rounded-[16px] border border-border bg-white p-5 card-shadow">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="flex items-baseline gap-2 text-[18px] font-semibold text-navy-950">
