---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { verifySessionPayload } from '../../lib/portalSession';
import { roleAllowed } from '../../lib/portalShiftRoles';
import { getActiveShift, getEvents, getEventDates, getDone, listShifts, EVENT_TYPE_LABELS, eventColorClass, type ShiftEvent } from '../../lib/portalShift';
import { listStaff } from '../../lib/portalStaff';
import { getActivity } from '../../lib/portalActivities';
import { canEditEvent } from '../../lib/portalShiftPerms';
import PortalUploader from '../../components/portal/UppyUploader.astro';
import MediaManager from '../../components/portal/MediaManager.astro';

const role = Astro.locals.portalRole!;
const sub = verifySessionPayload(
  Astro.cookies.get('portal_session')?.value,
  process.env.PORTAL_SESSION_SECRET ?? '',
)?.sub;

const allShifts = (await listShifts()) ?? [];
const reqShiftId = Number(Astro.url.searchParams.get('shift') || 0);
const shift =
  allShifts.find((sh) => sh.id === reqShiftId) ?? (await getActiveShift()) ?? allShifts[0] ?? null;

// Виды и подписи табов.
type View = 'day' | 'activity' | 'matrix';
const VIEWS: { key: View; label: string; icon: string }[] = [
  { key: 'day', label: 'Все события дня', icon: 'calendar-week' },
  { key: 'activity', label: 'По активностям', icon: 'tag' },
  { key: 'matrix', label: 'Шахматка', icon: 'kanban' },
];
const rawView = Astro.url.searchParams.get('view');
// «Мой день» убрали — все видят всё, ответственного назначает руководитель смены.
const isManagerView = role === 'admin' || role === 'rukovoditel';
const view: View = (VIEWS.some((v) => v.key === rawView) ? rawView : 'day') as View;

// Выбор даты: ?date=, иначе сегодня (если в пределах смены), иначе старт смены.
function isoToday(): string {
  return new Date().toISOString().slice(0, 10);
}
const today = isoToday();
let selectedDate = Astro.url.searchParams.get('date') ?? '';
if (shift) {
  const inShift = today >= shift.start_date && today <= shift.end_date;
  if (!selectedDate || !/^\d{4}-\d{2}-\d{2}$/.test(selectedDate)) {
    selectedDate = inShift ? today : shift.start_date;
  }
}

// Список дат смены — нужен навигации по дням и шахматке (дёшево, без загрузки событий).
const dates = shift ? await getEventDates(shift.id) : [];

// События грузим под выбранный вид:
//  - role/day работают по одной дате → грузим только её события;
//  - activity/matrix — обзор всей смены → грузим все.
const fullShiftView = view === 'activity' || view === 'matrix';
const events: ShiftEvent[] = shift
  ? await getEvents(shift.id, fullShiftView ? undefined : selectedDate)
  : [];
const done = shift && sub ? await getDone(sub, shift.id) : new Set<string>();

// Карта staff_key → краткое имя для подписей в шахматке.
const staffList = view === 'matrix' ? await listStaff() : [];
// Для inline-формы «Править событие» — список активных staff (нужен админу/руководителю
// чтобы назначать «Главного ответственного»).
const isManager = role === 'admin' || role === 'rukovoditel';
const responsibleOptions = isManager ? (await listStaff()).filter((s) => s.active) : [];
const staffNameByKey = new Map<string, string>();
for (const s of staffList) {
  if (s.staff_key && s.full_name) {
    // Берём имя (первое слово) — компактнее в плашке
    staffNameByKey.set(s.staff_key, s.full_name.split(/\s+/)[0]);
  }
}
/** Превратить URL в строке в кликабельные ссылки (escape XSS, target=_blank). */
function linkifyNotes(text: string): string {
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const re = /(https?:\/\/[^\s)<>]+)/g;
  let out = '';
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    out += esc(text.slice(last, m.index));
    const url = m[0];
    out += `<a href="${esc(url)}" target="_blank" rel="noopener" class="text-primary underline hover:opacity-80">${esc(url)}</a>`;
    last = m.index + url.length;
  }
  out += esc(text.slice(last));
  return out;
}
function eventActor(e: ShiftEvent): string {
  if (!e.staff_keys || e.staff_keys.length === 0) return '';
  const names = e.staff_keys.map((k) => staffNameByKey.get(k)).filter(Boolean) as string[];
  return names.length > 0 ? names.join(', ') : '';
}

function fmtTime(t: string | null): string {
  return t ? t.slice(0, 5) : '';
}
function timeRange(e: ShiftEvent): string {
  const a = fmtTime(e.start_time);
  const b = fmtTime(e.end_time);
  if (a && b) return `${a}–${b}`;
  return a || b || '';
}
// Двух-буквенные инициалы из имени: «Варвара Мухортова» → «ВМ», «Омар» → «ОМ»
function initials(name: string | null | undefined): string {
  if (!name) return '??';
  const parts = String(name).trim().split(/\s+/);
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return parts[0].slice(0, 2).toUpperCase();
}
const BADGE_PALETTE = [
  'bg-amber-100 text-amber-900 border-amber-300',
  'bg-blue-100 text-blue-900 border-blue-300',
  'bg-emerald-100 text-emerald-900 border-emerald-300',
  'bg-pink-100 text-pink-900 border-pink-300',
  'bg-purple-100 text-purple-900 border-purple-300',
  'bg-cyan-100 text-cyan-900 border-cyan-300',
  'bg-orange-100 text-orange-900 border-orange-300',
  'bg-indigo-100 text-indigo-900 border-indigo-300',
];
function badgeColor(id: number | null | undefined): string {
  if (id == null) return 'bg-slate-100 text-slate-700 border-slate-300';
  return BADGE_PALETTE[Math.abs(id) % BADGE_PALETTE.length];
}

function byTime(a: ShiftEvent, b: ShiftEvent): number {
  return (a.start_time ?? '99').localeCompare(b.start_time ?? '99') || a.sort - b.sort;
}

const ROLE_LABEL: Record<string, string> = {
  teacher: 'Учитель',
  vozhaty: 'Вожатый',
  rukovoditel: 'Руководитель',
  student: 'Ученик',
  admin: 'Админ',
};
function roleLabel(r: string): string {
  return ROLE_LABEL[r] ?? r;
}

// --- role view: события роли на дату + чек-листы роли ---
// Админ/руководитель видит ВСЕ события дня даже в «Моём дне», т.к. отвечает за всю смену.
// «Мой день» убрали: лента дня — все события без фильтра по роли. Все видят всё,
// чек-листы и галочки доступны каждому, ответственного назначает руководитель.
const allDayEvents = events.filter((e) => e.date === selectedDate).sort(byTime);

// Уникальные «ответственные» на сегодня — для вкладок по человеку
const ownerMap = new Map<number, string>();
for (const e of allDayEvents) {
  if (e.responsible_staff_id && e.responsible_name) {
    ownerMap.set(e.responsible_staff_id, e.responsible_name);
  }
}
const owners = Array.from(ownerMap.entries()).map(([id, name]) => ({ id, name }));

// Найти свой staff_id (для дефолта вкладки преподавателя/вожатого)
async function staffIdByTg(tg: number | null | undefined): Promise<number | null> {
  if (tg == null) return null;
  const conn = process.env.AIDAPLUS_PG_DSN || process.env.PG_DSN || '';
  if (!conn) return null;
  const { default: pg } = await import('pg');
  const c = new pg.Client({ connectionString: conn });
  await c.connect();
  try {
    const r = await c.query('SELECT id FROM portal_staff WHERE telegram_id=$1', [tg]);
    return r.rows[0] ? Number(r.rows[0].id) : null;
  } finally { await c.end(); }
}
const mySid = await staffIdByTg((Astro.locals as any).portalSub);

// Парам ?owner=<id>; для teacher/vozhaty дефолт — свой id, если он есть в owners.
// Для admin/rukovoditel дефолт — все.
const rawOwner = Astro.url.searchParams.get('owner');
let activeOwner: number | 'all' = 'all';
if (rawOwner === 'all') activeOwner = 'all';
else if (rawOwner) activeOwner = Number(rawOwner) || 'all';
else if (!isManagerView && mySid && ownerMap.has(mySid)) activeOwner = mySid;

const roleEvents = activeOwner === 'all'
  ? allDayEvents
  : allDayEvents.filter((e) => e.responsible_staff_id === activeOwner);

// Группируем по слоту (start_time + end_time). Слот = «уникальное время на таймлайне».
// Если в слоте несколько событий — будем рендерить карточку с табами параллельных.
function slotKey(e: any): string { return `${e.start_time ?? ''}|${e.end_time ?? ''}`; }
const slots: Array<{ key: string; events: any[] }> = (() => {
  const m = new Map<string, any[]>();
  for (const e of roleEvents) {
    const k = slotKey(e);
    const arr = m.get(k) ?? [];
    arr.push(e);
    m.set(k, arr);
  }
  return Array.from(m.entries()).map(([key, events]) => ({ key, events }));
})();

function ownerHref(o: number | 'all'): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (o === 'all') params.delete('owner');
  else params.set('owner', String(o));
  return Astro.url.pathname + '?' + params.toString();
}

// --- day view: все события даты ---
const dayEvents = events.filter((e) => e.date === selectedDate).sort(byTime);

// --- activity view: группировка по event_type ---
const activityGroups = (() => {
  const map = new Map<string, ShiftEvent[]>();
  for (const e of events) {
    const k = (e.event_type ?? e.activity_type ?? 'other') as string;
    const arr = map.get(k) ?? [];
    arr.push(e);
    map.set(k, arr);
  }
  return [...map.entries()]
    .sort((a, b) => (EVENT_TYPE_LABELS[a[0]] ?? a[0]).localeCompare(EVENT_TYPE_LABELS[b[0]] ?? b[0]))
    .map(([type, evs]) => ({
      type,
      label: EVENT_TYPE_LABELS[type] ?? type,
      events: [...evs].sort((a, b) => a.date.localeCompare(b.date) || byTime(a, b)),
    }));
})();

// --- matrix view: дни × роли ---
const MATRIX_ROLES = ['teacher', 'vozhaty', 'rukovoditel'];
function cellEvents(date: string, r: string): ShiftEvent[] {
  return events.filter((e) => e.date === date && e.roles.includes(r)).sort(byTime);
}

// Хелпер построения ссылки таба/даты.
function viewHref(v: View): string {
  const p = new URLSearchParams();
  if (shift) p.set('shift', String(shift.id));
  p.set('view', v);
  if (selectedDate) p.set('date', selectedDate);
  return `/portal/smena?${p.toString()}`;
}
function dateHref(d: string): string {
  const p = new URLSearchParams();
  if (shift) p.set('shift', String(shift.id));
  p.set('view', view);
  p.set('date', d);
  return `/portal/smena?${p.toString()}`;
}
function shiftHref(id: number): string {
  return `/portal/smena?shift=${id}&view=${view}`;
}

const MONTHS_RU=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
function fmtDate(iso){ const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(iso); return m? Number(m[3])+' '+MONTHS_RU[Number(m[2])-1] : iso; }
const showDateNav = view === 'day';
const isAdminLike = role === 'admin' || role === 'rukovoditel';

const CONTENT_TYPE_LABELS: Record<string, string> = {
  photo: 'Фото',
  video: 'Видео',
  interview: 'Интервью',
  group_photo: 'Групповое',
  timelapse: 'Таймлапс',
};
---

<PortalLayout title="Сетка смены — АйДаКемп">
  {!shift ? (
    <div class="rounded-[16px] border border-border bg-white p-8 text-center card-shadow">
      <span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-[14px] bg-primary-soft text-primary">
        <i class="bi bi-calendar-week text-[28px]" aria-hidden="true"></i>
      </span>
      <h1 class="text-[24px] font-bold text-navy-950">Смена ещё не создана</h1>
      <p class="mt-2 text-[16px] text-body-muted">
        Активной смены пока нет. Расписание появится, когда смена будет создана.
      </p>
      {isAdminLike && (
        <a
          href="/portal/smena/admin"
          class="mt-5 inline-flex items-center gap-2 rounded-[12px] bg-primary px-5 py-3 text-[16px] font-semibold text-white transition hover:bg-primary-hover"
        >
          <i class="bi bi-kanban text-[18px]" aria-hidden="true"></i>
          Управление сеткой
        </a>
      )}
    </div>
  ) : (
    <>
      <div class="mb-4">
        <div class="flex items-center justify-between gap-2">
          <h1 class="truncate text-[18px] font-bold tracking-[-0.02em] text-navy-950 md:text-[28px]">
            {shift.name}
          </h1>
          {isAdminLike && (
            <a
              href="/portal/smena/admin"
              title="Управление сеткой"
              aria-label="Управление сеткой"
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border border-border bg-white text-body-muted transition hover:border-primary hover:text-primary md:h-auto md:w-auto md:gap-2 md:px-4 md:py-2"
            >
              <i class="bi bi-kanban text-[16px]" aria-hidden="true"></i>
              <span class="hidden md:inline">Управление</span>
            </a>
          )}
        </div>

        {allShifts.length > 1 && (
          <nav class="mt-4 flex flex-wrap gap-2" aria-label="Выбор смены">
            {allShifts.map((sh) => (
              <a
                href={shiftHref(sh.id)}
                class={`inline-flex items-center gap-2 rounded-[12px] border px-4 py-2 text-[15px] font-medium transition ${
                  shift && sh.id === shift.id
                    ? 'border-primary bg-primary text-white'
                    : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary'
                }`}
              >
                <i class="bi bi-calendar-week text-[16px]" aria-hidden="true"></i>
                {sh.name}
              </a>
            ))}
          </nav>
        )}

        {/* Табы видов — на мобилке только иконки, на десктопе с подписями */}
        <nav class="mt-3 flex flex-wrap gap-2" aria-label="Виды расписания">
          {VIEWS.map((v) => (
            <a
              href={viewHref(v.key)}
              title={v.label}
              aria-label={v.label}
              class:list={[
                'inline-flex h-9 w-9 items-center justify-center rounded-[10px] border font-medium transition md:h-auto md:w-auto md:gap-2 md:px-4 md:py-2 md:text-[16px]',
                v.key === view
                  ? 'border-primary bg-primary text-white'
                  : 'border-border bg-white text-body-muted hover:border-primary hover:text-primary',
              ]}
            >
              <i class={`bi bi-${v.icon} text-[16px] md:text-[18px]`} aria-hidden="true"></i>
              <span class="hidden md:inline">{v.label}</span>
            </a>
          ))}
        </nav>

        {/* Навигация по датам — показываем сегодня + 3 будущих, остальные раскрываем кнопкой */}
        {showDateNav && dates.length > 0 && (
          <div class="mt-3" aria-label="Дни смены">
            {(() => {
              const today = new Date().toISOString().slice(0, 10);
              // Найдём индекс «опорной» даты: либо selectedDate, либо ближайшая к сегодня
              const refIdx = (() => {
                const i = dates.indexOf(selectedDate);
                if (i >= 0) return i;
                const j = dates.findIndex((d) => d >= today);
                return j >= 0 ? j : 0;
              })();
              const startIdx = Math.max(0, refIdx);
              const visibleEnd = Math.min(dates.length, startIdx + 4);
              const visible = dates.slice(startIdx, visibleEnd);
              const past = dates.slice(0, startIdx);
              const future = dates.slice(visibleEnd);
              const hidden = past.length + future.length;
              return (
                <>
                  <div class="flex flex-wrap items-center gap-1.5">
                    {visible.map((d) => (
                      <a
                        href={dateHref(d)}
                        class:list={[
                          'rounded-[10px] border px-2.5 py-1.5 text-[13px] font-medium transition md:text-[14px]',
                          d === selectedDate
                            ? 'border-primary bg-primary-soft text-primary'
                            : 'border-border bg-white text-body-muted hover:border-primary',
                        ]}
                      >
                        {fmtDate(d)}
                      </a>
                    ))}
                    {hidden > 0 && (
                      <button
                        type="button"
                        id="dates-toggle"
                        title="Показать все"
                        aria-label="Показать все даты"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-[10px] border border-border bg-white text-body-muted hover:border-primary"
                      >
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                      </button>
                    )}
                  </div>
                  {hidden > 0 && (
                    <div id="dates-extra" class="mt-1.5 hidden flex-wrap gap-1.5">
                      {[...past, ...future].map((d) => (
                        <a
                          href={dateHref(d)}
                          class:list={[
                            'rounded-[10px] border px-2.5 py-1.5 text-[13px] font-medium transition md:text-[14px]',
                            d === selectedDate
                              ? 'border-primary bg-primary-soft text-primary'
                              : 'border-border bg-white text-body-muted opacity-70 hover:border-primary hover:opacity-100',
                          ]}
                        >
                          {fmtDate(d)}
                        </a>
                      ))}
                    </div>
                  )}
                </>
              );
            })()}
          </div>
        )}

        <script is:inline>
          (() => {
            const btn = document.getElementById('dates-toggle');
            const extra = document.getElementById('dates-extra');
            if (!btn || !extra) return;
            btn.addEventListener('click', () => {
              extra.classList.toggle('hidden');
              extra.classList.toggle('flex');
            });
          })();
        </script>
      </div>

      {/* Вкладки по ответственным (показываем когда есть 2+ разных). */}
      {view === 'day' && owners.length >= 2 && (
        <nav class="mb-4 -mx-1 overflow-x-auto px-1" aria-label="Ответственные">
          <div class="flex gap-1.5">
            <a href={ownerHref('all')}
               class:list={[
                 'shrink-0 rounded-[10px] border px-3 py-1.5 text-[13px] font-medium transition md:text-[14px]',
                 activeOwner === 'all'
                   ? 'border-primary bg-primary text-white'
                   : 'border-border bg-white text-body-muted hover:border-primary',
               ]}>
              <i class="bi bi-people mr-1" aria-hidden="true"></i>
              Все ({allDayEvents.length})
            </a>
            {owners.map((o) => {
              const cnt = allDayEvents.filter((e) => e.responsible_staff_id === o.id).length;
              return (
                <a href={ownerHref(o.id)}
                   class:list={[
                     'shrink-0 rounded-[10px] border px-3 py-1.5 text-[13px] font-medium transition md:text-[14px]',
                     activeOwner === o.id
                       ? 'border-primary bg-primary text-white'
                       : 'border-border bg-white text-body-muted hover:border-primary',
                   ]}>
                  {o.name} <span class="opacity-70">({cnt})</span>
                </a>
              );
            })}
          </div>
        </nav>
      )}

      {/* ===== ROLE VIEW ===== */}
      {view === 'day' && (
        <section class="space-y-4">
          {roleEvents.length === 0 && (
            <p class="rounded-[16px] border border-border bg-white p-6 text-[16px] text-body-muted card-shadow">
              {activeOwner === 'all'
                ? 'На этот день событий нет.'
                : 'У этого ответственного на сегодня событий нет.'}
            </p>
          )}
          {slots.map((slot) => {
            const isParallel = slot.events.length > 1;
            const slotId = 'slot-' + slot.events[0].id;
            return isParallel ? (
              <div class="parallel-slot rounded-[16px] border border-primary/30 bg-primary-soft/30 p-2 card-shadow" data-slot-id={slotId}>
                <div class="mb-2 flex items-center justify-between gap-2 px-2 pt-1">
                  <span class="inline-flex items-center gap-1 text-[14px] font-semibold text-primary">
                    <i class="bi bi-stack" aria-hidden="true"></i>
                    Параллельные: {slot.events.length}
                  </span>
                  <div class="flex items-center gap-1.5">
                    {slot.events.map((e) => e.responsible_staff_id && (
                      <span class={`inline-flex h-7 w-7 items-center justify-center rounded-full border text-[11px] font-bold ${badgeColor(e.responsible_staff_id)}`}
                            title={e.responsible_name ?? ''}>
                        {initials(e.responsible_name)}
                      </span>
                    ))}
                    <span class="ml-1 text-[13px] text-body-muted">{timeRange(slot.events[0])}</span>
                  </div>
                </div>
                <nav class="parallel-slot__tabs mb-2 -mx-1 flex gap-1 overflow-x-auto px-1" aria-label="Параллельные события">
                  {slot.events.map((e, idx) => (
                    <button type="button"
                            data-slot-tab={slotId}
                            data-target={'panel-' + e.id}
                            class:list={[
                              'shrink-0 rounded-[10px] border px-3 py-1.5 text-[13px] font-medium transition',
                              idx === 0 ? 'border-primary bg-primary text-white' : 'border-border bg-white text-body-muted',
                            ]}>
                      {e.responsible_name ?? e.title}
                    </button>
                  ))}
                </nav>
                {slot.events.map((e, idx) => {
                  const myChecklists = isManagerView ? e.checklists : e.checklists.filter((cl) => roleAllowed(role, cl.roles));
                  return (
                    <div data-slot-panel={slotId} id={'panel-' + e.id} class:list={['parallel-slot__panel', idx === 0 ? '' : 'hidden']}>
                      <Fragment set:html={''} />
                      {/* Используем общий рендер из основной map ниже — но нам нужен компактный inline. */}
                      <article class="rounded-[14px] border border-border bg-white p-4">
                        <div class="flex items-baseline gap-2">
                          <h2 class="text-[16px] font-semibold text-navy-950 flex-1 truncate">{e.title}</h2>
                          {canEditEvent(role, e.roles) && (
                            <button type="button" data-edit-title-for={e.id} title="Править"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-[8px] border border-border text-body-muted">
                              <i class="bi bi-pencil text-[12px]"></i>
                            </button>
                          )}
                        </div>
                        <div class="mt-1 text-[13px]">
                          <span class="text-body-muted">Отв:</span>{' '}
