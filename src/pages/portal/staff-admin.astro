---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { listStaff } from '../../lib/portalStaff';
import { listInvites } from '../../lib/portalInvite';

if (Astro.locals.portalRole !== 'admin') return Astro.redirect('/portal/');

// listStaff и listInvites независимы — запрашиваем параллельно
const [staff, invites] = await Promise.all([listStaff(), listInvites()]);
const activeInvites = invites.filter((i) => !i.revoked && !i.used_at && new Date(i.expires_at) > new Date());
const usedInvites = invites.filter((i) => i.used_at);
const baseUrl = Astro.url.origin;
const ROLE_LABEL: Record<string, string> = {
  admin: 'Админ', rukovoditel: 'Руководитель',
  teacher: 'Преподаватель', vozhaty: 'Вожатый', student: 'Ученик',
};

// Pending: telegram_id есть, role нет, staff_key нет
const pending = staff.filter((s) => s.telegram_id != null && s.role == null && s.staff_key == null);
// Placeholder: telegram_id нет (staff_key опционален — add-manual может создать без ключа)
const placeholders = staff.filter((s) => s.telegram_id == null);
// Для выпадайки «привязать к должности» — только активные placeholder
const activePlaceholders = placeholders.filter((p) => p.active);
// Linked: telegram_id есть, role есть
const linked = staff.filter((s) => s.telegram_id != null && s.role != null);
const active = linked.filter((s) => s.active);
const inactive = linked.filter((s) => !s.active);

const ROLES = ['teacher', 'vozhaty', 'rukovoditel', 'admin'];
const ROLE_LABELS: Record<string, string> = {
  admin: 'Админ',
  rukovoditel: 'Руководитель',
  teacher: 'Преподаватель',
  vozhaty: 'Вожатый',
  student: 'Ученик',
};
const roleLabel = (r: string | null | undefined): string => (r ? ROLE_LABELS[r] ?? r : '');
---

<PortalLayout title="Сотрудники — АйДаКемп">
  <h1 class="mb-6 text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
    Сотрудники
  </h1>

  <!-- INVITES: сразу после h1 -->
  <section class="mb-8 rounded-[16px] border border-emerald-200 bg-emerald-50/40 p-5 card-shadow">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="flex items-center gap-2 text-[18px] font-semibold text-navy-950">
        <i class="bi bi-send text-emerald-700" aria-hidden="true"></i>
        Приглашения
        <span class="text-base font-normal text-body-muted">· активных: {activeInvites.length}</span>
      </h2>
      <button id="btn-new-invite" type="button"
        class="rounded-[10px] border border-emerald-600 bg-emerald-600 text-white px-3 py-1.5 text-base hover:opacity-90">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        Новое приглашение
      </button>
    </div>
    <p class="mb-3 text-base text-body-muted">
      Создаёшь приглашение — получаешь ссылку. Отправляешь сотруднику в Telegram. Он переходит, авторизуется через TG, и его аккаунт сразу активен с теми ролями, что ты указал.
    </p>

    {activeInvites.length > 0 && (
      <div class="space-y-2">
        {activeInvites.map((inv) => (
          <div class="flex flex-wrap items-center gap-2 rounded-[10px] border border-border bg-white p-3" data-invite-row data-id={inv.id}>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                {inv.name && <span class="font-medium text-navy-950">{inv.name}</span>}
                {inv.roles.map((r) => (
                  <span class="rounded-full bg-primary-soft px-2 py-0.5 text-[12px] font-medium text-primary">{ROLE_LABEL[r] ?? r}</span>
                ))}
                <span class="text-[12px] text-body-muted">истекает {new Date(inv.expires_at).toLocaleDateString('ru-RU')}</span>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-2">
                <code class="select-all rounded bg-page px-2 py-1 font-mono text-base text-navy-950">{baseUrl}/i/{inv.token}</code>
                <button type="button" data-copy-link data-link={`${baseUrl}/i/${inv.token}`}
                        class="rounded-[6px] border border-border bg-white px-2 py-1 text-[12px] hover:border-primary hover:text-primary">
                  <i class="bi bi-clipboard" aria-hidden="true"></i> скопировать
                </button>
                <a href={`https://t.me/share/url?url=${encodeURIComponent(`${baseUrl}/i/${inv.token}`)}&text=${encodeURIComponent('Приглашение в АйДаКемп')}`}
                   target="_blank" rel="noopener"
                   class="rounded-[6px] border border-emerald-300 bg-emerald-50 px-2 py-1 text-[12px] text-emerald-800 hover:bg-emerald-100">
                  <i class="bi bi-telegram" aria-hidden="true"></i> в Telegram
                </a>
              </div>
              {inv.comment && <div class="mt-1 text-[12px] text-body-muted">«{inv.comment}»</div>}
            </div>
            <button type="button" data-revoke-invite data-id={inv.id}
                    class="rounded-[8px] border border-transparent px-2 py-1 text-[12px] text-body-muted hover:bg-red-50 hover:text-red-700">
              <i class="bi bi-x-circle" aria-hidden="true"></i> отозвать
            </button>
          </div>
        ))}
      </div>
    )}

    {usedInvites.length > 0 && (
      <details class="mt-4">
        <summary class="cursor-pointer text-base text-body-muted">Использованные ({usedInvites.length})</summary>
        <ul class="mt-2 space-y-1 text-base text-body-muted">
          {usedInvites.slice(0, 20).map((inv) => (
            <li>
              {inv.name ?? '—'} · {inv.roles.map((r) => ROLE_LABEL[r] ?? r).join(', ')} ·
              TG #{inv.used_by_tg} · {new Date(inv.used_at!).toLocaleString('ru-RU')}
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  {/* Модалка нового приглашения */}
  <dialog id="invite-dialog" class="aida-modal-center rounded-[16px] border border-border bg-white p-0 backdrop:bg-black/40">
    <form method="dialog" class="aida-modal-form">
      <h3 class="text-[18px] font-semibold text-navy-950">Новое приглашение</h3>
      <div class="mt-4 space-y-3">
        <label class="block">
          <span class="form-label">Имя (для контекста, чтобы не забыть кому ссылка)</span>
          <input id="inv-name" type="text" placeholder="например: Маша Иванова"
                 class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 focus:border-primary focus:outline-none" />
        </label>
        <div>
          <span class="form-label">Роли</span>
          <div class="mt-1 grid grid-cols-2 gap-2 text-base">
            <label class="inline-flex items-center gap-2"><input type="checkbox" name="inv-role" value="teacher" class="rounded border-border"> Преподаватель</label>
            <label class="inline-flex items-center gap-2"><input type="checkbox" name="inv-role" value="vozhaty" class="rounded border-border"> Вожатый</label>
            <label class="inline-flex items-center gap-2"><input type="checkbox" name="inv-role" value="rukovoditel" class="rounded border-border"> Руководитель</label>
            <label class="inline-flex items-center gap-2"><input type="checkbox" name="inv-role" value="admin" class="rounded border-border"> Админ</label>
          </div>
        </div>
        <label class="block">
          <span class="form-label">Заметка (необязательно)</span>
          <textarea id="inv-comment" rows="2" class="mt-1 w-full rounded-[10px] border border-border bg-white px-3 py-2 text-base focus:border-primary focus:outline-none"></textarea>
        </label>
      </div>
      <div class="mt-5 flex items-center justify-end gap-2">
        <span id="inv-status" class="mr-auto text-base text-body-muted"></span>
        <button type="button" id="inv-cancel" class="rounded-[10px] border border-border bg-white px-4 py-2 text-base hover:border-primary">Отмена</button>
        <button type="button" id="inv-create" class="rounded-[10px] border border-emerald-600 bg-emerald-600 text-white px-4 py-2 text-base hover:opacity-90">
          <i class="bi bi-send" aria-hidden="true"></i> Создать ссылку
        </button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    (function () {
      const dlg = document.getElementById('invite-dialog');
      const openBtn = document.getElementById('btn-new-invite');
      const closeBtn = document.getElementById('inv-cancel');
      const createBtn = document.getElementById('inv-create');
      const status = document.getElementById('inv-status');
      if (openBtn) openBtn.addEventListener('click', () => {
        document.getElementById('inv-name').value = '';
        document.getElementById('inv-comment').value = '';
        document.querySelectorAll('input[name="inv-role"]').forEach((c) => c.checked = false);
        if (status) status.textContent = '';
        dlg.showModal();
      });
      if (closeBtn) closeBtn.addEventListener('click', () => dlg.close());
      if (createBtn) createBtn.addEventListener('click', async () => {
        const roles = Array.from(document.querySelectorAll('input[name="inv-role"]:checked')).map((i) => i.value);
        if (roles.length === 0) { status.textContent = 'Отметь хотя бы одну роль'; return; }
        const body = {
          action: 'create',
          name: document.getElementById('inv-name').value.trim(),
          comment: document.getElementById('inv-comment').value.trim(),
          roles,
        };
        status.textContent = 'Создаём…';
        try {
          const r = await fetch('/api/portal/invite', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body), credentials: 'include',
          });
          const jr = await r.json();
          if (jr.ok && jr.invite && jr.invite.token) {
            const link = location.origin + '/i/' + jr.invite.token;
            // Сразу копируем в буфер и показываем ссылку в модалке + кнопки
            try { await navigator.clipboard.writeText(link); } catch {}
            status.innerHTML = '✓ скопировано в буфер';
            // Заменяем содержимое модалки на «Готово» с ссылкой
            const form = createBtn.closest('form');
            form.innerHTML =
              '<h3 class="text-[18px] font-semibold text-emerald-700">Приглашение создано ✓</h3>' +
              '<p class="mt-3 text-base text-body-muted">Ссылка скопирована в буфер. Можешь сразу вставить в чат:</p>' +
              '<div class="mt-3 break-all rounded-[10px] border border-emerald-300 bg-emerald-50 px-3 py-3 font-mono text-base text-navy-950 select-all">' + link + '</div>' +
              '<div class="mt-4 flex flex-wrap gap-2">' +
                '<a href="https://t.me/share/url?url=' + encodeURIComponent(link) + '&text=' + encodeURIComponent('Приглашение в АйДаКемп') + '" target="_blank" rel="noopener" class="rounded-[10px] border border-emerald-600 bg-emerald-600 text-white px-4 py-2 text-base">📨 Отправить в Telegram</a>' +
                '<button type="button" onclick="navigator.clipboard.writeText(' + JSON.stringify(link) + '); this.textContent=\'✓ скопировано\';" class="rounded-[10px] border border-border bg-white px-4 py-2 text-base">📋 Скопировать ещё раз</button>' +
                '<button type="button" onclick="window.location.reload()" class="rounded-[10px] border border-border bg-white px-4 py-2 text-base">Закрыть</button>' +
              '</div>';
          } else {
            status.textContent = 'Ошибка: ' + (jr.error || 'unknown');
          }
        } catch (e) { status.textContent = 'Сетевая ошибка'; }
      });

      // Копирование ссылок
      document.querySelectorAll('[data-copy-link]').forEach((btn) => {
        btn.addEventListener('click', () => {
          navigator.clipboard?.writeText(btn.dataset.link).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg"></i> скопировано';
            setTimeout(() => { btn.innerHTML = orig; }, 1400);
          });
        });
      });

      // Отзыв
      document.querySelectorAll('[data-revoke-invite]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Отозвать приглашение? Ссылка перестанет работать.')) return;
          const id = Number(btn.dataset.id);
          const r = await fetch('/api/portal/invite', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'revoke', id }), credentials: 'include',
          });
          const jr = await r.json();
          if (jr.ok) location.reload(); else alert('Ошибка: ' + (jr.error || ''));
        });
      });
    })();
  </script>

  <!-- ADD MANUAL: создать сотрудника без TG -->
  <section class="mb-10 rounded-[16px] border border-border bg-white p-5 card-shadow">
    <details>
      <summary class="cursor-pointer text-[18px] font-semibold text-navy-950">
        <i class="bi bi-person-plus text-[20px] text-primary" aria-hidden="true"></i>
        Добавить сотрудника вручную
        <span class="ml-1 text-base font-normal text-body-muted">(без TG-входа — допишет, когда зайдёт)</span>
      </summary>
      <form method="POST" action="/api/portal/staff/add-manual" class="mt-4 space-y-3">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div>
            <label class="form-label">ФИО</label>
            <input name="full_name" required placeholder="Иван Иванов"
                   class="form-input" />
          </div>
          <div>
            <label class="form-label">staff_key <span class="text-body-muted">(опц.)</span></label>
            <input name="staff_key" placeholder="например, counselor_3"
                   class="form-input" />
            <p class="mt-1 text-[12px] text-body-muted">Если не задавать — сотрудник появится без привязки к семантическому ключу.</p>
          </div>
        </div>
        <div>
          <label class="form-label">Роли (можно несколько)</label>
          <div class="mt-1 flex flex-wrap gap-3">
            {ROLES.map((r) => (
              <label class="inline-flex items-center gap-1 text-base">
                <input type="checkbox" name="roles" value={r} class="h-4 w-4 rounded border-border text-primary" />
                {roleLabel(r)}
              </label>
            ))}
          </div>
        </div>
        <button class="rounded-[10px] bg-emerald-600 px-4 py-2 text-base font-semibold text-white transition hover:bg-emerald-700">
          <i class="bi bi-check-lg mr-1" aria-hidden="true"></i> Добавить
        </button>
      </form>
    </details>
  </section>

  <!-- PENDING: ожидают привязки к placeholder -->
  <section class="mb-10">
    <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
      <i class="bi bi-hourglass-split mr-1" aria-hidden="true"></i>
      Ожидают привязки ({pending.length})
    </h2>
    <p class="mb-3 text-base text-body-muted">
      Эти люди вошли через Telegram, но не связаны с именованной должностью. Выбери placeholder и нажми «Объединить».
    </p>
    {pending.length === 0 && <p class="text-[16px] text-body-muted">Нет ожидающих привязки.</p>}
    {pending.map((s) => (
      <div
        class="mb-3 rounded-[16px] border border-border bg-white p-4 card-shadow"
        data-pending-id={s.id}
      >
        <div class="flex flex-wrap items-center gap-2">
          <i class="bi bi-person-fill text-[18px] text-body-muted" aria-hidden="true"></i>
          <span class="min-w-0 flex-1 text-[16px] text-navy-950">
            {s.full_name ?? '—'}{s.tg_username ? ` @${s.tg_username}` : ''}
            <span class="ml-1 text-body-muted">#{s.telegram_id}</span>
          </span>
          <form method="POST" action="/api/portal/staff/by-id">
            <input type="hidden" name="id" value={s.id} />
            <input type="hidden" name="action" value="delete" />
            <button class="rounded-[10px] border border-red-300 px-3 py-1.5 text-base font-medium text-red-700 transition hover:bg-red-50"
                    onclick="return confirm('Отклонить заявку и удалить запись?')">
              <i class="bi bi-x-lg mr-1" aria-hidden="true"></i>
              Отклонить
            </button>
          </form>
        </div>

        {/* Вариант 1: объединить с существующим placeholder (Варвара, Ташкин и т.п.) */}
        {activePlaceholders.length > 0 && (
          <div class="mt-3 border-t border-border pt-3">
            <p class="mb-2 text-base font-medium text-body-muted">
              <i class="bi bi-link-45deg mr-1" aria-hidden="true"></i>
              Привязать к существующей должности:
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <select
                class="merge-select rounded-[10px] border border-border px-3 py-2 text-base text-body outline-none focus:border-primary"
                aria-label="Привязать к placeholder"
              >
                <option value="">— выбери должность —</option>
                {activePlaceholders.map((ph) => (
                  <option value={ph.id}>
                    {ph.full_name ?? ph.staff_key} ({roleLabel(ph.role) || 'без роли'})
                  </option>
                ))}
              </select>
              <button class="merge-btn rounded-[10px] bg-primary px-4 py-2 text-base font-semibold text-white transition hover:bg-primary-hover disabled:opacity-50" disabled>
                Объединить
              </button>
            </div>
          </div>
        )}

        {/* Вариант 2: назначить роль напрямую (без привязки к placeholder — для доп. руководителя, доп. админа и т.п.) */}
        <form method="POST" action="/api/portal/staff/roles" class="mt-3 border-t border-border pt-3">
          <input type="hidden" name="telegram_id" value={s.telegram_id!} />
          <p class="mb-2 text-base font-medium text-body-muted">
            <i class="bi bi-plus-circle mr-1" aria-hidden="true"></i>
            Или назначить роли напрямую (новый сотрудник):
          </p>
          <div class="flex flex-wrap items-center gap-3">
            {ROLES.map((r) => (
              <label class="inline-flex items-center gap-1 text-base">
                <input type="checkbox" name="roles" value={r} class="h-4 w-4 rounded border-border text-primary" />
                {roleLabel(r)}
              </label>
            ))}
            <button class="rounded-[10px] bg-emerald-600 px-4 py-2 text-base font-semibold text-white transition hover:bg-emerald-700">
              <i class="bi bi-check-lg mr-1" aria-hidden="true"></i>
              Одобрить
            </button>
          </div>
        </form>
      </div>
    ))}
  </section>

  <!-- PLACEHOLDERS: ждут первого входа -->
  <section class="mb-10">
    <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
      <i class="bi bi-shield-fill-check mr-1" aria-hidden="true"></i>
      Placeholder-ы (без Telegram) ({placeholders.length})
    </h2>
    {placeholders.length === 0 && <p class="text-[16px] text-body-muted">Нет placeholder-ов.</p>}
    {placeholders.map((ph) => (
      <div class={`mb-2 flex flex-wrap items-center gap-2 rounded-[16px] border border-border bg-white p-4 card-shadow ${ph.active ? '' : 'opacity-60'}`}>
        <i class="bi bi-person-fill text-[18px] text-body-muted" aria-hidden="true"></i>
        <form method="POST" action="/api/portal/staff/by-id" class="flex min-w-0 flex-1 items-center gap-2">
          <input type="hidden" name="id" value={ph.id} />
          <input type="hidden" name="action" value="rename" />
          <input
            type="text"
            name="full_name"
            value={ph.full_name ?? ''}
            placeholder="Имя"
            class="min-w-0 flex-1 rounded-[8px] border border-transparent bg-transparent px-2 py-1 text-[16px] text-navy-950 outline-none transition hover:border-border focus:border-primary focus:bg-white"
          />
          <button type="submit" class="rounded-[8px] border border-border px-2 py-1 text-[12px] font-medium text-body-muted transition hover:border-primary hover:text-primary" title="Сохранить имя">
            <i class="bi bi-check-lg text-base" aria-hidden="true"></i>
          </button>
          <span class="whitespace-nowrap text-base text-body">{ph.full_name || '(без имени)'} · <b>{roleLabel(ph.role) || 'без роли'}</b></span>
          {ph.staff_key && <span class="hidden text-base text-body-muted md:inline">key: {ph.staff_key}</span>}
          {!ph.active && <span class="text-base font-semibold text-red-600">отключён</span>}
        </form>
        <span class="hidden text-base text-body-muted lg:inline">Ждёт TG</span>
        <div class="basis-full mt-2 flex flex-wrap items-center gap-2 text-base" data-staff-code data-id={ph.id}>
          <span class="text-body-muted"><i class="bi bi-key" aria-hidden="true"></i> Код-вход:</span>
          <code class="staff-code-val rounded bg-page px-2 py-0.5 font-mono text-base text-navy-950">{ph.code ?? '— нет —'}</code>
          <button type="button" class="staff-code-gen rounded-[8px] border border-primary px-2 py-1 text-[12px] text-primary transition hover:bg-primary-soft">{ph.code ? 'Обновить код' : 'Выдать код'}</button>
          <button type="button" class={`staff-code-revoke rounded-[8px] border border-border px-2 py-1 text-[12px] text-body-muted transition hover:text-red-700 ${ph.code ? '' : 'hidden'}`}>Убрать</button>
        </div>
        <form method="POST" action="/api/portal/staff/by-id">
          <input type="hidden" name="id" value={ph.id} />
          <input type="hidden" name="action" value={ph.active ? 'deactivate' : 'activate'} />
          <button class="rounded-[10px] border border-border px-3 py-1.5 text-base font-medium text-body-muted transition hover:border-primary hover:text-primary">
            {ph.active ? 'Отключить' : 'Включить'}
          </button>
        </form>
        <form method="POST" action="/api/portal/staff/by-id">
          <input type="hidden" name="id" value={ph.id} />
          <input type="hidden" name="action" value="delete" />
          <button class="rounded-[10px] border border-red-300 px-3 py-1.5 text-base font-medium text-red-700 transition hover:bg-red-50"
                  onclick="return confirm('Удалить placeholder?')">
            <i class="bi bi-trash3 text-[12px]" aria-hidden="true"></i>
          </button>
        </form>
      </div>
    ))}
  </section>

  <!-- ACTIVE: привязаны и активны -->
  <section class="mb-10">
    <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
      Активные ({active.length})
    </h2>
    {active.length === 0 && <p class="text-[16px] text-body-muted">Нет активных сотрудников.</p>}
    {active.map((s) => {
      const userRoles = Array.isArray((s as any).roles) && (s as any).roles.length > 0
        ? ((s as any).roles as string[])
        : (s.role ? [s.role] : []);
      return (
      <div class="mb-3 flex flex-wrap items-start gap-3 rounded-[16px] border border-border bg-white p-4 card-shadow">
        <div class="min-w-0 flex-1">
          <form method="POST" action="/api/portal/staff/by-id" class="flex items-center gap-2">
            <input type="hidden" name="id" value={s.id} />
            <input type="hidden" name="action" value="rename" />
            <input
              type="text"
              name="full_name"
              value={s.full_name ?? ''}
              placeholder="Имя"
              class="min-w-0 flex-1 rounded-[8px] border border-transparent bg-transparent px-2 py-1 text-[16px] text-navy-950 outline-none transition hover:border-border focus:border-primary focus:bg-white"
            />
            <button type="submit" class="rounded-[8px] border border-border px-2 py-1 text-[12px] font-medium text-body-muted transition hover:border-primary hover:text-primary" title="Сохранить имя">
              <i class="bi bi-check-lg text-base" aria-hidden="true"></i>
            </button>
            {s.tg_username && <span class="whitespace-nowrap text-base text-body-muted">@{s.tg_username}</span>}
          </form>
          <div class="mt-1 text-base text-body-muted">
            Роли: <b class="text-navy-950">{userRoles.map(roleLabel).join(' + ') || 'нет'}</b>
            {s.staff_key && <span> · staff_key: <code>{s.staff_key}</code></span>}
          </div>
          <form method="POST" action="/api/portal/staff/roles" class="mt-2 flex flex-wrap items-center gap-3">
            <input type="hidden" name="telegram_id" value={s.telegram_id!} />
            {ROLES.map((r) => (
              <label class="inline-flex items-center gap-1 text-base">
                <input type="checkbox" name="roles" value={r} checked={userRoles.includes(r)} class="h-4 w-4 rounded border-border text-primary" />
                {roleLabel(r)}
              </label>
            ))}
            <button class="rounded-[10px] bg-primary px-3 py-1 text-base font-medium text-white transition hover:opacity-90">
              Обновить роли
            </button>
          </form>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-base" data-staff-code data-id={s.id}>
            <span class="text-body-muted"><i class="bi bi-key" aria-hidden="true"></i> Код-вход:</span>
            <code class="staff-code-val rounded bg-page px-2 py-0.5 font-mono text-base text-navy-950">{s.code ?? '— нет —'}</code>
            <button type="button" class="staff-code-gen rounded-[8px] border border-primary px-2 py-1 text-[12px] text-primary transition hover:bg-primary-soft">{s.code ? 'Обновить код' : 'Выдать код'}</button>
            <button type="button" class={`staff-code-revoke rounded-[8px] border border-border px-2 py-1 text-[12px] text-body-muted transition hover:text-red-700 ${s.code ? '' : 'hidden'}`}>Убрать</button>
          </div>
        </div>
        <form method="POST" action="/api/portal/staff">
          <input type="hidden" name="telegram_id" value={s.telegram_id!} />
          <input type="hidden" name="action" value="deactivate" />
          <button
            class="rounded-[12px] border border-red-300 px-4 py-2 text-[16px] font-medium text-red-700 transition hover:bg-red-50"
          >
            Отключить
          </button>
        </form>
      </div>
      );
    })}
  </section>

  <!-- INACTIVE -->
  <section>
    <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
      Отключённые ({inactive.length})
    </h2>
    {inactive.length === 0 && <p class="text-[16px] text-body-muted">Нет отключённых сотрудников.</p>}
    {inactive.map((s) => (
      <div class="mb-2 flex flex-wrap items-center gap-2 rounded-[16px] border border-border bg-white p-4 card-shadow opacity-70">
        <span class="min-w-0 flex-1 text-[16px] text-navy-950">
          {s.full_name ?? '—'} — {roleLabel(s.role)}
        </span>
        <form method="POST" action="/api/portal/staff">
          <input type="hidden" name="telegram_id" value={s.telegram_id!} />
          <input type="hidden" name="action" value="reactivate" />
          <button
            class="rounded-[12px] border border-border px-4 py-2 text-[16px] font-medium text-body transition hover:border-primary"
          >
            Включить
          </button>
        </form>
      </div>
    ))}
  </section>

  <section class="mb-10 mt-10">
    <h2 class="mb-3 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
      Документы
    </h2>
    <a
      href="https://ai.aidacamp.ru/docs/server-access.html"
      target="_blank"
      rel="noopener"
      class="mb-2 flex items-center gap-4 rounded-[16px] border border-border bg-white p-4 card-shadow transition hover:border-primary hover:shadow-md"
    >
      <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-[10px] bg-primary/10">
        <i class="bi bi-file-earmark-text text-[20px] text-primary" aria-hidden="true"></i>
      </div>
      <div class="min-w-0 flex-1">
        <div class="text-[16px] font-semibold text-navy-950">Подключение к внутреннему серверу</div>
        <div class="text-base text-body-muted">SSH, RDP, аварийный доступ — все способы подключения к server1</div>
      </div>
      <i class="bi bi-box-arrow-right text-[18px] text-body-muted" aria-hidden="true"></i>
    </a>
  </section>
<script>
  // Enable merge button only when a placeholder is selected
  document.querySelectorAll<HTMLDivElement>('[data-pending-id]').forEach((row) => {
    const sel = row.querySelector<HTMLSelectElement>('.merge-select')!;
    const btn = row.querySelector<HTMLButtonElement>('.merge-btn')!;
    const pendingId = Number(row.dataset.pendingId);

    sel.addEventListener('change', () => {
      btn.disabled = !sel.value;
    });

    btn.addEventListener('click', async () => {
      const placeholderId = Number(sel.value);
      if (!placeholderId) return;
      btn.disabled = true;
      btn.textContent = 'Объединяю…';
      try {
        const res = await fetch('/api/portal/staff/merge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pending_id: pendingId, placeholder_id: placeholderId }),
        });
        const data = await res.json();
        if (data.ok) {
          window.location.reload();
        } else {
          alert(`Ошибка: ${data.error ?? 'неизвестно'}`);
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-link-45deg" aria-hidden="true"></i> Объединить';
        }
      } catch {
        alert('Сетевая ошибка');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-link-45deg" aria-hidden="true"></i> Объединить';
      }
    });
  });
</script>
<script>
  // Код-вход сотрудников: выдать/обновить/убрать персональный код (альтернатива TG).
  document.querySelectorAll<HTMLElement>('[data-staff-code]').forEach((row) => {
    const id = Number(row.dataset.id);
    const val = row.querySelector<HTMLElement>('.staff-code-val')!;
    const gen = row.querySelector<HTMLButtonElement>('.staff-code-gen')!;
    const rev = row.querySelector<HTMLButtonElement>('.staff-code-revoke');

    gen.addEventListener('click', async () => {
      const orig = gen.textContent;
      gen.disabled = true;
      gen.textContent = '…';
      try {
        const r = await fetch('/api/portal/staff/code', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, action: 'generate' }), credentials: 'include',
        });
        const d = await r.json();
        if (d.ok && d.code) {
          val.textContent = d.code;
          gen.textContent = 'Обновить код';
          rev?.classList.remove('hidden');
          try { await navigator.clipboard.writeText(d.code); } catch {}
        } else {
          gen.textContent = orig;
          alert('Ошибка: ' + (d.error || 'неизвестно'));
        }
      } catch {
        gen.textContent = orig;
        alert('Сетевая ошибка');
      } finally {
        gen.disabled = false;
      }
    });

    rev?.addEventListener('click', async () => {
      if (!confirm('Убрать код-вход у сотрудника? Останется только вход через Telegram.')) return;
      try {
        const r = await fetch('/api/portal/staff/code', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, action: 'revoke' }), credentials: 'include',
        });
        const d = await r.json();
        if (d.ok) {
          val.textContent = '— нет —';
          gen.textContent = 'Выдать код';
          rev.classList.add('hidden');
        } else {
          alert('Ошибка: ' + (d.error || 'неизвестно'));
        }
      } catch {
        alert('Сетевая ошибка');
      }
    });
  });
</script>
</PortalLayout>
