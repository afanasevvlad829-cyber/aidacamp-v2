            {role === 'teacher' && nowEvent.event_type === 'lesson' && (
              <div class="mt-4">
                {nowEvent.activity_slug ? (
                  <a
                    href={`/portal/metodichki/${nowEvent.activity_slug}`}
                    class="inline-flex items-center gap-2 rounded-[12px] border border-primary px-4 py-2 text-[16px] font-medium text-primary transition hover:bg-primary-soft"
                  >
                    <i class="bi bi-journal-text text-[18px]" aria-hidden="true"></i>
                    Открыть методичку
                  </a>
                ) : (
                  <button
                    type="button"
                    disabled
                    title="Методичка пока не привязана к этому уроку"
                    class="inline-flex cursor-not-allowed items-center gap-2 rounded-[12px] border border-border px-4 py-2 text-[16px] font-medium text-body-muted opacity-60"
                  >
                    <i class="bi bi-journal-text text-[18px]" aria-hidden="true"></i>
                    Методичка пока не привязана
                  </button>
                )}
              </div>
            )}

            {/* content_task — кнопка загрузки фото */}
            {nowEvent.content_task_template_id && (
              <div class="mt-3 portal-uploader" data-event-id={nowEvent.id} data-content-task-id={nowEvent.content_task_template_id}>
                <input type="file" accept="image/*,video/*" capture="environment" class="portal-uploader__input hidden" />
                <button type="button" class="portal-uploader__btn inline-flex items-center gap-2 rounded-[12px] bg-primary px-4 py-2 text-[16px] font-medium text-white transition hover:opacity-90">
                  <i class="bi bi-camera-fill text-[18px]" aria-hidden="true"></i>
                  Снять и загрузить
                </button>
                <p class="portal-uploader__status mt-2 text-[14px] text-body-muted hidden" aria-live="polite"></p>
              </div>
            )}

            {/* Лента загруженных фото/видео по текущему событию */}
            <div class="portal-media mt-3"
                 data-event-id={nowEvent.id}
                 data-can-delete={role === 'admin' || role === 'rukovoditel' ? 'true' : 'false'}>
              <div class="portal-media__header hidden text-[13px] font-semibold text-body-muted"></div>
              <ul class="portal-media__list mt-1 space-y-1 text-[14px]"></ul>
            </div>
          </div>
        ) : (
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-primary-soft text-primary">
              <i class="bi bi-sun text-[20px]" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[17px] font-semibold text-navy-950">Сегодня свободно</p>
              <p class="text-[15px] text-body-muted">Нет событий для вашей роли прямо сейчас</p>
            </div>
          </div>
        )}
      </div>
    )}

    {/* ── "Дальше" card ── */}
    {isShiftDay && nextEvent && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <p class="mb-2 text-[13px] font-medium uppercase tracking-wide text-body-muted">Дальше</p>
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[17px] font-semibold text-navy-950">{nextEvent.title}</p>
            <p class="mt-1 text-[15px] text-body-muted">
              {relativeTime(nextEvent.start_time)}
              {nextEvent.event_type && ` · ${EVENT_TYPE_LABELS[nextEvent.event_type] ?? nextEvent.event_type}`}
            </p>
          </div>
          <a
            href={`/portal/smena?view=role&date=${today}`}
            class="inline-flex shrink-0 items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[16px] font-medium text-navy-950 transition hover:border-primary hover:text-primary"
          >
            <i class="bi bi-calendar-week text-[18px]" aria-hidden="true"></i>
            К расписанию
          </a>
        </div>
      </div>
    )}

    {/* ── Today's timeline ── */}
    {isShiftDay && myEvents.length > 0 && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-[17px] font-bold text-navy-950">Сегодня</h2>
          <a
            href={`/portal/smena?view=role&date=${today}`}
            class="text-[15px] text-primary transition hover:underline"
          >
            Все события
          </a>
        </div>
        <ul class="divide-y divide-border">
          {myEvents.map((e) => {
            const isCurrent = e.id === nowEvent?.id;
            const prog = checklistProgress(e, doneSet, role);
            return (
              <li class={`flex items-center gap-3 py-3 ${isCurrent ? 'rounded-[8px] bg-primary-soft px-2' : ''}`}>
                <span class="w-[52px] shrink-0 text-[14px] font-medium tabular-nums text-body-muted">
                  {formatTime(e.start_time)}
                </span>
                <span class="min-w-0 flex-1">
                  <span class={`block text-[16px] font-medium ${isCurrent ? 'text-primary' : 'text-navy-950'}`}>{e.title}</span>
                  {prog.total > 0 && (
                    <span class="text-[13px] text-body-muted">{prog.done}/{prog.total} чек-лист</span>
                  )}
                </span>
                {isCurrent && (
                  <span class="shrink-0 rounded-full bg-primary px-2 py-0.5 text-[12px] font-semibold text-white">Сейчас</span>
                )}
              </li>
            );
          })}
        </ul>
        {role === 'teacher' && (
          <div class="mt-4 border-t border-border pt-4">
            <a
              href="/portal/metodichki/"
              class="inline-flex items-center gap-2 text-[15px] text-primary transition hover:underline"
            >
              <i class="bi bi-journal-text text-[16px]" aria-hidden="true"></i>
              Все методички
            </a>
          </div>
        )}
      </div>
    )}

    {/* ── No events today ── */}
    {isShiftDay && myEvents.length === 0 && !shiftStatusMsg && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <p class="text-[16px] text-body-muted">На сегодня событий для вашей роли не запланировано.</p>
        <a
          href={`/portal/smena?view=role&date=${today}`}
          class="mt-3 inline-flex items-center gap-2 text-[15px] text-primary transition hover:underline"
        >
          <i class="bi bi-calendar-week text-[16px]" aria-hidden="true"></i>
          Открыть расписание смены
        </a>
      </div>
    )}

  </div>
)}

</PortalLayout>
