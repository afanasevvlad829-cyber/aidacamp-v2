---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import type { PortalRole } from '../../lib/portalSession';
import searchIndex from '../../data/portalSearchIndex.json';

const role = Astro.locals.portalRole!;

interface SearchEntry {
  title: string;
  url: string;
  group: string;
  roles: PortalRole[];
  text: string;
}

// Только материалы, доступные текущей роли — чужие записи не утекают в клиент.
const searchEntries = (searchIndex as SearchEntry[]).filter((e) =>
  e.roles.includes(role),
);

const BASE = 'https://ai.aidacamp.ru';

interface CatalogItem {
  title: string;
  href: string;
  desc: string;
  icon: string;
}
interface CatalogGroup {
  group: string;
  roles: PortalRole[];
  items: CatalogItem[];
}

const catalog: CatalogGroup[] = [
  {
    group: 'Танковый полигон',
    roles: ['admin', 'teacher', 'student'],
    items: [
      { title: 'Танковый бой', href: `${BASE}/docs/tank-battle.html`, desc: 'Командное сражение на полигоне', icon: 'bullseye' },
      { title: 'Арена', href: `${BASE}/docs/arena.html`, desc: 'Турнирная площадка', icon: 'grid-3x3-gap' },
      { title: 'Тренировка', href: `${BASE}/docs/train.html`, desc: 'Отработка манёвров перед боем', icon: 'clipboard-check' },
      { title: 'Игра', href: `${BASE}/docs/play.html`, desc: 'Запуск игрового режима', icon: 'controller' },
    ],
  },
  {
    group: 'Учителю',
    roles: ['admin', 'teacher'],
    items: [
      { title: 'Онбординг преподавателя', href: `${BASE}/docs/onboarding-teacher.html`, desc: 'Первые шаги в роли преподавателя', icon: 'signpost-2' },
      { title: 'Преподавателю', href: `${BASE}/docs/teacher.html`, desc: 'Рабочее пространство преподавателя', icon: 'person-workspace' },
      { title: 'Хендбук', href: `${BASE}/docs/handbook.html`, desc: 'Справочник и методики', icon: 'journal-text' },
      { title: 'Дашборд', href: `${BASE}/docs/dashboard.html`, desc: 'Метрики и прогресс группы', icon: 'speedometer2' },
    ],
  },
  {
    group: 'Ученику',
    roles: ['admin', 'teacher', 'student'],
    items: [
      { title: 'Онбординг ученика', href: `${BASE}/docs/onboarding-student.html`, desc: 'С чего начать обучение', icon: 'signpost' },
      { title: 'Ученику', href: `${BASE}/docs/student.html`, desc: 'Личное пространство ученика', icon: 'person' },
      { title: 'Квесты', href: `${BASE}/docs/quests.html`, desc: 'Задания и испытания', icon: 'list-check' },
      { title: 'Каталог', href: `${BASE}/docs/catalog.html`, desc: 'Все доступные материалы', icon: 'collection' },
      { title: 'Тур', href: `${BASE}/docs/tour.html`, desc: 'Знакомство с порталом', icon: 'map' },
    ],
  },
  {
    group: 'Сотрудникам смены',
    roles: ['admin', 'rukovoditel', 'vozhaty'],
    items: [
      { title: 'Сетка смены', href: '/portal/smena', desc: 'Расписание, чек-листы, отметки', icon: 'calendar-week' },
      { title: 'Портал сотрудников', href: '/staff/', desc: 'Вожатый и руководитель смены: инструкции, самопроверка', icon: 'people-fill' },
      { title: 'Конструктор смены', href: '/staff/plan/', desc: 'План смены и расселение по комнатам', icon: 'calendar-event' },
    ],
  },
  {
    group: 'Методические материалы',
    roles: ['admin', 'teacher', 'vozhaty', 'rukovoditel'],
    items: [
      { title: 'Активности (А. Ташкин)', href: '/portal/metodichki', desc: 'Планы, чек-листы, материалы активностей', icon: 'book' },
    ],
  },
  {
    group: 'Управление',
    roles: ['admin'],
    items: [
      { title: 'Управление сотрудниками', href: '/portal/staff-admin', desc: 'Заявки, роли, отзыв доступа', icon: 'people-fill' },
      { title: 'Управление сеткой', href: '/portal/smena/admin', desc: 'События и чек-листы смены', icon: 'kanban' },
    ],
  },
];

const visibleGroups = catalog.filter((g) => g.roles.includes(role));
---

<PortalLayout title="Портал — АйДаКэмп">
  <div class="mb-10">
    <h1 class="text-[28px] font-bold tracking-[-0.02em] text-navy-950 md:text-[36px]">
      Портал АйДаКэмп
    </h1>
    <p class="mt-2 text-[16px] text-body-muted">Выберите раздел, чтобы открыть его.</p>
  </div>

  <div class="mb-10">
    <label for="portal-search" class="sr-only">Поиск по материалам</label>
    <div class="relative">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-body-muted">
        <i class="bi bi-search text-[18px]" aria-hidden="true"></i>
      </span>
      <input
        id="portal-search"
        type="search"
        autocomplete="off"
        placeholder="Поиск по материалам…"
        class="w-full rounded-[12px] border border-border bg-white py-3 pl-11 pr-4 text-[16px] text-navy-950 outline-none transition placeholder:text-body-muted focus:border-primary"
      />
    </div>
    <ul
      id="portal-search-results"
      class="mt-4 hidden space-y-3"
      aria-live="polite"
    ></ul>
    <p
      id="portal-search-empty"
      class="mt-4 hidden text-[16px] text-body-muted"
    >
      Ничего не найдено.
    </p>
  </div>

  <script type="application/json" id="portal-search-data" set:html={JSON.stringify(searchEntries)} />

  <div id="portal-cards" class="space-y-12">
    {visibleGroups.map((g) => (
      <section>
        <h2 class="mb-4 text-[20px] font-bold tracking-[-0.01em] text-navy-950 md:text-[24px]">
          {g.group}
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class="group flex items-start gap-4 rounded-[16px] border border-border bg-white p-5 card-shadow transition hover:border-primary"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] bg-primary-soft text-primary">
                <i class={`bi bi-${item.icon} text-[24px]`} aria-hidden="true"></i>
              </span>
              <span class="min-w-0">
                <span class="block text-[18px] font-semibold text-navy-950 group-hover:text-primary">
                  {item.title}
                </span>
                <span class="mt-1 block text-[16px] leading-[1.5] text-body-muted">
                  {item.desc}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    (() => {
      const dataTag = document.getElementById('portal-search-data');
      const input = document.getElementById('portal-search');
      const results = document.getElementById('portal-search-results');
      const empty = document.getElementById('portal-search-empty');
      const cards = document.getElementById('portal-cards');
      if (!dataTag || !input || !results || !empty || !cards) return;

      let entries = [];
      try {
        entries = JSON.parse(dataTag.textContent || '[]');
      } catch {
        entries = [];
      }

      const SNIPPET = 160;
      const MAX_RESULTS = 15;

      const escapeHtml = (s) =>
        s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

      function snippet(text, q) {
        if (!text) return '';
        const idx = text.toLowerCase().indexOf(q);
        if (idx < 0) return text.slice(0, SNIPPET).trim() + (text.length > SNIPPET ? '…' : '');
        const half = Math.floor((SNIPPET - q.length) / 2);
        const start = Math.max(0, idx - half);
        const end = Math.min(text.length, start + SNIPPET);
        let s = text.slice(start, end).trim();
        if (start > 0) s = '…' + s;
        if (end < text.length) s = s + '…';
        return s;
      }

      function search(q) {
        const needle = q.toLowerCase();
        const matched = [];
        for (const e of entries) {
          const inTitle = e.title.toLowerCase().includes(needle);
          const inText = (e.text || '').toLowerCase().includes(needle);
          if (inTitle || inText) matched.push({ e, rank: inTitle ? 0 : 1 });
        }
        matched.sort((a, b) => a.rank - b.rank);
        return matched.slice(0, MAX_RESULTS).map((m) => m.e);
      }

      function render(q) {
        const found = search(q);
        results.innerHTML = '';
        if (found.length === 0) {
          results.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }
        empty.classList.add('hidden');
        results.classList.remove('hidden');
        for (const e of found) {
          const li = document.createElement('li');
          li.innerHTML =
            '<a href="' +
            escapeHtml(e.url) +
            '" target="_blank" rel="noopener" class="block rounded-[16px] border border-border bg-white p-4 card-shadow transition hover:border-primary">' +
            '<span class="block text-[18px] font-semibold text-navy-950">' +
            escapeHtml(e.title) +
            '</span>' +
            '<span class="mt-1 block text-[14px] font-medium text-primary">' +
            escapeHtml(e.group) +
            '</span>' +
            '<span class="mt-1 block text-[16px] leading-[1.5] text-body-muted">' +
            escapeHtml(snippet(e.text || '', q.toLowerCase())) +
            '</span>' +
            '</a>';
          results.appendChild(li);
        }
      }

      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          const q = input.value.trim();
          if (!q) {
            results.classList.add('hidden');
            empty.classList.add('hidden');
            results.innerHTML = '';
            cards.classList.remove('hidden');
            return;
          }
          cards.classList.add('hidden');
          render(q);
        }, 150);
      });
    })();
  </script>
</PortalLayout>
