---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import type { PortalRole } from '../../lib/portalSession';
import { getActiveShift, getEvents, getDone, EVENT_TYPE_LABELS, eventColorClass } from '../../lib/portalShift';
import { pickNowAndNext, relativeTime, checklistProgress } from '../../lib/portalNow';
import searchIndex from '../../data/portalSearchIndex.json';

const role = Astro.locals.portalRole! as PortalRole;
const telegramId = Astro.locals.portalSub;

// ─── Student: keep hub-launcher ─────────────────────────────────────────────
interface SearchEntry {
  title: string; url: string; group: string; roles: PortalRole[]; text: string;
}
const searchEntries = role === 'student'
  ? (searchIndex as SearchEntry[]).filter((e) => e.roles.includes(role))
  : [];

const BASE = 'https://ai.aidacamp.ru';

// ─── Staff: load today's events only ─────────────────────────────────────────
const isStaff = role !== 'student';
const today = new Date().toISOString().slice(0, 10);

let shift = isStaff ? await getActiveShift() : null;
let events = (isStaff && shift) ? await getEvents(shift.id, today) : [];
let doneSet: Set<string> = new Set();
if (isStaff && shift && telegramId) {
  doneSet = await getDone(telegramId, shift.id);
}

// Determine if shift is active today
function shiftActive(sh: typeof shift, d: string): boolean {
  if (!sh) return false;
  return sh.start_date <= d && d <= sh.end_date;
}
const isShiftDay = shiftActive(shift, today);

// Pick now/next for current role
const { current: nowEvent, next: nextEvent } = isShiftDay
  ? pickNowAndNext(events, new Date().toISOString(), role)
  : { current: null, next: null };

// Today's events for this role (for day timeline)
import { roleAllowed } from '../../lib/portalShiftRoles';
const myEvents = isShiftDay
  ? events.filter((e) => roleAllowed(role, e.roles))
  : [];

// ─── Manager/Admin metrics ───────────────────────────────────────────────────
function computeMetrics() {
  const totalEvents = events.length;
  // An event is "closed" when ALL checklist items across ALL its checklists have a done entry
  let closedEvents = 0;
  let unclosedItems = 0;
  let contentTasks = 0;
  for (const e of events) {
    const allItems: string[] = [];
    for (const cl of e.checklists) {
      for (const item of cl.items) {
        allItems.push(`${e.id}:${cl.checklist_id}:${item.id}`);
      }
    }
    if (allItems.length > 0 && allItems.every((k) => doneSet.has(k))) {
      closedEvents++;
    }
    // unclosed items for events my role can see
    if (roleAllowed(role, e.roles)) {
      for (const cl of e.checklists) {
        for (const item of cl.items) {
          if (!doneSet.has(`${e.id}:${cl.checklist_id}:${item.id}`)) unclosedItems++;
        }
      }
    }
    if (e.content_task_template_id) contentTasks++;
  }
  return { totalEvents, closedEvents, unclosedItems, contentTasksTotal: contentTasks };
}

const metrics = (role === 'rukovoditel' || role === 'admin') ? computeMetrics() : null;

// Checklist progress for nowEvent
const nowProgress = nowEvent
  ? checklistProgress(nowEvent, doneSet, role)
  : null;

// Time display helper
function formatTime(t: string | null) {
  if (!t) return '';
  return t.slice(0, 5);
}

// Shift status label
function shiftStatus(): string {
  if (!shift) return 'Смена не активна';
  if (today < shift.start_date) return `Стартует ${shift.start_date}`;
  if (today > shift.end_date) return `Завершилась ${shift.end_date}`;
  return '';
}
const shiftStatusMsg = isStaff && !isShiftDay ? shiftStatus() : '';
