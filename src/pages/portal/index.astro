        </div>
        <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
          <p class="text-base font-medium uppercase tracking-wide text-body-muted">Незакрытых пунктов</p>
          <p class="mt-2 text-[28px] font-bold text-navy-950">{metrics.unclosedItems}</p>
        </div>
      </div>
    )}

    {/* ── Manager / Admin: placeholder report button ── */}
    {(role === 'rukovoditel' || role === 'admin') && isShiftDay && (
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          disabled
          title="Отчёт по дню будет доступен позже"
          class="inline-flex cursor-not-allowed items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[16px] font-medium text-body-muted opacity-60"
        >
          <i class="bi bi-file-earmark-text text-[18px]" aria-hidden="true"></i>
          Отчёт по дню
        </button>
        {role === 'admin' && (
          <a
            href="/portal/staff-admin/"
            class="inline-flex items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[16px] font-medium text-navy-950 transition hover:border-primary hover:text-primary"
          >
            <i class="bi bi-people-fill text-[18px]" aria-hidden="true"></i>
            Управление сотрудниками
          </a>
        )}
      </div>
    )}

    {/* ── "Сейчас" card (all staff roles) ── */}
    {isShiftDay && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        {nowEvent ? (
          <div>
            <!-- event header -->
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`inline-flex items-center rounded-[8px] border px-2.5 py-1 text-base font-semibold ${eventColorClass(nowEvent.event_type)}`}>
                    {nowEvent.event_type ? (EVENT_TYPE_LABELS[nowEvent.event_type] ?? nowEvent.event_type) : 'Событие'}
                  </span>
                  <span class="text-base text-body-muted">
                    {formatTime(nowEvent.start_time)}
                    {nowEvent.end_time ? ` — ${formatTime(nowEvent.end_time)}` : ''}
                  </span>
                </div>
                <h2 class="mt-2 text-[20px] font-bold text-navy-950">{nowEvent.title}</h2>
              </div>
              <a
                href={`/portal/smena?view=role&date=${today}`}
                class="inline-flex shrink-0 items-center gap-2 rounded-[12px] bg-primary px-4 py-2 text-[16px] font-semibold text-white transition hover:opacity-90"
              >
                <i class="bi bi-arrow-right text-[16px]" aria-hidden="true"></i>
                Открыть
              </a>
            </div>

            <!-- Чек-лист progress -->
            {nowProgress && nowProgress.total > 0 && (
              <div class="mt-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="text-base font-medium text-navy-950">Чек-лист</span>
                  <span class="text-base text-body-muted">{nowProgress.done} / {nowProgress.total} готово</span>
                </div>
                <div class="h-2 w-full overflow-hidden rounded-full bg-primary-soft">
                  <div
                    class="h-2 rounded-full bg-primary transition-all"
                    style={`width: ${nowProgress.total > 0 ? Math.round((nowProgress.done / nowProgress.total) * 100) : 0}%`}
                  ></div>
                </div>
              </div>
            )}

            <!-- teacher: lesson link -->
            {role === 'teacher' && nowEvent.event_type === 'lesson' && (
              <div class="mt-4">
                {nowEvent.activity_slug ? (
                  <a
                    href={`/portal/metodichki/${nowEvent.activity_slug}`}
                    class="inline-flex items-center gap-2 rounded-[12px] border border-primary px-4 py-2 text-[16px] font-medium text-primary transition hover:bg-primary-soft"
                  >
                    <i class="bi bi-journal-text text-[18px]" aria-hidden="true"></i>
                    Открыть методичку
                  </a>
                ) : (
                  <button
                    type="button"
                    disabled
                    title="Методичка пока не привязана к этому уроку"
                    class="inline-flex cursor-not-allowed items-center gap-2 rounded-[12px] border border-border px-4 py-2 text-[16px] font-medium text-body-muted opacity-60"
                  >
                    <i class="bi bi-journal-text text-[18px]" aria-hidden="true"></i>
                    Методичка пока не привязана
                  </button>
                )}
              </div>
            )}

            {/* content_task — кнопка загрузки фото */}
            {nowEvent.content_task_template_id && (
              <PortalUploader eventId={nowEvent.id}
                              contentTaskId={nowEvent.content_task_template_id}
                              buttonClass="inline-flex items-center gap-2 rounded-[12px] bg-primary px-4 py-2 text-[16px] font-medium text-white transition hover:opacity-90" />
            )}

            {/* Лента загруженных фото/видео по текущему событию */}
            <div class="portal-media mt-3"
                 data-event-id={nowEvent.id}
                 data-can-delete={role === 'admin' || role === 'rukovoditel' ? 'true' : 'false'}>
              <div class="portal-media__header hidden text-base font-semibold text-body-muted"></div>
              <ul class="portal-media__list mt-1 space-y-1 text-base"></ul>
            </div>
          </div>
        ) : (
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-primary-soft text-primary">
              <i class="bi bi-sun text-[20px]" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-[17px] font-semibold text-navy-950">Сегодня свободно</p>
              <p class="text-base text-body-muted">Нет событий для вашей роли прямо сейчас</p>
            </div>
          </div>
        )}
      </div>
    )}

    {/* ── "Дальше" card ── */}
    {isShiftDay && nextEvent && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <p class="mb-2 text-base font-medium uppercase tracking-wide text-body-muted">Дальше</p>
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[17px] font-semibold text-navy-950">{nextEvent.title}</p>
            <p class="mt-1 text-base text-body-muted">
              {relativeTime(nextEvent.start_time)}
              {nextEvent.event_type && ` · ${EVENT_TYPE_LABELS[nextEvent.event_type] ?? nextEvent.event_type}`}
            </p>
          </div>
          <a
            href={`/portal/smena?view=role&date=${today}`}
            class="inline-flex shrink-0 items-center gap-2 rounded-[12px] border border-border bg-white px-4 py-2 text-[16px] font-medium text-navy-950 transition hover:border-primary hover:text-primary"
          >
            <i class="bi bi-calendar-week text-[18px]" aria-hidden="true"></i>
            К расписанию
          </a>
        </div>
      </div>
    )}

    {/* ── Today's timeline ── */}
    {isShiftDay && myEvents.length > 0 && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-[17px] font-bold text-navy-950">Сегодня</h2>
          <a
            href={`/portal/smena?view=role&date=${today}`}
            class="text-base text-primary transition hover:underline"
          >
            Все события
          </a>
        </div>
        <ul class="divide-y divide-border">
          {myEvents.map((e) => {
            const isCurrent = e.id === nowEvent?.id;
            const prog = checklistProgress(e, doneSet, role);
            return (
              <li class={`flex items-center gap-3 py-3 ${isCurrent ? 'rounded-[8px] bg-primary-soft px-2' : ''}`}>
                <span class="w-[52px] shrink-0 text-base font-medium tabular-nums text-body-muted">
                  {formatTime(e.start_time)}
                </span>
                <span class="min-w-0 flex-1">
                  <span class={`block text-[16px] font-medium ${isCurrent ? 'text-primary' : 'text-navy-950'}`}>{e.title}</span>
                  {prog.total > 0 && (
                    <span class="text-base text-body-muted">{prog.done}/{prog.total} чек-лист</span>
                  )}
                </span>
                {isCurrent && (
                  <span class="shrink-0 rounded-full bg-primary px-2 py-0.5 text-[12px] font-semibold text-white">Сейчас</span>
                )}
              </li>
            );
          })}
        </ul>
        {role === 'teacher' && (
          <div class="mt-4 border-t border-border pt-4">
            <a
              href="/portal/metodichki/"
              class="inline-flex items-center gap-2 text-base text-primary transition hover:underline"
            >
              <i class="bi bi-journal-text text-[16px]" aria-hidden="true"></i>
              Все методички
            </a>
          </div>
        )}
      </div>
    )}

    {/* ── No events today ── */}
    {isShiftDay && myEvents.length === 0 && !shiftStatusMsg && (
      <div class="rounded-[16px] border border-border bg-white p-5 card-shadow">
        <p class="text-[16px] text-body-muted">На сегодня событий для вашей роли не запланировано.</p>
        <a
          href={`/portal/smena?view=role&date=${today}`}
          class="mt-3 inline-flex items-center gap-2 text-base text-primary transition hover:underline"
        >
          <i class="bi bi-calendar-week text-[16px]" aria-hidden="true"></i>
          Открыть расписание смены
        </a>
      </div>
    )}

  </div>
)}

</PortalLayout>
