---
import { PRICE_MAX, PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import { campNiches, moreYandexCamps, catalogCamps, RATING_AS_OF } from '../data/luchshieCamps';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import OurCampFeatured from '../components/luchshie/OurCampFeatured.astro';
import RatingByNiche from '../components/luchshie/RatingByNiche.astro';
import CompactRating from '../components/luchshie/CompactRating.astro';
import CatalogRating from '../components/luchshie/CatalogRating.astro';
import ItemListSchema from '../components/luchshie/ItemListSchema.astro';

// Методические секции (как выбрать/составить рейтинг). АйДаКемп-промо вынесено в featured-блок,
// сам рейтинг — объективный по оценкам Яндекс.Карт (campNiches).
const sections = [
  {
    h2: "Как составить рейтинг лагеря самостоятельно",
    text: "Официального рейтинга не существует — сравните варианты по одним пунктам, а не по фото на сайте.",
    list: [
      "Оценка на Яндекс.Картах — смотрите не только цифру, но и число отзывов: 5.0 из 3 ≠ 5.0 из 100+",
      "Лицензия Минобрнауки — проверяется в реестре Рособрнадзора, без неё нельзя оформить вычет",
      "Программа с понятным результатом (проект, диплом) — а не размытое «развитие и обучение»",
    ],
  },
  {
    h2: "Критерии выбора лагеря",
    text: "Редакция vc.ru включила наш детский лагерь в <a href='https://vc.ru/gdekurs/1216219' target='_blank' rel='noopener' class='text-primary underline'>топ-4 IT-программ области</a>. Короткий чек-лист для выбора.",
    list: [
      "1 преподаватель на 6–8 ребят — комфортное соотношение",
      "Отзывы на Яндекс.Картах — независимая площадка, накрутить сложно",
    ],
  },
  {
    h2: "Что говорят родители",
    text: "Рейтинг живёт за счёт отзывов родителей, уже отправлявших к нам ребят:",
    list: [
      "«Смотрела рейтинги месяц. Везде обещают, здесь сдержали. Сын вернулся с реальным проектом — ботом в Telegram» — Ольга, мама Максима, 12 лет",
      "«Лучший из вариантов, где была дочь за 5 лет. Преподаватели умеют объяснять, кормят хорошо, территория чистая» — Светлана, мама Алины, 10 лет",
      "«Критерии выбора: безопасность, программа, отзывы. АйДаКемп закрыл все три. Плюс оформили налоговый вычет» — Игорь, папа Димы, 13 лет",
    ],
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Рейтинг лучших детских лагерей ${SEASON_YEAR}: топ Подмосковья и России для детей`}
  description={`Рейтинг лучших летних детских лагерей ${SEASON_YEAR} для детей и подростков: Москва, Московская область, Подмосковье, Россия. Реальные оценки родителей на Яндекс.Картах — IT, языковые, спортивные, творческие, оздоровительные. Как выбрать лагерь.`}
  h1={`Лучшие детские лагеря, рейтинг Подмосковья и России ${SEASON_YEAR} для детей и подростков`}
  canonical="https://aidacamp.ru/luchshie-detskie-lagerya"
>
  <Fragment slot="head">
    <CourseSchema
      name="АйДаКемп — IT-лагерь для детей в Подмосковье"
      description="Загородный IT-лагерь с образовательной лицензией, рейтинг 5.0 на Яндекс.Картах. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/luchshie-detskie-lagerya"
      ageMin={7}
      ageMax={15}
    />
    <ItemListSchema niches={campNiches} compactCamps={moreYandexCamps} catalogCamps={catalogCamps} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Лучшие детские лагеря, рейтинг Подмосковья и России ${SEASON_YEAR} для детей и подростков`}
    subtitle="Собрали летние лагеря Московской области — IT, языковые, спорт, творчество, оздоровление, приключения. Отдельно — наш загородный детский IT-лагерь АйДаКемп."
    breadcrumb="Лучшие лагеря"
    keywords={[`Данные обновлены: ${RATING_AS_OF}`, "Топ по отзывам родителей на Яндекс.Картах", "Что отмечают родители — по реальным отзывам", "Честно: только проверяемые оценки, без накруток"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Лучшие детские лагеря Подмосковья — рейтинг"
  />

  <OurCampFeatured />

  <RatingByNiche niches={campNiches} asOf={RATING_AS_OF} />

  <CompactRating camps={moreYandexCamps} asOf={RATING_AS_OF} />

  <CatalogRating camps={catalogCamps} asOf={RATING_AS_OF} />

  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ only={['safety', 'medicine']} extraItems={[
    { q: "Как выбрать лучший детский лагерь?", a: "Проверьте лицензию Минобрнауки, отзывы на Яндекс.Картах и 2ГИС, договор с туроператором и медработника на месте. У сильных вариантов это есть в открытом доступе." },
    { q: "Есть ли официальный рейтинг лагерей в Подмосковье?", a: "Официального рейтинга нет. Мы составили топ по оценкам родителей на Яндекс.Картах по всей России — по нишам: IT, языки, спорт, творчество, оздоровление." },
    { q: "Какой лагерь считается лучшим для детей, которые любят игры?", a: "IT-формат, где ребёнок идёт от «играю» к «создаю игры». В АйДаКемп дети делают моды в Minecraft, игры в Roblox Studio и ботов на Python." },
    { q: "С какого возраста можно отправить ребёнка в детский лагерь?", a: "Большинство вариантов берут детей с 6–7 лет. АйДаКемп — от 7 до 15 лет, группы по возрасту и уровню." }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
