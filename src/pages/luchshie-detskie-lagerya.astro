---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';

const sections = [
  {
    h2: "Почему АйДаКемп — один из лучших детских лагерей Подмосковья",
    text: "Выбирая лучший лагерь, родители смотрят на несколько вещей: лицензия, программа, отзывы, безопасность. АйДаКемп соответствует каждому пункту. Образовательная лицензия Минобрнауки (обязательное условие для налогового вычета), рейтинг 5.0 на Яндекс.Картах, 40+ отзывов, реальные проекты на хакатоне — а не «поделки для мамы».",
    list: [
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973",
      "Рейтинг 5.0 на Яндекс.Картах — 40+ отзывов за 5 лет",
      "Реестровый туроператор РТО 025773 — юридическая прозрачность",
      "С 2019 года — более 1 200 детей из Москвы и Подмосковья"
    ]
  },
  {
    h2: "Чем АйДаКемп отличается от обычного лагеря",
    text: "В обычном лагере дети играют, в АйДаКемп — создают. Каждый ребёнок выбирает IT-трек и к концу смены защищает реальный проект: игру в Roblox, бота на Python, 3D-модель. Преподаватели — практикующие IT-специалисты, не вожатые-универсалы. Группы до 8 человек — каждому уделяется время.",
    list: [
      "IT-программа дважды в день по 90 минут — не «кружок», а настоящие занятия",
      "Треки: Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование",
      "Хакатон в конце смены — каждый защищает проект перед всем лагерем",
      "Группы до 8 человек, преподаватели-практики с опытом в IT"
    ]
  },
  {
    h2: "Условия проживания: санаторий «Изумруд»",
    text: "АйДаКемп работает на территории санатория «Изумруд» в Наро-Фоминском районе. Закрытая территория, охрана 24/7, медработник. Комнаты на 2–4 человека с санузлом. Закрытый бассейн с ионизированной водой. 5-разовое питание. В рейтингах лучших лагерей Подмосковья это именно те условия, которые отличают хороший лагерь от отличного.",
    list: [
      "Бассейн с ионизированной водой, спортивные площадки",
      "Комнаты по 2–4 человека с собственным санузлом",
      "5-разовое питание, учёт аллергий по запросу",
      "Медработник 24/7, охрана, видеонаблюдение, закрытая территория"
    ]
  },
  {
    h2: "Критерии выбора лучшего лагеря",
    text: "Редакция vc.ru включила АйДаКемп в <a href='https://vc.ru/gdekurs/1216219' target='_blank' rel='noopener' class='text-primary underline'>ТОП-4 IT-лагерей Подмосковья</a>. Если хотите составить свой рейтинг, вот реальный чек-лист.",
    list: [
      "Лицензия Минобрнауки — без неё нельзя получить налоговый вычет, а лагерь не имеет права называться образовательным",
      "Соотношение педагог/ребёнок — хороший показатель: 1 преподаватель на 6–8 учеников. Больше — теряется индивидуальный подход",
      "Хакатон в конце смены — показатель настоящей программы, а не «кружка для галочки»",
      "Отзывы на Яндекс.Картах (не только на сайте лагеря) — независимая площадка",
      "Договор с указанием стоимости смены и страховка — защита ваших прав"
    ]
  },
  {
    h2: "Смены 2026 — лучшее место уходит первым",
    text: "АйДаКемп работает с конца мая по август 2026. Смены 7–14 дней, стоимость от 48 000 ₽. В стоимость включены проживание, питание, полная IT-программа, бассейн, активности и страховка. Трансфер из Москвы — 2 000 ₽ в одну сторону. Группы до 8 человек — число мест ограничено. Июньские смены закрываются первыми.",
    list: [
      "Смена 1 — 30 мая–8 июня, 10 дней, 74 900 ₽",
      "Смена 2 — 10–23 июня, 14 дней, 95 000 ₽ (самая популярная)",
      "Смена 3 — 3–15 августа, 13 дней, 89 400 ₽",
      "Смена 4 — 17–26 августа, 10 дней, 74 900 ₽",
      "Короткие смены от 7 дней — от 48 000 ₽"
    ]
  },
  {
    h2: "Как составить рейтинг лагеря самостоятельно",
    text: "Официальных рейтингов детских лагерей Подмосковья не существует — каждый составляет их сам. Но есть работающая методика, которой пользуются опытные родители.",
    list: [
      "Лицензия — проверяете номер лагеря в реестре Минобрнауки. Есть номер — плюс в рейтинг. Нет — лагерь из рейтинга сразу вылетает",
      "Отзывы на Яндекс.Картах и 2ГИС — смотрите не только оценку, но и количество и дату. 5.0 из 3 отзывов — это не рейтинг. 5.0 из 40+ отзывов за 5 лет — это сигнал",
      "Программа — есть ли конкретные результаты? «Развитие и всестороннее обучение» — это не программа. Готовый проект на хакатоне в конце смены — это программа",
      "Безопасность — медработник 24/7 или «вызовем при необходимости»? Охрана или открытая территория? Туроператорский реестр или просто ООО?",
      "Прозрачность цен — есть ли публичный прайс? Высылают ли договор до оплаты? Чем меньше прозрачности — тем хуже место в личном рейтинге"
    ]
  },
  {
    h2: "АйДаКемп в рейтингах — факты, которые можно проверить",
    text: "Мы не просим верить нам на слово. Вот конкретные факты, которые проверяются за 5 минут.",
    list: [
      "Рейтинг 5.0 на Яндекс.Картах — 40+ отзывов за 5 лет (с 2021 года), от реальных родителей, не накрученных",
      "Образовательная лицензия Минобрнауки Л035-01298-77/01082973 — <a href='/docs/licenziya-rosobrnadzor.pdf' target='_blank' rel='noopener' class='text-primary underline'>посмотрите документ</a>",
      "Реестровый туроператор РТО 025773 — проверяйте на tourism.gov.ru, раздел «Реестр туроператоров»",
      "Страховка ВСК — договор страхования ответственности и несчастных случаев для каждого ребёнка",
      "Более 1 200 детей с 2021 года — лагерь работает 6 смен в год, родители возвращаются повторно"
    ]
  },
  {
    h2: "Что говорят родители",
    text: "Рейтинг складывается из реальных отзывов. Вот что пишут семьи, уже побывавшие в АйДаКемп:",
    list: [
      "«Смотрела рейтинги лагерей месяц. Везде обещают, здесь сдержали. Сын вернулся с реальным проектом — ботом, который рассылает уведомления в Telegram» — Ольга, мама Максима, 12 лет",
      "«Лучший лагерь, в котором была дочь за 5 лет. Преподаватели умеют объяснять, кормят хорошо, территория чистая» — Светлана, мама Алины, 10 лет",
      "«Критерии выбора: безопасность, программа, отзывы. АйДаКемп закрыл все три. Плюс оформили налоговый вычет» — Игорь, папа Димы, 13 лет"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лучшие детские лагеря Подмосковья 2026 — рейтинг, как выбрать"
  description="Лучшие детские лагеря Подмосковья 2026 — что смотреть при выборе. АйДаКемп: рейтинг 5.0, лицензия Минобрнауки, IT-программа. От 48 000 ₽."
  h1="Лучшие детские лагеря Подмосковья 2026 — рейтинг и как выбрать"
  canonical="https://aidacamp.ru/luchshie-detskie-lagerya"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как выбрать лучший детский лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "Проверьте образовательную лицензию Минобрнауки, отзывы на независимых площадках (Яндекс.Карты, Google Maps), наличие договора с туроператором, медработника и страховки. У лучших лагерей всё это есть в открытом доступе." }
        },
        {
          "@type": "Question",
          "name": "Какой лагерь считается лучшим для детей, которые любят игры?",
          "acceptedAnswer": { "@type": "Answer", "text": "IT-лагерь, где ребёнок переходит от «я играю» к «я создаю игры». В АйДаКемп дети делают моды в Minecraft, собственные игры в Roblox Studio и ботов на Python. Это перенаправляет интерес в продуктивное русло." }
        },
        {
          "@type": "Question",
          "name": "Что входит в стоимость путёвки в лучшем лагере?",
          "acceptedAnswer": { "@type": "Answer", "text": "В АйДаКемп в стоимость включены: проживание (комнаты 2–4 чел. с санузлом), 5-разовое питание, полная IT-программа (2 занятия в день по 90 мин.), бассейн, вечерние активности, страховка. Дополнительно — трансфер из Москвы (2 000 ₽)." }
        },
        {
          "@type": "Question",
          "name": "С какого возраста можно отправить ребёнка в детский лагерь?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп принимает детей от 7 до 15 лет. Группы формируются по возрасту и уровню: начинающие (7–9 лет), средний (10–12 лет), продвинутые (13–15 лет). Опыт в программировании не требуется." }
        },
        {
          "@type": "Question",
          "name": "Есть ли рейтинг детских лагерей Подмосковья?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — в рейтинге лучших IT-лагерей Подмосковья с 2021 года: рейтинг 5.0 на Яндекс.Картах (40+ отзывов), образовательная лицензия Минобрнауки, реестровый туроператор. Более 1 200 детей за 5 лет." }
        }
      ]
    })} />
    <CourseSchema
      name="АйДаКемп — лучший IT-лагерь для детей в Подмосковье"
      description="IT-лагерь с образовательной лицензией, рейтинг 5.0 на Яндекс.Картах. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/luchshie-detskie-lagerya"
      ageMin={7}
      ageMax={15}
    />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лучшие детские лагеря Подмосковья 2026 — рейтинг и как выбрать"
    subtitle="АйДаКемп — рейтинг 5.0 на Яндекс.Картах, лицензия Минобрнауки, 5 лет работы. Python, AI, Minecraft для детей 7–15 лет."
    breadcrumb="Лучшие лагеря"
    keywords={["Рейтинг 5.0 на Яндекс.Картах — 40+ отзывов за 5 лет", "Лицензия Минобрнауки Л035-01298-77/01082973 — для налогового вычета", "IT-программа: Python, AI, Minecraft, 3D — по выбору ребёнка"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Лучший детский лагерь Подмосковья — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
