---
import { PRICE_MAX, PRICE_MIN, SEASON_YEAR } from '../data/shifts';
import { campNiches, moreYandexCamps, catalogCamps, RATING_AS_OF } from '../data/luchshieCamps';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import OurCampFeatured from '../components/luchshie/OurCampFeatured.astro';
import RatingByNiche from '../components/luchshie/RatingByNiche.astro';
import CompactRating from '../components/luchshie/CompactRating.astro';
import CatalogRating from '../components/luchshie/CatalogRating.astro';
import ItemListSchema from '../components/luchshie/ItemListSchema.astro';

// Методические секции (как выбрать/сравнить детские лагеря). АйДаКемп-промо вынесено в featured-блок,
// сам список — объективный по оценкам Яндекс.Карт (campNiches).
const sections = [
  {
    h2: "Как самостоятельно сравнить детские лагеря",
    text: "Официального списка нет — каждый родитель сравнивает варианты сам, по одним и тем же пунктам, а не по фото на сайте.",
    list: [
      "Оценка на Яндекс.Картах — самый простой ориентир, но смотрите не только цифру, а и число отзывов: 5.0 из 3 ≠ 5.0 из 100+",
      "Лицензия Минобрнауки — обязательна для образовательных программ детских лагерей, проверяется в реестре Рособрнадзора, без неё нельзя оформить вычет",
      "Программа с понятным результатом (проект, диплом) — а не размытое «развитие и обучение»",
    ],
  },
  {
    h2: "Критерии выбора детского лагеря",
    text: "Редакция vc.ru включила наш детский лагерь в <a href='https://vc.ru/gdekurs/1216219' target='_blank' rel='noopener' class='text-primary underline'>топ-4 IT-программ области</a>. Короткий чек-лист для выбора — подходит и младшим школьникам, и подросткам.",
    list: [
      "1 преподаватель на 6–8 ребят — комфортное соотношение",
      "Отзывы на Яндекс.Картах — независимая площадка, накрутить сложно",
    ],
  },
  {
    h2: "Что важно родителям при выборе",
    text: "Три вещи, на которые чаще всего смотрят родители, сравнивая детские лагеря:",
    list: [
      "Реальный результат смены — проект или диплом, а не размытое «развитие и обучение»",
      "Условия на территории — питание, медработник, безопасность, а не только красивые фото",
      "Налоговый вычет — оформляется проще, если лагерь сразу даёт нужные документы",
    ],
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title={`Детский лагерь в Подмосковье ${SEASON_YEAR}: как выбрать для детей и подростков`}
  description={`Подборка детских лагерей Подмосковья ${SEASON_YEAR} для детей и подростков: Москва, Московская область, Россия. Реальные оценки родителей на Яндекс.Картах — IT, языковые, спортивные, творческие, оздоровительные. Как выбрать детский лагерь.`}
  h1={`Детские лагеря Подмосковья и России ${SEASON_YEAR}: как выбрать для детей и подростков`}
  canonical="https://aidacamp.ru/luchshie-detskie-lagerya"
>
  <Fragment slot="head">
    <CourseSchema
      name="АйДаКемп — IT-лагерь для детей в Подмосковье"
      description="Загородный IT-лагерь с образовательной лицензией, рейтинг 5.0 на Яндекс.Картах. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/luchshie-detskie-lagerya"
      ageMin={7}
      ageMax={15}
    />
    <ItemListSchema niches={campNiches} compactCamps={moreYandexCamps} catalogCamps={catalogCamps} />
  </Fragment>
  <LandingHero slot="hero"
    h1={`Детские лагеря Подмосковья и России ${SEASON_YEAR}: как выбрать для детей и подростков`}
    subtitle="Собрали детские лагеря Подмосковья по нишам — IT, языковые, спорт, творчество, оздоровление, приключения — для детей и подростков. Отдельно — наш загородный детский IT-лагерь АйДаКемп."
    breadcrumb="Детские лагеря"
    keywords={[`Данные обновлены: ${RATING_AS_OF}`, "Топ по отзывам родителей на Яндекс.Картах", "Что отмечают родители — по реальным отзывам", "Честно: только проверяемые оценки, без накруток"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детские лагеря Подмосковья — как выбрать для детей и подростков"
  />

  <OurCampFeatured />

  <RatingByNiche niches={campNiches} asOf={RATING_AS_OF} />

  <CompactRating camps={moreYandexCamps} asOf={RATING_AS_OF} />

  <CatalogRating camps={catalogCamps} asOf={RATING_AS_OF} />

  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ only={['safety', 'medicine']} extraItems={[
    { q: "Как выбрать лучший детский лагерь?", a: "Проверьте лицензию Минобрнауки, отзывы на Яндекс.Картах и 2ГИС, договор с туроператором и медработника на месте. У сильных вариантов это есть в открытом доступе." },
    { q: "Есть ли официальный рейтинг лагерей в Подмосковье?", a: "Официального списка нет. Мы собрали детские лагеря Подмосковья и области по оценкам родителей на Яндекс.Картах — по нишам: IT, языки, спорт, творчество, оздоровление." },
    { q: "Какой лагерь считается лучшим для детей, которые любят игры?", a: "Самый частый выбор — IT-формат, где ребёнок идёт от «играю» к «создаю игры». В АйДаКемп дети делают моды в Minecraft, игры в Roblox Studio и ботов на Python." },
    { q: "С какого возраста можно отправить ребёнка в детский лагерь?", a: "Большинство вариантов берут детей с 6–7 лет. АйДаКемп — от 7 до 15 лет, группы по возрасту и уровню." }
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
