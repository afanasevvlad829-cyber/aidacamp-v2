---
import { PRICE_MAX, PRICE_MIN } from '../data/shifts';
import { campNiches, moreYandexCamps, catalogCamps, RATING_AS_OF } from '../data/luchshieCamps';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import OurCampFeatured from '../components/luchshie/OurCampFeatured.astro';
import RatingByNiche from '../components/luchshie/RatingByNiche.astro';
import CompactRating from '../components/luchshie/CompactRating.astro';
import CatalogRating from '../components/luchshie/CatalogRating.astro';
import ItemListSchema from '../components/luchshie/ItemListSchema.astro';

// Методические секции (как выбрать/составить рейтинг). АйДаКемп-промо вынесено в featured-блок,
// сам рейтинг — объективный по оценкам Яндекс.Карт (campNiches).
const sections = [
  {
    h2: "Как составить рейтинг лагеря самостоятельно",
    text: "Официального рейтинга лучших детских лагерей Москвы и Подмосковья не существует — каждый родитель составляет его сам. Ниже — работающая методика, по которой мы и упорядочили лагеря выше: сначала независимая оценка Яндекс.Карт, затем проверяемые факты.",
    list: [
      "Оценка на Яндекс.Картах — независимая площадка. Смотрите не только оценку, но и количество отзывов: 5.0 из 3 отзывов ≠ 5.0 из 100+",
      "Лицензия Минобрнауки — проверяете номер в реестре Рособрнадзора. Есть — плюс, нет — образовательным лагерь называться не вправе (и вычет не получить)",
      "Программа — конкретный результат (проект, диплом) против размытого «развитие и обучение»",
      "Безопасность — медработник 24/7, охрана, закрытая территория, реестровый туроператор",
      "Прозрачность цен — публичный прайс и договор до оплаты",
    ],
  },
  {
    h2: "Критерии выбора лучшего лагеря",
    text: "Редакция vc.ru включила АйДаКемп в <a href='https://vc.ru/gdekurs/1216219' target='_blank' rel='noopener' class='text-primary underline'>ТОП-4 IT-лагерей Подмосковья</a>. Если хотите составить свой рейтинг — вот реальный чек-лист.",
    list: [
      "Лицензия Минобрнауки — без неё нельзя получить налоговый вычет",
      "Соотношение педагог/ребёнок — хорошо, когда 1 преподаватель на 6–8 учеников",
      "Хакатон или защита проекта в конце смены — показатель настоящей программы",
      "Отзывы на Яндекс.Картах, а не только на сайте лагеря",
      "Договор с указанием стоимости смены — защита ваших прав",
    ],
  },
  {
    h2: "Что говорят родители",
    text: "Рейтинг складывается из реальных отзывов. Вот что пишут семьи, уже побывавшие в АйДаКемп:",
    list: [
      "«Смотрела рейтинги лагерей месяц. Везде обещают, здесь сдержали. Сын вернулся с реальным проектом — ботом в Telegram» — Ольга, мама Максима, 12 лет",
      "«Лучший лагерь, в котором была дочь за 5 лет. Преподаватели умеют объяснять, кормят хорошо, территория чистая» — Светлана, мама Алины, 10 лет",
      "«Критерии выбора: безопасность, программа, отзывы. АйДаКемп закрыл все три. Плюс оформили налоговый вычет» — Игорь, папа Димы, 13 лет",
    ],
  },
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="Лучшие детские лагеря Подмосковья 2026 — рейтинг по оценкам Яндекс.Карт"
  description={`Рейтинг лучших детских лагерей Москвы и Подмосковья 2026 по реальным оценкам родителей на Яндекс.Картах — IT, языковые, спортивные, творческие, оздоровительные. Как выбрать лагерь.`}
  h1="Лучшие детские лагеря Подмосковья 2026 — рейтинг по оценкам Яндекс.Карт"
  canonical="https://aidacamp.ru/luchshie-detskie-lagerya"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как выбрать лучший детский лагерь?", a: "Проверьте образовательную лицензию Минобрнауки, отзывы на независимых площадках (Яндекс.Карты, 2ГИС), наличие договора с туроператором и медработника. У лучших лагерей всё это есть в открытом доступе." },
    { q: "Есть ли официальный рейтинг детских лагерей Подмосковья?", a: "Официального рейтинга нет. На этой странице мы упорядочили лагеря по реальным оценкам родителей на Яндекс.Картах, по нишам — IT, языковые, спортивные, творческие, оздоровительные. Оценки можно проверить на карточках лагерей." },
    { q: "Какой лагерь считается лучшим для детей, которые любят игры?", a: "IT-лагерь, где ребёнок переходит от «я играю» к «я создаю игры». В АйДаКемп дети делают моды в Minecraft, игры в Roblox Studio и ботов на Python." },
    { q: "С какого возраста можно отправить ребёнка в детский лагерь?", a: "Большинство лагерей принимают детей с 6–7 лет. АйДаКемп — от 7 до 15 лет, группы формируются по возрасту и уровню." },
    { q: "Как считается оценка в рейтинге?", a: `Это реальная оценка лагеря на Яндекс.Картах (данные на ${RATING_AS_OF}). Внутри каждой ниши сортировка по оценке и числу отзывов. Включены только лагеря с собственной карточкой на Яндекс.Картах.` },
    { q: "Какой лагерь считается лучшим в Москве и области?", a: "Большинство лучших лагерей физически расположены за городом, в Московской области — территория и природа важнее почтового адреса. При выборе смотрите не на «Москва» или «область» в названии, а на отзывы, лицензию и транспортную доступность от метро." }
  ]} />
    <CourseSchema
      name="АйДаКемп — IT-лагерь для детей в Подмосковье"
      description="Загородный IT-лагерь с образовательной лицензией, рейтинг 5.0 на Яндекс.Картах. Python, AI, Minecraft для детей 7–15 лет."
      url="https://aidacamp.ru/luchshie-detskie-lagerya"
      ageMin={7}
      ageMax={15}
    />
    <ItemListSchema niches={campNiches} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лучшие детские лагеря Подмосковья 2026 — рейтинг по оценкам Яндекс.Карт"
    subtitle="Собрали лагеря Московской области по нишам — IT, языковые, спорт, творчество, оздоровление, приключения. Отдельно — наш загородный IT-лагерь АйДаКемп."
    breadcrumb="Лучшие лагеря"
    keywords={["110+ лагерей области с рейтингом и отзывами", "Что отмечают родители — по реальным отзывам", "Честно: только проверяемые оценки, без накруток"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Лучшие детские лагеря Подмосковья — рейтинг"
  />

  <OurCampFeatured />

  <RatingByNiche niches={campNiches} asOf={RATING_AS_OF} />

  <CompactRating camps={moreYandexCamps} asOf={RATING_AS_OF} />

  <CatalogRating camps={catalogCamps} asOf={RATING_AS_OF} />

  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
