---
import { PRICE_MIN, SEASON_YEAR, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_DISTANCE, STAT_YEARS, STAT_KIDS, STAT_IT_CONTINUE, STAT_RATING } from '../data/contacts';
import { SEASON_FROM_TO } from '../data/evergreen';

const sections = [
  {
    h2: "Что такое компьютерный лагерь АйДаКемп",
    text: "Компьютерный лагерь — это не «сидеть за экраном весь день». Дети создают собственный проект: игровой мир, бота, анимацию или нейросетевой эксперимент — и за смену проходят путь от идеи до результата, который можно показать родителям. АйДаКемп находится в Подмосковье, в 66 км от МКАД по Киевскому шоссе — территория санатория «Изумруд» с бассейном и 5-разовым питанием."
  },
  {
    h2: "Программы компьютерного лагеря — выбери направление",
    text: "В зависимости от возраста и интересов ребёнок выбирает трек. Группы до 8 человек, у каждого трека свой преподаватель. Развивающие IT-программы адаптированы по возрасту: от Scratch для 7-летних до работы с реальными AI-API для 14-летних.",
    list: [
      "<a href='/python-lager/' class='text-[#ec7c00] hover:underline'>Python</a> — программирование для 10–15 лет: боты, игры, работа с данными",
      "<a href='/ai-lager/' class='text-[#ec7c00] hover:underline'>AI</a> — нейросети и искусственный интеллект для 11–15 лет",
      "<a href='/minecraft-lager/' class='text-[#ec7c00] hover:underline'>Minecraft</a> — программирование через любимую игру для 8–12 лет",
      "<a href='/scratch-lager/' class='text-[#ec7c00] hover:underline'>Scratch</a> — визуальное программирование для 7–10 лет",
      "<a href='/roblox-lager/' class='text-[#ec7c00] hover:underline'>Roblox</a> — создание игр на Lua для 9–13 лет",
      "<a href='/3d-modelirovanie-lager/' class='text-[#ec7c00] hover:underline'>3D-моделирование</a> — Blender и 3D-печать для 10–14 лет"
    ]
  },
  {
    h2: "Траектория за смену",
    text: "День 1–2 — основы языка и среды разработки. День 7 — первый рабочий проект, нередко игровой: запускается и выдаёт результат. День 14 — защита на хакатоне перед жюри и родителями."
  },
  {
    h2: "Чем компьютерный лагерь отличается от кружка",
    text: "В отличие от городского дневного формата, здесь ребёнок покидает привычную среду — школьник переключается по-настоящему. В отличие от онлайн-школ и недельных курсов, это полное погружение: утром занятия, днём активности (бассейн, спорт, командные игры), вечером — работа над проектом, а не «продолжим в следующем месяце». Смартфонов в кармане нет — экранное время зарабатывается за участие и помощь другим. Этот формат часто называют <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT camp</a>."
  },
  {
    h2: "Стоимость и смены компьютерного лагеря",
    text: `Летние каникулы в компьютерном лагере — 10 или 13 дней полного погружения: два IT-блока в день, бассейн, хакатон в финале. Смены проходят ${SEASON_FROM_TO} ${SEASON_YEAR} года. В стоимость путёвки включены: проживание, питание (5 раз в день), полная IT-программа, активности и трансфер (опция). Цены — от ${PRICE_MIN} за 10-дневную смену. <a href='/nalogovyj-vychet/' class='text-[#ec7c00] hover:underline'>Налоговый вычет 13%</a> — возврат до ${VYCHET_MAX} через ФНС. Рейтинг ${STAT_RATING} на Яндекс.Картах собран отзывами родителей.`
  },
  {
    h2: "Команда преподавателей",
    text: "Подростку интересно учиться у того, кто сам пишет код — не у школьного учителя информатики с учебником 2015 года. В АйДаКемп преподают студенты МФТИ, Бауманки, ВШЭ и практикующие разработчики, которые работают в IT-компаниях.",
    list: [
      "Преподаватели — студенты топ-вузов (МФТИ, Бауманка, ВШЭ) и практикующие разработчики",
      "1 преподаватель на 6 учеников — каждый вопрос слышат и разбирают",
      "Финальный хакатон принимают преподаватели + приглашённые IT-специалисты из индустрии"
    ]
  },
  {
    h2: "Какие технологии и языки учат дети в компьютерном лагере",
    text: "Программа подбирается по возрасту и уровню.",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые игры и анимации без клавиатуры",
      "Minecraft Education Edition (8–12 лет) — обучение через создание модов на Python, настройка серверов, логика редстоуна",
      "Python базовый (10–14 лет) — синтаксис, переменные, циклы, функции, первые скрипты",
      "Python Advanced (12–14 лет) — классы, работа с API, Telegram-боты, парсинг сайтов",
      "AI и нейросети (11–14 лет) — Gemini, Claude, ChatGPT как помощники программиста; генерация изображений",
      "Веб и дизайн (10–14 лет) — Figma для макетов, HTML/CSS для лендингов, принципы UX/UI"
    ]
  },
  {
    h2: "День в компьютерном лагере — расписание",
    text: "Самый частый вопрос от родителей: «Не сидят ли они за компьютером с утра до ночи?» Нет — IT-занятия идут двумя блоками по 90 минут, утром и вечером, а середина дня — бассейн, спорт, воздух.",
    list: [
      "08:00 — подъём, зарядка, завтрак",
      "09:00–10:30 — IT-занятия: первый блок в малых группах (до 8 человек)",
      "10:30 — перерыв и перекус",
      "11:00–12:30 — IT-занятия: второй блок, работа над проектом",
      "13:00 — обед",
      "14:00–17:00 — активности на свежем воздухе: бассейн, спортплощадка, командные игры (обязательная часть дня — без движения IT-занятия усваиваются хуже)",
      "17:00 — полдник",
      "18:00–19:30 — работа над финальным проектом в группе с преподавателем",
      "20:00 — ужин и вечерняя программа (квесты, настолки, кино)",
      "22:00 — отбой"
    ]
  },
  {
    h2: "Уровни подготовки в компьютерном лагере",
    text: "Боитесь, что ребёнок окажется в группе не по уровню? В АйДаКемп в первый день — короткая диагностика на 15 минут, и по результату группа из трёх уровней. Никаких стрессов и оценок.",
    list: [
      "Новичок — никогда не программировал. Начинаем с нуля, без страха ошибиться",
      "Продолжающий — знает основы. Идём к реальному проекту",
      "Продвинутый — уверенно программирует. Работаем над сложными задачами: API, боты, алгоритмы",
      "Перегнал свою группу за первые 2 дня — переводим в следующую"
    ]
  },
  {
    h2: "Финальный хакатон — защита проектов",
    text: "В последний день смены каждый ребёнок выходит на сцену и представляет свой проект. Не сдаёт домашку — а по-настоящему выступает перед аудиторией: рассказывает что сделал, отвечает на вопросы, получает аплодисменты. Мамы, которые смотрели трансляцию, говорят: это было неожиданно трогательно.",
    list: [
      "Каждый ребёнок выступает сам — личный проект, не групповой",
      "Жюри: преподаватели + приглашённые IT-специалисты",
      "Лучшие проекты получают дипломы и призы от АйДаКемп",
      "Родители смотрят лично, на трансляции или в видеозаписи, которую отправляем каждой семье",
      "По данным наших опросов, 78% детей продолжают заниматься IT после лагеря"
    ]
  },
  {
    h2: "Оборудование компьютерного лагеря",
    text: "В АйДаКемп ребёнку не нужно везти свой ноутбук — мы выдаём на каждого. Домашние ноутбуки не всегда подходят для IT-занятий: нет нужного ПО, слабое железо. Наш парк техники рассчитан под программу.",
    list: [
      "Ноутбуки — 25 штук MacBook Air / Lenovo ThinkPad для занятий (по 1 на ребёнка)",
      "Интерактивная доска Promethean 75″ в учебном классе",
      "3D-принтеры Prusa i3 MK3S — дети печатают свои 3D-модели",
      "VR-гарнитуры Meta Quest 2 × 2 шт — раз в смену VR-день",
      "Wi-Fi 6 во всех помещениях с ограничением по белому списку (никаких TikTok и игр в браузере)"
    ]
  },
  {
    h2: "Примеры реальных проектов, которые делали дети",
    text: `За ${STAT_YEARS} лет через АйДаКемп прошли ~${STAT_KIDS} детей — и каждый увёз свой проект. Четыре примера: «проект в лагере» — это не игрушечная поделка, а то, чем ребёнок гордо похвастается бабушке.`,
    list: [
      "«Бот-помощник для уроков» (Python, 12 лет) — Telegram-бот, который напоминает домашку и отвечает на вопросы одноклассников",
      "«Minecraft-карта Битва при Москве» (Minecraft Edu, 10 лет) — историческая карта, защитилась как проект для школы",
      "«Игра «Уборка комнаты»» (Scratch, 8 лет) — тренажёрная игра с 10 уровнями по просьбе родителей",
      "«Лендинг dog walking бизнеса» (Figma + HTML, 14 лет) — реальный запуск летнего бизнеса на выгул соседских собак"
    ]
  }
];

// Это хаб IT-направлений — даём ссылки на все 5 узких LP + лагерь программирования
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title={`Детский летний компьютерный лагерь для детей в Подмосковье ${SEASON_YEAR} — Python, AI, Roblox | АйДаКемп`}
  description={`Летний компьютерный лагерь для детей с проживанием в Подмосковье ${SEASON_YEAR}. Python, AI, Minecraft, Roblox — реальный проект за смену. Группы по 8 чел., 66 км от МКАД. От ${PRICE_MIN}.`}
  h1="Летний компьютерный лагерь в Подмосковье — небольшие группы детей"
  canonical="https://aidacamp.ru/kompyuternyy-lager"
>
  <LandingHero slot="hero"
    h1="Летний компьютерный лагерь в Подмосковье — небольшие группы детей"
    subtitle={`АйДаКемп — летняя IT-программа для детей с проживанием. Школьники 7–15 лет изучают Python, AI и создают собственные проекты за смену. Июль ${SEASON_YEAR} занят полностью.`}
    breadcrumb="Компьютерный лагерь"
    keywords={["Python, AI, Minecraft — реальный проект за смену", "Без телефонов: экранное время зарабатывается", `${STAT_DISTANCE} от Москвы, бассейн, 5-разовое питание`]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="Компьютерный лагерь для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Что такое компьютерный лагерь для детей?", a: "Компьютерный лагерь — это загородная программа с IT-занятиями и проживанием. В АйДаКемп дети занимаются программированием дважды в день по 90 минут (Python, AI, Minecraft, 3D), а вечером работают над своим проектом. В финале — хакатон с защитой проекта." },
    { q: "С какого возраста ребёнок может идти в компьютерный лагерь?", a: "С 7 лет. В АйДаКемп есть группы для разных возрастов: 7–10 лет — Scratch и Minecraft (без предварительных знаний), 10–12 лет — Python, 13–15 лет — Python Advanced и AI. Группы до 8 человек, у каждой свой преподаватель." },
    { q: "Какой результат ребёнок получит после компьютерного лагеря?", a: "Готовый IT-проект: игра, бот, сайт или 3D-модель — зависит от трека. Проект защищается на финальном хакатоне. Родители получают видеозапись защиты. По данным наших опросов, 78% детей продолжают занятия IT после лагеря." }
  ]} only={['medicine', 'safety', 'food', 'accommodation', 'communication', 'payment']} />
  <RelatedArticles articles={[
    { title: "ИИ заменит программиста? Что стоит знать родителям", url: "/stati/ii-zamenit-programmista/", description: "Почему умение работать с AI — самый нужный навык ближайшего десятилетия.", icon: "cpu" },
    { title: "«Просто играет» или уже зависимость? 7 признаков игромании", url: "/stati/igromaniya-u-detej/", description: "Чек-лист признаков для родителей — когда увлечение переходит черту.", icon: "controller" },
    { title: "Хакатон в детском лагере — как это устроено", url: "/stati/hakaton-v-detskom-lagere/", description: "Почему защита проекта — ключевой момент каждой смены АйДаКемп.", icon: "trophy" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
