---
import { PRICE_MIN, VYCHET_MAX } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { STAT_DISTANCE } from '../data/contacts';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Что такое компьютерный лагерь АйДаКемп",
    text: "Компьютерный лагерь — это не «сидеть за экраном весь день». Это место, где дети создают собственный проект: игру, бота, анимацию или нейросетевой эксперимент. За каждую смену дети проходят путь от идеи до готового результата, который можно показать родителям. Лагерь находится в Подмосковье, в 66 км от МКАД по Киевскому шоссе — на территории санатория «Изумруд» с бассейном и 5-разовым питанием."
  },
  {
    h2: "Программы компьютерного лагеря — выбери направление",
    text: "В зависимости от возраста и интересов ребёнок выбирает трек. Все направления доступны в каждой смене. Группы до 8 человек, у каждого трека свой преподаватель.",
    list: [
      "<a href='/python-lager/' class='text-[#ec7c00] hover:underline'>Python-лагерь</a> — программирование для 10–15 лет: боты, игры, работа с данными",
      "<a href='/ai-lager/' class='text-[#ec7c00] hover:underline'>AI-лагерь</a> — нейросети и искусственный интеллект для 11–15 лет",
      "<a href='/minecraft-lager/' class='text-[#ec7c00] hover:underline'>Minecraft-лагерь</a> — программирование через любимую игру для 8–12 лет",
      "<a href='/scratch-lager/' class='text-[#ec7c00] hover:underline'>Scratch-лагерь</a> — визуальное программирование для 7–10 лет",
      "<a href='/roblox-lager/' class='text-[#ec7c00] hover:underline'>Roblox-лагерь</a> — создание игр на Lua для 9–13 лет",
      "<a href='/3d-modelirovanie-lager/' class='text-[#ec7c00] hover:underline'>Лагерь 3D-моделирования</a> — Blender и 3D-печать для 10–14 лет"
    ]
  },
  {
    h2: "Программа компьютерного лагеря",
    text: "Занятия адаптированы под возраст — группы 7–10, 10–12 и 13–15 лет. Направления: Python, AI и нейросети, Minecraft-разработка, Scratch, веб и дизайн. Траектория за 14 дней: День 1–2 — основы языка и среды разработки. День 7 — первый рабочий проект: запускается, выдаёт результат. День 14 — защита на хакатоне перед жюри и родителями.",
    list: [
      "Python и основы программирования — с нуля до рабочего проекта",
      "AI и нейросети — практика с ChatGPT и реальными инструментами",
      "Minecraft — создание собственных миров и модов",
      "Дизайн и анимация — Figma, графика, интерфейсы"
    ]
  },
  {
    h2: "Чем компьютерный лагерь отличается от кружка",
    text: "В отличие от недельных курсов, лагерь даёт полное погружение: утром занятия, днём активности (бассейн, спорт, командные игры), вечером — работа над проектом. Здесь нет смартфонов в кармане — экранное время зарабатывается за участие и помощь другим. Это учит ценить время и работать осознанно. Этот лагерь часто называют <a href='/it-camp/' class='text-[#ec7c00] hover:underline'>IT camp</a> — полным погружением в технологии."
  },
  {
    h2: "Стоимость и смены компьютерного лагеря",
    text: `Смены проходят с июня по август 2026 года. Продолжительность — 10 и 13 дней. В стоимость включены: проживание, питание (5 раз в день), полная IT-программа, активности и трансфер (опция). Цены — от ${PRICE_MIN} за 10-дневную смену. <a href='/nalogovyj-vychet/' class='text-[#ec7c00] hover:underline'>Налоговый вычет 13%</a> — возврат до ${VYCHET_MAX} через ФНС. Июль 2026 полностью занят. Свободные места: июнь и август — уточняйте актуальность при бронировании.`
  },
  {
    h2: "Что ребёнок сделает за смену",
    text: "«Сделали проект» — это звучит абстрактно, пока не видишь что именно. Вот конкретика по трекам, которую родители показывают бабушкам:",
    list: [
      "Python: Telegram-бот с командами, игра на pygame с уровнями и очками, скрипт автоматизации домашних задач",
      "AI: бот с ChatGPT API, который отвечает на вопросы в своём стиле; генератор аватарок по описанию; голосовой ассистент на Python",
      "Roblox: собственная карта с правилами и NPC-персонажами; мод с новыми игровыми механиками и инвентарём",
      "Minecraft: историческая карта с воссозданием реальных событий; кастомный мод на Java с новыми блоками",
      "3D-моделирование: персонаж или объект в Blender + распечатанная на 3D-принтере физическая модель"
    ]
  },
  {
    h2: "Команда преподавателей",
    text: "Подростку интересно учиться у того, кто сам пишет код — не у школьного учителя информатики с учебником 2015 года. В АйДаКемп преподают студенты МФТИ, Бауманки, ВШЭ и практикующие разработчики, которые работают в IT-компаниях. Соотношение 1 преподаватель на 6 учеников — не потоковый курс, а почти персональная работа.",
    list: [
      "Преподаватели — студенты топ-вузов (МФТИ, Бауманка, ВШЭ) и практикующие разработчики",
      "1 преподаватель на 6 учеников — каждый вопрос слышат и разбирают",
      "В первый день смены — диагностика уровня: 15-минутная практическая задача, по результату распределяем в группу",
      "Если за 2 дня перерос группу — переводим без лишних разговоров",
      "Финальный хакатон принимают преподаватели + приглашённые IT-специалисты из индустрии"
    ]
  },
  {
    h2: "Какие технологии и языки учат дети в компьютерном лагере",
    text: "Программа подбирается по возрасту и уровню. На старте смены проходит диагностика — каждый делает простую задачу, по результатам попадает в правильную группу. Никто не оказывается «слишком маленьким» или «слишком продвинутым».",
    list: [
      "Scratch (7–9 лет) — визуальное программирование, первые игры и анимации без клавиатуры",
      "Minecraft Education Edition (8–12 лет) — обучение через создание модов на Python, настройка серверов, логика редстоуна",
      "Python базовый (10–14 лет) — синтаксис, переменные, циклы, функции, первые скрипты",
      "Python Advanced (12–14 лет) — классы, работа с API, Telegram-боты, парсинг сайтов",
      "AI и нейросети (11–14 лет) — Gemini, Claude, ChatGPT как помощники программиста; генерация изображений",
      "Веб и дизайн (10–14 лет) — Figma для макетов, HTML/CSS для лендингов, принципы UX/UI",
      "Робототехника (по желанию) — Lego Mindstorms, Arduino для старших"
    ]
  },
  {
    h2: "День в компьютерном лагере — расписание",
    text: "Самый частый вопрос от родителей: «А они там не сидят за компьютером с утра до ночи?». Нет. IT-занятия идут двумя блоками по 90 минут — утром и вечером. Середина дня — бассейн, спорт, воздух. Мы специально так построили расписание: ребёнок не выгорает от экрана и успевает соскучиться по программированию.",
    list: [
      "08:00 — подъём, зарядка, завтрак",
      "09:00–10:30 — IT-занятия: первый блок в малых группах (до 8 человек)",
      "10:30 — перерыв и перекус",
      "11:00–12:30 — IT-занятия: второй блок, работа над проектом",
      "13:00 — обед",
      "14:00–17:00 — активности на свежем воздухе: бассейн, спортплощадка, командные игры",
      "17:00 — полдник",
      "18:00–19:30 — работа над финальным проектом в группе с преподавателем",
      "20:00 — ужин и вечерняя программа (квесты, настолки, кино)",
      "22:00 — отбой"
    ]
  },
  {
    h2: "Уровни подготовки в компьютерном лагере",
    text: "Боитесь, что ребёнок окажется в группе, где все опытнее — или наоборот, заскучает, потому что всё уже знает? В АйДаКемп этого не бывает. В первый день смены каждый проходит короткую диагностику — практическую задачку на 15 минут. По результату попадает в одну из трёх групп. Никаких стрессов, никаких оценок — просто чтобы было интересно.",
    list: [
      "Новичок — никогда не программировал или делал только первые шаги. Начинаем с нуля, медленно и без страха ошибиться",
      "Продолжающий — знает основы, писал простые программы. Углубляемся и идём к реальному проекту с нуля",
      "Продвинутый — уверенно программирует, есть опыт. Работаем над сложными задачами: API, боты, собственные алгоритмы",
      "Если ребёнок за первые 2 дня перегнал свою группу — переводим в следующую без лишних разговоров"
    ]
  },
  {
    h2: "Финальный хакатон — защита проектов",
    text: "В последний день смены каждый ребёнок выходит на сцену и представляет свой проект. Не сдаёт домашку — а по-настоящему выступает перед аудиторией: рассказывает что сделал, отвечает на вопросы, получает аплодисменты. Мамы, которые смотрели трансляцию, говорят: это было неожиданно трогательно.",
    list: [
      "Каждый ребёнок выступает сам — личный проект, не групповой",
      "Жюри: преподаватели + приглашённые IT-специалисты",
      "Лучшие проекты получают дипломы и призы от АйДаКемп",
      "Родители могут приехать лично или подключиться к онлайн-трансляции",
      "Видеозапись защиты отправляем каждой семье — остаётся на память"
    ]
  },
  {
    h2: "Оборудование компьютерного лагеря",
    text: "В АйДаКемп ребёнку не нужно везти свой ноутбук — мы выдаём на каждого. Это важно: в поезде/машине гаджет может пострадать, а домашние ноутбуки родителей не всегда приспособлены для IT-занятий (нет нужного ПО, слабое железо). Наш парк железа рассчитан под программу.",
    list: [
      "Ноутбуки — 25 штук MacBook Air / Lenovo ThinkPad для занятий (по 1 на ребёнка)",
      "Интерактивная доска Promethean 75″ в учебном классе",
      "3D-принтеры Prusa i3 MK3S — дети печатают свои 3D-модели",
      "VR-гарнитуры Meta Quest 2 × 2 шт — раз в смену VR-день",
      "Проекционное оборудование в актовом зале — для защиты проектов",
      "Wi-Fi 6 во всех помещениях с ограничением по белому списку (никаких TikTok и игр в браузере)"
    ]
  },
  {
    h2: "Примеры реальных проектов, которые делали дети",
    text: "За 5 лет работы через АйДаКемп прошли ~1 200 детей. Каждый увёз свой проект. Для вдохновения — шесть реальных кейсов разных возрастов и уровней, чтобы вы понимали: «проект в лагере» это не игрушечная учебная поделка, а то, что ребёнок гордо покажет бабушке.",
    list: [
      "«Бот-помощник для уроков» (Python, 12 лет) — Telegram-бот, который напоминает домашку, хранит расписание и отвечает на вопросы одноклассников.",
      "«Minecraft-карта Битва при Москве» (Minecraft Edu, 10 лет) — историческая карта с воссозданием ключевых эпизодов 1941 года, защитилась как проект для школы.",
      "«Генератор аватарок для школьной группы» (Gemini API + Python, 13 лет) — ребёнок собрал скрипт, который генерирует стилизованные аватары для одноклассников.",
      "«Игра «Уборка комнаты»» (Scratch, 8 лет) — реакция на родительскую просьбу, получилась тренажёрная игра с 10 уровнями.",
      "«Калькулятор карманных денег» (Python + HTML, 11 лет) — сайт-учёт карманных, с возможностью «договариваться с родителем».",
      "«Лендинг своего dog walking бизнеса» (Figma + HTML, 14 лет) — реальный запуск летнего бизнеса на выгул соседских собак."
    ]
  },
  {
    h2: "Чем компьютерный лагерь с проживанием лучше онлайн-школ программирования",
    text: "Онлайн-школы (Алгоритмика, Кодемия, Skysmart) дают неплохой академический контент, но у них три проблемы. Первая — дистанционный формат: ребёнок постоянно соблазняется YouTube в соседней вкладке, родитель должен быть «надсмотрщиком». Вторая — нет социализации: ребёнок учится один у экрана, не видит реальных сверстников которые тоже программируют. Третья — результат размазан во времени: «ну в следующем месяце продолжим». Компьютерный лагерь решает всё это за 7–15 дней: полное погружение, живая команда, результат в виде защищённого проекта, который остаётся с ребёнком. Плюс — отдых, бассейн, спорт, новые друзья, сертификат и, наконец, неделя-две «тишины» для занятых родителей."
  }
];

// Это хаб IT-направлений — даём ссылки на все 5 узких LP + лагерь программирования
---

<LandingLayout
  heroImage="/images/hero/kompyuternyy-lager.avif"
  title="Детский компьютерный лагерь в Подмосковье 2026 — Python, AI, Roblox | АйДаКемп"
  description={`Детский компьютерный лагерь с проживанием в Подмосковье 2026. Python, AI, Minecraft, Roblox — реальный проект за смену. Группы по 8 чел., 66 км от МКАД. Июнь и август. От ${PRICE_MIN}.`}
  h1="Детский компьютерный лагерь в Подмосковье 2026 — Python, AI и Roblox в группах по 8 детей"
  canonical="https://aidacamp.ru/kompyuternyy-lager"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Что такое компьютерный лагерь для детей?", a: "Компьютерный лагерь — это загородный лагерь с IT-программой и проживанием. В АйДаКемп дети занимаются программированием дважды в день по 90 минут (Python, AI, Minecraft, 3D), а вечером работают над своим проектом. В финале — хакатон с защитой проекта." },
    { q: "С какого возраста ребёнок может идти в компьютерный лагерь?", a: "С 7 лет. В АйДаКемп есть группы для разных возрастов: 7–10 лет — Scratch и Minecraft (без предварительных знаний), 10–12 лет — Python, 13–15 лет — Python Advanced и AI. Группы до 8 человек, у каждой свой преподаватель." },
    { q: "Нужен ли ребёнку свой ноутбук в компьютерном лагере?", a: "Нет. В АйДаКемп вся техника предоставляется лагерем. Одинаковые устройства у всех — это помогает преподавателю одновременно помогать всем в группе. Личный ноутбук привозить не нужно." },
    { q: "Какой результат ребёнок получит после компьютерного лагеря?", a: "Готовый IT-проект: игра, бот, сайт или 3D-модель — зависит от трека. Проект защищается на финальном хакатоне. Родители получают видеозапись защиты. По данным наших опросов, 78% детей продолжают занятия IT после лагеря." }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Детский компьютерный лагерь в Подмосковье — Python, AI и Roblox в группах по 8 детей"
    subtitle="Летний компьютерный лагерь для детей с проживанием. Школьники 7–15 лет изучают Python, AI и создают собственные проекты за смену. Июль 2026 занят полностью."
    breadcrumb="Компьютерный лагерь"
    keywords={["Python, AI, Minecraft — реальный проект за смену", "Без телефонов: экранное время зарабатывается", `${STAT_DISTANCE} от Москвы, бассейн, 5-разовое питание`]}
    image="/images/hero/kompyuternyy-lager.avif"
    imageAlt="Компьютерный лагерь для детей в Подмосковье"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <RelatedArticles articles={[
    { title: "ИИ заменит программиста? Что стоит знать родителям", url: "/stati/ii-zamenit-programmista/", description: "Почему умение работать с AI — самый нужный навык ближайшего десятилетия.", icon: "cpu" },
    { title: "«Просто играет» или уже зависимость? 7 признаков игромании", url: "/stati/igromaniya-u-detej/", description: "Чек-лист признаков для родителей — когда увлечение переходит черту.", icon: "controller" },
    { title: "Хакатон в детском лагере — как это устроено", url: "/stati/hakaton-v-detskom-lagere/", description: "Почему защита проекта — ключевой момент каждой смены АйДаКемп.", icon: "trophy" },
  ]} />
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
