---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getInfoEffect } from '../lib/heroVariant';
import { allShifts, BYT_PER_DAY, SEASON_YEAR } from '../data/shifts';

const heroEffect = getInfoEffect('politika-vozvrata');

const _priceNum = (s: string) => parseInt(s.replace(/[^\d]/g, ''), 10);
const _daysNum  = (s: string) => parseInt(s.replace(/[^\d]/g, ''), 10);

const refundRows = allShifts.map(s => {
  const price    = _priceNum(s.price);
  const days     = _daysNum(s.duration);
  const expenses = BYT_PER_DAY * days;
  const refund   = price - expenses;
  return { name: s.name, duration: s.duration, price, days, expenses, refund };
});

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽';
---

<Base
  title="Политика возврата путёвки — АйДаКемп"
  description="Условия возврата средств за путёвку в детский лагерь АйДаКемп. Два варианта: перенос на другую смену или возврат деньгами по ФЗ № 2300-1."
  hideMarketingWidgets
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://aidacamp.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Политика возврата" }
      ]
    })} />
  </Fragment>

  <Header />

  <section class="relative overflow-hidden border-b border-white/10" data-hero-bg="glass-orbs" data-hero-effect={heroEffect}>
    <div class="relative z-10 mx-auto max-w-[860px] px-4 pt-10 pb-8 md:pt-14 md:pb-10">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-[24px] font-bold text-white md:text-[32px]">Политика возврата</h1>
          <p class="mt-2 text-base text-white/75">ООО «ВОИП КОННЕКТ» · Детский ИТ-лагерь АйДаКемп · Смены {SEASON_YEAR}</p>
        </div>
        <a href="/" class="shrink-0 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors backdrop-blur-sm">
          На главную
        </a>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-[860px] px-4 py-8 pb-16">

    <!-- Вводный блок -->
    <div class="mt-6 rounded-[20px] bg-[#fff8f0] border border-[#ffd9a8] p-5">
      <p class="text-base leading-[1.65] text-slate-700">
        При досрочном отъезде или отмене путёвки мы предлагаем <strong>два варианта</strong>. Выбирает родитель.
      </p>
    </div>

    <div class="mt-5 grid gap-4">

      <!-- Вариант 1 — перенос -->
      <section class="rounded-[20px] border-2 border-primary/30 bg-gradient-to-br from-orange-50 to-amber-50 p-5 shadow-[0_4px_16px_rgba(236,124,0,0.10)]">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-white text-base font-bold">1</span>
          <h2 class="text-[18px] font-semibold text-slate-900">Перенос — 100% остатка на другую смену или школу</h2>
        </div>
        <p class="mt-3 text-base leading-[1.65] text-slate-700">
          Переносим <strong>100% неиспользованной суммы</strong> — деньги не сгорают, а превращаются в кредит:
        </p>
        <ul class="mt-3 space-y-2 text-base leading-[1.6] text-slate-700">
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle-fill text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>На любую другую смену АйДаКемп — при наличии свободных мест</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle-fill text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>На занятия в школе программирования АйДаКодить</span>
          </li>
        </ul>
        <div class="mt-4 rounded-[12px] bg-white/70 border border-primary/20 p-3.5">
          <p class="text-base leading-[1.6] text-slate-600">
            <strong>Как считается остаток при досрочном отъезде:</strong> пропорционально неиспользованным дням.
            Уехали на 3-й день из 14 — переносим 11/14 от стоимости путёвки.
          </p>
        </div>
      </section>

      <!-- Вариант 2 — возврат деньгами по закону -->
      <section class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-600 text-white text-base font-bold">2</span>
          <h2 class="text-[18px] font-semibold text-slate-900">Возврат деньгами — по ФЗ № 2300-1, ст. 32</h2>
        </div>
        <p class="mt-3 text-base leading-[1.65] text-slate-600">
          Если выбираете деньгами — возвращаем согласно Закону о защите прав потребителей. Потребитель вправе
          отказаться от услуги в любое время, оплатив исполнителю <strong>фактически понесённые расходы</strong>.
        </p>

        <!-- Формула -->
        <div class="mt-4 rounded-[14px] bg-slate-50 border border-slate-200 p-4">
          <p class="text-base font-semibold text-slate-500 uppercase tracking-wide mb-2">Формула</p>
          <p class="text-base font-mono text-slate-800">
            Возврат = (Цена за день − {BYT_PER_DAY.toLocaleString('ru-RU')} ₽) × количество неотбытых дней
          </p>
          <p class="mt-1 text-[12px] leading-[1.55] text-slate-500">
            Цена за день = цена смены ÷ длительность.
          </p>
          <p class="mt-2 text-[12px] leading-[1.55] text-slate-500">
            {BYT_PER_DAY.toLocaleString('ru-RU')} ₽/день — фактически понесённые расходы: проживание и питание,
            оплаченные базе отдыха за 6 месяцев до старта смены (не подлежат возврату базой).
          </p>
        </div>

        <p class="mt-4 text-[12px] leading-[1.55] text-slate-400">
          При досрочном отъезде во время смены удержание рассчитывается только за дни, когда базой уже оказаны услуги (проживание + питание).
        </p>

        <!-- Калькулятор -->
        <div class="mt-5 rounded-[14px] bg-slate-50 border border-slate-200 p-4" id="refund-calc">
          <p class="text-base font-semibold text-slate-700 mb-1">Посчитать для своей смены</p>
          <p class="text-[12px] text-slate-400 mb-3">Выберите смену и укажите, сколько дней ребёнок не провёл в лагере (неотбытые дни).</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <select id="calc-select" class="w-full rounded-[10px] border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary/30">
              <option value="">— выберите смену —</option>
              {refundRows.map(r => (
                <option value={`${r.price}|${r.days}`}>
                  {r.name} ({r.duration}) — {fmt(r.price)}
                </option>
              ))}
            </select>
            <input id="calc-days" type="number" inputmode="numeric" min="0" placeholder="Неотбытые дни" disabled
              class="w-full rounded-[10px] border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary/30 disabled:bg-slate-100 disabled:text-slate-400" />
          </div>
          <p id="calc-hint" class="mt-1.5 text-[12px] text-slate-400 hidden">Из <span id="calc-total"></span> дней смены отбыто <span id="calc-used"></span>.</p>
          <div id="calc-result" class="hidden mt-4 rounded-[10px] bg-white border border-emerald-200 px-4 py-3 flex items-center justify-between gap-4">
            <div>
              <p class="text-[12px] text-slate-500">Удержание (не возвращается)</p>
              <p id="calc-expenses" class="text-[16px] font-bold text-slate-600"></p>
            </div>
            <div class="h-8 w-px bg-slate-200"></div>
            <div>
              <p class="text-[12px] text-slate-500">Возврат деньгами</p>
              <p id="calc-refund" class="text-[20px] font-extrabold text-emerald-700"></p>
            </div>
          </div>
          <p class="mt-3 text-[12px] leading-[1.5] text-slate-400">
            Расчёт носит ознакомительный характер и не является основанием для предъявления требований к ООО «ВОИП КОННЕКТ». Итоговая сумма возврата определяется по фактическим данным в соответствии с условиями заключённого договора и действующим законодательством. Согласно Гражданскому кодексу РФ исполнитель вправе удержать суммы для покрытия фактически понесённых расходов и причинённого ущерба на условиях договора.
          </p>
        </div>
        <script define:vars={{ byt: BYT_PER_DAY }}>
          const sel = document.getElementById('calc-select');
          const daysIn = document.getElementById('calc-days');
          const res = document.getElementById('calc-result');
          const expEl = document.getElementById('calc-expenses');
          const refEl = document.getElementById('calc-refund');
          const hint = document.getElementById('calc-hint');
          const totalEl = document.getElementById('calc-total');
          const usedEl = document.getElementById('calc-used');
          const money = (n) => Math.round(n).toLocaleString('ru-RU') + ' ₽';
          function recalc() {
            if (!sel || !sel.value) {
              if (daysIn) { daysIn.disabled = true; daysIn.value = ''; }
              if (res) res.classList.add('hidden');
              if (hint) hint.classList.add('hidden');
              return;
            }
            const parts = sel.value.split('|').map(Number);
            const price = parts[0], days = parts[1];
            daysIn.disabled = false;
            daysIn.max = String(days);
            let unused = parseInt(daysIn.value, 10);
            if (isNaN(unused) || unused < 0) unused = 0;
            if (unused > days) { unused = days; daysIn.value = String(days); }
            const used = days - unused;
            const pricePerDay = price / days;
            const refund = Math.max(0, Math.round((pricePerDay - byt) * unused));
            const expenses = price - refund;
            totalEl.textContent = String(days);
            usedEl.textContent = String(used);
            expEl.textContent = money(expenses);
            refEl.textContent = money(refund);
            hint.classList.remove('hidden');
            if (daysIn.value !== '') res.classList.remove('hidden'); else res.classList.add('hidden');
          }
          if (sel) sel.addEventListener('change', recalc);
          if (daysIn) daysIn.addEventListener('input', recalc);
        </script>
      </section>

      <!-- Как подать заявку -->
      <section class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <div class="flex items-center gap-2.5">
          <i class="bi bi-send text-[20px] text-primary" aria-hidden="true"></i>
          <h2 class="text-[18px] font-semibold text-slate-900">Как оформить</h2>
        </div>
        <ol class="mt-3 space-y-2 text-base leading-[1.65] text-slate-600 list-decimal list-inside">
          <li>Напишите на <a href="mailto:hello@codims.ru" class="text-primary underline decoration-orange-200 underline-offset-2">hello@codims.ru</a> или в <a href="https://wa.me/79688086455" target="_blank" rel="noopener" class="text-primary underline decoration-orange-200 underline-offset-2">WhatsApp</a></li>
          <li>Укажите ФИО ребёнка, номер договора, выбранный вариант (перенос или деньги)</li>
          <li>Мы подтвердим в течение 1 рабочего дня</li>
          <li>Перенос — активируем сразу. Возврат деньгами — на карту в течение 10 рабочих дней</li>
        </ol>
      </section>

      <!-- Ссылки -->
      <section class="rounded-[20px] border border-slate-100 bg-slate-50 p-5">
        <p class="text-base font-semibold text-slate-500 uppercase tracking-wide">Смотрите также</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href="/legal/" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-base text-slate-600 hover:text-slate-900 transition-colors">
            <i class="bi bi-file-earmark-text text-base" aria-hidden="true"></i>
            Правовая информация
          </a>
          <a href="/nalogovyj-vychet/" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-base text-slate-600 hover:text-slate-900 transition-colors">
            <i class="bi bi-percent text-base" aria-hidden="true"></i>
            Налоговый вычет 13%
          </a>
          <a href="/putevka-v-lager/" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-base text-slate-600 hover:text-slate-900 transition-colors">
            <i class="bi bi-ticket-perforated text-base" aria-hidden="true"></i>
            Купить путёвку
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Base>
