---
import { DAYS_S4, PRICE_MIN, PRICE_S4, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const sections = [
  {
    h2: "Берут ли шестилеток в лагерь: говорим честно",
    text: "С какого возраста мы принимаем в лагерь: с 7 лет для всех детей — формат со сном вне дома комфортен, когда ребёнок отучился в школе хотя бы класс. День рождения рядом — обсудим индивидуально: смотрим, готовы ли дети."
  },
  {
    h2: "Что будет, когда ребёнку исполнится семь",
    text: "Лагерь с лицензией Минобрнауки. Группы по 6–8 человек, вожатый на 8 детей, медработник круглосуточно.",
    list: [
      "Программа младших — Scratch, результат — мультфильм или мини-игра",
      `Смена 4 (${DAYS_S4}, август) — ${PRICE_S4}, всё включено: проживание, питание, программа, бассейн`
    ]
  },
  {
    h2: "Как подготовить ребёнка к первой смене",
    list: [
      "Ночёвка у бабушки снимает половину адаптации; Scratch Junior на планшете — то же, что у нас на сменах для младших"
    ]
  },
  {
    h2: "Почему граница — 7 лет, а не 5",
    text: "Лагерь «с 5 лет» работает как сад с ночёвкой. Граница 7 лет держит настоящую IT-программу даже в младших группах — семилетки учат Scratch, а не играют под присмотром.",
    list: [
      "<a href='/lager-7-let/'>Лагерь для 7 лет</a> — ближайшая ступень для вашего ребёнка",
      "<a href='/lager-8-let/'>Лагерь для 8 лет</a> и <a href='/lager-9-let/'>для 9 лет</a> — что будет дальше"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Лагерь для детей 6 лет — можно ли, с какого возраста берут | АйДаКемп"
  description={`Ищете лагерь для ребёнка 6 лет — можно ли и с какого возраста берут? Честно: загородные смены у нас с 7. Как подготовить шестилетку и забронировать первую смену заранее. От ${PRICE_MIN}.`}
  h1="Лагерь для детей 6 лет: с какого возраста берут"
  canonical="https://aidacamp.ru/lager-6-let"
  breadcrumb="Можно ли в 6 лет"
>
  <LandingHero slot="hero"
    h1="Лагерь для детей 6 лет: с какого возраста берут"
    subtitle="Честный ответ: загородные смены — с 7 лет."
    breadcrumb="Можно ли в 6 лет"
    keywords={["Принимаем с 7 лет — объясняем почему", "Бронь заранее — цена фиксируется"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Лагерь для детей 6 лет — когда пора в первую смену"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ extraItems={[
    { q: "Берут ли детей 6 лет в лагерь АйДаКемп?", a: "Загородные смены — с 7 лет. Если ребёнку 6 и день рождения рядом — обсудим индивидуально." },
    { q: "Почему лагерь принимает только с 7 лет?", a: "С какого возраста дети готовы — решаем индивидуально." },
    { q: "Как подготовить шестилетку к первому лагерю?", a: "Ночёвки у бабушки и Scratch Junior на планшете помогают детям освоиться. К семи годам адаптация в лагере — легче." },
    { q: "Можно ли забронировать смену заранее, если ребёнку скоро 7?", a: "Да, бронь фиксирует цену. Для первого раза — короткая смена 7 дней." },
    { q: `Сколько стоила смена для младших в ${SEASON_YEAR} году?`, a: `Смена 4 на ${DAYS_S4} стоила ${PRICE_S4}: проживание, питание, IT-программа и бассейн. Налоговый вычет 13% — документы на ребёнка оформляем.` }
  ]} items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedArticles articles={[
    { title: "Первый раз в лагере: как подготовить ребёнка", url: "/stati/pervyj-raz-v-lagere/", description: "Советы для родителей перед первой сменой.", icon: "backpack" },
    { title: "Куда деть ребёнка летом", url: "/stati/kuda-det-rebenka-letom/", description: "Форматы летнего отдыха по возрастам.", icon: "sun" },
    { title: "Ребёнок не хочет в лагерь: что делать", url: "/stati/rebenok-ne-hochet-v-lager/", description: "Как помочь, если страшно ехать.", icon: "chat-heart" },
  ]} />
  <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-7-let/" class="text-primary underline underline-offset-2">Лагерь для 7 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
