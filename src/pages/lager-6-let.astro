---
import { PRICE_MIN, PRICE_S2, PRICE_S3, PRICE_S4, PRICE_S21, SEASON_YEAR } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import FAQSchema from '../components/FAQSchema.astro';

const sections = [
  {
    h2: "Берут ли шестилеток в лагерь: говорим честно",
    text: "С какого возраста стоит отправлять ребёнка в лагерь — этот вопрос задают чуть ли не с каждым звонком. Сразу честно: в АйДаКемп мы принимаем ребят с 7 лет. Не потому что «так положено», а потому что проверили на практике: загородный формат со сном вне дома комфортен, когда ребёнок уже пожил школьной жизнью хотя бы год. Шестилетке чаще всего ещё нужна мама рядом вечером — и это нормально. Но если вашему ребёнку 6 и день рождения до начала смены или в её первые дни — в этом случае напишите нам, обсудим индивидуально: смотрим не на цифру в свидетельстве, а на то, готовы ли ребята к жизни в лагере без мамы рядом. Готовность — это умение самостоятельно засыпать, обратиться к взрослому, если что-то болит, и справляться с бытом самим. Если сомнения остаются — приезжайте к нам на день открытых дверей и поговорите о лагере с вожатыми лично."
  },
  {
    h2: "Чем занять шестилетку, пока он ждёт свой первый лагерь",
    text: "Год до лагеря — отличное время подготовить почву, чтобы первая смена прошла на ура. Что реально помогает, по опыту родителей наших семилеток:",
    list: [
      "Небольшие поездки к бабушке или ночёвка у друзей — привычка спать вне дома снимает половину адаптации к такой поездке. В среднем к 1 классу ребята уже готовы к первой загородной смене",
      "Scratch Junior дома на планшете — бесплатное приложение, то же визуальное программирование, что у нас на сменах для младших",
      "Кружок или секция с постоянной группой — опыт «я сам в коллективе без мамы» и общение со сверстниками без родителей рядом",
      "Городской дневной формат на каникулах — промежуточная ступень перед загородным"
    ]
  },
  {
    h2: "Что будет в 7 лет: первая смена без слёз",
    text: "Когда исполнится семь — добро пожаловать. АйДаКемп — официально зарегистрированный лагерь летнего пребывания с лицензией Минобрнауки. Для первого раза подойдёт смена покороче: достаточно, чтобы прожить полный цикл «приехал — освоился — сделал проект — показал родителям», и не слишком долго для первой разлуки. Группы по 6–8 человек, у младших соотношение вожатый-ребята 1:8, медработник на территории круглосуточно, фото в родительский чат каждый день. Жизнь в лагере — это ещё и первые самостоятельные шаги без мамы.",
    list: [
      "Программа младших — Scratch: код из цветных блоков, никакого текста",
      "Результат смены — собственный мультфильм или мини-игра",
      "Между IT — бассейн, спортивные игры и творческие активности на открытом воздухе",
      "Вожатый рядом 24/7, звонки домой в установленные часы",
      `Смена 4 (10 дней, август) — ${PRICE_MIN}, всё включено: проживание, питание 5 раз, программа, бассейн`
    ]
  },
  {
    h2: "Почему мы не берём раньше семи — и почему это плюс",
    text: "Лагерь, который берёт всех подряд «с 5 лет», по сути работает детским садом с ночёвкой: воспитатели заняты бытом малышей, а не программой. Мы выбрали другое: нижняя граница 7 лет позволяет держать настоящую IT-программу даже в младших группах — и старшие не ждут младших, а младшие не тянутся из последних сил. Каждый возраст занимается своим: семилетки — Scratch, девятилетки — первый Python, подростки — нейросети и собственные проекты. Этот же вопрос — с какого возраста ехать — решаем индивидуально, если день рождения выпадает на начало смены.",
    list: [
      "Возрастные треки: программа растёт вместе с ребятами",
      "<a href='/lager-7-let/'>Лагерь для 7 лет</a> — ближайшая ступень для вашего шестилетки",
      "<a href='/lager-8-let/'>Лагерь для 8 лет</a> и <a href='/lager-9-let/'>для 9 лет</a> — что будет дальше"
    ]
  },
  {
    h2: `Смены ${SEASON_YEAR} и цены`,
    text: "Если ребёнку скоро семь — можно забронировать место в лагере заранее на смену, которая начнётся после дня рождения. Бронь фиксирует цену. Следующие августовские смены открыты — бронь на 72 часа без предоплаты: место фиксируется, пока вы думаете.",
    list: [
      `Смена 4: 10 дней, август — ${PRICE_S4} (рекомендуем для первого раза)`,
      `Смена 3: 13 дней, август — ${PRICE_S3}`,
      `Смена 2.1: 7 дней — ${PRICE_S21} (завершена)`,
      `Смена 2: 14 дней — ${PRICE_S2} (завершена)`,
      "Налоговый вычет 13% с образовательной части — оформляем документы"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-dlya-shkolnikov.avif"
  title="Лагерь для детей 6 лет — можно ли, с какого возраста берут | АйДаКемп"
  description={`Ищете лагерь для ребёнка 6 лет — можно ли и с какого возраста берут? Честно: загородные смены у нас с 7. Как подготовить шестилетку и забронировать первую смену заранее. От ${PRICE_MIN}.`}
  h1="Лагерь для детей 6 лет: можно ли, с какого возраста берут"
  canonical="https://aidacamp.ru/lager-6-let"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Берут ли детей 6 лет в лагерь АйДаКемп?", a: "Загородные смены АйДаКемп — с 7 лет. Если ребёнку 6 и день рождения до начала смены или в её первые дни — напишите нам, обсудим индивидуально. Смотрим, готовы ли ребята к лагерю, а не только на дату в свидетельстве." },
    { q: "Почему лагерь принимает только с 7 лет?", a: "Загородный формат со сном вне дома комфортен после года школьной жизни. Граница 7 лет позволяет держать настоящую IT-программу даже в младших группах: семилетки занимаются Scratch, а не просто играют под присмотром." },
    { q: "Как подготовить шестилетку к первому лагерю?", a: "Ночёвки у бабушки, Scratch Junior на планшете, кружок с постоянной группой, городской дневной формат на каникулах. К семи годам адаптация в лагере пройдёт заметно легче." },
    { q: "Можно ли забронировать смену заранее, если ребёнку скоро 7?", a: "Да. Бронируйте смену, которая начнётся после дня рождения — бронь фиксирует цену. Для первого раза рекомендуем короткую смену 7 дней." },
    { q: "Сколько стоит смена для младших?", a: `Открыта Смена 4 (10 дней, август) — ${PRICE_S4}: проживание, питание 5 раз в день, IT-программа, бассейн. Налоговый вычет 13% с образовательной части — документы оформляем.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Лагерь для детей 6 лет: можно ли, с какого возраста берут"
    subtitle="Честный ответ: загородные смены — с 7 лет. Рассказываем почему, как подготовить шестилетку и когда бронировать первую смену."
    breadcrumb="Лагерь для детей 6 лет"
    keywords={["Принимаем с 7 лет — объясняем почему", "Как подготовить шестилетку к первой смене", "Бронь заранее — цена фиксируется"]}
    image="/images/hero/lager-dlya-shkolnikov.avif"
    imageAlt="Лагерь для детей 6 лет — когда пора в первую смену"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ items={['documents:0', 'documents:6', 'payment:1', 'payment:2']} moreLink={{ href: '/faq/', text: 'Остальные вопросы — на странице FAQ' }} />
  <RelatedArticles articles={[
    { title: "Первый раз в лагере: как подготовить ребёнка", url: "/stati/pervyj-raz-v-lagere/", description: "Советы для родителей перед первой сменой.", icon: "backpack" },
    { title: "Куда деть ребёнка летом", url: "/stati/kuda-det-rebenka-letom/", description: "Форматы летнего отдыха по возрастам.", icon: "sun" },
    { title: "Ребёнок не хочет в лагерь: что делать", url: "/stati/rebenok-ne-hochet-v-lager/", description: "Как помочь, если страшно ехать.", icon: "chat-heart" },
  ]} />
  <div class="mx-auto max-w-[1312px] px-4 py-4 flex gap-6 text-base text-slate-500">
    <a href="/lager-7-let/" class="text-primary underline underline-offset-2">Лагерь для 7 лет →</a>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
