---
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import ShiftBookModal from '../components/shifts/ShiftBookModal.astro';
---

<LandingLayout
  heroImage="/images/hero/lager-v-podmoskove.avif"
  title="Детский летний лагерь в подмосковье 2026 — IT-лагерь АйДаКемп"
  description="Детский летний лагерь в подмосковье — АйДаКемп в Подмосковье 2026. Python, AI, Minecraft, бассейн. Смены июнь–август, от 48 000 ₽. Трансфер от м. Солнцево."
  h1="Детский летний лагерь в подмосковье 2026 — АйДаКемп"
  canonical="https://aidacamp.ru/detskiy-letniy-lager-v-podmoskove"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли детский летний лагерь в подмосковье с проживанием в 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "АйДаКемп — загородный IT-лагерь с проживанием в Наро-Фоминском районе, доступный из Подмосковье. Смены 7–14 дней, летом 2026, для школьников 7–15 лет." }
        },
        {
          "@type": "Question",
          "name": "Как добраться до лагеря из Подмосковье?",
          "acceptedAnswer": { "@type": "Answer", "text": "Организованный трансфер отправляется от м. Солнцево (2 000 ₽). На машине: лагерь в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе." }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит лагерь в 2026 году?",
          "acceptedAnswer": { "@type": "Answer", "text": "От 48 000 ₽ за 7 дней. Смены 10, 13 и 14 дней — 74 900–99 000 ₽. Включены питание, проживание, IT-программа. Налоговый вычет 13% — до 5 434 ₽." }
        }
      ]
    })} />
  </Fragment>

  <main class="mx-auto max-w-[720px] px-4 py-10">
    <h1 class="text-[28px] md:text-[36px] font-bold text-body leading-tight tracking-[-0.02em] mb-6">
      Детский летний лагерь в подмосковье 2026 — АйДаКемп
    </h1>

    <div class="prose prose-lg max-w-none text-body-muted leading-relaxed">
      <p>АйДаКемп — детский IT-лагерь в Подмосковье для школьников 7–15 лет. Расположен в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД по Киевскому шоссе. Для семей из Подмосковье — организованный трансфер от м. Солнцево (2 000 ₽).</p>
      <p>Программы: Python, AI и нейросети, Minecraft Education, Roblox Studio, 3D-моделирование. Группы до 8 человек, занятия дважды в день. В финале смены — хакатон и готовый проект. Путёвка от 48 000 ₽, налоговый вычет 13% — до 5 434 ₽.</p>
    </div>

    <ul class="mt-6 space-y-2">
            <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>IT-треки: Python, AI, Minecraft, Roblox, 3D — на выбор</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Группы до 8 человек, 1 преподаватель на 6–8 участников</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Бассейн, 5-разовое питание, медработник 24/7</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Трансфер от м. Солнцево, 2 000 ₽</span>
      </li>
      <li class="flex items-start gap-2 text-[16px] text-body">
        <i class="bi bi-check-lg text-primary mt-0.5 shrink-0" aria-hidden="true"></i>
        <span>Смены 7–14 дней, июнь и август 2026</span>
      </li>
    </ul>

    <div class="mt-8 p-5 bg-orange-50 rounded-[16px] border border-orange-100">
      <p class="text-[15px] text-slate-700">
        <strong>АйДаКемп</strong> — детский IT-лагерь в Подмосковье, 66 км от МКАД.
        Python, AI, Minecraft для школьников 7–15 лет. Смены июнь–август 2026, от 48 000 ₽.
        Налоговый вычет 13% — до 5 434 ₽.
      </p>
    </div>
  </main>

  <Shifts />
  <FAQ />
  <ShiftBookModal />
  <div class="mx-auto max-w-[720px] px-4 pb-8 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> ·
      <a href="/ceny" class="text-primary hover:underline">цены и смены 2026</a>
    </p>
  </div>
  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />


  

  <!-- strengthened-v2 -->
  <section class="mx-auto max-w-[720px] px-4 py-8 prose prose-lg max-w-none text-body-muted leading-relaxed">
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4">Как проходит смена</h2>
    <p>В АйДаКемпе ребёнок не просто проводит каникулы за городом, а за смену собирает свой проект — игру на Python, бота с нейросетью или мир в Minecraft. В конце ребята защищают работу на хакатоне и забирают домой диплом и первое портфолио.</p>
    <p>Занятия идут в группах до 8 человек, поэтому преподаватель успевает разобраться с каждым. Между ними — бассейн, спорт и вечерние программы. Живём в санатории «Изумруд» в Наро-Фоминском районе, 66 км от МКАД: закрытая территория, 5-разовое питание, медработник круглосуточно.</p>
    <p>Родителям каждый день приходят фото из отряда в Telegram — спокойно видеть, что школьник занят и в хорошем настроении. Смены идут с июня по август 2026, от 7 до 14 дней.</p>
    <h2 class="text-[22px] md:text-[28px] font-bold text-body mb-4 mt-8">Коротко о смене</h2>
    <ul class="space-y-2">
      <li>Возраст 7–15 лет, группы до 8 человек</li>
      <li>Направления: Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование</li>
      <li>Проживание 2–4 человека, 5-разовое питание, бассейн</li>
      <li>Медработник 24/7, закрытая охраняемая территория</li>
      <li>Фото из лагеря в Telegram каждый день</li>
      <li>Налоговый вычет 13% — до 5 434 ₽ за 14-дневную смену</li>
    </ul>
  </section>
</LandingLayout>
