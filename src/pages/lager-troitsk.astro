---
import { DATES_SHORT_S3, DATES_SHORT_S4, PRICE_MIN, PRICE_S3, PRICE_S4, VYCHET_MAX, VYCHET_S3, VYCHET_S4 } from '../data/shifts';
import '../styles/global.css';
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingTwoCol from '../components/LandingTwoCol.astro';
import Shifts from '../components/Shifts.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { getRelatedPages } from '../data/landing-pages';
import Gallery from '../components/Gallery.astro';
import CourseSchema from '../components/CourseSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { PAYMENT_SPLIT } from '../data/contacts';

const sections = [
  {
    h2: "IT-лагерь рядом с Троицком — соседнее направление, ~50 минут",
    text: "Троицк — это наукоград Новой Москвы на юго-западе, и АйДаКемп стоит буквально по той же стороне Подмосковья. От Троицка до санатория «Изумруд» всего ~45 км и около 50 минут на машине: то же юго-западное направление, никаких объездов через всю столицу. Из всех городов вокруг нас Троицк — один из самых близких. Ребёнок едет не в дальние края, а в соседний лесной район — и возвращается с собственным IT-проектом."
  },
  {
    h2: "Маршрут из Троицка в АйДаКемп — около 50 минут",
    text: "Троицк стоит на Калужском шоссе, наш лагерь — на Киевском, и эти направления идут рядом по юго-западу. Дорога занимает примерно 50 минут, без выезда на МКАД и без столичных пробок. Сам лагерь — 66 км от МКАД, но из Троицка получается короче: вы уже на нужной стороне области.",
    list: [
      "На машине: из Троицка на юго-запад через А107 на Киевское шоссе, около 50 минут",
      "Электричка: ст. Нара (~1 ч), далее такси ~20 мин, или ст. Башкино (~8 км до лагеря)",
      "Трансфер лагеря от м. Солнцево — 2 000 ₽, из Троицка до метро ~25 мин на машине"
    ]
  },
  {
    h2: "Трансфер из Троицка в лагерь",
    text: "Трансфер лагеря (2 000 ₽ в один конец, с сопровождающим) отправляется от м. Солнцево в день заезда и обратно в день отъезда. Из Троицка до точки сбора — около 25 минут на машине. Но многие семьи из Троицка едут напрямую: дорога всего ~50 минут, и это удобнее, чем сначала заезжать к метро.",
    list: [
      "Трансфер 2 000 ₽ в один конец, от м. Солнцево в день заезда и обратно в день отъезда",
      "Из Троицка до м. Солнцево — ~25 мин на машине",
      "Альтернатива: привезти ребёнка прямо в лагерь — около 50 минут по своему направлению"
    ]
  },
  {
    h2: "Налоговый вычет для родителей из Троицка",
    text: "АйДаКемп — лицензированная образовательная организация. Родители из Троицка оформляют налоговый вычет ровно так же, как и москвичи: через личный кабинет налоговой на nalog.ru, ведь Троицк — это Москва.",
    list: [
      `Смена 4 — 10 дней (${PRICE_S4}) → возврат ~${VYCHET_S4}`,
      `Смена 3 — 13 дней (${PRICE_S3}) → возврат до ${VYCHET_MAX}`,
      "Документы для вычета (договор + чек) выдаём при заезде"
    ]
  },
  {
    h2: "Что ждёт ребят в IT-лагере",
    text: "АйДаКемп — лагерь с полным погружением в технологии. Школьники 7–15 лет выбирают трек по интересу: Python, AI и нейросети, Minecraft, Roblox или 3D-моделирование. Занятия проходят дважды в день по 90 минут, ведут их практикующие IT-специалисты.",
    list: [
      "Бассейн с ионизированной водой, спортплощадки, настольные игры",
      "5-разовое питание, комнаты по 2–4 человека с санузлом",
      "Медработник 24/7, охрана, закрытая территория санатория «Изумруд»",
      "Итоговый хакатон — каждый защищает свой проект"
    ]
  },
  {
    h2: "Вожатые и команда лагеря",
    text: "В АйДаКемп работают преподаватели-практики и воспитатели с педагогическим образованием. Родители из Троицка всегда видят, чем занят их подросток в течение дня.",
    list: [
      "1 преподаватель на 6–8 ребят — каждый получает внимание и помощь",
      "Вожатые — студенты педагогических специальностей, конкурсный отбор",
      "Медработник круглосуточно, охраняемая территория санатория «Изумруд»",
      "Ежедневные фото в Telegram-канале лагеря в 21:00 — видите, как проходит день"
    ]
  },
  {
    h2: "Почему семьи из Троицка выбирают АйДаКемп",
    text: "Троицк и наш лагерь — на одной юго-западной стороне Подмосковья. Это самое короткое плечо из всех окрестных городов:",
    list: [
      "~50 мин от Троицка — один из ближайших IT-лагерей с проживанием в нашем направлении",
      "То же направление и климат — никакой акклиматизации, подросток сразу в ритм",
      "Можно заехать в любой день смены — проведать или привезти забытые вещи",
      "Самостоятельный заезд без трансфера — просто привезти на машине, около 50 мин"
    ]
  },
  {
    h2: "Смены 2026 — цены и наличие мест",
    text: "Июль 2026 занят полностью. В июне и августе ещё есть свободные места — бронируйте сейчас. В стоимость входят проживание, питание, полная IT-программа, бассейн и активности. Получается полноценный отдых с пользой: проживание, питание и бассейн — в цене, доплачивать за программу не нужно.",
    list: [
      `Смена 3 — ${DATES_SHORT_S3}, 13 дней, ${PRICE_S3} (налоговый вычет ~${VYCHET_S3})`,
      `Смена 4 — ${DATES_SHORT_S4}, 10 дней, ${PRICE_S4} (налоговый вычет ~${VYCHET_S4})`,
      "Трансфер от м. Солнцево — 2 000 ₽ отдельно",
      PAYMENT_SPLIT
    ]
  },
  {
    h2: "Отзывы семей из Троицка и Новой Москвы",
    text: "В АйДаКемп приезжают ребята из Троицка, Ватутинок, Щербинки и других районов юго-запада. Вот что пишут родители:",
    list: [
      "«Мы на той же стороне, что и лагерь — доехали меньше чем за час по своему направлению. Не пришлось пилить через всю Москву» — Марина, Троицк",
      "«Дочка вернулась со своей игрой на Python и сразу засела показывать её подругам во дворе. Она теперь «та самая, которая программирует»» — Ольга, Ватутинки",
      "«Возили сами, без трансфера — около 50 минут. Заезжали на родительский день, всё чисто и спокойно» — Дмитрий, Троицк"
    ]
  }
];
---

<LandingLayout
  heroImage="/images/hero/lager-na-leto-2026.avif"
  title="IT-лагерь рядом с Троицком 2026 — ~50 минут | АйДаКемп"
  description={`Детский IT-лагерь ~50 минут от Троицка, Python и AI для ребят 7–15 лет. Налоговый вычет до ${VYCHET_MAX}, трансфер от м. Солнцево. Смены 2026.`}
  h1="IT-лагерь рядом с Троицком — соседнее направление, ~50 минут"
  canonical="https://aidacamp.ru/lager-troitsk"
>
  <Fragment slot="head">
    <FAQSchema items={[
    { q: "Как добраться из Троицка до лагеря АйДаКемп?", a: "Из Троицка — около 50 минут на машине: через А107 на Киевское шоссе, без выезда на МКАД. Троицк и лагерь на одном юго-западном направлении, поэтому ехать недалеко. Сам лагерь — 66 км от МКАД. Можно и на электричке: ст. Нара (~1 ч), далее такси ~20 мин." },
    { q: "Есть ли трансфер из Троицка?", a: "Прямого трансфера из Троицка нет. Есть трансфер лагеря от м. Солнцево — 2 000 ₽ в один конец, с сопровождающим; из Троицка до метро ~25 минут. Но многие семьи едут прямо в лагерь — это всего ~50 минут по своему направлению." },
    { q: "Можно ли вернуть часть стоимости путёвки?", a: `Да, налоговый вычет 13%. Троицк — это Москва, поэтому всё работает как у москвичей: документы через nalog.ru. Возврат от ~${VYCHET_S4} (10-дневная смена) до ${VYCHET_MAX} (13-дневная).` },
    { q: "Для каких ребят подходит лагерь?", a: "Для школьников 7–15 лет. Опыт программирования не нужен — принимаем с нуля. Занятия в группах до 8 человек." },
    { q: "Какие IT-треки доступны в лагере?", a: "Python, AI и нейросети, Minecraft, Roblox, 3D-моделирование — подросток выбирает сам при заезде. К концу смены каждый защищает реальный проект на хакатоне." },
    { q: "Можно ли оплатить частями?", a: `Да. ${PAYMENT_SPLIT}. Стоимость смен от ${PRICE_MIN}.` }
  ]} />
    <CourseSchema
      name="Детский IT-лагерь рядом с Троицком — АйДаКемп"
      description="IT-лагерь в Наро-Фоминском районе, около 50 минут от Троицка по одному юго-западному направлению. Python, AI, Minecraft для школьников 7–15 лет."
      url="https://aidacamp.ru/lager-troitsk"
      ageMin={7}
      ageMax={15}
    />

    <FAQSchema items={[
    { q: "Как быстро добраться из Троицка в АйДаКемп?", a: "Около 50 минут на машине: Троицк и лагерь на одном юго-западном направлении, через А107 выезжаете на Киевское шоссе без МКАД и пробок. Сам лагерь — 66 км от МКАД. Трансфер лагеря от м. Солнцево — 2 000 ₽ (из Троицка ~25 минут до метро)." },
    { q: "Входит ли в стоимость трансфер из Троицка?", a: "Трансфер платный — 2 000 ₽ в один конец, от м. Солнцево. Из Троицка до Солнцево ~25 минут. Или привезите ребёнка сами — около 50 минут по своему направлению." },
    { q: "Можно ли заехать в лагерь в середине смены из Троицка?", a: "Да. Близость лагеря (около 50 минут от Троицка) позволяет родителям проведывать ребят или привозить забытые вещи во время смены." },
    { q: "Какой налоговый вычет получит родитель из Троицка?", a: `На 10-дневную смену (${PRICE_S4}) — возврат ~${VYCHET_S4}; на 13-дневную (${PRICE_S3}) — до ${VYCHET_MAX}. Оформляется через nalog.ru как у москвичей.` }
  ]} />
  </Fragment>
  <LandingHero slot="hero"
    h1="Летний детский IT-лагерь рядом с Троицком"
    subtitle="IT-лагерь в Наро-Фоминском районе — около 50 минут от Троицка по одному юго-западному направлению. Трансфер от м. Солнцево 2 000 ₽."
    breadcrumb="Лагерь из Троицка"
    keywords={["~50 мин от Троицка, одно направление, трансфер от м. Солнцево 2 000 ₽", "IT-лагерь: Python, AI, Minecraft для школьников 7–15 лет", "Загородный с проживанием, бассейн, 5-разовое питание"]}
    image="/images/hero/lager-na-leto-2026.avif"
    imageAlt="Детский IT-лагерь рядом с Троицком — АйДаКемп"
  />
  <LandingTwoCol sections={sections} />
  <Gallery />
  <Shifts />
  <FAQ />
  <div class="mx-auto max-w-[720px] px-4 py-6 text-center">
    <p class="text-[14px] text-slate-500">
      Подробнее о программе: <a href="/" class="text-primary hover:underline">детский IT-лагерь в Подмосковье</a> — <a href="/stati/kak-dobratsya-do-lagera/" class="text-primary hover:underline">как добраться до лагеря</a>
    </p>
    <p class="text-[14px] text-slate-500 mt-2">
      Смотрите также: <a href="/lager-novaya-moskva/" class="text-primary hover:underline">лагерь из Новой Москвы</a> · <a href="/ceny/" class="text-primary hover:underline">смены и даты 2026</a> · <a href="/ceny/" class="text-primary hover:underline">стоимость и налоговый вычет</a>
    </p>
  </div>

<section class="featured-snippet">
  <h2>Как быстро добраться из Троицка в АйДаКемп?</h2>
  <p><strong>Время:</strong> около 50 минут на машине из Троицка — через А107 на Киевское шоссе, без выезда на МКАД и пробок.</p>
  <p><strong>Направление:</strong> Троицк и лагерь на одной юго-западной стороне Подмосковья, поэтому объезжать всю Москву не нужно.</p>
  <p><strong>Трансфер:</strong> от метро Солнцево в день заезда и отъезда, 2 000 ₽ в один конец (из Троицка до Солнцево ~25 минут).</p>
</section>

  <RelatedPages pages={getRelatedPages(Astro.url.pathname)} />
</LandingLayout>
