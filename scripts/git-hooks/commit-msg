#!/usr/bin/env bash
# Enforce conventional commits (semantic commits)
# https://www.conventionalcommits.org/
#
# Формат: <type>(<scope>): <subject>
# Примеры:
#   feat(hero): add hero mobile refactor
#   fix(Shifts): remove duplicate SHIFT_STAT block
#   chore: add CODEOWNERS for hot files
#   docs(README): update deployment instructions
#   style(icons): update icon manifest
#   refactor(BookingBar): simplify state management
#   test: add Shifts component tests
#   perf(images): optimize hero images

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Пропускаем проверку для merge-коммитов и revert-коммитов (они системные)
if [[ "$commit_msg" =~ ^Merge[[:space:]] ]] || [[ "$commit_msg" =~ ^Revert[[:space:]] ]]; then
  exit 0
fi

# Allowed types
allowed_types="feat|fix|docs|style|refactor|test|perf|build|ci|chore|revert"

# Проверка: первая строка должна быть в формате type(scope): message или type: message
if ! echo "$commit_msg" | head -1 | grep -E "^($allowed_types)(\(.+\))?: .+" > /dev/null; then
  echo "❌ COMMIT MESSAGE ДОЛЖНО СООТВЕТСТВОВАТЬ SEMANTIC COMMITS" >&2
  echo "" >&2
  echo "Формат: <type>(<scope>): <subject>" >&2
  echo "Примеры:" >&2
  echo "  feat(hero): add hero mobile refactor" >&2
  echo "  fix(Shifts): remove duplicate SHIFT_STAT block" >&2
  echo "  chore: add CODEOWNERS for hot files" >&2
  echo "  docs(README): update deployment instructions" >&2
  echo "" >&2
  echo "Допустимые типы: $allowed_types" >&2
  echo "" >&2
  echo "Текущее сообщение:" >&2
  echo "  $commit_msg" >&2
  exit 1
fi

# ✅ Проверка пройдена
exit 0
