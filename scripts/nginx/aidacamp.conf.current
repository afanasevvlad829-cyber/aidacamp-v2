        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~ ^/skolko-deystvuet-spravka-079u-dlya-lagerya/?$ {
        proxy_pass http://127.0.0.1:4185;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~ ^/nalogovyy-vychet-za-detskiy-lager/?$ {
        proxy_pass http://127.0.0.1:4185;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /data/news-jazz.json {
        alias /var/www/aidacamp/current/data/news-jazz.json;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        include snippets/security-headers.conf;
        add_header Set-Cookie $aid_set;
        access_log /var/log/nginx/access.log combined_host;
        access_log /var/log/nginx/attribution.log attribution;
        try_files $uri $uri/ =404;
        error_page 404 /404.html;
    }

    location ^~ /_ops/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
    }

    location = /healthz {
        access_log /var/log/nginx/access.log combined_host;
        return 200 "ok\n";
    }
}

